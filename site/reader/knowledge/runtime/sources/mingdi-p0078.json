ingdi-e-p021b-q"]},"ordering_evidence":"mingdi-e-p021b-q","source_order":[3,242,"P021b"],"order":830},{"id":"mingdi-e-p021e","title":"秦朗随母养公宫曹操爱之","accounts":[{"id":"mingdi-e-p021e-account","label":"裴注·献帝传","text":"秦朗随母养公宫曹操爱之","evidence":["mingdi-e-p021e-q"]}],"participants":[{"person":"mingdi-p0031","role":"受抚养","evidence":["mingdi-e-p021e-q"]},{"person":"mingdi-p0078","role":"携子","evidence":["mingdi-e-p021e-q"]},{"person":"cao-cao","role":"抚养","evidence":["mingdi-e-p021e-q"]}],"place":null,"time":{"label":"吕布被围前后，回叙","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["mingdi-e-p021e-q"]},"ordering_evidence":"mingdi-e-p021e-q","source_order":[3,242,"P021e"],"order":833}],"persons":[{"id":"mingdi-p0078","name":"杜氏（秦朗母）","evidence":["mingdi-q-p021","xiahoucao-q-p047"],"facts":[],"aliases":[],"mentions":[{"id":"mingdi-m-p021-mingdi-p0078","kind":"mention","text":"文中提及","evidence":["mingdi-q-p021"]},{"id":"xiahoucao-m-p047-mingdi-p0078","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-p047"]}]}],"evidence":[{"id":"guanzhang-e-p001a-q","section":"chapter-036","block":"b-79022483cd461a542448","layer":"pei","quote":"﹝一﹞《蜀记》曰：“曹公与刘备围吕布于下邳。关羽启公：布使秦宜禄行求救，乞娶其妻；公许之。临破，又屡启于公。公疑其有异色，先遣迎看；因自留之，羽心不自安。”此与《魏氏春秋》所说无异也。","attribution":"《蜀记》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":7,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f214c7b82beace6c970a","start":0,"end":92,"offset_unit":"unicode_code_point"},{"id":"mingdi-e-p021b-q","section":"chapter-003","block":"b-0b51273f0eff3bb164c4","layer":"pei","quote":"布之被围，关羽屡请于太祖，求以杜氏为妻。太祖疑其有色。及城陷，太祖见之，乃自纳之。","attribution":"裴注·献帝传","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":241,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9ebeadb65240878258aa","start":41,"end":82,"offset_unit":"unicode_code_point"},{"id":"mingdi-e-p021e-q","section":"chapter-003","block":"b-0b51273f0eff3bb164c4","layer":"pei","quote":"朗随母氏，蓄于公宫，太祖甚爱之。每坐席，谓宾客曰：‘世有人爱假子如孤者乎？","attribution":"裴注·献帝传","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":241,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9ebeadb65240878258aa","start":150,"end":187,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-p021","section":"chapter-003","block":"b-0b51273f0eff3bb164c4","layer":"pei","quote":"《献帝传》曰：“朗父，名宜禄。为吕布使诣袁术，术妻以汉宗室女。其前妻杜氏，留下邳。布之被围，关羽屡请于太祖，求以杜氏为妻。太祖疑其有色。及城陷，太祖见之，乃自纳之。宜禄归降，以为铚长。及刘备走小沛，张飞随之，过谓宜禄曰：‘人取汝妻，而为之长；乃蚩蚩若是邪！随我去乎？’宜禄从之数里，悔，欲还；飞杀之。朗随母氏，蓄于公宫，太祖甚爱之。每坐席，谓宾客曰：‘世有人爱假子如孤者乎？’”","attribution":"裴注·献帝传","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":241,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9ebeadb65240878258aa","start":0,"end":189,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-p047","section":"chapter-009","block":"b-8f654c67b72ea809e6a5","layer":"pei","quote":"《魏末传》曰：“晏妇金乡公主，即晏同母妹。公主贤，谓其母沛王太妃曰：‘晏为恶日甚，将何保身？’母笑曰：‘汝得无妒晏邪？’俄而晏死。有一男，年五六岁，宣王遣人录之。晏（母）〔妇〕归藏其子王宫中，向使者搏颊，乞白活之。使者具以白宣王。宣王亦闻晏妇有先见之言，心常嘉之；且为沛王故，特原不杀。”臣松之按：《魏末传》云晏取其同母妹为妻，此搢绅所不忍言；虽楚王之妻（嫂）〔媦〕，不是甚也已。设令此言出于旧史，犹将莫之或信，况底下之书乎？按《诸王公传》，沛王出自杜夫人所生。晏母姓尹，公主若与沛王同生，焉得言与晏同母？","attribution":"《魏末传》；裴松之按语","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":386,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-46a3d2d6a327171eb9f7","start":0,"end":253,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
