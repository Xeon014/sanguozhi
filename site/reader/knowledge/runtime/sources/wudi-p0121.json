"]},{"id":"dongyuan-m-o024-wudi-p0121","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o024"]},{"id":"dongyuan-m-o026-wudi-p0121","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o026"]},{"id":"dongyuan-m-p051-wudi-p0121","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p051"]}]}],"evidence":[{"id":"chengguo-q-69d8b70d6d174e3ecf33","section":"chapter-014","block":"b-089f6b5dc0e8a9b3cd1e","layer":"original","quote":"奉由是失望，与韩暹等到定陵抄暴〖11〗","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":176,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":348,"end":367,"offset_unit":"unicode_code_point"},{"id":"chengguo-q-94febb2e441767a833d4","section":"chapter-014","block":"b-089f6b5dc0e8a9b3cd1e","layer":"original","quote":"太祖不应，密往攻其梁营，降诛即定。奉、暹失众，东降袁术","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":176,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":368,"end":395,"offset_unit":"unicode_code_point"},{"id":"chengguo-q-a8500e619a687d1c8e48","section":"chapter-014","block":"b-d63745ed601e2334eece","layer":"original","quote":"遣使诣河东，会天子还洛阳，韩暹、杨奉、董承及杨，各违戾不和","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":154,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":13,"end":42,"offset_unit":"unicode_code_point"},{"id":"chengguo-q-ea8a185329a547f1308e","section":"chapter-014","block":"b-b6f3feb7dc055ac2a2d7","layer":"modern","quote":"〖6〗镇东、费亭之事：指建安元年（公元 196）六月，朝廷提升曹操为镇东将军，并封他为费亭侯事。此事出自杨奉等人的推举，见上文与本书卷一《武帝纪》。","attribution":"现代注释","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":187,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c9f8f12fd9a5cc33380b","start":0,"end":74,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-o024b-q","section":"chapter-006","block":"b-4952f69b7a7ab8eb99b0","layer":"original","quote":"傕、汜悔遣天子，复相与和，追及天子于弘农之曹阳。奉急招河东故白波帅韩暹、胡才、李乐等合〖3〗，与傕、汜大战。奉兵败，傕等纵兵杀公卿百官，略宫人入弘农。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":163,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":47,"end":122,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-o024c-q","section":"chapter-006","block":"b-4952f69b7a7ab8eb99b0","layer":"original","quote":"天子走陕，北渡河。失辎重，步行；唯皇后、贵人从。至大阳〖4〗，止人家屋中〖5〗﹝三﹞。奉、暹等遂以天子都安邑，御乘牛车；太尉杨彪、太仆韩融近臣从者十余人〖6〗。以暹为征东，才为征西，乐征北将军，并与奉、承持政。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":163,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":125,"end":230,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-o024f-q","section":"chapter-006","block":"b-4952f69b7a7ab8eb99b0","layer":"original","quote":"诸将不能相率〖7〗，上下乱，粮食尽。奉、暹、承乃以天子还洛阳；出箕关〖8〗，下轵道〖9〗。张杨以食迎道路，拜大司马。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":163,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":283,"end":341,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-o026c-q","section":"chapter-006","block":"b-575c8f171eb8425f4603","layer":"original","quote":"暹、奉不能奉王法，各出奔，寇徐、扬间，为刘备所杀。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":181,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":9,"end":34,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p051a-q","section":"chapter-006","block":"b-14c7600846b455d230bc","layer":"pei","quote":"﹝一﹞《英雄记》曰：“备诱奉，与相见，因于坐上执之。暹失奉，势孤，时欲走还并州；为杼秋屯帅张宣所邀杀。”","attribution":"《英雄记》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":189,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6ca2457f7a0447d0dda4","start":0,"end":52,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o024","section":"chapter-006","block":"b-4952f69b7a7ab8eb99b0","layer":"original","quote":"郭汜复欲胁天子，还都郿。天子奔奉营，奉击汜，破之。汜走南山〖2〗。奉及将军董承，以天子还洛阳。傕、汜悔遣天子，复相与和，追及天子于弘农之曹阳。奉急招河东故白波帅韩暹、胡才、李乐等合〖3〗，与傕、汜大战。奉兵败，傕等纵兵杀公卿百官，略宫人入弘农。﹝二﹞天子走陕，北渡河。失辎重，步行；唯皇后、贵人从。至大阳〖4〗，止人家屋中〖5〗﹝三﹞。奉、暹等遂以天子都安邑，御乘牛车；太尉杨彪、太仆韩融近臣从者十余人〖6〗。以暹为征东，才为征西，乐征北将军，并与奉、承持政。遣融至弘农，与傕、汜等连和；还所略宫人、公卿百官，及乘舆车马数乘。是时蝗虫起，岁旱无谷；从官食枣菜。﹝四﹞诸将不能相率〖7〗，上下乱，粮食尽。奉、暹、承乃以天子还洛阳；出箕关〖8〗，下轵道〖9〗。张杨以食迎道路，拜大司马。语在《杨传》。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":163,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":348,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o026","section":"chapter-006","block":"b-575c8f171eb8425f4603","layer":"original","quote":"太祖乃迎天子都许。暹、奉不能奉王法，各出奔，寇徐、扬间，为刘备所杀。﹝一﹞董承从太祖〔三〕岁余，诛。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":181,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":50,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p051","section":"chapter-006","block":"b-14c7600846b455d230bc","layer":"pei","quote":"﹝一﹞《英雄记》曰：“备诱奉，与相见，因于坐上执之。暹失奉，势孤，时欲走还并州；为杼秋屯帅张宣所邀杀。”","attribution":"《英雄记》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":189,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6ca2457f7a0447d0dda4","start":0,"end":52,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-8b2d447c179f5fa02f2e","section":"chapter-008","block":"b-6625e15615544094ec8f","layer":"original","quote":"粮乏，杨以粮迎道路，遂至洛阳。谓诸将曰：“天子，当与天下共之。幸有公卿大臣；杨当捍外难〖8〗，何事京都〖9〗？”遂还野王。即拜为大司马","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":146,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":20,"end":87,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-bec3188cfa2c7b265ac9","section":"chapter-008","block":"b-6625e15615544094ec8f","layer":"original","quote":"建安元年，杨奉、董承、韩暹挟天子还旧京","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":146,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-0ea390afd2c83caa18a9","section":"chapter-007","block":"b-fe60abe324d40d59e61e","layer":"pei","quote":"布进军，去勋等营百步，暹、奉兵同时并发。斩十将首，杀伤堕水死者不可胜数","attribution":"裴注·九州春秋","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":117,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a7ab9de04a39324dfeda","start":119,"end":154,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-23a27027d215e0a24739","section":"chapter-007","block":"b-0c7981b3fdfd16298529","layer":"original","quote":"术怒，与韩暹、杨奉等连势，遣大将张勋，攻布","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":95,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-4ee21f84e7b8d8441c4d","section":"chapter-007","block":"b-283cedb7fa0273b89062","layer":"pei","quote":"布后又与暹、奉二军向寿春，水陆并进，所过虏略。到钟离，大获而还","attribution":"裴注·英雄记","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":118,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a7ab9de04a39324dfeda","start":8,"end":39,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-62f6f06678aca807f40c","section":"chapter-007","block":"b-fe60abe324d40d59e61e","layer":"pei","quote":"布与暹、奉书曰：‘二将军拔大驾来东，有元功于国；当书勋竹帛，万世不朽。今袁术造逆，当共诛讨，奈何与贼臣还共伐布？布有杀董卓之功，与二将军俱为功臣；可因今共击破术，建功于天下，此时不可失也！’暹、奉得书，即回计从布","attribution":"裴注·九州春秋","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":117,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a7ab9de04a39324dfeda","start":12,"end":118,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-8c16a5237fcdeea47140","section":"chapter-007","block":"b-0c7981b3fdfd16298529","layer":"original","quote":"布谓珪曰：“今致术军，卿之由也。为之奈何？”珪曰：“暹、奉与术，猝合之军耳！策谋不素定，不能相维持。子登策之，比之连鸡〖1〗：势不俱栖，可解离也。”布用珪策，遣人说暹、奉，使与己并力共击术军；军资所有，悉许暹、奉。于是暹、奉从之，勋大破败","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":95,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":22,"end":141,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-be0293bbb2bdb5076386","section":"chapter-007","block":"b-c40ab31a9696e5efe967","layer":"pei","quote":"使人于山阳界亡失文字，太祖又手书厚加慰劳布；说起迎天子当平定天下意；并诏书购捕公孙瓒、袁术、韩暹、杨奉等","attribution":"裴注·英雄记","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":94,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6ead8e3a37684baf1c18","start":61,"end":113,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o043a-q","section":"chapter-001","block":"b-db9622d15d0b32d20b90","layer":"original","quote":"秋七月，杨奉、韩暹以天子还洛阳〖9〗。﹝一﹞奉别屯梁〖10〗。太祖遂至洛阳，卫京都。暹遁走。天子假太祖节、钺〖11〗，录尚书事〖12〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":261,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":68,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-16a5462151b1cfe5142d","section":"chapter-001","block":"b-16a5462151b1cfe5142d","layer":"modern","quote":"〖1〗建安元年：公元 196 年。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":264,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-df2756e12f4ac1fef3c4","start":0,"end":17,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o040","section":"chapter-001","block":"b-c71d10ef121af30ac6b7","layer":"original","quote":"建安元年春正月〖1〗，太祖军临武平〖2〗。袁术所置陈相袁嗣，降。太祖将迎天子，诸将或疑；荀彧、程昱劝之。乃遣曹洪将兵西迎。卫将军董承与袁术将苌奴拒险〖3〗，洪不得进。汝南、颍川黄巾何仪、刘辟、黄邵、何曼等〖4〗，众各数万。初应袁术，又附孙坚〖5〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":258,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":124,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o043","section":"chapter-001","block":"b-db9622d15d0b32d20b90","layer":"original","quote":"秋七月，杨奉、韩暹以天子还洛阳〖9〗。﹝一﹞奉别屯梁〖10〗。太祖遂至洛阳，卫京都。暹遁走。天子假太祖节、钺〖11〗，录尚书事〖12〗。﹝二﹞洛阳残破，董昭等劝太祖都许〖13〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":261,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":89,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o143","section":"chapter-001","block":"b-87c7d8a437d7c846207e","layer":"original","quote":"昔者董卓初兴国难，群后释位以谋王室〖31〗；﹝四﹞君则摄进〖32〗，首启戎行〖33〗。此君之忠于本朝也。后及黄巾反易天常〖34〗，侵我三州〖35〗，延及平民；君又翦之以宁东夏〖36〗。此又君之功也。韩暹、杨奉专用威命；君则致讨，克黜其难，遂迁许都，造我京畿，设官兆祀〖37〗，不失旧物〖38〗，天地鬼神于是获乂〖39〗。此又君之功也。袁术僭逆〖40〗，肆于淮南；慑惮君灵，用丕显谋〖41〗，蕲阳之役〖42〗，桥蕤授首〖43〗，稜威南迈，术以陨溃。此又君之功也。回戈东征，吕布就戮；乘辕将返，张杨殂毙，眭固伏罪，张绣稽服〖44〗。此又君之功也。袁绍逆乱天常，谋危社稷，凭恃其众，称兵内侮〖45〗。当此之时，王师寡弱，天下寒心，莫有固志；君执大节〖46〗，精贯白日，奋其武怒，运其神策，致届官渡〖47〗，大歼丑类，﹝五﹞俾我国家拯于危坠。此又君之功也。济师洪河〖48〗，拓定四州〖49〗，袁谭、高幹，咸枭其首，海盗奔进，黑山顺轨〖50〗。此又君之功也。乌丸三种〖51〗，崇乱二世〖52〗，袁尚因之，逼据塞北；束马悬车〖53〗，一征而灭。此又君之功也。刘表背诞，不供贡职〖54〗；王师首路〖55〗，威风先逝，百城八郡〖56〗，交臂屈膝。此又君之功也。马超、成宜，同恶相济，滨据河、潼，求逞所欲；殄之渭南，献馘万计〖57〗，遂定边境，抚和戎狄。此又君之功也。鲜卑、丁零〖58〗，重译而至〖59〗；（单）〔箄〕于、白屋〖60〗，请吏率职〖61〗。此又君之功也。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":111,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":625,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o011b-q","section":"chapter-032","block":"b-50264f958d931f9c772f","layer":"original","quote":"杨奉、韩暹寇徐、扬间，先主邀击，尽斩之〖12〗。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":41,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":50,"end":74,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o011","section":"chapter-032","block":"b-50264f958d931f9c772f","layer":"original","quote":"先主与术相持经月，吕布乘虚袭下邳；下邳守将曹豹反，间迎布〖11〗，布虏先主妻子。先主转军海西。﹝二﹞杨奉、韩暹寇徐、扬间，先主邀击，尽斩之〖12〗。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":41,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":74,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-o012","section":"chapter-010","block":"b-e204c2e6a37c8c4659f5","layer":"original","quote":"建安元年，太祖击破黄巾。汉献帝自河东，还洛阳。太祖议奉迎，都许，或以“山东未平，韩暹、杨奉新将天子到洛阳，北连张杨，未可猝制〖1〗”。彧劝太祖曰：“〔昔晋文纳周襄王而诸侯景从〕〖2〗，高祖东伐为义帝缟素而天下归心〖3〗。自天子播越〖4〗，将军首倡义兵，徒以山东扰乱〖5〗，未能远赴关右；然犹分遣将帅，蒙险通使〖6〗；虽御难于外〖7〗，乃心无不在王室〖8〗：是将军匡天下之素志也〖9〗。今车驾旋轸〖10〗，〔东京榛芜〕；义士有存本之思，百姓感旧而增哀。诚因此时，奉主上以从民望，大顺也；秉至公以服雄杰，大略也；扶弘义以致英俊〖11〗，大德也。天下虽有逆节〖12〗，必不能为累〖13〗，明矣。韩暹、杨奉其敢为害！若不时定〖14〗，四方生心；后虽虑之，无及！”","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":57,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":327,"offset_unit":"unicode_code_point"},{"id":"zhangle-q-o039","section":"chapter-017","block":"b-326b70d27f4056f70d0f","layer":"original","quote":"徐晃字公明，河东杨人也。为郡吏。从车骑将军杨奉讨贼，有功，拜骑都尉。李傕、郭汜之乱长安也，晃说奉，令与天子还洛阳；奉从其计，天子渡河至安邑，封晃都亭侯。及到洛阳，韩暹、董承日争斗，晃说奉令归太祖。奉欲从之，后悔；太祖讨奉于梁，晃遂归太祖。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":144,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":119,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
