{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p086a","title":"王次仲创楷法","accounts":[{"id":"wudi-e-p086a-account","label":"卫恒《四体书势序》","text":"卫恒《四体书势序》称王次仲善隶书，始为楷法。","evidence":["wudi-e-p086a-q"]}],"participants":[{"person":"wudi-p0256","role":"创书法","evidence":["wudi-e-p086a-q"]}],"place":{"text":"上谷","evidence":["wudi-e-p086a-q"]},"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p086a-q"]},"source_order":[1,688,"P086a"],"order":280}],"persons":[{"id":"wudi-p0256","name":"王次仲","evidence":["wudi-q-p086"],"facts":[],"aliases":[],"mentions":[{"id":"wudi-m-p086-wudi-p0256","kind":"mention","text":"文中提及","evidence":["wudi-q-p086"]}]}],"evidence":[{"id":"wudi-e-p086a-q","section":"chapter-001","block":"b-648d7c68dbec5a605916","layer":"pei","quote":"上谷王次仲，善隶书，始为楷法。","attribution":"卫恒《四体书势序》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":12,"anchor":null},"note_id":"n-cf8a0075075368325cde","start":15,"end":30},{"id":"wudi-q-p086","section":"chapter-001","block":"b-648d7c68dbec5a605916","layer":"pei","quote":"﹝三﹞卫恒《四体书势序》曰：“上谷王次仲，善隶书，始为楷法。至灵帝好书，世多能者，而师宜官为最。甚矜其能，每书，辄削焚其札。梁鹄乃益为版而饮之酒，候其醉而窃其札。鹄卒以攻书至选部尚书。于是公欲为洛阳令，鹄以为北部尉。鹄后依刘表。及荆州平，公募求鹄；鹄惧，自缚诣门。署军假司马，使在秘书，以勤书自效。公常悬著帐中，及以钉壁玩之，谓胜宜官。鹄字孟黄，安定人。魏宫殿题署，皆鹄书也。”","attribution":"卫恒《四体书势序》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":12,"anchor":null},"note_id":"n-cf8a0075075368325cde","start":0,"end":189}],"profiles":{},"directory_counts":{}}
