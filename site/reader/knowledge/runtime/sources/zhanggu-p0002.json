:"zhangyan-q-47cf115473c2c3f50f42","order":9464},{"id":"zhangyan-e-85f4f9cddc0d227407d9","title":"孙权又试严畯骑，畯上马堕鞍","accounts":[{"id":"zhangyan-a-85f4f9cddc0d227407d9","label":"裴注·志林","text":"孙权又试严畯骑，畯上马堕鞍","evidence":["zhangyan-q-67c9411317152d11f035"]}],"participants":[{"person":"sun-quan","role":"试畯骑者","evidence":["zhangyan-q-67c9411317152d11f035"]},{"person":"zhanggu-p0002","role":"上马堕鞍者","evidence":["zhangyan-q-67c9411317152d11f035"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["zhangyan-q-67c9411317152d11f035"]},"ordering_evidence":"zhangyan-q-67c9411317152d11f035","order":9468},{"id":"zhangyan-e-b0d3338865a001cb443b","title":"严畯荐徵崇：行足以厉俗，学足以为师","accounts":[{"id":"zhangyan-a-b0d3338865a001cb443b","label":"裴注·吴录","text":"严畯荐徵崇：行足以厉俗，学足以为师","evidence":["zhangyan-q-7c99c592078c0b3fe575"]}],"participants":[{"person":"zhanggu-p0002","role":"荐者","evidence":["zhangyan-q-7c99c592078c0b3fe575"]},{"person":"zhangyan-p-c47f411925dca7","role":"被荐者","evidence":["zhangyan-q-7c99c592078c0b3fe575"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["zhangyan-q-7c99c592078c0b3fe575"]},"ordering_evidence":"zhangyan-q-7c99c592078c0b3fe575","order":9481},{"id":"zhulv-e-o162","title":"初，权移都建业，大会将相文武，（时）〔特〕谓严畯曰：孤昔叹鲁子敬比邓禹、吕子衡方吴汉，闻卿诸人未平此论，今定云何；畯退席曰：臣未解指趣，谓肃、范受饶，褒叹过实","accounts":[{"id":"zhulv-a-0a89956a8946274abbf4","label":"裴注·江表传","text":"初，权移都建业，大会将相文武，（时）〔特〕谓严畯曰：孤昔叹鲁子敬比邓禹、吕子衡方吴汉，闻卿诸人未平此论，今定云何；畯退席曰：臣未解指趣，谓肃、范受饶，褒叹过实","evidence":["zhulv-q-718fe1688f35a6985284"]},{"id":"zhulv-a-b3e98d8d7c06891b0c66","label":"裴注·江表传","text":"权曰：昔邓仲华初见光武，劝以复汉业，是禹开初议之端；子敬英爽有殊略，始与一语便及大计，与禹相似故比之；吕子衡忠笃亮直，性虽好奢然以忧公为先，避袁术自归于兄，忧兄事乞为都督，办护修整加之恪勤，与吴汉相类故方之；皆有指趣，非孤私之也；畯乃服","evidence":["zhulv-q-0c62f093d9133d8722ef"]}],"participants":[{"person":"sun-quan","role":"发论者；申论者","evidence":["zhulv-q-718fe1688f35a6985284","zhulv-q-0c62f093d9133d8722ef"]},{"person":"zhanggu-p0002","role":"退席对者；乃服者","evidence":["zhulv-q-718fe1688f35a6985284","zhulv-q-0c62f093d9133d8722ef"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["zhulv-q-718fe1688f35a6985284","zhulv-q-0c62f093d9133d8722ef"]},"ordering_evidence":"zhulv-q-718fe1688f35a6985284","source_order":[56,197,11],"order":10019}],"persons":[{"id":"zhanggu-p0002","name":"严畯","evidence":["zhanggu-q-d18f029142470954da4a","zhanggu-q-0806381e287156375677","zhulv-q-718fe1688f35a6985284","zhulv-q-0c62f093d9133d8722ef","zhangyan-q-8715acebc62d4946d88f","zhangyan-q-19535267089f588219c0","zhangyan-q-50ad21a6e38f9ddf5454","zhangyan-q-aa53815a810fafd5cf0b","zhangyan-q-8dfa24c4f6a62368f411","zhangyan-q-9635707181d0aa734e80","zhangyan-q-4f5fa951a0f86902f2f4","zhangyan-q-efc82cc414d465949675","zhangyan-q-886d6cb0730535d55ebe","zhangyan-q-e86f05f752cbd12c00b0","zhangyan-q-47cf115473c2c3f50f42","zhangyan-q-67c9411317152d11f035","zhangyan-q-7c99c592078c0b3fe575","zhangyan-q-9f0111f8a7f28382ccff","zhangyan-q-2d9e6a1d93a8f42f869b","zhangyan-q-1179e9ab33dcb164b490","zhangyan-q-118dd7b542a20ec2838a","zhangyan-q-aec1a426a8539d7e9b8c"],"facts":[{"id":"zhangyan-f-207196f1d7ca067f562b","text":"字曼才，彭城人","evidence":["zhangyan-q-9f0111f8a7f28382ccff"]},{"id":"zhangyan-f-4cd4f49049aaf666f080","text":"少耽学，善《诗》、《书》、三《礼》，又好《说文》","evidence":["zhangyan-q-9f0111f8a7f28382ccff"]},{"id":"zhangyan-f-9b473d7a549b0219288e","text":"与诸葛瑾、步骘齐名友善","evidence":["zhangyan-q-9f0111f8a7f28382ccff"]},{"id":"zhangyan-f-47bb1c5b16ac1c8ec1a0","text":"性质直纯厚；其于人物，忠告善导，志存补益","evidence":["zhangyan-q-9f0111f8a7f28382ccff"]},{"id":"zhangyan-f-268745ab1213b5408911","text":"固辞时发言慷慨，至于流涕；世嘉其能以实让","evidence":["zhangyan-q-2d9e6a1d93a8f42f869b"]},{"id":"zhangyan-f-4430d8e3076fb3401550","text":"不蓄禄赐，皆散之亲戚知故，家常不充","evidence":["zhangyan-q-1179e9ab33dcb164b490"]},{"id":"zhangyan-f-7e8acca89a50628d9be6","text":"《吴书》称畯时年七十八","evidence":["zhangyan-q-aec1a426a8539d7e9b8c"]}],"aliases":[],"mentions":[{"id":"zhanggu-m-7312690eb0dc73cbef98","kind":"mention","text":"本段涉及严畯","evidence":["zhanggu-q-69c49b727d00b321b52e","zhanggu-q-e04ac29cba45dc64dbdb","zhanggu-q-0596c31ce6387ff34892","zhanggu-q-5f211045471a25fc2444","zhanggu-q-f00afa6623cd827b5aff","zhanggu-q-5979a844ea9f6cc50318"]},{"id":"zhangyan-m-85a60deea16831ea03d4","kind":"mention","text":"陈寿评曰：严畯辞荣济旧，不亦长者乎","evidence":["zhangyan-q-118dd7b542a20ec2838a"]}]}],"evidence":[{"id":"zhanggu-q-0596c31ce6387ff34892","section":"chapter-052","block":"b-b150f524fed4051c8a1a","layer":"original","quote":"当世君子能不然者，亦比有之〖2〗，岂独古人乎？然论其绝异，未若顾豫章、诸葛使君、步丞相、严卫尉、张奋威之为美也〖3〗。《论语》言“夫子恂恂然善诱人〖4〗”，又曰“成人之美，不成人之恶”：豫章有之矣。“望之俨然〖5〗，即之也温〖6〗，听其言也厉〖7〗”：使君体之矣〖8〗。“恭而安〖9〗，威而不猛”：丞相履之矣。学不求禄，心无苟得〖10〗：卫尉、奋威蹈之矣。此五君者，虽德实有差〖11〗，轻重不同；至于趋舍大检〖12〗，不犯四者，俱一揆也〖13〗。","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":469,"anchor":null},"note_id":null,"start":0,"end":223},{"id":"zhanggu-q-0806381e287156375677","section":"chapter-052","block":"b-2bcb1aaf0f33a0c830be","layer":"pei","quote":"岁余，骘以疾免。与琅邪诸葛瑾、彭城严畯，俱游吴中，并著声名，为当时英俊","attribution":"裴注·吴书","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":382,"anchor":null},"note_id":"n-1f8d1b17142bb7732b67","start":10,"end":45},{"id":"zhanggu-q-5979a844ea9f6cc50318","section":"chapter-052","block":"b-741f7bb5edae3222195f","layer":"original","quote":"若乃经国家〖40〗，当军旅；于驰骛之际〖41〗，立霸王之功：此五〔君〕者未为过人。至其纯粹履道，求不苟得；升降当世，保全名行；邈然绝俗〖42〗，实有所师。故粗论其事，以示后之君子。","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":472,"anchor":null},"note_id":null,"start":0,"end":90},{"id":"zhanggu-q-5f211045471a25fc2444","section":"chapter-052","block":"b-145a6f5a67c459da712d","layer":"original","quote":"昔丁谞出于孤家〖14〗，吾粲由于牧竖〖15〗；豫章扬其善，以并陆、全之列〖16〗：是以人无幽滞而风俗厚焉〖17〗。使君、丞相、卫尉三君，昔以布衣俱相友善〖18〗，诸论者因各叙其优劣：初，先卫尉，次丞相，而后（有）使君也。其后并事明主，经营世务〖19〗；出处之才有不同〖20〗，先后之名须反其初〖21〗：此世常人所决勤薄也〖22〗。至于三君分好〖23〗，卒无亏损，岂非古人交哉！又鲁横江昔杖万兵〖24〗，屯据陆口，当世之美业也；能与不能，孰不愿焉〖25〗？而横江既亡，卫尉应其选；自以才非将帅，深辞固让，终于不就。后徙九列〖26〗，迁典八座〖27〗；荣不足以自曜，禄不足以自奉。至于二君〖28〗，皆位为上将，穷富极贵。卫尉既无求欲，二君又不称荐；各守所志，保其名好。孔子曰：","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":470,"anchor":null},"note_id":null,"start":0,"end":336},{"id":"zhanggu-q-69c49b727d00b321b52e","section":"chapter-052","block":"b-c30fe96f26c9dda6799c","layer":"original","quote":"颍川周昭，著书称步骘及严畯等曰","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":467,"anchor":null},"note_id":null,"start":0,"end":15},{"id":"zhanggu-q-d18f029142470954da4a","section":"chapter-052","block":"b-d56a4f4368be6994a519","layer":"original","quote":"权尝问卫尉严畯〖1〗：“宁念小时所*〔诵〕书不〖2〗？”畯因诵《孝经》“仲尼居〖3〗”。昭曰：“严畯鄙生〖4〗。臣请为陛下诵之。”乃诵“君子之事上〖5〗”，咸以昭为知所诵","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":52,"anchor":null},"note_id":null,"start":23,"end":108},{"id":"zhanggu-q-e04ac29cba45dc64dbdb","section":"chapter-052","block":"b-43ccad8a48b51ffa6b2f","layer":"original","quote":"古今贤士大夫所以失名丧身、倾家害国者，其由非一也。然要其大归〖1〗，总其常患，四者而已：急论议一也，争名势二也，重朋党三也，务欲速四也。急论议则伤人，争名势则败友，重朋党则蔽主，务欲速则失德。此四者不除，未有能全〔者〕也。","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":468,"anchor":null},"note_id":null,"start":0,"end":111},{"id":"zhanggu-q-f00afa6623cd827b5aff","section":"chapter-052","block":"b-e95888bc39a76aea9336","layer":"original","quote":"“君子矜而不争〖29〗，群而不党〖30〗。”斯有风矣。又奋威之名，亦三君之次也；当一方之戍，受上将之任，与使君、丞相不异也。然历国事，论功劳，实有先后，故爵位之荣殊焉〖31〗。而奋威将处此，决能明其部分；心无失道之欲〖32〗，事无充诎之求〖33〗；每升朝堂，循礼而动；辞气謇謇〖34〗，罔不惟忠。（叔嗣）〔元逊〕虽亲贵〖35〗，言忧其败；蔡文至虽疏贱〖36〗，谈称其贤。女配太子，受礼若吊〖37〗。慷慨之趋〖38〗，惟笃人物〖39〗；成败得失，皆如所虑。可谓守道见机，好古之士也。","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":471,"anchor":null},"note_id":null,"start":0,"end":240},{"id":"zhangyan-q-1179e9ab33dcb164b490","section":"chapter-053","block":"b-0adae5ebaaf66c834884","layer":"original","quote":"权为吴王，及称尊号，畯尝为卫尉。使至蜀，蜀相诸葛亮深善之。不蓄禄赐，皆散之亲戚知故〖6〗：家常不充。","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":79,"anchor":null},"note_id":null,"start":0,"end":50},{"id":"zhangyan-q-118dd7b542a20ec2838a","section":"chapter-053","block":"b-54c13977d6aeab18cd97","layer":"original","quote":"评曰：张纮文理意正，为世令器〖1〗；孙策待之，亚于张昭；诚有以也〖2〗。严、程、阚生，一时儒林也。至畯辞荣济旧〖3〗，不亦长者乎〖4〗？薛综学识规纳〖5〗，为吴良臣。及莹纂蹈〖6〗，允有先风〖7〗；然于暴酷之朝，屡登显列〖8〗：君子殆诸〖9〗。","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":363,"anchor":null},"note_id":null,"start":0,"end":122},{"id":"zhangyan-q-19535267089f588219c0","section":"chapter-053","block":"b-81b97b590a33c7685379","layer":"original","quote":"张昭进之于孙权，权以为骑都尉，从事中郎","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":78,"anchor":null},"note_id":null,"start":0,"end":19},{"id":"zhangyan-q-2d9e6a1d93a8f42f869b","section":"chapter-053","block":"b-81b97b590a33c7685379","layer":"original","quote":"张昭进之于孙权，权以为骑都尉，从事中郎〖3〗。及横江将军鲁肃卒〖4〗，权以畯代肃；督兵万人，镇据陆口。众人咸为畯喜，畯前后固辞：“朴素书生，不闲军事〖5〗；非才而据，咎悔必至！”发言慷慨，至于流涕。﹝一﹞权乃听焉，世嘉其能以实让。","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":78,"anchor":null},"note_id":null,"start":0,"end":115},{"id":"zhangyan-q-47cf115473c2c3f50f42","section":"chapter-053","block":"b-bc5ca8e4e139a99bc746","layer":"original","quote":"又与裴玄、张承论管仲、季路〖9〗：皆传于世","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":82,"anchor":null},"note_id":null,"start":14,"end":35},{"id":"zhangyan-q-4f5fa951a0f86902f2f4","section":"chapter-053","block":"b-05a38f3182213d614ba6","layer":"original","quote":"权怒，废畯，而颖得免罪","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":80,"anchor":null},"note_id":null,"start":72,"end":83},{"id":"zhangyan-q-50ad21a6e38f9ddf5454","section":"chapter-053","block":"b-81b97b590a33c7685379","layer":"original","quote":"权以畯代肃；督兵万人，镇据陆口。众人咸为畯喜，畯前后固辞：“朴素书生，不闲军事〖5〗；非才而据，咎悔必至！”发言慷慨，至于流涕。﹝一﹞权乃听焉，世嘉其能以实让","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":78,"anchor":null},"note_id":null,"start":35,"end":114},{"id":"zhangyan-q-67c9411317152d11f035","section":"chapter-053","block":"b-abd26152df20eac558be","layer":"pei","quote":"权又试畯骑，上马，堕鞍","attribution":"裴注·志林","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":98,"anchor":null},"note_id":"n-fec6d8659cf4b4edb8a2","start":10,"end":21},{"id":"zhangyan-q-7c99c592078c0b3fe575","section":"chapter-053","block":"b-618ebfaa7420bbb0f2fc","layer":"pei","quote":"严畯荐崇：‘行足以厉俗，学足以为师。’","attribution":"裴注·吴录","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":120,"anchor":null},"note_id":"n-4eae9e069757d1aeb120","start":93,"end":112},{"id":"zhangyan-q-8715acebc62d4946d88f","section":"chapter-053","block":"b-899ed8262fff3218cf6b","layer":"original","quote":"避乱江东","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":77,"anchor":null},"note_id":null,"start":42,"end":46},{"id":"zhangyan-q-886d6cb0730535d55ebe","section":"chapter-053","block":"b-33b91ab24f7db85d3aa1","layer":"original","quote":"后卒","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":81,"anchor":null},"note_id":null,"start":10,"end":12},{"id":"zhangyan-q-8dfa24c4f6a62368f411","section":"chapter-053","block":"b-0adae5ebaaf66c834884","layer":"original","quote":"使至蜀，蜀相诸葛亮深善之","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":79,"anchor":null},"note_id":null,"start":16,"end":28},{"id":"zhangyan-q-9635707181d0aa734e80","section":"chapter-053","block":"b-05a38f3182213d614ba6","layer":"original","quote":"畯亦驰语颖，使还谢权","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":80,"anchor":null},"note_id":null,"start":61,"end":71},{"id":"zhangyan-q-9f0111f8a7f28382ccff","section":"chapter-053","block":"b-899ed8262fff3218cf6b","layer":"original","quote":"严畯字曼才，彭城人也。少耽学，善《诗》、《书》、三《礼》〖1〗，又好《说文》〖2〗。避乱江东，与诸葛瑾、步骘，齐名友善。性质直纯厚；其于人物，忠告善导，志存补益。","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":77,"anchor":null},"note_id":null,"start":0,"end":81},{"id":"zhangyan-q-aa53815a810fafd5cf0b","section":"chapter-053","block":"b-0adae5ebaaf66c834884","layer":"original","quote":"权为吴王，及称尊号，畯尝为卫尉","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":79,"anchor":null},"note_id":null,"start":0,"end":15},{"id":"zhangyan-q-aec1a426a8539d7e9b8c","section":"chapter-053","block":"b-1e829440cf8b75eb41c8","layer":"pei","quote":"﹝二﹞《吴书》曰：“畯时年七十八。二子：凯、爽。凯官至升平少府。”","attribution":"裴注·吴书","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":99,"anchor":null},"note_id":"n-c6660077b03a8e5a41ec","start":0,"end":33},{"id":"zhangyan-q-e86f05f752cbd12c00b0","section":"chapter-053","block":"b-bc5ca8e4e139a99bc746","layer":"original","quote":"畯著《孝经传》、《潮水论》","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":82,"anchor":null},"note_id":null,"start":0,"end":13},{"id":"zhangyan-q-efc82cc414d465949675","section":"chapter-053","block":"b-33b91ab24f7db85d3aa1","layer":"original","quote":"以畯为尚书令","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":81,"anchor":null},"note_id":null,"start":3,"end":9},{"id":"zhulv-q-0c62f093d9133d8722ef","section":"chapter-056","block":"b-062d7325abf3106e2a61","layer":"pei","quote":"昔邓仲华初见光武：光武时受更始使，抚河北，行大司马事耳，未有帝王志也。禹劝之以复汉业，是禹开初议之端矣。子敬英爽有殊略，孤始与一语，便及大计；与禹相似，故比之。吕子衡忠笃亮直，性虽好奢，然以忧公为先，不足为损。避袁术，自归于兄；兄作大将，别领部曲，故忧兄事，乞为都督；办护修整，加之恪勤，与吴汉相类：故方之。皆有指趣，非孤私之也。’畯乃服","attribution":"裴注·江表传","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":196,"anchor":null},"note_id":"n-863d18fd3a14ad5facfd","start":100,"end":269},{"id":"zhulv-q-718fe1688f35a6985284","section":"chapter-056","block":"b-062d7325abf3106e2a61","layer":"pei","quote":"初，权移都建业，大会将相文武，（时）〔特〕谓严畯曰：‘孤昔叹鲁子敬比邓禹，吕子衡方吴汉；闻卿诸人，未平此论：今定云何？’畯退席曰：‘臣未解指趣，谓肃、范受饶，褒叹过实","attribution":"裴注·江表传","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":196,"anchor":null},"note_id":"n-863d18fd3a14ad5facfd","start":11,"end":94}],"profiles":{},"directory_counts":{}}
