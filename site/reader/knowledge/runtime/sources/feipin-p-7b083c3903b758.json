13b"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["feipin-q-c95e0ec49d3ab7c3413b"]},"ordering_evidence":"feipin-q-c95e0ec49d3ab7c3413b","order":9052}],"persons":[{"id":"feipin-p-7b083c3903b758","name":"徐琨","evidence":["feipin-q-fdc9c75b801369e69e7a","feipin-q-4ada0b2c7053703d4bfe","feipin-q-3f3a88590536b01cef40","feipin-q-c95e0ec49d3ab7c3413b","feipin-q-3bebc6a541b342609073","feipin-q-5b2e6a9e47cae4430fe9"],"facts":[],"mentions":[],"aliases":[]}],"evidence":[{"id":"feipin-q-3bebc6a541b342609073","section":"chapter-050","block":"b-1644b583470b219bfb40","layer":"original","quote":"琨少仕州郡。汉末扰乱，去吏。随坚征伐有功，拜偏将军。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":41,"anchor":null},"note_id":null,"start":0,"end":26},{"id":"feipin-q-3f3a88590536b01cef40","section":"chapter-050","block":"b-c02a68458d713f31abe6","layer":"original","quote":"后从讨黄祖，中流矢，卒。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":43,"anchor":null},"note_id":null,"start":0,"end":12},{"id":"feipin-q-4ada0b2c7053703d4bfe","section":"chapter-050","block":"b-d06c9af07564f47819b4","layer":"original","quote":"琨以督军中郎将领兵。从破庐江太守李术〖4〗，封广德侯，迁平虏将军〖5〗。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":42,"anchor":null},"note_id":null,"start":32,"end":68},{"id":"feipin-q-5b2e6a9e47cae4430fe9","section":"chapter-050","block":"b-1644b583470b219bfb40","layer":"original","quote":"坚薨，随孙策讨樊能、于麋等于横江，击张英于当利口〖1〗；而船少，欲驻军更求。琨母时在军中，谓琨曰：“恐州家多发水军来逆人〖2〗，则不利矣，如何可驻邪！宜伐芦苇以为泭〖3〗，佐船渡军。”﹝一﹞琨具启策，策即行之，众悉俱济；遂破英，击走笮融、刘繇。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":41,"anchor":null},"note_id":null,"start":26,"end":148},{"id":"feipin-q-c95e0ec49d3ab7c3413b","section":"chapter-050","block":"b-3eaf1898ebcd8c6c9646","layer":"pei","quote":"﹝二﹞《江表传》曰：“初，袁术遣从弟胤为丹杨；策令琨讨而代之。会景还，以景前在（仕）丹杨，宽仁得众，吏民所思；而琨手下兵多，策嫌其太重；且方攻伐，宜得琨众；乃复用景，召琨还吴。”","attribution":"裴注·江表传","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":62,"anchor":null},"note_id":"n-b17f0b48b9116e4fdf34","start":0,"end":89},{"id":"feipin-q-fdc9c75b801369e69e7a","section":"chapter-050","block":"b-d06c9af07564f47819b4","layer":"original","quote":"事业克定，策表琨领丹杨太守。会吴景委广陵来东，复为丹杨守；﹝二﹞","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":42,"anchor":null},"note_id":null,"start":0,"end":32}],"profiles":{},"directory_counts":{}}
