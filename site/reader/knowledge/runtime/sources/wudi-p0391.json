{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p143b","title":"宗子卿说释太守后围侯音","accounts":[{"id":"wudi-e-p143b-account","label":"《曹瞒传》","text":"宗子卿劝侯音释放东里衮，后夜逃与太守收民围侯音，曹仁军到后共同灭之。","evidence":["wudi-e-p143b-q"]}],"participants":[{"person":"wudi-p0391","role":"说释放后围攻","evidence":["wudi-e-p143b-q"]},{"person":"wudi-p0382","role":"释人后败亡","evidence":["wudi-e-p143b-q"]},{"person":"wudi-p0390","role":"获释围攻","evidence":["wudi-e-p143b-q"]},{"person":"cao-ren","role":"合击","evidence":["wudi-e-p143b-q"]}],"place":{"text":"宛","evidence":["wudi-e-p143b-q"]},"time":{"label":"侯音起事至曹仁到宛","precision":"relative","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p143b-q"],"after":"wudi-e-o193a"},"source_order":[1,1111,"P143b"],"order":433}],"persons":[{"id":"wudi-p0391","name":"宗子卿","evidence":["wudi-q-p143"],"facts":[],"aliases":[],"mentions":[{"id":"wudi-m-p143-wudi-p0391","kind":"mention","text":"文中提及","evidence":["wudi-q-p143"]}]}],"evidence":[{"id":"wudi-e-p143b-q","section":"chapter-001","block":"b-7b243201ddfe4ecaad10","layer":"pei","quote":"南阳功曹宗子卿，往说音曰：‘足下顺民心，举大事，远近莫不望风；然执郡将，逆而无益；何不遣之？吾与子共戮力。比曹公军来，关羽兵亦至矣。’音从之，即释遣太守。子卿因夜逾城亡出，遂与太守收余民，围音。会曹仁军至，共灭之。","attribution":"《曹瞒传》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":435,"anchor":null},"note_id":"n-8fe895a36710c7eeb225","start":48,"end":155},{"id":"wudi-q-p143","section":"chapter-001","block":"b-7b243201ddfe4ecaad10","layer":"pei","quote":"﹝一﹞《曹瞒传》曰：“是时，南阳间苦徭役。音于是执太守东里（裦）〔衮〕，与吏民共反，与关羽连和。南阳功曹宗子卿，往说音曰：‘足下顺民心，举大事，远近莫不望风；然执郡将，逆而无益；何不遣之？吾与子共戮力。比曹公军来，关羽兵亦至矣。’音从之，即释遣太守。子卿因夜逾城亡出，遂与太守收余民，围音。会曹仁军至，共灭之。”","attribution":"《曹瞒传》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":435,"anchor":null},"note_id":"n-8fe895a36710c7eeb225","start":0,"end":156}],"profiles":{},"directory_counts":{}}
