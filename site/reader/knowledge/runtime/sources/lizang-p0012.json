g-q-6110055c6d152e98af01"]},{"person":"liu-biao","role":"益礼宾硕","evidence":["lizang-q-6110055c6d152e98af01"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["lizang-q-6110055c6d152e98af01"]},"ordering_evidence":"lizang-q-6110055c6d152e98af01","source_order":[18,279,772],"order":3724},{"id":"lizang-e-o275","title":"《勇侠传》：顷之宾硕病亡，赵岐在南为行丧","accounts":[{"id":"lizang-a-e97242a863b2d3d2b209","label":"裴注·魏略《勇侠传》","text":"《勇侠传》：顷之宾硕病亡，赵岐在南为行丧","evidence":["lizang-q-f9f1f4410ec3f868dcd4"]}],"participants":[{"person":"lizang-p0012","role":"病亡","evidence":["lizang-q-f9f1f4410ec3f868dcd4"]},{"person":"xunyu-p0029","role":"为行丧","evidence":["lizang-q-f9f1f4410ec3f868dcd4"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["lizang-q-f9f1f4410ec3f868dcd4"]},"ordering_evidence":"lizang-q-f9f1f4410ec3f868dcd4","source_order":[18,279,826],"order":3725}],"persons":[{"id":"lizang-p0012","name":"孙宾硕","evidence":["lizang-q-3380758f45a14aae6f05","lizang-q-5ae1f45fba7fe6bddc65","lizang-q-791456f307e9b8c09f7c","lizang-q-6110055c6d152e98af01","lizang-q-f9f1f4410ec3f868dcd4"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[{"id":"lizang-q-3380758f45a14aae6f05","section":"chapter-018","block":"b-55531cdb96f8079c0577","layer":"pei","quote":"宾硕时年二十余，乘犊车，将骑入市。观见岐，疑其非常人也。因问之曰：‘自有饼邪？贩之邪？’岐曰：‘贩之。’宾硕曰：‘买几钱？卖几钱？’岐曰：‘买三十，卖亦三十。’宾硕曰：‘视处士之望，非似卖饼者，殆有故！’乃开车后户，顾所将两骑，令下马，扶上之。时岐以为是唐氏耳目也，甚怖，面失色。宾硕闭车后户，下前檐，谓之曰：‘视处士状貌，既非贩饼者；加今面色变动，即不有重怨，则当亡命。我北海孙宾硕也，阖门百口，又有百岁老母在堂，势能相度者也；终不相负，必语我以实！’岐乃俱告之","attribution":"裴注·魏略《勇侠传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":278,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-48d5c144befb35f43c2d","start":389,"end":621,"offset_unit":"unicode_code_point"},{"id":"lizang-q-5ae1f45fba7fe6bddc65","section":"chapter-018","block":"b-55531cdb96f8079c0577","layer":"pei","quote":"宾硕遂载岐驱归。住车门外，先入白母，言：‘今日出〔行〕，得死友在外，当来入拜。’乃出，延岐入，椎牛钟酒，快相娱乐。一二日，因载著别田舍，藏置复壁中","attribution":"裴注·魏略《勇侠传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":278,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-48d5c144befb35f43c2d","start":622,"end":695,"offset_unit":"unicode_code_point"},{"id":"lizang-q-6110055c6d152e98af01","section":"chapter-018","block":"b-55531cdb96f8079c0577","layer":"pei","quote":"至兴平中，赵岐以太仆、持节使，安慰天下，南诣荆州；乃复与宾硕相遇，相对流涕。岐为刘表陈其本末，由是益礼宾硕","attribution":"裴注·魏略《勇侠传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":278,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-48d5c144befb35f43c2d","start":772,"end":825,"offset_unit":"unicode_code_point"},{"id":"lizang-q-791456f307e9b8c09f7c","section":"chapter-018","block":"b-55531cdb96f8079c0577","layer":"pei","quote":"初平末，宾硕以东方饥荒，南客荆州","attribution":"裴注·魏略《勇侠传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":278,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-48d5c144befb35f43c2d","start":755,"end":771,"offset_unit":"unicode_code_point"},{"id":"lizang-q-f9f1f4410ec3f868dcd4","section":"chapter-018","block":"b-55531cdb96f8079c0577","layer":"pei","quote":"顷之，宾硕病亡；岐在南，为行丧也","attribution":"裴注·魏略《勇侠传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":278,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-48d5c144befb35f43c2d","start":826,"end":842,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
