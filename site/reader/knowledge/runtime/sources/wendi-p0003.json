tlepage_0009.xhtml","index":25,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1aa19f6feba4e668650c","start":0,"end":17,"offset_unit":"unicode_code_point"},{"id":"wendi-q-b-ec88012a7f6c352d0e04","section":"chapter-002","block":"b-ec88012a7f6c352d0e04","layer":"modern","quote":"〖1〗二年：黄初二年（公元 221）。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":210,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8fff547b113ffa36bbc1","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wendi-q-o002","section":"chapter-002","block":"b-1c3ea4f0ea338bf2ec5a","layer":"original","quote":"太祖崩，嗣位为丞相，魏王。﹝三﹞尊王后曰王太后〖5〗。改建安二十五年为延康元年。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":2,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":40,"offset_unit":"unicode_code_point"},{"id":"wendi-q-o004","section":"chapter-002","block":"b-b0d3c82e3d1c42e2cd0c","layer":"original","quote":"初，汉熹平五年〖8〗，黄龙现谯〖9〗。光禄大夫桥玄问太史令单飏〖10〗：“此何祥也〖11〗？”飏曰：“其国，后当有王者兴。不及五十年〖12〗，亦当复现。天事恒象〖13〗，此其应也。”内黄殷登默而记之。至四十五年，登尚在。三月，黄龙现谯，登闻之曰：“单飏之言，其验兹乎！”﹝二﹞","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":15,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":138,"offset_unit":"unicode_code_point"},{"id":"wendi-q-o019","section":"chapter-002","block":"b-8820e5c7f9006d364c44","layer":"original","quote":"二年春正月〖1〗，郊祀天地、明堂〖2〗。甲戌〖3〗，校猎至原陵〖4〗。遣使者，以太牢祠汉世祖〖5〗。乙亥〖6〗，朝日于东郊〖7〗。﹝一﹞初令郡国口满十万者〖8〗，岁察孝廉一人；其有秀异〖9〗，无拘户口。辛巳〖10〗，分三公户邑，封子弟各一人为列侯。壬午〖11〗，复颍川郡一年田租〖12〗。﹝二﹞改许县为许昌县。以魏郡东部为阳平郡〖13〗，西部为广平郡〖14〗。﹝三﹞","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":208,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":183,"offset_unit":"unicode_code_point"},{"id":"wendi-q-p006","section":"chapter-002","block":"b-f7612b0655e228a2ddf4","layer":"pei","quote":"﹝二﹞《魏书》曰：“王召见登，谓之曰：‘昔成风闻楚丘之繇，而敬事季友；邓晨信少公之言，而自纳光武。登以笃老，服膺占术；记识天道，岂有是乎！’赐登谷三百斛，遣归家。”","attribution":"裴注·魏书","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":36,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a0ddb3724c0beca9ae0f","start":0,"end":82,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
