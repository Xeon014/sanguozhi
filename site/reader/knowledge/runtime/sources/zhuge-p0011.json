ntions":[{"id":"zhuge-m-p004-zhuge-p0011","kind":"mention","text":"文中提及","evidence":["zhuge-q-p004"]},{"id":"zhuge-m-p006-zhuge-p0011","kind":"mention","text":"文中提及","evidence":["zhuge-q-p006"]}]}],"evidence":[{"id":"liusima-q-478b4e688807d9582709","section":"chapter-015","block":"b-ebe6e961a0acc51041fa","layer":"pei","quote":"亮后出祁山，答司马宣王书，使杜子绪宣意于公威也","attribution":"裴注·魏略","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":226,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-236f3205e9503042f77c","start":24,"end":47,"offset_unit":"unicode_code_point"},{"id":"liusima-q-bf745822cdbd5a1970cc","section":"chapter-015","block":"b-c2c71df5c52e87c529c2","layer":"original","quote":"恢卒后，汝南孟建为凉州刺史，有治名。官至征东将军。﹝一﹞","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":209,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":28,"offset_unit":"unicode_code_point"},{"id":"zhuge-e-p004a-q","section":"chapter-035","block":"b-2799031265eb93da80f4","layer":"pei","quote":"《魏略》曰：“亮在荆州，以建安初，与颍川石广元，徐元直、汝南孟公威等俱游学。三人务于精熟，而亮独观其大略。每晨夜从容，常抱膝长啸，而谓三人曰：‘卿三人仕进，可至刺史、郡守也。’三人问其‘所至’，亮但笑而不言。后公威思乡里，欲北归；亮谓之曰：‘中国饶士大夫，邀游何必故乡邪！’”","attribution":"《魏略》","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":26,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-e40ccd03a9bef78547a3","start":0,"end":138,"offset_unit":"unicode_code_point"},{"id":"zhuge-f0005-q","section":"chapter-035","block":"b-f92972e0a4d6dea82fc9","layer":"pei","quote":"公威名建","attribution":"裴注","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":28,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-e40ccd03a9bef78547a3","start":0,"end":4,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-p004","section":"chapter-035","block":"b-2799031265eb93da80f4","layer":"pei","quote":"《魏略》曰：“亮在荆州，以建安初，与颍川石广元，徐元直、汝南孟公威等俱游学。三人务于精熟，而亮独观其大略。每晨夜从容，常抱膝长啸，而谓三人曰：‘卿三人仕进，可至刺史、郡守也。’三人问其‘所至’，亮但笑而不言。后公威思乡里，欲北归；亮谓之曰：‘中国饶士大夫，邀游何必故乡邪！’”","attribution":"《魏略》","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":26,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-e40ccd03a9bef78547a3","start":0,"end":138,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-p006","section":"chapter-035","block":"b-f92972e0a4d6dea82fc9","layer":"pei","quote":"公威名建，在魏亦贵达。","attribution":"裴注","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":28,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-e40ccd03a9bef78547a3","start":0,"end":11,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
