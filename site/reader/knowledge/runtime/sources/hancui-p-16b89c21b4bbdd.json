:["xuhuwang-q-3bb3db908960d24ea35d"]},{"person":"wudi-p0227","role":"解说","evidence":["xuhuwang-q-3bb3db908960d24ea35d"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["xuhuwang-q-3bb3db908960d24ea35d"]},"ordering_evidence":"xuhuwang-q-3bb3db908960d24ea35d","order":5283}],"persons":[{"id":"hancui-p-16b89c21b4bbdd","name":"赵达（曹操校事）","evidence":["hancui-q-16b08bf8b516e5d4718e","hancui-q-adae275647ef2c358043","xuhuwang-q-3bb3db908960d24ea35d"],"facts":[],"mentions":[],"aliases":[]}],"evidence":[{"id":"hancui-q-16b08bf8b516e5d4718e","section":"chapter-024","block":"b-ca0db377e40bbc65c985","layer":"original","quote":"达等后奸利发〖18〗，太祖杀之以谢于柔〖19〗。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":169,"anchor":null},"note_id":null,"start":0,"end":24},{"id":"hancui-q-adae275647ef2c358043","section":"chapter-024","block":"b-ac303c3f94236bea936d","layer":"original","quote":"时置校事卢洪、赵达等，使察群下。柔谏曰：“设官分职，各有所司。今置校事，既非居上信下之旨；又达等数以憎爱擅作威福，宜检治之。”太祖曰：“卿知达等，恐不如吾也。要能刺举而办众事〖16〗，使贤人君子为之，则不能也。昔叔孙通用群盗〖17〗，良有以也。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":168,"anchor":null},"note_id":null,"start":14,"end":136},{"id":"xuhuwang-q-3bb3db908960d24ea35d","section":"chapter-027","block":"b-2e024074e9b50ad3a209","layer":"original","quote":"时科禁酒〖3〗，而邈私饮至于沉醉。校事赵达问以曹事〖4〗，邈曰：“中圣人〖5〗。”达白之太祖，太祖甚怒。度辽将军鲜于辅进曰〖6〗：“平日醉客谓酒清者为‘圣人’，浊者为‘贤人’。邈性修慎，偶醉言耳。”竟坐〖7〗，得免刑。","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":2,"anchor":null},"note_id":null,"start":0,"end":109}],"profiles":{},"directory_counts":{}}
