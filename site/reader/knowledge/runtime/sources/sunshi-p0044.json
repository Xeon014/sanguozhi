o003d-q"]},"ordering_evidence":"zhouyu-e-o003d-q","source_order":[54,4,"O003d"],"related_events":[{"event":"zhulv-e2-wu056-031","type":"related","evidence":["zhulv-q-404bf8a47a0d895284ae","zhouyu-e-o003d-q"]}],"order":9565}],"persons":[{"id":"sunshi-p0044","name":"樊能","evidence":["sunshi-q-o027","yaoci-q-db4f64b5e1c7f56c6428","yaoci-q-744cdbd572e355e2c817","yaoci-q-9bab4d421cb031da45ea","zongshi-q-625855e81c675855603e","zongshi-q-24851ba16439c74c06ab"],"facts":[],"aliases":[],"mentions":[{"id":"sunshi-m-o027-sunshi-p0044","kind":"mention","text":"文中提及","evidence":["sunshi-q-o027"]},{"id":"sunshi-m-p037-sunshi-p0044","kind":"mention","text":"文中提及","evidence":["sunshi-q-p037"]}]}],"evidence":[{"id":"sunshi-e-o027b-q","section":"chapter-046","block":"b-1538e7ae2754e5a06f87","layer":"original","quote":"繇遣樊能、于麋（陈横屯江津）〔屯横江〕〖23〗，张英屯当利口〖24〗，以拒术。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":179,"anchor":null},"note_id":null,"start":81,"end":120},{"id":"sunshi-e-p037e-q","section":"chapter-046","block":"b-8ad4a2f852325dd4ff74","layer":"pei","quote":"而樊能、于麋等，复合众，袭夺牛渚屯。策闻之，还攻破能等，获男女万余人。","attribution":"《江表传》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":248,"anchor":null},"note_id":"n-6fa39d8ee05c62716a11","start":106,"end":141},{"id":"sunshi-q-o027","section":"chapter-046","block":"b-1538e7ae2754e5a06f87","layer":"original","quote":"先是，刘繇为扬州刺史〖20〗，州旧治寿春。寿春，术已据之；繇乃渡江，治曲阿。时吴景尚在丹杨，策从兄贲又为丹杨都尉〖21〗；繇至，皆迫逐之。景、贲退舍历阳〖22〗。繇遣樊能、于麋（陈横屯江津）〔屯横江〕〖23〗，张英屯当利口〖24〗，以拒术。术自用故吏琅邪惠衢为扬州刺史〖25〗，更以景为督军中郎将〖26〗；与贲共将兵击英等，连年不克。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":179,"anchor":null},"note_id":null,"start":0,"end":167},{"id":"sunshi-q-p037","section":"chapter-046","block":"b-8ad4a2f852325dd4ff74","layer":"pei","quote":"﹝二﹞《江表传》曰：“策渡江，攻繇牛渚营，尽得邸阁粮谷、战具。是岁兴平二年也。时彭城相薛礼、下邳相笮融，依繇为盟主；礼据秣陵城，融屯县南。策先攻融，融出兵交战；斩首五百余级，融即闭门，不敢动。因渡江攻礼，礼突走；而樊能、于麋等，复合众，袭夺牛渚屯。策闻之，还攻破能等，获男女万余人。复下攻融，为流矢所中，伤股；不能乘马，因自舆，还牛渚营。或叛告融曰：‘孙郎被箭，已死！’融大喜，即遣将于兹向策。策遣步骑数百挑战，设伏于后。贼出击之，锋刃未接而伪走；贼追入伏中，乃大破之，斩首千余级。策因往到融营下，令左右大呼曰：‘孙郎竟云何！’贼于是惊怖，夜遁。融闻策尚在，更深沟高垒，缮治守备。策以融所屯地势险固，乃舍去；攻破繇别将于海陵，转攻湖孰、江乘，皆下之。”","attribution":"《江表传》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":248,"anchor":null},"note_id":"n-6fa39d8ee05c62716a11","start":0,"end":326},{"id":"xunyu-q-b-c63b764c8d77474949e4","section":"chapter-010","block":"b-c63b764c8d77474949e4","layer":"modern","quote":"〖11〗二年：兴平二年（公元 195）。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":38,"anchor":null},"note_id":"n-c70b78b19d5fc0e5d4ef","start":0,"end":20},{"id":"xunyu-q-o009","section":"chapter-010","block":"b-867468e927405dc6280f","layer":"original","quote":"二年夏〖11〗，太祖军乘氏。大饥，人相食。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":26,"anchor":null},"note_id":null,"start":0,"end":21},{"id":"yaoci-q-744cdbd572e355e2c817","section":"chapter-049","block":"b-9c3ec449339241f9608c","layer":"original","quote":"于是术乃自置扬州刺史，与景、贲并力攻英、能等，岁余不下","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":3,"anchor":null},"note_id":null,"start":104,"end":131},{"id":"yaoci-q-9bab4d421cb031da45ea","section":"chapter-049","block":"b-b11e4525d5674fad5f88","layer":"original","quote":"孙策东渡〖18〗，破英、能等","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":4,"anchor":null},"note_id":null,"start":0,"end":14},{"id":"yaoci-q-db4f64b5e1c7f56c6428","section":"chapter-049","block":"b-9c3ec449339241f9608c","layer":"original","quote":"繇遣樊能、张英，屯江边以拒之","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":3,"anchor":null},"note_id":null,"start":73,"end":87},{"id":"zhouyu-e-o003d-q","section":"chapter-054","block":"b-31b40d63d1cd4e25427e","layer":"original","quote":"转下湖孰、江乘〖8〗，进入曲阿，刘繇奔走：而策之众已数万矣。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":3,"anchor":null},"note_id":null,"start":65,"end":95},{"id":"zhulv-q-404bf8a47a0d895284ae","section":"chapter-056","block":"b-03a8558afb4d94614edf","layer":"original","quote":"后从策攻破庐江。还，俱东渡；到横江、当利，破张英、于麋，下小丹杨、湖孰〖9〗，领湖孰相","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":150,"anchor":null},"note_id":null,"start":0,"end":43},{"id":"zhulv-q-769b6b6dcac67d39e310","section":"chapter-056","block":"b-03a8558afb4d94614edf","layer":"original","quote":"策定秣陵、曲阿，收笮融、刘繇余众；增范兵二千，骑五十匹","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":150,"anchor":null},"note_id":null,"start":48,"end":75},{"id":"zongshi-q-24851ba16439c74c06ab","section":"chapter-051","block":"b-e5ea2fea4c6316384cb1","layer":"original","quote":"及策东渡，助贲、景破英、能等；遂进击刘繇，繇走豫章","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":94,"anchor":null},"note_id":null,"start":120,"end":145},{"id":"zongshi-q-625855e81c675855603e","section":"chapter-051","block":"b-e5ea2fea4c6316384cb1","layer":"original","quote":"术复使贲与吴景，共击樊能、张英等，未能拔","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":94,"anchor":null},"note_id":null,"start":99,"end":119}],"profiles":{},"directory_counts":{}}
