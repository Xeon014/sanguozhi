{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"hechang-e-217378b08cec810ba0df","title":"曹丕收杨俊，杨俊之死","accounts":[{"id":"hechang-a-217378b08cec810ba0df","label":"正文","text":"黄初三年曹丕收杨俊司马懿王象苟纬请救不许杨俊自杀","evidence":["hechang-q-ba2cc62f0a8fcbcaa694"]},{"id":"hechang-a-e7a0462d11b6225c5dd5","label":"裴注引《魏略》","text":"《魏略》述杨俊被收，王象叩谏不济","evidence":["hechang-q-d5d28ae82e54076a161a"]}],"participants":[{"person":"wudi-p0170","role":"收治拒救；处置者","evidence":["hechang-q-ba2cc62f0a8fcbcaa694","hechang-q-d5d28ae82e54076a161a"]},{"person":"cuimao-p0041","role":"自杀；被收杀者","evidence":["hechang-q-ba2cc62f0a8fcbcaa694","hechang-q-d5d28ae82e54076a161a"]},{"person":"wudi-p0364","role":"请救","evidence":["hechang-q-ba2cc62f0a8fcbcaa694"]},{"person":"xiahoucao-p0084","role":"请救；叩谏者","evidence":["hechang-q-ba2cc62f0a8fcbcaa694","hechang-q-d5d28ae82e54076a161a"]},{"person":"hechang-p-4295a500a06640","role":"请救","evidence":["hechang-q-ba2cc62f0a8fcbcaa694"]}],"place":null,"time":{"label":"黄初三年","precision":"undated","basis":"保留本条明文纪年；未审定对应公元年。","evidence":["hechang-q-ba2cc62f0a8fcbcaa694","hechang-q-d5d28ae82e54076a161a"]},"ordering_evidence":"hechang-q-ba2cc62f0a8fcbcaa694","order":4740}],"persons":[{"id":"hechang-p-4295a500a06640","name":"苟纬（杨俊请救者）","evidence":["hechang-q-ba2cc62f0a8fcbcaa694"],"facts":[],"mentions":[],"aliases":[]}],"evidence":[{"id":"hechang-q-ba2cc62f0a8fcbcaa694","section":"chapter-023","block":"b-9f843515ac2d0078199f","layer":"original","quote":"黄初三年，车驾至宛〖14〗，以市不丰乐，发怒收俊。尚书仆射司马宣王、常侍王象、苟纬请俊〖15〗，叩头流血；帝不许。俊曰：“吾知罪矣！”遂自杀。众冤痛之。﹝一﹞","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":169,"anchor":null},"note_id":null,"start":0,"end":79},{"id":"hechang-q-d5d28ae82e54076a161a","section":"chapter-023","block":"b-ae4bff4520e3cf6e72c3","layer":"pei","quote":"车驾南巡，未到宛，有诏：‘百官不得干豫郡县。’及车驾到，而宛令不解诏旨，闭市门。帝闻之，忿然曰：‘吾是寇邪？’乃收宛令及太守杨俊。诏问尚书：‘汉明帝杀几二千石？’时象见诏文，知俊必不免。乃当帝前叩头，流血竟面，请俊减死一等。帝不答，欲释，入禁中。象引帝衣，帝顾谓象曰：‘我知杨俊与卿本末耳。今听卿，是无我也！卿宁无俊邪？无我邪？’象以帝言切，乃缩手。帝遂入，决俊法，然后乃出。","attribution":"裴注引《魏略》","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":188,"anchor":null},"note_id":"n-782ce6c2a2abb258a623","start":171,"end":359}],"profiles":{},"directory_counts":{}}
