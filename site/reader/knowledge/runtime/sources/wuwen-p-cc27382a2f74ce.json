q-3de1bea44c3d5fa70bfc"]},"ordering_evidence":"wuwen-q-3de1bea44c3d5fa70bfc","order":3922}],"persons":[{"id":"wuwen-p-cc27382a2f74ce","name":"曹林","evidence":["wuwen-q-1dd977396dac2e7e571a","wuwen-q-dd3c15bb355f24cf7159","wuwen-q-1479672fde903f19a047","wuwen-q-41105697c083a1617791","wuwen-q-d3bd6ac15c34b2ef779e","wuwen-q-52b76afdd61408854724","wuwen-q-aa815ad6e71074e23e51","wuwen-q-30bddb8974e66808da12","wuwen-q-3de1bea44c3d5fa70bfc","wuwen-q-8d9bcc4e41697005dc97","wuwen-q-a1be9bd5faa5383881d7","wuwen-q-c2f55f326342aebf012b","wuwen-q-a78c9d4a27de80e8e854"],"facts":[{"id":"wuwen-f-34033255c0f6b24aacd6","text":"父为曹操；本传记母为杜夫人。","evidence":["wuwen-q-c2f55f326342aebf012b"]},{"id":"wuwen-f-a3820ba774e0b88002d7","text":"《嵇氏谱》记嵇康妻为曹林之子的女儿。","evidence":["wuwen-q-a78c9d4a27de80e8e854"]}],"mentions":[],"aliases":[]}],"evidence":[{"id":"mingdi-e-o046a-q","section":"chapter-003","block":"b-3ff5cbdc8f2c5963da4d","layer":"original","quote":"冬十月，己酉〖15〗，中山王衮薨〖16〗。壬申〖17〗，太白昼现。十一月，丁酉〖18〗，行幸许昌宫。﹝三﹞","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":295,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":53,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-b-e98ed256e58910694910","section":"chapter-003","block":"b-e98ed256e58910694910","layer":"modern","quote":"〖1〗三年：青龙三年（公元 235）。明帝将司马懿提升为太尉，使他让出大将军一职，出自深层次政治考量。太尉作为三公之首，品级地位虽然略高于大将军，但是在控制军事实权和亲近皇帝的程度上，却比不上后者。明帝是要为曹氏亲族的年轻将领腾出这一重要位置，与异姓元勋重臣进行力量平衡，从而保证皇权安定稳固。戊子：旧历初八日。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":297,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ddf87e6819a0a2dfe019","start":0,"end":156,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-o043","section":"chapter-003","block":"b-9b32a12fd737552ea52d","layer":"original","quote":"三年春正月，戊子〖1〗，以大将军司马宣王为太尉。己亥〖2〗。复置朔方郡。京都大疫。丁巳〖3〗，皇太后崩。乙亥〖4〗，陨石于寿光县〖5〗。三月，庚寅〖6〗，葬文德郭后。营陵于首阳陵涧西〖7〗，如终制。﹝一﹞","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":292,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":102,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-1479672fde903f19a047","section":"chapter-020","block":"b-788ef5a9be9349011465","layer":"original","quote":"黄初二年，进爵为公。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":54,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":28,"end":38,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-1dd977396dac2e7e571a","section":"chapter-020","block":"b-788ef5a9be9349011465","layer":"original","quote":"沛穆王林，建安十六年，封饶阳侯。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":54,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":16,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-30bddb8974e66808da12","section":"chapter-020","block":"b-788ef5a9be9349011465","layer":"original","quote":"景初、正元、景元中，累增邑；并前四千七百户。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":54,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":85,"end":107,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-3de1bea44c3d5fa70bfc","section":"chapter-020","block":"b-0cc2b4cf9dd0f8d6f1f3","layer":"original","quote":"三年秋，衮得疾病，诏遣太医视疾；殿中虎贲赍手诏、赐珍膳相属〖20〗；又遣太妃、沛王林并就省疾〖21〗。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":75,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":155,"end":206,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-41105697c083a1617791","section":"chapter-020","block":"b-788ef5a9be9349011465","layer":"original","quote":"三年〖9〗，为谯王。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":54,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":38,"end":48,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-52b76afdd61408854724","section":"chapter-020","block":"b-788ef5a9be9349011465","layer":"original","quote":"七年〖12〗，徙封鄄城。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":54,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":64,"end":76,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-8d9bcc4e41697005dc97","section":"chapter-020","block":"b-030c33f6ccff5bb0d90d","layer":"original","quote":"林薨，","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":55,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":3,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-a1be9bd5faa5383881d7","section":"chapter-020","block":"b-27a9ece946e7d4ac8dac","layer":"original","quote":"其年薨。诏沛王林留，讫葬；使大鸿胪持节典护丧事，宗正吊祭，赠赗甚厚。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":77,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":236,"end":270,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-a78c9d4a27de80e8e854","section":"chapter-020","block":"b-65e5abb9d44d86bfdc39","layer":"pei","quote":"﹝一﹞按《嵇氏谱》：“嵇康妻，林子之女也。”","attribution":"裴注引《嵇氏谱》","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":70,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-20a27d1636869c97ef3c","start":0,"end":22,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-aa815ad6e71074e23e51","section":"chapter-020","block":"b-788ef5a9be9349011465","layer":"original","quote":"太和六年，改封沛。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":54,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":76,"end":85,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-c2f55f326342aebf012b","section":"chapter-020","block":"b-87027621c423a4f13bd6","layer":"original","quote":"武皇帝二十五男：卞皇后生文皇帝、任城威王彰、陈思王植、萧怀王熊；刘夫人生丰愍王昂、相殇王铄；环夫人生邓哀王冲、彭城王据、燕王宇；杜夫人生沛穆王林、中山恭王衮；秦夫人生济阳怀王玹、陈留恭王峻；尹夫人生范阳闵王矩；王昭仪生赵王幹；孙姬生临邑殇公子上、楚王彪、刚殇公子勤；李姬生谷城殇公子乘、郿戴公子整、灵殇公子京；周姬生樊安公均；刘姬生广宗殇公子棘；宋姬生东平灵王徽；赵姬生乐陵王茂。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":1,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":190,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-d3bd6ac15c34b2ef779e","section":"chapter-020","block":"b-788ef5a9be9349011465","layer":"original","quote":"五年〖10〗，改封谯县〖11〗。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":54,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":48,"end":64,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-dd3c15bb355f24cf7159","section":"chapter-020","block":"b-788ef5a9be9349011465","layer":"original","quote":"二十二年〖8〗，徙封谯。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":54,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":16,"end":28,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
