{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"shaodi-e-o043a","title":"曹芳谒高平陵司马懿奏免曹爽兄弟","accounts":[{"id":"shaodi-e-o043a-account","label":"《三少帝纪》正文","text":"曹芳谒高平陵司马懿奏免曹爽兄弟","evidence":["shaodi-e-o043a-q"]},{"id":"xiahoucao-e-o066a-account","label":"《诸夏侯曹传第九》正文","text":"曹芳朝高平陵曹爽兄弟从行","evidence":["xiahoucao-e-o066a-q"]},{"id":"xiahoucao-e-o067a-account","label":"《诸夏侯曹传第九》正文","text":"司马懿据武库屯洛水奉太后令奏罢曹爽兄弟","evidence":["xiahoucao-e-o067a-q"]},{"id":"xiahoucao-e-o070a-account","label":"《诸夏侯曹传第九》正文","text":"许允陈泰劝曹爽归罪曹爽遣二人见司马懿罢官还第","evidence":["xiahoucao-e-o070a-q"]},{"id":"xiahoucao-e-p034b-account","label":"《世语》","text":"《世语》称许允陈泰传意，蒋济与书，尹大目以洛水誓言唯免官，曹爽信而罢兵。","evidence":["xiahoucao-e-p034b-q"]},{"id":"major-proof-a-jiangji","label":"蒋济传引《世语》","text":"《世语》记蒋济随司马宣王屯洛水浮桥，致书曹爽，传达仅免官的说法。","evidence":["major-proof-q-jiangji"]},{"id":"huanchen-a-dc9d0cc4e412bf8b99b7","label":"正文","text":"爽等见收宣王使毓行司隶校尉治其狱","evidence":["huanchen-q-19d51fe544f347ced97a"]},{"id":"chengguo-a-f3bfb4891b9aced5af21","label":"正文","text":"蒋济随司马懿屯洛水诛曹爽","evidence":["chengguo-q-c59fa9616fded7055827"]}],"participants":[{"person":"wendi-p0129","role":"谒陵","evidence":["shaodi-e-o043a-q"]},{"person":"wudi-p0364","role":"奏免","evidence":["shaodi-e-o043a-q"]},{"person":"mingdi-p0056","role":"被免","evidence":["shaodi-e-o043a-q"]},{"person":"shaodi-p0023","role":"被免","evidence":["shaodi-e-o043a-q"]},{"person":"shaodi-p0024","role":"被免","evidence":["shaodi-e-o043a-q"]},{"person":"shaodi-p0025","role":"被免","evidence":["shaodi-e-o043a-q"]},{"person":"shaodi-p0009","role":"奏请","evidence":["xiahoucao-e-o067a-q"]},{"person":"shaodi-p0036","role":"奏请","evidence":["xiahoucao-e-o067a-q"]},{"person":"mingdi-p0054","role":"令免","evidence":["xiahoucao-e-o067a-q"]},{"person":"shaodi-p0069","role":"说降","evidence":["xiahoucao-e-o070a-q"]},{"person":"shaodi-p0046","role":"说降","evidence":["xiahoucao-e-o070a-q"]},{"person":"xiahoucao-p0080","role":"誓说","evidence"