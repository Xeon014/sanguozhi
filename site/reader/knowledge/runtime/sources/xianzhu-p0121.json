-o035","title":"刘备称尊号以马良为侍中","accounts":[{"id":"dongliu-a-fb188727512f68fb3390","label":"正文","text":"刘备称尊号以马良为侍中","evidence":["dongliu-q-f5d41dfcb3b645b00ade"]}],"participants":[{"person":"liu-bei","role":"称尊号，以马良为侍中","evidence":["dongliu-q-f5d41dfcb3b645b00ade"]},{"person":"xianzhu-p0121","role":"受任侍中","evidence":["dongliu-q-f5d41dfcb3b645b00ade"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["dongliu-q-f5d41dfcb3b645b00ade"]},"ordering_evidence":"dongliu-q-f5d41dfcb3b645b00ade","source_order":[39,68,0],"order":7175}],"persons":[{"id":"xianzhu-p0121","name":"马良","evidence":["xianzhu-q-o068","dongliu-q-ff01bb38d7ddcf1c98e7","dongliu-q-8fa6cb5059a28fd6b12f","dongliu-q-32af7144ef2eb284f93c","dongliu-q-ccfc181bccac3d4aa3ff","dongliu-q-f917e66624abb2611d71","dongliu-q-a5a7e79329b0d387d618","dongliu-q-3d7058b34b870465afd5","dongliu-q-f5d41dfcb3b645b00ade","dongliu-q-1faec6e7da7aae6ba68f","dongliu-q-25211585ffcc2365b464","dongliu-q-85ca59c417355093e98c","dongliu-q2-778d785a27c5d756601c"],"facts":[],"aliases":[],"mentions":[{"id":"xianzhu-m-o068-xianzhu-p0121","kind":"mention","text":"文中提及","evidence":["xianzhu-q-o068"]},{"id":"dongliu-m2-role-ce35be98d10b3b34a94b","kind":"mention","text":"文中提及","evidence":["dongliu-q-85ca59c417355093e98c","dongliu-q2-778d785a27c5d756601c"]}]}],"evidence":[{"id":"chenghuang-q-b5bf74db1c826dfa961a","section":"chapter-055","block":"b-708161e3f591bac9e404","layer":"original","quote":"甘宁卒，又并其军。刘备出夷陵，璋与陆逊并力拒之。璋部下斩备护军冯习等〖11〗，所杀伤甚众。拜平北将军，襄阳太守","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":332,"anchor":null},"note_id":null,"start":0,"end":55},{"id":"dengzhang-q-412416358d4db55f12ea","section":"chapter-045","block":"b-4445e3e3e8a98a07754c","layer":"original","quote":"时又有义阳傅肜，先主退军，断后拒战。兵人死尽，吴将语肜令降。肜骂曰：“吴狗！何有汉将军降者！”遂战死","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":348,"anchor":null},"note_id":null,"start":28,"end":78},{"id":"dengzhang-q-44dded103d55f29ebfe9","section":"chapter-045","block":"b-b1ca2b95c1a4aed6d951","layer":"original","quote":"先主东征吴，习为领军，统诸军；大败于猇亭","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":347,"anchor":null},"note_id":null,"start":15,"end":35},{"id":"dengzhang-q-67e4f9b2b1bed056a47b","section":"chapter-045","block":"b-ae37311a660d50a1ec42","layer":"original","quote":"或告之曰：“后追已至！解船轻去，乃可以免。”畿曰：“吾在军，未曾为敌走〖10〗；况从天子而见危哉！”追人遂及畿船，畿身执戟战，敌船有覆者。众大至，共击之，乃死","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":356,"anchor":null},"note_id":null,"start":331,"end":410},{"id":"dengzhang-q-7b18684e8ffd04292b00","section":"chapter-045","block":"b-4445e3e3e8a98a07754c","layer":"original","quote":"领兵从先主征吴，与习俱死","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":348,"anchor":null},"note_id":null,"start":15,"end":27},{"id":"dengzhang-q-ef6e93679179b6c18260","section":"chapter-045","block":"b-48db56fffb91683be546","layer":"original","quote":"随先主征吴，军败于秭归，遇害","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":320,"anchor":null},"note_id":null,"start":49,"end":63},{"id":"dongliu-q-1faec6e7da7aae6ba68f","section":"chapter-039","block":"b-7239366a53921085f610","layer":"original","quote":"及东征吴，遣良入武陵，招纳五溪蛮夷；蛮夷渠帅皆受印号〖28〗，咸如意指","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":67,"anchor":null},"note_id":null,"start":12,"end":47},{"id":"dongliu-q-25211585ffcc2365b464","section":"chapter-039","block":"b-7239366a53921085f610","layer":"original","quote":"良亦遇害","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":67,"anchor":null},"note_id":null,"start":61,"end":65},{"id":"dongliu-q-32af7144ef2eb284f93c","section":"chapter-039","block":"b-4686344692214a1f3293","layer":"original","quote":"先主辟良为左将军掾","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":66,"anchor":null},"note_id":null,"start":0,"end":9},{"id":"dongliu-q-3d7058b34b870465afd5","section":"chapter-039","block":"b-4686344692214a1f3293","layer":"original","quote":"权敬待之","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":66,"anchor":null},"note_id":null,"start":157,"end":161},{"id":"dongliu-q-85ca59c417355093e98c","section":"chapter-039","block":"b-c63c79a2ef86a8c80a10","layer":"original","quote":"先主拜良子秉为骑都尉","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":68,"anchor":null},"note_id":null,"start":0,"end":10},{"id":"dongliu-q-8fa6cb5059a28fd6b12f","section":"chapter-039","block":"b-b78dae76878d5a1fc590","layer":"original","quote":"良留荆州，与亮书曰","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":65,"anchor":null},"note_id":null,"start":25,"end":34},{"id":"dongliu-q-a5a7e79329b0d387d618","section":"chapter-039","block":"b-4686344692214a1f3293","layer":"original","quote":"良即为草曰","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":66,"anchor":null},"note_id":null,"start":64,"end":69},{"id":"dongliu-q-c0644cd45cb4f702516d","section":"chapter-039","block":"b-7239366a53921085f610","layer":"original","quote":"会先主败绩于夷陵","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":67,"anchor":null},"note_id":null,"start":52,"end":60},{"id":"dongliu-q-ccfc181bccac3d4aa3ff","section":"chapter-039","block":"b-4686344692214a1f3293","layer":"original","quote":"后遣使吴","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":66,"anchor":null},"note_id":null,"start":10,"end":14},{"id":"dongliu-q-f5d41dfcb3b645b00ade","section":"chapter-039","block":"b-7239366a53921085f610","layer":"original","quote":"先主称尊号，以良为侍中","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":67,"anchor":null},"note_id":null,"start":0,"end":11},{"id":"dongliu-q-f917e66624abb2611d71","section":"chapter-039","block":"b-4686344692214a1f3293","layer":"original","quote":"良谓亮曰：“今衔国命〖18〗，协穆二家〖19〗；幸为良介于孙将军","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":66,"anchor":null},"note_id":null,"start":15,"end":47},{"id":"dongliu-q-ff01bb38d7ddcf1c98e7","section":"chapter-039","block":"b-b78dae76878d5a1fc590","layer":"original","quote":"先主领荆州，辟为从事","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":65,"anchor":null},"note_id":null,"start":0,"end":10},{"id":"dongliu-q2-61598741f218eb1409e1","section":"chapter-039","block":"b-b78dae76878d5a1fc590","layer":"original","quote":"先主领荆州，辟为从事。及先主入蜀，诸葛亮亦从后往；良留荆州，与亮书曰：“闻雒城已拔，此天祚也〖2〗。尊兄应期赞世〖3〗，配业光国〖4〗，魄兆现矣〖5〗。﹝一﹞夫变用雅虑〖6〗，审贵垂明〖7〗，于以简才〖8〗，宜适其时。若乃和光悦远〖9〗，迈德天壤〖10〗；使时闲于（听）〔德〕〖11〗，世服于道；齐高妙之音，正郑、卫之声〖12〗；并利于事，无相夺伦〖13〗：此乃管弦之至〖14〗，牙、旷之调也〖15〗。虽非钟期〖16〗，敢不击节〖17〗！”","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":65,"anchor":null},"note_id":null,"start":0,"end":220},{"id":"dongliu-q2-778d785a27c5d756601c","section":"chapter-039","block":"b-c63c79a2ef86a8c80a10","layer":"original","quote":"先主拜良子秉为骑都尉〖30〗。","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":68,"anchor":null},"note_id":null,"start":0,"end":15},{"id":"dongliu-q2-e38d1eaf62294955b45f","section":"chapter-039","block":"b-4686344692214a1f3293","layer":"original","quote":"先主辟良为左将军掾。后遣使吴，良谓亮曰：“今衔国命〖18〗，协穆二家〖19〗；幸为良介于孙将军〖20〗。”亮曰：“君试自为文。”良即为草曰：“寡君遣掾马良〖21〗，通聘继好，以绍昆吾、豕韦之勋〖22〗。其人吉士〖23〗，荆楚之令〖24〗；鲜于造次之华〖25〗，而有克终之美〖26〗。愿降心存纳〖27〗，以慰将命。”权敬待之。","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":66,"anchor":null},"note_id":null,"start":0,"end":162},{"id":"huangli-q-1cb5e0273ed0af39abc6","section":"chapter-043","block":"b-6f5d0f2c904adccd1410","layer":"original","quote":"先主东征，败绩猇亭","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":126,"anchor":null},"note_id":null,"start":0,"end":9},{"id":"huangli-q-3cfca8ff71f614717fb4","section":"chapter-043","block":"b-5d7b868f4daa79fd6c83","layer":"original","quote":"以权为镇北将军，督江北军以防魏师","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":12,"anchor":null},"note_id":null,"start":59,"end":75},{"id":"huangli-q-f120862d5699e9b578c9","section":"chapter-043","block":"b-0996c97d882e13e06732","layer":"original","quote":"及吴将军陆议乘流断围〖5〗，南军败绩，先主引退","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":13,"anchor":null},"note_id":null,"start":0,"end":23},{"id":"huowang-q-7c6eeec51538912b9b6d","section":"chapter-041","block":"b-e690691aa6a425fbd55b","layer":"original","quote":"秭归之败〖11〗，宠营特完","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":42,"anchor":null},"note_id":null,"start":13,"end":26},{"id":"luxun-e-o021b-q","section":"chapter-058","block":"b-485f5750e7c476ae4cfe","layer":"original","quote":"乃敕各持一把茅，以火攻拔之。一尔势成〖15〗，通率诸军同时俱攻；斩张南、冯习及胡王沙摩柯等首〖16〗，破其四十余营。备将杜路、刘宁等，穷逼请降。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":90,"anchor":null},"note_id":null,"start":34,"end":106},{"id":"wendi-e-o032a-q","section":"chapter-002","block":"b-4189701a92b124deb712","layer":"original","quote":"闰月〖26〗，孙权破刘备于夷陵〖27〗。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":285,"anchor":null},"note_id":null,"start":0,"end":20},{"id":"wendi-e-o033b-q","section":"chapter-002","block":"b-a5bf91c6f666aa87700c","layer":"original","quote":"八月，蜀大将黄权率众降〖2〗。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":320,"anchor":null},"note_id":null,"start":29,"end":44},{"id":"wuzhu-e-o055a-q","section":"chapter-047","block":"b-59fa99f2e0e3c37653aa","layer":"original","quote":"蜀军分据险地，前后五十余营；逊随轻重，以兵应拒。自正月至闰月〖4〗，大破之，临阵所斩及投兵降首数万人〖5〗；刘备奔走，仅以身免。﹝一﹞","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":294,"anchor":null},"note_id":null,"start":0,"end":67},{"id":"xianzhu-e-o068b-q","section":"chapter-032","block":"b-8136daaf302c35b9c188","layer":"original","quote":"二月，先主自秭归率诸将进军，缘山截岭，于夷道猇亭﹝二﹞驻营〖9〗。自佷山﹝三﹞通武陵〖10〗，遣侍中马良安慰五溪蛮夷〖11〗，咸相率响应。镇北将军黄权督江北诸军，与吴军相拒于夷陵道。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":401,"anchor":null},"note_id":null,"start":38,"end":129},{"id":"xianzhu-e-o069b-q","section":"chapter-032","block":"b-5398e8ba8cc35262f80d","layer":"original","quote":"后十余日，陆议大破先主军于犹亭；将军冯习、张南等皆没〖12〗。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":402,"anchor":null},"note_id":null,"start":20,"end":51},{"id":"xianzhu-q-b-e2b85eacbc16310809ee","section":"chapter-032","block":"b-e2b85eacbc16310809ee","layer":"modern","quote":"〖7〗二年：章武二年（公元 222）。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":413,"anchor":null},"note_id":"n-18295fa1c5ff11c612db","start":0,"end":19},{"id":"xianzhu-q-o068","section":"chapter-032","block":"b-8136daaf302c35b9c188","layer":"original","quote":"二年春正月〖7〗，先主军还秭归；将军吴班、陈式水军屯夷陵，夹江东西岸〖8〗。二月，先主自秭归率诸将进军，缘山截岭，于夷道猇亭﹝二﹞驻营〖9〗。自佷山﹝三﹞通武陵〖10〗，遣侍中马良安慰五溪蛮夷〖11〗，咸相率响应。镇北将军黄权督江北诸军，与吴军相拒于夷陵道。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":401,"anchor":null},"note_id":null,"start":0,"end":129},{"id":"zhulv-q-0f64e349b7617004ae8b","section":"chapter-056","block":"b-573074f8b77bb485b3b8","layer":"original","quote":"黄武元年，刘备举兵攻宜都；然督五千人，与陆逊并力拒备","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":57,"anchor":null},"note_id":null,"start":0,"end":26},{"id":"zhulv-q-91f98b8cef7e20d317da","section":"chapter-056","block":"b-573074f8b77bb485b3b8","layer":"original","quote":"然别攻破备前锋，断其后道：备遂破走","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":57,"anchor":null},"note_id":null,"start":27,"end":44},{"id":"zongshi-q-9d9cb181df7b17ae9deb","section":"chapter-051","block":"b-7798609de1816f91666c","layer":"original","quote":"与陆逊共拒刘备，备军众甚盛，弥山盈谷。桓投刀奋命，与逊戮力，备遂败走","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":221,"anchor":null},"note_id":null,"start":29,"end":63},{"id":"zongshi-q-a9b2efcfa5afd7f77f4c","section":"chapter-051","block":"b-b64d8aec66ed57f089fa","layer":"original","quote":"备逾山越险，仅乃得免，忿恚叹曰：“吾昔初至京城，桓尚小儿；而今迫孤，乃至此也","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":222,"anchor":null},"note_id":null,"start":0,"end":38},{"id":"zongshi-q-fd7d20b4b4223a4457f7","section":"chapter-051","block":"b-7798609de1816f91666c","layer":"original","quote":"桓斩上（兜）〔夔〕道〖2〗，截其径要","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":221,"anchor":null},"note_id":null,"start":64,"end":82}],"profiles":{"xianzhu-p0121":{"fields":[],"directory":{"faction":"shu"}}},"directory_counts":{}}
