{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-o069b","title":"陆议猇亭破刘备冯习张南战死","accounts":[{"id":"xianzhu-e-o069b-account","label":"《先主传》正文","text":"黄气记载后十余日，陆议大破刘备军，冯习、张南等战死。","evidence":["xianzhu-e-o069b-q"]},{"id":"wendi-e-o032a-account","label":"《文帝纪》正文","text":"黄初三年闰月，孙权于夷陵破刘备。","evidence":["wendi-e-o032a-q"]},{"id":"wuzhu-e-o055a-account","label":"《吴主传第二》正文","text":"陆逊破蜀诸营刘备败走","evidence":["wuzhu-e-o055a-q"]},{"id":"luxun-e-o021b-account","label":"《陆逊传第十三》正文","text":"陆议命持茅火攻诸军破营斩将受降","evidence":["luxun-e-o021b-q"]},{"id":"chenghuang-a-3031b7ed32ab7604e611","label":"正文","text":"夷陵璋与陆逊拒备部下斩冯习","evidence":["chenghuang-q-b5bf74db1c826dfa961a"]},{"id":"dongliu-a-c7afeeb23b4de680799c","label":"正文","text":"刘备败绩于夷陵","evidence":["dongliu-q-c0644cd45cb4f702516d"]},{"id":"dongliu-a-5e4b1a516e24db16a68e","label":"正文","text":"马良遇害","evidence":["dongliu-q-25211585ffcc2365b464"]},{"id":"huangli-a-bb675fc02dbdab33c5e7","label":"正文","text":"陆逊乘流断围，刘备败退","evidence":["huangli-q-f120862d5699e9b578c9"]},{"id":"huangli-a-274eedfab07c354b719a","label":"正文","text":"刘备东征败于猇亭","evidence":["huangli-q-1cb5e0273ed0af39abc6"]},{"id":"huowang-a-7b5a3f002fd86423db09","label":"正文","text":"秭归之败向宠营完","evidence":["huowang-q-7c6eeec51538912b9b6d"]},{"id":"dengzhang-a-49e31ae28921909ce18a","label":"正文","text":"王甫遇害于秭归","evidence":["dengzhang-q-ef6e93679179b6c18260"]},{"id":"dengzhang-a-ff96514ff8de3ca340a4","label":"正文","text":"冯习领军败于猇亭","evidence":["dengzhang-q-44dded103d55f29ebfe9"]},{"id":"dengzhang-a-017f531a3d582ce651bd","label":"正文","text":"张南与冯习俱死于吴役","evidence":["dengzhang-q-7b18684e8ffd04292b00"]},{"id":"dengzhang-a-357d786f386b0d8f580d","label":"正文","text":"傅肜断后战死","evidence":["dengzhang-q-412416358d4db55f12ea"]},{"id":"dengzhang-a-a54b080ee54598e42846","label":"正文","text":"程畿执戟战死","evidence":["dengzhang-q-67e4f9b2b1bed056a47b"]},{"id":"zongshi-a-666bb9805219e2b2d9cb","label":"正文","text":"桓与陆逊共拒刘备，备军众甚盛，弥山盈谷；桓投刀奋命，与逊戮力，备遂败走","evidence":["zongshi-q-9d9cb181df7b17ae9deb"]},{"id":"zongshi-a-088c90499934bf7962b3","label":"正文","text":"桓斩上（兜）〔夔〕道，截其径要","evidence":["zongshi-q-fd7d20b4b4223a4457f7"]},{"id":"zongshi-a-b0aad961acd2d86ec13c","label":"正文","text":"备逾山越险，仅乃得免，忿恚叹曰：吾昔初至京城，桓尚小儿，而今迫孤，乃至此也","evidence":["zongshi-q-a9b2efcfa5afd7f77f4c"]},{"id":"zhulv-a-ebb9f68c4650560ea6e3","label":"正文","text":"黄武元年，刘备举兵攻宜都；然督五千人，与陆逊并力拒备","evidence":["zhulv-q-0f64e349b7617004ae8b"]},{"id":"zhulv-a-c2041007383fddf1326a","label":"正文","text":"然别攻破备前锋，断其后道，备遂破走","evidence":["zhulv-q-91f98b8cef7e20d317da"]}],"participants":[{"person":"xianzhu-p0115","role":"破军","evidence":["xianzhu-e-o069b-q"]},{"person":"liu-bei","role":"败军","evidence":["xianzhu-e-o069b-q"]},{"person":"xianzhu-p0119","role":"战死","evidence":["xianzhu-e-o069b-q"]},{"person":"xianzhu-p0122","role":"战死","evidence":["xianzhu-e-o069b-q"]},{"person":"sun-quan","role":"破敌","evidence":["wendi-e-o032a-q"]},{"person":"luxun-p0021","role":"战死","evidence":["luxun-e-o021b-q"]},{"person":"luxun-p0022","role":"投降","evidence":["luxun-e-o021b-q"]},{"person":"luxun-p0023","role":"投降","evidence":["luxun-e-o021b-q"]},{"person":"zhouyu-p0055","role":"与陆逊并力拒刘备，部下斩冯习等","evidence":["chenghuang-q-b5bf74db1c826dfa961a"]},{"person":"xianzhu-p0121","role":"夷陵之败中遇害","evidence":["dongliu-q-25211585ffcc2365b464"]},{"person":"zhuge-p0029","role":"秭归之败中其营垒独完好","evidence":["huowang-q-7c6eeec51538912b9b6d"]},{"person":"dengzhang-p0044","role":"随先主征吴，军败于秭归，遇害","evidence":["dengzhang-q-ef6e93679179b6c18260"]},{"person":"luxun-p0020","role":"先主退军时断后拒战，兵人死尽，骂吴将曰吴狗何有汉将军降者，遂战死","evidence":["dengzhang-q-412416358d4db55f12ea"]},{"person":"dengzhang-p0047","role":"拒解船轻去之劝，称未曾为敌走况从天子而见危，身执戟战，敌船有覆者，众大至共击之，乃死","evidence":["dengzhang-q-67e4f9b2b1bed056a47b"]},{"person":"luxun-p0016","role":"投刀奋命者；截道者；迫备者（背景）","evidence":["zongshi-q-9d9cb181df7b17ae9deb","zongshi-q-fd7d20b4b4223a4457f7","zongshi-q-a9b2efcfa5afd7f77f4c"]},{"person":"mingdi-p0046","role":"督众拒备者；破前锋断道者","evid