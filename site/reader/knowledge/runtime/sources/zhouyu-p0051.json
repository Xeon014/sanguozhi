c60ded137a87a","shiyi-q-680dd08ada26846c8c0c","shiyi-q-55f815ea6d969387b315"],"facts":[{"id":"zhouyu-f0016","label":"字","text":"子太","evidence":["zhouyu-f0016-q"]},{"id":"dengzhang-f2-f03b092d020f5ea155db","text":"郝普官至廷尉。","evidence":["dengzhang-q2-621ef821fa1e8a5e550c"]}],"aliases":[{"text":"子太","evidence":["zhouyu-f0016-q"]}],"mentions":[{"id":"zhouyu-m-o081-zhouyu-p0051","kind":"mention","text":"文中提及","evidence":["zhouyu-q-o081"]},{"id":"zhouyu-m-o083-zhouyu-p0051","kind":"mention","text":"文中提及","evidence":["zhouyu-q-o083"]},{"id":"zhouyu-m-o098-zhouyu-p0051","kind":"mention","text":"文中提及","evidence":["zhouyu-q-o098"]},{"id":"zhouyu-m-o082-zhouyu-p0051","kind":"mention","text":"文中提及","evidence":["zhouyu-q-o082"]},{"id":"zhouyu-m-o084-zhouyu-p0051","kind":"mention","text":"文中提及","evidence":["zhouyu-q-o084"]},{"id":"wuzhu-m-o028-zhouyu-p0051","kind":"mention","text":"文中提及","evidence":["wuzhu-q-o028"]}]}],"evidence":[{"id":"chenghuang-q-8e91a90b14374430c121","section":"chapter-055","block":"b-0727a48d0bc130478c74","layer":"original","quote":"后随鲁肃镇益阳，拒关羽。羽号有三万人，自择选锐士五千人，投县上流十余里浅濑〖1〗，云“欲夜涉渡”。肃与诸将议。宁时有三百兵，乃曰：“可复以五百人益吾，吾往对之。保羽闻吾咳唾〖2〗，不敢涉水；涉水，即是吾擒！”肃便选千兵益宁，宁乃夜往。羽闻之，住不渡，而结柴营〖3〗。今遂名此处为“关羽濑","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":227,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":143,"offset_unit":"unicode_code_point"},{"id":"dengzhang-q-76c80cf8703e0b5cbe0c","section":"chapter-045","block":"b-bc84cd193f7c658fd4af","layer":"original","quote":"为吴将吕蒙所谲〖17〗，开城诣蒙","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":361,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":26,"end":42,"offset_unit":"unicode_code_point"},{"id":"dengzhang-q-94ea524720f53e73710a","section":"chapter-045","block":"b-bc84cd193f7c658fd4af","layer":"original","quote":"先主自荆州入蜀，以普为零陵太守","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":361,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":10,"end":25,"offset_unit":"unicode_code_point"},{"id":"dengzhang-q2-621ef821fa1e8a5e550c","section":"chapter-045","block":"b-51d41a232534f63df917","layer":"original","quote":"普至廷尉；濬至太常，封侯。","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":362,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":44,"end":57,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-68bd4c7e13290de845c9","section":"chapter-040","block":"b-08d2f565f2bb694ab4e3","layer":"original","quote":"建安二十年，权遣吕蒙掩袭南三郡〖3〗；立脱身走，自归先主。","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":156,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":29,"offset_unit":"unicode_code_point"},{"id":"shiyi-q-55f815ea6d969387b315","section":"chapter-062","block":"b-837459c1c5fdde4c304d","layer":"pei","quote":"权问普：‘卿前盛称蕃，又为之怨望朝廷；使蕃反叛，皆卿之由！","attribution":"裴注·吴历","section_title":"是仪胡综传第十七","source":{"file":"OEBPS/Text/titlepage_0131.xhtml","index":198,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-03af5d33c13053b69c65","start":7,"end":36,"offset_unit":"unicode_code_point"},{"id":"shiyi-q-680dd08ada26846c8c0c","section":"chapter-062","block":"b-1bfab7b7bf3112c80af4","layer":"original","quote":"普见责，自杀","section_title":"是仪胡综传第十七","source":{"file":"OEBPS/Text/titlepage_0131.xhtml","index":178,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":67,"end":73,"offset_unit":"unicode_code_point"},{"id":"shiyi-q-7f4433dc60ded137a87a","section":"chapter-062","block":"b-1bfab7b7bf3112c80af4","layer":"original","quote":"左将军朱据、廷尉郝普，称蕃有王佐之才〖14〗；普尤与之亲善，常怨叹其屈","section_title":"是仪胡综传第十七","source":{"file":"OEBPS/Text/titlepage_0131.xhtml","index":178,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":18,"end":53,"offset_unit":"unicode_code_point"},{"id":"wuzhu-e-o028a-q","section":"chapter-047","block":"b-aed5aacc47d73bf1a3f2","layer":"original","quote":"蒙到，二郡皆服，惟零陵太守郝普未下〖8〗。会备到公安〖9〗，使关羽将三万兵至益阳；权乃召蒙等，使还助肃。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":126,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":52,"offset_unit":"unicode_code_point"},{"id":"wuzhu-e-o028b-q","section":"chapter-047","block":"b-aed5aacc47d73bf1a3f2","layer":"original","quote":"蒙使人诱普，普降，尽得三郡将守〖10〗；因引军还，与孙皎、潘璋并鲁肃兵并进〖11〗，拒羽于益阳。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":126,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":52,"end":100,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-b-6c673130b822b151c942","section":"chapter-047","block":"b-6c673130b822b151c942","layer":"modern","quote":"〖1〗益州：州名。治所在今四川成都市。此段所述史事发生在建安二十年（公元 215），参见本书卷三十二《先主传》。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":130,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1574d392980d4ec4daef","start":0,"end":56,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o026","section":"chapter-047","block":"b-80743944340fd37ea837","layer":"original","quote":"权以备已得益州〖1〗，令诸葛瑾从求荆州诸郡。备不许，曰：“吾方图凉州；凉州定，乃尽以荆州与吴耳。”权曰：“此假而不返〖2〗，而欲以虚辞引岁〖3〗！”遂置南三郡长吏〖4〗。关羽尽逐之〖5〗。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":124,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":94,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o028","section":"chapter-047","block":"b-aed5aacc47d73bf1a3f2","layer":"original","quote":"蒙到，二郡皆服，惟零陵太守郝普未下〖8〗。会备到公安〖9〗，使关羽将三万兵至益阳；权乃召蒙等，使还助肃。蒙使人诱普，普降，尽得三郡将守〖10〗；因引军还，与孙皎、潘璋并鲁肃兵并进〖11〗，拒羽于益阳。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":126,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":100,"offset_unit":"unicode_code_point"},{"id":"zhouyu-e-o081d-q","section":"chapter-054","block":"b-82ba5f92bc12b49d8842","layer":"original","quote":"惟零陵太守郝普〖1〗，城守不降。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":380,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":40,"end":56,"offset_unit":"unicode_code_point"},{"id":"zhouyu-e-o083a-q","section":"chapter-054","block":"b-8d6d265b3a8ecb062468","layer":"original","quote":"玄之见普，具宣蒙意，普惧而听之。玄之先出报蒙，普寻后当至〖19〗。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":382,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":33,"offset_unit":"unicode_code_point"},{"id":"zhouyu-e-o083b-q","section":"chapter-054","block":"b-8d6d265b3a8ecb062468","layer":"original","quote":"蒙预敕四将：各选百人；普出，便入守城门。须臾普出〖20〗，蒙迎执其手，与俱下船。语毕，出书示之，因拊手大笑。普见书，知备在公安，而羽在益阳，惭恨入地。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":382,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":33,"end":108,"offset_unit":"unicode_code_point"},{"id":"zhouyu-f0016-q","section":"chapter-054","block":"b-57a3cb855da82271b353","layer":"original","quote":"郝子太闻世间有忠义事","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":381,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":79,"end":89,"offset_unit":"unicode_code_point"},{"id":"zhouyu-haopu-name-note","section":"chapter-054","block":"b-8b0e853f185afe515512","layer":"modern","quote":"〖6〗郝子太：郝普字子太。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":391,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b9ce398a3882717442a1","start":0,"end":13,"offset_unit":"unicode_code_point"},{"id":"zhouyu-q-o081","section":"chapter-054","block":"b-82ba5f92bc12b49d8842","layer":"original","quote":"是时刘备令关羽镇守，专有荆土。权命蒙西取长沙、零、桂三郡。蒙移书二郡，望风归服；惟零陵太守郝普〖1〗，城守不降。而备自蜀亲至公安，遣羽争三郡。权时住陆口，使鲁肃将万人屯益阳拒羽；而飞书召蒙〖2〗，使舍零陵，急还助肃。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":380,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":108,"offset_unit":"unicode_code_point"},{"id":"zhouyu-q-o082","section":"chapter-054","block":"b-57a3cb855da82271b353","layer":"original","quote":"初，蒙既定长沙，当之零陵；过酃〖3〗，载南阳邓玄之。玄之者，郝普之旧也〖4〗：欲令诱普。及被书当还〖5〗，蒙秘之；夜召诸将，授以方略。晨当攻城，顾谓玄之曰：“郝子太闻世间有忠义事〖6〗，亦欲为之，而不知时也。左将军在汉中〖7〗，为夏侯渊所围；关羽在南郡，今至尊身自临之〖8〗；近者破樊本屯〖9〗，救酃，逆为孙规所破〖10〗：此皆目前之事，君所亲见也。彼方首尾倒悬，救死不给；岂有余力，复营此哉〖11〗？今吾士卒精锐，人思致命〖12〗；至尊遣兵，相继于道。今子〔太〕以旦夕之命，待不可望之救；犹牛蹄中鱼〖13〗，冀赖江、汉〖14〗：其不可恃亦明矣。若子太必能一士卒之心，保孤城之守，尚能稽延旦夕，以待所归者，可也。今吾计力度虑〖15〗，而以攻此，曾不移日〖16〗，而城必破；城破之后，身死何益于事？而令百岁老母，戴白受诛〖17〗：岂不痛哉！度此家不得外问〖18〗，谓援可恃，故至于此耳。君可见之，为陈祸福。”","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":381,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":403,"offset_unit":"unicode_code_point"},{"id":"zhouyu-q-o083","section":"chapter-054","block":"b-8d6d265b3a8ecb062468","layer":"original","quote":"玄之见普，具宣蒙意，普惧而听之。玄之先出报蒙，普寻后当至〖19〗。蒙预敕四将：各选百人；普出，便入守城门。须臾普出〖20〗，蒙迎执其手，与俱下船。语毕，出书示之，因拊手大笑。普见书，知备在公安，而羽在益阳，惭恨入地。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":382,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":108,"offset_unit":"unicode_code_point"},{"id":"zhouyu-q-o084","section":"chapter-054","block":"b-dd7fdce0fda1f24e697c","layer":"original","quote":"蒙留孙（河）〔皎〕委以后事，即日引军赴益阳。刘备请盟，权乃归普等〖21〗；割湘水，以零陵还之。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":383,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":47,"offset_unit":"unicode_code_point"},{"id":"zhouyu-q-o098","section":"chapter-054","block":"b-3f59cf0d520c67554298","layer":"original","quote":"评曰：曹公乘汉相之资，挟天子而扫群杰；新荡荆城〖1〗，仗威（东夏）〔东下〕。于时议者莫不疑贰〖2〗；周瑜、鲁肃建独断之明，出众人之表：实奇才也！吕蒙勇而有谋，断识军计；谲郝普〖3〗，擒关羽，最其妙者。初虽轻果妄杀〖4〗，终于克己，有国士之量：岂徒武将而已乎！孙权之论，优劣允当〖5〗，故载录焉。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":489,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":147,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
