{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhangle-e-o017a","title":"乐进屯阳翟平荆州后屯襄阳击关羽苏非受降","accounts":[{"id":"zhangle-e-o017a-account","label":"《张乐于张徐传第十七》正文","text":"乐进屯阳翟平荆州后屯襄阳击关羽苏非受降","evidence":["zhangle-e-o017a-q"]}],"participants":[{"person":"wudi-p0236","role":"屯守征讨","evidence":["zhangle-e-o017a-q"]},{"person":"wudi-p0172","role":"败退","evidence":["zhangle-e-o017a-q"]},{"person":"zhangle-p0015","role":"败退","evidence":["zhangle-e-o017a-q"]}],"place":null,"time":{"label":"荆州未服至合肥屯守时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["zhangle-e-o017a-q"]},"ordering_evidence":"zhangle-e-o017a-q","source_order":[17,59,"O017a"],"order":3513}],"persons":[{"id":"zhangle-p0015","name":"苏非","evidence":["zhangle-q-o017"],"facts":[],"aliases":[],"mentions":[{"id":"zhangle-m-o017-zhangle-p0015","kind":"mention","text":"文中提及","evidence":["zhangle-q-o017"]}]}],"evidence":[{"id":"zhangle-e-o017a-q","section":"chapter-017","block":"b-cae73ece940f4b66840c","layer":"original","quote":"荆州未服，遣屯阳翟。后从平荆州，留屯襄阳；击关羽、苏非等，皆走之；南郡诸县山谷蛮夷，诣进降。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":58,"anchor":null},"note_id":null,"start":0,"end":46},{"id":"zhangle-q-o017","section":"chapter-017","block":"b-cae73ece940f4b66840c","layer":"original","quote":"荆州未服，遣屯阳翟。后从平荆州，留屯襄阳；击关羽、苏非等，皆走之；南郡诸县山谷蛮夷，诣进降。又讨刘备临沮长杜普、旌阳长梁大〖10〗，皆大破之。后从征孙权，假进节。太祖还，留进与张辽、李典屯合肥。增邑五百，并前凡千二百户。以进数有功，分五百户，封一子列侯；进，迁右将军。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":58,"anchor":null},"note_id":null,"start":0,"end":134}],"profiles":{},"directory_counts":{}}
