引张璠《汉纪》","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":23,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-50050b992d7d5915d74c","start":0,"end":221,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-0b593b14822cbef26d1e","section":"chapter-021","block":"b-0a5e92793cfa20a08991","layer":"pei","quote":"初，山阳太守薛勤丧妻，不哭；将殡，临之曰：‘幸不为夭，复何恨哉！’及龚妻卒，龚与诸子并杖行服，时人或两讥焉","attribution":"裴注·汉纪","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":23,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-50050b992d7d5915d74c","start":31,"end":84,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-73526a02e1978cfe9870","section":"chapter-021","block":"b-0a5e92793cfa20a08991","layer":"pei","quote":"龚字伯宗。有高名于天下。顺帝时为太尉。","attribution":"裴注引张璠《汉纪》","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":23,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-50050b992d7d5915d74c","start":12,"end":31,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
