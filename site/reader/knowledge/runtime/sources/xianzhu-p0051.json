id":"guanzhang-m-o036-xianzhu-p0051","kind":"mention","text":"文中提及","evidence":["guanzhang-q-o036"]},{"id":"guanzhang-m-o037-xianzhu-p0051","kind":"mention","text":"文中提及","evidence":["guanzhang-q-o037"]},{"id":"guanzhang-m-o038-xianzhu-p0051","kind":"mention","text":"文中提及","evidence":["guanzhang-q-o038"]},{"id":"guanzhang-m-o039-xianzhu-p0051","kind":"mention","text":"文中提及","evidence":["guanzhang-q-o039"]},{"id":"guanzhang-m-o040-xianzhu-p0051","kind":"mention","text":"文中提及","evidence":["guanzhang-q-o040"]},{"id":"guanzhang-m-p025-xianzhu-p0051","kind":"mention","text":"文中提及","evidence":["guanzhang-q-p025"]},{"id":"guanzhang-m-o046-xianzhu-p0051","kind":"mention","text":"文中提及","evidence":["guanzhang-q-o046"]},{"id":"guanzhang-m-o048-xianzhu-p0051","kind":"mention","text":"文中提及","evidence":["guanzhang-q-o048"]},{"id":"pangfa-m-o024-xianzhu-p0051","kind":"mention","text":"文中提及","evidence":["pangfa-q-o024"]},{"id":"houzhu-m-houzhu-q-O072-xianzhu-p0051","kind":"mention","text":"文中提及","evidence":["houzhu-q-O072"]}]}],"evidence":[{"id":"dengzhang-q-717a432bbf8367bb45e1","section":"chapter-045","block":"b-dcad3795f68a26f97ecf","layer":"pei","quote":"群下上先主为汉中王；其文，朝所造也","attribution":"裴注·华阳国志","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":345,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c4df925d7ccb2471fbb6","start":47,"end":64,"offset_unit":"unicode_code_point"},{"id":"guanzhang-e-o008a-q","section":"chapter-036","block":"b-b96955cde6bd0ef2541b","layer":"original","quote":"二十四年〖1〗，先主为汉中王；拜羽为前将军，假节、钺。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":35,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":27,"offset_unit":"unicode_code_point"},{"id":"guanzhang-e-o036a-q","section":"chapter-036","block":"b-4bbfe7fb10e5f8762a6c","layer":"original","quote":"荆州牧刘表以为中郎将；与表从子磐共守长沙攸县〖1〗。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":167,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":11,"end":37,"offset_unit":"unicode_code_point"},{"id":"guanzhang-e-o036b-q","section":"chapter-036","block":"b-4bbfe7fb10e5f8762a6c","layer":"original","quote":"及曹公克荆州，假行裨将军〖2〗；仍就故任〖3〗，统属长沙太守韩玄。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":167,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":37,"end":70,"offset_unit":"unicode_code_point"},{"id":"guanzhang-e-o037a-q","section":"chapter-036","block":"b-ff11092313b144c8dc2e","layer":"original","quote":"先主南定诸郡，忠遂委质〖4〗，随从入蜀。自葭萌受任，还攻刘璋；忠常先登陷阵，勇毅冠三军。益州既定，拜为讨虏将军。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":168,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":56,"offset_unit":"unicode_code_point"},{"id":"guanzhang-e-o038a-q","section":"chapter-036","block":"b-05b027684ab7ab886724","layer":"original","quote":"建安二十四年，于汉中定军山击夏侯渊，渊众甚精。忠推锋必进，劝率士卒；金鼓振天，欢声动谷〖5〗；一战斩渊，渊军大败。迁征西将军。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":169,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":63,"offset_unit":"unicode_code_point"},{"id":"guanzhang-e-o039a-q","section":"chapter-036","block":"b-38bd93b2d0b8b7c999fb","layer":"original","quote":"是岁，先主为汉中王，欲用忠为后将军；诸葛亮说先主曰：“忠之名望，素非关、马之伦也〖6〗；而今便令同列〖7〗：马、张在近〖8〗，亲见其功，尚可喻指〖9〗；关遥闻之，恐必不悦，得无不可乎〖10〗？”先主曰：“吾自当解之〖11〗。”遂与羽等齐位，赐爵关内侯。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":170,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":126,"offset_unit":"unicode_code_point"},{"id":"guanzhang-e-o040a-q","section":"chapter-036","block":"b-e6e6964f70aff4cbabd0","layer":"original","quote":"明年卒〖12〗，追谥刚侯。子叙，早没，无后。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":171,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":22,"offset_unit":"unicode_code_point"},{"id":"guanzhang-e-p025b-q","section":"chapter-036","block":"b-bfbd05c62f55b5319eef","layer":"pei","quote":"夏侯渊败，曹公争汉中地，运米北山下，数千万囊。黄忠以为可取，云兵随忠取米。忠过期不还，云将数十骑轻行出围，迎视忠等。值曹公扬兵大出，云为公前锋所击，方战，其大众至；势逼，遂前突其阵，且斗且却。公军败，已复合；云陷敌，还趋围。将张著被创，云复驰马还营，迎著。","attribution":"《云别传》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":198,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a08234bc0170e60d90c5","start":135,"end":263,"offset_unit":"unicode_code_point"},{"id":"guanzhang-f0013-q","section":"chapter-036","block":"b-4bbfe7fb10e5f8762a6c","layer":"original","quote":"黄忠字汉升","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":167,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":5,"offset_unit":"unicode_code_point"},{"id":"guanzhang-f0014-q","section":"chapter-036","block":"b-4bbfe7fb10e5f8762a6c","layer":"original","quote":"南阳人也","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":167,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":6,"end":10,"offset_unit":"unicode_code_point"},{"id":"guanzhang-f0018-q","section":"chapter-036","block":"b-e6e6964f70aff4cbabd0","layer":"original","quote":"追谥刚侯","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":171,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":8,"end":12,"offset_unit":"unicode_code_point"},{"id":"guanzhang-q-b-edafc9276d2732d2c2af","section":"chapter-036","block":"b-edafc9276d2732d2c2af","layer":"modern","quote":"〖1〗二十四年：建安二十四年（公元 219）。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":42,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-16dc4b02f597093385c1","start":0,"end":23,"offset_unit":"unicode_code_point"},{"id":"guanzhang-q-o008","section":"chapter-036","block":"b-b96955cde6bd0ef2541b","layer":"original","quote":"二十四年〖1〗，先主为汉中王；拜羽为前将军，假节、钺。是岁，羽率众攻曹仁于樊。曹公遣于禁助仁。秋，大霖雨，汉水泛溢，禁所督七军皆没；禁降羽，羽又斩将军庞德〖2〗；梁、郏、陆浑群盗或遥受羽印号〖3〗，为之支党。羽威震华夏〖4〗，曹公议徙许都，以避其锐。司马宣王、蒋济以为：“关羽得志，孙权必不愿也。可遣人劝权蹑其后〖5〗，许割江南以封权，则樊围自解。”曹公从之。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":35,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":180,"offset_unit":"unicode_code_point"},{"id":"guanzhang-q-o036","section":"chapter-036","block":"b-4bbfe7fb10e5f8762a6c","layer":"original","quote":"黄忠字汉升，南阳人也。荆州牧刘表以为中郎将；与表从子磐共守长沙攸县〖1〗。及曹公克荆州，假行裨将军〖2〗；仍就故任〖3〗，统属长沙太守韩玄。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":167,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":70,"offset_unit":"unicode_code_point"},{"id":"guanzhang-q-o037","section":"chapter-036","block":"b-ff11092313b144c8dc2e","layer":"original","quote":"先主南定诸郡，忠遂委质〖4〗，随从入蜀。自葭萌受任，还攻刘璋；忠常先登陷阵，勇毅冠三军。益州既定，拜为讨虏将军。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":168,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":56,"offset_unit":"unicode_code_point"},{"id":"guanzhang-q-o038","section":"chapter-036","block":"b-05b027684ab7ab886724","layer":"original","quote":"建安二十四年，于汉中定军山击夏侯渊，渊众甚精。忠推锋必进，劝率士卒；金鼓振天，欢声动谷〖5〗；一战斩渊，渊军大败。迁征西将军。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":169,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":63,"offset_unit":"unicode_code_point"},{"id":"guanzhang-q-o039","section":"chapter-036","block":"b-38bd93b2d0b8b7c999fb","layer":"original","quote":"是岁，先主为汉中王，欲用忠为后将军；诸葛亮说先主曰：“忠之名望，素非关、马之伦也〖6〗；而今便令同列〖7〗：马、张在近〖8〗，亲见其功，尚可喻指〖9〗；关遥闻之，恐必不悦，得无不可乎〖10〗？”先主曰：“吾自当解之〖11〗。”遂与羽等齐位，赐爵关内侯。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":170,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":126,"offset_unit":"unicode_code_point"},{"id":"guanzhang-q-o040","section":"chapter-036","block":"b-e6e6964f70aff4cbabd0","layer":"original","quote":"明年卒〖12〗，追谥刚侯。子叙，早没，无后。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":171,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":22,"offset_unit":"unicode_code_point"},{"id":"guanzhang-q-o046","section":"chapter-036","block":"b-9f348b83292228dfc790","layer":"original","quote":"七年卒〖3〗，追谥顺平侯。初，先主时，惟法正见谥。后主时，诸葛亮功德盖世，蒋琬、费祎荷国之重〖4〗，亦见谥。陈祗宠待〖5〗，特加殊奖；夏侯霸，远来归国〖6〗：故复得谥。于是关羽、张飞、马超、庞统、黄忠及云乃追谥，时论以为荣﹝二﹞。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":201,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":115,"offset_unit":"unicode_code_point"},{"id":"guanzhang-q-o048","section":"chapter-036","block":"b-ed718ddcba8b8e3b3282","layer":"original","quote":"评曰：关羽、张飞，皆称“万人之敌”，为世虎臣。羽报效曹公，飞义释严颜：并有国士之风。然羽刚而自矜，飞暴而无恩；以短取败，理数之常也。马超阻戎负勇〖1〗，以覆其族。惜哉！能因穷致泰〖2〗，不犹愈乎〖3〗！黄忠、赵云，强鸷壮猛〖4〗，并作爪牙：其灌、滕之徒欤〖5〗？","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":215,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":131,"offset_unit":"unicode_code_point"},{"id":"guanzhang-q-p025","section":"chapter-036","block":"b-bfbd05c62f55b5319eef","layer":"pei","quote":"﹝三﹞《云别传》曰：“益州既定，时议欲以成都中屋舍及城外园地、桑田，分赐诸将。云驳之曰：‘霍去病以匈奴未灭，无用家为；今国贼非但匈奴，未可求安也。须天下都定，各反桑梓，归耕本土，乃其宜耳。益州人民，初罹兵革，田宅皆可归还；令安居复业，然后可役调，得其欢心。’先主即从之。夏侯渊败，曹公争汉中地，运米北山下，数千万囊。黄忠以为可取，云兵随忠取米。忠过期不还，云将数十骑轻行出围，迎视忠等。值曹公扬兵大出，云为公前锋所击，方战，其大众至；势逼，遂前突其阵，且斗且却。公军败，已复合；云陷敌，还趋围。将张著被创，云复驰马还营，迎著。公军追至围，此时沔阳长张翼，在云围内，翼欲闭门拒守；而云入营，更大开门，偃旗息鼓。公军疑云有伏兵，引去。云擂鼓震天，惟以戎弩于后射公军；公军惊骇，自相蹂践，坠汉水中死者甚多。先主明旦自来，至云营围，视昨战处，曰：‘子龙一身都是胆也！’作乐饮宴，至瞑，军中号云为‘虎威将军’。孙权袭荆州，先主大怒，欲讨权。云谏曰：‘国贼是曹操，非孙权也；且先灭魏，则吴自服。操身虽毙，子丕篡盗；当因众心，早图关中；居河、渭上流，以讨凶逆，关东义士必裹粮策马以迎王师。不应置魏，先与吴战；兵势一交，不得猝解也！’先主不听，遂东征，留云督江州。先主失利于秭归，云进兵至永安，吴军已退。”","attribution":"《云别传》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":198,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a08234bc0170e60d90c5","start":0,"end":545,"offset_unit":"unicode_code_point"},{"id":"houzhu-q-O072","section":"chapter-033","block":"b-2771cbfbb1cbc3074370","layer":"original","quote":"三年秋九月，追谥故将军关羽、张飞、马超、庞统、黄忠。","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":148,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":26,"offset_unit":"unicode_code_point"},{"id":"huangli-q-bd474f24d9b352df893a","section":"chapter-043","block":"b-f5314af9b98692ce672f","layer":"original","quote":"及先主袭取益州，将帅分下郡县，郡县望风影附","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":2,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"huangli-q2-8ec763646120744b2ac2","section":"chapter-043","block":"b-b937b741ffd9fc15238b","layer":"original","quote":"先主假权偏将军。﹝一﹞及曹公破张鲁，鲁走入巴中。权进曰：“若失汉中，则三巴不振〖1〗，此为割蜀之股臂也！”于是先主以权为护军，率诸将迎鲁；鲁已还南郑，北降曹公。然卒破杜濩、朴胡〖2〗，杀夏侯渊，据汉中：皆权本谋也。","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":10,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":107,"offset_unit":"unicode_code_point"},{"id":"huowang-q-3d839b07145d47a93b8a","section":"chapter-041","block":"b-a2d44a8ea9a1d8953eaa","layer":"original","quote":"羽闻黄忠为后将军，（羽）怒曰：“大丈夫终不与老兵同列！〖2〗”不肯受拜","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":170,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":17,"end":52,"offset_unit":"unicode_code_point"},{"id":"huowang-q-a085f159439635932339","section":"chapter-041","block":"b-05065728d211baad4f67","layer":"original","quote":"先主自葭萌南还袭刘璋，留峻守葭萌城","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":2,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":19,"end":36,"offset_unit":"unicode_code_point"},{"id":"huowang-q-ae94efcb1d0091064fb5","section":"chapter-041","block":"b-a2d44a8ea9a1d8953eaa","layer":"original","quote":"诗谓羽曰：“夫立王业者，所用非一。昔萧、曹与高祖少小亲旧〖3〗，而陈、韩亡命后至〖4〗；论其班列，韩最居上，未闻萧、曹以此为怨。今汉〔中〕王以一时之功〖5〗，隆崇于汉（室）〔升〕；然意之轻重〖6〗，宁当与君侯齐乎〖7〗？且王与君侯，譬犹一体；同休等戚，祸福共之。愚为君侯〖8〗，不宜计官号之高下，爵禄之多少为意也。仆一介之使〖9〗，衔命之人；君侯不受拜，如是便还；但相为惜此举动，恐有后悔耳！”羽大感悟，遽即受拜","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":170,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":53,"end":259,"offset_unit":"unicode_code_point"},{"id":"huowang-q-c7f9408621d68792ed41","section":"chapter-041","block":"b-a2d44a8ea9a1d8953eaa","layer":"original","quote":"先主为汉中王，遣诗拜关羽为前将军","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":170,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":16,"offset_unit":"unicode_code_point"},{"id":"liuermu-q-4d23bb4578b63b8f2031","section":"chapter-031","block":"b-9368771bcb03c6644bf6","layer":"original","quote":"还兵南向〖25〗，所在皆克","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":72,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":13,"end":26,"offset_unit":"unicode_code_point"},{"id":"mantian-q-60ee42f505cc336d697b","section":"chapter-026","block":"b-d160820c791d32df9d68","layer":"original","quote":"太祖还，留征西将军夏侯渊拒刘备，以淮为渊司马","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":282,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":22,"offset_unit":"unicode_code_point"},{"id":"mantian-q-e3c821d7eeb6b48aabca","section":"chapter-026","block":"b-d160820c791d32df9d68","layer":"original","quote":"太祖还，留征西将军夏侯渊拒刘备，以淮为渊司马。渊与备战，淮时有疾不出。渊遇害，军中扰扰","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":282,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":43,"offset_unit":"unicode_code_point"},{"id":"pangfa-e-o024a-q","section":"chapter-037","block":"b-b3d109bb3fe355546163","layer":"original","quote":"二十四年〖27〗，先主自阳平南渡沔水，缘山稍前〖28〗，于定军（兴势）〔山〕作营。渊将兵来争其地。正曰：“可击矣！”先主命黄忠乘高鼓噪攻之，大破渊军，渊等授首〖29〗。","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":149,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":84,"offset_unit":"unicode_code_point"},{"id":"pangfa-q-o024","section":"chapter-037","block":"b-b3d109bb3fe355546163","layer":"original","quote":"二十四年〖27〗，先主自阳平南渡沔水，缘山稍前〖28〗，于定军（兴势）〔山〕作营。渊将兵来争其地。正曰：“可击矣！”先主命黄忠乘高鼓噪攻之，大破渊军，渊等授首〖29〗。曹公西征，闻正之策，曰：“吾故知玄德不辨有此〖30〗，必为人所教也。”﹝三﹞","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":149,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":122,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o195a-q","section":"chapter-001","block":"b-a6c4894727ead1cc5e5d","layer":"original","quote":"夏侯渊与刘备战于阳平，为备所杀。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":423,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":16,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-1e7ae1441471aa22d204","section":"chapter-001","block":"b-1e7ae1441471aa22d204","layer":"modern","quote":"〖1〗二十四年：建安二十四年（公元 219）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":428,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f2589f07b550616f1e63","start":0,"end":23,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o194","section":"chapter-001","block":"b-adb6682558d65fc17e1a","layer":"original","quote":"二十四年春正月〖1〗，仁屠宛，斩音。﹝一﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":422,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o019a-q","section":"chapter-009","block":"b-4cfaf68cad6f0d5e3e1c","layer":"original","quote":"二十四年正月〖9〗，备夜烧围鹿角〖10〗；渊使张郃护东围，自将轻兵护南围。备挑郃战，郃军不利。渊分所将兵半，助郃；为备所袭，渊遂战死。谥曰愍侯。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":84,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":72,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-o019-warning","section":"chapter-009","block":"b-4cfaf68cad6f0d5e3e1c","layer":"original","quote":"初，渊虽数战胜，太祖常戒曰：“为将当有怯弱时，不可但恃勇也〖11〗！将当以勇为本，行之以智计。但知任勇，一匹夫敌耳。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":84,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":72,"end":130,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o041a-q","section":"chapter-032","block":"b-c205af65c5b891e6a027","layer":"original","quote":"先主大怒，召璋白水军督杨怀，责以无礼，斩之。乃使黄忠、卓膺勒兵向璋〖9〗。先主径至关中〖10〗，质诸将并士卒妻子〖11〗；引兵与忠、膺等进到涪，据其城。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":166,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":76,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o048a-q","section":"chapter-032","block":"b-2d515ba2dae40f6a248e","layer":"original","quote":"二十四年春〖11〗，自阳平南渡沔水，缘山稍前〖12〗，于定军山（势）作营〖13〗。渊将兵来争其地，先主命黄忠乘高鼓噪攻之。大破渊军，斩渊及曹公所署益州刺史赵颙等。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":203,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":81,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o051a-q","section":"chapter-032","block":"b-652c7dfc21363b200764","layer":"original","quote":"“平西将军、都亭侯臣马超，左将军领长史、镇军将军臣许靖，营司马臣庞羲，议曹从事、中郎、军议中郎将臣射援，﹝一﹞军师将军臣诸葛亮，荡寇将军、汉寿亭侯臣关羽，征虏将军、新亭侯臣张飞，征西将军臣黄忠，镇远将军臣赖恭，扬武将军臣法正，兴业将军臣李严等一百二十人上言曰〖17〗：","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":206,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":134,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-b-09400c250015597cdc75","section":"chapter-032","block":"b-09400c250015597cdc75","layer":"modern","quote":"〖10〗十六年：建安十六年（公元 211 ）。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":152,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8471d798647e2ff3307a","start":0,"end":23,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-b-c3e56caa3865de7f7114","section":"chapter-032","block":"b-c3e56caa3865de7f7114","layer":"modern","quote":"〖11〗二十四年：建安二十四年（公元 219）。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":222,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fd85f82251e498647de7","start":0,"end":24,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o034","section":"chapter-032","block":"b-464a6d3ab5db13314b70","layer":"original","quote":"十六年〖10〗，益州牧刘璋，遥闻曹公将遣钟繇等向汉中讨张鲁，内怀恐惧。别驾从事蜀郡张松说璋曰：“曹公兵强，无敌于天下；若因张鲁之资以取蜀土〖11〗，谁能御之者乎？”璋曰：“吾固忧之而未有计。”松曰：“刘豫州，使君之宗室，而曹公之深仇也，善用兵；若使之讨鲁，鲁必破；鲁破，则益州强；曹公虽来，无能为也。”","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":140,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":151,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o039","section":"chapter-032","block":"b-3fc74e22c633afc483a4","layer":"original","quote":"明年，曹公征孙权，权呼先主自救〖4〗。先主遣使告璋曰：“曹公征吴，吴忧危急；孙氏与孤，本为唇齿。又乐进在青泥与关羽相拒〖5〗；今不往救羽，进必大克；转侵州界〖6〗，其忧有甚于鲁。鲁，自守之贼，不足虑也。”乃从璋求万兵及资（宝）〔实〕〖7〗，欲以东行。璋但许兵四千，其余皆给半。﹝一﹞","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":164,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":141,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o041","section":"chapter-032","block":"b-c205af65c5b891e6a027","layer":"original","quote":"先主大怒，召璋白水军督杨怀，责以无礼，斩之。乃使黄忠、卓膺勒兵向璋〖9〗。先主径至关中〖10〗，质诸将并士卒妻子〖11〗；引兵与忠、膺等进到涪，据其城。璋遣刘z 、冷苞、张任、邓贤〔、吴懿〕等拒先主于涪；﹝三﹞皆破败，退保绵竹。璋复遣李严督绵竹诸军〖12〗，严率众降先主。先主军益强，分遣诸将平下属县。诸葛亮、张飞、赵云等将兵溯流定白帝、江州、江阳〖13〗，唯关羽留镇荆州。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":166,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":187,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o048","section":"chapter-032","block":"b-2d515ba2dae40f6a248e","layer":"original","quote":"二十四年春〖11〗，自阳平南渡沔水，缘山稍前〖12〗，于定军山（势）作营〖13〗。渊将兵来争其地，先主命黄忠乘高鼓噪攻之。大破渊军，斩渊及曹公所署益州刺史赵颙等。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":203,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":81,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o050-preface","section":"chapter-032","block":"b-a429b62b1d8ac4da31ba","layer":"original","quote":"秋，群下上《先王为汉中王表》于汉帝〖16〗，曰：","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":205,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":24,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o051","section":"chapter-032","block":"b-652c7dfc21363b200764","layer":"original","quote":"“平西将军、都亭侯臣马超，左将军领长史、镇军将军臣许靖，营司马臣庞羲，议曹从事、中郎、军议中郎将臣射援，﹝一﹞军师将军臣诸葛亮，荡寇将军、汉寿亭侯臣关羽，征虏将军、新亭侯臣张飞，征西将军臣黄忠，镇远将军臣赖恭，扬武将军臣法正，兴业将军臣李严等一百二十人上言曰〖17〗：","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":206,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":134,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o052-argument1","section":"chapter-032","block":"b-13bc0548f92b946e57ac","layer":"original","quote":"昔唐尧至圣，而四凶在朝〖18〗；周成仁贤，而四国作难〖19〗；高后称制，而诸吕窃命〖20〗；孝昭幼冲，而上官逆谋〖21〗：皆凭世宠〖22〗，藉履国权〖23〗，穷凶极乱，社稷几危。非大舜、周公、朱虚、博陆〖24〗，则不能流放擒讨，安危定倾。伏惟陛下诞姿圣德，统理万邦；而遭厄运不造之艰〖25〗。董卓首难〖26〗，荡覆京畿；曹操阶祸〖27〗，窃执天衡〖28〗；皇后太子〖29〗，鸩杀见害；剥乱天下，残毁民物〖30〗。久令陛下蒙尘忧厄，幽处虚邑〖31〗；人神无主，遏绝王命；厌昧皇极〖32〗，欲盗神器。左将军、领司隶校尉、豫、荆、益三州牧宜城亭侯备，受朝爵秩，念在输力〖33〗，以殉国难。睹其机兆〖34〗，赫然愤发；与车骑将军董承同谋诛操，将安国家，克宁旧都。会承机事不密，令操游魂得遂长恶〖35〗，残泯海内。臣等每惧王室大有阎乐之祸〖36〗，小有定安之变〖37〗；﹝二﹞夙夜惴惴，战栗累息。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":207,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":393,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o053-argument2","section":"chapter-032","block":"b-5e935a656e57fa2b467f","layer":"original","quote":"昔在《虞书》〖38〗，敦序九族〖39〗；周监二代〖40〗，封建同姓；《诗》著其义〖41〗，历载长久。汉兴之初，割裂疆土〖42〗，尊王子弟；是以卒折诸吕之难〖43〗，而成太宗之基〖44〗。臣等以备肺腑枝叶〖45〗，宗子藩翰〖46〗；心存国家，念在弥乱〖47〗；自操破于汉中，海内英雄望风蚁附；而爵号不显，九锡未加〖48〗：非所以镇卫社稷，光昭万世也。奉辞在外〖49〗，礼命断绝。昔河西太守梁统等值汉中兴〖50〗，限于山河〖51〗；位同权均，不能相率；咸推窦融以为元帅〖52〗，卒立效绩〖53〗，摧破隗嚣〖54〗。今社稷之难，急于陇、蜀〖55〗；操外吞天下，内残群僚；朝廷有萧墙之危〖56〗，而御侮未建〖57〗，可为寒心。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":208,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":309,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o054-proposal","section":"chapter-032","block":"b-48e611d2cf38e3f1ec45","layer":"original","quote":"臣等辄依旧典，封备汉中王，拜大司马，董齐六军〖58〗，纠合同盟，扫灭凶逆；以汉中、巴、蜀、广汉、犍为为国，所署置依汉初诸侯王故典。夫权宜之制，苟利社稷，专之可也；然后功成事立，臣等退伏矫罪〖59〗，虽死无恨！”","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":209,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":105,"offset_unit":"unicode_code_point"}],"profiles":{"xianzhu-p0051":{"fields":[{"id":"guanzhang-f0013","key":"courtesy","label":"字","text":"汉升","evidence":["guanzhang-f0013-q"]},{"id":"guanzhang-f0014","key":"home","label":"籍贯","text":"南阳","evidence":["guanzhang-f0014-q"]},{"id":"guanzhang-f0018","key":"posthumous","label":"谥号","text":"刚侯","evidence":["guanzhang-f0018-q"]}],"directory":{"faction":"shu"}}},"directory_counts":{}}
