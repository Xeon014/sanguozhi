-a-46e0e8d0b27deeb7b44c","label":"裴注·辂别传","text":"石苞问君何以不隐；辂答陵虚之鸟爱其清高、渊沼之鱼乐其濡湿，由性异而分不同；仆自欲正身以明道、直己以亲义，素隐行怪未暇斯务","evidence":["fangji-q-b09c70b0a79f62c5bcaf"]}],"participants":[{"person":"shaodi-p0138","role":"问者","evidence":["fangji-q-b09c70b0a79f62c5bcaf"]},{"person":"fangji-p-f06456c2a8f978","role":"答者","evidence":["fangji-q-b09c70b0a79f62c5bcaf"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["fangji-q-b09c70b0a79f62c5bcaf"]},"ordering_evidence":"fangji-q-b09c70b0a79f62c5bcaf","order":6051},{"id":"chenghuang-e-o164","title":"宝鼎三年奉攻合肥与石苞书间之","accounts":[{"id":"chenghuang-a-8428c088e0b350da0f8c","label":"正文","text":"宝鼎三年奉攻合肥与石苞书间之","evidence":["chenghuang-q-414c2d4ac18090afbb57"]}],"participants":[{"person":"santizhu-p0017","role":"与诸葛靓攻合肥、与晋大将石苞书构而间之","evidence":["chenghuang-q-414c2d4ac18090afbb57"]},{"person":"wgc-p0021","role":"同攻合肥","evidence":["chenghuang-q-414c2d4ac18090afbb57"]},{"person":"shaodi-p0138","role":"晋大将、被书构而间之、以征还","evidence":["chenghuang-q-414c2d4ac18090afbb57"]},{"person":"shaodi-p0162","role":"命奉者","evidence":["chenghuang-q-414c2d4ac18090afbb57"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["chenghuang-q-414c2d4ac18090afbb57"]},"ordering_evidence":"chenghuang-q-414c2d4ac18090afbb57","source_order":[55,365,0],"order":9944},{"id":"santizhu064-e-o090b","title":"朱异夜渡筑垒后为石苞州泰击破","accounts":[{"id":"santizhu064-a-48fd2c64a419ed74bad5","label":"正文","text":"朱异夜渡筑垒后为石苞州泰击破","evidence":["santizhu064-q-216d48cb470c163c85cd"]}],"participants":[{"person":"wuzhu-p0126","role":"遣部将夜渡筑垒，遭击破后退至高处并复作围","evidence":["santizhu064-q-216d48cb470c163c85cd"]},{"person":"santizhu-p0161","role":"奉命募勇士夜渡","evidence":["santizhu064-q-216d48cb470c163c85cd"]},{"person":"santizhu-p0162","role":"奉命募勇士夜渡","evidence":["santizhu064-q-216d48cb470c163c85cd"]},{"person":"shaodi-p0138","role":"与州泰击破朱异所部","evidence":["santizhu064-q-216d48cb470c163c85cd"]},{"person":"shaodi-p0035","role":"与石苞击破朱异所部","evidence":["santizhu064-q-216d48cb470c163c85cd"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"未由相邻段落推算纪年；原文时间表达保留在来源引句中。","evidence":["santizhu064-q-216d48cb470c163c85cd"]},"ordering_evidence":"santizhu064-q-216d48cb470c163c85cd","source_order":[64,90,44],"order":11017}],"persons":[{"id":"shaodi-p0138","name":"石苞","evidence":["shaodi-q-p056","wgc-q0028","wgc-q0120","santizhu064-q-216d48cb470c163c85cd","chenghuang-q-414c2d4ac18090afbb57","fangji-q-f263ce0a9086c07e657d","fangji-q-22e922118c4cdb43954a","fangji-q-b09c70b0a79f62c5bcaf"],"facts":[],"aliases":[],"mentions":[{"id":"shaodi-m-p056-shaodi-p0138","kind":"mention","text":"文中提及","evidence":["shaodi-q-p056"]},{"id":"shaodi-m-o191-shaodi-p0138","kind":"mention","text":"文中提及","evidence":["shaodi-q-o191"]},{"id":"wgc-m-o035-shaodi-p0138","kind":"mention","text":"本段涉及石苞","evidence":["wgc-q0028"]},{"id":"wgc-m-p039-shaodi-p0138","kind":"mention","text":"本段涉及石苞","evidence":["wgc-q0120"]}]}],"evidence":[{"id":"chenghuang-q-414c2d4ac18090afbb57","section":"chapter-055","block":"b-cfd59fad9ead02633b3b","layer":"original","quote":"宝鼎三年，皓命奉，与诸葛靓攻合肥。奉与晋大将石苞书〖17〗，构而间之〖18〗；苞以征还","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":364,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":43,"offset_unit":"unicode_code_point"},{"id":"fangji-q-22e922118c4cdb43954a","section":"chapter-029","block":"b-713f878d903057c2d70b","layer":"pei","quote":"欲闻其妙，君且善论其数也。’辂言：‘夫物不精不为神，数不妙不为术；故精者神之所合，妙者智之所遇；合之机微，可以性通，难以言论；是故鲁班不能说其手，离朱不能说其目。非言之难：孔子曰‘书不尽言’，言之细也；‘言不尽意’，意之微也：斯皆神妙之谓也。请举其大体以验之。夫白日登天，运景万里，无物不照；及其入地，一炭之光，不可得见。三五盈月，清耀烛夜，可以远望；及其在昼，明不如镜。今逃日月者必阴阳之数，阴阳之数通于万类；鸟兽犹化，况于人乎？夫得数者妙，得神者灵；非徒生者有验，死亦有征。是以杜伯乘火气以流精，彭生托水变以立形。是故生者能出亦能入，死者能显亦能幽；此物之精气，化之游魂；人鬼相感，数使之然也","attribution":"裴注·辂别传","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":408,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-03cc742182d2d4b5f511","start":300,"end":598,"offset_unit":"unicode_code_point"},{"id":"fangji-q-b09c70b0a79f62c5bcaf","section":"chapter-029","block":"b-713f878d903057c2d70b","layer":"pei","quote":"君何以不隐？’辂曰：‘夫陵虚之鸟，爱其清高，不愿江、汉之鱼；渊沼之鱼，乐其濡湿，不易腾风之鸟：由性异而分不同也。仆自欲正身以明道，直己以亲义；见数不以为异，知术不以为奇；夙夜研几，孳孳温故。而素隐行怪，未暇斯务也","attribution":"裴注·辂别传","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":408,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-03cc742182d2d4b5f511","start":616,"end":722,"offset_unit":"unicode_code_point"},{"id":"fangji-q-f263ce0a9086c07e657d","section":"chapter-029","block":"b-713f878d903057c2d70b","layer":"pei","quote":"与辂相见，问曰：‘闻君乡里翟文耀，能隐形，其事可信乎？’辂言：‘此但阴阳蔽匿之数。苟得其数，则四岳可藏，河海可逃；况以七尺之形，游变化之内；散云雾以幽身，布金水以灭迹？述足数成，不足为难","attribution":"裴注·辂别传","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":408,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-03cc742182d2d4b5f511","start":201,"end":294,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-216d48cb470c163c85cd","section":"chapter-064","block":"b-f1f75337999ea6de2e8a","layer":"original","quote":"异屯黎浆〖6〗，遣将军任度、张震等募勇敢六千人，于屯西六里为浮桥夜渡〖7〗，筑偃月垒〖8〗。为魏监军石苞及州泰所破，军却退就高。异复作车箱围，趋五木城","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":440,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":44,"end":119,"offset_unit":"unicode_code_point"},{"id":"shaodi-e-o191c-q","section":"chapter-004","block":"b-a7b192a40422b556c612","layer":"original","quote":"九月，乙未〖23〗，大赦。戊午〖24〗，司徒何曾为晋丞相。癸亥〖25〗，以骠骑将军司马望为司徒，征东大将军石苞为骠骑将军〖26〗，征南大将军陈骞为车骑将军。乙亥〖27〗，葬晋文王。闰月，庚辰〖28〗，康居、大宛献名马〖29〗；归于相国府，以显怀万国致远之勋。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":341,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":129,"offset_unit":"unicode_code_point"},{"id":"shaodi-e-p056a-q","section":"chapter-004","block":"b-dac5896f2380535b6283","layer":"pei","quote":"﹝二﹞《世语》曰：“初，青龙中，石苞鬻铁于长安。得见司马宣王，宣王知焉。后擢为尚书郎，历青州刺史、镇东将军。甘露中入朝，当还，辞高贵乡公，留中尽日。文王遣人邀，令过。文王问苞：‘何淹留也？’苞曰：‘非常人也！’明日发至荥阳，数日而难作。”","attribution":"《世语》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":122,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1ed87a609f609653d8e4","start":0,"end":119,"offset_unit":"unicode_code_point"},{"id":"shaodi-e-p056b-q","section":"chapter-004","block":"b-dac5896f2380535b6283","layer":"pei","quote":"﹝二﹞《世语》曰：“初，青龙中，石苞鬻铁于长安。得见司马宣王，宣王知焉。后擢为尚书郎，历青州刺史、镇东将军。甘露中入朝，当还，辞高贵乡公，留中尽日。文王遣人邀，令过。文王问苞：‘何淹留也？’苞曰：‘非常人也！’明日发至荥阳，数日而难作。”","attribution":"《世语》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":122,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1ed87a609f609653d8e4","start":0,"end":119,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-b-ded6d700dc6f860d1670","section":"chapter-004","block":"b-ded6d700dc6f860d1670","layer":"modern","quote":"〖1〗四年：景元四年（公元 263）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":201,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ef642248e44d01f3825d","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o165","section":"chapter-004","block":"b-b35fdf03685051716720","layer":"original","quote":"四年春二月〖1〗，复命大将军进位、爵赐，一如前诏。又固辞，乃止。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":194,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":32,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o171","section":"chapter-004","block":"b-cef469d41ec5962b4e48","layer":"original","quote":"咸熙元年春正月，壬戌〖1〗，槛车征邓艾〖2〗。甲子〖3〗，行幸长安。壬申〖4〗，使使者以璧币祀华山〖5〗。是月，钟会反于蜀，为众所讨。邓艾亦见杀。二月，辛卯〖6〗，特赦诸在益土者。庚申〖7〗，葬明元郭后。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":220,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":102,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o184","section":"chapter-004","block":"b-1096c71775017a1a0d00","layer":"original","quote":"二年春二月，甲辰〖1〗，朐顗县获灵龟以献〖2〗，归之于相国府。庚戌〖3〗，以虎贲张修，昔于成都驰马至诸营，言钟会反逆，以至没身；赐修弟倚，爵关内侯。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":334,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":74,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o191","section":"chapter-004","block":"b-a7b192a40422b556c612","layer":"original","quote":"九月，乙未〖23〗，大赦。戊午〖24〗，司徒何曾为晋丞相。癸亥〖25〗，以骠骑将军司马望为司徒，征东大将军石苞为骠骑将军〖26〗，征南大将军陈骞为车骑将军。乙亥〖27〗，葬晋文王。闰月，庚辰〖28〗，康居、大宛献名马〖29〗；归于相国府，以显怀万国致远之勋。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":341,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":129,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-p056","section":"chapter-004","block":"b-dac5896f2380535b6283","layer":"pei","quote":"﹝二﹞《世语》曰：“初，青龙中，石苞鬻铁于长安。得见司马宣王，宣王知焉。后擢为尚书郎，历青州刺史、镇东将军。甘露中入朝，当还，辞高贵乡公，留中尽日。文王遣人邀，令过。文王问苞：‘何淹留也？’苞曰：‘非常人也！’明日发至荥阳，数日而难作。”","attribution":"《世语》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":122,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1ed87a609f609653d8e4","start":0,"end":119,"offset_unit":"unicode_code_point"},{"id":"wgc-q0028","section":"chapter-028","block":"b-c135ec113c597ad4f2da","layer":"original","quote":"六月，车驾东征，至项。大将军司马文王督中外诸军二十六万众，临淮讨之。大将军屯丘头，使基及安东将军陈骞等四面合围，表里再重〖9〗，堑垒甚峻。又使监军石苞、兖州刺史州泰等〖10〗，简锐卒为游军〖11〗，备外寇。钦等数出犯围〖12〗，逆击走之。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":175,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":119,"offset_unit":"unicode_code_point"},{"id":"wgc-q0120","section":"chapter-028","block":"b-2c684f2b0eec488340ff","layer":"pei","quote":"﹝一﹞《世语》曰：“邓艾少为襄城典农部民，与石苞皆年十二三。谒者阳翟郭玄信，武帝监军郭诞元奕之子。建安中，少府吉本，起兵许都。玄信坐被刑，在家；从典农司马求人御。以艾、苞与御，行十余里，与语，悦之，谓二人皆当远至，为佐相。艾后为典农功曹，奉使诣宣王，由此见知，遂被拔擢。”","attribution":"世语","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":261,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f2e8626b788c9c29d72d","start":0,"end":136,"offset_unit":"unicode_code_point"},{"id":"wgc-q0282","section":"chapter-028","block":"b-c135ec113c597ad4f2da","layer":"original","quote":"又使监军石苞、兖州刺史州泰等〖10〗，简锐卒为游军〖11〗，备外寇","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":175,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":69,"end":102,"offset_unit":"unicode_code_point"},{"id":"wgc-q0601","section":"chapter-028","block":"b-2c684f2b0eec488340ff","layer":"pei","quote":"玄信坐被刑，在家；从典农司马求人御。以艾、苞与御，行十余里，与语，悦之，谓二人皆当远至，为佐相","attribution":"裴注·世语","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":261,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f2e8626b788c9c29d72d","start":63,"end":110,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
