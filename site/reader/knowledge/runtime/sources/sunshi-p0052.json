968b0","zhulv-q-eeafb4598bbaef21f780","zhulv-q-e0e3d6ac42ab9233d45b"]},"ordering_evidence":"zhulv-q-ed91176d1ef7a90968b0","source_order":[56,23,37],"order":9964},{"id":"zhulv-e-o025","title":"权优异之：自令督军御史典属城文书，治领四县租税而已","accounts":[{"id":"zhulv-a-9ccf759bddbf836b12fd","label":"正文","text":"权优异之：自令督军御史典属城文书，治领四县租税而已","evidence":["zhulv-q-778ed29204a1a19c3230"]}],"participants":[{"person":"sun-quan","role":"下令者","evidence":["zhulv-q-778ed29204a1a19c3230"]},{"person":"sunshi-p0052","role":"受任领租者","evidence":["zhulv-q-778ed29204a1a19c3230"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["zhulv-q-778ed29204a1a19c3230"]},"ordering_evidence":"zhulv-q-778ed29204a1a19c3230","source_order":[56,41,18],"order":9965},{"id":"zhulv-e-o026","title":"公族子弟及吴四姓多出仕郡，郡吏常以千数；治率数年一遣诣王府，所遣数百人；每岁时献御，权答报过厚","accounts":[{"id":"zhulv-a-a323b9affab881c58d97","label":"正文","text":"公族子弟及吴四姓多出仕郡，郡吏常以千数；治率数年一遣诣王府，所遣数百人；每岁时献御，权答报过厚","evidence":["zhulv-q-1ae5b9a636b845505d75"]}],"participants":[{"person":"sunshi-p0052","role":"遣吏者","evidence":["zhulv-q-1ae5b9a636b845505d75"]},{"person":"sun-quan","role":"答报过厚者","evidence":["zhulv-q-1ae5b9a636b845505d75"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["zhulv-q-1ae5b9a636b845505d75"]},"ordering_evidence":"zhulv-q-1ae5b9a636b845505d75","source_order":[56,41,50],"order":9966},{"id":"zhulv-e-o027","title":"是时丹杨深地颇有奸叛，治亦以年向老、思恋土风，自表屯故鄣，镇抚山越","accounts":[{"id":"zhulv-a-df681adf28ee9e4235a3","label":"正文","text":"是时丹杨深地颇有奸叛，治亦以年向老、思恋土风，自表屯故鄣，镇抚山越","evidence":["zhulv-q-0b8360ab79d5ebd2bfd7"]},{"id":"zhulv-a-24b4f5136b264e45f6c4","label":"正文","text":"诸父老故人莫不诣门，治皆引进，与共饮宴，乡党以为荣","evidence":["zhulv-q-6357551e7751bf39bcf4"]}],"participants":[{"person":"sunshi-p0052","role":"自表屯鄣者；引进饮宴者","evidence":["zhulv-q-0b8360ab79d5ebd2bfd7","zhulv-q-6357551e7751bf39bcf4"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["z