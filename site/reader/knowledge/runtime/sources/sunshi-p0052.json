["zhulv-q-ed91176d1ef7a90968b0"]},{"id":"zhulv-a-924820ba127eebfbe605","label":"正文","text":"治闻之，求往见贲，为陈安危，贲由此遂止","evidence":["zhulv-q-eeafb4598bbaef21f780"]},{"id":"zhulv-a-43c024eddd22af6f4e98","label":"裴注·江表传","text":"《江表传》载治说贲：破虏昔率义兵讨董卓声冠中夏，讨逆廓定六郡，讨虏聪明神武继承洪业必克成王基应运东南，刘备远布腹心求见拯救；今曹公阻兵倾覆汉室、幼帝流离、中国萧条，岂能越长江与我争利；责其欲背骨肉之亲、违万安之计，为一女子改虑易图，失机毫厘差以千里","evidence":["zhulv-q-e0e3d6ac42ab9233d45b"]}],"participants":[{"person":"sunshi-p0027","role":"畏惧欲遣子入质者；闻而止者；被说者","evidence":["zhulv-q-ed91176d1ef7a90968b0","zhulv-q-eeafb4598bbaef21f780","zhulv-q-e0e3d6ac42ab9233d45b"]},{"person":"cao-cao","role":"破荆州威震南土、其公子娶贲女者（背景）；阻兵倾覆汉室者（背景）","evidence":["zhulv-q-ed91176d1ef7a90968b0","zhulv-q-e0e3d6ac42ab9233d45b"]},{"person":"sunshi-p0052","role":"往陈安危者；进说者","evidence":["zhulv-q-eeafb4598bbaef21f780","zhulv-q-e0e3d6ac42ab9233d45b"]},{"person":"wudi-p0119","role":"破虏将军（背景）","evidence":["zhulv-q-e0e3d6ac42ab9233d45b"]},{"person":"wudi-p0099","role":"讨逆（背景）","evidence":["zhulv-q-e0e3d6ac42ab9233d45b"]},{"person":"sun-quan","role":"讨虏（背景）","evidence":["zhulv-q-e0e3d6ac42ab9233d45b"]},{"person":"liu-bei","role":"远布腹心者（背景）","evidence":["zhulv-q-e0e3d6ac42ab9233d45b"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["zhulv-q-ed91176d1ef7a90968b0","zhulv-q-eeafb4598bbaef21f780","zhulv-q-e0e3d6ac42ab9233d45b"]},"ordering_evidence":"zhulv-q-ed91176d1ef7a90968b0","source_order":[56,23,37],"order":9964},{"id":"zhulv-e-o025","title":"权优异之：自令督军御史典属城文书，治领四县租税而已","accounts":[{"id":"zhulv-a-9ccf759bddbf836b12fd","label":"正文","text":"权优异之：自令督军御史典属城文书，治领四县租税而已","evidence":["zhulv-q-778ed29204a1a19c3230"]}],"participants":[{"person":"sun-quan","role":"下令者","evidence":["zhulv-q-778ed29204a1a19c3230"]},{"person":"sunshi-p0052","role":"受任领租者","evidence":["zhulv-q-778ed29204a1a19c3230"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["zhulv-q-778ed29204a1a19c3230"]},"ordering_evidence":"zhulv-q-778ed29204a1a19c3230","source_order":[56,41,18],"order":9965},{"id":"zhulv-e-o026","title":"公族子弟及吴四姓多出仕郡，郡吏常以千数；治率数年一遣诣王府，所遣数百人；每岁时献御，权答报过厚","accounts":[{"id":"zhulv-a-a323b9affab881c58d97","label":"正文","text":"公族子弟及吴四姓多出仕郡，郡吏常以千数；治率数年一遣诣王府，所遣数百人；每岁时献御，权答报过厚","evidence":["zhulv-q-1ae5b9a636b845505d75"]}],"participants":[{"person":"sunshi-p0052","role":"遣吏者","evidence":["zhulv-q-1ae5b9a636b845505d75"]},{"person":"sun-quan","role":"答报过厚者","evidence":["zhulv-q-1ae5b9a636b845505d75"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["zhulv-q-1ae5b9a636b845505d75"]},"ordering_evidence":"zhulv-q-1ae5b9a636b845505d75","source_order":[56,41,50],"order":9966},{"id":"zhulv-e-o027","title":"是时丹杨深地颇有奸叛，治亦以年向老、思恋土风，自表屯故鄣，镇抚山越","accounts":[{"id":"zhulv-a-df681adf28ee9e4235a3","label":"正文","text":"是时丹杨深地颇有奸叛，治亦以年向老、思恋土风，自表屯故鄣，镇抚山越","evidence":["zhulv-q-0b8360ab79d5ebd2bfd7"]},{"id":"zhulv-a-24b4f5136b264e45f6c4","label":"正文","text":"诸父老故人莫不诣门，治皆引进，与共饮宴，乡党以为荣","evidence":["zhulv-q-6357551e7751bf39bcf4"]}],"participants":[{"person":"sunshi-p0052","role":"自表屯鄣者；引进饮宴者","evidence":["zhulv-q-0b8360ab79d5ebd2bfd7","zhulv-q-6357551e7751bf39bcf4"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["zhulv-q-0b8360ab79d5ebd2bfd7","zhulv-q-6357551e7751bf39bcf4"]},"ordering_evidence":"zhulv-q-0b8360ab79d5ebd2bfd7","source_order":[56,42,0],"order":9967},{"id":"zhulv-e-o028","title":"治在故鄣岁余，还吴；黄武三年卒，在郡三十一年，年六十九","accounts":[{"id":"zhulv-a-ce6cfb076f23d4e72b50","label":"正文","text":"治在故鄣岁余，还吴；黄武三年卒，在郡三十一年，年六十九","evidence":["zhulv-q-f9376e8e970bc73d7ff1"]}],"participants":[{"person":"sunshi-p0052","role":"还吴而卒者","evidence":["zhulv-q-f9376e8e970bc73d7ff1"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["zhulv-q-f9376e8e970bc73d7ff1"]},"ordering_evidence":"zhulv-q-f9376e8e970bc73d7ff1","source_order":[56,43,0],"order":9968},{"id":"zhulv-e-o031","title":"初治未有子，然年十三，乃启策乞以为嗣；策命丹杨郡以羊酒召然；然到吴，策优以礼贺","accounts":[{"id":"zhulv-a-dd72e04278dc5c361a9f","label":"正文","text":"初治未有子，然年十三，乃启策乞以为嗣；策命丹杨郡以羊酒召然；然到吴，策优以礼贺","evidence":["zhulv-q-295e23eea352664c76b7"]}],"participants":[{"person":"sunshi-p0052","role":"乞嗣者","evidence":["zhulv-q-295e23eea352664c76b7"]},{"person":"mingdi-p0046","role":"被立为嗣者","evidence":["zhulv-q-295e23eea352664c76b7"]},{"person":"wudi-p0099","role":"命郡召而礼贺者","evidence":["zhulv-q-295e23eea352664c76b7"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["zhulv-q-295e23eea352664c76b7"]},"ordering_evidence":"zhulv-q-295e23eea352664c76b7","source_order":[56,54,16],"order":9971}],"persons":[{"id":"sunshi-p0052","name":"朱治","evidence":["sunshi-q-o031","zhanggu-q-5f0e007b5ff964af5dc6","zongshi-q-a5f0ea7471a824564e27","zhulv-q-faa0b128dd0d996ab7b1","zhulv-q-b9aa5f06157da1a7f3fa","zhulv-q-0187f2cf887663ea68ac","zhulv-q-50a35ad4af38a54c242c","zhulv-q-fbd76786e8ea098b9626","zhulv-q-c96f6b60e11508c9c805","zhulv-q-374c85733e1fa1c641b0","zhulv-q-54a20b9bb3d95f6a4f6e","zhulv-q-b2ec842802a6d073330c","zhulv-q-425e0a248acfe7477559","zhulv-q-9aef41db5c2075129bc1","zhulv-q-909d78cc3cae20fe1c9a","zhulv-q-0d61a7528e4c20f21c28","zhulv-q-312648162b7cb7ecd6f4","zhulv-q-eff98f8c027d151cbbbe","zhulv-q-7772c2905aa6b5842382","zhulv-q-eeafb4598bbaef21f780","zhulv-q-778ed29204a1a19c3230","zhulv-q-1ae5b9a636b845505d75","zhulv-q-0b8360ab79d5ebd2bfd7","zhulv-q-6357551e7751bf39bcf4","zhulv-q-f9376e8e970bc73d7ff1","zhulv-q-295e23eea352664c76b7","zhulv-q-602ea0fde80a0a0d0292","zhulv-q-e0e3d6ac42ab9233d45b","zhulv-q2-8294e146e763f25f1bc4","zhulv-q2-c2095ecbd83f24ab2678","zhulv-q2-08b74e60ca733a22c08b","zhulv-q2-e6ea50b43cc15f47254c","zhulv-q2-d1c256a11fc343148c35","yululu-q-e631bc8aaa000678a1b1"],"facts":[{"id":"zhulv-f2-1d426800c8ed2cbd26dc","text":"初为县吏，察孝廉，州辟从事。","evidence":["zhulv-q2-8294e146e763f25f1bc4"]},{"id":"zhulv-f2-af53700c32ef73fea8f4","text":"中平五年，拜司马。","evidence":["zhulv-q2-c2095ecbd83f24ab2678"]},{"id":"zhulv-f2-88b2263aa2ca1751a856","text":"迁吴郡都尉。","evidence":["zhulv-q2-08b74e60ca733a22c08b"]},{"id":"zhulv-f2-1b38af9ad81f4d8edf15","text":"黄武元年，封毗陵侯，领郡如故；二年，拜安国将军，金印紫绶，徙封故鄣。","evidence":["zhulv-q2-e6ea50b43cc15f47254c"]},{"id":"zhulv-f2-98070a49d1bc7727e3de","text":"子才素为校尉领兵；嗣父爵，迁偏将军。","evidence":["zhulv-q2-d1c256a11fc343148c35"]}],"aliases":[],"mentions":[{"id":"sunshi-m-o031-sunshi-p0052","kind":"mention","text":"文中提及","evidence":["sunshi-q-o031"]},{"id":"zhanggu-m-84724cbe58ebb139b492","kind":"mention","text":"本段涉及朱治","evidence":["zhanggu-q-5f0e007b5ff964af5dc6"]},{"id":"zhulv-m2-6253b6bde64c7afc4352","kind":"mention","text":"文中提及","evidence":["zhulv-q-602ea0fde80a0a0d0292"]},{"id":"yululu-m-4deb344c786fcd3767fb","kind":"mention","text":"骆统表言暨艳\"先见用于朱治\"","evidence":["yululu-q-e631bc8aaa000678a1b1"]}]}],"evidence":[{"id":"chenghuang-q-da6c3fb33ec12adaad73","section":"chapter-055","block":"b-90332a44cc1d7f140301","layer":"original","quote":"从孙坚征伐，讨黄巾于宛、邓，破董卓于阳人；攻城野战，身被创夷","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":1,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":35,"end":65,"offset_unit":"unicode_code_point"},{"id":"sunshi-e-o011b-q","section":"chapter-046","block":"b-488a6db6b68ceede0be9","layer":"original","quote":"周朝、郭石，亦帅徒众起于零、桂〖24〗，与星相应；遂越境寻讨，三郡肃然。汉朝录前后功，封坚乌程侯〖25〗。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":51,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":64,"end":117,"offset_unit":"unicode_code_point"},{"id":"sunshi-e-o016a-q","section":"chapter-046","block":"b-6abf6e06036e75998b11","layer":"original","quote":"坚复相收兵，合战于阳人〖32〗；大破卓军，枭其都督华雄等〖33〗。﹝五﹞","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":85,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":36,"offset_unit":"unicode_code_point"},{"id":"sunshi-e-o028a-q","section":"chapter-046","block":"b-5f6ab83e97199a3cab55","layer":"original","quote":"策乃说术〖1〗，乞助景等平定江东〖2〗。﹝一﹞术表策为折冲校尉〖3〗，行殄寇将军〖4〗；","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":212,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":44,"offset_unit":"unicode_code_point"},{"id":"sunshi-e-o031b-q","section":"chapter-046","block":"b-cdb6c814242d1c81716e","layer":"original","quote":"尽更置长吏。策自领会稽太守，复以吴景为丹杨太守，以孙贲为豫章太守〖14〗；分豫章为庐陵郡〖15〗，以贲弟辅为庐陵太守〖16〗；丹杨朱治〖17〗，为吴郡太守。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":215,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":36,"end":114,"offset_unit":"unicode_code_point"},{"id":"sunshi-e-p036a-q","section":"chapter-046","block":"b-db9fc0cdb59cdfb799f5","layer":"pei","quote":"﹝一﹞《江表传》曰：“策说术云：‘家有旧恩在东，愿助舅讨横江；横江拔，因投本土召募，可得三万兵：以佐明使君匡济汉室。’术知其恨，而以刘繇据曲阿，王朗在会稽；谓策未必能定，故许之。”","attribution":"《江表传》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":247,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-d9a42142482ca251e68d","start":0,"end":90,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-o031","section":"chapter-046","block":"b-cdb6c814242d1c81716e","layer":"original","quote":"遂引兵渡浙江〖11〗，据会稽〖12〗，屠东冶〖13〗，乃攻破虎等。﹝四﹞尽更置长吏。策自领会稽太守，复以吴景为丹杨太守，以孙贲为豫章太守〖14〗；分豫章为庐陵郡〖15〗，以贲弟辅为庐陵太守〖16〗；丹杨朱治〖17〗，为吴郡太守。彭城张昭、广陵张纮、秦松、陈端等为谋主〖18〗。﹝五﹞","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":215,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":141,"offset_unit":"unicode_code_point"},{"id":"yululu-q-e631bc8aaa000678a1b1","section":"chapter-057","block":"b-2980ba0a1e92ec4ad20b","layer":"original","quote":"国家之于暨艳，不纳之忌族〖22〗，犹等之平民；是故先见用于朱治，次见举于众人，中见任于明朝，亦见交于温也。君臣之义〖23〗，义之最重；朋友之交，交之最轻者也。国家不嫌于艳为最重之义〖24〗，是以温亦不嫌与艳为最轻之交也；时世宠之于上〖25〗，温窃亲之于下也。","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":240,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":129,"offset_unit":"unicode_code_point"},{"id":"zhanggu-q-5f0e007b5ff964af5dc6","section":"chapter-052","block":"b-4fa9395bb38fd3eb68c6","layer":"original","quote":"吴郡太守朱治，权举将也〖7〗，权曾有以望之〖8〗；而素加敬，难自诘让〖9〗，忿忿不解。瑾揣知其故，而不敢显陈，乃乞以意私自问。遂于权前为书〖10〗，泛论物理；因以己心，遥往忖度之。毕，以呈权；权喜，笑曰：“孤意解矣！颜氏之德〖11〗，使人加亲〖12〗：岂谓此邪","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":240,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":130,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-0187f2cf887663ea68ac","section":"chapter-056","block":"b-58cce53fa1659006dc07","layer":"original","quote":"从破董卓于阳人，入洛阳","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":2,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":41,"end":52,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-0b8360ab79d5ebd2bfd7","section":"chapter-056","block":"b-406c58e1e0e63edde61b","layer":"original","quote":"是时丹杨深地，颇有奸叛，亦以年向老，思恋土风〖6〗；自表屯故鄣，镇抚山越","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":41,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":36,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-0d61a7528e4c20f21c28","section":"chapter-056","block":"b-b882384ef96f74245450","layer":"original","quote":"建安七年，权表治为（九）真太守，行扶义将军；割娄、由拳、无锡、毗陵为奉邑〖1〗，置长吏","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":20,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":14,"end":57,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-1ae5b9a636b845505d75","section":"chapter-056","block":"b-569c3221167de5daba41","layer":"original","quote":"然公族子弟及吴四姓多出仕郡〖4〗，郡吏常以千数；治率数年一遣诣王府〖5〗，所遣数百人。每岁时献御，权答报过厚","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":40,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":50,"end":104,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-295e23eea352664c76b7","section":"chapter-056","block":"b-ecbba0380ad0bc253d16","layer":"original","quote":"初治未有子，然年十三，乃启策乞以为嗣〖1〗。策命丹杨郡以羊酒召然〖2〗。然到吴，策优以礼贺","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":53,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":16,"end":61,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-312648162b7cb7ecd6f4","section":"chapter-056","block":"b-b882384ef96f74245450","layer":"original","quote":"征讨夷越〖3〗，佐定东南，擒截黄巾余类陈败、万秉等","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":20,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":61,"end":86,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-374c85733e1fa1c641b0","section":"chapter-056","block":"b-53b95a44617c09adb1fa","layer":"original","quote":"时太傅马日！在寿春〖5〗，辟治为掾","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":4,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":17,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-425e0a248acfe7477559","section":"chapter-056","block":"b-907cdb867e6182d7fbaa","layer":"original","quote":"治遂入郡，领太守事","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":6,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":9,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-50a35ad4af38a54c242c","section":"chapter-056","block":"b-58cce53fa1659006dc07","layer":"original","quote":"表治行督军校尉〖2〗，特将步骑〖3〗，东助徐州牧陶谦讨黄巾","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":2,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":53,"end":82,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-54a20b9bb3d95f6a4f6e","section":"chapter-056","block":"b-53b95a44617c09adb1fa","layer":"original","quote":"而策家门尽在州下〖9〗，治乃使人于曲阿迎太妃及权兄弟，所以供奉辅护，甚有恩纪","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":4,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":67,"end":105,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-602ea0fde80a0a0d0292","section":"chapter-056","block":"b-07b20463f19d9ca2a1a8","layer":"original","quote":"初，然为治行丧竟〖21〗，乞复本姓：权不许","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":123,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-6357551e7751bf39bcf4","section":"chapter-056","block":"b-406c58e1e0e63edde61b","layer":"original","quote":"诸父老故人，莫不诣门；治皆引进，与共饮宴：乡党以为荣","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":41,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":37,"end":63,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-7772c2905aa6b5842382","section":"chapter-056","block":"b-830e1b7b03ae5a272e12","layer":"original","quote":"初，权弟翊，性峭急〖10〗，喜怒快意〖11〗。治数责数〖12〗，喻以道义","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":22,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":36,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-778ed29204a1a19c3230","section":"chapter-056","block":"b-569c3221167de5daba41","layer":"original","quote":"权优异之：自令督军御史典属城文书〖2〗，治领四县租税而已","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":40,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":18,"end":46,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-909d78cc3cae20fe1c9a","section":"chapter-056","block":"b-b882384ef96f74245450","layer":"original","quote":"后策薨，治与张昭等共尊奉权","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":20,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":13,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-9aef41db5c2075129bc1","section":"chapter-056","block":"b-907cdb867e6182d7fbaa","layer":"original","quote":"权年十五，治举为孝廉","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":6,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":25,"end":35,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-b2ec842802a6d073330c","section":"chapter-056","block":"b-6e29ea033fd039ec581b","layer":"original","quote":"治从钱唐欲进到吴〖11〗，吴郡太守许贡拒之于由拳。治与战，大破之。贡南就山贼严白虎","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":5,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":41,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-b9aa5f06157da1a7f3fa","section":"chapter-056","block":"b-58cce53fa1659006dc07","layer":"original","quote":"从讨长沙、零、桂等三郡贼周朝、苏马等，有功，坚表治行都尉","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":2,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":9,"end":37,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-c96f6b60e11508c9c805","section":"chapter-056","block":"b-b84052514322d6752783","layer":"original","quote":"后知术政德不立，乃劝策还平江东","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":3,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":17,"end":32,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-e0e3d6ac42ab9233d45b","section":"chapter-056","block":"b-4ba7559dc4f6890a6e38","layer":"pei","quote":"破虏将军昔率义兵入讨董卓，声冠中夏：义士壮之。讨逆继世，廓定六郡；特以君侯骨肉至亲，器为时生；故表汉朝，剖符大郡，兼建将校，仍关综两府：荣冠宗室，为远近所瞻。加讨虏聪明神武，继承洪业；揽结英雄，周济世务；军众日盛，事业日隆。虽昔萧王之在河北，无以加也；必克成王基，应运东南。故刘玄德远布腹心，求见拯救。此天下所共知也。前在东，闻道路之言，云将军‘有异趣’，良用怃然！今曹公阻兵，倾覆汉室，幼帝流离；百姓元元，未知所归。而中国萧条，或百里无烟；城邑空虚，道殣相望；士叹于外，妇怨乎室；加之以师旅，因之以饥馑。以此料之，岂能越长江与我争利哉！将军当斯时也，而欲背骨肉之亲，违万安之计，割同气之肤，啖虎狼之口；为一女子，改虑易图；失机毫厘，差以千里：岂不惜哉","attribution":"裴注·江表传","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":39,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0a35fcb1544e7e1e70ab","start":15,"end":341,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-ed91176d1ef7a90968b0","section":"chapter-056","block":"b-830e1b7b03ae5a272e12","layer":"original","quote":"权从兄豫章太守贲〖13〗，女为曹公子妇〖14〗。及曹公破荆州，威震南土。贲畏惧，欲遣子入质","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":22,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":37,"end":82,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-eeafb4598bbaef21f780","section":"chapter-056","block":"b-830e1b7b03ae5a272e12","layer":"original","quote":"治闻之，求往见贲，为陈安危；﹝一﹞贲由此遂止","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":22,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":83,"end":105,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-eff98f8c027d151cbbbe","section":"chapter-056","block":"b-67fb58972903db38bbf7","layer":"original","quote":"权历位上将〖7〗，及为吴王；治每进见，权常亲迎，执版交拜〖8〗。飨宴赠赐，恩敬特隆，至从行吏皆得奉贽私觌〖9〗：其见异如此","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":21,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":43,"end":104,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-f9376e8e970bc73d7ff1","section":"chapter-056","block":"b-a5a0541af72a1a72b30e","layer":"original","quote":"在故鄣岁余，还吴。黄武三年卒，在郡三十一年，年六十九","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":42,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":26,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-faa0b128dd0d996ab7b1","section":"chapter-056","block":"b-5acfb6aba1224ef98ab9","layer":"original","quote":"随孙坚征伐","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":1,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":28,"end":33,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-fbd76786e8ea098b9626","section":"chapter-056","block":"b-b84052514322d6752783","layer":"original","quote":"会坚薨，治扶翼策〖4〗，依就袁术","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":3,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":16,"offset_unit":"unicode_code_point"},{"id":"zhulv-q2-08b74e60ca733a22c08b","section":"chapter-056","block":"b-53b95a44617c09adb1fa","layer":"original","quote":"时太傅马日！在寿春〖5〗，辟治为掾。迁吴郡都尉。是时吴景已在丹杨〖6〗，而策为术攻庐江；于是刘繇恐为袁、孙所并〖7〗，遂构嫌隙〖8〗。而策家门尽在州下〖9〗，治乃使人于曲阿迎太妃及权兄弟，所以供奉辅护，甚有恩纪〖10〗。","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":4,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":110,"offset_unit":"unicode_code_point"},{"id":"zhulv-q2-8294e146e763f25f1bc4","section":"chapter-056","block":"b-5acfb6aba1224ef98ab9","layer":"original","quote":"朱治字君理，丹杨故鄣人也。初为县吏，后察孝廉，州辟从事。随孙坚征伐。","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":1,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":34,"offset_unit":"unicode_code_point"},{"id":"zhulv-q2-c2095ecbd83f24ab2678","section":"chapter-056","block":"b-58cce53fa1659006dc07","layer":"original","quote":"中平五年，拜司马。从讨长沙、零、桂等三郡贼周朝、苏马等，有功，坚表治行都尉〖1〗。从破董卓于阳人，入洛阳。表治行督军校尉〖2〗，特将步骑〖3〗，东助徐州牧陶谦讨黄巾。","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":2,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":83,"offset_unit":"unicode_code_point"},{"id":"zhulv-q2-d1c256a11fc343148c35","section":"chapter-056","block":"b-002597445d11a4609bbe","layer":"original","quote":"子才，素为校尉领兵；既嗣父爵，迁偏将军。﹝一﹞才弟纪，权以策女妻之；亦以校尉领兵。纪弟纬、万岁，皆早夭。才子琬，袭爵为将，至镇西将军。","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":43,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":67,"offset_unit":"unicode_code_point"},{"id":"zhulv-q2-e6ea50b43cc15f47254c","section":"chapter-056","block":"b-67fb58972903db38bbf7","layer":"original","quote":"黄武元年，封毗陵侯，领郡如故。二年〖4〗，拜安国将军〖5〗，金印紫绶〖6〗，徙封故鄣。权历位上将〖7〗，及为吴王；治每进见，权常亲迎，执版交拜〖8〗。飨宴赠赐，恩敬特隆，至从行吏皆得奉贽私觌〖9〗：其见异如此。","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":21,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":105,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-a5f0ea7471a824564e27","section":"chapter-051","block":"b-d2edf9c41227a70afff2","layer":"original","quote":"太守朱治举孝廉〖1〗，司空辟","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":145,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":20,"end":34,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
