3719}],"persons":[{"id":"lizang-p0072","name":"赵息","evidence":["lizang-q-ab403694268781b033cf","lizang-q-ebc2651fc5caa6212477","lizang-q-5c345c7fe675399421a1","lizang-q-52c101e4de3cc480cc79"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[{"id":"lizang-q-52c101e4de3cc480cc79","section":"chapter-018","block":"b-55531cdb96f8079c0577","layer":"pei","quote":"时息从父仲台，现为凉州刺史；于是衡为诏，征仲台，遣归。遂诏中都官及郡部督邮：捕诸赵尺儿以上，及仲台皆杀之；有藏者，与同罪","attribution":"裴注·魏略《勇侠传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":278,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-48d5c144befb35f43c2d","start":277,"end":337,"offset_unit":"unicode_code_point"},{"id":"lizang-q-575cbfc2ffcd5994842d","section":"chapter-018","block":"b-55531cdb96f8079c0577","layer":"pei","quote":"延熹中，衡弟为京兆虎牙都尉，秩比二千石，而统属郡。衡弟初之官，不修敬于京兆尹，入门不持版","attribution":"裴注·魏略《勇侠传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":278,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-48d5c144befb35f43c2d","start":35,"end":79,"offset_unit":"unicode_code_point"},{"id":"lizang-q-5c345c7fe675399421a1","section":"chapter-018","block":"b-55531cdb96f8079c0577","layer":"pei","quote":"息自知前过，乃逃走","attribution":"裴注·魏略《勇侠传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":278,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-48d5c144befb35f43c2d","start":267,"end":276,"offset_unit":"unicode_code_point"},{"id":"lizang-q-ab403694268781b033cf","section":"chapter-018","block":"b-55531cdb96f8079c0577","layer":"pei","quote":"郡功曹赵息呵廊下曰：‘虎牙，仪如属城，何得放臂入府门！’促收其主簿。衡弟顾促取版，既入见尹","attribution":"裴注·魏略《勇侠传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":278,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-48d5c144befb35f43c2d","start":80,"end":125,"offset_unit":"unicode_code_point"},{"id":"lizang-q-ebc2651fc5caa6212477","section":"chapter-018","block":"b-55531cdb96f8079c0577","layer":"pei","quote":"息又启云：‘左悺、〔唐衡〕子弟，来为虎牙，非德选；不足为特酤买，宜随中舍菜食而已。’及其到官，遣吏奉笺谢尹；息又敕门，言：‘无常见此无阴儿辈子弟邪？用其笺记为通乎！’晚乃通之，又不得即令报","attribution":"裴注·魏略《勇侠传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":278,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-48d5c144befb35f43c2d","start":138,"end":232,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
