6a0d60"]}],"participants":[{"person":"liusima-p0026","role":"至敦煌固辞疾笃","evidence":["lizang-q-980412af37dda26a0d60"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["lizang-q-980412af37dda26a0d60"]},"ordering_evidence":"lizang-q-980412af37dda26a0d60","source_order":[18,253,46],"order":3715},{"id":"lizang-e-o230","title":"张恭太和中卒，赠执金吾","accounts":[{"id":"lizang-a-bd956908d1b4862b3f0f","label":"正文","text":"张恭太和中卒，赠执金吾","evidence":["lizang-q-af7fd25d21aed279415d"]}],"participants":[{"person":"liusima-p0026","role":"卒赠执金吾","evidence":["lizang-q-af7fd25d21aed279415d"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["lizang-q-af7fd25d21aed279415d"]},"ordering_evidence":"lizang-q-af7fd25d21aed279415d","source_order":[18,254,0],"order":3716}],"persons":[{"id":"liusima-p0026","name":"张恭","evidence":["liusima-q-cd82892baa6f03578c78","lizang-q-26a1a4355819df8f18fa","lizang-q-fccafd1b3c0107a35e90","lizang-q-ca4c762cb67d21cb7d57","lizang-q-34bd8dc4ffe56d7434c3","lizang-q-49bc1aa25f35e32ade60","lizang-q-9ec1083cfa870b70e6ca","lizang-q-980412af37dda26a0d60","lizang-q-af7fd25d21aed279415d","lizang-q2-b53219393ed52f91a3f2","lizang-q-50a98d08eaf087e53acc"],"facts":[{"id":"lizang-f2-16ac48d10f39d3aa828c","text":"为戊己校尉；数岁征还，拟为侍臣，以疾笃不就，子就代为校尉。","evidence":["lizang-q2-b53219393ed52f91a3f2"]},{"id":"lizang-f2-796b58d7e54e72f7e06a","text":"《世语》记就子敩字祖文，晋武帝世为广汉太守，后至匈奴中郎将；曾收王濬从事列上，帝召还责问而后善其答；敩子固字元安，为黄门郎，早卒。","evidence":["lizang-q-50a98d08eaf087e53acc"]}],"aliases":[],"mentions":[]}],"evidence":[{"id":"liusima-q-7a640fc9795029a728d2","section":"chapter-015","block":"b-9d369236f45a972c5dfe","layer":"original","quote":"张掖张进执郡守，举兵拒岐；黄华、麹演各逐故太守，举兵以应之","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":160,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":22,"end":51,"offset_unit":"unicode_code_point"},{"id":"liusima-q-aa0eab2115d01c9efa15","section":"chapter-015","block":"b-9d369236f45a972c5dfe","layer":"original","quote":"既进兵，为护羌校尉苏则声势〖1〗，故则得以有功","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":160,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":52,"end":75,"offset_unit":"unicode_code_point"},{"id":"liusima-q-cd82892baa6f03578c78","section":"chapter-015","block":"b-f47115d2b1aa6550f308","layer":"original","quote":"其所礼辟：扶风庞延、天水杨阜、安定胡遵、酒泉庞淯，敦煌张恭、周生烈等，终皆有名位","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":182,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":13,"end":53,"offset_unit":"unicode_code_point"},{"id":"lizang-q-26a1a4355819df8f18fa","section":"chapter-018","block":"b-70898cfcffa39d291237","layer":"original","quote":"功曹张恭，素有学行，郡人推行长史事：恩信甚著","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":250,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":30,"end":52,"offset_unit":"unicode_code_point"},{"id":"lizang-q-34bd8dc4ffe56d7434c3","section":"chapter-018","block":"b-f2c7a004344479739639","layer":"original","quote":"恭即遣从弟华，攻酒泉沙头、乾齐二县〖14〗。恭又连兵，寻继华后，以为首尾之援","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":251,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":38,"offset_unit":"unicode_code_point"},{"id":"lizang-q-49bc1aa25f35e32ade60","section":"chapter-018","block":"b-f2c7a004344479739639","layer":"original","quote":"别遣铁骑二百，迎吏官属；东缘酒泉北塞，径出张掖北河，逢迎太守尹奉","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":251,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":39,"end":71,"offset_unit":"unicode_code_point"},{"id":"lizang-q-50a98d08eaf087e53acc","section":"chapter-018","block":"b-f9f42767ee144928c752","layer":"pei","quote":"﹝一﹞《世语》曰：“就子敩，字祖文。弘毅有干正，晋武帝世，为广汉太守。王濬在益州，受中制，募兵讨吴，无虎符；敩收濬从事，列上，由此召敩还。帝责敩：‘何不密启而便收从事？’敩曰：‘蜀汉绝远，刘备尝用之。辄收，臣犹以为轻！’帝善之。官至匈奴中郎将。敩子固，字元安。有敩风，为黄门郎，早卒。”敩，一本作勃。","attribution":"裴注（引书见引句）","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":276,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-48d5c144befb35f43c2d","start":0,"end":150,"offset_unit":"unicode_code_point"},{"id":"lizang-q-6990f13f51360a8892b1","section":"chapter-018","block":"b-70898cfcffa39d291237","layer":"original","quote":"时酒泉黄华、张掖张进，各据其郡，欲与恭（艾）并势","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":250,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":67,"end":91,"offset_unit":"unicode_code_point"},{"id":"lizang-q-905417782ade1ced54ad","section":"chapter-018","block":"b-70898cfcffa39d291237","layer":"original","quote":"就至酒泉，为华所拘执；劫以白刃，就终不回","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":250,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":92,"end":112,"offset_unit":"unicode_code_point"},{"id":"lizang-q-980412af37dda26a0d60","section":"chapter-018","block":"b-bc0aa4fb7b38adf3cac1","layer":"original","quote":"恭至敦煌〖18〗，固辞疾笃","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":252,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":46,"end":59,"offset_unit":"unicode_code_point"},{"id":"lizang-q-9ec1083cfa870b70e6ca","section":"chapter-018","block":"b-bc0aa4fb7b38adf3cac1","layer":"original","quote":"黄初二年，下诏褒扬，赐恭爵关内侯","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":252,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":16,"offset_unit":"unicode_code_point"},{"id":"lizang-q-af7fd25d21aed279415d","section":"chapter-018","block":"b-f404891015437d265f2e","layer":"original","quote":"太和中卒，赠执金吾","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":253,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":9,"offset_unit":"unicode_code_point"},{"id":"lizang-q-bbbf7e14283ba5da8cab","section":"chapter-018","block":"b-f2c7a004344479739639","layer":"original","quote":"于是，张进须黄华之助〖16〗；华欲救进，西顾恭兵，恐急击其后，遂诣金城太守苏则降","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":251,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":76,"end":116,"offset_unit":"unicode_code_point"},{"id":"lizang-q-ca4c762cb67d21cb7d57","section":"chapter-018","block":"b-70898cfcffa39d291237","layer":"original","quote":"私与恭疏曰：“大人率厉敦煌〖7〗，忠义显然，岂以就在困厄之中而替之哉〖8〗！昔乐羊食子〖9〗，李通覆家〖10〗；经国之臣，宁怀妻孥邪〖11〗？今大军垂至，但当促兵以掎之耳〖12〗！愿不以下流之爱〖13〗，使就有恨于黄壤也","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":250,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":116,"end":226,"offset_unit":"unicode_code_point"},{"id":"lizang-q-d26b436e440fc95daf4b","section":"chapter-018","block":"b-f2c7a004344479739639","layer":"original","quote":"就竟平安，奉得之官","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":251,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":117,"end":126,"offset_unit":"unicode_code_point"},{"id":"lizang-q-fccafd1b3c0107a35e90","section":"chapter-018","block":"b-70898cfcffa39d291237","layer":"original","quote":"乃遣子就，东诣太祖，请太守","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":250,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":53,"end":66,"offset_unit":"unicode_code_point"},{"id":"lizang-q2-b53219393ed52f91a3f2","section":"chapter-018","block":"b-bc0aa4fb7b38adf3cac1","layer":"original","quote":"黄初二年，下诏褒扬，赐恭爵关内侯。拜西域戊己校尉，数岁，征还，将授以侍臣之位，而以子就代焉。恭至敦煌〖18〗，固辞疾笃〖19〗。","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":252,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":64,"offset_unit":"unicode_code_point"},{"id":"rensu-q-131d2e9d4727bb8913d2","section":"chapter-016","block":"b-ff53aeeeca30c3bafe3a","layer":"original","quote":"则遂与诸军围张掖，破之；斩进及其支党，众皆降","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":31,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":224,"end":246,"offset_unit":"unicode_code_point"},{"id":"rensu-q-672330646ed54726015e","section":"chapter-016","block":"b-f2a1f0d88b85b5a704a9","layer":"original","quote":"张掖张进执太守杜通","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":30,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":9,"end":18,"offset_unit":"unicode_code_point"},{"id":"rensu-q-708104788f9f28e00771","section":"chapter-016","block":"b-f2a1f0d88b85b5a704a9","layer":"original","quote":"后演复结旁郡为乱","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":30,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":8,"offset_unit":"unicode_code_point"},{"id":"rensu-q-87331ef88f5f111f3e7d","section":"chapter-016","block":"b-ff53aeeeca30c3bafe3a","layer":"original","quote":"演闻之，将步骑三千迎则；辞来助军〖8〗，而实欲为变。则诱与相见，因斩之；出以徇军〖9〗，其党皆散走","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":31,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":174,"end":223,"offset_unit":"unicode_code_point"},{"id":"rensu-q-8866e3b3b3c5ef093f51","section":"chapter-016","block":"b-ff53aeeeca30c3bafe3a","layer":"original","quote":"于是昭等从之，乃发兵救武威；降其三种胡","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":31,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":146,"end":165,"offset_unit":"unicode_code_point"},{"id":"rensu-q-89f8773457ad9ed676b9","section":"chapter-016","block":"b-ff53aeeeca30c3bafe3a","layer":"original","quote":"河西平，乃还金城","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":31,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":264,"end":272,"offset_unit":"unicode_code_point"},{"id":"rensu-q-8d497aa5e12452521112","section":"chapter-016","block":"b-ff53aeeeca30c3bafe3a","layer":"original","quote":"则乃见郡中大吏及昭等〖3〗，与羌豪帅谋曰：“今贼虽盛，然皆新合；或有胁从，未必同心。因衅击之〖4〗，善恶必离；离而归我，我增而彼损矣。既获益众之实，且有倍气之势〖5〗；率以进讨，破之必矣。若待大军，旷日持久；善人无归，必合于恶；善恶既合，势难猝离。虽有诏命〖6〗，违而合权，专之可也","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":31,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":141,"offset_unit":"unicode_code_point"},{"id":"rensu-q-9ebd4335c7d1500f1afd","section":"chapter-016","block":"b-ff53aeeeca30c3bafe3a","layer":"original","quote":"演军败，华惧，出所执乞降","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":31,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":247,"end":259,"offset_unit":"unicode_code_point"},{"id":"rensu-q-d8ad3784f12f64f762ae","section":"chapter-016","block":"b-f2a1f0d88b85b5a704a9","layer":"original","quote":"酒泉黄华不受太守辛机〖1〗；进、华皆自称太守，以应之","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":30,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":19,"end":45,"offset_unit":"unicode_code_point"},{"id":"rensu-q-e78f512255bb183010b0","section":"chapter-016","block":"b-f2a1f0d88b85b5a704a9","layer":"original","quote":"武威太守毌丘兴，告急于则","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":30,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":62,"end":74,"offset_unit":"unicode_code_point"},{"id":"rensu-q-f9e1009ed308649c45ca","section":"chapter-016","block":"b-ff53aeeeca30c3bafe3a","layer":"original","quote":"与兴击进于张掖","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":31,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":166,"end":173,"offset_unit":"unicode_code_point"},{"id":"wendi-e-o007d-q","section":"chapter-002","block":"b-aff500edc4a38bf656c0","layer":"original","quote":"酒泉黄华、张掖张进等各执太守以叛〖9〗。金城太守苏则讨进，斩之〖10〗。华降。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":40,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":83,"end":122,"offset_unit":"unicode_code_point"},{"id":"wendi-q-b-ec88012a7f6c352d0e04","section":"chapter-002","block":"b-ec88012a7f6c352d0e04","layer":"modern","quote":"〖1〗二年：黄初二年（公元 221）。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":210,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8fff547b113ffa36bbc1","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wendi-q-o002","section":"chapter-002","block":"b-1c3ea4f0ea338bf2ec5a","layer":"original","quote":"太祖崩，嗣位为丞相，魏王。﹝三﹞尊王后曰王太后〖5〗。改建安二十五年为延康元年。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":2,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":40,"offset_unit":"unicode_code_point"},{"id":"wendi-q-o019","section":"chapter-002","block":"b-8820e5c7f9006d364c44","layer":"original","quote":"二年春正月〖1〗，郊祀天地、明堂〖2〗。甲戌〖3〗，校猎至原陵〖4〗。遣使者，以太牢祠汉世祖〖5〗。乙亥〖6〗，朝日于东郊〖7〗。﹝一﹞初令郡国口满十万者〖8〗，岁察孝廉一人；其有秀异〖9〗，无拘户口。辛巳〖10〗，分三公户邑，封子弟各一人为列侯。壬午〖11〗，复颍川郡一年田租〖12〗。﹝二﹞改许县为许昌县。以魏郡东部为阳平郡〖13〗，西部为广平郡〖14〗。﹝三﹞","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":208,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":183,"offset_unit":"unicode_code_point"},{"id":"wgc-q0011","section":"chapter-028","block":"b-9d2fd98fa3c9420e521b","layer":"original","quote":"毌丘俭字仲恭〖1〗，河东闻喜人也。父兴，黄初中为武威太守；伐叛柔服〖2〗，开通河右，名次金城太守苏则〖3〗。讨贼张进及讨叛胡有功，封高阳乡侯。﹝一﹞入为将作大匠。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":60,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":81,"offset_unit":"unicode_code_point"},{"id":"wgc-q0186","section":"chapter-028","block":"b-9d2fd98fa3c9420e521b","layer":"original","quote":"讨贼张进及讨叛胡有功","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":60,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":54,"end":64,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
