{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"guanzhang-e-p024c","title":"赵云博望获夏侯兰请活荐为军正","accounts":[{"id":"guanzhang-e-p024c-account","label":"《云别传》","text":"赵云博望获夏侯兰请活荐为军正","evidence":["guanzhang-e-p024c-q"]}],"participants":[{"person":"xianzhu-p0034","role":"获俘荐才","evidence":["guanzhang-e-p024c-q"]},{"person":"guanzhang-p0042","role":"获释受任","evidence":["guanzhang-e-p024c-q"]}],"place":null,"time":{"label":"长坂以后及入蜀前","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["guanzhang-e-p024c-q"]},"ordering_evidence":"guanzhang-e-p024c-q","source_order":[36,198,"P024c"],"order":6932}],"persons":[{"id":"guanzhang-p0042","name":"夏侯兰","evidence":["guanzhang-q-p024"],"facts":[],"aliases":[],"mentions":[{"id":"guanzhang-m-p024-guanzhang-p0042","kind":"mention","text":"文中提及","evidence":["guanzhang-q-p024"]}]}],"evidence":[{"id":"guanzhang-e-p024c-q","section":"chapter-036","block":"b-41949c93fbffbb7cc1da","layer":"pei","quote":"先是，与夏侯惇战于博望，生获夏侯兰。兰是云乡里人，少小相知；云白先主，活之，荐兰明于法律，以为军正，云不用自近。其慎虑类如此。","attribution":"《云别传》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":197,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-26a4b4aa30fcb9c70f24","start":157,"end":220,"offset_unit":"unicode_code_point"},{"id":"guanzhang-q-p024","section":"chapter-036","block":"b-41949c93fbffbb7cc1da","layer":"pei","quote":"﹝二﹞《云别传》曰：“初，先主之败，有人言‘云已北去’者，先主以手戟擿之曰：‘子龙不弃我走也！’顷之，云至。从平江南，以为偏将军，领桂阳太守，代赵范。范寡嫂曰樊氏，有国色，范欲以配云。云辞曰：‘相与同姓，卿兄犹我兄！’固辞不许。时有人劝云纳之，云曰：‘范迫降耳，心未可测；天下女不少！’遂不取。范果逃走，云无纤介。先是，与夏侯惇战于博望，生获夏侯兰。兰是云乡里人，少小相知；云白先主，活之，荐兰明于法律，以为军正，云不用自近。其慎虑类如此。先主入益州，云领留营司马。此时先主孙夫人，以权妹骄豪，多将吴吏兵，纵横不法。先主以云严重，必能整齐，特任掌内事。权闻备西征，大遣舟船，迎妹；而夫人内欲将后主还吴，云与张飞勒兵截江，乃得后主还。”","attribution":"《云别传》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":197,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-26a4b4aa30fcb9c70f24","start":0,"end":317,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
