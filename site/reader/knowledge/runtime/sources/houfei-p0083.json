{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[],"persons":[{"id":"houfei-p0083","name":"甄黄","evidence":["houfei-q-o031"],"facts":[],"aliases":[],"mentions":[{"id":"houfei-m-o031-houfei-p0083","kind":"mention","text":"文中提及","evidence":["houfei-q-o031"]}]}],"evidence":[{"id":"houfei-q-o031","section":"chapter-005","block":"b-6812c920b6ae5772de59","layer":"original","quote":"太和六年，明帝爱女淑薨，追封谥淑为平原懿公主，为之立庙。取后亡从孙黄与合葬〖22〗，追封黄列侯。以夫人郭氏从弟德，为之后〖23〗，承甄氏姓；封德为平原侯，袭公主爵。﹝一﹞","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":124,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":85,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
