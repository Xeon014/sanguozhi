18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":12,"end":29,"offset_unit":"unicode_code_point"},{"id":"erfei-q-8abf5f5275b3c65ded5a","section":"chapter-034","block":"b-c3b960c67d5476e63405","layer":"original","quote":"后卒，葬于南郡","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":1,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":97,"end":104,"offset_unit":"unicode_code_point"},{"id":"erfei-q-b648380c28cca92c3e44","section":"chapter-034","block":"b-ca4931503d944da1291b","layer":"original","quote":"章武二年，追谥“皇思夫人”","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":2,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":13,"offset_unit":"unicode_code_point"},{"id":"erfei-q-d4f3267ea1755b493f9d","section":"chapter-034","block":"b-c3b960c67d5476e63405","layer":"original","quote":"值曹公军至，追及先主于当阳长坂","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":1,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":59,"end":74,"offset_unit":"unicode_code_point"},{"id":"erfei-q-d6cc1573ed85a0ec4bdb","section":"chapter-034","block":"b-ca4931503d944da1291b","layer":"original","quote":"迁葬于蜀","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":2,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":14,"end":18,"offset_unit":"unicode_code_point"},{"id":"erfei-q-f1b727addb181ebcce33","section":"chapter-034","block":"b-c3b960c67d5476e63405","layer":"original","quote":"随先主于荆州，产后主","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":1,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":48,"end":58,"offset_unit":"unicode_code_point"},{"id":"erfei-q2-55769d2535342a38a787","section":"chapter-034","block":"b-c3b960c67d5476e63405","layer":"original","quote":"先主昭烈甘皇后，沛人也。先主临豫州〖1〗，住小沛，纳以为妾。先主数丧嫡室〖2〗，常摄内事〖3〗。随先主于荆州，产后主。值曹公军至，追及先主于当阳长坂；于时困逼，弃后及后主：赖赵云保护，得免于难。后卒，葬于南郡。","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":1,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":105,"offset_unit":"unicode_code_point"},{"id":"erfei-q2-6df689be16a871a26237","section":"chapter-034","block":"b-ca4931503d944da1291b","layer":"original","quote":"章武二年，追谥“皇思夫人”，迁葬于蜀；未至，而先主殂陨。丞相亮上言：“皇思夫人履行修仁〖4〗，淑慎其身。大行皇帝昔在上将〖5〗，嫔妃作合〖6〗；载育圣躬〖7〗，大命不融〖8〗。大行皇帝存时，笃义垂恩〖9〗；念皇思夫人神柩在远飘摇〖10〗，特遣使者奉迎；会大行皇帝崩。今皇思夫人神柩已到；又梓宫在道〖11〗，园陵将成〖12〗，安厝有期〖13〗。臣辄与太常臣赖恭等议：《礼记》曰：‘立爱自亲始〖14〗，教民孝也；立敬自长始，教民顺也。’不忘其亲，所由生也〖15〗。《春秋》之义，母以子贵〖16〗。昔高皇帝追尊太上昭灵夫人为昭灵皇后〖17〗；孝和皇帝改葬其母梁贵人〖18〗，尊号曰恭怀皇后；孝愍皇帝亦改葬其母王夫人〖19〗，尊号曰灵怀皇后。今皇思夫人宜有尊号，以慰寒泉之思〖20〗。辄与恭等案《谥法》〖21〗，宜曰昭烈皇后。《诗》曰：‘穀则异室〖22〗，死则同穴。’﹝一﹞故昭烈皇后宜与大行皇帝合葬。臣请太尉告宗庙，布露天下〖23〗；具礼仪别奏〖24〗。”","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":2,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":425,"offset_unit":"unicode_code_point"},{"id":"guanzhang-e-o041b-q","section":"chapter-036","block":"b-0115adad8a91126b45f3","layer":"original","quote":"及先主为曹公所追于当阳长坂，弃妻子南走。云身抱弱子，即后主也；保护甘夫人，即后主母也：皆得免难。迁为牙门将军〖4〗。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":185,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":53,"end":111,"offset_unit":"unicode_code_point"},{"id":"lizang-q-191e369b2d3f4e75595b","section":"chapter-018","block":"b-e9d18d4f862d319c0c25","layer":"original","quote":"授聘兵，使与曹纯追讨刘备于长坂","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":88,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":135,"end":150,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-888495d8be7766faf20c","section":"chapter-001","block":"b-888495d8be7766faf20c","layer":"modern","quote":"〖1〗十三年：建安十三年（公元 208）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":666,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0bae348fdb687025113d","start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o119","section":"chapter-001","block":"b-4bcffcc4ee709a4e5ea3","layer":"original","quote":"十三年春正月〖1〗，公还邺。作玄武池以肄舟师〖2〗。﹝一﹞汉罢三公官，置丞相、御史大夫〖3〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":661,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":47,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o027a-q","section":"chapter-032","block":"b-50bee17966dbf776f03c","layer":"original","quote":"曹公以江陵有军实〖4〗，恐先主据之；乃释辎重，轻军到襄阳。闻先主已过，曹公将精骑五千急追之；一日一夜行三百余里，及于当阳之长坂〖5〗。先主弃妻子，与诸葛亮、张飞、赵云等数十骑走〖6〗。曹公大获其人众辎重。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":111,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":102,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o024","section":"chapter-032","block":"b-c857386227851cc86ab3","layer":"original","quote":"（曹公南征表）〔及曹公南征〕，会表卒，﹝二﹞子琮代立〖2〗，遣使请降。先主屯樊，不知曹公猝至；至宛乃闻之，遂将其众去。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":108,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":59,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
