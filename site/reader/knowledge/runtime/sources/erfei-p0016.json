{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-o027a","title":"曹操追及长坂与刘备败走","accounts":[{"id":"xianzhu-e-o027a-account","label":"《先主传》正文","text":"曹操以精骑急追至长坂，刘备与诸葛亮、张飞、赵云等数十骑逃走，其妻子及众多辎重失陷。","evidence":["xianzhu-e-o027a-q"]},{"id":"erfei-a-27ea25de61e32103fb12","label":"正文","text":"曹军追及刘备于当阳长坂","evidence":["erfei-q-d4f3267ea1755b493f9d"]},{"id":"erfei-a-4a9ea730f2840523faa4","label":"正文","text":"刘备弃甘氏与刘禅","evidence":["erfei-q-09b8863c4a284ce3516a"]},{"id":"lizang-a-c33f522b15c6d64a3095","label":"正文","text":"太祖授文聘兵，使与曹纯追讨刘备于长坂","evidence":["lizang-q-191e369b2d3f4e75595b"]}],"participants":[{"person":"cao-cao","role":"急追","evidence":["xianzhu-e-o027a-q"]},{"person":"liu-bei","role":"败走","evidence":["xianzhu-e-o027a-q"]},{"person":"zhuge-liang","role":"随行","evidence":["xianzhu-e-o027a-q"]},{"person":"wudi-p0367","role":"随行","evidence":["xianzhu-e-o027a-q"]},{"person":"xianzhu-p0034","role":"随行","evidence":["xianzhu-e-o027a-q"]},{"person":"erfei-p0016","role":"被刘备丢弃于乱军之中","evidence":["erfei-q-09b8863c4a284ce3516a"]},{"person":"xianzhu-p0112","role":"被刘备丢弃于乱军之中","evidence":["erfei-q-09b8863c4a284ce3516a"]},{"person":"wudi-p0250","role":"与纯追讨备","evidence":["lizang-q-191e369b2d3f4e75595b"]},{"person":"xiahoucao-p0045","role":"同追讨","evidence":["lizang-q-191e369b2d3f4e75595b"]}],"place":{"text":"当阳长坂","evidence":["xianzhu-e-o027a-q"]},"time":{"year":208,"label":"南避曹军时","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xianzhu-y208","dating_review":{"reviewed":true,"anchor":"xianzhu-q-o024","basis":"南避曹军时"},"evidence":["xianzhu-e-o027a-q","xianzhu-q-o024","wudi-q-o119","wudi-q-b-888495d8be7766faf20c"]},"source_order":[32,112,"O027a"],"order":3654},{"id":"erfei-e-o001","title":"刘备纳甘氏为妾","accounts":[{"id":"erfei-a-eb21eafed96ad4d1b954","label":"正文","text":"刘备纳甘氏为妾","evidence":["erfei-q-6651851eb5e3733711a6"]}],"participants":[{"person":"liu-bei","role":"任豫州牧驻小沛期间纳甘氏为妾","evidence":["e