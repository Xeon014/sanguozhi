474b6c257"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["santizhu-q-799b648f266474b6c257"]},"ordering_evidence":"santizhu-q-799b648f266474b6c257","source_order":[48,114,0],"order":8875}],"persons":[{"id":"wgc-p0026","name":"胡奋","evidence":["wgc-q0032","wgc-q0135","santizhu-q-799b648f266474b6c257","huanchen-q-0b370e9eafa4316e420e"],"aliases":[],"facts":[],"mentions":[{"id":"wgc-m-o040-wgc-p0026","kind":"mention","text":"本段涉及胡奋","evidence":["wgc-q0032"]},{"id":"wgc-m-p059-wgc-p0026","kind":"mention","text":"本段涉及胡奋","evidence":["wgc-q0135"]}]}],"evidence":[{"id":"huanchen-q-0b370e9eafa4316e420e","section":"chapter-022","block":"b-48f01f6f024563e9a474","layer":"original","quote":"泰军上邽〖15〗，分兵守要，晨夜进前。邓艾、胡奋、王秘亦到〖16〗；即与艾、秘等分为三军，进到陇西","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":238,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":49,"offset_unit":"unicode_code_point"},{"id":"huanchen-q-68a23cc7738425b8be69","section":"chapter-022","block":"b-aa2d7882210810b7e6e8","layer":"modern","quote":"〖9〗郭淮（？—公元 255）：传见本书卷二十六。雍州：州名。治所在今陕西西安市西北。","attribution":"现代注释","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":223,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cee263fdd4853e6a7145","start":0,"end":43,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-799b648f266474b6c257","section":"chapter-048","block":"b-bd2df9b2ac026100f1ff","layer":"original","quote":"冬，晋命镇东大将军司马伷向涂中〖23〗；安东将军王浑、扬州刺史周浚向牛渚〖24〗；建威将军王戎向武昌〖25〗；平南将军胡奋向夏口〖26〗；镇南〔大〕将军杜预向江陵〖27〗；龙骧将军王濬、广武将军唐彬浮江东下〖28〗；太尉贾充为大都督〖29〗，量宜处要，尽军势之中〖30〗","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":477,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":135,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-a805fae656d71ba8f345","section":"chapter-048","block":"b-dc57a9e53d35b30f8168","layer":"original","quote":"三月，司马文王克寿春；诞及左右战死，将吏以下皆降。","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":119,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":16,"end":41,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-4ee6b68e68a3fac3ca3f","section":"chapter-064","block":"b-390d7a804c8a1bdac217","layer":"original","quote":"魏大将军诸葛诞举寿春叛，保城请降。吴遣文钦、唐咨、全端、全怿等帅三万人救之。魏镇南将军王基，围诞〖1〗，钦等突围入城","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":439,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":58,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-bc79e2ff7fe0cc5495b3","section":"chapter-064","block":"b-f1f75337999ea6de2e8a","layer":"original","quote":"綝于是大发卒，出屯镬里〖4〗；复遣异率将军丁奉、黎斐等五万人，攻魏，留辎重于都陆","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":440,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":40,"offset_unit":"unicode_code_point"},{"id":"shaodi-e-o129a-q","section":"chapter-004","block":"b-b1abcd215d0c852fc17c","layer":"original","quote":"三年春二月〖1〗，大将军司马文王陷寿春城，斩诸葛诞。三月，诏曰：“古者克敌，收其尸以为京观〖2〗，所以惩昏逆而彰武功也。汉孝武元鼎中〖3〗，改桐乡为闻喜〖4〗，新乡为获嘉〖5〗，以著南越之亡〖6〗。大将军亲总六戎〖7〗，营据丘头〖8〗；内夷群凶〖9〗，外殄寇虏〖10〗；功济兆民，声振四海。克敌之地，宜有令名〖11〗：其改‘丘头’为‘武丘’。明以武平乱，后世不忘；亦京观、二邑之义也〖12〗”。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":575,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":197,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-b-ee7d999da8e03b038d07","section":"chapter-004","block":"b-ee7d999da8e03b038d07","layer":"modern","quote":"〖1〗三年：甘露三年（公元 258）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":582,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-663d9ce877d00f2d0cbc","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o129","section":"chapter-004","block":"b-b1abcd215d0c852fc17c","layer":"original","quote":"三年春二月〖1〗，大将军司马文王陷寿春城，斩诸葛诞。三月，诏曰：“古者克敌，收其尸以为京观〖2〗，所以惩昏逆而彰武功也。汉孝武元鼎中〖3〗，改桐乡为闻喜〖4〗，新乡为获嘉〖5〗，以著南越之亡〖6〗。大将军亲总六戎〖7〗，营据丘头〖8〗；内夷群凶〖9〗，外殄寇虏〖10〗；功济兆民，声振四海。克敌之地，宜有令名〖11〗：其改‘丘头’为‘武丘’。明以武平乱，后世不忘；亦京观、二邑之义也〖12〗”。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":575,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":197,"offset_unit":"unicode_code_point"},{"id":"wgc-q0032","section":"chapter-028","block":"b-7511a5080accea460f90","layer":"original","quote":"大将军乃自临围，四面进兵，同时鼓噪登城。城内无敢动者。诞窘急，单乘马，将其麾下突小城门出。大将军司马胡奋部兵逆击〖11〗，斩诞；传首，夷三族。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":198,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":71,"offset_unit":"unicode_code_point"},{"id":"wgc-q0135","section":"chapter-028","block":"b-a344b1173e6856a98116","layer":"pei","quote":"﹝四﹞《晋诸公赞》曰：“胡烈儿名渊，字世元。遵之孙也。遵，安定人，以才兼文武，累居藩镇，至车骑将军。子奋，字玄威。亦历方任。女为晋武帝贵人，有宠。太康中，以奋为尚书仆射，加镇军大将军，开府。弟广，字宣祖，少府；次烈，字玄武，秦州刺史；次岐，字玄嶷，并州刺史。广子喜，凉州刺史。渊小字鹞鸱。时年十八，既杀会救父，名震远近。后赵王伦篡位，三王兴义，伦使渊与张泓，将兵御齐王，屡破齐军。会成都战克，渊乃归降，伏法。”","attribution":"晋诸公赞","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":593,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-7dfa0827333ec78b2b0e","start":0,"end":205,"offset_unit":"unicode_code_point"},{"id":"wgc-q0298","section":"chapter-028","block":"b-7511a5080accea460f90","layer":"original","quote":"大将军乃自临围，四面进兵，同时鼓噪登城","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":198,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wgc-q0299","section":"chapter-028","block":"b-7511a5080accea460f90","layer":"original","quote":"诞窘急，单乘马，将其麾下突小城门出。大将军司马胡奋部兵逆击〖11〗，斩诞；传首，夷三族","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":198,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":27,"end":70,"offset_unit":"unicode_code_point"},{"id":"wgc-q0303","section":"chapter-028","block":"b-3e13a9b79fa20e998b01","layer":"original","quote":"初围寿春，议者多欲急攻之。大将军以为：“城固而众多，攻之必力屈；若有外寇，表里受敌，此危道也。今三叛相聚于孤城之中〖2〗，天其或者将使同就戮；吾当以全策縻之〖3〗，可坐而制也。”诞以二年五月反，三年二月破灭。六军按甲〖4〗，深沟高垒；而诞自困，竟不烦攻而克。﹝二﹞","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":215,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":132,"offset_unit":"unicode_code_point"},{"id":"wgc-q0304","section":"chapter-028","block":"b-3e13a9b79fa20e998b01","layer":"original","quote":"诞以二年五月反，三年二月破灭。六军按甲〖4〗，深沟高垒；而诞自困，竟不烦攻而克","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":215,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":89,"end":128,"offset_unit":"unicode_code_point"},{"id":"wgc-q0700","section":"chapter-028","block":"b-a344b1173e6856a98116","layer":"pei","quote":"太康中，以奋为尚书仆射，加镇军大将军，开府。","attribution":"晋诸公赞","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":593,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-7dfa0827333ec78b2b0e","start":73,"end":95,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
