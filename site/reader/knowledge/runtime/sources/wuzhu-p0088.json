6dd10","santizhu-q-0933724e6f5a43004cac","santizhu064-q-d291c494e8c9a9a2091f","santizhu064-q-7216ea41b317f50b4a1f","santizhu064-q-4ee6b68e68a3fac3ca3f","hequan-q-01ecda5546cbfbdb55d1","hequan-q-325916b7669c826b4048","hequan-q-e3d8ee9f560c65f499ea","chenghuang-q-43b7eb41151cc3920037","chenghuang-q-0cf97fa905c953017d83","zhulv-q-a10a3c3eee3aa2496b9c"],"facts":[],"aliases":[],"mentions":[{"id":"wuzhu-m-o113-wuzhu-p0088","kind":"mention","text":"文中提及","evidence":["wuzhu-q-o113"]},{"id":"wuzhu-m-o128-wuzhu-p0088","kind":"mention","text":"文中提及","evidence":["wuzhu-q-o128"]},{"id":"wgc-m-o034-wuzhu-p0088","kind":"mention","text":"本段涉及唐咨","evidence":["wgc-q0027"]},{"id":"wgc-m-o037-wuzhu-p0088","kind":"mention","text":"本段涉及唐咨","evidence":["wgc-q0030"]},{"id":"wgc-m-o090-wuzhu-p0088","kind":"mention","text":"本段涉及唐咨","evidence":["wgc-q0069"]},{"id":"wgc-m-o098-wuzhu-p0088","kind":"mention","text":"本段涉及唐咨","evidence":["wgc-q0075"]},{"id":"wgc-m-p033-wuzhu-p0088","kind":"mention","text":"本段涉及唐咨","evidence":["wgc-q0114"]},{"id":"wgc-m-o041-wuzhu-p0088","kind":"mention","text":"本段涉及唐咨","evidence":["wgc-q0033"]},{"id":"wgc-m-o044-wuzhu-p0088","kind":"mention","text":"本段涉及唐咨","evidence":["wgc-q0034"]}]}],"evidence":[{"id":"chenghuang-q-0cf97fa905c953017d83","section":"chapter-055","block":"b-8df1d46a00b273a6bbbc","layer":"original","quote":"太平二年，〔魏大将军诸葛诞据寿春来降，〕魏人围之。遣朱异、唐咨等往救，复使奉与黎斐解围。奉为先登，屯于黎浆〖10〗；力战有功，拜左将军","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":358,"anchor":null},"note_id":null,"start":0,"end":67},{"id":"chenghuang-q-1da7562bc4ca7ae07bed","section":"chapter-055","block":"b-f6550e25d92fd67b6b52","layer":"original","quote":"天寒，雪，敌诸将置酒高会。奉见其前部兵少，相谓曰：“取封侯爵赏，正在今日！”乃使兵解铠著胄，持短兵〖7〗。敌人从而笑焉，不为设备。奉纵兵斫之，大破敌前屯；会据等至，魏军遂溃。迁灭寇将军〖8〗，进封都（亭）〔乡〕侯","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":356,"anchor":null},"note_id":null,"start":0,"end":106},{"id":"chenghuang-q-43b7eb41151cc3920037","section":"chapter-055","block":"b-876b9e224f245867d86d","layer":"original","quote":"及恪上岸，奉与将军唐咨、吕据、留赞等，俱从山西上。奉曰：“今诸军行迟；若敌据便地〖4〗，则难与争锋矣！”乃辟诸军，使下道〖5〗；帅麾下三千人，径进。时北风，奉举帆二日至，遂据徐塘","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":355,"anchor":null},"note_id":null,"start":112,"end":201},{"id":"chenghuang-q-6a6c8553c5614eb1ca01","section":"chapter-055","block":"b-87fe2456927ad072130b","layer":"original","quote":"东兴之役〖15〗，综为前锋，军败身死。诸葛恪斩送其首，以白权庙","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":59,"anchor":null},"note_id":null,"start":26,"end":57},{"id":"hequan-q-01ecda5546cbfbdb55d1","section":"chapter-060","block":"b-b9ceb362e6ecd228dd14","layer":"original","quote":"权复诏岱督刘纂、唐咨等，分部讨击","section_title":"贺全吕周钟离传第十五","source":{"file":"OEBPS/Text/titlepage_0127.xhtml","index":189,"anchor":null},"note_id":null,"start":36,"end":52},{"id":"hequan-q-325916b7669c826b4048","section":"chapter-060","block":"b-a57701aef4456007aa9d","layer":"original","quote":"权遣使追拜岱交州牧，及遣诸将唐咨等，骆驿相继","section_title":"贺全吕周钟离传第十五","source":{"file":"OEBPS/Text/titlepage_0127.xhtml","index":216,"anchor":null},"note_id":null,"start":43,"end":65},{"id":"hequan-q-ae4ded7244b535b59ef0","section":"chapter-060","block":"b-6c5f593279f7e62e0019","layer":"pei","quote":"东关之役，绪与丁奉，建议引兵先出；以破魏军，封一子亭侯","attribution":"裴注·《吴书》","section_title":"贺全吕周钟离传第十五","source":{"file":"OEBPS/Text/titlepage_0127.xhtml","index":159,"anchor":null},"note_id":"n-745969b04e6140fa105c","start":49,"end":76},{"id":"hequan-q-e3d8ee9f560c65f499ea","section":"chapter-060","block":"b-95778efaeb0bf3c60266","layer":"original","quote":"吾粲、唐咨尝以三千兵攻守〖2〗，连月不能拔","section_title":"贺全吕周钟离传第十五","source":{"file":"OEBPS/Text/titlepage_0127.xhtml","index":372,"anchor":null},"note_id":null,"start":25,"end":46},{"id":"houfei-q-b-64a27e8dc3dd5339d73a","section":"chapter-005","block":"b-64a27e8dc3dd5339d73a","layer":"modern","quote":"〖16〗四年：青龙四年（公元 236）。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":114,"anchor":null},"note_id":"n-bd98b8bd7ce8c71de9ac","start":0,"end":20},{"id":"houfei-q-o025","section":"chapter-005","block":"b-0744a279ae4c62a54e64","layer":"original","quote":"青龙二年春，追谥后兄俨曰安城乡穆侯。夏，吴贼寇扬州，以像为伏波将军〖12〗，持节，监诸将东征〖13〗。还，复为射声校尉〖14〗。三年薨〖15〗，追赠卫将军，改封魏昌县，谥曰贞侯。子畅嗣。又封畅弟温、4 、艳，皆为列侯。四年〖16〗，改逸、俨本封，皆曰魏昌侯，谥因故〖17〗。封俨世妇刘为东乡君〖18〗，又追封逸世妇张为安喜君。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":97,"anchor":null},"note_id":null,"start":0,"end":163},{"id":"houfei-q-o050","section":"chapter-005","block":"b-6dc749ac781a81d5a82f","layer":"original","quote":"帝疾困，遂立为皇后。齐王即位，尊后为皇太后，称“永宁宫”。追封谥太后父满，为西都定侯，以立子建绍其爵。封太后母杜，为郃阳君。芝迁散骑常侍、长水校尉；﹝一﹞立，宣德将军〖2〗；皆封列侯。建兄德，出养甄氏。德及建，俱为镇护将军〖3〗，皆封列侯，并掌宿卫。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":236,"anchor":null},"note_id":null,"start":0,"end":125},{"id":"mingdi-q-b-e59395a0e3cfa7e31144","section":"chapter-003","block":"b-e59395a0e3cfa7e31144","layer":"modern","quote":"〖4〗三年：景初三年（公元 239）。丁亥：旧历初一日。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":496,"anchor":null},"note_id":"n-271e1436daf6e49feb83","start":0,"end":28},{"id":"mingdi-q-o068","section":"chapter-003","block":"b-15faf626ce48eb2f68b4","layer":"original","quote":"三年春正月，丁亥〖4〗，太尉宣王还至河内；帝驿马召到〖5〗，引入卧内，执其手谓曰：“吾疾甚！以后事属君。君其与爽辅少子〖6〗。吾得见君，无所恨！”宣王顿首流涕〖7〗。﹝一﹞即日，帝崩于嘉福殿。﹝二﹞时年三十六〖8〗。﹝三﹞癸丑〖9〗，葬高平陵〖10〗。﹝四﹞","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":491,"anchor":null},"note_id":null,"start":0,"end":129},{"id":"panlu-q-0b8229086ad163dff583","section":"chapter-061","block":"b-24dc59549a2a19d246f9","layer":"original","quote":"与诸将共赴寿春。还，累迁荡魏、绥远将军","section_title":"潘濬陆凯传第十六","source":{"file":"OEBPS/Text/titlepage_0129.xhtml","index":44,"anchor":null},"note_id":null,"start":48,"end":67},{"id":"santizhu-q-031eb9e989f1b32de8d0","section":"chapter-048","block":"b-827c97fc82e30ff0481c","layer":"original","quote":"据、钦、咨等，表荐卫将军滕胤为丞相；綝不听","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":74,"anchor":null},"note_id":null,"start":86,"end":107},{"id":"santizhu-q-0933724e6f5a43004cac","section":"chapter-048","block":"b-c67c55e25345c5fcaa53","layer":"original","quote":"六月，使文钦、唐咨、全端等，步骑三万救诞","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":94,"anchor":null},"note_id":null,"start":151,"end":171},{"id":"santizhu-q-84444601eaa62c647710","section":"chapter-048","block":"b-92e9eb0cafdc7f212442","layer":"original","quote":"八月，先遣钦及骠骑吕据、车骑刘纂、镇南朱异、前将军唐咨军，自江都入淮、泗","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":73,"anchor":null},"note_id":null,"start":0,"end":36},{"id":"santizhu-q-8812753a9ed1bf501f17","section":"chapter-048","block":"b-9b3f5181b40c2019f20c","layer":"original","quote":"甲寅〖11〗，恪以大兵赴敌。戊午〖12〗，兵及东兴，交战；大破魏军，杀将军韩综、桓嘉等","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":14,"anchor":null},"note_id":null,"start":102,"end":145},{"id":"santizhu-q-a805fae656d71ba8f345","section":"chapter-048","block":"b-dc57a9e53d35b30f8168","layer":"original","quote":"三月，司马文王克寿春；诞及左右战死，将吏以下皆降。","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":119,"anchor":null},"note_id":null,"start":16,"end":41},{"id":"santizhu-q-c603ff0f3115a916dd10","section":"chapter-048","block":"b-827c97fc82e30ff0481c","layer":"original","quote":"綝遣使以诏书告喻钦、咨等，使取据","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":74,"anchor":null},"note_id":null,"start":138,"end":154},{"id":"santizhu064-q-4ee6b68e68a3fac3ca3f","section":"chapter-064","block":"b-390d7a804c8a1bdac217","layer":"original","quote":"魏大将军诸葛诞举寿春叛，保城请降。吴遣文钦、唐咨、全端、全怿等帅三万人救之。魏镇南将军王基，围诞〖1〗，钦等突围入城","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":439,"anchor":null},"note_id":null,"start":0,"end":58},{"id":"santizhu064-q-7216ea41b317f50b4a1f","section":"chapter-064","block":"b-9e8341426d9ac906dc50","layer":"original","quote":"其明年，文钦说峻征魏。峻使钦与吕据、车骑刘纂、镇南朱异、前将军唐咨，自江都入淮、泗〖13〗，以图青、徐。峻与胤至石头〖14〗，因饯之","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":393,"anchor":null},"note_id":null,"start":0,"end":66},{"id":"santizhu064-q-bc79e2ff7fe0cc5495b3","section":"chapter-064","block":"b-f1f75337999ea6de2e8a","layer":"original","quote":"綝于是大发卒，出屯镬里〖4〗；复遣异率将军丁奉、黎斐等五万人，攻魏，留辎重于都陆","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":440,"anchor":null},"note_id":null,"start":0,"end":40},{"id":"santizhu064-q-c0aaa14c0306cbe5684d","section":"chapter-064","block":"b-d3196146b5b40af27868","layer":"original","quote":"恪兴军四万，晨夜赴救。遵等敕其诸军：作浮桥渡，阵于堤上〖6〗，分兵攻两城。城在高峻，不可猝拔。恪遣将军留赞、吕据、唐咨、丁奉为前部。时天寒，雪，魏诸将会饮。见赞等兵少，而解置铠甲，不持矛戟；但兜鍪刀盾〖7〗，裸身缘遏〖8〗：大笑之，不即严兵〖9〗。兵得上，便鼓噪乱斫〖10〗。魏军惊扰散走，争渡浮桥；桥坏绝，自投于水，更相蹈藉。乐安太守桓嘉等，同时并没〖11〗，死者数万。故叛将韩综为魏前军督〖12〗，亦斩之。获车乘牛、马、驴、骡各数千，资器山积，振旅而归〖13〗。","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":164,"anchor":null},"note_id":null,"start":0,"end":233},{"id":"santizhu064-q-d291c494e8c9a9a2091f","section":"chapter-064","block":"b-da2900eb25692ecb6e49","layer":"original","quote":"据引兵还，使人报胤，欲共废綝。綝闻之，遣从兄（虑）〔宪〕，将兵逆据于江都〖3〗；使中使敕文钦、刘纂、唐咨等，合众击据；遣侍中、左将军华融、中书丞丁晏，告胤取据，并喻胤宜速去意〖4〗。胤自以祸及，因留融、晏，勒兵自卫","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":416,"anchor":null},"note_id":null,"start":47,"end":154},{"id":"shaodi-e-o129a-q","section":"chapter-004","block":"b-b1abcd215d0c852fc17c","layer":"original","quote":"三年春二月〖1〗，大将军司马文王陷寿春城，斩诸葛诞。三月，诏曰：“古者克敌，收其尸以为京观〖2〗，所以惩昏逆而彰武功也。汉孝武元鼎中〖3〗，改桐乡为闻喜〖4〗，新乡为获嘉〖5〗，以著南越之亡〖6〗。大将军亲总六戎〖7〗，营据丘头〖8〗；内夷群凶〖9〗，外殄寇虏〖10〗；功济兆民，声振四海。克敌之地，宜有令名〖11〗：其改‘丘头’为‘武丘’。明以武平乱，后世不忘；亦京观、二邑之义也〖12〗”。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":575,"anchor":null},"note_id":null,"start":0,"end":197},{"id":"shaodi-q-o002","section":"chapter-004","block":"b-69d95c2d10b2c4a40b0c","layer":"original","quote":"青龙三年，立为齐王。景初三年正月，丁亥朔，帝病甚，乃立为皇太子。是日，即皇帝位。大赦。尊皇后曰皇太后〖2〗。大将军曹爽、太尉司马宣王辅政。诏曰：“朕以眇身〖3〗，继承鸿业。茕茕在疚〖4〗，靡所控告〖5〗。大将军、太尉奉受末命〖6〗，夹辅朕躬；司徒、司空，冢宰元辅总率百僚〖7〗，以宁社稷；其与群卿大夫勉勖乃心〖8〗，称朕意焉。”诸所兴作宫室之役，皆以遗诏罢之；官奴婢六十以上，免为良人〖9〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":2,"anchor":null},"note_id":null,"start":0,"end":196},{"id":"wgc-q0027","section":"chapter-028","block":"b-3e0f9aeb5d0f62e60b75","layer":"original","quote":"吴人大喜，遭将全怿、全端、唐咨、王祚等，率三万众，密与文钦俱来应诞。以诞为左都护，假节，大司徒〖8〗，骠骑将军，青州牧，寿春侯。是时镇南将军王基始至，督诸军围寿春，末合。咨、钦等从城东北，因山乘险，得将其众突入城。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":174,"anchor":null},"note_id":null,"start":0,"end":107},{"id":"wgc-q0030","section":"chapter-028","block":"b-629abdab0ff82c8393d0","layer":"original","quote":"三年正月〖5〗，诞、钦、咨等大为攻具，昼夜五六日攻南围，欲决围而出〖6〗。﹝二﹞围上诸军，临高以发石车、火箭逆烧破其攻具〖7〗，弩矢及石雨下。死伤者蔽地，血流盈堑。复还入城，城内食转竭，降出者数万口。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":195,"anchor":null},"note_id":null,"start":0,"end":100},{"id":"wgc-q0033","section":"chapter-028","block":"b-306b4aff277153d62295","layer":"original","quote":"诞麾下数百人，坐不降见斩；皆曰：“为诸葛公死，不恨！”其得人心如此。﹝一﹞唐咨、王祚及诸裨将，皆面缚降；吴兵万众，器仗军实山积〖1〗。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":214,"anchor":null},"note_id":null,"start":0,"end":67},{"id":"wgc-q0034","section":"chapter-028","block":"b-1557e93d1c7c76ec6209","layer":"original","quote":"唐咨本利城人〖9〗。黄初中，利城郡反，杀太守徐箕，推咨为主。文帝遣诸军讨破之，咨走入海；遂亡至吴；官至左将军，封侯，持节。诞、钦屠戮，咨亦生擒；三叛皆获，天下快焉。﹝三﹞拜咨安远将军〖10〗，其余裨将咸假号位〖11〗。吴众悦服，江东感之，皆不诛其家。其淮南将吏士民诸为诞所胁略者，惟诛其首逆，余皆赦之。听鸯、虎收敛钦丧，给其车牛，致葬旧墓。﹝四﹞","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":217,"anchor":null},"note_id":null,"start":0,"end":173},{"id":"wgc-q0069","section":"chapter-028","block":"b-3813a3aab7f10a285eae","layer":"original","quote":"景元三年冬，以会为镇西将军，假节，都督关中诸军事。文王敕青，徐、兖、豫、荆、扬诸州，并使作船；又令唐咨作浮海大船，外为将伐吴者。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":470,"anchor":null},"note_id":null,"start":0,"end":64},{"id":"wgc-q0075","section":"chapter-028","block":"b-7c536b5df4fd050637db","layer":"original","quote":"今国朝隆天覆之恩，宰辅弘宽恕之德；先惠后诛，好生恶杀。往者吴将孙壹举众内附〖41〗，位为上司〖42〗，宠秩殊异。文钦、唐咨为国大害，叛主雠贼〖43〗，还为戎首〖44〗。咨困逼擒获，钦二子还降，皆将军、封侯；咨与闻国事。壹等穷蹙归命〖45〗，犹加盛宠，况巴蜀贤智见机而作者哉？诚能深鉴成败，邈然高蹈〖46〗；投迹微子之踪，措身陈平之轨；则福同古人，庆流来裔〖47〗；百姓士民，安堵（旧）〔乐〕业；农不易亩，市不回肆〖48〗；去累卵之危，就永安之福。岂不美与！","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":478,"anchor":null},"note_id":null,"start":0,"end":228},{"id":"wgc-q0114","section":"chapter-028","block":"b-fa99abaef1f673ce3780","layer":"pei","quote":"﹝二﹞《汉晋春秋》曰：“文钦曰：‘蒋班、焦彝，谓我不能出而走；全端、全怿，又率众逆降：此敌无备之时也，可以战矣！’诞及唐咨等皆以为然，遂共悉众出攻。”","attribution":"汉晋春秋","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":213,"anchor":null},"note_id":"n-73682a57dcb31fcf32f5","start":0,"end":75},{"id":"wgc-q0275","section":"chapter-028","block":"b-3e0f9aeb5d0f62e60b75","layer":"original","quote":"吴人大喜，遭将全怿、全端、唐咨、王祚等，率三万众，密与文钦俱来应诞","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":174,"anchor":null},"note_id":null,"start":0,"end":33},{"id":"wgc-q0278","section":"chapter-028","block":"b-3e0f9aeb5d0f62e60b75","layer":"original","quote":"咨、钦等从城东北，因山乘险，得将其众突入城","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":174,"anchor":null},"note_id":null,"start":85,"end":106},{"id":"wgc-q0288","section":"chapter-028","block":"b-629abdab0ff82c8393d0","layer":"original","quote":"三年正月〖5〗，诞、钦、咨等大为攻具，昼夜五六日攻南围，欲决围而出","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":195,"anchor":null},"note_id":null,"start":0,"end":33},{"id":"wgc-q0289","section":"chapter-028","block":"b-8ffa03075a5c83c684c0","layer":"modern","quote":"〖5〗三年：甘露三年（公元 258）。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":204,"anchor":null},"note_id":"n-2f01fabf4ad1206b46c4","start":0,"end":19},{"id":"wgc-q0291","section":"chapter-028","block":"b-629abdab0ff82c8393d0","layer":"original","quote":"复还入城，城内食转竭，降出者数万口","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":195,"anchor":null},"note_id":null,"start":82,"end":99},{"id":"wgc-q0301","section":"chapter-028","block":"b-306b4aff277153d62295","layer":"original","quote":"唐咨、王祚及诸裨将，皆面缚降","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":214,"anchor":null},"note_id":null,"start":37,"end":51},{"id":"wgc-q0308","section":"chapter-028","block":"b-1557e93d1c7c76ec6209","layer":"original","quote":"黄初中，利城郡反，杀太守徐箕，推咨为主","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":217,"anchor":null},"note_id":null,"start":10,"end":29},{"id":"wgc-q0309","section":"chapter-028","block":"b-1557e93d1c7c76ec6209","layer":"original","quote":"文帝遣诸军讨破之，咨走入海；遂亡至吴","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":217,"anchor":null},"note_id":null,"start":30,"end":48},{"id":"wgc-q0310","section":"chapter-028","block":"b-1557e93d1c7c76ec6209","layer":"original","quote":"官至左将军，封侯，持节","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":217,"anchor":null},"note_id":null,"start":49,"end":60},{"id":"wgc-q0311","section":"chapter-028","block":"b-1557e93d1c7c76ec6209","layer":"original","quote":"拜咨安远将军〖10〗，其余裨将咸假号位","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":217,"anchor":null},"note_id":null,"start":85,"end":104},{"id":"wgc-q0448","section":"chapter-028","block":"b-3813a3aab7f10a285eae","layer":"original","quote":"文王敕青，徐、兖、豫、荆、扬诸州，并使作船；又令唐咨作浮海大船，外为将伐吴者","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":470,"anchor":null},"note_id":null,"start":25,"end":63},{"id":"wgc-q0592","section":"chapter-028","block":"b-fa99abaef1f673ce3780","layer":"pei","quote":"文钦曰：‘蒋班、焦彝，谓我不能出而走；全端、全怿，又率众逆降：此敌无备之时也，可以战矣！’诞及唐咨等皆以为然，遂共悉众出攻","attribution":"裴注·汉晋春秋","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":213,"anchor":null},"note_id":"n-73682a57dcb31fcf32f5","start":12,"end":73},{"id":"wuzhu-e-o113d-q","section":"chapter-047","block":"b-56f9d22ba18041334d05","layer":"original","quote":"中郎将吾粲获李桓〖20〗；将军唐咨〖21〗，获罗厉等。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":52,"anchor":null},"note_id":null,"start":78,"end":105},{"id":"wuzhu-e-o128a-q","section":"chapter-047","block":"b-43c4e115f962534e3553","layer":"original","quote":"冬十月，将军蒋秘南讨夷贼。秘所领都督廖式，杀临贺太守严纲等〖2〗，自称“平南将军〖3〗”；与弟潜，共攻零陵、桂阳，及摇动交州、苍梧、郁林诸郡〖4〗，众数万人。遣将军吕岱、唐咨讨之，岁余皆破。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":163,"anchor":null},"note_id":null,"start":0,"end":95},{"id":"wuzhu-q-o113","section":"chapter-047","block":"b-56f9d22ba18041334d05","layer":"original","quote":"五年春〖15〗，铸大钱，一当五百。诏使吏民输铜〖16〗，计铜畀直〖17〗；设盗铸之科〖18〗。（二）〔三〕月，武昌言甘露降于礼宾殿。辅吴将军张昭卒〖19〗。中郎将吾粲获李桓〖20〗；将军唐咨〖21〗，获罗厉等。自十月不雨，至于夏。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":52,"anchor":null},"note_id":null,"start":0,"end":115},{"id":"wuzhu-q-o126","section":"chapter-047","block":"b-ab932a5023f68052057f","layer":"original","quote":"二年春三月〖1〗，﹝一﹞遣使者羊衜、郑胄、将军孙怡，之辽东，击魏守将张持、高虑等，虏得男女。﹝二﹞零陵言甘露降。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":161,"anchor":null},"note_id":null,"start":0,"end":56},{"id":"wuzhu-q-o128","section":"chapter-047","block":"b-43c4e115f962534e3553","layer":"original","quote":"冬十月，将军蒋秘南讨夷贼。秘所领都督廖式，杀临贺太守严纲等〖2〗，自称“平南将军〖3〗”；与弟潜，共攻零陵、桂阳，及摇动交州、苍梧、郁林诸郡〖4〗，众数万人。遣将军吕岱、唐咨讨之，岁余皆破。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":163,"anchor":null},"note_id":null,"start":0,"end":95},{"id":"zhulv-q-305b4439281ed74f2920","section":"chapter-056","block":"b-604767dbf5853a5d004b","layer":"original","quote":"魏出东兴，据赴讨有功","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":199,"anchor":null},"note_id":null,"start":10,"end":20},{"id":"zhulv-q-77551a11b8ee4f203b3f","section":"chapter-056","block":"b-abd659c367dbc19a7af5","layer":"original","quote":"是岁，魏遣胡遵、诸葛诞等出东兴。异督水军攻浮梁〖6〗，坏之，魏军大破","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":285,"anchor":null},"note_id":null,"start":11,"end":45},{"id":"zhulv-q-a10a3c3eee3aa2496b9c","section":"chapter-056","block":"b-321b841bc136cd345e37","layer":"original","quote":"綝闻之，使中书奉诏〖9〗，诏文钦、刘纂、唐咨等，使取据；又遣从兄（虑）〔宪〕，以都下兵逆据于江都","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":201,"anchor":null},"note_id":null,"start":42,"end":90}],"profiles":{},"directory_counts":{}}
