{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wuzhu-e-p030b","title":"孙权向曹丕询问张辽朱横海复驻合肥","accounts":[{"id":"wuzhu-e-p030b-account","label":"《魏略》","text":"孙权向曹丕询问张辽朱横海复驻合肥","evidence":["wuzhu-e-p030b-q"]}],"participants":[{"person":"sun-quan","role":"询问","evidence":["wuzhu-e-p030b-q"]},{"person":"wudi-p0170","role":"受笺","evidence":["wuzhu-e-p030b-q"]},{"person":"wudi-p0178","role":"驻军","evidence":["wuzhu-e-p030b-q"]},{"person":"wuzhu-p0141","role":"驻军","evidence":["wuzhu-e-p030b-q"]}],"place":null,"time":{"label":"孙权向曹丕陈边境冲突时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["wuzhu-e-p030b-q"]},"ordering_evidence":"wuzhu-e-p030b-q","source_order":[47,348,"P030b"],"order":8234}],"persons":[{"id":"wuzhu-p0141","name":"朱横海（《魏略》所记）","evidence":["wuzhu-q-p030"],"facts":[],"aliases":[],"mentions":[{"id":"wuzhu-m-p030-wuzhu-p0141","kind":"mention","text":"文中提及","evidence":["wuzhu-q-p030"]}]}],"evidence":[{"id":"wuzhu-e-p030b-q","section":"chapter-047","block":"b-56fc0fcff99b4d647260","layer":"pei","quote":"又闻张征东、朱横海，今复还合肥。先王盟要，由来未久；且权自度，未获罪衅，不审今者何以发起，牵军远次？事业未讫，甫当为国讨除贼备；重闻斯问，深使失图！凡远人所恃，在于明信；愿殿下克卒前分，开示坦然；使权誓命，得卒本规。凡所愿言，周等所当传也。’","attribution":"《魏略》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":347,"anchor":null},"note_id":"n-43467797fb37569f4074","start":144,"end":265},{"id":"wuzhu-q-p030","section":"chapter-047","block":"b-56fc0fcff99b4d647260","layer":"pei","quote":"又曰：‘先王以权推诚已验，军当引还；故除合肥之守，著南北之信：令权长驱，不复后顾。近得守将周泰、全琮等白事：过月六日，有马步七百，径到横江，又督将马和，复将四百人进到居巢；琮等闻有兵马渡江，视之，为兵马所击；临时交锋，大相杀伤。猝得此问，情用恐惧。权实在远，不预闻知；约敕无素，敢谢其罪？又闻张征东、朱横海，今复还合肥。先王盟要，由来未久；且权自度，未获罪衅，不审今者何以发起，牵军远次？事业未讫，甫当为国讨除贼备；重闻斯问，深使失图！凡远人所恃，在于明信；愿殿下克卒前分，开示坦然；使权誓命，得卒本规。凡所愿言，周等所当传也。’","attribution":"《魏略》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":347,"anchor":null},"note_id":"n-43467797fb37569f4074","start":0,"end":265}],"profiles":{},"directory_counts":{}}
