{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p087a","title":"王儁少时交游","accounts":[{"id":"wudi-e-p087a-account","label":"皇甫谧《逸士传》","text":"王儁少为范滂、许章赏识，与岑晊友善，曹操为布衣时亦爱重他。","evidence":["wudi-e-p087a-q"]}],"participants":[{"person":"wudi-p0259","role":"被赏识交游","evidence":["wudi-e-p087a-q"]},{"person":"wudi-p0260","role":"赏识","evidence":["wudi-e-p087a-q"]},{"person":"wudi-p0261","role":"赏识","evidence":["wudi-e-p087a-q"]},{"person":"wudi-p0262","role":"友善","evidence":["wudi-e-p087a-q"]},{"person":"cao-cao","role":"爱重","evidence":["wudi-e-p087a-q"]}],"place":null,"time":{"label":"王儁少时及曹操布衣时","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p087a-q"]},"source_order":[1,689,"P087a"],"order":284}],"persons":[{"id":"wudi-p0262","name":"岑晊","evidence":["wudi-q-p087","dongyuan-q-p109"],"facts":[],"aliases":[],"mentions":[{"id":"wudi-m-p087-wudi-p0262","kind":"mention","text":"文中提及","evidence":["wudi-q-p087"]},{"id":"dongyuan-m-p109-wudi-p0262","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p109"]}]}],"evidence":[{"id":"dongyuan-q-p109","section":"chapter-006","block":"b-8c13365348655e1e7588","layer":"pei","quote":"表与汝南陈翔字仲麟、范滂字孟博、鲁国孔昱字世元、勃海苑康字仲真、山阳檀敷字文友、张俭字元节、南阳岑晊字公孝为‘八友’。","attribution":"《汉末名士录》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":468,"anchor":null},"note_id":"n-79d1d1dad564a618e84b","start":10,"end":69},{"id":"wudi-e-p087a-q","section":"chapter-001","block":"b-ea056e74ee4abddcf775","layer":"pei","quote":"少为范滂、许章所识，与南阳岑晊善。公之为布衣，特爱儁；儁亦称公有治世之具。","attribution":"皇甫谧《逸士传》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":13,"anchor":null},"note_id":"n-cf8a0075075368325cde","start":20,"end":57},{"id":"wudi-q-p087","section":"chapter-001","block":"b-ea056e74ee4abddcf775","layer":"pei","quote":"皇甫谧《逸士传》曰：“汝南王儁，字子文。少为范滂、许章所识，与南阳岑晊善。公之为布衣，特爱儁；儁亦称公有治世之具。及袁绍与弟术丧母，归葬汝南；儁与公会之，会者三万人。公于外密语儁曰：‘天下将乱，为乱魁者，必此二人也！欲济天下，为百姓请命；不先诛此二子，乱今作矣。’儁曰：‘如卿之言，济天下者，舍卿复谁？’相对而笑。儁为人外静而内明，不应州郡、三府之命。公车征，不到。避地居武陵，归儁者一百余家。帝之都许，复征为尚书，又不就。刘表见绍强，阴与绍通。儁谓表曰：‘曹公，天下之雄也！必能兴霸道，继桓、文之功者也。今乃释近而就远；如有一朝之急，遥望漠北之救，不亦难乎？’表不从。儁年六十四，以寿终于武陵。公闻而哀伤。及平荆州，自临江迎丧：改葬于江陵，表为先贤也。”","attribution":"皇甫谧《逸士传》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":13,"anchor":null},"note_id":"n-cf8a0075075368325cde","start":0,"end":328}],"profiles":{},"directory_counts":{}}
