{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[],"persons":[{"id":"pangfa-p0024","name":"杨干","evidence":["pangfa-q-p013"],"facts":[],"aliases":[],"mentions":[{"id":"pangfa-m-p013-pangfa-p0024","kind":"allusion","text":"祖系或典故提及","evidence":["pangfa-q-p013"]}]}],"evidence":[{"id":"pangfa-q-p013","section":"chapter-037","block":"b-b1b888007831717e3087","layer":"pei","quote":"﹝二﹞孙盛曰：“夫威福自下，亡家害国之道；刑纵于宠，毁政乱理之源。安可以功臣而极其陵肆，嬖幸而藉其国柄者哉？故颠颉虽勤，不免违命之刑；杨干虽亲，犹加乱行之戮。夫岂不爱？王宪故也。诸葛氏之言，于是乎失政刑矣。”","attribution":"孙盛论","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":189,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-368fe212c90f9644b63a","start":0,"end":104,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
