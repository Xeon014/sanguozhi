-a6e2f90c11fbdfcdda28","feipin-q-c7ea592308d8d825fb5c","feipin-q-44414d26f51712e6135f","feipin-q-52e38e9eebfd05889d5c","feipin-q-a09d9b3ab1d0a2333bf1","feipin-q-218644c37caf41d0d30e","feipin-q-f7f0d231d54288a536e8","feipin-q-e2ea08ac7611b8c1e287","feipin-q-3f4cebed50970de0235d","feipin-q-6e61f4c674157b2fabb1","yululu-q-18f39d30425563b65159","yululu-q-7cdab036d8beeaf32719"],"facts":[{"id":"feipin-f-58b1694864138311a641","text":"字：大虎","evidence":["feipin-q-6e61f4c674157b2fabb1"]}],"aliases":[],"mentions":[{"id":"yululu-m-2b504a3074abb775bb8c","kind":"mention","text":"本篇原文记及全公主，具体行动与称谓见引文。","evidence":["yululu-q-7cdab036d8beeaf32719"]}]}],"evidence":[{"id":"feipin-q-218644c37caf41d0d30e","section":"chapter-050","block":"b-69af0fa98c05338f3141","layer":"original","quote":"太平中，孙亮知朱主为全主所害，问朱主死意〖5〗。全主惧曰：“我实不知，皆据二子熊、损所白！”亮杀熊、损。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":124,"anchor":null},"note_id":null,"start":0,"end":52},{"id":"feipin-q-3f4cebed50970de0235d","section":"chapter-050","block":"b-f8fad0f4016d04bd1d63","layer":"original","quote":"孙亮即位，孙峻辅政，峻素媚事全主。全主与和母有隙，遂劝峻徙和居新都；","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":138,"anchor":null},"note_id":null,"start":16,"end":50},{"id":"feipin-q-44414d26f51712e6135f","section":"chapter-050","block":"b-ab7c7df5debf9edb03d8","layer":"original","quote":"孙亮全夫人，全尚女也。（尚）从祖母公主爱之〖1〗，每进见辄与俱。及潘夫人母子有宠，全主自以与孙和母有隙，乃劝权，为潘氏男亮纳夫人，亮遂为嗣。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":111,"anchor":null},"note_id":null,"start":0,"end":70},{"id":"feipin-q-52e38e9eebfd05889d5c","section":"chapter-050","block":"b-8b87611dfa211c2910fe","layer":"original","quote":"初，孙和为太子时，全主谮害王夫人，欲废太子，立鲁王；朱主不听，由是有隙。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":123,"anchor":null},"note_id":null,"start":0,"end":36},{"id":"feipin-q-6e61f4c674157b2fabb1","section":"chapter-050","block":"b-d2dc14d313c8506f172c","layer":"original","quote":"长曰鲁班，字大虎","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":63,"anchor":null},"note_id":null,"start":65,"end":73},{"id":"feipin-q-a09d9b3ab1d0a2333bf1","section":"chapter-050","block":"b-8b87611dfa211c2910fe","layer":"original","quote":"五凤中，孙仪谋杀峻，事觉被诛。全主因言朱主与仪同谋，峻枉杀朱主。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":123,"anchor":null},"note_id":null,"start":36,"end":68},{"id":"feipin-q-c7ea592308d8d825fb5c","section":"chapter-050","block":"b-c1db69dafd59121d87ca","layer":"original","quote":"步氏薨后，和立为太子，权将立夫人为后；而全公主素憎夫人，稍稍谮毁〖1〗。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":86,"anchor":null},"note_id":null,"start":0,"end":36},{"id":"feipin-q-e2ea08ac7611b8c1e287","section":"chapter-050","block":"b-d2dc14d313c8506f172c","layer":"original","quote":"生二女：长曰鲁班，字大虎；前配周瑜子循〖2〗，后配全琮。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":63,"anchor":null},"note_id":null,"start":61,"end":89},{"id":"feipin-q-f7f0d231d54288a536e8","section":"chapter-050","block":"b-f8fad0f4016d04bd1d63","layer":"original","quote":"全主与和母有隙，遂劝峻徙和居新都；遣使赐死，嫡妃张氏亦自杀。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":138,"anchor":null},"note_id":null,"start":33,"end":63},{"id":"santizhu-q-134171d2c7afd0a384dd","section":"chapter-048","block":"b-adb7a4c042b8d74eade7","layer":"original","quote":"因倚权意，欲豫自结，数称述全尚女〖3〗，劝为亮纳","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":1,"anchor":null},"note_id":null,"start":49,"end":73},{"id":"santizhu-q-4ea4628abd86d3d6823f","section":"chapter-048","block":"b-fce5536b05cb3d0ea98d","layer":"original","quote":"亮以綝专恣，与太常全尚，将军刘丞，谋诛綝","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":121,"anchor":null},"note_id":null,"start":0,"end":20},{"id":"santizhu-q-985073c5de116ac5a2c9","section":"chapter-048","block":"b-adb7a4c042b8d74eade7","layer":"original","quote":"姊全公主尝谮太子和子母〖2〗","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":1,"anchor":null},"note_id":null,"start":29,"end":43},{"id":"santizhu059-q-6e995c73673dbd70d0c9","section":"chapter-059","block":"b-812b635bdb003f1dd7f3","layer":"original","quote":"是后王夫人与全公主有隙〖1〗。权尝寝疾〖2〗，和祠祭于庙；和妃叔父张休居近庙，邀和过所居〖3〗。全公主使人觇视〖4〗，因言太子不在庙中，专就妃家计议；又言王夫人见上寝疾，有喜色。权由是发怒，夫人忧死","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":159,"anchor":null},"note_id":null,"start":0,"end":99},{"id":"santizhu059-q-a6e2f90c11fbdfcdda28","section":"chapter-059","block":"b-9e46b98e48021784edc1","layer":"pei","quote":"权寝疾，意颇感悟，欲征和还国，立之；全公主及孙峻、孙弘等，固争之：乃止","attribution":"裴注·吴书","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":186,"anchor":null},"note_id":"n-c3775377fae83c73a475","start":10,"end":45},{"id":"santizhu059-q-b925e518424d302a132e","section":"chapter-059","block":"b-ca9dd836a1caafeb5792","layer":"original","quote":"又遣使者赐死。和与妃张辞别，张曰：“吉凶当相随，终不独生活也〖7〗！”亦自杀。举邦伤焉","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":188,"anchor":null},"note_id":null,"start":21,"end":64},{"id":"santizhu064-q-5274abc71ef19e4c91a7","section":"chapter-064","block":"b-95b6f4e559a9caf04f8a","layer":"original","quote":"亮妃，綝从姊女也〖5〗，以其谋告綝。","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":455,"anchor":null},"note_id":null,"start":91,"end":109},{"id":"santizhu064-q-64579e32a56ee44262ce","section":"chapter-064","block":"b-59d70cead8757b2905a8","layer":"original","quote":"綝遣将军孙耽，送亮之国〖16〗；徙尚于零陵；迁公主于豫章","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":458,"anchor":null},"note_id":null,"start":0,"end":28},{"id":"santizhu064-q-7f20cc569ae15f362b09","section":"chapter-064","block":"b-5a68ad209c9913a5a2f5","layer":"pei","quote":"纪承诏，以告尚；尚无远虑，以语纪母。母使人密语綝。綝夜发严兵废亮，比明，兵已围宫","attribution":"裴注·江表传","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":477,"anchor":null},"note_id":"n-3c25a1ac71ab7fb35794","start":230,"end":270},{"id":"santizhu064-q-e5d1dd0847f190e833bb","section":"chapter-064","block":"b-95b6f4e559a9caf04f8a","layer":"original","quote":"亮遂与公主鲁班、太常全尚、将军刘（承）〔丞〕议诛綝。亮妃，綝从姊女也〖5〗，以其谋告綝","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":455,"anchor":null},"note_id":null,"start":65,"end":108},{"id":"santizhu064-q-e606b38463134279ca20","section":"chapter-064","block":"b-76153f8279a05885c8c4","layer":"original","quote":"峻素无重名，骄矜险害〖7〗，多所刑杀，百姓嚣然。又奸乱宫人，与公主鲁班私通〖8〗。","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":388,"anchor":null},"note_id":null,"start":0,"end":41},{"id":"santizhu064-q-f4cffdb0d4a70d37ea2f","section":"chapter-064","block":"b-5a68ad209c9913a5a2f5","layer":"pei","quote":"亮召全尚息黄门侍郎纪，密谋，曰：‘孙綝专势，轻小于孤。孤（见）〔前〕敕之，使速上岸，为唐咨等作援；而留湖中，不上岸一步。又委罪朱异，擅杀功臣，不先表闻。筑第桥南，不复朝见。此为自在，无复所畏，不可久忍。今规取之，卿父作中军都督，使密严整士马；孤当自出临桥，帅宿卫虎骑、左右无难，一时围之；作板诏敕綝所领皆解散，不得举手：正尔，自〔当〕得之！卿去，但当使密耳。卿宣诏语卿父，勿令卿母知之；女人既不晓大事，且綝同堂姊：邂逅泄漏，误孤非小也","attribution":"裴注·江表传","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":477,"anchor":null},"note_id":"n-3c25a1ac71ab7fb35794","start":11,"end":228},{"id":"shaodi-q-b-f25c29f875d80e25ad66","section":"chapter-004","block":"b-f25c29f875d80e25ad66","layer":"modern","quote":"〖1〗三年：正始三年（公元 242）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":84,"anchor":null},"note_id":"n-0c94d6c7ec4663a4ff7d","start":0,"end":19},{"id":"shaodi-q-o015","section":"chapter-004","block":"b-928dff832b77cf5f2f14","layer":"original","quote":"三年春正月〖1〗，东平王徽薨〖2〗。三月，太尉满宠薨。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":71,"anchor":null},"note_id":null,"start":0,"end":27},{"id":"wuzhu-e-o135a-q","section":"chapter-047","block":"b-692e948ed8fd30650c98","layer":"original","quote":"五年春正月〖1〗，立子和为太子〖2〗。大赦，改禾兴为嘉兴。百官奏立皇后及四王，诏曰：“今天下不定，民物劳瘁〖3〗；且有功者或未录，饥寒者尚未恤；猥割土壤以丰子弟〖4〗，崇爵位以宠妃妾：孤甚不取。其释此议。”三月，海盐县言黄龙现〖5〗。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":193,"anchor":null},"note_id":null,"start":0,"end":117},{"id":"wuzhu-q-o135","section":"chapter-047","block":"b-692e948ed8fd30650c98","layer":"original","quote":"五年春正月〖1〗，立子和为太子〖2〗。大赦，改禾兴为嘉兴。百官奏立皇后及四王，诏曰：“今天下不定，民物劳瘁〖3〗；且有功者或未录，饥寒者尚未恤；猥割土壤以丰子弟〖4〗，崇爵位以宠妃妾：孤甚不取。其释此议。”三月，海盐县言黄龙现〖5〗。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":193,"anchor":null},"note_id":null,"start":0,"end":117},{"id":"yululu-q-18f39d30425563b65159","section":"chapter-057","block":"b-b3a968fc5e8c816d3bcc","layer":"original","quote":"为全公主所谮，皆死","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":473,"anchor":null},"note_id":null,"start":14,"end":23},{"id":"yululu-q-7cdab036d8beeaf32719","section":"chapter-057","block":"b-b3a968fc5e8c816d3bcc","layer":"original","quote":"孙亮时，二子熊、损各复领兵。为全公主所谮，皆死。永安中，追录前功，以熊子宣，袭爵云阳侯，尚公主。孙皓时，宣至骠骑将军。","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":473,"anchor":null},"note_id":null,"start":0,"end":59}],"profiles":{},"directory_counts":{}}
