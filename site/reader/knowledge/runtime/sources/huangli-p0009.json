{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"mingdi-e-o009b","title":"曹真督关右张郃街亭击破蜀军三郡平","accounts":[{"id":"mingdi-e-o009b-account","label":"《明帝纪》正文","text":"曹真督关右张郃街亭击破蜀军三郡平","evidence":["mingdi-e-o009b-q"]},{"id":"zhangle-e-o035a-account","label":"《张乐于张徐传第十七》正文","text":"张郃街亭绝汲道破马谡平三郡增邑","evidence":["zhangle-e-o035a-q"]},{"id":"zhuge-e-o033a-account","label":"《诸葛亮传第五》正文","text":"马谡违令街亭败张郃诸葛亮拔西县千余家还汉中斩谡","evidence":["zhuge-e-o033a-q"]},{"id":"zhuge-a-o034-judgment","label":null,"text":"诸葛亮疏陈街亭、箕谷之失皆由授任不当，自请贬三等。","evidence":["zhuge-q-o034-judgment"]},{"id":"xiahoucao-e-o052b-account","label":"《诸夏侯曹传第九》正文","text":"曹叡遣曹真督军张郃破马谡","evidence":["xiahoucao-e-o052b-q"]},{"id":"jfj-a-o032c","label":"正文 · 建兴六年","text":"马谡败于街亭","evidence":["jfj-q0133"]},{"id":"jfj-a-p009d","label":"《魏略》","text":"《魏略》记张郃费繇破蜀前锋","evidence":["jfj-q0228"]},{"id":"dongliu-a-433d9726e73070dad903","label":"正文","text":"诸葛亮违众拔马谡统大众在前","evidence":["dongliu-q-8d1ff93eb341f47f1325"]},{"id":"dongliu-a-be18cced1f144c49bbfd","label":"正文","text":"马谡与张郃战于街亭败破","evidence":["dongliu-q-968d7586901dfbcd3bb8"]},{"id":"dongliu-a-f28d4fd663ff03e66014","label":"正文","text":"诸葛亮退军还汉中","evidence":["dongliu-q-e9d60a047f9d066765a0"]},{"id":"dongliu-a-b75b19e3edd71a81824e","label":"正文","text":"马谡下狱物故，诸葛亮流涕","evidence":["dongliu-q-e76d9988594e126a9d3e"]},{"id":"huangli-a-149857408c92921e15a7","label":"正文","text":"马谡舍水上山","evidence":["huangli-q-cb50c70060b9dbdd4ff9"]},{"id":"huangli-a-0dfb2a621d32aec9a994","label":"正文","text":"王平规谏马谡不用","evidence":["huangli-q-8f70414a41aba2d4ce93"]},{"id":"huangli-a-7f5f909a83637ba6e010","label":"正文","text":"马谡大败街亭","evidence":["huangli-q-5904600ce6ee553f0758"]},{"id":"huangli-a-3050cea35d90b063d6e5","label":"正文","text":"王平鸣鼓自持张郃不逼","evidence":["huangli-q-ec683034033dae302667"]},{"id":"huangli-a-3f17cca58e6702ff5410","label":"正文","text":"王平收合败散将士","evidence":["huangli-q-d93fb00a0e39c932cd7f"]},{"id":"huangli-a-7635a6d88a118179bd50","label":"正文","text":"诸葛亮诛马谡等","evidence":["huangli-q-c17dcd424ae69fe98562"]},{"id":"dengzhang-a-05bf66718ee6164ab4b3","label":"裴注·华阳国志","text":"马谡败绩亮将杀之","evidence":["dengzhang-q-d232be08e8af119aad41"]}],"participants":[{"person":"wendi-p0038","role":"督军","evidence":["mingdi-e-o009b-q"]},{"person":"wudi-p0183","role":"击破","evidence":["mingdi-e-o009b-q"]},{"person":"zhuge-liang","role":"退兵","evidence":["mingdi-e-o009b-q"]},{"person":"mingdi-p0072","role":"被破","evidence":["zhangle-e-o035a-q"]},{"person":"wendi-p0005","role":"嘉赏","evidence":["zhangle-e-o035a-q"]},{"person":"jfj-p0028","role":"破敌","evidence":["jfj-q0228"]},{"person":"houzhu-p0029","role":"连规谏谡；所领千人，鸣鼓自持；徐徐收合诸营遗迸，率将士而还","evidence":["huangli-q-8f70414a41aba2d4ce93","huangli-q-ec683034033dae302667","huangli-q-d93fb00a0e39c932cd7f"]},{"person":"huangli-p0009","role":"将军，被诛","evidence":["huangli-q-c17dcd424ae69fe98562"]},{"person":"huangli-p0019","role":"将军，被诛","evidence":["huangli-q-c17dcd424ae69fe98562"]},{"person":"huangli-p0037","role":"将军，被夺兵","evidence":["huangli-q-c17dcd424ae69fe98562"]}],"place":{"text":"街亭","evidence":["mingdi-e-o009b-q"]},"time":{"year":228,"label":"太和二年","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"mingdi-y228","dating_review":{"reviewed":true,"anchor":"mingdi-q-o008","basis":"太和二年"},"evidence":["mingdi-e-o009b-q","mingdi-q-o008","mingdi-q-b-76fba510250937628a99"]},"ordering_evidence":"mingdi-e-o009b-q","source_order":[3,56,"O009b"],"order":739}],"persons":[{"id":"huangli-p0009","name":"张休（蜀将军）","evidence":["huangli-q-c17dcd424ae69fe98562"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[{"id":"dengzhang-q-d232be08e8af119aad41","section":"chapter-045","block":"b-3553154601c3ee84933d","layer":"pei","quote":"建兴六年，亮西征。马谡在前，败绩，亮将杀之","attribution":"裴注·华阳国志","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":343,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-dbd38a35de422f1d27d6","start":161,"end":182,"offset_unit":"unicode_code_point"},{"id":"dongliu-q-8d1ff93eb341f47f1325","section":"chapter-039","block":"b-c007b99c30e3df8ac9f4","layer":"original","quote":"而亮违众拔谡，统大众在前","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":104,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":38,"end":50,"offset_unit":"unicode_code_point"},{"id":"dongliu-q-968d7586901dfbcd3bb8","section":"chapter-039","block":"b-c007b99c30e3df8ac9f4","layer":"original","quote":"与魏将张郃战于街亭，为郃所破，士卒离散","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":104,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":51,"end":70,"offset_unit":"unicode_code_point"},{"id":"dongliu-q-e76d9988594e126a9d3e","section":"chapter-039","block":"b-c007b99c30e3df8ac9f4","layer":"original","quote":"谡下狱，物故〖3〗，亮为之流涕","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":104,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":83,"end":98,"offset_unit":"unicode_code_point"},{"id":"dongliu-q-e9d60a047f9d066765a0","section":"chapter-039","block":"b-c007b99c30e3df8ac9f4","layer":"original","quote":"亮进无所据，退军还汉中","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":104,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":71,"end":82,"offset_unit":"unicode_code_point"},{"id":"huangli-q-5904600ce6ee553f0758","section":"chapter-043","block":"b-c07b80607e4db3042648","layer":"original","quote":"大败于街亭，众尽星散","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":159,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":35,"end":45,"offset_unit":"unicode_code_point"},{"id":"huangli-q-8f70414a41aba2d4ce93","section":"chapter-043","block":"b-c07b80607e4db3042648","layer":"original","quote":"平连规谏谡，谡不能用","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":159,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":24,"end":34,"offset_unit":"unicode_code_point"},{"id":"huangli-q-c17dcd424ae69fe98562","section":"chapter-043","block":"b-c07b80607e4db3042648","layer":"original","quote":"丞相亮既诛马谡及将军张休、李盛，夺将军黄袭等兵","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":159,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":93,"end":116,"offset_unit":"unicode_code_point"},{"id":"huangli-q-cb50c70060b9dbdd4ff9","section":"chapter-043","block":"b-c07b80607e4db3042648","layer":"original","quote":"谡舍水上山，举措烦扰","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":159,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":13,"end":23,"offset_unit":"unicode_code_point"},{"id":"huangli-q-d93fb00a0e39c932cd7f","section":"chapter-043","block":"b-c07b80607e4db3042648","layer":"original","quote":"于是平徐徐收合诸营遗迸〖1〗，率将士而还","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":159,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":72,"end":92,"offset_unit":"unicode_code_point"},{"id":"huangli-q-ec683034033dae302667","section":"chapter-043","block":"b-c07b80607e4db3042648","layer":"original","quote":"惟平所领千人，鸣鼓自持。魏将张郃疑其伏兵，不往逼也","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":159,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":46,"end":71,"offset_unit":"unicode_code_point"},{"id":"jfj-q0133","section":"chapter-044","block":"b-85aae37594d28a751d2e","layer":"original","quote":"会马谡败于街亭","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":158,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":128,"end":135,"offset_unit":"unicode_code_point"},{"id":"jfj-q0228","section":"chapter-044","block":"b-1fcbe6e22b07445711e4","layer":"pei","quote":"未及遣迎冀中人，会亮前锋为张郃、费繇等所破","attribution":"《魏略》","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":173,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-46e2cf216fe32246f7b2","start":192,"end":213,"offset_unit":"unicode_code_point"},{"id":"mingdi-e-o009b-q","section":"chapter-003","block":"b-aec45ce1d329ad6dfa62","layer":"original","quote":"蜀大将诸葛亮寇边〖4〗，天水、南安、安定三郡吏民叛应亮〖5〗。﹝二﹞遣大将军曹真都督关右〖6〗，并进兵。右将军张郃击亮于街亭〖7〗，大破之。亮败走，三郡平。丁未〖8〗，行幸长安。﹝三﹞","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":55,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":92,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-b-76fba510250937628a99","section":"chapter-003","block":"b-76fba510250937628a99","layer":"modern","quote":"〖1〗二年：太和二年（公元 228）。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":60,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-38a74578b09178cb1fd4","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-o008","section":"chapter-003","block":"b-bec9198de0001b0aa26c","layer":"original","quote":"二年春正月〖1〗，宣王攻破新城。斩达，传其首〖2〗。﹝一﹞分新城之上庸、武陵、巫县为上庸郡〖3〗，锡县为锡郡。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":54,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":55,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o052b-q","section":"chapter-009","block":"b-6b09c300271ca978ec28","layer":"original","quote":"诸葛亮围祁山，南安、天水、安定三郡反应亮。帝遣真督诸军，军郿；遣张郃击亮将马谡〖12〗，大破之。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":221,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":19,"end":67,"offset_unit":"unicode_code_point"},{"id":"zhangle-e-o035a-q","section":"chapter-017","block":"b-1c7bb0c2a4ad2f049b9c","layer":"original","quote":"诸葛亮出祁山。加郃位特进，遣督诸军，拒亮将马谡于街亭。谡依阻南山，不下据城。郃绝其汲道〖2〗，击，大破之。南安、天水、安定郡反，应亮，郃皆破平之。诏曰：“贼亮以巴蜀之众，当虓虎之师〖3〗；将军被坚执锐，所向克定。朕甚嘉之！”益邑千户，并前四千三百户。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":122,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":125,"offset_unit":"unicode_code_point"},{"id":"zhuge-e-o033a-q","section":"chapter-035","block":"b-7d68192c0e968e4ac882","layer":"original","quote":"魏明帝西镇长安，命张郃拒亮。亮使马谡督诸军在前，与郃战于街亭〖7〗。谡违亮节度，举动失宜，大为郃所破。亮拔西县千余家〖8〗，还于汉中，﹝三﹞戮谡以谢众〖9〗。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":214,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":79,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-o034-judgment","section":"chapter-035","block":"b-ac0a1291d9674d568ae3","layer":"original","quote":"上疏曰：“臣以弱才，叨窃非据〖10〗，亲秉旄钺以厉三军〖11〗；不能训章明法，临事而惧〖12〗；至有街亭违命之阙，箕谷不戒之失〖13〗。咎皆在臣，授任无方；臣明不知人〖14〗，恤事多暗〖15〗。《春秋》责帅〖16〗，臣职是当〖17〗；请自贬三等，以督厥咎〖18〗。”","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":215,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":133,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
