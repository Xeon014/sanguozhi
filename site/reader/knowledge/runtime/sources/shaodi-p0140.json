342aebf012b"]}],"aliases":[],"mentions":[{"id":"shaodi-m-o160-shaodi-p0140","kind":"mention","text":"文中提及","evidence":["shaodi-q-o160"]}]}],"evidence":[{"id":"shaodi-e-o160b-q","section":"chapter-004","block":"b-72d03f189fe68e024021","layer":"original","quote":"秋七月，乐浪外夷韩、濊貊〖2〗，各率其属来朝贡。八月，戊寅〖3〗，赵王幹薨〖4〗。〔九月〕，甲寅〖5〗，复命大将军进爵晋公，加位相国，备礼崇锡〖6〗，一如前诏。又固辞，乃止。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":176,"anchor":null},"note_id":null,"start":0,"end":87},{"id":"shaodi-q-b-523407ec676f6c94e8ae","section":"chapter-004","block":"b-523407ec676f6c94e8ae","layer":"modern","quote":"〖1〗二年：景元二年（公元 261）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":182,"anchor":null},"note_id":"n-fcf5dbfcd0c9fc529bf8","start":0,"end":19},{"id":"shaodi-q-o159","section":"chapter-004","block":"b-cd68530495692d2d5ffb","layer":"original","quote":"二年夏五月〔丁未〕朔〖1〗，日有食之。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":175,"anchor":null},"note_id":null,"start":0,"end":19},{"id":"shaodi-q-o160","section":"chapter-004","block":"b-72d03f189fe68e024021","layer":"original","quote":"秋七月，乐浪外夷韩、濊貊〖2〗，各率其属来朝贡。八月，戊寅〖3〗，赵王幹薨〖4〗。〔九月〕，甲寅〖5〗，复命大将军进爵晋公，加位相国，备礼崇锡〖6〗，一如前诏。又固辞，乃止。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":176,"anchor":null},"note_id":null,"start":0,"end":87},{"id":"wuwen-q-299985923df0ec3c33a6","section":"chapter-020","block":"b-3104688293ae677a4e57","layer":"original","quote":"二十二年〖9〗，徙封赖亭侯。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":120,"anchor":null},"note_id":null,"start":16,"end":30},{"id":"wuwen-q-47d2dfa2748585852437","section":"chapter-020","block":"b-8bb8960c501de2bb665a","layer":"pei","quote":"﹝一﹞《魏略》曰：“幹，一名良。良本陈妾子，良生而陈氏死，太祖令王夫人养之。良年五岁，而太祖疾困，遗令语太子曰：‘此儿三岁亡母，五岁失父，以累汝也！’太子由是亲待，隆于诸弟。良年小，常呼文帝为‘阿翁’；帝谓良曰：‘我，汝兄耳。’文帝又愍其如是，每为流涕。”","attribution":"裴注引《魏略》","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":160,"anchor":null},"note_id":"n-e3db13613c68be899775","start":0,"end":128},{"id":"wuwen-q-648b098c35d48f02eeb9","section":"chapter-020","block":"b-8bb8960c501de2bb665a","layer":"pei","quote":"幹，一名良。","attribution":"裴注·谱系/人物资料（具体引书见原块）","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":160,"anchor":null},"note_id":"n-e3db13613c68be899775","start":10,"end":16},{"id":"wuwen-q-7c25bc33fbd9415b49cc","section":"chapter-020","block":"b-3104688293ae677a4e57","layer":"original","quote":"五年〖11〗，改封乐（城）〔成〕县〖12〗。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":120,"anchor":null},"note_id":null,"start":67,"end":89},{"id":"wuwen-q-80ef71fe8b90862d4b35","section":"chapter-020","block":"b-02d8e3db112f1ab23a73","layer":"original","quote":"景初、正元、景元中，累增邑；并前五千户。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":123,"anchor":null},"note_id":null,"start":0,"end":20},{"id":"wuwen-q-982ffe8c97df28dda5e9","section":"chapter-020","block":"b-3104688293ae677a4e57","layer":"original","quote":"七年，徙封钜鹿〖13〗。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":120,"anchor":null},"note_id":null,"start":89,"end":101},{"id":"wuwen-q-aa853c52202b67271064","section":"chapter-020","block":"b-3104688293ae677a4e57","layer":"original","quote":"赵王幹，建安二十年，封高平亭侯。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":120,"anchor":null},"note_id":null,"start":0,"end":16},{"id":"wuwen-q-ae26efc14397dd3e8aa0","section":"chapter-020","block":"b-a689ae3e6f0068c6d95a","layer":"original","quote":"幹母，有宠于太祖。及文帝为嗣，幹母有力。文帝临崩，有遗诏，是以明帝常加恩意。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":121,"anchor":null},"note_id":null,"start":0,"end":38},{"id":"wuwen-q-c2f55f326342aebf012b","section":"chapter-020","block":"b-87027621c423a4f13bd6","layer":"original","quote":"武皇帝二十五男：卞皇后生文皇帝、任城威王彰、陈思王植、萧怀王熊；刘夫人生丰愍王昂、相殇王铄；环夫人生邓哀王冲、彭城王据、燕王宇；杜夫人生沛穆王林、中山恭王衮；秦夫人生济阳怀王玹、陈留恭王峻；尹夫人生范阳闵王矩；王昭仪生赵王幹；孙姬生临邑殇公子上、楚王彪、刚殇公子勤；李姬生谷城殇公子乘、郿戴公子整、灵殇公子京；周姬生樊安公均；刘姬生广宗殇公子棘；宋姬生东平灵王徽；赵姬生乐陵王茂。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":1,"anchor":null},"note_id":null,"start":0,"end":190},{"id":"wuwen-q-d1a3d592813e577bc213","section":"chapter-020","block":"b-8bb8960c501de2bb665a","layer":"pei","quote":"良本陈妾子，良生而陈氏死，太祖令王夫人养之。","attribution":"裴注·谱系/人物资料（具体引书见原块）","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":160,"anchor":null},"note_id":"n-e3db13613c68be899775","start":16,"end":38},{"id":"wuwen-q-d431f6d6b32b7cb0b815","section":"chapter-020","block":"b-3104688293ae677a4e57","layer":"original","quote":"其年，改封弘农侯。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":120,"anchor":null},"note_id":null,"start":30,"end":39},{"id":"wuwen-q-d8bdcbac15c54250a2a7","section":"chapter-020","block":"b-3104688293ae677a4e57","layer":"original","quote":"﹝一﹞三年〖10〗，为河间王。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":120,"anchor":null},"note_id":null,"start":52,"end":67},{"id":"wuwen-q-ebc2af41eb08f4c11f36","section":"chapter-020","block":"b-3104688293ae677a4e57","layer":"original","quote":"太和六年，改封赵王。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":120,"anchor":null},"note_id":null,"start":101,"end":111},{"id":"wuwen-q-fd6869ec16e0d5569ed4","section":"chapter-020","block":"b-c86f79772c876a3924c9","layer":"original","quote":"青龙二年，私通宾客，为有司所奏；赐幹玺书诫诲之，曰：“《易》称‘开国承家，小人勿用〖14〗’；《诗》著‘大车惟尘’之诫〖15〗。自太祖受命创业，深睹治乱之源，鉴存亡之机；初封诸侯，训以恭慎之至言，辅以天下之端士。常称马援之遗诫〖16〗，重诸侯宾客交通之禁〖17〗，乃使与犯妖恶同〖18〗。夫岂以此薄骨肉哉〖19〗？徒欲使子弟无过失之愆〖20〗，士民无伤害之悔耳。高祖践阼，祗慎万机，申著诸侯不朝之令〖21〗。朕感诗人《棠棣》之作〖22〗，嘉《采菽》之义〖23〗；亦缘诏文曰‘若有诏得诣京都’〖24〗，故命诸王以朝聘之礼。而楚、中山并犯交通之禁〖25〗，赵宗、戴捷咸伏其辜〖26〗。近东平王复使属官殴寿张吏〖27〗，有司举奏，朕才削县〖28〗。（令）〔今〕有司以‘曹纂、王乔等，因九族时节〖29〗，集会王家〖30〗；或非其时，皆违禁防’。朕惟王幼少有恭顺之素；加受先帝顾命，欲崇恩礼，延乎后嗣；况近在王之身乎？且自非圣人，孰能无过？已诏有司，宥王之失。古人有言：‘戒慎乎其所不睹〖31〗，恐惧乎其所弗闻；莫现乎隐〖32〗，莫显乎微：故君子慎其独焉〖33〗。’叔父兹率先圣之典〖34〗，以纂乃先帝之遗命；战战兢兢，靖恭厥位：称朕意焉。”","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":122,"anchor":null},"note_id":null,"start":0,"end":516},{"id":"wuwen-q-fe07233a853c89bf37ff","section":"chapter-020","block":"b-3104688293ae677a4e57","layer":"original","quote":"黄初二年，进爵，徙封燕公。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":120,"anchor":null},"note_id":null,"start":39,"end":52}],"profiles":{},"directory_counts":{}}
