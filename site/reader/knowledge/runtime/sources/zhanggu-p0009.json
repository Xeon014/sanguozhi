{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"santizhu-e-o004a","title":"孙权寝疾时征诸葛恪滕胤辅太子","accounts":[{"id":"santizhu-a-92beb5079eb6199aa70d","label":"正文","text":"孙权寝疾时征诸葛恪滕胤辅太子","evidence":["santizhu-q-a8671dfa719ada9608d6"]},{"id":"santizhu064-a-0f53048ab485394171da","label":"正文","text":"孙权病重征诸葛恪等属以后事","evidence":["santizhu064-q-9738c31389ca10915f3b"]},{"id":"santizhu064-a-738cd4253778cb6470c4","label":"裴注·吴书","text":"峻表恪器任辅政权征恪","evidence":["santizhu064-q-0e7db2ae4b51bf6a222c"]},{"id":"santizhu064-a-28dd8c5d0b6e1165aa83","label":"裴注·吴书","text":"引恪受诏诸事一统于恪","evidence":["santizhu064-q-0af572f7d632a75c4086"]},{"id":"santizhu064-a-acef3aa935e1add61390","label":"正文","text":"权疾困，召恪、弘及太常滕胤、将军吕据、侍中孙峻，属以后事（孙弘以中书令领少傅）","evidence":["santizhu064-q-d14aaec4798e4c86c446"]},{"id":"santizhu064-a-d7ddfe2aa7da87eccbd2","label":"正文","text":"太元元年权寝疾，滕胤诣都留为太常，与诸葛恪等俱受遗诏辅政","evidence":["santizhu064-q-6e387014176f2cdc6a30"]}],"participants":[{"person":"sun-quan","role":"征诸葛恪、滕胤并令辅太子","evidence":["santizhu-q-a8671dfa719ada9608d6"]},{"person":"shaodi-p0041","role":"受征为太子太傅并辅太子","evidence":["santizhu-q-a8671dfa719ada9608d6"]},{"person":"santizhu-p0005","role":"受征为太常并辅太子","evidence":["santizhu-q-a8671dfa719ada9608d6"]},{"person":"wuzhu-p0127","role":"受召属以后事","evidence":["santizhu064-q-9738c31389ca10915f3b"]},{"person":"shaodi-p0075","role":"受召属以后事","evidence":["santizhu064-q-9738c31389ca10915f3b"]},{"person":"zhanggu-p0009","role":"以中书令领少傅，受召属以后事","evidence":["santizhu064-q-d14aaec4798e4c86c446"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["santizhu-q-a8671dfa719ada9608d6"]},"ordering_evidence":"santizhu-q-a8671dfa719ada9608d6","source_order":[48,4,0],"order":8422},{"id":"feipin-e-1b3ac7ce11ddb58636c9","title":"潘后遣问孙弘吕后专制故事","accounts":[{"id":"feipin-a-1b3ac7ce11ddb58636c9","label":"正文","text":"潘后遣问孙弘吕后专制故事","evidence":["feipin-q-8845d0d33dfafc146