{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wgc-e-add021","title":"毌丘奥任巴东监军益州刺史","order":5538,"accounts":[{"id":"wgc-a-add021","label":"世语","text":"毌丘奥任巴东监军益州刺史","evidence":["wgc-q0671","wgc-q0105"]}],"participants":[{"person":"wgc-p0080","role":"任官","evidence":["wgc-q0671","wgc-q0105"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0671","wgc-q0105"]},"ordering_evidence":"wgc-q0671"}],"persons":[{"id":"wgc-p0080","name":"毌丘奥","evidence":["wgc-q0105"],"aliases":[],"facts":[],"mentions":[{"id":"wgc-m-p021-wgc-p0080","kind":"mention","text":"本段涉及毌丘奥","evidence":["wgc-q0105"]}]}],"evidence":[{"id":"wgc-q0105","section":"chapter-028","block":"b-e1d61910b994c052c68e","layer":"pei","quote":"﹝一﹞《世语》曰：“甸字子邦。有名京邑。齐王之废也，甸谓俭曰：‘大人居方岳重任，国倾覆而晏然自守，将受四海之责。’俭然之。大将军恶其为人也，及俭起兵，问‘屈所在’？云‘不来，无能为也’。俭初起兵，遣子宗四人，入吴。太康中，吴平，宗兄弟皆还中国。宗字子仁。有俭风，至零陵太守。宗子奥，巴东监军、益州刺史。”","attribution":"世语","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":145,"anchor":null},"note_id":"n-d49275c82a6bab93ed43","start":0,"end":152},{"id":"wgc-q0671","section":"chapter-028","block":"b-e1d61910b994c052c68e","layer":"pei","quote":"宗子奥，巴东监军、益州刺史。","attribution":"世语","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":145,"anchor":null},"note_id":"n-d49275c82a6bab93ed43","start":137,"end":151}],"profiles":{},"directory_counts":{}}
