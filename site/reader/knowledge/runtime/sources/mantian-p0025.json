mantian-q-f4a0e3c9350401fc12ee","mantian-q-bd082664d36665f91444","mantian-q-132300e8d82d959fbe8e","mantian-q-78beb3976865f0df7022","mantian-q-ce72fdf4c54543548dc4","mantian-q-e31ba0346fea23fc55aa","mantian-q-62eed4e6ae2d1cce40eb"],"facts":[],"aliases":[],"mentions":[{"id":"mantian-m-0a0c6c3cfda084cfef8b","kind":"mention","text":"本段涉及牵招","evidence":["mantian-q-92927df21649c665fe83"]}]}],"evidence":[{"id":"mantian-q-052befe11bb71c7b914e","section":"chapter-026","block":"b-612b11792dcbb8ab7171","layer":"original","quote":"招呵忠曰：“曹公允恭明哲，翼戴天子；伐叛柔服，宁静四海。汝君臣顽嚣，今恃险远，背违王命；欲擅拜假，侮弄神器〖10〗。方当屠戮，何敢慢易咎毁大人〖11〗！”便捉忠头顿筑，拔刀欲斩之。峭王惊怖，徒跣抱招，以救请忠，左右失色。招乃还坐，为峭王等说成败之效，祸福所归。皆下席跪伏，敬受敕教；便辞辽东之使，罢所严骑","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":215,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":152,"offset_unit":"unicode_code_point"},{"id":"mantian-q-132300e8d82d959fbe8e","section":"chapter-026","block":"b-770d9b116fbc844e9384","layer":"original","quote":"建安九年，太祖围邺。尚遣招至上党，督致军粮。未还，尚破走，到中山〖7〗","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":200,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":35,"offset_unit":"unicode_code_point"},{"id":"mantian-q-29ea192291ae7278d5b4","section":"chapter-026","block":"b-c0dc876e5d6437775c60","layer":"original","quote":"事罢，还邺，拜平虏校尉〖14〗；将兵督青、徐州郡诸军事，击东莱贼〖15〗。斩其渠率〖16〗，东土宁静","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":217,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":16,"end":66,"offset_unit":"unicode_code_point"},{"id":"mantian-q-2bcfbc489381043fc159","section":"chapter-026","block":"b-291e1f4d532cf8a23116","layer":"original","quote":"太祖灭谭于南皮〖13〗，署招军谋掾，从讨乌丸。至柳城，拜护乌丸校尉","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":216,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":33,"offset_unit":"unicode_code_point"},{"id":"mantian-q-2c5c29bcebc55e3f1b1c","section":"chapter-026","block":"b-90bffa095285fdb22467","layer":"original","quote":"比能复大合骑来，到故（平）〔武〕州塞北〖10〗。招潜行扑讨，大斩首级","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":258,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":34,"offset_unit":"unicode_code_point"},{"id":"mantian-q-2f448ad6c234211abed7","section":"chapter-026","block":"b-b3a5e0dd44cfcc9fe5d4","layer":"original","quote":"又并驰布羽檄〖5〗，称陈形势，云“当西北掩取虏家〖6〗，然后东行，会诛虏身〖7〗”。檄到，豫军踊跃。又遗一通于虏蹊要〖8〗，虏即恐怖，种类离散。军到故平城〖9〗，便皆溃走","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":257,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":94,"end":179,"offset_unit":"unicode_code_point"},{"id":"mantian-q-3d6a4ce82af2fe2aa5b5","section":"chapter-026","block":"b-e92954ffe78a2f952234","layer":"original","quote":"出为雁门太守〖6〗。郡在边陲，虽有候望之备，而寇抄不断。招既教民战阵，又表复乌丸五百余家租调〖7〗；使备鞍马，远遣侦候。虏每犯塞，勒兵逆击，来辄摧破；于是吏民胆气日锐，荒野无虞。又搆间离散，使虏更相猜疑","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":236,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":25,"end":126,"offset_unit":"unicode_code_point"},{"id":"mantian-q-572d381e3da9fd8ee9cf","section":"chapter-026","block":"b-f8d8a89a32857ae8f96b","layer":"original","quote":"乃使豫持节，护乌丸校尉〖2〗；牵招、解儁，并护鲜卑","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":141,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":17,"end":42,"offset_unit":"unicode_code_point"},{"id":"mantian-q-62eed4e6ae2d1cce40eb","section":"chapter-026","block":"b-81c5af75b6aa7cb02926","layer":"original","quote":"峭王问招：“昔袁公言受天子之命，假我为单于；今曹公复言‘当更白天子，假我真单于’；辽东复持印绶来。如此，谁当为正？”招答曰：“昔袁公承制〖5〗，得有所拜假〖6〗；中间违错〖7〗，天子命曹公代之，言‘当白天子，更假真单于’，是也。辽东下郡，何得擅称拜假也？”忠曰：“我辽东在沧海之东，拥兵百万；又有扶余、濊貊之用〖8〗。当今之势，强者为右〖9〗。曹操独何得为是也","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":214,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":180,"offset_unit":"unicode_code_point"},{"id":"mantian-q-66984bd61b3fb64a2db2","section":"chapter-026","block":"b-e92954ffe78a2f952234","layer":"original","quote":"大军欲征吴，召招还。至，值军罢，拜右中郎将〖5〗","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":236,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":24,"offset_unit":"unicode_code_point"},{"id":"mantian-q-78beb3976865f0df7022","section":"chapter-026","block":"b-770d9b116fbc844e9384","layer":"original","quote":"时尚外兄高幹为并州刺史，招以“并州左有恒山之险〖8〗，右有大河之固〖9〗；带甲五万〖10〗，北阻强胡”，劝幹迎尚，并力观变。幹既不能，而阴欲害招。招闻之，间行而去〖11〗；道隔不得追尚，遂东诣太祖","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":200,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":36,"end":134,"offset_unit":"unicode_code_point"},{"id":"mantian-q-7feae76c4ad0f4c2d7c4","section":"chapter-026","block":"b-f98461219d42ba544b4b","layer":"original","quote":"文帝践阼，拜招使持节、护鲜卑校尉，屯昌平〖1〗。是时，边民流散山泽；又亡叛在鲜卑中者，处有千数。招广布恩信，招诱降附。建义中郎将公孙集等〖2〗，率将部曲，咸各归命；使还本郡。又怀来鲜卑素利、弥加等十余万落〖3〗；皆令款塞","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":235,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":110,"offset_unit":"unicode_code_point"},{"id":"mantian-q-865f3332b5257734672e","section":"chapter-026","block":"b-291e1f4d532cf8a23116","layer":"original","quote":"署招军谋掾，从讨乌丸。至柳城，拜护乌丸校尉","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":216,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":12,"end":33,"offset_unit":"unicode_code_point"},{"id":"mantian-q-8917264f68583da405d5","section":"chapter-026","block":"b-207580a4bad8b5a7887f","layer":"original","quote":"招乃简选有才识者，诣太学受业；还相授教，数年中庠序大兴〖14〗","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":238,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":31,"offset_unit":"unicode_code_point"},{"id":"mantian-q-8b24a134e1a5cfee22c9","section":"chapter-026","block":"b-c746afce98646ef06fd1","layer":"original","quote":"招通河西鲜卑附头等十余万家〖11〗。缮治陉北故上馆城〖12〗，置屯戍以镇内外；夷虏大小，莫不归心；诸叛亡虽亲戚不敢藏匿，咸悉收送。于是野居晏闭〖13〗，寇贼静息","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":237,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":100,"end":180,"offset_unit":"unicode_code_point"},{"id":"mantian-q-916b5626ced076ca3527","section":"chapter-026","block":"b-b3a5e0dd44cfcc9fe5d4","layer":"original","quote":"明帝即位，赐爵关内侯","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":257,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":10,"offset_unit":"unicode_code_point"},{"id":"mantian-q-92927df21649c665fe83","section":"chapter-026","block":"b-ebd1963bc8381f309d9e","layer":"original","quote":"评曰：满宠立志刚毅，勇而有谋；田豫居身清白，规略明练〖1〗；牵招秉义壮烈，威绩显著；郭淮方策精详，垂问秦、雍〖2〗。而豫位止小州〖3〗，招终于郡守：未尽其用也","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":377,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":79,"offset_unit":"unicode_code_point"},{"id":"mantian-q-959d108053a708b63004","section":"chapter-026","block":"b-90bffa095285fdb22467","layer":"original","quote":"招以“蜀虏诸葛亮数出，而比能狡猾，能相交通”，表为防备；议者以为悬远，未之信也。会亮时在祁山，果遣使连结比能。比能至故北地吕城〖11〗，与相首尾〖12〗。帝乃诏招，使从便宜讨之","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":258,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":35,"end":123,"offset_unit":"unicode_code_point"},{"id":"mantian-q-9e3a0010e04c72f7d61b","section":"chapter-026","block":"b-291e1f4d532cf8a23116","layer":"original","quote":"辽东送袁尚首，悬在马市；招睹之悲感，设祭头下。太祖义之，举为茂才","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":216,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":37,"end":69,"offset_unit":"unicode_code_point"},{"id":"mantian-q-b3a1f1d151412a1b0a6a","section":"chapter-026","block":"b-291e1f4d532cf8a23116","layer":"original","quote":"还邺，辽东送袁尚首，悬在马市；招睹之悲感，设祭头下。太祖义之，举为茂才。","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":216,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":34,"end":70,"offset_unit":"unicode_code_point"},{"id":"mantian-q-bd082664d36665f91444","section":"chapter-026","block":"b-e72bd743ae5c404ac039","layer":"original","quote":"冀州牧袁绍辟为督军从事〖4〗，兼领乌丸突骑〖5〗。绍舍人犯令〖6〗，招先斩乃白；绍奇其意而不见罪也。绍卒，又事绍子尚","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":199,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":58,"offset_unit":"unicode_code_point"},{"id":"mantian-q-c557e45009ce1e77e74d","section":"chapter-026","block":"b-b3a5e0dd44cfcc9fe5d4","layer":"original","quote":"招即整勒兵马，欲赴救豫。并州以常宪禁招〖2〗；招以为节将见围〖3〗，不可拘于吏议〖4〗，自表辄行","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":257,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":45,"end":93,"offset_unit":"unicode_code_point"},{"id":"mantian-q-c8d0e74cffa64d04c5ac","section":"chapter-026","block":"b-c746afce98646ef06fd1","layer":"original","quote":"是以招自出，率将归泥等，讨比能于云中故郡〖10〗，大破之","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":237,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":71,"end":99,"offset_unit":"unicode_code_point"},{"id":"mantian-q-ce72fdf4c54543548dc4","section":"chapter-026","block":"b-6205b7b45e89110835ff","layer":"original","quote":"太祖领冀州，辟为从事","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":213,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":10,"offset_unit":"unicode_code_point"},{"id":"mantian-q-d21c251019a2d765f75b","section":"chapter-026","block":"b-207580a4bad8b5a7887f","layer":"original","quote":"郡所治广武〖15〗，井水咸苦；民皆担辇远汲流水〖16〗，往返七里。招准望地势〖17〗，因山陵之宜，凿源开渠，注水城内，民赖其益","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":238,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":32,"end":95,"offset_unit":"unicode_code_point"},{"id":"mantian-q-da0e3bef927e8d94bea7","section":"chapter-026","block":"b-c0dc876e5d6437775c60","layer":"original","quote":"从平汉中，太祖还，留招为中护军。事罢，还邺，拜平虏校尉〖14〗；将兵督青、徐州郡诸军事，击东莱贼〖15〗。斩其渠率〖16〗，东土宁静","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":217,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":66,"offset_unit":"unicode_code_point"},{"id":"mantian-q-dc0d92098b5f1d8b8884","section":"chapter-026","block":"b-90bffa095285fdb22467","layer":"original","quote":"未及施行，会病卒","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":258,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":256,"end":264,"offset_unit":"unicode_code_point"},{"id":"mantian-q-e31ba0346fea23fc55aa","section":"chapter-026","block":"b-6205b7b45e89110835ff","layer":"original","quote":"太祖将讨袁谭，而柳城乌丸欲出骑助谭〖1〗。太祖以招尝领乌丸，遣诣柳城。到，值峭王严〖2〗，以五千骑当遣诣谭","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":213,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":11,"end":64,"offset_unit":"unicode_code_point"},{"id":"mantian-q-e3414b7540851f912fcf","section":"chapter-026","block":"b-90bffa095285fdb22467","layer":"original","quote":"时比能已还漠南〖14〗，招与刺史毕轨议曰〖15〗：“胡虏迁徙无常。若劳师远追，则迟速不相及；若欲潜袭，则山溪艰险，资粮转运，难以密办。可使守新兴、雁门二牙门〖16〗，出屯陉北；外以镇抚，内令兵田〖17〗；储蓄资粮，秋冬马肥；州郡兵合，乘衅征讨：计必全克","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":258,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":128,"end":254,"offset_unit":"unicode_code_point"},{"id":"mantian-q-f4a0e3c9350401fc12ee","section":"chapter-026","block":"b-4786a3d67b02098d83da","layer":"original","quote":"招（俱）与隐门生史路等，触蹈锋刃，共殡殓隐尸，送丧还归。道遇寇抄，路等皆悉散走。贼欲斫棺取钉〖3〗，招垂泪请赦；贼义之，乃释而去。由此显名","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":198,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":61,"end":130,"offset_unit":"unicode_code_point"}],"profiles":{"mantian-p0025":{"fields":[],"directory":{"faction":"wei"}}},"directory_counts":{}}
