{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-p003a","title":"《典略》载刘备讨张纯中创获免","accounts":[{"id":"xianzhu-e-p003a-account","label":"《典略》","text":"刘子平荐刘备随从事讨张纯，刘备野战中受伤佯死，后由故人载车救走；该书记以此军功任安熹尉。","evidence":["xianzhu-e-p003a-q"]}],"participants":[{"person":"xianzhu-p0019","role":"荐举","evidence":["xianzhu-e-p003a-q"]},{"person":"liu-bei","role":"中创获免","evidence":["xianzhu-e-p003a-q"]},{"person":"xianzhu-p0020","role":"反叛","evidence":["xianzhu-e-p003a-q"]}],"place":{"text":"平原、安熹","evidence":["xianzhu-e-p003a-q"]},"time":{"label":"张纯反叛时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xianzhu-e-p003a-q"]},"source_order":[32,34,"P003a"],"order":6504}],"persons":[{"id":"xianzhu-p0019","name":"刘子平","evidence":["xianzhu-q-p003"],"facts":[],"aliases":[],"mentions":[{"id":"xianzhu-m-p003-xianzhu-p0019","kind":"mention","text":"文中提及","evidence":["xianzhu-q-p003"]}]}],"evidence":[{"id":"xianzhu-e-p003a-q","section":"chapter-032","block":"b-aaad2a9fe6d9aa146623","layer":"pei","quote":"﹝一﹞《典略》曰：“平原刘子平，知备有武勇。时张纯反叛，青州被诏：遣从事将兵讨纯。过平原，子平荐备于从事，遂与相随。遇贼于野，备中创，佯死；贼去后，故人以车载之，得免。后以军功，为中山安（喜）〔熹〕尉。”","attribution":"《典略》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":33,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-e4dddf546e62010fbc7d","start":0,"end":102,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-p003","section":"chapter-032","block":"b-aaad2a9fe6d9aa146623","layer":"pei","quote":"﹝一﹞《典略》曰：“平原刘子平，知备有武勇。时张纯反叛，青州被诏：遣从事将兵讨纯。过平原，子平荐备于从事，遂与相随。遇贼于野，备中创，佯死；贼去后，故人以车载之，得免。后以军功，为中山安（喜）〔熹〕尉。”","attribution":"《典略》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":33,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-e4dddf546e62010fbc7d","start":0,"end":102,"offset_unit":"unicode_code_point"}],"profiles"