{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","section_sha256":{"chapter-001":"8aca4c346aa9cc8706094afc84a5888aa03910aadd75d3ee763fc732c00f7cf9","chapter-032":"a96846f8d938ee9c7b7644e4c1129ee5f143cef89abd660e00079e672445f305","chapter-054":"b5a12151318a634fc4ef1614a82b326cf31c11f29517fa7499b22e9df91cfead","chapter-002":"818e8049aaf4f2a93e8e46cd1aec733ed0e64863d8e91740be9c2472df004a3f","chapter-003":"a712d3afa6ac7c3e4faf87034c28a6aa57016260f8ddc98db8371e45a741536f","chapter-004":"2171636d4f88c51d566305b5c1dab806c253f5c206c89344f7e018893e738028","chapter-015":"f0f9387e4b0dde80a6b055e07924ffcb4b10222a9b56646d6350f77af6526714","chapter-051":"a35b11546f8435d585e16ee91e712d089972f83683f6d20319a1c56dc1d799d5","chapter-056":"96018f636d52bbff2c40906e669b52dc15c6734e7fa1e8a72b3260a13b5d4f69","chapter-049":"a319eaf1bf5f55d97ace63a168eb54f04234b59a4cd3d0fe2e6735a0ed53a0b5","chapter-005":"f33226d3809db3cbfa443023153066e4dc45f48bdf0a8fb7eaaae1e8f82bf8d4","chapter-017":"5cec5d9ac492f6f2d39500b30462be81180ffc6a29b4d9a4d704029814fb72d3","chapter-036":"47395a433ab8fe36f518928103d5c65f2d0e0c2ab4c4f2a0b4d3b20baa6edfa4","chapter-010":"09b405418e12ca9955223795330cf68335053af94f8586f546597fb93df73066","chapter-035":"1562f254358a04b1163df4f3f0ded73c0127bc1cbfa658b64749c98d9dc0f472","chapter-046":"2753c06ad42c38c1bdda422039c88144527fde54706e2c9246256b95d67ccf78","chapter-047":"d1894475df403fb65529aa57eb61a381255c0003de05a8ea635c4c1e3ad1321c","chapter-037":"3a31f347a754d0cc679f264c87a42272b4a77f2ec52847d4d7731f441948b4c8","chapter-058":"96fec57b485009675959eea96ef614906ce42afd8dce8318e433309129ee4ee5","chapter-009":"1ea4f07c42f6c03a0ea52f25f11f50d07eebc10e103b79badbcf752f5eb248bd","chapter-006":"901e82940ed39d65d67bf239a4d4a22ef64dca1eccad342805569308ff9b1042","chapter-048":"1a501150c90be19c978c8cde2d3cd7fb37fe72426a86dc0e38cd064d9f7ac1c4","chapter-014":"b73a4ced9fb5b7dba83be6531e23f0ed6efdbb235dc7b12b80441313d91fe3dd","chapter-028":"e