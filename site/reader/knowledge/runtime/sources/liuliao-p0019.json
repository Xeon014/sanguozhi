3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":34,"end":52,"offset_unit":"unicode_code_point"},{"id":"dengzhang-q-b6ceaebbb6880816a85d","section":"chapter-045","block":"b-5c28c096b533dff59f06","layer":"original","quote":"随丞相亮南征，为蛮夷所害，时年三十一","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":326,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":42,"end":60,"offset_unit":"unicode_code_point"},{"id":"dengzhang-q-d5dbd61162ffdc44a5c9","section":"chapter-045","block":"b-b45992c9c1a17284dbab","layer":"original","quote":"亮南征，留邵为治中从事","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":321,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":40,"end":51,"offset_unit":"unicode_code_point"},{"id":"dongliu-q-91af810846f5ae3f00a1","section":"chapter-039","block":"b-56bd53348c75c5b9fee8","layer":"original","quote":"上疏曰：“侍中郭攸之、费祎、侍郎董允等，先帝简拔以遗陛下","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":150,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":62,"end":90,"offset_unit":"unicode_code_point"},{"id":"dongliu-q-cd27e4cca7a9a20fc237","section":"chapter-039","block":"b-56bd53348c75c5b9fee8","layer":"original","quote":"亮寻请祎为参军","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":150,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":161,"end":168,"offset_unit":"unicode_code_point"},{"id":"dongliu-q-e2c33f6fff716105c8c6","section":"chapter-039","block":"b-4f59a98859b4f475164b","layer":"pei","quote":"建兴三年，亮征南中","attribution":"裴注·襄阳记","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":110,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b2f83c142b53ed7a6593","start":11,"end":20,"offset_unit":"unicode_code_point"},{"id":"dongliu-q-eb0b210fd16e9b4d714b","section":"chapter-039","block":"b-4f59a98859b4f475164b","layer":"pei","quote":"亮纳其策，赦孟获以服南方","attribution":"裴注·襄阳记","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":110,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b2f83c142b53ed7a6593","start":163,"end":175,"offset_unit":"unicode_code_point"},{"id":"erfei-q-a439f0801272a0726186","section":"chapter-034","block":"b-b00e4a0b53c2891dee6b","layer":"original","quote":"延熙元年春正月，策曰","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":53,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":25,"end":35,"offset_unit":"unicode_code_point"},{"id":"erfei-q-be066eabde783ade7a19","section":"chapter-034","block":"b-7da40348af4a58b0e891","layer":"original","quote":"延熙元年正月策曰","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":92,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":25,"end":33,"offset_unit":"unicode_code_point"},{"id":"erfei-q2-478bae2e56304e34573c","section":"chapter-034","block":"b-7da40348af4a58b0e891","layer":"original","quote":"后主太子璿，字文衡。母王贵人，本敬哀张皇后侍人也。延熙元年正月策曰：“在昔帝王，继体立嗣〖1〗；副贰国统，古今常道。今以璿为皇太子，昭显祖宗之威。命使行丞相事、左将军朗，持节，授印绶。其勉修茂质，祗恪道义；咨询典礼，敬友师傅；斟酌众善，翼成尔德〖2〗。可不务修以自勖哉〖3〗！”时年十五。","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":92,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":144,"offset_unit":"unicode_code_point"},{"id":"erfei-q2-b6c16f582166fd9ee0c7","section":"chapter-034","block":"b-b00e4a0b53c2891dee6b","layer":"original","quote":"后主张皇后，前后敬哀之妹也。建兴十五年，入为贵人。延熙元年春正月，策曰：“朕统承大业，君临天下，奉郊庙、社稷。今以贵人为皇后。使行丞相事、左将军（向）朗〖1〗，持节，授玺绶。勉修中馈〖2〗，恪肃禋祀〖3〗。皇后其敬之哉！”","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":53,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":111,"offset_unit":"unicode_code_point"},{"id":"houzhu-q-O011","section":"chapter-033","block":"b-354a0a35bf9887aa11d1","layer":"original","quote":"三年春三月，丞相亮南征四郡〖2〗，四郡皆平。改益州郡为建宁郡；分建宁、永昌郡为云南郡〖3〗；又分建宁、牂牁为兴古郡〖4〗。","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":35,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":61,"offset_unit":"unicode_code_point"},{"id":"houzhu-q-O012","section":"chapter-033","block":"b-3529bcb2e8097984bcb5","layer":"original","quote":"十二月，亮还成都。","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":36,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":9,"offset_unit":"unicode_code_point"},{"id":"houzhu-q-O014","section":"chapter-033","block":"b-6af7fe784f1e0008c0e9","layer":"original","quote":"五年春，丞相亮出屯汉中，营沔北阳平、石马〖6〗。﹝二﹞","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":38,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":27,"offset_unit":"unicode_code_point"},{"id":"houzhu-q-O036","section":"chapter-033","block":"b-106d75ef6065149f87ea","layer":"original","quote":"延熙元年春正月〖1〗，立皇后张氏〖2〗。大赦，改元。立子璿为太子〖3〗，子瑶为安定王。","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":94,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":43,"offset_unit":"unicode_code_point"},{"id":"huangli-q-35d0854ebbacd22277ac","section":"chapter-043","block":"b-d2ec35871a73902cd80f","layer":"original","quote":"建兴五年，丞相亮北住汉中","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":193,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":12,"offset_unit":"unicode_code_point"},{"id":"huangli-q-4639de401721810ce6f4","section":"chapter-043","block":"b-e11f9e586959d73e2f0d","layer":"original","quote":"于是恢出击，大破之；追奔逐北，南至盘江〖19〗，东接牂牁，与亮声势相连","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":59,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":170,"end":205,"offset_unit":"unicode_code_point"},{"id":"huangli-q-6468462c5c9ba31b69b4","section":"chapter-043","block":"b-e11f9e586959d73e2f0d","layer":"original","quote":"丞相亮南征，先由越嶲","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":59,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":32,"end":42,"offset_unit":"unicode_code_point"},{"id":"huangli-q-719f26aa2be89e5fdfc4","section":"chapter-043","block":"b-1f594d574238f76d3965","layer":"original","quote":"及丞相亮南征讨阉，既发在道","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":93,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":18,"end":31,"offset_unit":"unicode_code_point"},{"id":"huangli-q-8607804c6bf08d8f9001","section":"chapter-043","block":"b-1f594d574238f76d3965","layer":"original","quote":"而闿已为高定部曲所杀","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":93,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":32,"end":42,"offset_unit":"unicode_code_point"},{"id":"huangli-q-b5114bce442112fd9e76","section":"chapter-043","block":"b-e11f9e586959d73e2f0d","layer":"original","quote":"时恢众少敌倍，又未得亮声息，绐谓南人曰〖15〗：“官军粮尽，欲规退还〖16〗；吾中间久斥乡里〖17〗，乃今得旋〖18〗，不能复北；欲还与汝等同计谋，故以诚相告。”南人信之，故围守怠缓","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":59,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":78,"end":169,"offset_unit":"unicode_code_point"},{"id":"huangli-q-e3ccf28eaf60b6787884","section":"chapter-043","block":"b-e11f9e586959d73e2f0d","layer":"original","quote":"而恢案道向建宁〖13〗，诸县大相纠合，围恢军于昆（明）〔泽〕","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":59,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":43,"end":73,"offset_unit":"unicode_code_point"},{"id":"huowang-q-48d4d3ad43fe395fd2c9","section":"chapter-041","block":"b-06fb1f2ea118ceeed874","layer":"original","quote":"朗素与马谡善，谡逃亡〖2〗，朗知情不举；亮恨之，免官还成都","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":39,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":11,"end":40,"offset_unit":"unicode_code_point"},{"id":"huowang-q-650287f82a6a45d463e5","section":"chapter-041","block":"b-f74d179169f140ec0a9f","layer":"original","quote":"荆州牧刘表，以为临沮长","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":37,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":16,"end":27,"offset_unit":"unicode_code_point"},{"id":"huowang-q-723bcf23a1cbdd5d3b1f","section":"chapter-041","block":"b-a4fa1eecb622b2ecaabd","layer":"original","quote":"洪对曰：“裔天姿明察，长于治剧〖12〗，才诚堪之；然性不公平，恐不可专任〖13〗。不如留向朗，朗情伪差少〖14〗；裔随从目下〖15〗，效其器能：于事两善。","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":124,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":30,"end":107,"offset_unit":"unicode_code_point"},{"id":"huowang-q-7c2b7ec9a46ef91f269f","section":"chapter-041","block":"b-06fb1f2ea118ceeed874","layer":"original","quote":"数年，为光禄勋〖3〗。亮卒后徙左将军，追论旧功，封显明亭侯，位特进","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":39,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":41,"end":74,"offset_unit":"unicode_code_point"},{"id":"huowang-q-7deeebf0e8889001c1fc","section":"chapter-041","block":"b-06fb1f2ea118ceeed874","layer":"original","quote":"五年〖1〗，随亮汉中","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":39,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":10,"offset_unit":"unicode_code_point"},{"id":"huowang-q-89d5b00a4674e6fec403","section":"chapter-041","block":"b-18d6bb3f10515ce754c4","layer":"original","quote":"延熙十年卒","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":41,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":5,"offset_unit":"unicode_code_point"},{"id":"huowang-q-8f424ee850969da203c7","section":"chapter-041","block":"b-5008b9b7cd23cd6b1641","layer":"original","quote":"丞相亮南征，朗留统后事","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":38,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":20,"end":31,"offset_unit":"unicode_code_point"},{"id":"huowang-q-9418f38e1a330c9a23fd","section":"chapter-041","block":"b-0331bba35be1e9a1beba","layer":"original","quote":"建兴三年，随诸葛亮南行，归至汉阳县","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":172,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":17,"offset_unit":"unicode_code_point"},{"id":"huowang-q-94ed756c01e6a610ea57","section":"chapter-041","block":"b-f74d179169f140ec0a9f","layer":"original","quote":"蜀既平，以朗为巴西太守。顷之转任牂牁。又徙房陵","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":37,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":63,"end":86,"offset_unit":"unicode_code_point"},{"id":"huowang-q-b80ed2d13f0b6c16869e","section":"chapter-041","block":"b-f74d179169f140ec0a9f","layer":"original","quote":"表卒，归先主","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":37,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":28,"end":34,"offset_unit":"unicode_code_point"},{"id":"huowang-q-cae6e0bf5310a86dc620","section":"chapter-041","block":"b-f74d179169f140ec0a9f","layer":"original","quote":"先主定江南，使朗督秭归、夷道、巫（山）、夷陵四县军民事","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":37,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":35,"end":62,"offset_unit":"unicode_code_point"},{"id":"huowang-q-cf555a5e236ef873ec39","section":"chapter-041","block":"b-e6998c80678c2b5e8a5a","layer":"original","quote":"丞相诸葛亮北驻汉中，请为记室〖5〗，使与子乔共周旋游处","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":5,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":27,"end":54,"offset_unit":"unicode_code_point"},{"id":"huowang-q-d31f418dd718fd014242","section":"chapter-041","block":"b-5008b9b7cd23cd6b1641","layer":"original","quote":"后主践阼，为步兵校尉，代王连领丞相长史","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":38,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"huowang-q-d6bd9abf610f84d31df3","section":"chapter-041","block":"b-ddba202528f8d05c7b7b","layer":"original","quote":"诸葛亮当北行，表与后主曰","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":43,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":12,"offset_unit":"unicode_code_point"},{"id":"huowang-q-df96241442ae09acfa45","section":"chapter-041","block":"b-16c2533477b122f48f5b","layer":"pei","quote":"朗少，师事司马德操。与徐元直、韩德高、庞士元皆亲善","attribution":"裴注·襄阳记","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":61,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-06d489ae4e8130ce5c53","start":11,"end":36,"offset_unit":"unicode_code_point"},{"id":"huowang-q-f77c8c8a833a94a6e386","section":"chapter-041","block":"b-ae55c1e4142178a93a87","layer":"original","quote":"自去长史，优游无事垂（三）（二）十年；﹝二﹞乃更潜心典籍，孜孜不倦。年逾八十，犹手自校书〖6〗，刊定谬误〖7〗；积聚篇卷，于时最多","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":40,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":26,"end":91,"offset_unit":"unicode_code_point"},{"id":"huowang-q-fd284d2a7935c051196e","section":"chapter-041","block":"b-ae55c1e4142178a93a87","layer":"original","quote":"开门接宾，诱纳后进〖8〗；但讲论古义，不干时事〖9〗，以是见称。上自执政，下及童冠〖10〗，皆敬重焉","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":40,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":92,"end":142,"offset_unit":"unicode_code_point"},{"id":"huowang-q-fd8bce84f8ecc240c5df","section":"chapter-041","block":"b-896b201bb490be2096b9","layer":"pei","quote":"朗遗言戒子曰：‘《传》称师克在和，不在众：此言天地和，则万物生；君臣和，则国家平；九族和，则动得所求，静得所安。是以圣人守和，以存以亡也。吾，楚国之小子耳。而早丧所天，为二兄所诱养，使其性行不随禄利以堕。今但贫耳，贫非人患；惟和为贵，汝其勉之！","attribution":"裴注·襄阳记","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":63,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6c9c69e0145fca004dd3","start":11,"end":133,"offset_unit":"unicode_code_point"},{"id":"huowang-q2-0252e419eed424e51196","section":"chapter-041","block":"b-a4fa1eecb622b2ecaabd","layer":"original","quote":"五年〖11〗，丞相亮北住汉中；欲用张裔为留府长史，问洪何如？洪对曰：“裔天姿明察，长于治剧〖12〗，才诚堪之；然性不公平，恐不可专任〖13〗。不如留向朗，朗情伪差少〖14〗；裔随从目下〖15〗，效其器能：于事两善。”","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":124,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":108,"offset_unit":"unicode_code_point"},{"id":"huowang-q2-d04494cf17320d81fd3c","section":"chapter-041","block":"b-5008b9b7cd23cd6b1641","layer":"original","quote":"后主践阼，为步兵校尉，代王连领丞相长史。丞相亮南征，朗留统后事。","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":38,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":32,"offset_unit":"unicode_code_point"},{"id":"liuermu-q-74c22b7e2a9d68bbb6e6","section":"chapter-031","block":"b-2a7eb34fd683676ae1b4","layer":"original","quote":"丞相诸葛亮平南土","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":75,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":41,"end":49,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-2ce94aa555b48d9d49d5","section":"chapter-040","block":"b-3432b319a4ef9b1daa34","layer":"original","quote":"五年〖1〗，诸葛亮驻汉中；更以延为督前部〖2〗，领丞相司马〖3〗，凉州刺史。","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":271,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":10,"end":48,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-b6ac46d1e937aa8eba43","section":"chapter-040","block":"b-1299f01ed12fc89c34bb","layer":"original","quote":"后主袭位，徙长水校尉。立本意，自谓才名宜为诸葛亮之贰；而更游散在李严等下，常怀怏怏。后丞相掾李（郃）〔邵〕、蒋琬至，立计曰：“军当远出，卿诸人好谛其事〖5〗：昔先（主）〔帝〕不取汉中，走与吴人争南三郡；卒以三郡与吴人，徒劳役吏士，无益而还。既亡汉中；使夏侯渊、张郃深入于巴，几丧一州。后至汉中；使关侯身死无孑遗〖6〗；上庸覆败，徒失一方。是羽怙恃勇名，作军无法〖7〗，直以意突耳〖8〗；故前后数丧师众也。如向朗、文恭，凡俗之人耳：恭作治中，无纲纪；朗昔奉马良兄弟，谓为‘圣人’，今作长史，素能合道。中郎郭演长，从人者耳，不足与经大事；而作侍中。今弱世也〖9〗，欲任此三人〖10〗，为不然也。王连流俗〖11〗，苟作掊克〖12〗；使百姓疲弊，以致今日。”","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":157,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":325,"offset_unit":"unicode_code_point"},{"id":"zhuge-e-o023a-q","section":"chapter-035","block":"b-862592827af5abe9feb3","layer":"original","quote":"三年春〖10〗，亮率众南征〖11〗。﹝三﹞其秋，悉平：军资所出〖12〗，国以富饶；﹝四﹞乃治戎讲武，以俟大举。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":133,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":55,"offset_unit":"unicode_code_point"},{"id":"zhuge-e-o024a-q","section":"chapter-035","block":"b-1cb2342652e8f8d4d768","layer":"original","quote":"五年〖1〗，率诸军北驻汉中。临发，上疏曰〖2〗：","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":152,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":24,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-b-28bd067e0a3e898385bc","section":"chapter-035","block":"b-28bd067e0a3e898385bc","layer":"modern","quote":"〖10〗三年：建兴三年（公元 225）。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":144,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-d52302c7e46aff00f085","start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-b-bac68d65cbee34059b3b","section":"chapter-035","block":"b-bac68d65cbee34059b3b","layer":"modern","quote":"〖1〗五年：建兴五年（公元 227）。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":160,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-7b55cee111ab139cccf8","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-o023","section":"chapter-035","block":"b-862592827af5abe9feb3","layer":"original","quote":"三年春〖10〗，亮率众南征〖11〗。﹝三﹞其秋，悉平：军资所出〖12〗，国以富饶；﹝四﹞乃治戎讲武，以俟大举。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":133,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":55,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-o024","section":"chapter-035","block":"b-1cb2342652e8f8d4d768","layer":"original","quote":"五年〖1〗，率诸军北驻汉中。临发，上疏曰〖2〗：","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":152,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":24,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-o025-judgment","section":"chapter-035","block":"b-f349f47d12e0cbd06380","layer":"original","quote":"先帝创业未半而中道崩殂〖3〗，今天下三分，益州疲弊〖4〗：此诚危急存亡之秋也〖5〗。然待卫之臣不懈于内〖6〗，忠志之士忘身于外者〖7〗，盖追先帝之殊遇〖8〗，欲报之于陛下也。诚宜开张圣听〖9〗，以光先帝遗德，恢弘志士之气；不宜妄自菲薄〖10〗，引喻失义〖11〗，以塞忠谏之路也。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":153,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":139,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-o026-judgment","section":"chapter-035","block":"b-b541f3054e32715de401","layer":"original","quote":"宫中、府中俱为一体；陟罚臧否〖12〗，不宜异同〖13〗。若有作奸犯科及为忠善者〖14〗，宜付有司论其刑赏〖15〗，以昭陛下平明之理〖16〗；不宜偏私，使内外异法也。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":154,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":82,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-o027-judgment","section":"chapter-035","block":"b-f53c08ba28ed4fadd5f0","layer":"original","quote":"侍中、侍郎郭攸之、费祎、董允等〖17〗，此皆良实，志虑忠纯，是以先帝简拔以遗陛下〖18〗。愚以为宫中之事〖19〗，事无大小，悉以咨之，然后施行；必能裨补阙漏〖20〗，有所广益。将军向宠〖21〗，性行淑均〖22〗，晓畅军事；试用于昔日，先帝称之曰能，是以众议举宠为督〖23〗。愚以为营中之事〖24〗，悉以咨之；必能使行阵和睦〖25〗，优劣得所。亲贤臣，远小人，此先汉所以兴隆也〖26〗；亲小人，远贤臣，此后汉所以倾颓也。先帝在时，每与臣论此事，未尝不叹息痛恨于桓、灵也〖27〗。侍中、尚书、长史、参军〖28〗，此悉贞良死节之臣〖29〗，愿陛下亲之信之，则汉室之隆，可计日而待也。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":155,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":288,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-o028-judgment","section":"chapter-035","block":"b-334ba1b152f8848f7ced","layer":"original","quote":"臣本布衣〖30〗，躬耕于南阳〖31〗；苟全性命于乱世〖32〗，不求闻达于诸侯〖33〗。先帝不以臣卑鄙〖34〗，猥自枉屈〖35〗，三顾臣于草庐之中，咨臣以当世之事；由是感激〖36〗，遂许先帝以驱驰〖37〗；后值倾覆〖38〗，受任于败军之际；奉命于危难之间：尔来二十有一年矣〖39〗。﹝一﹞先帝知臣谨慎，故临崩寄臣以大事也。受命以来，夙夜忧叹，恐托付不效〖40〗，以伤先帝之明；故五月渡泸〖41〗，深入不毛〖42〗。﹝二﹞今南方已定，兵甲已足；当奖率三军〖43〗，北定中原；庶竭驽钝〖44〗，攘除奸凶〖45〗；兴复汉室，还于旧都。此臣所以报先帝，而忠陛下之职分也。至于斟酌损益，进尽忠言，则攸之、袆、允之任也。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":156,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":303,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-o029-judgment","section":"chapter-035","block":"b-b687c1ebece526d57fd5","layer":"original","quote":"愿陛下托臣以讨贼兴复之效；不效，则治臣之罪，以告先帝之灵。〔若无兴德之言，则〕责攸之、祎、允等之慢〖46〗，以彰其咎。陛下亦宜自谋〖47〗，以咨诹善道〖48〗，察纳雅言〖49〗，深追先帝遗诏。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":157,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":96,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-o030-judgment","section":"chapter-035","block":"b-5b1e2aef1cc53d06cf76","layer":"original","quote":"臣不胜受恩感激；今当远离，临表涕零，不知所言！","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":158,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":23,"offset_unit":"unicode_code_point"}],"profiles":{"liuliao-p0019":{"fields":[],"directory":{"faction":"shu"}}},"directory_counts":{}}
