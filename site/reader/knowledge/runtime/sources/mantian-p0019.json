rt":0,"end":33,"offset_unit":"unicode_code_point"},{"id":"mantian-q-c8d0e74cffa64d04c5ac","section":"chapter-026","block":"b-c746afce98646ef06fd1","layer":"original","quote":"是以招自出，率将归泥等，讨比能于云中故郡〖10〗，大破之","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":237,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":71,"end":99,"offset_unit":"unicode_code_point"},{"id":"mantian-q-db99d8b125e75c487365","section":"chapter-026","block":"b-c746afce98646ef06fd1","layer":"original","quote":"敕令还击比能，杀比能弟苴罗侯，及叛乌丸归义侯王同、王寄等〖9〗；大结怨仇","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":237,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":34,"end":70,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-49023c326ea13763d287","section":"chapter-030","block":"b-7a2407d2753b29e36a3a","layer":"original","quote":"扶罗韩子泄归泥及部众悉属比能。比能自以杀归泥父，特又善遇之","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":64,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":123,"end":152,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-5b505093c8fb26a7d7bb","section":"chapter-030","block":"b-c129e6d9e032aa46097d","layer":"original","quote":"其秋，豫将西部鲜卑蒲头、泄归泥，出塞讨郁筑鞬，大破之","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":72,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":30,"end":56,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-5fa6cc27025240dc3905","section":"chapter-030","block":"b-7a2407d2753b29e36a3a","layer":"original","quote":"建安中，太祖定幽州，步度根与轲比能等因乌丸校尉阎柔上贡献〖2〗。后代郡乌丸能臣氐等叛，求属扶罗韩；扶罗韩将万余骑迎之。到桑干〖3〗，氐等议，以为扶罗韩部威禁宽缓，恐不见济〖4〗；更遣人，呼轲比能。比能即将万余骑到，当共盟誓；比能便于会上杀扶罗韩，扶罗韩子泄归泥及部众悉属比能。比能自以杀归泥父，特又善遇之〖5〗。步度根由是怨比能。","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":64,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":165,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-854aecb455d4435ff533","section":"chapter-030","block":"b-c7f229fe35499fa53b78","layer":"original","quote":"步度根乃使人招呼泄归泥曰：“汝父为比能所杀，不念报仇，反属怨家〖8〗。今虽厚待汝，是欲杀汝计也；不如还我，我与汝是骨肉至亲，岂与仇等","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":65,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":78,"end":144,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-8b996a18b7c4c670f4e6","section":"chapter-030","block":"b-c7f229fe35499fa53b78","layer":"original","quote":"由是归泥将其部落逃归步度根，比能追之弗及","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":65,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":146,"end":166,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-8c4820186041e79c98d1","section":"chapter-030","block":"b-faa0eac8be27a9cd175d","layer":"original","quote":"归泥叛比能，将其部众降","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":66,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":86,"end":97,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-9268fe8fe10c45992137","section":"chapter-030","block":"b-faa0eac8be27a9cd175d","layer":"original","quote":"于是步度根将泄归泥及部众悉保比能，寇抄并州，杀略吏民","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":66,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":44,"end":70,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-e6e357c93fd5fc6f7d96","section":"chapter-030","block":"b-faa0eac8be27a9cd175d","layer":"original","quote":"拜归义王，赐幢麾、曲盖、鼓吹〖11〗，居并州如故","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":66,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":98,"end":122,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
