page_0017.xhtml","index":473,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":225,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-o086a-q","section":"chapter-006","block":"b-eba9efae89fde9c055f3","layer":"original","quote":"嵩还，深陈太祖威德，说表遣子入质〖5〗。表疑嵩反为太祖说，大怒，欲杀嵩；考杀随嵩行者〖6〗，知嵩无他意，乃止。﹝一﹞表虽外貌儒雅，而心多疑忌，皆此类也。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":474,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":76,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-o088c-q","section":"chapter-006","block":"b-36c489d1f93241a324d4","layer":"original","quote":"越、嵩及东曹掾傅巽等说琮归太祖〖2〗。琮曰：“今与诸君据全楚之地〖3〗，守先君之业；以观天下，何为不可乎？”巽对曰：“逆顺有大体，强弱有定势。以人臣而拒人主，逆也；以新造之楚而御国家，其势弗当也；以刘备而敌曹公，又弗当也。三者皆短，欲以抗王兵之锋，必亡之道也！将军自料何与刘备〖4〗？”琮曰：“吾不若也。”巽曰：“诚以刘备不足御曹公乎〖5〗，则虽保楚之地，不足以自存也；诚以刘备足御曹公乎，则备不为将军下也〖6〗。愿将军勿疑！”","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":485,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":76,"end":290,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-o090a-q","section":"chapter-006","block":"b-35b4f4f1203d0e78df18","layer":"original","quote":"太祖以琮为青州刺史，封列侯；﹝一﹞蒯越等，侯者十五人。越，为光禄勋；﹝二﹞嵩，大鸿胪〖1〗；﹝三﹞羲，侍中；﹝四﹞先，尚书令；其余多至大官。﹝五﹞","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":499,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":73,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p114a-q","section":"chapter-006","block":"b-207439cab16e863a0c42","layer":"pei","quote":"初表谓嵩曰：‘今天下大乱，未知所定。曹公拥天子都许，君为我观其衅。’嵩对曰：‘圣达节，次守节。嵩，守节者也。夫事君为君，君臣名定，以死守之。今策名委质，唯将军所命；虽赴汤蹈火，死无辞也。以嵩观之，曹公至明，必济天下。将军能上顺天子，下归曹公，必享百世之利，楚国实受其佑，使嵩可也；设计未定，嵩使京师，天子假嵩一官，则天子之臣，而将军之故吏耳。在君为君，则嵩守天子之命，义不得复为将军死也。唯将军重思，无负嵩。’表遂使之，","attribution":"《傅子》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":483,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fc47dd4a1e39d4ff65b0","start":10,"end":220,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p114b-q","section":"chapter-006","block":"b-207439cab16e863a0c42","layer":"pei","quote":"果如所言，天子拜嵩侍中，迁零陵太守；还，称朝廷、曹公之德也。","attribution":"《傅子》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":483,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fc47dd4a1e39d4ff65b0","start":220,"end":250,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p114c-q","section":"chapter-006","block":"b-207439cab16e863a0c42","layer":"pei","quote":"表以为怀贰，大会僚属数百人，陈兵见嵩；盛怒，持节，将斩之，数曰：‘韩嵩敢怀贰邪！’众皆恐，欲令嵩谢。嵩不动，谓表曰：‘将军负嵩，嵩不负将军！’具陈前言。表怒不已，其妻蔡氏谏之曰：‘韩嵩，楚国之望也；且其言直，诛之无辞。’表乃弗诛而囚之。","attribution":"《傅子》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":483,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fc47dd4a1e39d4ff65b0","start":250,"end":368,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p121a-q","section":"chapter-006","block":"b-9685958a28e1faf9a2f8","layer":"pei","quote":"少好学，贫不改操。知世将乱，不应三公之命；与同好数人，隐居于郦西山中。黄巾起，嵩避难南方。","attribution":"《先贤行状》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":505,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a1447becdf7391db5227","start":21,"end":66,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p121b-q","section":"chapter-006","block":"b-9685958a28e1faf9a2f8","layer":"pei","quote":"刘表逼以为别驾，转从事中郎。表郊祀天地，嵩正谏不从，渐见违忤。","attribution":"《先贤行状》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":505,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a1447becdf7391db5227","start":66,"end":97,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p122a-q","section":"chapter-006","block":"b-d30667144427c0923f0c","layer":"pei","quote":"奉使到许，事在前注。荆州平，嵩疾病，就在所拜授大鸿胪印绶。","attribution":"裴注叙事","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":506,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a1447becdf7391db5227","start":0,"end":29,"offset_unit":"unicode_code_point"},{"id":"dongyuan-f0051-q","section":"chapter-006","block":"b-9685958a28e1faf9a2f8","layer":"pei","quote":"嵩字德高","attribution":"《先贤行状》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":505,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a1447becdf7391db5227","start":12,"end":16,"offset_unit":"unicode_code_point"},{"id":"dongyuan-f0052-q","section":"chapter-006","block":"b-9685958a28e1faf9a2f8","layer":"pei","quote":"义阳人","attribution":"《先贤行状》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":505,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a1447becdf7391db5227","start":17,"end":20,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o085","section":"chapter-006","block":"b-192264c9c238158ab549","layer":"original","quote":"从事中郎韩嵩、别驾刘先说表曰〖1〗：“豪杰并争，两雄相持；天下之重，在于将军。将军若欲有为，起乘其弊可也；若不然，固将择所从。将军拥十万之众，安坐而观望。夫见贤而不能助〖2〗，请和而不得〖3〗；此两怨必集于将军，将军不得中立矣！夫以曹公之明哲，天下贤俊皆归之，其势必举袁绍〖4〗；然后称兵以向江、汉，恐将军不能御也。故为将军计者，不若举州以附曹公，曹公必重德将军。长享福祚，垂之后嗣：此万全之策也！”表大将蒯越亦劝表。表狐疑，乃遣嵩诣太祖，以观虚实。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":473,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":225,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o086","section":"chapter-006","block":"b-eba9efae89fde9c055f3","layer":"original","quote":"嵩还，深陈太祖威德，说表遣子入质〖5〗。表疑嵩反为太祖说，大怒，欲杀嵩；考杀随嵩行者〖6〗，知嵩无他意，乃止。﹝一﹞表虽外貌儒雅，而心多疑忌，皆此类也。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":474,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":76,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o088","section":"chapter-006","block":"b-36c489d1f93241a324d4","layer":"original","quote":"建安十三年，太祖征表；未至，表病死。初，表及妻爱少子琮，欲以为后，而蔡瑁、张允为之支党〖1〗；乃出长子琦为江夏太守，众遂奉琮为嗣：琦与琮遂为仇隙。﹝二﹞越、嵩及东曹掾傅巽等说琮归太祖〖2〗。琮曰：“今与诸君据全楚之地〖3〗，守先君之业；以观天下，何为不可乎？”巽对曰：“逆顺有大体，强弱有定势。以人臣而拒人主，逆也；以新造之楚而御国家，其势弗当也；以刘备而敌曹公，又弗当也。三者皆短，欲以抗王兵之锋，必亡之道也！将军自料何与刘备〖4〗？”琮曰：“吾不若也。”巽曰：“诚以刘备不足御曹公乎〖5〗，则虽保楚之地，不足以自存也；诚以刘备足御曹公乎，则备不为将军下也〖6〗。愿将军勿疑！”","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":485,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":290,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o090","section":"chapter-006","block":"b-35b4f4f1203d0e78df18","layer":"original","quote":"太祖以琮为青州刺史，封列侯；﹝一﹞蒯越等，侯者十五人。越，为光禄勋；﹝二﹞嵩，大鸿胪〖1〗；﹝三﹞羲，侍中；﹝四﹞先，尚书令；其余多至大官。﹝五﹞","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":499,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":73,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p114","section":"chapter-006","block":"b-207439cab16e863a0c42","layer":"pei","quote":"﹝一﹞《傅子》曰：“初表谓嵩曰：‘今天下大乱，未知所定。曹公拥天子都许，君为我观其衅。’嵩对曰：‘圣达节，次守节。嵩，守节者也。夫事君为君，君臣名定，以死守之。今策名委质，唯将军所命；虽赴汤蹈火，死无辞也。以嵩观之，曹公至明，必济天下。将军能上顺天子，下归曹公，必享百世之利，楚国实受其佑，使嵩可也；设计未定，嵩使京师，天子假嵩一官，则天子之臣，而将军之故吏耳。在君为君，则嵩守天子之命，义不得复为将军死也。唯将军重思，无负嵩。’表遂使之，果如所言，天子拜嵩侍中，迁零陵太守；还，称朝廷、曹公之德也。表以为怀贰，大会僚属数百人，陈兵见嵩；盛怒，持节，将斩之，数曰：‘韩嵩敢怀贰邪！’众皆恐，欲令嵩谢。嵩不动，谓表曰：‘将军负嵩，嵩不负将军！’具陈前言。表怒不已，其妻蔡氏谏之曰：‘韩嵩，楚国之望也；且其言直，诛之无辞。’表乃弗诛而囚之。”","attribution":"《傅子》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":483,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fc47dd4a1e39d4ff65b0","start":0,"end":369,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p121","section":"chapter-006","block":"b-9685958a28e1faf9a2f8","layer":"pei","quote":"﹝三﹞《先贤行状》曰：“嵩字德高，义阳人。少好学，贫不改操。知世将乱，不应三公之命；与同好数人，隐居于郦西山中。黄巾起，嵩避难南方。刘表逼以为别驾，转从事中郎。表郊祀天地，嵩正谏不从，渐见违忤。”","attribution":"《先贤行状》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":505,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a1447becdf7391db5227","start":0,"end":98,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p122","section":"chapter-006","block":"b-d30667144427c0923f0c","layer":"pei","quote":"奉使到许，事在前注。荆州平，嵩疾病，就在所拜授大鸿胪印绶。","attribution":"裴注叙事","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":506,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a1447becdf7391db5227","start":0,"end":29,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o121d-q","section":"chapter-001","block":"b-031a374e9090ba29242f","layer":"original","quote":"公进军江陵〖9〗，下令荆州吏民，与之更始。乃论荆州服从之功，侯者十五人。以刘表大将文聘为江夏太守〖10〗，使统本兵；引用荆州名士韩嵩、邓义等〖11〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":663,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":62,"end":137,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-888495d8be7766faf20c","section":"chapter-001","block":"b-888495d8be7766faf20c","layer":"modern","quote":"〖1〗十三年：建安十三年（公元 208）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":666,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0bae348fdb687025113d","start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o119","section":"chapter-001","block":"b-4bcffcc4ee709a4e5ea3","layer":"original","quote":"十三年春正月〖1〗，公还邺。作玄武池以肄舟师〖2〗。﹝一﹞汉罢三公官，置丞相、御史大夫〖3〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":661,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":47,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o121","section":"chapter-001","block":"b-031a374e9090ba29242f","layer":"original","quote":"秋七月，公南征刘表。八月，表卒；其子琮代〖4〗，屯襄阳〖5〗。刘备屯樊〖6〗。九月，公到新野〖7〗，琮遂降。备走夏口〖8〗。公进军江陵〖9〗，下令荆州吏民，与之更始。乃论荆州服从之功，侯者十五人。以刘表大将文聘为江夏太守〖10〗，使统本兵；引用荆州名士韩嵩、邓义等〖11〗。﹝三﹞益州牧刘璋始受征役〖12〗，遣兵给军。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":663,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":159,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o012","section":"chapter-047","block":"b-3843def972d8a772cdb3","layer":"original","quote":"十三年春〖1〗，权复征黄祖。祖先遣舟兵拒军，都尉吕蒙破其前锋；而凌统、董袭等尽锐攻之〖2〗，遂屠其城。祖挺身亡走〖3〗。骑士冯则追枭其首〖4〗，虏其男女数万口。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":60,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":80,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-o064","section":"chapter-010","block":"b-38f29d879d5ca24386ff","layer":"original","quote":"建安十三年，太祖破荆州，欲顺江东下。诩谏曰：“明公昔破袁氏，今收汉南；威名远著，军势既大。若乘旧楚之饶，以飨吏士；抚安百姓，使安土乐业；则可不劳众而江东稽服矣〖4〗。”太祖不从，军遂无利。﹝一﹞","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":314,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":97,"offset_unit":"unicode_code_point"},{"id":"zhouyu-q-b-63f47c62fde80b3a0132","section":"chapter-054","block":"b-63f47c62fde80b3a0132","layer":"modern","quote":"〖6〗十三年：建安十三年（公元 208）。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":43,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8f109f42647e5ee8d831","start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"zhouyu-q-o009","section":"chapter-054","block":"b-3661896c106f1817bf4b","layer":"original","quote":"十三年春〖6〗，权讨江夏，瑜为前部大督〖7〗。其年九月，曹公入荆州，刘琮举众降。曹公得其水军船，步兵数十万。将士闻之皆恐。（惧）〔权〕延见群下〖8〗，问以计策。议者咸曰：“曹公，豺虎也！然托名汉相，挟天子以征四方，动以朝廷为辞；今日拒之，事更不顺。且将军大势：可以拒操者，长江也。今操得荆州，奄有其地〖9〗；刘表治水军，蒙冲、斗舰〖10〗，乃以千数，操悉浮以沿江；兼有步兵，水陆俱下。此为长江之险，已与我共之矣。而势力众寡，又不可论。愚谓大计不如迎之。”","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":34,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":227,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
