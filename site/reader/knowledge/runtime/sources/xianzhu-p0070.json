evidence":["liuliao-q-22512f040a2aea93d481"]},{"person":"xianzhu-p0073","role":"降魏、魏假耽怀集将军徙居南阳","evidence":["liuliao-q-22512f040a2aea93d481"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liuliao-q-22512f040a2aea93d481"]},"ordering_evidence":"liuliao-q-22512f040a2aea93d481","source_order":[40,12,0],"order":7247},{"id":"liuliao-e-o011","title":"先主责封赐死诸葛亮劝除之","accounts":[{"id":"liuliao-a-b2012ae1b475f0709c05","label":"正文","text":"先主责封赐死诸葛亮劝除之","evidence":["liuliao-q-8b0dafb9c8557175e4be"]}],"participants":[{"person":"liu-bei","role":"责封之侵陵达又不救羽、赐封死使自裁、为之流涕","evidence":["liuliao-q-8b0dafb9c8557175e4be"]},{"person":"zhuge-liang","role":"虑封刚猛易世之后终难制御、劝先主因此除之","evidence":["liuliao-q-8b0dafb9c8557175e4be"]},{"person":"xianzhu-p0070","role":"叹曰恨不用孟子度之言","evidence":["liuliao-q-8b0dafb9c8557175e4be"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liuliao-q-8b0dafb9c8557175e4be"]},"ordering_evidence":"liuliao-q-8b0dafb9c8557175e4be","source_order":[40,13,0],"order":7248}],"persons":[{"id":"xianzhu-p0070","name":"刘封","evidence":["xianzhu-q-o049","mingdi-q-p008","liuliao-q-376f13c5b505fc8ceec0","liuliao-q-79ddd8e23b5a267e775e","liuliao-q-da55f083868ec2c28f18","liuliao-q-6972e29d3070cf1efaa2","liuliao-q-0acb720ea57843737acd","liuliao-q-6bfb128dde5e5b38e551","liuliao-q-3724935feef65eeae077","liuliao-q-900dfb187d87f60b2cf8","liuliao-q-1b718b5a5c871ffc0d50","liuliao-q-eedf27599aabd0e108ba","liuliao-q-22512f040a2aea93d481","liuliao-q-8b0dafb9c8557175e4be","liuliao-q-870435406faae38bafd1","rencheng-q-5336e47142b837778ce5"],"facts":[{"id":"liuliao-f-742ad1a42f5734f7e7fe","text":"本罗侯寇氏之子，长沙刘氏之甥","evidence":["liuliao-q-870435406faae38bafd1"]}],"aliases":[],"mentions":[{"id":"xianzhu-m-o049-xianzhu-p0070","kind":"mention","text":"文中提及","evidence":["xianzhu-q-o049"]},{"id":"mingdi-m-p008-xianzhu-p0070","kind":"allusion","text":"祖系或典故提及","evidence":["mingdi-q-p008"]},{"id":"liuliao-m-a688aaab81baf0402432","kind":"mention","text":"本段涉及刘封","evidence":["liuliao-q-d9665bbb91f9df502fd4"]}]}],"evidence":[{"id":"chengguo-q-aeacfcb43c4e717c3e8a","section":"chapter-014","block":"b-f8a55e273c5a6f3c4809","layer":"original","quote":"延康元年，蜀将孟达率众降。达有容止才观〖1〗，文帝甚器爱之","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":317,"anchor":null},"note_id":null,"start":0,"end":29},{"id":"duzhou-q-6ebfbc56aa670fefde09","section":"chapter-042","block":"b-8c61a7d2840a5e8b787b","layer":"original","quote":"揖为将军孟达营都督〖2〗，随达降魏，为中书令史","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":364,"anchor":null},"note_id":null,"start":49,"end":72},{"id":"liuliao-q-0acb720ea57843737acd","section":"chapter-040","block":"b-967b35f4077a1663b327","layer":"original","quote":"遣征南将军夏侯尚、右将军徐晃与达共袭封","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":5,"anchor":null},"note_id":null,"start":70,"end":89},{"id":"liuliao-q-1b718b5a5c871ffc0d50","section":"chapter-040","block":"b-6ef7f14bf671f57395d5","layer":"original","quote":"昔微子去殷，智果别族〖39〗；违难背祸〖40〗，犹皆如斯。﹝二﹞今足下弃父母而为人后〖41〗，非礼也；知祸将至而留之，非智也；见正不从而疑之，非义也。自号为丈夫，为此三者，何所贵乎！以足下之才，弃身来东〖42〗，继嗣罗侯，不为背亲也；北面事君，以正纲纪，不为弃旧也；怒不致乱〖43〗，以免危亡，不为徒行也〖44〗。加陛下新受禅命〖45〗，虚心侧席〖46〗，以德怀远；若足下翻然内向，非但与仆为伦〖47〗，受三百户封〖48〗，继统罗国而已；当更剖符大邦〖49〗，为始封之君。陛下大军，金鼓已震，当转都宛、邓〖50〗；若二敌不平〖51〗，军无还期。足下宜因此时，早定良计。《易》有“利见大人〖52〗”，《诗》有“自求多福〖53〗”。","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":9,"anchor":null},"note_id":null,"start":0,"end":314},{"id":"liuliao-q-22512f040a2aea93d481","section":"chapter-040","block":"b-bb5e55dfbb21fd6de43d","layer":"original","quote":"封不从达言。申仪叛封，封破走还成都。申耽降魏，魏假耽怀集将军〖56〗，徙居南阳；仪魏兴太守〖57〗，封（真）〔郧〕乡侯，屯洵口","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":11,"anchor":null},"note_id":null,"start":0,"end":63},{"id":"liuliao-q-3724935feef65eeae077","section":"chapter-040","block":"b-fa63c17e9e9f143db10f","layer":"original","quote":"古人有言：“疏不间亲〖11〗，新不加旧〖12〗。”此谓上明下直〖13〗，谗慝不行也〖14〗。若乃权君谲主〖15〗，贤父慈亲〖16〗，犹有忠臣蹈功以罹祸〖17〗，孝子抱仁以陷难；种、商、白起、孝己、伯奇〖18〗，皆其类也。其所以然，非骨肉好离〖19〗，亲亲乐患也〖20〗：或有恩移爱易，亦有谗间其间〖21〗；虽忠臣不能移之于君，孝子不能变之于父者也。势利所加，改亲为仇；况非亲亲乎？故申生、卫伋、御寇、楚建禀受形之气〖22〗，当嗣立之正，而犹如此。","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":7,"anchor":null},"note_id":null,"start":0,"end":223},{"id":"liuliao-q-376f13c5b505fc8ceec0","section":"chapter-040","block":"b-3443043e734a4ed0d935","layer":"original","quote":"及先主入蜀，自葭萌还攻刘璋；时封年二十余，有武艺，气力过人，将兵俱与诸葛亮、张飞等溯流西上，所在战克。益州既定，以封为副军中郎将","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":2,"anchor":null},"note_id":null,"start":0,"end":64},{"id":"liuliao-q-6972e29d3070cf1efaa2","section":"chapter-040","block":"b-e0170f6f55ee0c459ef7","layer":"original","quote":"又封与达忿争不和，封寻夺达鼓吹〖8〗。达既惧罪，又忿恚封，遂表辞先主，率所领降魏","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":4,"anchor":null},"note_id":null,"start":55,"end":95},{"id":"liuliao-q-6bfb128dde5e5b38e551","section":"chapter-040","block":"b-1a18c3e79fe09ec29a18","layer":"original","quote":"达与封书曰：","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":6,"anchor":null},"note_id":null,"start":0,"end":6},{"id":"liuliao-q-79ddd8e23b5a267e775e","section":"chapter-040","block":"b-ee57665e94513ca12cf7","layer":"original","quote":"达将进攻上庸〖4〗，先主阴恐达难独任；乃遣封自汉中乘沔水下统达军，与达会上庸。上庸太守申耽举众降，遣妻子及宗族诣成都。先主加耽征北将军，领上庸太守，员乡侯如故。以耽弟仪为建信将军、西城太守〖5〗。迁封为副军将军","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":3,"anchor":null},"note_id":null,"start":31,"end":136},{"id":"liuliao-q-870435406faae38bafd1","section":"chapter-040","block":"b-148ebac729d3f50185cc","layer":"original","quote":"刘封者，本罗侯寇氏之子〖1〗，长沙刘氏之甥也。先主至荆州，以未有继嗣，养封为子。","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":1,"anchor":null},"note_id":null,"start":0,"end":40},{"id":"liuliao-q-8b0dafb9c8557175e4be","section":"chapter-040","block":"b-29640d1514dace64a7cc","layer":"original","quote":"封既至，先主责封之侵陵达，又不救羽；诸葛亮虑封刚猛，易世之后终难制御〖59〗，劝先主因此除之。于是赐封死，使自裁。封叹曰：“恨不用孟子度之言〖60〗！”先主为之流涕","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":12,"anchor":null},"note_id":null,"start":0,"end":82},{"id":"liuliao-q-900dfb187d87f60b2cf8","section":"chapter-040","block":"b-b94650314cb0dae824bf","layer":"original","quote":"今足下与汉中王〖23〗，道路之人耳〖24〗！亲非骨血而据势权，义非君臣而处上位；征则有偏任之威〖25〗，居则有副军之号：远近所闻也。自立阿斗为太子以来〖26〗，有识之人相为寒心。如使申生从子舆之言〖27〗，必为太伯〖28〗；卫伋听其弟之谋，无彰父之讥也〖29〗。且小白出奔〖30〗，入而为霸；重耳逾垣〖31〗，卒以克复〖32〗。自古有之，非独今也。夫智贵免祸，明尚夙达〖33〗。仆揆汉中王虑定于内〖34〗，疑生于外矣；虑定则心固，疑生则心惧；乱祸之兴作，未曾不由废立之间也。私怨人情，不能不现，恐左右必有以间于汉中王矣〖35〗。然则疑成怨闻，其发若践机耳〖36〗。今足下在远，尚可假息一时〖37〗；若大军遂进〖38〗，足下失据而还，窃相为危之！","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":8,"anchor":null},"note_id":null,"start":0,"end":322},{"id":"liuliao-q-d9665bbb91f9df502fd4","section":"chapter-040","block":"b-c6ce1a9ba0d2a56939d4","layer":"original","quote":"评曰：刘封处嫌疑之地，而思防不足以自卫；彭羕、廖立以才拔进；李严以干局达〖1〗；魏延以勇略任；杨仪以当官显；刘琰旧仕〖2〗：并咸贵重。览其举措，迹其规矩〖3〗；招祸取咎，无不自己也〖4〗。","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":355,"anchor":null},"note_id":null,"start":0,"end":94},{"id":"liuliao-q-da55f083868ec2c28f18","section":"chapter-040","block":"b-e0170f6f55ee0c459ef7","layer":"original","quote":"自关羽围樊城、襄阳，连呼封、达，令发兵自助〖7〗。封、达辞以山郡初附，未可动摇，不承羽命。会羽覆败，先主恨之；","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":4,"anchor":null},"note_id":null,"start":0,"end":55},{"id":"liuliao-q-eedf27599aabd0e108ba","section":"chapter-040","block":"b-19b7adef91d9a647d2b1","layer":"original","quote":"行矣〖54〗，今足下勉之！无使狐突闭门不出〖55〗。","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":10,"anchor":null},"note_id":null,"start":0,"end":26},{"id":"mingdi-e-p007a-q","section":"chapter-003","block":"b-5bf81d9dfe407ed70c63","layer":"pei","quote":"达以延康元年率部曲四千余家，归魏。文帝时初即王位，既宿知有达，闻其来，甚悦。令贵臣有识察者往观之，还曰‘将帅之才也’，或曰‘卿相之器也’；王益钦达","attribution":"裴注·魏略","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":52,"anchor":null},"note_id":"n-680a01f5d7c24c678bdc","start":7,"end":80},{"id":"mingdi-q-p008","section":"chapter-003","block":"b-45e87c171e0131afcd00","layer":"pei","quote":"干宝《晋纪》曰：“达初入新城，登白马塞。叹曰：‘刘封、申耽，据金城千里而失之乎！’”","attribution":"裴注·干宝晋纪","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":53,"anchor":null},"note_id":"n-680a01f5d7c24c678bdc","start":0,"end":42},{"id":"rencheng-q-5336e47142b837778ce5","section":"chapter-019","block":"b-3b25314bad4afd3b0d72","layer":"pei","quote":"﹝二﹞《魏略》曰：“太祖在汉中，而刘备栖于山头，使刘封下挑战。太祖骂曰：‘卖履舍儿，长使假子拒汝公乎？待呼我黄须来，令击之！’乃召彰。彰晨夜进道，西到长安；而太祖已还，从汉中而归。彰须黄，故以呼之。”","attribution":"裴注·魏略","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":36,"anchor":null},"note_id":"n-3843ab27452efd271684","start":0,"end":100},{"id":"wendi-e-o010b-q","section":"chapter-002","block":"b-7a2dbfc0b022363adb0c","layer":"original","quote":"蜀将孟达率众降〖8〗。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":67,"anchor":null},"note_id":null,"start":7,"end":18},{"id":"wendi-q-b-ec88012a7f6c352d0e04","section":"chapter-002","block":"b-ec88012a7f6c352d0e04","layer":"modern","quote":"〖1〗二年：黄初二年（公元 221）。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":210,"anchor":null},"note_id":"n-8fff547b113ffa36bbc1","start":0,"end":19},{"id":"wendi-q-o002","section":"chapter-002","block":"b-1c3ea4f0ea338bf2ec5a","layer":"original","quote":"太祖崩，嗣位为丞相，魏王。﹝三﹞尊王后曰王太后〖5〗。改建安二十五年为延康元年。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":2,"anchor":null},"note_id":null,"start":0,"end":40},{"id":"wendi-q-o019","section":"chapter-002","block":"b-8820e5c7f9006d364c44","layer":"original","quote":"二年春正月〖1〗，郊祀天地、明堂〖2〗。甲戌〖3〗，校猎至原陵〖4〗。遣使者，以太牢祠汉世祖〖5〗。乙亥〖6〗，朝日于东郊〖7〗。﹝一﹞初令郡国口满十万者〖8〗，岁察孝廉一人；其有秀异〖9〗，无拘户口。辛巳〖10〗，分三公户邑，封子弟各一人为列侯。壬午〖11〗，复颍川郡一年田租〖12〗。﹝二﹞改许县为许昌县。以魏郡东部为阳平郡〖13〗，西部为广平郡〖14〗。﹝三﹞","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":208,"anchor":null},"note_id":null,"start":0,"end":183},{"id":"xiahoucao-e-o075b-q","section":"chapter-009","block":"b-f83eff2dbdf6ae27ac4e","layer":"original","quote":"尚奏：“刘备别军在上庸，山道险难，彼不我虞〖4〗；若以奇兵潜行，出其不意，则独克之势也！”遂勒诸军击破上庸，平三郡九县，迁征南大将军。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":390,"anchor":null},"note_id":null,"start":35,"end":102},{"id":"xianzhu-e-o049c-q","section":"chapter-032","block":"b-8a052498f4fbd858ba0b","layer":"original","quote":"遣刘封、孟达、李平等攻申耽于上庸〖15〗。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":204,"anchor":null},"note_id":null,"start":83,"end":104},{"id":"xianzhu-q-b-c3e56caa3865de7f7114","section":"chapter-032","block":"b-c3e56caa3865de7f7114","layer":"modern","quote":"〖11〗二十四年：建安二十四年（公元 219）。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":222,"anchor":null},"note_id":"n-fd85f82251e498647de7","start":0,"end":24},{"id":"xianzhu-q-o048","section":"chapter-032","block":"b-2d515ba2dae40f6a248e","layer":"original","quote":"二十四年春〖11〗，自阳平南渡沔水，缘山稍前〖12〗，于定军山（势）作营〖13〗。渊将兵来争其地，先主命黄忠乘高鼓噪攻之。大破渊军，斩渊及曹公所署益州刺史赵颙等。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":203,"anchor":null},"note_id":null,"start":0,"end":81},{"id":"xianzhu-q-o049","section":"chapter-032","block":"b-8a052498f4fbd858ba0b","layer":"original","quote":"曹公自长安举众南征。先主遥策之曰：“曹公虽来，无能为也；我必有汉川矣〖14〗！”及曹公至，先主敛众拒险，终不交锋；积月不拔，亡者日多。夏，曹公果引军还，先主遂有汉中；遣刘封、孟达、李平等攻申耽于上庸〖15〗。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":204,"anchor":null},"note_id":null,"start":0,"end":104}],"profiles":{"xianzhu-p0070":{"fields":[],"directory":{"faction":"shu"}}},"directory_counts":{}}
