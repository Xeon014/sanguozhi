{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhuge-e-o022b","title":"南中叛乱诸葛亮缓兵使聘吴结好","accounts":[{"id":"zhuge-e-o022b-account","label":"《诸葛亮传第五》正文","text":"南中叛乱诸葛亮缓兵使聘吴结好","evidence":["zhuge-e-o022b-q"]},{"id":"houzhu-a-d58c3939fbd0","label":"《后主传》正文","text":"建兴元年夏〖3〗，牂牁太守朱褒拥郡反〖4〗。﹝二﹞先是，益州郡有大姓雍闿反〖5〗，流太守张裔于吴〖6〗，据郡不宾〖7〗；越嶲夷王高定亦背叛〖8〗。","evidence":["houzhu-q-O005"]},{"id":"liuermu-a-ec9e858c83040298e91e","label":"正文","text":"雍闿据益郡反附吴","evidence":["liuermu-q-a9f48e45367138fd4bf2"]},{"id":"huangli-a-db6702341a9225c4d3af","label":"正文","text":"高定恣睢于越嶲","evidence":["huangli-q-3076eb64caa60a3cd72c"]},{"id":"huangli-a-195f7b993a66fa95f547","label":"正文","text":"雍闿跋扈于建宁","evidence":["huangli-q-82cef6099d615e3317fb"]},{"id":"huangli-a-a164604028ecab43300e","label":"正文","text":"朱褒反叛于牂牁","evidence":["huangli-q-d6880fb35d8a8e416986"]},{"id":"huangli-a-0e17878883f8dc4c90ba","label":"正文","text":"雍闿闻刘备薨骄横","evidence":["huangli-q-e1483ff918bac0db8db5"]}],"participants":[{"person":"zhuge-liang","role":"暂缓征讨联吴","evidence":["zhuge-e-o022b-q"]},{"person":"houzhu-p0021","role":"反叛者","evidence":["houzhu-q-O005"]},{"person":"houzhu-p0022","role":"反叛者","evidence":["houzhu-q-O005"]},{"person":"mingdi-p0069","role":"反叛者","evidence":["houzhu-q-O005"]},{"person":"xianzhu-p0094","role":"被流放者","evidence":["houzhu-q-O005"]},{"person":"liu-bei","role":"薨于永安","evidence":["huangli-q-e1483ff918bac0db8db5"]}],"place":null,"time":{"year":223,"label":"建兴元年","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"zhuge-y223","dating_review":{"reviewed":true,"anchor":"zhuge-q-o021","basis":"建兴元年"},"evidence":["zhuge-e-o022b-q","zhuge-q-o021","wendi-q-o038","wendi-q-b-94d58550e3abb558ad13"]},"ordering_evidence":"zhuge-e-o022b-q","source_order":[35,133,"O022b"],"order":6781},{"id":"zhuge-e-o023a","title":"诸葛亮南征秋平南中备军资治戎","accounts":[{"id":"zhuge-e-o023a-account","label":"《诸葛亮传第五》正文","text":"诸葛亮南征秋平南中备军资治戎","evidence":["zhuge-e-o023a-q"]},{"id":"houzhu-a-cd09cc27d7c3","label":"《后主传》正文","text":"三年春三月，丞相亮南征四郡〖2〗，四郡皆平。改益州郡为建宁郡；分建宁、永昌郡为云南郡〖3〗；又分建宁、牂牁为兴古郡〖4〗。","evidence":["houzhu-q-O011"]},{"id":"houzhu-a-4be5073bc57a","label":"《后主传》正文","text":"十二月，亮还成都。","evidence":["houzhu-q-O012"]},{"id":"liuermu-a-4afa64d994032532ec41","label":"正文","text":"诸葛亮平南土","evidence":["liuermu-q-74c22b7e2a9d68bbb6e6"]},{"id":"dongliu-a-46c6b794eff2c6b27fe7","label":"裴注·襄阳记","text":"诸葛亮建兴三年征南中","evidence":["dongliu-q-e2c33f6fff716105c8c6"]},{"id":"dongliu-a-02cc262a250d7ab1640e","label":"裴注·襄阳记","text":"诸葛亮纳策赦孟获服南方","evidence":["dongliu-q-eb0b210fd16e9b4d714b"]},{"id":"huangli-a-702963f01a4ed94939d9","label":"正文","text":"诸葛亮南征先由越嶲","evidence":["huangli-q-6468462c5c9ba31b69b4"]},{"id":"huangli-a-5f4e1fdf9e62c6a816f5","label":"正文","text":"李恢向建宁被围昆泽","evidence":["huangli-q-e3ccf28eaf60b6787884"]},{"id":"huangli-a-9a24d5475d2059342dba","label":"正文","text":"李恢绐南人缓围守","evidence":["huangli-q-b5114bce442112fd9e76"]},{"id":"huangli-a-2c5e60e64ed818ef9a9f","label":"正文","text":"李恢出击大破南人","evidence":["huangli-q-4639de401721810ce6f4"]},{"id":"huangli-a-bab60bf8428c500b5743","label":"正文","text":"诸葛亮南征","evidence":["huangli-q-719f26aa2be89e5fdfc4"]},{"id":"huangli-a-50aacb7fbbc358afda51","label":"正文","text":"雍闿为高定部曲所杀","evidence":["huangli-q-8607804c6bf08d8f9001"]},{"id":"huowang-a-67657a9f3df20234f4e9","label":"正文","text":"向朗留统后事","evidence":["huowang-q-8f424ee850969da203c7"]},{"id":"huowang-a-490314c99ac4e6f8e34b","label":"正文","text":"费诗随亮南行","evidence":["huowang-q-9418f38e1a330c9a23fd"]},{"id":"dengzhang-a-cb17314a87967fd237ca","label":"正文","text":"亮南征留李邵为治中","evidence":["dengzhang-q-d5dbd61162ffdc44a5c9"]},{"id":"dengzhang-a-b5d5860a45d4a1b4cacc","label":"正文","text":"龚禄南征遇害","evidence":["dengzhang-q-b6ceaebbb6880816a85d"]},{"id":"dengzhang-a-dc5c9d9bf11fae034aa4","label":"正文","text":"王士南行遇害","evidence":["dengzhang-q-473b0c9081b5da467bd8"]}],"participants":[{"person":"zhuge-liang","role":"征讨","evidence":["zhuge-e-o023a-q"]},{"pers