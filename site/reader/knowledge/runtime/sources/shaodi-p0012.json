":[18,168,0],"order":3683},{"id":"lizang-e2-wei018-072","title":"太祖讨吕布于濮阳，夜袭其别屯，比明破之","accounts":[{"id":"lizang-a-5881a081341fb6e3909f","label":"正文","text":"太祖讨吕布于濮阳，夜袭其别屯，比明破之","evidence":["lizang-q-bb884336a33be1bf00cf"]},{"id":"lizang-a-3f038fd18ef3952904d1","label":"正文","text":"未及还，布救兵至三面掉战，布身自搏战自旦至日昳相持急","evidence":["lizang-q-bd7366d2281f7836b78b"]},{"id":"lizang-a-75aa5751e8689a07417d","label":"正文","text":"太祖募陷阵，典韦先占，将应募者数十人重铠持长矛撩戟","evidence":["lizang-q-38eebc2421c011f99859"]},{"id":"lizang-a-54b9e0fa089b1a4d3ede","label":"正文","text":"西面急韦进当之，虏至乃持戟大呼起，所抵皆倒，布众退，会日暮太祖乃得引去","evidence":["lizang-q-d8009c7432ac1beb9ec1"]}],"participants":[{"person":"shaodi-p0012","role":"陷阵拒敌","evidence":["lizang-q-38eebc2421c011f99859","lizang-q-d8009c7432ac1beb9ec1"]},{"person":"cao-cao","role":"夜袭吕布别屯，遇援兵战后引去","evidence":["lizang-q-bb884336a33be1bf00cf","lizang-q-bd7366d2281f7836b78b","lizang-q-38eebc2421c011f99859","lizang-q-d8009c7432ac1beb9ec1"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本篇独立行动，未继承范围不同的旧事件日期。","evidence":["lizang-q-bb884336a33be1bf00cf","lizang-q-bd7366d2281f7836b78b","lizang-q-38eebc2421c011f99859","lizang-q-d8009c7432ac1beb9ec1"]},"ordering_evidence":"lizang-q-bb884336a33be1bf00cf","related_events":[{"event":"wudi-e-o031a","type":"related","evidence":["lizang-q-bb884336a33be1bf00cf","lizang-q-bd7366d2281f7836b78b","lizang-q-38eebc2421c011f99859","lizang-q-d8009c7432ac1beb9ec1","wudi-e-o031a-q"]}],"order":3684},{"id":"lizang-e-o170","title":"拜典韦都尉，引置左右，将亲兵数百人常绕大帐","accounts":[{"id":"lizang-a-6f311d00616dc3142e1e","label":"正文","text":"拜典韦都尉，引置左右，将亲兵数百人常绕大帐","evidence":["lizang-q-aad2396f849f2527fbc8"]}],"participants":[{"person":"shaodi-p0012","role":"拜都尉将亲兵数百人","evidence":["lizang-q-aad2396f849f2527fbc8"]},{"person":"cao-cao","role":"引置左右","evidence":["lizang-q-aad2396f849f2527fbc8"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["lizang-q-aad2396f849f2527fbc8"]},"ordering_