{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o050a","title":"张绣降而复反与曹操宛败","accounts":[{"id":"wudi-e-o050a-account","label":"正文","text":"曹操到宛，张绣先降后反，曹操战败受伤，曹昂和曹安民遇害。","evidence":["wudi-e-o050a-q"]},{"id":"wendi-e-p106b-account","label":"裴注·典论自叙","text":"建安之初，时年十一岁，曹丕于张绣反叛时乘马逃脱。","evidence":["wendi-e-p106b-q"]},{"id":"gongsuntao-a-adc839b7d1edc356b77b","label":"正文","text":"太祖南征军淯水绣举众降","evidence":["gongsuntao-q-66d7130f3b50aa50a625"]},{"id":"gongsuntao-a-f3243179641f1928fe90","label":"正文","text":"计漏绣掩袭太祖军败二子没还保穰","evidence":["gongsuntao-q-ff71cd5fd221e28b5c5b"]},{"id":"gongsuntao-a-1512c32cb2a8cc60a519","label":"裴注·吴书","text":"绣用贾诩计乞徙军掩太祖太祖不备故败","evidence":["gongsuntao-q-16c794bc2c6a7efcabdf"]},{"id":"lizang-a-409cc34f89f6e4628887","label":"正文","text":"太祖征荆州至宛，张绣迎降","evidence":["lizang-q-1c5444ff52132f9bc957"]},{"id":"lizang-a-c950118931b6c1d6b252","label":"正文","text":"太祖延绣置酒高会，韦持大斧立后，所至辄举斧目之，竟酒绣莫敢仰视","evidence":["lizang-q-ea34e7392968597c78eb"]},{"id":"lizang-a-6e9347868b92fa2cbfc8","label":"正文","text":"后十余日绣反袭太祖营，太祖出战不利轻骑引去","evidence":["lizang-q-1cbf0e590bade9fba0e3"]},{"id":"lizang-a-01c8df5dae2bd90dfe4b","label":"正文","text":"韦战于门中殊死拒贼，以长戟左右击，被数十创，瞋目大骂而死，贼取其头传观","evidence":["lizang-q-7f3900fa715968a7461e"]}],"participants":[{"person":"cao-cao","role":"战败受伤","evidence":["wudi-e-o050a-q"]},{"person":"wudi-p0131","role":"降而复反","evidence":["wudi-e-o050a-q"]},{"person":"wudi-p0132","role":"遇害","evidence":["wudi-e-o050a-q"]},{"person":"wudi-p0133","role":"遇害","evidence":["wudi-e-o050a-q"]},{"person":"wudi-p0170","role":"逃脱","evidence":["wendi-e-p106b-q"]},{"person":"wudi-p0182","role":"计所出","evidence":["gongsuntao-q-16c794bc2c6a7efcabdf"]},{"person":"shaodi-p0012","role":"持大斧侍卫；拒战而死","evidence":["lizang-q-ea34e7392968597c78eb","lizang-q-7f3900fa715968a7461e"]}],"place":{"text":"宛","evidence":["wudi-e-o050a-q"]},"time":{"label":"建安二年春正月","year":197,"precision":"year","basis":"纪年经本批逐段审定；年份依据