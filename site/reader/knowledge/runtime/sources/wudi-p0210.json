{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o093a","title":"曹操破尹楷沮鹄并受二县降","accounts":[{"id":"wudi-e-o093a-account","label":"正文","text":"曹洪留攻邺，曹操出击尹楷、沮鹄获胜，韩范、梁岐举县投降受封。","evidence":["wudi-e-o093a-q"]}],"participants":[{"person":"wudi-p0075","role":"留攻","evidence":["wudi-e-o093a-q"]},{"person":"cao-cao","role":"出击受降","evidence":["wudi-e-o093a-q"]},{"person":"wudi-p0209","role":"被击败","evidence":["wudi-e-o093a-q"]},{"person":"wudi-p0210","role":"被击败","evidence":["wudi-e-o093a-q"]},{"person":"wudi-p0211","role":"投降","evidence":["wudi-e-o093a-q"]},{"person":"wudi-p0212","role":"投降","evidence":["wudi-e-o093a-q"]}],"place":{"text":"毛城、邯郸、易阳、涉","evidence":["wudi-e-o093a-q"]},"time":{"label":"建安九年夏四月","year":204,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o093a-q","wudi-q-o092","wudi-q-b-6787e3ddd3e334b677d4"],"chronology":"wudi-y204","dating_review":{"anchor":"wudi-q-o092","basis":"建安九年夏四月","reviewed":true}},"source_order":[1,508,"O093a"],"order":219}],"persons":[{"id":"wudi-p0210","name":"沮鹄","evidence":["wudi-q-o093"],"facts":[{"id":"wudi-f-p070-wudi-p0210-1c9d9e","label":"亲属记载","text":"沮授之子","evidence":["wudi-q-p070"]}],"aliases":[],"mentions":[{"id":"wudi-m-o093-wudi-p0210","kind":"mention","text":"文中提及","evidence":["wudi-q-o093"]},{"id":"wudi-m-p070-wudi-p0210","kind":"mention","text":"文中提及","evidence":["wudi-q-p070"]}]}],"evidence":[{"id":"wudi-e-o093a-q","section":"chapter-001","block":"b-b849d99c230efe708c30","layer":"original","quote":"夏四月，留曹洪攻邺；公自将击楷，破之而还。尚将沮鹄守邯郸〖7〗；﹝一﹞又击，拔之。易阳令韩范、涉长梁岐举县降，赐爵关内侯〖8〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":507,"anchor":null},"note_id":null,"start":0,"end":64},{"id":"wudi-q-b-6787e3ddd3e334b677d4","section":"chapter-001","block":"b-6787e3ddd3e334b677d4","layer":"modern","quote":"〖1〗九年：建安九年（公元 204）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":510,"anchor":null},"note_id":"n-c8fff97bafc82c655f3f","start":0,"end":19},{"id":"wudi-q-o092","section":"chapter-001","block":"b-3e549c423b15df48398a","layer":"original","quote":"九年春正月〖1〗，济河，遏淇水入白沟以通粮道〖2〗。二月，尚复攻谭，留苏由、审配守邺〖3〗。公进军到洹水〖4〗，由降；既至，攻邺，为土山、地道。武安长尹楷屯毛城〖5〗，通上党粮道〖6〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":506,"anchor":null},"note_id":null,"start":0,"end":93},{"id":"wudi-q-o093","section":"chapter-001","block":"b-b849d99c230efe708c30","layer":"original","quote":"夏四月，留曹洪攻邺；公自将击楷，破之而还。尚将沮鹄守邯郸〖7〗；﹝一﹞又击，拔之。易阳令韩范、涉长梁岐举县降，赐爵关内侯〖8〗。五月，毁土山、地道；作围堑，决漳水灌城〖9〗。城中饿死者过半。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":507,"anchor":null},"note_id":null,"start":0,"end":95},{"id":"wudi-q-p070","section":"chapter-001","block":"b-8869edfb3c9b7cf5a19f","layer":"pei","quote":"﹝一﹞沮，音菹，河朔间今犹有此姓。鹄，沮授子也。","attribution":"裴松之音释与家世说明","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":529,"anchor":null},"note_id":"n-bdb119d00051944cff7f","start":0,"end":24}],"profiles":{},"directory_counts":{}}
