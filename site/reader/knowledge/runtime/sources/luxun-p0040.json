{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"luxun-e-o049a","title":"谢渊谢厷陈便宜欲兴利改作事下陆议","accounts":[{"id":"luxun-e-o049a-account","label":"《陆逊传第十三》正文","text":"谢渊谢厷陈便宜欲兴利改作事下陆议","evidence":["luxun-e-o049a-q"]}],"participants":[{"person":"luxun-p0039","role":"献策","evidence":["luxun-e-o049a-q"]},{"person":"luxun-p0040","role":"献策","evidence":["luxun-e-o049a-q"]}],"place":null,"time":{"label":"谢渊谢厷陈改作时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["luxun-e-o049a-q"]},"ordering_evidence":"luxun-e-o049a-q","source_order":[58,231,"O049a"],"order":10356},{"id":"panlu-e-o012","title":"谢厷说吕壹惧解散顾雍事","accounts":[{"id":"panlu-a-0815ccfb9dc9491831a8","label":"正文","text":"谢厷说吕壹惧解散顾雍事","evidence":["panlu-q-bef1c618302df19e00ed"]}],"participants":[{"person":"luxun-p0040","role":"黄门侍郎、问壹顾公事何如、问若此公免退谁当代之、曰得无潘太常得之乎、谓曰潘太常常切齿于君今日代顾公恐明日便击君矣","evidence":["panlu-q-bef1c618302df19e00ed"]},{"person":"wuzhu-p0094","role":"答不能佳、良久曰君语近之也、大惧、遂解散雍事","evidence":["panlu-q-bef1c618302df19e00ed"]},{"person":"wuzhu-p0065","role":"被言切齿于壹者","evidence":["panlu-q-bef1c618302df19e00ed"]},{"person":"wuzhu-p0045","role":"其事遂解","evidence":["panlu-q-bef1c618302df19e00ed"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["panlu-q-bef1c618302df19e00ed"]},"ordering_evidence":"panlu-q-bef1c618302df19e00ed","source_order":[61,27,33],"order":10724}],"persons":[{"id":"luxun-p0040","name":"谢厷","evidence":["luxun-q-o049","panlu-q-bef1c618302df19e00ed"],"facts":[],"aliases":[],"mentions":[{"id":"luxun-m-o049-luxun-p0040","kind":"mention","text":"文中提及","evidence":["luxun-q-o049"]},{"id":"luxun-m-p013-luxun-p0040","kind":"mention","text":"文中提及","evidence":["luxun-q-p013"]},{"id":"luxun-m-o050-luxun-p0040","kind":"mention","text":"文中提及","evidence":["luxun-q-o050"]}]}],"evidence":[{"id":"luxun-e-o049a-q","section":"chapter-058","block":"b-f473fbd1691d7907a00b","layer":"original","quote":"时谢渊、谢厷等各陈便宜，欲兴利改作。﹝一﹞以事下逊。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":230,"anchor":null},"note_id":null,"start":0,"end":26},{"id":"luxun-q-o049","section":"chapter-058","block":"b-f473fbd1691d7907a00b","layer":"original","quote":"时谢渊、谢厷等各陈便宜，欲兴利改作。﹝一﹞以事下逊。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":230,"anchor":null},"note_id":null,"start":0,"end":26},{"id":"luxun-q-o050","section":"chapter-058","block":"b-5398f8cec39e33c08ff0","layer":"original","quote":"逊议曰：“国以民为本：强由民力，财由民出。夫民殷国弱〖7〗，民瘠国强者，未之有也。故为国者，得民则治，失之则乱；若不受利，而令尽用立效〖8〗，亦为难也。是以《诗》叹‘宜民宜人〖9〗，受禄于天’。乞垂圣恩，宁济百姓。数年之间，国用少丰，然后更图。”","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":231,"anchor":null},"note_id":null,"start":0,"end":123},{"id":"luxun-q-p013","section":"chapter-058","block":"b-46711f06c34277991a54","layer":"pei","quote":"《吴历》称云：“谢厷才辩，有计术。”","attribution":"《吴历》","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":244,"anchor":null},"note_id":"n-4bb4ccb93c53bcb6a59d","start":0,"end":18},{"id":"panlu-q-bef1c618302df19e00ed","section":"chapter-061","block":"b-55337a59319992546fa6","layer":"original","quote":"黄门侍郎谢厷，语次问壹〖2〗：“顾公事何如？”壹答：“不能佳。”厷又问：“若此公免退，谁当代之？”壹未答厷。厷曰：“得无潘太常得之乎〖3〗？”壹良久曰：“君语近之也。”厷谓曰：“潘太常，常切齿于君，但道远无因耳〖4〗。今日代顾公，恐明日便击君矣〖5〗！”壹大惧，遂解散雍事","section_title":"潘濬陆凯传第十六","source":{"file":"OEBPS/Text/titlepage_0129.xhtml","index":26,"anchor":null},"note_id":null,"start":33,"end":169}],"profiles":{},"directory_counts":{}}
