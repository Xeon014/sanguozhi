{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o176b","title":"曹军夜袭破阳平","accounts":[{"id":"wudi-e-o176b-account","label":"正文","text":"守军因曹军退却而解备，曹操遣军夜袭，大破敌军斩杨任，张卫夜遁，张鲁奔巴中。","evidence":["wudi-e-o176b-q"]},{"id":"xianzhu-e-o045a-account","label":"《先主传》正文","text":"刘备闻曹操平汉中、张鲁走巴西。","evidence":["xianzhu-e-o045a-q"]},{"id":"gongsuntao-a-57f65101b824182cc18b","label":"正文","text":"鲁欲降弟卫不肯率众拒关坚守太祖攻破之","evidence":["gongsuntao-q-6bab1ba78435eeef70cc"]},{"id":"gongsuntao-a-8534c138c46cb90670ab","label":"正文","text":"鲁闻阳平陷圃劝依杜濩朴胡奔南山入巴中","evidence":["gongsuntao-q-bb09dcc2706efd4bbfa0"]},{"id":"gongsuntao-a-eb4b99ce42320de9875e","label":"裴注·魏名臣奏","text":"董昭表言武帝征鲁阳平之险幸而克","evidence":["gongsuntao-q-b3d5c19d61f972ae0ce9"]},{"id":"gongsuntao-a-f4ff8b89230da169b39e","label":"裴注·魏名臣奏","text":"杨暨表言征鲁对兵三日欲还鲁守自坏","evidence":["gongsuntao-q-7fc2c40720129e9ed48e"]},{"id":"gongsuntao-a-7b78046bf6dc265d243a","label":"裴注·世语","text":"野麋突坏卫营高祚等夜会众卫惧遂降","evidence":["gongsuntao-q-2aea4a3865cb2c2daf3c"]}],"participants":[{"person":"cao-cao","role":"遣兵夜袭","evidence":["wudi-e-o176b-q"]},{"person":"wudi-p0346","role":"夜袭","evidence":["wudi-e-o176b-q"]},{"person":"wudi-p0347","role":"被斩","evidence":["wudi-e-o176b-q"]},{"person":"wudi-p0344","role":"逃走","evidence":["wudi-e-o176b-q"]},{"person":"wudi-p0279","role":"出奔","evidence":["wudi-e-o176b-q"]},{"person":"guanzhang-p0036","role":"又曰今以迫往功必轻不如依杜濩赴朴胡相拒然后委质功必多","evidence":["gongsuntao-q-bb09dcc2706efd4bbfa0"]},{"person":"wudi-p0349","role":"被劝所依者","evidence":["gongsuntao-q-bb09dcc2706efd4bbfa0"]},{"person":"wudi-p0348","role":"被劝所赴者","evidence":["gongsuntao-q-bb09dcc2706efd4bbfa0"]},{"person":"wudi-p0122","role":"表曰武皇帝承凉州从事及武都降人之辞说张鲁易攻信以为然、及往临履不如所闻乃叹曰他人商度少如人意","evidence":["gongsuntao-q-b3d5c19d61f972ae0ce9"]},{"person":"wudi-p0027","role":"故大将军、受遣呼山上兵还、前自见乃还白武皇帝","evidence":["gongsuntao-q-b3d5c19d61f972ae0ce9"]},{"person":"shaodi-p0015","role":"将军、同受遣呼山上兵还","evidence":["gongsuntao-q-b3d5c19d61f972ae0ce9"]},{"person":"wudi-p0203","role":"侍中、在兵后语惇褚言官兵已据得贼要屯贼已散走","evidence":["gongsuntao-q-b3d5c19d61f972ae0ce9"]},{"person":"wendi-p0071","role":"侍中、同语惇褚","evidence":["gongsuntao-q-b3d5c19d61f972ae0ce9"]},{"person":"xiahoucao-p0055","role":"表曰武皇帝始征张鲁以十万之众身亲临履指授方略因就民麦以为军粮","evidence":["gongsuntao-q-7fc2c40720129e9ed48e"]}],"place":{"text":"阳平、巴中","evidence":["wudi-e-o176b-q"]},"time":{"label":"建安二十年秋七月","year":215,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o176b-q","wudi-q-o173","wudi-q-b-e0a96bdd9353a663e5ab"],"chronology":"wudi-y215","dating_review":{"anchor":"wudi-q-o173","basis":"建安二十年秋七月","reviewed":true}},"source_order":[1,998,"O176b"],"order":374},{"id":"xiahoucao-e-o045b","title":"曹休谢罪曹叡遣杨暨慰谕","accounts":[{"id":"xiahoucao-e-o045b-account","label":"《诸夏侯曹传第九》正文","text":"曹休谢罪曹叡遣杨暨慰谕","evidence":["xiahoucao-e-o045b-q"]}],"participants":[{"person":"wendi-p0039","role":"谢罪","evidence":["xiahoucao-e-o045b-q"]},{"person":"wendi-p0005","role":"遣慰","evidence":["xiahoucao-e-o045b-q"]},{"person":"xiahoucao-p0055","role":"慰谕","evidence":["xiahoucao-e-o045b-q"]}],"place":null,"time":{"year":228,"label":"太和二年","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xiahoucao-y228","dating_review":{"reviewed":true,"anchor":"xiahoucao-q-o045","basis":"太和二年"},"evidence":["xiahoucao-e-o045b-q","xiahoucao-q-o045","luxun-q-o027","luxun-q-b-537c2ab6aaf33280136b"]},"ordering_evidence":"xiahoucao-e-o045b-q","source_order":[9,193,"O045b"],"order":2224},{"id":"chengguo-e-p175","title":"暨切谏召晔晔责帝泄露军谋","accounts":[{"id":"chengguo-a-10e8933326610cb5cab8","label":"裴注·《傅子》","text":"暨切谏召晔晔责帝泄露军谋","evidence":["chengguo-q-6644da51a53261a3666c"]}],"participants":[{"person":"xiahoucao-p0055","role":"中领军、帝之亲臣、持不可伐蜀之议最坚、每从内出辄过晔、从驾行天渊池切谏、谦谢臣言诚不足采晔可召质也","evidence":["chengguo-q-6644da51a53261a3666c"]},{"person":"wendi-p0071","role":"终不言、后独见责帝伐国大谋也、军事未发不厌其密、陛下显然露之臣恐敌国已闻之","evidence":["chengguo-q-6644da51a53261a3666c"]},{"person":"wendi-p0005","role":"论伐蜀事、曰卿书生焉知兵事、曰晔与吾言蜀可伐、诏召晔至、后独见、谢之","evidence":["chengguo-q-6644da51a53261a3666c"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["chengguo-q-6644da51a53261a3666c"]},"ordering_evidence":"chengguo-q-6644da51a53261a3666c","source_order":[14,364,76],"order":3127},{"id":"chengguo-e-p176","title":"晔责暨计不足采","accounts":[{"id":"chengguo-a-a08d2e8d3d1d9a6d6bf3","label":"裴注·《傅子》","text":"晔责暨计不足采","evidence":["chengguo-q-fc3a26bc74bba0a7a4f3"]}],"participants":[{"person":"wendi-p0071","role":"责暨夫钓者中大鱼则纵而随之须可制而后牵、子诚直臣然计不足采不可不精思","evidence":["chengguo-q-fc3a26bc74bba0a7a4f3"]},{"person":"xiahoucao-p0055","role":"亦谢之","evidence":["chengguo-q-fc3a26bc74bba0a7a4f3"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["chengguo-q-fc3a26bc74bba0a7a4f3"]},"ordering_evidence":"chengguo-q-fc3a26bc74bba0a7a4f3","source_order":[14,364,339],"order":3128},{"id":"mantian-e-o099a","title":"太和末公孙渊以辽东叛帝欲征难其人杨暨举豫","accounts":[{"id":"mantian-a-0ec4f865b368038c595a","label":"正文","text":"太和末公孙渊以辽东叛帝欲征难其人杨暨举豫","evidence":["mantian-q-36924631d680145852e9"]}],"participants":[{"person":"mingdi-p0013","role":"以辽东叛","evidence":["mantian-q-36924631d680145852e9"]},{"person":"wendi-p0005","role":"欲征之而难其人","evidence":["mantian-q-36924631d680145852e9"]},{"person":"xiahoucao-p0055","role":"举豫应选","evidence":["mantian-q-36924631d680145852e9"]},{"person":"mingdi-p0025","role":"以本官督青州诸军假节往讨","evidence":["mantian-q-36924631d680145852e9"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["mantian-q-36924631d680145852e9"]},"ordering_evidence":"mantian-q-36924631d680145852e9","source_order":[26,167,0],"order":5196},{"id":"mantian-e-o100b","title":"杨暨举豫督青州讨公孙渊","accounts":[{"id":"mantian-a-be592958e7a29924de01","label":"正文","text":"会吴遣使与公孙渊相结；帝以贼众、渡海，诏田豫罢军","evidence":["mantian-q-1ff47301887214a98bbb"]}],"participants":[{"person":"xiahoucao-p0055","role":"中领军、举豫应选","evidence":["mantian-q-1ff47301887214a98bbb"]},{"person":"mingdi-p0025","role":"以本官督青州诸军、假节、往讨之","evidence":["mantian-q-1ff47301887214a98bbb"]},{"person":"mingdi-p0013","role":"以辽东叛","evidence":["mantian-q-1ff47301887214a98bbb"]},{"person":"wendi-p0005","role":"欲征之而难其人、乃使豫、会吴贼遣使与渊相结、以贼众多又以渡海、诏豫使罢军","evidence":["mantian-q-1ff47301887214a98bbb"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["mantian-q-1ff47301887214a98bbb"]},"ordering_evidence":"mantian-q-1ff47301887214a98bbb","source_order":[26,167,0],"order":5197}],"persons":[{"id":"xiahoucao-p0055","name":"杨暨","evidence":["xiahoucao-q-o045","mantian-q-36924631d680145852e9","mantian-q-1ff47301887214a98bbb","chengguo-q-6644da51a53261a3666c","chengguo-q-fc3a26bc74bba0a7a4f3","gongsuntao-q-7fc2c40720129e9ed48e"],"facts":[],"aliases":[],"mentions":[{"id":"xiahoucao-m-o045-xiahoucao-p0055","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-o045"]}]}],"evidence":[{"id":"chengguo-q-6644da51a53261a3666c","section":"chapter-014","block":"b-cbe6200530aade931fad","layer":"pei","quote":"中领军杨暨，帝之亲臣，又重晔，持不可伐蜀之议最坚。每从内出，辄过晔，晔讲不可之意。后暨从驾行天渊池，帝论伐蜀事，暨切谏。帝曰：‘卿书生，焉知兵事！’暨谦谢曰：‘臣出自儒生之末，陛下过听，拔臣群萃之中，立之六军之上。臣有微心，不敢不尽言。臣言诚不足采，侍中刘晔，先帝谋臣，常曰蜀不可伐。’帝曰：‘晔与吾言蜀可伐。’暨曰：‘晔可召质也。’诏召晔至，帝问晔，终不言。后独见，晔责帝曰：‘伐国，大谋也。臣得与闻大谋，常恐眯梦漏泄以益臣罪，焉敢向人言之？夫兵，诡道也。军事未发，不厌其密也。陛下显然露之，臣恐敌国已闻之矣。’于是帝谢之","attribution":"裴注·《傅子》","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":363,"anchor":null},"note_id":"n-96f386a1b5bf5c263563","start":76,"end":338},{"id":"chengguo-q-fc3a26bc74bba0a7a4f3","section":"chapter-014","block":"b-cbe6200530aade931fad","layer":"pei","quote":"晔见出，责暨曰：‘夫钓者，中大鱼，则纵而随之，须可制而后牵，则无不得也。人主之威，岂徒大鱼而已。子诚直臣，然计不足采，不可不精思也！’暨亦谢之","attribution":"裴注·《傅子》","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":363,"anchor":null},"note_id":"n-96f386a1b5bf5c263563","start":339,"end":410},{"id":"gongsuntao-q-2aea4a3865cb2c2daf3c","section":"chapter-008","block":"b-4d77a48001960371679e","layer":"pei","quote":"夜有野麋数千突坏卫营，军大惊。夜，高祚等误与卫众遇，祚等多鸣鼓角会众。卫惧，以为大军见掩，遂降","attribution":"裴注·世语","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":309,"anchor":null},"note_id":"n-0c873df6029964ad38a0","start":99,"end":146},{"id":"gongsuntao-q-6bab1ba78435eeef70cc","section":"chapter-008","block":"b-6a1c95ed57c00b446116","layer":"original","quote":"鲁欲举汉中降；其弟卫不肯，率众数万人拒关坚守","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":287,"anchor":null},"note_id":null,"start":27,"end":49},{"id":"gongsuntao-q-7fc2c40720129e9ed48e","section":"chapter-008","block":"b-1954f1577f0c58b22fca","layer":"pei","quote":"又杨暨表曰：“武皇帝始征张鲁，以十万之众，身亲临履，指授方略，因就民麦以为军粮。张卫之守，盖不足言，地险守易；虽有精兵虎将，势不能施。对兵三日，欲抽军还，言：‘作军三十年，一朝持与人，如何？’此计已定，天祚大魏，鲁守自坏，因以定之","attribution":"裴注·魏名臣奏","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":308,"anchor":null},"note_id":"n-0c873df6029964ad38a0","start":0,"end":115},{"id":"gongsuntao-q-b3d5c19d61f972ae0ce9","section":"chapter-008","block":"b-9ba8257c047e00b51042","layer":"pei","quote":"武皇帝，承凉州从事及武都降人之辞，说‘张鲁易攻，阳平城下南北山相远，不可守也’，信以为然。及往临履，不如所闻，乃叹曰：‘他人商度，少如人意！’攻阳平山上诸屯，既不时拔，士卒伤夷者多。武皇帝意沮，便欲拔军，截山而还。遣故大将军夏侯惇、将军许褚，呼山上兵还。会前军未还，夜迷惑；误入贼营，贼便退散。侍中辛毗、刘晔等在兵后，语惇、褚，言：‘官兵已据得贼要屯，贼已散走。’犹不信之，惇前自见，乃还白武皇帝。进兵定之，幸而克获。此近事，吏士所知","attribution":"裴注·魏名臣奏","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":307,"anchor":null},"note_id":"n-0c873df6029964ad38a0","start":16,"end":233},{"id":"gongsuntao-q-bb09dcc2706efd4bbfa0","section":"chapter-008","block":"b-6a1c95ed57c00b446116","layer":"original","quote":"鲁闻阳平已陷，将稽颡〖10〗。圃又曰：“今以迫往〖11〗，功必轻；不如依杜（灌）〔濩〕赴朴胡相拒，然后委质〖12〗，功必多。”于是乃奔南山入巴中","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":287,"anchor":null},"note_id":null,"start":63,"end":135},{"id":"luxun-q-b-537c2ab6aaf33280136b","section":"chapter-058","block":"b-537c2ab6aaf33280136b","layer":"modern","quote":"〖1〗七年：黄武七年（公元 228）。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":139,"anchor":null},"note_id":"n-26a3d21704231c7e2739","start":0,"end":19},{"id":"luxun-q-o027","section":"chapter-058","block":"b-1dfb331a9884eb630d46","layer":"original","quote":"七年〖1〗，权使鄱阳太守（孙）〔周〕鲂，谲魏大司马曹休：休果举众入皖〖2〗。乃召逊，假黄钺〖3〗，为大都督，逆休。﹝一﹞休既觉知，耻见欺诱；自恃兵马精多，遂交战。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":135,"anchor":null},"note_id":null,"start":0,"end":81},{"id":"mantian-q-1ff47301887214a98bbb","section":"chapter-026","block":"b-264d40585d0692193181","layer":"original","quote":"会吴贼遣使与渊相结；帝以贼众多，又以渡海，诏豫使罢军","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":166,"anchor":null},"note_id":null,"start":56,"end":82},{"id":"mantian-q-36924631d680145852e9","section":"chapter-026","block":"b-264d40585d0692193181","layer":"original","quote":"太和末，公孙渊以辽东叛；帝欲征之而难其人〖1〗，中领军杨暨举豫应选。﹝一﹞乃使豫以本官督青州诸军，假节，往讨之","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":166,"anchor":null},"note_id":null,"start":0,"end":55},{"id":"wudi-e-o176b-q","section":"chapter-001","block":"b-889ba56c5491dd0a8600","layer":"original","quote":"贼见大军退，其守备解散。公乃密遣解(、高祚等乘险夜袭。大破之，斩其将杨任。进攻卫，卫等夜遁；鲁溃，奔巴中〖11〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":322,"anchor":null},"note_id":null,"start":47,"end":104},{"id":"wudi-q-b-e0a96bdd9353a663e5ab","section":"chapter-001","block":"b-e0a96bdd9353a663e5ab","layer":"modern","quote":"〖1〗二十年：建安二十年（公元 215 ）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":328,"anchor":null},"note_id":"n-3bb2f11071aab1690790","start":0,"end":22},{"id":"wudi-q-o173","section":"chapter-001","block":"b-fc2c779b81f1c3c13b40","layer":"original","quote":"二十年春正月〖1〗，天子立公中女为皇后〖2〗。省云中、定襄、五原、朔方郡〖3〗，郡置一县领其民；合以为新兴郡〖4〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":319,"anchor":null},"note_id":null,"start":0,"end":58},{"id":"xiahoucao-e-o045b-q","section":"chapter-009","block":"b-772f3a3de27ca1a3e015","layer":"original","quote":"休上书，谢罪；帝遣屯骑校尉杨暨慰谕，礼赐益隆。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":192,"anchor":null},"note_id":null,"start":75,"end":98},{"id":"xiahoucao-q-o045","section":"chapter-009","block":"b-772f3a3de27ca1a3e015","layer":"original","quote":"太和二年，帝为二道征吴，遣司马宣王从汉水下，（督休）〔休督〕诸军向寻阳。贼将伪降〖12〗，休深入；战不利，退还宿石亭。军夜惊，士卒乱，弃甲兵辎重甚多。休上书，谢罪；帝遣屯骑校尉杨暨慰谕，礼赐益隆。休因此痈发背薨〖13〗。谥曰壮侯。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":192,"anchor":null},"note_id":null,"start":0,"end":115},{"id":"xianzhu-e-o045a-q","section":"chapter-032","block":"b-1f07331b166b6f2880a1","layer":"original","quote":"是岁，曹公定汉中，张鲁遁走巴西。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":200,"anchor":null},"note_id":null,"start":0,"end":16}],"profiles":{},"directory_counts":{}}
