{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"rensu-e-o225","title":"令狐邵独谓族子愚性倜傥、不修德而愿大必灭我宗（众人皆谓愚必荣令狐氏），愚闻之心不平","accounts":[{"id":"rensu-a-e922aebf92f822ffbdb0","label":"裴注·魏略","text":"令狐邵独谓族子愚性倜傥、不修德而愿大必灭我宗（众人皆谓愚必荣令狐氏），愚闻之心不平","evidence":["rensu-q-290cba5d2b68d0f51b6b"]},{"id":"rensu-a-eb7c3b44faf916083ae0","label":"裴注·魏略","text":"令狐愚见令狐邵，从容言次微激之曰先时闻大人谓愚为不继、愚今竟云何邪，邵熟视不答","evidence":["rensu-q-80ff7daee8ad71cdbf32"]},{"id":"rensu-a-35df3e201e777d50a8d2","label":"裴注·魏略","text":"令狐邵私谓其妻子曰公治性度犹如故，以吾观之终当败灭，将逮汝曹","evidence":["rensu-q-b9ac1e759b4e03807094"]},{"id":"rensu-a-d9eb3440f82b99552640","label":"裴注·魏略","text":"令狐邵没后十余年间，令狐愚为兖州刺史，果与王凌谋废立，家属诛灭","evidence":["rensu-q-c9ec8d7dad0d8fc74924"]},{"id":"rensu-a-c143968a84220af64f42","label":"裴注·魏略","text":"令狐邵子令狐华时为弘农郡丞，以属疏得不坐","evidence":["rensu-q-eb47a8df9a68937ff9c4"]}],"participants":[{"person":"rensu-p0004","role":"预言者；熟视不答者；私语者","evidence":["rensu-q-290cba5d2b68d0f51b6b","rensu-q-80ff7daee8ad71cdbf32","rensu-q-b9ac1e759b4e03807094"]},{"person":"wgc-p0002","role":"闻而心不平者；激问者；所评之公治；谋废立而家属诛灭者","evidence":["rensu-q-290cba5d2b68d0f51b6b","rensu-q-80ff7daee8ad71cdbf32","rensu-q-b9ac1e759b4e03807094","rensu-q-c9ec8d7dad0d8fc74924"]},{"person":"shaodi-p0004","role":"同谋者","evidence":["rensu-q-c9ec8d7dad0d8fc74924"]},{"person":"rensu-p0003","role":"受牵连而得免者","evidence":["rensu-q-eb47a8df9a68937ff9c4"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["rensu-q-290cba5d2b68d0f51b6b","rensu-q-80ff7daee8ad71cdbf32","rensu-q-b9ac1e759b4e03807094","rensu-q-c9ec8d7dad0d8fc74924","rensu-q-eb47a8df9a68937ff9c4"]},"ordering_evidence":"rensu-q-290cba5d2b68d0f51b6b","source_order":[16,376,240],"order":3471}],"persons":[{"id":"rensu-p0003","name":"令狐华","evidence":["rensu-q-eb47a8df9a68937ff9c4"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[{"id":"rensu-q-290cba5d2b68d0f51b6b","section":"chapter-016","block":"b-bac77b5b1dcca1cb164c","layer":"pei","quote":"始，邵族子愚，为白衣时，常有高志。众人谓愚必荣令狐氏，而邵独以为：‘愚性倜傥，不修德而愿大，必灭我宗！’愚闻邵言，其心不平","attribution":"裴注·魏略","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":375,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5a7a9e505ad84ef4841b","start":240,"end":301,"offset_unit":"unicode_code_point"},{"id":"rensu-q-80ff7daee8ad71cdbf32","section":"chapter-016","block":"b-bac77b5b1dcca1cb164c","layer":"pei","quote":"及邵为虎贲郎将，而愚仕进已多所更历，所在有名称。愚见邵，因从容言次，微激之曰：‘先时闻大人谓愚为不继，愚今竟云何邪？’邵熟视，而不答也","attribution":"裴注·魏略","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":375,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5a7a9e505ad84ef4841b","start":302,"end":369,"offset_unit":"unicode_code_point"},{"id":"rensu-q-b9ac1e759b4e03807094","section":"chapter-016","block":"b-bac77b5b1dcca1cb164c","layer":"pei","quote":"然私谓其妻子曰：‘公治性度犹如故也！以吾观之，终当败灭。但不知我久当坐之不邪？将逮汝曹耳","attribution":"裴注·魏略","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":375,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5a7a9e505ad84ef4841b","start":370,"end":414,"offset_unit":"unicode_code_point"},{"id":"rensu-q-c9ec8d7dad0d8fc74924","section":"chapter-016","block":"b-bac77b5b1dcca1cb164c","layer":"pei","quote":"邵没之后，十余年间，愚为兖州刺史，果与王凌谋废立，家属诛灭","attribution":"裴注·魏略","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":375,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5a7a9e505ad84ef4841b","start":416,"end":445,"offset_unit":"unicode_code_point"},{"id":"rensu-q-eb47a8df9a68937ff9c4","section":"chapter-016","block":"b-bac77b5b1dcca1cb164c","layer":"pei","quote":"邵子华，时为弘农郡丞，以属疏，得不坐","attribution":"裴注·魏略","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":375,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5a7a9e505ad84ef4841b","start":446,"end":464,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
