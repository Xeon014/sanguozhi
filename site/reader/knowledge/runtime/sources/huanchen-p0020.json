chen-q-c5b52f32d56aede8af4c","yuanzhang-q-9fc46c59b6aa1a06e627","cuimao-q-90adbc59417022dc1060","fangji-q-0eecf44cedd32da35c36","fangji-q-42e0bad848cb13468a56"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[{"id":"cuimao-q-689792f4eeff7beadb90","section":"chapter-012","block":"b-717170dd7c6269de9532","layer":"original","quote":"而曜密表勋私解邕事，诏曰：“勋指鹿作马，收付廷尉","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":303,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":87,"end":111,"offset_unit":"unicode_code_point"},{"id":"cuimao-q-6f4b0e27931b7d876593","section":"chapter-012","block":"b-717170dd7c6269de9532","layer":"original","quote":"大军还洛阳，曜有罪，勋奏黜遣","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":303,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":72,"end":86,"offset_unit":"unicode_code_point"},{"id":"cuimao-q-90adbc59417022dc1060","section":"chapter-012","block":"b-717170dd7c6269de9532","layer":"original","quote":"太守孙邕见，出过勋。时营垒未成，但立标埒〖17〗。邕邪行，不从正道，军营令史刘曜欲推之〖18〗；勋以堑垒未成，解止不举","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":303,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":12,"end":71,"offset_unit":"unicode_code_point"},{"id":"fangji-q-0eecf44cedd32da35c36","section":"chapter-029","block":"b-03fdb056126f24c96814","layer":"pei","quote":"济南孙邕，少事之，从至京师","attribution":"裴注·典论","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":150,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-66c2e7fedf68bad14c99","start":209,"end":222,"offset_unit":"unicode_code_point"},{"id":"fangji-q-42e0bad848cb13468a56","section":"chapter-029","block":"b-03fdb056126f24c96814","layer":"pei","quote":"会和平病死，邕因葬之东陶；有书百余卷，药数囊，悉以送之","attribution":"裴注·典论","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":150,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-66c2e7fedf68bad14c99","start":223,"end":250,"offset_unit":"unicode_code_point"},{"id":"huanchen-q-c5b52f32d56aede8af4c","section":"chapter-022","block":"b-5297a3a57834eafd96dc","layer":"original","quote":"使毓自选代〖19〗，曰：“得如卿者，乃可。”毓举常侍郑冲〖20〗，帝曰：“文和，吾自知之；更举吾所未闻者。”乃举阮武、孙邕，帝于是用邕","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":543,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":87,"end":154,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-116769d2cec0f534e518","section":"chapter-011","block":"b-6d1785356eb094c9ba08","layer":"original","quote":"陛下践阼，纂承洪绪；圣敬日跻〖28〗，超越周成。每发德音〖29〗，动咨师傅〖30〗。若继二祖招贤故典，宾礼俊迈〖31〗，以广缉熙〖32〗；济济之化，侔于前代。宁清高恬泊，拟迹前轨；德行卓绝，海内无偶。历观前世玉帛所命〖33〗，申公、枚乘、周党、樊英之俦〖34〗，测其渊源，览其清浊，未有厉俗独行若宁者也！诚宜束帛加壁，备礼征聘；仍授几杖〖35〗，延登东序〖36〗；敷陈坟素〖37〗，坐而论道；上正璇玑〖38〗，协和皇极〖39〗；下阜群生〖40〗，彝伦攸叙〖41〗：必有可观，光益大化。若宁固执匪石〖42〗，守志箕山〖43〗；追迹洪崖〖44〗，参踪巢、许〖45〗：斯亦圣朝同符唐、虞，“优贤扬历”，垂声千载。﹝一﹞虽出处殊途〖46〗，俯仰异体〖47〗，至于兴治美俗，其揆一也〖48〗。","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":458,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":341,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-76de27cc3a9657f336e7","section":"chapter-011","block":"b-7c7ba6e367b1d9ebee88","layer":"original","quote":"于是特具安车蒲轮〖1〗，束帛加璧，聘焉。会宁卒，时年八十四","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":510,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":29,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-7ac388ceff886135beaa","section":"chapter-011","block":"b-faa3745399a3922ed71b","layer":"original","quote":"黄初四年，高祖文皇帝畴咨群公〖14〗，思求俊乂；故司徒华歆，举宁应选。公车特征，振翼遐裔〖15〗，翻然来翔〖16〗。行遇屯厄〖17〗，遭罹疾病，即拜太中大夫。烈祖明皇帝嘉美其德，登为光禄勋。宁疾弥留，未能进道。","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":456,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":105,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-9ccfc913e7b2f88022ec","section":"chapter-011","block":"b-8959b7718d31ce0345c9","layer":"original","quote":"今宁旧疾已瘳，行年八十，志无衰倦。环堵筚门〖18〗，偃息穷巷；饭粥糊口，并日而食〖19〗；吟咏《诗》、《书》，不改其乐。困而能通，遭难必济；经危蹈险，不易其节；金声玉色，久而弥彰。揆其终始〖20〗，殆天所祚〖21〗；当赞大魏，辅亮雍熙〖22〗。衮职有阙〖23〗，群下属望。昔高宗刻像〖24〗，营求贤哲；周文启龟〖25〗，以卜良佐。况宁前朝所表〖26〗，名德已著？而久栖迟，未时引致〖27〗；非所以奉遵明训，继成前志也。","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":457,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":209,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-9fc46c59b6aa1a06e627","section":"chapter-011","block":"b-21547c603887cde78a80","layer":"original","quote":"正始二年，太仆陶丘一、永宁卫尉孟观、侍中孙邕、中书侍郎王基荐宁曰","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":454,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":32,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-ccf34ec361ad9c34c6a4","section":"chapter-011","block":"b-8e42aa43e7ee448b3af5","layer":"original","quote":"臣闻龙凤隐耀〖2〗，应德而臻；明哲潜遁，俟时而动。是以鸑鷟鸣岐〖3〗，周道隆兴；四皓为佐，汉帝用康〖4〗。伏见太中大夫管宁，应二仪之中和〖5〗，总九德之纯懿〖6〗；含章素质〖7〗，冰洁渊清；玄虚澹泊，与道逍遥；娱心黄、老〖8〗，游志六艺；升堂入室，究其阃奥〖9〗；韬古今于胸怀，包道德之机要。中平之际，黄巾陆梁；华夏倾荡，王纲弛顿。遂避时难，乘桴越海；羁旅辽东，三十余年。在乾之姤〖10〗，匿景藏光；嘉遁养浩〖11〗，韬韫儒墨〖12〗；潜化傍流，畅于殊俗〖13〗。","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":455,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":232,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q2-7cf5f97120342f47c0bd","section":"chapter-011","block":"b-21547c603887cde78a80","layer":"original","quote":"正始二年，太仆陶丘一、永宁卫尉孟观、侍中孙邕、中书侍郎王基荐宁曰〖1〗：","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":454,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":36,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
