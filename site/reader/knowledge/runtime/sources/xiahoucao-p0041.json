idence":[{"id":"chengguo-q-c03032cf90197cdde8d0","section":"chapter-014","block":"b-5941eca38f36ffe5a583","layer":"original","quote":"帝悟昭言，即诏尚等“促出”。贼两头并前，官兵一道引去，不时得泄。将军石建、高迁，仅得自免。军出旬日，江水暴长。帝曰：“君论此事，何其审也！正使张、陈当之〖12〗，何以复加？”","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":236,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":87,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o030a-q","section":"chapter-009","block":"b-c437a5d357838e7708fe","layer":"original","quote":"后召还屯宛〖9〗。孙权遣将陈邵据襄阳，诏仁讨之。仁与徐晃攻破邵，遂入襄阳；使将军高迁等，徙汉南附化民于汉北〖10〗。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":136,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":58,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-o030","section":"chapter-009","block":"b-c437a5d357838e7708fe","layer":"original","quote":"后召还屯宛〖9〗。孙权遣将陈邵据襄阳，诏仁讨之。仁与徐晃攻破邵，遂入襄阳；使将军高迁等，徙汉南附化民于汉北〖10〗。文帝遣使，即拜仁大将军〖11〗。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":136,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":74,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
