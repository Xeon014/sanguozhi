{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xiahoucao-e-p006h","title":"史涣卒史静嗣","accounts":[{"id":"xiahoucao-e-p006h-account","label":"《魏书》","text":"史涣卒史静嗣","evidence":["xiahoucao-e-p006h-q"]}],"participants":[{"person":"wudi-p0158","role":"死亡","evidence":["xiahoucao-e-p006h-q"]},{"person":"xiahoucao-p0015","role":"嗣爵","evidence":["xiahoucao-e-p006h-q"]}],"place":null,"time":{"year":209,"label":"建安十四年","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xiahoucao-y209","dating_review":{"reviewed":true,"anchor":"xiahoucao-q-o013","basis":"建安十四年"},"evidence":["xiahoucao-e-p006h-q","xiahoucao-q-o013","xiahoucao-q-b-37d1816580d2541ad353"]},"ordering_evidence":"xiahoucao-e-p006h-q","source_order":[9,41,"P006h"],"order":2132}],"persons":[{"id":"xiahoucao-p0015","name":"史静","evidence":["xiahoucao-q-p006"],"facts":[],"aliases":[],"mentions":[{"id":"xiahoucao-m-p006-xiahoucao-p0015","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-p006"]}]}],"evidence":[{"id":"xiahoucao-e-p006h-q","section":"chapter-009","block":"b-9fbce7d96866baadec11","layer":"pei","quote":"十四年薨。子静嗣。","attribution":"《魏书》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":40,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-d74b1295041866c5f00c","start":378,"end":387,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-b-37d1816580d2541ad353","section":"chapter-009","block":"b-37d1816580d2541ad353","layer":"modern","quote":"〖7〗十四年：建安十四年（公元 209）。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":51,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5497913c514df18982ee","start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-o013","section":"chapter-009","block":"b-5a05419cd84365039812","layer":"original","quote":"十四年〖7〗，以渊为行领军〖8〗。太祖征孙权还，使渊督诸将，击庐江叛者雷绪〖9〗。绪破，又行征西护军〖10〗，督徐晃击太原贼；攻下二十余屯，斩贼帅商曜，屠其城。从征韩遂等，战于渭南。又督朱灵平隃糜、汧氐〖11〗。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":43,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":106,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-p006","section":"chapter-009","block":"b-9fbce7d96866baadec11","layer":"pei","quote":"﹝五﹞《魏书》曰：“韩浩字元嗣。汉末起兵，县近山薮，多寇；浩聚徒众，为县藩卫。太守王匡以为从事，将兵拒董卓于盟津。时浩舅杜阳，为河阴令，卓执之；使招浩，浩不从。袁术闻而壮之，以为骑都尉。夏侯惇闻其名，请与相见；大奇之，使领兵从征伐。时大议损益，浩以为当急田。太祖善之，迁护军。太祖欲讨柳城，领军史涣以为道远深入，非完计也，欲与浩共谏。浩曰：‘今兵势强盛，威加四海，战胜攻取，无不如志；不以此时，遂除天下之患，将为后忧。且公神武，举无遗策；吾与君，为中军主，不宜沮众！’遂从破柳城。改其官为中护军，置长史、司马。从讨张鲁，鲁降。议者以浩智略足以绥边，欲留使都督诸军，镇汉中。太祖曰：‘吾安可以无护军！’乃与俱还。其见亲任如此。及薨，太祖愍惜之。无子，以养子荣嗣。史涣字公刘。少任侠，有雄气。太祖初起，以客从，行中军校尉。从征伐，常监诸将；见亲信，转拜中领军。十四年薨。子静嗣。”","attribution":"《魏书》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":40,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-d74b1295041866c5f00c","start":0,"end":388,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
