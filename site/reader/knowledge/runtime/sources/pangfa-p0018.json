{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"pangfa-e-o013a","title":"郑度献坚壁清野策刘璋不用","accounts":[{"id":"pangfa-e-o013a-account","label":"《庞统法正传第七》正文","text":"郑度建议刘璋迁民焚谷、坚壁待刘备自退；刘备以问法正，法正料刘璋不用，刘璋果黜郑度。","evidence":["pangfa-e-o013a-q"]}],"participants":[{"person":"pangfa-p0018","role":"献策被黜","evidence":["pangfa-e-o013a-q"]},{"person":"wudi-p0253","role":"拒策","evidence":["pangfa-e-o013a-q"]},{"person":"liu-bei","role":"问策","evidence":["pangfa-e-o013a-q"]},{"person":"xianzhu-p0046","role":"答问","evidence":["pangfa-e-o013a-q"]}],"place":null,"time":{"label":"刘备自葭萌南还取璋时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["pangfa-e-o013a-q"]},"ordering_evidence":"pangfa-e-o013a-q","source_order":[37,80,"O013a"],"order":6989}],"persons":[{"id":"pangfa-p0018","name":"郑度","evidence":["pangfa-q-o013"],"facts":[{"id":"pangfa-f0012","label":"籍贯","text":"广汉","evidence":["pangfa-f0012-q"]}],"aliases":[],"mentions":[{"id":"pangfa-m-o013-pangfa-p0018","kind":"mention","text":"文中提及","evidence":["pangfa-q-o013"]},{"id":"pangfa-m-p010-pangfa-p0018","kind":"mention","text":"文中提及","evidence":["pangfa-q-p010"]}]}],"evidence":[{"id":"pangfa-e-o013a-q","section":"chapter-037","block":"b-e27a7ea74927f7d39f0d","layer":"original","quote":"郑度说璋曰：﹝一﹞“左将军悬军袭我〖1〗，兵不满万，士众未附；野谷是资〖2〗，军无辎重。其计莫若尽驱巴西、梓潼民，纳涪水以西〖3〗；其仓廪、野谷，一皆烧除〖4〗；高垒深沟，静以待之。彼至，请战，勿许；久无所资，不过百日，必将自走。走而击之，则必擒耳。”先主闻而恶之，以问正。正曰：“终不能用，无可忧也！”璋果如正言，谓其群下曰：“吾闻拒敌以安民，未闻动民以避敌也。”于是黜度，不用其计。","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":79,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":25,"end":218,"offset_unit":"unicode_code_point"},{"id":"pangfa-f0012-q","section":"chapter-037","block":"b-c6c17453ea40ff63db97","layer":"pei","quote":"度，广汉人，为州从事。","attribution":"《华阳国志》","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":143,"a