di-q-o130","mingdi-q-p024","zhangle-q-o030","guanzhang-q-o027","xiahoucao-q-o014","mantian-q-d6957423fd8f4bb7bf87"],"facts":[],"aliases":[],"mentions":[{"id":"wudi-m-o130-wudi-p0283","kind":"mention","text":"文中提及","evidence":["wudi-q-o130"]},{"id":"wudi-m-o132-wudi-p0283","kind":"mention","text":"文中提及","evidence":["wudi-q-o132"]},{"id":"wudi-m-o135-wudi-p0283","kind":"mention","text":"文中提及","evidence":["wudi-q-o135"]},{"id":"wudi-m-p100-wudi-p0283","kind":"mention","text":"文中提及","evidence":["wudi-q-p100"]},{"id":"mingdi-m-p024-wudi-p0283","kind":"mention","text":"文中提及","evidence":["mingdi-q-p024"]},{"id":"zhangle-m-o030-wudi-p0283","kind":"mention","text":"文中提及","evidence":["zhangle-q-o030"]},{"id":"guanzhang-m-o027-wudi-p0283","kind":"mention","text":"文中提及","evidence":["guanzhang-q-o027"]},{"id":"guanzhang-m-p018-wudi-p0283","kind":"mention","text":"文中提及","evidence":["guanzhang-q-p018"]},{"id":"xiahoucao-m-o014-wudi-p0283","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-o014"]}]}],"evidence":[{"id":"cuimao-q-33453425b6eebf4ac153","section":"chapter-012","block":"b-cd085f0bc2343b371c06","layer":"original","quote":"从西征马超。超破，军还","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":188,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":11,"end":22,"offset_unit":"unicode_code_point"},{"id":"cuimao-q-db2ebd12ac1479f03092","section":"chapter-012","block":"b-ecadc2b94d58e0bc3ac4","layer":"pei","quote":"从破马超等，子伯功为多。曹公常叹曰：‘子伯之计，孤不及也","attribution":"裴注·《吴书》","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":103,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4d3d422b1c33b802fc46","start":363,"end":391,"offset_unit":"unicode_code_point"},{"id":"guanzhang-e-o027b-q","section":"chapter-036","block":"b-a61619bc3d31e8681d13","layer":"original","quote":"超既统众，遂与韩遂合从〖6〗；及杨秋、李堪、成宜等相结，进军至潼关〖7〗。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":112,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":43,"end":80,"offset_unit":"unicode_code_point"},{"id":"guanzhang-q-o027","section":"chapter-036","block":"b-a61619bc3d31e8681d13","layer":"original","quote":"后腾与韩遂不和，求还京畿。于是征为卫尉，以超为偏将军，封都亭侯〖5〗，领腾部曲。﹝一﹞超既统众，遂与韩遂合从〖6〗；及杨秋、李堪、成宜等相结，进军至潼关〖7〗。曹公与遂、超单马会语。超负其多力〖8〗，阴欲突前捉曹公；曹公左右将许褚瞋目盻之〖9〗，超乃不敢动。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":112,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":129,"offset_unit":"unicode_code_point"},{"id":"guanzhang-q-p018","section":"chapter-036","block":"b-107ac81294c6a7f9bb40","layer":"pei","quote":"﹝三﹞《典略》曰：“建安十六年，超与关中诸将侯选、程银、李堪、张横、梁兴、成宜、马玩、杨秋、韩遂等，凡十部，俱反；其众十万，同据河、潼，建列营阵。是岁，曹公西征，与超等战于河、渭之交，超等败走。超至安定，遂奔凉州。诏收灭超家属。超复败于陇上，后奔汉中，张鲁以为都讲祭酒，欲妻之以女。或谏鲁曰：‘有人若此不爱其亲，焉能爱人？’鲁乃止。初，超未反时，其小妇弟种，留三辅；及超败，种先入汉中。正旦，种上寿于超。超捶胸吐血曰：‘阖门百口，一旦同命，今二人相贺邪！’后数从鲁求兵，欲北取凉州；鲁遣往，无利。又鲁将杨（白）〔昂〕等（欲）〔数〕害其能，超遂从武都逃入氐中，转奔往蜀。是岁，建安十九年也。”","attribution":"《典略》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":138,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-7c0270dd171b6d970305","start":0,"end":295,"offset_unit":"unicode_code_point"},{"id":"liusima-q-1c8aa779ac389f7303e7","section":"chapter-015","block":"b-dfd76f5cb0dc84d92f59","layer":"original","quote":"后超反，既从太祖破超于华阴","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":138,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":96,"end":109,"offset_unit":"unicode_code_point"},{"id":"lizang-q-52876f56216b11500e33","section":"chapter-018","block":"b-77cf8e238c8aa2ff298d","layer":"original","quote":"太祖破超于渭南，德随超亡入汉阳，保冀城","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":201,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":193,"end":212,"offset_unit":"unicode_code_point"},{"id":"lizang-q-e521121329ff29a1cea8","section":"chapter-018","block":"b-2791e4960695e3d97a40","layer":"original","quote":"后数日会战，大破超等，褚身斩首级","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":132,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":99,"end":115,"offset_unit":"unicode_code_point"},{"id":"mantian-q-d6957423fd8f4bb7bf87","section":"chapter-026","block":"b-6e6989442ca7108d4603","layer":"original","quote":"又行征羌护军〖8〗，护左将军张郃、冠军将军杨秋，讨山贼郑甘、卢水叛胡〖9〗，皆破平之；关中始定，民得安业","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":283,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":22,"end":74,"offset_unit":"unicode_code_point"},{"id":"mingdi-e-p024a-q","section":"chapter-003","block":"b-93cd3c37ec40bb3fa146","layer":"pei","quote":"建安初，数为将军杨秋使诣太祖，太祖表拜骑都尉。","attribution":"裴注·魏略","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":244,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9ebeadb65240878258aa","start":28,"end":51,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-p024","section":"chapter-003","block":"b-93cd3c37ec40bb3fa146","layer":"pei","quote":"《魏略》以朗与孔桂俱在《佞幸篇》：“桂字叔林，天水人也。建安初，数为将军杨秋使诣太祖，太祖表拜骑都尉。桂性便辟，晓博弈、蹋鞠，故太祖爱之；每在左右，出入随从。桂察太祖意，喜乐之时，因言次曲有所陈，事多见从。数得赏赐，人多馈遗，桂由此侯服玉食。太祖既爱桂，五官将及诸侯亦皆亲之。其后，桂见太祖久不立太子，而有意于临菑侯；因更亲附临菑侯而简于五官将，将甚衔之。及太祖薨，文帝即王位，未及致其罪。黄初元年，随例转拜驸马都尉。而桂私受西域货赂，许为人事；事发，有诏收问，遂杀之。”","attribution":"裴注·魏略","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":244,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9ebeadb65240878258aa","start":0,"end":236,"offset_unit":"unicode_code_point"},{"id":"rensu-q-a18ae77e46bc0262e5cc","section":"chapter-016","block":"b-36d1f8224f3cec24b29a","layer":"original","quote":"韩遂、马超之叛也，弘农、冯翊，多举县邑以应之","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":112,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":220,"end":242,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o130a-q","section":"chapter-001","block":"b-88fa41196c51bffe126a","layer":"original","quote":"是时，关中诸将疑繇欲自袭〖1〗，马超遂与韩遂、杨秋、李堪、成宜等叛〖2〗。遣曹仁讨之，超等屯潼关〖3〗。公敕诸将：“关西兵精悍〖4〗，坚壁勿与战！”","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":64,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":74,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o132b-q","section":"chapter-001","block":"b-e0f9191c7bec5bbb7c81","layer":"original","quote":"公乃与克日会战〖14〗，先以轻兵挑之。战良久，乃纵虎骑夹击〖15〗；大破之，斩成宜、李堪等。遂、超等走凉州〖16〗，杨秋奔安定〖17〗，关中平。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":66,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":165,"end":237,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o135a-q","section":"chapter-001","block":"b-b0e52c40dcdccb94e25f","layer":"original","quote":"冬十月，军自长安北征杨秋，围安定；秋降，复其爵位，使留抚其民人。﹝六﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":69,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":35,"offset_unit":"unicode_code_point"},{"id":"wudi-e-p100a-q","section":"chapter-001","block":"b-e903db0799980cc9b03a","layer":"pei","quote":"﹝六﹞《魏略》曰：“杨秋，黄初中迁讨寇将军，位特进，封临泾侯。以寿终。”","attribution":"《魏略》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":104,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-28561830e6debc7f6323","start":0,"end":36,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-2dc1a34b174874acae8b","section":"chapter-001","block":"b-2dc1a34b174874acae8b","layer":"modern","quote":"〖1〗十六年：建安十六年（公元 211）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":54,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-889c5acff5776ef2f54b","start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o128","section":"chapter-001","block":"b-37e542ccc37d1632e170","layer":"original","quote":"十六年春正月〖1〗，﹝一﹞天子命公世子丕为五官中郎将〖2〗，置官属〖3〗；为丞相副。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":51,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":42,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o130","section":"chapter-001","block":"b-88fa41196c51bffe126a","layer":"original","quote":"是时，关中诸将疑繇欲自袭〖1〗，马超遂与韩遂、杨秋、李堪、成宜等叛〖2〗。遣曹仁讨之，超等屯潼关〖3〗。公敕诸将：“关西兵精悍〖4〗，坚壁勿与战！”","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":64,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":74,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o132","section":"chapter-001","block":"b-e0f9191c7bec5bbb7c81","layer":"original","quote":"九月，进军渡渭。﹝三﹞超等数挑战，又不许；固请割地，求送任子〖10〗。公用贾诩计〖11〗，伪许之。韩遂请与公相见；公与遂父同岁孝廉，又与遂同时侪辈，于是交马语移时。不及军事；但说京都旧故，拊手欢笑〖12〗。既罢，超等问遂：“公何言？”遂曰：“无所言也。”超等疑之。﹝四﹞他日，公又与遂书，多所点窜〖13〗，如遂改定者，超等愈疑遂。公乃与克日会战〖14〗，先以轻兵挑之。战良久，乃纵虎骑夹击〖15〗；大破之，斩成宜、李堪等。遂、超等走凉州〖16〗，杨秋奔安定〖17〗，关中平。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":66,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":237,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o135","section":"chapter-001","block":"b-b0e52c40dcdccb94e25f","layer":"original","quote":"冬十月，军自长安北征杨秋，围安定；秋降，复其爵位，使留抚其民人。﹝六﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":69,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":35,"offset_unit":"unicode_code_point"},{"id":"wudi-q-p100","section":"chapter-001","block":"b-e903db0799980cc9b03a","layer":"pei","quote":"﹝六﹞《魏略》曰：“杨秋，黄初中迁讨寇将军，位特进，封临泾侯。以寿终。”","attribution":"《魏略》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":104,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-28561830e6debc7f6323","start":0,"end":36,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o014a-q","section":"chapter-009","block":"b-4de8ec3f953562853055","layer":"original","quote":"与太祖会安定，降杨秋。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":59,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":11,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-o014","section":"chapter-009","block":"b-4de8ec3f953562853055","layer":"original","quote":"与太祖会安定，降杨秋。十七年〖1〗，太祖乃还邺，以渊行护军将军，督朱灵、路招等，屯长安。击破南山贼刘雄〔鸣〕，降其众。围遂、超余党梁兴于鄠〖2〗，拔之，斩兴，封博昌亭侯。马超围凉州刺史韦康于冀〖3〗，渊救康；未到，康败。去冀二百余里，超来逆战。军不利。汧氐反，渊引军还。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":59,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":135,"offset_unit":"unicode_code_point"},{"id":"zhangle-e-o030e-q","section":"chapter-017","block":"b-3855d855bdd81918b067","layer":"original","quote":"从破马超、韩遂于渭南。围安定，降杨秋。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":102,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":90,"end":109,"offset_unit":"unicode_code_point"},{"id":"zhangle-q-o030","section":"chapter-017","block":"b-3855d855bdd81918b067","layer":"original","quote":"拜郃偏将军，封都亭侯，授以众。从攻邺，拔之。又从击袁谭于勃海，别将军围雍奴，大破之。从讨柳城，与张辽俱为军锋，以功迁平狄将军〖4〗。别征东莱，讨管承；又与张辽讨陈兰、梅成等，破之。从破马超、韩遂于渭南。围安定，降杨秋。与夏侯渊讨鄜贼梁兴及武都氐。又破马超，平宋建。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":102,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":132,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
