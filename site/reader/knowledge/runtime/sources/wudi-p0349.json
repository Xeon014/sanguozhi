{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o176b","title":"曹军夜袭破阳平","accounts":[{"id":"wudi-e-o176b-account","label":"正文","text":"守军因曹军退却而解备，曹操遣军夜袭，大破敌军斩杨任，张卫夜遁，张鲁奔巴中。","evidence":["wudi-e-o176b-q"]},{"id":"xianzhu-e-o045a-account","label":"《先主传》正文","text":"刘备闻曹操平汉中、张鲁走巴西。","evidence":["xianzhu-e-o045a-q"]},{"id":"gongsuntao-a-57f65101b824182cc18b","label":"正文","text":"鲁欲降弟卫不肯率众拒关坚守太祖攻破之","evidence":["gongsuntao-q-6bab1ba78435eeef70cc"]},{"id":"gongsuntao-a-8534c138c46cb90670ab","label":"正文","text":"鲁闻阳平陷圃劝依杜濩朴胡奔南山入巴中","evidence":["gongsuntao-q-bb09dcc2706efd4bbfa0"]},{"id":"gongsuntao-a-eb4b99ce42320de9875e","label":"裴注·魏名臣奏","text":"董昭表言武帝征鲁阳平之险幸而克","evidence":["gongsuntao-q-b3d5c19d61f972ae0ce9"]},{"id":"gongsuntao-a-f4ff8b89230da169b39e","label":"裴注·魏名臣奏","text":"杨暨表言征鲁对兵三日欲还鲁守自坏","evidence":["gongsuntao-q-7fc2c40720129e9ed48e"]},{"id":"gongsuntao-a-7b78046bf6dc265d243a","label":"裴注·世语","text":"野麋突坏卫营高祚等夜会众卫惧遂降","evidence":["gongsuntao-q-2aea4a3865cb2c2daf3c"]}],"participants":[{"person":"cao-cao","role":"遣兵夜袭","evidence":["wudi-e-o176b-q"]},{"person":"wudi-p0346","role":"夜袭","evidence":["wudi-e-o176b-q"]},{"person":"wudi-p0347","role":"被斩","evidence":["wudi-e-o176b-q"]},{"person":"wudi-p0344","role":"逃走","evidence":["wudi-e-o176b-q"]},{"person":"wudi-p0279","role":"出奔","evidence":["wudi-e-o176b-q"]},{"person":"guanzhang-p0036","role":"又曰今以迫往功必轻不如依杜濩赴朴胡相拒然后委质功必多","evidence":["gongsuntao-q-bb09dcc2706efd4bbfa0"]},{"person":"wudi-p0349","role":"被劝所依者","evidence":["gongsuntao-q-bb09dcc2706efd4bbfa0"]},{"person":"wudi-p0348","role":"被劝所赴者","evidence":["gongsuntao-q-bb09dcc2706efd4bbfa0"]},{"person":"wudi-p0122","role":"表曰武皇帝承凉州从事及武都降人之辞说张鲁易攻信以为然、及往临履不如所闻乃叹曰他人商度少如人意","evidence":["gongsuntao-q-b3d5c19d61f972ae0ce9"]},{"person":"wudi-p0027","role":"故大将军、受遣呼山上兵还、前自见乃还白武皇帝","evidence":["gongsuntao-q-b3d5c19d61f972ae0ce9"]},{"person":"shaodi-p0015","role":"将军、同受遣呼山上兵还","evidence":["gongsun