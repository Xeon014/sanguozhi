evidence":["dengzhang-q-3a30aa8c9d82842f8203"]},{"person":"zhuge-liang","role":"为杨颙之死垂泣三日","evidence":["dengzhang-q-3a30aa8c9d82842f8203"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["dengzhang-q-3a30aa8c9d82842f8203"]},"ordering_evidence":"dengzhang-q-3a30aa8c9d82842f8203","source_order":[45,258,290],"order":7946}],"persons":[{"id":"dengzhang-p0038","name":"杨颙","evidence":["dengzhang-q-e20a4fe6b22a680ce2e8","dengzhang-q-cd544388e5e220dc72eb","dengzhang-q-3a30aa8c9d82842f8203","dengzhang-q2-286344a5d3f9db80bd2e","dengzhang-q2-55f1a87b82ff15acc81c"],"facts":[{"id":"dengzhang-f2-eb8a2f22e5d361e70c95","text":"《襄阳记》记杨颙入蜀为巴郡太守、诸葛亮主簿，后为东曹属典选举。","evidence":["dengzhang-q2-286344a5d3f9db80bd2e","dengzhang-q2-55f1a87b82ff15acc81c"]}],"aliases":[],"mentions":[]}],"evidence":[{"id":"dengzhang-q-3a30aa8c9d82842f8203","section":"chapter-045","block":"b-fcbf045ac94a0a206f3b","layer":"pei","quote":"颙死，亮垂泣三日","attribution":"裴注·襄阳记","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":257,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8d683843ae555c62c0ee","start":290,"end":298,"offset_unit":"unicode_code_point"},{"id":"dengzhang-q-cd544388e5e220dc72eb","section":"chapter-045","block":"b-fcbf045ac94a0a206f3b","layer":"pei","quote":"亮尝自校簿书，颙直入谏曰：‘为治有体，上下不可相侵。请为明公以作家譬之：今有人使奴执耕稼，婢典炊爨，鸡主司晨，犬主吠盗，牛负重载，马涉远路；私业无旷，所求皆足；雍容高枕，饮食而已。忽一旦尽欲以身亲其役，不复付任；劳其体力，为此碎务；形疲神困，终无一成。岂其智之不如奴婢鸡狗哉？失为家主之法也！是故古人称，坐而论道谓之王公，作而行之谓之士大夫。故邴吉不问横道死人，而忧牛喘；陈平不肯知钱谷之数，云自有主者：彼诚达于位分之体也。今明公为治，乃躬自校簿书，流汗竟日，不亦劳乎！’亮谢之","attribution":"裴注·襄阳记","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":257,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8d683843ae555c62c0ee","start":40,"end":279,"offset_unit":"unicode_code_point"},{"id":"dengzhang-q-e20a4fe6b22a680ce2e8","section":"chapter-045","block":"b-96d3f55961b19f0ab838","layer":"original","quote":"亮甚惜之，与留府长史、参军张裔、蒋琬书曰：“令史失赖厷，掾属丧杨颙，为朝中损益多矣〖69〗！”","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":179,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":152,"end":199,"offset_unit":"unicode_code_point"},{"id":"dengzhang-q2-286344a5d3f9db80bd2e","section":"chapter-045","block":"b-fcbf045ac94a0a206f3b","layer":"pei","quote":"入蜀，为巴郡大守，丞相诸葛亮主簿。","attribution":"裴注（引书见原文）","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":257,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8d683843ae555c62c0ee","start":23,"end":40,"offset_unit":"unicode_code_point"},{"id":"dengzhang-q2-55f1a87b82ff15acc81c","section":"chapter-045","block":"b-fcbf045ac94a0a206f3b","layer":"pei","quote":"后为东曹属，典选举。","attribution":"裴注（引书见原文）","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":257,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8d683843ae555c62c0ee","start":280,"end":290,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
