{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dongliu-e-o106","title":"南阳士民举兵攻刘祥败亡","accounts":[{"id":"dongliu-a-41f55749538b44e3b4d6","label":"裴注·零陵先贤传","text":"南阳士民举兵攻刘祥败亡","evidence":["dongliu-q-24efc9703ba6702c14e3"]}],"participants":[{"person":"dongliu-p0003","role":"与孙坚同心，南阳士民怨而举兵攻之，与战败亡","evidence":["dongliu-q-24efc9703ba6702c14e3"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["dongliu-q-24efc9703ba6702c14e3"]},"ordering_evidence":"dongliu-q-24efc9703ba6702c14e3","source_order":[39,57,60],"order":7137}],"persons":[{"id":"dongliu-p0003","name":"刘祥","evidence":["dongliu-q-24efc9703ba6702c14e3","dongliu-q2-f10aea1b8f8c199ef787"],"facts":[{"id":"dongliu-f2-3aef6e930fba210a5e93","text":"刘祥为刘巴之父，任江夏太守、荡寇将军。","evidence":["dongliu-q2-f10aea1b8f8c199ef787"]}],"aliases":[],"mentions":[]}],"evidence":[{"id":"dongliu-q-24efc9703ba6702c14e3","section":"chapter-039","block":"b-79d23173cd059594a6bb","layer":"pei","quote":"祥与同心，南阳士民由此怨祥；举兵攻之，与战，败亡","attribution":"裴注·零陵先贤传","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":56,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-2e5c4ea3c83f130fd0a8","start":60,"end":84,"offset_unit":"unicode_code_point"},{"id":"dongliu-q2-f10aea1b8f8c199ef787","section":"chapter-039","block":"b-79d23173cd059594a6bb","layer":"pei","quote":"﹝一﹞《零陵先贤传》曰：“巴祖父曜，苍梧太守。父祥，江夏太守，荡寇将军。时孙坚举兵讨董卓，以南阳太守张咨不给军粮，杀之。祥与同心，南阳士民由此怨祥；举兵攻之，与战，败亡。刘表亦素不善祥，拘巴，欲杀之；数遣祥故所亲信人，密诈谓巴曰：‘刘牧欲相危害，可相随逃之！’如此再三，巴辄不应。具以报表，表乃不杀巴。年十八，郡署户曹史、主记、主簿。刘先（主）欲遣周不疑，就巴学，巴答曰：‘昔游荆北，时涉师门；记问之学，不足纪名；内无杨朱守静之术，外无墨翟务时之风；犹天之南箕，虚而不用。赐书乃欲令贤甥摧鸾凤之艳，游燕雀之宇，将何以启明之哉？愧于‘有若无，实若虚’，何以堪之？’”","attribution":"裴注（引书见原文）","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":56,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-2e5c4ea3c83f130fd0a8","start":0,"end":282,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
