{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"guanzhang-e-o016a","title":"张飞诸葛亮溯江定郡破江州释严颜","accounts":[{"id":"guanzhang-e-o016a-account","label":"《关张马黄赵传第六》正文","text":"张飞诸葛亮溯江定郡破江州释严颜","evidence":["guanzhang-e-o016a-q"]}],"participants":[{"person":"wudi-p0367","role":"征讨释俘","evidence":["guanzhang-e-o016a-q"]},{"person":"zhuge-liang","role":"征讨","evidence":["guanzhang-e-o016a-q"]},{"person":"guanzhang-p0006","role":"被俘获释","evidence":["guanzhang-e-o016a-q"]}],"place":null,"time":{"label":"刘备攻刘璋时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["guanzhang-e-o016a-q"]},"ordering_evidence":"guanzhang-e-o016a-q","source_order":[36,65,"O016a"],"order":6871},{"id":"guanzhang-e-p015a","title":"严颜叹刘备入蜀如放虎自卫","accounts":[{"id":"guanzhang-e-p015a-account","label":"《华阳国志》","text":"严颜叹刘备入蜀如放虎自卫","evidence":["guanzhang-e-p015a-q"]}],"participants":[{"person":"guanzhang-p0006","role":"评论","evidence":["guanzhang-e-p015a-q"]}],"place":null,"time":{"label":"刘备初入蜀","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["guanzhang-e-p015a-q"]},"ordering_evidence":"guanzhang-e-p015a-q","source_order":[36,80,"P015a"],"order":6875}],"persons":[{"id":"guanzhang-p0006","name":"严颜","evidence":["guanzhang-q-o016"],"facts":[],"aliases":[],"mentions":[{"id":"guanzhang-m-o016-guanzhang-p0006","kind":"mention","text":"文中提及","evidence":["guanzhang-q-o016"]},{"id":"guanzhang-m-p015-guanzhang-p0006","kind":"mention","text":"文中提及","evidence":["guanzhang-q-p015"]},{"id":"guanzhang-m-o048-guanzhang-p0006","kind":"mention","text":"文中提及","evidence":["guanzhang-q-o048"]}]}],"evidence":[{"id":"guanzhang-e-o016a-q","section":"chapter-036","block":"b-d1ccc642b9a84445e667","layer":"original","quote":"先主入益州，还攻刘璋；飞与诸葛亮等溯流而上，分定郡县。至江州，破璋将巴郡太守严颜〖4〗。生获颜，飞呵颜曰：“大军至，何以不降而敢拒战？”颜答曰：“卿等无状〖5〗，侵夺我州；我州但有断头将军，无有降将军也！”飞怒，令左右牵去斫头〖6〗；颜色不变，曰：“斫头便斫头，何为怒邪！”飞壮而释之，引为宾客。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":64,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":148,"offset_unit":"unicode_code_point"},{"id":"guanzhang-e-p015a-q","section":"chapter-036","block":"b-5ef1e153242f50cca7e3","layer":"pei","quote":"﹝一﹞《华阳国志》曰：“初，先主入蜀，至巴郡。颜拊心叹曰：‘此所谓独坐穷山，放虎自卫也！’”","attribution":"《华阳国志》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":79,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-10b30151f443b73fee43","start":0,"end":46,"offset_unit":"unicode_code_point"},{"id":"guanzhang-q-o016","section":"chapter-036","block":"b-d1ccc642b9a84445e667","layer":"original","quote":"先主入益州，还攻刘璋；飞与诸葛亮等溯流而上，分定郡县。至江州，破璋将巴郡太守严颜〖4〗。生获颜，飞呵颜曰：“大军至，何以不降而敢拒战？”颜答曰：“卿等无状〖5〗，侵夺我州；我州但有断头将军，无有降将军也！”飞怒，令左右牵去斫头〖6〗；颜色不变，曰：“斫头便斫头，何为怒邪！”飞壮而释之，引为宾客。﹝一﹞飞所过战克，与先主会于成都。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":64,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":165,"offset_unit":"unicode_code_point"},{"id":"guanzhang-q-o048","section":"chapter-036","block":"b-ed718ddcba8b8e3b3282","layer":"original","quote":"评曰：关羽、张飞，皆称“万人之敌”，为世虎臣。羽报效曹公，飞义释严颜：并有国士之风。然羽刚而自矜，飞暴而无恩；以短取败，理数之常也。马超阻戎负勇〖1〗，以覆其族。惜哉！能因穷致泰〖2〗，不犹愈乎〖3〗！黄忠、赵云，强鸷壮猛〖4〗，并作爪牙：其灌、滕之徒欤〖5〗？","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":215,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":131,"offset_unit":"unicode_code_point"},{"id":"guanzhang-q-p015","section":"chapter-036","block":"b-5ef1e153242f50cca7e3","layer":"pei","quote":"﹝一﹞《华阳国志》曰：“初，先主入蜀，至巴郡。颜拊心叹曰：‘此所谓独坐穷山，放虎自卫也！’”","attribution":"《华阳国志》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":79,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-10b30151f443b73fee43","start":0,"end":46,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
