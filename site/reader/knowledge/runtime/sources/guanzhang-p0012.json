dence":["dengzhang-q-f0e6b83cf6842484b4ae","dengzhang-q2-1bb45648135f74b59125"]}]}],"evidence":[{"id":"dengzhang-q-f0e6b83cf6842484b4ae","section":"chapter-045","block":"b-7b31a0c081e71b2bb3d5","layer":"original","quote":"廖化过预〖8〗，欲与预共诣瞻许。预曰：“吾等年逾七十，所窃已过〖9〗，但少一死耳；何求于年少辈，而屑屑造门邪〖10〗？”遂不往","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":78,"anchor":null},"note_id":null,"start":12,"end":75},{"id":"dengzhang-q2-1bb45648135f74b59125","section":"chapter-045","block":"b-7b31a0c081e71b2bb3d5","layer":"original","quote":"时都护诸葛瞻，初统朝事；廖化过预〖8〗，欲与预共诣瞻许。预曰：“吾等年逾七十，所窃已过〖9〗，但少一死耳；何求于年少辈，而屑屑造门邪〖10〗？”遂不往。","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":78,"anchor":null},"note_id":null,"start":0,"end":76},{"id":"duzhou-q-ebb0099964c927cd1134","section":"chapter-042","block":"b-8a67d616dc335860e00f","layer":"original","quote":"景耀六年冬，魏大将（军）邓艾克江由，长驱而前。而蜀本谓敌不便至〖3〗，不作城守调度；及闻艾已入（阴）平〖4〗，百姓扰扰，皆进山野，不可禁制","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":297,"anchor":null},"note_id":null,"start":0,"end":69},{"id":"guanzhang-e-o024b-q","section":"chapter-036","block":"b-da7855fd72a6672939f6","layer":"original","quote":"苞子遵为尚书，随诸葛瞻于绵竹；与邓艾战，死。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":85,"anchor":null},"note_id":null,"start":22,"end":44},{"id":"guanzhang-q-o024","section":"chapter-036","block":"b-da7855fd72a6672939f6","layer":"original","quote":"长子苞，早夭。次子绍嗣，官至侍中、尚书仆射。苞子遵为尚书，随诸葛瞻于绵竹；与邓艾战，死。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":85,"anchor":null},"note_id":null,"start":0,"end":44},{"id":"houzhu-q-O077","section":"chapter-033","block":"b-083c24beaf11955596f3","layer":"original","quote":"冬，邓艾破卫将军诸葛瞻于绵竹。用光禄大夫谯周策〖8〗，降于艾。奉书曰：“限分江、汉〖9〗，遇值深远〖10〗，阶缘蜀土〖11〗，斗绝一隅〖12〗；干运犯冒〖13〗，渐苒历载〖14〗，遂与京畿攸隔万里〖15〗。每惟黄初中〖16〗，文皇帝命虎牙将军鲜于辅〖17〗，宣温密之诏〖18〗，申三好之恩〖19〗；开示门户〖20〗，大义炳然。而否德暗弱〖21〗，窃贪遗绪〖22〗；俯仰累纪〖23〗，未率大教〖24〗。天威既震〖25〗，人鬼归能（之数）〖26〗，怖骇王师；神武所次〖27〗，敢不革面〖28〗，顺以从命！辄敕群帅投戈释甲，官府帑藏一无所毁〖29〗。百姓布野，余粮栖亩〖30〗；以俟后来之惠〖31〗，全元元之命〖32〗。伏惟大魏，布德施化；宰辅伊、周〖33〗，含覆藏疾〖34〗。谨遣私署侍中张绍、光禄大夫谯周、驸马都尉邓良〖35〗，奉赍印绶〖36〗，请命告诚，敬输忠款；存亡敕赐，惟所裁之〖37〗。舆榇在近〖38〗，不复缕陈〖39〗。”","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":153,"anchor":null},"note_id":null,"start":0,"end":415},{"id":"huangli-q-008c50ce62f462a5ce4d","section":"chapter-043","block":"b-06a51967d1668bb5b546","layer":"original","quote":"瞻盘桓未进〖1〗，崇屡劝瞻“宜速行据险，无令敌得入平（地）”。瞻犹豫未纳，崇至于流涕","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":52,"anchor":null},"note_id":null,"start":26,"end":68},{"id":"huangli-q-01c5afceb9b0607b4686","section":"chapter-043","block":"b-417ead1270fb5c2f3823","layer":"original","quote":"会艾长驱而前，瞻却战至绵竹","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":53,"anchor":null},"note_id":null,"start":0,"end":13},{"id":"huangli-q-3a910cb638d63807dce2","section":"chapter-043","block":"b-06a51967d1668bb5b546","layer":"original","quote":"随卫将军诸葛瞻拒邓艾，到涪县","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":52,"anchor":null},"note_id":null,"start":11,"end":25},{"id":"huangli-q-5ad791f1aa4aa25b0b4d","section":"chapter-043","block":"b-ffc116c405cea888a171","layer":"original","quote":"嶷与书曰：“东主初崩〖6〗，帝实幼弱〖7〗；太傅受寄托之重，亦何容易！亲以周公之才，犹有管、蔡流言之变；霍光受任，亦有燕、盖、上官逆乱之谋〖8〗：赖成、昭之明〖9〗，以免斯难耳。昔每闻东主杀生赏罚，不任下人；又今以垂没之命，猝召太傅，属以后事：诚实可虑。加吴、楚剽急〖10〗，乃昔所记；而太傅离少主，履敌庭，恐非良计长算之术也。虽云东家纲纪肃然，上下辑睦〖11〗；百有一失，非明者之虑邪？取古则今，今则古也。自非郎君进忠言于太傅〖12〗，谁复有尽言者也？旋军广农〖13〗，务行德惠；数年之中，东西并举，实为不晚：愿深采察","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":246,"anchor":null},"note_id":null,"start":41,"end":301},{"id":"huangli-q-88668c4110c7053cccf0","section":"chapter-043","block":"b-417ead1270fb5c2f3823","layer":"original","quote":"崇帅厉军士，期于必死，临阵见杀","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":53,"anchor":null},"note_id":null,"start":14,"end":29},{"id":"huangli-q-88a275deef402a0641ef","section":"chapter-043","block":"b-0dc5c04328f7048c3197","layer":"original","quote":"随诸葛瞻拒邓艾，临阵授命，死于绵竹","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":62,"anchor":null},"note_id":null,"start":19,"end":36},{"id":"huangli-q2-807acbcd1b67a6414c96","section":"chapter-043","block":"b-ffc116c405cea888a171","layer":"original","quote":"吴太傅诸葛恪以初破魏军，大兴兵众以图攻取。侍中诸葛瞻，丞相亮之子，恪从弟也〖5〗。嶷与书曰：“东主初崩〖6〗，帝实幼弱〖7〗；太傅受寄托之重，亦何容易！亲以周公之才，犹有管、蔡流言之变；霍光受任，亦有燕、盖、上官逆乱之谋〖8〗：赖成、昭之明〖9〗，以免斯难耳。昔每闻东主杀生赏罚，不任下人；又今以垂没之命，猝召太傅，属以后事：诚实可虑。加吴、楚剽急〖10〗，乃昔所记；而太傅离少主，履敌庭，恐非良计长算之术也。虽云东家纲纪肃然，上下辑睦〖11〗；百有一失，非明者之虑邪？取古则今，今则古也。自非郎君进忠言于太傅〖12〗，谁复有尽言者也？旋军广农〖13〗，务行德惠；数年之中，东西并举，实为不晚：愿深采察！”恪竟以此夷族〖14〗。嶷识见多如是类。","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":246,"anchor":null},"note_id":null,"start":0,"end":322},{"id":"jfj-q0068","section":"chapter-044","block":"b-44bc679849801b06bb71","layer":"original","quote":"子斌嗣。为绥武将军、汉城护军〖1〗。魏大将（军）钟会至汉城，与斌书曰：“巴蜀贤智文武之士，多矣！至于足下、诸葛思远〖2〗，譬诸草木，吾气类也〖3〗。桑梓之敬〖4〗，古今所敦〖5〗。西到，欲奉瞻尊大君公侯墓〖6〗；当洒扫坟茔，奉祠致敬：愿告其所在。”","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":83,"anchor":null},"note_id":null,"start":0,"end":124},{"id":"jfj-q0194","section":"chapter-044","block":"b-9de65e02e159a5ef52b1","layer":"original","quote":"维不答书，列营守险。会不能克，粮运悬远，将议还归。而邓艾自阴平由景谷道傍入，遂破诸葛瞻于绵竹；后主请降于艾，艾前据成都。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":232,"anchor":null},"note_id":null,"start":0,"end":60},{"id":"jfj-q0195","section":"chapter-044","block":"b-9de65e02e159a5ef52b1","layer":"original","quote":"而邓艾自阴平由景谷道傍入，遂破诸葛瞻于绵竹；","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":232,"anchor":null},"note_id":null,"start":25,"end":47},{"id":"jfj-q0249","section":"chapter-044","block":"b-ef7b2aeb716f95d8fb05","layer":"pei","quote":"臣松之以为：盛之讥维，又为不当。于时钟会大众既造剑阁，维与诸将列营守险，会不得进，已议还计；全蜀之功，几乎立矣。但邓艾诡道傍入，出于其后；诸葛瞻既败，成都自溃。维若回军救内，则会乘其背；当时之势，焉得两济？而责维不能奋节绵竹，拥卫蜀主，非其理也。会欲尽坑魏将，以举大事，授维重兵，使为前驱。若令魏将皆死，兵事在维手；杀会复蜀，不为难矣。夫功成理外，然后为奇；不可以事有差（牙）〔互〕，而抑谓不然。设使田单之计，邂逅不会，复可谓之愚暗哉？","attribution":"裴松之按","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":262,"anchor":null},"note_id":"n-24e37758cf4fa9a9b5f8","start":0,"end":218},{"id":"wgc-q0049","section":"chapter-028","block":"b-f79d34065989623ef2a7","layer":"original","quote":"蜀卫将军诸葛瞻自涪还绵竹〖18〗，列陈待艾。艾遣子惠唐亭侯忠等出其右〖19〗，司马师纂等出其左。忠、纂战不利，并退还，曰：“贼未可击。”艾怒曰：“存亡之分，在此一举；何不可之有！”乃叱忠、纂等，将斩之。忠、纂驰还更战，大破之；斩瞻及尚书张遵等首，进军到雒〖20〗。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":325,"anchor":null},"note_id":null,"start":0,"end":132},{"id":"wgc-q0077","section":"chapter-028","block":"b-a20ce9841d0949b327ba","layer":"original","quote":"艾遂至绵竹，大战，斩诸葛瞻。维等闻瞻已破，率其众东入于巴〖3〗。会乃进军至涪，遣胡烈、田续、庞会等追维〖4〗。艾进军向成都；刘禅诣艾降，遣使敕维等令降于会。维至广汉郪县〖5〗，令兵悉放器仗，送节、传于胡烈〖6〗，便从东道诣会降。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":531,"anchor":null},"note_id":null,"start":0,"end":114},{"id":"wgc-q0382","section":"chapter-028","block":"b-f79d34065989623ef2a7","layer":"original","quote":"蜀卫将军诸葛瞻自涪还绵竹〖18〗，列陈待艾","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":325,"anchor":null},"note_id":null,"start":0,"end":21},{"id":"wgc-q0384","section":"chapter-028","block":"b-f79d34065989623ef2a7","layer":"original","quote":"艾怒曰：“存亡之分，在此一举；何不可之有！”乃叱忠、纂等，将斩之。忠、纂驰还更战，大破之；斩瞻及尚书张遵等首，进军到雒","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":325,"anchor":null},"note_id":null,"start":68,"end":127},{"id":"wgc-q0470","section":"chapter-028","block":"b-a20ce9841d0949b327ba","layer":"original","quote":"艾遂至绵竹，大战，斩诸葛瞻","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":531,"anchor":null},"note_id":null,"start":0,"end":13},{"id":"zhuge-e-o083b-q","section":"chapter-035","block":"b-d2cf53b949d570d9fc6d","layer":"original","quote":"年十七，尚公主〖10〗，拜骑都尉。其明年，为羽林中郎将〖11〗，屡迁射声校尉、侍中、尚书仆射〖12〗，加军师将军〖13〗。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":406,"anchor":null},"note_id":null,"start":53,"end":114},{"id":"zhuge-e-o085a-q","section":"chapter-035","block":"b-e5ed1b1c3d244f688cfe","layer":"original","quote":"景耀四年，为行都护、卫将军〖16〗，与辅国大将军、南乡侯董厥，并平尚书事〖17〗。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":408,"anchor":null},"note_id":null,"start":0,"end":41},{"id":"zhuge-e-o086a-q","section":"chapter-035","block":"b-9fe4ebfa42a59d8d7bb9","layer":"original","quote":"六年冬〖18〗，魏征西将军邓艾伐蜀，自阴平由景谷道旁入〖19〗。瞻督诸军至涪停住；前锋破，退还，住绵竹。艾遣书诱瞻曰：“若降者，必表为琅邪王〖20〗。”瞻怒，斩艾使。遂战，大败；临阵死，时年三十七。众皆离散，艾长驱至成都。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":409,"anchor":null},"note_id":null,"start":0,"end":111},{"id":"zhuge-e-p054a-q","section":"chapter-035","block":"b-c757579021f8983017ea","layer":"pei","quote":"瞻、厥等以维好战无功，国内疲弊；宜表后主，召还为益州刺史，夺其兵权。蜀长老犹有瞻表‘以阎宇代维’故事。","attribution":"孙盛《异同记》","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":453,"anchor":null},"note_id":"n-728adfc2b17d8d199f48","start":13,"end":64},{"id":"zhuge-f0011-q","section":"chapter-035","block":"b-d2cf53b949d570d9fc6d","layer":"original","quote":"瞻字思远","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":406,"anchor":null},"note_id":null,"start":0,"end":4},{"id":"zhuge-f0016-q","section":"chapter-035","block":"b-2065c191ed1475a45d72","layer":"original","quote":"亮子瞻，嗣爵","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":266,"anchor":null},"note_id":null,"start":11,"end":17},{"id":"zhuge-q-b-3a665f982f59f4321b04","section":"chapter-035","block":"b-3a665f982f59f4321b04","layer":"modern","quote":"〖18〗六年：景耀六年（公元 263）。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":429,"anchor":null},"note_id":"n-5c4c42970dd122437e5b","start":0,"end":20},{"id":"zhuge-q-o047","section":"chapter-035","block":"b-2065c191ed1475a45d72","layer":"original","quote":"亮弟均，官至长水校尉。亮子瞻，嗣爵。﹝八﹞","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":266,"anchor":null},"note_id":null,"start":0,"end":21},{"id":"zhuge-q-o083","section":"chapter-035","block":"b-d2cf53b949d570d9fc6d","layer":"original","quote":"瞻字思远。建兴十二年，亮出武功，与兄瑾书曰：“瞻今已八岁，聪慧可爱；嫌其早成〖8〗，恐不为重器耳〖9〗。”年十七，尚公主〖10〗，拜骑都尉。其明年，为羽林中郎将〖11〗，屡迁射声校尉、侍中、尚书仆射〖12〗，加军师将军〖13〗。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":406,"anchor":null},"note_id":null,"start":0,"end":114},{"id":"zhuge-q-o084","section":"chapter-035","block":"b-0cbd6cac8eff4fab3388","layer":"original","quote":"瞻工书画，强识念〖14〗；蜀人追思亮，咸爱其才敏。每朝廷有一善政佳事，虽非瞻所建倡，百姓皆传相告曰：“葛侯之所为也〖15〗。”是以美声溢誉，有过其实。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":407,"anchor":null},"note_id":null,"start":0,"end":75},{"id":"zhuge-q-o085","section":"chapter-035","block":"b-e5ed1b1c3d244f688cfe","layer":"original","quote":"景耀四年，为行都护、卫将军〖16〗，与辅国大将军、南乡侯董厥，并平尚书事〖17〗。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":408,"anchor":null},"note_id":null,"start":0,"end":41},{"id":"zhuge-q-o086","section":"chapter-035","block":"b-9fe4ebfa42a59d8d7bb9","layer":"original","quote":"六年冬〖18〗，魏征西将军邓艾伐蜀，自阴平由景谷道旁入〖19〗。瞻督诸军至涪停住；前锋破，退还，住绵竹。艾遣书诱瞻曰：“若降者，必表为琅邪王〖20〗。”瞻怒，斩艾使。遂战，大败；临阵死，时年三十七。众皆离散，艾长驱至成都。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":409,"anchor":null},"note_id":null,"start":0,"end":111},{"id":"zhuge-q-o089","section":"chapter-035","block":"b-8ad10299db2621d1c503","layer":"original","quote":"自瞻、厥、建统事，姜维常征伐在外，宦人黄皓窃弄机柄；咸共将护〖8〗，无能匡矫，﹝二﹞然建特不与皓和好往来。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":438,"anchor":null},"note_id":null,"start":0,"end":53},{"id":"zhuge-q-p052","section":"chapter-035","block":"b-303a491be10b09862ae5","layer":"pei","quote":"﹝三﹞按《诸葛氏谱》云：“京字行宗。”《晋泰始起居注》载诏曰：“诸葛亮在蜀，尽其心力；其子瞻，临难而死义。天下之善一也，其孙京，随才署吏。”后为郿令。尚书仆射山涛《启事》曰：“郿令诸葛京：祖父亮，遇汉乱分隔，父子在蜀；虽不达天命，要为尽心所事。京治郿，自复有称；臣以为宜以补东宫舍人，以明事人之理，副梁、益之论。”京位至江州刺史。","attribution":"《晋泰始起居注》及山涛《启事》","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":436,"anchor":null},"note_id":"n-2b19446d410da5a67516","start":0,"end":165},{"id":"zhuge-q-p054","section":"chapter-035","block":"b-c757579021f8983017ea","layer":"pei","quote":"﹝二﹞孙盛《异同记》曰：“瞻、厥等以维好战无功，国内疲弊；宜表后主，召还为益州刺史，夺其兵权。蜀长老犹有瞻表‘以阎宇代维’故事。晋永和三年，蜀史常璩说蜀长老云：‘陈寿尝为瞻吏，为瞻所辱；故因此事归恶黄皓，而云瞻不能匡矫也。’”","attribution":"孙盛《异同记》","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":453,"anchor":null},"note_id":"n-728adfc2b17d8d199f48","start":0,"end":113}],"profiles":{},"directory_counts":{}}
