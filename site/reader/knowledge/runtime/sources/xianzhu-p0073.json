{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-o049c","title":"刘封孟达李平攻上庸","accounts":[{"id":"xianzhu-e-o049c-account","label":"《先主传》正文","text":"刘备遣刘封、孟达、李平进攻上庸申耽。","evidence":["xianzhu-e-o049c-q"]},{"id":"liuliao-a-d08eac14319c829753ed","label":"正文","text":"封统达军会上庸申耽举众降","evidence":["liuliao-q-79ddd8e23b5a267e775e"]}],"participants":[{"person":"liu-bei","role":"遣将","evidence":["xianzhu-e-o049c-q"]},{"person":"xianzhu-p0070","role":"进攻","evidence":["xianzhu-e-o049c-q"]},{"person":"xianzhu-p0071","role":"进攻","evidence":["xianzhu-e-o049c-q"]},{"person":"xianzhu-p0072","role":"进攻","evidence":["xianzhu-e-o049c-q"]},{"person":"xianzhu-p0073","role":"受攻","evidence":["xianzhu-e-o049c-q"]},{"person":"mingdi-p0064","role":"任建信将军西城太守","evidence":["liuliao-q-79ddd8e23b5a267e775e"]}],"place":{"text":"上庸","evidence":["xianzhu-e-o049c-q"]},"time":{"year":219,"label":"建安二十四年夏","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xianzhu-y219","dating_review":{"reviewed":true,"anchor":"xianzhu-q-o048","basis":"建安二十四年夏"},"evidence":["xianzhu-e-o049c-q","xianzhu-q-o048","xianzhu-q-b-c3e56caa3865de7f7114"]},"source_order":[32,205,"O049c"],"order":6579},{"id":"liuliao-e-o010","title":"申仪叛封封破走还成都申耽降魏","accounts":[{"id":"liuliao-a-52c4db31fe43c697c7fc","label":"正文","text":"申仪叛封封破走还成都申耽降魏","evidence":["liuliao-q-22512f040a2aea93d481"]}],"participants":[{"person":"xianzhu-p0070","role":"不从达言、破走还成都","evidence":["liuliao-q-22512f040a2aea93d481"]},{"person":"mingdi-p0064","role":"叛封、魏兴太守封郧乡侯屯洵口","evidence":["liuliao-q-22512f040a2aea93d481"]},{"person":"xianzhu-p0073","role":"降魏、魏假耽怀集将军徙居南阳","evidence":["liuliao-q-22512f040a2aea93d481"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liuliao-q-22512f040a2aea93d481"]},"ordering_evidence":"liuliao-q-22512f040a2aea93d481","source_order":[40,12,0],"order":7247},{"id":"liuliao-e-o068","title":"魏略记申耽聚众通张鲁受曹公将军上庸都尉","accounts":[{"id":"liuliao-a-0c301559977dcb94b60e","label":"裴注·魏略","text":"魏略记申耽聚众通张鲁受曹公将军上庸都尉","evidence":["liuliao-q-d2d356ef0e0f52d0fd2d"]}],"participants":[{"person":"xianzhu-p0073","role":"聚众通张鲁遣使诣曹公、领上庸都尉，后以郡西属","evidence":["liuliao-q-d2d356ef0e0f52d0fd2d"]},{"person":"wudi-p0279","role":"与耽相通","evidence":["liuliao-q-d2d356ef0e0f52d0fd2d"]},{"person":"cao-cao","role":"加将军使领上庸都尉","evidence":["liuliao-q-d2d356ef0e0f52d0fd2d"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liuliao-q-d2d356ef0e0f52d0fd2d"]},"ordering_evidence":"liuliao-q-d2d356ef0e0f52d0fd2d","source_order":[40,79,10],"order":7251}],"persons":[{"id":"xianzhu-p0073","name":"申耽","evidence":["xianzhu-q-o049","mingdi-q-p008","liuliao-q-79ddd8e23b5a267e775e","liuliao-q-22512f040a2aea93d481","liuliao-q-d2d356ef0e0f52d0fd2d"],"facts":[],"aliases":[],"mentions":[{"id":"xianzhu-m-o049-xianzhu-p0073","kind":"mention","text":"文中提及","evidence":["xianzhu-q-o049"]},{"id":"mingdi-m-p008-xianzhu-p0073","kind":"allusion","text":"祖系或典故提及","evidence":["mingdi-q-p008"]}]}],"evidence":[{"id":"liuliao-q-22512f040a2aea93d481","section":"chapter-040","block":"b-bb5e55dfbb21fd6de43d","layer":"original","quote":"封不从达言。申仪叛封，封破走还成都。申耽降魏，魏假耽怀集将军〖56〗，徙居南阳；仪魏兴太守〖57〗，封（真）〔郧〕乡侯，屯洵口","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":11,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":63,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-79ddd8e23b5a267e775e","section":"chapter-040","block":"b-ee57665e94513ca12cf7","layer":"original","quote":"达将进攻上庸〖4〗，先主阴恐达难独任；乃遣封自汉中乘沔水下统达军，与达会上庸。上庸太守申耽举众降，遣妻子及宗族诣成都。先主加耽征北将军，领上庸太守，员乡侯如故。以耽弟仪为建信将军、西城太守〖5〗。迁封为副军将军","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":3,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":31,"end":136,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-d2d356ef0e0f52d0fd2d","section":"chapter-040","block":"b-c6646f0ee12ee8a93736","layer":"pei","quote":"申仪兄名耽，字义举。初在西（平）〔城〕、上庸间，聚众数千家。后与张鲁通；又遣使诣曹公，曹公加其号为将军，因使领上庸都尉。至建安末，为蜀所攻，以其郡西属。","attribution":"裴注·魏略","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":78,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ccf0b2ee090d7b0f0d83","start":10,"end":86,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-p008","section":"chapter-003","block":"b-45e87c171e0131afcd00","layer":"pei","quote":"干宝《晋纪》曰：“达初入新城，登白马塞。叹曰：‘刘封、申耽，据金城千里而失之乎！’”","attribution":"裴注·干宝晋纪","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":53,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-680a01f5d7c24c678bdc","start":0,"end":42,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o049c-q","section":"chapter-032","block":"b-8a052498f4fbd858ba0b","layer":"original","quote":"遣刘封、孟达、李平等攻申耽于上庸〖15〗。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":204,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":83,"end":104,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-b-c3e56caa3865de7f7114","section":"chapter-032","block":"b-c3e56caa3865de7f7114","layer":"modern","quote":"〖11〗二十四年：建安二十四年（公元 219）。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":222,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fd85f82251e498647de7","start":0,"end":24,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o048","section":"chapter-032","block":"b-2d515ba2dae40f6a248e","layer":"original","quote":"二十四年春〖11〗，自阳平南渡沔水，缘山稍前〖12〗，于定军山（势）作营〖13〗。渊将兵来争其地，先主命黄忠乘高鼓噪攻之。大破渊军，斩渊及曹公所署益州刺史赵颙等。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":203,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":81,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o049","section":"chapter-032","block":"b-8a052498f4fbd858ba0b","layer":"original","quote":"曹公自长安举众南征。先主遥策之曰：“曹公虽来，无能为也；我必有汉川矣〖14〗！”及曹公至，先主敛众拒险，终不交锋；积月不拔，亡者日多。夏，曹公果引军还，先主遂有汉中；遣刘封、孟达、李平等攻申耽于上庸〖15〗。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":204,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":104,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
