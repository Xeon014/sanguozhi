745af","label":"正文","text":"孙休去世后濮阳兴张布废嫡子迎立孙皓","evidence":["santizhu064-q-89a7787cfa000c7b3131"]},{"id":"chenghuang-a-e107e5ee2ea1ddcc18b4","label":"正文","text":"休薨奉与濮阳兴等迎立孙皓","evidence":["chenghuang-q-76041c5796aa70038653"]}],"participants":[{"person":"shaodi-p0150","role":"去世","evidence":["santizhu064-q-89a7787cfa000c7b3131"]},{"person":"santizhu-p0062","role":"劝濮阳兴、张布","evidence":["santizhu064-q-89a7787cfa000c7b3131"]},{"person":"santizhu-p0048","role":"参与废孙休嫡子并迎立孙皓","evidence":["santizhu064-q-89a7787cfa000c7b3131"]},{"person":"santizhu-p0035","role":"参与废孙休嫡子并迎立孙皓","evidence":["santizhu064-q-89a7787cfa000c7b3131"]},{"person":"shaodi-p0162","role":"被迎立","evidence":["santizhu064-q-89a7787cfa000c7b3131"]},{"person":"santizhu-p0017","role":"与濮阳兴等从万彧言迎立孙皓","evidence":["chenghuang-q-76041c5796aa70038653"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"未由相邻段落推算纪年；原文时间表达保留在来源引句中。","evidence":["santizhu064-q-89a7787cfa000c7b3131"]},"ordering_evidence":"santizhu064-q-89a7787cfa000c7b3131","source_order":[64,113,0],"related_events":[{"event":"santizhu-e-sr-sunxiu-death","type":"related","evidence":["santizhu064-q-89a7787cfa000c7b3131","santizhu-q-0ff98c04ba8ea0aa6878"]},{"event":"santizhu-e-sr-sunhao-enthrone","type":"related","evidence":["santizhu064-q-89a7787cfa000c7b3131","santizhu-q-1af7102aeffef23fd915"]}],"order":11052},{"id":"santizhu064-e-o114a","title":"孙皓收濮阳兴张布并徙广州道杀","accounts":[{"id":"santizhu064-a-a0d5f3a79dfb6f2f6cf8","label":"正文","text":"皓践阼加兴侍中领青州牧；俄而万彧谮兴、布追悔前事；十一月朔入朝，皓因收兴、布，徙广州，道追杀之，夷三族","evidence":["santizhu064-q-4cccf48d27aa3aa2370b"]}],"participants":[{"person":"shaodi-p0162","role":"收捕濮阳兴、张布并徙广州","evidence":["santizhu064-q-4cccf48d27aa3aa2370b"]},{"person":"santizhu-p0048","role":"被收捕、徙广州，途中被杀并夷三族","evidence":["santizhu064-q-4cccf48d27aa3aa2370b"]},{"person":"santizhu-p0035","role":"被收捕、徙广州，途中被杀并夷三族","evidence":["santizhu064-q-4cccf48d27aa3aa2370b"]},{"person":"santizhu-p0062","role":"谮濮阳兴、张布追悔前事","evidence":["santizhu064-q-4cccf48d27aa3aa2370b"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"未由相邻段落推算纪年；原文时间表达保留在来源引句中。","evidence":["santizhu064-q-4cccf48d27aa3aa2370b"]},"ordering_evidence":"santizhu064-q-4cccf48d27aa3aa2370b","source_order":[64,114,33],"order":11053}],"persons":[{"id":"santizhu-p0048","name":"濮阳兴","evidence":["santizhu-q-5e126f7762744020d84a","santizhu-q-9d1adc3df3e99d260197","santizhu-q-aa25c2798a6bb28ab696","santizhu-q-2150977941873511531c","santizhu-q-43da33c9a317c296c18f","santizhu-q-cf7743561a5b52853e00","santizhu-q-4d2e6164339b83a17692","santizhu064-q-89a7787cfa000c7b3131","santizhu064-q-4cccf48d27aa3aa2370b","santizhu064-q-7ce1af6eaac6924374cd","chenghuang-q-76041c5796aa70038653","yululu-q-b9eaedb6a4bf107d23e9","yululu-q-a10cdb7af3f03e686cf1"],"facts":[{"id":"santizhu064-f-sr-047","text":"字子元，陈留人；父逸汉末避乱江东官至长沙太守（逸事见《陆瑁传》）；兴少有士名","evidence":["santizhu064-q-7ce1af6eaac6924374cd"]}],"aliases":[],"mentions":[{"id":"yululu-m-f0965640b11d62c45dd7","kind":"mention","text":"本篇原文记及濮阳兴，具体行动与称谓见引文。","evidence":["yululu-q-b9eaedb6a4bf107d23e9"]}]}],"evidence":[{"id":"chenghuang-q-76041c5796aa70038653","section":"chapter-055","block":"b-cd24621fcb9995479e10","layer":"original","quote":"休薨，奉与丞相濮阳兴等，从万彧之言，共迎立孙皓。迁右大司马、左军师","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":363,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":33,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-0ff98c04ba8ea0aa6878","section":"chapter-048","block":"b-25a289c0c24062b2e434","layer":"original","quote":"癸未〖9〗，休薨，﹝一﹞时年三十，谥曰景皇帝。﹝二﹞","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":284,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":93,"end":119,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-1af7102aeffef23fd915","section":"chapter-048","block":"b-cc2e940e4e45d8901403","layer":"original","quote":"于是遂迎立皓，时年二十三。","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":300,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":13,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-2150977941873511531c","section":"chapter-048","block":"b-a99dfc9c64dc935a5cca","layer":"original","quote":"左典军万彧昔为乌程令〖5〗，与皓相善；称皓“才识明断，是长沙桓王之畴也〖6〗，又加之好学，奉遵法度”；屡言之于丞相濮阳兴、左将军张布","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":299,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":31,"end":97,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-43da33c9a317c296c18f","section":"chapter-048","block":"b-a99dfc9c64dc935a5cca","layer":"original","quote":"兴、布说休妃太后朱〖7〗，欲以皓为嗣","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":299,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":98,"end":116,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-4d2e6164339b83a17692","section":"chapter-048","block":"b-70cd147d8691d1f9a0e6","layer":"pei","quote":"休寝疾，口不能言；乃手书呼丞相濮阳兴入，令子�出，拜之。休把兴臂，而指�以托之","attribution":"裴注·江表传","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":296,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f15a70c7dc978417a0a5","start":11,"end":50,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-5e126f7762744020d84a","section":"chapter-048","block":"b-31685d9067fb5e5662da","layer":"original","quote":"冬十月，以卫将军濮阳兴为丞相〖7〗；廷尉丁密、光禄勋孟宗，为左、右御史大夫","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":233,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":37,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-9d1adc3df3e99d260197","section":"chapter-048","block":"b-6a5ddb2360694843e01d","layer":"original","quote":"休以丞相兴及左将军张布有旧恩，委之以事：布典宫省〖9〗；兴关军国〖10〗","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":234,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":36,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-aa25c2798a6bb28ab696","section":"chapter-048","block":"b-f8f66aaddf4db29220ba","layer":"original","quote":"丞相兴，建取屯田万人以为兵〖8〗","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":269,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":128,"end":144,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-cf7743561a5b52853e00","section":"chapter-048","block":"b-2466c1de60d62b2735c4","layer":"original","quote":"十一月，诛兴、布","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":311,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":35,"end":43,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-29afb4f6180e39ac2241","section":"chapter-064","block":"b-567ebaa1e7ad327e90ec","layer":"original","quote":"孙权时除上虞令。稍迁至尚书左曹〖3〗。以五官中郎将使蜀〖4〗；还，为会稽太守。","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":531,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":44,"end":83,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-4cccf48d27aa3aa2370b","section":"chapter-064","block":"b-a5c8966dcdf43d4ccc61","layer":"original","quote":"皓既践阼，加兴（侍郎）〔侍中〕，领青州牧。俄而彧谮兴、布追悔前事。十一月朔〖10〗，入朝，皓因收兴、布，徙广州〖11〗；道追杀之〖12〗，夷三族。","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":535,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":73,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-68bb539aae1f98bac08e","section":"chapter-064","block":"b-5e7cef985b4af30aa617","layer":"original","quote":"永安三年，都尉严密建丹杨湖田，作浦里塘。诏百官会议，咸以为“用功多而田不保成”，唯兴以为“可成”。遂会诸兵民就作，功佣之费不可胜数；士卒死亡，或自贼杀〖6〗：百姓大怨之。","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":532,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":44,"end":129,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-7ce1af6eaac6924374cd","section":"chapter-064","block":"b-567ebaa1e7ad327e90ec","layer":"original","quote":"濮阳兴字子元，陈留人也〖1〗。父逸，汉末避乱江东，官至长沙太守。﹝一﹞兴少有士名〖2〗。","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":531,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":44,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-89a7787cfa000c7b3131","section":"chapter-064","block":"b-2ba1972d4a8c96ace07e","layer":"original","quote":"七年七月〖8〗，休薨。左典军万彧，素与乌程侯孙皓善〖9〗，乃劝兴、布；于是兴、布废休嫡子而迎立皓","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":534,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":48,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-d3e71a32432ce81684ad","section":"chapter-064","block":"b-5e7cef985b4af30aa617","layer":"original","quote":"时琅邪王休，居会稽，兴深与相结。及休即位，征兴为太常，卫将军，平军国事〖5〗，封外黄侯。","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":532,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":44,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-f40298c6c7bc7bed9a3c","section":"chapter-064","block":"b-af200e6163dcef7fe78f","layer":"original","quote":"兴迁为丞相，与休宠臣左将军张布，共相表里〖7〗。邦内失望。","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":533,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":29,"offset_unit":"unicode_code_point"},{"id":"yululu-q-a10cdb7af3f03e686cf1","section":"chapter-057","block":"b-19e656ddf062438a74f1","layer":"pei","quote":"濮阳府君曰：‘御史所云，既闻其人；亚斯以下，书佐宁识之乎？’育曰：‘瞻仰景行，敢不识之！近者太守上虞陈业，洁身清行，志怀霜雪，贞亮之信，同操柳下。遭汉中微，委官弃禄；遁迹黟、歙，以求其志；高邈妙踪，天下所闻。故桓文〔林〕遗之尺牍之书，比竟三高。其聪明大略，忠直謇谔，则侍御史余姚虞翻，偏将军乌伤骆统。其渊懿纯德，则太子少傅山阴阚泽，学通行茂，作帝师儒。其雄姿武毅，立功当世，则后将军贺齐，勋成绩著。其探极秘术，言合神明，则太史令上虞吴范。其文章之士，立言粲盛，则御史中丞句章任奕，鄱阳太守章安虞翔，各驰文檄，晔若春荣。处士（邓）〔� 〕卢叙，弟犯公宪，自杀乞代。吴宁斯敦、山阴祁庚、上虞樊正，咸代父死罪。其女则松阳柳朱，永宁（瞿）〔翟〕素：或一醮守节，丧身不顾；或遭寇劫贼，死不亏行。皆近世之事，尚在耳目。’府君曰：‘皆海内之英也！吾闻秦始皇二十五年，以吴越地为会稽郡，治吴；汉封诸侯王。以何年复为郡，而分治于此？’育对曰：‘刘贾为荆王，贾为英布所杀，又以刘濞为吴王。景帝四年，濞反，诛；乃复为郡，治于吴。元鼎五年，除东越，因以其地为治，并属于此，而立东部都尉；后徙章安；阳朔元年，又徙治鄞；或有寇害，复徒句章。到永建四年，刘府君上书：浙江之北，以为吴郡；会稽还治山阴。自永建四年岁在己巳，以至今年，积百二十九岁。’府君称善。","attribution":"裴注·会稽典录","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":108,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-d74a16d867d430187c4b","start":0,"end":563,"offset_unit":"unicode_code_point"},{"id":"yululu-q-b9eaedb6a4bf107d23e9","section":"chapter-057","block":"b-37f719fb5ba85adbe9cc","layer":"pei","quote":"“孙亮时，有山阴朱育，少好奇字。凡所特达，依体象类，造作异字千名以上。仕郡门下书佐。太守濮阳兴，正旦宴见掾吏。言次，问：‘太守昔闻朱颍川问士于郑召公，韩吴郡问士于刘圣博，王景兴问士于虞仲翔；尝见郑、刘二答，而未睹仲翔对也。钦闻国贤，思睹盛美有日矣：书佐宁识之乎？’育对曰：‘往过习之。昔初平末年，王府君以渊妙之才，超迁临郡；思贤嘉善，乐采名俊。问功曹虞翻曰：“闻玉出崑山，珠生南海；远方异域，各生珍宝。且曾闻士人叹美贵邦，旧多英俊；徒以远于京畿，含香未越耳。功曹雅好博古，宁识其人邪？”翻对曰：“夫会稽上应牵牛之宿，下当少阳之位；东渐巨海，西通五湖，南畅无垠，北渚浙江。南山攸居，实为州镇；昔禹会群臣，因以命之。山有金木鸟兽之殷，水有鱼盐珠蚌之饶；海岳精液，善生俊异。是以忠臣继踵，孝子连闾；下及贤女，靡不育焉。”王府君笑曰：“地势然矣。士女之名可悉闻乎？”翻对曰：“不敢及远，略言其近者耳。往者孝子句章董黯，尽心色养，丧致其哀；单身林野，鸟兽归怀。怨亲之辱，白日报仇；海内闻名，昭然光著。太中大夫山阴陈嚣，渔则化盗，居则让邻；感侵退藩，遂成义里；摄养车妪，行足厉俗。自扬子云等上书荐之，粲然传世。太尉山阴郑公，清亮质直，不畏强御。鲁相山阴钟离意，禀殊特之姿，孝家忠朝，宰县相国，所在遗惠。故取养有君子之谟，鲁国有丹书之信。及陈宫、费齐，皆上契天心，功德治状，记在汉籍。有道山阴赵晔，征士上虞王充，各洪才渊懿，学究道源；著书垂藻，骆驿百篇；释经传之宿疑，解当世之盘结；或上穷阴阳之奥秘，下摅人情之归极。交阯刺史上虞綦毋俊，拔济一郡，让爵土之封。决曹掾上虞孟英，三世死义。主簿句章梁宏，功曹史余姚驷勋，主簿句章郑云；皆敦终始之义，引罪免官。门下督盗贼余姚伍隆，�莫候反。主簿任光，章安小吏黄他，身当白刃，济君于难。扬州从事句章王修，委身授命，垂声来世。河内太守上虞魏少英，遭世屯蹇，忘家忧国；列在‘八俊’，为世英彦。尚书乌伤杨乔，桓帝妻以公主，辞疾不纳。近故太尉上虞朱公，天姿聪亮，钦明神武；策无失谟，征无遗虑；是以天下义兵，思以为首。上虞女子曹娥，父溺江流，投水而死；立石碑纪，炳然著显。”王府君曰：“是既然矣！颍川有巢、许之逸轨，吴有太伯之三让。贵郡虽士人纷纭，于此足矣！”翻对曰：“故先言其近者耳。若乃引上世之事，及抗节之士，亦有其人。昔越王翳让位，逃于巫山之穴，越人熏而出之：斯非太伯之俦邪？且太伯外来之君，非其地人也。若以外来言之，则大禹亦巡于此而葬之矣。鄞大里黄公，洁己暴秦之世；高祖即阼，不能一致；惠帝恭让，出则济难。征士余姚严遵，王莽数聘，抗节不行；光武中兴，然后俯就：矫手不拜，志陵云日。皆著于传籍，较然彰明；岂如巢、许，流俗遗谈，不见经传者哉！”王府君笑曰：“善哉话言也！贤矣，非君不著。太守未之前闻也。”’","attribution":"裴注·会稽典录","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":107,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-d74a16d867d430187c4b","start":0,"end":1163,"offset_unit":"unicode_code_point"}],"profiles":{"santizhu-p0048":{"fields":[{"id":"santizhu-p0048-directory-courtesy","key":"courtesy","label":"字","text":"子元","evidence":["santizhu064-q-7ce1af6eaac6924374cd"]}],"directory":{"faction":"wu"}}},"directory_counts":{}}
