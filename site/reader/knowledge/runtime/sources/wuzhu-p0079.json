","wuzhu-q-o148","shaodi-q-o030","shaodi-q-b-b12b565bdbec15bb549b"]},"ordering_evidence":"wuzhu-e-p064a-q","source_order":[47,770,"P064a"],"order":8388}],"persons":[{"id":"wuzhu-p0079","name":"谢宏","evidence":["wuzhu-q-p056"],"facts":[],"aliases":[],"mentions":[{"id":"wuzhu-m-p056-wuzhu-p0079","kind":"mention","text":"文中提及","evidence":["wuzhu-q-p056"]},{"id":"wuzhu-m-p064-wuzhu-p0079","kind":"mention","text":"文中提及","evidence":["wuzhu-q-p064"]}]}],"evidence":[{"id":"shaodi-q-b-b12b565bdbec15bb549b","section":"chapter-004","block":"b-b12b565bdbec15bb549b","layer":"modern","quote":"〖12〗七年：正始七年（公元 246）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":128,"anchor":null},"note_id":"n-9b6236e5001b76c5de88","start":0,"end":20},{"id":"shaodi-q-o030","section":"chapter-004","block":"b-4bf73c4c06612837c692","layer":"original","quote":"七年春二月〖12〗，幽州刺史毌丘俭讨高句骊。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":111,"anchor":null},"note_id":null,"start":0,"end":22},{"id":"wuzhu-e-p056e-q","section":"chapter-047","block":"b-730503f5b61bb0807f1a","layer":"pei","quote":"间一年，遣使者谢宏、中书陈恂，拜宫为单于，加赐衣物、珍宝。恂等到安平口，先遣校尉陈奉前，见宫；而宫受魏幽州刺史讽旨，令以吴使自效。奉闻之，（到）〔倒〕还。","attribution":"《吴书》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":45,"anchor":null},"note_id":"n-0985bb2211035724e176","start":521,"end":598},{"id":"wuzhu-e-p056f-q","section":"chapter-047","block":"b-730503f5b61bb0807f1a","layer":"pei","quote":"宫遣主簿笮咨、带固等出安平，与宏相见。宏即缚得三十余人，质之；宫于是谢罪，上马数百匹。宏乃遣咨、固，奉诏书赐物，与宫。是时宏船小，载马八十匹而还。","attribution":"《吴书》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":45,"anchor":null},"note_id":"n-0985bb2211035724e176","start":598,"end":671},{"id":"wuzhu-e-p064a-q","section":"chapter-047","block":"b-bac6c298ab586e6488e6","layer":"pei","quote":"﹝二﹞《江表传》曰：“是岁，权诏曰：‘谢宏往日陈铸大钱，云以广货，故听之。今闻民意不以为便，其省息之；铸为器物，官勿复出也。私家有者，敕以输藏；计畀其直，勿有所枉也。’”","attribution":"《江表传》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":258,"anchor":null},"note_id":"n-90d3aae79ff527f8b3f8","start":0,"end":85},{"id":"wuzhu-q-o148","section":"chapter-047","block":"b-1ea4bc0b6a2e6da659b7","layer":"original","quote":"九年春二月〖8〗，车骑将军朱然征魏柤中，斩获千余。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":233,"anchor":null},"note_id":null,"start":0,"end":25},{"id":"wuzhu-q-p056","section":"chapter-047","block":"b-730503f5b61bb0807f1a","layer":"pei","quote":"﹝五﹞《吴书》曰：“初，张弥、许晏等俱到襄平，官属从者四百许人。渊欲图弥、晏，先分其人众，置辽东诸县；以中使秦旦、张群、杜德、黄疆等及吏兵六十人，置玄菟郡。玄菟郡在辽东北，相去二百里；太守王赞领户二百，兼重可三四百人。旦等皆舍于民家，仰其饮食。积四十许日，旦与疆等议曰：‘吾人远辱国命，自弃于此，与死亡何异？今观此郡，形势甚弱。若一旦同心，焚烧城郭，杀其长吏；为国报耻，然后伏死，足以无恨！孰与偷生苟活，长为囚虏乎？’疆等然之。于是阴相约结，当用八月十九日夜发。其日中时，为部中张松所告；赞便会士众闭城门。旦、群、德、疆等，皆逾城得走。时群，病疽创著膝，不及辈旅；德常扶接与俱，崎岖山谷。行六七百里，创益困，不复能前；卧草中，相守悲泣。群曰：‘吾不幸创甚，死亡无日；卿诸人宜速进道，冀有所达。空相守，俱死于穷谷之中，何益也！’德曰：‘万里流离，死生共之，不忍相委！’于是推旦、疆，使前；德独留守群，捕菜果食之。旦、疆别数日，得达句骊（王宫）；因宣诏于句骊王宫及其主簿，诏言有赐，为辽东所攻夺。宫等大喜，即受诏；命使人随旦还迎群、德。其年，宫遣皂衣二十五人，送旦等还，奉表称臣，贡貂皮千枚，鹖鸡皮十具。旦等见权，悲喜不能自胜。权义之，皆拜校尉。间一年，遣使者谢宏、中书陈恂，拜宫为单于，加赐衣物、珍宝。恂等到安平口，先遣校尉陈奉前，见宫；而宫受魏幽州刺史讽旨，令以吴使自效。奉闻之，（到）〔倒〕还。宫遣主簿笮咨、带固等出安平，与宏相见。宏即缚得三十余人，质之；宫于是谢罪，上马数百匹。宏乃遣咨、固，奉诏书赐物，与宫。是时宏船小，载马八十匹而还。”","attribution":"《吴书》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":45,"anchor":null},"note_id":"n-0985bb2211035724e176","start":0,"end":672},{"id":"wuzhu-q-p064","section":"chapter-047","block":"b-bac6c298ab586e6488e6","layer":"pei","quote":"﹝二﹞《江表传》曰：“是岁，权诏曰：‘谢宏往日陈铸大钱，云以广货，故听之。今闻民意不以为便，其省息之；铸为器物，官勿复出也。私家有者，敕以输藏；计畀其直，勿有所枉也。’”","attribution":"《江表传》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":258,"anchor":null},"note_id":"n-90d3aae79ff527f8b3f8","start":0,"end":85}],"profiles":{},"directory_counts":{}}
