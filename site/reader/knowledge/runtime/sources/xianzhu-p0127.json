{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-p051a","title":"《神仙传》载李意其画示征吴之兆","accounts":[{"id":"xianzhu-e-p051a-account","label":"葛洪《神仙传》","text":"《神仙传》称刘备征吴前迎李意其问吉凶，李画兵马毁之、画大人埋之，书中以此寓示兵败与刘备之死。","evidence":["xianzhu-e-p051a-q"]}],"participants":[{"person":"liu-bei","role":"传说中问吉凶","evidence":["xianzhu-e-p051a-q"]},{"person":"xianzhu-p0127","role":"传说中画示","evidence":["xianzhu-e-p051a-q"]}],"place":null,"time":{"label":"《神仙传》所述伐吴前","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xianzhu-e-p051a-q"]},"source_order":[32,459,"P051a"],"order":6629}],"persons":[{"id":"xianzhu-p0127","name":"李意其","evidence":["xianzhu-q-p051"],"facts":[{"id":"xianzhu-f0034","label":"籍贯记载（《神仙传》）","text":"蜀","evidence":["xianzhu-f0034-q"]}],"aliases":[],"mentions":[{"id":"xianzhu-m-p051-xianzhu-p0127","kind":"mention","text":"文中提及","evidence":["xianzhu-q-p051"]}]}],"evidence":[{"id":"xianzhu-e-p051a-q","section":"chapter-032","block":"b-b309ce3d53106744428f","layer":"pei","quote":"﹝三﹞葛洪《神仙传》曰：“仙人李意其，蜀人也。传世见之，云是汉文帝时人。先主欲伐吴，遣人迎意其。意其到，先主礼敬之。问以吉凶，意其不答而求纸笔；画作兵马、器仗数十纸，已，便一一以手裂坏之；又画作一大人，掘地埋之。便径去，先主大不喜。而自出军征吴，大败，还，忿耻发病死；众人乃知其意：其画作大人而埋之者，即是言先主死意。”","attribution":"葛洪《神仙传》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":458,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-42f35a75771dd2504b96","start":0,"end":160,"offset_unit":"unicode_code_point"},{"id":"xianzhu-f0034-q","section":"chapter-032","block":"b-b309ce3d53106744428f","layer":"pei","quote":"仙人李意其，蜀人也。","attribution":"葛洪《神仙传》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":458,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-42f35a75771dd2504b96","start":13,"end":23,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-p051","section":"chapter-032","block":"b-b309ce3d53106744428f","layer":"pei","quote":"﹝三﹞葛洪《神仙传》曰：“仙人李意其，蜀人也。传世见之，云是汉文帝时人。先主欲伐吴，遣人迎意其。意其到，先主礼敬之。问以吉凶，意其不答而求纸笔；画作兵马、器仗数十纸，已，便一一以手裂坏之；又画作一大人，掘地埋之。便径去，先主大不喜。而自出军征吴，大败，还，忿耻发病死；众人乃知其意：其画作大人而埋之者，即是言先主死意。”","attribution":"葛洪《神仙传》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":458,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-42f35a75771dd2504b96","start":0,"end":160,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
