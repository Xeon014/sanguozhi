782c4","zongshi-q-a24c948b1b77b6d137c4","zongshi-q-9ae736e66ec05771072f","zongshi-q-37defde1e4884c3b712c","zongshi-q-058a6aa810fc76a0d8f3","zongshi-q-f4791bcc2c3cf10826c9","zongshi-q2-5ddc4a3c6678e8eb3a70","zongshi-q2-19fb4502bbf08cb26e25","zhulv-q-15837c4dbb19d67c7309"],"facts":[{"id":"zongshi-f2-64f4a375c71905dbaad7","text":"为广陵太守、偏将军；孙权为吴王，迁扬威将军，封建德侯；孙权称尊号，为镇北将军。","evidence":["zongshi-q2-5ddc4a3c6678e8eb3a70"]},{"id":"zongshi-f2-dfd14c7526ac1eb20cc4","text":"赤乌四年卒，子越嗣；越兄楷，代为京下督；另有异、奕、恢各居职。","evidence":["zongshi-q2-19fb4502bbf08cb26e25"]}],"aliases":[],"mentions":[{"id":"mingdi-m-o039-mingdi-p0037","kind":"mention","text":"文中提及","evidence":["mingdi-q-o039"]},{"id":"mingdi-m-o040-mingdi-p0037","kind":"mention","text":"文中提及","evidence":["mingdi-q-o040"]},{"id":"wuzhu-m-p045-mingdi-p0037","kind":"mention","text":"文中提及","evidence":["wuzhu-q-p045"]},{"id":"wuzhu-m-o108-mingdi-p0037","kind":"mention","text":"文中提及","evidence":["wuzhu-q-o108"]},{"id":"zongshi-m2-ba8690f6f5d0471c3542","kind":"mention","text":"文中提及","evidence":["zongshi-q-fd8d0bc42c1d8beea253"]}]}],"evidence":[{"id":"guanzhang-q-b-be58a15ce144f67b67a5","section":"chapter-036","block":"b-be58a15ce144f67b67a5","layer":"modern","quote":"〖13〗二年：章武二年（公元 222）。马超的祠墓遗址，相传在今四川成都市新都区城南的马超小学内，曾有墓碑出土。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":158,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1fcace810489e51a4218","start":0,"end":56,"offset_unit":"unicode_code_point"},{"id":"guanzhang-q-o034","section":"chapter-036","block":"b-7ddd1fa08ce5c9feb1d4","layer":"original","quote":"二年卒〖13〗，时年四十七。临没上疏曰：“臣门宗二百余口〖14〗，为孟德所诛略尽〖15〗；惟有从弟岱，当为微宗血食之继〖16〗，深托陛下。余无复言。”","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":143,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":75,"offset_unit":"unicode_code_point"},{"id":"hequan-q-201b6b9807aa4b307891","section":"chapter-060","block":"b-371a2d8bb805612c7632","layer":"original","quote":"黄武元年，魏以舟军大出洞口。权使吕范督诸将拒之","section_title":"贺全吕周钟离传第十五","source":{"file":"OEBPS/Text/titlepage_0127.xhtml","index":123,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":23,"offset_unit":"unicode_code_point"},{"id":"hequan-q-e32be2221236a8d4948b","section":"chapter-060","block":"b-5ed63010bb087005cebc","layer":"original","quote":"黄武初，魏使曹休来伐；齐以道远后至，因住新市为拒","section_title":"贺全吕周钟离传第十五","source":{"file":"OEBPS/Text/titlepage_0127.xhtml","index":86,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":24,"offset_unit":"unicode_code_point"},{"id":"mantian-q-3c5cf736a6778f82e410","section":"chapter-026","block":"b-b532990698a1a69ad25e","layer":"original","quote":"后孙权号十万众攻新城，征东将军满宠欲率诸军救之","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":168,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":23,"offset_unit":"unicode_code_point"},{"id":"mantian-q-600ebe2871292deea210","section":"chapter-026","block":"b-e1a46a1eeb88500f5c92","layer":"original","quote":"权自将号十万，至合肥新城","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":85,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":3,"end":15,"offset_unit":"unicode_code_point"},{"id":"mantian-q-68662ceb5338803231ef","section":"chapter-026","block":"b-e1a46a1eeb88500f5c92","layer":"original","quote":"权自将号十万，至合肥新城。宠驰往赴，募壮士数十人；折松为炬，灌以麻油；从上风放火，烧贼攻具〖17〗，射杀权弟子孙泰〖18〗。贼于是引退","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":85,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":3,"end":70,"offset_unit":"unicode_code_point"},{"id":"mingdi-e-o039b-q","section":"chapter-003","block":"b-5bf6d1ed2ab463eadb39","layer":"original","quote":"五月，太白昼现。孙权入居巢湖口〖1〗，向合肥新城〖2〗；又遣将陆议、孙韶各将万余人入淮、沔〖3〗。六月，征东将军满宠进军拒之〖4〗。宠欲拔新城守〖5〗，致贼寿春〖6〗。帝不听，曰：“昔汉光武遣兵悬据略阳〖7〗，终以破隗嚣〖8〗。先帝东置合肥，南守襄阳，西固祁山〖9〗；贼来辄破于三城之下者〖10〗，地有所必争也。纵权攻新城，必不能拔；敕诸将坚守，吾将自往征之；比至，恐权走也。”","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":268,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":189,"offset_unit":"unicode_code_point"},{"id":"mingdi-e-o040a-q","section":"chapter-003","block":"b-86852a0ccf13743ef54c","layer":"original","quote":"秋七月，壬寅〖11〗，帝亲御龙舟，东征。权攻新城，将军张颖等拒守力战。帝军未至数百里，权遁走，议、韶等亦退。群臣以为：“大将军方与诸葛亮相持，未解，车驾可西幸长安。”帝曰：“权走，亮胆破；大将军（以）〔必〕制之！吾无忧矣。”遂进军幸寿春，录诸将功，封赏各有差。八月，己未〖12〗，大曜兵〖13〗，飨六军；遣使者持节，犒劳合肥、寿春诸军。辛巳〖14〗，行还许昌宫。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":269,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":181,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-b-7a11c761ca65aeb3d195","section":"chapter-003","block":"b-7a11c761ca65aeb3d195","layer":"modern","quote":"〖1〗二年：青龙二年（公元 234）。己未：旧历初四日。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":252,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6c0753fe684a18a3a281","start":0,"end":28,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-o037","section":"chapter-003","block":"b-ff97c2d326d0fc08a9de","layer":"original","quote":"二年春二月，（乙）〔己〕未〖1〗，太白犯荧惑。癸酉〖2〗，诏曰：“‘鞭作官刑〖3〗’，所以纠慢怠也〖4〗；而顷多以无辜死。其减鞭杖之制〖5〗，著于令。”三月，庚寅〖6〗，山阳公薨；帝素服发哀〖7〗，遣使持节，典护丧事。己酉〖8〗，大赦。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":249,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":118,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-o039","section":"chapter-003","block":"b-5bf6d1ed2ab463eadb39","layer":"original","quote":"五月，太白昼现。孙权入居巢湖口〖1〗，向合肥新城〖2〗；又遣将陆议、孙韶各将万余人入淮、沔〖3〗。六月，征东将军满宠进军拒之〖4〗。宠欲拔新城守〖5〗，致贼寿春〖6〗。帝不听，曰：“昔汉光武遣兵悬据略阳〖7〗，终以破隗嚣〖8〗。先帝东置合肥，南守襄阳，西固祁山〖9〗；贼来辄破于三城之下者〖10〗，地有所必争也。纵权攻新城，必不能拔；敕诸将坚守，吾将自往征之；比至，恐权走也。”","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":268,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":189,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-o040","section":"chapter-003","block":"b-86852a0ccf13743ef54c","layer":"original","quote":"秋七月，壬寅〖11〗，帝亲御龙舟，东征。权攻新城，将军张颖等拒守力战。帝军未至数百里，权遁走，议、韶等亦退。群臣以为：“大将军方与诸葛亮相持，未解，车驾可西幸长安。”帝曰：“权走，亮胆破；大将军（以）〔必〕制之！吾无忧矣。”遂进军幸寿春，录诸将功，封赏各有差。八月，己未〖12〗，大曜兵〖13〗，飨六军；遣使者持节，犒劳合肥、寿春诸军。辛巳〖14〗，行还许昌宫。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":269,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":181,"offset_unit":"unicode_code_point"},{"id":"wuzhu-e-o057a-q","section":"chapter-047","block":"b-18306c49b308c4280bb8","layer":"original","quote":"秋九月，魏乃命曹休、张辽、臧霸出洞口〖9〗；曹仁出濡须；曹真、夏侯尚、张郃、徐晃围南郡〖10〗。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":296,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":48,"offset_unit":"unicode_code_point"},{"id":"wuzhu-e-o108a-q","section":"chapter-047","block":"b-8d6d7b03ef7e78c66434","layer":"original","quote":"夏五月，权遣陆逊、诸葛瑾等屯江夏、沔口〖5〗；孙韶、张承等向广陵、淮（阳）〔阴〕〖6〗；权率大众，围合肥新城。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":47,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":55,"offset_unit":"unicode_code_point"},{"id":"wuzhu-e-o108b-q","section":"chapter-047","block":"b-8d6d7b03ef7e78c66434","layer":"original","quote":"是时蜀相诸葛亮出武功〖7〗，权谓魏明帝不能远出；而帝遣兵助司马宣王拒亮〖8〗，自率水军东征。未至寿春，权退还，孙韶亦罢。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":47,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":55,"end":115,"offset_unit":"unicode_code_point"},{"id":"wuzhu-e-p045a-q","section":"chapter-047","block":"b-7e48004d0b997dd2b7df","layer":"pei","quote":"﹝八﹞《吴录》曰：“是冬，魏文帝至广陵，临江观兵；兵有十余万，旌旗弥数百里，有渡江之志。权严设固守。时大寒，冰，舟不得入江。帝见波涛汹涌，叹曰：‘嗟乎！固天所以隔南北也！’遂归。孙韶又遣将高寿等，率敢死之士五百人，于径路夜要之。帝大惊；寿等获副车、羽盖以还。”","attribution":"《吴录》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":386,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ee1abf3b1661683403c1","start":0,"end":130,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o054","section":"chapter-047","block":"b-7e0fdf82962252602cbd","layer":"original","quote":"黄武元年春正月〖1〗，陆逊部将军宋谦等〖2〗，攻蜀五屯；皆破之，斩其将。三月，鄱阳言黄龙现〖3〗。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":293,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":49,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o068","section":"chapter-047","block":"b-6363a8960241c0d42a9f","layer":"original","quote":"四年夏五月〖11〗，丞相孙邵卒。﹝六﹞六月，以太常顾雍为丞相〖12〗。﹝七﹞","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":359,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":38,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o107","section":"chapter-047","block":"b-adeefad7184b459985c1","layer":"original","quote":"三年春正月〖1〗，诏曰：“兵久不辍，民困于役，岁或不登〖2〗。其宽诸逋〖3〗，勿复督课〖4〗。”","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":46,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":48,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o108","section":"chapter-047","block":"b-8d6d7b03ef7e78c66434","layer":"original","quote":"夏五月，权遣陆逊、诸葛瑾等屯江夏、沔口〖5〗；孙韶、张承等向广陵、淮（阳）〔阴〕〖6〗；权率大众，围合肥新城。是时蜀相诸葛亮出武功〖7〗，权谓魏明帝不能远出；而帝遣兵助司马宣王拒亮〖8〗，自率水军东征。未至寿春，权退还，孙韶亦罢。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":47,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":115,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-p045","section":"chapter-047","block":"b-7e48004d0b997dd2b7df","layer":"pei","quote":"﹝八﹞《吴录》曰：“是冬，魏文帝至广陵，临江观兵；兵有十余万，旌旗弥数百里，有渡江之志。权严设固守。时大寒，冰，舟不得入江。帝见波涛汹涌，叹曰：‘嗟乎！固天所以隔南北也！’遂归。孙韶又遣将高寿等，率敢死之士五百人，于径路夜要之。帝大惊；寿等获副车、羽盖以还。”","attribution":"《吴录》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":386,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ee1abf3b1661683403c1","start":0,"end":130,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-b-28bd067e0a3e898385bc","section":"chapter-035","block":"b-28bd067e0a3e898385bc","layer":"modern","quote":"〖10〗三年：建兴三年（公元 225）。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":144,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-d52302c7e46aff00f085","start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-b-934abed655148ea08df3","section":"chapter-035","block":"b-934abed655148ea08df3","layer":"modern","quote":"〖2〗十二年：建兴十二年（公元 234）。以上诸葛亮出兵北伐共计五次，经由祁山只有两次。后世所说的“六出祁山”并非历史真实。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":269,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1e22705f935572994567","start":0,"end":62,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-o023","section":"chapter-035","block":"b-862592827af5abe9feb3","layer":"original","quote":"三年春〖10〗，亮率众南征〖11〗。﹝三﹞其秋，悉平：军资所出〖12〗，国以富饶；﹝四﹞乃治戎讲武，以俟大举。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":133,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":55,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-o039","section":"chapter-035","block":"b-e60db7c722cd4fe4fb69","layer":"original","quote":"十二年春〖2〗，亮悉大众由斜谷出，以流马运；据武功五丈原〖3〗，与司马宣王对于渭南〖4〗。亮每患粮不继，使己志不申；是以分兵屯田，为久驻之基。耕者杂于渭滨居民之间，而百姓安堵〖5〗，军无私焉〖6〗。﹝三﹞相持百余日。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":258,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":108,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-15837c4dbb19d67c7309","section":"chapter-056","block":"b-fa9f8655bfd56be37fd7","layer":"original","quote":"曹休、张辽、臧霸等来伐；范督徐盛、全琮、孙韶等，以舟师拒休等于洞口","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":174,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":33,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-c6662a503490f6f162ea","section":"chapter-056","block":"b-1bcb6b62fd91ee9e1a9d","layer":"original","quote":"嘉禾三年，权与蜀克期大举；权自向新城〖12〗，然与全琮各受斧钺〖13〗，为左、右督","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":71,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":41,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-d391e3b5a74a420c1faa","section":"chapter-056","block":"b-1bcb6b62fd91ee9e1a9d","layer":"original","quote":"会吏士疾病，故未攻而退","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":71,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":46,"end":57,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-058a6aa810fc76a0d8f3","section":"chapter-051","block":"b-b7cd96841b6cf6a55b52","layer":"original","quote":"权欢悦曰：“吾久不见公礼，不图进益乃尔！”加领幽州牧，假节","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":197,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":80,"end":109,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-0ac4211e9c2e2089b938","section":"chapter-051","block":"b-44a8dd642e4b89343204","layer":"original","quote":"韶年十七，收河余众；缮治京城，起楼橹〖1〗，修器备以御敌","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":193,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":28,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-37defde1e4884c3b712c","section":"chapter-051","block":"b-b7cd96841b6cf6a55b52","layer":"original","quote":"权问青、徐诸屯要害，远近人马众寡，魏将帅姓名；尽具识之〖11〗，有问咸对","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":197,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":29,"end":65,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-5332e816b24f3e1694a6","section":"chapter-051","block":"b-03ea69a8190928bde76f","layer":"original","quote":"嘉禾三年，从权围新城，中流矢死","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":160,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":18,"end":33,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-5bccfdeb03c4c1cc1bca","section":"chapter-051","block":"b-ed5ad5f26ebf8a9ed071","layer":"pei","quote":"曹休出洞口，吕范率军御之","attribution":"裴注·江表传","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":170,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-2e477cf123d96200cb3b","start":11,"end":23,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-6a8ae9d12a4e442782c4","section":"chapter-051","block":"b-92eaf631c87d8a041a26","layer":"original","quote":"明日见韶，甚器之；即拜承烈校尉〖5〗，统河部曲；食曲阿、丹徒二县〖6〗，自置长吏，一如河旧","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":195,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":45,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-9ae736e66ec05771072f","section":"chapter-051","block":"b-b7cd96841b6cf6a55b52","layer":"original","quote":"自权西征还，都武昌，韶不进见者十余年。权还建业，乃得朝觐","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":197,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":28,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-a24c948b1b77b6d137c4","section":"chapter-051","block":"b-f6225b29f6565e16d5ff","layer":"original","quote":"青、徐、汝、沛颇来归附〖9〗，淮南滨江屯候皆撤兵远徙〖10〗；徐泗、江、淮之地，不居者各数百里","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":196,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":49,"end":96,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-f4791bcc2c3cf10826c9","section":"chapter-051","block":"b-e9f615ee96ac3a528d74","layer":"original","quote":"赤乌四年，卒。子越嗣，至右将军","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":198,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":15,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-fd8d0bc42c1d8beea253","section":"chapter-051","block":"b-ad972acb37aee06b8b4c","layer":"original","quote":"夜至京城下营，试攻惊之；兵皆乘城传檄备警〖3〗，w声动地〖4〗，颇射外人：权使晓喻，乃止","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":194,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":22,"end":66,"offset_unit":"unicode_code_point"},{"id":"zongshi-q2-19fb4502bbf08cb26e25","section":"chapter-051","block":"b-e9f615ee96ac3a528d74","layer":"original","quote":"赤乌四年，卒。子越嗣，至右将军〖13〗。越兄楷，武卫大将军〖14〗，临成侯，代越为京下督。楷弟异，至领军将军〖15〗；奕，宗正卿；恢，武陵太守。","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":198,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":72,"offset_unit":"unicode_code_point"},{"id":"zongshi-q2-5ddc4a3c6678e8eb3a70","section":"chapter-051","block":"b-92eaf631c87d8a041a26","layer":"original","quote":"明日见韶，甚器之；即拜承烈校尉〖5〗，统河部曲；食曲阿、丹徒二县〖6〗，自置长吏，一如河旧。后为广陵太守，偏将军。权为吴王，迁扬威将军，封建德侯。权称尊号，为镇北将军〖7〗。","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":195,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":87,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
