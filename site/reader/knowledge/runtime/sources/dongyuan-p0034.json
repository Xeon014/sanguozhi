q"]}],"mentions":[{"id":"dongyuan-m-o065-dongyuan-p0034","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o065"]},{"id":"dongyuan-m-o068-dongyuan-p0034","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o068"]},{"id":"dongyuan-m-p099-dongyuan-p0034","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p099"]}]}],"evidence":[{"id":"dongyuan-e-o065b-q","section":"chapter-006","block":"b-192340983e440a0e661b","layer":"original","quote":"触自号幽州刺史，驱率诸郡太守、令长，背袁向曹；陈兵数万，杀白马盟。令曰：“违命者斩！”众莫敢语，各以次歃〖3〗。至别驾韩珩，曰：“吾受袁公父子厚恩，今其破亡，智不能救，勇不能死，于义缺矣；若乃北面于曹氏〖4〗，所弗能为也！”一坐为珩失色。触曰：“夫兴大事，当立大义；事之济否，不待一人。可卒珩志〖5〗，以励事君〖6〗。”","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":372,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":20,"end":180,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-o068a-q","section":"chapter-006","block":"b-6aa09b001abf4c25eb61","layer":"original","quote":"太祖高韩珩节，屡辟。不至，卒于家。﹝三﹞","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":375,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p099a-q","section":"chapter-006","block":"b-9d51038e5210616a383b","layer":"pei","quote":"﹝三﹞《先贤行状》曰：“珩字子佩，代郡人。清粹有雅量。少丧父母，奉养兄姊，宗族称孝悌焉。”","attribution":"《先贤行状》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":387,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1398f46064f0bbdedac6","start":0,"end":45,"offset_unit":"unicode_code_point"},{"id":"dongyuan-f0042-q","section":"chapter-006","block":"b-9d51038e5210616a383b","layer":"pei","quote":"珩字子佩","attribution":"《先贤行状》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":387,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c