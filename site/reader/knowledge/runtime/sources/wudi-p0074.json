{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o012a","title":"汴水战败与曹洪救曹操","accounts":[{"id":"wudi-e-o012a-account","label":"正文","text":"卫兹分兵随曹操，与徐荣战于汴水而败；曹操受伤失马，曹洪让马，曹操夜间脱身。","evidence":["wudi-e-o012a-q"]},{"id":"xiahoucao-e-o035a-account","label":"《诸夏侯曹传第九》正文","text":"曹洪下马授曹操步从寻船同济汴水奔谯","evidence":["xiahoucao-e-o035a-q"]},{"id":"lvzang-a-0ef472110aff40854909","label":"正文","text":"董卓之乱太祖与邈首举义兵汴水之战邈遣卫兹将兵随太祖","evidence":["lvzang-q-8313539e9d272536b98f"]},{"id":"cuimao-a-d8328e9ab4f232096d5a","label":"裴注·《魏书》","text":"汴水之败鲍信被创，鲍韬在阵战亡","evidence":["cuimao-q-b47d6ab0cc4198f95915"]}],"participants":[{"person":"wudi-p0062","role":"遣将","evidence":["wudi-e-o012a-q"]},{"person":"wudi-p0056","role":"助战","evidence":["wudi-e-o012a-q"]},{"person":"cao-cao","role":"战败脱身","evidence":["wudi-e-o012a-q"]},{"person":"wudi-p0074","role":"交战退军","evidence":["wudi-e-o012a-q"]},{"person":"wudi-p0075","role":"让马救援","evidence":["wudi-e-o012a-q"]},{"person":"wudi-p0065","role":"被创者","evidence":["cuimao-q-b47d6ab0cc4198f95915"]},{"person":"cuimao-p0071","role":"在阵战亡者","evidence":["cuimao-q-b47d6ab0cc4198f95915"]}],"place":{"text":"荥阳汴水","evidence":["wudi-e-o012a-q"]},"time":{"label":"初平元年","year":190,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o012a-q","wudi-q-o009","wudi-q-b-4a17eb75600ced2abdde"],"chronology":"wudi-y190","dating_review":{"anchor":"wudi-q-o009","basis":"初平元年","reviewed":true}},"source_order":[1,102,"O012a"],"order":61},{"id":"gongsuntao-e-o073","title":"徐荣荐度为辽东太守","accounts":[{"id":"gongsuntao-a-57427ede09d0ec77bc64","label":"正文","text":"徐荣荐度为辽东太守","evidence":["gongsuntao-q-a614cfc45063becfb535"]}],"participants":[{"person":"wudi-p0074","role":"同郡人、董卓中郎将、荐度为辽东太守","evidence":["gongsuntao-q-a614cfc45063becfb535"]},{"person":"gongsuntao-p0007","role":"被荐为辽东太守、起玄菟小吏为辽东郡所轻","evidence":["gongsuntao-q-a614cfc45063becfb535"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["gongsuntao-q-a614cfc45063becfb535"]},"ordering_evidence":"gongsuntao-q-a614cfc45063becfb535","source_order":[8,165,0],"order":2019}],"persons":[{"id":"wudi-p0074","name":"徐荣","evidence":["wudi-q-o012","xiahoucao-q-o035","gongsuntao-q-a614cfc45063becfb535"],"facts":[],"aliases":[],"mentions":[{"id":"wudi-m-o012-wudi-p0074","kind":"mention","text":"文中提及","evidence":["wudi-q-o012"]},{"id":"xiahoucao-m-o035-wudi-p0074","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-o035"]}]}],"evidence":[{"id":"cuimao-q-b47d6ab0cc4198f95915","section":"chapter-012","block":"b-08203b2976224e5bbb3f","layer":"pei","quote":"汴水之败，信被创，韬在阵战亡","attribution":"裴注·《魏书》","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":296,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-678dfc7a2f3975ac89c5","start":257,"end":271,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-a614cfc45063becfb535","section":"chapter-008","block":"b-9b100edc000c32804ff5","layer":"original","quote":"同郡徐荣为董卓中郎将，荐度为辽东太守","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":164,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":18,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-8313539e9d272536b98f","section":"chapter-007","block":"b-e0bf87d51bee3453a4e2","layer":"original","quote":"董卓之乱，太祖与邈首举义兵。汴水之战，邈遣卫兹将兵随太祖","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":43,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":28,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o012a-q","section":"chapter-001","block":"b-2ce0778dff9b29b4e2d1","layer":"original","quote":"邈遣将卫兹，分兵随太祖。到荥阳汴水〖9〗，遇卓将徐荣，与战不利，士卒死伤甚多。太祖为流矢所中，所乘马被创〖10〗。从弟洪以马与太祖〖11〗，得夜遁去。荣见太祖所将兵少〖12〗，力战尽日；谓酸枣未易攻也，亦引兵还。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":101,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":106,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-4a17eb75600ced2abdde","section":"chapter-001","block":"b-4a17eb75600ced2abdde","layer":"modern","quote":"〖1〗初平元年：公元 190 年。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":86,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-93d66253e23c705b336d","start":0,"end":17,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o009","section":"chapter-001","block":"b-20c7e941eb42ee97df8c","layer":"original","quote":"初平元年春正月〖1〗，后将军袁术、冀州牧韩馥、﹝一﹞豫州刺史孔伷、﹝二﹞兖州刺史刘岱、﹝三﹞河内太守王匡、﹝四﹞勃海太守袁绍、陈留太守张邈、东郡太守桥瑁、﹝五﹞山阳太守袁遗、﹝六﹞济北相鲍信，﹝七﹞同时俱起兵〖2〗。众各数万，推绍为盟主。太祖行奋武将军〖3〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":84,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":130,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o012","section":"chapter-001","block":"b-2ce0778dff9b29b4e2d1","layer":"original","quote":"邈遣将卫兹，分兵随太祖。到荥阳汴水〖9〗，遇卓将徐荣，与战不利，士卒死伤甚多。太祖为流矢所中，所乘马被创〖10〗。从弟洪以马与太祖〖11〗，得夜遁去。荣见太祖所将兵少〖12〗，力战尽日；谓酸枣未易攻也，亦引兵还。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":101,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":106,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o035a-q","section":"chapter-009","block":"b-879705d364554277c415","layer":"original","quote":"太祖起义兵讨董卓，至荥阳，为卓将徐荣所败。太祖失马，贼追甚急；洪下，以马授太祖；太祖辞让，洪曰：“天下可无洪，不可无君！”遂步从到汴水。水深不得渡，洪循水得船；与太祖俱济，还奔谯。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":166,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":15,"end":105,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-o035","section":"chapter-009","block":"b-879705d364554277c415","layer":"original","quote":"曹洪字子廉。太祖从弟也。﹝一﹞太祖起义兵讨董卓，至荥阳，为卓将徐荣所败。太祖失马，贼追甚急；洪下，以马授太祖；太祖辞让，洪曰：“天下可无洪，不可无君！”遂步从到汴水。水深不得渡，洪循水得船；与太祖俱济，还奔谯。扬州刺史陈温素与洪善，洪将家兵千余人，就温募兵；得庐江上甲二千人〖1〗，东到丹杨，复得数千人，与太祖会龙亢。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":166,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":159,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
