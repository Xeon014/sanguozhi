444","zhanggu-q-5979a844ea9f6cc50318","zhanggu-q-3daa3c56b9872fdc7a53"]}]}],"evidence":[{"id":"pangfa-e-o003b-q","section":"chapter-037","block":"b-906efa25edd07a3c9958","layer":"original","quote":"吴人多闻其名，及当西还，并会昌门〖11〗：陆绩、顾邵、全琮皆往〖12〗。统曰：“陆子可谓驽马有逸足之力〖13〗，顾子可谓驽牛能负重致远也。”﹝二﹞谓全琮曰：“卿好施慕名〖14〗，有似汝南樊子昭；﹝三﹞虽智力不多，亦一时之佳也。”绩、邵谓统曰：“使天下太平〖15〗，当与卿共料四海之士〖16〗。”深与统相结而还。","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":3,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":27,"end":182,"offset_unit":"unicode_code_point"},{"id":"pangfa-e-p002a-q","section":"chapter-037","block":"b-61b9797ee634a05e0eec","layer":"pei","quote":"或问统曰：‘如所目，陆子为胜乎？’统曰：‘驽马虽精，所致一人耳；驽牛一日行三十里，所致岂一人之重哉！’邵就统宿，语，因问：‘卿名知人，吾与卿孰愈？’统曰：‘陶冶世俗，甄综人物，吾不及卿；论帝王之秘策，揽倚伏之要最，吾似有一日之长。’邵安其言而亲之。”","attribution":"张勃《吴录》","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":23,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-084422541bf4a70a5315","start":12,"end":137,"offset_unit":"unicode_code_point"},{"id":"pangfa-q-o003","section":"chapter-037","block":"b-906efa25edd07a3c9958","layer":"original","quote":"吴将周瑜助先主取荆州，因领南郡太守。瑜卒，统送丧至吴。吴人多闻其名，及当西还，并会昌门〖11〗：陆绩、顾邵、全琮皆往〖12〗。统曰：“陆子可谓驽马有逸足之力〖13〗，顾子可谓驽牛能负重致远也。”﹝二﹞谓全琮曰：“卿好施慕名〖14〗，有似汝南樊子昭；﹝三﹞虽智力不多，亦一时之佳也。”绩、邵谓统曰：“使天下太平〖15〗，当与卿共料四海之士〖16〗。”深与统相结而还。","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":3,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":182,"offset_unit":"unicode_code_point"},{"id":"pangfa-q-p002","section":"chapter-037","block":"b-61b9797ee634a05e0eec","layer":"pei","quote":"﹝二﹞张勃《吴录》曰：“或问统曰：‘如所目，陆子为胜乎？’统曰：‘驽马虽精，所致一人耳；驽牛一日行三十里，所致岂一人之重哉！’邵就统宿，语，因问：‘卿名知人，吾与卿孰愈？’统曰：‘陶冶世俗，甄综人物，吾不及卿；论帝王之秘策，揽倚伏之要最，吾似有一日之长。’邵安其言而亲之。”","attribution":"张勃《吴录》","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":23,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-084422541bf4a70a5315","start":0,"end":137,"offset_unit":"unicode_code_point"},{"id":"zhanggu-q-0596c31ce6387ff34892","section":"chapter-052","block":"b-b150f524fed4051c8a1a","layer":"original","quote":"当世君子能不然者，亦比有之〖2〗，岂独古人乎？然论其绝异，未若顾豫章、诸葛使君、步丞相、严卫尉、张奋威之为美也〖3〗。《论语》言“夫子恂恂然善诱人〖4〗”，又曰“成人之美，不成人之恶”：豫章有之矣。“望之俨然〖5〗，即之也温〖6〗，听其言也厉〖7〗”：使君体之矣〖8〗。“恭而安〖9〗，威而不猛”：丞相履之矣。学不求禄，心无苟得〖10〗：卫尉、奋威蹈之矣。此五君者，虽德实有差〖11〗，轻重不同；至于趋舍大检〖12〗，不犯四者，俱一揆也〖13〗。","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":469,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":223,"offset_unit":"unicode_code_point"},{"id":"zhanggu-q-2d2de8dfc6ae3d7d3002","section":"chapter-052","block":"b-f4dc0db8646f2568e9c1","layer":"original","quote":"邵字孝则。博览书传，好乐人伦〖1〗。少与舅陆绩齐名〖2〗，而陆逊、张敦、卜静等皆亚焉。﹝一﹞自州郡庶几及四方人士，往来相见，或言议而去，或结厚而别：风声流闻，远近称之。权妻以策女。","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":173,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":90,"offset_unit":"unicode_code_point"},{"id":"zhanggu-q-3daa3c56b9872fdc7a53","section":"chapter-052","block":"b-60fc7c60c8160373a740","layer":"original","quote":"评曰：张昭受遗辅佐，功勋克举；忠謇方直，动不为己。而以严见惮〖1〗，以高见外；既不处宰相，又不登师保〖2〗；从容闾巷〖3〗，养老而已：以此明权之不及策也！顾雍依仗素业〖4〗，而将之智局〖5〗：故能究极荣位。诸葛瑾、步骘，并以德度规检，见器当世〖6〗；张承、顾邵，虚心长者，好尚人物；周昭之论，称之甚美：故详录焉。谭献纳在公，有忠贞之节；休、承修志，咸庶为善；爱恶相攻〖7〗，流播南裔〖8〗：哀哉！","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":519,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":198,"offset_unit":"unicode_code_point"},{"id":"zhanggu-q-529e4448a3c572f04f5c","section":"chapter-052","block":"b-f4dc0db8646f2568e9c1","layer":"original","quote":"自州郡庶几及四方人士，往来相见，或言议而去，或结厚而别：风声流闻，远近称之。权妻以策女","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":173,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":46,"end":89,"offset_unit":"unicode_code_point"},{"id":"zhanggu-q-55d57ae922cf7f838007","section":"chapter-052","block":"b-c195e655860b7fd17bee","layer":"original","quote":"在郡五年，卒官","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":176,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":7,"offset_unit":"unicode_code_point"},{"id":"zhanggu-q-5979a844ea9f6cc50318","section":"chapter-052","block":"b-741f7bb5edae3222195f","layer":"original","quote":"若乃经国家〖40〗，当军旅；于驰骛之际〖41〗，立霸王之功：此五〔君〕者未为过人。至其纯粹履道，求不苟得；升降当世，保全名行；邈然绝俗〖42〗，实有所师。故粗论其事，以示后之君子。","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":472,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":90,"offset_unit":"unicode_code_point"},{"id":"zhanggu-q-5f211045471a25fc2444","section":"chapter-052","block":"b-145a6f5a67c459da712d","layer":"original","quote":"昔丁谞出于孤家〖14〗，吾粲由于牧竖〖15〗；豫章扬其善，以并陆、全之列〖16〗：是以人无幽滞而风俗厚焉〖17〗。使君、丞相、卫尉三君，昔以布衣俱相友善〖18〗，诸论者因各叙其优劣：初，先卫尉，次丞相，而后（有）使君也。其后并事明主，经营世务〖19〗；出处之才有不同〖20〗，先后之名须反其初〖21〗：此世常人所决勤薄也〖22〗。至于三君分好〖23〗，卒无亏损，岂非古人交哉！又鲁横江昔杖万兵〖24〗，屯据陆口，当世之美业也；能与不能，孰不愿焉〖25〗？而横江既亡，卫尉应其选；自以才非将帅，深辞固让，终于不就。后徙九列〖26〗，迁典八座〖27〗；荣不足以自曜，禄不足以自奉。至于二君〖28〗，皆位为上将，穷富极贵。卫尉既无求欲，二君又不称荐；各守所志，保其名好。孔子曰：","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":470,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":336,"offset_unit":"unicode_code_point"},{"id":"zhanggu-q-7b81b64790332e4b5097","section":"chapter-052","block":"b-857456b1330134302938","layer":"original","quote":"年二十七，起家为豫章太守〖3〗。下车，祀先贤徐孺子之墓〖4〗，优待其后〖5〗；禁其淫祀非礼之祭者〖6〗。小吏资质佳者，辄令就学；择其先进，擢置右职〖7〗。举善以教，风化大行","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":174,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":86,"offset_unit":"unicode_code_point"},{"id":"zhanggu-q-c4873c8dcf9cf544ec1d","section":"chapter-052","block":"b-88ac1b3a4b744cc5260f","layer":"original","quote":"邵当之豫章，发在近路，值秉疾病；时送者百数，邵辞宾客曰：“张仲节有疾〖12〗，苦不能来别，恨不见之。暂还与诀〖13〗，诸君少时相待。”其留心下士，惟善所在，皆此类也","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":175,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":72,"end":154,"offset_unit":"unicode_code_point"},{"id":"zhanggu-q-c9f942188159de7cc6c2","section":"chapter-052","block":"b-88ac1b3a4b744cc5260f","layer":"original","quote":"初，钱唐丁谞出于役伍〖8〗，阳羡张秉生于庶民，乌程吾粲、云阳殷礼起乎微贱〖9〗。邵皆拔而友之，为立声誉","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":175,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":51,"offset_unit":"unicode_code_point"},{"id":"zhanggu-q-fa5d3849e98d1775c551","section":"chapter-052","block":"b-40d2513f76ca53756c05","layer":"original","quote":"长子邵，早卒；次子裕，有笃疾〖16〗；少子济嗣，无后，绝","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":147,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":28,"offset_unit":"unicode_code_point"},{"id":"zhouyu-e-o095d-q","section":"chapter-054","block":"b-97e085c3fdd1c21f6aa4","layer":"original","quote":"及豫章太守顾邵卒〖15〗，","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":448,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":47,"end":60,"offset_unit":"unicode_code_point"},{"id":"zhouyu-q-o095","section":"chapter-054","block":"b-97e085c3fdd1c21f6aa4","layer":"original","quote":"蒙少不修书传〖13〗，每陈大事，常口占为笺疏〖14〗。常以部曲事为江夏太守蔡遗所白，蒙无恨意。及豫章太守顾邵卒〖15〗，权问所用；蒙因荐遗，奉职佳吏〖16〗。权笑曰：“君欲为祁奚耶〖17〗？”于是用之。甘宁粗暴好杀，既尝失蒙意，又时违权令，权怒之。蒙辄陈请：“天下未定，斗将如宁难得：宜容忍之。”权遂厚宁，卒得其用。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":448,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":158,"offset_unit":"unicode_code_point"}],"profiles":{"zhouyu-p0061":{"fields":[{"id":"zhouyu-p0061-directory-courtesy","key":"courtesy","label":"字","text":"孝则","evidence":["zhanggu-q-2d2de8dfc6ae3d7d3002"]}],"directory":{"faction":"wu"}}},"directory_counts":{}}
