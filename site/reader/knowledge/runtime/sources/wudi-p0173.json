{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[],"persons":[{"id":"wudi-p0173","name":"夫差","evidence":["wudi-q-p057","wuzhu-q-p050"],"facts":[],"aliases":[],"mentions":[{"id":"wudi-m-p057-wudi-p0173","kind":"allusion","text":"祖系或典故提及","evidence":["wudi-q-p057"]},{"id":"wuzhu-m-p050-wudi-p0173","kind":"allusion","text":"祖系或典故提及","evidence":["wuzhu-q-p050"]}]}],"evidence":[{"id":"wudi-q-p057","section":"chapter-001","block":"b-2838883e884addfcb23e","layer":"pei","quote":"臣松之以为：史之记言，既多润色，故前载所述有非实者矣。后之作者又生意改之，于失实也，不亦弥远乎！凡孙盛制书，多用《左氏》以易旧文，如此者非一。嗟乎，后之学者将何取信哉？且魏武方以天下励志，而用夫差分死之言，尤非其类。","attribution":"裴松之按语","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":409,"anchor":null},"note_id":"n-af2044ff06809bacd596","start":0,"end":108},{"id":"wuzhu-q-p050","section":"chapter-047","block":"b-3719d2870548cb3c2646","layer":"pei","quote":"﹝二﹞昌门，吴西郭门。夫差所作。","attribution":"裴注地理释名","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":501,"anchor":null},"note_id":"n-cdb8996541dbd7684f73","start":0,"end":16}],"profiles":{},"directory_counts":{}}
