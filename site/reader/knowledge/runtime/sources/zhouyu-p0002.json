{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dongyuan-e-p048b","title":"士孙瑞历显官为大司农三老诸公辞让","accounts":[{"id":"dongyuan-e-p048b-account","label":"《三辅决录注》","text":"董卓诛后士孙瑞任大司农、国三老，诸公辞让于瑞。","evidence":["dongyuan-e-p048b-q"]}],"participants":[{"person":"dongyuan-p0009","role":"任官","evidence":["dongyuan-e-p048b-q"]},{"person":"zhouyu-p0002","role":"辞让","evidence":["dongyuan-e-p048b-q"]},{"person":"xianzhu-p0088","role":"辞让","evidence":["dongyuan-e-p048b-q"]},{"person":"dongyuan-p0099","role":"辞让","evidence":["dongyuan-e-p048b-q"]},{"person":"wendi-p0040","role":"辞让","evidence":["dongyuan-e-p048b-q"]},{"person":"wudi-p0153","role":"辞让","evidence":["dongyuan-e-p048b-q"]},{"person":"dongyuan-p0100","role":"辞让","evidence":["dongyuan-e-p048b-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-p048b-q"]},"ordering_evidence":"dongyuan-e-p048b-q","source_order":[6,179,"P048b"],"order":1591}],"persons":[{"id":"zhouyu-p0002","name":"周忠","evidence":["zhouyu-q-o001","xunyu-q-p051","dongyuan-e-p048b-q"],"facts":[{"id":"zhouyu-f0012","label":"官职","text":"汉太尉","evidence":["zhouyu-f0012-q"]}],"aliases":[],"mentions":[{"id":"zhouyu-m-o001-zhouyu-p0002","kind":"mention","text":"文中提及","evidence":["zhouyu-q-o001"]},{"id":"xunyu-m-p051-zhouyu-p0002","kind":"mention","text":"文中提及","evidence":["xunyu-q-p051"]},{"id":"dongyuan-m-p048-zhouyu-p0002","kind":"mention","text":"文中提及","evidence":["dongyuan-e-p048b-q"]}]}],"evidence":[{"id":"dongyuan-e-p048b-q","section":"chapter-006","block":"b-1abc43feb57659c26d5f","layer":"pei","quote":"仕历显位。卓既诛，迁大司农，为国三老。每三公缺，瑞常在选中。太尉周忠、皇甫嵩，司徒淳于嘉、赵温，司空杨彪、张喜等，为公，皆辞拜，让瑞。","attribution":"《三辅决录注》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":178,"anchor":null},"note_id":"n-e9356f73a1c3748952e5","start":63,"end":130},{"id":"xunyu-q-p051","section":"chapter-010","block":"b-5501ade0d985684b4d65","layer":"pei","quote":"﹝五﹞《献帝纪》曰：“天子既东，而李傕来追，王师败绩。司徒赵温、太常王伟、卫尉周忠、司隶荣邵，皆为傕所嫌；欲杀之，诩谓傕曰：‘此皆天子大臣，卿奈何害之？’傕乃止。”","attribution":"《献帝纪》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":296,"anchor":null},"note_id":"n-aed35970262df1b9d218","start":0,"end":82},{"id":"zhouyu-f0012-q","section":"chapter-054","block":"b-7e5b67e8fe855e34c562","layer":"original","quote":"景子忠〖3〗，皆为汉太尉。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":1,"anchor":null},"note_id":null,"start":23,"end":36},{"id":"zhouyu-q-o001","section":"chapter-054","block":"b-7e5b67e8fe855e34c562","layer":"original","quote":"周瑜字公瑾，庐江舒人也〖1〗。从祖父景〖2〗，景子忠〖3〗，皆为汉太尉。﹝一﹞父异，洛阳令。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":1,"anchor":null},"note_id":null,"start":0,"end":46}],"profiles":{},"directory_counts":{}}
