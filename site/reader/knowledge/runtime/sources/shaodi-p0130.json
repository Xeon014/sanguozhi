9574493e1edfa1a0b095"]}],"participants":[{"person":"shaodi-p0130","role":"接收孙皓所致印绶并遣使送孙皓","evidence":["santizhu-q-9574493e1edfa1a0b095"]},{"person":"shaodi-p0162","role":"致印绶于司马伷并被送往晋","evidence":["santizhu-q-9574493e1edfa1a0b095"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["santizhu-q-9574493e1edfa1a0b095"]},"ordering_evidence":"santizhu-q-9574493e1edfa1a0b095","source_order":[48,122,0],"order":8904}],"persons":[{"id":"shaodi-p0130","name":"司马伷","evidence":["shaodi-q-p045","santizhu-q-799b648f266474b6c257","santizhu-q-9574493e1edfa1a0b095","santizhu-q-e4e74308393a35a22bc8","zhangyan-q-b86fc7f04034d2681027","zhangyan-q-082f2bc2bca1364edb2a"],"facts":[],"aliases":[],"mentions":[{"id":"shaodi-m-p045-shaodi-p0130","kind":"mention","text":"文中提及","evidence":["shaodi-q-p045"]},{"id":"zhangyan-m-208053264cd60a9960ba","kind":"mention","text":"本篇原文记及司马伷，具体行动与称谓见引文。","evidence":["zhangyan-q-082f2bc2bca1364edb2a"]}]}],"evidence":[{"id":"atlas-close-q-wu-date","section":"chapter-048","block":"b-7e623d5c0070fc0c04d7","layer":"modern","quote":"〖1〗四年：天纪四年（公元 280）。","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":529,"anchor":null},"note_id":"n-ce3554cdfa6d4a10d8dc","start":0,"end":19},{"id":"atlas-close-q-wu-letter","section":"chapter-048","block":"b-494ea68636e86f3566e3","layer":"original","quote":"而王濬顺流将至，司马伷、王浑皆临近境。皓用光禄勋薛莹、中书令胡冲等计〖7〗，分遣使，奉书于濬、伷、浑曰：“昔汉室失统，九州分裂；先人因时，略有江南；遂分阻山川，与魏乖隔。今大晋龙兴，德覆四海；暗劣偷安，未喻天命。至于今者，猥烦六军；衡盖路次〖8〗，远临江渚。举国震惶，假息漏刻〖9〗；敢缘天朝，含弘光大。谨遣私署太常张夔等〖10〗，奉所佩印绶，委质请命。惟垂信纳，以济元元〖11〗。”﹝三﹞","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":523,"anchor":null},"note_id":null,"start":0,"end":195},{"id":"atlas-close-q-wu-surrender","section":"chapter-048","block":"b-c76b27d961ba7e5c15ed","layer":"original","quote":"（壬申）〔三月壬寅〕〖12〗，王濬最先到；于是受皓之降，解缚焚榇〖13〗，延请相见。﹝四﹞","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":524,"anchor":null},"note_id":null,"start":0,"end":45},{"id":"atlas-close-q-wu-year","section":"chapter-048","block":"b-6d9d569aba82d35ae0c8","layer":"original","quote":"四年春〖1〗，立中山、代等十一王〖2〗。大赦。","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":520,"anchor":null},"note_id":null,"start":0,"end":23},{"id":"major-proof-q-wu-letter","section":"chapter-053","block":"b-2039c8cd73aadf4de2e9","layer":"original","quote":"天纪四年，晋军征皓；皓奉书于司马伷、王浑、王濬请降：其文，莹所造也。","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":334,"anchor":null},"note_id":null,"start":44,"end":78},{"id":"santizhu-q-5e1ac8597c6e78a9cfc7","section":"chapter-048","block":"b-c76b27d961ba7e5c15ed","layer":"original","quote":"（壬申）〔三月壬寅〕〖12〗，王濬最先到；于是受皓之降，解缚焚榇〖13〗，延请相见","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":524,"anchor":null},"note_id":null,"start":0,"end":41},{"id":"santizhu-q-799b648f266474b6c257","section":"chapter-048","block":"b-bd2df9b2ac026100f1ff","layer":"original","quote":"冬，晋命镇东大将军司马伷向涂中〖23〗；安东将军王浑、扬州刺史周浚向牛渚〖24〗；建威将军王戎向武昌〖25〗；平南将军胡奋向夏口〖26〗；镇南〔大〕将军杜预向江陵〖27〗；龙骧将军王濬、广武将军唐彬浮江东下〖28〗；太尉贾充为大都督〖29〗，量宜处要，尽军势之中〖30〗","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":477,"anchor":null},"note_id":null,"start":0,"end":135},{"id":"santizhu-q-9574493e1edfa1a0b095","section":"chapter-048","block":"b-bdc91c75897c00a521d5","layer":"original","quote":"伷以皓致印绶于己，遣使送皓","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":525,"anchor":null},"note_id":null,"start":0,"end":13},{"id":"santizhu-q-e4e74308393a35a22bc8","section":"chapter-048","block":"b-494ea68636e86f3566e3","layer":"original","quote":"而王濬顺流将至，司马伷、王浑皆临近境。皓用光禄勋薛莹、中书令胡冲等计〖7〗，分遣使，奉书于濬、伷、浑曰：“昔汉室失统，九州分裂；先人因时，略有江南；遂分阻山川，与魏乖隔。今大晋龙兴，德覆四海；暗劣偷安，未喻天命。至于今者，猥烦六军；衡盖路次〖8〗，远临江渚。举国震惶，假息漏刻〖9〗；敢缘天朝，含弘光大。谨遣私署太常张夔等〖10〗，奉所佩印绶，委质请命","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":523,"anchor":null},"note_id":null,"start":0,"end":176},{"id":"shaodi-e-p045c-q","section":"chapter-004","block":"b-7b9a7d8c7e1e41d12750","layer":"pei","quote":"﹝一﹞《汉晋春秋》曰：“帝见威权日去，不胜其忿。乃召侍中王沈、尚书王经、散骑常侍王业，谓曰：‘司马昭之心，路人所知也！吾不能坐受废辱！今日当与卿自出讨之。’王经曰：‘昔鲁昭公不忍季氏，败走失国，为天下笑。今权在其门，为日久矣。朝廷四方皆为之致死，不顾逆顺之理，非一日也。且宿卫空阙，兵甲寡弱，陛下何所资用？而一旦如此，无乃欲除疾而更深之邪？祸殆不测，宜见重详！’帝乃出怀中版令投地，曰：‘行之决矣！正使死，何所惧？况不必死邪！’于是入白太后。沈、业奔走告文王，文王为之备。帝遂帅僮仆数百，鼓噪而出。文王弟屯骑校尉伷入，遇帝于东止车门，左右呵之，伷众奔走。中护军贾充又逆帝，战于南阙下。帝自用剑，众欲退。太子舍人成济问充曰：‘事急矣。当云何？’充曰：‘畜养汝等，正谓今日！今日之事，无所问也！’济即前刺帝，刃出于背。文王闻，大惊，自投于地曰：‘天下其谓我何！’太傅孚奔往，枕帝股而哭，哀甚。曰：‘杀陛下者，臣之罪也！’”","attribution":"《汉晋春秋》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":72,"anchor":null},"note_id":"n-74646ac2cf964244648d","start":0,"end":409},{"id":"shaodi-q-b-77066dd061eb6a338ffa","section":"chapter-004","block":"b-77066dd061eb6a338ffa","layer":"modern","quote":"〖1〗五年：甘露五年（公元 260 ）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":50,"anchor":null},"note_id":"n-21e90e29c9fd438bba21","start":0,"end":20},{"id":"shaodi-q-o139","section":"chapter-004","block":"b-c33fc441ae4a3de17fb6","layer":"original","quote":"五年春正月朔〖1〗，日有食之。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":45,"anchor":null},"note_id":null,"start":0,"end":15},{"id":"shaodi-q-p045","section":"chapter-004","block":"b-7b9a7d8c7e1e41d12750","layer":"pei","quote":"﹝一﹞《汉晋春秋》曰：“帝见威权日去，不胜其忿。乃召侍中王沈、尚书王经、散骑常侍王业，谓曰：‘司马昭之心，路人所知也！吾不能坐受废辱！今日当与卿自出讨之。’王经曰：‘昔鲁昭公不忍季氏，败走失国，为天下笑。今权在其门，为日久矣。朝廷四方皆为之致死，不顾逆顺之理，非一日也。且宿卫空阙，兵甲寡弱，陛下何所资用？而一旦如此，无乃欲除疾而更深之邪？祸殆不测，宜见重详！’帝乃出怀中版令投地，曰：‘行之决矣！正使死，何所惧？况不必死邪！’于是入白太后。沈、业奔走告文王，文王为之备。帝遂帅僮仆数百，鼓噪而出。文王弟屯骑校尉伷入，遇帝于东止车门，左右呵之，伷众奔走。中护军贾充又逆帝，战于南阙下。帝自用剑，众欲退。太子舍人成济问充曰：‘事急矣。当云何？’充曰：‘畜养汝等，正谓今日！今日之事，无所问也！’济即前刺帝，刃出于背。文王闻，大惊，自投于地曰：‘天下其谓我何！’太傅孚奔往，枕帝股而哭，哀甚。曰：‘杀陛下者，臣之罪也！’”","attribution":"《汉晋春秋》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":72,"anchor":null},"note_id":"n-74646ac2cf964244648d","start":0,"end":409},{"id":"zhangyan-q-082f2bc2bca1364edb2a","section":"chapter-053","block":"b-2039c8cd73aadf4de2e9","layer":"original","quote":"是时法政多谬，举措烦苛；莹每上便宜〖20〗，陈缓刑简役，以济育百姓：事或施行。迁光禄勋。天纪四年，晋军征皓；皓奉书于司马伷、王浑、王濬请降：其文，莹所造也。","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":334,"anchor":null},"note_id":null,"start":0,"end":78},{"id":"zhangyan-q-b86fc7f04034d2681027","section":"chapter-053","block":"b-2039c8cd73aadf4de2e9","layer":"original","quote":"皓奉书于司马伷、王浑、王濬请降：其文，莹所造也","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":334,"anchor":null},"note_id":null,"start":54,"end":77}],"profiles":{},"directory_counts":{}}
