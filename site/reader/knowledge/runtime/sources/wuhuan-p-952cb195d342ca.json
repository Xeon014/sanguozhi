t":69,"end":82,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-29a85aad39fa02b66c08","section":"chapter-030","block":"b-913e4b4dc1858efb4f54","layer":"original","quote":"夫余本属玄菟。汉末，公孙度雄张海东〖21〗，威服外夷；夫余王尉仇台更属辽东。时句丽、鲜卑强〖22〗，度以夫余在二虏之间，妻以宗女〖23〗。尉仇台死，〔至孙〕简位居立。无適子〖24〗，有孽子麻余〖25〗。位居死，诸加共立麻余。牛加兄子名位居，为大使；轻财善施，国人附之，岁岁遣使诣京都贡献。","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":142,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":144,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-9703c61acd1b63775777","section":"chapter-030","block":"b-913e4b4dc1858efb4f54","layer":"original","quote":"位居死，诸加共立麻余","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":142,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":101,"end":111,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
