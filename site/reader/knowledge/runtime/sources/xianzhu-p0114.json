251512cc0e8809","erfei-q-284b13ca7d16e7834b19","erfei-q-06d38f7248bc6caa2f9e","erfei-q2-5891323d029ef85a67aa"],"facts":[{"id":"xianzhu-f0032","label":"封号","text":"梁王","evidence":["xianzhu-f0032-q"]},{"id":"erfei-f2-1b8ef4fbdb24a74e32ab","text":"刘理字奉孝，与刘永异母；为后主庶弟。","evidence":["erfei-q2-5891323d029ef85a67aa"]}],"aliases":[],"mentions":[{"id":"xianzhu-m-o066-xianzhu-p0114","kind":"mention","text":"文中提及","evidence":["xianzhu-q-o066"]},{"id":"guanzhang-m-o035-xianzhu-p0114","kind":"mention","text":"文中提及","evidence":["guanzhang-q-o035"]},{"id":"houzhu-m-houzhu-q-O021-xianzhu-p0114","kind":"mention","text":"文中提及","evidence":["houzhu-q-O021"]},{"id":"houzhu-m-houzhu-q-O044-xianzhu-p0114","kind":"mention","text":"文中提及","evidence":["houzhu-q-O044"]}]}],"evidence":[{"id":"erfei-q-06d38f7248bc6caa2f9e","section":"chapter-034","block":"b-ebbe05c85e6433b7bc52","layer":"original","quote":"延熙七年卒，谥曰悼王","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":81,"anchor":null},"note_id":null,"start":0,"end":10},{"id":"erfei-q-284b13ca7d16e7834b19","section":"chapter-034","block":"b-04a5ef8a760dfbd48eb4","layer":"original","quote":"建兴八年，改封理为安平王","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":80,"anchor":null},"note_id":null,"start":0,"end":12},{"id":"erfei-q-9a3af67d92e7eb56630f","section":"chapter-034","block":"b-f32c94405104cd60952a","layer":"original","quote":"建兴八年，改封为甘陵王","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":62,"anchor":null},"note_id":null,"start":0,"end":11},{"id":"erfei-q-c3c569251512cc0e8809","section":"chapter-034","block":"b-ba53693076b6b95703b6","layer":"original","quote":"章武元年六月，使司徒靖立理为梁王","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":79,"anchor":null},"note_id":null,"start":18,"end":34},{"id":"erfei-q2-5891323d029ef85a67aa","section":"chapter-034","block":"b-ba53693076b6b95703b6","layer":"original","quote":"刘理字奉孝。亦后主庶弟也，与永异母。章武元年六月，使司徒靖立理为梁王。策曰：“小子理：朕统承汉序，祗顺天命。遵修典秩〖1〗，建尔于东，为汉藩辅。惟彼梁土，畿甸之邦〖2〗；民狎教化〖3〗，易导以礼。往悉乃心〖4〗，怀保黎庶〖5〗，以永尔国。王其敬之哉！”","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":79,"anchor":null},"note_id":null,"start":0,"end":126},{"id":"guanzhang-e-o035b-q","section":"chapter-036","block":"b-40b37903b6de145c9576","layer":"original","quote":"超女，配安平王理〖17〗。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":144,"anchor":null},"note_id":null,"start":25,"end":38},{"id":"guanzhang-q-o035","section":"chapter-036","block":"b-40b37903b6de145c9576","layer":"original","quote":"追谥超曰威侯，子承嗣。岱位至平北将军，进爵陈仓侯。超女，配安平王理〖17〗。﹝二﹞","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":144,"anchor":null},"note_id":null,"start":0,"end":41},{"id":"houzhu-q-O021","section":"chapter-033","block":"b-5ba39d4009c0b73e0bbd","layer":"original","quote":"八年秋，魏使司马懿由西城，张郃由子午，曹真由斜谷：﹝一﹞欲攻汉中。丞相亮待之于城固赤坂〖5〗。大雨道绝，真等皆还。是岁，魏延破魏雍州刺史郭淮于阳溪〖6〗。徙鲁王永为甘陵王，梁王理为安平王；皆以鲁、梁在吴分界故也〖7〗。","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":53,"anchor":null},"note_id":null,"start":0,"end":109},{"id":"houzhu-q-O044","section":"chapter-033","block":"b-39a107def4ece77ffbe8","layer":"original","quote":"夏四月，安平王理卒。","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":102,"anchor":null},"note_id":null,"start":0,"end":10},{"id":"xianzhu-e-o066e-q","section":"chapter-032","block":"b-9899314a2556743b9f4b","layer":"original","quote":"六月，以子永为鲁王〖3〗，理为梁王〖4〗。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":399,"anchor":null},"note_id":null,"start":69,"end":90},{"id":"xianzhu-f0032-q","section":"chapter-032","block":"b-9899314a2556743b9f4b","layer":"original","quote":"六月，以子永为鲁王〖3〗，理为梁王〖4〗。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":399,"anchor":null},"note_id":null,"start":69,"end":90},{"id":"xianzhu-q-b-7396ee3085c96d5be06c","section":"chapter-032","block":"b-7396ee3085c96d5be06c","layer":"modern","quote":"〖22〗建安二十六年：公元 221 年。建安年号到二十四年为止。刘备不承认曹魏的年号，所以继续以建安年号记年。丙午：阴历初六日。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":380,"anchor":null},"note_id":"n-dce0e27ac9260548c4b5","start":0,"end":64},{"id":"xianzhu-q-o065","section":"chapter-032","block":"b-3ec28bd830861da89fc0","layer":"original","quote":"即皇帝位于成都武担之南〖21〗，﹝一﹞为文曰：“惟建安二十六年四月丙午〖22〗，皇帝〔臣〕备，敢用玄牡〖23〗，昭告皇天上帝、后土神祇：汉有天下，历数无疆。曩者王莽篡盗〖24〗，光武皇帝震怒致诛，社稷复存。今曹操阻兵安忍〖25〗，戮杀主后；滔天泯夏〖26〗，罔顾天显〖27〗。操子丕，载其凶逆〖28〗，窃居神器。群臣将士以为社稷坠废，备宜修之；嗣武二祖〖29〗，龚行天罚。备惟否德〖30〗，惧忝帝位〖31〗；询于庶民，外及蛮夷君长，佥曰：‘天命不可以不答，祖业不可以久替，四海不可以无主；率土式望〖32〗，在备一人。’备畏天明命，又惧汉阼将湮于地；谨择元日〖33〗，与百僚登坛，受皇帝玺绶；修燔瘗〖34〗，告类于大神〖35〗。惟神〔尚〕飨〖36〗！祚于汉家，永绥四海〖37〗！”﹝二﹞","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":357,"anchor":null},"note_id":null,"start":0,"end":342},{"id":"xianzhu-q-o066","section":"chapter-032","block":"b-9899314a2556743b9f4b","layer":"original","quote":"章武元年夏四月，大赦，改年。以诸葛亮为丞相，许靖为司徒，置百官；立宗庙，祫祭高皇帝以下〖1〗。﹝一﹞五月，立皇后吴氏〖2〗，子禅为皇太子。六月，以子永为鲁王〖3〗，理为梁王〖4〗。车骑将军张飞为其左右所害。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":399,"anchor":null},"note_id":null,"start":0,"end":103}],"profiles":{"xianzhu-p0114":{"fields":[],"directory":{"faction":"shu"}}},"directory_counts":{}}
