公孙度、康、恭前后所资遗，既已西渡，尽封还之；曰废嫡立庶下有异心乱之所由起也，乃将家属乘海即受征，在辽东积三十七年乃归；海中遇暴风船皆没唯其乘船自若，望火光趋之得岛，行人咸异以为神光之祐","evidence":["yuanzhang-q-870cd6af7bf3c206c73f","yuanzhang-q-d001cc765ba4361532f4","yuanzhang-q-ea624a9e4f8c6e81ea55","yuanzhang-q-87d4f9c5b0e3f715babb","yuanzhang-q-093b09c6157e1c3a725a"]},{"person":"wendi-p0015","role":"送之南郊，加赠服物；康弟，懦弱，被立","evidence":["yuanzhang-q-d001cc765ba4361532f4","yuanzhang-q-87d4f9c5b0e3f715babb"]},{"person":"wudi-p0247","role":"已死","evidence":["yuanzhang-q-87d4f9c5b0e3f715babb"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["yuanzhang-q-870cd6af7bf3c206c73f","yuanzhang-q-d001cc765ba4361532f4","yuanzhang-q-ea624a9e4f8c6e81ea55","yuanzhang-q-87d4f9c5b0e3f715babb","yuanzhang-q-093b09c6157e1c3a725a"]},"ordering_evidence":"yuanzhang-q-870cd6af7bf3c206c73f","source_order":[11,368,0],"order":2660},{"id":"mantian-e-o118","title":"公孙康遣韩忠赍单于印绶假峭王","accounts":[{"id":"mantian-a-a28ffe6abe7eec1eb8e7","label":"正文","text":"公孙康遣韩忠赍单于印绶假峭王","evidence":["mantian-q-773a23cc09b51c6e202f"]}],"participants":[{"person":"wudi-p0247","role":"辽东太守、自称平州牧、遣使韩忠赍单于印绶往假峭王","evidence":["mantian-q-773a23cc09b51c6e202f"]},{"person":"mantian-p0055","role":"奉遣赍印绶","evidence":["mantian-q-773a23cc09b51c6e202f"]},{"person":"mantian-p0009","role":"严、以五千骑当遣诣谭、被假单于印绶者、大会群长","evidence":["mantian-q-773a23cc09b51c6e202f"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["mantian-q-773a23cc09b51c6e202f"]},"ordering_evidence":"mantian-q-773a23cc09b51c6e202f","source_order":[26,214,65],"order":5218},{"id":"wuhuan-e-f2b7b0c0e1d70a68faff","title":"建安中公孙康出军击高句丽，破其国，焚烧邑落","accounts":[{"id":"wuhuan-a-f2b7b0c0e1d70a68faff","label":"正文","text":"建安中公孙康出军击高句丽，破其国，焚烧邑落","evidence":["wuhuan-q-b9025c3ff96003d63403"]}],"participants":[{"person":"wudi-p0247","role":"出军击句丽、破其国、焚烧邑落者","evidence":["wuhuan-q-b9025c3ff96003d63403"]}],"place":null,"time":{"label":"建安中","precisi