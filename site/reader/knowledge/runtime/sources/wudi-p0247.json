ba4d679ab8"]}]}],"evidence":[{"id":"dongyuan-e-o067a-q","section":"chapter-006","block":"b-893eb6895390377ea179","layer":"original","quote":"十二年，太祖至辽西，击乌丸。尚、熙与乌丸，逆军战，败走奔辽东。公孙康诱斩之，送其首。﹝二﹞","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":374,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":45,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p097a-q","section":"chapter-006","block":"b-f46b09acc3c0c8c8d7a9","layer":"pei","quote":"﹝二﹞《典略》曰：“尚为人有勇力，欲夺取康众。与熙谋曰：‘今到，康必相见；欲与兄手击之，有辽东，犹可以自广也。’康亦心计曰：‘今不取熙、尚，无以为说于国家。’乃先置其精勇于厩中，然后请熙、尚。熙、尚入，康伏兵出，皆缚之。坐于冻地，尚寒，求席。（熙）〔康〕曰：‘头颅方行万里，何席之为！’遂斩首。”","attribution":"《典略》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":385,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-875885dc65143abcb0d9","start":0,"end":148,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o067","section":"chapter-006","block":"b-893eb6895390377ea179","layer":"original","quote":"十二年，太祖至辽西，击乌丸。尚、熙与乌丸，逆军战，败走奔辽东。公孙康诱斩之，送其首。﹝二﹞","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":374,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":45,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p097","section":"chapter-006","block":"b-f46b09acc3c0c8c8d7a9","layer":"pei","quote":"﹝二﹞《典略》曰：“尚为人有勇力，欲夺取康众。与熙谋曰：‘今到，康必相见；欲与兄手击之，有辽东，犹可以自广也。’康亦心计曰：‘今不取熙、尚，无以为说于国家。’乃先置其精勇于厩中，然后请熙、尚。熙、尚入，康伏兵出，皆缚之。坐于冻地，尚寒，求席。（熙）〔康〕曰：‘头颅方行万里，何席之为！’遂斩首。”","attribution":"《典略》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":385,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-875885dc65143abcb0d9","start":0,"end":148,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-3dfda7291a97e1e462c4","section":"chapter-008","block":"b-32cde7e21d373e6d01d7","layer":"original","quote":"度死，子康嗣位，以永宁乡侯封弟恭。是岁，建安九年也","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":191,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":25,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-592c8f6c69633726cb91","section":"chapter-008","block":"b-b23d1c1ba3f807309a47","layer":"pei","quote":"臣父康，昔杀权使，结为仇隙。今乃谲欺，遣使诱致；令权倾心，虚国竭禄，远命上卿，宠授极位，震动南土，备尽礼数。又权待舒、综，契阔委曲；君臣上下，毕欢竭情。而令四使见杀，枭示万里；士众流离，屠戮津渚；惭耻远布，痛辱弥天；权之怨疾，将刻肌骨。若天衰其业，使至丧陨，权将内伤愤激而死。若期运未讫，将播毒螫，必恐长蛇来为寇害。徐州诸屯及城阳诸郡，与相接近。如有船众，后年向海门，得其消息，乞速告臣","attribution":"裴注·魏略","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":223,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-14d174739835bc97c008","start":4,"end":197,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-9199d23a0fba4d679ab8","section":"chapter-008","block":"b-214838e0d91a327bae94","layer":"pei","quote":"公孙渊，昔年敢违王命，废绝计贡者，实挟两端：既恃阻险，又怙孙权；故敢跋扈，恣睢海外。宿舒亲见贼权军众府库，知其弱少不足凭恃，是以决计斩贼之使。又高句丽、濊貊与渊为仇，并为寇抄。今外失吴援，内有胡寇；心知国家能从陆道，势不得不怀惶惧之心。因斯之时，宜遣使示以祸福。奉车都尉鬷弘，武皇帝时始奉使命，开通道路；文皇帝即位，欲通使命，遣弘将妻子还归乡里，赐其车、牛，绢百匹。弘以受恩，归死国期，无有还意；乞留妻子，身奉使命。公孙康遂称臣妾，以弘奉使称意，赐爵关内侯。弘性果烈，乃心于国，夙夜拳拳，念自竭效；冠族子孙，少好学问，博通书记，多所关涉，口论速捷，辩而不俗，附依典诰，若出胸臆；加仕本郡，常在人右，彼方士人素所敬服。若当遣使，以为可使弘行。弘乃自旧土，习其国俗；为说利害，辩足以动其意，明足以见其事，才足以行之，辞足以见信。若其计从，虽郦生之降齐王，陆贾之说尉佗，亦无以远过也。欲进远路，不宜释骐骥；将已笃疾，不宜废扁鹊。愿察愚言也","attribution":"裴注·魏名臣奏","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":226,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8a1400a8bbd3ac2228a7","start":20,"end":436,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-9b68f6a8b6bb8a667f33","section":"chapter-008","block":"b-d9c910b62671c4a10be3","layer":"original","quote":"文帝践阼，遣使即拜恭为车骑将军，假节，封平郭侯；追赠康大司马","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":192,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":20,"end":50,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-ba0bf752c4b5829a22a4","section":"chapter-008","block":"b-d9c910b62671c4a10be3","layer":"original","quote":"康死，子晃、渊等皆小，众立恭为辽东太守","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":192,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-cfa6d629b8b47b2f49ed","section":"chapter-008","block":"b-32cde7e21d373e6d01d7","layer":"original","quote":"十二年〖1〗，太祖征三郡乌丸，屠柳城。袁尚等奔辽东，康斩送尚首。语在《武纪》。封康襄平侯，拜左将军","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":191,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":26,"end":75,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-f7fb013a4539624c60b2","section":"chapter-008","block":"b-9b100edc000c32804ff5","layer":"original","quote":"先时，属国公孙昭守襄平令〖5〗，召度子康为伍长〖6〗。度到官，收昭，笞杀于襄平市","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":164,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":33,"end":73,"offset_unit":"unicode_code_point"},{"id":"mantian-q-773a23cc09b51c6e202f","section":"chapter-026","block":"b-6205b7b45e89110835ff","layer":"original","quote":"又辽东太守公孙康自称平州牧〖3〗，遣使韩忠赍单于印绶往假峭王。峭王大会群长〖4〗，忠亦在坐","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":213,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":65,"end":110,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o117b-q","section":"chapter-001","block":"b-3982d5aa554a26f2c3db","layer":"original","quote":"康即斩尚、熙及速仆丸等，传其首。诸将或问：“公还而康斩送尚、熙，何也？”公曰：“彼素畏尚等，吾急之则并力，缓之则自相图；其势然也。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":636,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":14,"end":79,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-fbc277caaf5ad8b958df","section":"chapter-001","block":"b-fbc277caaf5ad8b958df","layer":"modern","quote":"〖1〗十二年：建安十二年（公元 207）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":623,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-20efb4f3aff50357a189","start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o111","section":"chapter-001","block":"b-01eaf58b917a530c61d5","layer":"original","quote":"十二年春二月〖1〗，公自淳于还邺。丁酉〖2〗，令曰：“吾起义兵诛暴乱，于今十九年；所征必克，岂吾功哉？乃贤士大夫之力也！天下虽未悉定，吾当要与贤士大夫共定之；而专享其劳〖3〗，吾何以安焉？其促定功行封〖4〗。”于是大封功臣二十余人，皆为列侯；其余各以次受封；及复死事之孤〖5〗：轻重各有差〖6〗。﹝一﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":621,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":151,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o116","section":"chapter-001","block":"b-8e4c7f6cc2694c02bfab","layer":"original","quote":"初，辽东太守公孙康恃远不服〖18〗。及公破乌丸，或说公遂征之，尚兄弟可擒也。公曰：“吾方使康斩送尚、熙首，不烦兵矣！”","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":635,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":59,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o117","section":"chapter-001","block":"b-3982d5aa554a26f2c3db","layer":"original","quote":"九月，公引兵自柳城还。﹝一﹞康即斩尚、熙及速仆丸等，传其首。诸将或问：“公还而康斩送尚、熙，何也？”公曰：“彼素畏尚等，吾急之则并力，缓之则自相图；其势然也。”","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":636,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":80,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-1091895f20e3f56f2897","section":"chapter-030","block":"b-7b33f9a9408c8052b151","layer":"original","quote":"遣公孙模、张敞等收集遗民，兴兵伐韩、濊","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":310,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":23,"end":42,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-b9025c3ff96003d63403","section":"chapter-030","block":"b-ffc4a2c8b72ed79c4569","layer":"original","quote":"建安中，公孙康出军击之，破其国，焚烧邑落","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":191,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-cae0da15618832a27bd1","section":"chapter-030","block":"b-7b33f9a9408c8052b151","layer":"original","quote":"建安中，公孙康分屯有县以南荒地为带方郡","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":310,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-eb5808b148eb6d8febc0","section":"chapter-030","block":"b-ffc4a2c8b72ed79c4569","layer":"original","quote":"拔奇怨为兄而不得立，与涓奴加各将下户三万余口〖38〗，诣康降，还住沸流水","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":191,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":21,"end":57,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o011","section":"chapter-047","block":"b-f715dc33a31e617fe160","layer":"original","quote":"十二年〖31〗，西征黄祖，虏其人民而还。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":23,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-o006","section":"chapter-009","block":"b-9b0ef46552fe5fa7e211","layer":"original","quote":"建安十二年，录惇前后功，增封邑千八百户，并前二千五百户。二十一年，从征孙权。还，使惇都督二十六军〖6〗，留居巢；赐伎乐、名倡，令曰：“魏绛以和戎之功〖7〗，犹受金石之乐〖8〗，况将军乎！”二十四年，太祖军（击破吕布军）于摩陂，召惇常与同载；特见亲重，出入卧内〖9〗。诸将莫得比也。拜前将军，﹝二﹞督诸军还寿春，徙屯召陵。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":17,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":160,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-093b09c6157e1c3a725a","section":"chapter-011","block":"b-1157405894aaf96d21ad","layer":"pei","quote":"宁之归也，海中遇暴风；船皆没，唯宁乘船自若。时夜风晦冥，船人尽惑，莫知所泊。望见有火光，辄趋之，得岛。岛无居人，又无火烬；行人咸异焉，以为神光之祐也。皇甫谧曰：‘积善之应也","attribution":"裴注·傅子","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":449,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4555308644cb020df99a","start":134,"end":220,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-34572da0cb0069de028c","section":"chapter-011","block":"b-980722d8367b4a4376f3","layer":"original","quote":"辽东斩送袁尚首，令三军：“敢有哭之者，斩！”畴以尝为尚所辟，乃往吊祭。太祖亦不问","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":230,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":81,"end":121,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-3ba3654f9591bb797dac","section":"chapter-011","block":"b-1e77d6c23c1dd6d6ec82","layer":"pei","quote":"度庶子康，代居郡，外以将军、太守为号，而内实有王心；卑己崇礼，欲官宁以自镇辅；而终莫敢发言，其敬惮如此","attribution":"裴注·傅子","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":363,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4958052ff2433e6ba0c5","start":153,"end":204,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-870cd6af7bf3c206c73f","section":"chapter-011","block":"b-ce968cc1eb7efd4702c2","layer":"original","quote":"黄初四年，诏公卿举独行君子〖4〗。司徒华歆荐宁，文帝即（位）征宁","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":367,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":32,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-87d4f9c5b0e3f715babb","section":"chapter-011","block":"b-1157405894aaf96d21ad","layer":"pei","quote":"是时，康又已死，嫡子不立而立弟恭；恭懦弱，而康孽子渊有俊才。宁曰：‘废嫡立庶，下有异心，乱之所由起也。’乃将家属乘海即受征。宁在辽东，积三十七年乃归","attribution":"裴注·傅子","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":449,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4555308644cb020df99a","start":10,"end":84,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-9b16e2e766c9994eee03","section":"chapter-011","block":"b-c95cfb5d17dd1992e875","layer":"original","quote":"太祖为司空，辟宁；度子康绝命〖6〗，不宣","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":350,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":77,"end":97,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-d001cc765ba4361532f4","section":"chapter-011","block":"b-ce968cc1eb7efd4702c2","layer":"original","quote":"遂将家属，浮海还郡〖5〗；公孙恭送之南郊〖6〗，加赠服物","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":367,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":33,"end":61,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-ea624a9e4f8c6e81ea55","section":"chapter-011","block":"b-ce968cc1eb7efd4702c2","layer":"original","quote":"自宁之东也，度、康、恭前后所资遗，皆受而藏诸；既已西渡，尽封还之","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":367,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":65,"end":97,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q2-5c55926811b00d1b1965","section":"chapter-011","block":"b-ce968cc1eb7efd4702c2","layer":"original","quote":"黄初四年，诏公卿举独行君子〖4〗。司徒华歆荐宁，文帝即（位）征宁。遂将家属，浮海还郡〖5〗；公孙恭送之南郊〖6〗，加赠服物〖7〗。自宁之东也，度、康、恭前后所资遗，皆受而藏诸；既已西渡，尽封还之。﹝一﹞诏以宁为太中大夫，固辞不受。﹝二﹞","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":367,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":118,"offset_unit":"unicode_code_point"},{"id":"zhonghua-q-56166747e6635aa4db2c","section":"chapter-013","block":"b-a9855a57d7396cfcab6d","layer":"original","quote":"黄初中，诏公卿举独行君子；歆举管宁，帝以安东征之。","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":178,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":25,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-b-40accddaa1b32119c6cb","section":"chapter-035","block":"b-40accddaa1b32119c6cb","layer":"modern","quote":"〖39〗尔来：从那以来。这一句总括上文，所以是从刘备三顾时的建安十二年（公元 207）算起。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":198,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1692331886f906f52ea2","start":0,"end":46,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-o005","section":"chapter-035","block":"b-e33c66499df69116b2fc","layer":"original","quote":"由是先主遂诣亮；凡三往，乃见。因屏人曰〖1〗：“汉室倾颓，奸臣窃命〖2〗，主上蒙尘〖3〗。孤不度德量力〖4〗，欲信大义于天下〖5〗；而智术短浅，遂用猖獗〖6〗。至于今日，然志犹未已，君谓计将安出？”","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":30,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":99,"offset_unit":"unicode_code_point"}],"profiles":{"wudi-p0247":{"fields":[],"directory":{"faction":"qunxiong"}}},"directory_counts":{}}
