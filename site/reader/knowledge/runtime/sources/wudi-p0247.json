"yuanzhang-a-53cdf3b7767cba305c6d","label":"裴注·傅子","text":"公孙康死，嫡子不立而立弟恭；管宁曰废嫡立庶下有异心乱之所由起，乃将家属乘海即受征；宁在辽东积三十七年乃归","evidence":["yuanzhang-q-87d4f9c5b0e3f715babb"]},{"id":"yuanzhang-a-c38a0a660fd477f2c286","label":"裴注·傅子","text":"管宁归途海中遇暴风，船皆没唯宁乘船自若；夜风晦冥望见火光趋之得岛，岛无居人又无火烬，行人以为神光之祐；皇甫谧曰积善之应","evidence":["yuanzhang-q-093b09c6157e1c3a725a"]},{"id":"zhonghua-a-d78817710eba2b2dc5e8","label":"正文","text":"黄初中诏公卿举独行君子，华歆举管宁，帝以安东征之","evidence":["zhonghua-q-56166747e6635aa4db2c"]}],"participants":[{"person":"wudi-p0340","role":"为司徒，荐管宁","evidence":["yuanzhang-q-870cd6af7bf3c206c73f"]},{"person":"wudi-p0170","role":"即位征管宁","evidence":["yuanzhang-q-870cd6af7bf3c206c73f"]},{"person":"huanchen-p0600","role":"被荐被征；将家属浮海还郡；受而藏公孙度、康、恭前后所资遗，既已西渡，尽封还之；曰废嫡立庶下有异心乱之所由起也，乃将家属乘海即受征，在辽东积三十七年乃归；海中遇暴风船皆没唯其乘船自若，望火光趋之得岛，行人咸异以为神光之祐","evidence":["yuanzhang-q-870cd6af7bf3c206c73f","yuanzhang-q-d001cc765ba4361532f4","yuanzhang-q-ea624a9e4f8c6e81ea55","yuanzhang-q-87d4f9c5b0e3f715babb","yuanzhang-q-093b09c6157e1c3a725a"]},{"person":"wendi-p0015","role":"送之南郊，加赠服物；康弟，懦弱，被立","evidence":["yuanzhang-q-d001cc765ba4361532f4","yuanzhang-q-87d4f9c5b0e3f715babb"]},{"person":"wudi-p0247","role":"已死","evidence":["yuanzhang-q-87d4f9c5b0e3f715babb"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["yuanzhang-q-870cd6af7bf3c206c73f","yuanzhang-q-d001cc765ba4361532f4","yuanzhang-q-ea624a9e4f8c6e81ea55","yuanzhang-q-87d4f9c5b0e3f715babb","yuanzhang-q-093b09c6157e1c3a725a"]},"ordering_evidence":"yuanzhang-q-870cd6af7bf3c206c73f","source_order":[11,368,0],"order":2660},{"id":"mantian-e-o118","title":"公孙康遣韩忠赍单于印绶假峭王","accounts":[{"id":"mantian-a-a28ffe6abe7eec1eb8e7","label":"正文","text":"公孙康遣韩忠赍单于印绶假峭王","evidence":["mantian-q-773a23cc09b51c6e202f"]}],"participants":[{"person":"wudi-p0247","role":"辽东太守、自称平州牧、遣使韩忠赍单于印绶往假峭王","evidence":["mantian-q-773a23cc09b51c6e202f"]},{"person":"mantian-p0055","role":"奉遣赍印绶","evidence":["mantian-q-773a23cc09b51c6e202f"]},