{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[],"persons":[{"id":"yuanzhang-p2-heyun","name":"何恽（何桢子）","evidence":["yuanzhang-q2-fa68ad232bfd86ea8bcd"],"facts":[{"id":"yuanzhang-f2-f51627c22b6e689acc21","text":"何恽为何桢子，任豫州刺史。","evidence":["yuanzhang-q2-fa68ad232bfd86ea8bcd"]}],"aliases":[],"mentions":[]}],"evidence":[{"id":"yuanzhang-q2-fa68ad232bfd86ea8bcd","section":"chapter-011","block":"b-5bb6ca7d3ca70aa727d7","layer":"pei","quote":"﹝四﹞《文士传》曰：“桢字元幹，庐江人。有文学器干，容貌甚伟。历幽州刺史、廷尉；入晋为尚书、光禄大夫。桢子龛，后将军；勖，车骑将军；恽，豫州刺史；其余多至大官。自后累世昌阜，司空、文穆公充，恽之孙也，贵达至今。”","attribution":"裴注（引书见原文）","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":580,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9d16239470567f438e6a","start":0,"end":106,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
