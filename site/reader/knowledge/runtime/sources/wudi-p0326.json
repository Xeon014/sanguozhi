],"order":6892}],"persons":[{"id":"wudi-p0326","name":"赵衢","evidence":["wudi-q-o162","guanzhang-q-o029","xiahoucao-q-o015","dongyuan-q-o028","xinyang-q-9b9c59a1fd0649050ed3","xinyang-q-974e0fb588a9ccf19afa"],"facts":[],"aliases":[],"mentions":[{"id":"wudi-m-o162-wudi-p0326","kind":"mention","text":"文中提及","evidence":["wudi-q-o162"]},{"id":"guanzhang-m-o029-wudi-p0326","kind":"mention","text":"文中提及","evidence":["guanzhang-q-o029"]},{"id":"xiahoucao-m-o015-wudi-p0326","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-o015"]},{"id":"dongyuan-m-o028-wudi-p0326","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o028"]}]}],"evidence":[{"id":"dongyuan-e-o028c-q","section":"chapter-006","block":"b-406eca3adfa94582717f","layer":"original","quote":"赵衢等举义兵讨超，超走汉中从张鲁；","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":183,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":53,"end":70,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o028","section":"chapter-006","block":"b-406eca3adfa94582717f","layer":"original","quote":"十六年〖3〗，超与关中诸将及遂等反。太祖征破之。语在《武纪》。遂奔金城，为其将所杀。超据汉阳。腾坐夷三族。赵衢等举义兵讨超，超走汉中从张鲁；后奔刘备，死于蜀。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":183,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":79,"offset_unit":"unicode_code_point"},{"id":"guanzhang-e-o029a-q","section":"chapter-036","block":"b-84721df30150911d93e2","layer":"original","quote":"康故吏民杨阜、姜叙、梁宽、赵衢等〖15〗，合谋击超。阜、叙起于卤城，超出攻之，不能下；宽、衢闭冀城门，超不得入。进退狼狈，乃奔汉中依张鲁。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":114,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":69,"offset_unit":"unicode_code_point"},{"id":"guanzhang-q-o029","section":"chapter-036","block":"b-84721df30150911d93e2","layer":"original","quote":"康故吏民杨阜、姜叙、梁宽、赵衢等〖15〗，合谋击超。阜、叙起于卤城，超出攻之，不能下；宽、衢闭冀城门，超不得入。进退狼狈，乃奔汉中依张鲁。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":114,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":69,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o162a-q","section":"chapter-001","block":"b-7cda53694140f969edd1","layer":"original","quote":"南安赵衢、汉阳尹奉等，讨超，枭其妻子。超奔汉中。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":281,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":24,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-c4192d9fada3bef44302","section":"chapter-001","block":"b-c4192d9fada3bef44302","layer":"modern","quote":"〖1〗十九年：建安十九年（公元 214）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":293,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-e80ed93e01a75d2ad2bd","start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o161","section":"chapter-001","block":"b-ba55911420464ee82a49","layer":"original","quote":"十九年春正月〖1〗，始耕籍田〖2〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":280,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":18,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o162","section":"chapter-001","block":"b-7cda53694140f969edd1","layer":"original","quote":"南安赵衢、汉阳尹奉等，讨超，枭其妻子。超奔汉中。韩遂徙金城，入氐王千万部，率羌胡万余骑与夏侯渊战。击，大破之，遂走西平〖3〗。渊与诸将攻兴国，屠之。省安东、永阳郡〖4〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":281,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":85,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o015a-q","section":"chapter-009","block":"b-b8c87841b07ea6980a4a","layer":"original","quote":"十九年〖4〗，赵衢、尹奉等谋讨超，姜叙起兵卤城以应之〖5〗。衢等谲说超〖6〗，使出击叙；于后尽杀超妻子。超奔汉中，","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":60,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":57,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-b-b498a647e50cbea8388e","section":"chapter-009","block":"b-b498a647e50cbea8388e","layer":"modern","quote":"〖4〗十九年：建安十九年（公元 214）。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":66,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-046be76ee897a2f72015","start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-o015","section":"chapter-009","block":"b-b8c87841b07ea6980a4a","layer":"original","quote":"十九年〖4〗，赵衢、尹奉等谋讨超，姜叙起兵卤城以应之〖5〗。衢等谲说超〖6〗，使出击叙；于后尽杀超妻子。超奔汉中，还围祁山，叙等急求救。诸将议者，欲须太祖节度〖7〗。渊曰：“公在邺，反复四千里；比报〖8〗，叙等必败，非救急也！”遂行。使张郃督步骑五千，在前从陈仓狭道入〖9〗；渊自督粮，在后。郃至渭水上，超将氐羌数千逆郃；未战，超走，郃进军收超军器械。渊到，诸县皆已降。韩遂在显亲〖10〗；渊欲袭取之，遂走。渊收遂军粮，追至略阳城，去遂二十余里。诸将欲攻之，或言当攻兴国氐。渊以为：“遂兵精，兴国城固；攻不可猝拔。不如击长离诸羌〖11〗。长离诸羌，多在遂军；必归救其家。若〔舍〕羌独守则孤〖12〗，救长离则官兵得与野战，可必虏也。”渊乃留督将守辎重，轻兵步骑到长离。攻烧羌屯，斩获甚众。诸羌在遂军者，各还种落〖13〗。遂果救长离，与渊军对阵。诸将见遂众，恶之〖14〗，欲结营作堑乃与战。渊曰：“我转斗千里，今复作营堑，则士众疲惫，不可久。贼虽众，易与耳〖15〗！”乃鼓之，大破遂军。得其旌麾，还略阳，进军围兴国。氐王千万，逃奔马超，余众降。转击高平屠各〖16〗，皆散走，收其粮谷牛马。乃假渊节。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":60,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":497,"offset_unit":"unicode_code_point"},{"id":"xinyang-q-974e0fb588a9ccf19afa","section":"chapter-025","block":"b-9c7fd5f9389ce057a69e","layer":"original","quote":"超闻阜等兵起，自将出〖10〗。而衢、宽等解岳，闭冀城门，讨超妻子。","section_title":"辛毗杨阜高堂隆传第二十五","source":{"file":"OEBPS/Text/titlepage_0056.xhtml","index":150,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":33,"offset_unit":"unicode_code_point"},{"id":"xinyang-q-9b9c59a1fd0649050ed3","section":"chapter-025","block":"b-551c3ab6a5036b511895","layer":"original","quote":"叙母慨然，敕叙从阜计。计定，外与乡人姜隐、赵昂、尹奉、姚琼、孔信〖8〗，武都人李俊、王灵结谋，定讨超约；使从弟谟至冀，语岳；并结安定梁宽、南安赵衢、庞恭等。约誓既明，十（七）〔八〕年九月，与叙起兵于卤城〖9〗。","section_title":"辛毗杨阜高堂隆传第二十五","source":{"file":"OEBPS/Text/titlepage_0056.xhtml","index":149,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":105,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
