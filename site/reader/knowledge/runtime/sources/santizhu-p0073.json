c2569d5d36f768","start":70,"end":113,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-5b7cefe56f481c0ab74c","section":"chapter-048","block":"b-9d796ccbfbbd331d899e","layer":"original","quote":"宝鼎元年正月，遣大鸿胪张俨、五官中郎将丁忠吊祭晋文帝","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":346,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":26,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-8086c519c2f05d385090","section":"chapter-048","block":"b-e476f067c552bc43ab1d","layer":"pei","quote":"使于晋，皓谓俨曰：‘今南北通好，以君为有出境之才，故相屈行。’","attribution":"裴注·吴录","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":371,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6b2af9c2569d5d36f768","start":39,"end":70,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-8c8f8db2723f7d72ccdc","section":"chapter-048","block":"b-e476f067c552bc43ab1d","layer":"pei","quote":"尚书仆射羊祜、尚书何桢，并结缟带之好。","attribution":"裴注·吴录","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":371,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6b2af9c2569d5d36f768","start":146,"end":165,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-9bd404f7b7d73d7cb2e2","section":"chapter-048","block":"b-e476f067c552bc43ab1d","layer":"pei","quote":"既至，车骑将军贾充、尚书令裴秀、侍中荀勖等，欲傲以所不知而不能屈。","attribution":"裴注·吴录","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":371,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6b2af9c2569d5d36f768","start":113,"end":146,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-f21dd40b7100425f8101","section":"chapter-048","block":"b-9d796ccbfbbd331d899e","layer":"original","quote":"及还，俨道病死","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":346,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":30,"end":37,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-c20c42a0c7251ec2bef1","section":"chapter-056","block":"b-8b03e77ec4d976d2f885","layer":"pei","quote":"张惇子纯与张俨及异，俱童少，往见骠骑将军朱据。据闻三人才名，欲试之，告曰：‘老鄙相闻，饥渴甚矣！夫骠以迅骤为功，鹰隼以轻疾为妙。其为吾各赋一物，然后乃坐。’俨乃赋犬曰：‘守则有威，出则有获。韩卢、宋鹊，书名竹帛。’纯赋席曰：‘席以冬设，簟为夏施。揖让而坐，君子攸宜。’异赋弩曰：‘南岳之干，钟山之铜。应机命中，获隼高墉。’三人各随其目所见而赋之，皆成而后坐：据大欢悦","attribution":"裴注·文士传","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":294,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-718ca0bdd43c32f19b69","start":11,"end":194,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
