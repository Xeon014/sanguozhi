{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p155a","title":"曹操招引方术士","accounts":[{"id":"wudi-e-p155a-account","label":"张华《博物志》","text":"《博物志》记曹操招引左慈、华佗、甘始、郄俭等方术之士，皆来。","evidence":["wudi-e-p155a-q"]}],"participants":[{"person":"cao-cao","role":"招引","evidence":["wudi-e-p155a-q"]},{"person":"wudi-p0406","role":"来应","evidence":["wudi-e-p155a-q"]},{"person":"wudi-p0407","role":"来应","evidence":["wudi-e-p155a-q"]},{"person":"wudi-p0408","role":"来应","evidence":["wudi-e-p155a-q"]},{"person":"wudi-p0409","role":"来应","evidence":["wudi-e-p155a-q"]}],"place":null,"time":{"label":"生平补叙","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p155a-q"]},"source_order":[1,1135,"P155a"],"order":453}],"persons":[{"id":"wudi-p0409","name":"郄俭","evidence":["wudi-q-p155"],"facts":[],"aliases":[],"mentions":[{"id":"wudi-m-p155-wudi-p0409","kind":"mention","text":"文中提及","evidence":["wudi-q-p155"]}]}],"evidence":[{"id":"wudi-e-p155a-q","section":"chapter-001","block":"b-d76d672bc0848c8009df","layer":"pei","quote":"招引方术之士，庐江左慈、谯郡华佗、甘陵甘始、阳城郄俭，无不毕至。","attribution":"张华《博物志》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":459,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6c928ccff5d542bc3225","start":86,"end":118,"offset_unit":"unicode_code_point"},{"id":"wudi-q-p155","section":"chapter-001","block":"b-d76d672bc0848c8009df","layer":"pei","quote":"张华《博物志》曰：“汉世，安平崔瑗、瑗子寔，弘农张芝、芝弟昶，并善草书；而太祖亚之。桓谭、蔡邕善音乐，冯翊山子道、王九真、郭凯等善围棋；太祖皆与埒能。又好养性法，亦解方药。招引方术之士，庐江左慈、谯郡华佗、甘陵甘始、阳城郄俭，无不毕至。又习啖野葛至一尺，亦得少多饮鸩酒。”","attribution":"张华《博物志》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":459,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6c928ccff5d542bc3225","start":0,"end":136,"offset_unit":"unicode_code_point"}