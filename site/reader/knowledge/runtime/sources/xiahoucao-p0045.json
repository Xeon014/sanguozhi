:"xiahoucao-f0012","label":"亲属","text":"曹仁弟","evidence":["xiahoucao-f0012-q"]},{"id":"xiahoucao-f0013","label":"谥号","text":"威侯","evidence":["xiahoucao-f0013-q"]}],"aliases":[{"text":"子和","evidence":["xiahoucao-f0011-q"]}],"mentions":[{"id":"xiahoucao-m-o033-xiahoucao-p0045","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-o033"]},{"id":"xiahoucao-m-o034-xiahoucao-p0045","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-o034"]},{"id":"xiahoucao-m-p016-xiahoucao-p0045","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-p016"]},{"id":"xiahoucao-m-p017-xiahoucao-p0045","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-p017"]}]}],"evidence":[{"id":"erfei-q-09b8863c4a284ce3516a","section":"chapter-034","block":"b-c3b960c67d5476e63405","layer":"original","quote":"于时困逼，弃后及后主","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":1,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":75,"end":85,"offset_unit":"unicode_code_point"},{"id":"erfei-q-d4f3267ea1755b493f9d","section":"chapter-034","block":"b-c3b960c67d5476e63405","layer":"original","quote":"值曹公军至，追及先主于当阳长坂","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":1,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":59,"end":74,"offset_unit":"unicode_code_point"},{"id":"lizang-q-191e369b2d3f4e75595b","section":"chapter-018","block":"b-e9d18d4f862d319c0c25","layer":"original","quote":"授聘兵，使与曹纯追讨刘备于长坂","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":88,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":135,"end":150,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-888495d8be7766faf20c","section":"chapter-001","block":"b-888495d8be7766faf20c","layer":"modern","quote":"〖1〗十三年：建安十三年（公元 208）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":666,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0bae348fdb687025113d","start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o119","section":"chapter-001","block":"b-4bcffcc4ee709a4e5ea3","layer":"original","quote":"十三年春正月〖1〗，公还邺。作玄武池以肄舟师〖2〗。﹝一﹞汉罢三公官，置丞相、御史大夫〖3〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":661,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":47,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o019","section":"chapter-047","block":"b-bb7411f88ec45a0e6e99","layer":"original","quote":"十五年〖25〗，分豫章为鄱阳郡〖26〗；分长沙为汉昌郡〖27〗，以鲁肃为太守，屯陆口〖28〗。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":67,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":47,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o033a-q","section":"chapter-009","block":"b-7bb3311908283b52f710","layer":"original","quote":"仁弟纯。﹝一﹞初以议郎参司空军事〖1〗。督虎、豹骑从围南皮〖2〗，袁谭出战；士卒多死，太祖欲缓之。纯曰：“今千里蹈敌，进不能克，退必丧威；且悬师深入〖3〗，难以持久。彼胜而骄，我败而惧；以惧敌骄，必可克也！”太祖善其言，遂急攻之；谭败，纯麾下骑斩谭首。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":156,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":126,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o033b-q","section":"chapter-009","block":"b-7bb3311908283b52f710","layer":"original","quote":"及北征三郡，纯部骑获单于蹋顿。以前后功封高陵亭侯，邑三百户。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":156,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":126,"end":156,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o033c-q","section":"chapter-009","block":"b-7bb3311908283b52f710","layer":"original","quote":"从征荆州，追刘备于长坂〖4〗；获其二女、辎重，收其散卒。进降江陵，从还谯。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":156,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":156,"end":193,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o034a-q","section":"chapter-009","block":"b-bfaeac6ad2e91b732d04","layer":"original","quote":"建安十五年薨。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":157,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":7,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-p016a-q","section":"chapter-009","block":"b-1801cf006787581d94ec","layer":"pei","quote":"年十四而丧父，与同产兄仁别居。承父业，富于财，僮仆人客以百数；纯纲纪督御，不失其理，乡里咸以为能。好学问，敬爱学士，学士多归焉。由是为远近所称。","attribution":"《英雄记》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":164,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-35282ac00714a61a86a6","start":16,"end":88,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-p016b-q","section":"chapter-009","block":"b-1801cf006787581d94ec","layer":"pei","quote":"年十八，为黄门侍郎。二十，从太祖到襄邑募兵，遂常从征战。","attribution":"《英雄记》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":164,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-35282ac00714a61a86a6","start":88,"end":116,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-p017a-q","section":"chapter-009","block":"b-94a6a6f3fb411f808480","layer":"pei","quote":"纯所督虎、豹骑，皆天下骁锐，或从百人将补之。太祖难其帅，纯以选为督，抚循甚得人心。","attribution":"《魏书》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":165,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-d1b3badf40b22252a7e5","start":10,"end":51,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-f0011-q","section":"chapter-009","block":"b-1801cf006787581d94ec","layer":"pei","quote":"纯字子和","attribution":"《英雄记》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":164,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-35282ac00714a61a86a6","start":11,"end":15,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-f0012-q","section":"chapter-009","block":"b-7bb3311908283b52f710","layer":"original","quote":"仁弟纯","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":156,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":3,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-f0013-q","section":"chapter-009","block":"b-bfaeac6ad2e91b732d04","layer":"original","quote":"追谥曰威侯","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":157,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":12,"end":17,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-o033","section":"chapter-009","block":"b-7bb3311908283b52f710","layer":"original","quote":"仁弟纯。﹝一﹞初以议郎参司空军事〖1〗。督虎、豹骑从围南皮〖2〗，袁谭出战；士卒多死，太祖欲缓之。纯曰：“今千里蹈敌，进不能克，退必丧威；且悬师深入〖3〗，难以持久。彼胜而骄，我败而惧；以惧敌骄，必可克也！”太祖善其言，遂急攻之；谭败，纯麾下骑斩谭首。及北征三郡，纯部骑获单于蹋顿。以前后功封高陵亭侯，邑三百户。从征荆州，追刘备于长坂〖4〗；获其二女、辎重，收其散卒。进降江陵，从还谯。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":156,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":193,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-o034","section":"chapter-009","block":"b-bfaeac6ad2e91b732d04","layer":"original","quote":"建安十五年薨。文帝即位，追谥曰威侯。﹝二﹞子演嗣，官至领军将军。正元中，进封平乐乡侯。演薨，子亮嗣。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":157,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":50,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-p016","section":"chapter-009","block":"b-1801cf006787581d94ec","layer":"pei","quote":"﹝一﹞《英雄记》曰：“纯字子和。年十四而丧父，与同产兄仁别居。承父业，富于财，僮仆人客以百数；纯纲纪督御，不失其理，乡里咸以为能。好学问，敬爱学士，学士多归焉。由是为远近所称。年十八，为黄门侍郎。二十，从太祖到襄邑募兵，遂常从征战。”","attribution":"《英雄记》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":164,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-35282ac00714a61a86a6","start":0,"end":117,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-p017","section":"chapter-009","block":"b-94a6a6f3fb411f808480","layer":"pei","quote":"﹝二﹞《魏书》曰：“纯所督虎、豹骑，皆天下骁锐，或从百人将补之。太祖难其帅，纯以选为督，抚循甚得人心。及卒，有司白选代。太祖曰：‘纯之比，何可复得？吾独不中督邪！’遂不选。”","attribution":"《魏书》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":165,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-d1b3badf40b22252a7e5","start":0,"end":87,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o027a-q","section":"chapter-032","block":"b-50bee17966dbf776f03c","layer":"original","quote":"曹公以江陵有军实〖4〗，恐先主据之；乃释辎重，轻军到襄阳。闻先主已过，曹公将精骑五千急追之；一日一夜行三百余里，及于当阳之长坂〖5〗。先主弃妻子，与诸葛亮、张飞、赵云等数十骑走〖6〗。曹公大获其人众辎重。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":111,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":102,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o024","section":"chapter-032","block":"b-c857386227851cc86ab3","layer":"original","quote":"（曹公南征表）〔及曹公南征〕，会表卒，﹝二﹞子琮代立〖2〗，遣使请降。先主屯樊，不知曹公猝至；至宛乃闻之，遂将其众去。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":108,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":59,"offset_unit":"unicode_code_point"},{"id":"zhangle-q-b-1c8b2d7f701a85a14a28","section":"chapter-017","block":"b-1c8b2d7f701a85a14a28","layer":"modern","quote":"〖9〗十五年：建安十五年（公元 210）。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":158,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b5c5c4671b8693a9f34f","start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"zhangle-q-o041","section":"chapter-017","block":"b-4ea9ede39bd95135199f","layer":"original","quote":"从征荆州，别屯樊，讨中庐、临沮、宜城贼〖7〗。又与满宠讨关羽于汉津〖8〗，与曹仁击周瑜于江陵。十五年〖9〗，讨太原反者，围大陵；拔之，斩贼帅商曜。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":146,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":73,"offset_unit":"unicode_code_point"}],"profiles":{"xiahoucao-p0045":{"fields":[{"id":"xiahoucao-f0011","key":"courtesy","label":"字","text":"子和","evidence":["xiahoucao-f0011-q"]},{"id":"xiahoucao-f0013","key":"posthumous","label":"谥号","text":"威侯","evidence":["xiahoucao-f0013-q"]}],"directory":{"faction":"wei"}}},"directory_counts":{}}
