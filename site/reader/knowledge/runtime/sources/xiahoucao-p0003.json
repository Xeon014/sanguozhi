":["xiahoucao-e-p004b-q"]},{"person":"xiahoucao-p0003","role":"转官","evidence":["xiahoucao-e-p004b-q"]}],"place":null,"time":{"year":228,"label":"太和二年","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xiahoucao-y228","dating_review":{"reviewed":true,"anchor":"xiahoucao-q-o045","basis":"太和二年"},"evidence":["xiahoucao-e-p004b-q","xiahoucao-q-o045","luxun-q-o027","luxun-q-b-537c2ab6aaf33280136b"]},"ordering_evidence":"xiahoucao-e-p004b-q","source_order":[9,39,"P004b"],"order":2122},{"id":"xiahoucao-e-p004c","title":"夏侯楙弟构谤清河公主奏收段默谏止查明","accounts":[{"id":"xiahoucao-e-p004c-account","label":"《魏略》","text":"夏侯楙弟构谤清河公主奏收段默谏止查明","evidence":["xiahoucao-e-p004c-q"]}],"participants":[{"person":"xiahoucao-p0003","role":"被诬获免","evidence":["xiahoucao-e-p004c-q"]},{"person":"houfei-p0080","role":"奏劾","evidence":["xiahoucao-e-p004c-q"]},{"person":"xiahoucao-p0008","role":"谏止","evidence":["xiahoucao-e-p004c-q"]},{"person":"wendi-p0005","role":"推问","evidence":["xiahoucao-e-p004c-q"]},{"person":"xiahoucao-p0009","role":"构谤","evidence":["xiahoucao-e-p004c-q"]},{"person":"xiahoucao-p0010","role":"构谤","evidence":["xiahoucao-e-p004c-q"]}],"place":null,"time":{"label":"夏侯楙任关中都督后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xiahoucao-e-p004c-q"]},"ordering_evidence":"xiahoucao-e-p004c-q","source_order":[9,39,"P004c"],"order":2123},{"id":"liuliao-e-r020","title":"魏略记夏侯楙任安西将军镇长安","accounts":[{"id":"liuliao-a-ce26c6f66035bb098648","label":"裴注·魏略","text":"魏略记夏侯楙任安西将军镇长安","evidence":["liuliao-q-ed3eabf69466f4a64c3c"]}],"participants":[{"person":"xiahoucao-p0003","role":"为安西将军镇长安","evidence":["liuliao-q-ed3eabf69466f4a64c3c"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liuliao-q-ed3eabf69466f4a64c3c"]},"ordering_evidence":"liuliao-q-ed3eabf69466f4a64c3c","source_order":[40,290,10],"order":7308}],"persons":[{"id":"xiahoucao-p0003","name":"夏侯楙","evidence":["xiahoucao-q-o009","liuliao-q-ed3eabf69466f4a64c3c"],"facts":[{"id":"xiahoucao-f0033","label":"字","text":"子林","evidence":["xiahoucao-f0033-q"]},{"id":"xiahoucao-f0034","label":"亲属","text":"夏侯惇中子","evidence":["xiahoucao-f0034-q"]}],"aliases":[{"text":"子林","evidence":["xiahoucao-f0033-q"]}],"mentions":[{"id":"xiahoucao-m-o009-xiahoucao-p0003","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-o009"]},{"id":"xiahoucao-m-p004-xiahoucao-p0003","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-p004"]},{"id":"liuliao-m-44229d967f7ae8089dcb","kind":"mention","text":"本段涉及夏侯楙","evidence":["liuliao-q-bd25c46a5e8b41aeff3d"]}]}],"evidence":[{"id":"liuliao-q-bd25c46a5e8b41aeff3d","section":"chapter-040","block":"b-5b0651b11b2085bc11d1","layer":"pei","quote":"夏侯楙为安西将军，镇长安。亮于南郑与群下计议，延曰：‘闻夏侯楙少，主婿也；怯而无谋。今假延精兵五千，负粮五千；直从褒中出，循秦岭而东，当子午而北：不过十日，可到长安。楙闻延奄至，必乘船逃走；长安中，惟有御史、京兆太守耳。横门邸阁与散民之谷，足周食也。比东方相合聚，尚二十许日；而公从斜谷来，必足以达。如此，则一举而咸阳以西可定矣！’亮以为此悬危；不如安从坦道，可以平取陇右，十全必克而无虞。故不用延计","attribution":"裴注·魏略","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":289,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-634d3c9aa56fe2f2b975","start":10,"end":210,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-ed3eabf69466f4a64c3c","section":"chapter-040","block":"b-5b0651b11b2085bc11d1","layer":"pei","quote":"夏侯楙为安西将军，镇长安。","attribution":"裴注·魏略","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":289,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-634d3c9aa56fe2f2b975","start":10,"end":23,"offset_unit":"unicode_code_point"},{"id":"luxun-q-b-537c2ab6aaf33280136b","section":"chapter-058","block":"b-537c2ab6aaf33280136b","layer":"modern","quote":"〖1〗七年：黄武七年（公元 228）。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":139,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-26a3d21704231c7e2739","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"luxun-q-o027","section":"chapter-058","block":"b-1dfb331a9884eb630d46","layer":"original","quote":"七年〖1〗，权使鄱阳太守（孙）〔周〕鲂，谲魏大司马曹休：休果举众入皖〖2〗。乃召逊，假黄钺〖3〗，为大都督，逆休。﹝一﹞休既觉知，耻见欺诱；自恃兵马精多，遂交战。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":135,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":81,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o009b-q","section":"chapter-009","block":"b-af4cb66c5dbf74f34a25","layer":"original","quote":"初，太祖以女妻楙，即清河公主也。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":20,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":49,"end":65,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o009c-q","section":"chapter-009","block":"b-af4cb66c5dbf74f34a25","layer":"original","quote":"楙历位侍中、尚书，安西、镇东将军，假节。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":20,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":65,"end":85,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-p004a-q","section":"chapter-009","block":"b-42c72387182d89f3d57c","layer":"pei","quote":"文帝少与楙亲，及即位，以为安西将军、持节，承夏侯渊处都督关中。","attribution":"《魏略》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":38,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-19a717998a9f24d09769","start":20,"end":51,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-p004b-q","section":"chapter-009","block":"b-42c72387182d89f3d57c","layer":"pei","quote":"至太和二年，明帝西征，人有白楙者，遂召还为尚书。","attribution":"《魏略》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":38,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-19a717998a9f24d09769","start":62,"end":86,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-p004c-q","section":"chapter-009","block":"b-42c72387182d89f3d57c","layer":"pei","quote":"楙在西时，多蓄伎妾，公主由此与楙不和。其后群弟不遵礼度，楙数切责；弟惧见治，乃共构楙以诽谤， 〔令〕 公主奏之。有诏收楙，帝意欲杀之，以问长水校尉京兆段默。默以为：‘〔诽谤之言不与实相应。〕此必清河公主与楙不睦，出于谮构，冀不推实耳。且伏波与先帝有定天下之功，宜加三思。’帝意解，曰：‘吾亦以为然！’乃发诏推问为公主作表者，果其群弟子臧、子江所构也。","attribution":"《魏略》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":38,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-19a717998a9f24d09769","start":86,"end":261,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-f0033-q","section":"chapter-009","block":"b-42c72387182d89f3d57c","layer":"pei","quote":"楙字子林","attribution":"《魏略》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":38,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-19a717998a9f24d09769","start":10,"end":14,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-f0034-q","section":"chapter-009","block":"b-42c72387182d89f3d57c","layer":"pei","quote":"惇中子也","attribution":"《魏略》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":38,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-19a717998a9f24d09769","start":15,"end":19,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-o009","section":"chapter-009","block":"b-af4cb66c5dbf74f34a25","layer":"original","quote":"子充嗣。帝追思惇功，欲使子孙毕侯；分惇邑千户，赐惇七子二孙爵，皆关内侯。惇弟廉及子楙，素自封列侯。初，太祖以女妻楙，即清河公主也。楙历位侍中、尚书，安西、镇东将军，假节。﹝三﹞充薨，子廙嗣。廙薨，子劭嗣。﹝四﹞","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":20,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":105,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-o045","section":"chapter-009","block":"b-772f3a3de27ca1a3e015","layer":"original","quote":"太和二年，帝为二道征吴，遣司马宣王从汉水下，（督休）〔休督〕诸军向寻阳。贼将伪降〖12〗，休深入；战不利，退还宿石亭。军夜惊，士卒乱，弃甲兵辎重甚多。休上书，谢罪；帝遣屯骑校尉杨暨慰谕，礼赐益隆。休因此痈发背薨〖13〗。谥曰壮侯。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":192,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":115,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-p004","section":"chapter-009","block":"b-42c72387182d89f3d57c","layer":"pei","quote":"﹝三﹞《魏略》曰：“楙字子林，惇中子也。文帝少与楙亲，及即位，以为安西将军、持节，承夏侯渊处都督关中。楙性无武略，而好治生。至太和二年，明帝西征，人有白楙者，遂召还为尚书。楙在西时，多蓄伎妾，公主由此与楙不和。其后群弟不遵礼度，楙数切责；弟惧见治，乃共构楙以诽谤， 〔令〕 公主奏之。有诏收楙，帝意欲杀之，以问长水校尉京兆段默。默以为：‘〔诽谤之言不与实相应。〕此必清河公主与楙不睦，出于谮构，冀不推实耳。且伏波与先帝有定天下之功，宜加三思。’帝意解，曰：‘吾亦以为然！’乃发诏推问为公主作表者，果其群弟子臧、子江所构也。”","attribution":"《魏略》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":38,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-19a717998a9f24d09769","start":0,"end":262,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
