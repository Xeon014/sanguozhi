idence":[{"id":"feipin-q-218644c37caf41d0d30e","section":"chapter-050","block":"b-69af0fa98c05338f3141","layer":"original","quote":"太平中，孙亮知朱主为全主所害，问朱主死意〖5〗。全主惧曰：“我实不知，皆据二子熊、损所白！”亮杀熊、损。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":124,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":52,"offset_unit":"unicode_code_point"},{"id":"yululu-q-18f39d30425563b65159","section":"chapter-057","block":"b-b3a968fc5e8c816d3bcc","layer":"original","quote":"为全公主所谮，皆死","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":473,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":14,"end":23,"offset_unit":"unicode_code_point"},{"id":"yululu-q-7cdab036d8beeaf32719","section":"chapter-057","block":"b-b3a968fc5e8c816d3bcc","layer":"original","quote":"孙亮时，二子熊、损各复领兵。为全公主所谮，皆死。永安中，追录前功，以熊子宣，袭爵云阳侯，尚公主。孙皓时，宣至骠骑将军。","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":473,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":59,"offset_unit":"unicode_code_point"},{"id":"yululu-q-c6ef85850b7c507883d4","section":"chapter-057","block":"b-b3a968fc5e8c816d3bcc","layer":"original","quote":"孙亮时，二子熊、损各复领兵","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":473,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":13,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
