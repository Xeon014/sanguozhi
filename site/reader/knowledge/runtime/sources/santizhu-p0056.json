39d6275e43f3583fd19","huowang-q-1582308c0e6ffaf71961"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[{"id":"duzhou-q-178507ad62e769e5846b","section":"chapter-042","block":"b-3d45e522d16e992ebfe7","layer":"original","quote":"景耀六年，后主从谯周之计，遣使请降于邓艾","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":579,"anchor":null},"note_id":null,"start":0,"end":20},{"id":"duzhou-q-304ce4773010397a5961","section":"chapter-042","block":"b-68dd3d19d6456b42b287","layer":"original","quote":"群臣或难周曰：“今艾已不远，恐不受降，如之何？”周曰：“方今东吴未宾〖13〗，事势不得不受之；受之后，不得不礼。若陛下降魏，魏不裂土以封陛下者〖14〗，周请身诣京都，以古义争之！”众人无以易周之理","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":299,"anchor":null},"note_id":null,"start":0,"end":98},{"id":"duzhou-q-3e79261917b90578efcf","section":"chapter-042","block":"b-3d45e522d16e992ebfe7","layer":"original","quote":"其书，正所造也","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":579,"anchor":null},"note_id":null,"start":21,"end":28},{"id":"duzhou-q-41c437ed6248c17bf075","section":"chapter-042","block":"b-9f5771338709a8e53422","layer":"original","quote":"于是遂从周策。刘氏无虞〖33〗，一邦蒙赖：周之谋也","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":301,"anchor":null},"note_id":null,"start":0,"end":25},{"id":"duzhou-q-4866ceaa6aacd666bb63","section":"chapter-042","block":"b-f1e0524442057229c3d8","layer":"original","quote":"后主犹疑于入南〖15〗，周上疏曰：“或说陛下以北兵深入，有欲适南之计，臣愚以为不安","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":300,"anchor":null},"note_id":null,"start":0,"end":41},{"id":"duzhou-q-4e827542b8e82940ce6f","section":"chapter-042","block":"b-9a87d2041e499d8b5b04","layer":"original","quote":"惟周以为：“自古以来，无寄他国为天子者也。今若入吴，固当臣服。且政理不殊〖6〗，则大能吞小，此数之自然也。由此言之，则魏能并吴，吴不能并魏，明矣。（等为小称臣，孰与为大）〔等为称臣〖7〗，为小孰与为大〖8〗〕？再辱之耻〖9〗，何与一辱？且若欲奔南，则当早为之计，然后可果〖10〗。今大敌已近，祸败将及；群小之心〖11〗，无一可保；恐发足之日〖12〗，其变不测：何至南之有乎","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":298,"anchor":null},"note_id":null,"start":61,"end":247},{"id":"duzhou-q-7dd80f12a80a4e32e2f9","section":"chapter-042","block":"b-9a87d2041e499d8b5b04","layer":"original","quote":"后主使群臣会议，计无所出。或以为“蜀之与吴，本为和国，宜可奔吴”；或以为“南中七郡，阻险斗绝〖5〗，易以自守，宜可奔南","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":298,"anchor":null},"note_id":null,"start":0,"end":59},{"id":"duzhou-q2-ac591ab893dbcebe554c","section":"chapter-042","block":"b-f1e0524442057229c3d8","layer":"original","quote":"后主犹疑于入南〖15〗，周上疏曰：“或说陛下以北兵深入，有欲适南之计，臣愚以为不安。何者？南方远夷之地，平常无所供为〖16〗，犹数反叛；自丞相亮南征，兵势逼之，穷乃（幸）〔率〕从〖17〗。是后供出官赋，取以给兵，以为愁怨：此患国之人也〖18〗。今以穷迫，欲往依恃，恐必复反叛。一也；北兵之来，非但取蜀而已；若奔南方，必因人势衰，及时赴追。二也；若至南方，外当拒敌，内供服御〖19〗，费用张广〖20〗；他无所取，耗损诸夷必甚，甚必速叛。三也；昔王郎以邯郸僭号〖21〗，时世祖在信都〖22〗，畏逼于郎，欲弃还关中。邳肜谏曰：‘明公西还，则邯郸城民不肯捐父母〖23〗，背城主，而千里送公；其亡叛可必也〖24〗。’世祖从之，遂破邯郸。今北兵至，陛下南行，诚恐邳肜之言复信于今。四也。愿陛下早为之图，可获爵土；若遂适南，势穷乃服，其祸必深。《易》曰：‘亢之为言〖25〗：知得，而不知丧〖26〗；知存，而不知亡。知得失、存亡而不失其正者，其惟圣人乎！’言圣人知命而不苟必也〖27〗。故尧、舜以子不善，知天有授〖28〗，而求授人〖29〗。子虽不肖〖30〗，祸尚未萌，而迎授与人，况祸已至乎？故微子以殷王之昆〖31〗，面缚衔璧而归武王〖32〗：岂所乐哉？不得已也！”","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":300,"anchor":null},"note_id":null,"start":0,"end":525},{"id":"erfei-q-8683f8fdde33a5a39205","section":"chapter-034","block":"b-caa1bd390bc6a9f3db51","layer":"original","quote":"景耀六年冬，蜀亡","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":93,"anchor":null},"note_id":null,"start":0,"end":8},{"id":"hequan-q-22dee006306dcfe238a7","section":"chapter-060","block":"b-53f50d8a3e0bf232cd15","layer":"original","quote":"永安六年，蜀并于魏","section_title":"贺全吕周钟离传第十五","source":{"file":"OEBPS/Text/titlepage_0127.xhtml","index":400,"anchor":null},"note_id":null,"start":0,"end":9},{"id":"houzhu-q-O077","section":"chapter-033","block":"b-083c24beaf11955596f3","layer":"original","quote":"冬，邓艾破卫将军诸葛瞻于绵竹。用光禄大夫谯周策〖8〗，降于艾。奉书曰：“限分江、汉〖9〗，遇值深远〖10〗，阶缘蜀土〖11〗，斗绝一隅〖12〗；干运犯冒〖13〗，渐苒历载〖14〗，遂与京畿攸隔万里〖15〗。每惟黄初中〖16〗，文皇帝命虎牙将军鲜于辅〖17〗，宣温密之诏〖18〗，申三好之恩〖19〗；开示门户〖20〗，大义炳然。而否德暗弱〖21〗，窃贪遗绪〖22〗；俯仰累纪〖23〗，未率大教〖24〗。天威既震〖25〗，人鬼归能（之数）〖26〗，怖骇王师；神武所次〖27〗，敢不革面〖28〗，顺以从命！辄敕群帅投戈释甲，官府帑藏一无所毁〖29〗。百姓布野，余粮栖亩〖30〗；以俟后来之惠〖31〗，全元元之命〖32〗。伏惟大魏，布德施化；宰辅伊、周〖33〗，含覆藏疾〖34〗。谨遣私署侍中张绍、光禄大夫谯周、驸马都尉邓良〖35〗，奉赍印绶〖36〗，请命告诚，敬输忠款；存亡敕赐，惟所裁之〖37〗。舆榇在近〖38〗，不复缕陈〖39〗。”","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":153,"anchor":null},"note_id":null,"start":0,"end":415},{"id":"houzhu-q-O079","section":"chapter-033","block":"b-fb6d39ea3e1279d8d1a7","layer":"original","quote":"绍、良与艾相遇于雒县。艾得书，大喜；即报书，﹝二﹞遣绍、良先还。艾至城北，后主舆榇自缚，诣军垒门〖40〗。艾解缚焚榇，延请相见；﹝三﹞因承制拜后主为骠骑将军。诸围守悉被后主敕〖41〗，然后降下〖42〗。艾使后主止其故宫，身往造焉〖43〗。","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":155,"anchor":null},"note_id":null,"start":0,"end":119},{"id":"houzhu-q-P081a","section":"chapter-033","block":"b-a8c3e37d5fbc72dc6b52","layer":"pei","quote":"后主将从谯周之策，北地主谌怒曰：‘若理穷力屈，祸败必及；便当父子君臣，背城一战，同死社稷，以见先帝可也！’后主不纳，遂送玺绶。","attribution":"《汉晋春秋》","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":204,"anchor":null},"note_id":"n-5804c0b85b7b50186ffc","start":12,"end":75},{"id":"houzhu-q-P082a","section":"chapter-033","block":"b-be1c6a77bfff424b4c56","layer":"pei","quote":"﹝二﹞王隐《蜀记》曰：“艾报书云：‘王纲失道，群英并起；龙战虎争，终归真主：此盖天命去就之道也。自古圣帝，爰逮汉、魏，受命而王者，莫不在乎中土。河出《图》，洛出《书》，圣人则之，以兴洪业；其不由此，未有不颠覆者也。隗嚣凭陇而亡，公孙述据蜀而灭：此皆前世覆车之鉴也。圣上明哲，宰相忠贤；将比隆黄轩，侔功往代。衔命来征，思闻嘉响；果烦来使，告以德音：此非人事，岂天启哉？昔微子归周，实为上宾；君子豹变，义存《大易》。来辞谦冲，以礼与舆榇，皆前哲归命之典也。全国为上，破国次之；自非通明智达，何以见王者之义乎！’禅又遣太常张峻、益州别驾汝超受节度，遣太仆蒋显有命敕姜维。又遣尚书郎李虎送士民簿，领户二十八万，男女口九十四万；带甲将士十万二千，吏四万人；米四十余万斛，金、银各二千斤，锦绮、彩绢各二十万匹，余物称此。”","attribution":"王隐《蜀记》","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":205,"anchor":null},"note_id":"n-9231f0793ae41fa221ac","start":0,"end":355},{"id":"huowang-q-0d149ff6f87fdb366bb6","section":"chapter-041","block":"b-4dcb6200f55cc020b124","layer":"pei","quote":"得后主委质问至，乃帅所统，临于都亭三日","attribution":"裴注·襄阳记","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":25,"anchor":null},"note_id":"n-c480ade0f0913bd6d1da","start":195,"end":214},{"id":"huowang-q-1582308c0e6ffaf71961","section":"chapter-041","block":"b-4dcb6200f55cc020b124","layer":"pei","quote":"六年薨，赠安南将军，谥曰烈侯","attribution":"裴注·襄阳记","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":25,"anchor":null},"note_id":"n-c480ade0f0913bd6d1da","start":724,"end":738},{"id":"huowang-q-239d6275e43f3583fd19","section":"chapter-041","block":"b-4dcb6200f55cc020b124","layer":"pei","quote":"宪还，袭取吴之巫城，因上伐吴之策","attribution":"裴注·襄阳记","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":25,"anchor":null},"note_id":"n-c480ade0f0913bd6d1da","start":686,"end":702},{"id":"huowang-q-2cd802a9b0c851c8cdb5","section":"chapter-041","block":"b-4dcb6200f55cc020b124","layer":"pei","quote":"陈骞言于晋王，遣荆州刺史胡烈救宪，抗等引退","attribution":"裴注·襄阳记","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":25,"anchor":null},"note_id":"n-c480ade0f0913bd6d1da","start":481,"end":502},{"id":"huowang-q-2eb43d7af9194987705c","section":"chapter-041","block":"b-4dcb6200f55cc020b124","layer":"pei","quote":"三年冬，入朝，进位冠军将军，假节","attribution":"裴注·襄阳记","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":25,"anchor":null},"note_id":"n-c480ade0f0913bd6d1da","start":576,"end":592},{"id":"huowang-q-33b9ffeac78904365a48","section":"chapter-041","block":"b-4dcb6200f55cc020b124","layer":"pei","quote":"宪临江拒射，不能御；遣参军杨宗，突围北出，告急安东将军陈骞；又送文武印绶、任子，诣晋王","attribution":"裴注·襄阳记","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":25,"anchor":null},"note_id":"n-c480ade0f0913bd6d1da","start":339,"end":382},{"id":"huowang-q-35dfebfed4ffc5c8033b","section":"chapter-041","block":"b-4dcb6200f55cc020b124","layer":"pei","quote":"吴闻钟、邓败，百城无主，有兼蜀之志；而巴东固守，兵不得过，使步协率众而西","attribution":"裴注·襄阳记","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":25,"anchor":null},"note_id":"n-c480ade0f0913bd6d1da","start":302,"end":338},{"id":"huowang-q-43bf8122e96ed8d57b3e","section":"chapter-041","block":"b-4dcb6200f55cc020b124","layer":"pei","quote":"时右大将军阎宇，都督巴东，为领军；后主拜宪为宇副贰","attribution":"裴注·襄阳记","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":25,"anchor":null},"note_id":"n-c480ade0f0913bd6d1da","start":109,"end":134},{"id":"huowang-q-513690e653a3397bdc63","section":"chapter-041","block":"b-4dcb6200f55cc020b124","layer":"pei","quote":"宪遣妻子居洛阳，武帝以子袭为给事中","attribution":"裴注·襄阳记","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":25,"anchor":null},"note_id":"n-c480ade0f0913bd6d1da","start":558,"end":575},{"id":"huowang-q-5e3af6f42ff8bca40844","section":"chapter-041","block":"b-4dcb6200f55cc020b124","layer":"pei","quote":"后主立太子，为太子舍人","attribution":"裴注·襄阳记","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":25,"anchor":null},"note_id":"n-c480ade0f0913bd6d1da","start":44,"end":55},{"id":"huowang-q-60c360f1712db23a95a1","section":"chapter-041","block":"b-4dcb6200f55cc020b124","layer":"pei","quote":"泰始元年改封西鄂县侯","attribution":"裴注·襄阳记","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":25,"anchor":null},"note_id":"n-c480ade0f0913bd6d1da","start":547,"end":557},{"id":"huowang-q-619c5e05ee785e9ee234","section":"chapter-041","block":"b-4dcb6200f55cc020b124","layer":"pei","quote":"时黄皓预政，众多附之，宪独不与同；皓恚，左迁巴东太守","attribution":"裴注·襄阳记","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":25,"anchor":null},"note_id":"n-c480ade0f0913bd6d1da","start":82,"end":108},{"id":"huowang-q-783b0e9563d686888d49","section":"chapter-041","block":"b-4dcb6200f55cc020b124","layer":"pei","quote":"保城缮甲，告誓将士；厉以节义，莫不用命","attribution":"裴注·襄阳记","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":25,"anchor":null},"note_id":"n-c480ade0f0913bd6d1da","start":282,"end":301},{"id":"huowang-q-b89f741ec88fc13f1d82","section":"chapter-041","block":"b-4dcb6200f55cc020b124","layer":"pei","quote":"寻闻成都败，城中扰动，江边长吏皆弃城走；宪斩称‘成都乱’者一人，百姓乃定","attribution":"裴注·襄阳记","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":25,"anchor":null},"note_id":"n-c480ade0f0913bd6d1da","start":158,"end":194},{"id":"huowang-q-be25be1649a2086e71ca","section":"chapter-041","block":"b-4dcb6200f55cc020b124","layer":"pei","quote":"吴闻蜀败，起兵西上；外托救援，内欲袭宪。宪曰：‘本朝倾覆，吴为唇齿；不恤我难而邀其利，背盟违约。且汉已亡，吴何得久？宁能为吴降虏乎！","attribution":"裴注·襄阳记","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":25,"anchor":null},"note_id":"n-c480ade0f0913bd6d1da","start":215,"end":281},{"id":"huowang-q-c96785b0920fd4930364","section":"chapter-041","block":"b-8f0e683a3aca43ae9c4b","layer":"original","quote":"是岁，蜀并于魏。弋与巴东领军襄阳罗宪〖13〗，各保全一方，举以内附；咸因仍前任〖14〗，宠待有加","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":7,"anchor":null},"note_id":null,"start":12,"end":60},{"id":"huowang-q-cfd7b345e722f80d350c","section":"chapter-041","block":"b-4dcb6200f55cc020b124","layer":"pei","quote":"魏之伐蜀，召宇西还；留宇二千人，令宪守永安城","attribution":"裴注·襄阳记","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":25,"anchor":null},"note_id":"n-c480ade0f0913bd6d1da","start":135,"end":157},{"id":"huowang-q-d72d78a78c202a947db3","section":"chapter-041","block":"b-4dcb6200f55cc020b124","layer":"pei","quote":"四年三月，从帝宴于华林园，诏问蜀大臣子弟，后问先辈宜时叙用者；宪荐蜀郡常忌、杜轸、寿良，巴西陈寿，南郡高轨，（高）〔南〕阳吕雅、许国，江夏费恭，琅邪诸葛京，汝南陈裕：即皆叙用，咸显于世","attribution":"裴注·襄阳记","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":25,"anchor":null},"note_id":"n-c480ade0f0913bd6d1da","start":593,"end":685},{"id":"huowang-q-e055bd41d8e0045e8835","section":"chapter-041","block":"b-4dcb6200f55cc020b124","layer":"pei","quote":"孙休怒，复遣陆抗等帅众三万人增宪之围","attribution":"裴注·襄阳记","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":25,"anchor":null},"note_id":"n-c480ade0f0913bd6d1da","start":397,"end":415},{"id":"huowang-q-e35b6266dd5e9839bc02","section":"chapter-041","block":"b-4dcb6200f55cc020b124","layer":"pei","quote":"迁庶子、尚书吏部郎；以宣信校尉再使于吴，吴人称美焉","attribution":"裴注·襄阳记","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":25,"anchor":null},"note_id":"n-c480ade0f0913bd6d1da","start":56,"end":81},{"id":"huowang-q-ed2849639b6287c6c167","section":"chapter-041","block":"b-4dcb6200f55cc020b124","layer":"pei","quote":"被攻凡六月日，而救援不到；城中疾病大半，或说宪奔走之计。宪曰：‘夫为人主，百姓所仰；危不能安，急而弃之，君子不为也。毕命于此矣！","attribution":"裴注·襄阳记","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":25,"anchor":null},"note_id":"n-c480ade0f0913bd6d1da","start":416,"end":480},{"id":"huowang-q-f34c99561a906b4443c1","section":"chapter-041","block":"b-4dcb6200f55cc020b124","layer":"pei","quote":"晋王即委前任，拜宪凌江将军，封万年亭侯","attribution":"裴注·襄阳记","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":25,"anchor":null},"note_id":"n-c480ade0f0913bd6d1da","start":503,"end":522},{"id":"huowang-q-f46a3c68d1c2462d9484","section":"chapter-041","block":"b-4dcb6200f55cc020b124","layer":"pei","quote":"会武陵四县，举众叛吴，以宪为武陵太守、巴东监军","attribution":"裴注·襄阳记","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":25,"anchor":null},"note_id":"n-c480ade0f0913bd6d1da","start":523,"end":546},{"id":"huowang-q-fb3807c2e728d395299f","section":"chapter-041","block":"b-4dcb6200f55cc020b124","layer":"pei","quote":"协攻城，宪出与战，大破其军","attribution":"裴注·襄阳记","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":25,"anchor":null},"note_id":"n-c480ade0f0913bd6d1da","start":383,"end":396},{"id":"jfj-q0196","section":"chapter-044","block":"b-9de65e02e159a5ef52b1","layer":"original","quote":"后主请降于艾","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":232,"anchor":null},"note_id":null,"start":47,"end":53},{"id":"major-proof-q-dengai","section":"chapter-028","block":"b-ab37cd18c6e8ebcec1ec","layer":"original","quote":"刘禅遣使奉皇帝玺绶，为笺诣艾请降。艾至成都，禅率太子、诸王及群臣六十余人，面缚舆榇诣军门〖1〗。艾执节，解缚焚榇，受而宥之。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":347,"anchor":null},"note_id":null,"start":0,"end":62},{"id":"major-proof-q-houzhu","section":"chapter-033","block":"b-fb6d39ea3e1279d8d1a7","layer":"original","quote":"艾至城北，后主舆榇自缚，诣军垒门〖40〗。艾解缚焚榇，延请相见；","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":155,"anchor":null},"note_id":null,"start":32,"end":64},{"id":"major-proof-q-shu-variant","section":"chapter-033","block":"b-48582bda3620c8e6db2a","layer":"pei","quote":"﹝三﹞《晋诸公赞》曰：“刘禅乘骡车诣艾，不具亡国之礼。”","attribution":"《晋诸公赞》","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":206,"anchor":null},"note_id":"n-3cec51d46edadb4b2cd1","start":0,"end":28},{"id":"santizhu-q-56c460bc3b472dcdd307","section":"chapter-048","block":"b-25a289c0c24062b2e434","layer":"original","quote":"魏使将军胡烈，步骑二万侵西陵〖7〗，以救罗宪","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":284,"anchor":null},"note_id":null,"start":46,"end":68},{"id":"santizhu-q-7afd12882015e084317a","section":"chapter-048","block":"b-58fb185861c2591b0764","layer":"original","quote":"二月，镇军陆抗、抚军步协、征西将军留平，建平太守盛曼〖2〗，率众围蜀巴东守将罗宪","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":282,"anchor":null},"note_id":null,"start":12,"end":52},{"id":"shaodi-e-o169a-q","section":"chapter-004","block":"b-05f79fb18153dad67bec","layer":"original","quote":"自邓艾、钟会率众伐蜀，所至辄克。是月，蜀主刘禅诣艾降〖14〗，巴蜀皆平。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":198,"anchor":null},"note_id":null,"start":0,"end":36},{"id":"shaodi-q-b-ded6d700dc6f860d1670","section":"chapter-004","block":"b-ded6d700dc6f860d1670","layer":"modern","quote":"〖1〗四年：景元四年（公元 263）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":201,"anchor":null},"note_id":"n-ef642248e44d01f3825d","start":0,"end":19},{"id":"shaodi-q-o165","section":"chapter-004","block":"b-b35fdf03685051716720","layer":"original","quote":"四年春二月〖1〗，复命大将军进位、爵赐，一如前诏。又固辞，乃止。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":194,"anchor":null},"note_id":null,"start":0,"end":32},{"id":"wgc-q0050","section":"chapter-028","block":"b-ab37cd18c6e8ebcec1ec","layer":"original","quote":"刘禅遣使奉皇帝玺绶，为笺诣艾请降。艾至成都，禅率太子、诸王及群臣六十余人，面缚舆榇诣军门〖1〗。艾执节，解缚焚榇，受而宥之。检御将士，无所虏略；绥纳降附，使复旧业：蜀人称焉。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":347,"anchor":null},"note_id":null,"start":0,"end":87},{"id":"wgc-q0385","section":"chapter-028","block":"b-ab37cd18c6e8ebcec1ec","layer":"original","quote":"刘禅遣使奉皇帝玺绶，为笺诣艾请降","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":347,"anchor":null},"note_id":null,"start":0,"end":16},{"id":"wgc-q0386","section":"chapter-028","block":"b-ab37cd18c6e8ebcec1ec","layer":"original","quote":"艾至成都，禅率太子、诸王及群臣六十余人，面缚舆榇诣军门","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":347,"anchor":null},"note_id":null,"start":17,"end":44},{"id":"wgc-q0387","section":"chapter-028","block":"b-ab37cd18c6e8ebcec1ec","layer":"original","quote":"艾执节，解缚焚榇，受而宥之。检御将士，无所虏略；绥纳降附，使复旧业：蜀人称焉","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":347,"anchor":null},"note_id":null,"start":48,"end":86}],"profiles":{},"directory_counts":{}}
