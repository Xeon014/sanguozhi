{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"shaodi-e-o169a","title":"刘禅向邓艾降巴蜀平","accounts":[{"id":"shaodi-e-o169a-account","label":"《三少帝纪》正文","text":"刘禅向邓艾降巴蜀平","evidence":["shaodi-e-o169a-q"]},{"id":"major-proof-a-houzhu","label":"后主传","text":"刘禅舆榇自缚到军门；邓艾解缚焚榇，延请相见。","evidence":["major-proof-q-houzhu"]},{"id":"major-proof-a-dengai","label":"邓艾传","text":"刘禅奉玺绶请降，率太子、诸王和群臣到军门，邓艾解缚焚榇。","evidence":["major-proof-q-dengai"]},{"id":"major-proof-a-shu-variant","label":"后主传引《晋诸公赞》","text":"《晋诸公赞》另称刘禅乘骡车赴邓艾处，未具亡国之礼；与正文舆榇自缚的礼仪叙述有别。","evidence":["major-proof-q-shu-variant"]},{"id":"houzhu-a-518dfbb2f172","label":"《后主传》正文","text":"绍、良与艾相遇于雒县。艾得书，大喜；即报书，﹝二﹞遣绍、良先还。艾至城北，后主舆榇自缚，诣军垒门〖40〗。艾解缚焚榇，延请相见；﹝三﹞因承制拜后主为骠骑将军。诸围守悉被后主敕〖41〗，然后降下〖42〗。艾使后主止其故宫，身往造焉〖43〗。","evidence":["houzhu-q-O079"]},{"id":"houzhu-a-split-c49b791ab99c","label":"《后主传》正文","text":"刘禅遣使奉书请降","evidence":["houzhu-q-O077"]},{"id":"houzhu-a-variant-surrender-advice","label":"裴注·《汉晋春秋》","text":"《汉晋春秋》称刘谌劝刘禅背城一战，刘禅不纳而送玺绶。","evidence":["houzhu-q-P081a"]},{"id":"houzhu-a-surrender-register","label":"裴注·王隐《蜀记》","text":"《蜀记》载邓艾回书劝降，刘禅遣使听命并呈送蜀国户口、军资簿。","evidence":["houzhu-q-P082a"]},{"id":"jfj-a-o053c","label":"正文 · 景耀六年","text":"刘禅向邓艾请降","evidence":["jfj-q0196"]},{"id":"wgc-a-4-e8","label":"正文","text":"刘禅遣使奉玺绶请降","evidence":["wgc-q0385","wgc-q0050"]},{"id":"wgc-a-4-e9","label":"正文","text":"刘禅率太子诸王群臣面缚舆榇诣军门","evidence":["wgc-q0386","wgc-q0050"]},{"id":"wgc-a-4-e10","label":"正文","text":"邓艾执节解缚焚榇受宥安蜀","evidence":["wgc-q0387","wgc-q0050"]},{"id":"hequan-a-c9e12d5c98afa6a5c3c7","label":"正文","text":"永安六年蜀并于魏","evidence":["hequan-q-22dee006306dcfe238a7"]},{"id":"erfei-a-812d30bce19cd9e3a0b6","label":"正文","text":"蜀亡","evidence":["erfei-q-8683f8fdde33a5a39205"]},{"id":"huowang-a-624c4cee3f77f58406a0","label":"正文","text":"霍弋罗宪举地内附","evidence":["huowang-q-c96785b0920fd4930364"]},{"id":"duzhou-a-13f70d821c756817884d","label":"正文","text":"后主集群臣议迁避","evidence":["duzhou-q-7dd80f12a80a4e32e2f9"]},{"id":"duzhou-a-caa7d81d712686dbbbda","label":"正文","text":"谯周议降魏斥奔吴南","evidence":["duzhou-q-4e827542b8e82940ce6f"]},{"id":"duzhou-a-d7fbeca7d53309ffb5f7","label":"正文","text":"谯周答群臣请争裂土","evidence":["duzhou-q-304ce4773010397a5961"]},{"id":"duzhou-a-f294938c9ddca8a8fc98","label":"正文","text":"谯周上疏谏入南","evidence":["duzhou-q-4866ceaa6aacd666bb63","duzhou-q2-ac591ab893dbcebe554c"]},{"id":"duzhou-a-d9a22cd30141a325d1ba","label":"正文","text":"后主从谯周之策","evidence":["duzhou-q-41c437ed6248c17bf075"]},{"id":"duzhou-a-3cf41130c9464d5f749b","label":"正文","text":"后主遣使请降于邓艾","evidence":["duzhou-q-178507ad62e769e5846b"]},{"id":"duzhou-a-0c4c2add770062624af6","label":"正文","text":"郤正造请降书","evidence":["duzhou-q-3e79261917b90578efcf"]}],"participants":[{"person":"xianzhu-p0112","role":"归降","evidence":["shaodi-e-o169a-q"]},{"person":"shaodi-p0080","role":"受降","evidence":["shaodi-e-o169a-q"]},{"person":"shaodi-p0073","role":"参与伐蜀","evidence":["shaodi-e-o169a-q"]},{"person":"shaodi-p0154","role":"蜀并于魏之岁保全一方，举以内附，因仍前任；得后主东迁之问，始率六郡将守上表，称国败主附、守死无所，是以委质不敢有贰","evidence":["huowang-q-c96785b0920fd4930364"]},{"person":"santizhu-p0056","role":"巴东领军，与霍弋各保全一方举以内附","evidence":["huowang-q-c96785b0920fd4930364"]},{"person":"xianzhu-p0102","role":"以为自古以来无寄他国为天子，入吴固当臣服，魏能并吴吴不能并魏，再辱之耻何与一辱；欲奔南则当早计，今大敌已近群小之心无一可保，其变不测，何至南之有；答群臣之难以方今东吴未宾，事势不得不受降、受之后不得不礼；若陛下降魏而魏不裂土以封陛下，请身诣京都以古义争之；上疏以为适南之计不安；其策见用，刘氏无虞，一邦蒙赖；其降魏之计为后主所从","evidence":["duzhou-q-4e827542b8e82940ce6f","duzhou-q-304ce4773010397a5961","duzhou-q-4866ceaa6aacd666bb63","duzhou-q-41c437ed6248c17bf075","duzhou-q-178507ad62e769e5846b"]},{"person":"houzhu-p0019","role":"后主请降之书为其所造","evidence":["duzhou-q-3e79261917b90578efcf"]}],"place":null,"time":{"year":263,"label":"十一月","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"shaodi-y263","dating_review":{"reviewed":true,"anchor":"shaodi-q-o165","basis":"十一月"},"evidence":["shaodi-e-o169a-q","shaodi-q-o165","shaodi-q-b-ded6d700dc6f860d1670"]},"ordering_evidence":"shaodi-e-o169a