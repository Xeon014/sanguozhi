{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhouyu-e-o026a","title":"周瑜女配孙登","accounts":[{"id":"zhouyu-e-o026a-account","label":"《周瑜鲁肃吕蒙传》正文","text":"周瑜女配孙登","evidence":["zhouyu-e-o026a-q"]}],"participants":[{"person":"zhouyu-p0024","role":"成婚","evidence":["zhouyu-e-o026a-q"]},{"person":"zhouyu-p0025","role":"成婚","evidence":["zhouyu-e-o026a-q"]}],"place":null,"time":{"label":"周瑜子女成婚时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["zhouyu-e-o026a-q"]},"ordering_evidence":"zhouyu-e-o026a-q","source_order":[54,121,"O026a"],"order":9620}],"persons":[{"id":"zhouyu-p0024","name":"周瑜女","evidence":["zhouyu-q-o026","zhangyan-q-37eee38d39df22b3b8b2"],"facts":[],"aliases":[],"mentions":[{"id":"zhouyu-m-o026-zhouyu-p0024","kind":"mention","text":"文中提及","evidence":["zhouyu-q-o026"]},{"id":"zhangyan-m-8403aa40b4f13de63451","kind":"mention","text":"本篇原文记及周瑜女，具体行动与称谓见引文。","evidence":["zhangyan-q-37eee38d39df22b3b8b2"]}]}],"evidence":[{"id":"zhangyan-q-37eee38d39df22b3b8b2","section":"chapter-053","block":"b-7bb6f9fd953689e4a138","layer":"original","quote":"黄武四年，权为太子登聘周瑜女；秉守太常〖4〗，迎妃于吴。权亲幸秉船〖5〗，深见优礼。既还，秉从容进说登曰〖6〗：“婚姻，人伦之始，王教之基。是以圣王重之，所以率先众庶〖7〗，风化天下。故《诗》美《关雎》〖8〗，以为称首〖9〗。愿太子尊礼教于闺房，存《周南》之所咏〖10〗；则道化隆于上，颂声作于下矣。”登笑曰：“‘将顺其美〖11〗，匡救其恶’，诚所赖于傅君也〖12〗。”","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":102,"anchor":null},"note_id":null,"start":0,"end":185},{"id":"zhouyu-e-o026a-q","section":"chapter-054","block":"b-3e4cfb19ec554c3ef09e","layer":"original","quote":"瑜两男一女。女配太子登。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":120,"anchor":null},"note_id":null,"start":0,"end":12},{"id":"zhouyu-q-o026","section":"chapter-054","block":"b-3e4cfb19ec554c3ef09e","layer":"original","quote":"瑜两男一女。女配太子登。男循，尚公主〖1〗，拜骑都尉，有瑜风。早卒。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":120,"anchor":null},"note_