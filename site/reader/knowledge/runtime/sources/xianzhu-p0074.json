"liuermu-q2-5b650d5ea983b66bb39d","liuermu-q2-722f02439b8785811dd2","dengzhang-q-9b676b534cec2b51f6a9","dengzhang-q-f77ede3d7fe61b3ed8e3","dengzhang-q-dc2b6e4ab8c9b508ba1c","dengzhang-q-e1935e61c2cd35996b03","dengzhang-q-3a2f50daba186b34437b","dengzhang-q-b5d9d2de8c33a580b66d","dengzhang-q-848fbc9f76e7f59478fa"],"facts":[{"id":"liuermu-f2-1aca9383caa9fcf852ae","text":"庞羲之女为刘璋长子刘循妻。","evidence":["liuermu-q2-722f02439b8785811dd2"]}],"aliases":[],"mentions":[{"id":"xianzhu-m-o051-xianzhu-p0074","kind":"mention","text":"文中提及","evidence":["xianzhu-q-o051"]},{"id":"liuermu-m2-role-2886ecf3db0cd7344c30","kind":"mention","text":"文中提及","evidence":["liuermu-q-dde36aaadb127cf1c44d","liuermu-q2-5b650d5ea983b66bb39d"]}]}],"evidence":[{"id":"dengzhang-q-3a2f50daba186b34437b","section":"chapter-045","block":"b-ae37311a660d50a1ec42","layer":"original","quote":"畿报曰：“郡合部曲，本不为叛；虽有交构〖6〗，要在尽诚〖7〗；若必以惧，遂怀异志，非畿之所闻！”并敕郁曰：“我受州恩，当为州牧尽节。汝为郡吏，当为太守效力：不得以吾故有异志也！”","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":356,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":113,"end":202,"offset_unit":"unicode_code_point"},{"id":"dengzhang-q-717a432bbf8367bb45e1","section":"chapter-045","block":"b-dcad3795f68a26f97ecf","layer":"pei","quote":"群下上先主为汉中王；其文，朝所造也","attribution":"裴注·华阳国志","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":345,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c4df925d7ccb2471fbb6","start":47,"end":64,"offset_unit":"unicode_code_point"},{"id":"dengzhang-q-848fbc9f76e7f59478fa","section":"chapter-045","block":"b-ae37311a660d50a1ec42","layer":"original","quote":"羲知畿必不为己，厚陈谢于璋以致无咎","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":356,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":270,"end":287,"offset_unit":"unicode_code_point"},{"id":"dengzhang-q-9b676b534cec2b51f6a9","section":"chapter-045","block":"b-de68bbc9c81cd1ec1901","layer":"original","quote":"芝闻巴西太守庞羲好士，往依焉","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":1,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":76,"end":90,"offset_unit":"unicode_code_point"},{"id":"dengzhang-q-b5d9d2de8c33a580b66d","section":"chapter-045","block":"b-ae37311a660d50a1ec42","layer":"original","quote":"羲使人告畿曰：“尔子在郡，不从太守，家将及祸！”畿曰：“昔乐羊为将〖8〗，饮子之羹；非父子无恩，大义然也！今虽复羹子〖9〗，吾必饮之！”","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":356,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":202,"end":270,"offset_unit":"unicode_code_point"},{"id":"dengzhang-q-dc2b6e4ab8c9b508ba1c","section":"chapter-045","block":"b-ae37311a660d50a1ec42","layer":"original","quote":"有谗于璋，说羲欲叛者，璋阴疑之","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":356,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":68,"end":83,"offset_unit":"unicode_code_point"},{"id":"dengzhang-q-e1935e61c2cd35996b03","section":"chapter-045","block":"b-ae37311a660d50a1ec42","layer":"original","quote":"羲闻，甚惧，将谋自守〖4〗；遣畿子郁宣旨〖5〗，索兵自助","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":356,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":84,"end":112,"offset_unit":"unicode_code_point"},{"id":"dengzhang-q-f77ede3d7fe61b3ed8e3","section":"chapter-045","block":"b-ae37311a660d50a1ec42","layer":"original","quote":"巴西太守庞羲以天下扰乱，郡宜有武卫，颇招合部曲","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":356,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":44,"end":67,"offset_unit":"unicode_code_point"},{"id":"liuermu-q-0a6cc8b2035aff9410d2","section":"chapter-031","block":"b-e1d93d8865a36222023d","layer":"original","quote":"鲁部曲多在巴西，故以羲为巴西太守，领兵御鲁","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":67,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":51,"end":72,"offset_unit":"unicode_code_point"},{"id":"liuermu-q-621907b18ec892fb262c","section":"chapter-031","block":"b-d501f074327fe41cf7aa","layer":"pei","quote":"庞羲与璋有旧，又免璋诸子于难；故璋厚德羲，以羲为巴西太守，遂专权势","attribution":"裴注·英雄记","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":113,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9239a330c613df8c25d4","start":11,"end":44,"offset_unit":"unicode_code_point"},{"id":"liuermu-q-76ad6b663be441f1137a","section":"chapter-031","block":"b-e1d93d8865a36222023d","layer":"original","quote":"璋累遣厐羲等攻鲁，〔数为〕所破","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":67,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":35,"end":50,"offset_unit":"unicode_code_point"},{"id":"liuermu-q-93941833864168df1511","section":"chapter-031","block":"b-bccefe4727ae6d26d31c","layer":"original","quote":"议郎河南庞羲与焉通家〖13〗，乃募将焉诸孙入蜀","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":38,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":87,"end":110,"offset_unit":"unicode_code_point"},{"id":"liuermu-q-adec016fe61d7783343a","section":"chapter-031","block":"b-2a7eb34fd683676ae1b4","layer":"original","quote":"先主定蜀，羲为左将军司马","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":75,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":80,"end":92,"offset_unit":"unicode_code_point"},{"id":"liuermu-q-bfea3ae623f777b5c776","section":"chapter-031","block":"b-2a7eb34fd683676ae1b4","layer":"original","quote":"璋时从羲启留循〖34〗，先主以为奉车中郎将","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":75,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":97,"end":118,"offset_unit":"unicode_code_point"},{"id":"liuermu-q-dde36aaadb127cf1c44d","section":"chapter-031","block":"b-bb8534db9135eea0c435","layer":"original","quote":"后松复说璋曰：“今州中诸将庞羲、李异等，皆恃功骄豪，欲有外意〖15〗；不得豫州〖16〗，则敌攻其外，民攻其内：必败之道也","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":70,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":60,"offset_unit":"unicode_code_point"},{"id":"liuermu-q2-5b650d5ea983b66bb39d","section":"chapter-031","block":"b-bb8534db9135eea0c435","layer":"original","quote":"后松复说璋曰：“今州中诸将庞羲、李异等，皆恃功骄豪，欲有外意〖15〗；不得豫州〖16〗，则敌攻其外，民攻其内：必败之道也。”璋又从之，遣法正请先主。璋主簿黄权陈其利害〖17〗，从事广汉王累自倒悬于州门以谏〖18〗；璋一无所纳，敕在所：供奉先主〖19〗；先主入境如归〖20〗。","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":70,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":137,"offset_unit":"unicode_code_point"},{"id":"liuermu-q2-722f02439b8785811dd2","section":"chapter-031","block":"b-2a7eb34fd683676ae1b4","layer":"original","quote":"璋卒，南中豪率雍闿据益郡反〖31〗，附于吴。权复以璋子阐为益州刺史，处交、益界首。丞相诸葛亮平南土〖32〗，阐还吴，为御史中丞。﹝八﹞初，璋长子循妻，庞羲女也。先主定蜀，羲为左将军司马〖33〗；璋时从羲启留循〖34〗，先主以为奉车中郎将〖35〗。是以璋二子之后，分在吴、蜀。","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":75,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":137,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o051a-q","section":"chapter-032","block":"b-652c7dfc21363b200764","layer":"original","quote":"“平西将军、都亭侯臣马超，左将军领长史、镇军将军臣许靖，营司马臣庞羲，议曹从事、中郎、军议中郎将臣射援，﹝一﹞军师将军臣诸葛亮，荡寇将军、汉寿亭侯臣关羽，征虏将军、新亭侯臣张飞，征西将军臣黄忠，镇远将军臣赖恭，扬武将军臣法正，兴业将军臣李严等一百二十人上言曰〖17〗：","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":206,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":134,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-b-c3e56caa3865de7f7114","section":"chapter-032","block":"b-c3e56caa3865de7f7114","layer":"modern","quote":"〖11〗二十四年：建安二十四年（公元 219）。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":222,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fd85f82251e498647de7","start":0,"end":24,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o048","section":"chapter-032","block":"b-2d515ba2dae40f6a248e","layer":"original","quote":"二十四年春〖11〗，自阳平南渡沔水，缘山稍前〖12〗，于定军山（势）作营〖13〗。渊将兵来争其地，先主命黄忠乘高鼓噪攻之。大破渊军，斩渊及曹公所署益州刺史赵颙等。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":203,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":81,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o050-preface","section":"chapter-032","block":"b-a429b62b1d8ac4da31ba","layer":"original","quote":"秋，群下上《先王为汉中王表》于汉帝〖16〗，曰：","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":205,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":24,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o051","section":"chapter-032","block":"b-652c7dfc21363b200764","layer":"original","quote":"“平西将军、都亭侯臣马超，左将军领长史、镇军将军臣许靖，营司马臣庞羲，议曹从事、中郎、军议中郎将臣射援，﹝一﹞军师将军臣诸葛亮，荡寇将军、汉寿亭侯臣关羽，征虏将军、新亭侯臣张飞，征西将军臣黄忠，镇远将军臣赖恭，扬武将军臣法正，兴业将军臣李严等一百二十人上言曰〖17〗：","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":206,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":134,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o052-argument1","section":"chapter-032","block":"b-13bc0548f92b946e57ac","layer":"original","quote":"昔唐尧至圣，而四凶在朝〖18〗；周成仁贤，而四国作难〖19〗；高后称制，而诸吕窃命〖20〗；孝昭幼冲，而上官逆谋〖21〗：皆凭世宠〖22〗，藉履国权〖23〗，穷凶极乱，社稷几危。非大舜、周公、朱虚、博陆〖24〗，则不能流放擒讨，安危定倾。伏惟陛下诞姿圣德，统理万邦；而遭厄运不造之艰〖25〗。董卓首难〖26〗，荡覆京畿；曹操阶祸〖27〗，窃执天衡〖28〗；皇后太子〖29〗，鸩杀见害；剥乱天下，残毁民物〖30〗。久令陛下蒙尘忧厄，幽处虚邑〖31〗；人神无主，遏绝王命；厌昧皇极〖32〗，欲盗神器。左将军、领司隶校尉、豫、荆、益三州牧宜城亭侯备，受朝爵秩，念在输力〖33〗，以殉国难。睹其机兆〖34〗，赫然愤发；与车骑将军董承同谋诛操，将安国家，克宁旧都。会承机事不密，令操游魂得遂长恶〖35〗，残泯海内。臣等每惧王室大有阎乐之祸〖36〗，小有定安之变〖37〗；﹝二﹞夙夜惴惴，战栗累息。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":207,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":393,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o053-argument2","section":"chapter-032","block":"b-5e935a656e57fa2b467f","layer":"original","quote":"昔在《虞书》〖38〗，敦序九族〖39〗；周监二代〖40〗，封建同姓；《诗》著其义〖41〗，历载长久。汉兴之初，割裂疆土〖42〗，尊王子弟；是以卒折诸吕之难〖43〗，而成太宗之基〖44〗。臣等以备肺腑枝叶〖45〗，宗子藩翰〖46〗；心存国家，念在弥乱〖47〗；自操破于汉中，海内英雄望风蚁附；而爵号不显，九锡未加〖48〗：非所以镇卫社稷，光昭万世也。奉辞在外〖49〗，礼命断绝。昔河西太守梁统等值汉中兴〖50〗，限于山河〖51〗；位同权均，不能相率；咸推窦融以为元帅〖52〗，卒立效绩〖53〗，摧破隗嚣〖54〗。今社稷之难，急于陇、蜀〖55〗；操外吞天下，内残群僚；朝廷有萧墙之危〖56〗，而御侮未建〖57〗，可为寒心。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":208,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":309,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o054-proposal","section":"chapter-032","block":"b-48e611d2cf38e3f1ec45","layer":"original","quote":"臣等辄依旧典，封备汉中王，拜大司马，董齐六军〖58〗，纠合同盟，扫灭凶逆；以汉中、巴、蜀、广汉、犍为为国，所署置依汉初诸侯王故典。夫权宜之制，苟利社稷，专之可也；然后功成事立，臣等退伏矫罪〖59〗，虽死无恨！”","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":209,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":105,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
