ernative","evidence":["santizhu-q-9b248481834fb33d577b","shaodi-e-o073a-q"]},{"event":"santizhu064-e-sr-liuzan-death-wushu","type":"alternative","evidence":["santizhu064-q-51aceda50efd02b54ab2","santizhu-q-9b248481834fb33d577b"]}],"order":8461},{"id":"santizhu-e-p046c","title":"沈莹三冲不动胜班乘乱土崩","accounts":[{"id":"santizhu-a-12138919ee559579769a","label":"裴注·干宝《晋纪》","text":"沈莹三冲不动胜班乘乱土崩","evidence":["santizhu-q-1b13478b0f5af0ad26fb"]}],"participants":[{"person":"santizhu-p0128","role":"讨吴护军、成阵相对","evidence":["santizhu-q-1b13478b0f5af0ad26fb"]},{"person":"santizhu-p0117","role":"扬州刺史同成阵","evidence":["santizhu-q-1b13478b0f5af0ad26fb"]},{"person":"santizhu-p0123","role":"领丹杨锐卒刀盾五千号青巾兵、三冲不动退引乱","evidence":["santizhu-q-1b13478b0f5af0ad26fb"]},{"person":"santizhu-p0129","role":"因乱乘之","evidence":["santizhu-q-1b13478b0f5af0ad26fb"]},{"person":"wgc-p0019","role":"同乘之","evidence":["santizhu-q-1b13478b0f5af0ad26fb"]},{"person":"santizhu-p0127","role":"又出其后","evidence":["santizhu-q-1b13478b0f5af0ad26fb"]},{"person":"santizhu-p0110","role":"版桥被获","evidence":["santizhu-q-1b13478b0f5af0ad26fb"]},{"person":"santizhu-p0126","role":"同被获","evidence":["santizhu-q-1b13478b0f5af0ad26fb"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["santizhu-q-1b13478b0f5af0ad26fb"]},"ordering_evidence":"santizhu-q-1b13478b0f5af0ad26fb","source_order":[48,46,169],"order":8909},{"id":"santizhu064-e-sr-liuzan-death-wushu","title":"《吴书》留赞之死：蒋班追击、赞付印弟子被害","accounts":[{"id":"santizhu064-a-8d18ba03de1fa97ddc35","label":"裴注·吴书","text":"孙峻征淮南授赞节拜左护军；未至寿春道病，峻令赞将车重先还；魏将蒋班以步骑四千追赞，赞病困不能整阵，解曲盖印绶付弟子；临敌被发叫天抗音而歌毕乃进战；及败叹曰吾战有常术今病困若此固命也，遂被害，时年七十三；二子略、平并为大将","evidence":["santizhu064-q-51aceda50efd02b54ab2"]}],"participants":[{"person":"shaodi-p0076","role":"授节左护军、病中还师、解印付弟子、被害","evidence":["santizhu064-q-51aceda50efd02b54ab2"]},{"person":"shaodi-p0075","role":"征淮南授赞节、令赞将车重先还","evidence":["santizhu064-q-51aceda50efd02b54ab2"]},{"person":"wgc-p0019","role":"以步骑四千追留赞（wgc-p0019）","evidence":["santizhu064-q-51aceda50efd02b54ab2"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"未由相邻段落推算纪年；原文时间表达保留在来源引句中。","evidence":["santizhu064-q-51aceda50efd02b54ab2"]},"ordering_evidence":"santizhu064-q-51aceda50efd02b54ab2","source_order":[64,415,0],"related_events":[{"event":"shaodi-e-o073a","type":"alternative","evidence":["santizhu064-q-51aceda50efd02b54ab2","shaodi-e-o073a-q"]},{"event":"santizhu-e-sr-liuzan-death","type":"alternative","evidence":["santizhu064-q-51aceda50efd02b54ab2","santizhu-q-9b248481834fb33d577b"]}],"order":11004}],"persons":[{"id":"wgc-p0019","name":"蒋班","evidence":["wgc-q0024","wgc-q0029","wgc-q0113","santizhu-q-1b13478b0f5af0ad26fb","santizhu-q-b2b3977b84b3b8706bb3"],"aliases":[],"facts":[],"mentions":[{"id":"wgc-m-o030-wgc-p0019","kind":"mention","text":"本段涉及蒋班","evidence":["wgc-q0024"]},{"id":"wgc-m-o036-wgc-p0019","kind":"mention","text":"本段涉及蒋班","evidence":["wgc-q0029"]},{"id":"wgc-m-p032-wgc-p0019","kind":"mention","text":"本段涉及蒋班","evidence":["wgc-q0113"]}]}],"evidence":[{"id":"santizhu-q-1b13478b0f5af0ad26fb","section":"chapter-048","block":"b-4311ae30072f04acbaa0","layer":"pei","quote":"与讨吴护军张翰、扬州刺史周浚成阵相对。沈莹领丹杨锐卒刀盾五千，号曰‘青巾兵’，前后屡陷坚阵：于是以驰淮南军，三冲不动；退引，乱。薛胜、蒋班，因其乱而乘之，吴军以次土崩，将帅不能止；张乔又出其后：大败吴军于版桥，获悌、震、莹等","attribution":"裴注·干宝《晋纪》","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":548,"anchor":null},"note_id":"n-5564fe5f445521640591","start":169,"end":281},{"id":"santizhu-q-9b248481834fb33d577b","section":"chapter-048","block":"b-d33ac4d7966626cd5c5b","layer":"original","quote":"留赞为诞别将蒋班所败于菰陂〖9〗，赞及将军孙楞、蒋修等，皆遇害。","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":53,"anchor":null},"note_id":null,"start":153,"end":185},{"id":"santizhu-q-b2b3977b84b3b8706bb3","section":"chapter-048","block":"b-d33ac4d7966626cd5c5b","layer":"original","quote":"留赞为诞别将蒋班所败于菰陂〖9〗，赞及将军孙楞、蒋修等，皆遇害","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":53,"anchor":null},"note_id":null,"start":153,"end":184},{"id":"santizhu064-q-20d87b32e3639cb4e23a","section":"chapter-064","block":"b-c440da85565fe532313d","layer":"original","quote":"二年〖9〗，魏将毌丘俭、文钦以众叛，与魏人战于乐嘉〖10〗。峻帅骠骑将军吕据、左将军留赞袭寿春；会钦败降，军还","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":390,"anchor":null},"note_id":null,"start":0,"end":55},{"id":"santizhu064-q-51aceda50efd02b54ab2","section":"chapter-064","block":"b-d6d1b5c9cae4cad8e15d","layer":"pei","quote":"孙峻征淮南，授赞节，拜左护军。未至寿春，道路病发，峻令赞将车重先还。魏将蒋班，以步骑四千追赞。赞病困，不能整阵；知必败，乃解曲盖、印绶，付弟子以归，曰：‘吾自为将，破敌搴旗，未尝负败。今病困兵羸，众寡不敌；汝速去矣，俱死无益于国，适所以快敌耳。’弟子不肯受，拔刀欲斫之，乃去。初，赞为将，临敌必先被发叫天，因抗音而歌，左右应之；毕，乃进战，战无不克。及败，叹曰：‘吾战有常术，今病困若此，固命也！’遂被害，时年七十三。众庶痛惜焉。二子：略、平，并为大将。”","attribution":"裴注·吴书","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":414,"anchor":null},"note_id":"n-9d9f10434c65e6735646","start":299,"end":527},{"id":"shaodi-e-o073a-q","section":"chapter-004","block":"b-edb853525f526ca4c6d7","layer":"original","quote":"甲子〖18〗，吴大将孙峻等众号十万〖19〗，至寿春；诸葛诞拒击破之，斩吴左将军留赞〖20〗，献捷于京都。三月，立皇后卞氏〖21〗，大赦。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":333,"anchor":null},"note_id":null,"start":0,"end":68},{"id":"shaodi-q-b-2de9ea37d1e15a7d296f","section":"chapter-004","block":"b-2de9ea37d1e15a7d296f","layer":"modern","quote":"〖6〗二年：正元二年（公元 255）。乙丑：旧历十二日。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":346,"anchor":null},"note_id":"n-96103ace1e11ae4131ba","start":0,"end":28},{"id":"shaodi-q-o072","section":"chapter-004","block":"b-4b9070779d1c209c6814","layer":"original","quote":"二年春正月，乙丑〖6〗，镇东将军毌丘俭、扬州刺史文钦反。（戊戌）〔戊寅〕〖7〗，大将军司马景王征之。癸未〖8〗，车骑将军郭淮薨。闰月，己亥〖9〗，破钦于乐嘉〖10〗；钦遁走，遂奔吴。甲辰〖11〗，安风淮津都尉斩俭〖12〗，传首京都。﹝一﹞壬子〖13〗，复特赦淮南士民诸为俭、钦所诖误者〖14〗。以镇南将军诸葛诞为镇东大将军〖15〗。司马景王薨于许昌。二月，丁巳〖16〗，以卫将军司马文王为大将军〖17〗，录尚书事。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":332,"anchor":null},"note_id":null,"start":0,"end":207},{"id":"shaodi-q-o073","section":"chapter-004","block":"b-edb853525f526ca4c6d7","layer":"original","quote":"甲子〖18〗，吴大将孙峻等众号十万〖19〗，至寿春；诸葛诞拒击破之，斩吴左将军留赞〖20〗，献捷于京都。三月，立皇后卞氏〖21〗，大赦。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":333,"anchor":null},"note_id":null,"start":0,"end":68},{"id":"wgc-q0024","section":"chapter-028","block":"b-b65f0eafd40a24300f7f","layer":"original","quote":"吴大将孙峻、吕据、留赞等闻淮南乱〖10〗，会文钦往，乃帅众将钦径至寿春。时诞诸军已至，城不可攻，乃走。诞遣将军蒋班追击之，斩赞；传首，收其印、节。进封高平侯，邑三千五百户；转为征东大将军。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":153,"anchor":null},"note_id":null,"start":0,"end":94},{"id":"wgc-q0029","section":"chapter-028","block":"b-415a96152140983fb9ca","layer":"original","quote":"吴将朱异再以大众来迎诞等，渡黎浆水〖1〗；泰等逆与战，每摧其锋。孙綝以异战不进〖2〗，怒而杀之。城中食转少，外救不至，众无所恃。将军蒋班、焦彝，皆诞爪牙计事者也；弃诞，逾城自归大将军〖3〗。﹝一﹞大将军乃使反间，以奇变说全怿等〖4〗；怿等率众数千人，开门来出。城中震惧，不知所为。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":194,"anchor":null},"note_id":null,"start":0,"end":140},{"id":"wgc-q0113","section":"chapter-028","block":"b-8152b96e80f85b084c0f","layer":"pei","quote":"﹝一﹞《汉晋春秋》曰：“蒋班、焦彝言于诸葛诞曰：‘朱异等以大众来而不能进，孙綝杀异而归江东；外以发兵为名，而内实坐须成败，其归可见矣。今宜及众心尚固，士卒思用，并力决死，攻其一面；虽不能尽克，犹可有全者。’文钦曰：‘江东乘战胜之威久矣，未有难北方者也。况公今举十余万之众内附，而钦与全端等皆同居死地，父子兄弟尽在江表？就孙綝不欲，主上及其亲戚岂肯听乎？且中国无岁无事，军民并疲，今守我一年，势力已困；异图生心，变故将起，以往准今，可计日而望也。’班、彝固劝之，钦怒，而诞欲杀班。二人惧，且知诞之必败也，十一月，乃相携而降。”","attribution":"汉晋春秋","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":212,"anchor":null},"note_id":"n-37a96fab04e76e79956a","start":0,"end":262},{"id":"wgc-q0263","section":"chapter-028","block":"b-b65f0eafd40a24300f7f","layer":"original","quote":"吴大将孙峻、吕据、留赞等闻淮南乱〖10〗，会文钦往，乃帅众将钦径至寿春。时诞诸军已至，城不可攻，乃走","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":153,"anchor":null},"note_id":null,"start":0,"end":50},{"id":"wgc-q0264","section":"chapter-028","block":"b-b65f0eafd40a24300f7f","layer":"original","quote":"诞遣将军蒋班追击之，斩赞；传首，收其印、节","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":153,"anchor":null},"note_id":null,"start":51,"end":72},{"id":"wgc-q0286","section":"chapter-028","block":"b-415a96152140983fb9ca","layer":"original","quote":"将军蒋班、焦彝，皆诞爪牙计事者也；弃诞，逾城自归大将军","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":194,"anchor":null},"note_id":null,"start":64,"end":91},{"id":"wgc-q0589","section":"chapter-028","block":"b-8152b96e80f85b084c0f","layer":"pei","quote":"蒋班、焦彝言于诸葛诞曰：‘朱异等以大众来而不能进，孙綝杀异而归江东；外以发兵为名，而内实坐须成败，其归可见矣。今宜及众心尚固，士卒思用，并力决死，攻其一面；虽不能尽克，犹可有全者","attribution":"裴注·汉晋春秋","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":212,"anchor":null},"note_id":"n-37a96fab04e76e79956a","start":12,"end":101},{"id":"wgc-q0591","section":"chapter-028","block":"b-8152b96e80f85b084c0f","layer":"pei","quote":"班、彝固劝之，钦怒，而诞欲杀班。二人惧，且知诞之必败也，十一月，乃相携而降","attribution":"裴注·汉晋春秋","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":212,"anchor":null},"note_id":"n-37a96fab04e76e79956a","start":223,"end":260}],"profiles":{},"directory_counts":{}}
