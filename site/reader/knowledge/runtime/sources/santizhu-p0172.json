gyan-q-65fdb960383b8d9fead4","zhangyan-q-75e008196c3bbea93058","zhangyan-q-2c9a36d25280011a7371","zhangyan-q-9955c91d9a5777f1cbca","zhangyan-q-770269f217c5ae946fed","zhangyan-q-c948969ca66dbc379831","zhangyan-q-4a2a26d62b1cfad836f0","zhangyan-q-1d34166950c0bcd701d7","zhangyan-q-c6a5ed3f9abeb669c9a2","zhangyan-q-f876b4149df635694189","zhangyan-q-8896330432490af7a28a","zhangyan-q-5e9bed0855ae724b8f71","zhangyan-q-118dd7b542a20ec2838a","zhangyan-q-46349215efb2f27db00d","yululu-q-d290cedae207709779aa","yululu-q-a7c835f82230b992cee9","yululu-q-a10cdb7af3f03e686cf1"],"facts":[{"id":"zhangyan-f-d591ce7d61407aa5968e","text":"字德润，会稽山阴人","evidence":["zhangyan-q-c6a5ed3f9abeb669c9a2"]},{"id":"zhangyan-f-21ae72cea6932c40aadf","text":"家世农夫，至泽好学","evidence":["zhangyan-q-c6a5ed3f9abeb669c9a2"]},{"id":"zhangyan-f-867292fadeb03233277b","text":"居贫无资，常为人佣书以供纸笔；所写既毕，诵读亦遍","evidence":["zhangyan-q-c6a5ed3f9abeb669c9a2"]},{"id":"zhangyan-f-d7a6d17d4a1ce574b3ca","text":"追师论讲，究览群籍，兼通历数","evidence":["zhangyan-q-c6a5ed3f9abeb669c9a2"]},{"id":"zhangyan-f-0e3d2fb0e339fe5f7849","text":"由是显名","evidence":["zhangyan-q-c6a5ed3f9abeb669c9a2"]},{"id":"zhangyan-f-c544d79b74052668bac8","text":"每朝廷大议、经典所疑，孙权辄咨访之","evidence":["zhangyan-q-f876b4149df635694189"]},{"id":"zhangyan-f-3f75d257c5eb5212e7fc","text":"性谦恭笃慎，（官）〔宫〕府小吏呼召对问，皆为抗礼","evidence":["zhangyan-q-8896330432490af7a28a"]},{"id":"zhangyan-f-3a33cb4e059e2cae3aaa","text":"人有非短，口未尝及","evidence":["zhangyan-q-8896330432490af7a28a"]},{"id":"zhangyan-f-0850bf7a73579b8ab41f","text":"容貌似不足者，然所闻少穷","evidence":["zhangyan-q-8896330432490af7a28a"]},{"id":"zhangyan-f-7ae4afd4deda7443aba2","text":"诸官司欲增重科防以检御臣下，泽每曰宜依礼、律，其和而有正","evidence":["zhangyan-q-5e9bed0855ae724b8f71"]},{"id":"zhangyan-f-d50a33b0b792aafccfe2","text":"《吴录》称虞翻誉之曰阚生矫杰，盖蜀之扬雄；阚子儒术德行，亦今之仲舒也","evidence":["zhangyan-q-46349215efb2f27db00d"]}],"aliases":[],"mentions":[{"id":"wufan-m-463bd2a2b3575c027678","kind":"mention","text":"本篇记载：名儒善士，曾亲屈节就学于赵达","evidence":["wufan-q-d8e5edfa10a15e4625d5"]},{"id":"zhangyan-m-a4011acc495b04404fd6","kind":"mention","text":"陈寿评曰：严、程、阚生，一时儒林也","evidence":["zhangyan-q-118dd7b542a20ec2838a"]},{"id":"yululu-m-0ffcb2ef245647ca7d68","kind":"mention","text":"本篇原文记及阚泽，具体行动与称谓见引文。","evidence":["yululu-q-a7c835f82230b992cee9"]},{"id":"yululu-m-c798eda3f827cc7d84ba","kind":"mention","text":"育举太子少傅山阴阚泽，渊懿纯德、作帝师儒","evidence":["yululu-q-a10cdb7af3f03e686cf1"]}]}],"evidence":[{"id":"santizhu059-q-642194c1d800b80e867a","section":"chapter-059","block":"b-7b3d68d93f18abab5726","layer":"original","quote":"年十四，为置宫卫，使中书令阚泽教以书艺〖2〗。","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":130,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":23,"end":46,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-a574b7ad28b97b0677b2","section":"chapter-059","block":"b-6e9c3e0de1de4ad33d3b","layer":"original","quote":"赤乌五年，立为太子，时年十九。阚泽为太傅，薛综为少傅，而蔡颖、张纯、封俌、严维等，皆从容侍从","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":131,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":46,"offset_unit":"unicode_code_point"},{"id":"wufan-q-b9f045137bfd7b3217ce","section":"chapter-063","block":"b-107c2ef275bd39e731d3","layer":"original","quote":"自阚泽、殷礼皆名儒善士〖12〗，亲屈节就学：达秘而不告","section_title":"吴范刘惇赵达传第十八","source":{"file":"OEBPS/Text/titlepage_0133.xhtml","index":69,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":6,"end":33,"offset_unit":"unicode_code_point"},{"id":"wufan-q-d8e5edfa10a15e4625d5","section":"chapter-063","block":"b-107c2ef275bd39e731d3","layer":"original","quote":"阚泽、殷礼皆名儒善士","section_title":"吴范刘惇赵达传第十八","source":{"file":"OEBPS/Text/titlepage_0133.xhtml","index":69,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":7,"end":17,"offset_unit":"unicode_code_point"},{"id":"yululu-q-a10cdb7af3f03e686cf1","section":"chapter-057","block":"b-19e656ddf062438a74f1","layer":"pei","quote":"濮阳府君曰：‘御史所云，既闻其人；亚斯以下，书佐宁识之乎？’育曰：‘瞻仰景行，敢不识之！近者太守上虞陈业，洁身清行，志怀霜雪，贞亮之信，同操柳下。遭汉中微，委官弃禄；遁迹黟、歙，以求其志；高邈妙踪，天下所闻。故桓文〔林〕遗之尺牍之书，比竟三高。其聪明大略，忠直謇谔，则侍御史余姚虞翻，偏将军乌伤骆统。其渊懿纯德，则太子少傅山阴阚泽，学通行茂，作帝师儒。其雄姿武毅，立功当世，则后将军贺齐，勋成绩著。其探极秘术，言合神明，则太史令上虞吴范。其文章之士，立言粲盛，则御史中丞句章任奕，鄱阳太守章安虞翔，各驰文檄，晔若春荣。处士（邓）〔� 〕卢叙，弟犯公宪，自杀乞代。吴宁斯敦、山阴祁庚、上虞樊正，咸代父死罪。其女则松阳柳朱，永宁（瞿）〔翟〕素：或一醮守节，丧身不顾；或遭寇劫贼，死不亏行。皆近世之事，尚在耳目。’府君曰：‘皆海内之英也！吾闻秦始皇二十五年，以吴越地为会稽郡，治吴；汉封诸侯王。以何年复为郡，而分治于此？’育对曰：‘刘贾为荆王，贾为英布所杀，又以刘濞为吴王。景帝四年，濞反，诛；乃复为郡，治于吴。元鼎五年，除东越，因以其地为治，并属于此，而立东部都尉；后徙章安；阳朔元年，又徙治鄞；或有寇害，复徒句章。到永建四年，刘府君上书：浙江之北，以为吴郡；会稽还治山阴。自永建四年岁在己巳，以至今年，积百二十九岁。’府君称善。","attribution":"裴注·会稽典录","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":108,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-d74a16d867d430187c4b","start":0,"end":563,"offset_unit":"unicode_code_point"},{"id":"yululu-q-a7c835f82230b992cee9","section":"chapter-057","block":"b-139fef0974ff4bd2c7d6","layer":"pei","quote":"﹝三﹞《会稽典录》曰：“览字孝连。八岁而孤，家又单微；清身立行，用意不苟。推财从弟，以义让称。仕郡至功曹，守始平长。为人精微洁净，门无杂宾。孙权深贵待之。未及擢用，会病卒；甚见痛惜，殊其门户。览子固，字子贱。本名密，避滕密，改作固。固在襁褓中，阚泽见而异之，曰：‘此儿后必致公辅。’固少丧父，独与母居；家贫守约，色养致敬。族弟孤弱，与同寒温。翻与固同僚书曰：‘丁子贱塞渊好德，堂构克举，野无遗薪。斯之为懿，其美优矣。令德之后，惟此君嘉耳！’历显位。孙休时固为左御史大夫。孙皓即位，迁司徒。皓悖虐，固与陆凯、孟宗同心忧国。年七十六卒。子弥，字钦远。仕晋，至梁州刺史。孙潭，光禄大夫。徐陵字元大。历三县长，所在著称。迁零陵太守。时朝廷俟以列卿之位。故翻书曰：‘元大受上卿之遇；叔向在晋，未若于今。’其见重如此。陵卒，僮客土田或见侵夺；骆统为陵家讼之，求与丁览、卜清等为比：权许焉。陵子平，字伯先。童龀知名，翻甚爱之，屡称叹焉。诸葛恪为丹杨太守，讨山越；以平威重思虑，可与效力，请平为丞。稍迁武昌左部督，倾心接物，士卒皆为尽力。初，平为恪从事，意甚薄；及恪辅政，待平益疏。恪被害，子建亡走，为平部曲所得；平使遣去，别为他军所获。平两妇归宗，敬奉情过乎厚。其行义敦笃，皆此类也。”","attribution":"裴注·会稽典录","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":103,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0fc9542c4adb6310827d","start":0,"end":536,"offset_unit":"unicode_code_point"},{"id":"yululu-q-d290cedae207709779aa","section":"chapter-057","block":"b-139fef0974ff4bd2c7d6","layer":"pei","quote":"固在襁褓中，阚泽见而异之，曰：‘此儿后必致公辅","attribution":"裴注·《会稽典录》","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":103,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0fc9542c4adb6310827d","start":116,"end":139,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-118dd7b542a20ec2838a","section":"chapter-053","block":"b-54c13977d6aeab18cd97","layer":"original","quote":"评曰：张纮文理意正，为世令器〖1〗；孙策待之，亚于张昭；诚有以也〖2〗。严、程、阚生，一时儒林也。至畯辞荣济旧〖3〗，不亦长者乎〖4〗？薛综学识规纳〖5〗，为吴良臣。及莹纂蹈〖6〗，允有先风〖7〗；然于暴酷之朝，屡登显列〖8〗：君子殆诸〖9〗。","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":363,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":122,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-1d34166950c0bcd701d7","section":"chapter-053","block":"b-c54068771c5b07e0f17d","layer":"original","quote":"又诸官司有所患疾〖14〗，欲增重科防〖15〗，以检御臣下〖16〗；泽每曰“宜依礼、律”：其和而有正，皆此类也。﹝一﹞","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":124,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":65,"end":123,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-2c9a36d25280011a7371","section":"chapter-053","block":"b-82cf5a3db01dcbc02250","layer":"original","quote":"权尝问：“书传篇赋，何者为美？”泽欲讽喻以明治乱〖11〗，因对贾谊《过秦论》最善〖12〗：权览读焉","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":123,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":62,"end":111,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-3f1c4581f431eb10db9e","section":"chapter-053","block":"b-741df89c0b45269e744f","layer":"original","quote":"迁郴令","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":121,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":87,"end":90,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-46349215efb2f27db00d","section":"chapter-053","block":"b-846edb3c61aa73b55db0","layer":"pei","quote":"﹝一﹞《吴录》曰：“虞翻称泽曰：‘阚生矫杰，盖蜀之扬雄。’又曰：‘阚子儒术德行，亦今之仲舒也。’初，魏文帝即位，权尝从容问群臣曰：‘曹丕以盛年即位，恐孤不能及之；诸卿以为何如？’群臣未对，泽曰：‘不及十年，丕其没矣！大王勿忧也。’权曰：‘何以知之？’泽曰：‘以字言之，“不”、“十”为“丕”，此其数也。’文帝果七年而崩。”","attribution":"裴注·吴录","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":148,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-90a1872ce1b9f9c51f70","start":0,"end":161,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-4a2a26d62b1cfad836f0","section":"chapter-053","block":"b-846edb3c61aa73b55db0","layer":"pei","quote":"初，魏文帝即位，权尝从容问群臣曰：‘曹丕以盛年即位，恐孤不能及之；诸卿以为何如？’群臣未对，泽曰：‘不及十年，丕其没矣！大王勿忧也。’权曰：‘何以知之？’泽曰：‘以字言之，“不”、“十”为“丕”，此其数也。’","attribution":"裴注·吴录","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":148,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-90a1872ce1b9f9c51f70","start":48,"end":152,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-5e9bed0855ae724b8f71","section":"chapter-053","block":"b-c54068771c5b07e0f17d","layer":"original","quote":"初，以吕壹奸罪发闻，有司穷治，奏以大辟；或以为“宜加焚裂〖13〗，用彰元恶”。权以访泽，泽曰：“盛明之世，不宜复有此刑。”权从之。又诸官司有所患疾〖14〗，欲增重科防〖15〗，以检御臣下〖16〗；泽每曰“宜依礼、律”：其和而有正，皆此类也。﹝一﹞","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":124,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":123,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-65fdb960383b8d9fead4","section":"chapter-053","block":"b-b690f06c18fe4663e2e6","layer":"original","quote":"又著《乾象历注》，以正时日","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":122,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":105,"end":118,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-6e613c08bac8367d5823","section":"chapter-053","block":"b-b690f06c18fe4663e2e6","layer":"original","quote":"泽以经传文多，难得尽用；乃斟酌诸家，刊约《礼》文及诸注说，以授二宫〖5〗，为制行出入及见宾仪","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":122,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":55,"end":101,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-75e008196c3bbea93058","section":"chapter-053","block":"b-b690f06c18fe4663e2e6","layer":"original","quote":"以儒学勤劳，封都乡侯","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":122,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":135,"end":145,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-770269f217c5ae946fed","section":"chapter-053","block":"b-812ce9b0701e759402bb","layer":"original","quote":"六年冬卒","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":125,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":4,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-77527d6668a1801305f0","section":"chapter-053","block":"b-b690f06c18fe4663e2e6","layer":"original","quote":"嘉禾中，为中书令，加侍中","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":122,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":25,"end":37,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-7c713f77e93d18727571","section":"chapter-053","block":"b-b690f06c18fe4663e2e6","layer":"original","quote":"孙权为骠骑将军，辟补西曹掾","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":122,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":13,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-8896330432490af7a28a","section":"chapter-053","block":"b-82cf5a3db01dcbc02250","layer":"original","quote":"性谦恭笃慎，（官）〔宫〕府小吏〖7〗，呼召对问，皆为抗礼〖8〗。人有非短，口未尝及。容貌似不足者〖9〗，然所闻少穷〖10〗。权尝问：“书传篇赋，何者为美？”泽欲讽喻以明治乱〖11〗，因对贾谊《过秦论》最善〖12〗：权览读焉。","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":123,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":112,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-9955c91d9a5777f1cbca","section":"chapter-053","block":"b-c54068771c5b07e0f17d","layer":"original","quote":"或以为“宜加焚裂〖13〗，用彰元恶”。权以访泽，泽曰：“盛明之世，不宜复有此刑。”权从之。又诸官司有所患疾〖14〗，欲增重科防〖15〗，以检御臣下〖16〗；泽每曰“宜依礼、律”：其和而有正，皆此类也。﹝一﹞","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":124,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":20,"end":123,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-a4e6d6105e1f81394727","section":"chapter-053","block":"b-b690f06c18fe4663e2e6","layer":"original","quote":"及称尊号，以泽为尚书","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":122,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":14,"end":24,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-a53f5ddbced436fa20ec","section":"chapter-053","block":"b-9888b552da53b49120b0","layer":"modern","quote":"〖17〗六年：赤乌六年（公元 243）。","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":144,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-7ca9167c54fd1abf0433","start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-c510e421969d11e75367","section":"chapter-053","block":"b-b690f06c18fe4663e2e6","layer":"original","quote":"赤乌五年，拜太子太傅，领中书如故","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":122,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":38,"end":54,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-c6a5ed3f9abeb669c9a2","section":"chapter-053","block":"b-741df89c0b45269e744f","layer":"original","quote":"阚泽字德润，会稽山阴人也。家世农夫，至泽好学。居贫无资，常为人佣书〖1〗，以供纸笔；所写既毕，诵读亦遍。追师论讲〖2〗，究览群籍，兼通历数〖3〗。由是显名，察孝廉，除钱唐长。迁郴令〖4〗。","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":121,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":94,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-c948969ca66dbc379831","section":"chapter-053","block":"b-3c35b505bf673b119ca8","layer":"original","quote":"西使张奉，于权前列尚书阚泽姓名以嘲泽〖3〗，泽不能答","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":152,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":26,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-f876b4149df635694189","section":"chapter-053","block":"b-b690f06c18fe4663e2e6","layer":"original","quote":"孙权为骠骑将军，辟补西曹掾。及称尊号，以泽为尚书。嘉禾中，为中书令，加侍中。赤乌五年，拜太子太傅，领中书如故。泽以经传文多，难得尽用；乃斟酌诸家，刊约《礼》文及诸注说，以授二宫〖5〗，为制行出入及见宾仪〖6〗。又著《乾象历注》，以正时日。每朝廷大议，经典所疑，辄咨访之。以儒学勤劳，封都乡侯。","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":122,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":146,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-fc1f0ae6e502808d24ca","section":"chapter-053","block":"b-741df89c0b45269e744f","layer":"original","quote":"察孝廉，除钱唐长","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":121,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":78,"end":86,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
