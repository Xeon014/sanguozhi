hi-q-p008","luxun-q-o001","yululu-q-8b13005a9e39a626b01e","yululu-q-8672222a052e62289a5f","yululu-q-1e7db3501280f377abc5","yululu-q-b8ab92173ca33cce6651","yululu-q-05691139d7b60e0aa5ea","yululu-q-27c15dcac6a464711c49","yululu-q-3c8b2663c340a5f1d18a"],"facts":[{"id":"yululu-f-437c30230257b6bcac9a","text":"字季宁，少敦孝悌，勤修操行","evidence":["yululu-q-3c8b2663c340a5f1d18a"]}],"aliases":[],"mentions":[{"id":"sunshi-m-p008-sunshi-p0017","kind":"mention","text":"文中提及","evidence":["sunshi-q-p008"]},{"id":"sunshi-m-o026-sunshi-p0017","kind":"mention","text":"文中提及","evidence":["sunshi-q-o026"]},{"id":"luxun-m-o001-sunshi-p0017","kind":"mention","text":"文中提及","evidence":["luxun-q-o001"]},{"id":"yululu-m-0007ecb61885dd8827ca","kind":"mention","text":"本篇原文记及陆康，具体行动与称谓见引文。","evidence":["yululu-q-27c15dcac6a464711c49"]}]}],"evidence":[{"id":"luxun-e-o001a-q","section":"chapter-058","block":"b-ff4b69fec63fc12556eb","layer":"original","quote":"逊少孤，随从祖庐江太守康在官〖2〗。袁术与康有隙，将攻康；康遣逊及亲戚还吴：逊年长于康子绩数岁，为之纲纪门户〖3〗。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":1,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":28,"end":86,"offset_unit":"unicode_code_point"},{"id":"luxun-q-o001","section":"chapter-058","block":"b-ff4b69fec63fc12556eb","layer":"original","quote":"陆逊字伯言，吴郡吴人也。本名议。世江东大族〖1〗。﹝一﹞逊少孤，随从祖庐江太守康在官〖2〗。袁术与康有隙，将攻康；康遣逊及亲戚还吴：逊年长于康子绩数岁，为之纲纪门户〖3〗。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":1,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":86,"offset_unit":"unicode_code_point"},{"id":"sunshi-e-o026b-q","section":"chapter-046","block":"b-b7d697cd1a21ff6c147e","layer":"original","quote":"后术欲攻徐州，从庐江太守陆康求米三万斛〖17〗；康不与，术大怒。策昔曾诣康，康不见；使主簿接之，策尝衔恨。术遣策攻康，谓曰：“前错用陈纪，每恨本意不遂。今若得康，庐江，真卿有也〖18〗！","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":178,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":27,"end":120,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-o026","section":"chapter-046","block":"b-b7d697cd1a21ff6c147e","layer":"original","quote":"术初许策为九江太守〖15〗，已而更用丹杨陈纪〖16〗。后术欲攻徐州，从庐江太守陆康求米三万斛〖17〗；康不与，术大怒。策昔曾诣康，康不见；使主簿接之，策尝衔恨。术遣策攻康，谓曰：“前错用陈纪，每恨本意不遂。今若得康，庐江，真卿有也〖18〗！”策攻康，拔之；术复用其故吏刘勋为太守〖19〗，策益失望。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":178,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":149,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-p008","section":"chapter-046","block":"b-c373c7ace28a3ba70d51","layer":"pei","quote":"﹝二﹞《吴录》曰：“是时，庐江太守陆康从子，作宜春长。为贼所攻，遣使求救于坚。坚整严救之，主簿进谏。坚答曰：‘太守无文德，以征伐为功；越界攻讨，以全异国：以此获罪，何愧海内乎？’乃进兵往救，贼闻而走。”","attribution":"《吴录》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":80,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-d973db4b4b888a4ead83","start":0,"end":101,"offset_unit":"unicode_code_point"},{"id":"yululu-q-05691139d7b60e0aa5ea","section":"chapter-057","block":"b-7fa3bfa2381c889297d8","layer":"pei","quote":"后拜庐江太守","attribution":"裴注·谢承《后汉书》","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":154,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-72a1f387a8ca12ae03b9","start":75,"end":81,"offset_unit":"unicode_code_point"},{"id":"yululu-q-1e7db3501280f377abc5","section":"chapter-057","block":"b-7fa3bfa2381c889297d8","layer":"pei","quote":"肃后坐事伏法，康敛尸，送丧还颍川；行服，礼终","attribution":"裴注·谢承《后汉书》","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":154,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-72a1f387a8ca12ae03b9","start":37,"end":59,"offset_unit":"unicode_code_point"},{"id":"yululu-q-27c15dcac6a464711c49","section":"chapter-057","block":"b-aa002892a71ea961cb20","layer":"original","quote":"陆绩字公纪，吴郡吴人也。父康，汉末为庐江太守。﹝一﹞","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":124,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":26,"offset_unit":"unicode_code_point"},{"id":"yululu-q-3c8b2663c340a5f1d18a","section":"chapter-057","block":"b-7fa3bfa2381c889297d8","layer":"pei","quote":"﹝一﹞谢承《后汉书》曰：“康，字季宁。少敦孝悌，勤修操行。太守李肃察孝廉。肃后坐事伏法，康敛尸，送丧还颍川；行服，礼终。举茂才，历三郡太守，所在称治。后拜庐江太守。”","attribution":"裴注·谢承后汉书","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":154,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-72a1f387a8ca12ae03b9","start":0,"end":83,"offset_unit":"unicode_code_point"},{"id":"yululu-q-8672222a052e62289a5f","section":"chapter-057","block":"b-7fa3bfa2381c889297d8","layer":"pei","quote":"太守李肃察孝廉","attribution":"裴注·谢承《后汉书》","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":154,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-72a1f387a8ca12ae03b9","start":29,"end":36,"offset_unit":"unicode_code_point"},{"id":"yululu-q-8b13005a9e39a626b01e","section":"chapter-057","block":"b-aa002892a71ea961cb20","layer":"original","quote":"父康，汉末为庐江太守","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":124,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":12,"end":22,"offset_unit":"unicode_code_point"},{"id":"yululu-q-b8ab92173ca33cce6651","section":"chapter-057","block":"b-7fa3bfa2381c889297d8","layer":"pei","quote":"举茂才，历三郡太守，所在称治","attribution":"裴注·谢承《后汉书》","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":154,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-72a1f387a8ca12ae03b9","start":60,"end":74,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
