2a","xuhuwang-q-6edebf2fe593101be306","xuhuwang-q-076fe9fc0b662bbb50ba","xuhuwang-q-41574544844909d62902"],"facts":[{"id":"xuhuwang-f-5cad4f33ee9a3ace7279","text":"字景山，燕国蓟人。","evidence":["xuhuwang-q-41574544844909d62902"]}],"aliases":[],"mentions":[{"id":"shaodi-m-o040-shaodi-p0022","kind":"mention","text":"文中提及","evidence":["shaodi-q-o040"]}]}],"evidence":[{"id":"chengguo-q-2ffc36f55dbf610b6c96","section":"chapter-014","block":"b-e0d538a4c9d8de18da89","layer":"pei","quote":"如征东将军满宠、凉州刺史徐邈，并有谮毁之者；资皆盛陈其素行，使卒无纤介。宠、邈得保其功名者，资之力也","attribution":"裴注·《资别传》","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":510,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-dd527f858b45627ff07f","start":157,"end":207,"offset_unit":"unicode_code_point"},{"id":"hancui-q-e8f4da380583cef11970","section":"chapter-024","block":"b-24a29ebf8cf0df3164ca","layer":"original","quote":"后徙司徒。太傅司马宣王奏免曹爽，皇太后诏召柔〖1〗，假节，行大将军事，据爽营。太傅谓柔曰：“君为周勃矣〖2〗。”爽诛，进封万岁乡侯。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":324,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":18,"end":84,"offset_unit":"unicode_code_point"},{"id":"shaodi-e-o040a-q","section":"chapter-004","block":"b-eee70bd9a5c82e0ea03f","layer":"original","quote":"四月，以司空高柔为司徒；光禄大夫徐邈为司空〖26〗，固辞不受。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":150,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":31,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-b-60775abea476f875fc24","section":"chapter-004","block":"b-60775abea476f875fc24","layer":"modern","quote":"〖21〗九年：正始九年（公元 248）。参照下文，在“二月”之后应当有记日的干支。此处史文疑有脱落。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":174,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8324fe8afd82c8552b28","start":0,"end":50,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o039","section":"chapter-004","block":"b-e10813740402816008fd","layer":"original","quote":"九年春二月〖21〗，卫将军、中书令孙资；癸巳〖22〗，骠骑将军、中书监刘放；三月甲午〖23〗，司徒卫臻：各逊位，以侯就第〖24〗，位特进〖25〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":149,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":73,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o040","section":"chapter-004","block":"b-eee70bd9a5c82e0ea03f","layer":"original","quote":"四月，以司空高柔为司徒；光禄大夫徐邈为司空〖26〗，固辞不受。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":150,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":31,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-048a374b8da77c9c084b","section":"chapter-027","block":"b-09942697ef5a966c073b","layer":"original","quote":"车驾幸许昌，问邈曰：“颇复‘中圣人’不〖10〗？”邈对曰：“昔子反毙于穀阳〖11〗，御叔罚于饮酒〖12〗；臣嗜同二子，不能自惩〖13〗，时复中之〖14〗。然宿瘤以丑见传〖15〗，而臣以醉见识〖16〗。”帝大笑，顾左右曰：“名不虚立！","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":3,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":45,"end":161,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-076fe9fc0b662bbb50ba","section":"chapter-027","block":"b-b51fb8badd31ea17d66d","layer":"original","quote":"嘉平元年，年七十八，以大夫薨于家；用公礼葬〖30〗，谥曰穆侯。","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":8,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":31,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-206262881ed430c909ab","section":"chapter-027","block":"b-53b56755c6321df5b03e","layer":"original","quote":"公事去官。后为光禄大夫。","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":7,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":24,"end":36,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-322a75875bd797689886","section":"chapter-027","block":"b-2605737c3ddd14ed845d","layer":"original","quote":"乃（支度）〔度支〕州界军用之余，以市金帛犬马，通供中国之费〖21〗。以渐收敛民间私仗〖22〗，藏之府库。","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":5,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":51,"end":103,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-3bb3db908960d24ea35d","section":"chapter-027","block":"b-2e024074e9b50ad3a209","layer":"original","quote":"时科禁酒〖3〗，而邈私饮至于沉醉。校事赵达问以曹事〖4〗，邈曰：“中圣人〖5〗。”达白之太祖，太祖甚怒。度辽将军鲜于辅进曰〖6〗：“平日醉客谓酒清者为‘圣人’，浊者为‘贤人’。邈性修慎，偶醉言耳。”竟坐〖7〗，得免刑。","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":2,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":109,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-41574544844909d62902","section":"chapter-027","block":"b-35fa6955e189a6eac85c","layer":"original","quote":"徐邈字景山，燕国蓟人也〖1〗。太祖平河朔，召为丞相军谋掾。试守奉高令〖2〗。入为东曹议令史。魏国初建，为尚书郎。","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":1,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":56,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-42553161df8c35dd08ce","section":"chapter-027","block":"b-09942697ef5a966c073b","layer":"original","quote":"迁抚军大将军军师〖17〗。","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":3,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":162,"end":175,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-529e1470c17e7e5ec55c","section":"chapter-027","block":"b-35fa6955e189a6eac85c","layer":"original","quote":"试守奉高令〖2〗。入为东曹议令史。魏国初建，为尚书郎。","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":1,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":29,"end":56,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-65cb2c69fb3e4d75711b","section":"chapter-027","block":"b-cf3ad124cee4e6cc753d","layer":"original","quote":"至，值诸葛亮出祁山，陇右三郡反〖19〗；邈辄遣参军及金城太守等击南安贼，破之。","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":4,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":35,"end":74,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-6edebf2fe593101be306","section":"chapter-027","block":"b-1876d40263fdaeabdfa4","layer":"original","quote":"赏赐皆散与将士，无入家者；妻子衣食不充。天子闻而嘉之，随时供给其家。","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":6,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":73,"end":107,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-6f848e6d495f38a35bb4","section":"chapter-027","block":"b-53b56755c6321df5b03e","layer":"original","quote":"数岁即拜司空，邈叹曰：“三公论道之官〖29〗，无其人则缺。岂可以老病忝之哉！”遂固辞不受。","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":7,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":36,"end":81,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-816552ff903758b53cc4","section":"chapter-027","block":"b-35fa6955e189a6eac85c","layer":"original","quote":"太祖平河朔，召为丞相军谋掾。","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":1,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":15,"end":29,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-8a419fbfc8d613ad7435","section":"chapter-027","block":"b-1876d40263fdaeabdfa4","layer":"original","quote":"讨叛羌柯吾有功，封都亭侯，邑三百户；加建威将军。","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":6,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":24,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-934027f5e7ac5a47e62a","section":"chapter-027","block":"b-1876d40263fdaeabdfa4","layer":"original","quote":"邈与羌胡从事〖26〗，不问小过；若犯大罪，先告部帅〖27〗，使知；应死者，乃斩以徇：是以信服畏威。","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":6,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":24,"end":73,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-93a2637924b3d7cc6844","section":"chapter-027","block":"b-2e024074e9b50ad3a209","layer":"original","quote":"后领陇西太守，转为南安〖8〗。","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":2,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":109,"end":124,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-a3bd9583b1df1ab5c64d","section":"chapter-027","block":"b-63e8a976118c605183ac","layer":"original","quote":"卢钦著书，称邈曰：“徐公志高行洁，才博气猛。其施之也，高而不狷〖7〗，洁而不介〖8〗；博而守约，猛而能宽。圣人以靖为难，而徐公之所易也。”","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":42,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":69,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-add1b29ff84a6a99769f","section":"chapter-027","block":"b-772676769e8bfe67cf55","layer":"original","quote":"或问钦：“徐公当武帝之时〖9〗，人以为通〖10〗；自在凉州及还京师，人以为介。何也？”钦答曰：“往者毛孝先、崔季珪等用事〖11〗，贵清素之士，于时皆变易车服以求名高〖12〗，而徐公不改其常，故人以为通；比来天下奢靡〖13〗，转相仿效，而徐公雅尚自若，不与俗同。故前日之通，乃今日之介也；是世人之无常，而徐公之有常也。”","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":43,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":159,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-b4ad988fd0602e1d56fe","section":"chapter-027","block":"b-cf3ad124cee4e6cc753d","layer":"original","quote":"明帝以凉州绝远，南接蜀寇；以邈为凉州刺史，使持节，领护羌校尉〖18〗。","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":4,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":35,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-b6d2c24d91d7344ffd13","section":"chapter-027","block":"b-2605737c3ddd14ed845d","layer":"original","quote":"然后率以仁义，立学明训；禁厚葬，断淫祀〖23〗；进善黜恶，风化大行：百姓归心焉。","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":5,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":103,"end":143,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-d258182a5a246a760721","section":"chapter-027","block":"b-2605737c3ddd14ed845d","layer":"original","quote":"河右少雨，常苦乏谷。邈上修武威、酒泉盐池以收虏谷〖20〗；又广开水田，募贫民佃之：家家丰足，仓库盈溢。","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":5,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":51,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-e03cd594e883941e6363","section":"chapter-027","block":"b-53b56755c6321df5b03e","layer":"original","quote":"正始元年，还为大司农。迁为司隶校尉，百寮敬惮之。","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":7,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":24,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-e72088e32817bc022704","section":"chapter-027","block":"b-09942697ef5a966c073b","layer":"original","quote":"文帝践阼，历谯相，（平阳）〔阳平〕、安平太守，颍川典农中郎将〖9〗；所在著称，赐爵关内侯。","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":3,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":45,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
