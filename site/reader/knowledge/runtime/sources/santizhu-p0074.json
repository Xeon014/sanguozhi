18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":85,"end":89,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-c6b2cf9d50d9e3d98648","section":"chapter-048","block":"b-c05881b31e86595c49f9","layer":"original","quote":"冬十月，永安山贼施但等，聚众数千人〖12〗","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":349,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-48bf51332da896b5a859","section":"chapter-059","block":"b-993d070ed932e05166ec","layer":"pei","quote":"皓在武昌，吴兴施但因民之不堪命，聚万余人；劫谦，将至秣陵，欲立之","attribution":"裴注·吴历","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":223,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-77168bfdc9a211c11e33","start":44,"end":76,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-4d108a85100ccc747284","section":"chapter-059","block":"b-993d070ed932e05166ec","layer":"pei","quote":"但遂前到九里，固、靓出击，大破之。但兵裸身，无铠甲，临陈皆披散。谦独坐车中，遂生获之。","attribution":"裴注·吴历","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":223,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-77168bfdc9a211c11e33","start":109,"end":152,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-d2615d1a0ee788fc16c2","section":"chapter-059","block":"b-993d070ed932e05166ec","layer":"pei","quote":"未至三十里，住，择吉日，但遣使以谦命诏丁固、诸葛靓。靓即斩其使","attribution":"裴注·吴历","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":223,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-77168bfdc9a211c11e33","start":77,"end":108,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-4adb8436412b9dece098","section":"chapter-051","block":"b-a88c6de5793fe771ffb5","layer":"original","quote":"皓数遣诘楷，楷常惶怖；而猝被召，遂将妻子亲兵数百人，归晋","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":199,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":54,"end":82,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-62b7a2be010c167ef786","section":"chapter-051","block":"b-a88c6de5793fe771ffb5","layer":"original","quote":"天玺元年，征楷为宫下镇、骠骑将军","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":199,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":16,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-81c63aef25eb9c9d0ed8","section":"chapter-051","block":"b-a88c6de5793fe771ffb5","layer":"original","quote":"晋以为车骑将军，封丹杨侯","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":199,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":83,"end":95,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-93b0d6b5e1a63d078663","section":"chapter-051","block":"b-a88c6de5793fe771ffb5","layer":"original","quote":"初，永安贼施但等，劫皓弟谦，袭建业；或白楷二端不即赴讨者","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":199,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":21,"end":49,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
