eipin-q-86766bf2c71ce81cc0c8","feipin-q-ae9fe7b19276e372b1c8","feipin-q-40bf4cb2598db6786a9c"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[{"id":"feipin-q-40bf4cb2598db6786a9c","section":"chapter-050","block":"b-f4eea8e445d26359a6aa","layer":"original","quote":"植官至（大）司徒。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":140,"anchor":null},"note_id":null,"start":21,"end":30},{"id":"feipin-q-86766bf2c71ce81cc0c8","section":"chapter-050","block":"b-a5198816628abe07ecd6","layer":"pei","quote":"临海太守奚熙信讹言，举兵欲还诛都。都叔父植，时为备海督，击杀熙，夷三族；讹言乃息，而人心犹疑。”","attribution":"裴注·江表传","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":146,"anchor":null},"note_id":"n-953619b70f6ed07f746e","start":290,"end":338},{"id":"feipin-q-ae9fe7b19276e372b1c8","section":"chapter-050","block":"b-e86ebfc6806691c4527a","layer":"original","quote":"封弟洪，永平侯；蒋，溧阳侯；植，宣城侯。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":139,"anchor":null},"note_id":null,"start":39,"end":59},{"id":"santizhu-q-0878a010af9e8d9b046c","section":"chapter-048","block":"b-e56b329434e8031cc6b6","layer":"pei","quote":"皓将败，与舅何植书曰：‘昔大皇帝以神武之略，奋三千之卒；割据江南，席卷交、广：开拓洪基，欲祚之万世。至孤末德，嗣守成绪；不能怀集黎元，多为咎阙，以违天度。暗昧之变，反谓之祥；致使南蛮逆乱，征讨未克。闻晋大众，远来临江，庶竭劳瘁，众皆摧退；而张悌不返，丧军过半，孤甚愧怅，于今无聊。得陶濬表云：“武昌以西，并复不守。”不守者，非粮不足，非城不固：兵将背战耳！兵之背战，岂怨兵邪？孤之罪也！天文悬变于上，士民愤叹于下；观此事势，危如累卵；吴祚终讫，何其局哉！天匪亡吴，孤所招也！瞑目黄壤，当复何颜见四帝乎？公其勖勉奇谟，飞笔以闻","attribution":"裴注·江表传","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":553,"anchor":null},"note_id":"n-441b69ce125fcde06b54","start":11,"end":273},{"id":"santizhu-q-2edeccf46068a802049f","section":"chapter-048","block":"b-0dafd2801f25e863dc33","layer":"original","quote":"八月，以军师张悌为丞相〖13〗，牛渚都督何植为司徒〖14〗。执金吾滕（循）〔修〕为司空","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":475,"anchor":null},"note_id":null,"start":0,"end":43},{"id":"santizhu-q-cd99d4593797bb8aac59","section":"chapter-048","block":"b-bda2dc175512d4e3eb3c","layer":"original","quote":"遣三郡督何植收熙〖12〗","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":430,"anchor":null},"note_id":null,"start":66,"end":78}],"profiles":{},"directory_counts":{}}
