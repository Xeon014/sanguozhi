3e333bc0a14a28","note_id":null,"start":88,"end":99,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o187a-q","section":"chapter-001","block":"b-521a3bc138b73c58ef01","layer":"original","quote":"刘备遣张飞、马超、吴兰等屯下辩〖11〗；遣曹洪拒之。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":381,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":26,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o189a-q","section":"chapter-001","block":"b-48c05f2ce20929618c3d","layer":"original","quote":"曹洪破吴兰，斩其将任夔等。三月，张飞、马超走汉中。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":397,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":25,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o189b-q","section":"chapter-001","block":"b-48c05f2ce20929618c3d","layer":"original","quote":"阴平氐强端斩吴兰〖5〗，传其首〖6〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":397,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":25,"end":44,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-ac93ccb47f6e7be3aea4","section":"chapter-001","block":"b-ac93ccb47f6e7be3aea4","layer":"modern","quote":"〖1〗二十三年：建安二十三年（公元 218）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":403,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8cae36984cdc22e48444","start":0,"end":23,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-f23b885c4cc219692803","section":"chapter-001","block":"b-f23b885c4cc219692803","layer":"modern","quote":"〖1〗二十二年：建安二十二年（公元 217）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":383,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4fc85cb108cb7e71f49d","start":0,"end":23,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o185","section":"chapter-001","block":"b-1e821a23c7f404685c92","layer":"original","quote":"二十二年春正月〖1〗，王军居巢〖2〗。二月，进军屯江西郝溪〖3〗。权在濡须口筑城，拒守。遂逼攻之，权退走。三月，王引军还，留夏侯惇、曹仁、张辽等屯居巢。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":379,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":76,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o187","section":"chapter-001","block":"b-521a3bc138b73c58ef01","layer":"original","quote":"刘备遣张飞、马超、吴兰等屯下辩〖11〗；遣曹洪拒之。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":381,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":26,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o188","section":"chapter-001","block":"b-1336d4803d0b76311776","layer":"original","quote":"二十三年春正月〖1〗，汉太医令吉本与少府耿纪、司直韦晃等反〖2〗。攻许，烧丞相长史王必营〖3〗。﹝一﹞必与颍川典农中郎将严匡讨斩之〖4〗。﹝二﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":396,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":72,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o189","section":"chapter-001","block":"b-48c05f2ce20929618c3d","layer":"original","quote":"曹洪破吴兰，斩其将任夔等。三月，张飞、马超走汉中。阴平氐强端斩吴兰〖5〗，传其首〖6〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":397,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":44,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o042a-q","section":"chapter-009","block":"b-3a2ab390101b81a15491","layer":"original","quote":"刘备遣将吴兰屯下辩，太祖遣曹洪征之；以休为骑都尉，参洪军事。太祖谓休曰：“汝虽参军，其实帅也。”洪闻此令，亦委事于休。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":189,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":59,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o042b-q","section":"chapter-009","block":"b-3a2ab390101b81a15491","layer":"original","quote":"备遣张飞屯固山〖3〗，欲断军后。众议狐疑，休曰：“贼实断道者〖4〗，当伏兵潜行；今乃先张声势，此其不能也。宜及其未集，促击兰；兰破，则飞自走矣。”洪从之，进兵击兰，大破之，飞果走。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":189,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":59,"end":149,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-o042","section":"chapter-009","block":"b-3a2ab390101b81a15491","layer":"original","quote":"刘备遣将吴兰屯下辩，太祖遣曹洪征之；以休为骑都尉，参洪军事。太祖谓休曰：“汝虽参军，其实帅也。”洪闻此令，亦委事于休。备遣张飞屯固山〖3〗，欲断军后。众议狐疑，休曰：“贼实断道者〖4〗，当伏兵潜行；今乃先张声势，此其不能也。宜及其未集，促击兰；兰破，则飞自走矣。”洪从之，进兵击兰，大破之，飞果走。太祖拔汉中诸军还长安〖5〗，拜休中领军。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":189,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":169,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o047a-q","section":"chapter-032","block":"b-44db547f089e12d33623","layer":"original","quote":"二十三年〖10〗，先主率诸将进兵汉中。分遣将军吴兰、雷铜等入武都；皆为曹公军所没。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":202,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":41,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o047","section":"chapter-032","block":"b-44db547f089e12d33623","layer":"original","quote":"二十三年〖10〗，先主率诸将进兵汉中。分遣将军吴兰、雷铜等入武都；皆为曹公军所没。先主次于阳平关，与渊、郃等相拒。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":202,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":57,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
