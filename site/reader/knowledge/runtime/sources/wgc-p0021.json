antizhu059-q-4d108a85100ccc747284","source_order":[59,224,0],"related_events":[{"event":"santizhu-e-o079e","type":"related","evidence":["santizhu059-q-4d108a85100ccc747284","santizhu-q-40a51f0cdaaaeb785aa1"]}],"order":10477}],"persons":[{"id":"wgc-p0021","name":"诸葛靓","evidence":["wgc-q0026","wgc-q0116","santizhu-q-419ecd2292ce4d287052","santizhu-q-4569120a42261330eb66","santizhu-q-40a51f0cdaaaeb785aa1","santizhu-q-63dbb0fc9a075bddc66d","santizhu-q-8625954cb33d4468d47f","santizhu-q-0a8688dce52fa7427fff","santizhu-q-7ab3aacaf5c4af456f14","santizhu059-q-d2615d1a0ee788fc16c2","chenghuang-q-414c2d4ac18090afbb57"],"aliases":[],"facts":[],"mentions":[{"id":"wgc-m-o033-wgc-p0021","kind":"mention","text":"本段涉及诸葛靓","evidence":["wgc-q0026"]},{"id":"wgc-m-p035-wgc-p0021","kind":"mention","text":"本段涉及诸葛靓","evidence":["wgc-q0116"]}]}],"evidence":[{"id":"chenghuang-q-414c2d4ac18090afbb57","section":"chapter-055","block":"b-cfd59fad9ead02633b3b","layer":"original","quote":"宝鼎三年，皓命奉，与诸葛靓攻合肥。奉与晋大将石苞书〖17〗，构而间之〖18〗；苞以征还","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":364,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":43,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-0a8688dce52fa7427fff","section":"chapter-048","block":"b-644eb57c9a126837f3a6","layer":"pei","quote":"遂渡江战，吴军大败。诸葛靓与五六百人退走，使过迎悌","attribution":"裴注·襄阳记","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":549,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5564fe5f445521640591","start":761,"end":786,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-40a51f0cdaaaeb785aa1","section":"chapter-048","block":"b-c05881b31e86595c49f9","layer":"original","quote":"丁固、诸葛靓逆之于牛屯〖15〗；大战","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":349,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":66,"end":84,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-419ecd2292ce4d287052","section":"chapter-048","block":"b-c67c55e25345c5fcaa53","layer":"original","quote":"又遣子靓、长史吴纲、诸牙门子弟，为质","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":94,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":129,"end":147,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-4569120a42261330eb66","section":"chapter-048","block":"b-ad64edf1bd4ad11e3e6d","layer":"original","quote":"御史大夫丁固、右将军诸葛靓，镇建业","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":329,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":19,"end":36,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-63dbb0fc9a075bddc66d","section":"chapter-048","block":"b-4311ae30072f04acbaa0","layer":"pei","quote":"吴副军师诸葛靓，欲屠之，悌曰：‘敌在前，不宜先事其小；且杀降不祥。’靓曰：‘此等以救兵未至而力少，故且伪降以缓我；非来伏也。因其无战心而尽坑之，可以成三军之气。若舍之而前，必为后患！’悌不从，抚之而进","attribution":"裴注·干宝《晋纪》","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":548,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5564fe5f445521640591","start":68,"end":168,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-7ab3aacaf5c4af456f14","section":"chapter-048","block":"b-644eb57c9a126837f3a6","layer":"pei","quote":"靓自往牵之，谓曰：‘（且夫）天下存亡有大数，岂卿一人所知！如何故自取死为？’悌垂涕曰：‘仲思！今日是我死日也！且我作儿童时，便为卿家丞相所拔；常恐不得其死，负名贤知顾。今以身徇社稷，复何遁邪？莫牵曳之如是！’靓流涕放之","attribution":"裴注·襄阳记","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":549,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5564fe5f445521640591","start":792,"end":901,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-8625954cb33d4468d47f","section":"chapter-048","block":"b-644eb57c9a126837f3a6","layer":"pei","quote":"晋来伐吴，皓使悌督沈莹、诸葛靓，率众三万渡江逆之","attribution":"裴注·襄阳记","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":549,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5564fe5f445521640591","start":461,"end":485,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-4d108a85100ccc747284","section":"chapter-059","block":"b-993d070ed932e05166ec","layer":"pei","quote":"但遂前到九里，固、靓出击，大破之。但兵裸身，无铠甲，临陈皆披散。谦独坐车中，遂生获之。","attribution":"裴注·吴历","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":223,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-77168bfdc9a211c11e33","start":109,"end":152,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-d2615d1a0ee788fc16c2","section":"chapter-059","block":"b-993d070ed932e05166ec","layer":"pei","quote":"未至三十里，住，择吉日，但遣使以谦命诏丁固、诸葛靓。靓即斩其使","attribution":"裴注·吴历","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":223,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-77168bfdc9a211c11e33","start":77,"end":108,"offset_unit":"unicode_code_point"},{"id":"wgc-q0026","section":"chapter-028","block":"b-a7bfa7539b76de4cb092","layer":"original","quote":"二年五月〖5〗，征为司空。诞被诏书，愈恐，遂反。召会诸将，自出攻扬州刺史乐綝〖6〗，杀之。﹝一﹞敛淮南及淮北郡县、屯田口十余万官兵，扬州新附胜兵者四五万人〖7〗，聚谷足一年食，闭城自守。遣长史吴纲将小子靓，至吴请救。﹝二﹞","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":173,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":111,"offset_unit":"unicode_code_point"},{"id":"wgc-q0116","section":"chapter-028","block":"b-7250287caaecda5d07c5","layer":"pei","quote":"﹝二﹞干宝《晋纪》曰：“初，寿春每岁雨潦，淮水溢，常淹城邑。故文王之筑围也，诞笑之曰：‘是固不攻而自败也！’及大军之攻，亢旱逾年。城既陷，是日大雨，围垒皆毁。诞子靓，字仲思。吴平还晋。靓子恢，字道明。位至尚书令，追赠左光禄大夫，开府。”","attribution":"干宝晋纪","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":232,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b0443e64d8a54e613793","start":0,"end":118,"offset_unit":"unicode_code_point"},{"id":"wgc-q0271","section":"chapter-028","block":"b-070f7f878b699e9dd8f2","layer":"modern","quote":"〖5〗二年：甘露二年（公元 257）。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":181,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-41029aa679c68595f342","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wgc-q0274","section":"chapter-028","block":"b-a7bfa7539b76de4cb092","layer":"original","quote":"遣长史吴纲将小子靓，至吴请救","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":173,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":93,"end":107,"offset_unit":"unicode_code_point"},{"id":"wgc-q0676","section":"chapter-028","block":"b-7250287caaecda5d07c5","layer":"pei","quote":"吴平还晋。","attribution":"干宝晋纪","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":232,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b0443e64d8a54e613793","start":87,"end":92,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
