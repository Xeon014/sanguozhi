code_point"},{"id":"liuliao-q-a8c6eaae2d4d4e8506b4","section":"chapter-040","block":"b-e38db0cdb51ec11fb3f3","layer":"original","quote":"胡具以告言琰〖20〗，琰坐下狱。有司议曰：“卒，非挝妻之人；面，非受履之地。”琰竟弃市〖21〗。自是，大臣妻、母朝庆遂绝","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":241,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":60,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
