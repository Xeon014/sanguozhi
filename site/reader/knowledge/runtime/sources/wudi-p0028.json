{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o002a","title":"桥玄与何颙赏识曹操","accounts":[{"id":"wudi-e-o002a-account","label":"正文","text":"曹操少年时多不被世人看重，桥玄、何颙却认为他不凡；桥玄认为他有济乱之才。","evidence":["wudi-e-o002a-q"]}],"participants":[{"person":"cao-cao","role":"受赏识","evidence":["wudi-e-o002a-q"]},{"person":"wudi-p0028","role":"评价","evidence":["wudi-e-o002a-q"]},{"person":"wudi-p0029","role":"赏识","evidence":["wudi-e-o002a-q"]}],"place":null,"time":{"label":"曹操少年时","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-o002a-q"]},"source_order":[1,18,"O002a"],"order":11},{"id":"wudi-e-p007a","title":"桥玄以妻子托曹操","accounts":[{"id":"wudi-e-p007a-account","label":"《魏书》","text":"《魏书》记桥玄称赏曹操，并愿将妻子儿女托付给他。","evidence":["wudi-e-p007a-q"]}],"participants":[{"person":"wudi-p0028","role":"称赏托付","evidence":["wudi-e-p007a-q"]},{"person":"cao-cao","role":"受托","evidence":["wudi-e-p007a-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p007a-q"]},"source_order":[1,33,"P007a"],"order":15},{"id":"wudi-e-p009a","title":"桥玄因病罢太尉","accounts":[{"id":"wudi-e-p009a-account","label":"《汉纪》","text":"桥玄在光和年间任太尉，因久病罢职，又拜太中大夫。","evidence":["wudi-e-p009a-q"]}],"participants":[{"person":"wudi-p0028","role":"罢职迁官","evidence":["wudi-e-p009a-q"]}],"place":null,"time":{"label":"光和中","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p009a-q"]},"source_order":[1,35,"P009a"],"order":16},{"id":"wudi-e-p009b","title":"桥玄卒而家贫","accounts":[{"id":"wudi-e-p009b-account","label":"《汉纪》","text":"张璠《汉纪》记桥玄去世时家贫，甚至无资殡葬。","evidence":["wudi-e-p009b-q"]}],"participants":[{"person":"wudi-p0028","role":"去世","evidence":["wudi-e-p009b-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p009b-q"]},"source_order":[1,35,"P009b"],"order":17},{"id":"wudi-e-p010a","title":"桥玄荐曹操交许子将","accounts":[{"id":"wudi-e-p010a-account","label":"《世语》","text":"桥玄建议曹操结交许子将，曹操往访并获接纳，由此知名。","evidence":["wudi-e-p010a-q"]}],"participants":[{"person":"wudi-p0028","role":"建议","evidence":["wudi-e-p010a-q"]},{"person":"cao-cao","role":"往访","evidence":["wudi-e-p010a-q"]},{"person":"wudi-p0030","role":"接纳","evidence":["wudi-e-p010a-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p010a-q"]},"source_order":[1,36,"P010a"],"order":18},{"id":"wudi-e-o085b","title":"曹操治睢阳渠祭桥玄","accounts":[{"id":"wudi-e-o085b-account","label":"正文","text":"曹操至浚仪治睢阳渠，遣使以太牢祭桥玄，继而进军官渡。","evidence":["wudi-e-o085b-q"]}],"participants":[{"person":"cao-cao","role":"治渠遣祭","evidence":["wudi-e-o085b-q"]},{"person":"wudi-p0028","role":"受祭","evidence":["wudi-e-o085b-q"]}],"place":{"text":"浚仪、睢阳渠、官渡","evidence":["wudi-e-o085b-q"]},"time":{"label":"建安七年","year":202,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o085b-q","wudi-q-o085","wudi-q-b-6de9e09a3ba1d95f3972"],"chronology":"wudi-y202","dating_review":{"anchor":"wudi-q-o085","basis":"建安七年","reviewed":true}},"source_order":[1,459,"O085b"],"order":203},{"id":"wendi-e-o004a","title":"谯现黄龙单飏预言王者兴","accounts":[{"id":"wendi-e-o004a-account","label":"《文帝纪》正文","text":"谯现黄龙单飏预言王者兴","evidence":["wendi-e-o004a-q"]}],"participants":[{"person":"wudi-p0028","role":"问祥","evidence":["wendi-e-o004a-q"]},{"person":"wendi-p0002","role":"预言","evidence":["wendi-e-o004a-q"]},{"person":"wendi-p0003","role":"记言","evidence":["wendi-e-o004a-q"]}],"place":null,"time":{"year":176,"label":"汉熹平五年","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"wendi-y176","dating_review":{"reviewed":true,"anchor":"wendi-q-o004","basis":"汉熹平五年"},"evidence":["wendi-e-o004a-q","wendi-q-o004","wendi-q-b-ea1701bac033a55b3725"]},"ordering_evidence":"wendi-e-o004a-q","source_order":[2,16,"O004a"],"order":471}],"persons":[{"id":"wudi-p0028","name":"桥玄","evidence":["wudi-q-o002","wendi-q-o004"],"facts":[{"id":"wudi-f-p008-wudi-p0028-c55038","label":"字","text":"公祖","evidence":["wudi-q-p008"]}],"aliases":[{"text":"公祖","evidence":["wudi-q-p008"]}],"mentions":[{"id":"wudi-m-o002-wudi-p0028","kind":"mention","text":"文中提及","evidence":["wudi-q-o002"]},{"id":"wudi-m-p007-wudi-p0028","kind":"mention","text":"文中提及","evidence":["wudi-q-p007"]},{"id":"wudi-m-p008-wudi-p0028","kind":"mention","text":"文中提及","evidence":["wudi-q-p008"]},{"id":"wudi-m-p009-wudi-p0028","kind":"mention","text":"文中提及","evidence":["wudi-q-p009"]},{"id":"wudi-m-p010-wudi-p0028","kind":"mention","text":"文中提及","evidence":["wudi-q-p010"]},{"id":"wudi-m-p026-wudi-p0028","kind":"mention","text":"文中提及","evidence":["wudi-q-p026"]},{"id":"wudi-m-o085-wudi-p0028","kind":"mention","text":"文中提及","evidence":["wudi-q-o085"]},{"id":"wudi-m-p064-wudi-p0028","kind":"mention","text":"文中提及","evidence":["wudi-q-p064"]},{"id":"wendi-m-o004-wudi-p0028","kind":"mention","text":"文中提及","evidence":["wendi-q-o004"]},{"id":"wendi-m-o053-wudi-p0028","kind":"allusion","text":"祖系或典故提及","evidence":["wendi-q-o053"]}]}],"evidence":[{"id":"wendi-e-o004a-q","section":"chapter-002","block":"b-b0d3c82e3d1c42e2cd0c","layer":"original","quote":"初，汉熹平五年〖8〗，黄龙现谯〖9〗。光禄大夫桥玄问太史令单飏〖10〗：“此何祥也〖11〗？”飏曰：“其国，后当有王者兴。不及五十年〖12〗，亦当复现。天事恒象〖13〗，此其应也。”内黄殷登默而记之。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":15,"anchor":null},"note_id":null,"start":0,"end":100},{"id":"wendi-q-b-ea1701bac033a55b3725","section":"chapter-002","block":"b-ea1701bac033a55b3725","layer":"modern","quote":"〖8〗熹平五年：公元 176 年。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":25,"anchor":null},"note_id":"n-1aa19f6feba4e668650c","start":0,"end":17},{"id":"wendi-q-o004","section":"chapter-002","block":"b-b0d3c82e3d1c42e2cd0c","layer":"original","quote":"初，汉熹平五年〖8〗，黄龙现谯〖9〗。光禄大夫桥玄问太史令单飏〖10〗：“此何祥也〖11〗？”飏曰：“其国，后当有王者兴。不及五十年〖12〗，亦当复现。天事恒象〖13〗，此其应也。”内黄殷登默而记之。至四十五年，登尚在。三月，黄龙现谯，登闻之曰：“单飏之言，其验兹乎！”﹝二﹞","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":15,"anchor":null},"note_id":null,"start":0,"end":138},{"id":"wendi-q-o053","section":"chapter-002","block":"b-1d30ef656dda0ab13df8","layer":"original","quote":"冬十月，行幸广陵故城〖15〗，临江观兵〖16〗。戎卒十余万，旌旗数百里。﹝二﹞是岁，大寒，水道冰，舟不得入江；乃引还。十一月，东武阳王鉴薨。十二月，行自谯过梁〖17〗，遣使以太牢祀故汉太尉桥玄。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":465,"anchor":null},"note_id":null,"start":0,"end":97},{"id":"wudi-e-o002a-q","section":"chapter-001","block":"b-be6ee1955b4d2400e13d","layer":"original","quote":"嵩生太祖。太祖少机警，有权数〖1〗。而任侠放荡〖2〗，不治行业〖3〗，故世人未之奇也〖4〗。﹝一﹞惟梁国桥玄、南阳何颙异焉〖5〗。玄谓太祖曰：“天下将乱，非命世之才不能济也〖6〗。能安之者，其在君乎！”﹝二﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":17,"anchor":null},"note_id":null,"start":0,"end":104},{"id":"wudi-e-o085b-q","section":"chapter-001","block":"b-a8b85fd0a011c49dc335","layer":"original","quote":"遂至浚仪〖11〗，治睢阳渠〖12〗；遣使以太牢祀桥玄〖13〗。﹝一﹞进军官渡。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":458,"anchor":null},"note_id":null,"start":138,"end":177},{"id":"wudi-e-p007a-q","section":"chapter-001","block":"b-b793036e493f3d88a501","layer":"pei","quote":"太尉桥玄，世名知人，睹太祖而异之，曰：‘吾见天下名士多矣，未有若君者也！君善自持。吾老矣！愿以妻子为托。’由是声名益重。","attribution":"《魏书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":32,"anchor":null},"note_id":"n-4b0db760310d0caa5fad","start":10,"end":70},{"id":"wudi-e-p009a-q","section":"chapter-001","block":"b-5b63615f895c633b2240","layer":"pei","quote":"光和中为太尉，以久病策罢。拜太中大夫。","attribution":"《汉纪》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":34,"anchor":null},"note_id":"n-4b0db760310d0caa5fad","start":32,"end":51},{"id":"wudi-e-p009b-q","section":"chapter-001","block":"b-5b63615f895c633b2240","layer":"pei","quote":"卒，家贫乏产业，柩无所殡。当世以此称为名臣。","attribution":"《汉纪》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":34,"anchor":null},"note_id":"n-4b0db760310d0caa5fad","start":51,"end":73},{"id":"wudi-e-p010a-q","section":"chapter-001","block":"b-d52f4a808aa2fd44a80c","layer":"pei","quote":"《世语》曰：“玄谓太祖曰：‘君未有名，可交许子将。’太祖乃造子将。子将纳焉，由是知名。”","attribution":"《世语》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":35,"anchor":null},"note_id":"n-4b0db760310d0caa5fad","start":0,"end":44},{"id":"wudi-q-b-6de9e09a3ba1d95f3972","section":"chapter-001","block":"b-6de9e09a3ba1d95f3972","layer":"modern","quote":"〖5〗七年：建安七年（公元 202）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":464,"anchor":null},"note_id":"n-225e544b9b47ac46c22e","start":0,"end":19},{"id":"wudi-q-o002","section":"chapter-001","block":"b-be6ee1955b4d2400e13d","layer":"original","quote":"嵩生太祖。太祖少机警，有权数〖1〗。而任侠放荡〖2〗，不治行业〖3〗，故世人未之奇也〖4〗。﹝一﹞惟梁国桥玄、南阳何颙异焉〖5〗。玄谓太祖曰：“天下将乱，非命世之才不能济也〖6〗。能安之者，其在君乎！”﹝二﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":17,"anchor":null},"note_id":null,"start":0,"end":104},{"id":"wudi-q-o085","section":"chapter-001","block":"b-a8b85fd0a011c49dc335","layer":"original","quote":"七年春正月〖5〗，公军谯。令曰：“吾起义兵，为天下除暴乱。旧土人民〖6〗，死丧略尽〖7〗。国中终日行，不见所识〖8〗，使吾凄怆伤怀！其举义兵以来〖9〗，将士绝无后者，求其亲戚以后之〖10〗；授土田，官给耕牛；置学师以教之。为存者立庙，使祀其先人。魂而有灵，吾百年之后何恨哉！”遂至浚仪〖11〗，治睢阳渠〖12〗；遣使以太牢祀桥玄〖13〗。﹝一﹞进军官渡。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":458,"anchor":null},"note_id":null,"start":0,"end":177},{"id":"wudi-q-p007","section":"chapter-001","block":"b-b793036e493f3d88a501","layer":"pei","quote":"﹝二﹞《魏书》曰：“太尉桥玄，世名知人，睹太祖而异之，曰：‘吾见天下名士多矣，未有若君者也！君善自持。吾老矣！愿以妻子为托。’由是声名益重。”","attribution":"《魏书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":32,"anchor":null},"note_id":"n-4b0db760310d0caa5fad","start":0,"end":71},{"id":"wudi-q-p008","section":"chapter-001","block":"b-0a2e06f2b8303171e435","layer":"pei","quote":"《续汉书》曰：“玄字公祖。严明有才略，长于人物。”","attribution":"《续汉书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":33,"anchor":null},"note_id":"n-4b0db760310d0caa5fad","start":0,"end":25},{"id":"wudi-q-p009","section":"chapter-001","block":"b-5b63615f895c633b2240","layer":"pei","quote":"张璠《汉纪》曰：“玄历位中外，以刚断称。谦俭下士，不以王爵私亲。光和中为太尉，以久病策罢。拜太中大夫。卒，家贫乏产业，柩无所殡。当世以此称为名臣。”","attribution":"《汉纪》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":34,"anchor":null},"note_id":"n-4b0db760310d0caa5fad","start":0,"end":74},{"id":"wudi-q-p010","section":"chapter-001","block":"b-d52f4a808aa2fd44a80c","layer":"pei","quote":"《世语》曰：“玄谓太祖曰：‘君未有名，可交许子将。’太祖乃造子将。子将纳焉，由是知名。”","attribution":"《世语》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":35,"anchor":null},"note_id":"n-4b0db760310d0caa5fad","start":0,"end":44},{"id":"wudi-q-p026","section":"chapter-001","block":"b-4deebbcde1ac1f9ea901","layer":"pei","quote":"﹝五﹞《英雄记》曰：“瑁字元伟。玄族子。先为兖州刺史，甚有威惠。”","attribution":"《英雄记》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":94,"anchor":null},"note_id":"n-e0e778cc8691b030ffc3","start":0,"end":33},{"id":"wudi-q-p064","section":"chapter-001","block":"b-f96befa547fa37c887f2","layer":"pei","quote":"﹝一﹞《褒赏令》载公祀文曰：“故太尉桥公，诞敷明德，泛爱博容；国念明训，士思令谟。灵幽体翳，邈哉晞矣！吾以幼年，逮升堂室；特以顽鄙之姿，为大君子所纳；增荣益观，皆由奖助：犹仲尼称不如颜渊，李生之厚叹贾复。士死知己，怀此无忘。又承从容约誓之言：‘殂逝之后，路有经由，不以斗酒只鸡过相沃酹；车过三步，腹痛勿怪！’虽临时戏笑之言，非至亲之笃好，胡肯为此辞乎？匪谓灵忿，能贻己疾；怀旧惟顾，念之凄怆！奉命东征，屯次乡里；北望贵土，乃心陵墓。裁致薄奠，公其尚飨！”","attribution":"《褒赏令》所载曹操祭文","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":474,"anchor":null},"note_id":"n-1a299cfb0fa3b783d823","start":0,"end":227}],"profiles":{},"directory_counts":{}}
