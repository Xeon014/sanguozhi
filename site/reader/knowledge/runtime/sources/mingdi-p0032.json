{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"mingdi-e-o034a","title":"胡遵讨降叛匈奴","accounts":[{"id":"mingdi-e-o034a-account","label":"《明帝纪》正文","text":"胡遵讨降叛匈奴","evidence":["mingdi-e-o034a-q"]}],"participants":[{"person":"mingdi-p0032","role":"叛降","evidence":["mingdi-e-o034a-q"]},{"person":"wudi-p0364","role":"遣将","evidence":["mingdi-e-o034a-q"]},{"person":"mingdi-p0033","role":"讨降","evidence":["mingdi-e-o034a-q"]}],"place":null,"time":{"year":233,"label":"青龙元年秋九月","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"mingdi-y233","dating_review":{"reviewed":true,"anchor":"mingdi-q-o030","basis":"青龙元年秋九月"},"evidence":["mingdi-e-o034a-q","mingdi-q-o030","mingdi-q-o037","mingdi-q-b-7a11c761ca65aeb3d195"]},"ordering_evidence":"mingdi-e-o034a-q","source_order":[3,215,"O034a"],"order":826}],"persons":[{"id":"mingdi-p0032","name":"胡薄居姿职","evidence":["mingdi-q-o034"],"facts":[],"aliases":[],"mentions":[{"id":"mingdi-m-o034-mingdi-p0032","kind":"mention","text":"文中提及","evidence":["mingdi-q-o034"]}]}],"evidence":[{"id":"mingdi-e-o034a-q","section":"chapter-003","block":"b-95dd799f2af7548409aa","layer":"original","quote":"秋九月，安定保塞匈奴大人胡薄居姿职等，叛；司马宣王遣将军胡遵等追讨〖19〗，破降之。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":214,"anchor":null},"note_id":null,"start":0,"end":42},{"id":"mingdi-q-b-7a11c761ca65aeb3d195","section":"chapter-003","block":"b-7a11c761ca65aeb3d195","layer":"modern","quote":"〖1〗二年：青龙二年（公元 234）。己未：旧历初四日。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":252,"anchor":null},"note_id":"n-6c0753fe684a18a3a281","start":0,"end":28},{"id":"mingdi-q-o030","section":"chapter-003","block":"b-cb99fef1996d806deb1c","layer":"original","quote":"青龙元年春正月，甲申〖1〗，青龙现郏之摩陂井中〖2〗。二月，丁酉〖3〗，幸摩陂观龙。于是改年，改摩陂为龙陂。赐男子爵，人二级；鳏寡孤独。无出今年租赋。三月，甲子〖4〗，诏公卿举贤良、笃行之士。各一人。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":210,"anchor":null},"note_id":null,"start":0,"end":100},{"id":"mingdi-q-o034","section":"chapter-003","block":"b-95dd799f2af7548409aa","layer":"original","quote":"秋九月，安定保塞匈奴大人胡薄居姿职等，叛；司马宣王遣将军胡遵等追讨〖19〗，破降之。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":214,"anchor":null},"note_id":null,"start":0,"end":42},{"id":"mingdi-q-o037","section":"chapter-003","block":"b-ff97c2d326d0fc08a9de","layer":"original","quote":"二年春二月，（乙）〔己〕未〖1〗，太白犯荧惑。癸酉〖2〗，诏曰：“‘鞭作官刑〖3〗’，所以纠慢怠也〖4〗；而顷多以无辜死。其减鞭杖之制〖5〗，著于令。”三月，庚寅〖6〗，山阳公薨；帝素服发哀〖7〗，遣使持节，典护丧事。己酉〖8〗，大赦。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":249,"anchor":null},"note_id":null,"start":0,"end":118}],"profiles":{},"directory_counts":{}}
