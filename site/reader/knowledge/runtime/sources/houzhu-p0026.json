327f922c2"],"facts":[{"id":"erfei-f2-416f773257157f0767d3","text":"刘璿字文衡，母王贵人原为敬哀张皇后侍人；立太子时年十五。","evidence":["erfei-q2-478bae2e56304e34573c"]}],"aliases":[],"mentions":[{"id":"houzhu-m-houzhu-q-O036-houzhu-p0026","kind":"mention","text":"文中提及","evidence":["houzhu-q-O036"]},{"id":"jfj-m-o030-houzhu-p0026","kind":"mention","text":"本段记载：费祎长女为刘璿妃","evidence":["jfj-q0123"]},{"id":"wgc-m-o066-houzhu-p0026","kind":"mention","text":"本段涉及刘璿","evidence":["wgc-q0050"]},{"id":"wgc-m-o067-houzhu-p0026","kind":"mention","text":"本段涉及刘璿","evidence":["wgc-q0051"]}]}],"evidence":[{"id":"erfei-q-2b75180de6685687580b","section":"chapter-034","block":"b-caa1bd390bc6a9f3db51","layer":"original","quote":"璿为乱兵所害","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":93,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":24,"end":30,"offset_unit":"unicode_code_point"},{"id":"erfei-q-be066eabde783ade7a19","section":"chapter-034","block":"b-7da40348af4a58b0e891","layer":"original","quote":"延熙元年正月策曰","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":92,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":25,"end":33,"offset_unit":"unicode_code_point"},{"id":"erfei-q2-478bae2e56304e34573c","section":"chapter-034","block":"b-7da40348af4a58b0e891","layer":"original","quote":"后主太子璿，字文衡。母王贵人，本敬哀张皇后侍人也。延熙元年正月策曰：“在昔帝王，继体立嗣〖1〗；副贰国统，古今常道。今以璿为皇太子，昭显祖宗之威。命使行丞相事、左将军朗，持节，授印绶。其勉修茂质，祗恪道义；咨询典礼，敬友师傅；斟酌众善，翼成尔德〖2〗。可不务修以自勖哉〖3〗！”时年十五。","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":92,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":144,"offset_unit":"unicode_code_point"},{"id":"houzhu-q-O036","section":"chapter-033","block":"b-106d75ef6065149f87ea","layer":"original","quote":"延熙元年春正月〖1〗，立皇后张氏〖2〗。大赦，改元。立子璿为太子〖3〗，子瑶为安定王。","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":94,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":43,"offset_unit":"unicode_code_point"},{"id":"huowang-q-6714d239c8f327f922c2","section":"chapter-041","block":"b-e6998c80678c2b5e8a5a","layer":"original","quote":"璿好骑射，出入无度；弋援引古义，尽言规谏，甚得切磋之体","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":5,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":84,"end":111,"offset_unit":"unicode_code_point"},{"id":"huowang-q-f3e6022f0747ba914447","section":"chapter-041","block":"b-e6998c80678c2b5e8a5a","layer":"original","quote":"后主立太子璿，以弋为中庶子","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":5,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":67,"end":80,"offset_unit":"unicode_code_point"},{"id":"jfj-q0123","section":"chapter-044","block":"b-83db8e3f53b71e459c76","layer":"original","quote":"子承嗣，为黄门侍郎。承弟恭，尚公主。﹝七﹞祎长女，配太子璿为妃。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":116,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":32,"offset_unit":"unicode_code_point"},{"id":"jfj-q0125","section":"chapter-044","block":"b-83db8e3f53b71e459c76","layer":"original","quote":"祎长女，配太子璿为妃。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":116,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":21,"end":32,"offset_unit":"unicode_code_point"},{"id":"wgc-q0050","section":"chapter-028","block":"b-ab37cd18c6e8ebcec1ec","layer":"original","quote":"刘禅遣使奉皇帝玺绶，为笺诣艾请降。艾至成都，禅率太子、诸王及群臣六十余人，面缚舆榇诣军门〖1〗。艾执节，解缚焚榇，受而宥之。检御将士，无所虏略；绥纳降附，使复旧业：蜀人称焉。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":347,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":87,"offset_unit":"unicode_code_point"},{"id":"wgc-q0051","section":"chapter-028","block":"b-3b75cd8087fec2db4ca3","layer":"original","quote":"辄依邓禹故事〖2〗，承制拜禅行骠骑将军，太子奉车〖3〗，诸王驸马都尉〖4〗。蜀群司各随高下，拜为王官，或领艾官属。以师纂领益州刺史，陇西太守牵弘等领蜀中诸郡。使于绵竹筑台以为京观〖5〗，用彰战功。士卒死事者，皆与蜀兵同共埋藏。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":348,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":113,"offset_unit":"unicode_code_point"},{"id":"wgc-q0388","section":"chapter-028","block":"b-3b75cd8087fec2db4ca3","layer":"original","quote":"辄依邓禹故事〖2〗，承制拜禅行骠骑将军，太子奉车〖3〗，诸王驸马都尉〖4〗。蜀群司各随高下，拜为王官，或领艾官属","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":348,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":56,"offset_unit":"unicode_code_point"}],"profiles":{"houzhu-p0026":{"fields":[],"directory":{"faction":"shu"}}},"directory_counts":{}}
