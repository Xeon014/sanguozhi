{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"shaodi-e-o061a","title":"李丰张缉谋以夏侯玄为大将军事觉被诛","accounts":[{"id":"shaodi-e-o061a-account","label":"《三少帝纪》正文","text":"李丰张缉谋以夏侯玄为大将军事觉被诛","evidence":["shaodi-e-o061a-q"]},{"id":"xiahoucao-e-o103a-account","label":"《诸夏侯曹传第九》正文","text":"诏原齐长公主三子免死李丰夏侯玄等夷族","evidence":["xiahoucao-e-o103a-q"]},{"id":"xiahoucao-e-o103b-account","label":"《诸夏侯曹传第九》正文","text":"夏侯玄临斩东市自若年四十六","evidence":["xiahoucao-e-o103b-q"]},{"id":"xiahoucao-a-o108-review-xuan","label":"陈寿评","text":"陈寿称夏侯玄格量名望，也批其未匡曹爽之非、援致良才。","evidence":["xiahoucao-q-o108-review-xuan"]},{"id":"rensu-a-401d302f435ba5950969","label":"裴注·傅子","text":"李恢死后，李丰为中书令，父子兄弟皆诛","evidence":["rensu-q-fbfc1f3607c397ecf600"]}],"participants":[{"person":"shaodi-p0062","role":"谋易大臣","evidence":["shaodi-e-o061a-q"]},{"person":"shaodi-p0063","role":"参与谋议","evidence":["shaodi-e-o061a-q"]},{"person":"shaodi-p0064","role":"被诛","evidence":["xiahoucao-e-o103a-q"]},{"person":"xiahoucao-p0104","role":"被诛","evidence":["xiahoucao-e-o103a-q"]},{"person":"xiahoucao-p0105","role":"被诛","evidence":["xiahoucao-e-o103a-q"]},{"person":"xiahoucao-p0106","role":"被诛","evidence":["xiahoucao-e-o103a-q"]}],"place":null,"time":{"year":254,"label":"二月庚戌","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"shaodi-y254","dating_review":{"reviewed":true,"anchor":"shaodi-q-o059","basis":"二月庚戌"},"evidence":["shaodi-e-o061a-q","shaodi-q-o059","shaodi-q-b-91c7db3288e80e5b9e4b"]},"ordering_evidence":"shaodi-e-o061a-q","source_order":[4,269,"O061a"],"order":1111},{"id":"xiahoucao-e-o100a","title":"李丰等谋临轩诛司马师改夏侯玄张缉官与苏铄等约","accounts":[{"id":"xiahoucao-e-o100a-account","label":"《诸夏侯曹传第九》正文","text":"李丰等谋临轩诛司马师改夏侯玄张缉官与苏铄等约","evidence":["xiahoucao-e-o100a-q"]},{"id":"xiahoucao-e-p054b-account","label":"《魏书》","text":"李丰约苏铄等临轩胁帝诛司马师张缉遣子张邈同谋","evidence":["xiahoucao-e-p054b-q"]}],"participants":[{"person":"shaodi-p0062","role":"谋议","evidence":["xiahoucao-e-o100a-q"]},{"person":"xiahoucao-p0104","role":"许诺","evidence":["xiahoucao-e-o100a-q"]},{"person":"xiahoucao-p0105","role":"许诺","evidence":["xiahoucao-e-o100a-q"]},{"person":"xiahoucao-p0106","role":"许诺","evidence":["xiahoucao-e-o100a-q"]},{"person":"shaodi-p0063","role":"遣子","evidence":["xiahoucao-e-p054b-q"]},{"person":"xiahoucao-p0111","role":"结谋","evidence":["xiahoucao-e-p054b-q"]}],"place":null,"time":{"year":254,"label":"嘉平六年二月","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xiahoucao-y254","dating_review":{"reviewed":true,"anchor":"xiahoucao-q-o100","basis":"嘉平六年二月"},"evidence":["xiahoucao-e-o100a-q","xiahoucao-q-o100","shaodi-q-o059","shaodi-q-b-91c7db3288e80e5b9e4b"]},"ordering_evidence":"xiahoucao-e-o100a-q","source_order":[9,583,"O100a"],"order":2340},{"id":"xiahoucao-e-o101a","title":"司马师召李丰即杀收夏侯玄张缉等钟毓奏论法","accounts":[{"id":"xiahoucao-e-o101a-account","label":"《诸夏侯曹传第九》正文","text":"司马师召李丰即杀收夏侯玄张缉等钟毓奏论法","evidence":["xiahoucao-e-o101a-q"]},{"id":"xiahoucao-e-p055a-account","label":"《世语》","text":"王羡向司马师请召李丰并设拒召预案乃迎丰","evidence":["xiahoucao-e-p055a-q"]},{"id":"xiahoucao-e-p055b-account","label":"《魏氏春秋》","text":"《魏氏春秋》称司马师责李丰，李丰斥其父子怀奸，司马师怒令勇士以刀环筑腰杀之。","evidence":["xiahoucao-e-p055b-q"]},{"id":"xiahoucao-e-p056i-account","label":"《魏略》","text":"《魏略》称景王知李丰议己，召丰，丰不实告而被杀，事秘。","evidence":["xiahoucao-e-p056i-q"]}],"participants":[{"person":"shaodi-p0038","role":"杀人治狱","evidence":["xiahoucao-e-o101a-q"]},{"person":"shaodi-p0062","role":"被杀","evidence":["xiahoucao-e-o101a-q"]},{"person":"shaodi-p0064","role":"被收","evidence":["xiahoucao-e-o101a-q"]},{"person":"shaodi-p0063","role":"被收","evidence":["xiahoucao-e-o101a-q"]},{"person":"xiahoucao-p0104","role":"被收","evidence":["xiahoucao-e-o101a-q"]},{"person":"xiahoucao-p0105","role":"被收","evidence":["xiahoucao-e-o101a-q"]},{"person":"xiahoucao-p0106","role":"被收","evidence":["xiahoucao-e-o101a-q"]},{"person":"shaodi-p0093","role":"奏法","evidence":["xiahoucao-e-o101a-q"]},{"person":"xiahoucao-p0112","role":"请