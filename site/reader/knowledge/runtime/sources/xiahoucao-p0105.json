e_0013_split_000.xhtml","index":275,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-386affd091adab4ef2df","start":0,"end":28,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o059","section":"chapter-004","block":"b-83849af55ebd17291970","layer":"original","quote":"六年春二月，己丑〖1〗，镇东将军毌丘俭上言：“昔诸葛恪围合肥新城，城中遣士刘整出围〖2〗，传消息，为贼所得。考问所传，语整曰：‘诸葛公欲活汝，汝可具服〖3〗。’整骂曰：‘死狗，此何言也！我当必死为魏国鬼！不苟求活逐汝去也。欲杀我者，便速杀之！’终无他辞。又遣士郑像出城传消息。或以语恪，恪遣马骑寻围迹索，得像还。四五人的头面缚〖4〗，将绕城表。敕语像〖5〗，使大呼，言：‘大军已还洛，不如早降！’像不从其言，更大呼城中曰：‘大军近在围外，壮士努力！’贼以刀筑其口，使不得言。像遂大呼，令城中闻知。整、像为兵，能守义执节，子弟宜有差异〖6〗。”","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":266,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":271,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o100a-q","section":"chapter-009","block":"b-23e2c5b4fe1020c88bf5","layer":"original","quote":"嘉平六年二月，当拜贵人〖5〗。丰等欲因御临轩〖6〗，诸门有陛兵〖7〗，诛大将军；以玄代之，以缉为骠骑将军。丰密语黄门监苏铄、永宁署令乐敦、冗从仆射刘贤等曰〖8〗：“卿诸人居内，多有不法；大将军严毅，累以为言。张当可以为诫〖9〗！”铄等皆许以从命。﹝二﹞","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":582,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":126,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o101a-q","section":"chapter-009","block":"b-820cad0cf3fc52c5c84b","layer":"original","quote":"大将军微闻其谋〖10〗，请丰相见；丰不知而往，即杀之。﹝三﹞事下有司，收玄、缉、铄、敦、贤等送廷尉。﹝四﹞廷尉钟毓奏：“丰等谋迫胁至尊，擅诛冢宰〖11〗，大逆无道。请论如法〖12〗。”","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":583,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":92,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o103a-q","section":"chapter-009","block":"b-81b2bba6833a95ef3701","layer":"original","quote":"诏书：“齐长公主先帝遗爱〖20〗，原其三子死命。”于是丰、玄、缉、 〔铄〕 、敦、贤等，皆夷三族；﹝五﹞其余，亲属徙乐浪郡。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":585,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":62,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o103b-q","section":"chapter-009","block":"b-81b2bba6833a95ef3701","layer":"original","quote":"玄格量弘济〖21〗，临斩东市〖22〗，颜色不变，举动自若。时年四十六。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":585,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":62,"end":97,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-p054b-q","section":"chapter-009","block":"b-70d83084548daf5da0b9","layer":"pei","quote":"韬于是往报丰，密语黄门监苏铄等。苏铄等答丰：‘惟君侯计。’丰言曰：‘今拜贵人，诸营兵皆屯门。陛下临轩，因此便共迫胁，将群僚人兵，就诛大将军。卿等当共密白此意。’铄等曰：‘陛下傥不从人，奈何？’丰等曰：‘事有权宜！临时若不信听，便当劫将去耳。那得不从！’铄等许诺。丰曰：‘此族灭事，卿等密之！事成，卿等皆当封侯、常侍也。’丰复密以告玄、缉。缉遣子邈与丰相结，同谋起事。","attribution":"《魏书》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":613,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c44e0083c4a365fd5d28","start":323,"end":506,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-p055a-q","section":"chapter-009","block":"b-162374bb52fb1597ca0e","layer":"pei","quote":"大将军闻丰谋，舍人王（羕）〔羡〕请以命请丰：‘丰若无备，情屈势迫，必来；若不来，（羕）〔羡〕一人足以制之。若知谋泄，以众挟轮，长戟自卫，径入云龙门；挟天子登凌云台，台上有三千人仗，鸣鼓会众。如此，（羕）〔羡〕所不及也。’大将军乃遣（羕）〔羡〕以车迎之。丰见劫迫，随（羕）〔羡〕而至。","attribution":"《世语》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":614,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-bf13de5cd1b966f56f0e","start":10,"end":151,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-p055b-q","section":"chapter-009","block":"b-162374bb52fb1597ca0e","layer":"pei","quote":"大将军责丰；丰知祸及，遂正色曰：‘卿父子怀奸，将倾社稷。惜吾力劣，不能相擒灭耳！’大将军怒，使勇士以刀环筑丰腰，杀之。","attribution":"《魏氏春秋》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":614,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-bf13de5cd1b966f56f0e","start":161,"end":220,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-p056i-q","section":"chapter-009","block":"b-876aff4f7f73869ce262","layer":"pei","quote":"景王知其议己，请丰；丰不以实告，乃杀之。其事秘。","attribution":"《魏略》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":615,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-bf13de5cd1b966f56f0e","start":568,"end":592,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-o100","section":"chapter-009","block":"b-23e2c5b4fe1020c88bf5","layer":"original","quote":"嘉平六年二月，当拜贵人〖5〗。丰等欲因御临轩〖6〗，诸门有陛兵〖7〗，诛大将军；以玄代之，以缉为骠骑将军。丰密语黄门监苏铄、永宁署令乐敦、冗从仆射刘贤等曰〖8〗：“卿诸人居内，多有不法；大将军严毅，累以为言。张当可以为诫〖9〗！”铄等皆许以从命。﹝二﹞","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":582,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":126,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-o101","section":"chapter-009","block":"b-820cad0cf3fc52c5c84b","layer":"original","quote":"大将军微闻其谋〖10〗，请丰相见；丰不知而往，即杀之。﹝三﹞事下有司，收玄、缉、铄、敦、贤等送廷尉。﹝四﹞廷尉钟毓奏：“丰等谋迫胁至尊，擅诛冢宰〖11〗，大逆无道。请论如法〖12〗。”","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":583,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":92,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-o103","section":"chapter-009","block":"b-81b2bba6833a95ef3701","layer":"original","quote":"诏书：“齐长公主先帝遗爱〖20〗，原其三子死命。”于是丰、玄、缉、 〔铄〕 、敦、贤等，皆夷三族；﹝五﹞其余，亲属徙乐浪郡。玄格量弘济〖21〗，临斩东市〖22〗，颜色不变，举动自若。时年四十六。﹝六﹞","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":585,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":100,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-o108-review-xuan","section":"chapter-009","block":"b-e8aa83f31b75ca2487ba","layer":"original","quote":"评曰：夏侯、曹氏，世为婚姻。故惇、渊、仁、洪、休、尚、真等，并以亲旧肺腑〖1〗，贵重于时；左右勋业〖2〗，咸有效劳〖3〗。爽德薄位尊，沉溺盈溢〖4〗；此固大《易》所著〖5〗，道家所忌也〖6〗。玄以规格局度〖7〗，世称其名；然与曹爽中外缱绻〖8〗，荣位如斯；曾未闻匡弼其非，援致良才。举兹以论，焉能免之乎〖9〗？","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":643,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":155,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
