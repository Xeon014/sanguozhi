702c9ce5","source_order":[22,383,75],"order":4583},{"id":"hechang-e-c8db718711a9b2f77109","title":"梁习荐常林等曹操以为县长","accounts":[{"id":"hechang-a-c8db718711a9b2f77109","label":"正文","text":"梁习荐常林等曹操以为县长","evidence":["hechang-q-82ae2818151ca6070e3a"]}],"participants":[{"person":"wendi-p0031","role":"荐举","evidence":["hechang-q-82ae2818151ca6070e3a"]},{"person":"cao-cao","role":"任命","evidence":["hechang-q-82ae2818151ca6070e3a"]},{"person":"wudi-p0321","role":"受任","evidence":["hechang-q-82ae2818151ca6070e3a"]},{"person":"cuimao-p0041","role":"受任","evidence":["hechang-q-82ae2818151ca6070e3a"]},{"person":"shaodi-p0004","role":"受任","evidence":["hechang-q-82ae2818151ca6070e3a"]},{"person":"xiahoucao-p0084","role":"受任","evidence":["hechang-q-82ae2818151ca6070e3a"]},{"person":"hechang-p-08d1fb9c1d12ad","role":"受任","evidence":["hechang-q-82ae2818151ca6070e3a"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["hechang-q-82ae2818151ca6070e3a"]},"ordering_evidence":"hechang-q-82ae2818151ca6070e3a","order":4690}],"persons":[{"id":"wendi-p0031","name":"梁习","evidence":["wendi-q-o049","huanchen-q-06d8eedae584702c9ce5","liusima-q-dbfec0f9b985eb3ca575","liusima-q-e3f77d0d243301abd2ed","liusima-q-57fabc50b2baa6a907b2","liusima-q-f8189373c99805183a9f","liusima-q-91a38f8479c8644ab806","liusima-q-33c4936b1ffd5eefd7b6","liusima-q-6586ca93d3c335c0d2ab","liusima-q-1729ffa03fd42bcdc7af","liusima-q-cee8bf97b2e16128f5de","liusima-q-211a507531e3a5e66d51","liusima-q-5c307b21ac35fa83a933","liusima-q-59f0f2376afbb17200df","liusima-q-9c82646570d98f881e8c","liusima-q-045846e6aa298c4df891","liusima-q-c13419c9bb0d3850dedb","liusima-q-b8b8fdcd00f5907fd90c","liusima-q-12097fe98eecb435ca0e","liusima-q-cc6cb9918f19a0e75be8","liusima-q-8357d9c62d774b1f5972","liusima-q-7c768a646245ab55c06d","liusima-q2-4bde34ad97335ed3033f","liusima-q2-294bd3f6a396a9f14087","hechang-q-82ae2818151ca6070e3a"],"facts":[{"id":"liusima-f2-e4d80c9379802028bc4b","text":"历郡纲纪、章长，迁乘氏、海西、下邳令，为西曹令史，迁属。","evidence":["liusima-q-7c768a646245ab55c06d"]},{"id":"liusima-f2-31cec13b7664134a2e54","text":"进封申门亭侯，邑百户。","evidence":["liusima-q2-4bde34ad97335ed3033f"]},{"id":"liusima-f2-ca74d62f531caa6e08ba","text":"太和二年征拜大司农。","evidence":["liusima-q2-294bd3f6a396a9f14087"]}],"aliases":[],"mentions":[{"id":"wendi-m-o049-wendi-p0031","kind":"mention","text":"文中提及","evidence":["wendi-q-o049"]}]}],"evidence":[{"id":"hechang-q-82ae2818151ca6070e3a","section":"chapter-023","block":"b-ab97e3071a95f7f68c96","layer":"original","quote":"后刺史梁习，荐州界名士林及杨俊、王凌、王象、荀纬〖1〗，太祖皆以为县长。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":114,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":36,"offset_unit":"unicode_code_point"},{"id":"huanchen-q-06d8eedae584702c9ce5","section":"chapter-022","block":"b-76f5b2a0b26b5519ef32","layer":"original","quote":"海西、淮浦二县民作乱〖4〗；都尉卫弥、令梁习夜奔宣家〖5〗，密送免之","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":382,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":75,"end":109,"offset_unit":"unicode_code_point"},{"id":"liusima-q-045846e6aa298c4df891","section":"chapter-015","block":"b-838334a9c8a55f111f7c","layer":"original","quote":"四年薨〖3〗，子施嗣","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":123,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":44,"end":54,"offset_unit":"unicode_code_point"},{"id":"liusima-q-0e962d904b246bc2978b","section":"chapter-015","block":"b-bb9f5fb910ff412a2da9","layer":"original","quote":"思因直日白事〖4〗，失太祖指〖5〗；太祖大怒，教召主者，将加重辟","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":124,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":16,"end":48,"offset_unit":"unicode_code_point"},{"id":"liusima-q-12097fe98eecb435ca0e","section":"chapter-015","block":"b-b0201fcf74e9a553c67d","layer":"pei","quote":"市易未毕，市吏收缚一胡。延骑皆惊，上马弯弓围习数重；吏民惶怖不知所施。习乃徐呼市吏，问缚胡意。而胡实侵犯人。习乃使译呼延，延到，习责延曰：‘汝胡自犯法，吏不侵汝，汝何为使诸骑惊骇邪！’遂斩之，余胡破胆不敢动。是后无寇虏","attribution":"裴注·魏略","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":121,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8f3fa47404936b4d9fd2","start":96,"end":205,"offset_unit":"unicode_code_point"},{"id":"liusima-q-1729ffa03fd42bcdc7af","section":"chapter-015","block":"b-87dfcb2115b071f68883","layer":"original","quote":"建安十八年，州并属冀州；更拜议郎、西部都督从事〖17〗，统属冀州，总故部曲","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":99,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":37,"offset_unit":"unicode_code_point"},{"id":"liusima-q-211a507531e3a5e66d51","section":"chapter-015","block":"b-87dfcb2115b071f68883","layer":"original","quote":"习表置屯田都尉二人〖18〗，领客六百夫〖19〗；于道次耕种菽粟，以给人牛之费","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":99,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":52,"end":90,"offset_unit":"unicode_code_point"},{"id":"liusima-q-33c4936b1ffd5eefd7b6","section":"chapter-015","block":"b-c1b385cb79382f8ddc99","layer":"original","quote":"边境肃清，百姓布野；勤劝农桑，令行禁止","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":98,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":224,"end":243,"offset_unit":"unicode_code_point"},{"id":"liusima-q-57fabc50b2baa6a907b2","section":"chapter-015","block":"b-c1b385cb79382f8ddc99","layer":"original","quote":"豪右已尽，乃次发诸丁强以为义从〖10〗；又因大军出征，分请以为勇力","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":98,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":112,"end":145,"offset_unit":"unicode_code_point"},{"id":"liusima-q-59f0f2376afbb17200df","section":"chapter-015","block":"b-2d08c99d78a93a648dec","layer":"original","quote":"文帝践阼，复置并州，复为刺史","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":122,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":14,"offset_unit":"unicode_code_point"},{"id":"liusima-q-5c307b21ac35fa83a933","section":"chapter-015","block":"b-87dfcb2115b071f68883","layer":"original","quote":"后单于入侍，西北无虞，习之绩也","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":99,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":91,"end":106,"offset_unit":"unicode_code_point"},{"id":"liusima-q-6586ca93d3c335c0d2ab","section":"chapter-015","block":"b-c1b385cb79382f8ddc99","layer":"original","quote":"太祖嘉之，赐爵关内侯，更拜为真","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":98,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":262,"end":277,"offset_unit":"unicode_code_point"},{"id":"liusima-q-7c768a646245ab55c06d","section":"chapter-015","block":"b-4f933b9bbac3318e8851","layer":"original","quote":"梁习字子虞，陈郡柘人也〖1〗。为郡纲纪。太祖为司空，辟召为（漳）〔章〕长〖2〗。累转乘氏、海西、下邳令〖3〗，所在有治名。还为西曹令史〖4〗，迁为属。","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":97,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":75,"offset_unit":"unicode_code_point"},{"id":"liusima-q-8357d9c62d774b1f5972","section":"chapter-015","block":"b-b0201fcf74e9a553c67d","layer":"pei","quote":"始，太祖闻昔叛，恐其为乱于北边；会闻已杀之，大喜。以习前后有策略，封为关内侯","attribution":"裴注·魏略","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":121,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8f3fa47404936b4d9fd2","start":371,"end":409,"offset_unit":"unicode_code_point"},{"id":"liusima-q-91a38f8479c8644ab806","section":"chapter-015","block":"b-c1b385cb79382f8ddc99","layer":"original","quote":"其不从命者，兴兵致讨；斩首千数，降附者万计","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":98,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":172,"end":193,"offset_unit":"unicode_code_point"},{"id":"liusima-q-9c82646570d98f881e8c","section":"chapter-015","block":"b-838334a9c8a55f111f7c","layer":"original","quote":"习在州二十余年，而居处贫穷，无方面珍物〖2〗。明帝异之，礼赐甚厚","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":123,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":11,"end":43,"offset_unit":"unicode_code_point"},{"id":"liusima-q-ae94c5e4911e13480dc2","section":"chapter-015","block":"b-bb9f5fb910ff412a2da9","layer":"original","quote":"思乃驰还，自陈己罪，罪应受死。太祖叹习之不言，思之识分。曰：“何意吾军中有二义士乎","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":124,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":68,"end":109,"offset_unit":"unicode_code_point"},{"id":"liusima-q-b8b8fdcd00f5907fd90c","section":"chapter-015","block":"b-b0201fcf74e9a553c67d","layer":"pei","quote":"鲜卑大人育延，常为州所畏。而一旦将其部落五千余骑，诣习，求互市。习念：不听则恐其怨；若听到州下，又恐为所略。于是乃许之往与会空城中，交市。遂敕郡县，自将治中以下军，往就之","attribution":"裴注·魏略","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":121,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8f3fa47404936b4d9fd2","start":10,"end":95,"offset_unit":"unicode_code_point"},{"id":"liusima-q-c13419c9bb0d3850dedb","section":"chapter-015","block":"b-bb9f5fb910ff412a2da9","layer":"original","quote":"时思近出，习代往对，已被收执","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":124,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":52,"end":66,"offset_unit":"unicode_code_point"},{"id":"liusima-q-cc6cb9918f19a0e75be8","section":"chapter-015","block":"b-b0201fcf74e9a553c67d","layer":"pei","quote":"昔有爱妻，住在晋阳。昔既思之，又恐遂不得归，乃以其部五百骑，叛还并州；留其余骑置山谷间，而单骑独入晋阳，盗取其妻。已出城，州郡乃觉。吏民又畏昔善射，不敢追。习乃令从事张景募鲜卑，使逐昔。昔马负其妻，重骑行迟；未及与其众合，而为鲜卑所射死","attribution":"裴注·魏略","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":121,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8f3fa47404936b4d9fd2","start":252,"end":370,"offset_unit":"unicode_code_point"},{"id":"liusima-q-cee8bf97b2e16128f5de","section":"chapter-015","block":"b-87dfcb2115b071f68883","layer":"original","quote":"又使于上党取大材，供邺宫室","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":99,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":38,"end":51,"offset_unit":"unicode_code_point"},{"id":"liusima-q-dbfec0f9b985eb3ca575","section":"chapter-015","block":"b-c1b385cb79382f8ddc99","layer":"original","quote":"并土新附，习以别部司马领并州刺史。时承高幹荒乱之余，胡狄在界（张雄）〔雄张〕跋扈；吏民亡叛，入其部落。兵家拥众〖5〗，作为寇害；更相扇动，往往棋峙","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":98,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":73,"offset_unit":"unicode_code_point"},{"id":"liusima-q-dfb5390d74a8232458d1","section":"chapter-015","block":"b-c1b385cb79382f8ddc99","layer":"original","quote":"单于恭顺，名王稽颡；部曲服事供职〖12〗，同于编户","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":98,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":194,"end":219,"offset_unit":"unicode_code_point"},{"id":"liusima-q-e3f77d0d243301abd2ed","section":"chapter-015","block":"b-c1b385cb79382f8ddc99","layer":"original","quote":"习到官，诱喻招纳，皆礼召其豪右〖7〗，稍稍荐举〖8〗，使诣幕府","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":98,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":77,"end":108,"offset_unit":"unicode_code_point"},{"id":"liusima-q-f6faf7b404d26ee2fb21","section":"chapter-015","block":"b-3c4d050d20c8005f61d4","layer":"modern","quote":"〖3〗四年：太和四年（公元 230）。","attribution":"现代注释","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":128,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0cf27a38f20bca3128d6","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"liusima-q-f8189373c99805183a9f","section":"chapter-015","block":"b-c1b385cb79382f8ddc99","layer":"original","quote":"吏兵已去之后，稍移其家；前后送邺，凡数万口","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":98,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":150,"end":171,"offset_unit":"unicode_code_point"},{"id":"liusima-q2-294bd3f6a396a9f14087","section":"chapter-015","block":"b-838334a9c8a55f111f7c","layer":"original","quote":"太和二年，征拜大司农。习在州二十余年，而居处贫穷，无方面珍物〖2〗。明帝异之，礼赐甚厚。四年薨〖3〗，子施嗣。","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":123,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":55,"offset_unit":"unicode_code_point"},{"id":"liusima-q2-4bde34ad97335ed3033f","section":"chapter-015","block":"b-2d08c99d78a93a648dec","layer":"original","quote":"文帝践阼，复置并州，复为刺史；进封申门亭侯，邑百户。政治常为天下最〖1〗。","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":122,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":37,"offset_unit":"unicode_code_point"},{"id":"liusima-q2-fa642b7614cd145f9aba","section":"chapter-015","block":"b-87dfcb2115b071f68883","layer":"original","quote":"建安十八年，州并属冀州；更拜议郎、西部都督从事〖17〗，统属冀州，总故部曲。又使于上党取大材，供邺宫室。习表置屯田都尉二人〖18〗，领客六百夫〖19〗；于道次耕种菽粟，以给人牛之费。后单于入侍，西北无虞，习之绩也。﹝一﹞","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":99,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":110,"offset_unit":"unicode_code_point"},{"id":"wendi-e-o049c-q","section":"chapter-002","block":"b-d5847039c2d504d36e8e","layer":"original","quote":"并州刺史梁习讨鲜卑轲比能〖6〗，大破之。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":461,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":71,"end":91,"offset_unit":"unicode_code_point"},{"id":"wendi-q-b-e28c5cd47fe98ad60171","section":"chapter-002","block":"b-e28c5cd47fe98ad60171","layer":"modern","quote":"〖1〗六年：黄初六年（公元 225）。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":467,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-61512c4ade75d71d6a76","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wendi-q-o049","section":"chapter-002","block":"b-d5847039c2d504d36e8e","layer":"original","quote":"六年春二月〖1〗，遣使者循行许昌以东，尽沛郡〖2〗。问民所疾苦，贫者赈贷之。﹝一﹞三月，行幸召陵〖3〗，通讨虏渠〖4〗。乙巳〖5〗，还许昌宫。并州刺史梁习讨鲜卑轲比能〖6〗，大破之。辛未〖7〗，帝为舟师，东征。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":461,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":105,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
