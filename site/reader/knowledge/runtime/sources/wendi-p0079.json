en-q-4b8f894ed8ecebdf3691","huanchen-q-c7f8aa442079f52aa289","huanchen-q-d86105732daa498225dc","huanchen-q-a05c0959e185a7fd4159","huanchen-q-d7ec06ed742d60318e2a","huanchen-q-f17cfdc502a23703eef5","huanchen-q-42cfc335c2160f875d4a","huanchen-q-222ce66085d03c4fc145","huanchen-q-4ce8dbd077599ec646a5","chengguo-q-7122a87d9baebcf83d8e","cuimao-q-f9b34731544f1f3d79d4"],"facts":[],"aliases":[],"mentions":[{"id":"wendi-m-p030-wendi-p0079","kind":"mention","text":"文中提及","evidence":["wendi-q-p030"]},{"id":"wendi-m-p039-wendi-p0079","kind":"mention","text":"文中提及","evidence":["wendi-q-p039"]},{"id":"mingdi-m-o053-wendi-p0079","kind":"mention","text":"文中提及","evidence":["mingdi-q-o053"]},{"id":"mingdi-m-o065-wendi-p0079","kind":"mention","text":"文中提及","evidence":["mingdi-q-o065"]},{"id":"shaodi-m-o039-wendi-p0079","kind":"mention","text":"文中提及","evidence":["shaodi-q-o039"]},{"id":"wgc-m-p026-wendi-p0079","kind":"mention","text":"本段涉及卫臻","evidence":["wgc-q0109"]},{"id":"huanchen-m-42d71d82fc7186a23d91","kind":"mention","text":"本段涉及卫臻","evidence":["huanchen-q-2929c6b6b5c74f0fdd1a"]}]}],"evidence":[{"id":"chengguo-q-7122a87d9baebcf83d8e","section":"chapter-014","block":"b-283a8ac0a4b3a3e647f8","layer":"original","quote":"晔议曰：“圣帝孝孙之欲褒崇先祖，诚无量已。然亲疏之数，远近之降，盖有礼纪；所以割断私情，克成公法，为万世式也。周王所以上祖后稷者，以其佐唐有功〖8〗，名在祀典故也。至于汉氏之初，追谥之义，不过其父〖9〗。上比周室，则大魏发迹自高皇始；下论汉氏，则追谥之礼不及其祖：此诚往代之成法，当今之明义也。陛下孝思中发，诚无已已；然君举必书〖10〗，所以慎于礼制也。以为追尊之义，宜齐高皇而已。”尚书卫臻，与晔议同〖11〗，事遂施行","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":340,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":210,"offset_unit":"unicode_code_point"},{"id":"cuimao-q-415d1419c6a2a158f0a2","section":"chapter-012","block":"b-55c24cb840d03886971a","layer":"original","quote":"后二旬，文帝亦崩，莫不为勋叹恨","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":305,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":20,"end":35,"offset_unit":"unicode_code_point"},{"id":"cuimao-q-7a3cffa956653aa11de0","section":"chapter-012","block":"b-15725c07c00dbde011b6","layer":"original","quote":"廷尉法议〖19〗：“正刑五岁〖20〗。”三官驳〖21〗：“依律，罚金二斤","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":304,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":36,"offset_unit":"unicode_code_point"},{"id":"cuimao-q-99dc418111faa5df3f94","section":"chapter-012","block":"b-15725c07c00dbde011b6","layer":"original","quote":"帝不许，遂诛勋","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":304,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":138,"end":145,"offset_unit":"unicode_code_point"},{"id":"cuimao-q-e22917c9d226c4dc1f26","section":"chapter-012","block":"b-15725c07c00dbde011b6","layer":"original","quote":"帝大怒曰：“勋无活分，而汝等敢纵之！收三官以下付刺奸〖22〗，当令十鼠同穴","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":304,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":38,"end":75,"offset_unit":"unicode_code_point"},{"id":"cuimao-q-f9b34731544f1f3d79d4","section":"chapter-012","block":"b-15725c07c00dbde011b6","layer":"original","quote":"太尉钟繇、司徒华歆、镇军大将军陈群、侍中辛毗、尚书卫臻、守廷尉高柔等〖24〗，并表“勋父信有功于太祖”，求请勋罪","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":304,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":81,"end":137,"offset_unit":"unicode_code_point"},{"id":"hancui-q-25af6afd313a5069383e","section":"chapter-024","block":"b-74fce0f98849d3b3d185","layer":"original","quote":"后年，遂为司空，封安阳亭侯，邑六百户。三公封列侯，自林始也。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":81,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":30,"offset_unit":"unicode_code_point"},{"id":"hancui-q-9bc6393060972e742e0b","section":"chapter-024","block":"b-79edcd7298f3d52b0257","layer":"pei","quote":"﹝一﹞臣松之以为：汉封丞相邑，为荀悦所讥；魏封三公，其失同也。","attribution":"裴注·裴松之评论","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":105,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-90491e541dbabf9c6065","start":0,"end":31,"offset_unit":"unicode_code_point"},{"id":"huanchen-q-107909331934ed8f5aeb","section":"chapter-022","block":"b-6fb821eddefd3afb9329","layer":"original","quote":"幽州刺史毌丘俭上疏曰〖29〗：“陛下即位以来，未有可书。吴、蜀恃险，未可猝平；聊可以此方无用之士，克定辽东〖30〗。”臻曰：“俭所陈皆战国细术，非王者之事也。吴频岁称兵，寇乱边境；而犹按甲养士，未果寻致讨者〖31〗，诚以百姓疲劳故也。且渊生长海表〖32〗，相承三世〖33〗；外抚戎夷，内修战射。而俭欲以偏军长驱〖34〗，朝至夕卷，知其妄矣。”俭行，军遂不利","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":456,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":178,"offset_unit":"unicode_code_point"},{"id":"huanchen-q-189f6221ce84b9952e83","section":"chapter-022","block":"b-3164b264690f834c075d","layer":"original","quote":"征东大将军曹休，表得降贼辞〖3〗，“孙权已在濡须口〖4〗”。臻曰：“权恃长江，未敢抗衡。此必畏怖伪辞耳。”考核降者，果守将诈所作也","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":446,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":12,"end":77,"offset_unit":"unicode_code_point"},{"id":"huanchen-q-222ce66085d03c4fc145","section":"chapter-022","block":"b-78709bf1a5e891b21d32","layer":"original","quote":"东郡朱越谋反，引臻。太祖令曰：“孤与卿君同共举事〖7〗，加钦令问〖8〗；始闻越言，固自不信；及得荀令君书〖9〗，具亮忠诚","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":427,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":162,"end":222,"offset_unit":"unicode_code_point"},{"id":"huanchen-q-25e417541639f644fbf7","section":"chapter-022","block":"b-0a31b545734a6374e4f0","layer":"original","quote":"臻答曰：“古人遗智慧而任度量〖6〗；须考绩而加黜陟。今子同牧野于成、康〖7〗；喻断蛇于文、景〖8〗；好不经之举〖9〗，开拔奇之津〖10〗。将使天下驰骋而起矣","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":452,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":93,"end":171,"offset_unit":"unicode_code_point"},{"id":"huanchen-q-2929c6b6b5c74f0fdd1a","section":"chapter-022","block":"b-c244875cc30f324b80d0","layer":"original","quote":"评曰：桓阶识睹成败，才周当世〖1〗。陈群动仗名义，有清流雅望；泰弘济简至〖2〗，允克堂构矣〖3〗。魏世事统台阁〖4〗，重内轻外；故八座尚书〖5〗，即古六卿之任也〖6〗。陈、徐、卫、卢，久居斯位；矫、宣刚断骨鲠；臻、毓规鉴清理：咸不忝厥职云","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":604,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":119,"offset_unit":"unicode_code_point"},{"id":"huanchen-q-3622c05da673319406b0","section":"chapter-022","block":"b-2306f8c5823cba4a18da","layer":"original","quote":"臻曰：“然，吴之骁将，必下从权；且为势以缀征南耳","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":455,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":29,"end":53,"offset_unit":"unicode_code_point"},{"id":"huanchen-q-42cfc335c2160f875d4a","section":"chapter-022","block":"b-78709bf1a5e891b21d32","layer":"original","quote":"夏侯惇为陈留太守〖5〗，举臻计吏；命妇出宴，臻以为“末世之俗〖6〗，非礼之正”。惇怒，执臻，既而赦之","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":427,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":103,"end":153,"offset_unit":"unicode_code_point"},{"id":"huanchen-q-4b8f894ed8ecebdf3691","section":"chapter-022","block":"b-6fb821eddefd3afb9329","layer":"original","quote":"臻迁为司空。徙司徒","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":456,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":179,"end":188,"offset_unit":"unicode_code_point"},{"id":"huanchen-q-4ce8dbd077599ec646a5","section":"chapter-022","block":"b-94aa648c86ff9d70509b","layer":"original","quote":"会奉诏命，聘贵人于魏〖11〗，因表留臻参丞相军事。追录臻父旧勋，赐爵关内侯。转为户曹掾","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":428,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":43,"offset_unit":"unicode_code_point"},{"id":"huanchen-q-53405ac699db36d39017","section":"chapter-022","block":"b-265c739dc4f9c7875507","layer":"original","quote":"臻奏：“宜遣奇兵入散关〖13〗，绝其粮道。”乃以臻为征蜀将军〖14〗，假节，督诸军事。到长安，亮退。还，复职，加光禄大夫","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":453,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":11,"end":71,"offset_unit":"unicode_code_point"},{"id":"huanchen-q-5e927a27f6574676683e","section":"chapter-022","block":"b-0a31b545734a6374e4f0","layer":"original","quote":"明帝即位，进封康乡侯。后转为右仆射，典选举，如前加侍中。中护军蒋济遗臻书曰〖1〗：“汉祖遇亡虏为上将〖2〗，周武拔渔父为太师〖3〗。布衣厮养〖4〗，可登王公；何必守文〖5〗，试而后用","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":452,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":91,"offset_unit":"unicode_code_point"},{"id":"huanchen-q-7771445ccb5e8e408ac1","section":"chapter-022","block":"b-6a49514fafa64d9c087a","layer":"original","quote":"文帝即王位，为散骑常侍。及践阼，封安国亭侯","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":445,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"huanchen-q-7c9b173f47e86b6bd00e","section":"chapter-022","block":"b-2306f8c5823cba4a18da","layer":"original","quote":"帝欲自东征，臻曰：“权外示应亮，内实观望；且合肥城固，不足为虑。车驾可无亲征，以省六军之费。”帝到寻阳，而权竟退","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":455,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":76,"end":132,"offset_unit":"unicode_code_point"},{"id":"huanchen-q-a05c0959e185a7fd4159","section":"chapter-022","block":"b-62ccfab46bacc14e8c55","layer":"original","quote":"曹爽辅政，使夏侯玄宣指〖5〗，欲引臻入守尚书令〖6〗，及为弟求婚；皆不许","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":492,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":105,"end":141,"offset_unit":"unicode_code_point"},{"id":"huanchen-q-a5d783e869696ae049e0","section":"chapter-022","block":"b-c47f1e02f1725b9a0914","layer":"original","quote":"是时，帝方隆意于殿舍〖15〗，臻数切谏。及殿中监擅收兰台令史〖16〗，臻奏案之〖17〗。诏曰：“殿舍不成，吾所留心。卿推之何〖18〗？”臻上疏曰：“古制侵官之法〖19〗，非恶其勤事也〖20〗；诚以所益者小，所隳者大也〖21〗。臣每察校事〖22〗，类皆如此；惧群司将遂越职，以至陵迟矣","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":454,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":141,"offset_unit":"unicode_code_point"},{"id":"huanchen-q-c7f8aa442079f52aa289","section":"chapter-022","block":"b-62ccfab46bacc14e8c55","layer":"original","quote":"太祖久不立太子，而方奇贵临淄侯〖1〗。丁仪等为之羽翼，劝臻自结〖2〗；臻以大义拒之","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":492,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":22,"end":63,"offset_unit":"unicode_code_point"},{"id":"huanchen-q-cf25e3b0f5c3b9cb340a","section":"chapter-022","block":"b-6a49514fafa64d9c087a","layer":"original","quote":"时群臣并颂魏德，多抑损前朝；臻独明禅授之义，称扬汉美。帝数目臻曰〖1〗：“天下之珍，当与山阳共之〖2〗。”迁尚书，转侍中、吏部尚书","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":445,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":22,"end":87,"offset_unit":"unicode_code_point"},{"id":"huanchen-q-d7ec06ed742d60318e2a","section":"chapter-022","block":"b-62ccfab46bacc14e8c55","layer":"original","quote":"正始中，进爵长垣侯，邑千户；封一子列侯","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":492,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"huanchen-q-d86105732daa498225dc","section":"chapter-022","block":"b-62ccfab46bacc14e8c55","layer":"original","quote":"及文帝即位，东海王霖有宠〖3〗。帝问臻：“平原王何如〖4〗？”臻称明德美而终不言","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":492,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":64,"end":104,"offset_unit":"unicode_code_point"},{"id":"huanchen-q-dc8c83ecd62693cce7c5","section":"chapter-022","block":"b-3164b264690f834c075d","layer":"original","quote":"帝幸广陵，行中领军，从","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":446,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":11,"offset_unit":"unicode_code_point"},{"id":"huanchen-q-f17cfdc502a23703eef5","section":"chapter-022","block":"b-62ccfab46bacc14e8c55","layer":"original","quote":"固乞逊位。诏曰：“昔干木偃息〖7〗，义压强秦；留侯颐神〖8〗，不忘楚事。谠言嘉谋〖9〗，望不吝焉。”赐宅一区，位特进〖10〗，秩如三司。薨，追赠太尉〖11〗，谥曰敬侯","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":492,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":142,"end":225,"offset_unit":"unicode_code_point"},{"id":"mingdi-e-o053d-q","section":"chapter-003","block":"b-476a635cf6803693a619","layer":"original","quote":"五月，己巳〖13〗，行还洛阳宫。己丑〖14〗，大赦。六月，戊申〖15〗，京都地震。己亥〖16〗，以尚书令陈矫为司徒〖17〗，尚书左仆射卫臻为司空〖18〗。丁未〖19〗，分魏兴之魏阳，锡郡之安富、上庸，为上庸郡。省锡郡〖20〗。以锡县属魏兴郡。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":364,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":121,"offset_unit":"unicode_code_point"},{"id":"mingdi-e-o065a-q","section":"chapter-003","block":"b-7fe896f4b9a9286dc45d","layer":"original","quote":"壬午〖14〗，以司空卫臻为司徒，司隶校尉崔林为司空〖15〗。闰月〔癸丑〕〖16〗，月犯心中央大星。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":460,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":49,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-b-78ee587f18f11aa30bd9","section":"chapter-003","block":"b-78ee587f18f11aa30bd9","layer":"modern","quote":"〖1〗二年：景初二年（公元 238 ）。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":438,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-917b5dc4aecce5a0dcf4","start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-o052","section":"chapter-003","block":"b-26b7ecd6c3ecce777040","layer":"original","quote":"景初元年春（正）〔二〕月，壬辰〖1〗，山茌县言黄龙现〖2〗。﹝一﹞于是有司奏，以为魏得地统〖3〗，宜以建丑之月为正〖4〗。三月，定历改年为孟夏四月；﹝二﹞服色尚黄〖5〗；牺牲用白〖6〗；戎事乘黑首白马〖7〗，建大赤之旂〖8〗；朝会，建大白之旗。﹝三﹞改太和历曰景初历〖9〗：其春夏秋冬孟仲季月，虽与正岁不同〖10〗，至于郊祀、迎气、礿祠、蒸尝、巡狩、蒐田、分至启闭、班宣时令、中气早晚、敬授民事〖11〗，皆以正岁斗建为历数之序〖12〗。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":363,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":218,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-o053","section":"chapter-003","block":"b-476a635cf6803693a619","layer":"original","quote":"五月，己巳〖13〗，行还洛阳宫。己丑〖14〗，大赦。六月，戊申〖15〗，京都地震。己亥〖16〗，以尚书令陈矫为司徒〖17〗，尚书左仆射卫臻为司空〖18〗。丁未〖19〗，分魏兴之魏阳，锡郡之安富、上庸，为上庸郡。省锡郡〖20〗。以锡县属魏兴郡。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":364,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":121,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-o059","section":"chapter-003","block":"b-5790b2efe14805978c50","layer":"original","quote":"二年春正月〖1〗，诏太尉司马宣王。率众讨辽东。﹝一﹞","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":434,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":26,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-o065","section":"chapter-003","block":"b-7fe896f4b9a9286dc45d","layer":"original","quote":"壬午〖14〗，以司空卫臻为司徒，司隶校尉崔林为司空〖15〗。闰月〔癸丑〕〖16〗，月犯心中央大星。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":460,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":49,"offset_unit":"unicode_code_point"},{"id":"shaodi-e-o039c-q","section":"chapter-004","block":"b-e10813740402816008fd","layer":"original","quote":"九年春二月〖21〗，卫将军、中书令孙资；癸巳〖22〗，骠骑将军、中书监刘放；三月甲午〖23〗，司徒卫臻：各逊位，以侯就第〖24〗，位特进〖25〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":149,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":73,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-b-60775abea476f875fc24","section":"chapter-004","block":"b-60775abea476f875fc24","layer":"modern","quote":"〖21〗九年：正始九年（公元 248）。参照下文，在“二月”之后应当有记日的干支。此处史文疑有脱落。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":174,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8324fe8afd82c8552b28","start":0,"end":50,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o039","section":"chapter-004","block":"b-e10813740402816008fd","layer":"original","quote":"九年春二月〖21〗，卫将军、中书令孙资；癸巳〖22〗，骠骑将军、中书监刘放；三月甲午〖23〗，司徒卫臻：各逊位，以侯就第〖24〗，位特进〖25〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":149,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":73,"offset_unit":"unicode_code_point"},{"id":"wendi-e-p030a-q","section":"chapter-002","block":"b-5174c3cb0d47f5332e81","layer":"pei","quote":"于是侍中辛毗、刘晔，散骑常侍傅巽、卫臻，尚书令桓阶，尚书陈矫、陈群，给事中、博士、骑都尉苏林、董巴等奏曰：“伏见太史丞许芝上魏国受命之符；令书恳切，允执谦让，虽舜、禹、汤、文，义无以过。然古先哲王所以受天命而不辞者，诚急遵皇天之意，副兆民之望，弗得已也。且《易》曰：‘观乎天文以察时变，观乎人文以化成天下。’又曰：‘天垂象，见吉凶，圣人则之；河出《图》，洛出《书》，圣人效之。’以为天文因人而变；至于河洛之《书》，著于《洪范》，则殷、周效而用之矣。斯言，诚帝王之明符，天道之大要也。是以由德应录者，代兴于前；失道数尽者，迭废于后。《传》讥苌弘欲支天之所坏，而说蔡墨‘雷乘乾’之说；明神器之存亡，非人力所能建也。今汉室衰替，帝纲堕坠；天子之诏，歇灭无闻；皇天将舍旧而命新，百姓既去汉而为魏；昭然著明，是可知也。先王拨乱平世，将建洪基；至于殿下，以至德当历数之运。即位以来，天应人事，粲然大备；神灵图籍，兼仍往古；休征嘉兆，跨越前代。是芝所取《中黄》、《运期》姓（纬）〔讳〕之谶，斯文乃著于前世，与汉并见。由是言之，天命久矣，非殿下所得而拒之也。神明之意，候望禋享；兆民颙颙，咸注嘉愿。惟殿下览图籍之明文，急天下之公义；辄宣令外内，布告州郡，使知符命著明而殿下谦虚之意。”","attribution":"裴注·献帝传","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":142,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fc6f9c6942b5c231c294","start":0,"end":534,"offset_unit":"unicode_code_point"},{"id":"wendi-e-p039a-q","section":"chapter-002","block":"b-32d6a80e513bb1b8c254","layer":"pei","quote":"侍中刘廙、常侍卫臻等奏议曰：“汉氏遵唐尧公天下之议，陛下以圣德膺历数之运；天人同欢，靡不得所；宜顺灵符，速践皇阼。问太史丞许芝，今月十七日己未直成，可受禅命；辄治坛场之处，所当施行别奏。”","attribution":"裴注·献帝传","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":151,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fc6f9c6942b5c231c294","start":0,"end":94,"offset_unit":"unicode_code_point"},{"id":"wendi-q-b-ec88012a7f6c352d0e04","section":"chapter-002","block":"b-ec88012a7f6c352d0e04","layer":"modern","quote":"〖1〗二年：黄初二年（公元 221）。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":210,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8fff547b113ffa36bbc1","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wendi-q-o002","section":"chapter-002","block":"b-1c3ea4f0ea338bf2ec5a","layer":"original","quote":"太祖崩，嗣位为丞相，魏王。﹝三﹞尊王后曰王太后〖5〗。改建安二十五年为延康元年。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":2,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":40,"offset_unit":"unicode_code_point"},{"id":"wendi-q-o019","section":"chapter-002","block":"b-8820e5c7f9006d364c44","layer":"original","quote":"二年春正月〖1〗，郊祀天地、明堂〖2〗。甲戌〖3〗，校猎至原陵〖4〗。遣使者，以太牢祠汉世祖〖5〗。乙亥〖6〗，朝日于东郊〖7〗。﹝一﹞初令郡国口满十万者〖8〗，岁察孝廉一人；其有秀异〖9〗，无拘户口。辛巳〖10〗，分三公户邑，封子弟各一人为列侯。壬午〖11〗，复颍川郡一年田租〖12〗。﹝二﹞改许县为许昌县。以魏郡东部为阳平郡〖13〗，西部为广平郡〖14〗。﹝三﹞","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":208,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":183,"offset_unit":"unicode_code_point"},{"id":"wendi-q-p030","section":"chapter-002","block":"b-5174c3cb0d47f5332e81","layer":"pei","quote":"于是侍中辛毗、刘晔，散骑常侍傅巽、卫臻，尚书令桓阶，尚书陈矫、陈群，给事中、博士、骑都尉苏林、董巴等奏曰：“伏见太史丞许芝上魏国受命之符；令书恳切，允执谦让，虽舜、禹、汤、文，义无以过。然古先哲王所以受天命而不辞者，诚急遵皇天之意，副兆民之望，弗得已也。且《易》曰：‘观乎天文以察时变，观乎人文以化成天下。’又曰：‘天垂象，见吉凶，圣人则之；河出《图》，洛出《书》，圣人效之。’以为天文因人而变；至于河洛之《书》，著于《洪范》，则殷、周效而用之矣。斯言，诚帝王之明符，天道之大要也。是以由德应录者，代兴于前；失道数尽者，迭废于后。《传》讥苌弘欲支天之所坏，而说蔡墨‘雷乘乾’之说；明神器之存亡，非人力所能建也。今汉室衰替，帝纲堕坠；天子之诏，歇灭无闻；皇天将舍旧而命新，百姓既去汉而为魏；昭然著明，是可知也。先王拨乱平世，将建洪基；至于殿下，以至德当历数之运。即位以来，天应人事，粲然大备；神灵图籍，兼仍往古；休征嘉兆，跨越前代。是芝所取《中黄》、《运期》姓（纬）〔讳〕之谶，斯文乃著于前世，与汉并见。由是言之，天命久矣，非殿下所得而拒之也。神明之意，候望禋享；兆民颙颙，咸注嘉愿。惟殿下览图籍之明文，急天下之公义；辄宣令外内，布告州郡，使知符命著明而殿下谦虚之意。”","attribution":"裴注·献帝传","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":142,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fc6f9c6942b5c231c294","start":0,"end":534,"offset_unit":"unicode_code_point"},{"id":"wendi-q-p039","section":"chapter-002","block":"b-32d6a80e513bb1b8c254","layer":"pei","quote":"侍中刘廙、常侍卫臻等奏议曰：“汉氏遵唐尧公天下之议，陛下以圣德膺历数之运；天人同欢，靡不得所；宜顺灵符，速践皇阼。问太史丞许芝，今月十七日己未直成，可受禅命；辄治坛场之处，所当施行别奏。”","attribution":"裴注·献帝传","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":151,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fc6f9c6942b5c231c294","start":0,"end":94,"offset_unit":"unicode_code_point"},{"id":"wgc-q0109","section":"chapter-028","block":"b-a60df5631c12b6021cc3","layer":"pei","quote":"﹝二﹞《世语》曰：“是时，当世俊士散骑常侍夏侯玄、尚书诸葛诞、邓飏之徒，共相题表，以玄（畴）〔等〕四人为‘四聪’，诞（备）〔辈〕八人为‘八达’。中书监刘放子熙、孙资子密、吏部尚书卫臻子烈三人，咸不及比；以父居势位，容之为‘三豫’：凡十五人。帝以构长浮华，皆免官废锢。”","attribution":"世语","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":170,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-755a241ddb9f85f85b2a","start":0,"end":134,"offset_unit":"unicode_code_point"}],"profiles":{"wendi-p0079":{"fields":[],"directory":{"faction":"wei"}}},"directory_counts":{}}
