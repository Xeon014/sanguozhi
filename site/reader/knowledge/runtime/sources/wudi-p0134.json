{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o052a","title":"曹操东征袁术斩其留将","accounts":[{"id":"wudi-e-o052a-account","label":"正文","text":"袁术侵陈，闻曹操亲来而走，曹操击杀桥蕤、李丰、梁纲、乐就，袁术渡淮。","evidence":["wudi-e-o052a-q"]}],"participants":[{"person":"wudi-p0057","role":"侵陈退走","evidence":["wudi-e-o052a-q"]},{"person":"cao-cao","role":"东征","evidence":["wudi-e-o052a-q"]},{"person":"wudi-p0134","role":"被斩","evidence":["wudi-e-o052a-q"]},{"person":"wudi-p0135","role":"被斩","evidence":["wudi-e-o052a-q"]},{"person":"wudi-p0136","role":"被斩","evidence":["wudi-e-o052a-q"]},{"person":"wudi-p0137","role":"被斩","evidence":["wudi-e-o052a-q"]}],"place":{"text":"陈、淮","evidence":["wudi-e-o052a-q"]},"time":{"label":"建安二年秋九月","year":197,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o052a-q","wudi-q-o050","wudi-q-b-40d8b7057f4a29d6fe0d"],"chronology":"wudi-y197","dating_review":{"anchor":"wudi-q-o050","basis":"建安二年秋九月","reviewed":true}},"source_order":[1,301,"O052a"],"order":137},{"id":"dongyuan-e-o071c","title":"袁术以张勋桥蕤为大将","accounts":[{"id":"dongyuan-e-o071c-account","label":"《董二袁刘传第六》正文","text":"袁术任张勋、桥蕤等为大将。","evidence":["dongyuan-e-o071c-q"]}],"participants":[{"person":"wudi-p0057","role":"授官","evidence":["dongyuan-e-o071c-q"]},{"person":"sunshi-p0042","role":"受任","evidence":["dongyuan-e-o071c-q"]},{"person":"wudi-p0134","role":"受任","evidence":["dongyuan-e-o071c-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-o071c-q"]},"ordering_evidence":"dongyuan-e-o071c-q","source_order":[6,391,"O071c"],"order":1720},{"id":"cuimao-e-o059","title":"袁术与桥蕤俱攻围蕲阳，蕲阳为太祖固守","accounts":[{"id":"cuimao-a-bcfb0e5780f7afa7ce6d","label":"正文","text":"袁术与桥蕤俱攻围蕲阳，蕲阳为太祖固守","evidence":["cuimao-q-1fc58f8b6fd07cc28248"]}],"participants":[{"person":"wudi-p0057","role":"攻围蕲阳者","evidence":["cuimao-q-1fc58f8b6fd07cc28248"]},{"person":"wudi-p0134","role":"俱攻围蕲阳者","evidence":["cuimao-q-1fc58f8b6fd07cc28248"]},{"person":"cao-cao","role":"蕲阳为之固守者","evidence":["cuimao-q-1fc58f8b6fd07cc28248"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["cuimao-q-1fc58f8b6fd07cc28248"]},"ordering_evidence":"cuimao-q-1fc58f8b6fd07cc28248","source_order":[12,206,24],"order":2778},{"id":"zhangle-e-o015b","title":"乐进从击吕布张超桥蕤先登封侯","accounts":[{"id":"zhangle-e-o015b-account","label":"《张乐于张徐传第十七》正文","text":"乐进从击吕布张超桥蕤先登封侯","evidence":["zhangle-e-o015b-q"]}],"participants":[{"person":"wudi-p0236","role":"从征","evidence":["zhangle-e-o015b-q"]},{"person":"wudi-p0088","role":"被攻","evidence":["zhangle-e-o015b-q"]},{"person":"zhangle-p0013","role":"被攻","evidence":["zhangle-e-o015b-q"]},{"person":"wudi-p0134","role":"被攻","evidence":["zhangle-e-o015b-q"]}],"place":null,"time":{"label":"乐进从曹操征伐时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["zhangle-e-o015b-q"]},"ordering_evidence":"zhangle-e-o015b-q","source_order":[17,57,"O015b"],"order":3505},{"id":"zhangle-e-o020e","title":"于禁从围桥蕤至宛降张绣","accounts":[{"id":"zhangle-e-o020e-account","label":"《张乐于张徐传第十七》正文","text":"于禁从围桥蕤至宛降张绣","evidence":["zhangle-e-o020e-q"]}],"participants":[{"person":"wudi-p0162","role":"从征","evidence":["zhangle-e-o020e-q"]},{"person":"wudi-p0134","role":"被斩","evidence":["zhangle-e-o020e-q"]},{"person":"wudi-p0131","role":"降","evidence":["zhangle-e-o020e-q"]}],"place":null,"time":{"label":"曹操领兖州以后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["zhangle-e-o020e-q"]},"ordering_evidence":"zhangle-e-o020e-q","source_order":[17,73,"O020e"],"order":3523},{"id":"sunshi-e-o025b","title":"马日！礼辟孙策表怀义校尉乔蕤张勋敬重","accounts":[{"id":"sunshi-e-o025b-account","label":"《孙破虏讨逆传第一》正文","text":"马日！礼辟孙策表怀义校尉乔蕤张勋敬重","evidence":["sunshi-e-o025b-q"]}],"participants":[{"person":"sunshi-p0041","role":"礼辟表官","evidence":["sunshi-e-o025b-q"]},{"person":"wudi-p0099","role":"受辟受官","evidence":["sunshi-e-o025b-q"]},{"person":"wudi-p0134","role":"敬重","evidence":["sunshi-e-o025b-q"]},{"person":"sunshi-p0042","role":"敬重","evidence":["sunshi-e-o025b-q"]}],"place":null,"time":{"year":194,"label":"兴平元年","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"sunshi-y194","dating_review":{"reviewed":true,"anchor":"sunshi-q-o025","basis":"兴平元年"},"evidence":["sunshi-e-o025b-q","sunshi-q-o025","xunyu-q-o007","xianzhu-q-o009","wudi-q-o028","wudi-q-b-927979d68d5dacfd36fe"]},"ordering_evidence":"sunshi-e-o025b-q","source_order":[46,178,"O025b"],"order":8070}],"persons":[{"id":"wudi-p0134","name":"桥蕤","evidence":["wudi-q-o052","zhangle-q-o015","sunshi-q-o025","dongyuan-q-o071","cuimao-q-1fc58f8b6fd07cc28248"],"facts":[{"id":"sunshi-f0020","label":"本篇写法","text":"乔蕤","evidence":["sunshi-f0020-q"]}],"aliases":[{"text":"乔蕤","evidence":["sunshi-f0020-q"]}],"mentions":[{"id":"wudi-m-o052-wudi-p0134","kind":"mention","text":"文中提及","evidence":["wudi-q-o052"]},{"id":"wudi-m-o143-wudi-p0134","kind":"mention","text":"文中提及","evidence":["wudi-q-o143"]},{"id":"zhangle-m-o015-wudi-p0134","kind":"mention","text":"文中提及","evidence":["zhangle-q-o015"]},{"id":"zhangle-m-o020-wudi-p0134","kind":"mention","text":"文中提及","evidence":["zhangle-q-o020"]},{"id":"sunshi-m-o025-wudi-p0134","kind":"mention","text":"文中提及","evidence":["sunshi-q-o025"]},{"id":"dongyuan-m-o071-wudi-p0134","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o071"]}]}],"evidence":[{"id":"cuimao-q-1fc58f8b6fd07cc28248","section":"chapter-012","block":"b-06f1f28083cdd4e2dd27","layer":"original","quote":"术与桥蕤俱攻围蕲阳，蕲阳为太祖固守","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":205,"anchor":null},"note_id":null,"start":24,"end":41},{"id":"dongyuan-e-o071c-q","section":"chapter-006","block":"b-e7fa65d5e1ea25c916b0","layer":"original","quote":"以张勋、桥蕤等为大将（军）。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":390,"anchor":null},"note_id":null,"start":41,"end":55},{"id":"dongyuan-q-o071","section":"chapter-006","block":"b-e7fa65d5e1ea25c916b0","layer":"original","quote":"引军入陈留，太祖与绍合击，大破术军；术以余众奔九江，杀扬州刺史陈温，领其州，﹝二﹞以张勋、桥蕤等为大将（军）。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":390,"anchor":null},"note_id":null,"start":0,"end":55},{"id":"sunshi-e-o025b-q","section":"chapter-046","block":"b-0ad407171fe244241c8d","layer":"original","quote":"太傅马日！仗节安集关东〖10〗；在寿春以礼辟策〖11〗，表拜怀义校尉〖12〗。术大将乔蕤、张勋，皆倾心敬焉。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":177,"anchor":null},"note_id":null,"start":24,"end":78},{"id":"sunshi-f0020-q","section":"chapter-046","block":"b-0ad407171fe244241c8d","layer":"original","quote":"术大将乔蕤、张勋","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":177,"anchor":null},"note_id":null,"start":63,"end":71},{"id":"sunshi-q-o025","section":"chapter-046","block":"b-0ad407171fe244241c8d","layer":"original","quote":"兴平元年，从袁术。术甚奇之，以坚部曲还策。﹝三﹞太傅马日！仗节安集关东〖10〗；在寿春以礼辟策〖11〗，表拜怀义校尉〖12〗。术大将乔蕤、张勋，皆倾心敬焉。术常叹曰：“使术有子如孙郎，死复何恨！”策骑士有罪，逃入术营，隐于内厩；策指使人就斩之〖13〗，讫，诣术谢〖14〗。术曰：“兵人好叛，当共疾之！何为谢也？”由是军中益畏惮之。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":177,"anchor":null},"note_id":null,"start":0,"end":165},{"id":"wudi-e-o052a-q","section":"chapter-001","block":"b-8ec86cba86065a1316d1","layer":"original","quote":"秋九月，术侵陈，公东征之。术闻公自来，弃军走，留其将桥蕤、李丰、梁纲、乐就。公到，击破蕤等，皆斩之。术走，渡淮〖12〗。公还许。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":300,"anchor":null},"note_id":null,"start":0,"end":64},{"id":"wudi-q-b-40d8b7057f4a29d6fe0d","section":"chapter-001","block":"b-40d8b7057f4a29d6fe0d","layer":"modern","quote":"〖3〗二年：建安二年（公元 197）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":305,"anchor":null},"note_id":"n-de6807349faf5c41a470","start":0,"end":19},{"id":"wudi-q-b-927979d68d5dacfd36fe","section":"chapter-001","block":"b-927979d68d5dacfd36fe","layer":"modern","quote":"〖1〗二年：兴平二年（公元 195）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":246,"anchor":null},"note_id":"n-8c38464987eb86819ded","start":0,"end":19},{"id":"wudi-q-o028","section":"chapter-001","block":"b-fefe0240b8480efce927","layer":"original","quote":"兴平元年春，太祖自徐州还〖1〗。初，太祖父嵩，去官后还谯。董卓之乱，避难琅邪〖2〗。为陶谦所害，故太祖志在复仇东伐。﹝一﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":204,"anchor":null},"note_id":null,"start":0,"end":61},{"id":"wudi-q-o050","section":"chapter-001","block":"b-c2d0fc350fb933237a70","layer":"original","quote":"二年春正月〖3〗，公到宛〖4〗。张绣降，既而悔之，复反。公与战，军败，为流矢所中。长子昂、弟子安民遇害〖5〗。﹝一﹞公乃引兵还舞阴〖6〗，绣将骑来抄〖7〗。公击破之，绣奔穰〖8〗，与刘表合。公谓诸将曰：“吾降张绣等，失不便取其质〖9〗，以至于此。吾知所以败。诸卿观之：自今以后，不复败矣！”遂还许。﹝二﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":298,"anchor":null},"note_id":null,"start":0,"end":152},{"id":"wudi-q-o052","section":"chapter-001","block":"b-8ec86cba86065a1316d1","layer":"original","quote":"秋九月，术侵陈，公东征之。术闻公自来，弃军走，留其将桥蕤、李丰、梁纲、乐就。公到，击破蕤等，皆斩之。术走，渡淮〖12〗。公还许。公之自舞阴还也，南阳章陵诸县复叛为绣〖13〗。公遣曹洪击之，不利。还屯叶〖14〗，数为绣、表所侵〖15〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":300,"anchor":null},"note_id":null,"start":0,"end":117},{"id":"wudi-q-o143","section":"chapter-001","block":"b-87c7d8a437d7c846207e","layer":"original","quote":"昔者董卓初兴国难，群后释位以谋王室〖31〗；﹝四﹞君则摄进〖32〗，首启戎行〖33〗。此君之忠于本朝也。后及黄巾反易天常〖34〗，侵我三州〖35〗，延及平民；君又翦之以宁东夏〖36〗。此又君之功也。韩暹、杨奉专用威命；君则致讨，克黜其难，遂迁许都，造我京畿，设官兆祀〖37〗，不失旧物〖38〗，天地鬼神于是获乂〖39〗。此又君之功也。袁术僭逆〖40〗，肆于淮南；慑惮君灵，用丕显谋〖41〗，蕲阳之役〖42〗，桥蕤授首〖43〗，稜威南迈，术以陨溃。此又君之功也。回戈东征，吕布就戮；乘辕将返，张杨殂毙，眭固伏罪，张绣稽服〖44〗。此又君之功也。袁绍逆乱天常，谋危社稷，凭恃其众，称兵内侮〖45〗。当此之时，王师寡弱，天下寒心，莫有固志；君执大节〖46〗，精贯白日，奋其武怒，运其神策，致届官渡〖47〗，大歼丑类，﹝五﹞俾我国家拯于危坠。此又君之功也。济师洪河〖48〗，拓定四州〖49〗，袁谭、高幹，咸枭其首，海盗奔进，黑山顺轨〖50〗。此又君之功也。乌丸三种〖51〗，崇乱二世〖52〗，袁尚因之，逼据塞北；束马悬车〖53〗，一征而灭。此又君之功也。刘表背诞，不供贡职〖54〗；王师首路〖55〗，威风先逝，百城八郡〖56〗，交臂屈膝。此又君之功也。马超、成宜，同恶相济，滨据河、潼，求逞所欲；殄之渭南，献馘万计〖57〗，遂定边境，抚和戎狄。此又君之功也。鲜卑、丁零〖58〗，重译而至〖59〗；（单）〔箄〕于、白屋〖60〗，请吏率职〖61〗。此又君之功也。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":111,"anchor":null},"note_id":null,"start":0,"end":625},{"id":"xianzhu-q-o009","section":"chapter-032","block":"b-939a0c2b5149377c476b","layer":"original","quote":"谦表先主为豫州刺史，屯小沛〖2〗。谦病笃，谓别驾麋竺曰〖3〗：“非刘备，不能安此州也！”谦死，竺率州人迎先主。先主未敢当，下邳陈登谓先主曰：“今汉室陵迟，海内倾覆；立功立事，在于今日！（彼）〔鄙〕州殷富〖4〗，户口百万；欲屈使君，抚临州事。”先主曰：“袁公路近在寿春〖5〗；此君四世五公〖6〗，海内所归；君可以州与之。”登曰：“公路骄豪，非治乱之主！今欲为使君合步骑十万：上可以匡主济民，成五霸之业〖7〗；下可以割地守境，书功于竹帛。若使君不见听许，登亦未敢听使君也！”北海相孔融谓先主曰：“袁公路岂忧国忘家者邪？冢中枯骨〖8〗，何足介意！今日之事，百姓与能〖9〗；天与不取，悔不可追！”先主遂领徐州。﹝一﹞","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":39,"anchor":null},"note_id":null,"start":0,"end":304},{"id":"xunyu-q-o007","section":"chapter-010","block":"b-0a1838dcb6c559056287","layer":"original","quote":"兴平元年，太祖征陶谦，任彧留事〖4〗。会张邈、陈宫以兖州反，潜迎吕布。布既至，邈乃使刘翊告彧曰：“吕将军来助曹使君击陶谦〖5〗。宜亟供其军食！”众疑惑。彧知邈为乱，即勒兵设备〖6〗；驰召东郡太守夏侯惇。而兖州诸城皆应布矣。时太祖悉军攻谦，留守兵少；而督将、大吏多与邈、宫通谋〖7〗。惇至，其夜诛谋叛者数十人，众乃定。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":24,"anchor":null},"note_id":null,"start":0,"end":158},{"id":"zhangle-e-o015b-q","section":"chapter-017","block":"b-ed66dc626c10ce5c9c00","layer":"original","quote":"从击吕布于濮阳，张超于雍丘，桥蕤于苦；皆先登有功，封广昌亭侯。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":56,"anchor":null},"note_id":null,"start":60,"end":91},{"id":"zhangle-e-o020e-q","section":"chapter-017","block":"b-268a3271c0ec48659996","layer":"original","quote":"从围桥蕤于苦，斩蕤等四将。从至宛，降张绣。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":72,"anchor":null},"note_id":null,"start":178,"end":199},{"id":"zhangle-q-o015","section":"chapter-017","block":"b-ed66dc626c10ce5c9c00","layer":"original","quote":"乐进字文谦，阳平卫国人也〖1〗。容貌短小，以胆烈从太祖，为帐下吏。遣还本郡募兵，得千余人；还为军假司马、陷阵都尉〖2〗。从击吕布于濮阳，张超于雍丘，桥蕤于苦；皆先登有功，封广昌亭侯。从征张绣于安众；围吕布于下邳，破别将。击眭固于射犬，攻刘备于沛；皆破之，拜讨寇校尉〖3〗。渡河攻获嘉〖4〗。还，从击袁绍于官渡；力战，斩绍将淳于琼。从击谭、尚于黎阳，斩其大将严敬，行游击将军〖5〗。别击黄巾，破之，定乐安郡。从围邺。邺定，从击袁谭于南皮；先登，入谭东门。谭败，别攻雍奴，破之。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":56,"anchor":null},"note_id":null,"start":0,"end":237},{"id":"zhangle-q-o020","section":"chapter-017","block":"b-268a3271c0ec48659996","layer":"original","quote":"及太祖领兖州，禁与其党俱诣，为都伯〖2〗，属将军王朗。朗异之，荐禁才任大将（军）。太祖召见，与语，拜军司马；使将兵诣徐州，攻广戚；拔之，拜陷阵都尉。从讨吕布于濮阳，别破布二营于城南；又别将破高雅于须昌。从攻寿张、定陶、离狐〖3〗，围张超于雍丘，皆拔之。从征黄巾刘辟、黄邵等，屯版梁；邵等夜袭太祖营，禁帅麾下击破之，斩（辟）邵等，尽降其众。迁平虏校尉〖4〗。从围桥蕤于苦，斩蕤等四将。从至宛，降张绣。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":72,"anchor":null},"note_id":null,"start":0,"end":199}],"profiles":{},"directory_counts":{}}
