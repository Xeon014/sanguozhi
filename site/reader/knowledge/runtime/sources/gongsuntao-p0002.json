ence":["wuhuan-q-6951d78a9766104f00c7"]},{"person":"wuhuan-p-37ee27cc27c055","role":"自称汗鲁王者","evidence":["wuhuan-q-6951d78a9766104f00c7"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["wuhuan-q-6951d78a9766104f00c7"]},"ordering_evidence":"wuhuan-q-6951d78a9766104f00c7","order":6122},{"id":"wuhuan-e-c99e0ec57c87be1441ad","title":"丘力居死，其子楼班年小","accounts":[{"id":"wuhuan-a-c99e0ec57c87be1441ad","label":"正文","text":"丘力居死，其子楼班年小","evidence":["wuhuan-q-f7091709bcc2f11ae088"]}],"participants":[{"person":"gongsuntao-p0002","role":"死亡的辽西乌丸大人","evidence":["wuhuan-q-f7091709bcc2f11ae088"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["wuhuan-q-f7091709bcc2f11ae088"]},"ordering_evidence":"wuhuan-q-f7091709bcc2f11ae088","order":6127}],"persons":[{"id":"gongsuntao-p0002","name":"丘力居","evidence":["gongsuntao-q-b93bcb0cd63af339523f","gongsuntao-q-ad541a255acd5c451967","gongsuntao-q-5e44069ecb911ed27cee","gongsuntao-q-d825d30b6eba3626f0ad","wuhuan-q-f7091709bcc2f11ae088","wuhuan-q-6951d78a9766104f00c7","wuhuan-q-439475830a72fa3d383f"],"facts":[{"id":"wuhuan-f-14220fccef953594e4c5","text":"辽西乌丸大人，众五千余落。","evidence":["wuhuan-q-439475830a72fa3d383f"]}],"aliases":[],"mentions":[{"id":"gongsuntao-m-review-6f403498bf43f9847e54","kind":"mention","text":"丘力居见于相关言论或记载。","evidence":["gongsuntao-q-ad541a255acd5c451967","gongsuntao-q-d825d30b6eba3626f0ad"]}]}],"evidence":[{"id":"gongsuntao-q-5e44069ecb911ed27cee","section":"chapter-008","block":"b-c097aa766dca364074ad","layer":"original","quote":"虞到，遣使至胡中，告以利害，责使送纯首。丘力居等闻虞至，喜，各遣译自归","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":34,"anchor":null},"note_id":null,"start":86,"end":121},{"id":"gongsuntao-q-ad541a255acd5c451967","section":"chapter-008","block":"b-c097aa766dca364074ad","layer":"original","quote":"丘力居等抄略青、徐、幽、冀，四州被其害，瓒不能御。朝议以‘宗正东海刘伯安既有德义〖1〗；昔为幽州刺史，恩信流著，戎狄附之；若使镇抚，可不劳众而定’。乃以刘虞为幽州牧","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":34,"anchor":null},"note_id":null,"start":0,"end":82},{"id":"gongsuntao-q-b93bcb0cd63af339523f","section":"chapter-008","block":"b-8d4c872900407e75fd4d","layer":"original","quote":"（光和）〔中平〕中〖17〗，凉州贼起〖18〗。发幽州突骑三千人〖19〗，假瓒都督行事传〖20〗，使将之。军到蓟中〖21〗，渔阳张纯，诱辽西乌丸丘力居等叛〖22〗，劫略蓟中；自号将军，﹝三﹞略吏民，攻右北平、辽西、属国诸城〖23〗，所至残破","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":4,"anchor":null},"note_id":null,"start":0,"end":119},{"id":"gongsuntao-q-d825d30b6eba3626f0ad","section":"chapter-008","block":"b-6e59df743dd665bf78c1","layer":"original","quote":"瓒害虞有功〖3〗，乃阴使人邀杀胡使〖4〗。胡知其情，间行诣虞","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":35,"anchor":null},"note_id":null,"start":0,"end":30},{"id":"wuhuan-q-439475830a72fa3d383f","section":"chapter-030","block":"b-f55d6a89d37cd69fcb45","layer":"original","quote":"汉末，辽西乌丸大人丘力居，众五千余落；上谷乌丸大人难楼〖1〗，众九千余落：各称王。而辽东属国乌丸大人苏仆延，众千余落，自称峭王；右北平乌丸大人乌延，众八百余落，自称汗鲁王：皆有计策，勇健。中山太守张纯，叛入丘力居众中，自号“弥天安安王”，为三郡乌丸元帅；寇略青、徐、幽、冀四州，杀略吏民。","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":42,"anchor":null},"note_id":null,"start":0,"end":144},{"id":"wuhuan-q-6951d78a9766104f00c7","section":"chapter-030","block":"b-f55d6a89d37cd69fcb45","layer":"original","quote":"汉末，辽西乌丸大人丘力居，众五千余落；上谷乌丸大人难楼〖1〗，众九千余落：各称王。而辽东属国乌丸大人苏仆延，众千余落，自称峭王；右北平乌丸大人乌延，众八百余落，自称汗鲁王：皆有计策，勇健。","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":42,"anchor":null},"note_id":null,"start":0,"end":94},{"id":"wuhuan-q-f7091709bcc2f11ae088","section":"chapter-030","block":"b-228521c23fcc33c40b25","layer":"original","quote":"后丘力居死，子楼班年小","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":43,"anchor":null},"note_id":null,"start":26,"end":37}],"profiles":{},"directory_counts":{}}
