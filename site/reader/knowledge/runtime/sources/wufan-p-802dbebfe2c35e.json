{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[],"persons":[{"id":"wufan-p-802dbebfe2c35e","name":"陈梁甫","evidence":["wufan-q-9d84e2fa5c1fd16afff6","wufan-q-59a554eda84c1d85303b"],"facts":[{"id":"wufan-f-436a8fd2ca4ca195f500","text":"善书","evidence":["wufan-q-9d84e2fa5c1fd16afff6"]}],"mentions":[{"id":"wufan-m-a0e34d8da8461fb46a7b","kind":"mention","text":"本篇记载：《吴录》称其能书，甫恨逋","evidence":["wufan-q-59a554eda84c1d85303b"]}],"aliases":[]}],"evidence":[{"id":"wufan-q-59a554eda84c1d85303b","section":"chapter-063","block":"b-914eb0282e241c66943d","layer":"pei","quote":"陈梁甫能书。甫恨逋","attribution":"裴注所引记载（引书见原文）","section_title":"吴范刘惇赵达传第十八","source":{"file":"OEBPS/Text/titlepage_0133.xhtml","index":109,"anchor":null},"note_id":"n-a0bd07c10a0db1fefc47","start":32,"end":41},{"id":"wufan-q-9d84e2fa5c1fd16afff6","section":"chapter-063","block":"b-914eb0282e241c66943d","layer":"pei","quote":"﹝二﹞《吴录》曰：“皇象字休明，广陵江都人。幼工书。时有张子并、陈梁甫能书。甫恨逋，并恨峻；象斟酌其间，甚得其妙，中国善书者不能及也。严武字子卿。卫尉畯再从子也。围棋莫与为辈。宋寿占梦，十不失一。曹不兴善画。权使画屏风，误落笔点素，因就以作蝇；既进御，权以为生蝇，举手弹之。孤城郑妪，能相人。及范、惇、达，八人，世皆称妙，谓之‘八绝’云。”","attribution":"《吴录》","section_title":"吴范刘惇赵达传第十八","source":{"file":"OEBPS/Text/titlepage_0133.xhtml","index":109,"anchor":null},"note_id":"n-a0bd07c10a0db1fefc47","start":0,"end":170}],"profiles":{},"directory_counts":{}}
