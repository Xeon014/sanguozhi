r":4777}],"persons":[{"id":"hechang-p-0c47eb88a089d6","name":"繁钦","evidence":["hechang-q-372e1461831f38a8e0b6","hechang-q-7cfc96ef72e9ccdf5dc5","wangwei-q-7a5b142c997bae125d5f","wangwei-q-8c783817d15313a8e4a6","wangwei-q-86db11ea8782864f96bd"],"facts":[{"id":"wangwei-f-d7ba2b66643ccfe4b97a","text":"字休伯，为丞相主簿。","evidence":["wangwei-q-86db11ea8782864f96bd"]}],"mentions":[{"id":"wangwei-m-1b044f3fe263af8f5648","kind":"mention","text":"鱼豢引韦仲将言论诸文士用世与文章","evidence":["wangwei-q-8c783817d15313a8e4a6"]}],"aliases":[]}],"evidence":[{"id":"hechang-q-372e1461831f38a8e0b6","section":"chapter-023","block":"b-db2bf67949cb8c374cea","layer":"original","quote":"赵俨字伯然，颍川阳翟人也〖1〗。避乱荆州，与杜袭、繁钦通财同计，合为一家。太祖始迎献帝都许，俨谓钦曰：“曹镇东应期命世〖2〗，必能匡济华夏；吾知归矣！”","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":247,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":76,"offset_unit":"unicode_code_point"},{"id":"hechang-q-7cfc96ef72e9ccdf5dc5","section":"chapter-023","block":"b-02da3dc5a9fcffd414b2","layer":"original","quote":"袭避乱荆州，刘表待以宾礼。同郡繁钦数现奇于表〖3〗，袭喻之曰：“吾所以与子俱来者，徒欲龙蟠幽薮〖4〗，待时凤翔；岂谓刘牧当为拨乱之主〖5〗，而规长者委身哉〖6〗！子若现能不已，非吾徒也；吾其与子绝矣！”钦慨然曰：“请敬受命。”袭遂南适长沙。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":189,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":36,"end":156,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-7a5b142c997bae125d5f","section":"chapter-021","block":"b-0b000d16ecfb3c0d8ecb","layer":"pei","quote":"建安二十三年卒","attribution":"裴注·典略","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":128,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-455f178ad5b438a4713a","start":70,"end":77,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-86db11ea8782864f96bd","section":"chapter-021","block":"b-0b000d16ecfb3c0d8ecb","layer":"pei","quote":"﹝五﹞繁，音婆。《典略》曰：“钦字休伯。以文才机辩，少得名于汝、颍。钦既长于书记，又善为诗赋。其所与太子书，记喉转意，率皆巧丽。为丞相主簿。建安二十三年卒。”","attribution":"裴注引《典略》","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":128,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-455f178ad5b438a4713a","start":0,"end":79,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-8c783817d15313a8e4a6","section":"chapter-021","block":"b-ae9b0ea06dd163d3a430","layer":"pei","quote":"鱼豢曰：“寻省往者，鲁连、邹阳之徒，援譬引类，以解缔结，诚彼时文辩之俊也。今览王、繁、阮、陈、路诸人前后文旨，亦何昔不若哉？其所以不论者，时世异耳。余又窃怪其不甚见用，以问大鸿胪卿韦仲将。仲将云：‘仲宣伤于肥戆，休伯都无格检，元瑜病于体弱，孔璋实自粗疏，文蔚性颇忿鸷。’如是，彼为非徒以脂烛自煎糜也；其不高蹈，盖有由矣。然君子不责备于一人，譬之朱漆，虽无桢干，其为光泽亦壮观也。”","attribution":"裴注·鱼豢论","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":130,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cdb5776a7cfbd5fbdd22","start":0,"end":190,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
