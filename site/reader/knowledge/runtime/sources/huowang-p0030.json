b53ed7a6593","start":11,"end":20},{"id":"dongliu-q-e3070df472d0b9c41900","section":"chapter-039","block":"b-8e9e3c4c6d67f5fa476c","layer":"original","quote":"先主定蜀，征和为掌军中郎将","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":3,"anchor":null},"note_id":null,"start":0,"end":13},{"id":"dongliu-q-eb0b210fd16e9b4d714b","section":"chapter-039","block":"b-4f59a98859b4f475164b","layer":"pei","quote":"亮纳其策，赦孟获以服南方","attribution":"裴注·襄阳记","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":110,"anchor":null},"note_id":"n-b2f83c142b53ed7a6593","start":163,"end":175},{"id":"guanzhang-e-o008a-q","section":"chapter-036","block":"b-b96955cde6bd0ef2541b","layer":"original","quote":"二十四年〖1〗，先主为汉中王；拜羽为前将军，假节、钺。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":35,"anchor":null},"note_id":null,"start":0,"end":27},{"id":"guanzhang-q-b-edafc9276d2732d2c2af","section":"chapter-036","block":"b-edafc9276d2732d2c2af","layer":"modern","quote":"〖1〗二十四年：建安二十四年（公元 219）。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":42,"anchor":null},"note_id":"n-16dc4b02f597093385c1","start":0,"end":23},{"id":"guanzhang-q-o008","section":"chapter-036","block":"b-b96955cde6bd0ef2541b","layer":"original","quote":"二十四年〖1〗，先主为汉中王；拜羽为前将军，假节、钺。是岁，羽率众攻曹仁于樊。曹公遣于禁助仁。秋，大霖雨，汉水泛溢，禁所督七军皆没；禁降羽，羽又斩将军庞德〖2〗；梁、郏、陆浑群盗或遥受羽印号〖3〗，为之支党。羽威震华夏〖4〗，曹公议徙许都，以避其锐。司马宣王、蒋济以为：“关羽得志，孙权必不愿也。可遣人劝权蹑其后〖5〗，许割江南以封权，则樊围自解。”曹公从之。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":35,"anchor":null},"note_id":null,"start":0,"end":180},{"id":"houzhu-q-O011","section":"chapter-033","block":"b-354a0a35bf9887aa11d1","layer":"original","quote":"三年春三月，丞相亮南征四郡〖2〗，四郡皆平。改益州郡为建宁郡；分建宁、永昌郡为云南郡〖3〗；又分建宁、牂牁为兴古郡〖4〗。","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":35,"anchor":null},"note_id":null,"start":0,"end":61},{"id":"houzhu-q-O012","section":"chapter-033","block":"b-3529bcb2e8097984bcb5","layer":"original","quote":"十二月，亮还成都。","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":36,"anchor":null},"note_id":null,"start":0,"end":9},{"id":"huangli-q-4639de401721810ce6f4","section":"chapter-043","block":"b-e11f9e586959d73e2f0d","layer":"original","quote":"于是恢出击，大破之；追奔逐北，南至盘江〖19〗，东接牂牁，与亮声势相连","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":59,"anchor":null},"note_id":null,"start":170,"end":205},{"id":"huangli-q-6468462c5c9ba31b69b4","section":"chapter-043","block":"b-e11f9e586959d73e2f0d","layer":"original","quote":"丞相亮南征，先由越嶲","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":59,"anchor":null},"note_id":null,"start":32,"end":42},{"id":"huangli-q-719f26aa2be89e5fdfc4","section":"chapter-043","block":"b-1f594d574238f76d3965","layer":"original","quote":"及丞相亮南征讨阉，既发在道","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":93,"anchor":null},"note_id":null,"start":18,"end":31},{"id":"huangli-q-8607804c6bf08d8f9001","section":"chapter-043","block":"b-1f594d574238f76d3965","layer":"original","quote":"而闿已为高定部曲所杀","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":93,"anchor":null},"note_id":null,"start":32,"end":42},{"id":"huangli-q-b5114bce442112fd9e76","section":"chapter-043","block":"b-e11f9e586959d73e2f0d","layer":"original","quote":"时恢众少敌倍，又未得亮声息，绐谓南人曰〖15〗：“官军粮尽，欲规退还〖16〗；吾中间久斥乡里〖17〗，乃今得旋〖18〗，不能复北；欲还与汝等同计谋，故以诚相告。”南人信之，故围守怠缓","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":59,"anchor":null},"note_id":null,"start":78,"end":169},{"id":"huangli-q-b685b1081f6c75c813e8","section":"chapter-043","block":"b-962c82ad79e50c7a0854","layer":"original","quote":"成都既定，先主领益州牧，以恢为功曹书佐、主簿","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":57,"anchor":null},"note_id":null,"start":0,"end":22},{"id":"huangli-q-e3ccf28eaf60b6787884","section":"chapter-043","block":"b-e11f9e586959d73e2f0d","layer":"original","quote":"而恢案道向建宁〖13〗，诸县大相纠合，围恢军于昆（明）〔泽〕","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":59,"anchor":null},"note_id":null,"start":43,"end":73},{"id":"huowang-q-1e29e19a7340b10ed473","section":"chapter-041","block":"b-b9d5c2fd4c47c184f0be","layer":"original","quote":"亮谓琬、诗曰：“还都当有书与子度相闻〖25〗。”诗进曰：“孟达小子，昔事振威不忠〖26〗，后又背叛先主；反覆之人，何足与书邪！”亮默然不答","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":173,"anchor":null},"note_id":null,"start":0,"end":69},{"id":"huowang-q-225ed2d7e9d667049592","section":"chapter-041","block":"b-20cf9e4bd23391868d15","layer":"original","quote":"成都既定，先主领益州牧，以诗为督军从事","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":169,"anchor":null},"note_id":null,"start":34,"end":53},{"id":"huowang-q-3d839b07145d47a93b8a","section":"chapter-041","block":"b-a2d44a8ea9a1d8953eaa","layer":"original","quote":"羽闻黄忠为后将军，（羽）怒曰：“大丈夫终不与老兵同列！〖2〗”不肯受拜","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":170,"anchor":null},"note_id":null,"start":17,"end":52},{"id":"huowang-q-44875a307c92acac4812","section":"chapter-041","block":"b-20cf9e4bd23391868d15","layer":"original","quote":"刘璋时为绵竹令","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":169,"anchor":null},"note_id":null,"start":13,"end":20},{"id":"huowang-q-598e4283645222f44715","section":"chapter-041","block":"b-e668531e9260aca6910b","layer":"original","quote":"蒋琬秉政，以诗为谏议大夫","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":176,"anchor":null},"note_id":null,"start":0,"end":12},{"id":"huowang-q-8c868a7016c10c996983","section":"chapter-041","block":"b-d71e29fc595b6b00032c","layer":"original","quote":"后群臣议欲推汉中王称尊号，诗上疏曰","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":171,"anchor":null},"note_id":null,"start":0,"end":17},{"id":"huowang-q-8f424ee850969da203c7","section":"chapter-041","block":"b-5008b9b7cd23cd6b1641","layer":"original","quote":"丞相亮南征，朗留统后事","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":38,"anchor":null},"note_id":null,"start":20,"end":31},{"id":"huowang-q-9418f38e1a330c9a23fd","section":"chapter-041","block":"b-0331bba35be1e9a1beba","layer":"original","quote":"建兴三年，随诸葛亮南行，归至汉阳县","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":172,"anchor":null},"note_id":null,"start":0,"end":17},{"id":"huowang-q-a4732998d8c4beb176b5","section":"chapter-041","block":"b-e668531e9260aca6910b","layer":"original","quote":"卒于家","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":176,"anchor":null},"note_id":null,"start":13,"end":16},{"id":"huowang-q-aa9daafd244650a509ad","section":"chapter-041","block":"b-20cf9e4bd23391868d15","layer":"original","quote":"先主攻绵竹时，诗先举城降","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":169,"anchor":null},"note_id":null,"start":21,"end":33},{"id":"huowang-q-ae94efcb1d0091064fb5","section":"chapter-041","block":"b-a2d44a8ea9a1d8953eaa","layer":"original","quote":"诗谓羽曰：“夫立王业者，所用非一。昔萧、曹与高祖少小亲旧〖3〗，而陈、韩亡命后至〖4〗；论其班列，韩最居上，未闻萧、曹以此为怨。今汉〔中〕王以一时之功〖5〗，隆崇于汉（室）〔升〕；然意之轻重〖6〗，宁当与君侯齐乎〖7〗？且王与君侯，譬犹一体；同休等戚，祸福共之。愚为君侯〖8〗，不宜计官号之高下，爵禄之多少为意也。仆一介之使〖9〗，衔命之人；君侯不受拜，如是便还；但相为惜此举动，恐有后悔耳！”羽大感悟，遽即受拜","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":170,"anchor":null},"note_id":null,"start":53,"end":259},{"id":"huowang-q-c7f9408621d68792ed41","section":"chapter-041","block":"b-a2d44a8ea9a1d8953eaa","layer":"original","quote":"先主为汉中王，遣诗拜关羽为前将军","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":170,"anchor":null},"note_id":null,"start":0,"end":16},{"id":"huowang-q-c8cfba41e4ea66924419","section":"chapter-041","block":"b-20cf9e4bd23391868d15","layer":"original","quote":"出为牂牁太守；还为州前部司马","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":169,"anchor":null},"note_id":null,"start":54,"end":68},{"id":"huowang-q-e9b66b831192e486b700","section":"chapter-041","block":"b-0331bba35be1e9a1beba","layer":"original","quote":"降人李鸿来诣亮，亮见鸿，时蒋琬与诗在坐","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":172,"anchor":null},"note_id":null,"start":22,"end":41},{"id":"huowang-q-ebf767f05c26fd36c8ce","section":"chapter-041","block":"b-d71e29fc595b6b00032c","layer":"original","quote":"由是忤指〖15〗，左迁部永昌从事","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":171,"anchor":null},"note_id":null,"start":138,"end":154},{"id":"huowang-q2-3bf8a9797acb7aa6c764","section":"chapter-041","block":"b-d71e29fc595b6b00032c","layer":"original","quote":"后群臣议欲推汉中王称尊号，诗上疏曰：“殿下以曹操父子逼主篡位〖10〗，故乃羁旅万里〖11〗，纠合士众，将以讨贼。今大敌未克，而先自立，恐人心疑惑。昔高祖与楚约，先破秦者王。及屠咸阳〖12〗，获子婴〖13〗，犹怀推让；况今殿下未出门庭〖14〗，便欲自立邪？愚臣诚不为殿下取也。”由是忤指〖15〗，左迁部永昌从事〖16〗。﹝一﹞","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":171,"anchor":null},"note_id":null,"start":0,"end":162},{"id":"huowang-q2-5b6e7bf927e1863f7b45","section":"chapter-041","block":"b-b9d5c2fd4c47c184f0be","layer":"original","quote":"亮谓琬、诗曰：“还都当有书与子度相闻〖25〗。”诗进曰：“孟达小子，昔事振威不忠〖26〗，后又背叛先主；反覆之人，何足与书邪！”亮默然不答。","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":173,"anchor":null},"note_id":null,"start":0,"end":70},{"id":"liuermu-q-74c22b7e2a9d68bbb6e6","section":"chapter-031","block":"b-2a7eb34fd683676ae1b4","layer":"original","quote":"丞相诸葛亮平南土","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":75,"anchor":null},"note_id":null,"start":41,"end":49},{"id":"liuliao-q-bff53060b5c21dc2f8b9","section":"chapter-040","block":"b-c85321149a539f796ae2","layer":"original","quote":"建安十八年，署严为护军，拒先主于绵竹。严率众降先主，先主拜严裨将军","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":186,"anchor":null},"note_id":null,"start":0,"end":33},{"id":"xianzhu-e-o041b-q","section":"chapter-032","block":"b-c205af65c5b891e6a027","layer":"original","quote":"璋遣刘z 、冷苞、张任、邓贤〔、吴懿〕等拒先主于涪；﹝三﹞皆破败，退保绵竹。璋复遣李严督绵竹诸军〖12〗，严率众降先主。先主军益强，分遣诸将平下属县。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":166,"anchor":null},"note_id":null,"start":76,"end":151},{"id":"xianzhu-e-o043c-q","section":"chapter-032","block":"b-4a221026fdb893201c62","layer":"original","quote":"先主复领益州牧：诸葛亮为股肱〖2〗，法正为谋主，关羽、张飞、马超为爪牙〖3〗，许靖、麋竺、简雍为宾友〖4〗。及董和、黄权、李严等〖5〗，本璋之所授用也，吴壹、费观等〖6〗，又璋之婚亲也；彭羕〖7〗，又璋之所排摈也；刘巴者〖8〗，宿昔之所忌恨也：皆处之显任，尽其器能。有志之士，无不竞劝。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":186,"anchor":null},"note_id":null,"start":63,"end":206},{"id":"xianzhu-q-b-dcc10490c7b3b72c467f","section":"chapter-032","block":"b-dcc10490c7b3b72c467f","layer":"modern","quote":"〖1〗十九年：建安十九年（公元 214）。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":188,"anchor":null},"note_id":"n-dc65792cc6043766510a","start":0,"end":21},{"id":"xianzhu-q-o043","section":"chapter-032","block":"b-4a221026fdb893201c62","layer":"original","quote":"十九年夏〖1〗，雒城破；﹝一﹞进围成都，数十日，璋出降。﹝二﹞蜀中殷盛丰乐，先主置酒大飨士卒；取蜀城中金银分赐将士，还其谷帛。先主复领益州牧：诸葛亮为股肱〖2〗，法正为谋主，关羽、张飞、马超为爪牙〖3〗，许靖、麋竺、简雍为宾友〖4〗。及董和、黄权、李严等〖5〗，本璋之所授用也，吴壹、费观等〖6〗，又璋之婚亲也；彭羕〖7〗，又璋之所排摈也；刘巴者〖8〗，宿昔之所忌恨也：皆处之显任，尽其器能。有志之士，无不竞劝。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":186,"anchor":null},"note_id":null,"start":0,"end":206},{"id":"xianzhu-q-p038-fucheng","section":"chapter-032","block":"b-8aa718c2e93c0cc7db20","layer":"pei","quote":"刘璋遣张任、刘璝，率精兵拒捍先主于涪；为先主所破，退与璋子循守雒城。","attribution":"《益部耆旧杂记》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":197,"anchor":null},"note_id":"n-9652930478437e755980","start":14,"end":48},{"id":"xumisun-q-9d9c6c3cd013f113898d","section":"chapter-038","block":"b-4724e70f37115927f07b","layer":"original","quote":"先主克蜀，以靖为左将军长史","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":148,"anchor":null},"note_id":null,"start":7,"end":20},{"id":"zhuge-e-o023a-q","section":"chapter-035","block":"b-862592827af5abe9feb3","layer":"original","quote":"三年春〖10〗，亮率众南征〖11〗。﹝三﹞其秋，悉平：军资所出〖12〗，国以富饶；﹝四﹞乃治戎讲武，以俟大举。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":133,"anchor":null},"note_id":null,"start":0,"end":55},{"id":"zhuge-q-b-28bd067e0a3e898385bc","section":"chapter-035","block":"b-28bd067e0a3e898385bc","layer":"modern","quote":"〖10〗三年：建兴三年（公元 225）。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":144,"anchor":null},"note_id":"n-d52302c7e46aff00f085","start":0,"end":20},{"id":"zhuge-q-o023","section":"chapter-035","block":"b-862592827af5abe9feb3","layer":"original","quote":"三年春〖10〗，亮率众南征〖11〗。﹝三﹞其秋，悉平：军资所出〖12〗，国以富饶；﹝四﹞乃治戎讲武，以俟大举。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":133,"anchor":null},"note_id":null,"start":0,"end":55}],"profiles":{"huowang-p0030":{"fields":[],"directory":{"faction":"shu"}}},"directory_counts":{}}
