{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o100c","title":"焦触张南叛袁氏降曹","accounts":[{"id":"wudi-e-o100c-account","label":"正文","text":"焦触、张南叛攻袁熙、袁尚，二袁奔三郡乌丸，焦触等举县降曹并受封。","evidence":["wudi-e-o100c-q"]}],"participants":[{"person":"wudi-p0222","role":"叛降","evidence":["wudi-e-o100c-q"]},{"person":"wudi-p0223","role":"叛降","evidence":["wudi-e-o100c-q"]},{"person":"wudi-p0221","role":"出奔","evidence":["wudi-e-o100c-q"]},{"person":"wudi-p0198","role":"出奔","evidence":["wudi-e-o100c-q"]},{"person":"cao-cao","role":"受降","evidence":["wudi-e-o100c-q"]}],"place":{"text":"三郡乌丸","evidence":["wudi-e-o100c-q"]},"time":{"label":"建安十年正月","year":205,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o100c-q","wudi-q-o100","wudi-q-b-2e98e13ca098117a86e9"],"chronology":"wudi-y205","dating_review":{"anchor":"wudi-q-o100","basis":"建安十年正月","reviewed":true}},"source_order":[1,558,"O100c"],"order":233},{"id":"dongyuan-e-o065a","title":"焦触张南攻袁熙袁尚二袁奔乌丸","accounts":[{"id":"dongyuan-e-o065a-account","label":"《董二袁刘传第六》正文","text":"焦触张南攻袁熙袁尚二袁奔乌丸","evidence":["dongyuan-e-o065a-q"]}],"participants":[{"person":"wudi-p0222","role":"进攻","evidence":["dongyuan-e-o065a-q"]},{"person":"wudi-p0223","role":"进攻","evidence":["dongyuan-e-o065a-q"]},{"person":"wudi-p0221","role":"败走","evidence":["dongyuan-e-o065a-q"]},{"person":"wudi-p0198","role":"败走","evidence":["dongyuan-e-o065a-q"]}],"place":null,"time":{"label":"袁熙袁尚失幽州时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-o065a-q"]},"ordering_evidence":"dongyuan-e-o065a-q","source_order":[6,373,"O065a"],"order":1708}],"persons":[{"id":"wudi-p0223","name":"张南","evidence":["wudi-q-o100","dongyuan-q-o065"],"facts":[],"aliases":[],"mentions":[{"id":"wudi-m-o100-wudi-p0223","kind":"mention","text":"文中提及","evidence":["wudi-q-o100"]},{"id":"dongyuan-m-o065-wudi-p0223","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o065"]}]}],"evidence":[{"id":"dongyuan-e-o065a-q","section":"chapter-006","block":"b-192340983e440a0e661b","layer":"original","quote":"熙、尚为其将焦触、张南所攻，奔辽西乌丸。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":372,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o065","section":"chapter-006","block":"b-192340983e440a0e661b","layer":"original","quote":"熙、尚为其将焦触、张南所攻，奔辽西乌丸。触自号幽州刺史，驱率诸郡太守、令长，背袁向曹；陈兵数万，杀白马盟。令曰：“违命者斩！”众莫敢语，各以次歃〖3〗。至别驾韩珩，曰：“吾受袁公父子厚恩，今其破亡，智不能救，勇不能死，于义缺矣；若乃北面于曹氏〖4〗，所弗能为也！”一坐为珩失色。触曰：“夫兴大事，当立大义；事之济否，不待一人。可卒珩志〖5〗，以励事君〖6〗。”","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":372,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":180,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o100c-q","section":"chapter-001","block":"b-1ca17316b02d7b4d213c","layer":"original","quote":"是月，袁熙大将焦触、张南等叛〖5〗，攻熙、尚；熙、尚奔三郡乌丸〖6〗。触等举其县降，封为列侯。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":557,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":76,"end":123,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-2e98e13ca098117a86e9","section":"chapter-001","block":"b-2e98e13ca098117a86e9","layer":"modern","quote":"〖1〗十年：建安十年（公元 205）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":560,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a9b0434ee8de64aed40f","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o100","section":"chapter-001","block":"b-1ca17316b02d7b4d213c","layer":"original","quote":"十年春正月〖1〗，攻谭，破之。斩谭，诛其妻子〖2〗，冀州平。﹝一﹞下令曰：“其与袁氏同恶者，与之更始〖3〗。”令民不得复私仇，禁厚葬；皆一之于法〖4〗。是月，袁熙大将焦触、张南等叛〖5〗，攻熙、尚；熙、尚奔三郡乌丸〖6〗。触等举其县降，封为列侯。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":557,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":123,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
