nchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":47,"end":57,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-795f128073847807d36d","section":"chapter-030","block":"b-ff66571bde87edf233d8","layer":"original","quote":"宫遣主簿、大加将数千人，助军","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":193,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":32,"end":46,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-909ca0dfe79690916c1a","section":"chapter-030","block":"b-4a01b4f250fa0cbefba2","layer":"original","quote":"伊夷模死，立以为王，今句丽王宫是也","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":192,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":21,"end":38,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-916e9f026a339b175ccd","section":"chapter-030","block":"b-23465df5bcf6e11b3a0a","layer":"original","quote":"又遣偏师致讨〖15〗，穷追极远；逾乌丸、（骨）〔丸〕都，过沃沮，践肃慎之庭，东临大海","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":114,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":51,"end":93,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-c2e090ca503b6207d2ef","section":"chapter-030","block":"b-8ea8a2749a1c8c5474fe","layer":"original","quote":"毌丘俭讨句丽，句丽王宫奔沃沮","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":239,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":14,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-ef30f7a11e957773b5d5","section":"chapter-030","block":"b-ff66571bde87edf233d8","layer":"original","quote":"其五年〖40〗，为幽州刺史毌丘俭所破","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/ti