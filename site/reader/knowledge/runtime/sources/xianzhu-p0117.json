xianzhu-e-o070a-q"]},{"person":"xianzhu-p0117","role":"追军后撤","evidence":["xianzhu-e-o070a-q"]}],"place":{"text":"南山、巫","evidence":["xianzhu-e-o070a-q"]},"time":{"year":222,"label":"章武二年秋八月","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xianzhu-y222","dating_review":{"reviewed":true,"anchor":"xianzhu-q-o068","basis":"章武二年秋八月"},"evidence":["xianzhu-e-o070a-q","xianzhu-q-o068","xianzhu-q-b-e2b85eacbc16310809ee"]},"source_order":[32,404,"O070a"],"order":6614}],"persons":[{"id":"xianzhu-p0117","name":"刘阿","evidence":["xianzhu-q-o067","zhangle-q-o034"],"facts":[],"aliases":[],"mentions":[{"id":"xianzhu-m-o067-xianzhu-p0117","kind":"mention","text":"文中提及","evidence":["xianzhu-q-o067"]},{"id":"xianzhu-m-o070-xianzhu-p0117","kind":"mention","text":"文中提及","evidence":["xianzhu-q-o070"]},{"id":"zhangle-m-o034-xianzhu-p0117","kind":"mention","text":"文中提及","evidence":["zhangle-q-o034"]}]}],"evidence":[{"id":"xianzhu-e-o067b-q","section":"chapter-032","block":"b-f54e9d2c0e7f626f5702","layer":"original","quote":"吴将陆议、李异、刘阿等屯巫、秭归；将军吴班、冯习自巫攻破异等〖5〗；军次秭归，武陵五溪蛮夷遣使请兵〖6〗。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":400,"anchor":null},"note_id":null,"start":41,"end":94},{"id":"xianzhu-e-o070a-q","section":"chapter-032","block":"b-b545db4aad347d176890","layer":"original","quote":"吴遣将军李异、刘阿等踵蹑先主军〖14〗，屯驻南山〖15〗。秋八月，收兵还巫。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":403,"anchor":null},"note_id":null,"start":0,"end":38},{"id":"xianzhu-q-b-7396ee3085c96d5be06c","section":"chapter-032","block":"b-7396ee3085c96d5be06c","layer":"modern","quote":"〖22〗建安二十六年：公元 221 年。建安年号到二十四年为止。刘备不承认曹魏的年号，所以继续以建安年号记年。丙午：阴历初六日。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":380,"anchor":null},"note_id":"n-dce0e27ac9260548c4b5","start":0,"end":64},{"id":"xianzhu-q-b-e2b85eacbc16310809ee","section":"chapter-032","block":"b-e2b85eacbc16310809ee","layer":"modern","quote":"〖7〗二年：章武二年（公元 222）。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":413,"anchor":null},"note_id":"n-18295fa1c5ff11c612db","start":0,"end":19},{"id":"xianzhu-q-o065","section":"chapter-032","block":"b-3ec28bd830861da89fc0","layer":"original","quote":"即皇帝位于成都武担之南〖21〗，﹝一﹞为文曰：“惟建安二十六年四月丙午〖22〗，皇帝〔臣〕备，敢用玄牡〖23〗，昭告皇天上帝、后土神祇：汉有天下，历数无疆。曩者王莽篡盗〖24〗，光武皇帝震怒致诛，社稷复存。今曹操阻兵安忍〖25〗，戮杀主后；滔天泯夏〖26〗，罔顾天显〖27〗。操子丕，载其凶逆〖28〗，窃居神器。群臣将士以为社稷坠废，备宜修之；嗣武二祖〖29〗，龚行天罚。备惟否德〖30〗，惧忝帝位〖31〗；询于庶民，外及蛮夷君长，佥曰：‘天命不可以不答，祖业不可以久替，四海不可以无主；率土式望〖32〗，在备一人。’备畏天明命，又惧汉阼将湮于地；谨择元日〖33〗，与百僚登坛，受皇帝玺绶；修燔瘗〖34〗，告类于大神〖35〗。惟神〔尚〕飨〖36〗！祚于汉家，永绥四海〖37〗！”﹝二﹞","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":357,"anchor":null},"note_id":null,"start":0,"end":342},{"id":"xianzhu-q-o067","section":"chapter-032","block":"b-f54e9d2c0e7f626f5702","layer":"original","quote":"初，先主忿孙权之袭关羽，将东征。秋七月，遂帅诸军伐吴。孙权遣书请和，先主盛怒不许。吴将陆议、李异、刘阿等屯巫、秭归；将军吴班、冯习自巫攻破异等〖5〗；军次秭归，武陵五溪蛮夷遣使请兵〖6〗。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":400,"anchor":null},"note_id":null,"start":0,"end":94},{"id":"xianzhu-q-o068","section":"chapter-032","block":"b-8136daaf302c35b9c188","layer":"original","quote":"二年春正月〖7〗，先主军还秭归；将军吴班、陈式水军屯夷陵，夹江东西岸〖8〗。二月，先主自秭归率诸将进军，缘山截岭，于夷道猇亭﹝二﹞驻营〖9〗。自佷山﹝三﹞通武陵〖10〗，遣侍中马良安慰五溪蛮夷〖11〗，咸相率响应。镇北将军黄权督江北诸军，与吴军相拒于夷陵道。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":401,"anchor":null},"note_id":null,"start":0,"end":129},{"id":"xianzhu-q-o070","section":"chapter-032","block":"b-b545db4aad347d176890","layer":"original","quote":"吴遣将军李异、刘阿等踵蹑先主军〖14〗，屯驻南山〖15〗。秋八月，收兵还巫。司徒许靖卒。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":403,"anchor":null},"note_id":null,"start":0,"end":44},{"id":"zhangle-e-o034a-q","section":"chapter-017","block":"b-44f76925e2aff303abc0","layer":"original","quote":"明帝即位，遣南屯荆州。与司马宣王击孙权别将刘阿等，追至祁口〖1〗；交战，破之。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":121,"anchor":null},"note_id":null,"start":0,"end":39},{"id":"zhangle-q-o034","section":"chapter-017","block":"b-44f76925e2aff303abc0","layer":"original","quote":"明帝即位，遣南屯荆州。与司马宣王击孙权别将刘阿等，追至祁口〖1〗；交战，破之。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":121,"anchor":null},"note_id":null,"start":0,"end":39}],"profiles":{},"directory_counts":{}}
