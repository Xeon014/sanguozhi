014","name":"潘秘","evidence":["panlu-q-1c2ed68e5b28bbb7c6ab","panlu-q-1a0b0d89b834a7c8d737","panlu-q-3f3ab6866752fd343896"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[{"id":"panlu-q-1a0b0d89b834a7c8d737","section":"chapter-061","block":"b-4fb8890078a3403f6754","layer":"pei","quote":"襄阳习温，为荆州大公平。大公平，今之州都。秘过辞于温，问曰：‘先君昔（因）〔曰〕君侯当为州里议主，今果如其言；不审州里谁当复相代者？’温曰：‘无过于君也","attribution":"裴注·《襄阳记》","section_title":"潘濬陆凯传第十六","source":{"file":"OEBPS/Text/titlepage_0129.xhtml","index":41,"anchor":null},"note_id":"n-02c93753515c464c5ede","start":8,"end":84},{"id":"panlu-q-1c2ed68e5b28bbb7c6ab","section":"chapter-061","block":"b-19b9464c5ba81582c71a","layer":"pei","quote":"翥弟秘，权以姊陈氏女，妻之。调湘乡令","attribution":"裴注·《吴书》","section_title":"潘濬陆凯传第十六","source":{"file":"OEBPS/Text/titlepage_0129.xhtml","index":40,"anchor":null},"note_id":"n-02c93753515c464c5ede","start":28,"end":46},{"id":"panlu-q-3f3ab6866752fd343896","section":"chapter-061","block":"b-4fb8890078a3403f6754","layer":"pei","quote":"后秘为尚书仆射，代温为公平，甚得州里之誉","attribution":"裴注·《襄阳记》","section_title":"潘濬陆凯传第十六","source":{"file":"OEBPS/Text/titlepage_0129.xhtml","index":41,"anchor":null},"note_id":"n-02c93753515c464c5ede","start":86,"end":106}],"profiles":{},"directory_counts":{}}
