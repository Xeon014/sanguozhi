ce":["rensu-q-55032501933ccba60d0e","rensu-q-ea3bc4874160c901ba70"]},"ordering_evidence":"rensu-q-55032501933ccba60d0e","source_order":[16,316,68],"order":3445},{"id":"rensu-e-o204","title":"华歆、荀攸素与郑泰善，见郑袤叹曰郑公业为不亡矣","accounts":[{"id":"rensu-a-e7285ee5c5f1a8a40d39","label":"裴注·晋阳秋","text":"华歆、荀攸素与郑泰善，见郑袤叹曰郑公业为不亡矣","evidence":["rensu-q-5d61c1e24e3947b492b2"]}],"participants":[{"person":"wudi-p0340","role":"赞叹者","evidence":["rensu-q-5d61c1e24e3947b492b2"]},{"person":"wudi-p0143","role":"赞叹者","evidence":["rensu-q-5d61c1e24e3947b492b2"]},{"person":"shaodi-p0072","role":"所见之郑泰子","evidence":["rensu-q-5d61c1e24e3947b492b2"]},{"person":"wudi-p0067","role":"所叹不亡之公业","evidence":["rensu-q-5d61c1e24e3947b492b2"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["rensu-q-5d61c1e24e3947b492b2"]},"ordering_evidence":"rensu-q-5d61c1e24e3947b492b2","source_order":[16,348,19],"order":3460}],"persons":[{"id":"shaodi-p0072","name":"郑袤","evidence":["shaodi-q-p023","rensu-q-55032501933ccba60d0e","rensu-q-5d61c1e24e3947b492b2","rensu-q2-570e2db75b6d8087f63c"],"facts":[{"id":"rensu-f2-199ef66884c407e385b9","text":"《晋阳秋》记历临淄侯文学、光禄大夫，泰始七年拜司空，固辞不受，终于家；《晋诸公赞》记子默太常，默弟质、舒、诩皆为卿，默子球为尚书右仆射、领选，球弟豫为尚书。","evidence":["rensu-q2-570e2db75b6d8087f63c"]}],"aliases":[],"mentions":[{"id":"shaodi-m-p023-shaodi-p0072","kind":"mention","text":"文中提及","evidence":["shaodi-q-p023"]}]}],"evidence":[{"id":"rensu-q-55032501933ccba60d0e","section":"chapter-016","block":"b-0ec29c53f32db50fc2e0","layer":"original","quote":"浑将泰小子袤，避难淮南，袁术宾礼甚厚","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":315,"anchor":null},"note_id":null,"start":68,"end":86},{"id":"rensu-q-5d61c1e24e3947b492b2","section":"chapter-016","block":"b-be26b0821daad1e42476","layer":"pei","quote":"泰与华歆、荀攸善，见袤曰：‘郑公业为不亡矣","attribution":"裴注·晋阳秋","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":347,"anchor":null},"note_id":"n-1b669ed5932f35d1e391","start":19,"end":40},{"id":"rensu-q-ea3bc4874160c901ba70","section":"chapter-016","block":"b-0ec29c53f32db50fc2e0","layer":"original","quote":"浑知术必败，时华歆为豫章太守，素与泰善，浑乃渡江投歆","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":315,"anchor":null},"note_id":null,"start":87,"end":113},{"id":"rensu-q2-570e2db75b6d8087f63c","section":"chapter-016","block":"b-be26b0821daad1e42476","layer":"pei","quote":"﹝一﹞《晋阳秋》曰：“泰子袤，字林叔。泰与华歆、荀攸善，见袤曰：‘郑公业为不亡矣！’初为临淄侯文学，稍迁至光禄大夫。泰始七年，以袤为司空；固辞不受，终于家。子默，字思玄。”《晋诸公赞》曰：“默遵守家业，以笃素称。位至太常。默弟质、舒、诩，皆为卿。默子球，清直有理识；尚书右仆射，领选。球弟豫，为尚书。”","attribution":"裴注·晋阳秋","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":347,"anchor":null},"note_id":"n-1b669ed5932f35d1e391","start":0,"end":151},{"id":"shaodi-e-p023a-q","section":"chapter-004","block":"b-b16a9dbb51cb501fdf1f","layer":"pei","quote":"﹝四﹞《魏书》曰：“景王复与群臣共奏永宁宫曰：‘臣等闻：人道亲亲，故尊祖；尊祖，故敬宗。礼，大宗无嗣，则择支子之贤者。为人后者，为之子也。东海定王子高贵乡公，文皇帝之孙；宜承正统，以嗣烈祖明皇帝后。率土有赖，万邦幸甚，臣请征公诣洛阳宫。’奏，可。使中护军望，兼太常、河南尹肃，持节，与少府（褒）〔袤〕、尚书亮、侍中表等，奉法驾，迎公于元城。”","attribution":"《魏书》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":305,"anchor":null},"note_id":"n-a571bce205aad8e15394","start":0,"end":171},{"id":"shaodi-q-b-91c7db3288e80e5b9e4b","section":"chapter-004","block":"b-91c7db3288e80e5b9e4b","layer":"modern","quote":"〖1〗六年：嘉平六年（公元 254）。己丑：旧历初一日。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":275,"anchor":null},"note_id":"n-386affd091adab4ef2df","start":0,"end":28},{"id":"shaodi-q-o059","section":"chapter-004","block":"b-83849af55ebd17291970","layer":"original","quote":"六年春二月，己丑〖1〗，镇东将军毌丘俭上言：“昔诸葛恪围合肥新城，城中遣士刘整出围〖2〗，传消息，为贼所得。考问所传，语整曰：‘诸葛公欲活汝，汝可具服〖3〗。’整骂曰：‘死狗，此何言也！我当必死为魏国鬼！不苟求活逐汝去也。欲杀我者，便速杀之！’终无他辞。又遣士郑像出城传消息。或以语恪，恪遣马骑寻围迹索，得像还。四五人的头面缚〖4〗，将绕城表。敕语像〖5〗，使大呼，言：‘大军已还洛，不如早降！’像不从其言，更大呼城中曰：‘大军近在围外，壮士努力！’贼以刀筑其口，使不得言。像遂大呼，令城中闻知。整、像为兵，能守义执节，子弟宜有差异〖6〗。”","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":266,"anchor":null},"note_id":null,"start":0,"end":271},{"id":"shaodi-q-p023","section":"chapter-004","block":"b-b16a9dbb51cb501fdf1f","layer":"pei","quote":"﹝四﹞《魏书》曰：“景王复与群臣共奏永宁宫曰：‘臣等闻：人道亲亲，故尊祖；尊祖，故敬宗。礼，大宗无嗣，则择支子之贤者。为人后者，为之子也。东海定王子高贵乡公，文皇帝之孙；宜承正统，以嗣烈祖明皇帝后。率土有赖，万邦幸甚，臣请征公诣洛阳宫。’奏，可。使中护军望，兼太常、河南尹肃，持节，与少府（褒）〔袤〕、尚书亮、侍中表等，奉法驾，迎公于元城。”","attribution":"《魏书》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":305,"anchor":null},"note_id":"n-a571bce205aad8e15394","start":0,"end":171},{"id":"zhonghua-q-2075dcee19897f7496b4","section":"chapter-013","block":"b-0f4e787b73b6486d2597","layer":"original","quote":"嘉平六年，持节，兼太常，奉法驾〖5〗，迎高贵乡公于元城。","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":480,"anchor":null},"note_id":null,"start":0,"end":28}],"profiles":{},"directory_counts":{}}
