{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o121d","title":"曹操入江陵封赏任用荆州人士","accounts":[{"id":"wudi-e-o121d-account","label":"正文","text":"曹操进军江陵，赦告吏民，封赏归附者；任文聘为江夏太守，任用韩嵩、邓义等。","evidence":["wudi-e-o121d-q"]}],"participants":[{"person":"cao-cao","role":"封赏任用","evidence":["wudi-e-o121d-q"]},{"person":"wudi-p0250","role":"受任","evidence":["wudi-e-o121d-q"]},{"person":"wudi-p0251","role":"被任用","evidence":["wudi-e-o121d-q"]},{"person":"wudi-p0252","role":"被任用","evidence":["wudi-e-o121d-q"]}],"place":{"text":"江陵、江夏","evidence":["wudi-e-o121d-q"]},"time":{"label":"建安十三年九月以后","year":208,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o121d-q","wudi-q-o119","wudi-q-b-888495d8be7766faf20c"],"chronology":"wudi-y208","dating_review":{"anchor":"wudi-q-o119","basis":"建安十三年九月以后","reviewed":true}},"source_order":[1,664,"O121d"],"order":270}],"persons":[{"id":"wudi-p0252","name":"邓义","evidence":["wudi-q-o121"],"facts":[],"aliases":[],"mentions":[{"id":"wudi-m-o121-wudi-p0252","kind":"mention","text":"文中提及","evidence":["wudi-q-o121"]}]}],"evidence":[{"id":"wudi-e-o121d-q","section":"chapter-001","block":"b-031a374e9090ba29242f","layer":"original","quote":"公进军江陵〖9〗，下令荆州吏民，与之更始。乃论荆州服从之功，侯者十五人。以刘表大将文聘为江夏太守〖10〗，使统本兵；引用荆州名士韩嵩、邓义等〖11〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":663,"anchor":null},"note_id":null,"start":62,"end":137},{"id":"wudi-q-b-888495d8be7766faf20c","section":"chapter-001","block":"b-888495d8be7766faf20c","layer":"modern","quote":"〖1〗十三年：建安十三年（公元 208）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":666,"anchor":null},"note_id":"n-0bae348fdb687025113d","start":0,"end":21},{"id":"wudi-q-o119","section":"chapter-001","block":"b-4bcffcc4ee709a4e5ea3","layer":"original","quote":"十三年春正月〖1〗，公还邺。作玄武池以肄舟师〖2〗。﹝一﹞汉罢三公官，置丞相、御史大夫〖3〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":661,"anchor":null},"note_id":null,"start":0,"end":47},{"id":"wudi-q-o121","section":"chapter-001","block":"b-031a374e9090ba29242f","layer":"original","quote":"秋七月，公南征刘表。八月，表卒；其子琮代〖4〗，屯襄阳〖5〗。刘备屯樊〖6〗。九月，公到新野〖7〗，琮遂降。备走夏口〖8〗。公进军江陵〖9〗，下令荆州吏民，与之更始。乃论荆州服从之功，侯者十五人。以刘表大将文聘为江夏太守〖10〗，使统本兵；引用荆州名士韩嵩、邓义等〖11〗。﹝三﹞益州牧刘璋始受征役〖12〗，遣兵给军。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":663,"anchor":null},"note_id":null,"start":0,"end":159}],"profiles":{},"directory_counts":{}}
