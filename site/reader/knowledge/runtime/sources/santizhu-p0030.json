19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b67c177f97871b035fb2","start":141,"end":154,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-190612c850c985d6d7f4","section":"chapter-048","block":"b-ee93699dac12389e55ea","layer":"pei","quote":"权引见，衡口陈壹奸短数千言，权有愧色","attribution":"裴注·襄阳记","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":195,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b67c177f97871b035fb2","start":108,"end":126,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-1a6e5e89234f32be1762","section":"chapter-048","block":"b-ee93699dac12389e55ea","layer":"pei","quote":"时孙休在郡治，衡数以法绳之。妻习氏，每谏衡，衡不从","attribution":"裴注·襄阳记","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":195,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b67c177f97871b035fb2","start":166,"end":191,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-27281e07f1937098532e","section":"chapter-048","block":"b-ee93699dac12389e55ea","layer":"pei","quote":"会休立，衡忧惧，谓妻曰：‘不用卿言，以至于此！’遂欲奔魏。妻曰：‘不可！君本庶民耳。先帝相拔过重，既数作无礼；而复逆自猜嫌，逃叛求活：以此北归，何面见中国人乎？’衡曰：‘计何所出？’妻曰：‘琅邪王，素好善慕名，方欲自显于天下；终不以私嫌杀君，明矣。可自囚诣狱，表列前失，显求受罪。如此，乃当逆见优饶，非但直活而已。’衡从之，果得无患","attribution":"裴注·襄阳记","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":195,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b67c177f97871b035fb2","start":192,"end":358,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-3acd5b2c66023a357a18","section":"chapter-048","block":"b-9d63ae7d8500b7f0f682","layer":"original","quote":"又诏曰：“丹杨太守李衡，以往事之嫌，自拘有司。夫射钩、斩袪〖6〗，在君为君。遣衡还郡，勿令自疑","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":150,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":47,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-40aa978c1097a24a2daf","section":"chapter-048","block":"b-ee93699dac12389e55ea","layer":"pei","quote":"衡每欲治家，妻辄不听；后密遣客十人，于武陵龙阳汜洲上，作宅，种甘橘千株。临死，敕儿曰：‘汝母恶我治家，故穷如是！然吾州里，有千头木奴；不责汝衣食，岁上一匹绢：亦可足用耳。’衡亡后二十余日，儿以白母。母曰：‘此当是种甘橘也！汝家失十户客来七八年，必汝父遣为宅。汝父恒称太史公言：“江陵千树橘，当封君家。”吾答曰：“且人患无德义，不患不富；若贵而能贫，方好耳：用此何为！”’吴末，衡甘橘成；岁得绢数千匹，家道殷足。","attribution":"裴注·襄阳记","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":195,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b67c177f97871b035fb2","start":371,"end":576,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-9dab776d653b4d732c11","section":"chapter-048","block":"b-e2a4d88372a4bf1dca83","layer":"original","quote":"太守李衡，数以事侵休","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":128,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":53,"end":63,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-d2ed2e5089216cc2bcff","section":"chapter-048","block":"b-ee93699dac12389e55ea","layer":"pei","quote":"而衡大见显擢","attribution":"裴注·襄阳记","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":195,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b67c177f97871b035fb2","start":134,"end":140,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-d3e8395276a2dac51361","section":"chapter-048","block":"b-ee93699dac12389e55ea","layer":"pei","quote":"恪被诛，求为丹杨太守","attribution":"裴注·襄阳记","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":195,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b67c177f97871b035fb2","start":155,"end":165,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-e997c6d5c693212a4622","section":"chapter-048","block":"b-ee93699dac12389e55ea","layer":"pei","quote":"又加威远将军，授以棨戟","attribution":"裴注·襄阳记","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":195,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b67c177f97871b035fb2","start":359,"end":370,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-f012df6111efbabf2629","section":"chapter-048","block":"b-ee93699dac12389e55ea","layer":"pei","quote":"闻羊衜有人物之鉴，往干之。衜曰：‘多事之世，尚书剧曹郎才也","attribution":"裴注·襄阳记","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":195,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b67c177f97871b035fb2","start":35,"end":64,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-fd56f067f59cfe391492","section":"chapter-048","block":"b-ee93699dac12389e55ea","layer":"pei","quote":"衜曰：‘非李衡无能困之者！’遂共荐为郎","attribution":"裴注·襄阳记","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":195,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b67c177f97871b035fb2","start":88,"end":107,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-a49c469fafde41f74313","section":"chapter-064","block":"b-bf7194ba919f0bb9485e","layer":"pei","quote":"《汉晋春秋》曰：“恪使司马李衡，往蜀说姜维，令同举。曰：‘古人有言：圣人不能（为）〔违〕时，时至亦不可失也。今敌政在私门，外内猜隔；兵挫于外，而民怨于内。自曹操以来，彼之亡形，未有如今者也。若大举伐之，使吴攻其东，汉入其西；彼救西则东虚，重东则西轻。以练实之军，乘虚轻之敌：破之必矣！’维从之。”","attribution":"裴注·汉晋春秋","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":187,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-bc261450f526f19497a5","start":3,"end":151,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
