{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"sunshi-e-o027c","title":"袁术用惠衢领扬州吴景孙贲攻张英不克","accounts":[{"id":"sunshi-e-o027c-account","label":"《孙破虏讨逆传第一》正文","text":"袁术用惠衢领扬州吴景孙贲攻张英不克","evidence":["sunshi-e-o027c-q"]}],"participants":[{"person":"wudi-p0057","role":"授官","evidence":["sunshi-e-o027c-q"]},{"person":"sunshi-p0047","role":"受任","evidence":["sunshi-e-o027c-q"]},{"person":"sunshi-p0039","role":"征讨","evidence":["sunshi-e-o027c-q"]},{"person":"sunshi-p0027","role":"征讨","evidence":["sunshi-e-o027c-q"]},{"person":"sunshi-p0046","role":"拒战","evidence":["sunshi-e-o027c-q"]}],"place":null,"time":{"label":"刘繇渡江据曲阿时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["sunshi-e-o027c-q"]},"ordering_evidence":"sunshi-e-o027c-q","source_order":[46,180,"O027c"],"order":8077}],"persons":[{"id":"sunshi-p0047","name":"惠衢","evidence":["sunshi-q-o027"],"facts":[],"aliases":[],"mentions":[{"id":"sunshi-m-o027-sunshi-p0047","kind":"mention","text":"文中提及","evidence":["sunshi-q-o027"]}]}],"evidence":[{"id":"sunshi-e-o027c-q","section":"chapter-046","block":"b-1538e7ae2754e5a06f87","layer":"original","quote":"术自用故吏琅邪惠衢为扬州刺史〖25〗，更以景为督军中郎将〖26〗；与贲共将兵击英等，连年不克。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":179,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":120,"end":167,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-o027","section":"chapter-046","block":"b-1538e7ae2754e5a06f87","layer":"original","quote":"先是，刘繇为扬州刺史〖20〗，州旧治寿春。寿春，术已据之；繇乃渡江，治曲阿。时吴景尚在丹杨，策从兄贲又为丹杨都尉〖21〗；繇至，皆迫逐之。景、贲退舍历阳〖22〗。繇遣樊能、于麋（陈横屯江津）〔屯横江〕〖23〗，张英屯当利口〖24〗，以拒术。术自用故吏琅邪惠衢为扬州刺史〖25〗，更以景为督军中郎将〖26〗；与贲共将兵击英等，连年不克。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":179,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":167,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
