ence":["dongyuan-q-p020"]},{"id":"dongyuan-m-p021-dongyuan-p0066","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p021"]}]}],"evidence":[{"id":"dongyuan-e-p020a-q","section":"chapter-006","block":"b-4e5867b3f04aff594570","layer":"pei","quote":"少有大节，为郡门下书佐。其本邑长有罪，太守使孚出教，敕曹下督邮，收之。孚不肯受教，伏地仰谏曰：‘君虽不君，臣不可不臣。明府奈何令孚受教，敕外收本邑长乎？更乞授他吏！’太守奇而听之。","attribution":"谢承《后汉书》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":71,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-02d5fe58c20ace23ce6f","start":16,"end":106,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p020b-q","section":"chapter-006","block":"b-4e5867b3f04aff594570","layer":"pei","quote":"后大将军何进辟，为东曹属。稍迁侍中、河南尹、越骑校尉。","attribution":"谢承《后汉书》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":71,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-02d5fe58c20ace23ce6f","start":106,"end":133,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p020c-q","section":"chapter-006","block":"b-4e5867b3f04aff594570","layer":"pei","quote":"董卓作乱，百僚震栗。孚著小铠，于朝服里挟佩刀见卓，欲伺便刺杀之；语阕辞去，卓送至阁中，孚因出刀刺之。卓多力，退却不中。即收孚，卓曰：‘卿欲反邪？’孚大言曰：‘汝非吾君，吾非汝臣，何反之有！汝乱国篡主，罪盈恶大，今是吾死日，故来诛奸贼耳。恨不车裂汝于市朝，以谢天下！’遂杀孚。","attribution":"谢承《后汉书》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":71,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-02d5fe58c20ace23ce6f","start":133,"end":270,"offset_unit":"unicode_code_point"},{"id":"dongyuan-f0017-q","section":"chapter-006","block":"b-4e5867b3f04aff594570","layer":"pei","quote":"伍孚字德瑜","attribution":"谢承《后汉书》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":71,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-02d5fe58c20ace23ce6f","start":10,"end":15,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p020","section":"chapter-006","block":"b-4e5867b3f04aff594570","layer":"pei","quote":"谢承《后汉书》曰：“伍孚字德瑜。少有大节，为郡门下书佐。其本邑长有罪，太守使孚出教，敕曹下督邮，收之。孚不肯受教，伏地仰谏曰：‘君虽不君，臣不可不臣。明府奈何令孚受教，敕外收本邑长乎？更乞授他吏！’太守奇而听之。后大将军何进辟，为东曹属。稍迁侍中、河南尹、越骑校尉。董卓作乱，百僚震栗。孚著小铠，于朝服里挟佩刀见卓，欲伺便刺杀之；语阕辞去，卓送至阁中，孚因出刀刺之。卓多力，退却不中。即收孚，卓曰：‘卿欲反邪？’孚大言曰：‘汝非吾君，吾非汝臣，何反之有！汝乱国篡主，罪盈恶大，今是吾死日，故来诛奸贼耳。恨不车裂汝于市朝，以谢天下！’遂杀孚。”","attribution":"谢承《后汉书》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":71,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-02d5fe58c20ace23ce6f","start":0,"end":271,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p021","section":"chapter-006","block":"b-b39b4f511a1546cebf6d","layer":"pei","quote":"谢承记孚字及本郡，则与琼同；而致死事乃与孚异也。不知孚为琼之别名？为别有伍孚也？盖未详之。","attribution":"裴松之按","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":72,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-02d5fe58c20ace23ce6f","start":0,"end":45,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
