c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":31,"offset_unit":"unicode_code_point"},{"id":"mantian-q-1fad7cad262d534f9e31","section":"chapter-026","block":"b-b3a9d9dc77437b1997ce","layer":"original","quote":"是岁，与雍州刺史陈泰协策〖33〗，降蜀牙门将句安等于翅上","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":332,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":20,"end":48,"offset_unit":"unicode_code_point"},{"id":"mantian-q-fae704f7e85e5384bcc0","section":"chapter-026","block":"b-b3a9d9dc77437b1997ce","layer":"original","quote":"降蜀牙门将句安等于翅上〖34〗","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":332,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":37,"end":52,"offset_unit":"unicode_code_point"},{"id":"wgc-q0078","section":"chapter-028","block":"b-6a383cd03d18c26da31d","layer":"original","quote":"会上言曰：“贼姜维、张翼、廖化、董厥等〖7〗，逃死遁走，欲趋成都。臣辄遣司马夏侯咸、护军胡烈等，经从剑阁，出新都、大渡截其前〖8〗；参军爰g 、将军句安等蹑其后；参军皇甫闿、将军王买等从涪南出冲其腹；臣据涪县为东西势援。维等所统步骑四五万人，擐甲厉兵〖9〗，塞川填谷，数百里中首尾相继；凭恃其众，方轨而西。臣敕咸、闿等，令分兵据势，广张罗网；南杜走吴之道，西塞成都之路，北绝越逸之径；四面云集，首尾并进，蹊路断绝，走伏无地。臣又手书申喻，开示生路；群寇困逼，知命穷数尽；解甲投戈，面缚委质；印绶万数，资器山积。昔舜舞干戚，有苗自服；牧野之师〖10〗，商旅倒戈〖11〗。有征无战，帝王之盛业。‘全国为上，破国次之；全军为上，破军次之’：用兵之令典〖12〗。陛下圣德，侔踪前代；翼辅忠明〖13〗，齐轨公旦〖14〗；‘仁育群生，义征不h〖15〗’；殊俗向化，无思不服；师不逾时，兵不血刃；万里同风，九州共贯。臣辄奉宣诏命，导扬恩化；复其社稷，安其闾伍；舍其赋调，弛其征役；训之德礼以移其风，示之轨仪以易其俗。百姓欣欣，人怀逸豫〖16〗；后来其苏〖17〗，义无以过。”","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":532,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":480,"offset_unit":"unicode_code_point"},{"id":"wgc-q0476","section":"chapter-028","block":"b-6a383cd03d18c26da31d","layer":"original","quote":"将军句安等蹑其后","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":532,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":72,"end":80,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
