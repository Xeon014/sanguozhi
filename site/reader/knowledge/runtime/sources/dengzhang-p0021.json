02934625"]}],"participants":[{"person":"dengzhang-p0016","role":"与三百余人衰杖送纲丧至武阳，葬讫为起冢立祠，四时奉祭","evidence":["dengzhang-q-f0bd6727307002934625"]},{"person":"dengzhang-p0021","role":"丧，为张婴等所送葬立祠","evidence":["dengzhang-q-f0bd6727307002934625"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["dengzhang-q-f0bd6727307002934625"]},"ordering_evidence":"dengzhang-q-f0bd6727307002934625","source_order":[45,71,1061],"order":7901}],"persons":[{"id":"dengzhang-p0021","name":"张纲","evidence":["dengzhang-q-80b5430d07f455e7142d","dengzhang-q-77987e714205a4725065","dengzhang-q-4c854a560c6353dcbb8e","dengzhang-q-663a98c9bf0c1ac222c5","dengzhang-q-bede8d3e807bdf35460f","dengzhang-q-39aff595303242e57d26","dengzhang-q-2ae2bea39c6b8ec50b25","dengzhang-q-8c094f59e6c41f3aa8bd","dengzhang-q-a2331442a5a85b30eb0f","dengzhang-q-97d1a4759f025b664dac","dengzhang-q-41dcb930852f5408d6dc","dengzhang-q-129e3f00d5edc52bcc05","dengzhang-q-f0bd6727307002934625","dengzhang-q2-8e8ce2821b43604cfb45","dengzhang-q2-f17ace727c3fa3cb9e85"],"facts":[{"id":"dengzhang-f2-67846e6910d8aa958c43","text":"张纲为司徒所辟，以高第任侍御史。","evidence":["dengzhang-q2-8e8ce2821b43604cfb45"]},{"id":"dengzhang-f2-c754ba5df9fe295b8158","text":"天子下诏褒扬张纲，除其未具名一子为郎。","evidence":["dengzhang-q2-f17ace727c3fa3cb9e85"]}],"aliases":[],"mentions":[]}],"evidence":[{"id":"dengzhang-q-129e3f00d5edc52bcc05","section":"chapter-045","block":"b-8204d62ca48619f1ab78","layer":"pei","quote":"建康元年，病，卒官","attribution":"裴注·续汉书","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":70,"anchor":null},"note_id":"n-c5879cbe3d59542c346b","start":1045,"end":1054},{"id":"dengzhang-q-2ae2bea39c6b8ec50b25","section":"chapter-045","block":"b-8204d62ca48619f1ab78","layer":"pei","quote":"纲延置上坐，问其疾苦；礼毕，乃谓之曰：‘前后二千石，多非其人；杜塞国恩，肆其私求。乡郡远，天子不能朝夕闻也，故民人相聚以避害。二千石，信有罪矣；为之者，乃非义也。忠臣不欺君以自荣，孝子不损父以求福。天子（圣人）〔仁圣〕，欲文德以来之；故使大守来，思以爵禄相荣，不愿以刑也：今诚转祸为福之时也。若闻义不服，天子赫然（发）〔震〕怒，〔荆、扬、兖、豫〕大兵云合，岂不危乎？宜深计其利害！’婴闻，泣曰：‘荒裔愚人，数为二千石所侵枉；不堪其困，故遂相聚偷生。明府仁及草木，乃婴等更生之泽；但恐投兵之日，不免孥戮耳！’纲曰：‘岂其然乎！要之以天地，誓之以日月；方当相显以爵位，何祸之有乎？’婴曰：‘苟赦其罪，得全首领以就农亩，则抱戴没齿；爵禄，非所望也！’婴虽为大贼，起于狂暴，自以为必死；及得纲言，旷然开明，乃辞还营","attribution":"裴注·续汉书","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":70,"anchor":null},"note_id":"n-c5879cbe3d59542c346b","start":520,"end":873},{"id":"dengzhang-q-39aff595303242e57d26","section":"chapter-045","block":"b-8204d62ca48619f1ab78","layer":"pei","quote":"纲又于门外罢遣吏兵，留所亲者十余人，以书语其长老素为婴所信者；请与相见，问以本变；因示以诏恩，使还请婴。婴见纲意诚，即出见纲","attribution":"裴注·续汉书","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":70,"anchor":null},"note_id":"n-c5879cbe3d59542c346b","start":457,"end":519},{"id":"dengzhang-q-41dcb930852f5408d6dc","section":"chapter-045","block":"b-8204d62ca48619f1ab78","layer":"pei","quote":"天子美其功，征，欲用之。婴等上书，乞留在郡二岁","attribution":"裴注·续汉书","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":70,"anchor":null},"note_id":"n-c5879cbe3d59542c346b","start":1021,"end":1044},{"id":"dengzhang-q-4c854a560c6353dcbb8e","section":"chapter-045","block":"b-8204d62ca48619f1ab78","layer":"pei","quote":"唯纲独埋车轮于洛阳都亭，不去，曰：‘豺狼当路，安问狐狸！’遂上书曰：‘大将军梁冀、河南尹不疑：蒙外戚之援，荷国厚恩；以刍荛之姿，安居阿保；不能敷扬五教，翼赞日月；而专为封豕长蛇，肆其贪饕；甘心好货，纵恣无厌；多树诌谀，以害忠良：诚天威所不赦，大辟所宜加也！谨条其无君之心十五事于左，皆忠臣之所切齿也。’书奏御，京师震悚","attribution":"裴注·续汉书","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":70,"anchor":null},"note_id":"n-c5879cbe3d59542c346b","start":139,"end":298},{"id":"dengzhang-q-663a98c9bf0c1ac222c5","section":"chapter-045","block":"b-8204d62ca48619f1ab78","layer":"pei","quote":"冀欲陷纲，乃讽尚书，以纲为广陵太守：若不为婴所杀，则欲以法中之","attribution":"裴注·续汉书","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":70,"anchor":null},"note_id":"n-c5879cbe3d59542c346b","start":360,"end":391},{"id":"dengzhang-q-77987e714205a4725065","section":"chapter-045","block":"b-8204d62ca48619f1ab78","layer":"pei","quote":"汉安元年，拜光禄大夫。与侍中杜乔等八人，同日受诏，持节分出，案行天下贪廉","attribution":"裴注·续汉书","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":70,"anchor":null},"note_id":"n-c5879cbe3d59542c346b","start":42,"end":78},{"id":"dengzhang-q-80b5430d07f455e7142d","section":"chapter-045","block":"b-8204d62ca48619f1ab78","layer":"pei","quote":"少以三公子经明行修，举孝廉；不就","attribution":"裴注·续汉书","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":70,"anchor":null},"note_id":"n-c5879cbe3d59542c346b","start":13,"end":29},{"id":"dengzhang-q-8c094f59e6c41f3aa8bd","section":"chapter-045","block":"b-8204d62ca48619f1ab78","layer":"pei","quote":"明日，遂将所部万余人，与妻子面缚，诣纲降。纲悉释缚慰纳","attribution":"裴注·续汉书","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":70,"anchor":null},"note_id":"n-c5879cbe3d59542c346b","start":874,"end":901},{"id":"dengzhang-q-97d1a4759f025b664dac","section":"chapter-045","block":"b-8204d62ca48619f1ab78","layer":"pei","quote":"论功，纲当封；为冀所遏绝，故不得侯","attribution":"裴注·续汉书","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":70,"anchor":null},"note_id":"n-c5879cbe3d59542c346b","start":1003,"end":1020},{"id":"dengzhang-q-a2331442a5a85b30eb0f","section":"chapter-045","block":"b-8204d62ca48619f1ab78","layer":"pei","quote":"纲以其至诚，乃各从其意，亲为安处居宅；子弟欲为吏者，随才任职；欲为民者，劝以农桑；田业并丰，南州晏然","attribution":"裴注·续汉书","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":70,"anchor":null},"note_id":"n-c5879cbe3d59542c346b","start":952,"end":1002},{"id":"dengzhang-q-bede8d3e807bdf35460f","section":"chapter-045","block":"b-8204d62ca48619f1ab78","layer":"pei","quote":"及纲受拜，诏问：‘当得兵马几何？’钢对曰：‘无用兵马。’遂单车之官，径诣婴垒门，示以祸福","attribution":"裴注·续汉书","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":70,"anchor":null},"note_id":"n-c5879cbe3d59542c346b","start":402,"end":446},{"id":"dengzhang-q-f0bd6727307002934625","section":"chapter-045","block":"b-8204d62ca48619f1ab78","layer":"pei","quote":"婴等三百余人，皆衰杖送纲丧至（洛）〔武〕阳；葬讫，为起冢立祠，四时奉祭","attribution":"裴注·续汉书","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":70,"anchor":null},"note_id":"n-c5879cbe3d59542c346b","start":1061,"end":1096},{"id":"dengzhang-q2-8e8ce2821b43604cfb45","section":"chapter-045","block":"b-8204d62ca48619f1ab78","layer":"pei","quote":"司徒辟，以高第为侍御史。","attribution":"裴注（引书见原文）","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":70,"anchor":null},"note_id":"n-c5879cbe3d59542c346b","start":30,"end":42},{"id":"dengzhang-q2-f17ace727c3fa3cb9e85","section":"chapter-045","block":"b-8204d62ca48619f1ab78","layer":"pei","quote":"天子追念不已，下诏褒扬，除一子为郎。","attribution":"裴注（引书见原文）","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":70,"anchor":null},"note_id":"n-c5879cbe3d59542c346b","start":1104,"end":1122},{"id":"dengzhang-q2-f72462e0309e411a20df","section":"chapter-045","block":"b-8204d62ca48619f1ab78","layer":"pei","quote":"《续汉书》曰：“纲字文纪。少以三公子经明行修，举孝廉；不就。司徒辟，以高第为侍御史。汉安元年，拜光禄大夫。与侍中杜乔等八人，同日受诏，持节分出，案行天下贪廉：墨绶有罪，便收；刺史、二千石，以驿表闻。威惠清忠，名振郡国，号曰‘八俊’。是时，大将军梁冀侵扰百姓，乔等七人皆奉命四出；唯纲独埋车轮于洛阳都亭，不去，曰：‘豺狼当路，安问狐狸！’遂上书曰：‘大将军梁冀、河南尹不疑：蒙外戚之援，荷国厚恩；以刍荛之姿，安居阿保；不能敷扬五教，翼赞日月；而专为封豕长蛇，肆其贪饕；甘心好货，纵恣无厌；多树诌谀，以害忠良：诚天威所不赦，大辟所宜加也！谨条其无君之心十五事于左，皆忠臣之所切齿也。’书奏御，京师震悚。时冀妹为皇后，内宠方盛，冀兄弟权重于人主；顺帝虽知纲言不诬，然无心治冀。冀深恨纲。会广陵贼张婴等众数万人，杀刺史、二千石。冀欲陷纲，乃讽尚书，以纲为广陵太守：若不为婴所杀，则欲以法中之。前大守往，辄多请兵；及纲受拜，诏问：‘当得兵马几何？’钢对曰：‘无用兵马。’遂单车之官，径诣婴垒门，示以祸福。婴大惊惧，走欲闭门。纲又于门外罢遣吏兵，留所亲者十余人，以书语其长老素为婴所信者；请与相见，问以本变；因示以诏恩，使还请婴。婴见纲意诚，即出见纲。纲延置上坐，问其疾苦；礼毕，乃谓之曰：‘前后二千石，多非其人；杜塞国恩，肆其私求。乡郡远，天子不能朝夕闻也，故民人相聚以避害。二千石，信有罪矣；为之者，乃非义也。忠臣不欺君以自荣，孝子不损父以求福。天子（圣人）〔仁圣〕，欲文德以来之；故使大守来，思以爵禄相荣，不愿以刑也：今诚转祸为福之时也。若闻义不服，天子赫然（发）〔震〕怒，〔荆、扬、兖、豫〕大兵云合，岂不危乎？宜深计其利害！’婴闻，泣曰：‘荒裔愚人，数为二千石所侵枉；不堪其困，故遂相聚偷生。明府仁及草木，乃婴等更生之泽；但恐投兵之日，不免孥戮耳！’纲曰：‘岂其然乎！要之以天地，誓之以日月；方当相显以爵位，何祸之有乎？’婴曰：‘苟赦其罪，得全首领以就农亩，则抱戴没齿；爵禄，非所望也！’婴虽为大贼，起于狂暴，自以为必死；及得纲言，旷然开明，乃辞还营。明日，遂将所部万余人，与妻子面缚，诣纲降。纲悉释缚慰纳，谓婴曰：‘卿诸人一旦解散，方垂荡然；当条名上之，必受封赏。’婴曰：‘乞归故业，不愿以秽名污明时也！’纲以其至诚，乃各从其意，亲为安处居宅；子弟欲为吏者，随才任职；欲为民者，劝以农桑；田业并丰，南州晏然。论功，纲当封；为冀所遏绝，故不得侯。天子美其功，征，欲用之。婴等上书，乞留在郡二岁。建康元年，病，卒官。时年三十六。婴等三百余人，皆衰杖送纲丧至（洛）〔武〕阳；葬讫，为起冢立祠，四时奉祭，思慕如丧考妣。天子追念不已，下诏褒扬，除一子为郎。”","attribution":"裴注（引书见原文）","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":70,"anchor":null},"note_id":"n-c5879cbe3d59542c346b","start":0,"end":1123}],"profiles":{},"directory_counts":{}}
