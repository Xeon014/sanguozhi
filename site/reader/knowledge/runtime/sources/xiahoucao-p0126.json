evidence":["wgc-q0705","wgc-q0138"]}],"participants":[{"person":"xiahoucao-p0126","role":"收葬","evidence":["wgc-q0705","wgc-q0138"]},{"person":"shaodi-p0073","role":"被收葬","evidence":["wgc-q0705","wgc-q0138"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0705","wgc-q0138"]},"ordering_evidence":"wgc-q0705"},{"id":"wgc-e-16-e8","title":"向雄答掩骼埋胔之义王悦遣之","order":5831,"accounts":[{"id":"wgc-a-16-e8","label":"裴注·汉晋春秋","text":"向雄答掩骼埋胔之义王悦遣之","evidence":["wgc-q0641","wgc-q0138"]}],"participants":[{"person":"xiahoucao-p0126","role":"答以掩骼埋胔仁流朽骨之义","evidence":["wgc-q0641","wgc-q0138"]},{"person":"shaodi-p0045","role":"悦、与宴谈而遣之","evidence":["wgc-q0641","wgc-q0138"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0641","wgc-q0138"]},"ordering_evidence":"wgc-q0641"}],"persons":[{"id":"xiahoucao-p0126","name":"向雄","evidence":["xiahoucao-q-p069","wgc-q0138"],"facts":[],"aliases":[],"mentions":[{"id":"xiahoucao-m-p069-xiahoucao-p0126","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-p069"]},{"id":"wgc-m-p063-xiahoucao-p0126","kind":"mention","text":"本段涉及向雄","evidence":["wgc-q0138"]}]}],"evidence":[{"id":"wgc-q0138","section":"chapter-028","block":"b-2734da889060ff3b807a","layer":"pei","quote":"《汉晋春秋》曰：“文王闻钟会功曹向雄之收葬会也，召而责之曰：‘往者王经之死，卿哭于东市而我不问，今钟会躬为叛逆而又辄收葬；若复相容，其如王法何！’雄曰：‘昔先王掩骼埋胔，仁流朽骨，当时岂先卜其功罪而后收葬哉？今王诛既加，于法已备；雄感义收葬，教亦无阙。法立于上，教弘于下；以此训物，雄曰可矣，何必使雄背死违生，以立于时？殿下仇对枯骨，捐之中野，百岁之后，为臧获所笑，岂仁贤所掩哉？’王悦，与宴谈而遣之。”习凿齿曰：“向伯茂，可谓勇于蹈义也！哭王经而哀感市人，葬钟会而义动明主；彼皆忠烈奋劲，知死而往，非存生也。况使经、会处世，或身在急难，而有不赴者乎？故寻其奉死之心，可以见事生之情；览其忠贞之节，足以愧背义之士矣。王加礼而遣，可谓明达。”","attribution":"汉晋春秋；习凿齿论","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":620,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b8c46d3147cdc6a86a2c","start":0,"end":320,"offset_unit":"unicode_code_point"},{"id":"wgc-q0640","section":"chapter-028","block":"b-2734da889060ff3b807a","layer":"pei","quote":"文王闻钟会功曹向雄之收葬会也，召而责之曰：‘往者王经之死，卿哭于东市而我不问，今钟会躬为叛逆而又辄收葬；若复相容，其如王法何","attribution":"裴注·汉晋春秋","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":620,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b8c46d3147cdc6a86a2c","start":9,"end":71,"offset_unit":"unicode_code_point"},{"id":"wgc-q0641","section":"chapter-028","block":"b-2734da889060ff3b807a","layer":"pei","quote":"昔先王掩骼埋胔，仁流朽骨，当时岂先卜其功罪而后收葬哉？今王诛既加，于法已备；雄感义收葬，教亦无阙。法立于上，教弘于下；以此训物，雄曰可矣，何必使雄背死违生，以立于时？殿下仇对枯骨，捐之中野，百岁之后，为臧获所笑，岂仁贤所掩哉？’王悦，与宴谈而遣之","attribution":"裴注·汉晋春秋","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":620,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b8c46d3147cdc6a86a2c","start":77,"end":200,"offset_unit":"unicode_code_point"},{"id":"wgc-q0705","section":"chapter-028","block":"b-2734da889060ff3b807a","layer":"pei","quote":"文王闻钟会功曹向雄之收葬会也，","attribution":"汉晋春秋；习凿齿论","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":620,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b8c46d3147cdc6a86a2c","start":9,"end":24,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-p069b-q","section":"chapter-009","block":"b-85303da9d80e55d46607","layer":"pei","quote":"经为司隶校尉，辟河内向雄为都官从事。","attribution":"《世语》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":640,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-73667ee44886c1a2557e","start":93,"end":111,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-p069c-q","section":"chapter-009","block":"b-85303da9d80e55d46607","layer":"pei","quote":"王业之出，不申经（竟）〔意〕以及难。经刑于东市，雄哭之，感动一市。刑及经母。雍州故吏皇甫晏，以家财收葬焉。","attribution":"《世语》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":640,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-73667ee44886c1a2557e","start":111,"end":164,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-p069","section":"chapter-009","block":"b-85303da9d80e55d46607","layer":"pei","quote":"﹝二﹞《世语》曰：“经字彦（伟）〔纬〕。初为江夏大守。大将军曹爽附绢（二十）〔二千〕匹令交市于吴；经不发书，弃官归。母问归状，经以实对。母以经典兵马而擅去，对送吏杖经五十；爽闻，不复罪。经为司隶校尉，辟河内向雄为都官从事。王业之出，不申经（竟）〔意〕以及难。经刑于东市，雄哭之，感动一市。刑及经母。雍州故吏皇甫晏，以家财收葬焉。”","attribution":"《世语》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":640,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-73667ee44886c1a2557e","start":0,"end":165,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
