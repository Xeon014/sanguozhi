{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xiahoucao-e-p069c","title":"王经母子受刑向雄哭市皇甫晏财葬","accounts":[{"id":"xiahoucao-e-p069c-account","label":"《世语》","text":"王经母子受刑向雄哭市皇甫晏财葬","evidence":["xiahoucao-e-p069c-q"]}],"participants":[{"person":"shaodi-p0079","role":"受刑","evidence":["xiahoucao-e-p069c-q"]},{"person":"xiahoucao-p0109","role":"受刑","evidence":["xiahoucao-e-p069c-q"]},{"person":"xiahoucao-p0126","role":"哭市","evidence":["xiahoucao-e-p069c-q"]},{"person":"xiahoucao-p0127","role":"收葬","evidence":["xiahoucao-e-p069c-q"]}],"place":null,"time":{"label":"王经江夏守至被诛后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xiahoucao-e-p069c-q"]},"ordering_evidence":"xiahoucao-e-p069c-q","source_order":[9,641,"P069c"],"order":2381}],"persons":[{"id":"xiahoucao-p0127","name":"皇甫晏","evidence":["xiahoucao-q-p069"],"facts":[],"aliases":[],"mentions":[{"id":"xiahoucao-m-p069-xiahoucao-p0127","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-p069"]}]}],"evidence":[{"id":"xiahoucao-e-p069c-q","section":"chapter-009","block":"b-85303da9d80e55d46607","layer":"pei","quote":"王业之出，不申经（竟）〔意〕以及难。经刑于东市，雄哭之，感动一市。刑及经母。雍州故吏皇甫晏，以家财收葬焉。","attribution":"《世语》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":640,"anchor":null},"note_id":"n-73667ee44886c1a2557e","start":111,"end":164},{"id":"xiahoucao-q-p069","section":"chapter-009","block":"b-85303da9d80e55d46607","layer":"pei","quote":"﹝二﹞《世语》曰：“经字彦（伟）〔纬〕。初为江夏大守。大将军曹爽附绢（二十）〔二千〕匹令交市于吴；经不发书，弃官归。母问归状，经以实对。母以经典兵马而擅去，对送吏杖经五十；爽闻，不复罪。经为司隶校尉，辟河内向雄为都官从事。王业之出，不申经（竟）〔意〕以及难。经刑于东市，雄哭之，感动一市。刑及经母。雍州故吏皇甫晏，以家财收葬焉。”","attribution":"《世语》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":640,"anchor":null},"note_id":"n-73667ee44886c1a2557e","start":0,"end":165}],"profiles":{},"directory_counts":{}}
