{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"yaoci-e-o096","title":"吕岱被诏诛徽，自广州将兵昼夜驰入，过合浦与良俱前","accounts":[{"id":"yaoci-a-a1246cf8463779b823d8","label":"正文","text":"吕岱被诏诛徽，自广州将兵昼夜驰入，过合浦与良俱前","evidence":["yaoci-q-aedad429ded9dc8488b3"]},{"id":"yaoci-a-99b20976e293ca3d7d00","label":"正文","text":"壹子中郎将匡与岱有旧，岱署匡师友从事","evidence":["yaoci-q-8bf77fea6dd8a8f5693c"]},{"id":"yaoci-a-aea79c76c95cf08f574e","label":"正文","text":"岱先移书交阯告喻祸福，又遣匡见徽说令服罪，虽失郡守保无他忧","evidence":["yaoci-q-36ce4e3899b482dcd2eb"]},{"id":"yaoci-a-a1616796b04a8b27eabf","label":"正文","text":"岱寻匡后至；徽兄祗、弟幹、颂等六人肉袒奉迎；岱谢令复服，前至郡下","evidence":["yaoci-q-92372eb53339246e5b67"]},{"id":"yaoci-a-bb794220912946ec683e","label":"正文","text":"明旦，岱早施帐幔，请徽兄弟以次入；岱起拥节读诏书，数徽罪过；左右因反缚以出，即皆伏诛，传首诣武昌","evidence":["yaoci-q-8e7762b6d451372d1916"]}],"participants":[{"person":"wuzhu-p0086","role":"受诏驰进者；署任者；移书遣使劝降者；受迎而进者；拥节读诏诛徽者","evidence":["yaoci-q-aedad429ded9dc8488b3","yaoci-q-8bf77fea6dd8a8f5693c","yaoci-q-36ce4e3899b482dcd2eb","yaoci-q-92372eb53339246e5b67","yaoci-q-8e7762b6d451372d1916"]},{"person":"hequan-p0030","role":"俱前者","evidence":["yaoci-q-aedad429ded9dc8488b3"]},{"person":"hequan-p0020","role":"被诏诛者；被劝说者；出降迎者；被诛者","evidence":["yaoci-q-aedad429ded9dc8488b3","yaoci-q-36ce4e3899b482dcd2eb","yaoci-q-92372eb53339246e5b67","yaoci-q-8e7762b6d451372d1916"]},{"person":"yaoci-p0013","role":"受署者；奉命说徽者","evidence":["yaoci-q-8bf77fea6dd8a8f5693c","yaoci-q-36ce4e3899b482dcd2eb"]},{"person":"yaoci-p0019","role":"肉袒奉迎者；兄弟同被诛者","evidence":["yaoci-q-92372eb53339246e5b67","yaoci-q-8e7762b6d451372d1916"]},{"person":"yaoci-p0015","role":"肉袒奉迎者；兄弟同被诛者","evidence":["yaoci-q-92372eb53339246e5b67","yaoci-q-8e7762b6d451372d1916"]},{"person":"yaoci-p0021","role":"肉袒奉迎者；兄弟同被诛者","evidence":["yaoci-q-92372eb53339246e5b67","yaoci-q-8e7762b6d451372d1916"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["yaoci-q-aedad429ded9dc8488b3","y