dongliu-q-480631399ff3624aa041","section":"chapter-039","block":"b-9009e00809c75a20419e","layer":"original","quote":"转在犍为","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":112,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":58,"end":62,"offset_unit":"unicode_code_point"},{"id":"dongliu-q-6d6e286ba840111c26ce","section":"chapter-039","block":"b-b276806059ddb2996f31","layer":"original","quote":"建兴三年，入拜尚书。迁尚书令","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":113,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":14,"offset_unit":"unicode_code_point"},{"id":"dongliu-q-71855a8bc9808f09db31","section":"chapter-039","block":"b-b276806059ddb2996f31","layer":"original","quote":"以震为卫尉〖3〗，贺权践阼","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":113,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":32,"end":45,"offset_unit":"unicode_code_point"},{"id":"dongliu-q-aeb4747942370caca0c8","section":"chapter-039","block":"b-b276806059ddb2996f31","layer":"original","quote":"奉命使吴","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":113,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":15,"end":19,"offset_unit":"unicode_code_point"},{"id":"dongliu-q-bb49b9398747081affcd","section":"chapter-039","block":"b-9009e00809c75a20419e","layer":"original","quote":"先主领荆州牧，辟为从事，部诸郡","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":112,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":11,"end":26,"offset_unit":"unicode_code_point"},{"id":"dongliu-q-db7d1ca9f51f456297d6","section":"chapter-039","block":"b-9009e00809c75a20419e","layer":"original","quote":"随先主入蜀","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":112,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":30,"end":35,"offset_unit":"unicode_code_point"},{"id":"dongliu-q-e9904aeeabad16ae3ed8","section":"chapter-039","block":"b-af4642442933448fc90f","layer":"original","quote":"震入吴界，移关侯曰","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":114,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":9,"offset_unit":"unicode_code_point"},{"id":"dongliu-q2-2f567d9e6048aa89459a","section":"chapter-039","block":"b-af4642442933448fc90f","layer":"original","quote":"震入吴界，移关侯曰〖7〗：“东之与西，驿使往来，冠盖相望〖8〗；申盟初好，日新其事。东尊应保圣祚〖9〗，告燎受符〖10〗，剖判土宇〖11〗；天下响应，各有所归。于此时也，以同心讨贼，则何寇不灭哉！西朝君臣，引领欣赖〖12〗。震以不才，得充下使，奉聘叙好；践界踊跃〖13〗，入则如归。献子适鲁〖14〗，犯其山讳〖15〗，《春秋》讥之；望必启告〖16〗，使行人睦焉〖17〗。即日张旍诰众〖18〗，各自约誓。顺流漂疾〖19〗，国典异制〖20〗；惧或有违，幸必斟诲〖21〗，示其所宜。”","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":114,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":239,"offset_unit":"unicode_code_point"},{"id":"dongliu-q2-b2b260412fd0eac553f3","section":"chapter-039","block":"b-b276806059ddb2996f31","layer":"original","quote":"建兴三年，入拜尚书。迁尚书令，奉命使吴。七年〖2〗，孙权称尊号，以震为卫尉〖3〗，贺权践阼〖4〗。诸葛亮与兄瑾书曰〖5〗：“孝起忠纯之性，老而益笃；及其赞述东西〖6〗，欢乐和合，有可贵者。”","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":113,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":95,"offset_unit":"unicode_code_point"},{"id":"dongliu-q2-f6fe054185dcfe86a77d","section":"chapter-039","block":"b-aa10e5f0d2cfeb33df76","layer":"original","quote":"九年〖25〗，都护李平坐诬罔废〖26〗。诸葛亮与长史蒋琬、侍中董允书曰：“孝起前临至吴，为吾说‘正方腹中有鳞甲〖27〗，乡党以为不可近’。吾以为‘鳞甲者’，但不当犯之耳；不图复有苏、张之事出于不意〖28〗。可使孝起知之。”","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":116,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":111,"offset_unit":"unicode_code_point"},{"id":"wuzhu-e-o089a-q","section":"chapter-047","block":"b-5d43e8016d6ee7f00604","layer":"original","quote":"六月，蜀遣卫尉陈震〖10〗，庆权践位。权乃参分天下〖11〗：豫、青、徐、幽，属吴〖12〗；兖、冀、并、凉，属蜀〖13〗；其司州之土〖14〗，以函谷关为界〖15〗。造为盟曰：","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":447,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":86,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o084","section":"chapter-047","block":"b-83e35f5ca74d8a53a1d7","layer":"original","quote":"黄龙元年春，公卿百司皆劝权正尊号〖1〗。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":442,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o089","section":"chapter-047","block":"b-5d43e8016d6ee7f00604","layer":"original","quote":"六月，蜀遣卫尉陈震〖10〗，庆权践位。权乃参分天下〖11〗：豫、青、徐、幽，属吴〖12〗；兖、冀、并、凉，属蜀〖13〗；其司州之土〖14〗，以函谷关为界〖15〗。造为盟曰：","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":447,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":86,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o090-judgment","section":"chapter-047","block":"b-41369b29327ae254c7c3","layer":"original","quote":"天降丧乱，皇纲失叙〖16〗；逆臣乘衅〖17〗，劫夺国柄：始于董卓，终于曹操；穷凶极恶，以覆四海。至令九州幅裂〖18〗，普天无统；民神痛怨，靡所戾止〖19〗。及操子丕，桀逆遗丑〖20〗；荐作奸回〖21〗，偷取天位。而叡幺麽〖22〗，寻丕凶迹；阻兵盗土，未伏厥诛。昔共工乱象而高辛行师〖23〗，三苗干度而虞舜征焉〖24〗。今日灭叡，擒其徒党；非汉与吴，将复谁任？","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":448,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":179,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o091-judgment","section":"chapter-047","block":"b-35a1cdbe43bcada2be96","layer":"original","quote":"夫讨恶翦暴，必声其罪〖25〗；宜先分裂，夺其土地：使士民之心，各知所归。是以《春秋》晋侯伐卫〖26〗，先分其田以畀宋人〖27〗：斯其义也。且古建大事，必先盟誓；故《周礼》有司盟之官〖28〗，《尚书》有告誓之文〖29〗。汉之与吴，虽信由中〖30〗；然分土裂境，宜有盟约。诸葛丞相，德威远著；翼戴本国，典戎在外〖31〗；信感阴阳，诚动天地；重复结盟，广诚约誓：使东西士民，咸共闻知。故立坛杀牲，昭告神明；再歃加书〖32〗，副之天府〖33〗。天高听下，灵威棐谌〖34〗；司慎、司盟〖35〗，群神群祀：莫不临之。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":449,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":252,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o092-judgment","section":"chapter-047","block":"b-3fa271aefcbf4b9a9a1c","layer":"original","quote":"自今日汉、吴既盟之后，戮力一心，同讨魏贼；救危恤患，分灾共庆；好恶齐之，无或携贰。若有害汉，则吴伐之；若有害吴，则汉伐之。各守分土，无相侵犯；传之后叶〖36〗，克终若始。凡百之约，皆如载书〖37〗。信言不艳〖38〗，实居于好。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":450,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":113,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o093-judgment","section":"chapter-047","block":"b-2a530c4e8431de345f3e","layer":"original","quote":"有渝此盟〖39〗，创祸先乱；违贰不协，慆慢天命〖40〗；明神上帝，是讨是督；山川百神，是纠是殛：俾坠其师〖41〗，无克祚国〖42〗。于尔大神，其明鉴之！","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":451,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":76,"offset_unit":"unicode_code_point"},{"id":"zhuge-e-p033a-q","section":"chapter-035","block":"b-80682ad0bc71f1302b45","layer":"pei","quote":"﹝五﹞《汉晋春秋》曰：“是岁，孙权称尊号，其群臣以并尊二帝来告。议者咸以为：‘交之无益，而名体弗顺；宜显明正义，绝其盟好。’亮曰：‘权有僭逆之心久矣！国家所以略其衅情者，求掎角之援也。今若加显绝，仇我必深；便当移兵东戍，与之角力；须并其土，乃议中原。彼贤才尚多，将相缉穆，未可一朝定也。顿兵相持，坐而须老；使北贼得计，非算之上者。昔孝文卑辞匈奴，先帝优与吴盟；皆应权通变，弘思远益，非匹夫之为（分）〔忿〕者也。今议者咸以“权利在鼎足，不能并力；且志望已满，无上岸之情”。推此，皆似是而非也。何者？其智力不侔，故限江自保；权之不能越江，犹魏贼之不能渡汉，非力有余而利不取也。若大军致讨，彼高当分裂其地以为后规；下当略民广境，示武于内：非端坐者也。若就其不动而睦于我，我之北伐，无东顾之忧，河南之众不得尽西，此之为利，亦已深矣。权僭之罪，未宜明也。’乃遣卫尉陈震庆权正号。”","attribution":"《汉晋春秋》","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":256,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0859e9a7d178bbe2c3fc","start":0,"end":385,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-b-2cd6c12d0155d7b41caf","section":"chapter-035","block":"b-2cd6c12d0155d7b41caf","layer":"modern","quote":"〖21〗七年：建兴七年（公元 229）。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":240,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6aef03116ccf2e720e54","start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-o036","section":"chapter-035","block":"b-019120a2568f2b0d74c9","layer":"original","quote":"七年〖21〗，亮遣陈式攻武都、阴平。魏雍州刺史郭淮率众欲击式，亮自出至建威〖22〗；淮退还，遂平二郡。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":217,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":51,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-p033","section":"chapter-035","block":"b-80682ad0bc71f1302b45","layer":"pei","quote":"﹝五﹞《汉晋春秋》曰：“是岁，孙权称尊号，其群臣以并尊二帝来告。议者咸以为：‘交之无益，而名体弗顺；宜显明正义，绝其盟好。’亮曰：‘权有僭逆之心久矣！国家所以略其衅情者，求掎角之援也。今若加显绝，仇我必深；便当移兵东戍，与之角力；须并其土，乃议中原。彼贤才尚多，将相缉穆，未可一朝定也。顿兵相持，坐而须老；使北贼得计，非算之上者。昔孝文卑辞匈奴，先帝优与吴盟；皆应权通变，弘思远益，非匹夫之为（分）〔忿〕者也。今议者咸以“权利在鼎足，不能并力；且志望已满，无上岸之情”。推此，皆似是而非也。何者？其智力不侔，故限江自保；权之不能越江，犹魏贼之不能渡汉，非力有余而利不取也。若大军致讨，彼高当分裂其地以为后规；下当略民广境，示武于内：非端坐者也。若就其不动而睦于我，我之北伐，无东顾之忧，河南之众不得尽西，此之为利，亦已深矣。权僭之罪，未宜明也。’乃遣卫尉陈震庆权正号。”","attribution":"《汉晋春秋》","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":256,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0859e9a7d178bbe2c3fc","start":0,"end":385,"offset_unit":"unicode_code_point"}],"profiles":{"zhuge-p0038":{"fields":[],"directory":{"faction":"shu"}}},"directory_counts":{}}
