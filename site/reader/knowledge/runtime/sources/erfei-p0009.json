e_id":null,"start":56,"end":62,"offset_unit":"unicode_code_point"},{"id":"dengzhang-q-fd8816170a83b3e8db71","section":"chapter-045","block":"b-69ddd63985a2340030f4","layer":"original","quote":"随刘焉入蜀","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":259,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":10,"end":15,"offset_unit":"unicode_code_point"},{"id":"erfei-q-3a33c7954424c7865a70","section":"chapter-034","block":"b-e1720e70babf6930eb0b","layer":"original","quote":"建安二十四年，立为汉中王后","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":33,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":72,"end":85,"offset_unit":"unicode_code_point"},{"id":"erfei-q-43a1cb23a0f1f9c28d60","section":"chapter-034","block":"b-503b60285f39e36005b1","layer":"original","quote":"是以举家随焉入蜀","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":32,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":34,"end":42,"offset_unit":"unicode_code_point"},{"id":"erfei-q-4752d9cb18794e516529","section":"chapter-034","block":"b-e1720e70babf6930eb0b","layer":"original","quote":"群下劝先主聘后，先主疑与瑁同族","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":33,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":17,"end":32,"offset_unit":"unicode_code_point"},{"id":"erfei-q-512baec489e7c40297d3","section":"chapter-034","block":"b-b32e4a84f604af4b02d4","layer":"original","quote":"章武元年夏五月，策曰","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":34,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":10,"offset_unit":"unicode_code_point"},{"id":"erfei-q-55d622816eb7707a40d1","section":"chapter-034","block":"b-e1720e70babf6930eb0b","layer":"original","quote":"于是纳后为夫人","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":33,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":61,"end":68,"offset_unit":"unicode_code_point"},{"id":"erfei-q-67cc72c4541928482b53","section":"chapter-034","block":"b-4d9028f30fabc08b31ce","layer":"original","quote":"尊后为皇太后，称“长乐宫”","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":35,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":12,"end":25,"offset_unit":"unicode_code_point"},{"id":"erfei-q-8580bfbd0063fae5a23f","section":"chapter-034","block":"b-4d9028f30fabc08b31ce","layer":"original","quote":"延熙八年，后薨，合葬惠陵","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":35,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":38,"end":50,"offset_unit":"unicode_code_point"},{"id":"erfei-q-999d4adf6d2c12e8b0a4","section":"chapter-034","block":"b-e1720e70babf6930eb0b","layer":"original","quote":"法正进曰：“论其亲疏，何与晋文之于子圉乎","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":33,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":36,"end":56,"offset_unit":"unicode_code_point"},{"id":"erfei-q-a93e82dcb002e7f36f58","section":"chapter-034","block":"b-503b60285f39e36005b1","layer":"original","quote":"瑁死，后寡居","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":32,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":76,"end":82,"offset_unit":"unicode_code_point"},{"id":"erfei-q-c8bb822aefd8f3af6970","section":"chapter-034","block":"b-503b60285f39e36005b1","layer":"original","quote":"焉有异志〖3〗，而闻善相者相后当大贵，焉时将子瑁自随；遂为瑁纳后","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":32,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":43,"end":75,"offset_unit":"unicode_code_point"},{"id":"erfei-q2-9b60de42f863f2ba7364","section":"chapter-034","block":"b-e1720e70babf6930eb0b","layer":"original","quote":"先主既定益州，而孙夫人还吴；﹝一﹞群下劝先主聘后，先主疑与瑁同族〖4〗。法正进曰：“论其亲疏，何与晋文之于子圉乎〖5〗？”于是纳后为夫人。﹝二﹞建安二十四年，立为汉中王后。","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":33,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":86,"offset_unit":"unicode_code_point"},{"id":"erfei-q2-ae736c6de8ae8b2111d7","section":"chapter-034","block":"b-b32e4a84f604af4b02d4","layer":"original","quote":"章武元年夏五月，策曰：“朕承天命，奉至尊〖6〗，临万国。今以后为皇后，遣使持节、丞相亮授玺绶〖7〗；承宗庙，母天下〖8〗。皇后其敬之哉！”","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":34,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":69,"offset_unit":"unicode_code_point"},{"id":"erfei-q2-d2e1ec0dbcb9385a2bc5","section":"chapter-034","block":"b-503b60285f39e36005b1","layer":"original","quote":"先主穆吴皇后〖1〗，陈留人也。兄吴壹，少孤；壹父素与刘焉有旧〖2〗，是以举家随焉入蜀。焉有异志〖3〗，而闻善相者相后当大贵，焉时将子瑁自随；遂为瑁纳后。瑁死，后寡居。","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":32,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":83,"offset_unit":"unicode_code_point"},{"id":"houzhu-q-O002","section":"chapter-033","block":"b-7c043f25cb0b51f20adc","layer":"original","quote":"及即尊号，册曰〖3〗：“惟章武元年五月辛巳〖4〗，皇帝若曰〖5〗：太子禅，朕遭汉运艰难，贼臣篡盗；社稷无主，格人群正〖6〗；以天明命，朕继大统〖7〗。今以禅为皇太子，以承宗庙，祗肃社稷〖8〗。使使持节、丞相亮，授印绶；敬听师傅，行一物而三善皆得焉〖9〗，可不勉与〖10〗！”﹝一﹞","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":2,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":140,"offset_unit":"unicode_code_point"},{"id":"liuermu-q-5445365516415190f465","section":"chapter-031","block":"b-6783747cbbde53c6b1ef","layer":"original","quote":"听相者之言，则求婚吴氏","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":122,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":104,"end":115,"offset_unit":"unicode_code_point"},{"id":"liuermu-q-9d3a11f3dc3530ec4241","section":"chapter-031","block":"b-b8148093bbe5d70f2860","layer":"original","quote":"瑁狂疾物故","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":68,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":43,"end":48,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o066d-q","section":"chapter-032","block":"b-9899314a2556743b9f4b","layer":"original","quote":"五月，立皇后吴氏〖2〗，子禅为皇太子。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":399,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":50,"end":69,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-b-7396ee3085c96d5be06c","section":"chapter-032","block":"b-7396ee3085c96d5be06c","layer":"modern","quote":"〖22〗建安二十六年：公元 221 年。建安年号到二十四年为止。刘备不承认曹魏的年号，所以继续以建安年号记年。丙午：阴历初六日。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":380,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-dce0e27ac9260548c4b5","start":0,"end":64,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o065","section":"chapter-032","block":"b-3ec28bd830861da89fc0","layer":"original","quote":"即皇帝位于成都武担之南〖21〗，﹝一﹞为文曰：“惟建安二十六年四月丙午〖22〗，皇帝〔臣〕备，敢用玄牡〖23〗，昭告皇天上帝、后土神祇：汉有天下，历数无疆。曩者王莽篡盗〖24〗，光武皇帝震怒致诛，社稷复存。今曹操阻兵安忍〖25〗，戮杀主后；滔天泯夏〖26〗，罔顾天显〖27〗。操子丕，载其凶逆〖28〗，窃居神器。群臣将士以为社稷坠废，备宜修之；嗣武二祖〖29〗，龚行天罚。备惟否德〖30〗，惧忝帝位〖31〗；询于庶民，外及蛮夷君长，佥曰：‘天命不可以不答，祖业不可以久替，四海不可以无主；率土式望〖32〗，在备一人。’备畏天明命，又惧汉阼将湮于地；谨择元日〖33〗，与百僚登坛，受皇帝玺绶；修燔瘗〖34〗，告类于大神〖35〗。惟神〔尚〕飨〖36〗！祚于汉家，永绥四海〖37〗！”﹝二﹞","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":357,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":342,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
