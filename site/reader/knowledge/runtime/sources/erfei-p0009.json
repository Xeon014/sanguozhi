{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-o066d","title":"刘备立吴皇后刘禅皇太子","accounts":[{"id":"xianzhu-e-o066d-account","label":"《先主传》正文","text":"刘备立吴氏为皇后、刘禅为皇太子。","evidence":["xianzhu-e-o066d-q"]},{"id":"houzhu-a-1d2ccd1c4723","label":"《后主传》正文","text":"及即尊号，册曰〖3〗：“惟章武元年五月辛巳〖4〗，皇帝若曰〖5〗：太子禅，朕遭汉运艰难，贼臣篡盗；社稷无主，格人群正〖6〗；以天明命，朕继大统〖7〗。今以禅为皇太子，以承宗庙，祗肃社稷〖8〗。使使持节、丞相亮，授印绶；敬听师傅，行一物而三善皆得焉〖9〗，可不勉与〖10〗！”﹝一﹞","evidence":["houzhu-q-O002"]},{"id":"erfei-a-3a0e3a121e88bf2b4adc","label":"正文","text":"刘备策立吴氏为皇后","evidence":["erfei-q-512baec489e7c40297d3","erfei-q2-ae736c6de8ae8b2111d7"]}],"participants":[{"person":"liu-bei","role":"册立","evidence":["xianzhu-e-o066d-q"]},{"person":"xianzhu-p0111","role":"立为皇后","evidence":["xianzhu-e-o066d-q"]},{"person":"xianzhu-p0112","role":"立为皇太子","evidence":["xianzhu-e-o066d-q"]},{"person":"zhuge-liang","role":"授印绶者","evidence":["houzhu-q-O002"]},{"person":"erfei-p0009","role":"被策立为皇后","evidence":["erfei-q-512baec489e7c40297d3"]}],"place":null,"time":{"year":221,"label":"章武元年五月","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xianzhu-y221","dating_review":{"reviewed":true,"anchor":"xianzhu-q-o065","basis":"章武元年五月"},"evidence":["xianzhu-e-o066d-q","xianzhu-q-o065","xianzhu-q-b-7396ee3085c96d5be06c"]},"source_order":[32,400,"O066d"],"order":6605},{"id":"erfei-e-o011","title":"吴壹举家随刘焉入蜀","accounts":[{"id":"erfei-a-74e815f0a280355b5b03","label":"正文","text":"吴壹举家随刘焉入蜀","evidence":["erfei-q-43a1cb23a0f1f9c28d60"]},{"id":"dengzhang-a-27ad4291fc5b6e4b2e91","label":"正文","text":"吴壹随刘焉入蜀","evidence":["dengzhang-q-fd8816170a83b3e8db71"]}],"participants":[{"person":"xianzhu-p0056","role":"其父素与刘焉有旧，举家随刘焉入蜀","evidence":["erfei-q-43a1cb23a0f1f9c28d60"]},{"person":"gongsuntao-p0021","role":"入蜀，吴家随行","evidence":["erfei-q-43a1cb23a0f1f9c28d60"]},{"person":"erfei-p0009","role":"随吴家入蜀","evidence":["erfei-q-43a1cb23a0f1f9c28d60"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年"