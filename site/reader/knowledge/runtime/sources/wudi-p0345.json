ccounts":[{"id":"xinyang-a-f4288d267835d1a16a51","label":"正文","text":"马超拘杨岳使杨昂杀州郡长官","evidence":["xinyang-q-f47878baad422027aed7"]}],"participants":[{"person":"wudi-p0282","role":"拘人命杀","evidence":["xinyang-q-f47878baad422027aed7"]},{"person":"xinyang-p-a89cdacfb63c19","role":"被拘","evidence":["xinyang-q-f47878baad422027aed7"]},{"person":"wudi-p0345","role":"杀州郡长官","evidence":["xinyang-q-f47878baad422027aed7"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["xinyang-q-f47878baad422027aed7"]},"ordering_evidence":"xinyang-q-f47878baad422027aed7","order":5052},{"id":"guanzhang-e-p018f","title":"马超因杨昂等害能逃氐中转入蜀","accounts":[{"id":"guanzhang-e-p018f-account","label":"《典略》","text":"马超因杨昂等害能逃氐中转入蜀","evidence":["guanzhang-e-p018f-q"]}],"participants":[{"person":"wudi-p0282","role":"逃奔","evidence":["guanzhang-e-p018f-q"]},{"person":"wudi-p0345","role":"嫉害","evidence":["guanzhang-e-p018f-q"]}],"place":null,"time":{"label":"建安十六年至十九年","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["guanzhang-e-p018f-q"]},"ordering_evidence":"guanzhang-e-p018f-q","source_order":[36,139,"P018f"],"order":6908}],"persons":[{"id":"wudi-p0345","name":"杨昂","evidence":["wudi-q-o176","guanzhang-q-p018","xinyang-q-e8cb2490ce111c7c32b4","xinyang-q-f47878baad422027aed7"],"facts":[],"aliases":[],"mentions":[{"id":"wudi-m-o176-wudi-p0345","kind":"mention","text":"文中提及","evidence":["wudi-q-o176"]},{"id":"guanzhang-m-p018-wudi-p0345","kind":"mention","text":"文中提及","evidence":["guanzhang-q-p018"]}]}],"evidence":[{"id":"gongsuntao-q-d6d122888269e9f8a0e2","section":"chapter-008","block":"b-4d77a48001960371679e","layer":"pei","quote":"遣五官掾降；弟卫，横山筑阳平城以拒，王师不得进","attribution":"裴注·世语","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":309,"anchor":null},"note_id":"n-0c873df6029964ad38a0","start":7,"end":30},{"id":"guanzhang-e-p018f-q","section":"chapter-036","block":"b-107ac81294c6a7f9bb40","layer":"pei","quote":"又鲁将杨（白）〔昂〕等（欲）〔数〕害其能，超遂从武都逃入氐中，转奔往蜀。是岁，建安十九年也。","attribution":"《典略》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":138,"anchor":null},"note_id":"n-7c0270dd171b6d970305","start":248,"end":294},{"id":"guanzhang-q-p018","section":"chapter-036","block":"b-107ac81294c6a7f9bb40","layer":"pei","quote":"﹝三﹞《典略》曰：“建安十六年，超与关中诸将侯选、程银、李堪、张横、梁兴、成宜、马玩、杨秋、韩遂等，凡十部，俱反；其众十万，同据河、潼，建列营阵。是岁，曹公西征，与超等战于河、渭之交，超等败走。超至安定，遂奔凉州。诏收灭超家属。超复败于陇上，后奔汉中，张鲁以为都讲祭酒，欲妻之以女。或谏鲁曰：‘有人若此不爱其亲，焉能爱人？’鲁乃止。初，超未反时，其小妇弟种，留三辅；及超败，种先入汉中。正旦，种上寿于超。超捶胸吐血曰：‘阖门百口，一旦同命，今二人相贺邪！’后数从鲁求兵，欲北取凉州；鲁遣往，无利。又鲁将杨（白）〔昂〕等（欲）〔数〕害其能，超遂从武都逃入氐中，转奔往蜀。是岁，建安十九年也。”","attribution":"《典略》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":138,"anchor":null},"note_id":"n-7c0270dd171b6d970305","start":0,"end":295},{"id":"wudi-e-o176a-q","section":"chapter-001","block":"b-889ba56c5491dd0a8600","layer":"original","quote":"秋七月，公至阳平〖10〗。张鲁使弟卫与将杨昂等据阳平关，横山筑城十余里。攻之不能拔，乃引军还。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":322,"anchor":null},"note_id":null,"start":0,"end":47},{"id":"wudi-q-b-e0a96bdd9353a663e5ab","section":"chapter-001","block":"b-e0a96bdd9353a663e5ab","layer":"modern","quote":"〖1〗二十年：建安二十年（公元 215 ）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":328,"anchor":null},"note_id":"n-3bb2f11071aab1690790","start":0,"end":22},{"id":"wudi-q-o173","section":"chapter-001","block":"b-fc2c779b81f1c3c13b40","layer":"original","quote":"二十年春正月〖1〗，天子立公中女为皇后〖2〗。省云中、定襄、五原、朔方郡〖3〗，郡置一县领其民；合以为新兴郡〖4〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":319,"anchor":null},"note_id":null,"start":0,"end":58},{"id":"wudi-q-o176","section":"chapter-001","block":"b-889ba56c5491dd0a8600","layer":"original","quote":"秋七月，公至阳平〖10〗。张鲁使弟卫与将杨昂等据阳平关，横山筑城十余里。攻之不能拔，乃引军还。贼见大军退，其守备解散。公乃密遣解(、高祚等乘险夜袭。大破之，斩其将杨任。进攻卫，卫等夜遁；鲁溃，奔巴中〖11〗。公军入南郑〖12〗，尽得鲁府库珍宝。﹝二﹞巴、汉皆降〖13〗。复汉宁郡为汉中；分汉中之安阳、西城为西城郡〖14〗，置太守；分锡、上庸（郡）〖15〗，置都尉。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":322,"anchor":null},"note_id":null,"start":0,"end":182},{"id":"xinyang-q-e8cb2490ce111c7c32b4","section":"chapter-025","block":"b-6677f0d0806a149bfd99","layer":"original","quote":"超尽兼陇右之众，而张鲁又遣大将杨昂以助之，凡万余人，攻城。阜率国士大夫及宗族子弟胜兵者千余人〖15〗，使从弟岳于城上作偃月营〖16〗，与超接战，自正月至八月拒守，而救兵不至。州遣别驾阎温循水潜出求救〖17〗，为超所杀，于是刺史、太守失色，始有降超之计。阜流涕谏曰：“阜等率父兄子弟以义相励，有死无二；田单之守〖18〗，不固于此也。弃垂成之功，陷不义之名，阜以死守之。”遂号哭。刺史、太守卒遣人请和，开城门迎超。","section_title":"辛毗杨阜高堂隆传第二十五","source":{"file":"OEBPS/Text/titlepage_0056.xhtml","index":124,"anchor":null},"note_id":null,"start":0,"end":205},{"id":"xinyang-q-f47878baad422027aed7","section":"chapter-025","block":"b-ff87ba012e601d5dc4c9","layer":"original","quote":"超入，拘岳于冀，使杨昂杀刺史、太守。","section_title":"辛毗杨阜高堂隆传第二十五","source":{"file":"OEBPS/Text/titlepage_0056.xhtml","index":125,"anchor":null},"note_id":null,"start":0,"end":18}],"profiles":{},"directory_counts":{}}
