-q-O029"]},{"id":"jfj-m-o024-zhuge-p0045","kind":"mention","text":"本段记载：费祎调解魏延杨仪争执","evidence":["jfj-q0103"]},{"id":"liuliao-m-46829aa6321cd01d671b","kind":"mention","text":"本段涉及杨仪","evidence":["liuliao-q-8b31cc3e680ba8afd3a9","liuliao-q-d9665bbb91f9df502fd4","liuliao-q-04ff760255f9ebb28e0f"]},{"id":"dongliu-m2-role-f8a7998190802f79be14","kind":"mention","text":"文中提及","evidence":["dongliu-q-e31c3700ef74c4d1f0f3","dongliu-q2-25f267a687aa6921afe8"]}]}],"evidence":[{"id":"dongliu-q-9b1b42eb9b3cad1c7740","section":"chapter-039","block":"b-aa10e5f0d2cfeb33df76","layer":"original","quote":"都护李平坐诬罔废","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":116,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":7,"end":15,"offset_unit":"unicode_code_point"},{"id":"dongliu-q-e31c3700ef74c4d1f0f3","section":"chapter-039","block":"b-6d40e1c899febcc21925","layer":"pei","quote":"孙权尝大醉问祎曰：‘杨仪、魏延，牧竖小人也。虽尝有鸣吠之益于时务，然既已任之，势不得轻；若一朝无诸葛亮，必为祸乱矣！诸君愦愦，曾不知防虑于此，岂所谓贻厥孙谋乎","attribution":"裴注·襄阳记","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":186,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a0857d4d9477a7c4acf2","start":36,"end":115,"offset_unit":"unicode_code_point"},{"id":"dongliu-q2-25f267a687aa6921afe8","section":"chapter-039","block":"b-6d40e1c899febcc21925","layer":"pei","quote":"﹝二﹞《襄阳记》曰：“董恢字休绪，襄阳人。入蜀，以宣信中郎，副费祎使吴。孙权尝大醉问祎曰：‘杨仪、魏延，牧竖小人也。虽尝有鸣吠之益于时务，然既已任之，势不得轻；若一朝无诸葛亮，必为祸乱矣！诸君愦愦，曾不知防虑于此，岂所谓贻厥孙谋乎？’祎愕然，四顾视，不能即答。恢目祎曰：‘可速言：仪、延之不协，起于私忿耳，而无黥、韩难御之心也。今方扫除强贼，混一区夏；功以才成，业由才广。若舍此不任，防其后患；是犹备有风波而逆废舟楫，非长计也。’权大笑乐。诸葛亮闻之，以为知言。还，未满三日，辟为丞相府属。迁巴郡太守。”臣松之按：《汉晋春秋》亦载此语，不云董恢所教，辞亦小异；此二书俱出习氏而不同若此。本传云“恢年少官微”，若已为丞相府属，出作巴郡，则官不微矣。以此疑习氏之言为不审的也。","attribution":"裴注（引书见原文）","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":186,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a0857d4d9477a7c4acf2","start":0,"end":336,"offset_unit":"unicode_code_point"},{"id":"houzhu-q-O024","section":"chapter-033","block":"b-13322259e3385d3184d4","layer":"original","quote":"秋八月，都护李平废徙梓潼郡。〖11〗﹝二﹞","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":56,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"houzhu-q-O028","section":"chapter-033","block":"b-f14b2099cf9ad715d98a","layer":"original","quote":"秋八月，亮卒于渭滨。征西大将军魏延，与丞相长史杨仪争权，不和〖17〗，举兵相攻，延败走，斩延首；仪率诸军还成都。大赦。以左将军吴壹为车骑将军，假节督汉中。以丞相留府长史蒋琬为尚书令〖18〗，总统国事。","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":60,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":100,"offset_unit":"unicode_code_point"},{"id":"houzhu-q-O029","section":"chapter-033","block":"b-053e1b4c39a42a6cce03","layer":"original","quote":"十三年春正月，中军师杨仪废徙汉嘉郡〖19〗。","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":61,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":22,"offset_unit":"unicode_code_point"},{"id":"huangli-q-6643c77dec5718446508","section":"chapter-043","block":"b-b11ee1fc4d2478105ae4","layer":"original","quote":"魏延作乱，一战而败：平之功也","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":161,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":17,"end":31,"offset_unit":"unicode_code_point"},{"id":"jfj-q0103","section":"chapter-044","block":"b-2453062e69067490f3ce","layer":"original","quote":"建兴八年，转为中护军，后又为司马。值军师魏延，与长史杨仪相憎恶，每至，并坐争论；延或举刃拟仪〖17〗，仪泣涕横集。祎常入其坐间，谏喻分别〖18〗。终亮之世，各尽延、仪之用者，祎匡救之力也。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":110,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":94,"offset_unit":"unicode_code_point"},{"id":"jfj-q0105","section":"chapter-044","block":"b-2453062e69067490f3ce","layer":"original","quote":"值军师魏延，与长史杨仪相憎恶，每至，并坐争论；延或举刃拟仪〖17〗，仪泣涕横集。祎常入其坐间，谏喻分别〖18〗。终亮之世，各尽延、仪之用者，祎匡救之力也。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":110,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":17,"end":94,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-04ff760255f9ebb28e0f","section":"chapter-040","block":"b-6dc52065d442a8329e1d","layer":"pei","quote":"臣松之以为：此盖敌国传闻之言，不得与本传争审","attribution":"裴注·注家按语","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":323,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a579fc2d130429316a3e","start":122,"end":144,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-06ddd44f26eadeb98aad","section":"chapter-040","block":"b-3cb5b15a96930d85d118","layer":"original","quote":"祎绐延曰〖4〗：“当为君还解杨长史〖5〗；长史文吏，稀更军事〖6〗，必不违命也！”祎出门驰马而去，延寻悔，追之已不及矣。延遣人觇〖7〗，仪等遂使欲案亮成规，诸营相次引军还","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":291,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":85,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-0a13d394f18edc1fb726","section":"chapter-040","block":"b-7e6fe4238cfdb43b76c0","layer":"original","quote":"亮数出军，仪常规画分部，筹度粮谷；不稽思虑〖7〗，斯须便了〖8〗；军戎节度，取办于仪。亮深惜仪之才干，凭魏延之骁勇；常恨二人之不平〖9〗，不忍有所偏废也。","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":327,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":77,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-0d1422bdd1fd62bb32e1","section":"chapter-040","block":"b-dd818fc193fcfc460aad","layer":"original","quote":"先主与语，论军国计策，政治得失；大悦之，因辟为左将军兵曹掾〖1〗。及先主为汉中王，拔仪为尚书","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":325,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":46,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-1346b733fbb3253fbb3d","section":"chapter-040","block":"b-c558478a9b00576fad1c","layer":"original","quote":"杨仪字威公，襄阳人也。建安中，为荆州刺史傅群主簿；背群而诣襄阳太守关羽。羽命为功曹，遣奉使西诣先主。","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":324,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":50,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-13509c2b4ced4972ae61","section":"chapter-040","block":"b-a77c9da17590ce981a3a","layer":"original","quote":"十二年〖10〗，随亮出屯谷口。亮卒于敌场，仪既领军还，又诛讨延；自以为功勋至大，宜当代亮秉政。呼都尉赵正，以《周易》筮之；卦得《家人》〖11〗，默然不悦","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":328,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":76,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-1b34bb87b09da04cd707","section":"chapter-040","block":"b-6dc52065d442a8329e1d","layer":"pei","quote":"﹝一﹞《魏略》曰：“诸葛亮病，谓延等云：‘我之死后，但谨自守，慎勿复来也！’令延摄行己事，密持丧去。延遂匿之，行至褒口，乃发丧。亮长史杨仪，宿与延不和，见延摄行军事，惧为所害；乃张言延欲举众北附，遂率其众攻延。延本无此心，不战军走，追而杀之。”","attribution":"裴注·魏略（异说）","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":323,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a579fc2d130429316a3e","start":0,"end":122,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-1c812a4820a869379925","section":"chapter-040","block":"b-317d1e2f3b26f8f27025","layer":"original","quote":"而亮平生密指〖12〗，以仪性狷狭〖13〗，意在蒋琬；琬遂为尚书令、益州刺史。仪至，拜为中军师，无所统领，从容而已〖14〗。初，仪为先主尚书，琬为尚书郎；后虽俱为丞相参军、长史，仪每从行，当其劳剧〖15〗。自惟年宦先琬，才能逾之；于是怨愤形于声色，叹咤之音发于五内","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":329,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":131,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-4a6733e86270db124d4d","section":"chapter-040","block":"b-1dfd5ab326c02500a1a6","layer":"original","quote":"建兴三年，丞相亮以为参军，署府事，将南行〖3〗。","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":326,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":24,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-6a406d272344fe2f6bdd","section":"chapter-040","block":"b-a9b42ab8457885e68114","layer":"original","quote":"时人畏其言语不节，莫敢从也；惟后军师费祎往慰省之〖17〗。仪对祎恨望〖18〗，前后云云；又语祎曰：“往者丞相亡没之际，吾若举军以就魏氏，处世宁当落度如此邪〖19〗？令人追悔，不可复及！”祎密表其言","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":330,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":98,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-77af79b2872276af9e44","section":"chapter-040","block":"b-46fe7f140656f2fef98a","layer":"original","quote":"秋，亮病困，密与长史杨仪、司马费祎、护军姜维等，作身殁之后退军节度〖1〗：令延断后，姜维次之；若延或不从命，军便自发。亮适卒，秘不发丧；仪令祎往揣延意指〖2〗。延曰：“丞相虽亡，吾自见在。府亲官属，便可将丧还葬；吾自当率诸军击贼。云何以一人死，废天下之事邪？且魏延何人？当为杨仪所部勒〖3〗，作断后将乎！”因与祎共作行留部分；令祎手书与己连名，告下诸将。","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":290,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":177,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-79401dc33d26cf0fb6d3","section":"chapter-040","block":"b-585b382be8c75611e079","layer":"original","quote":"仪等槎山通道〖12〗，昼夜兼行，亦继延后。延先至，据南谷口〖13〗；遣兵逆击仪等。仪等令何平在前御延〖14〗，平叱延先登曰：“公亡，身尚未寒，汝辈何敢乃尔！”延士众知曲在延〖15〗，莫为用命，军皆散","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":293,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":99,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-8616cc25c1fcfa78679e","section":"chapter-040","block":"b-1dfd5ab326c02500a1a6","layer":"original","quote":"八年〖5〗，迁长史，加绥军将军〖6〗。","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":326,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":35,"end":54,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-8b31cc3e680ba8afd3a9","section":"chapter-040","block":"b-587a3c342819d8bffdf8","layer":"original","quote":"原延意不北降魏而南还者〖21〗，但欲除杀仪等；平日诸将素不同，冀时论必当以代亮〖22〗：本指如此〖23〗，不便背叛〖24〗。﹝一﹞","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":296,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":65,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-8e51c44a0be9c4974f53","section":"chapter-040","block":"b-a2d578375714e8a92044","layer":"original","quote":"延大怒，（才）〔搀〕仪未发〖8〗，率所领径先南归；所过烧绝阁道〖9〗。延、仪各相表叛逆〖10〗，一日之中，羽檄交至〖11〗。后主以问侍中董允、留府长史蒋琬，琬、允咸保仪疑延","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":292,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":86,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-92b2ef7bfb78fdc7f66b","section":"chapter-040","block":"b-065c05ab03722c8e41b1","layer":"original","quote":"仪至徙所，复上书诽谤，辞指激切。遂下郡收仪，仪自杀。其妻子还蜀。﹝一﹞","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":331,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":18,"end":53,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-b30598f2b6891fcd098f","section":"chapter-040","block":"b-3973f0a63d7652cc65db","layer":"pei","quote":"﹝二﹞亮公文上尚书曰：“平为大臣，受恩过量；不思忠报，横造无端；危耻不办，迷罔上下；论狱弃科，导人为奸；狭情志狂，若无天地！自度奸露，嫌心遂生；闻军临至，西向托疾还沮、（漳）〔沔〕；军临至沮，复还江阳，平参军狐忠勤谏乃止。今篡贼未灭，社稷多难；国事惟和，可以克捷；不可苞含，以危大业。辄与行中军师，车骑将军、都乡侯臣刘琰，使持节、前军师、征西大将军、领凉州刺史、南郑侯臣魏延，前将军、都亭侯臣袁綝，左将军、领荆州刺史、高阳乡侯臣吴壹，督前部、右将军、玄乡侯臣高翔，督后部、后将军、安乐亭侯臣吴班，领长史、绥军将军臣杨仪，督左部、行中监军、扬武将军臣邓芝，行前监军、征南将军臣刘巴，行中护军、偏将军臣费祎，行前护军、偏将军、汉成亭侯臣许允，行左护军、笃信中郎将臣丁咸，行右护军、偏将军臣刘敏，行护军、征（南）〔西〕将军、当阳亭侯臣姜维，行中典军、讨虏将军臣上官雍，行中参军、昭武中郎将臣胡济，行参军、建义将军臣阎晏，行参军、偏将军臣爨习，行参军、裨将军臣杜义，行参军、武略中郎将臣杜祺，行参军、绥戎都尉臣盛勃，领从事中郎、武略中郎将臣樊岐等议：辄解平任，免官禄、节传、印绶、符策，削其爵土。”","attribution":"裴注·诸葛亮公文上尚书","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":233,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-63939405533bf19c17e7","start":0,"end":495,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-b42ac304d0b5ee390415","section":"chapter-040","block":"b-dd818fc193fcfc460aad","layer":"original","quote":"先主称尊号，东征吴；仪与尚书令刘巴不睦，左迁遥署弘农太守","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":325,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":47,"end":75,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-b4d078ca114d3e79bedf","section":"chapter-040","block":"b-065c05ab03722c8e41b1","layer":"original","quote":"十三年〖20〗，废仪为民，徙汉嘉郡。","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":331,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":18,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-c6e6f60db0bf0cbc289a","section":"chapter-040","block":"b-730d9183607041ebec12","layer":"original","quote":"乃废平为民，徙梓潼郡","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":206,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":10,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-d9665bbb91f9df502fd4","section":"chapter-040","block":"b-c6ce1a9ba0d2a56939d4","layer":"original","quote":"评曰：刘封处嫌疑之地，而思防不足以自卫；彭羕、廖立以才拔进；李严以干局达〖1〗；魏延以勇略任；杨仪以当官显；刘琰旧仕〖2〗：并咸贵重。览其举措，迹其规矩〖3〗；招祸取咎，无不自己也〖4〗。","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":355,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":94,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-db0fecf4962ca3a70bd3","section":"chapter-040","block":"b-1dfd5ab326c02500a1a6","layer":"original","quote":"五年〖4〗，随亮汉中。","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":326,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":24,"end":35,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-fd55cb6c6430cf57b659","section":"chapter-040","block":"b-96862d35761cedcbeb53","layer":"original","quote":"延独与其子数人逃亡，奔汉中。仪遣马岱追斩之〖16〗，致首于仪；仪起自踏之，曰：“庸奴〖17〗，复能作恶不？”遂夷延三族","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":294,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":59,"offset_unit":"unicode_code_point"},{"id":"zhuge-e-p043a-q","section":"chapter-035","block":"b-2f2b6bbbac71886c81dc","layer":"pei","quote":"﹝五﹞《汉晋春秋》曰：“杨仪等整军而出，百姓奔告宣王，宣王追焉。姜维令仪反旗鸣鼓，若将向宣王者；宣王乃退，不敢逼。于是仪结阵而去，入谷然后发丧。宣王之退也，百姓为之谚曰：‘死诸葛走生仲达！’或以告宣王，宣王曰：‘吾能料生，不便料死也。’”","attribution":"《汉晋春秋》","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":312,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5f62dbf3d1f1e8688ec4","start":0,"end":119,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-p043","section":"chapter-035","block":"b-2f2b6bbbac71886c81dc","layer":"pei","quote":"﹝五﹞《汉晋春秋》曰：“杨仪等整军而出，百姓奔告宣王，宣王追焉。姜维令仪反旗鸣鼓，若将向宣王者；宣王乃退，不敢逼。于是仪结阵而去，入谷然后发丧。宣王之退也，百姓为之谚曰：‘死诸葛走生仲达！’或以告宣王，宣王曰：‘吾能料生，不便料死也。’”","attribution":"《汉晋春秋》","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":312,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5f62dbf3d1f1e8688ec4","start":0,"end":119,"offset_unit":"unicode_code_point"}],"profiles":{"zhuge-p0045":{"fields":[{"id":"zhuge-p0045-directory-courtesy","key":"courtesy","label":"字","text":"威公","evidence":["liuliao-q-1346b733fbb3253fbb3d"]}],"directory":{"faction":"shu"}}},"directory_counts":{}}
