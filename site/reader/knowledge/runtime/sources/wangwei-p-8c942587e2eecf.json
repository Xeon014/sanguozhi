{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[],"persons":[{"id":"wangwei-p-8c942587e2eecf","name":"应珣","evidence":["wangwei-q-3e0192260e9b5c7b99dd"],"facts":[{"id":"wangwei-f-2ae900e028cdf44d1c97","text":"应劭之弟、应玚之父，字季瑜，司空掾。","evidence":["wangwei-q-3e0192260e9b5c7b99dd"]}],"mentions":[],"aliases":[]}],"evidence":[{"id":"wangwei-q-3e0192260e9b5c7b99dd","section":"chapter-021","block":"b-379d8fa1f2c8ba75232d","layer":"pei","quote":"《续汉书》曰：“劭又著《中汉辑叙》、《汉官仪》及《礼仪故事》，凡十一种，百三十六卷。朝廷制度，百官仪式，所以不亡者，由劭记之。官至泰山太守。劭弟珣，字季瑜，司空掾；即玚之父。”","attribution":"裴注引《续汉书》","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":123,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0f3014d59d0b9f2f0650","start":0,"end":88,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
