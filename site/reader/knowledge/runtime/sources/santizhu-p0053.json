["wanglou-q-9d5abb6165d196b3ff71"]},"ordering_evidence":"wanglou-q-9d5abb6165d196b3ff71","order":11065}],"persons":[{"id":"santizhu-p0053","name":"留平","evidence":["santizhu-q-296f551772590b86078d","santizhu-q-7f9162718351abfba62e","santizhu-q-7afd12882015e084317a","santizhu-q-55ec39ef43aae33fb99e","santizhu-q-c712dc8b558585c33a44","santizhu-q-5776bdc18959bf237a97","panlu-q-9a0172edb3016f9bf296","panlu-q-4ea9882f3bbfe7c3c937","panlu-q-94d4208c50105d566366","wanglou-q-9d5abb6165d196b3ff71"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[{"id":"huowang-q-35dfebfed4ffc5c8033b","section":"chapter-041","block":"b-4dcb6200f55cc020b124","layer":"pei","quote":"吴闻钟、邓败，百城无主，有兼蜀之志；而巴东固守，兵不得过，使步协率众而西","attribution":"裴注·襄阳记","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":25,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c480ade0f0913bd6d1da","start":302,"end":338,"offset_unit":"unicode_code_point"},{"id":"huowang-q-e055bd41d8e0045e8835","section":"chapter-041","block":"b-4dcb6200f55cc020b124","layer":"pei","quote":"孙休怒，复遣陆抗等帅众三万人增宪之围","attribution":"裴注·襄阳记","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":25,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c480ade0f0913bd6d1da","start":397,"end":415,"offset_unit":"unicode_code_point"},{"id":"panlu-q-4ea9882f3bbfe7c3c937","section":"chapter-061","block":"b-e2b0533f92b634d91b43","layer":"pei","quote":"凯令其子祎，以谋语平。平素与丁奉有隙；祎未及得宣凯旨，平语祎曰：‘闻野猪入丁奉营，此凶征也！’有喜色。祎乃不敢言。还，因具启凯，故辍止","attribution":"裴注·《吴录》","section_title":"潘濬陆凯传第十六","source":{"file":"OEBPS/Text/titlepage_0129.xhtml","index":157,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-34c1b7061cd32124db22","start":81,"end":148,"offset_unit":"unicode_code_point"},{"id":"panlu-q-94d4208c50105d566366","section":"chapter-061","block":"b-6eeada7f4655703a7e98","layer":"original","quote":"或曰：“宝鼎元年十二月，凯与右大司马丁奉、御史大夫丁固谋〖19〗：因皓谒庙〖20〗，欲废皓立孙休子。时左将军留平领兵先驱，故密语平。平拒而不许，誓以不泄；是以所图不果。太史郎陈苗奏皓〖21〗，久阴不雨，风气回逆，将有阴谋：皓深警惧云","section_title":"潘濬陆凯传第十六","source":{"file":"OEBPS/Text/titlepage_0129.xhtml","index":133,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":116,"offset_unit":"unicode_code_point"},{"id":"panlu-q-9a0172edb3016f9bf296","section":"chapter-061","block":"b-e2b0533f92b634d91b43","layer":"pei","quote":"旧拜庙，选兼大将军领三千兵为卫；凯欲因此兵以图之，令选曹白用丁奉。皓偶不欲，曰：‘更选。’凯令执据：‘虽暂兼，然宜得其人。’皓曰：‘用留平","attribution":"裴注·《吴录》","section_title":"潘濬陆凯传第十六","source":{"file":"OEBPS/Text/titlepage_0129.xhtml","index":157,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-34c1b7061cd32124db22","start":10,"end":79,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-296f551772590b86078d","section":"chapter-048","block":"b-f8f66aaddf4db29220ba","layer":"original","quote":"将军留平，别诣施绩于南郡〖5〗，议兵所向","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":269,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":54,"end":74,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-55ec39ef43aae33fb99e","section":"chapter-048","block":"b-2e7ee8228e9ed5b707d7","layer":"pei","quote":"初，皓游华里，彧与丁奉、留平密谋曰：‘此行不急，若至华里不归；社稷事重，不得不自还。’此语颇泄。皓闻知，以彧等旧臣，且以计忍，而阴衔之","attribution":"裴注·江表传","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":450,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-3fb07fda1bf01077fbb2","start":11,"end":78,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-5776bdc18959bf237a97","section":"chapter-048","block":"b-2e7ee8228e9ed5b707d7","layer":"pei","quote":"平忧懑，月余亦死","attribution":"裴注·江表传","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":450,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-3fb07fda1bf01077fbb2","start":120,"end":128,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-7afd12882015e084317a","section":"chapter-048","block":"b-58fb185861c2591b0764","layer":"original","quote":"二月，镇军陆抗、抚军步协、征西将军留平，建平太守盛曼〖2〗，率众围蜀巴东守将罗宪","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":282,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":12,"end":52,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-7f9162718351abfba62e","section":"chapter-048","block":"b-f8f66aaddf4db29220ba","layer":"original","quote":"蜀主刘禅降魏问至〖7〗，然后罢","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":269,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":94,"end":109,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-c712dc8b558585c33a44","section":"chapter-048","block":"b-2e7ee8228e9ed5b707d7","layer":"pei","quote":"后因会，以毒酒饮彧；传酒人，私减之。又饮留平，平觉之；服他药以解，得不死。","attribution":"裴注·江表传","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":450,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-3fb07fda1bf01077fbb2","start":79,"end":116,"offset_unit":"unicode_code_point"},{"id":"wanglou-q-9d5abb6165d196b3ff71","section":"chapter-065","block":"b-e774f8c8af898e42f886","layer":"original","quote":"卫将军滕牧、征西将军留平请〖15〗，不能得。﹝一﹞丞相陆凯上疏曰〖16〗：“常侍王蕃，黄中通理〖17〗，知天知物，处朝忠謇〖18〗。斯社稷之重镇，大吴之龙逢也〖19〗。昔事景皇〖20〗，纳言左右〖21〗；景皇钦嘉，叹为异伦〖22〗。而陛下忿其苦辞〖23〗，恶其直对；枭之殿堂，尸骸暴弃；（郡）〔邦〕内伤心，有识悲悼！”其痛蕃如此。","section_title":"王楼贺韦华传第二十","source":{"file":"OEBPS/Text/titlepage_0137.xhtml","index":5,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":165,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
