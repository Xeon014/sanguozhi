{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"luxun-e-o073b","title":"陆抗分遣张咸孙遵留虑朱琬分御三路亲对杨肇","accounts":[{"id":"luxun-e-o073b-account","label":"《陆逊传第十三》正文","text":"陆抗分遣张咸孙遵留虑朱琬分御三路亲对杨肇","evidence":["luxun-e-o073b-q"]}],"participants":[{"person":"luxun-p0048","role":"部署","evidence":["luxun-e-o073b-q"]},{"person":"luxun-p0057","role":"守城","evidence":["luxun-e-o073b-q"]},{"person":"luxun-p0060","role":"御敌","evidence":["luxun-e-o073b-q"]},{"person":"luxun-p0061","role":"拒水军","evidence":["luxun-e-o073b-q"]},{"person":"luxun-p0062","role":"拒水军","evidence":["luxun-e-o073b-q"]}],"place":null,"time":{"label":"徐胤杨肇援西陵时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["luxun-e-o073b-q"]},"ordering_evidence":"luxun-e-o073b-q","source_order":[58,351,"O073b"],"order":10391}],"persons":[{"id":"luxun-p0062","name":"朱琬","evidence":["luxun-q-o073"],"facts":[],"aliases":[],"mentions":[{"id":"luxun-m-o073-luxun-p0062","kind":"mention","text":"文中提及","evidence":["luxun-q-o073"]}]}],"evidence":[{"id":"luxun-e-o073b-q","section":"chapter-058","block":"b-00c7d3403d867b106f10","layer":"original","quote":"抗令张咸固守其城；公安督孙遵巡南岸御祜〖13〗；水军督留虑、镇西将军朱琬拒胤；身率三军，凭围对肇。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":350,"anchor":null},"note_id":null,"start":28,"end":77},{"id":"luxun-q-o073","section":"chapter-058","block":"b-00c7d3403d867b106f10","layer":"original","quote":"晋巴东监军徐胤率水军诣建平〖12〗，荆州刺史杨肇至西陵。抗令张咸固守其城；公安督孙遵巡南岸御祜〖13〗；水军督留虑、镇西将军朱琬拒胤；身率三军，凭围对肇。将军朱乔、营都督俞赞，亡诣肇〖14〗。抗曰：“赞军中旧吏，知吾虚实者。吾常虑夷兵素不简练〖15〗，若敌攻围，必先此处！”即夜易夷（民）〔兵〕，皆以旧将充之。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":350,"anchor":null},"note_id":null,"start":0,"end":155}],"profiles":{},"directory_counts":{}}
