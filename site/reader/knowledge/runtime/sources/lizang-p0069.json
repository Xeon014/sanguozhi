{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"lizang-e-o217","title":"庞淯外祖父赵安为同县李寿所杀","accounts":[{"id":"lizang-a-3232db02443cad45b616","label":"正文","text":"庞淯外祖父赵安为同县李寿所杀","evidence":["lizang-q-8acaf198e1346562cddd"]},{"id":"lizang-a-837ae5db5c53dc65bd23","label":"正文","text":"赵娥自伤父仇不报，帏车袖剑白日刺李寿于都亭前，诣县请受戮","evidence":["lizang-q-3f56a23c92d1a2d022aa"]},{"id":"lizang-a-2db8d98f51b7c3cb30f6","label":"正文","text":"禄福长尹嘉解印绶纵娥，娥不肯去，遂强载还家","evidence":["lizang-q-d7ccab4fcb4f6874367f"]},{"id":"lizang-a-b059f597ae43dc3e7eaa","label":"正文","text":"赵娥会赦得免","evidence":["lizang-q-fc2c7ca5b491eb7c8e9e"]},{"id":"lizang-a-fb3a2f905f4d20466df6","label":"正文","text":"州郡叹贵赵娥，刊石表闾","evidence":["lizang-q-220b1000ee0211e28a67"]},{"id":"lizang-a-13c57d3a32bd1e982aba","label":"裴注·皇甫谧《列女传》","text":"《列女传》：赵君安为同县李寿所杀","evidence":["lizang-q-cbd18f4c53093e6ab527"]},{"id":"lizang-a-1d5fc35f2c762eab9d1b","label":"裴注·皇甫谧《列女传》","text":"《列女传》：光和二年二月上旬娥亲于都亭前遇寿，奋刀斫伤其马；寿挤沟中，娥亲就地斫之折刀，挺身抵额椿喉应手而倒，遂拔刀截寿头","evidence":["lizang-q-73ec8306b8b6bd4c4b4e"]},{"id":"lizang-a-a1c04538bafcfb5083f1","label":"裴注·皇甫谧《列女传》","text":"《列女传》：娥亲持寿头诣都亭归罪有司，徐步诣狱辞颜不变","evidence":["lizang-q-690a517f171f1db15dbe"]},{"id":"lizang-a-72bb153889909e8a8e7c","label":"裴注·皇甫谧《列女传》","text":"《列女传》：禄福长汉阳尹嘉不忍论娥亲，解印绶去官弛法纵之；娥亲辞不敢枉官法","evidence":["lizang-q-27cb5c0de496e7bc6a86"]},{"id":"lizang-a-9782ac213e91fcdb4bd3","label":"裴注·皇甫谧《列女传》","text":"《列女传》：守尉阴语使去，娥亲抗声乞归法就戮，面无惧色；尉强载还家","evidence":["lizang-q-edf9a971a59c2bd80bb2"]},{"id":"lizang-a-e6f9c1c1e9bace3008be","label":"裴注·皇甫谧《列女传》","text":"《列女传》：凉州刺史周洪、酒泉太守刘班等表上称娥亲烈义，刊石立碑显其门闾","evidence":["lizang-q-faf89bbf9f81e97f4313"]}],"participants":[{"person":"lizang-p0036","role":"杀赵安；被刺杀；杀赵君安；被杀","evidence":["lizang-q-8acaf198e1346562cddd","lizang-q-3f56a23c92d1a2d022aa","lizang-q-cbd18f4c53093e6ab527","lizang-q-73ec8306b8b6bd4c4b4e"]},{"person":"lizang-p0070","role":"被杀；所报之父仇","evidence":["lizang-q-8acaf198e1346562cddd","lizang-q-3f56a23c92d1a2d022aa","lizang-q-cbd18f4c53093e6ab527"]},{"person":"liusima-p0024","role":"赵安之外孙","evidence":["lizang-q-8acaf198e1346562cddd"]},{"person":"lizang-p0069","role":"刺寿自首请戮；不肯去被载还；会赦得免；受州郡刊石表闾；君安之女；格斗截杀李寿；自首诣狱；辞谢枉法之纵；乞归法后强被载还；被表称刊石立碑","evidence":["lizang-q-3f56a23c92d1a2d022aa","lizang-q-d7ccab4fcb4f6874367f","lizang-q-fc2c7ca5b491eb7c8e9e","lizang-q-220b1000ee0211e28a67","lizang-q-cbd18f4c53093e6ab527","lizang-q-73ec8306b8b6bd4c4b4e","lizang-q-690a517f171f1db15dbe","lizang-q-27cb5c0de496e7bc6a86","lizang-q-edf9a971a59c2bd80bb2","lizang-q-faf89bbf9f81e97f4313"]},{"person":"lizang-p0015","role":"解印绶纵娥强载还家；解印绶去官弛法纵之","evidence":["lizang-q-d7ccab4fcb4f6874367f","lizang-q-27cb5c0de496e7bc6a86"]},{"person":"lizang-p0010","role":"表上称烈义","evidence":["lizang-q-faf89bbf9f81e97f4313"]},{"person":"lizang-p0004","role":"表上称烈义","evidence":["lizang-q-faf89bbf9f81e97f4313"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["lizang-q-8acaf198e1346562cddd","lizang-q-3f56a23c92d1a2d022aa","lizang-q-d7ccab4fcb4f6874367f","lizang-q-fc2c7ca5b491eb7c8e9e","lizang-q-220b1000ee0211e28a67","lizang-q-cbd18f4c53093e6ab527","lizang-q-73ec8306b8b6bd4c4b4e","lizang-q-690a517f171f1db15dbe","lizang-q-27cb5c0de496e7bc6a86","lizang-q-edf9a971a59c2bd80bb2","lizang-q-faf89bbf9f81e97f4313"]},"ordering_evidence":"lizang-q-8acaf198e1346562cddd","source_order":[18,227,2],"order":3702},{"id":"lizang-e-o259","title":"《列女传》：娥亲男弟三人欲报仇，会遭灾疫皆死；寿闻大喜庆贺，谓赵氏强壮已尽唯余女弱，防备懈弛","accounts":[{"id":"lizang-a-64656d4ddb47af0db895","label":"裴注·皇甫谧《列女传》","text":"《列女传》：娥亲男弟三人欲报仇，会遭灾疫皆死；寿闻大喜庆贺，谓赵氏强壮已尽唯余女弱，防备懈弛","evidence":["lizang-q-46717759a070b83a25ca"]},{"id":"lizang-a-5180c002f2cf03acf173","label":"裴注·皇甫谧《列女传》","text":"《列女传》：娥亲子淯出行闻寿言，还以启娥亲","evidence":["lizang-q-d3ade48f87367b2b63e5"]},{"id":"lizang-a-d42144f09056d46178b7","label":"裴注·皇甫谧《列女传》","text":"《列女传》：娥亲闻言感激愈深，誓终不活李寿，阴市名刀昼夜志在杀寿","evidence":["lizang-q-af778785b3b5523f3a18"]},{"id":"lizang-a-7e4d6cc061cb3cfef7a8","label":"裴注·皇甫谧《列女传》","text":"《列女传》：寿为人凶豪，闻娥亲之言更乘马带刀，乡人皆畏惮之","evidence":["lizang-q-58c8aacd8d19c8eacc71"]},{"id":"lizang-a-be796e699df82d77b068","label":"裴注·皇甫谧《列女传》","text":"《列女传》：比邻徐氏妇每谏止娥亲，娥亲答以父母之仇不共天地、寿必为己所杀","evidence":["lizang-q-6cce93b24f92e1442961"]},{"id":"lizang-a-b273213f50cbd916b823","label":"裴注·皇甫谧《列女传》","text":"《列女传》：娥亲夜数磨砺所持刀，谓要以寿颈血污刃，遂弃家事乘鹿车伺寿","evidence":["lizang-q-40c81dd636e138550969"]}],"participants":[{"person":"lizang-p0036","role":"闻喜庆贺防备懈弛；所誓杀者；乘马带刀自卫","evidence":["lizang-q-46717759a070b83a25ca","lizang-q-af778785b3b5523f3a18","lizang-q-58c8aacd8d19c8eacc71"]},{"person":"liusima-p0024","role":"闻寿言还以启母","evidence":["lizang-q-d3ade48f87367b2b63e5"]},{"person":"lizang-p0069","role":"所启之母；誓报仇阴市名刀；拒谏明志；磨刀伺寿","evidence":["lizang-q-d3ade48f87367b2b63e5","lizang-q-af778785b3b5523f3a18","lizang-q-6cce93b24f92e1442961","lizang-q-40c81dd636e138550969"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["lizang-q-46717759a070b83a25ca","lizang-q-d3ade48f87367b2b63e5","lizang-q-af778785b3b5523f3a18","lizang-q-58c8aacd8d19c8eacc71","lizang-q-6cce93b24f92e1442961","lizang-q-40c81dd636e138550969"]},"ordering_evidence":"lizang-q-46717759a070b83a25ca","source_order":[18,248,50],"order":3706},{"id":"lizang-e-o260","title":"《列女传》：太常弘农张奂贵尚所履，以束帛二十端礼娥亲","accounts":[{"id":"lizang-a-a8750199ee55cbd29e5a","label":"裴注·皇甫谧《列女传》","text":"《列女传》：太常弘农张奂贵尚所履，以束帛二十端礼娥亲","evidence":["lizang-q-c639bfa4086f8cc965c6"]}],"participants":[{"person":"wudi-p0022","role":"以束帛礼娥亲","evidence":["lizang-q-c639bfa4086f8cc965c6"]},{"person":"lizang-p0069","role":"受礼遇","evidence":["lizang-q-c639bfa4086f8cc965c6"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["lizang-q-c639bfa4086f8cc965c6"]},"ordering_evidence":"lizang-q-c639bfa4086f8cc965c6","source_order":[18,248,1005],"order":3707},{"id":"lizang-e-o261","title":"《列女传》：故黄门侍郎安定梁宽追述娥亲，为其作传","accounts":[{"id":"lizang-a-6f1ce85472e04dbfa96b","label":"裴注·皇甫谧《列女传》","text":"《列女传》：故黄门侍郎安定梁宽追述娥亲，为其作传","evidence":["lizang-q-5c0a1e6833193072add6"]}],"participants":[{"person":"lizang-p0052","role":"为娥亲作传","evidence":["lizang-q-5c0a1e6833193072add6"]},{"person":"lizang-p0069","role":"传主","evidence":["lizang-q-5c0a1e6833193072add6"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["lizang-q-5c0a1e6833193072add6"]},"ordering_evidence":"lizang-q-5c0a1e6833193072add6","source_order":[18,248,1045],"order":3708}],"persons":[{"id":"lizang-p0069","name":"赵娥","evidence":["lizang-q-3f56a23c92d1a2d022aa","lizang-q-d7ccab4fcb4f6874367f","lizang-q-fc2c7ca5b491eb7c8e9e","lizang-q-220b1000ee0211e28a67","lizang-q-cbd18f4c53093e6ab527","lizang-q-d3ade48f87367b2b63e5","lizang-q-af778785b3b5523f3a18","lizang-q-6cce93b24f92e1442961","lizang-q-40c81dd636e138550969","lizang-q-73ec8306b8b6bd4c4b4e","lizang-q-690a517f171f1db15dbe","lizang-q-27cb5c0de496e7bc6a86","lizang-q-edf9a971a59c2bd80bb2","lizang-q-faf89bbf9f81e97f4313","lizang-q-c639bfa4086f8cc965c6","lizang-q-5c0a1e6833193072add6"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[{"id":"lizang-q-220b1000ee0211e28a67","section":"chapter-018","block":"b-4c6be2f7890f71e92c47","layer":"original","quote":"州郡叹贵，刊石表闾","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":226,"anchor":null},"note_id":null,"start":127,"end":136},{"id":"lizang-q-27cb5c0de496e7bc6a86","section":"chapter-018","block":"b-8b0b8ca8696a583b4afa","layer":"pei","quote":"时禄福长汉阳尹嘉不忍论娥亲；即解印绶去官，弛法纵之。娥亲曰：‘仇塞身死，妾之明分也。治狱制刑，君之常典也。何敢贪生，以枉官法","attribution":"裴注·皇甫谧《列女传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":247,"anchor":null},"note_id":"n-c73b2ef4a752cbb49de9","start":711,"end":773},{"id":"lizang-q-3f56a23c92d1a2d022aa","section":"chapter-018","block":"b-4c6be2f7890f71e92c47","layer":"original","quote":"自伤父仇不报，乃帏车袖剑〖12〗，白日刺寿于都亭前〖13〗；讫，徐诣县〖14〗，颜色不变。曰：“父仇已报，请受戮","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":226,"anchor":null},"note_id":null,"start":37,"end":93},{"id":"lizang-q-40c81dd636e138550969","section":"chapter-018","block":"b-8b0b8ca8696a583b4afa","layer":"pei","quote":"夜数磨砺所持刀，讫，扼腕切齿，悲涕长叹。家人及邻里咸共笑之。娥亲谓左右曰：‘卿等笑我，直以我女弱不能杀寿故也。要当以寿颈血，污此刀刃，令汝辈见之！’遂弃家事，乘鹿车伺寿","attribution":"裴注·皇甫谧《列女传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":247,"anchor":null},"note_id":"n-c73b2ef4a752cbb49de9","start":448,"end":532},{"id":"lizang-q-46717759a070b83a25ca","section":"chapter-018","block":"b-8b0b8ca8696a583b4afa","layer":"pei","quote":"娥亲有男弟三人，皆欲报仇，寿深以为备。会遭灾疫，三人皆死。寿闻大喜，请会宗族，共相庆贺。云：‘赵氏强壮已尽，唯有女弱。何足复忧！’防备懈弛","attribution":"裴注·皇甫谧《列女传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":247,"anchor":null},"note_id":"n-c73b2ef4a752cbb49de9","start":50,"end":119},{"id":"lizang-q-58c8aacd8d19c8eacc71","section":"chapter-018","block":"b-8b0b8ca8696a583b4afa","layer":"pei","quote":"寿为人凶豪，闻娥亲之言，更乘马带刀，乡人皆畏惮之","attribution":"裴注·皇甫谧《列女传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":247,"anchor":null},"note_id":"n-c73b2ef4a752cbb49de9","start":233,"end":257},{"id":"lizang-q-5c0a1e6833193072add6","section":"chapter-018","block":"b-8b0b8ca8696a583b4afa","layer":"pei","quote":"故黄门侍郎安定梁宽，追述娥亲，为其作传","attribution":"裴注·皇甫谧《列女传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":247,"anchor":null},"note_id":"n-c73b2ef4a752cbb49de9","start":1045,"end":1064},{"id":"lizang-q-690a517f171f1db15dbe","section":"chapter-018","block":"b-8b0b8ca8696a583b4afa","layer":"pei","quote":"持诣都亭，归罪有司，徐步诣狱，辞颜不变","attribution":"裴注·皇甫谧《列女传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":247,"anchor":null},"note_id":"n-c73b2ef4a752cbb49de9","start":691,"end":710},{"id":"lizang-q-6cce93b24f92e1442961","section":"chapter-018","block":"b-8b0b8ca8696a583b4afa","layer":"pei","quote":"比邻有徐氏妇，忧娥亲不能制，恐逆见中害，每谏止之，曰：‘李寿，男子也。凶恶有素，加今备卫在身。赵虽有猛烈之志，而强弱不敌。邂逅不制，则为重受祸于寿；绝灭门户，痛辱不轻也。愿详举动，为门户之计。’娥亲曰：“父母之仇，不同天地共日月者也！李寿不死，娥亲视息世间，活复何求！今虽三弟早死，门户泯绝；而娥亲犹在，岂可假手于人哉！若以卿心况我，则李寿不可得杀；论我之心，寿必为我所杀明矣","attribution":"裴注·皇甫谧《列女传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":247,"anchor":null},"note_id":"n-c73b2ef4a752cbb49de9","start":258,"end":446},{"id":"lizang-q-73ec8306b8b6bd4c4b4e","section":"chapter-018","block":"b-8b0b8ca8696a583b4afa","layer":"pei","quote":"至光和二年二月上旬，以白日清时，于都亭之前，与寿相遇；便下车扣寿马，叱之。寿惊愕，回马欲走。娥亲奋刀斫之，并伤其马。马惊，寿挤道边沟中。娥亲寻复就地斫之，探中树兰，折所持刀。寿被创，未死，娥亲因前欲取寿所佩刀杀寿；寿护刀，瞋目大呼，跳梁而起。娥亲乃挺身奋手，左抵其额，右椿其喉，反覆盘旋，应手而倒。遂拔其刀以截寿头","attribution":"裴注·皇甫谧《列女传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":247,"anchor":null},"note_id":"n-c73b2ef4a752cbb49de9","start":533,"end":690},{"id":"lizang-q-8acaf198e1346562cddd","section":"chapter-018","block":"b-4c6be2f7890f71e92c47","layer":"original","quote":"淯外祖父赵安，为同县李寿所杀","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":226,"anchor":null},"note_id":null,"start":2,"end":16},{"id":"lizang-q-af778785b3b5523f3a18","section":"chapter-018","block":"b-8b0b8ca8696a583b4afa","layer":"pei","quote":"娥亲既素有报仇之心，及闻寿言，感激愈深。怆然陨涕曰：‘李寿，汝莫喜也，终不活汝！戴履天地，为吾门户，吾三子之羞也。焉知娥亲不手刃杀汝，而自侥幸邪！’阴市名刀，挟长持短；昼夜哀酸，志在杀寿","attribution":"裴注·皇甫谧《列女传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":247,"anchor":null},"note_id":"n-c73b2ef4a752cbb49de9","start":139,"end":232},{"id":"lizang-q-c639bfa4086f8cc965c6","section":"chapter-018","block":"b-8b0b8ca8696a583b4afa","layer":"pei","quote":"太常弘农张奂，贵尚所履，以束帛二十端，礼之","attribution":"裴注·皇甫谧《列女传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":247,"anchor":null},"note_id":"n-c73b2ef4a752cbb49de9","start":1005,"end":1026},{"id":"lizang-q-cbd18f4c53093e6ab527","section":"chapter-018","block":"b-8b0b8ca8696a583b4afa","layer":"pei","quote":"君安为同县李寿所杀","attribution":"裴注·皇甫谧《列女传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":247,"anchor":null},"note_id":"n-c73b2ef4a752cbb49de9","start":40,"end":49},{"id":"lizang-q-d3ade48f87367b2b63e5","section":"chapter-018","block":"b-8b0b8ca8696a583b4afa","layer":"pei","quote":"娥亲子淯，出行，闻寿此言，还以启娥亲","attribution":"裴注·皇甫谧《列女传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":247,"anchor":null},"note_id":"n-c73b2ef4a752cbb49de9","start":120,"end":138},{"id":"lizang-q-d7ccab4fcb4f6874367f","section":"chapter-018","block":"b-4c6be2f7890f71e92c47","layer":"original","quote":"禄福长尹嘉，解印绶纵娥〖15〗；娥不肯去，遂强载还家","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":226,"anchor":null},"note_id":null,"start":95,"end":121},{"id":"lizang-q-edf9a971a59c2bd80bb2","section":"chapter-018","block":"b-8b0b8ca8696a583b4afa","layer":"pei","quote":"守尉不敢公纵，阴语使去，以便宜自匿。娥亲抗声大言曰：‘枉法逃死，非妾本心。今仇人已雪，死则妾分；乞得归法，以全国体。虽复万死，于娥亲毕足，不敢贪生为明廷负也！’尉故不听所执，娥亲复言曰：‘匹妇虽微，犹知宪制。杀人之罪，法所不纵。今既犯之，义无可逃。乞就刑戮，陨身朝市。肃明王法，娥亲之愿也！’辞气愈厉，面无惧色。尉知其难夺，强载还家","attribution":"裴注·皇甫谧《列女传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":247,"anchor":null},"note_id":"n-c73b2ef4a752cbb49de9","start":803,"end":969},{"id":"lizang-q-faf89bbf9f81e97f4313","section":"chapter-018","block":"b-8b0b8ca8696a583b4afa","layer":"pei","quote":"凉州刺史周洪、酒泉太守刘班等，并共表上，称其烈义；刊石立碑，显其门闾","attribution":"裴注·皇甫谧《列女传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":247,"anchor":null},"note_id":"n-c73b2ef4a752cbb49de9","start":970,"end":1004},{"id":"lizang-q-fc2c7ca5b491eb7c8e9e","section":"chapter-018","block":"b-4c6be2f7890f71e92c47","layer":"original","quote":"会赦得免","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":226,"anchor":null},"note_id":null,"start":122,"end":126}],"profiles":{},"directory_counts":{}}
