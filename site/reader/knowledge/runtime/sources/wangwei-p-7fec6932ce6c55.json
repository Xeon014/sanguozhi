tlepage_0048.xhtml","index":558,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":136,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-6044d35fbb52e45944ca","section":"chapter-021","block":"b-7f69f5f015b818e1e7d7","layer":"pei","quote":"﹝三﹞《典论》曰：“今之文人：鲁国孔融，广陵陈琳，山阳王粲，北海徐幹，陈留阮瑀，汝南应玚，东平刘桢。斯七子者，于学无所遗，于辞无所假；咸自以骋骐骥于千里，仰齐足而并驰。粲长于辞赋。幹时有逸气，然非粲匹也。如粲之《初征》、《登楼》、《槐赋》、《征思》，幹之《玄猨》、《漏卮》、《圆扇》、《橘赋》，虽张、蔡不过也；然于他文未能称是。琳、瑀之章表书记，今之俊也。应玚和而不壮，刘桢壮而不密。孔融体气高妙，有过人者；然不能持论，理不胜辞，至于杂以嘲戏；及其所善，扬、班之俦也。”","attribution":"裴注引《典论》","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":126,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-e44ff8b8254edc395f28","start":0,"end":235,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-6a4f635c9fc3733daf28","section":"chapter-021","block":"b-ac0f83bf878f3223fcbe","layer":"pei","quote":"后除上艾长，又以疾不行","attribution":"裴注·先贤行状","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":89,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6cda802ff9befeb2d22b","start":59,"end":70,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-8243a07df208763a2f0c","section":"chapter-021","block":"b-00796707525917e80bff","layer":"original","quote":"幹、琳、玚、桢二十二年卒","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":95,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":10,"end":22,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-846989baa32fb389edf4","section":"chapter-021","block":"b-ac0f83bf878f3223fcbe","layer":"pei","quote":"建安中，太祖特加旌命，以疾休息","attribution":"裴注·先贤行状","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":89,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6cda802ff9befeb2d22b","start":43,"end":58,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-b043a0fb4cd2090d01bc","section":"chapter-021","block":"b-2e025778458cccd8f2ba","layer":"original","quote":"始，文帝为五官将〖1〗，及平原侯植〖2〗，皆好文学。粲与北海徐幹字伟长、广陵陈琳字孔璋、陈留阮瑀字元瑜、汝南应玚字德琏、东平刘桢字公幹〖3〗，并见友善。﹝一﹞","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":61,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":79,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
