0],"order":2727}],"persons":[{"id":"cuimao-p0036","name":"张俭（山阳）","evidence":["cuimao-q-dd76614ae9fdbc3c5170","cuimao-q-66d72580bf23c8574bda","cuimao-q-aa032f6ab5e2df34cb81"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[{"id":"cuimao-q-66d72580bf23c8574bda","section":"chapter-012","block":"b-71af50ed5989381e6496","layer":"pei","quote":"俭与融兄裦，有旧，亡投裦，遇裦出。时融年十（六）〔七〕，俭以其少，不告也。融知俭长者，有窘迫色，谓曰：‘吾独不能为君主邪！’因留舍，藏之","attribution":"裴注·《续汉书》","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":95,"anchor":null},"note_id":"n-0ed74dd0dffffddb82dc","start":300,"end":368},{"id":"cuimao-q-a4edb2cb70c4cedcdb21","section":"chapter-012","block":"b-71af50ed5989381e6496","layer":"pei","quote":"保纳藏舍者，融也；融当坐之。’裦曰：‘彼来求我，罪我之由，非弟之过；我当坐之。’兄弟争死，郡县疑不能决；乃上谳，诏书令裦坐焉","attribution":"裴注·《续汉书》","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":95,"anchor":null},"note_id":"n-0ed74dd0dffffddb82dc","start":402,"end":464},{"id":"cuimao-q-aa032f6ab5e2df34cb81","section":"chapter-012","block":"b-71af50ed5989381e6496","layer":"pei","quote":"后事泄，国相以下，密就掩捕；俭得脱走，登时收融及裦，送狱","attribution":"裴注·《续汉书》","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":95,"anchor":null},"note_id":"n-0ed74dd0dffffddb82dc","start":369,"end":397},{"id":"cuimao-q-dd76614ae9fdbc3c5170","section":"chapter-012","block":"b-71af50ed5989381e6496","layer":"pei","quote":"山阳张俭，以中正，为中常侍侯览所忿疾，览为刊章下州郡：捕俭","attribution":"裴注·《续汉书》","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":95,"anchor":null},"note_id":"n-0ed74dd0dffffddb82dc","start":270,"end":299}],"profiles":{},"directory_counts":{}}
