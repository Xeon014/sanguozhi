{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o009a","title":"诸军起兵推袁绍为盟主","accounts":[{"id":"wudi-e-o009a-account","label":"正文","text":"袁术、韩馥等同时起兵，各有数万众，共推袁绍为盟主；曹操行奋武将军。","evidence":["wudi-e-o009a-q"]},{"id":"dongyuan-e-o036a-account","label":"《董二袁刘传第六》正文","text":"袁绍勃海起兵讨董卓","evidence":["dongyuan-e-o036a-q"]}],"participants":[{"person":"wudi-p0057","role":"起兵","evidence":["wudi-e-o009a-q"]},{"person":"wudi-p0058","role":"起兵","evidence":["wudi-e-o009a-q"]},{"person":"wudi-p0059","role":"起兵","evidence":["wudi-e-o009a-q"]},{"person":"wudi-p0060","role":"起兵","evidence":["wudi-e-o009a-q"]},{"person":"wudi-p0061","role":"起兵","evidence":["wudi-e-o009a-q"]},{"person":"wudi-p0052","role":"受推盟主","evidence":["wudi-e-o009a-q"]},{"person":"wudi-p0062","role":"起兵","evidence":["wudi-e-o009a-q"]},{"person":"wudi-p0063","role":"起兵","evidence":["wudi-e-o009a-q"]},{"person":"wudi-p0064","role":"起兵","evidence":["wudi-e-o009a-q"]},{"person":"wudi-p0065","role":"起兵","evidence":["wudi-e-o009a-q"]},{"person":"cao-cao","role":"行奋武将军","evidence":["wudi-e-o009a-q"]}],"place":null,"time":{"label":"初平元年春正月","year":190,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o009a-q","wudi-q-o009","wudi-q-b-4a17eb75600ced2abdde"],"chronology":"wudi-y190","dating_review":{"anchor":"wudi-q-o009","basis":"初平元年春正月","reviewed":true}},"source_order":[1,85,"O009a"],"related_events":[{"event":"rensu-e2-wei016-062","type":"related","evidence":["rensu-q-f64cf1a8c7978e162aed","wudi-e-o009a-q"]}],"order":49},{"id":"wudi-e-p025a","title":"王匡募弩兵赴京又归乡","accounts":[{"id":"wudi-e-p025a-account","label":"《英雄记》","text":"王匡受辟何进府，在徐州募强弩五百赴京；何进败后归乡，后任河内太守。","evidence":["wudi-e-p025a-q"]}],"participants":[{"person":"wudi-p0061","role":"募兵任官","evidence":["wudi-e-p025a-q"]},{"person":"wudi-p0051","role":"辟用","evidence":["wudi-e-p025a-q"]}],"place":{"text":"徐州、京师、河内","evidence":["wudi-e-p025a-q"]},"time":{"label":"原文未明示时间