ence":["liusima-q-037b7315ddb88169745e"]},{"id":"liusima-a-68feef8b5164ebebd4b8","label":"正文","text":"帝诏褒张既破胡之功，徙封西乡侯增邑二百","evidence":["liusima-q-2aa5898655c68d54735f"]}],"participants":[{"person":"liusima-p0002","role":"卢水胡，与治元多等反，河西大扰","evidence":["liusima-q-fa191a1adbe752162bb3"]},{"person":"wudi-p0170","role":"忧之，称非既莫能安凉州，乃召邹岐，以既代之；诏既引贾复请击郾贼故事，称卿谋略过人今则其时，以便宜从事，勿复先请；遣护军夏侯儒、将军费曜等继既后；甚悦，诏褒既逾河历险、以劳击逸、以寡胜众，功过南仲勤逾吉甫，此勋永宁河右，徙封西乡侯","evidence":["liusima-q-5b9878e0b144a9ab2c8f","liusima-q-78bda4e0e8487c740adb","liusima-q-99f08230202561e54ef1","liusima-q-2aa5898655c68d54735f"]},{"person":"wgc-p0068","role":"代邹岐统军，显美设伏破胡","evidence":["liusima-q-5b9878e0b144a9ab2c8f","liusima-q-78bda4e0e8487c740adb","liusima-q-91ba5079ad5d62bbedba","liusima-q-295900b8d301562b62b8","liusima-q-fb796c6c073763573d28","liusima-q-e02513496e51b61f3ac8","liusima-q-037b7315ddb88169745e","liusima-q-2aa5898655c68d54735f"]},{"person":"liusima-p0062","role":"被召还","evidence":["liusima-q-5b9878e0b144a9ab2c8f"]},{"person":"xiahoucao-p0025","role":"护军，受遣继既后；等犹未达","evidence":["liusima-q-99f08230202561e54ef1","liusima-q-fb796c6c073763573d28"]},{"person":"mingdi-p0012","role":"将军，受遣继既后；继至武威","evidence":["liusima-q-99f08230202561e54ef1","liusima-q-fb796c6c073763573d28"]},{"person":"liusima-p0032","role":"参军，督千余骑挑战佯退","evidence":["liusima-q-037b7315ddb88169745e"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本篇独立行动，未继承范围不同的旧事件日期。","evidence":["liusima-q-fa191a1adbe752162bb3","liusima-q-5b9878e0b144a9ab2c8f","liusima-q-78bda4e0e8487c740adb","liusima-q-99f08230202561e54ef1","liusima-q-91ba5079ad5d62bbedba","liusima-q-295900b8d301562b62b8","liusima-q-fb796c6c073763573d28","liusima-q-e02513496e51b61f3ac8","liusima-q-037b7315ddb88169745e","liusima-q-2aa5898655c68d54735f"]},"ordering_evidence":"liusima-q-fa191a1adbe752162bb3","related_events":[{"event":"wendi-e-p080a","type":"related","evidence":["liusima-q-fa191a1adbe752162bb3","liusima-q-5b9878e0b144a9ab2c8f","liusima-q-78bda4e0e8487c740adb","l