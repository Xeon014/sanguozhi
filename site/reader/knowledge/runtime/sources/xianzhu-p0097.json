29,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":25,"offset_unit":"unicode_code_point"},{"id":"huowang-q-32a3ba5740c932e72af4","section":"chapter-041","block":"b-125769210f4b7485b3a4","layer":"original","quote":"裔流放在吴，洪临裔郡〖16〗，裔子郁给郡吏〖17〗；微过受罚，不特原假","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":125,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":9,"end":44,"offset_unit":"unicode_code_point"},{"id":"huowang-q-723bcf23a1cbdd5d3b1f","section":"chapter-041","block":"b-a4fa1eecb622b2ecaabd","layer":"original","quote":"洪对曰：“裔天姿明察，长于治剧〖12〗，才诚堪之；然性不公平，恐不可专任〖13〗。不如留向朗，朗情伪差少〖14〗；裔随从目下〖15〗，效其器能：于事两善。","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":124,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":30,"end":107,"offset_unit":"unicode_code_point"},{"id":"huowang-q-8e4249faeeb7833f6099","section":"chapter-041","block":"b-f5d2aa43bc3afae2aab6","layer":"original","quote":"汉嘉太守黄元素为诸葛亮所不善，闻先主疾病，惧有后患；举郡反，烧临邛城。时亮东行省疾〖6〗，成都单虚，是以元益无所惮","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":121,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":29,"end":86,"offset_unit":"unicode_code_point"},{"id":"huowang-q-917e155c8a1eec7287e4","section":"chapter-041","block":"b-f5d2aa43bc3afae2aab6","layer":"original","quote":"顷之，转为益州治中从事","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":121,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":11,"offset_unit":"unicode_code_point"},{"id":"huowang-q-9630f7b77420e667e935","section":"chapter-041","block":"b-402b8dd12cfa86663358","layer":"pei","quote":"每朝会，祗次洪坐。嘲祗曰：‘君马何驶？’祗曰：‘故吏马不敢驶，但明府未著鞭耳！’众传之以为笑","attribution":"裴注·益部耆旧传•杂记","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":168,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c2ad504755adcbb9bb52","start":16,"end":62,"offset_unit":"unicode_code_point"},{"id":"huowang-q-98141cc19b3a2ca2814d","section":"chapter-041","block":"b-125769210f4b7485b3a4","layer":"original","quote":"裔后还，闻之，深以为恨，与洪情好有损","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":125,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":49,"end":67,"offset_unit":"unicode_code_point"},{"id":"huowang-q-9a01aacb130cbe0a3ed7","section":"chapter-041","block":"b-ba188e615ef3d5d004d3","layer":"original","quote":"洪建兴元年赐爵关内侯，复为蜀郡太守、忠节将军","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":123,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":22,"offset_unit":"unicode_code_point"},{"id":"huowang-q-a3d385c838eadbfc6c6e","section":"chapter-041","block":"b-ba188e615ef3d5d004d3","layer":"original","quote":"后为越骑校尉，领郡如故","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":123,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":27,"end":38,"offset_unit":"unicode_code_point"},{"id":"huowang-q-af1060d585bdd4c66289","section":"chapter-041","block":"b-9fdcbc190275cf56490e","layer":"original","quote":"洪迎门下书佐何祗〖34〗，有才策功干〖35〗，举郡吏，数年为广汉太守；时洪亦尚在蜀郡","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":129,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":30,"end":72,"offset_unit":"unicode_code_point"},{"id":"huowang-q-bc898be65c05628af967","section":"chapter-041","block":"b-a4fa1eecb622b2ecaabd","layer":"original","quote":"五年〖11〗，丞相亮北住汉中；欲用张裔为留府长史，问洪何如","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":124,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":29,"offset_unit":"unicode_code_point"},{"id":"huowang-q-cdfd9186cbf862987d5b","section":"chapter-041","block":"b-84496185788f03e98dc9","layer":"original","quote":"众议以为：“元若不能围成都，当由越嶲据南中。”洪曰：“元素性凶暴，无他恩信，何能办此？不过乘水东下，冀主上平安，面缚归死〖7〗；如其有异〖8〗，奔吴求活耳！","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":122,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":78,"offset_unit":"unicode_code_point"},{"id":"huowang-q-d60ccac802ec63f5c0b2","section":"chapter-041","block":"b-d3fd242e53f9b98b052f","layer":"original","quote":"先主定蜀，太守李严命为功曹","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":119,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":24,"end":37,"offset_unit":"unicode_code_point"},{"id":"huowang-q-d62dd174490cce3cbc87","section":"chapter-041","block":"b-d3fd242e53f9b98b052f","layer":"original","quote":"刘璋时历部诸郡","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":119,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":13,"end":20,"offset_unit":"unicode_code_point"},{"id":"huowang-q-dc25b070d0b3429d8342","section":"chapter-041","block":"b-b525a615bd948949749b","layer":"modern","quote":"〖11〗五年：建兴五年（公元 227）。","attribution":"现代注释","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":141,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a41a13365a948c5d7f03","start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"huowang-q-e1ed3a761d357320e233","section":"chapter-041","block":"b-f5d2aa43bc3afae2aab6","layer":"original","quote":"洪即启太子，遣其亲兵，使将军陈曶、郑绰讨元","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":121,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":87,"end":108,"offset_unit":"unicode_code_point"},{"id":"huowang-q-e64a0db7673086e285d3","section":"chapter-041","block":"b-bef14e1d6eec52645f4b","layer":"original","quote":"六年〖31〗，卒官","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":128,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":9,"offset_unit":"unicode_code_point"},{"id":"huowang-q-e816306f26dded3a3f4c","section":"chapter-041","block":"b-d3fd242e53f9b98b052f","layer":"original","quote":"严（欲）荐洪于州，为（蜀部）〔部蜀〕从事","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":119,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":65,"end":85,"offset_unit":"unicode_code_point"},{"id":"huowang-q-f324fdc0aa05d6550f63","section":"chapter-041","block":"b-541309042485a993c3bb","layer":"original","quote":"洪曰：“汉中则益州咽喉，存亡之机会；若无汉中则无蜀矣，此家门之祸也！方今之事，男子当战，女子当运，发兵何疑！","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":120,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":22,"end":76,"offset_unit":"unicode_code_point"},{"id":"huowang-q2-0252e419eed424e51196","section":"chapter-041","block":"b-a4fa1eecb622b2ecaabd","layer":"original","quote":"五年〖11〗，丞相亮北住汉中；欲用张裔为留府长史，问洪何如？洪对曰：“裔天姿明察，长于治剧〖12〗，才诚堪之；然性不公平，恐不可专任〖13〗。不如留向朗，朗情伪差少〖14〗；裔随从目下〖15〗，效其器能：于事两善。”","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":124,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":108,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o063a-q","section":"chapter-032","block":"b-98bb2c0b5125ea94653e","layer":"original","quote":"故议郎、阳泉〔亭〕侯刘豹，青衣侯向举，偏将军张裔、黄权，大司马属殷纯，益州别驾从事赵莋，治中从事杨洪，从事祭酒何宗，议曹从事杜琼，劝学从事张爽、尹默、谯周等上言〖5〗：“臣闻《河图》、《洛书》〖6〗，五经谶、纬〖7〗；孔子所甄〖8〗，验应自远〖9〗。谨案《洛书甄曜度》曰：‘赤三日德昌〖10〗，九世会备〖11〗，合为帝际。’《洛书宝号命》曰：‘天度帝道备称皇，以统握契〖12〗，百成不败。’《洛书录运期》曰：‘九侯七杰争，命民炊骸〖13〗，道路籍籍履人头〖14〗，谁使主者玄且来。’《孝经钩命决录》曰：‘帝三建九会备。’臣父群未亡时〖15〗，言西南数有黄气，直立数丈，见来积年〖16〗；时时有景云祥风〖17〗，从璇玑下来应之〖18〗：此为异瑞。又二十二年中〖19〗，数有气如旗，从西竟东，中天而行；《图》、《书》曰‘必有天子出其方〖20〗’。加是年太白、荧惑、填星〖21〗，常从岁星相追〖22〗。近汉初兴，五星从岁星聚〖23〗；岁星主义〖24〗，汉位在西，义之上方〖25〗：故汉法常以岁星候人主〖26〗，当有圣主起于此州，以致中兴。时许帝尚存〖27〗，故群下不敢漏言〖28〗。顷者荧惑复追岁星〖29〗，现在胃、昴、毕〖30〗；昴、毕为天纲〖31〗，《经》曰‘帝星处之，众邪消亡’。圣讳预睹〖32〗，推揆期验〖33〗；符合数至，若此非一。臣闻圣王先天而天不违〖34〗，后天而奉天时；故应际而生〖35〗，与神合契。愿大王应天顺民，速即洪业〖36〗，以宁海内。”","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":318,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":628,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o073b-q","section":"chapter-032","block":"b-4232898cf1bcba6ab843","layer":"original","quote":"三月，黄元进兵攻临邛县〖2〗。遣将军陈曶﹝一﹞讨元。元军败，顺流下江；为其亲兵所缚，生致成都，斩之。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":429,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":19,"end":69,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-b-c3a154cca1b5578eba4b","section":"chapter-032","block":"b-c3a154cca1b5578eba4b","layer":"modern","quote":"〖1〗三年：章武三年（公元 223）。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":435,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-51b38d25bb3f712211d0","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o063","section":"chapter-032","block":"b-98bb2c0b5125ea94653e","layer":"original","quote":"故议郎、阳泉〔亭〕侯刘豹，青衣侯向举，偏将军张裔、黄权，大司马属殷纯，益州别驾从事赵莋，治中从事杨洪，从事祭酒何宗，议曹从事杜琼，劝学从事张爽、尹默、谯周等上言〖5〗：“臣闻《河图》、《洛书》〖6〗，五经谶、纬〖7〗；孔子所甄〖8〗，验应自远〖9〗。谨案《洛书甄曜度》曰：‘赤三日德昌〖10〗，九世会备〖11〗，合为帝际。’《洛书宝号命》曰：‘天度帝道备称皇，以统握契〖12〗，百成不败。’《洛书录运期》曰：‘九侯七杰争，命民炊骸〖13〗，道路籍籍履人头〖14〗，谁使主者玄且来。’《孝经钩命决录》曰：‘帝三建九会备。’臣父群未亡时〖15〗，言西南数有黄气，直立数丈，见来积年〖16〗；时时有景云祥风〖17〗，从璇玑下来应之〖18〗：此为异瑞。又二十二年中〖19〗，数有气如旗，从西竟东，中天而行；《图》、《书》曰‘必有天子出其方〖20〗’。加是年太白、荧惑、填星〖21〗，常从岁星相追〖22〗。近汉初兴，五星从岁星聚〖23〗；岁星主义〖24〗，汉位在西，义之上方〖25〗：故汉法常以岁星候人主〖26〗，当有圣主起于此州，以致中兴。时许帝尚存〖27〗，故群下不敢漏言〖28〗。顷者荧惑复追岁星〖29〗，现在胃、昴、毕〖30〗；昴、毕为天纲〖31〗，《经》曰‘帝星处之，众邪消亡’。圣讳预睹〖32〗，推揆期验〖33〗；符合数至，若此非一。臣闻圣王先天而天不违〖34〗，后天而奉天时；故应际而生〖35〗，与神合契。愿大王应天顺民，速即洪业〖36〗，以宁海内。”","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":318,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":628,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o073","section":"chapter-032","block":"b-4232898cf1bcba6ab843","layer":"original","quote":"三年春二月〖1〗，丞相亮自成都到永安。三月，黄元进兵攻临邛县〖2〗。遣将军陈曶﹝一﹞讨元。元军败，顺流下江；为其亲兵所缚，生致成都，斩之。先主病笃，托孤于丞相亮〖3〗；尚书令李严为副。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":429,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":92,"offset_unit":"unicode_code_point"}],"profiles":{"xianzhu-p0097":{"fields":[],"directory":{"faction":"shu"}}},"directory_counts":{}}
