{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"shaodi-e-o184c","title":"张修成都传钟会反而死","accounts":[{"id":"shaodi-e-o184c-account","label":"《三少帝纪》正文","text":"张修成都传钟会反而死","evidence":["shaodi-e-o184c-q"]}],"participants":[{"person":"shaodi-p0159","role":"传警身死","evidence":["shaodi-e-o184c-q"]}],"place":null,"time":{"year":264,"label":"钟会乱时","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"shaodi-y264","dating_review":{"reviewed":true,"anchor":"shaodi-q-o171","basis":"钟会乱时"},"evidence":["shaodi-e-o184c-q","shaodi-q-o171","shaodi-q-o165","shaodi-q-b-ded6d700dc6f860d1670"]},"ordering_evidence":"shaodi-e-o184c-q","source_order":[4,927,"O184c"],"order":1313}],"persons":[{"id":"shaodi-p0159","name":"张修","evidence":["shaodi-q-o184"],"facts":[],"aliases":[],"mentions":[{"id":"shaodi-m-o184-shaodi-p0159","kind":"mention","text":"文中提及","evidence":["shaodi-q-o184"]}]}],"evidence":[{"id":"shaodi-e-o184c-q","section":"chapter-004","block":"b-1096c71775017a1a0d00","layer":"original","quote":"二年春二月，甲辰〖1〗，朐顗县获灵龟以献〖2〗，归之于相国府。庚戌〖3〗，以虎贲张修，昔于成都驰马至诸营，言钟会反逆，以至没身；赐修弟倚，爵关内侯。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":334,"anchor":null},"note_id":null,"start":0,"end":74},{"id":"shaodi-q-b-ded6d700dc6f860d1670","section":"chapter-004","block":"b-ded6d700dc6f860d1670","layer":"modern","quote":"〖1〗四年：景元四年（公元 263）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":201,"anchor":null},"note_id":"n-ef642248e44d01f3825d","start":0,"end":19},{"id":"shaodi-q-o165","section":"chapter-004","block":"b-b35fdf03685051716720","layer":"original","quote":"四年春二月〖1〗，复命大将军进位、爵赐，一如前诏。又固辞，乃止。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":194,"anchor":null},"note_id":null,"start":0,"end":32},{"id":"shaodi-q-o171","section":"chapter-004","block":"b-cef469d41ec5962b4e48","layer":"original","quote":"咸熙元年春正月，壬戌〖1〗，槛车征邓艾〖2〗。甲子〖3〗，行幸长安。壬申〖4〗，使使者以璧币祀华山〖5〗。是月，钟会反于蜀，为众所讨。邓艾亦见杀。二月，辛卯〖6〗，特赦诸在益土者。庚申〖7〗，葬明元郭后。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":220,"anchor":null},"note_id":null,"start":0,"end":102},{"id":"shaodi-q-o184","section":"chapter-004","block":"b-1096c71775017a1a0d00","layer":"original","quote":"二年春二月，甲辰〖1〗，朐顗县获灵龟以献〖2〗，归之于相国府。庚戌〖3〗，以虎贲张修，昔于成都驰马至诸营，言钟会反逆，以至没身；赐修弟倚，爵关内侯。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":334,"anchor":null},"note_id":null,"start":0,"end":74}],"profiles":{},"directory_counts":{}}
