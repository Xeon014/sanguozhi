accounts":[{"id":"zongshi-a-bb06e90cb1b3da63e088","label":"正文","text":"策立辅为庐陵太守，抚定属城，分置长吏","evidence":["zongshi-q-df0a499f97d619232d6f"]}],"participants":[{"person":"wudi-p0099","role":"立太守者","evidence":["zongshi-q-df0a499f97d619232d6f"]},{"person":"sunshi-p0051","role":"受立抚定者","evidence":["zongshi-q-df0a499f97d619232d6f"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["zongshi-q-df0a499f97d619232d6f"]},"ordering_evidence":"zongshi-q-df0a499f97d619232d6f","source_order":[51,136,99],"order":9184},{"id":"zongshi-e-o079","title":"辅遣使与曹公相闻，事觉，权幽系之","accounts":[{"id":"zongshi-a-578fdbb229f22bdcc8a6","label":"正文","text":"辅遣使与曹公相闻，事觉，权幽系之","evidence":["zongshi-q-499ebd8b5be184f94d5c"]},{"id":"zongshi-a-b787d69354080023fc51","label":"裴注·典略","text":"辅恐权不能保守江东，因权出行东冶，乃遣人赍书呼曹公；行人以告，权乃还，伪若不知，与张昭共见辅","evidence":["zongshi-q-a42a7ef556ddd95d3b71"]},{"id":"zongshi-a-9665b77b4fd08fe63f46","label":"裴注·典略","text":"权谓辅曰：兄厌乐邪？何为呼他人？辅云无是；权因投书与昭，昭示辅，辅惭无辞；乃悉斩辅亲近，分其部曲，徒辅置东","evidence":["zongshi-q-105c33b551eba397a664"]}],"participants":[{"person":"sunshi-p0051","role":"遣使通曹者；遣书通曹者；被处置者","evidence":["zongshi-q-499ebd8b5be184f94d5c","zongshi-q-a42a7ef556ddd95d3b71","zongshi-q-105c33b551eba397a664"]},{"person":"sun-quan","role":"幽系者；闻而伪不知者；质辅而处置者","evidence":["zongshi-q-499ebd8b5be184f94d5c","zongshi-q-a42a7ef556ddd95d3b71","zongshi-q-105c33b551eba397a664"]},{"person":"wendi-p0133","role":"同见者；示书者","evidence":["zongshi-q-a42a7ef556ddd95d3b71","zongshi-q-105c33b551eba397a664"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["zongshi-q-499ebd8b5be184f94d5c","zongshi-q-a42a7ef556ddd95d3b71","zongshi-q-105c33b551eba397a664"]},"ordering_evidence":"zongshi-q-499ebd8b5be184f94d5c","source_order":[51,137,15],"order":9185},{"id":"zongshi-e-o080","title":"辅数岁卒","accounts":[{"id":"zongshi-a-4af56e8c4a8e154c63b5","label":"正文","text":"辅数岁卒","evidence":["zongshi-q-184fb0dc4981666eef05"]}],"participants":[{"person":"sunshi-p0051","role":"卒者","evidence":["zongshi-q-184fb0dc4981666eef05"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["zongshi-q-184fb0dc4981666eef05"]},"ordering_evidence":"zongshi-q-184fb0dc4981666eef05","source_order":[51,138,0],"order":9186},{"id":"wufan-e-d7e5d8c23bf3ce81c172","title":"刘惇遭乱避地，客游庐陵，事孙辅","accounts":[{"id":"wufan-a-d7e5d8c23bf3ce81c172","label":"正文","text":"刘惇遭乱避地，客游庐陵，事孙辅","evidence":["wufan-q-aaa34965a01bb9902ccd"]}],"participants":[{"person":"wufan-p-68c6a8b7006d7d","role":"避地客游而事孙辅者","evidence":["wufan-q-aaa34965a01bb9902ccd"]},{"person":"sunshi-p0051","role":"所事之主","evidence":["wufan-q-aaa34965a01bb9902ccd"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["wufan-q-aaa34965a01bb9902ccd"]},"ordering_evidence":"wufan-q-aaa34965a01bb9902ccd","order":10878},{"id":"wufan-e-a34f434a9050ea455783","title":"孙辅异之，以刘惇为军师","accounts":[{"id":"wufan-a-a34f434a9050ea455783","label":"正文","text":"孙辅异之，以刘惇为军师","evidence":["wufan-q-a589ac9a55c31dc88fa4"]}],"participants":[{"person":"sunshi-p0051","role":"任以为军师者","evidence":["wufan-q-a589ac9a55c31dc88fa4"]},{"person":"wufan-p-68c6a8b7006d7d","role":"受任军师者","evidence":["wufan-q-a589ac9a55c31dc88fa4"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["wufan-q-a589ac9a55c31dc88fa4"]},"ordering_evidence":"wufan-q-a589ac9a55c31dc88fa4","order":10879}],"persons":[{"id":"sunshi-p0051","name":"孙辅","evidence":["sunshi-q-o031","sunshi-q-b-320274d50e02fb532ac8","zongshi-q-c9b0d15d22a6f29980c5","zongshi-q-88e897b3e6bf4a44a7c2","zongshi-q-4b8c9b990f613cc7a4ec","zongshi-q-37a154c79119d5b6f2d9","zongshi-q-3a88a976131224511612","zongshi-q-df0a499f97d619232d6f","zongshi-q-499ebd8b5be184f94d5c","zongshi-q-184fb0dc4981666eef05","zongshi-q-f648cb4e0a24dd4799cb","zongshi-q-06ac05aacb5459935d1f","zongshi-q-b73b8d64e09c140affb2","zongshi-q-a42a7ef556ddd95d3b71","zongshi-q-105c33b551eba397a664","zongshi-q2-67d60afaade32286aeee","zongshi-q2-aa0d84929fdd1858eb6d","wufan-q-aaa34965a01bb9902ccd","wufan-q-a589ac9a55c31dc88fa4","yululu-q-5e683253b8a51089167c"],"facts":[{"id":"zongshi-f2-57b33f10e7ef48d7b7c1","text":"迁平南将军，假节，领交州刺史。","evidence":["zongshi-q2-67d60afaade32286aeee"]},{"id":"zongshi-f2-1a62b957acad6b1e5acf","text":"数岁卒；子兴、昭、伟、昕，皆历位。","evidence":["zongshi-q2-aa0d84929fdd1858eb6d"]}],"aliases":[],"mentions":[{"id":"sunshi-m-o031-sunshi-p0051","kind":"mention","text":"文中提及","evidence":["sunshi-q-o031","sunshi-q-b-320274d50e02fb532ac8"]},{"id":"sunshi-m-p046-sunshi-p0051","kind":"mention","text":"文中提及","evidence":["sunshi-q-p046"]},{"id":"yululu-m-59447c790f9ed001047c","kind":"mention","text":"本篇原文记及孙辅，具体行动与称谓见引文。","evidence":["yululu-q-5e683253b8a51089167c"]}]}],"evidence":[{"id":"sunshi-e-o031b-q","section":"chapter-046","block":"b-cdb6c814242d1c81716e","layer":"original","quote":"尽更置长吏。策自领会稽太守，复以吴景为丹杨太守，以孙贲为豫章太守〖14〗；分豫章为庐陵郡〖15〗，以贲弟辅为庐陵太守〖16〗；丹杨朱治〖17〗，为吴郡太守。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":215,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":36,"end":114,"offset_unit":"unicode_code_point"},{"id":"sunshi-e-p046f-q","section":"chapter-046","block":"b-0df888008b92c8896d19","layer":"pei","quote":"贲、辅又于彭泽破勋。勋走入楚江，从寻阳步上到置马亭；闻策等已克皖，乃投西塞。至沂，筑垒自守；告急于刘表，求救于黄祖。祖遣太子射、船军五千人，助勋。","attribution":"《江表传》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":257,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-344fcece1d1f127d763a","start":325,"end":398,"offset_unit":"unicode_code_point"},{"id":"sunshi-e-p046g-q","section":"chapter-046","block":"b-0df888008b92c8896d19","layer":"pei","quote":"策复就攻，大破勋。","attribution":"《江表传》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":257,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-344fcece1d1f127d763a","start":398,"end":407,"offset_unit":"unicode_code_point"},{"id":"sunshi-e-p046j-q","section":"chapter-046","block":"b-0df888008b92c8896d19","layer":"pei","quote":"闻勋轻身诣海昏，便分遣从兄贲、辅，率八千人，于彭泽待勋；","attribution":"《江表传》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":257,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-344fcece1d1f127d763a","start":227,"end":255,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-b-320274d50e02fb532ac8","section":"chapter-046","block":"b-320274d50e02fb532ac8","layer":"modern","quote":"〖16〗辅：即孙辅。传见本书卷五十一。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":234,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-3b0bb008458be7306985","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-o031","section":"chapter-046","block":"b-cdb6c814242d1c81716e","layer":"original","quote":"遂引兵渡浙江〖11〗，据会稽〖12〗，屠东冶〖13〗，乃攻破虎等。﹝四﹞尽更置长吏。策自领会稽太守，复以吴景为丹杨太守，以孙贲为豫章太守〖14〗；分豫章为庐陵郡〖15〗，以贲弟辅为庐陵太守〖16〗；丹杨朱治〖17〗，为吴郡太守。彭城张昭、广陵张纮、秦松、陈端等为谋主〖18〗。﹝五﹞","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":215,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":141,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-p046","section":"chapter-046","block":"b-0df888008b92c8896d19","layer":"pei","quote":"﹝八﹞《江表传》曰：“策被诏敕，与司空曹公、卫将军董承、益州牧刘璋等，并力讨袁术、刘表。军严当进，会术死。术从弟胤、女婿黄猗等，畏惧曹公，不敢守寿春；乃共舁术棺柩，扶其妻子及部曲男女，就刘勋于皖城。勋粮食少，无以相赈；乃遣从弟偕，告籴于豫章太守华歆。歆郡素少谷，遣吏将偕，就海昏、上缭，使诸宗帅共出三万斛米以与偕。偕往历月，才得数千斛。偕乃报勋，具说形状，使勋来袭取之。勋得偕书，使潜军到海昏邑下。宗帅知之，空壁逃匿，勋了无所得。时策西讨黄祖，行及石城。闻勋轻身诣海昏，便分遣从兄贲、辅，率八千人，于彭泽待勋；自与周瑜率二万人，步袭皖城，即克之，得术百工及鼓吹部曲三万余人，并术、勋妻子。表用汝南李术为庐江太守，给兵三千人以守皖；皆徙所得人，东诣吴。贲、辅又于彭泽破勋。勋走入楚江，从寻阳步上到置马亭；闻策等已克皖，乃投西塞。至沂，筑垒自守；告急于刘表，求救于黄祖。祖遣太子射、船军五千人，助勋。策复就攻，大破勋。勋与偕，北归曹公，射亦遁走。策收得勋兵二千余人，船千艘；遂前进夏口，攻黄祖。时刘表遣从子虎、南阳韩晞，将长矛五千，来为黄祖前锋。策与战，大破之。”","attribution":"《江表传》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":257,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-344fcece1d1f127d763a","start":0,"end":480,"offset_unit":"unicode_code_point"},{"id":"wufan-q-a589ac9a55c31dc88fa4","section":"chapter-063","block":"b-4756992061338dc7e698","layer":"original","quote":"每有水旱寇贼，皆先时处期〖4〗，无不中者。辅异焉，以为军师。军中咸敬事之，号曰“神明”。建安中，孙权在豫章。时有星变〖5〗，以问惇。惇曰：“灾在丹杨。”权曰：“何如？”曰：“客胜主人。到某日，当得问〖6〗。”是时边鸿作乱〖7〗，卒如惇言。","section_title":"吴范刘惇赵达传第十八","source":{"file":"OEBPS/Text/titlepage_0133.xhtml","index":54,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":119,"offset_unit":"unicode_code_point"},{"id":"wufan-q-aaa34965a01bb9902ccd","section":"chapter-063","block":"b-cbd06593206ca2b2b3e0","layer":"original","quote":"遭乱避地，客游庐陵，事孙辅","section_title":"吴范刘惇赵达传第十八","source":{"file":"OEBPS/Text/titlepage_0133.xhtml","index":53,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":14,"end":27,"offset_unit":"unicode_code_point"},{"id":"yululu-q-5e683253b8a51089167c","section":"chapter-057","block":"b-9a0daa2cc9276ae3ffa0","layer":"original","quote":"孙权以将军领会稽太守。统年二十，试为乌程相。民户过万，咸叹其惠理〖9〗。权嘉之，召为功曹，行骑都尉，妻以从兄辅女〖10〗。","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":307,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":61,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-06ac05aacb5459935d1f","section":"chapter-051","block":"b-8a1fb7a68a5f6d28ea97","layer":"pei","quote":"策谓贲曰：‘兄今据豫章，是扼僮芝咽喉而守其门户矣。但当伺其形便，因令国仪杖兵而进；使公瑾为作势援：一举可定也","attribution":"裴注·江表传","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":109,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9aaac20463a47de00710","start":36,"end":90,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-105c33b551eba397a664","section":"chapter-051","block":"b-b694d88b8806fc97b6ec","layer":"pei","quote":"权谓辅曰：‘兄厌乐邪？何为呼他人？’辅云：‘无是。’权因投书与昭；昭示辅，辅惭，无辞。乃悉斩辅亲近，分其部曲，徒辅置东","attribution":"裴注·典略","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":144,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ac229b93528b60e95798","start":59,"end":118,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-11c86715125785962926","section":"chapter-051","block":"b-c529af783399939485ea","layer":"original","quote":"时策已平吴、会二郡，贲与策征庐江太守刘勋、江夏太守黄祖","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":95,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":27,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-184fb0dc4981666eef05","section":"chapter-051","block":"b-9f00fa6383f679f952fa","layer":"original","quote":"数岁卒","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":137,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":3,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-37a154c79119d5b6f2d9","section":"chapter-051","block":"b-107b5b6395a4b3b6b579","layer":"original","quote":"又从策讨陵阳〖3〗，生得祖郎等","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":135,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":58,"end":73,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-3a88a976131224511612","section":"chapter-051","block":"b-107b5b6395a4b3b6b579","layer":"original","quote":"策西袭庐江太守刘勋，辅随从；身先士卒，有功","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":135,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":77,"end":98,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-499ebd8b5be184f94d5c","section":"chapter-051","block":"b-18e3b714c7e46696543f","layer":"original","quote":"遣使与曹公相闻，事觉，权幽系之","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":136,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":15,"end":30,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-4b8c9b990f613cc7a4ec","section":"chapter-051","block":"b-107b5b6395a4b3b6b579","layer":"original","quote":"策讨丹杨七县，使辅西屯历阳，以拒袁术；并招诱余民，鸠合遗散","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":135,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":25,"end":54,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-571f0ba403c559058ba9","section":"chapter-051","block":"b-bc8e7771a00e42e333a3","layer":"pei","quote":"即破械，赐衣服，署门下贼曹。及军还，郎与太史慈，俱在前导军，人以为荣","attribution":"裴注·江表传","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":143,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b3e7511317934afcf937","start":130,"end":164,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-7d6eef4abdd84d8afa57","section":"chapter-051","block":"b-bc8e7771a00e42e333a3","layer":"pei","quote":"策自率将士讨郎，生获之。策谓郎曰：‘尔昔袭击孤，斫孤马鞍；今创军立事，除弃宿恨，惟取能用；与天下通耳，非但汝：汝莫恐怖！’郎叩头谢罪","attribution":"裴注·江表传","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":143,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b3e7511317934afcf937","start":63,"end":129,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-88e897b3e6bf4a44a7c2","section":"chapter-051","block":"b-107b5b6395a4b3b6b579","layer":"original","quote":"以扬武校尉佐孙策平三郡","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":135,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":10,"end":21,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-a42a7ef556ddd95d3b71","section":"chapter-051","block":"b-b694d88b8806fc97b6ec","layer":"pei","quote":"辅恐权不能保守江东，因权出行东冶，乃遣人赍书，呼曹公。行人以告，权乃还，伪若不知；与张昭，共见辅","attribution":"裴注·典略","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":144,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ac229b93528b60e95798","start":10,"end":58,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-b73b8d64e09c140affb2","section":"chapter-051","block":"b-8a1fb7a68a5f6d28ea97","layer":"pei","quote":"后贲闻芝病，即如策计；周瑜到巴丘，辅遂得进据庐陵","attribution":"裴注·江表传","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":109,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9aaac20463a47de00710","start":92,"end":116,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-c9b0d15d22a6f29980c5","section":"chapter-051","block":"b-4b5df34883b76455b81f","layer":"original","quote":"贲早失二亲，弟辅，婴孩；贲自赡育，友爱甚笃","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":93,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":26,"end":47,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-df0a499f97d619232d6f","section":"chapter-051","block":"b-107b5b6395a4b3b6b579","layer":"original","quote":"策立辅为庐陵太守，抚定属城，分置长吏","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":135,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":99,"end":117,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-f648cb4e0a24dd4799cb","section":"chapter-051","block":"b-8a1fb7a68a5f6d28ea97","layer":"pei","quote":"时丹杨僮芝，自署庐陵太守。策留贲弟辅，领兵住南昌","attribution":"裴注·江表传","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":109,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9aaac20463a47de00710","start":11,"end":35,"offset_unit":"unicode_code_point"},{"id":"zongshi-q2-67d60afaade32286aeee","section":"chapter-051","block":"b-18e3b714c7e46696543f","layer":"original","quote":"迁平南将军，假节，领交州刺史。遣使与曹公相闻，事觉，权幽系之。﹝二﹞","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":136,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":34,"offset_unit":"unicode_code_point"},{"id":"zongshi-q2-aa0d84929fdd1858eb6d","section":"chapter-051","block":"b-9f00fa6383f679f952fa","layer":"original","quote":"数岁卒。子兴、昭、伟、昕，皆历列位。","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":137,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":18,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
