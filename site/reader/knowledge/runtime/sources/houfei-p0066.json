dering_evidence":"houfei-e-o042d-q","source_order":[5,203,"O042d"],"order":1444},{"id":"houfei-e-o042e","title":"郭详卒郭钊嗣","accounts":[{"id":"houfei-e-o042e-account","label":"《后妃传》正文","text":"郭详卒郭钊嗣","evidence":["houfei-e-o042e-q"]}],"participants":[{"person":"houfei-p0066","role":"卒","evidence":["houfei-e-o042e-q"]},{"person":"houfei-p0069","role":"嗣爵","evidence":["houfei-e-o042e-q"]}],"place":null,"time":{"label":"详薨后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["houfei-e-o042e-q"]},"ordering_evidence":"houfei-e-o042e-q","source_order":[5,203,"O042e"],"order":1445}],"persons":[{"id":"houfei-p0066","name":"郭详","evidence":["houfei-q-o041"],"facts":[],"aliases":[],"mentions":[{"id":"houfei-m-o041-houfei-p0066","kind":"mention","text":"文中提及","evidence":["houfei-q-o041"]},{"id":"houfei-m-o042-houfei-p0066","kind":"mention","text":"文中提及","evidence":["houfei-q-o042"]}]}],"evidence":[{"id":"houfei-e-o041a-q","section":"chapter-005","block":"b-ea6bed6da1ea24121baf","layer":"original","quote":"太和四年，诏封表安阳亭侯。又进爵乡侯，增邑并前五百户，迁中垒将军。以表子详为骑都尉。其年，帝追谥太后父永，为安阳乡敬侯；母董，为都乡君。迁表昭德将军〖1〗，加金紫〖2〗，位特进；表第二子训，为骑都尉。及孟武母卒，欲厚葬，起祠堂。太后止之曰：“自丧乱以来，坟墓无不发掘。皆由厚葬也，首阳陵可以为法。”","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":201,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":149,"offset_unit":"unicode_code_point"},{"id":"houfei-e-o042b-q","section":"chapter-005","block":"b-66c1f6044f4f1392a642","layer":"original","quote":"青龙三年春，后崩于许昌，以终制营陵。三月庚寅〖3〗，葬首阳陵西。﹝一﹞帝进表爵为观津侯，增邑五百，并前千户。迁详为驸马都尉〖4〗。四年〖5〗，追改封永为观津敬侯，世妇董为堂阳君；追封谥后兄浮为梁里亭戴侯，都为武城亭孝侯，成为新乐亭定侯：皆使使者奉策，祠以太牢。表薨，子详嗣；又分表爵，封详弟述为列侯。详薨，子钊嗣。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":202,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":157,"offset_unit":"unicode_code_point"},{"id":"houfei-e-o042d-q","section":"chapter-005","block":"b-66c1f6044f4f1392a642","layer":"original","quote":"青龙三年春，后崩于许昌，以终制营陵。三月庚寅〖3〗，葬首阳陵西。﹝一﹞帝进表爵为观津侯，增邑五百，并前千户。迁详为驸马都尉〖4〗。四年〖5〗，追改封永为观津敬侯，世妇董为堂阳君；追封谥后兄浮为梁里亭戴侯，都为武城亭孝侯，成为新乐亭定侯：皆使使者奉策，祠以太牢。表薨，子详嗣；又分表爵，封详弟述为列侯。详薨，子钊嗣。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":202,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":157,"offset_unit":"unicode_code_point"},{"id":"houfei-e-o042e-q","section":"chapter-005","block":"b-66c1f6044f4f1392a642","layer":"original","quote":"青龙三年春，后崩于许昌，以终制营陵。三月庚寅〖3〗，葬首阳陵西。﹝一﹞帝进表爵为观津侯，增邑五百，并前千户。迁详为驸马都尉〖4〗。四年〖5〗，追改封永为观津敬侯，世妇董为堂阳君；追封谥后兄浮为梁里亭戴侯，都为武城亭孝侯，成为新乐亭定侯：皆使使者奉策，祠以太牢。表薨，子详嗣；又分表爵，封详弟述为列侯。详薨，子钊嗣。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":202,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":157,"offset_unit":"unicode_code_point"},{"id":"houfei-q-b-cbf406b91aa2796bad01","section":"chapter-005","block":"b-cbf406b91aa2796bad01","layer":"modern","quote":"〖10〗四年：太和四年（公元 230）。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":108,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-776c1db56d4d5699fd84","start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"houfei-q-b-e47ffea5cca5eab53d92","section":"chapter-005","block":"b-e47ffea5cca5eab53d92","layer":"modern","quote":"〖15〗三年：青龙三年（公元 235）。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":113,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4aa0b3373c71cedadeb9","start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"houfei-q-o012","section":"chapter-005","block":"b-743375ca04aa18c715da","layer":"original","quote":"至太和四年春，明帝乃追谥太后祖父广曰开阳恭侯〖12〗，父远曰敬侯〖13〗，祖母周封阳都君，及（恭）〔敬〕侯夫人，皆赠印绶〖14〗。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":44,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":65,"offset_unit":"unicode_code_point"},{"id":"houfei-q-o025","section":"chapter-005","block":"b-0744a279ae4c62a54e64","layer":"original","quote":"青龙二年春，追谥后兄俨曰安城乡穆侯。夏，吴贼寇扬州，以像为伏波将军〖12〗，持节，监诸将东征〖13〗。还，复为射声校尉〖14〗。三年薨〖15〗，追赠卫将军，改封魏昌县，谥曰贞侯。子畅嗣。又封畅弟温、4 、艳，皆为列侯。四年〖16〗，改逸、俨本封，皆曰魏昌侯，谥因故〖17〗。封俨世妇刘为东乡君〖18〗，又追封逸世妇张为安喜君。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":97,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":163,"offset_unit":"unicode_code_point"},{"id":"houfei-q-o041","section":"chapter-005","block":"b-ea6bed6da1ea24121baf","layer":"original","quote":"太和四年，诏封表安阳亭侯。又进爵乡侯，增邑并前五百户，迁中垒将军。以表子详为骑都尉。其年，帝追谥太后父永，为安阳乡敬侯；母董，为都乡君。迁表昭德将军〖1〗，加金紫〖2〗，位特进；表第二子训，为骑都尉。及孟武母卒，欲厚葬，起祠堂。太后止之曰：“自丧乱以来，坟墓无不发掘。皆由厚葬也，首阳陵可以为法。”","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":201,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":149,"offset_unit":"unicode_code_point"},{"id":"houfei-q-o042","section":"chapter-005","block":"b-66c1f6044f4f1392a642","layer":"original","quote":"青龙三年春，后崩于许昌，以终制营陵。三月庚寅〖3〗，葬首阳陵西。﹝一﹞帝进表爵为观津侯，增邑五百，并前千户。迁详为驸马都尉〖4〗。四年〖5〗，追改封永为观津敬侯，世妇董为堂阳君；追封谥后兄浮为梁里亭戴侯，都为武城亭孝侯，成为新乐亭定侯：皆使使者奉策，祠以太牢。表薨，子详嗣；又分表爵，封详弟述为列侯。详薨，子钊嗣。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":202,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":157,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
