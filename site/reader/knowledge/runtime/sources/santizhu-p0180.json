":{"file":"OEBPS/Text/titlepage_0131.xhtml","index":197,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-03af5d33c13053b69c65","start":70,"end":91,"offset_unit":"unicode_code_point"},{"id":"shiyi-q-c586ab638736f695ef61","section":"chapter-062","block":"b-bbef289ad14182ba819e","layer":"pei","quote":"蕃有口才，魏明帝使诈叛，如吴；令求作廷尉职，重案大臣，以离间之","attribution":"裴注·吴录","section_title":"是仪胡综传第十七","source":{"file":"OEBPS/Text/titlepage_0131.xhtml","index":197,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-03af5d33c13053b69c65","start":10,"end":41,"offset_unit":"unicode_code_point"},{"id":"shiyi-q-d979b508e2d50a56b6c4","section":"chapter-062","block":"b-1bfab7b7bf3112c80af4","layer":"original","quote":"后蕃谋叛，事觉伏诛","section_title":"是仪胡综传第十七","source":{"file":"OEBPS/Text/titlepage_0131.xhtml","index":178,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":54,"end":63,"offset_unit":"unicode_code_point"},{"id":"shiyi-q-f0a5422b61e64c256f06","section":"chapter-062","block":"b-82c5416db938abe31d1a","layer":"original","quote":"青州人隐蕃，归吴。上书曰：“臣闻纣为无道，微子先出〖2〗；高祖宽明，陈平先入。臣年二十二，委弃封域〖3〗，归命有道；赖蒙天灵，得自全致〖4〗。臣至止有日〖5〗，而主者同之降人〖6〗，未见精别；使臣微言妙旨，不得上达。於邑三叹〖7〗，曷惟其已〖8〗！谨诣阙拜章，乞蒙引见。”","section_title":"是仪胡综传第十七","source":{"file":"OEBPS/Text/titlepage_0131.xhtml","index":176,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":6,"end":142,"offset_unit":"unicode_code_point"},{"id":"shiyi-q-f78ba286ae0217abc2b5","section":"chapter-062","block":"b-bbef289ad14182ba819e","layer":"pei","quote":"既为廷尉监，众人以据、普与蕃亲善，常车马云集，宾客盈堂","attribution":"裴注·吴录","section_title":"是仪胡综传第十七","source":{"file":"OEBPS/Text/titlepage_0131.xhtml","index":197,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-03af5d33c13053b69c65","s