nce":["panlu-q-df7c5a57940e2ab79a0a"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["panlu-q-df7c5a57940e2ab79a0a"]},"ordering_evidence":"panlu-q-df7c5a57940e2ab79a0a","source_order":[61,268,200],"related_events":[{"event":"santizhu059-e-o056b","type":"alternative","evidence":["panlu-q-df7c5a57940e2ab79a0a","santizhu059-q-44736858bd150782c131"]}],"order":10778}],"persons":[{"id":"luxun-p0049","name":"杨竺","evidence":["luxun-q-o059","santizhu059-q-60e5b248903bb26daf08","santizhu059-q-e1d8884fd529e9e75a5e","santizhu059-q-44736858bd150782c131","santizhu059-q-f5c695232dc8ff7315a1","panlu-q-453e992432eeed68e490","panlu-q-cc562756d03ea48ba6b4","panlu-q-df7c5a57940e2ab79a0a","panlu-q-90c1a58221a216cbb567","yululu-q-715d3201e4b91dc9a135","yululu-q-eb1d161d5b6c68234406"],"facts":[],"aliases":[],"mentions":[{"id":"luxun-m-o059-luxun-p0049","kind":"mention","text":"文中提及","evidence":["luxun-q-o059"]},{"id":"luxun-m-o056-luxun-p0049","kind":"mention","text":"文中提及","evidence":["luxun-q-o056"]},{"id":"yululu-m-ba89469b96432f81da3d","kind":"mention","text":"本篇原文记及杨竺，具体行动与称谓见引文。","evidence":["yululu-q-eb1d161d5b6c68234406"]}]}],"evidence":[{"id":"feipin-q-7c72f2103baae9549fc5","section":"chapter-050","block":"b-c14bd5deb73480d18b5f","layer":"original","quote":"安坐党鲁王霸，死〖10〗。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":7,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":35,"end":48,"offset_unit":"unicode_code_point"},{"id":"luxun-e-o054c-q","section":"chapter-058","block":"b-03ef9029e4f75daea2ea","layer":"original","quote":"太子太傅吾粲，坐数与逊交书，下狱死。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":248,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":61,"end":79,"offset_unit":"unicode_code_point"},{"id":"luxun-q-o056","section":"chapter-058","block":"b-8e957902767561dae8ac","layer":"original","quote":"初，暨艳造营府之论〖26〗，逊谏戒之，以为必祸。又谓诸葛恪曰：“在我前者，吾必奉之同升；在我下者，则扶持之。今观君气陵其上〖27〗，意蔑乎下〖28〗：非安德之基也。”又广陵杨竺少获声名，而逊谓之终败，劝竺兄穆，令与别族〖29〗：其先睹如此。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":250,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":120,"offset_unit":"unicode_code_point"},{"id":"luxun-q-o059","section":"chapter-058","block":"b-9af64c9a4a4bd7ce5a6f","layer":"original","quote":"送葬东还，诣都谢恩。孙权以杨竺所白逊二十事，问抗〖2〗，禁绝宾客，中使临诘〖3〗；抗无所顾问〖4〗，事事条答〖5〗：权意渐解。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":283,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":63,"offset_unit":"unicode_code_point"},{"id":"panlu-q-453e992432eeed68e490","section":"chapter-061","block":"b-2f8f206f4f039d83c0a9","layer":"pei","quote":"太子自惧黜废，而鲁王觊觎益甚。权时见杨竺，辟左右而论霸之才；竺深述霸有文武英姿，宜为嫡嗣：于是权乃许立焉","attribution":"裴注·《吴录》","section_title":"潘濬陆凯传第十六","source":{"file":"OEBPS/Text/titlepage_0129.xhtml","index":267,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-90be1bc5b1a157bbf567","start":10,"end":62,"offset_unit":"unicode_code_point"},{"id":"panlu-q-90c1a58221a216cbb567","section":"chapter-061","block":"b-b41003707cccf82182ea","layer":"original","quote":"会全寄，杨竺等阿附鲁王霸，与和分争，阴相谮构","section_title":"潘濬陆凯传第十六","source":{"file":"OEBPS/Text/titlepage_0129.xhtml","index":240,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":32,"end":54,"offset_unit":"unicode_code_point"},{"id":"panlu-q-cc562756d03ea48ba6b4","section":"chapter-061","block":"b-2f8f206f4f039d83c0a9","layer":"pei","quote":"权疑竺泄之，竺辞不服。权使竺出寻其由，竺白：‘顷惟胤西行，必其所道。’又遣问逊何由知之，逊言胤所述","attribution":"裴注·《吴录》","section_title":"潘濬陆凯传第十六","source":{"file":"OEBPS/Text/titlepage_0129.xhtml","index":267,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-90be1bc5b1a157bbf567","start":124,"end":173,"offset_unit":"unicode_code_point"},{"id":"panlu-q-df7c5a57940e2ab79a0a","section":"chapter-061","block":"b-2f8f206f4f039d83c0a9","layer":"pei","quote":"竺不胜痛毒，服是所道。初权疑竺泄之，及服，以为果然：乃斩竺","attribution":"裴注·《吴录》","section_title":"潘濬陆凯传第十六","source":{"file":"OEBPS/Text/titlepage_0129.xhtml","index":267,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-90be1bc5b1a157bbf567","start":200,"end":229,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-44736858bd150782c131","section":"chapter-059","block":"b-4b82ceb061997a002877","layer":"original","quote":"流竺尸于江；兄穆，以数谏戒竺，得免大辟，犹徙南州〖15〗。霸赐死后，又诛寄、安、奇等：咸以党霸构和故也","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":227,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":39,"end":90,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-60e5b248903bb26daf08","section":"chapter-059","block":"b-f77eaac96e37b2d3db4c","layer":"original","quote":"陆逊、吾粲、顾谭等数陈嫡庶之义，理不可夺；全寄、杨竺为鲁王霸支党，谮诉日兴〖6〗。粲遂下狱诛，谭徙交州","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":160,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":51,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-e1d8884fd529e9e75a5e","section":"chapter-059","block":"b-4b82ceb061997a002877","layer":"original","quote":"时全寄、吴安、孙奇、杨竺等，阴共附霸，图危太子。谮毁既行，太子以败，霸亦赐死","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":227,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":38,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-f5c695232dc8ff7315a1","section":"chapter-059","block":"b-f77eaac96e37b2d3db4c","layer":"original","quote":"陆逊、吾粲、顾谭等数陈嫡庶之义，理不可夺；全寄、杨竺为鲁王霸支党，谮诉日兴〖6〗。粲遂下狱诛，谭徙交州","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":160,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":51,"offset_unit":"unicode_code_point"},{"id":"yululu-q-715d3201e4b91dc9a135","section":"chapter-057","block":"b-12487deb4f8058d89b8b","layer":"original","quote":"由此为霸、竺等所谮害，下狱诛","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":447,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":75,"end":89,"offset_unit":"unicode_code_point"},{"id":"yululu-q-eb1d161d5b6c68234406","section":"chapter-057","block":"b-12487deb4f8058d89b8b","layer":"original","quote":"迁太子太傅，遭二宫之变〖14〗。抗言执正〖15〗，明嫡庶之分；欲使鲁王霸出驻夏口，遣杨竺不得令在都邑〖16〗。又数以消息语陆逊，逊时驻武昌，连表谏争。由此为霸、竺等所谮害，下狱诛〖17〗。","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":447,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":94,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
