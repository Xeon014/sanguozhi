{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhanggu-e-o045","title":"壹罪发雍往断狱和颜问之","accounts":[{"id":"zhanggu-a-57b3e045e51715f97e2c","label":"正文","text":"壹罪发雍往断狱和颜问之","evidence":["zhanggu-q-ac63164db98346ad9e5a"]}],"participants":[{"person":"wuzhu-p0094","role":"奸罪发露、收系廷尉、以囚见、叩头无言","evidence":["zhanggu-q-ac63164db98346ad9e5a"]},{"person":"wuzhu-p0045","role":"往断狱、和颜色问其辞状、临出又谓壹曰君意得无欲有所道、责叙曰官有正法何至于此","evidence":["zhanggu-q-ac63164db98346ad9e5a"]},{"person":"zhanggu-p0015","role":"尚书郎、面詈辱壹","evidence":["zhanggu-q-ac63164db98346ad9e5a"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["zhanggu-q-ac63164db98346ad9e5a"]},"ordering_evidence":"zhanggu-q-ac63164db98346ad9e5a","source_order":[52,145,105],"order":9294}],"persons":[{"id":"zhanggu-p0015","name":"怀叙","evidence":["zhanggu-q-ac63164db98346ad9e5a"],"facts":[],"aliases":[],"mentions":[{"id":"zhanggu-m-cb372cb6c379a67d6dc2","kind":"mention","text":"本段涉及怀叙","evidence":["zhanggu-q-963ec956fb4ceb6b3c57"]}]}],"evidence":[{"id":"zhanggu-q-963ec956fb4ceb6b3c57","section":"chapter-052","block":"b-768cf7a650822144fd92","layer":"pei","quote":"徐众评曰：“雍不以吕壹见毁之故，而和颜悦色，诚长者矣；然开引其意，问所欲道，此非也。壹奸险乱法，毁伤忠贤，吴国寒心；自太子登、陆逊以下，切谏不能得；是以潘濬欲因会，手剑之，以除国患，疾恶忠主，义形于色。而今乃发起令言，若壹称枉邪：不申理，则非录狱本旨；若承辞而奏之，吴主傥以敬丞相所言，而复原宥，伯言、承明不当悲慨哉！怀叙本无私恨，无所为嫌；故詈辱之，疾恶意耳：恶不仁者，其为仁也。季武子死，曾点倚其门而歌；子皙创发，子产催令自裁。以此言之，雍不当责怀叙也。”","attribution":"裴注·徐众评","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":170,"anchor":null},"note_id":"n-c5f62508b513eb563318","start":0,"end":230},{"id":"zhanggu-q-ac63164db98346ad9e5a","section":"chapter-052","block":"b-e13bf0a091cac44e124f","layer":"original","quote":"后壹奸罪发露，收系廷尉。雍往断狱，壹以囚见；雍和颜色，问其辞状。临出，又谓壹曰：“君意得无欲有所道〖13〗？”壹叩头无言。时尚书郎怀叙，面詈辱壹〖14〗；雍责叙曰：“官有正法，何至于此","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":144,"anchor":null},"note_id":null,"start":105,"end":197}],"profiles":{},"directory_counts":{}}
