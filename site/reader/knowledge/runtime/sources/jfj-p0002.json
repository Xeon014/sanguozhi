name":"赵直","evidence":["jfj-q0037","jfj-q0038","liuliao-q-fbfd9d3fc26dabbd695a","huowang-q-bc8bcc755c2108f27c9f"],"facts":[],"aliases":[],"mentions":[{"id":"jfj-m-o003-jfj-p0002","kind":"mention","text":"本段记载：蒋琬梦牛头流血并问赵直","evidence":["jfj-q0038"]}]}],"evidence":[{"id":"huowang-q-bc8bcc755c2108f27c9f","section":"chapter-041","block":"b-402b8dd12cfa86663358","layer":"pei","quote":"尝梦井中生桑，以问占梦赵直，直曰：‘桑非井中之物，会当移植；然“桑”字四十下八，君寿恐不过此。’祗笑言：‘得此足矣！","attribution":"裴注·益部耆旧传•杂记","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":168,"anchor":null},"note_id":"n-c2ad504755adcbb9bb52","start":106,"end":164},{"id":"jfj-q0037","section":"chapter-044","block":"b-e9fd815eeddbc442fb59","layer":"original","quote":"琬见推之后〖6〗，夜梦有一牛头在门前，流血滂沱〖7〗，意甚恶之。呼问占梦赵直〖8〗，直曰：“夫见血者，事分明也；牛角及鼻，‘公’字之象：君位必当至公，大吉之征也。”","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":3,"anchor":null},"note_id":null,"start":0,"end":82},{"id":"jfj-q0038","section":"chapter-044","block":"b-e9fd815eeddbc442fb59","layer":"original","quote":"琬见推之后〖6〗，夜梦有一牛头在门前，流血滂沱〖7〗，意甚恶之。呼问占梦赵直〖8〗，直曰：“夫见血者，事分明也；牛角及鼻，‘公’字之象：君位必当至公，大吉之征也。”顷之，为什邡令。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":3,"anchor":null},"note_id":null,"start":0,"end":90},{"id":"liuliao-q-fbfd9d3fc26dabbd695a","section":"chapter-040","block":"b-0f9d68d6f2d47cc220b3","layer":"original","quote":"十二年〖10〗，亮出北谷口〖11〗，延为前锋，出亮营十里。延梦头上生角，以问占梦赵直〖12〗。直诈延曰：“夫麒麟有角而不用，此不战而贼欲自破之象也。”退而告人曰：“‘角’之为字：‘刀’下‘用’也；头上用刀，其凶甚矣","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":274,"anchor":null},"note_id":null,"start":0,"end":107}],"profiles":{},"directory_counts":{}}
