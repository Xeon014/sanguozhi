ersons":[{"id":"wgc-p0112","name":"王业（王弼父）","evidence":["wgc-q0139","wgc-q0141","wgc-q0140"],"aliases":[],"facts":[],"mentions":[{"id":"wgc-m-p064-wgc-p0112","kind":"mention","text":"本段涉及王业（王弼父）","evidence":["wgc-q0139"]},{"id":"wgc-m-p067-wgc-p0112","kind":"mention","text":"本段涉及王业（王弼父）","evidence":["wgc-q0141"]},{"id":"wgc-m-p066-wgc-p0112","kind":"mention","text":"本段涉及王业（王弼父）","evidence":["wgc-q0140"]}]}],"evidence":[{"id":"wangwei-q-c17de50cd573cb817665","section":"chapter-021","block":"b-815c10d656058333ea9b","layer":"original","quote":"粲二子，为魏讽所引〖23〗，诛。后绝","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":32,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":18,"offset_unit":"unicode_code_point"},{"id":"wgc-q0139","section":"chapter-028","block":"b-9b251afc54919533df14","layer":"pei","quote":"﹝一﹞弼，字辅嗣。何劭为其传曰：“弼幼而察慧，年十余，好《老氏》，能辩能言。父业，为尚书郎。时裴徽为吏部郎，弼未弱冠，往造焉。徽一见而异之，问弼曰：‘夫无者，诚万物之所资也，然圣人莫肯致言，而老子申之无已者何？’弼曰：‘圣人体无，无又不可以训，故不说也。老子是有者也，故恒言（无）〔其〕所不足。’寻亦为傅嘏所知。于时何晏为吏部尚书，甚奇弼，叹之曰：‘仲尼称后生可畏。若斯人者，可与言天人之际乎！’正始中，黄门侍郎累缺。晏既用贾充、裴秀、朱整，又议用弼。时丁谧与晏争衡，致高邑王黎于曹爽，爽用黎；于是以弼补台郎。初除，觐爽，请闲；爽为屏左右，而弼与论道，移时无所他及，爽以此嗤之。时爽专朝政，党与共相进用，弼通俊，不治名高。寻黎无几时病亡，爽用王沈代黎；弼遂不得在门下，晏为之叹恨。弼在台既浅，事功亦雅非所长，益不留意焉。淮南人刘陶，善论纵横，为当时所推。每与弼语，常屈弼。弼天才卓出，当其所得，莫能夺也。性和理，乐游宴，解音律，善投壶。其论道：傅会文辞，不如何晏；自然有所拔得，多晏也。颇以所长笑人，故时为士君子所疾。弼与钟会善，会论议，以校练为家，然每服弼之高致。何晏以为圣人无喜怒哀乐，其论甚精，钟会等述之。弼与不同，以为：圣人茂于人者，神明也；同于人者，五情也；神明茂，故能体冲和以通无；五情同，故不能无哀乐以应物：然则圣人之情，应物而无累于物者也。今以其无累，便谓不复应物，失之多矣。弼注《易》，颍川人荀融难弼《大衍义》。弼答其意，白书以戏之曰：‘夫明足以寻极幽微，而不能去自然之性。颜子之量，孔父之所预在，然遇之不能无乐，丧之不能无哀。又常狭斯人，以为未能以情从理者也，而今乃知自然之不可革。足下之量，虽已定乎胸怀之内；然而隔逾旬朔，何其相思之多乎？故知尼父之于颜子，可以无大过矣。’弼注《老子》，为之指略，致有理统。著《道略论》，注《易》，往往有高丽言。太原王济好谈，病《老》、《庄》，常云：‘见弼《易注》，所悟者多。’然弼为人，浅而不识物情。初与王黎、荀融善，黎夺其黄门郎；于是恨黎，与融亦不终。正始十年，曹爽废，以公事免。其秋遇疠疾亡，时年二十四。无子，绝嗣。弼之卒也，晋景王闻之，嗟叹者累日，其为高识所惜如此。”","attribution":"何劭王弼传","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":627,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fd72bf831660f4aea13e","start":0,"end":915,"offset_unit":"unicode_code_point"},{"id":"wgc-q0140","section":"chapter-028","block":"b-916e3150373d4079c2cd","layer":"pei","quote":"《博物记》曰：“初，王粲与族兄凯，俱避地荆州。刘表欲以女妻粲，而嫌其形陋而用率；以凯有风貌，乃以妻凯。凯生业，业即刘表外孙也。蔡邕有书近万卷，末年载数车与粲。粲亡后，相国掾魏讽谋反，粲子与焉；既被诛，邕所与书，悉入业。业字长绪。位至谒者仆射。子宏字正宗。司隶校尉。宏，弼之兄也。”","attribution":"博物记","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":629,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fd72bf831660f4aea13e","start":0,"end":140,"offset_unit":"unicode_code_point"},{"id":"wgc-q0141","section":"chapter-028","block":"b-89b6d566268a9df60730","layer":"pei","quote":"《魏氏春秋》曰：“文帝既诛粲二子；以业嗣粲。”","attribution":"魏氏春秋","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":630,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fd72bf831660f4aea13e","start":0,"end":23,"offset_unit":"unicode_code_point"},{"id":"wgc-q0655","section":"chapter-028","block":"b-89b6d566268a9df60730","layer":"pei","quote":"文帝既诛粲二子；以业嗣粲","attribution":"裴注·魏氏春秋","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":630,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fd72bf831660f4aea13e","start":9,"end":21,"offset_unit":"unicode_code_point"},{"id":"wgc-q0707","section":"chapter-028","block":"b-9b251afc54919533df14","layer":"pei","quote":"父业，为尚书郎。","attribution":"何劭王弼传","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":627,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fd72bf831660f4aea13e","start":38,"end":46,"offset_unit":"unicode_code_point"},{"id":"wgc-q0715","section":"chapter-028","block":"b-916e3150373d4079c2cd","layer":"pei","quote":"蔡邕有书近万卷，末年载数车与粲。粲亡后，相国掾魏讽谋反，粲子与焉；既被诛，邕所与书，悉入业。","attribution":"博物记","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":629,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fd72bf831660f4aea13e","start":63,"end":109,"offset_unit":"unicode_code_point"},{"id":"wgc-q0716","section":"chapter-028","block":"b-916e3150373d4079c2cd","layer":"pei","quote":"业字长绪。位至谒者仆射。","attribution":"博物记","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":629,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fd72bf831660f4aea13e","start":109,"end":121,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
