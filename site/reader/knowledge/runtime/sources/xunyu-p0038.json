{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xunyu-e-p019a","title":"荀融与王弼钟会论易老","accounts":[{"id":"xunyu-e-p019a-account","label":"《荀氏家传》及裴注","text":"荀融为洛阳令、参大将军军事，与王弼、钟会论易老义。","evidence":["xunyu-e-p019a-q"]}],"participants":[{"person":"xunyu-p0040","role":"论学","evidence":["xunyu-e-p019a-q"]},{"person":"xunyu-p0038","role":"论学","evidence":["xunyu-e-p019a-q"]},{"person":"shaodi-p0073","role":"论学","evidence":["xunyu-e-p019a-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xunyu-e-p019a-q"]},"ordering_evidence":"xunyu-e-p019a-q","source_order":[10,155,"P019a"],"order":2439},{"id":"chengguo-e-p178","title":"陶论仲尼不圣王弼大惑","accounts":[{"id":"chengguo-a-5812bff525832b612e50","label":"裴注·《傅子》","text":"陶论仲尼不圣王弼大惑","evidence":["chengguo-q-fa4e7fd4ea0d4ce2735d"]}],"participants":[{"person":"wgc-p0111","role":"意陵青云、谓玄仲尼不圣、智者图国天下群愚如弄一丸于掌中而不能得天下、爽败后退居里舍乃谢其言之过","evidence":["chengguo-q-fa4e7fd4ea0d4ce2735d"]},{"person":"xunyu-p0038","role":"以其言大惑不复详难、谓之曰天下之质变无常也今见卿穷","evidence":["chengguo-q-fa4e7fd4ea0d4ce2735d"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["chengguo-q-fa4e7fd4ea0d4ce2735d"]},"ordering_evidence":"chengguo-q-fa4e7fd4ea0d4ce2735d","source_order":[14,365,74],"related_events":[{"event":"chengguo-e-p179","type":"alternative","evidence":["chengguo-q-fa4e7fd4ea0d4ce2735d","chengguo-q-517e7ce1fe46be8a0d5a"],"note":"刘陶退居谢过与《晋纪》出守追杀的结局记载分层并列。"}],"order":3131},{"id":"wgc-e-add012","title":"王弼注易及老子","order":5835,"accounts":[{"id":"wgc-a-add012","label":"正文","text":"王弼注易及老子","evidence":["wgc-q0664","wgc-q0086"]}],"participants":[{"person":"xunyu-p0038","role":"作注","evidence":["wgc-q0664","wgc-q0086"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0664","wgc-q0086"]},"ordering_evidence":"wgc-q0664"},{"id":"wgc-e-ad