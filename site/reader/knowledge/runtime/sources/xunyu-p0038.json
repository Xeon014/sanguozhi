48b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fd72bf831660f4aea13e","start":816,"end":854,"offset_unit":"unicode_code_point"},{"id":"wgc-q0651","section":"chapter-028","block":"b-9b251afc54919533df14","layer":"pei","quote":"正始十年，曹爽废，以公事免。其秋遇疠疾亡，时年二十四。无子，绝嗣","attribution":"裴注·何劭王弼传","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":627,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fd72bf831660f4aea13e","start":855,"end":887,"offset_unit":"unicode_code_point"},{"id":"wgc-q0664","section":"chapter-028","block":"b-5a154c6b810e91832abf","layer":"original","quote":"注《易》及《老子》。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":621,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":82,"end":92,"offset_unit":"unicode_code_point"},{"id":"wgc-q0665","section":"chapter-028","block":"b-5a154c6b810e91832abf","layer":"original","quote":"为尚书郎","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":621,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":92,"end":96,"offset_unit":"unicode_code_point"},{"id":"wgc-q0666","section":"chapter-028","block":"b-5a154c6b810e91832abf","layer":"original","quote":"年二十余卒。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":621,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":97,"end":103,"offset_unit":"unicode_code_point"},{"id":"wgc-q0710","section":"chapter-028","block":"b-9b251afc54919533df14","layer":"pei","quote":"正始十年，曹爽废，以公事免。其秋遇疠疾亡，时年二十四。无子，绝嗣。","attribution":"何劭王弼传","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":627,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fd72bf831660f4aea13e","start":855,"end":888,"offset_unit":"unicode_code_point"},{"id":"wgc-q0711","section":"chapter-028","block":"b-9b251afc54919533df14","layer":"pei","quote":"著《道略论》，注《易》，往往有高丽言。","attribution":"何劭王弼传","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":627,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fd72bf831660f4aea13e","start":764,"end":783,"offset_unit":"unicode_code_point"},{"id":"wgc-q0713","section":"chapter-028","block":"b-ecb93edddf7a0440e55b","layer":"pei","quote":"孙盛曰：“《易》之为书，穷神知化；非天下之至精，其孰能与于此？世之注解，殆皆妄也；况弼以傅会之辨，而欲笼统玄旨者乎？故其叙浮义则丽辞溢目，造阴阳则妙颐无闲。至于六爻变化，群象所效；日时岁月，五气相推；弼皆摈落，多所不关。虽有可观者焉，恐将泥夫大道。”","attribution":"孙盛论","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":628,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fd72bf831660f4aea13e","start":0,"end":125,"offset_unit":"unicode_code_point"},{"id":"xunyu-e-p019a-q","section":"chapter-010","block":"b-310798880b116dcdf9cc","layer":"pei","quote":"绍子融，字伯雅；与王弼、钟会俱知名；为洛阳令，参大将军军事；与弼、会论《易》、《老》义，传于世。","attribution":"《荀氏家传》及裴注","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":154,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-75cfb114317a4cad6048","start":91,"end":139,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-p019","section":"chapter-010","block":"b-310798880b116dcdf9cc","layer":"pei","quote":"﹝一﹞《荀氏家传》曰：“衍，字休若。彧第三兄。”彧第四兄谌，字友若。事见《袁绍传》。陈群与孔融，论汝、颍人物，群曰：“荀文若、公达、休若、友若、仲豫，当今并无对。”衍子绍，位至太仆。绍子融，字伯雅；与王弼、钟会俱知名；为洛阳令，参大将军军事；与弼、会论《易》、《老》义，传于世。谌子闳，字仲茂。为太子文学掾。时有甲、乙疑论，闳与钟繇、王朗、袁涣，议各不同。文帝与繇书曰：“袁、王国士，更为唇齿；荀闳劲悍，往来锐师：真君侯之勍敌，左右之深忧也。”终黄门侍郎。闳从孙（恽）〔煇〕，字景文。太子中庶子，亦知名。与贾充共定（音）〔晋〕律，又作《易集解》。仲豫名悦，朗陵长俭之少子，彧从父兄也。","attribution":"《荀氏家传》及裴注","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":154,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-75cfb114317a4cad6048","start":0,"end":292,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
