{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"rensu-e-o151","title":"兴平中三辅乱饥穷，苏则避难北地，客安定","accounts":[{"id":"rensu-a-9e0c6f6b20229fdd18d4","label":"裴注·魏略","text":"兴平中三辅乱饥穷，苏则避难北地，客安定","evidence":["rensu-q-45220e2bb3ce4cdf4def"]},{"id":"rensu-a-b7472ffe8e723c4c8533","label":"裴注·魏略","text":"苏则依富室师亮，亮待遇不足；则慨然叹天下会安必还为此郡守、折庸辈士","evidence":["rensu-q-210e9e7ca02278136a53"]},{"id":"rensu-a-b0be5ca4ad1921d7c0c2","label":"裴注·魏略","text":"苏则后与冯翊吉茂等隐于郡南太白山中，以书籍自娱","evidence":["rensu-q-d4b09d9c2fc83d0acf97"]},{"id":"rensu-a-20b3690698f803c68dc5","label":"裴注·魏略","text":"及苏则为安定太守，师亮等皆欲逃走；则闻之预使人解语，以礼报之","evidence":["rensu-q-953bb7cdbb4364f331ef"]}],"participants":[{"person":"wendi-p0010","role":"避难者；依人而有慨叹者；隐居者；解语以礼者","evidence":["rensu-q-45220e2bb3ce4cdf4def","rensu-q-210e9e7ca02278136a53","rensu-q-d4b09d9c2fc83d0acf97","rensu-q-953bb7cdbb4364f331ef"]},{"person":"rensu-p0023","role":"待遇不足之富室；惧罪欲逃者","evidence":["rensu-q-210e9e7ca02278136a53","rensu-q-953bb7cdbb4364f331ef"]},{"person":"rensu-p0012","role":"同隐者","evidence":["rensu-q-d4b09d9c2fc83d0acf97"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["rensu-q-45220e2bb3ce4cdf4def","rensu-q-210e9e7ca02278136a53","rensu-q-d4b09d9c2fc83d0acf97","rensu-q-953bb7cdbb4364f331ef"]},"ordering_evidence":"rensu-q-45220e2bb3ce4cdf4def","source_order":[16,29,14],"order":3395}],"persons":[{"id":"rensu-p0023","name":"师亮","evidence":["rensu-q-210e9e7ca02278136a53","rensu-q-953bb7cdbb4364f331ef"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[{"id":"rensu-q-210e9e7ca02278136a53","section":"chapter-016","block":"b-cd1041adcf23a3bcd4a8","layer":"pei","quote":"依富室师亮，亮待遇不足。则慨然叹曰：‘天下会安，当不久尔；必还为此郡守，折庸辈士也","attribution":"裴注·魏略","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":28,"anchor":null},"note_id":"n-fc1c6feb90f952a33627","start":34,"end":75},{"id":"rensu-q-45220e2bb3ce4cdf4def","section":"chapter-016","block":"b-cd1041adcf23a3bcd4a8","layer":"pei","quote":"兴平中，三辅乱，饥穷，避难北地，客安定","attribution":"裴注·魏略","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":28,"anchor":null},"note_id":"n-fc1c6feb90f952a33627","start":14,"end":33},{"id":"rensu-q-953bb7cdbb4364f331ef","section":"chapter-016","block":"b-cd1041adcf23a3bcd4a8","layer":"pei","quote":"及为安定太守，而师亮等皆欲逃走。则闻之，预使人解语，以礼报之","attribution":"裴注·魏略","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":28,"anchor":null},"note_id":"n-fc1c6feb90f952a33627","start":100,"end":130},{"id":"rensu-q-d4b09d9c2fc83d0acf97","section":"chapter-016","block":"b-cd1041adcf23a3bcd4a8","layer":"pei","quote":"后与冯翊吉茂等，隐于郡南太白山中，以书籍自娱","attribution":"裴注·魏略","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":28,"anchor":null},"note_id":"n-fc1c6feb90f952a33627","start":77,"end":99}],"profiles":{},"directory_counts":{}}
