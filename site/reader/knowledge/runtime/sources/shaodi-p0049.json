shaodi-m-p018-shaodi-p0049","kind":"mention","text":"文中提及","evidence":["shaodi-q-p018"]},{"id":"shaodi-m-p019-shaodi-p0049","kind":"mention","text":"文中提及","evidence":["shaodi-q-p019"]},{"id":"jfj-m-o029-shaodi-p0049","kind":"mention","text":"本段记载：郭修在岁首宴会刺杀费祎","evidence":["jfj-q0120"]}]}],"evidence":[{"id":"houzhu-q-O060","section":"chapter-033","block":"b-1f37e1b42e65df576a4b","layer":"original","quote":"十六年春正月，大将军费祎为魏降人郭修所杀于汉寿。","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":118,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":24,"offset_unit":"unicode_code_point"},{"id":"huangli-q-c5d66e44f07a43bde2c9","section":"chapter-043","block":"b-3c802f54bceca5d153c1","layer":"original","quote":"后祎果为魏降人郭修所害","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":245,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":40,"end":51,"offset_unit":"unicode_code_point"},{"id":"jfj-q0119","section":"chapter-044","block":"b-8057c101f8e5c1e65768","layer":"original","quote":"十六年岁首大会〖30〗，魏降人郭修在坐。祎欢饮沉醉，为修手刃所害","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":115,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":32,"offset_unit":"unicode_code_point"},{"id":"jfj-q0120","section":"chapter-044","block":"b-8057c101f8e5c1e65768","layer":"original","quote":"十六年岁首大会〖30〗，魏降人郭修在坐。祎欢饮沉醉，为修手刃所害〖31〗。谥曰敬侯。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":115,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":42,"offset_unit":"unicode_code_point"},{"id":"jfj-q0151","section":"chapter-044","block":"b-17531dc8d5be031fa190","layer":"original","quote":"十六年春〖10〗，祎卒。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":180,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":12,"offset_unit":"unicode_code_point"},{"id":"shaodi-e-o057b-q","section":"chapter-004","block":"b-62de37a81864196f8119","layer":"original","quote":"八月，诏曰：“故中郎西平郭修〖2〗，砥节厉行，秉心不回〖3〗。乃者蜀将姜维寇抄修郡〖4〗，为所执略。往岁伪大将军费祎，驱率群众〖5〗，阴图窥窬〖6〗；道经汉寿〖7〗，请会众宾。修于广坐之中，手刃击祎〖8〗，勇过聂政〖9〗，功逾介子〖10〗。可谓杀身成仁，释生取义者矣〖11〗。夫追加褒宠，所以表扬忠义；祚及后胤，所以奖劝将来。其追封修为长乐乡侯，食邑千户，谥曰威侯；子袭爵，加拜奉车都尉〖12〗；赐银千鉼〖13〗，绢千匹。以光宠存亡〖14〗，永垂来世焉。”﹝三﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":241,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":231,"offset_unit":"unicode_code_point"},{"id":"shaodi-e-o057c-q","section":"chapter-004","block":"b-62de37a81864196f8119","layer":"original","quote":"八月，诏曰：“故中郎西平郭修〖2〗，砥节厉行，秉心不回〖3〗。乃者蜀将姜维寇抄修郡〖4〗，为所执略。往岁伪大将军费祎，驱率群众〖5〗，阴图窥窬〖6〗；道经汉寿〖7〗，请会众宾。修于广坐之中，手刃击祎〖8〗，勇过聂政〖9〗，功逾介子〖10〗。可谓杀身成仁，释生取义者矣〖11〗。夫追加褒宠，所以表扬忠义；祚及后胤，所以奖劝将来。其追封修为长乐乡侯，食邑千户，谥曰威侯；子袭爵，加拜奉车都尉〖12〗；赐银千鉼〖13〗，绢千匹。以光宠存亡〖14〗，永垂来世焉。”﹝三﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":241,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":231,"offset_unit":"unicode_code_point"},{"id":"shaodi-e-p018a-q","section":"chapter-004","block":"b-5c35212fabc5cc58302f","layer":"pei","quote":"﹝三﹞《魏氏春秋》曰：“修字孝先。素有业行，著名西州。姜维劫之，修不为屈。刘禅以为左将军，修欲刺禅而不得亲近。每因庆贺，且拜且前；为禅左右所遏，事辄不克，故杀祎焉。”","attribution":"《魏氏春秋》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":264,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8cc9180077c660fd8f82","start":0,"end":83,"offset_unit":"unicode_code_point"},{"id":"shaodi-f0003-q","section":"chapter-004","block":"b-5c35212fabc5cc58302f","layer":"pei","quote":"修字孝先","attribution":"《魏氏春秋》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":264,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8cc9180077c660fd8f82","start":12,"end":16,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o057","section":"chapter-004","block":"b-62de37a81864196f8119","layer":"original","quote":"八月，诏曰：“故中郎西平郭修〖2〗，砥节厉行，秉心不回〖3〗。乃者蜀将姜维寇抄修郡〖4〗，为所执略。往岁伪大将军费祎，驱率群众〖5〗，阴图窥窬〖6〗；道经汉寿〖7〗，请会众宾。修于广坐之中，手刃击祎〖8〗，勇过聂政〖9〗，功逾介子〖10〗。可谓杀身成仁，释生取义者矣〖11〗。夫追加褒宠，所以表扬忠义；祚及后胤，所以奖劝将来。其追封修为长乐乡侯，食邑千户，谥曰威侯；子袭爵，加拜奉车都尉〖12〗；赐银千鉼〖13〗，绢千匹。以光宠存亡〖14〗，永垂来世焉。”﹝三﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":241,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":231,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-p018","section":"chapter-004","block":"b-5c35212fabc5cc58302f","layer":"pei","quote":"﹝三﹞《魏氏春秋》曰：“修字孝先。素有业行，著名西州。姜维劫之，修不为屈。刘禅以为左将军，修欲刺禅而不得亲近。每因庆贺，且拜且前；为禅左右所遏，事辄不克，故杀祎焉。”","attribution":"《魏氏春秋》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":264,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8cc9180077c660fd8f82","start":0,"end":83,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-p018-stabbing-account","section":"chapter-004","block":"b-5c35212fabc5cc58302f","layer":"pei","quote":"每因庆贺，且拜且前；为禅左右所遏，事辄不克，故杀祎焉。","attribution":"《魏氏春秋》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":264,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8cc9180077c660fd8f82","start":55,"end":82,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-p019","section":"chapter-004","block":"b-df60847a0d457632ff57","layer":"pei","quote":"臣松之以为：古之舍生取义者，必有理存焉。或感恩怀德，投命无悔；或利害有机，奋发以应会：诏所称聂政、介子是也。事非斯类，则陷乎妄作矣。魏之与蜀，虽为敌国；非有赵襄灭智之仇，燕丹危亡之急。且刘禅凡下之主，费祎中才之相；二人存亡，固无关于兴丧。郭修在魏，西州之男子耳。始获于蜀，既不能抗节不辱；于魏又无食禄之责，不为时主所使。而无故规规然糜身于非所，义无所加，功无所立，可谓“折柳樊圃”；其狂也且，此之谓也。","attribution":"裴松之论","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":265,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8cc9180077c660fd8f82","start":0,"end":201,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-p019-stabbing-critique","section":"chapter-004","block":"b-df60847a0d457632ff57","layer":"pei","quote":"臣松之以为：古之舍生取义者，必有理存焉。或感恩怀德，投命无悔；或利害有机，奋发以应会：诏所称聂政、介子是也。事非斯类，则陷乎妄作矣。魏之与蜀，虽为敌国；非有赵襄灭智之仇，燕丹危亡之急。且刘禅凡下之主，费祎中才之相；二人存亡，固无关于兴丧。郭修在魏，西州之男子耳。始获于蜀，既不能抗节不辱；于魏又无食禄之责，不为时主所使。而无故规规然糜身于非所，义无所加，功无所立，可谓“折柳樊圃”；其狂也且，此之谓也。","attribution":"裴松之论","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":265,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8cc9180077c660fd8f82","start":0,"end":201,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
