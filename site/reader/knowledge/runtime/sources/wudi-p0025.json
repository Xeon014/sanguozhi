ence":["wudi-q-p004"]},{"id":"wudi-m-p013-wudi-p0025","kind":"mention","text":"文中提及","evidence":["wudi-q-p013"]},{"id":"wudi-m-o005-wudi-p0025","kind":"mention","text":"文中提及","evidence":["wudi-q-o005"]},{"id":"wudi-m-p016-wudi-p0025","kind":"mention","text":"文中提及","evidence":["wudi-q-p016"]},{"id":"wudi-m-o007-wudi-p0025","kind":"mention","text":"文中提及","evidence":["wudi-q-o007"]},{"id":"wudi-m-p086-wudi-p0025","kind":"mention","text":"文中提及","evidence":["wudi-q-p086"]},{"id":"wudi-m-p148-wudi-p0025","kind":"allusion","text":"祖系或典故提及","evidence":["wudi-q-p148"]},{"id":"xianzhu-m-o005-wudi-p0025","kind":"allusion","text":"祖系或典故提及","evidence":["xianzhu-q-o005"]},{"id":"xianzhu-m-p006-wudi-p0025","kind":"allusion","text":"祖系或典故提及","evidence":["xianzhu-q-p006"]},{"id":"xianzhu-m-p013-wudi-p0025","kind":"allusion","text":"祖系或典故提及","evidence":["xianzhu-q-p013"]},{"id":"wendi-m-p032-wudi-p0025","kind":"allusion","text":"祖系或典故提及","evidence":["wendi-q-p032"]},{"id":"wendi-m-p059-wudi-p0025","kind":"allusion","text":"祖系或典故提及","evidence":["wendi-q-p059"]},{"id":"mingdi-m-p005-wudi-p0025","kind":"allusion","text":"祖系或典故提及","evidence":["mingdi-q-p005"]},{"id":"zhuge-m-o027-wudi-p0025","kind":"allusion","text":"祖系或典故提及","evidence":["zhuge-q-o027"]},{"id":"sunshi-m-o012-wudi-p0025","kind":"mention","text":"文中提及","evidence":["sunshi-q-o012"]},{"id":"dongyuan-m-p060-wudi-p0025","kind":"allusion","text":"祖系或典故提及","evidence":["dongyuan-q-p060"]},{"id":"dongyuan-m-o004-wudi-p0025","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o004"]},{"id":"dongyuan-m-o080-wudi-p0025","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o080"]}]}],"evidence":[{"id":"dongyuan-q-o004","section":"chapter-006","block":"b-84c2342f9d49bfb5684b","layer":"original","quote":"灵帝崩，少帝即位。大将军何进与司隶校尉袁绍，谋诛诸阉官，太后不从。进乃召卓，使将兵诣京师；并密令上书曰：“中常侍张让等窃幸乘宠〖1〗，浊乱海内。昔赵鞅兴晋阳之甲〖2〗，以逐君侧之恶。臣辄鸣钟鼓如洛阳〖3〗，即讨让等。”欲以胁迫太后。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":26,"anchor":null},"note_id":null,"start":0,"end":116},{"id":"dongyuan-q-o080","section":"chapter-006","block":"b-3c9a56ae7ad5e62f153a","layer":"original","quote":"以大将军掾为北军中候〖3〗。灵帝崩，代王叡为荆州刺史〖4〗。是时山东兵起，表亦合兵军襄阳〖5〗。﹝二﹞袁术之在南阳也，与孙坚合从，欲袭夺表州，使坚攻表。坚为流矢所中死，军败；术遂不能胜表。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":450,"anchor":null},"note_id":null,"start":0,"end":94},{"id":"dongyuan-q-p060","section":"chapter-006","block":"b-3c498933c751d69e13dd","layer":"pei","quote":"﹝一﹞《献帝春秋》曰：“卓欲废帝，谓绍曰：‘皇帝冲暗，非万乘之主。陈留王犹胜，今欲立之。人有少智，大或痴，亦知复何如？为当且尔。卿不见灵帝乎？念此令人愤毒！’绍曰：‘汉家君天下，四百许年，恩泽深渥，兆民戴之来久。今帝虽幼冲，未有不善宣闻天下；公欲废嫡立庶，恐众不从公议也。’卓谓绍曰：‘竖子！天下事岂不决我？我今为之，谁敢不从？尔谓董卓刀为不利乎！’绍曰：‘天下健者，岂唯董公！’引佩刀横揖而出。”","attribution":"《献帝春秋》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":228,"anchor":null},"note_id":"n-ca82cc66f8330aa4ef22","start":0,"end":199},{"id":"gongsuntao-q-17bf7b17b9e88027545e","section":"chapter-008","block":"b-9bdc891e043888f35a7b","layer":"pei","quote":"张角之反也，黑山、白波、黄龙、左校、牛角、五鹿、羝根、苦蝤、刘石、平汉、大洪、司隶、缘城、罗市、雷公、浮云、飞燕、白爵、杨凤、于毒等，各起兵，大者二三万，小者不减数千。灵帝不能讨，乃遣使拜杨凤为黑山校尉，领诸山贼，得举孝廉、计吏。后遂弥漫，不可复数","attribution":"裴注·九州春秋","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":248,"anchor":null},"note_id":"n-6c0b4fdbd0432367e810","start":12,"end":136},{"id":"gongsuntao-q-4f882b17b2b61cc45fe0","section":"chapter-008","block":"b-82cdaa660bd80f1d0c4b","layer":"pei","quote":"灵帝以虞清贫，特不使出钱","attribution":"裴注·魏书","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":45,"anchor":null},"note_id":"n-e4bf0c7a9d686fd81a68","start":86,"end":98},{"id":"gongsuntao-q-5652c4cb9ec407646a77","section":"chapter-008","block":"b-82cdaa660bd80f1d0c4b","layer":"pei","quote":"灵帝时，南宫灾；吏迁补州郡者，皆责助治宫钱；或一千万，或二千万；富者以私财办，或发民钱以备之；贫而清慎者，无以充调，或至自杀","attribution":"裴注·魏书","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":45,"anchor":null},"note_id":"n-e4bf0c7a9d686fd81a68","start":23,"end":85},{"id":"gongsuntao-q-5ed4fccca0551298138d","section":"chapter-008","block":"b-1a056961745d382769e6","layer":"pei","quote":"以虎贲中郎将袁绍为中军校尉，屯骑校尉鲍鸿为下军校尉，议郎曹操为典军校尉，赵融、冯芳为助军校尉，夏牟、淳于琼为左、右校尉","attribution":"裴注·灵帝纪","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":160,"anchor":null},"note_id":"n-4a0a0161a1cc664d25fd","start":11,"end":70},{"id":"gongsuntao-q-95e6846afe7e5fb96b3f","section":"chapter-008","block":"b-25201fdc1649528fb337","layer":"original","quote":"其后人众寝广，常山、赵郡、中山、上党、河内诸山谷，皆相通；其小帅孙轻、王当等，各以部众从燕，众至百万：号曰“黑山”。灵帝不能征，河北诸郡被其害","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":238,"anchor":null},"note_id":null,"start":0,"end":71},{"id":"gongsuntao-q-b799b6b36314a90febc3","section":"chapter-008","block":"b-5a06f5471508744b051d","layer":"original","quote":"灵帝末，天下乱，帝以所宠小黄门蹇硕为西园上军校尉〖2〗，军京都，欲以御四方。征天下豪杰，以为偏裨〖3〗；太祖及袁绍等皆为校尉，属之","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":144,"anchor":null},"note_id":null,"start":0,"end":65},{"id":"gongsuntao-q-dba8d768022566fbb809","section":"chapter-008","block":"b-5a06f5471508744b051d","layer":"original","quote":"灵帝崩，硕为何进所杀。杨复为进所遣，归本州募兵，得千余人。因留上党，击山贼","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":144,"anchor":null},"note_id":null,"start":91,"end":128},{"id":"liuermu-q-07971b1d941cb6c647a3","section":"chapter-031","block":"b-62d3ec73a6bf5de7f0ed","layer":"pei","quote":"焉受命而行，以道路不通，住荆州东界","attribution":"裴注·汉灵帝纪","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":34,"anchor":null},"note_id":"n-fd307a7978039f12ea65","start":95,"end":112},{"id":"liuermu-q-359d77e4bc9302127841","section":"chapter-031","block":"b-28361ed8be9ef5b608e1","layer":"original","quote":"焉谋得施，出为监军使者〖16〗，领益州牧，封阳城侯，当收俭治罪","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":3,"anchor":null},"note_id":null,"start":47,"end":78},{"id":"liuermu-q-61ce836922a05cc2aad9","section":"chapter-031","block":"b-62d3ec73a6bf5de7f0ed","layer":"pei","quote":"帝引见焉，宣示方略，加以赏赐","attribution":"裴注·汉灵帝纪","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":34,"anchor":null},"note_id":"n-fd307a7978039f12ea65","start":9,"end":23},{"id":"liuermu-q-63a830cbafaeabe66d38","section":"chapter-031","block":"b-62d3ec73a6bf5de7f0ed","layer":"pei","quote":"敕：‘焉为益州刺史。前刺史刘隽、郤俭，皆贪残放滥，取受狼藉；元元无聊，呼嗟充野。焉到，便收摄行法，以示万姓；勿令漏露，使痈疽决溃，为国生梗","attribution":"裴注·汉灵帝纪","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":34,"anchor":null},"note_id":"n-fd307a7978039f12ea65","start":24,"end":93},{"id":"liuermu-q-c096b536d557b6f9bb93","section":"chapter-031","block":"b-623bf969181385f8ee83","layer":"pei","quote":"于是灵帝征扶，即拜侍中","attribution":"裴注·益部耆旧传","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":35,"anchor":null},"note_id":"n-6499b8e5158463761833","start":226,"end":237},{"id":"lvzang-q-6650b0dcab8d51bb1961","section":"chapter-007","block":"b-53c0cb3176e9e7cfe412","layer":"original","quote":"灵帝崩，原将兵诣洛阳。﹝一﹞与何进谋诛诸黄门，拜执金吾","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":2,"anchor":null},"note_id":null,"start":0,"end":27},{"id":"mingdi-q-p005","section":"chapter-003","block":"b-4275bc6283624abd0772","layer":"pei","quote":"﹝一﹞《三辅决录》曰：“伯郎，凉州人。名不令休。其注曰：‘伯郎姓孟，名他。扶风人。’灵帝时，中常侍张让专朝政；让监奴典护家事。他仕不遂，乃尽以家财赂监奴，与共结亲。积年家业为之破尽，众奴皆惭，问他所欲。他曰：‘欲得卿曹拜耳。’奴被恩久，皆许诺。时宾客求见让者，门下车常数百乘，或累日不得通。他最后到，众奴伺其至，皆迎车而拜，径将他车独入。众人悉惊，谓他与让善，争以珍物遗他。他得之，尽以赂让；让大喜。他又以蒲桃酒一斛遗让，即拜凉州刺史。”","attribution":"裴注·三辅决录及其注","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":50,"anchor":null},"note_id":"n-680a01f5d7c24c678bdc","start":0,"end":219},{"id":"rensu-q-24f90298468dc8a641d0","section":"chapter-016","block":"b-c172c36c6f19e1d68402","layer":"pei","quote":"何进辅政，征用名士，以泰为尚书侍郎，加奉车都尉","attribution":"裴注·张璠《汉纪》","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":338,"anchor":null},"note_id":"n-011440cf6742ee5cb197","start":77,"end":100},{"id":"sunshi-q-o012","section":"chapter-046","block":"b-84cf62d2b7cd8fe12d65","layer":"original","quote":"灵帝崩〖1〗，卓擅朝政，横恣京城。诸州郡并兴义兵，欲以讨卓。﹝一﹞坚亦举兵。荆州刺史王叡，素遇坚无礼〖2〗；坚过，杀之。﹝二﹞比至南阳〖3〗，众数万人。南阳太守张咨闻军至，晏然自若。﹝三﹞坚以牛酒礼咨〖4〗。咨明日，亦答诣坚〖5〗。酒酣，长沙主簿入白坚〖6〗：“前移南阳〖7〗，而道路不治，军资不具〖8〗；请收主簿，推问意故〖9〗！”咨大惧，欲去；兵陈四周，不得出。有顷〖10〗，主簿复入白坚：“南阳太守稽停义兵，使贼不时讨；请收出，按军法从事〖11〗！”便牵咨于军门斩之〖12〗。郡中震栗，无求不获。﹝四﹞","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":81,"anchor":null},"note_id":null,"start":0,"end":254},{"id":"wendi-q-p032","section":"chapter-002","block":"b-672630f578f395129508","layer":"pei","quote":"癸丑，宣告群僚。督军御史中丞司马懿，侍御史郑浑、羊祕、鲍勋、武周等言：“令如左。伏读太史丞许芝上符命事。臣等闻有唐世衰，天命在虞；虞氏世衰，天命在夏。然则天地之灵，历数之运，去就之符，惟德所在。故孔子曰：‘凤鸟不至，河不出《图》，吾已矣夫！’今汉室衰，自安、和、冲、质以来，国统屡绝；桓、灵荒淫，禄去公室。此乃天命去就，非一朝一夕，其所由来久矣。殿下践阼，至德广被，格于上下；天人感应，符瑞并臻。考之旧史，未有若今日之盛。夫大人者，先天而天弗违；后天而奉天时。天时已至而犹谦让者，舜、禹所不为也；故生民蒙救济之惠，群类受育长之施。今八方颙颙，大小注望；皇天乃眷，神人同谋；十分而九以委质，义过周文，所谓过恭也。臣妾上下，伏所不安。”","attribution":"裴注·献帝传","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":144,"anchor":null},"note_id":"n-fc6f9c6942b5c231c294","start":0,"end":316},{"id":"wendi-q-p059","section":"chapter-002","block":"b-6c9c9fea1fc3cda9128d","layer":"pei","quote":"相国华歆、太尉贾诩、御史大夫王朗及九卿上言曰：“臣等被召，到，伏见太史丞许芝、左中郎将李伏所上图谶、符命，侍中刘廙等宣叙众心，人灵同谋。又汉朝知陛下圣化通于神明，圣德参于虞、夏；因瑞应之备至，听历数之所在；遂献玺绶，固让尊号。能言之伦，莫不抃舞！《河图》、《洛书》，天命瑞应；人事协于天时，民言协于天叙。而陛下性秉劳谦，体尚克让；明诏恳切，未肯听许；臣妾小人，莫不伊邑。臣等闻自古及今，有天下者不常在乎一姓：考以德势，则盛衰在乎强弱；论以终始，则废兴在乎期运。唐、虞历数，不在厥子而在舜、禹。舜、禹虽怀克让之意迫，群后执玉帛而朝之，兆民怀欣戴而归之，率土扬歌谣而咏之。故其守节之拘，不可得而常处；达节之权，不可得而久避；是以或逊位而不吝，或受禅而不辞；不吝者未必厌皇宠，不辞者未必渴帝祚：各迫天命而不得以已。既禅之后，则唐氏之子为宾于有虞，虞氏之胄为客于夏代；然则禅代之义，非独受之者实应天福，授之者亦与有余庆焉。汉自章、和之后，世多变故，稍以陵迟。洎乎孝灵，不恒其心；虐贤害仁，聚敛无度；政在嬖竖，视民如仇；遂令上天震怒，百姓从风如归；当时则四海鼎沸，既没则祸发宫廷；宠势并竭，帝室遂卑。若在帝舜之末节，犹择圣代而授之；荆人抱玉璞，犹思良工而刊之；况汉国既往，莫之能匡？推器移君，委之圣哲，固其宜也。汉朝委质，既愿礼禅之速定也。天祚率土，必将有主；主率土者，非陛下其孰能任之？所谓论德无与为比，考功无推让矣。天命不可久稽，民望不可久违。臣等\"\"，不胜大愿。伏请陛下割#谦之志，修受禅之礼；副人神之意，慰外内之愿。”","attribution":"裴注·献帝传","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":171,"anchor":null},"note_id":"n-fc6f9c6942b5c231c294","start":0,"end":658},{"id":"wudi-e-o005a-q","section":"chapter-001","block":"b-0c67d32d2029b25115d6","layer":"original","quote":"顷之，冀州刺史王芬、南阳许攸、沛国周旌等连结豪杰〖10〗，谋废灵帝〖11〗，立合肥侯〖12〗，以告太祖。太祖拒之，芬等遂败。﹝三﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":40,"anchor":null},"note_id":null,"start":0,"end":65},{"id":"wudi-e-o007a-q","section":"chapter-001","block":"b-50b64ee18ec5610ba8a9","layer":"original","quote":"会灵帝崩，太子即位〖3〗，太后临朝〖4〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":60,"anchor":null},"note_id":null,"start":0,"end":21},{"id":"wudi-e-p004a-q","section":"chapter-001","block":"b-e90db5467d9d5623caa7","layer":"pei","quote":"为司隶校尉。灵帝擢拜大司农、大鸿胪，代崔烈为太尉。","attribution":"《续汉书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":15,"anchor":null},"note_id":"n-32f37ed50b79cc722888","start":26,"end":51},{"id":"wudi-e-p013c-q","section":"chapter-001","block":"b-c8ebb5719c067c6530d1","layer":"pei","quote":"太祖上书陈武等正直而见陷害，奸邪盈朝，善人壅塞，其言甚切。灵帝不能用。","attribution":"《魏书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":38,"anchor":null},"note_id":"n-93b8bf4cd95e2ce6a347","start":65,"end":100},{"id":"wudi-e-p013d-q","section":"chapter-001","block":"b-c8ebb5719c067c6530d1","layer":"pei","quote":"是后诏书敕三府：举奏州县政理无效，民为作谣言者，免罢之。三公倾邪，皆希世见用，货赂并行。强者为怨，不见举奏；弱者守道，多被陷毁。太祖疾之。是岁，以灾异博问得失，因此复上书切谏，说三公所举奏专回避贵戚之意。奏上，天子感悟，以示三府，责让之；诸以谣言征者，皆拜议郎。是后政教日乱，豪猾益炽，多所摧毁。太祖知不可匡正，遂不复献言。","attribution":"《魏书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":38,"anchor":null},"note_id":"n-93b8bf4cd95e2ce6a347","start":100,"end":262},{"id":"wudi-e-p016b-q","section":"chapter-001","block":"b-27342ea0cc40a8b4e589","layer":"pei","quote":"灵帝欲北巡河间旧宅，芬等谋因此作难，上书言黑山贼攻劫郡县，求得起兵。会北方有赤气，东西竟天。太史上言‘当有阴谋，不宜北行’，帝乃止。敕芬罢兵，俄而征之；芬惧，自杀。","attribution":"《九州春秋》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":57,"anchor":null},"note_id":"n-4ada009fc136a7fb3275","start":86,"end":168},{"id":"wudi-q-b-b4fc0c31b702e7836bfb","section":"chapter-001","block":"b-b4fc0c31b702e7836bfb","layer":"modern","quote":"〖11〗灵帝：即刘宏（公元 156—189）。东汉皇帝，公元168 至 189 年在位。事详《后汉书》卷八《灵帝纪》。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":52,"anchor":null},"note_id":"n-2d50aaa27c865b0737d7","start":0,"end":59},{"id":"wudi-q-b-c8312ddce42041c69855","section":"chapter-001","block":"b-c8312ddce42041c69855","layer":"modern","quote":"〖14〗杀太后及弘农王：董卓杀何太后在中平六年（公元 189），但杀弘农王则在第二年的正月。见《后汉书》卷八《灵帝纪》、卷九《献帝纪》。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":76,"anchor":null},"note_id":"n-449cc7b499c8a1fee35c","start":0,"end":68},{"id":"wudi-q-o005","section":"chapter-001","block":"b-0c67d32d2029b25115d6","layer":"original","quote":"顷之，冀州刺史王芬、南阳许攸、沛国周旌等连结豪杰〖10〗，谋废灵帝〖11〗，立合肥侯〖12〗，以告太祖。太祖拒之，芬等遂败。﹝三﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":40,"anchor":null},"note_id":null,"start":0,"end":65},{"id":"wudi-q-o007","section":"chapter-001","block":"b-50b64ee18ec5610ba8a9","layer":"original","quote":"会灵帝崩，太子即位〖3〗，太后临朝〖4〗。大将军何进与袁绍谋诛宦官〖5〗，太后不听；进乃召董卓〖6〗，欲以胁太后。﹝一﹞卓未至而进见杀。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":60,"anchor":null},"note_id":null,"start":0,"end":68},{"id":"wudi-q-o008","section":"chapter-001","block":"b-9faaac9907c958c4d4d1","layer":"original","quote":"卓到，废帝为弘农王而立献帝〖7〗，京都大乱。卓表太祖为骁骑校尉〖8〗，欲与计事。太祖乃变易姓名，间行东归〖9〗；﹝二﹞出关〖10〗，过中牟〖11〗。为亭长所疑〖12〗，执诣县。邑中或窃识之〖13〗，为请得解。﹝三﹞卓遂杀太后及弘农王〖14〗。太祖至陈留〖15〗，散家财，合义兵，将以诛卓。冬十二月，始起兵于己吾〖16〗。﹝四﹞是岁，中平六年也。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":61,"anchor":null},"note_id":null,"start":0,"end":172},{"id":"wudi-q-p004","section":"chapter-001","block":"b-e90db5467d9d5623caa7","layer":"pei","quote":"﹝三﹞《续汉书》曰：“嵩字巨高。质性敦慎，所在忠孝。为司隶校尉。灵帝擢拜大司农、大鸿胪，代崔烈为太尉。黄初元年，追尊嵩曰太皇帝。”","attribution":"《续汉书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":15,"anchor":null},"note_id":"n-32f37ed50b79cc722888","start":0,"end":65},{"id":"wudi-q-p013","section":"chapter-001","block":"b-c8ebb5719c067c6530d1","layer":"pei","quote":"﹝四﹞《魏书》曰：“太祖从妹夫!强侯宋奇被诛，从坐，免官。后以能明古学，复征拜议郎。先是，大将军窦武、太傅陈蕃谋诛阉官，反为所害。太祖上书陈武等正直而见陷害，奸邪盈朝，善人壅塞，其言甚切。灵帝不能用。是后诏书敕三府：举奏州县政理无效，民为作谣言者，免罢之。三公倾邪，皆希世见用，货赂并行。强者为怨，不见举奏；弱者守道，多被陷毁。太祖疾之。是岁，以灾异博问得失，因此复上书切谏，说三公所举奏专回避贵戚之意。奏上，天子感悟，以示三府，责让之；诸以谣言征者，皆拜议郎。是后政教日乱，豪猾益炽，多所摧毁。太祖知不可匡正，遂不复献言。”","attribution":"《魏书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":38,"anchor":null},"note_id":"n-93b8bf4cd95e2ce6a347","start":0,"end":263},{"id":"wudi-q-p016","section":"chapter-001","block":"b-27342ea0cc40a8b4e589","layer":"pei","quote":"﹝三﹞司马彪《九州春秋》曰：“于是陈蕃子逸与术士平原襄楷，会于芬坐，楷曰：‘天文不利宦者，黄门、常侍（贵）〔真〕族灭矣。’逸喜。芬曰：‘若然者，芬愿驱除。’于是与攸等结谋。灵帝欲北巡河间旧宅，芬等谋因此作难，上书言黑山贼攻劫郡县，求得起兵。会北方有赤气，东西竟天。太史上言‘当有阴谋，不宜北行’，帝乃止。敕芬罢兵，俄而征之；芬惧，自杀。”","attribution":"《九州春秋》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":57,"anchor":null},"note_id":"n-4ada009fc136a7fb3275","start":0,"end":169},{"id":"wudi-q-p086","section":"chapter-001","block":"b-648d7c68dbec5a605916","layer":"pei","quote":"﹝三﹞卫恒《四体书势序》曰：“上谷王次仲，善隶书，始为楷法。至灵帝好书，世多能者，而师宜官为最。甚矜其能，每书，辄削焚其札。梁鹄乃益为版而饮之酒，候其醉而窃其札。鹄卒以攻书至选部尚书。于是公欲为洛阳令，鹄以为北部尉。鹄后依刘表。及荆州平，公募求鹄；鹄惧，自缚诣门。署军假司马，使在秘书，以勤书自效。公常悬著帐中，及以钉壁玩之，谓胜宜官。鹄字孟黄，安定人。魏宫殿题署，皆鹄书也。”","attribution":"卫恒《四体书势序》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":12,"anchor":null},"note_id":"n-cf8a0075075368325cde","start":0,"end":189},{"id":"wudi-q-p148","section":"chapter-001","block":"b-6ad4d93ffadfd8178d7c","layer":"pei","quote":"﹝五﹞《魏略》曰：“孙权上书称臣，称说天命。王以权书示外曰：‘是儿欲踞吾著炉火上邪！’侍中陈群、尚书桓阶奏曰：‘汉自安帝以来，政去公室，国统数绝。至于今者，唯有名号；尺土一民，皆非汉有。期运久已尽，历数久已终，非适今日也。是以桓、灵之间，诸明图纬者，皆言“汉行气尽，黄家当兴”。殿下应期，十分天下而有其九，以服事汉；群生注望，遐迩怨叹，是故孙权在远称臣。此天人之应，异气齐声。臣愚以为虞、夏不以谦辞，殷、周不吝诛放；畏天知命，无所与让也。’”","attribution":"《魏略》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":440,"anchor":null},"note_id":"n-b733ce3606187de56ac6","start":0,"end":221},{"id":"xianzhu-q-o005","section":"chapter-032","block":"b-8d72564c7b9f62ba311c","layer":"original","quote":"中山大商张世平、苏双等赀累千金〖3〗，贩马周旋于涿郡；见而异之，乃多与之金财。先主由是得用合徒众。灵帝末，黄巾起，州郡各举义兵。先主率其属，从校尉邹靖讨黄巾贼；有功，除安（喜）〔熹〕尉〖4〗。﹝一﹞督邮以公事到县，先主求谒，不通；直入缚督邮，杖二百；解绶系其颈着马枊〖5〗，﹝二﹞弃官亡命。﹝三﹞","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":19,"anchor":null},"note_id":null,"start":0,"end":148},{"id":"xianzhu-q-p006","section":"chapter-032","block":"b-2b7c82e9d245979f9448","layer":"pei","quote":"﹝四﹞《英雄记》云：“灵帝末年，备尝在京师。后与曹公俱还沛国，募召合众。会灵帝崩，天下大乱，备亦起军，从讨董卓。”","attribution":"《英雄记》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":36,"anchor":null},"note_id":"n-a2a236a06eca74260197","start":0,"end":57},{"id":"xianzhu-q-p013","section":"chapter-032","block":"b-4a52194b7e591242c0bd","layer":"pei","quote":"﹝一﹞臣松之按：董承，汉灵帝母董太后之侄，于献帝为丈人；盖古无丈人之名，故谓之“舅”也。","attribution":"裴松之按语","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":85,"anchor":null},"note_id":"n-0f86313f310eba82dfc8","start":0,"end":44},{"id":"zhonghua-q-00f9995539b4bea0a786","section":"chapter-013","block":"b-7f5b058236b9717cea61","layer":"original","quote":"灵帝崩，何进辅政，征河南郑泰、颍川荀攸及歆等。","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":149,"anchor":null},"note_id":null,"start":13,"end":36},{"id":"zhonghua-q-1039a35e7f4d1f4fe066","section":"chapter-013","block":"b-429397320d5327062c86","layer":"original","quote":"时王芬与豪杰谋废灵帝。语在《武纪》。﹝二﹞芬阴呼歆、洪共定计","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":148,"anchor":null},"note_id":null,"start":86,"end":116},{"id":"zhonghua-q-f982593720ca5c9cade0","section":"chapter-013","block":"b-429397320d5327062c86","layer":"original","quote":"洪欲行，歆止之曰：“夫废立大事，伊、霍之所难〖5〗。芬性疏而不武〖6〗，此必无成，而祸将及族。子其无往！”洪从歆言而止。后芬果败，洪乃服。","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":148,"anchor":null},"note_id":null,"start":117,"end":186},{"id":"zhuge-q-o027","section":"chapter-035","block":"b-f53c08ba28ed4fadd5f0","layer":"original","quote":"侍中、侍郎郭攸之、费祎、董允等〖17〗，此皆良实，志虑忠纯，是以先帝简拔以遗陛下〖18〗。愚以为宫中之事〖19〗，事无大小，悉以咨之，然后施行；必能裨补阙漏〖20〗，有所广益。将军向宠〖21〗，性行淑均〖22〗，晓畅军事；试用于昔日，先帝称之曰能，是以众议举宠为督〖23〗。愚以为营中之事〖24〗，悉以咨之；必能使行阵和睦〖25〗，优劣得所。亲贤臣，远小人，此先汉所以兴隆也〖26〗；亲小人，远贤臣，此后汉所以倾颓也。先帝在时，每与臣论此事，未尝不叹息痛恨于桓、灵也〖27〗。侍中、尚书、长史、参军〖28〗，此悉贞良死节之臣〖29〗，愿陛下亲之信之，则汉室之隆，可计日而待也。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":155,"anchor":null},"note_id":null,"start":0,"end":288}],"profiles":{},"directory_counts":{}}
