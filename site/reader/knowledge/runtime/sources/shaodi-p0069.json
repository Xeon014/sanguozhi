ource_order":[9,638,"P066c"],"order":2373},{"id":"xiahoucao-e-p066d","title":"桓范劝许允入见阮氏阮氏论德许允惭而敬之","accounts":[{"id":"xiahoucao-e-p066d-account","label":"《魏氏春秋》","text":"桓范劝许允入见阮氏阮氏论德许允惭而敬之","evidence":["xiahoucao-e-p066d-q"]}],"participants":[{"person":"shaodi-p0030","role":"劝和","evidence":["xiahoucao-e-p066d-q"]},{"person":"shaodi-p0069","role":"敬妻","evidence":["xiahoucao-e-p066d-q"]},{"person":"xiahoucao-p0120","role":"论德","evidence":["xiahoucao-e-p066d-q"]}],"place":null,"time":{"label":"许允仕明帝至死后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xiahoucao-e-p066d-q"]},"ordering_evidence":"xiahoucao-e-p066d-q","source_order":[9,638,"P066d"],"order":2374}],"persons":[{"id":"shaodi-p0069","name":"许允","evidence":["shaodi-q-p020","xiahoucao-q-o070","wgc-q0100"],"facts":[{"id":"xiahoucao-f0061","label":"字","text":"士宗","evidence":["xiahoucao-f0061-q"]}],"aliases":[{"text":"士宗","evidence":["xiahoucao-f0061-q"]}],"mentions":[{"id":"shaodi-m-p020-shaodi-p0069","kind":"mention","text":"文中提及","evidence":["shaodi-q-p020"]},{"id":"xiahoucao-m-o070-shaodi-p0069","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-o070"]},{"id":"xiahoucao-m-p034-shaodi-p0069","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-p034"]},{"id":"xiahoucao-m-o105-shaodi-p0069","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-o105"]},{"id":"xiahoucao-m-o106-shaodi-p0069","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-o106"]},{"id":"xiahoucao-m-o107-shaodi-p0069","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-o107"]},{"id":"xiahoucao-m-p063-shaodi-p0069","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-p063"]},{"id":"xiahoucao-m-p065-shaodi-p0069","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-p065"]},{"id":"xiahoucao-m-p066-shaodi-p0069","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-p066"]},{"id":"wgc-m-p015-shaodi-p0069","kind":"mention","text":"本段涉及许允","evidence":["wgc-q0100"]}]}],"evidence":[{"id":"chengguo-q-c59fa9616fded7055827","section":"chapter-014","block":"b-26e0c4210ec3844d5ae2","layer":"original","quote":"以随太傅司马宣王屯洛水浮桥，诛曹爽等，","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":453,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"huanchen-q-19d51fe544f347ced97a","section":"chapter-022","block":"b-a56712cdc2166428f216","layer":"original","quote":"爽等见收〖4〗，太傅司马宣王使毓行司隶校尉〖5〗，治其狱〖6〗","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":584,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":31,"offset_unit":"unicode_code_point"},{"id":"major-proof-q-gaoping-date","section":"chapter-009","block":"b-46588bc9fdcd4116f089","layer":"modern","quote":"〖1〗十年：正始十年（公元 249）。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":316,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5be1013409cc3f861402","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"major-proof-q-gaoping-year","section":"chapter-009","block":"b-a06b19e7658aef13c99d","layer":"original","quote":"十年正月〖1〗，车驾朝高平陵〖2〗。爽兄弟皆从。﹝一﹞","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":312,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":27,"offset_unit":"unicode_code_point"},{"id":"major-proof-q-jiangji","section":"chapter-014","block":"b-de6bc6fc5630d4049bee","layer":"pei","quote":"﹝四﹞《世语》曰：“初，济随司马宣王屯洛水浮桥；济书与曹爽，言宣王旨‘惟免官而已’。","attribution":"《世语》","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":472,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-3e463f8d129186dd38ad","start":0,"end":42,"offset_unit":"unicode_code_point"},{"id":"shaodi-e-o043a-q","section":"chapter-004","block":"b-b1c990928436e9ed43da","layer":"original","quote":"嘉平元年春正月，甲午〖1〗，车驾谒高平陵。﹝一﹞太傅司马宣王奏免大将军曹爽、爽弟中领军羲、武卫将军训、散骑常侍彦官〖2〗，以侯就第。戊戌〖3〗，有司奏收黄门张当付廷尉〖4〗；考实其辞，爽与谋不轨。又尚书丁谧、邓飏、何晏，司隶校尉毕轨，荆州刺史李胜，大司农桓范，皆与爽通奸谋〖5〗，夷三族。语在《爽传》。丙午〖6〗，大赦。丁未〖7〗，以太傅司马宣王为丞相；固让，乃止。﹝二﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":180,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":186,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-b-33155276d789f594176b","section":"chapter-004","block":"b-33155276d789f594176b","layer":"modern","quote":"〖13〗二年：嘉平二年（公元 250）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":198,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-235bc158a4eae2a0609a","start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o043","section":"chapter-004","block":"b-b1c990928436e9ed43da","layer":"original","quote":"嘉平元年春正月，甲午〖1〗，车驾谒高平陵。﹝一﹞太傅司马宣王奏免大将军曹爽、爽弟中领军羲、武卫将军训、散骑常侍彦官〖2〗，以侯就第。戊戌〖3〗，有司奏收黄门张当付廷尉〖4〗；考实其辞，爽与谋不轨。又尚书丁谧、邓飏、何晏，司隶校尉毕轨，荆州刺史李胜，大司农桓范，皆与爽通奸谋〖5〗，夷三族。语在《爽传》。丙午〖6〗，大赦。丁未〖7〗，以太傅司马宣王为丞相；固让，乃止。﹝二﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":180,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":186,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o046","section":"chapter-004","block":"b-8bc97b77985c9cc83eeb","layer":"original","quote":"二年夏五月〖13〗，以征西将军郭淮为车骑将军〖14〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":183,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":27,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-p020","section":"chapter-004","block":"b-93172b94722060ccd0d2","layer":"pei","quote":"﹝一﹞《世语》及《魏氏春秋》并云：“此秋，姜维寇陇右。时安东将军司马文王镇许昌，征还，击维。至京师，帝于平乐观以临军过。中领军许允与左右小臣谋：因文王辞，杀之；勒其众，以退大将军。已书诏于前。文王入，帝方食栗。优人云午等唱曰：‘青头鸡，青头鸡。’青头鸡者，鸭也。帝惧不敢发。文王引兵入城，景王因是谋废帝。”臣松之按《夏侯玄传》及《魏略》，许允此年春，与李丰事相连。丰既诛，即出允为镇北将军；未发，以放散官物收付廷尉；徙乐浪，追杀之。允此秋不得故为领军而建此谋。","attribution":"《世语》《魏氏春秋》及裴松之按","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":302,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1ef9a4b46b7aa031d2dd","start":0,"end":230,"offset_unit":"unicode_code_point"},{"id":"wgc-q0100","section":"chapter-028","block":"b-28be3c298c25640153cc","layer":"pei","quote":"而师以盛年在职，无疾托病，坐拥强兵，无有臣礼；朝臣非之，义士讥之，天下所闻。其罪一也；懿造计取贼，多舂军粮，克期有日。师为大臣，当除国难；又为人子，为当父业。哀声未绝而便罢息，为臣不忠，为子不孝。其罪二也；贼退过东关，坐自起众，三征同进，丧众败绩，历年军实，一旦而尽；致使贼来，天下骚动，死伤流离。其罪三也；贼举国悉众，号五十万，来向寿春，图诣洛阳；会太尉孚与臣等建计，乃杜塞要险，不与争锋，还固新城。淮南将士，冲锋履刃，昼夜相守，勤瘁百日，死者涂地；自魏有军以来，为难苦甚，莫过于此。而师遂意自由，不论封赏，权势自在，无所领录。其罪四也；故中书令李丰等，以师无人臣节，欲议退之。师知而请丰，其夕拉杀，载尸埋棺。丰等为大臣，帝王腹心，擅加酷暴，死无罪名，师有无君之心。其罪五也；懿每叹说齐王自堪人主，君臣之义定。奉事以来十有五载；始欲归政，按行武库，诏问禁兵不得妄出。师自知奸慝，人神所不祐，矫废君主，加之以罪。孚，师之叔父，性甚仁孝，追送齐王，悲不自胜。群臣皆怒而师怀忍，不顾大义。其罪六也；又故光禄大夫张缉，无罪而诛，夷其妻子；并及母后，逼恐至尊，强催督遣，临时哀愕，莫不伤痛；而师称庆，反以欢喜。其罪七也；陛下践阼，聪明神武，事经圣心，欲崇省约，天下闻之，莫不欢庆；而师不自改悔修复臣礼，而方征兵募士，毁坏官内，列侯自卫。陛下即阼，初不朝觐。陛下欲临幸师舍以省其疾，复拒不通，不奉法度。其罪八也；近者领军许允当为镇北，以厨钱给赐；而师举奏加辟，虽云流徙，道路饿杀，天下闻之，莫不哀伤。其罪九也；三方之守，一朝阙废，多选精兵，以自营卫；五营领兵，阙而不补，多载器杖，充聚本营，天下所闻，人怀愤怨，讹言盈路，以疑海内。其罪十也；多休守兵，以占高第，以空虚四表，欲擅强势，以逞奸心；募取屯田，加其复赏，阻兵安忍，坏乱旧法。合聚诸藩王公以著邺，欲悉诛之，一旦举事废主。天不长恶，使目肿，不成。其罪十一也。","attribution":"毌丘俭文钦表","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":118,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6d2d8c49ddd3275ba483","start":0,"end":801,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o066a-q","section":"chapter-009","block":"b-a06b19e7658aef13c99d","layer":"original","quote":"十年正月〖1〗，车驾朝高平陵〖2〗。爽兄弟皆从。﹝一﹞","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":312,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":27,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o067a-q","section":"chapter-009","block":"b-f84db3982bc003dbcc59","layer":"original","quote":"宣王部勒兵马，先据武库。遂出屯洛水浮桥〖3〗，奏爽曰〖4〗：“臣昔从辽东还，先帝诏陛下、秦王及臣升御床，把臣臂，深以后事为念。臣言：‘二祖亦属臣，以后事为念，此自陛下所见；无所忧苦〖5〗，万一有不如意，臣当以死奉明诏！’黄门令董箕等，才人侍疾者〖6〗，皆所闻知。今大将军爽，背弃顾命〖7〗，败乱国典；内则僭拟〖8〗，外专威权；破坏诸营〖9〗，尽据禁兵；群官要职，皆置所亲；殿中宿卫，历世旧人皆复斥出，欲置新人以树私计；根据盘互〖10〗，纵恣日甚。外既如此，又以黄门张当为都监〖11〗，专共交关〖12〗；看察至尊，候伺神器〖13〗；离间二宫〖14〗，伤害骨肉。天下汹汹〖15〗，人怀危惧；陛下但为寄坐〖16〗，岂得久安？此非先帝诏陛下及臣升御床之本意也！臣虽朽迈，敢忘往言？昔赵高极意〖17〗，秦氏以灭；吕、霍早断〖18〗，汉祚永世。此乃陛下之大鉴，臣受命之时也！太尉臣济、尚书令臣孚等〖19〗，皆以‘爽为有无君之心，兄弟不宜典兵宿卫’，奏永宁宫〖20〗。皇太后令敕臣：‘如奏施行。’臣辄敕主者及黄门令：‘罢爽、羲、训吏兵〖21〗，以侯就第；不得逗留，以稽车驾〖22〗；敢有稽留，便以军法从事！’臣辄力疾将兵，屯洛水浮桥〖23〗，伺察非常〖24〗。”﹝二﹞","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":313,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":527,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o070a-q","section":"chapter-009","block":"b-a0a0e5805493de5e57b4","layer":"original","quote":"侍中许允、尚书陈泰说爽，使早自归罪。爽于是遣允、泰诣宣王，归罪请死；乃通宣王奏事。﹝一﹞遂免爽兄弟，以侯还第。﹝二﹞","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":346,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":58,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o105a-q","section":"chapter-009","block":"b-a0de07acf695b3572fea","layer":"original","quote":"初，中领军高阳许允，与丰、玄亲善。先是，有诈作尺一诏书〖1〗：以玄为大将军，允为太尉；共录尚书事。有何人天未明乘马，以诏板付允门吏〖2〗，曰：“有诏！”因便驰走。允即投书烧之，不以（开）〔关〕呈司马景王〖3〗。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":624,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":105,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o106a-q","section":"chapter-009","block":"b-0769a884f01b70a317cc","layer":"original","quote":"后丰等事觉，徙允为镇北将军，假节，督河北诸军事。未发〖4〗，以放散官物〖5〗，收付廷尉；徙乐浪，道死。﹝一﹞","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":625,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":54,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o107b-q","section":"chapter-009","block":"b-b62dfdbf80e8ceed005a","layer":"original","quote":"允友人同郡崔赞，亦尝以处世太盛戒允云。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":626,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":98,"end":117,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-p034b-q","section":"chapter-009","block":"b-09d9efa3d0503db50c7a","layer":"pei","quote":"宣王使许允、陈泰解语爽，蒋济亦与书达宣王之旨；又使爽所信殿中校尉尹大目谓爽‘唯免官而已’，以洛水为誓。爽信之，罢兵。","attribution":"《世语》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":354,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-396397b55629f744e16c","start":63,"end":121,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-p063b-q","section":"chapter-009","block":"b-a28301d33c65814e2e54","layer":"pei","quote":"太傅薨，许允谓玄曰：‘无复忧矣！’玄叹曰：‘士宗！卿何不见事乎？此人犹能以通家年少遇我；子元、子上，不吾容也！","attribution":"《魏氏春秋》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":622,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-31bf80f2d3548114eff9","start":46,"end":101,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-p065a-q","section":"chapter-009","block":"b-f1ab0fb4442e4014299b","layer":"pei","quote":"允字士宗。世冠族。父据，仕历典农校尉、郡守。允少与同郡崔赞，俱发名于冀州，召入军。明帝时，为尚书选曹郎，与陈国袁侃对；同坐职事，皆收送狱。诏旨严切，当有死者；正直者为重。允谓侃曰：‘卿，功臣之子，法应八议，不忧死也。’侃知其指，乃为受重。允刑竟，复吏，出为郡守。稍迁为侍中，尚书，中领军。","attribution":"《魏略》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":636,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0f3b23485549690803dc","start":10,"end":154,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-p065b-q","section":"chapter-009","block":"b-f1ab0fb4442e4014299b","layer":"pei","quote":"允闻李丰等被收，欲往见大将军。已出门，回遑不定；中道还取裤，丰等已收讫。大将军闻允前遽，怪之曰：‘我自收丰等，不知士大夫何为匆匆乎！’是时朝臣遽者多耳，而众人咸以为意在允也。会镇北将军刘静卒，朝廷以允代静。已受节传，出止外舍。","attribution":"《魏略》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":636,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0f3b23485549690803dc","start":154,"end":267,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-p065c-q","section":"chapter-009","block":"b-f1ab0fb4442e4014299b","layer":"pei","quote":"大将军与允书曰：‘镇北虽少事，而都典一方。念足下震华鼓，建朱节，历本州；此所谓著绣昼行也！’允心甚悦，与台中相闻，欲易其鼓吹、旌旗。其兄子素，颇闻众人说允前见嫌意，戒允：‘但当趋耳！用是为邪？’允曰：‘卿俗士不解。我以荣国耳，故求之。’帝以允当出，乃诏会群臣。群臣皆集，帝特引允以自近。允前为侍中，顾当与帝别，涕泣歔欷。会讫，罢出，诏促允，令去。","attribution":"《魏略》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":636,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0f3b23485549690803dc","start":267,"end":440,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-p065d-q","section":"chapter-009","block":"b-f1ab0fb4442e4014299b","layer":"pei","quote":"会有司奏允，前擅以厨钱谷乞诸俳及其官属，故遂收送廷尉；考问竟，（故）减死，徙边。允以嘉平六年秋徙，妻子不得自随；行道未到，以其年冬死。","attribution":"《魏略》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":636,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0f3b23485549690803dc","start":440,"end":507,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-p066a-q","section":"chapter-009","block":"b-b3fb00b23d11cf366efe","layer":"pei","quote":"允为吏部郎，选郡守。明帝疑其所用非次，召入，将加罪。允妻阮氏跣出，谓曰：‘明主可以理夺，难以情求！’允颔之而入。帝怒诘之，允对曰：‘某郡太守虽限满文书先至，年限在后；〔某守虽后，年〕限在前。’帝前，取事视之，乃释遣出。望其衣败，曰：‘清吏也。’赐之。","attribution":"《魏氏春秋》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":637,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0f3b23485549690803dc","start":9,"end":134,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-p066b-q","section":"chapter-009","block":"b-b3fb00b23d11cf366efe","layer":"pei","quote":"允之出为镇北也，喜谓其妻曰：‘吾知免矣！’妻曰：‘祸见于此，何免之有！’允善相印；将拜，以印不善，使更刻之；如此者三。允曰：‘印虽始成，而已被辱。’问送印者，果怀之而坠于厕。","attribution":"《魏氏春秋》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":637,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0f3b23485549690803dc","start":134,"end":221,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-p066c-q","section":"chapter-009","block":"b-b3fb00b23d11cf366efe","layer":"pei","quote":"《相印书》曰：‘相印法本出陈长文，长文以语韦仲将。印工杨利，从仲将受法，以语许士宗。利以法术占吉凶，十可中八九。仲将问长文：“从谁得法？”长文曰：“本出汉世，有《相印》、《相笏经》，又有《鹰经》、《牛经》、《马经》。印工宗养，以法语程申伯，是故有一十二家相法传于世。","attribution":"《魏氏春秋》引《相印书》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":637,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0f3b23485549690803dc","start":221,"end":354,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-p066d-q","section":"chapter-009","block":"b-b3fb00b23d11cf366efe","layer":"pei","quote":"允妻阮氏，贤明而丑，允始见愕然；交礼毕，无复入意。妻遣婢觇之，云：‘有客姓桓。’妻曰：‘是必桓范，将劝使入也。’既而范果劝之。允入，须臾便起，妻捉裾留之。允顾谓妇曰：‘妇有四德，卿有其几？’妇曰：‘新妇所乏唯容。士有百行，君有其几？’（许）〔允〕曰：‘皆备！’妇曰：‘士有百行，以德为首。君好色不好德，何谓皆备？’允有惭色，知其非凡，遂雅相亲重。","attribution":"《魏氏春秋》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":637,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0f3b23485549690803dc","start":356,"end":529,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-f0061-q","section":"chapter-009","block":"b-f1ab0fb4442e4014299b","layer":"pei","quote":"允字士宗","attribution":"《魏略》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":636,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0f3b23485549690803dc","start":10,"end":14,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-o070","section":"chapter-009","block":"b-a0a0e5805493de5e57b4","layer":"original","quote":"侍中许允、尚书陈泰说爽，使早自归罪。爽于是遣允、泰诣宣王，归罪请死；乃通宣王奏事。﹝一﹞遂免爽兄弟，以侯还第。﹝二﹞","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":346,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":58,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-o105","section":"chapter-009","block":"b-a0de07acf695b3572fea","layer":"original","quote":"初，中领军高阳许允，与丰、玄亲善。先是，有诈作尺一诏书〖1〗：以玄为大将军，允为太尉；共录尚书事。有何人天未明乘马，以诏板付允门吏〖2〗，曰：“有诏！”因便驰走。允即投书烧之，不以（开）〔关〕呈司马景王〖3〗。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":624,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":105,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-o106","section":"chapter-009","block":"b-0769a884f01b70a317cc","layer":"original","quote":"后丰等事觉，徙允为镇北将军，假节，督河北诸军事。未发〖4〗，以放散官物〖5〗，收付廷尉；徙乐浪，道死。﹝一﹞","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":625,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":54,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-o107","section":"chapter-009","block":"b-b62dfdbf80e8ceed005a","layer":"original","quote":"清河王经，亦与允俱称冀州名士。甘露中为尚书〖6〗，坐高贵乡公事诛。始，经为郡守，经母谓经曰：“汝田家子，今仕至二千石。物太过不祥〖7〗，可以止矣！”经不能从。历二州刺史，司隶校尉，终以致败。﹝二﹞允友人同郡崔赞，亦尝以处世太盛戒允云。﹝三﹞","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":626,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":120,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-p034","section":"chapter-009","block":"b-09d9efa3d0503db50c7a","layer":"pei","quote":"﹝一﹞干宝《晋书》曰：“桓范出赴爽，宣王谓蒋济曰：‘智囊往矣！’济曰：‘范则智矣；驽马恋栈豆，爽必不能用也。’”《世语》曰：“宣王使许允、陈泰解语爽，蒋济亦与书达宣王之旨；又使爽所信殿中校尉尹大目谓爽‘唯免官而已’，以洛水为誓。爽信之，罢兵。”《魏氏春秋》曰：“爽既罢兵，曰：‘我不失作富家翁。’范哭曰：‘曹子丹，佳人；生汝兄弟，犊耳！何图今日，坐汝等族灭矣！’”","attribution":"干宝《晋书》；《世语》；《魏氏春秋》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":354,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-396397b55629f744e16c","start":0,"end":182,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-p063","section":"chapter-009","block":"b-a28301d33c65814e2e54","layer":"pei","quote":"《魏氏春秋》曰：“初，夏侯霸将奔蜀，呼玄欲与之俱。玄曰：‘吾岂苟存自客于寇虏乎？’遂还京师。太傅薨，许允谓玄曰：‘无复忧矣！’玄叹曰：‘士宗！卿何不见事乎？此人犹能以通家年少遇我；子元、子上，不吾容也！’玄尝著《乐毅》、《张良》及《本无肉刑论》，辞旨通远，咸传于世。玄之执也，（卫将军）〔安东将军〕司马文王流涕请之。大将军曰：‘卿忘会赵司空葬乎？’先是，司空赵俨薨，大将军兄弟会葬，宾客以百数；玄时后至，众宾客咸越席而迎，大将军由是恶之。”","attribution":"《魏氏春秋》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":622,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-31bf80f2d3548114eff9","start":0,"end":220,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-p065","section":"chapter-009","block":"b-f1ab0fb4442e4014299b","layer":"pei","quote":"﹝一﹞《魏略》曰：“允字士宗。世冠族。父据，仕历典农校尉、郡守。允少与同郡崔赞，俱发名于冀州，召入军。明帝时，为尚书选曹郎，与陈国袁侃对；同坐职事，皆收送狱。诏旨严切，当有死者；正直者为重。允谓侃曰：‘卿，功臣之子，法应八议，不忧死也。’侃知其指，乃为受重。允刑竟，复吏，出为郡守。稍迁为侍中，尚书，中领军。允闻李丰等被收，欲往见大将军。已出门，回遑不定；中道还取裤，丰等已收讫。大将军闻允前遽，怪之曰：‘我自收丰等，不知士大夫何为匆匆乎！’是时朝臣遽者多耳，而众人咸以为意在允也。会镇北将军刘静卒，朝廷以允代静。已受节传，出止外舍。大将军与允书曰：‘镇北虽少事，而都典一方。念足下震华鼓，建朱节，历本州；此所谓著绣昼行也！’允心甚悦，与台中相闻，欲易其鼓吹、旌旗。其兄子素，颇闻众人说允前见嫌意，戒允：‘但当趋耳！用是为邪？’允曰：‘卿俗士不解。我以荣国耳，故求之。’帝以允当出，乃诏会群臣。群臣皆集，帝特引允以自近。允前为侍中，顾当与帝别，涕泣歔欷。会讫，罢出，诏促允，令去。会有司奏允，前擅以厨钱谷乞诸俳及其官属，故遂收送廷尉；考问竟，（故）减死，徙边。允以嘉平六年秋徙，妻子不得自随；行道未到，以其年冬死。”","attribution":"《魏略》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":636,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0f3b23485549690803dc","start":0,"end":508,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-p066","section":"chapter-009","block":"b-b3fb00b23d11cf366efe","layer":"pei","quote":"《魏氏春秋》曰：“允为吏部郎，选郡守。明帝疑其所用非次，召入，将加罪。允妻阮氏跣出，谓曰：‘明主可以理夺，难以情求！’允颔之而入。帝怒诘之，允对曰：‘某郡太守虽限满文书先至，年限在后；〔某守虽后，年〕限在前。’帝前，取事视之，乃释遣出。望其衣败，曰：‘清吏也。’赐之。允之出为镇北也，喜谓其妻曰：‘吾知免矣！’妻曰：‘祸见于此，何免之有！’允善相印；将拜，以印不善，使更刻之；如此者三。允曰：‘印虽始成，而已被辱。’问送印者，果怀之而坠于厕。《相印书》曰：‘相印法本出陈长文，长文以语韦仲将。印工杨利，从仲将受法，以语许士宗。利以法术占吉凶，十可中八九。仲将问长文：“从谁得法？”长文曰：“本出汉世，有《相印》、《相笏经》，又有《鹰经》、《牛经》、《马经》。印工宗养，以法语程申伯，是故有一十二家相法传于世。”’允妻阮氏，贤明而丑，允始见愕然；交礼毕，无复入意。妻遣婢觇之，云：‘有客姓桓。’妻曰：‘是必桓范，将劝使入也。’既而范果劝之。允入，须臾便起，妻捉裾留之。允顾谓妇曰：‘妇有四德，卿有其几？’妇曰：‘新妇所乏唯容。士有百行，君有其几？’（许）〔允〕曰：‘皆备！’妇曰：‘士有百行，以德为首。君好色不好德，何谓皆备？’允有惭色，知其非凡，遂雅相亲重。生二子：奇、猛，少有令闻。允后为景王所诛，门生走入告其妇。妇正在机，神色不变，曰：‘早知尔耳。’门生欲藏其子，女曰：‘无预诸儿事。’后移居墓所，景王遣钟会看之；若才艺德能及父，当收。儿以语母，母答：‘汝等虽佳，才具不多。率胸怀与会语，便自无忧；不须极哀，会止便止。又可多少问朝事。’儿从之。会反命，具以状对；卒免其祸，皆母之教也。虽会之识鉴，而输贤妇之智也。果庆及后嗣，追封子孙而已。”","attribution":"《魏氏春秋》引《相印书》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":637,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0f3b23485549690803dc","start":0,"end":722,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-p066-alternative-death","section":"chapter-009","block":"b-b3fb00b23d11cf366efe","layer":"pei","quote":"允后为景王所诛，门生走入告其妇。妇正在机，神色不变，曰：‘早知尔耳。","attribution":"《魏氏春秋》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":637,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0f3b23485549690803dc","start":542,"end":576,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
