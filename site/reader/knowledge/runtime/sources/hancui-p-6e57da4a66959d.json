e_id":"n-d880aa7224b10e5780cc","start":102,"end":124,"offset_unit":"unicode_code_point"},{"id":"hancui-q-c442b672a8f383a60b20","section":"chapter-024","block":"b-06df52ef50d0f265d90d","layer":"pei","quote":"寿妻贾充女。充无后，以寿子谧为嗣。弱冠为秘书监、侍中，性骄佚而才出（众）〔寿〕。","attribution":"裴注·晋诸公赞","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":41,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-d880aa7224b10e5780cc","start":62,"end":102,"offset_unit":"unicode_code_point"},{"id":"hancui-q-ff21eabe1e0959b16bcc","section":"chapter-024","block":"b-06df52ef50d0f265d90d","layer":"pei","quote":"《晋诸公赞》曰：“自暨以下，世治素业；寿能敦尚家风，性尤忠厚。早历清职，惠帝践阼，为散骑常侍，迁守河南尹。病卒，赠骠骑将军。寿妻贾充女。充无后，以寿子谧为嗣。弱冠为秘书监、侍中，性骄佚而才出（众）〔寿〕。少子蔚，亦有器望，并为赵王伦所诛。韩氏遂灭。”","attribution":"裴注（引书见原文，待主审复核）","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":41,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-d880aa7224b10e5780cc","start":0,"end":125,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
