PS/Text/titlepage_0048.xhtml","index":159,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8e6bd7e61642e82153d5","start":103,"end":122,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-295e09bf41500d52e2dc","section":"chapter-021","block":"b-60b2a95c39de4bb70858","layer":"pei","quote":"大将军司马文王常保持之，卒以寿终","attribution":"裴注·魏氏春秋","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":159,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8e6bd7e61642e82153d5","start":462,"end":478,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-3b7ca0058061d9035142","section":"chapter-021","block":"b-60b2a95c39de4bb70858","layer":"pei","quote":"后为尚书郎、曹爽参军，以疾归田里","attribution":"裴注·魏氏春秋","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":159,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8e6bd7e61642e82153d5","start":86,"end":102,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-3e36c0e444f5f7c53bbe","section":"chapter-021","block":"b-60b2a95c39de4bb70858","layer":"pei","quote":"﹝二﹞籍字嗣宗。《魏氏春秋》曰：“藉旷达不羁，不拘礼俗。性至孝，居丧虽不率常检，而毁几至灭性。兖州刺史王昶请与相见，终日不得与言；昶叹赏之，自以不能测也。太尉蒋济闻而辟之。后为尚书郎、曹爽参军，以疾归田里。岁余，爽诛，太傅及大将军乃以为从事中郎。后朝论以其名高，欲显崇之，籍以世多故，禄仕而已。闻步兵校尉缺，厨多美酒，营人善酿酒，求为校尉；遂纵酒昏酣，遗落世事。尝登广武，观楚、汉战处，乃叹曰：‘时无英才，使竖子成名乎！’时率意独驾，不由径路；车迹所穷，辄恸哭而返。籍少时尝游苏门山，苏门山有隐者，莫知名姓；有竹实数斛、臼杵而已。籍从之，与谈太古无为之道，及论五帝三王之义；苏门生萧然曾不经听。籍乃对之长啸，清韵响亮；苏门生逌尔而笑。籍既降，苏门生亦啸，若鸾风之音焉。至是，籍乃假苏门先生之论以寄所怀。其歌曰：‘日没不周西，月出丹渊中。阳精蔽不见，阴光代为雄。亭亭在须臾，厌厌将复隆。富贵俯仰间，贫贱何必终？’又叹曰：‘天地解兮六合开，星辰陨兮日月颓，我腾而上将何怀？’籍口不论人过，而自然高迈，故为礼法之士何曾等深所仇疾。大将军司马文王常保持之，卒以寿终。”子浑，字长成。《世语》曰：“浑以闲澹寡欲，知名京邑。为太子庶子。早卒。”","attribution":"裴注引《魏氏春秋》","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":159,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8e6bd7e61642e82153d5","start":0,"end":516,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-43f08281b546f0937cab","section":"chapter-021","block":"b-f8ff70bf10d41f3e849e","layer":"pei","quote":"康寓居河内之山阳县，与之游者，未尝见其喜愠之色。与陈留阮籍、河内山涛、河（南）〔内〕向秀、籍兄子咸、琅邪王戎、沛人刘伶，相与友善，游于竹林，号为‘七贤","attribution":"裴注·魏氏春秋","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":163,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-70ad920837cbb5d19ddf","start":9,"end":84,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-4d7b714ac788770a173f","section":"chapter-021","block":"b-60b2a95c39de4bb70858","layer":"pei","quote":"籍少时尝游苏门山，苏门山有隐者，莫知名姓；有竹实数斛、臼杵而已。籍从之，与谈太古无为之道，及论五帝三王之义；苏门生萧然曾不经听","attribution":"裴注·魏氏春秋","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":159,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8e6bd7e61642e82153d5","start":233,"end":296,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-5b409b5e9bc84ef18fd8","section":"chapter-021","block":"b-60b2a95c39de4bb70858","layer":"pei","quote":"籍乃对之长啸，清韵响亮；苏门生逌尔而笑。籍既降，苏门生亦啸，若鸾风之音焉","attribution":"裴注·魏氏春秋","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":159,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8e6bd7e61642e82153d5","start":297,"end":333,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-a64106ed1d63da15b968","section":"chapter-021","block":"b-60b2a95c39de4bb70858","layer":"pei","quote":"时率意独驾，不由径路；车迹所穷，辄恸哭而返","attribution":"裴注·魏氏春秋","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":159,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8e6bd7e61642e82153d5","start":211,"end":232,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-b441d2871e4eae8