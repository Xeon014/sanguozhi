{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-o005a","title":"张世平苏双资助刘备聚众","accounts":[{"id":"xianzhu-e-o005a-account","label":"《先主传》正文","text":"张世平、苏双在涿郡贩马，给刘备金财，刘备因此得以聚集徒众。","evidence":["xianzhu-e-o005a-q"]}],"participants":[{"person":"xianzhu-p0013","role":"资助","evidence":["xianzhu-e-o005a-q"]},{"person":"xianzhu-p0014","role":"资助","evidence":["xianzhu-e-o005a-q"]},{"person":"liu-bei","role":"聚众","evidence":["xianzhu-e-o005a-q"]}],"place":{"text":"涿郡","evidence":["xianzhu-e-o005a-q"]},"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xianzhu-e-o005a-q"]},"source_order":[32,20,"O005a"],"order":6496}],"persons":[{"id":"xianzhu-p0013","name":"张世平","evidence":["xianzhu-q-o005"],"facts":[],"aliases":[],"mentions":[{"id":"xianzhu-m-o005-xianzhu-p0013","kind":"mention","text":"文中提及","evidence":["xianzhu-q-o005"]}]}],"evidence":[{"id":"xianzhu-e-o005a-q","section":"chapter-032","block":"b-8d72564c7b9f62ba311c","layer":"original","quote":"中山大商张世平、苏双等赀累千金〖3〗，贩马周旋于涿郡；见而异之，乃多与之金财。先主由是得用合徒众。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":19,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":49,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o005","section":"chapter-032","block":"b-8d72564c7b9f62ba311c","layer":"original","quote":"中山大商张世平、苏双等赀累千金〖3〗，贩马周旋于涿郡；见而异之，乃多与之金财。先主由是得用合徒众。灵帝末，黄巾起，州郡各举义兵。先主率其属，从校尉邹靖讨黄巾贼；有功，除安（喜）〔熹〕尉〖4〗。﹝一﹞督邮以公事到县，先主求谒，不通；直入缚督邮，杖二百；解绶系其颈着马枊〖5〗，﹝二﹞弃官亡命。﹝三﹞","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":19,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":148,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
