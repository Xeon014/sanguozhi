ff1","liusima-q-76ffd1a30b45aa121968","liusima-q2-43495d28ff83bbd096c5","liusima-q2-71240b398921a557f42d"],"facts":[{"id":"liusima-f2-35616cbad3dfdc446dd4","text":"《晋阳秋》记其为车骑将军、开府、荆州刺史，假节，都督荆、交、广州诸军事，封宣城公。","evidence":["liusima-q2-43495d28ff83bbd096c5"]},{"id":"liusima-f2-e000526d9ed16169adb7","text":"《晋诸公赞》记其子璠为北中郎将。","evidence":["liusima-q2-71240b398921a557f42d"]}],"aliases":[],"mentions":[]}],"evidence":[{"id":"liusima-q-2b9c9725e35c15d665b6","section":"chapter-015","block":"b-e34c7ccc13d48177cae3","layer":"pei","quote":"其在江、汉，值王室多难，得专命一方，尽其器能。推诚群下，厉以公义；简刑狱，务农桑。每有兴发，手书郡国，丁宁款密。故莫不感悦，颠倒奔赴，咸曰：‘得刘公一纸书，贤于十部从事也","attribution":"裴注·晋阳秋","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":41,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-619a9166bae3298d065c","start":110,"end":195,"offset_unit":"unicode_code_point"},{"id":"liusima-q-746f7923c660b3411184","section":"chapter-015","block":"b-e34c7ccc13d48177cae3","layer":"pei","quote":"弘曰：‘夫统天下者当与天下同心，治一国者当与一国推实。吾统荆州十郡，安得十女婿，然后为治哉！’乃表：‘陟姻亲，旧制不得相监临事；初勋，宜见酬。’报听之","attribution":"裴注·晋阳秋","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":41,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-619a9166bae3298d065c","start":276,"end":351,"offset_unit":"unicode_code_point"},{"id":"liusima-q-76ffd1a30b45aa121968","section":"chapter-015","block":"b-de1bd4b331d408c3e960","layer":"pei","quote":"于时天下虽乱，荆州安全。弘有刘景升保有江、汉之志，不附大傅司马越。越甚衔之，会弘病卒","attribution":"裴注·晋诸公赞","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":42,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-619a9166bae3298d065c","start":9,"end":51,"offset_unit":"unicode_code_point"},{"id":"liusima-q-84906577404b280be13f","section":"chapter-015","block":"b-e34c7ccc13d48177cae3","layer":"pei","quote":"征士武陵伍朝，高尚其事；牙门将皮初，有勋江汉。弘上朝为零陵太守，初为襄阳太守。诏书以襄阳显郡，初资名轻浅，以弘婿夏侯陟，为襄阳","attribution":"裴注·晋阳秋","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":41,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-619a9166bae3298d065c","start":212,"end":275,"offset_unit":"unicode_code_point"},{"id":"liusima-q-8b45d584a2992e492ff1","section":"chapter-015","block":"b-e34c7ccc13d48177cae3","layer":"pei","quote":"广汉太守辛冉以天子蒙尘，四方云扰，进从横计于弘。弘怒，斩之，时人莫不称善","attribution":"裴注·晋阳秋","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":41,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-619a9166bae3298d065c","start":359,"end":395,"offset_unit":"unicode_code_point"},{"id":"liusima-q-f1e9998e0d775fb148b8","section":"chapter-015","block":"b-e34c7ccc13d48177cae3","layer":"pei","quote":"时帝在长安，命弘得选用宰、守","attribution":"裴注·晋阳秋","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":41,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-619a9166bae3298d065c","start":197,"end":211,"offset_unit":"unicode_code_point"},{"id":"liusima-q2-43495d28ff83bbd096c5","section":"chapter-015","block":"b-e34c7ccc13d48177cae3","layer":"pei","quote":"﹝一﹞《晋阳秋》曰：“刘弘，字叔和，熙之弟也。弘与晋世祖同年，居同里，以旧恩屡登显位。自靖至弘，世不旷名，而有政事才。晋西朝之末，弘为车骑（大）将军，开府，荆州刺史，假节，都督荆、交、广州诸军事，封（新城郡）〔宣城〕公。其在江、汉，值王室多难，得专命一方，尽其器能。推诚群下，厉以公义；简刑狱，务农桑。每有兴发，手书郡国，丁宁款密。故莫不感悦，颠倒奔赴，咸曰：‘得刘公一纸书，贤于十部从事也。’时帝在长安，命弘得选用宰、守。征士武陵伍朝，高尚其事；牙门将皮初，有勋江汉。弘上朝为零陵太守，初为襄阳太守。诏书以襄阳显郡，初资名轻浅，以弘婿夏侯陟，为襄阳。弘曰：‘夫统天下者当与天下同心，治一国者当与一国推实。吾统荆州十郡，安得十女婿，然后为治哉！’乃表：‘陟姻亲，旧制不得相监临事；初勋，宜见酬。’报听之。众益服其公当。广汉太守辛冉以天子蒙尘，四方云扰，进从横计于弘。弘怒，斩之，时人莫不称善。”","attribution":"裴注·晋阳秋","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":41,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-619a9166bae3298d065c","start":0,"end":397,"offset_unit":"unicode_code_point"},{"id":"liusima-q2-71240b398921a557f42d","section":"chapter-015","block":"b-de1bd4b331d408c3e960","layer":"pei","quote":"《晋诸公赞》曰：“于时天下虽乱，荆州安全。弘有刘景升保有江、汉之志，不附大傅司马越。越甚衔之，会弘病卒。子璠，北中郎将。”","attribution":"裴注·晋诸公赞","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":42,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-619a9166bae3298d065c","start":0,"end":61,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
