ll},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":47,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-p039a-q","section":"chapter-032","block":"b-41aefcb279e2501eff36","layer":"pei","quote":"辟公府，入为尚书选部郎。董卓欲以所私，并充台阁，戬拒不听。卓怒，召戬欲杀之；观者皆为戬惧，而戬自若。及见卓，引辞正色，陈说是非；卓虽凶戾，屈而谢之。迁平陵令。","attribution":"《典略》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":198,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b5ff5b5f2ba2531e20bb","start":207,"end":286,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-p039b-q","section":"chapter-032","block":"b-41aefcb279e2501eff36","layer":"pei","quote":"故将王允被害，莫敢近者，戬弃官收敛之。","attribution":"《典略》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":198,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b5ff5b5f2ba2531e20bb","start":286,"end":305,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-p039c-q","section":"chapter-032","block":"b-41aefcb279e2501eff36","layer":"pei","quote":"三辅乱，戬客荆州，刘表以为宾客。","attribution":"《典略》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":198,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b5ff5b5f2ba2531e20bb","start":305,"end":321,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-p039d-q","section":"chapter-032","block":"b-41aefcb279e2501eff36","layer":"pei","quote":"曹公平荆州，执戬手曰：‘何相见之晚也！’遂辟为掾。","attribution":"《典略》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":198,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b5ff5b5f2ba2531e20bb","start":321,"end":346,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-p039e-q","section":"chapter-032","block":"b-41aefcb279e2501eff36","layer":"pei","quote":"后为五官将司马，相国钟繇长史。年六十余卒。”","attribution":"《典略》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":198,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b5ff5b5f2ba2531e20bb","start":346,"end":368,"offset_unit":"unicode_code_point"},{"id":"xianzhu-f0017-q","section":"chapter-032","block":"b-41aefcb279e2501eff36","layer":"pei","quote":"赵戬，字叔茂，京兆长陵人也。","attribution":"《典略》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":198,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b5ff5b5f2ba2531e20bb","start":168,"end":182,"offset_unit":"unicode_code_point"},{"id":"xianzhu-f0018-q","section":"chapter-032","block":"b-41aefcb279e2501eff36","layer":"pei","quote":"赵戬，字叔茂，京兆长陵人也。","attribution":"《典略》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":198,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b5ff5b5f2ba2531e20bb","start":168,"end":182,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o024","section":"chapter-032","block":"b-c857386227851cc86ab3","layer":"original","quote":"（曹公南征表）〔及曹公南征〕，会表卒，﹝二﹞子琮代立〖2〗，遣使请降。先主屯樊，不知曹公猝至；至宛乃闻之，遂将其众去。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":108,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":59,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-p039","section":"chapter-032","block":"b-41aefcb279e2501eff36","layer":"pei","quote":"﹝二﹞《傅子》曰：“初，刘备袭蜀，丞相掾赵戬曰：‘刘备其不济乎？拙于用兵，每战则败；奔亡不暇，何以图人？蜀虽小区，险固四塞；独守之国，难猝并也。’征士傅幹曰：‘刘备宽仁有度，能得人死力。诸葛亮，达治知变，正而有谋，而为之相；张飞、关羽勇而有义，皆万人之敌，而为之将：此三人者，皆人杰也。以备之略，三杰佐之。何为不济也！’”《典略》曰：“赵戬，字叔茂，京兆长陵人也。质而好学，言称《诗》、《书》；爱恤于人，不论疏密。辟公府，入为尚书选部郎。董卓欲以所私，并充台阁，戬拒不听。卓怒，召戬欲杀之；观者皆为戬惧，而戬自若。及见卓，引辞正色，陈说是非；卓虽凶戾，屈而谢之。迁平陵令。故将王允被害，莫敢近者，戬弃官收敛之。三辅乱，戬客荆州，刘表以为宾客。曹公平荆州，执戬手曰：‘何相见之晚也！’遂辟为掾。后为五官将司马，相国钟繇长史。年六十余卒。”","attribution":"《傅子》；《典略》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":198,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b5ff5b5f2ba2531e20bb","start":0,"end":368,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
