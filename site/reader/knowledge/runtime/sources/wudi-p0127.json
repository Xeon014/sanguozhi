evidence":["wudi-e-o030a-q"]},{"person":"wudi-p0096","role":"叛迎","evidence":["wudi-e-o030a-q"]},{"person":"wudi-p0088","role":"被迎","evidence":["wudi-e-o030a-q"]},{"person":"wudi-p0100","role":"固守","evidence":["wudi-e-o030a-q"]},{"person":"wudi-p0101","role":"固守","evidence":["wudi-e-o030a-q"]},{"person":"cao-cao","role":"回援","evidence":["wudi-e-o030a-q"]},{"person":"wudi-p0127","role":"以兵据城者","evidence":["rensu-q-1e383e5b762f5fbdf776"]},{"person":"lizang-p0029","role":"叛","evidence":["lizang-q-bae6339aadb9077cb558"]},{"person":"lizang-p0053","role":"叛","evidence":["lizang-q-bae6339aadb9077cb558"]}],"place":{"text":"兖州、鄄城、范、东阿","evidence":["wudi-e-o030a-q"]},"time":{"label":"兴平元年","year":194,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o030a-q","wudi-q-o028","wudi-q-b-927979d68d5dacfd36fe"],"chronology":"wudi-y194","dating_review":{"anchor":"wudi-q-o028","basis":"兴平元年","reviewed":true}},"source_order":[1,218,"O030a"],"order":99},{"id":"wudi-e-o047a","title":"曹操采枣祗韩浩议兴屯田","accounts":[{"id":"wudi-e-o047a-account","label":"正文","text":"曹操采用枣祗、韩浩等建议，开始推行屯田。","evidence":["wudi-e-o047a-q"]},{"id":"yuanzhang-a-d42fab507b5ae25f2704","label":"正文","text":"袁涣白太祖屯田宜顺民之意，太祖从之百姓大悦","evidence":["yuanzhang-q-eb7264c567ccb419c713"]},{"id":"yuanzhang-a-3e75e5d635aa703b34c1","label":"正文","text":"太祖欲广置屯田使国渊典其事，渊屡陈损益相土处民计民置吏明功课之法，五年中仓廪丰实","evidence":["yuanzhang-q-5f59791b711af6d8f180"]},{"id":"rensu-a-8e3cf9ba2f243df149f6","label":"正文","text":"枣祗建议建置屯田（时岁饥旱军食不足）","evidence":["rensu-q-eb157a835335512305f2"]},{"id":"rensu-a-c404988ef1b393cc63e0","label":"裴注·魏武故事","text":"破黄巾定许后得贼资业，当兴立屯田；时议者皆言当\"计牛输谷\"，佃科以定","evidence":["rensu-q-2896b220ddbfd8398ae0"]},{"id":"rensu-a-5cca460d954317d4f4a5","label":"裴注·魏武故事","text":"施行后枣祗白以为\"僦牛输谷，大收不增谷，有水旱灾除，大不便\"，反覆来说；曹操犹以为当如故","evidence":["rensu-q-dc1d182c299189b9db4f"]},{"id":"rensu-a-69ed3de8172192459920","label":"裴注·魏武故事","text":"曹操不知所从，使枣祗与荀令君（荀彧）议之","evidence":["rensu-q-8cce79dcc70862fa26e7"]},{"id":"rensu-a-1a4648ca7d7ec45f93f8","label":"裴注·魏武故事","text":"故军祭酒侯声云\"科取官牛，为官田计，如祗议：于官便，于客不便\"，怀此以疑令君","evidence":["rensu-q-115cc53b14dac13a0107"]},{"id":"rensu-a-dfd2a5b3c2ea67d47ba8","label":"裴注·魏武故事","text":"枣祗犹自信，据计画还白，执分田之术","evidence":["rensu-q-a023a92ed4ca3239e318"]},{"id":"rensu-a-0e924c1ae4e5ef74cf24","label":"裴注·魏武故事","text":"曹操然之，使枣祗为屯田都尉，施设田业；其时岁则大收，后遂因此大田，丰足军用","evidence":["rensu-q-c7c7db2c71c7099618b5"]}],"participants":[{"person":"cao-cao","role":"采议推行","evidence":["wudi-e-o047a-q"]},{"person":"wudi-p0127","role":"建议","evidence":["wudi-e-o047a-q"]},{"person":"wudi-p0128","role":"建议","evidence":["wudi-e-o047a-q"]},{"person":"wudi-p0308","role":"白太祖民安土重迁，乐之者乃取，不欲者勿强","evidence":["yuanzhang-q-eb7264c567ccb419c713"]},{"person":"wendi-p0054","role":"屡陈损益，相土处民，计民置吏，明功课之法，五年中仓廪丰实百姓竞劝乐业","evidence":["yuanzhang-q-5f59791b711af6d8f180"]},{"person":"wudi-p0100","role":"与议之令君；被惑之议者","evidence":["rensu-q-8cce79dcc70862fa26e7","rensu-q-115cc53b14dac13a0107"]},{"person":"rensu-p0009","role":"进言者","evidence":["rensu-q-115cc53b14dac13a0107"]}],"place":null,"time":{"label":"建安元年","year":196,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o047a-q","wudi-q-o040","wudi-q-b-16a5462151b1cfe5142d"],"chronology":"wudi-y196","dating_review":{"anchor":"wudi-q-o040","basis":"建安元年","reviewed":true}},"source_order":[1,285,"O047a"],"order":130},{"id":"chengguo-e-o083","title":"枣祗薛悌与昱卒完三城","accounts":[{"id":"chengguo-a-ec2b051cacff11315edb","label":"正文","text":"枣祗薛悌与昱卒完三城","evidence":["chengguo-q-051652e52eec9071a1d8"]}],"participants":[{"person":"wudi-p0127","role":"东阿令、已率厉吏民拒城坚守","evidence":["chengguo-q-051652e52eec9071a1d8"]},{"person":"zhangle-p0008","role":"兖州从事、与昱协谋","evidence":["chengguo-q-051652e52eec9071a1d8"]},{"person":"wudi-p0101","role":"至东阿、卒完三城以待太祖","evidence":["chengguo-q-051652e52eec9071a1d8"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["chengguo-q-051652e52eec9071a1d8"]},"ordering_evidence