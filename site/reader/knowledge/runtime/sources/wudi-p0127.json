{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o030a","title":"兖州叛迎吕布与曹操回援","accounts":[{"id":"wudi-e-o030a-account","label":"正文","text":"张邈、陈宫迎吕布，荀彧、程昱等保住鄄城、范、东阿，曹操引军回援。","evidence":["wudi-e-o030a-q"]},{"id":"gongsuntao-a-2c8e71cf04fe46d5a083","label":"正文","text":"会张邈叛迎吕布太祖还击布","evidence":["gongsuntao-q-3b5ac4c18010d359fc37"]},{"id":"rensu-a-ab5b0d2a1c09d7ccaced","label":"裴注·魏武故事","text":"吕布之乱兖州皆叛，惟范、东阿完在，由枣祗以兵据城之力","evidence":["rensu-q-1e383e5b762f5fbdf776"]},{"id":"lizang-a-0866d82dd9cffd8d19c5","label":"正文","text":"兖州乱，徐翕毛晖皆叛","evidence":["lizang-q-bae6339aadb9077cb558"]}],"participants":[{"person":"wudi-p0062","role":"叛迎","evidence":["wudi-e-o030a-q"]},{"person":"wudi-p0096","role":"叛迎","evidence":["wudi-e-o030a-q"]},{"person":"wudi-p0088","role":"被迎","evidence":["wudi-e-o030a-q"]},{"person":"wudi-p0100","role":"固守","evidence":["wudi-e-o030a-q"]},{"person":"wudi-p0101","role":"固守","evidence":["wudi-e-o030a-q"]},{"person":"cao-cao","role":"回援","evidence":["wudi-e-o030a-q"]},{"person":"wudi-p0127","role":"以兵据城者","evidence":["rensu-q-1e383e5b762f5fbdf776"]},{"person":"lizang-p0029","role":"叛","evidence":["lizang-q-bae6339aadb9077cb558"]},{"person":"lizang-p0053","role":"叛","evidence":["lizang-q-bae6339aadb9077cb558"]}],"place":{"text":"兖州、鄄城、范、东阿","evidence":["wudi-e-o030a-q"]},"time":{"label":"兴平元年","year":194,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o030a-q","wudi-q-o028","wudi-q-b-927979d68d5dacfd36fe"],"chronology":"wudi-y194","dating_review":{"anchor":"wudi-q-o028","basis":"兴平元年","reviewed":true}},"source_order":[1,218,"O030a"],"order":99},{"id":"wudi-e-o047a","title":"曹操采枣祗韩浩议兴屯田","accounts":[{"id":"wudi-e-o047a-account","label":"正文","text":"曹操采用枣祗、韩浩等建议，开始推行屯田。","evidence":["wudi-e-o047a-q"]},{"id":"yuanzhang-a-d42fab507b5ae25f2704","label":"正文","text":"袁涣白太祖屯田宜顺民之意，太祖从之百姓大悦","evidence":["yuanzhang-q-eb7264c567ccb419c713"]},{"id":"yuanzhang-a-3e75e5d635aa703b34c1","label":"正文","text":"太祖欲广置屯田使国渊典其事，渊屡陈损益相土处民计民置吏明功课之法，五年中仓廪丰实","evidence":["yuanzhang-q-5f59791b711af6d8f180"]},{"id":"rensu-a-8e3cf9ba2f243df149f6","label":"正文","text":"枣祗建议建置屯田（时岁饥旱军食不足）","evidence":["rensu-q-eb157a835335512305f2"]},{"id":"rensu-a-c404988ef1b393cc63e0","label":"裴注·魏武故事","text":"破黄巾定许后得贼资业，当兴立屯田；时议者皆言当\"计牛输谷\"，佃科以定","evidence":["rensu-q-2896b220ddbfd8398ae0"]},{"id":"rensu-a-5cca460d954317d4f4a5","label":"裴注·魏武故事","text":"施行后枣祗白以为\"僦牛输谷，大收不增谷，有水旱灾除，大不便\"，反覆来说；曹操犹以为当如故","evidence":["rensu-q-dc1d182c299189b9db4f"]},{"id":"rensu-a-69ed3de8172192459920","label":"裴注·魏武故事","text":"曹操不知所从，使枣祗与荀令君（荀彧）议之","evidence":["rensu-q-8cce79dcc70862fa26e7"]},{"id":"rensu-a-1a4648ca7d7ec45f93f8","label":"裴注·魏武故事","text":"故军祭酒侯声云\"科取官牛，为官田计，如祗议：于官便，于客不便\"，怀此以疑令君","evidence":["rensu-q-115cc53b14dac13a0107"]},{"id":"rensu-a-dfd2a5b3c2ea67d47ba8","label":"裴注·魏武故事","text":"枣祗犹自信，据计画还白，执分田之术","evidence":["rensu-q-a023a92ed4ca3239e318"]},{"id":"rensu-a-0e924c1ae4e5ef74cf24","label":"裴注·魏武故事","text":"曹操然之，使枣祗为屯田都尉，施设田业；其时岁则大收，后遂因此大田，丰足军用","evidence":["rensu-q-c7c7db2c71c7099618b5"]}],"participants":[{"person":"cao-cao","role":"采议推行","evidence":["wudi-e-o047a-q"]},{"person":"wudi-p0127","role":"建议","evidence":["wudi-e-o047a-q"]},{"person":"wudi-p0128","role":"建议","evidence":["wudi-e-o047a-q"]},{"person":"wudi-p0308","role":"白太祖民安土重迁，乐之者乃取，不欲者勿强","evidence":["yuanzhang-q-eb7264c567ccb419c713"]},{"person":"wendi-p0054","role":"屡陈损益，相土处民，计民置吏，明功课之法，五年中仓廪丰实百姓竞劝乐业","evidence":["yuanzhang-q-5f59791b711af6d8f180"]},{"person":"wudi-p0100","role":"与议之令君；被惑之议者","evidence":["rensu-q-8cce79dcc70862fa26e7","rensu-q-115cc53b14dac13a0107"]},{"person":"rensu-p0009","role":"进言者","evidence":["rensu-q-115cc53b14dac13a0107"]}],"place":null,"time":{"label":"建安元年","year":196,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o047a-q","wudi-q-o040","wudi-q-b-16a5462151b1cfe5142d"],"chronology":"wudi-y196","dating_review":{"anchor":"wudi-q-o040","basis":"建安元年","reviewed":true}},"source_order":[1,285,"O047a"],"order":130},{"id":"chengguo-e-o083","title":"枣祗薛悌与昱卒完三城","accounts":[{"id":"chengguo-a-ec2b051cacff11315edb","label":"正文","text":"枣祗薛悌与昱卒完三城","evidence":["chengguo-q-051652e52eec9071a1d8"]}],"participants":[{"person":"wudi-p0127","role":"东阿令、已率厉吏民拒城坚守","evidence":["chengguo-q-051652e52eec9071a1d8"]},{"person":"zhangle-p0008","role":"兖州从事、与昱协谋","evidence":["chengguo-q-051652e52eec9071a1d8"]},{"person":"wudi-p0101","role":"至东阿、卒完三城以待太祖","evidence":["chengguo-q-051652e52eec9071a1d8"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["chengguo-q-051652e52eec9071a1d8"]},"ordering_evidence":"chengguo-q-051652e52eec9071a1d8","source_order":[14,15,342],"order":2965},{"id":"rensu-e-o140","title":"袁绍在冀州贪枣祗欲得之，祗深附托于曹操","accounts":[{"id":"rensu-a-c98076919102405b1cb9","label":"裴注·魏武故事","text":"袁绍在冀州贪枣祗欲得之，祗深附托于曹操","evidence":["rensu-q-6bf9d98613d749137f8e"]}],"participants":[{"person":"wudi-p0127","role":"深附托者","evidence":["rensu-q-6bf9d98613d749137f8e"]},{"person":"wudi-p0052","role":"欲得枣祗者","evidence":["rensu-q-6bf9d98613d749137f8e"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["rensu-q-6bf9d98613d749137f8e"]},"ordering_evidence":"rensu-q-6bf9d98613d749137f8e","source_order":[16,18,38],"order":3387},{"id":"rensu-e-o141","title":"曹操使枣祗领东阿令","accounts":[{"id":"rensu-a-1875f40fe06ea60d40ac","label":"裴注·魏武故事","text":"曹操使枣祗领东阿令","evidence":["rensu-q-85688ef535701e9ba1ed"]}],"participants":[{"person":"cao-cao","role":"任命者","evidence":["rensu-q-85688ef535701e9ba1ed"]},{"person":"wudi-p0127","role":"受任东阿令者","evidence":["rensu-q-85688ef535701e9ba1ed"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["rensu-q-85688ef535701e9ba1ed"]},"ordering_evidence":"rensu-q-85688ef535701e9ba1ed","source_order":[16,18,60],"order":3388},{"id":"rensu-e2-wei016-061","title":"后大军粮乏，得东阿以继，枣祗之功也","accounts":[{"id":"rensu-a-5870198cc98217ea9ff4","label":"裴注·魏武故事","text":"后大军粮乏，得东阿以继，枣祗之功也","evidence":["rensu-q-904c26b8b709cabf889d"]}],"participants":[{"person":"wudi-p0127","role":"据东阿供粮有功","evidence":["rensu-q-904c26b8b709cabf889d"]},{"person":"cao-cao","role":"大军得东阿续粮","evidence":["rensu-q-904c26b8b709cabf889d"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本篇独立行动，未继承范围不同的旧事件日期。","evidence":["rensu-q-904c26b8b709cabf889d"]},"ordering_evidence":"rensu-q-904c26b8b709cabf889d","related_events":[{"event":"wudi-e-o033a","type":"related","evidence":["rensu-q-904c26b8b709cabf889d","wudi-e-o033a-q"]}],"order":3389},{"id":"rensu-e-o150","title":"枣祗兴屯田之功，不幸早没，追赠以郡，犹未副之","accounts":[{"id":"rensu-a-3e16c45c1520550edf94","label":"裴注·魏武故事","text":"枣祗兴屯田之功，不幸早没，追赠以郡，犹未副之","evidence":["rensu-q-82360a980898884c8245"]},{"id":"rensu-a-3c7b8625cb72d0fb549f","label":"裴注·魏武故事","text":"令重思之：枣祗宜受封，稽留至今孤之过也；子处中宜加封爵，以祀祗为不朽之事","evidence":["rensu-q-e1aeaf51801e923bd9b1"]}],"participants":[{"person":"wudi-p0127","role":"早没受追赠者；宜受封者","evidence":["rensu-q-82360a980898884c8245","rensu-q-e1aeaf51801e923bd9b1"]},{"person":"cao-cao","role":"下令者","evidence":["rensu-q-e1aeaf51801e923bd9b1"]},{"person":"rensu-p0036","role":"宜加封爵者","evidence":["rensu-q-e1aeaf51801e923bd9b1"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["rensu-q-82360a980898884c8245","rensu-q-e1aeaf51801e923bd9b1"]},"ordering_evidence":"rensu-q-82360a980898884c8245","source_order":[16,18,335],"order":3390}],"persons":[{"id":"wudi-p0127","name":"枣祗","evidence":["wudi-q-o047","chengguo-q-051652e52eec9071a1d8","rensu-q-eb157a835335512305f2","rensu-q-6bf9d98613d749137f8e","rensu-q-85688ef535701e9ba1ed","rensu-q-1e383e5b762f5fbdf776","rensu-q-904c26b8b709cabf889d","rensu-q-dc1d182c299189b9db4f","rensu-q-8cce79dcc70862fa26e7","rensu-q-a023a92ed4ca3239e318","rensu-q-c7c7db2c71c7099618b5","rensu-q-82360a980898884c8245","rensu-q-e1aeaf51801e923bd9b1","rensu-q2-ae0971a600422cb42bea"],"facts":[{"id":"rensu-f2-5ec573b9439aaa1def0a","text":"《魏武故事》载枣祗子处中；《文士传》记祗本姓棘，先人为避难改枣氏，孙据字道彦为晋冀州刺史，据子嵩为散骑常侍，嵩兄腆为襄阳太守。","evidence":["rensu-q2-ae0971a600422cb42bea"]}],"aliases":[],"mentions":[{"id":"wudi-m-o047-wudi-p0127","kind":"mention","text":"文中提及","evidence":["wudi-q-o047"]}]}],"evidence":[{"id":"chengguo-q-051652e52eec9071a1d8","section":"chapter-014","block":"b-ef6e6d390c285fe0d80e","layer":"original","quote":"昱至东阿，东阿令枣祗已率厉吏民，拒城坚守。又兖州从事薛悌，与昱协谋，卒完三城，以待太祖","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":14,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":342,"end":385,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-3b5ac4c18010d359fc37","section":"chapter-008","block":"b-d4288ccd4470bb04ff2a","layer":"original","quote":"会张邈叛迎吕布，太祖还击布","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":126,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":28,"end":41,"offset_unit":"unicode_code_point"},{"id":"lizang-q-bae6339aadb9077cb558","section":"chapter-018","block":"b-eb5fdf6d1207ecfe4545","layer":"original","quote":"兖州乱，翕、晖皆叛","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":49,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":98,"end":107,"offset_unit":"unicode_code_point"},{"id":"rensu-q-115cc53b14dac13a0107","section":"chapter-016","block":"b-f7bf4f39640b854492a0","layer":"pei","quote":"时故军祭酒侯声云：‘科取官牛，为官田计，如祗议：于官便，于客不便。’声怀此云云，以疑令君","attribution":"裴注·魏武故事","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":17,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-60f466d9d92c616eb2c9