{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"santizhu059-e-sr-ji-yi-marquis","title":"五凤中封孙基吴侯、孙壹宛陵侯","accounts":[{"id":"santizhu059-a-2a3c3e2f782b979aff13","label":"正文","text":"霸二子基、壹；五凤中，封基为吴侯，壹宛陵侯","evidence":["santizhu059-q-7a92e76bd762d4070e31"]}],"participants":[{"person":"santizhu-p0157","role":"受封吴侯","evidence":["santizhu059-q-7a92e76bd762d4070e31"]},{"person":"santizhu-p0190","role":"受封宛陵侯","evidence":["santizhu059-q-7a92e76bd762d4070e31"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"未由相邻段落推算纪年；原文时间表达保留在来源引句中。","evidence":["santizhu059-q-7a92e76bd762d4070e31"]},"ordering_evidence":"santizhu059-q-7a92e76bd762d4070e31","source_order":[59,229,0],"order":10485},{"id":"santizhu059-e-sr-ji-horse-theft","title":"孙基盗御马付狱、孙亮问刁玄议罪、赦宫中基得免","accounts":[{"id":"santizhu059-a-dbf892b4b69d965eddb4","label":"正文","text":"基侍孙亮在内，太平二年盗乘御马收付狱；亮问侍中刁玄盗乘御马罪，玄对科应死并为基请哀原；亮论法不阿亲亲，从玄言赦宫中，基得免","evidence":["santizhu059-q-1118e5e9a01d19c98f6f"]}],"participants":[{"person":"santizhu-p0157","role":"盗乘御马被收付狱，因赦得免","evidence":["santizhu059-q-1118e5e9a01d19c98f6f"]},{"person":"wuzhu-p0128","role":"问罪于刁玄并赦宫中","evidence":["santizhu059-q-1118e5e9a01d19c98f6f"]},{"person":"santizhu-p0021","role":"对以科应死并请哀原、言赦制","evidence":["santizhu059-q-1118e5e9a01d19c98f6f"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"未由相邻段落推算纪年；原文时间表达保留在来源引句中。","evidence":["santizhu059-q-1118e5e9a01d19c98f6f"]},"ordering_evidence":"santizhu059-q-1118e5e9a01d19c98f6f","source_order":[59,230,0],"order":10486},{"id":"santizhu059-e-o059a","title":"孙皓即位后削基壹爵土并徙会稽","accounts":[{"id":"santizhu059-a-f06735fccc22494177b0","label":"正文","text":"孙皓即位后削基壹爵土并徙会稽","evidence":["santizhu059-q-28d45c0550f0e85b10a3"]}],"participants":[{"person":"shaodi-p0162","role":"即位后追旧隙、削基壹爵土并徙乌伤","evidence":["santizhu059-q-28d45c0550f0e85b10a3"]},{"person":"santizhu-p0157","role":"被削爵土并徙乌伤","evidence":["santizhu059-q-28d45c0550f0e85b10a3"]},{"person":"santizhu-p0159","role":"与孙基、孙壹同徙乌伤","evidence":["santizhu059-q-28d45c0550f0e85b10a3"]},{"person":"santizhu-p0190","role":"被削爵土并徙会稽乌伤（孙霸子，非降魏之孙壹）","evidence":["santizhu059-q-28d45c0550f0e85b10a3"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"未由相邻段落推算纪年；原文时间表达保留在来源引句中。","evidence":["santizhu059-q-28d45c0550f0e85b10a3"]},"ordering_evidence":"santizhu059-q-28d45c0550f0e85b10a3","source_order":[59,59,0],"order":10487}],"persons":[{"id":"santizhu-p0157","name":"孙基","evidence":["santizhu059-q-28d45c0550f0e85b10a3"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[{"id":"santizhu059-q-1118e5e9a01d19c98f6f","section":"chapter-059","block":"b-67c9b574ae699782ffe5","layer":"original","quote":"基侍孙亮在内。太平二年，盗乘御马，收付狱。亮问侍中刁玄曰：“盗乘御马，罪云何〖16〗？”玄对曰：“科应死〖17〗。然鲁王早终，惟陛下哀原之。”亮曰：“法者，天下所共，何得阿以亲亲故邪〖18〗！当思惟可以释此者，奈何以情相迫乎？”玄曰：“旧〖19〗，赦有大小；或天下，亦有千里、五百里赦：随意所及。”亮曰：“解人不当尔邪〖20〗！”乃赦宫中，基以得免。","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":229,"anchor":null},"note_id":null,"start":0,"end":175},{"id":"santizhu059-q-28d45c0550f0e85b10a3","section":"chapter-059","block":"b-e25487f8fc885f1b335b","layer":"original","quote":"孙皓即位，追和、霸旧隙，削基、壹爵土，与祖母谢姬俱徙会稽乌伤县","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":230,"anchor":null},"note_id":null,"start":0,"end":31},{"id":"santizhu059-q-7a92e76bd762d4070e31","section":"chapter-059","block":"b-18d8c74ed7ff009b854a","layer":"original","quote":"霸二子，基、壹。五凤中，封基为吴侯，壹宛陵侯。","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":228,"anchor":null},"note_id":null,"start":0,"end":23}],"profiles":{},"directory_counts":{}}
