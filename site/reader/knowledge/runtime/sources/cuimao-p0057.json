d":"n-62da5d107b0f07f7e09d","start":45,"end":60},{"id":"cuimao-q-63ee1574c23ba4c3fc12","section":"chapter-012","block":"b-4a44c3e5e62675d3ce24","layer":"pei","quote":"曾使主簿程咸为议，议曰：‘大魏承秦、汉之弊，未及革制。所以追戮已出之女，诚欲殄丑类之族也。若已产育，则成他家之母；于防则不足惩奸乱之源，于情则伤孝子之思。男不御罪于他族，而女独婴戮于二门；非所以哀矜女弱，均法制之大分也。臣以为：在室之女，可从父母之刑；既醮之妇，使从夫家之戮。’朝廷从之，乃定律令","attribution":"裴注·干宝《晋纪》","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":256,"anchor":null},"note_id":"n-62da5d107b0f07f7e09d","start":78,"end":226},{"id":"cuimao-q-946d25cc993d57649ddb","section":"chapter-012","block":"b-4a44c3e5e62675d3ce24","layer":"pei","quote":"时毌丘俭孙女，适刘氏，以孕系廷尉","attribution":"裴注·干宝《晋纪》","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":256,"anchor":null},"note_id":"n-62da5d107b0f07f7e09d","start":28,"end":44},{"id":"cuimao-q-f2eee0121f17f3467844","section":"chapter-012","block":"b-4a44c3e5e62675d3ce24","layer":"pei","quote":"既免，辞诣廷尉，乞为官婢以赎女命","attribution":"裴注·干宝《晋纪》","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":256,"anchor":null},"note_id":"n-62da5d107b0f07f7e09d","start":61,"end":77}],"profiles":{},"directory_counts":{}}
