{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"lizang-e-o278","title":"《勇侠传》：噉人贼数十人略鲍出之母，以绳贯其手掌驱去；初等怖恐不敢追逐","accounts":[{"id":"lizang-a-12f288cca57486b7c647","label":"裴注·魏略《勇侠传》","text":"《勇侠传》：噉人贼数十人略鲍出之母，以绳贯其手掌驱去；初等怖恐不敢追逐","evidence":["lizang-q-3910b73398dee857b96b"]},{"id":"lizang-a-6dc55fc14597e073765a","label":"裴注·魏略《勇侠传》","text":"《勇侠传》：鲍出到知母被略，兄弟皆云贼众当如何，出怒曰有母而使贼贯其手用活何为，乃独追之","evidence":["lizang-q-7216379afdfa1040f9a9"]},{"id":"lizang-a-20fd55e8090260c3efe4","label":"裴注·魏略《勇侠传》","text":"《勇侠传》：贼布列待出，出回从一头斫贼四五人；贼复合聚围出，出跳越围斫之又杀十余人","evidence":["lizang-q-95c18a7973cdde199a29"]},{"id":"lizang-a-9b28e9803376aee751dc","label":"裴注·魏略《勇侠传》","text":"《勇侠传》：贼驱出母前去，连击出不胜走与前辈合；出复追击之，还见其母与比舍妪同贯相连","evidence":["lizang-q-4c8ef5b6af8bae23baa8"]},{"id":"lizang-a-fd4109cfa5085bed42fa","label":"裴注·魏略《勇侠传》","text":"《勇侠传》：出奋击贼，责数指母以示，贼乃解还出母；比舍妪求哀，出指言此我嫂也，贼复解还之","evidence":["lizang-q-9239222a497e25d05d3a"]},{"id":"lizang-a-8a50d737d77a6e41469a","label":"裴注·魏略《勇侠传》","text":"《勇侠传》：出得母还，遂相扶侍，客南阳","evidence":["lizang-q-76167db6717a5f9afbb1"]}],"participants":[{"person":"lizang-p0082","role":"怖恐不敢追；谏疑","evidence":["lizang-q-3910b73398dee857b96b","lizang-q-7216379afdfa1040f9a9"]},{"person":"lizang-p0084","role":"怖恐不敢追；谏疑","evidence":["lizang-q-3910b73398dee857b96b","lizang-q-7216379afdfa1040f9a9"]},{"person":"lizang-p0083","role":"怖恐不敢追；谏疑","evidence":["lizang-q-3910b73398dee857b96b","lizang-q-7216379afdfa1040f9a9"]},{"person":"lizang-p0081","role":"怒而独追及贼；斫贼杀十余人；复追击贼；责贼得还其母并比舍妪；得母客南阳","evidence":["lizang-q-7216379afdfa1040f9a9","lizang-q-95c18a7973cdde199a29","lizang-q-4c8ef5b6af8bae23baa8","lizang-q-9239222a497e25d05d3a","lizang-q-76167db6717a5f9afbb1"]},{"person":"lizang-p-baochu","role":"持粮归家遇贼、怖恐不敢追逐","evidence":["lizang-q-3910b73398dee857b96b"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["lizang-q-3910b73398dee857b96b","lizang-q-7216379afdfa1040f9a9","lizang-q-95c18a7973cdde199a29","lizang-q-4c8ef5b6af8bae23baa8","lizang-q-9239222a497e25d05d3a","lizang-q-76167db6717a5f9afbb1"]},"ordering_evidence":"lizang-q-3910b73398dee857b96b","source_order":[18,281,94],"order":3728}],"persons":[{"id":"lizang-p-baochu","name":"鲍初","evidence":["lizang-q-baochu-identity"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[{"id":"lizang-q-3910b73398dee857b96b","section":"chapter-018","block":"b-edafdfb7985563e25ca5","layer":"pei","quote":"初等到家，而噉人贼数十人，已略其母；以绳贯其手掌，驱去。初等怖恐，不敢追逐","attribution":"裴注·魏略《勇侠传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":280,"anchor":null},"note_id":"n-48d5c144befb35f43c2d","start":94,"end":131},{"id":"lizang-q-4c8ef5b6af8bae23baa8","section":"chapter-018","block":"b-edafdfb7985563e25ca5","layer":"pei","quote":"时贼分布，驱出母，前去。贼连击出，不胜，乃走与前辈合。出复追击之，还见其母，与比舍妪同贯相连","attribution":"裴注·魏略《勇侠传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":280,"anchor":null},"note_id":"n-48d5c144befb35f43c2d","start":255,"end":301},{"id":"lizang-q-7216379afdfa1040f9a9","section":"chapter-018","block":"b-edafdfb7985563e25ca5","layer":"pei","quote":"须臾，出从后到，知母为贼所略，欲追贼。兄弟皆云：‘贼众，当如何？’出怒曰：‘有母而使贼贯其手，将去煮噉之，用活何为！’乃攘臂结衽独追之，行数里及贼","attribution":"裴注·魏略《勇侠传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":280,"anchor":null},"note_id":"n-48d5c144befb35f43c2d","start":132,"end":205},{"id":"lizang-q-76167db6717a5f9afbb1","section":"chapter-018","block":"b-edafdfb7985563e25ca5","layer":"pei","quote":"出得母还，遂相扶侍，客南阳","attribution":"裴注·魏略《勇侠传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":280,"anchor":null},"note_id":"n-48d5c144befb35f43c2d","start":395,"end":408},{"id":"lizang-q-9239222a497e25d05d3a","section":"chapter-018","block":"b-edafdfb7985563e25ca5","layer":"pei","quote":"出遂复奋击贼，贼问出曰：‘卿欲何得？’出责数贼，指其母以示之；贼乃解还出母。比舍妪独不解，遥望出求哀。出复斫贼，贼谓出曰：‘已还卿母，何为不止？’出又指求哀妪：‘此我嫂也！’贼复解还之","attribution":"裴注·魏略《勇侠传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":280,"anchor":null},"note_id":"n-48d5c144befb35f43c2d","start":302,"end":394},{"id":"lizang-q-95c18a7973cdde199a29","section":"chapter-018","block":"b-edafdfb7985563e25ca5","layer":"pei","quote":"贼望见出，乃共布列待之。出到，回从一头，斫贼四五人。贼走，复合聚围出；出跳越围，斫之，又杀十余人","attribution":"裴注·魏略《勇侠传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":280,"anchor":null},"note_id":"n-48d5c144befb35f43c2d","start":206,"end":254},{"id":"lizang-q-baochu-identity","section":"chapter-018","block":"b-edafdfb7985563e25ca5","quote":"使其二兄初、雅及其弟成，持归，为母作食","layer":"pei","note_id":"n-48d5c144befb35f43c2d","attribution":"裴注·魏略《勇侠传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":280,"anchor":null},"start":64,"end":83}],"profiles":{},"directory_counts":{}}
