uyu-p0011","role":"诛死者","evidence":["wangwei-q-834d79cfadbcb2b54393"]},{"person":"xunyu-p0005","role":"废者","evidence":["wangwei-q-834d79cfadbcb2b54393"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["wangwei-q-834d79cfadbcb2b54393"]},"ordering_evidence":"wangwei-q-834d79cfadbcb2b54393","order":4100}],"persons":[{"id":"xunyu-p0005","name":"王畅","evidence":["xunyu-q-p001","dongyuan-e-p109a-q","wangwei-q-0e687ab6ff05d5a11c44","wangwei-q-cac9b404dc0d816427c5","wangwei-q-834d79cfadbcb2b54393","wangwei-q-06c05a96a6d3f90b470c"],"facts":[{"id":"wangwei-f-de476f4ba74095da6e28","text":"字叔茂，名在八俊。","evidence":["wangwei-q-06c05a96a6d3f90b470c"]}],"aliases":[],"mentions":[{"id":"xunyu-m-p001-xunyu-p0005","kind":"mention","text":"文中提及","evidence":["xunyu-q-p001"]},{"id":"xunyu-m-p033-xunyu-p0005","kind":"mention","text":"文中提及","evidence":["xunyu-q-p033"]},{"id":"dongyuan-m-p109-xunyu-p0005","kind":"mention","text":"文中提及","evidence":["dongyuan-e-p109a-q"]}]}],"evidence":[{"id":"dongyuan-e-p109a-q","section":"chapter-006","block":"b-8c13365348655e1e7588","layer":"pei","quote":"表受学于同郡王畅。畅为南阳太守，行过乎俭。表时年十七，进谏曰：‘奢不僭上，俭不逼下，盖中庸之道；是故蘧伯玉耻独为君子。府君若不师孔圣之明训，而慕夷、齐之末操，无乃皎然自遗于世！’畅答曰：‘以约失之者，鲜矣。且以矫俗也。’","attribution":"谢承《后汉书》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":468,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-79d1d1dad564a618e84b","start":80,"end":190,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-06c05a96a6d3f90b470c","section":"chapter-021","block":"b-0a5e92793cfa20a08991","layer":"pei","quote":"﹝一﹞张璠《汉纪》曰：“龚字伯宗。有高名于天下。顺帝时为太尉。初，山阳太守薛勤丧妻，不哭；将殡，临之曰：‘幸不为夭，复何恨哉！’及龚妻卒，龚与诸子并杖行服，时人或两讥焉。畅字叔茂，名在‘八俊’。灵帝时为司空，以水灾免；而李膺亦免归故郡，二人以直道不容当时。天下以畅、膺为高士，诸危言危行之徒皆推宗之，愿涉其流，惟恐不及。会连有灾异，而言事者皆言：‘三公非其人；宜因其变，以畅、膺代之，则祯祥必至。’由是宦竖深怨之。及膺诛死而畅遂废，终于家。”","attribution":"裴注引张璠《汉纪》","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":23,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-50050b992d7d5915d74c","start":0,"end":221,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-0e687ab6ff05d5a11c44","section":"chapter-021","block":"b-0a5e92793cfa20a08991","layer":"pei","quote":"灵帝时为司空，以水灾免","attribution":"裴注·汉纪","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":23,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-50050b992d7d5915d74c","start":97,"end":108,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-834d79cfadbcb2b54393","section":"chapter-021","block":"b-0a5e92793cfa20a08991","layer":"pei","quote":"及膺诛死而畅遂废，终于家","attribution":"裴注·汉纪","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":23,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-50050b992d7d5915d74c","start":207,"end":219,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-cac9b404dc0d816427c5","section":"chapter-021","block":"b-0a5e92793cfa20a08991","layer":"pei","quote":"而李膺亦免归故郡，二人以直道不容当时","attribution":"裴注·汉纪","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":23,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-50050b992d7d5915d74c","start":109,"end":127,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-p001","section":"chapter-010","block":"b-a43ad189cc8f2f18e67f","layer":"pei","quote":"﹝一﹞《续汉书》曰：“淑，有高才，王畅、李膺皆以为师。为朗陵侯相，号称‘神君’。”","attribution":"《续汉书》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":16,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c347ca05b53d613cd76d","start":0,"end":41,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-p033","section":"chapter-010","block":"b-bbfe76c23f129e3ee4b3","layer":"pei","quote":"﹝一﹞《荀氏家传》曰：“昙字元智。兄昱，字伯修。”张璠《汉纪》称：“昱、昙并杰俊有殊才。昱与李膺、王畅、杜密等号为‘八俊’，位至沛相。”攸父彝，州从事。彝与彧为从祖兄弟。","attribution":"《荀氏家传》及张璠《汉纪》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":202,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-bd5e067e19041368a73a","start":0,"end":85,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
