vidence":["mingdi-e-p013f-q"]}],"participants":[{"person":"mingdi-p0007","role":"病卒遗令","evidence":["mingdi-e-p013f-q"]},{"person":"mingdi-p0076","role":"受戒","evidence":["mingdi-e-p013f-q"]}],"place":null,"time":{"label":"还朝后","precision":"relative","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["mingdi-e-p013f-q"],"after":"mingdi-e-p013e"},"ordering_evidence":"mingdi-e-p013f-q","source_order":[3,87,"P013f"],"order":760},{"id":"xiahoucao-e-o053a","title":"曹真料诸葛亮出陈仓遣郝昭王生筑守","accounts":[{"id":"xiahoucao-e-o053a-account","label":"《诸夏侯曹传第九》正文","text":"曹真料诸葛亮出陈仓遣郝昭王生筑守","evidence":["xiahoucao-e-o053a-q"]}],"participants":[{"person":"wendi-p0038","role":"料敌遣守","evidence":["xiahoucao-e-o053a-q"]},{"person":"mingdi-p0007","role":"守城","evidence":["xiahoucao-e-o053a-q"]},{"person":"xiahoucao-p0064","role":"守城","evidence":["xiahoucao-e-o053a-q"]}],"place":null,"time":{"label":"诸葛亮出陈仓前后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xiahoucao-e-o053a-q"]},"ordering_evidence":"xiahoucao-e-o053a-q","source_order":[9,223,"O053a"],"order":2244}],"persons":[{"id":"mingdi-p0007","name":"郝昭","evidence":["mingdi-q-o004","xiahoucao-q-o053","rensu-q-8d497aa5e12452521112","rensu-q-8866e3b3b3c5ef093f51","rensu-q2-dd38fe4233ccfbd967ea"],"facts":[{"id":"mingdi-f0007","label":"字","text":"伯道","evidence":["mingdi-f0007-q"]},{"id":"mingdi-f0008","label":"籍贯","text":"太原","evidence":["mingdi-f0008-q"]},{"id":"rensu-f2-816cd4d5208b315a0f64","text":"与魏平等先守金城，受诏不得西渡。","evidence":["rensu-q2-dd38fe4233ccfbd967ea"]}],"aliases":[{"text":"伯道","evidence":["mingdi-f0007-q"]}],"mentions":[{"id":"mingdi-m-o004-mingdi-p0007","kind":"mention","text":"文中提及","evidence":["mingdi-q-o004"]},{"id":"mingdi-m-p013-mingdi-p0007","kind":"mention","text":"文中提及","evidence":["mingdi-q-p013"]},{"id":"xiahoucao-m-o053-mingdi-p0007","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-o053"]}]}],"evidence":[{"id":"liusima-q-7a640fc9795029a728d2","section":"chapter-015","block":"b-9d369236f45a972c5dfe","layer":"original","quote":"张掖张进执郡守，举兵拒岐；黄华、麹演各逐故太守，举兵以应之","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":160,"anchor":null},"note_id":null,"start":22,"end":51},{"id":"liusima-q-aa0eab2115d01c9efa15","section":"chapter-015","block":"b-9d369236f45a972c5dfe","layer":"original","quote":"既进兵，为护羌校尉苏则声势〖1〗，故则得以有功","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":160,"anchor":null},"note_id":null,"start":52,"end":75},{"id":"lizang-q-34bd8dc4ffe56d7434c3","section":"chapter-018","block":"b-f2c7a004344479739639","layer":"original","quote":"恭即遣从弟华，攻酒泉沙头、乾齐二县〖14〗。恭又连兵，寻继华后，以为首尾之援","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":251,"anchor":null},"note_id":null,"start":0,"end":38},{"id":"lizang-q-49bc1aa25f35e32ade60","section":"chapter-018","block":"b-f2c7a004344479739639","layer":"original","quote":"别遣铁骑二百，迎吏官属；东缘酒泉北塞，径出张掖北河，逢迎太守尹奉","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":251,"anchor":null},"note_id":null,"start":39,"end":71},{"id":"lizang-q-6990f13f51360a8892b1","section":"chapter-018","block":"b-70898cfcffa39d291237","layer":"original","quote":"时酒泉黄华、张掖张进，各据其郡，欲与恭（艾）并势","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":250,"anchor":null},"note_id":null,"start":67,"end":91},{"id":"lizang-q-bbbf7e14283ba5da8cab","section":"chapter-018","block":"b-f2c7a004344479739639","layer":"original","quote":"于是，张进须黄华之助〖16〗；华欲救进，西顾恭兵，恐急击其后，遂诣金城太守苏则降","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":251,"anchor":null},"note_id":null,"start":76,"end":116},{"id":"mingdi-e-o004c-q","section":"chapter-003","block":"b-3d867ec3331f738aeaf5","layer":"original","quote":"太和元年春正月，郊祀武皇帝，以配天；宗祀文皇帝于明堂，以配上帝〖1〗。分江夏南部，置江夏南部都尉。西平麹英反，杀临羌令、西都长〖2〗。遣将军郝昭、鹿磐，讨斩之。二月，辛未〖3〗，帝耕于籍田。辛巳〖4〗，立文昭皇后寝庙于邺。丁亥〖5〗，朝日于东郊。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":30,"anchor":null},"note_id":null,"start":0,"end":123},{"id":"mingdi-e-p013a-q","section":"chapter-003","block":"b-35f8b7adee36b5682ae8","layer":"pei","quote":"为人雄壮，少入军，为部曲督，数有战功。为杂号将军，遂镇守河西十余年，民夷畏服。","attribution":"裴注·魏略","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":86,"anchor":null},"note_id":"n-91d96e75113271a0d70d","start":43,"end":82},{"id":"mingdi-e-p013b-q","section":"chapter-003","block":"b-35f8b7adee36b5682ae8","layer":"pei","quote":"先是，使将军郝昭筑陈仓城。","attribution":"裴注·魏略","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":86,"anchor":null},"note_id":"n-91d96e75113271a0d70d","start":10,"end":23},{"id":"mingdi-e-p013c-q","section":"chapter-003","block":"b-35f8b7adee36b5682ae8","layer":"pei","quote":"亮围陈仓，使昭乡人靳详于城外遥说之，昭于楼上应详曰：‘魏家科法，卿所练也；我之为人，卿所知也。我受国恩多而门户重，卿无可言者，但有必死耳。卿还谢诸葛，便可攻也！’详以昭语告亮，亮又使详重说昭，言‘人兵不敌，无为空自破灭’。昭谓详曰：‘前言已定矣。我识卿耳，箭不识也！’详乃去。","attribution":"裴注·魏略","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":86,"anchor":null},"note_id":"n-91d96e75113271a0d70d","start":82,"end":220},{"id":"mingdi-e-p013d-q","section":"chapter-003","block":"b-35f8b7adee36b5682ae8","layer":"pei","quote":"亮自以有众数万，而昭兵才千余人；又度东救未能便到，乃进兵攻昭。起云梯、冲车以临城；昭于是以火箭逆射其云梯，梯燃，梯上人皆烧死；昭又以绳连石磨压其冲车，冲车折。亮乃更为井阑百尺以射城中，以土丸填堑，欲直攀城；昭又于内筑重墙。亮又为地突，欲踊出于城里；昭又于城内穿地横截之。昼夜相攻拒二十余日，亮无计；救至，引退。","attribution":"裴注·魏略","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":86,"anchor":null},"note_id":"n-91d96e75113271a0d70d","start":220,"end":375},{"id":"mingdi-e-p013e-q","section":"chapter-003","block":"b-35f8b7adee36b5682ae8","layer":"pei","quote":"诏嘉昭善守，赐爵列侯。及还，帝引见慰劳之，顾谓中书令孙资曰：‘卿乡里乃有尔曹快人，为将灼如此！朕复何忧乎？’仍欲大用之。","attribution":"裴注·魏略","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":86,"anchor":null},"note_id":"n-91d96e75113271a0d70d","start":375,"end":435},{"id":"mingdi-e-p013f-q","section":"chapter-003","block":"b-35f8b7adee36b5682ae8","layer":"pei","quote":"会病亡，遗令戒其子凯曰：‘吾为将，知将不可为也。吾数发冢，取其木以为攻战具，又知厚葬无益于死者也。汝必殓以时服。且人，生有处所耳，死复何在耶？今去本墓远，东西南北，在汝而已。","attribution":"裴注·魏略","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":86,"anchor":null},"note_id":"n-91d96e75113271a0d70d","start":435,"end":522},{"id":"mingdi-f0007-q","section":"chapter-003","block":"b-35f8b7adee36b5682ae8","layer":"pei","quote":"昭字伯道","attribution":"裴注·魏略","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":86,"anchor":null},"note_id":"n-91d96e75113271a0d70d","start":34,"end":38},{"id":"mingdi-f0008-q","section":"chapter-003","block":"b-35f8b7adee36b5682ae8","layer":"pei","quote":"太原人","attribution":"裴注·魏略","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":86,"anchor":null},"note_id":"n-91d96e75113271a0d70d","start":39,"end":42},{"id":"mingdi-q-b-76fba510250937628a99","section":"chapter-003","block":"b-76fba510250937628a99","layer":"modern","quote":"〖1〗二年：太和二年（公元 228）。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":60,"anchor":null},"note_id":"n-38a74578b09178cb1fd4","start":0,"end":19},{"id":"mingdi-q-o004","section":"chapter-003","block":"b-3d867ec3331f738aeaf5","layer":"original","quote":"太和元年春正月，郊祀武皇帝，以配天；宗祀文皇帝于明堂，以配上帝〖1〗。分江夏南部，置江夏南部都尉。西平麹英反，杀临羌令、西都长〖2〗。遣将军郝昭、鹿磐，讨斩之。二月，辛未〖3〗，帝耕于籍田。辛巳〖4〗，立文昭皇后寝庙于邺。丁亥〖5〗，朝日于东郊。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":30,"anchor":null},"note_id":null,"start":0,"end":123},{"id":"mingdi-q-o008","section":"chapter-003","block":"b-bec9198de0001b0aa26c","layer":"original","quote":"二年春正月〖1〗，宣王攻破新城。斩达，传其首〖2〗。﹝一﹞分新城之上庸、武陵、巫县为上庸郡〖3〗，锡县为锡郡。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":54,"anchor":null},"note_id":null,"start":0,"end":55},{"id":"mingdi-q-p013","section":"chapter-003","block":"b-35f8b7adee36b5682ae8","layer":"pei","quote":"﹝五﹞《魏略》曰：“先是，使将军郝昭筑陈仓城。会亮至，围昭，不能拔。昭字伯道，太原人。为人雄壮，少入军，为部曲督，数有战功。为杂号将军，遂镇守河西十余年，民夷畏服。亮围陈仓，使昭乡人靳详于城外遥说之，昭于楼上应详曰：‘魏家科法，卿所练也；我之为人，卿所知也。我受国恩多而门户重，卿无可言者，但有必死耳。卿还谢诸葛，便可攻也！’详以昭语告亮，亮又使详重说昭，言‘人兵不敌，无为空自破灭’。昭谓详曰：‘前言已定矣。我识卿耳，箭不识也！’详乃去。亮自以有众数万，而昭兵才千余人；又度东救未能便到，乃进兵攻昭。起云梯、冲车以临城；昭于是以火箭逆射其云梯，梯燃，梯上人皆烧死；昭又以绳连石磨压其冲车，冲车折。亮乃更为井阑百尺以射城中，以土丸填堑，欲直攀城；昭又于内筑重墙。亮又为地突，欲踊出于城里；昭又于城内穿地横截之。昼夜相攻拒二十余日，亮无计；救至，引退。诏嘉昭善守，赐爵列侯。及还，帝引见慰劳之，顾谓中书令孙资曰：‘卿乡里乃有尔曹快人，为将灼如此！朕复何忧乎？’仍欲大用之。会病亡，遗令戒其子凯曰：‘吾为将，知将不可为也。吾数发冢，取其木以为攻战具，又知厚葬无益于死者也。汝必殓以时服。且人，生有处所耳，死复何在耶？今去本墓远，东西南北，在汝而已。’”","attribution":"裴注·魏略","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":86,"anchor":null},"note_id":"n-91d96e75113271a0d70d","start":0,"end":524},{"id":"rensu-q-131d2e9d4727bb8913d2","section":"chapter-016","block":"b-ff53aeeeca30c3bafe3a","layer":"original","quote":"则遂与诸军围张掖，破之；斩进及其支党，众皆降","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":31,"anchor":null},"note_id":null,"start":224,"end":246},{"id":"rensu-q-672330646ed54726015e","section":"chapter-016","block":"b-f2a1f0d88b85b5a704a9","layer":"original","quote":"张掖张进执太守杜通","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":30,"anchor":null},"note_id":null,"start":9,"end":18},{"id":"rensu-q-708104788f9f28e00771","section":"chapter-016","block":"b-f2a1f0d88b85b5a704a9","layer":"original","quote":"后演复结旁郡为乱","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":30,"anchor":null},"note_id":null,"start":0,"end":8},{"id":"rensu-q-87331ef88f5f111f3e7d","section":"chapter-016","block":"b-ff53aeeeca30c3bafe3a","layer":"original","quote":"演闻之，将步骑三千迎则；辞来助军〖8〗，而实欲为变。则诱与相见，因斩之；出以徇军〖9〗，其党皆散走","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":31,"anchor":null},"note_id":null,"start":174,"end":223},{"id":"rensu-q-8866e3b3b3c5ef093f51","section":"chapter-016","block":"b-ff53aeeeca30c3bafe3a","layer":"original","quote":"于是昭等从之，乃发兵救武威；降其三种胡","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":31,"anchor":null},"note_id":null,"start":146,"end":165},{"id":"rensu-q-89f8773457ad9ed676b9","section":"chapter-016","block":"b-ff53aeeeca30c3bafe3a","layer":"original","quote":"河西平，乃还金城","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":31,"anchor":null},"note_id":null,"start":264,"end":272},{"id":"rensu-q-8d497aa5e12452521112","section":"chapter-016","block":"b-ff53aeeeca30c3bafe3a","layer":"original","quote":"则乃见郡中大吏及昭等〖3〗，与羌豪帅谋曰：“今贼虽盛，然皆新合；或有胁从，未必同心。因衅击之〖4〗，善恶必离；离而归我，我增而彼损矣。既获益众之实，且有倍气之势〖5〗；率以进讨，破之必矣。若待大军，旷日持久；善人无归，必合于恶；善恶既合，势难猝离。虽有诏命〖6〗，违而合权，专之可也","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":31,"anchor":null},"note_id":null,"start":0,"end":141},{"id":"rensu-q-9ebd4335c7d1500f1afd","section":"chapter-016","block":"b-ff53aeeeca30c3bafe3a","layer":"original","quote":"演军败，华惧，出所执乞降","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":31,"anchor":null},"note_id":null,"start":247,"end":259},{"id":"rensu-q-d8ad3784f12f64f762ae","section":"chapter-016","block":"b-f2a1f0d88b85b5a704a9","layer":"original","quote":"酒泉黄华不受太守辛机〖1〗；进、华皆自称太守，以应之","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":30,"anchor":null},"note_id":null,"start":19,"end":45},{"id":"rensu-q-e78f512255bb183010b0","section":"chapter-016","block":"b-f2a1f0d88b85b5a704a9","layer":"original","quote":"武威太守毌丘兴，告急于则","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":30,"anchor":null},"note_id":null,"start":62,"end":74},{"id":"rensu-q-f9e1009ed308649c45ca","section":"chapter-016","block":"b-ff53aeeeca30c3bafe3a","layer":"original","quote":"与兴击进于张掖","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":31,"anchor":null},"note_id":null,"start":166,"end":173},{"id":"rensu-q2-dd38fe4233ccfbd967ea","section":"chapter-016","block":"b-f2a1f0d88b85b5a704a9","layer":"original","quote":"后演复结旁郡为乱。张掖张进执太守杜通，酒泉黄华不受太守辛机〖1〗；进、华皆自称太守，以应之。又武威三种胡，并寇抄，道路断绝。武威太守毌丘兴，告急于则。时雍、凉诸豪，皆驱略羌胡以从进等；郡人咸以为进不可当。又将军郝昭、魏平〖2〗，先是各屯守金城，亦受诏不得西度。","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":30,"anchor":null},"note_id":null,"start":0,"end":130},{"id":"wendi-e-o007d-q","section":"chapter-002","block":"b-aff500edc4a38bf656c0","layer":"original","quote":"酒泉黄华、张掖张进等各执太守以叛〖9〗。金城太守苏则讨进，斩之〖10〗。华降。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":40,"anchor":null},"note_id":null,"start":83,"end":122},{"id":"wendi-q-b-ec88012a7f6c352d0e04","section":"chapter-002","block":"b-ec88012a7f6c352d0e04","layer":"modern","quote":"〖1〗二年：黄初二年（公元 221）。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":210,"anchor":null},"note_id":"n-8fff547b113ffa36bbc1","start":0,"end":19},{"id":"wendi-q-o002","section":"chapter-002","block":"b-1c3ea4f0ea338bf2ec5a","layer":"original","quote":"太祖崩，嗣位为丞相，魏王。﹝三﹞尊王后曰王太后〖5〗。改建安二十五年为延康元年。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":2,"anchor":null},"note_id":null,"start":0,"end":40},{"id":"wendi-q-o019","section":"chapter-002","block":"b-8820e5c7f9006d364c44","layer":"original","quote":"二年春正月〖1〗，郊祀天地、明堂〖2〗。甲戌〖3〗，校猎至原陵〖4〗。遣使者，以太牢祠汉世祖〖5〗。乙亥〖6〗，朝日于东郊〖7〗。﹝一﹞初令郡国口满十万者〖8〗，岁察孝廉一人；其有秀异〖9〗，无拘户口。辛巳〖10〗，分三公户邑，封子弟各一人为列侯。壬午〖11〗，复颍川郡一年田租〖12〗。﹝二﹞改许县为许昌县。以魏郡东部为阳平郡〖13〗，西部为广平郡〖14〗。﹝三﹞","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":208,"anchor":null},"note_id":null,"start":0,"end":183},{"id":"wgc-q0011","section":"chapter-028","block":"b-9d2fd98fa3c9420e521b","layer":"original","quote":"毌丘俭字仲恭〖1〗，河东闻喜人也。父兴，黄初中为武威太守；伐叛柔服〖2〗，开通河右，名次金城太守苏则〖3〗。讨贼张进及讨叛胡有功，封高阳乡侯。﹝一﹞入为将作大匠。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":60,"anchor":null},"note_id":null,"start":0,"end":81},{"id":"wgc-q0186","section":"chapter-028","block":"b-9d2fd98fa3c9420e521b","layer":"original","quote":"讨贼张进及讨叛胡有功","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":60,"anchor":null},"note_id":null,"start":54,"end":64},{"id":"xiahoucao-e-o053a-q","section":"chapter-009","block":"b-8a3c9242757773ef45a6","layer":"original","quote":"真以亮惩于祁山〖14〗，后出必从陈仓；乃使将军郝昭、王生守陈仓〖15〗，治其城〖16〗。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":222,"anchor":null},"note_id":null,"start":0,"end":44},{"id":"xiahoucao-q-o053","section":"chapter-009","block":"b-8a3c9242757773ef45a6","layer":"original","quote":"真以亮惩于祁山〖14〗，后出必从陈仓；乃使将军郝昭、王生守陈仓〖15〗，治其城〖16〗。明年春，亮果围陈仓，已有备而不能克。增邑，并前二千九百户。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":222,"anchor":null},"note_id":null,"start":0,"end":73}],"profiles":{},"directory_counts":{}}
