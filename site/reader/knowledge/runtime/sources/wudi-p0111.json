{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o036b","title":"曹操伏击吕布并收复定陶","accounts":[{"id":"wudi-e-o036b-account","label":"正文","text":"吕布与陈宫再来，曹操设伏击败，继而攻下定陶；吕布东投刘备，张邈随行，张超守雍丘。","evidence":["wudi-e-o036b-q"]}],"participants":[{"person":"cao-cao","role":"设伏克城","evidence":["wudi-e-o036b-q"]},{"person":"wudi-p0088","role":"战败东投","evidence":["wudi-e-o036b-q"]},{"person":"wudi-p0096","role":"来战","evidence":["wudi-e-o036b-q"]},{"person":"wudi-p0062","role":"随吕布","evidence":["wudi-e-o036b-q"]},{"person":"wudi-p0111","role":"守雍丘","evidence":["wudi-e-o036b-q"]},{"person":"liu-bei","role":"吕布投奔对象","evidence":["wudi-e-o036b-q"]}],"place":{"text":"东缗、定陶、雍丘","evidence":["wudi-e-o036b-q"]},"time":{"label":"兴平二年夏","year":195,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o036b-q","wudi-q-o035","wudi-q-b-927979d68d5dacfd36fe"],"chronology":"wudi-y195","dating_review":{"anchor":"wudi-q-o035","basis":"兴平二年夏","reviewed":true}},"source_order":[1,242,"O036b"],"order":110},{"id":"wudi-e-o038b","title":"雍丘破与张氏败亡","accounts":[{"id":"wudi-e-o038b-account","label":"正文","text":"雍丘破，张超自杀，张邈三族被诛；张邈求救袁术途中为部众所杀，曹操平兖州后东略陈地。","evidence":["wudi-e-o038b-q"]},{"id":"lvzang-a-643969393a7690ca81bb","label":"正文","text":"邈从布留超将家属屯雍丘太祖攻围数月屠之斩超","evidence":["lvzang-q-952b88d657488aeea7e0"]},{"id":"lvzang-a-2decd37ef4dd022ed879","label":"正文","text":"邈诣袁术请救未至自为其兵所杀","evidence":["lvzang-q-eafaf45beebfde593b67"]}],"participants":[{"person":"cao-cao","role":"平州东略","evidence":["wudi-e-o038b-q"]},{"person":"wudi-p0111","role":"自杀","evidence":["wudi-e-o038b-q"]},{"person":"wudi-p0062","role":"求救被杀","evidence":["wudi-e-o038b-q"]},{"person":"wudi-p0057","role":"求救对象","evidence":["wudi-e-o038b-q"]},{"person":"zhangle-p0013","role":"留将家属屯雍丘、及其家被斩","evidence":["lvzang-q-952b88d657488aeea7e0"]}],"place":{"text":"雍丘、兖州、陈地","evidence":["wudi-e-o038b-q"]},"time":{"label":"兴平二年十二月","year":195,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o038b-q","wudi-q-o035","wudi-q-b-927979d68d5dacfd36fe"],"chronology":"wudi-y195","dating_review":{"anchor":"wudi-q-o035","basis":"兴平二年十二月","reviewed":true}},"source_order":[1,244,"O038b"],"order":113}],"persons":[{"id":"wudi-p0111","name":"张超（张邈弟）","evidence":["wudi-q-o036"],"facts":[],"aliases":[],"mentions":[{"id":"wudi-m-o036-wudi-p0111","kind":"mention","text":"文中提及","evidence":["wudi-q-o036"]},{"id":"wudi-m-o038-wudi-p0111","kind":"mention","text":"文中提及","evidence":["wudi-q-o038"]}]}],"evidence":[{"id":"lvzang-q-952b88d657488aeea7e0","section":"chapter-007","block":"b-8e996afd8217efe1b488","layer":"original","quote":"邈从布，留超将家属屯雍丘。太祖攻围数月，屠之，斩超及其家","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":46,"anchor":null},"note_id":null,"start":0,"end":28},{"id":"lvzang-q-eafaf45beebfde593b67","section":"chapter-007","block":"b-8e996afd8217efe1b488","layer":"original","quote":"邈诣袁术请救；未至，自为其兵所杀","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":46,"anchor":null},"note_id":null,"start":33,"end":49},{"id":"wudi-e-o036b-q","section":"chapter-001","block":"b-46b956aeab7b17efb940","layer":"original","quote":"布复从东缗与陈宫将万余人来战〖5〗。时太祖兵少，设伏，纵奇兵击；大破之，﹝一﹞布夜走。太祖复攻，拔定陶，分兵平诸县。布东奔刘备；张邈从布，使其弟超将家属保雍丘〖6〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":241,"anchor":null},"note_id":null,"start":36,"end":119},{"id":"wudi-e-o038b-q","section":"chapter-001","block":"b-80a0547cacad39c5ccaf","layer":"original","quote":"十二月，雍丘溃，超自杀。夷邈三族〖7〗。邈诣袁术请救，为其众所杀，兖州平。遂东略陈地〖8〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":243,"anchor":null},"note_id":null,"start":13,"end":59},{"id":"wudi-q-b-927979d68d5dacfd36fe","section":"chapter-001","block":"b-927979d68d5dacfd36fe","layer":"modern","quote":"〖1〗二年：兴平二年（公元 195）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":246,"anchor":null},"note_id":"n-8c38464987eb86819ded","start":0,"end":19},{"id":"wudi-q-o035","section":"chapter-001","block":"b-94e8aac81304812fd313","layer":"original","quote":"二年春〖1〗，袭定陶。济阴太守吴资保南城〖2〗，未拔〖3〗。会吕布至，又击破之。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":240,"anchor":null},"note_id":null,"start":0,"end":40},{"id":"wudi-q-o036","section":"chapter-001","block":"b-46b956aeab7b17efb940","layer":"original","quote":"夏，布将薛兰、李封屯钜野〖4〗，太祖攻之。布救兰，兰败；布走，遂斩兰等。布复从东缗与陈宫将万余人来战〖5〗。时太祖兵少，设伏，纵奇兵击；大破之，﹝一﹞布夜走。太祖复攻，拔定陶，分兵平诸县。布东奔刘备；张邈从布，使其弟超将家属保雍丘〖6〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":241,"anchor":null},"note_id":null,"start":0,"end":119},{"id":"wudi-q-o038","section":"chapter-001","block":"b-80a0547cacad39c5ccaf","layer":"original","quote":"冬十月，天子拜太祖兖州牧。十二月，雍丘溃，超自杀。夷邈三族〖7〗。邈诣袁术请救，为其众所杀，兖州平。遂东略陈地〖8〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":243,"anchor":null},"note_id":null,"start":0,"end":59}],"profiles":{},"directory_counts":{}}
