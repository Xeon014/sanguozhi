m-o011-jfj-p0006","kind":"mention","text":"本段记载：蒋琬为杨戏不应答辩解","evidence":["jfj-q0057"]}]}],"evidence":[{"id":"dengzhang-q-04f65db063a066eba622","section":"chapter-045","block":"b-bded90831a985d06d5c0","layer":"original","quote":"后景耀四年卒","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":105,"anchor":null},"note_id":null,"start":0,"end":6},{"id":"dengzhang-q-0d6d60b85e6902285a53","section":"chapter-045","block":"b-a68508d665246c0adc71","layer":"original","quote":"延熙二十年，随大将军姜维出军至芒水","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":104,"anchor":null},"note_id":null,"start":0,"end":17},{"id":"dengzhang-q-723999b533edc042b023","section":"chapter-045","block":"b-a68508d665246c0adc71","layer":"original","quote":"戏素心不服维，酒后言笑，每有傲弄之辞。维外宽内忌，意不能堪；军还，有司承旨奏戏，免为庶人","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":104,"anchor":null},"note_id":null,"start":18,"end":62},{"id":"dengzhang-q-73023962bd3182ba434f","section":"chapter-045","block":"b-a2e89ab5da9d0b17d151","layer":"original","quote":"琬以大将军开府，又辟为东曹掾","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":102,"anchor":null},"note_id":null,"start":26,"end":40},{"id":"dengzhang-q-974e8bcec5e371d17df2","section":"chapter-045","block":"b-a2e89ab5da9d0b17d151","layer":"original","quote":"刺史蒋琬请为治中从事史","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":102,"anchor":null},"note_id":null,"start":14,"end":25},{"id":"dengzhang-q-cad29e3064d6efd8807c","section":"chapter-045","block":"b-9f65eeeefb0e5854f63a","layer":"original","quote":"戏以延熙四年著《季汉辅臣赞》","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":130,"anchor":null},"note_id":null,"start":0,"end":14},{"id":"dengzhang-q-f5018a0948f2965da885","section":"chapter-045","block":"b-5345abf60a2a40fc9a8a","layer":"original","quote":"与巴西韩俨、黎韬，童幼相亲厚；后俨痼疾废顿〖13〗，韬无行见捐〖14〗：戏经纪赈恤〖15〗，恩好如初","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":106,"anchor":null},"note_id":null,"start":60,"end":110},{"id":"dengzhang-q2-0f1ceb9c42b3b6434dff","section":"chapter-045","block":"b-a2e89ab5da9d0b17d151","layer":"original","quote":"迁南中参军，副贰降都督，领建宁太守〖6〗。","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":102,"anchor":null},"note_id":null,"start":41,"end":62},{"id":"dengzhang-q2-22ce19dd9935690724be","section":"chapter-045","block":"b-a2e89ab5da9d0b17d151","layer":"original","quote":"亮卒，为尚书右选部郎〖5〗。","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":102,"anchor":null},"note_id":null,"start":0,"end":14},{"id":"dengzhang-q2-8c43971fafbc0e4cc5c4","section":"chapter-045","block":"b-a99a6bddbdd5ddcb52d5","layer":"original","quote":"戏年二十余，从州书佐为督军从事；职典刑狱，论法决疑，号为平当〖3〗。府辟为属〖4〗，主簿。","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":101,"anchor":null},"note_id":null,"start":62,"end":107},{"id":"dengzhang-q2-bacaca4b5d4f54e9bd43","section":"chapter-045","block":"b-8b406f1b08bb70329028","layer":"original","quote":"以疾征还成都，拜护军，监军。出领梓潼太守。入为射声校尉。","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":103,"anchor":null},"note_id":null,"start":0,"end":28},{"id":"houzhu-q-O068","section":"chapter-033","block":"b-125803ea97178002919c","layer":"original","quote":"二十年，闻魏大将（军）诸葛诞据寿春以叛，姜维复率众出骆谷，至芒水〖16〗。是岁大赦。","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":126,"anchor":null},"note_id":null,"start":0,"end":42},{"id":"jfj-q0056","section":"chapter-044","block":"b-76c3611dcafdc544fe0b","layer":"original","quote":"东曹掾杨戏，素性简略〖13〗；琬与言论，时不应答〖14〗。或欲构戏于琬曰〖15〗：“公与戏语而不见应，戏之慢上〖16〗，不亦甚乎！”琬曰：“人心不同，各如其面；面从后言〖17〗，古人之所诫也。戏欲赞吾是耶，则非其本心；欲反吾言〖18〗，则显吾之非；是以默然，是戏之快也〖19〗。”","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":31,"anchor":null},"note_id":null,"start":0,"end":140},{"id":"jfj-q0057","section":"chapter-044","block":"b-76c3611dcafdc544fe0b","layer":"original","quote":"东曹掾杨戏，素性简略〖13〗；琬与言论，时不应答〖14〗。或欲构戏于琬曰〖15〗：“公与戏语而不见应，戏之慢上〖16〗，不亦甚乎！”琬曰：“人心不同，各如其面；面从后言〖17〗，古人之所诫也。戏欲赞吾是耶，则非其本心；欲反吾言〖18〗，则显吾之非；是以默然，是戏之快也〖19〗。”又督农杨敏曾毁琬曰：“作事愦愦〖20〗，诚非及前人〖21〗。”或以白琬，主者请推治敏〖22〗。琬曰：“吾实不如前人，无可推也！”主者重据〖23〗，听不推则乞问其“愦愦”之状。琬曰：“苟其不如，则事不当理〖24〗；事不当理，则愦愦矣！复何问邪？”后敏坐事系狱，众人犹惧其必死；琬心无適莫〖25〗，得免重罪。其好恶存道〖26〗，皆此类也。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":31,"anchor":null},"note_id":null,"start":0,"end":307},{"id":"jfj-q0165","section":"chapter-044","block":"b-70b129f69e54215e09f3","layer":"original","quote":"二十年〖10〗，魏征东大将军诸葛诞反于淮南，分关中兵东下。维欲乘虚向秦川，复率数万人出骆谷，径至沈岭","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":197,"anchor":null},"note_id":null,"start":0,"end":50}],"profiles":{"jfj-p0006":{"fields":[],"directory":{"faction":"shu"}}},"directory_counts":{}}
