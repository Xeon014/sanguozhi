003e333bc0a14a28","note_id":"n-c480ade0f0913bd6d1da","start":135,"end":157,"offset_unit":"unicode_code_point"},{"id":"jfj-q0026","section":"chapter-044","block":"b-7dd0b4702f1410f9e19f","layer":"original","quote":"五年〖7〗，维率众出（汉）侯和；为邓艾所破，还住沓中。维本羁旅托国，累年攻战，功绩不立；而宦官黄皓等弄权于内，右大将军阎宇与皓协比〖8〗，而皓阴欲废维树宇。维亦疑之，故自危惧，不复还成都。﹝一﹞","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":216,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":97,"offset_unit":"unicode_code_point"},{"id":"jfj-q0179","section":"chapter-044","block":"b-7dd0b4702f1410f9e19f","layer":"original","quote":"而宦官黄皓等弄权于内，右大将军阎宇与皓协比〖8〗，而皓阴欲废维树宇。维亦疑之，故自危惧，不复还成都。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":216,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":44,"end":94,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-p054","section":"chapter-035","block":"b-c757579021f8983017ea","layer":"pei","quote":"﹝二﹞孙盛《异同记》曰：“瞻、厥等以维好战无功，国内疲弊；宜表后主，召还为益州刺史，夺其兵权。蜀长老犹有瞻表‘以阎宇代维’故事。晋永和三年，蜀史常璩说蜀长老云：‘陈寿尝为瞻吏，为瞻所辱；故因此事归恶黄皓，而云瞻不能匡矫也。’”","attribution":"孙盛《异同记》","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":453,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-728adfc2b17d8d199f48","start":0,"end":113,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-21259ce148f7c00dd50b","section":"chapter-056","block":"b-f23800be07859b108789","layer":"original","quote":"孙2 秉政，大臣疑贰〖16〗。绩恐吴必扰乱，而中国乘衅〖17〗；乃密书结蜀，使为并兼之虑","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":121,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":11,"end":55,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-d46209049517585f74cc","section":"chapter-056","block":"b-f23800be07859b108789","layer":"original","quote":"蜀遣右将军阎宇将兵五千，增白帝守，以须绩之后命","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":121,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":60,"end":83,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
