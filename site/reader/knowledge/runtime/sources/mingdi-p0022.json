{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"mingdi-e-o016c","title":"波调遣使奉献受封亲魏大月氏王","accounts":[{"id":"mingdi-e-o016c-account","label":"《明帝纪》正文","text":"波调遣使奉献受封亲魏大月氏王","evidence":["mingdi-e-o016c-q"]}],"participants":[{"person":"mingdi-p0022","role":"遣使受封","evidence":["mingdi-e-o016c-q"]}],"place":null,"time":{"year":229,"label":"十二月癸卯","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"mingdi-y229","dating_review":{"reviewed":true,"anchor":"mingdi-q-o013","basis":"十二月癸卯"},"evidence":["mingdi-e-o016c-q","mingdi-q-o013","mingdi-q-b-603b9eca40bc72aa5ca9"]},"ordering_evidence":"mingdi-e-o016c-q","source_order":[3,91,"O016c"],"order":769}],"persons":[{"id":"mingdi-p0022","name":"波调","evidence":["mingdi-q-o016"],"facts":[],"aliases":[],"mentions":[{"id":"mingdi-m-o016-mingdi-p0022","kind":"mention","text":"文中提及","evidence":["mingdi-q-o016"]}]}],"evidence":[{"id":"mingdi-e-o016c-q","section":"chapter-003","block":"b-7813ae24084c75e21fe4","layer":"original","quote":"初，洛阳宗庙未成，神主在邺庙。十一月，庙始成。使太常韩暨持节迎高皇帝、太皇帝、武帝、文帝神主于邺〖26〗。十二月，己丑至〖27〗，奉安神主于庙〖28〗。﹝一﹞癸卯〖29〗，大月氏王波调遣使奉献〖30〗，以调为亲魏大月氏王。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":90,"anchor":null},"note_id":null,"start":0,"end":111},{"id":"mingdi-q-b-603b9eca40bc72aa5ca9","section":"chapter-003","block":"b-603b9eca40bc72aa5ca9","layer":"modern","quote":"〖1〗三年：太和三年（公元 229）。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":92,"anchor":null},"note_id":"n-04d89584b18b3bb50af5","start":0,"end":19},{"id":"mingdi-q-o013","section":"chapter-003","block":"b-c7981dd3e3485c76d7c8","layer":"original","quote":"三年夏四月〖1〗，元城王礼薨。六月，癸卯〖2〗，繁阳王穆薨。戊申〖3〗，追尊高祖大长秋曰高皇帝，夫人吴氏曰高皇后。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":87,"anchor":null},"note_id":null,"start":0,"end":57},{"id":"mingdi-q-o016","section":"chapter-003","block":"b-7813ae24084c75e21fe4","layer":"original","quote":"初，洛阳宗庙未成，神主在邺庙。十一月，庙始成。使太常韩暨持节迎高皇帝、太皇帝、武帝、文帝神主于邺〖26〗。十二月，己丑至〖27〗，奉安神主于庙〖28〗。﹝一﹞癸卯〖29〗，大月氏王波调遣使奉献〖30〗，以调为亲魏大月氏王。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":90,"anchor":null},"note_id":null,"start":0,"end":111}],"profiles":{},"directory_counts":{}}
