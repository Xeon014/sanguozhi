"]}],"mentions":[{"id":"wudi-m-o062-wudi-p0158","kind":"mention","text":"文中提及","evidence":["wudi-q-o062"]},{"id":"wudi-m-o079-wudi-p0158","kind":"mention","text":"文中提及","evidence":["wudi-q-o079"]},{"id":"zhangle-m-o022-wudi-p0158","kind":"mention","text":"文中提及","evidence":["zhangle-q-o022"]},{"id":"zhangle-m-o040-wudi-p0158","kind":"mention","text":"文中提及","evidence":["zhangle-q-o040"]},{"id":"xunyu-m-o043-wudi-p0158","kind":"mention","text":"文中提及","evidence":["xunyu-q-o043"]},{"id":"xiahoucao-m-o010-wudi-p0158","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-o010"]},{"id":"xiahoucao-m-p006-wudi-p0158","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-p006"]},{"id":"xiahoucao-m-o023-wudi-p0158","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-o023"]}]}],"evidence":[{"id":"dongyuan-e-o050d-q","section":"chapter-006","block":"b-a2e1cd17fc4fadc62bd0","layer":"original","quote":"又遣奇兵袭击绍运车，大破之，尽焚其谷。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":308,"anchor":null},"note_id":null,"start":102,"end":121},{"id":"gongsuntao-q-f3d13d4c430c2aebb31a","section":"chapter-008","block":"b-e96ffada202f222baadb","layer":"original","quote":"杨将眭固杀丑，将其众，欲北合袁绍。太祖遣史涣邀击，破之于犬城，斩固，尽收其众也","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":147,"anchor":null},"note_id":null,"start":12,"end":51},{"id":"wudi-e-o062a-q","section":"chapter-001","block":"b-01656b554fda06a0ac10","layer":"original","quote":"夏四月，进军临河，使史涣、曹仁渡河击之〖5〗。固使杨故长史薛洪、河内太守缪尚留守〖6〗，自将兵北迎绍求救。与涣、仁相遇犬城〖7〗，交战；大破之，斩固。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":359,"anchor":null},"note_id":null,"start":0,"end":75},{"id":"wudi-e-o079a-q","section":"chapter-001","block":"b-ab14ad2160cf6ce6945b","layer":"original","quote":"袁绍运谷车数千乘至；公用荀攸计，遣徐晃、史涣邀击〖2〗。大破之，尽烧其车。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":435,"anchor":null},"note_id":null,"start":0,"end":37},{"id":"wudi-q-b-51bced16741add42ff70","section":"chapter-001","block":"b-51bced16741add42ff70","layer":"modern","quote":"〖1〗四年：建安四年（公元 199）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":369,"anchor":null},"note_id":"n-20628d34a709162c77f0","start":0,"end":19},{"id":"wudi-q-b-9900125064e5d85f08ad","section":"chapter-001","block":"b-9900125064e5d85f08ad","layer":"modern","quote":"〖1〗五年：建安五年（公元 200）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":403,"anchor":null},"note_id":"n-744e4aee7f5ff14cca85","start":0,"end":19},{"id":"wudi-q-o061","section":"chapter-001","block":"b-502d4e8c0ed143eaa30d","layer":"original","quote":"四年春二月〖1〗，公还至昌邑〖2〗。张杨将杨丑杀杨〖3〗。眭固又杀丑，以其众属袁绍，屯射犬〖4〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":358,"anchor":null},"note_id":null,"start":0,"end":49},{"id":"wudi-q-o062","section":"chapter-001","block":"b-01656b554fda06a0ac10","layer":"original","quote":"夏四月，进军临河，使史涣、曹仁渡河击之〖5〗。固使杨故长史薛洪、河内太守缪尚留守〖6〗，自将兵北迎绍求救。与涣、仁相遇犬城〖7〗，交战；大破之，斩固。公遂济河，围射犬。洪、尚率众降，封为列侯〖8〗。还军敖仓。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":359,"anchor":null},"note_id":null,"start":0,"end":104},{"id":"wudi-q-o071","section":"chapter-001","block":"b-c9f735ddad48a8f5c2b6","layer":"original","quote":"五年春正月〖1〗，董承等谋泄，皆伏诛。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":400,"anchor":null},"note_id":null,"start":0,"end":19},{"id":"wudi-q-o079","section":"chapter-001","block":"b-ab14ad2160cf6ce6945b","layer":"original","quote":"袁绍运谷车数千乘至；公用荀攸计，遣徐晃、史涣邀击〖2〗。大破之，尽烧其车。公与绍相拒连月，虽比战斩将〖3〗，然众少粮尽，士卒疲乏。公谓运者曰：“却十五日为汝破绍〖4〗，不复劳汝矣！”","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":435,"anchor":null},"note_id":null,"start":0,"end":91},{"id":"xiahoucao-e-o010a-q","section":"chapter-009","block":"b-a09645c517481b52d6a5","layer":"original","quote":"韩浩者，河内人。及沛国史涣，与浩俱以忠勇显〖12〗。浩至中护军，涣至中领军；皆掌禁兵，封列侯。﹝五﹞","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":21,"anchor":null},"note_id":null,"start":0,"end":50},{"id":"xiahoucao-e-o023b-q","section":"chapter-009","block":"b-be6530e8cc3f581d07e6","layer":"original","quote":"复与史涣等抄绍运军，烧其粮谷。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":118,"anchor":null},"note_id":null,"start":37,"end":52},{"id":"xiahoucao-e-p006d-q","section":"chapter-009","block":"b-9fbce7d96866baadec11","layer":"pei","quote":"太祖欲讨柳城，领军史涣以为道远深入，非完计也，欲与浩共谏。浩曰：‘今兵势强盛，威加四海，战胜攻取，无不如志；不以此时，遂除天下之患，将为后忧。且公神武，举无遗策；吾与君，为中军主，不宜沮众！’遂从破柳城。改其官为中护军，置长史、司马。","attribution":"《魏书》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":40,"anchor":null},"note_id":"n-d74b1295041866c5f00c","start":138,"end":255},{"id":"xiahoucao-e-p006g-q","section":"chapter-009","block":"b-9fbce7d96866baadec11","layer":"pei","quote":"史涣字公刘。少任侠，有雄气。太祖初起，以客从，行中军校尉。从征伐，常监诸将；见亲信，转拜中领军。","attribution":"《魏书》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":40,"anchor":null},"note_id":"n-d74b1295041866c5f00c","start":330,"end":378},{"id":"xiahoucao-e-p006h-q","section":"chapter-009","block":"b-9fbce7d96866baadec11","layer":"pei","quote":"十四年薨。子静嗣。","attribution":"《魏书》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":40,"anchor":null},"note_id":"n-d74b1295041866c5f00c","start":378,"end":387},{"id":"xiahoucao-f0031-q","section":"chapter-009","block":"b-9fbce7d96866baadec11","layer":"pei","quote":"史涣字公刘","attribution":"《魏书》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":40,"anchor":null},"note_id":"n-d74b1295041866c5f00c","start":330,"end":335},{"id":"xiahoucao-f0032-q","section":"chapter-009","block":"b-a09645c517481b52d6a5","layer":"original","quote":"及沛国史涣","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":21,"anchor":null},"note_id":null,"start":8,"end":13},{"id":"xiahoucao-q-b-37d1816580d2541ad353","section":"chapter-009","block":"b-37d1816580d2541ad353","layer":"modern","quote":"〖7〗十四年：建安十四年（公元 209）。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":51,"anchor":null},"note_id":"n-5497913c514df18982ee","start":0,"end":21},{"id":"xiahoucao-q-o010","section":"chapter-009","block":"b-a09645c517481b52d6a5","layer":"original","quote":"韩浩者，河内人。及沛国史涣，与浩俱以忠勇显〖12〗。浩至中护军，涣至中领军；皆掌禁兵，封列侯。﹝五﹞","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":21,"anchor":null},"note_id":null,"start":0,"end":50},{"id":"xiahoucao-q-o013","section":"chapter-009","block":"b-5a05419cd84365039812","layer":"original","quote":"十四年〖7〗，以渊为行领军〖8〗。太祖征孙权还，使渊督诸将，击庐江叛者雷绪〖9〗。绪破，又行征西护军〖10〗，督徐晃击太原贼；攻下二十余屯，斩贼帅商曜，屠其城。从征韩遂等，战于渭南。又督朱灵平隃糜、汧氐〖11〗。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":43,"anchor":null},"note_id":null,"start":0,"end":106},{"id":"xiahoucao-q-o023","section":"chapter-009","block":"b-be6530e8cc3f581d07e6","layer":"original","quote":"绍遣别将韩荀，抄断西道；仁击荀于鸡洛山〖2〗，大破之。由是绍不敢复分兵出。复与史涣等抄绍运军，烧其粮谷。河北既定，从围壶关。太祖令曰：“城拔，皆坑之〖3〗！”连月不下。仁言于太祖曰：“围城，必示之活门〖4〗，所以开其生路也。今公告之必死，将人自为守；且城固而粮多，攻之则士卒伤，守之则引日久。今顿兵坚城之下，以攻必死之虏：非良计也！”太祖从之，城降；于是录仁前后功，封都亭侯。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":118,"anchor":null},"note_id":null,"start":0,"end":188},{"id":"xiahoucao-q-p006","section":"chapter-009","block":"b-9fbce7d96866baadec11","layer":"pei","quote":"﹝五﹞《魏书》曰：“韩浩字元嗣。汉末起兵，县近山薮，多寇；浩聚徒众，为县藩卫。太守王匡以为从事，将兵拒董卓于盟津。时浩舅杜阳，为河阴令，卓执之；使招浩，浩不从。袁术闻而壮之，以为骑都尉。夏侯惇闻其名，请与相见；大奇之，使领兵从征伐。时大议损益，浩以为当急田。太祖善之，迁护军。太祖欲讨柳城，领军史涣以为道远深入，非完计也，欲与浩共谏。浩曰：‘今兵势强盛，威加四海，战胜攻取，无不如志；不以此时，遂除天下之患，将为后忧。且公神武，举无遗策；吾与君，为中军主，不宜沮众！’遂从破柳城。改其官为中护军，置长史、司马。从讨张鲁，鲁降。议者以浩智略足以绥边，欲留使都督诸军，镇汉中。太祖曰：‘吾安可以无护军！’乃与俱还。其见亲任如此。及薨，太祖愍惜之。无子，以养子荣嗣。史涣字公刘。少任侠，有雄气。太祖初起，以客从，行中军校尉。从征伐，常监诸将；见亲信，转拜中领军。十四年薨。子静嗣。”","attribution":"《魏书》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":40,"anchor":null},"note_id":"n-d74b1295041866c5f00c","start":0,"end":388},{"id":"xunyu-e-o043a-q","section":"chapter-010","block":"b-609b5e508ef6da68a7dc","layer":"original","quote":"军食方尽，攸言于太祖曰：“绍运车旦暮至〖2〗；其将韩，锐而轻敌，击，可破也。”﹝一﹞太祖曰：“谁可使？”攸曰：“徐晃可！”乃遣晃及史涣邀击，破走之，烧其辎重。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":221,"anchor":null},"note_id":null,"start":0,"end":79},{"id":"xunyu-q-o043","section":"chapter-010","block":"b-609b5e508ef6da68a7dc","layer":"original","quote":"军食方尽，攸言于太祖曰：“绍运车旦暮至〖2〗；其将韩，锐而轻敌，击，可破也。”﹝一﹞太祖曰：“谁可使？”攸曰：“徐晃可！”乃遣晃及史涣邀击，破走之，烧其辎重。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":221,"anchor":null},"note_id":null,"start":0,"end":79},{"id":"zhangle-e-o022a-q","section":"chapter-017","block":"b-3c2b1d6da151e5fdfca1","layer":"original","quote":"复从攻张绣于穰，擒吕布于下邳；别与史涣、曹仁攻眭固于射犬，破斩之。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":74,"anchor":null},"note_id":null,"start":0,"end":33},{"id":"zhangle-e-o040c-q","section":"chapter-017","block":"b-e7ed3fa863e93b8dd8f5","layer":"original","quote":"与史涣斩眭固于河内。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":145,"anchor":null},"note_id":null,"start":44,"end":54},{"id":"zhangle-e-o040f-q","section":"chapter-017","block":"b-e7ed3fa863e93b8dd8f5","layer":"original","quote":"又与史涣击袁绍运车于故市〖2〗，功最多，封都亭侯〖3〗。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":145,"anchor":null},"note_id":null,"start":96,"end":124},{"id":"zhangle-q-o022","section":"chapter-017","block":"b-3c2b1d6da151e5fdfca1","layer":"original","quote":"复从攻张绣于穰，擒吕布于下邳；别与史涣、曹仁攻眭固于射犬，破斩之。太祖初征袁绍，绍兵盛，禁愿为先登。太祖壮之，乃遣步卒二千人，使禁将，守延津以拒绍；太祖引军还官渡。刘备以徐州叛，太祖东征之。绍攻禁，禁坚守，绍不能拔。复与乐进等将步骑五千，击绍别营：从延津西南，缘河至汲、获嘉二县〖9〗，焚烧堡聚三十余屯；斩首、获生各数千，降绍将何茂、王摩等二十余人。太祖复使禁别将屯原武，击绍别营于杜氏津〖10〗，破之。迁裨将军。后从还官渡。太祖与绍连营，起土山相对。绍射营中，士卒多死伤，军中惧。禁督守土山，力战，气益奋。绍破，迁偏将军。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":74,"anchor":null},"note_id":null,"start":0,"end":262},{"id":"zhangle-q-o040","section":"chapter-017","block":"b-e7ed3fa863e93b8dd8f5","layer":"original","quote":"太祖授晃兵，使击卷、﹝一﹞原武贼〖1〗；破之，拜裨将军。从征吕布，别降布将赵庶、李邹等。与史涣斩眭固于河内。从破刘备。又从破颜良，拔白马；进至延津，破文丑，拜偏将军。与曹洪击！强贼祝臂，破之。又与史涣击袁绍运车于故市〖2〗，功最多，封都亭侯〖3〗。太祖既围邺，破邯郸。易阳令韩范，伪以城降而拒守，太祖遣晃攻之。晃至，飞矢城中，为陈成败；范悔，晃辄降之〖4〗。既而言于太祖曰：“二袁未破，诸城未下者倾耳而听；今日灭易阳〖5〗，明日皆以死守：恐河北无定时也。愿公降易阳以示诸诚，则莫不望风。”太祖善之。别讨毛城，设伏兵掩击，破三屯。从破袁谭于南皮，讨平原叛贼，克之。从征蹋顿，拜横野将军〖6〗。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":145,"anchor":null},"note_id":null,"start":0,"end":295}],"profiles":{},"directory_counts":{}}
