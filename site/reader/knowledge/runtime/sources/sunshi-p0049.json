event":"zhulv-e2-fan-poyang","type":"related","evidence":["zhulv-q2-7631eb8251fb57c57b05","zhulv-q-7d2f88f05a3d0389be42"]}],"order":10007}],"persons":[{"id":"sunshi-p0049","name":"祖郎","evidence":["sunshi-q-p035","chenghuang-q-d196dfc3f60152b7aabb","zongshi-q-37a154c79119d5b6f2d9","zongshi-q-51582b0052aee50eb08c","zongshi-q-7d6eef4abdd84d8afa57","zongshi-q-571f0ba403c559058ba9","zhulv-q-7d2f88f05a3d0389be42","feipin-q-7aed1d8c9b523e023a4e"],"facts":[],"aliases":[],"mentions":[{"id":"sunshi-m-p035-sunshi-p0049","kind":"mention","text":"文中提及","evidence":["sunshi-q-p035"]},{"id":"sunshi-m-p043-sunshi-p0049","kind":"mention","text":"文中提及","evidence":["sunshi-q-p043"]},{"id":"sunshi-m-p057-sunshi-p0049","kind":"allusion","text":"祖系或典故提及","evidence":["sunshi-q-p057"]}]}],"evidence":[{"id":"chenghuang-q-d196dfc3f60152b7aabb","section":"chapter-055","block":"b-5ecb4d52b1b6c18777c8","layer":"original","quote":"策尝攻祖郎，大为所围。普与一骑共蔽扞策，驱马疾呼，以矛突贼。贼披〖5〗，策因随出","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":2,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":123,"end":163,"offset_unit":"unicode_code_point"},{"id":"feipin-q-7aed1d8c9b523e023a4e","section":"chapter-050","block":"b-913913df849dedebb73d","layer":"original","quote":"孙策与孙河、吕范，依景，合众共讨泾县山贼祖郎；郎败走。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":2,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":111,"end":138,"offset_unit":"unicode_code_point"},{"id":"sunshi-e-p035b-q","section":"chapter-046","block":"b-47807d71f0fb1a72b324","layer":"pei","quote":"而为泾县大帅祖郎所袭，几至危殆。于是复往见术，术以坚余兵千余人，还策。","attribution":"《江表传》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":211,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4c2b7b68e867c3227c2b","start":149,"end":184,"offset_unit":"unicode_code_point"},{"id":"sunshi-e-p043d-q","section":"chapter-046","block":"b-84a6d56d68176dcda58a","layer":"pei","quote":"是时，陈瑀屯海西，策奉诏治严，当与布、瑀参同形势。行到钱唐，瑀阴图袭策；遣都尉万演等密渡江，使持印传三十余纽，与贼丹杨、宣城、泾、陵阳、始安、黟、歙诸险县大帅祖郎、焦已及吴郡乌程严白虎等，使为内应；伺策军发，欲攻取诸郡。","attribution":"《江表传》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":254,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-724f2dcc828652965c88","start":349,"end":459,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-p035","section":"chapter-046","block":"b-47807d71f0fb1a72b324","layer":"pei","quote":"《江表传》曰：“策径到寿春，见袁术，涕泣而言曰：‘亡父昔从长沙入讨董卓，与明使君会于南阳，同盟结好；不幸遇难，勋业不终。策感惟先人旧恩，欲自凭结：愿明使君垂察其诚！’术甚贵异之，然未肯还其父兵。术谓策曰：‘孤始用贵舅为丹杨太守，贤从伯阳为都尉；彼精兵之地，可还依召募。’策遂诣丹杨，依舅，得数百人；而为泾县大帅祖郎所袭，几至危殆。于是复往见术，术以坚余兵千余人，还策。”","attribution":"《江表传》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":211,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4c2b7b68e867c3227c2b","start":0,"end":185,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-p043","section":"chapter-046","block":"b-84a6d56d68176dcda58a","layer":"pei","quote":"﹝七﹞《江表传》曰：“建安二年夏，汉朝遣议郎王誧奉戊辰诏书曰：‘董卓逆乱，凶国害民。先将军坚，念在平讨；雅意未遂，厥美著闻。策遵善道，求福不回。今以策为骑都尉，袭爵乌程侯，领会稽太守。’又诏敕曰：‘故左将军袁术：不顾朝恩，坐创凶逆；造合虚伪，欲因兵乱，诡诈百姓。 〔始〕 闻其言，以为不然；定得使持节、平东将军、领徐州牧、温侯布，上术所造惑众妖妄，知术鸱枭之性，遂其无道；修治王宫，署置公卿；郊天祀地，残民害物：为祸深酷。布前后上策，乃心本朝，欲还讨术；为国效节，乞加显异。夫悬赏俟功，惟勤是与；故便宠授，承袭前邑；重以大郡，荣耀兼至：是策输力竭命之秋也。其亟与布及行吴郡太守、安东将军陈瑀，戮力一心，是时赴讨。’策自以统领兵马，但以骑都尉领郡，为轻，欲得将军号；及使人讽誧，誧便承制假策明汉将军。是时，陈瑀屯海西，策奉诏治严，当与布、瑀参同形势。行到钱唐，瑀阴图袭策；遣都尉万演等密渡江，使持印传三十余纽，与贼丹杨、宣城、泾、陵阳、始安、黟、歙诸险县大帅祖郎、焦已及吴郡乌程严白虎等，使为内应；伺策军发，欲攻取诸郡。策觉之，遣吕范、徐逸攻瑀于海西；大破瑀，获其吏士妻子四千人。”《山阳公载记》曰：“瑀单骑走冀州，自归袁绍。绍以为故安都尉。”","attribution":"《江表传》；《山阳公载记》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":254,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-724f2dcc828652965c88","start":0,"end":521,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-p057","section":"chapter-046","block":"b-0bd05c5ba15e2fa499c7","layer":"pei","quote":"臣松之按：《傅子》亦云曹公征柳城，将袭许。记述若斯，何其疏哉！然孙盛所讥，未为悉是。黄祖始被策破，魂气未反；但刘表君臣，本无兼并之志，虽在上流，何办规拟吴、会？策之此举，理应先图陈登；但举兵所在，不止登而已。于时强宗骁帅，祖郎、严虎之徒，擒灭已尽；所余山越，盖何足虑？然则策之所规，未可谓之不暇也。若使策志获从，大权在手；淮、泗之间，所在皆可都；何必毕志江外，其当迁帝于扬、越哉！按《魏武纪》，武帝以建安四年已出屯官渡，乃策未死之前，久与袁绍交兵，则《国志》所云不为谬也。许贡客，无闻之小人；而能感识恩遇，临义忘生，猝然奋发，有侔古烈矣。《诗》云：“君子有徽猷，小人与属。”贡客其有焉。","attribution":"裴松之按语","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":285,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-26c0935904b6bc636b31","start":0,"end":293,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-40d8b7057f4a29d6fe0d","section":"chapter-001","block":"b-40d8b7057f4a29d6fe0d","layer":"modern","quote":"〖3〗二年：建安二年（公元 197）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":305,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-de6807349faf5c41a470","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o050","section":"chapter-001","block":"b-c2d0fc350fb933237a70","layer":"original","quote":"二年春正月〖3〗，公到宛〖4〗。张绣降，既而悔之，复反。公与战，军败，为流矢所中。长子昂、弟子安民遇害〖5〗。﹝一﹞公乃引兵还舞阴〖6〗，绣将骑来抄〖7〗。公击破之，绣奔穰〖8〗，与刘表合。公谓诸将曰：“吾降张绣等，失不便取其质〖9〗，以至于此。吾知所以败。诸卿观之：自今以后，不复败矣！”遂还许。﹝二﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":298,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":152,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-7d2f88f05a3d0389be42","section":"chapter-056","block":"b-04e43ab0f40eb39bc1d5","layer":"original","quote":"又从攻祖郎于陵阳，太史慈于勇里〖14〗。七县平定，拜征虏中郎将〖15〗，征江夏；还平鄱阳","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":151,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":89,"end":133,"offset_unit":"unicode_code_point"},{"id":"zhulv-q2-3015358855368f3891ae","section":"chapter-056","block":"b-04e43ab0f40eb39bc1d5","layer":"original","quote":"征江夏","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":151,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":125,"end":128,"offset_unit":"unicode_code_point"},{"id":"zhulv-q2-7631eb8251fb57c57b05","section":"chapter-056","block":"b-04e43ab0f40eb39bc1d5","layer":"original","quote":"还平鄱阳。","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":151,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":129,"end":134,"offset_unit":"unicode_code_point"},{"id":"zhulv-q2-afe1d6970bb21602b982","section":"chapter-056","block":"b-04e43ab0f40eb39bc1d5","layer":"original","quote":"太史慈于勇里〖14〗。","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":151,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":98,"end":109,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-37a154c79119d5b6f2d9","section":"chapter-051","block":"b-107b5b6395a4b3b6b579","layer":"original","quote":"又从策讨陵阳〖3〗，生得祖郎等","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":135,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":58,"end":73,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-51582b0052aee50eb08c","section":"chapter-051","block":"b-bc8e7771a00e42e333a3","layer":"pei","quote":"袁术深怨策，乃阴遣间使赍印绶，与丹阳宗帅陵阳祖郎等；使激动山越，大合众，图共攻策","attribution":"裴注·江表传","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":143,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b3e7511317934afcf937","start":22,"end":62,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-571f0ba403c559058ba9","section":"chapter-051","block":"b-bc8e7771a00e42e333a3","layer":"pei","quote":"即破械，赐衣服，署门下贼曹。及军还，郎与太史慈，俱在前导军，人以为荣","attribution":"裴注·江表传","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":143,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b3e7511317934afcf937","start":130,"end":164,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-7d6eef4abdd84d8afa57","section":"chapter-051","block":"b-bc8e7771a00e42e333a3","layer":"pei","quote":"策自率将士讨郎，生获之。策谓郎曰：‘尔昔袭击孤，斫孤马鞍；今创军立事，除弃宿恨，惟取能用；与天下通耳，非但汝：汝莫恐怖！’郎叩头谢罪","attribution":"裴注·江表传","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":143,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b3e7511317934afcf937","start":63,"end":129,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
