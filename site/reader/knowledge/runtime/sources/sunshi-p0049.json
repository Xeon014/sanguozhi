{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"sunshi-e-p035b","title":"孙策受祖郎袭击再见袁术得父余兵","accounts":[{"id":"sunshi-e-p035b-account","label":"《江表传》","text":"孙策受祖郎袭击再见袁术得父余兵","evidence":["sunshi-e-p035b-q"]}],"participants":[{"person":"wudi-p0099","role":"遇袭求兵","evidence":["sunshi-e-p035b-q"]},{"person":"sunshi-p0049","role":"袭击","evidence":["sunshi-e-p035b-q"]},{"person":"wudi-p0057","role":"还兵","evidence":["sunshi-e-p035b-q"]}],"place":null,"time":{"label":"孙策初见袁术时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["sunshi-e-p035b-q"]},"ordering_evidence":"sunshi-e-p035b-q","source_order":[46,212,"P035b"],"order":8083},{"id":"sunshi-e-p043d","title":"陈瑀密遣万演结祖郎焦已严白虎谋袭孙策","accounts":[{"id":"sunshi-e-p043d-account","label":"《江表传》","text":"陈瑀密遣万演结祖郎焦已严白虎谋袭孙策","evidence":["sunshi-e-p043d-q"]}],"participants":[{"person":"sunshi-p0066","role":"谋袭","evidence":["sunshi-e-p043d-q"]},{"person":"sunshi-p0067","role":"密使","evidence":["sunshi-e-p043d-q"]},{"person":"sunshi-p0049","role":"被结","evidence":["sunshi-e-p043d-q"]},{"person":"sunshi-p0068","role":"被结","evidence":["sunshi-e-p043d-q"]},{"person":"sunshi-p0050","role":"被结","evidence":["sunshi-e-p043d-q"]}],"place":null,"time":{"year":197,"label":"建安二年夏","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"sunshi-y197","dating_review":{"reviewed":true,"anchor":"sunshi-q-p043","basis":"建安二年夏"},"evidence":["sunshi-e-p043d-q","sunshi-q-p043","wudi-q-o050","wudi-q-b-40d8b7057f4a29d6fe0d"]},"ordering_evidence":"sunshi-e-p043d-q","source_order":[46,255,"P043d"],"order":8110},{"id":"feipin-e-02bb1c0762421dc4f0d2","title":"孙策孙河吕范依吴景共讨祖郎","accounts":[{"id":"feipin-a-02bb1c0762421dc4f0d2","label":"正文","text":"孙策孙河吕范依吴景共讨祖郎","evidence":["feipin-q-7aed1d8c9b523e023a4e"]}],"participants":[{"person":"wudi-p0099","role":"依景共讨者","evidence":["feipin-q-7aed1d8c9b523e023a4e"]},{"person":"sunshi-p0040","role":"共讨者","evidence":["feipin-q-7aed1d8c9