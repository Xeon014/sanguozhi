2-41f3ee7b0febd8c44efd"]}],"aliases":[],"mentions":[]}],"evidence":[{"id":"zongshi-q-803d3a3a8ea5c1982bde","section":"chapter-051","block":"b-838933eb0906948787bc","layer":"pei","quote":"成都王颖，召为大将军参军。是时颖将有事于长沙，以陆机为前锋都督。惠与机，乡里亲厚，忧其致祸。谓之曰：‘子盍让都督于王粹乎？’机曰：‘将谓吾避贼首鼠，更速其害！’机寻被戮；二弟云、耽，亦见杀。惠甚伤恨之","attribution":"裴注·惠别传","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":134,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1c9591ac978a693556d2","start":164,"end":264,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-83223e6b8c7ffc0dfb7c","section":"chapter-051","block":"b-d784627aa3d293accfb1","layer":"pei","quote":"永安中，陆机为成都王大都督，请丞为司马：与机俱被害","attribution":"裴注·文士传","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":233,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-75f5bb207dd97fe936cc","start":120,"end":145,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-ad15a2fd65a0be67e641","section":"chapter-051","block":"b-d784627aa3d293accfb1","layer":"pei","quote":"吴平，赴洛。为范阳、涿令，甚有称绩","attribution":"裴注·文士传","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":233,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-75f5bb207dd97fe936cc","start":102,"end":119,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-f7283354509e4de67308","section":"chapter-051","block":"b-d784627aa3d293accfb1","layer":"pei","quote":"为黄门侍郎，与顾荣俱为侍臣。归命世，内侍多得罪尤；惟荣、丞，独获全。常使二人记事：丞答，顾问。乃下诏曰：‘自今以后，用侍郎，皆当如今宗室丞、顾荣畴也","attribution":"裴注·文士传","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":233,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-75f5bb207dd97fe936cc","start":26,"end":100,"offset_unit":"unicode_code_point"},{"id":"zongshi-q2-3aa9aa78b3086e01b0d4","section":"chapter-051","block":"b-d784627aa3d293accfb1","layer":"pei","quote":"与机俱被害。","attribution":"裴注·文士传","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":233,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-75f5bb207dd97fe936cc","start":140,"end":146,"offset_unit":"unicode_code_point"},{"id":"zongshi-q2-41f3ee7b0febd8c44efd","section":"chapter-051","block":"b-d784627aa3d293accfb1","layer":"pei","quote":"《文士传》曰：“丞好学，有文章，作《萤火赋》行于世。为黄门侍郎，与顾荣俱为侍臣。归命世，内侍多得罪尤；惟荣、丞，独获全。常使二人记事：丞答，顾问。乃下诏曰：‘自今以后，用侍郎，皆当如今宗室丞、顾荣畴也。’吴平，赴洛。为范阳、涿令，甚有称绩。永安中，陆机为成都王大都督，请丞为司马：与机俱被害。”","attribution":"裴注·文士传","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":233,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-75f5bb207dd97fe936cc","start":0,"end":147,"offset_unit":"unicode_code_point"},{"id":"zongshi-q2-68bf95195e074706b982","section":"chapter-051","block":"b-838933eb0906948787bc","layer":"pei","quote":"机寻被戮；二弟云、耽，亦见杀。","attribution":"裴注（引书见原文）","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":134,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1c9591ac978a693556d2","start":244,"end":259,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
