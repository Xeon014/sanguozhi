3cb7784","layer":"original","quote":"正始三年，薨。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":191,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":42,"end":49,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-f9cbb42707861e45ef03","section":"chapter-020","block":"b-7461d09158a6b26d0eba","layer":"original","quote":"五年〖11〗，改封寿张县。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":190,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":62,"end":75,"offset_unit":"unicode_code_point"},{"id":"xinyang-q-39f37f4204cd825214bc","section":"chapter-025","block":"b-66d36758f08ab16ca65f","layer":"original","quote":"后为历城侯徽文学〖11〗，转为相〖12〗。徽遭太祖丧，不哀，反游猎驰骋；隆以义正谏，甚得辅导之节。","section_title":"辛毗杨阜高堂隆传第二十五","source":{"file":"OEBPS/Text/titlepage_0056.xhtml","index":283,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":20,"end":69,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
