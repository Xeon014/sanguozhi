person":"wanglou-p-8cf334c2997b5d","role":"暴卒；不忍宣诏","evidence":["wanglou-q-476bee47df454d289bbf","wanglou-q-bfecf32fa6e5200ee9ca"]},{"person":"luxun-p0068","role":"殡殓自杀；服药死","evidence":["wanglou-q-476bee47df454d289bbf","wanglou-q-bfecf32fa6e5200ee9ca"]},{"person":"shaodi-p0162","role":"追赐鸩","evidence":["wanglou-q-bfecf32fa6e5200ee9ca"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["wanglou-q-476bee47df454d289bbf","wanglou-q-bfecf32fa6e5200ee9ca"]},"ordering_evidence":"wanglou-q-476bee47df454d289bbf","related_events":[{"event":"wanglou-e-13e4993f58d74e1d5ee3","type":"disputes","evidence":["wanglou-q-fbd2c4cec6f85f1c3501","wanglou-q-476bee47df454d289bbf"]},{"event":"wanglou-e-13e4993f58d74e1d5ee3","type":"related","evidence":["wanglou-q-fbd2c4cec6f85f1c3501","wanglou-q-bfecf32fa6e5200ee9ca"]}],"order":11085},{"id":"wanglou-e-4c07b489c0b3f8716c73","title":"玄一身随张奕讨贼持刀步涉，见奕辄拜，奕未忍杀","accounts":[{"id":"wanglou-a-4c07b489c0b3f8716c73","label":"正文","text":"玄一身随张奕讨贼持刀步涉，见奕辄拜，奕未忍杀","evidence":["wanglou-q-6dd76b59dcd2526684b1"]}],"participants":[{"person":"luxun-p0068","role":"随军","evidence":["wanglou-q-6dd76b59dcd2526684b1"]},{"person":"wanglou-p-8cf334c2997b5d","role":"不忍杀","evidence":["wanglou-q-6dd76b59dcd2526684b1"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["wanglou-q-6dd76b59dcd2526684b1"]},"ordering_evidence":"wanglou-q-6dd76b59dcd2526684b1","order":11086}],"persons":[{"id":"luxun-p0068","name":"楼玄","evidence":["luxun-q-o076","panlu-q-9c803300aa82314d1ecc","wanglou-q-a871e5db07666b571a4a","wanglou-q-52d65d2e16edfb68507e","wanglou-q-6d1cf42f3fc6c1bcbe9e","wanglou-q-bae19f7acced18823df0","wanglou-q-a2a55d178d91b6102527","wanglou-q-aa03cbec665ff38c576e","wanglou-q-5bd3d48dc548f98401cb","wanglou-q-6dd76b59dcd2526684b1","wanglou-q-476bee47df454d289bbf","wanglou-q-d359aec17a52ef09f670","wanglou-q-bfecf32fa6e5200ee9ca","wanglou-q-25c44a67616df63c1e52","wanglou-q-fbd2c4cec6f85f1c3501","wanglou-q-ccf1d82615dbb9718f39","wanglou-q-845b6b65fb393511b3fa"],"facts":[{"id":"wanglou-f-41ef28ee00f6b6683ac8","text":"字承先","evidence":["wanglou-q-a871e5db07666b571a4a"]},{"id":"wanglou-f-df6b96395a5b14d4544d","text":"沛郡蕲人","evidence":["wanglou-q-a871e5db07666b571a4a"]}],"aliases":[],"mentions":[{"id":"luxun-m-o076-luxun-p0068","kind":"mention","text":"文中提及","evidence":["luxun-q-o076"]},{"id":"panlu-m-0aabdb4a05519ee4de43","kind":"mention","text":"本段涉及楼玄","evidence":["panlu-q-9c803300aa82314d1ecc"]},{"id":"wanglou-m-9c7a04ff33e2e5b47a24","kind":"mention","text":"裴松之论楼玄之死，取《江表传》说为长","evidence":["wanglou-q-fbd2c4cec6f85f1c3501"]},{"id":"wanglou-m-d62e95b35f5f38c50590","kind":"mention","text":"陈寿录薛莹、胡冲评王蕃楼玄贺邵韦曜华覈，并论数子遭际","evidence":["wanglou-q-ccf1d82615dbb9718f39"]},{"id":"wanglou-m-d67137bc79267b594f64","kind":"mention","text":"本篇记载：字承先，沛郡蕲人","evidence":["wanglou-q-845b6b65fb393511b3fa"]}]}],"evidence":[{"id":"luxun-q-o076","section":"chapter-058","block":"b-11441c73cfeb9b85407b","layer":"original","quote":"闻武昌左部督薛莹，征下狱〖1〗，抗上疏曰：“夫俊乂者〖2〗，国家之良宝，社稷之贵资；庶政所以伦叙〖3〗，四门所以穆清也〖4〗。故大司农楼玄、散骑中常侍王蕃、少府李勖〖5〗，皆当世秀颖，一时显器；既蒙初宠，从容列位〖6〗；而并旋受诛殛，或圮族替祀〖7〗，或投弃荒裔。盖《周礼》有赦贤之辟〖8〗，《春秋》有宥善之义〖9〗。《书》曰：‘与其杀不辜〖10〗，宁失不经〖11〗。’而蕃等罪名未定，大辟已加〖12〗；心经忠义，身被极刑：岂不痛哉！且已死之刑〖13〗，固无所识〖14〗；至乃焚烁流漂，弃之水滨：惧非先王之正典，或甫侯之所戒也〖15〗。是以百姓哀耸，士民同戚。蕃、勖永已，悔亦靡及〖16〗；诚望陛下，赦召玄出。而顷闻薛莹，猝见逮录〖17〗。莹父综，纳言先帝〖18〗，傅弼文皇〖19〗。及莹承基，内厉名行；今之所坐〖20〗，罪在可宥。臣惧有司，未详其事；如复诛戮，益失民望。乞垂天恩，原赦莹罪；哀矜庶狱〖21〗，清澄刑网〖22〗。则天下幸甚！”","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":378,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":421,"offset_unit":"unicode_code_point"},{"id":"panlu-q-9c803300aa82314d1ecc","section":"chapter-061","block":"b-868322f07629aeb01c40","layer":"original","quote":"姚信、楼玄、贺邵、张悌、郭逴、薛莹、滕修及族弟喜、抗，或清白忠勤，或姿才卓茂〖6〗；皆社稷之桢干〖7〗，国家之良辅；愿陛下重留神思，访以时务：各尽其忠，拾遗万一","section_title":"潘濬陆凯传第十六","source":{"file":"OEBPS/Text/titlepage_0129.xhtml","index":128,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":70,"end":150,"offset_unit":"unicode_code_point"},{"id":"wanglou-q-25c44a67616df63c1e52","section":"chapter-065","block":"b-e5c381d0063d56d05501","layer":"original","quote":"玄见送南州〖92〗","section_title":"王楼贺韦华传第二十","source":{"file":"OEBPS/Text/titlepage_0137.xhtml","index":81,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":36,"end":45,"offset_unit":"unicode_code_point"},{"id":"wanglou-q-476bee47df454d289bbf","section":"chapter-065","block":"b-a7538fff8b967c64021b","layer":"original","quote":"皓疾玄名声，复徙玄及子据；付交阯将张奕〖17〗，使以战自效；阴别敕奕，令杀之。据至交阯，病死。玄一身随奕讨贼〖18〗，持刀步涉；见奕辄拜，奕未忍杀。会奕暴卒〖19〗，玄殡殓奕。于器中见敕书，还便自杀。﹝一﹞","section_title":"王楼贺韦华传第二十","source":{"file":"OEBPS/Text/titlepage_0137.xhtml","index":41,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":103,"offset_unit":"unicode_code_point"},{"id":"wanglou-q-52d65d2e16edfb68507e","section":"chapter-065","block":"b-3a9b33fc8ece7eee5aaa","layer":"original","quote":"孙皓即位，与王蕃、郭逴、万彧俱为散骑中常侍。出为会稽太守。入为大司农。旧禁中主者，自用亲近人作之〖3〗。彧陈亲密近识，宜用好人；皓因敕有司〖4〗：求忠清之士，以应其选。遂用玄为宫下镇，禁中候〖5〗，主殿中事。","section_title":"王楼贺韦华传第二十","source":{"file":"OEBPS/Text/titlepage_0137.xhtml","index":38,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":104,"offset_unit":"unicode_code_point"},{"id":"wanglou-q-5bd3d48dc548f98401cb","section":"chapter-065","block":"b-a7538fff8b967c64021b","layer":"original","quote":"皓疾玄名声，复徙玄及子据；付交阯将张奕〖17〗，使以战自效；阴别敕奕，令杀之","section_title":"王楼贺韦华传第二十","source":{"file":"OEBPS/Text/titlepage_0137.xhtml","index":41,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":38,"offset_unit":"unicode_code_point"},{"id":"wanglou-q-6d1cf42f3fc6c1bcbe9e","section":"chapter-065","block":"b-3a9b33fc8ece7eee5aaa","layer":"original","quote":"彧陈亲密近识，宜用好人；皓因敕有司〖4〗：求忠清之士，以应其选。遂用玄为宫下镇，禁中候〖5〗，主殿中事","section_title":"王楼贺韦华传第二十","source":{"file":"OEBPS/Text/titlepage_0137.xhtml","index":38,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":52,"end":103,"offset_unit":"unicode_code_point"},{"id":"wanglou-q-6dd76b59dcd2526684b1","section":"chapter-065","block":"b-a7538fff8b967c64021b","layer":"original","quote":"玄一身随奕讨贼〖18〗，持刀步涉；见奕辄拜，奕未忍杀","section_title":"王楼贺韦华传第二十","source":{"file":"OEBPS/Text/titlepage_0137.xhtml","index":41,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":47,"end":73,"offset_unit":"unicode_code_point"},{"id":"wanglou-q-845b6b65fb393511b3fa","section":"chapter-065","block":"b-be73d7c4a4dff3757cb7","layer":"original","quote":"楼玄字承先，沛郡蕲人也","section_title":"王楼贺韦华传第二十","source":{"file":"OEBPS/Text/titlepage_0137.xhtml","index":37,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":11,"offset_unit":"unicode_code_point"},{"id":"wanglou-q-a2a55d178d91b6102527","section":"chapter-065","block":"b-cb36afc09fba6df88fb5","layer":"original","quote":"后人诬白玄与贺邵相逢，驻，共耳语大笑，谤讪政事","section_title":"王楼贺韦华传第二十","source":{"file":"OEBPS/Text/titlepage_0137.xhtml","index":39,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":35,"end":58,"offset_unit":"unicode_code_point"},{"id":"wanglou-q-a871e5db07666b571a4a","section":"chapter-065","block":"b-be73d7c4a4dff3757cb7","layer":"original","quote":"楼玄字承先，沛郡蕲人也〖1〗。孙休时为监农御史〖2〗。","section_title":"王楼贺韦华传第二十","source":{"file":"OEBPS/Text/titlepage_0137.xhtml","index":37,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":27,"offset_unit":"unicode_code_point"},{"id":"wanglou-q-aa03cbec665ff38c576e","section":"chapter-065","block":"b-cb36afc09fba6df88fb5","layer":"original","quote":"玄从九卿，持刀侍卫；正身率众，奉法而行；应对切直，数忤皓意：渐见责怒。后人诬白玄与贺邵相逢，驻，共耳语大笑，谤讪政事。遂被诏诘责，送付广州。","section_title":"王楼贺韦华传第二十","source":{"file":"OEBPS/Text/titlepage_0137.xhtml","index":39,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":70,"offset_unit":"unicode_code_point"},{"id":"wanglou-q-bae19f7acced18823df0","section":"chapter-065","block":"b-cb36afc09fba6df88fb5","layer":"original","quote":"玄从九卿，持刀侍卫；正身率众，奉法而行；应对切直，数忤皓意：渐见责怒","section_title":"王楼贺韦华传第二十","source":{"file":"OEBPS/Text/titlepage_0137.xhtml","index":39,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":34,"offset_unit":"unicode_code_point"},{"id":"wanglou-q-bfecf32fa6e5200ee9ca","section":"chapter-065","block":"b-33f46caab52802f3c5e3","layer":"pei","quote":"﹝一﹞《江表传》曰：“皓遣将张奕，追赐玄鸩；奕以玄贤者，不忍即宣诏致药。玄阴知之，谓奕曰：‘当早告玄，玄何惜邪！’即服药死。”","attribution":"《江表传》","section_title":"王楼贺韦华传第二十","source":{"file":"OEBPS/Text/titlepage_0137.xhtml","index":63,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-d06f42d86dcf2007353b","start":0,"end":63,"offset_unit":"unicode_code_point"},{"id":"wanglou-q-ccf1d82615dbb9718f39","section":"chapter-065","block":"b-d6be71290e551050ab3b","layer":"original","quote":"评曰：薛莹称“王蕃器量绰异〖1〗，弘博多通；楼玄清白节操，才理条畅；贺邵厉志高洁，机理清要〖2〗；韦曜笃学好古，博见群籍，有记述之才”。胡冲以为：“玄、邵、蕃一时清妙，略无优劣；必不得已，玄宜在先，邵当次之。华覈文赋之才〖3〗，有过于曜；而典诰不及也〖4〗。”予观覈数献良规，期于自尽〖5〗，庶几忠臣矣〖6〗！然此数子，处无妄之世而有名位〖7〗，强死其理〖8〗，得免为幸耳。","section_title":"王楼贺韦华传第二十","source":{"file":"OEBPS/Text/titlepage_0137.xhtml","index":499,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":187,"offset_unit":"unicode_code_point"},{"id":"wanglou-q-d359aec17a52ef09f670","section":"chapter-065","block":"b-e5c381d0063d56d05501","layer":"original","quote":"邵奉公贞正，亲近所惮。乃共谮邵与楼玄谤毁国事，俱被诘责","section_title":"王楼贺韦华传第二十","source":{"file":"OEBPS/Text/titlepage_0137.xhtml","index":81,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":8,"end":35,"offset_unit":"unicode_code_point"},{"id":"wanglou-q-fbd2c4cec6f85f1c3501","section":"chapter-065","block":"b-38722480a2c5d0cb88c4","layer":"pei","quote":"臣松之以玄之清高，必不以安危易操；无缘骤拜张奕，以亏其节。且祸机既发，岂百拜所免？《江表传》所言，于理为长。","attribution":"裴松之论","section_title":"王楼贺韦华传第二十","source":{"file":"OEBPS/Text/titlepage_0137.xhtml","index":64,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-d06f42d86dcf2007353b","start":0,"end":54,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
