[{"id":"luxun-p0057","name":"张咸","evidence":["luxun-q-o072"],"facts":[],"aliases":[],"mentions":[{"id":"luxun-m-o072-luxun-p0057","kind":"mention","text":"文中提及","evidence":["luxun-q-o072"]},{"id":"luxun-m-o073-luxun-p0057","kind":"mention","text":"文中提及","evidence":["luxun-q-o073"]}]}],"evidence":[{"id":"luxun-e-o072a-q","section":"chapter-058","block":"b-1d3568cbbcce75558f17","layer":"original","quote":"初，江陵平衍，道路通利；抗敕江陵督张咸：作大堰遏水〖10〗，渐渍平中〖11〗，以绝寇叛。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":349,"anchor":null},"note_id":null,"start":0,"end":44},{"id":"luxun-e-o072b-q","section":"chapter-058","block":"b-1d3568cbbcce75558f17","layer":"original","quote":"祜欲因所遏水，浮船运粮，扬声将破堰以通步军。抗闻，使咸亟破之。诸将皆惑，屡谏；不听。祜至当阳，闻堰败，乃改船以车运，大费损功力。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":349,"anchor":null},"note_id":null,"start":44,"end":108},{"id":"luxun-e-o073b-q","section":"chapter-058","block":"b-00c7d3403d867b106f10","layer":"original","quote":"抗令张咸固守其城；公安督孙遵巡南岸御祜〖13〗；水军督留虑、镇西将军朱琬拒胤；身率三军，凭围对肇。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":350,"anchor":null},"note_id":null,"start":28,"end":77},{"id":"luxun-q-o072","section":"chapter-058","block":"b-1d3568cbbcce75558f17","layer":"original","quote":"初，江陵平衍，道路通利；抗敕江陵督张咸：作大堰遏水〖10〗，渐渍平中〖11〗，以绝寇叛。祜欲因所遏水，浮船运粮，扬声将破堰以通步军。抗闻，使咸亟破之。诸将皆惑，屡谏；不听。祜至当阳，闻堰败，乃改船以车运，大费损功力。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":349,"anchor":null},"note_id":null,"start":0,"end":108},{"id":"luxun-q-o073","section":"chapter-058","block":"b-00c7d3403d867b106f10","layer":"original","quote":"晋巴东监军徐胤率水军诣建平〖12〗，荆州刺史杨肇至西陵。抗令张咸固守其城；公安督孙遵巡南岸御祜〖13〗；水军督留虑、镇西将军朱琬拒胤；身率三军，凭围对肇。将军朱乔、营都督俞赞，亡诣肇〖14〗。抗曰：“赞军中旧吏，知吾虚实者。吾常虑夷兵素不简练〖15〗，若敌攻围，必先此处！”即夜易夷（民）〔兵〕，皆以旧将充之。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":350,"anchor":null},"note_id":null,"start":0,"end":155}],"profiles":{},"directory_counts":{}}
