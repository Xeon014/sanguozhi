9"]}],"participants":[{"person":"santizhu-p0019","role":"受遣就施绩等取诸葛融","evidence":["zhanggu-q-8b9e70c5556972f45fd9"]},{"person":"shaodi-p0155","role":"同取诸葛融","evidence":["zhanggu-q-8b9e70c5556972f45fd9"]},{"person":"shaodi-p0112","role":"同取诸葛融","evidence":["zhanggu-q-8b9e70c5556972f45fd9"]},{"person":"zhanggu-p0003","role":"同取诸葛融","evidence":["zhanggu-q-8b9e70c5556972f45fd9"]},{"person":"zhanggu-p0030","role":"被围饮药而死，三子皆伏诛","evidence":["zhanggu-q-8b9e70c5556972f45fd9"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["zhanggu-q-8b9e70c5556972f45fd9"]},"ordering_evidence":"zhanggu-q-8b9e70c5556972f45fd9","source_order":[52,317,0],"order":9358}],"persons":[{"id":"shaodi-p0112","name":"孙壹","evidence":["shaodi-q-o124","wgc-q0075","santizhu059-q-28d45c0550f0e85b10a3","zhanggu-q-8b9e70c5556972f45fd9","zongshi-q-268a2355ce4ea7de043f","zongshi-q-ecaf8adc789ce848f183","zongshi-q-495c745c24e943347c58","zongshi-q-c8c913b61216af99a383","zongshi-q-87b9127c6919627b45b5","zongshi-q-8d889d5c3d2faae89e40","zongshi-q2-eba5de8947a13c9b6b33"],"facts":[{"id":"zongshi-f2-1122e77d20e23795fd05","text":"从镇南迁镇军，假节督夏口。","evidence":["zongshi-q2-eba5de8947a13c9b6b33"]}],"aliases":[],"mentions":[{"id":"shaodi-m-o124-shaodi-p0112","kind":"mention","text":"文中提及","evidence":["shaodi-q-o124"]},{"id":"shaodi-m-p034-shaodi-p0112","kind":"mention","text":"文中提及","evidence":["shaodi-q-p034"]},{"id":"shaodi-m-o138-shaodi-p0112","kind":"mention","text":"文中提及","evidence":["shaodi-q-o138"]},{"id":"wgc-m-o098-shaodi-p0112","kind":"mention","text":"本段涉及孙壹","evidence":["wgc-q0075"]}]}],"evidence":[{"id":"santizhu059-q-28d45c0550f0e85b10a3","section":"chapter-059","block":"b-e25487f8fc885f1b335b","layer":"original","quote":"孙皓即位，追和、霸旧隙，削基、壹爵土，与祖母谢姬俱徙会稽乌伤县","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":230,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":31,"offset_unit":"unicode_code_point"},{"id":"shaodi-e-o124a-q","section":"chapter-004","block":"b-724e4d584ead501e0188","layer":"original","quote":"六月，乙巳〖21〗，诏：“吴使持节、都督夏口诸军事、镇军将军、沙羡侯孙壹〖22〗，贼之支属，位为上将；畏天知命，深鉴祸福；翻然举众，远归大国。虽微子去殷〖23〗，乐毅遁燕〖24〗，无以加之。其以壹为侍中、车骑将军，假节，交州牧，吴侯；开府辟召仪同三司〖25〗；依古侯伯八命之礼〖26〗，衮冕、赤舄：事从丰厚。”﹝一﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":529,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":158,"offset_unit":"unicode_code_point"},{"id":"shaodi-e-o138b-q","section":"chapter-004","block":"b-90d081a32f3abfc181f4","layer":"original","quote":"冬十月，丙寅〖3〗，分新城郡，复置上庸郡。十一月，癸卯〖4〗，车骑将军孙壹为婢所杀。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":37,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":42,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-b-6209c552405e0ebbdf98","section":"chapter-004","block":"b-6209c552405e0ebbdf98","layer":"modern","quote":"〖1〗二年：甘露二年（公元 257 ）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":535,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4dd98e402a6a8de51491","start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-b-c919b0b274bfdccf1c17","section":"chapter-004","block":"b-c919b0b274bfdccf1c17","layer":"modern","quote":"〖1〗四年：甘露四年（公元 259）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":39,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-20f59c750826a5b508ea","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o117","section":"chapter-004","block":"b-d021e0b00f489a01f208","layer":"original","quote":"二年春二月〖1〗，青龙现温县井中。三月，司空卢毓薨。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":522,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":26,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o124","section":"chapter-004","block":"b-724e4d584ead501e0188","layer":"original","quote":"六月，乙巳〖21〗，诏：“吴使持节、都督夏口诸军事、镇军将军、沙羡侯孙壹〖22〗，贼之支属，位为上将；畏天知命，深鉴祸福；翻然举众，远归大国。虽微子去殷〖23〗，乐毅遁燕〖24〗，无以加之。其以壹为侍中、车骑将军，假节，交州牧，吴侯；开府辟召仪同三司〖25〗；依古侯伯八命之礼〖26〗，衮冕、赤舄：事从丰厚。”﹝一﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":529,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":158,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o135","section":"chapter-004","block":"b-72c9f9276a8abbc231e6","layer":"original","quote":"四年春正月〖1〗，黄龙二，现宁陵县界井中。﹝一﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":34,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":24,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o138","section":"chapter-004","block":"b-90d081a32f3abfc181f4","layer":"original","quote":"冬十月，丙寅〖3〗，分新城郡，复置上庸郡。十一月，癸卯〖4〗，车骑将军孙壹为婢所杀。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":37,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":42,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-p034","section":"chapter-004","block":"b-35d064e11b05dfeb4b27","layer":"pei","quote":"﹝一﹞臣松之以为：壹畏逼归命，事无可嘉。格以古义，欲盖而名彰者也。当时之宜，未得远遵式典；固应量才受赏，足以酬其来情而已。至乃光锡八命，礼同台鼎，不亦过乎！于招携致远，又无取焉。何者？若使彼之将守，与时无嫌，终不悦于殊宠，坐生叛心；以叛而愧，辱孰甚焉？如其忧危将及，非奔不免，则必逃死苟存，无希荣利矣：然则高位厚禄，何为者哉？魏初有孟达、黄权，在晋有孙秀、孙楷。达、权爵赏，比壹为轻；秀、楷礼秩，优异尤甚。及至吴平，而降黜数等；不承权舆，岂不缘在始失中乎？","attribution":"裴松之论","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":574,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ad4fae97affa47236d4e","start":0,"end":228,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-p034-judgment","section":"chapter-004","block":"b-35d064e11b05dfeb4b27","layer":"pei","quote":"﹝一﹞臣松之以为：壹畏逼归命，事无可嘉。格以古义，欲盖而名彰者也。当时之宜，未得远遵式典；固应量才受赏，足以酬其来情而已。至乃光锡八命，礼同台鼎，不亦过乎！于招携致远，又无取焉。何者？若使彼之将守，与时无嫌，终不悦于殊宠，坐生叛心；以叛而愧，辱孰甚焉？如其忧危将及，非奔不免，则必逃死苟存，无希荣利矣：然则高位厚禄，何为者哉？魏初有孟达、黄权，在晋有孙秀、孙楷。达、权爵赏，比壹为轻；秀、楷礼秩，优异尤甚。及至吴平，而降黜数等；不承权舆，岂不缘在始失中乎？","attribution":"裴松之论","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":574,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ad4fae97affa47236d4e","start":0,"end":228,"offset_unit":"unicode_code_point"},{"id":"wgc-q0075","section":"chapter-028","block":"b-7c536b5df4fd050637db","layer":"original","quote":"今国朝隆天覆之恩，宰辅弘宽恕之德；先惠后诛，好生恶杀。往者吴将孙壹举众内附〖41〗，位为上司〖42〗，宠秩殊异。文钦、唐咨为国大害，叛主雠贼〖43〗，还为戎首〖44〗。咨困逼擒获，钦二子还降，皆将军、封侯；咨与闻国事。壹等穷蹙归命〖45〗，犹加盛宠，况巴蜀贤智见机而作者哉？诚能深鉴成败，邈然高蹈〖46〗；投迹微子之踪，措身陈平之轨；则福同古人，庆流来裔〖47〗；百姓士民，安堵（旧）〔乐〕业；农不易亩，市不回肆〖48〗；去累卵之危，就永安之福。岂不美与！","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":478,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":228,"offset_unit":"unicode_code_point"},{"id":"zhanggu-q-8b9e70c5556972f45fd9","section":"chapter-052","block":"b-33dcd8c4dccefbc86e0b","layer":"original","quote":"恪既诛，遣无难督施宽，就将军施绩、孙壹、全熙等，取融。融猝闻兵士至，惶惧犹豫，不能决计；兵到围城，饮药而死。三子，皆伏诛","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":316,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":60,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-268a2355ce4ea7de043f","section":"chapter-051","block":"b-691004ad2bb34b7da8c3","layer":"original","quote":"封承庶弟壹，奉奂后，袭业为将","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":71,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":39,"end":53,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-495c745c24e943347c58","section":"chapter-051","block":"b-4d4c1542c098dab2b8c8","layer":"original","quote":"綝遣朱异潜袭壹。异至武昌，壹知其攻己；率部曲千余口，过将胤妻奔魏","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":72,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":83,"end":115,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-87b9127c6919627b45b5","section":"chapter-051","block":"b-6241288b0cc62fe8d83a","layer":"original","quote":"邢美色妒忌；下不堪命〖15〗，遂共杀壹及邢氏","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":73,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":38,"end":60,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-8d889d5c3d2faae89e40","section":"chapter-051","block":"b-6241288b0cc62fe8d83a","layer":"original","quote":"壹入魏（黄初）三年死","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":73,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":61,"end":71,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-c8c913b61216af99a383","section":"chapter-051","block":"b-6241288b0cc62fe8d83a","layer":"original","quote":"魏以壹为车骑将军，仪同三司〖13〗，封吴侯；以故主芳贵人邢氏，妻之","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":73,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":33,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-ecaf8adc789ce848f183","section":"chapter-051","block":"b-4d4c1542c098dab2b8c8","layer":"original","quote":"孙峻之诛诸葛恪也，壹与全熙、施绩攻恪弟公安督融〖10〗，融自杀","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":72,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":31,"offset_unit":"unicode_code_point"},{"id":"zongshi-q2-eba5de8947a13c9b6b33","section":"chapter-051","block":"b-4d4c1542c098dab2b8c8","layer":"original","quote":"孙峻之诛诸葛恪也，壹与全熙、施绩攻恪弟公安督融〖10〗，融自杀。壹从镇南迁镇军〖11〗，假节督夏口。及孙綝诛滕胤、吕据，据、胤皆壹之妹夫也；壹弟封又知胤、据谋，自杀：綝遣朱异潜袭壹。异至武昌，壹知其攻己；率部曲千余口，过将胤妻奔魏〖12〗。","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":72,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":120,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
