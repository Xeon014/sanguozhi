ndated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xunyu-e-o059a-q"]},"ordering_evidence":"xunyu-e-o059a-q","source_order":[10,299,"O059a"],"order":2521}],"persons":[{"id":"xunyu-p0099","name":"段煨","evidence":["xunyu-q-o058"],"facts":[],"aliases":[],"mentions":[{"id":"xunyu-m-o058-xunyu-p0099","kind":"mention","text":"文中提及","evidence":["xunyu-q-o058"]},{"id":"xunyu-m-p052-xunyu-p0099","kind":"mention","text":"文中提及","evidence":["xunyu-q-p052"]},{"id":"xunyu-m-o059-xunyu-p0099","kind":"mention","text":"文中提及","evidence":["xunyu-q-o059"]}]}],"evidence":[{"id":"xunyu-e-o058a-q","section":"chapter-010","block":"b-b54c88a780f9ce130dcd","layer":"original","quote":"是时将军段煨屯华阴，﹝六﹞与诩同郡，遂去傕托煨〖10〗。诩素知名，为煨军所望〖11〗。煨内恐其见夺，而外奉诩礼甚备。诩愈不自安。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":278,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":64,"offset_unit":"unicode_code_point"},{"id":"xunyu-e-o059a-q","section":"chapter-010","block":"b-072c10e2a3d3871fdcf8","layer":"original","quote":"张绣在南阳，诩阴结绣。绣遣人迎诩，诩将行。或谓诩曰：“煨待君厚矣，君安去之？”诩曰：“煨性多疑，有忌诩意；礼虽厚，不可恃：久将为所图。我去必喜，又望吾结大援于外，必厚吾妻子。绣无谋主，亦愿得诩；则家与身，必俱全矣。”诩遂往，绣执子孙礼〖1〗。煨果善视其家。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":298,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":128,"offset_unit":"unicode_code_point"},{"id":"xunyu-e-p052a-q","section":"chapter-010","block":"b-bc7762b8bcd5e1dcb8aa","layer":"pei","quote":"煨在华阴时，修农事，不虏略。天子东还，煨迎道，贡遗周急。","attribution":"《典略》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":297,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0720eceb717bd466c28a","start":10,"end":38,"offset_unit":"unicode_code_point"},{"id":"xunyu-e-p052b-q","section":"chapter-010","block":"b-bc7762b8bcd5e1dcb8aa","layer":"pei","quote":"后以煨为大鸿胪，光禄大夫。建安十四年，以寿终。","attribution":"《献帝纪》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":297,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0720eceb717bd466c28a","start":47,"end":70,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-o058","section":"chapter-010","block":"b-b54c88a780f9ce130dcd","layer":"original","quote":"是时将军段煨屯华阴，﹝六﹞与诩同郡，遂去傕托煨〖10〗。诩素知名，为煨军所望〖11〗。煨内恐其见夺，而外奉诩礼甚备。诩愈不自安。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":278,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":64,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-o059","section":"chapter-010","block":"b-072c10e2a3d3871fdcf8","layer":"original","quote":"张绣在南阳，诩阴结绣。绣遣人迎诩，诩将行。或谓诩曰：“煨待君厚矣，君安去之？”诩曰：“煨性多疑，有忌诩意；礼虽厚，不可恃：久将为所图。我去必喜，又望吾结大援于外，必厚吾妻子。绣无谋主，亦愿得诩；则家与身，必俱全矣。”诩遂往，绣执子孙礼〖1〗。煨果善视其家。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":298,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":128,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-p052","section":"chapter-010","block":"b-bc7762b8bcd5e1dcb8aa","layer":"pei","quote":"﹝六﹞《典略》称：“煨在华阴时，修农事，不虏略。天子东还，煨迎道，贡遗周急。”《献帝纪》曰：“后以煨为大鸿胪，光禄大夫。建安十四年，以寿终。”","attribution":"《典略》《献帝纪》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":297,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0720eceb717bd466c28a","start":0,"end":71,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
