{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[],"persons":[{"id":"xunyu-p0009","name":"荀靖","evidence":["xunyu-q-p002"],"facts":[{"id":"xunyu-f0006","label":"字","text":"叔慈","evidence":["xunyu-f0006-q"]}],"aliases":[{"text":"叔慈","evidence":["xunyu-f0006-q"]}],"mentions":[{"id":"xunyu-m-p002-xunyu-p0009","kind":"mention","text":"文中提及","evidence":["xunyu-q-p002"]},{"id":"xunyu-m-p003-xunyu-p0009","kind":"mention","text":"文中提及","evidence":["xunyu-q-p003"]}]}],"evidence":[{"id":"xunyu-f0006-q","section":"chapter-010","block":"b-9e7f1bade3933fa1462b","layer":"pei","quote":"靖字叔慈","attribution":"张璠《汉纪》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":17,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c347ca05b53d613cd76d","start":234,"end":238,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-p002","section":"chapter-010","block":"b-9e7f1bade3933fa1462b","layer":"pei","quote":"张璠《汉纪》曰：“淑，博学有高行，与李固、李膺同志友善；拔李昭于小吏，友黄叔度于幼童。以贤良方正，征。对策讥切梁氏，出补朗陵侯相。卒官。八子：俭、绲、靖、焘、（诜）〔汪〕、爽、肃、旉。音敷。爽字慈明。幼好学，年十二，通《春秋》、《论语》。耽思经典，不应征命，积十数年。董卓秉政，复征爽；爽欲遁去，吏持之急。诏下郡，即拜平原相；行至苑陵，又追拜光禄勋；视事三日，策拜司空。爽起自布衣，九十五日而至三公。淑旧居西豪里，县令苑康曰‘昔高阳氏有才子八人’，署其里为‘高阳里’。靖字叔慈。亦有至德，名几亚爽，隐居终身。”","attribution":"张璠《汉纪》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":17,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c347ca05b53d613cd76d","start":0,"end":255,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-p003","section":"chapter-010","block":"b-b3af7d5b7883950a1fbb","layer":"pei","quote":"皇甫谧《逸士传》：“或问许子将：‘靖与爽，孰贤？’子将曰：‘二人皆玉也；慈明外朗，叔慈内润。’”","attribution":"皇甫谧《逸士传》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":18,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c347ca05b53d613cd76d","start":0,"end":48,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
