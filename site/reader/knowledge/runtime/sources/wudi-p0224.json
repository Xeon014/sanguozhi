idence":["gongsuntao-q-cda2e1ef94fa119ebf46"]}],"participants":[{"person":"wudi-p0224","role":"薨","evidence":["gongsuntao-q-cda2e1ef94fa119ebf46"]},{"person":"gongsuntao-p0031","role":"燕子、嗣、后薨","evidence":["gongsuntao-q-cda2e1ef94fa119ebf46"]},{"person":"gongsuntao-p0039","role":"方子、嗣","evidence":["gongsuntao-q-cda2e1ef94fa119ebf46"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["gongsuntao-q-cda2e1ef94fa119ebf46"]},"ordering_evidence":"gongsuntao-q-cda2e1ef94fa119ebf46","source_order":[8,241,0],"order":2063}],"persons":[{"id":"wudi-p0224","name":"张燕","evidence":["wudi-q-o102","dongyuan-q-o040","lvzang-q-36d12b824c4b3cd8157b","gongsuntao-q-80aa92e124710a14b4f2","gongsuntao-q-352e875572083c579bf3","gongsuntao-q-87ffd1873a7cc9766308","gongsuntao-q-95e6846afe7e5fb96b3f","gongsuntao-q-1a7ba03b46ca448f1f0b","gongsuntao-q-dddf0919a78e73c8fbb9","gongsuntao-q-9a87ca7765a535739c8d","gongsuntao-q-cda2e1ef94fa119ebf46","gongsuntao-q-4bfbe59d87df62dc7326","gongsuntao-q-82f8931ae2008a52d728","gongsuntao-q-264bc28b0674e766523e","gongsuntao-q-4c15e4ee9d44d6ec38ef","gongsuntao-q-092dc63a1f96ce5f40a5"],"facts":[{"id":"gongsuntao-f-review-3a91c12ff8c8d8a6277c","text":"常山真定人，本姓褚","evidence":["gongsuntao-q-264bc28b0674e766523e"]},{"id":"gongsuntao-f-review-cd8a6fe10ad8559ebefd","text":"剽悍捷速过人，故军中号曰飞燕","evidence":["gongsuntao-q-4c15e4ee9d44d6ec38ef"]},{"id":"gongsuntao-f-review-04c68eaa33cfc51bbde2","text":"典略记：《典略》黑山黄巾诸帅自相号字，谓轻捷者为张飞燕","evidence":["gongsuntao-q-092dc63a1f96ce5f40a5"]}],"aliases":[],"mentions":[{"id":"wudi-m-o102-wudi-p0224","kind":"mention","text":"文中提及","evidence":["wudi-q-o102"]},{"id":"dongyuan-m-o040-wudi-p0224","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o040"]},{"id":"gongsuntao-m-review-7a5345f5a9fd70ac1c5d","kind":"mention","text":"张燕见于相关言论或记载。","evidence":["gongsuntao-q-4bfbe59d87df62dc7326","gongsuntao-q-82f8931ae2008a52d728"]}]}],"evidence":[{"id":"dongyuan-q-o040","section":"chapter-006","block":"b-d1dc27b2f8ddd7223f4f","layer":"original","quote":"绍遂领冀州牧。从事沮授说绍曰：“将军弱冠登朝〖1〗，则播名海内；值废立之际，则忠义奋发；单骑出奔，则董卓怀怖；济河而北，则勃海稽首〖2〗。振一郡之卒〖3〗，撮冀州之众；威震河朔〖4〗，名重天下。虽黄巾猾乱〖5〗，黑山跋扈；举军东向，则青州可定；还讨黑山，则张燕可灭；回众北首〖6〗，则公孙必丧；震胁戎狄，则匈奴必从。横大河之北〖7〗，合四州之地〖8〗；收英雄之才，拥百万之众；迎大驾于西京〖9〗，复宗庙于洛邑〖10〗；号令天下，以讨未复〖11〗。以此争锋，谁能敌之！比及数年，此功不难。”绍喜曰：“此吾心也！”即表授为监军、奋威将军〖12〗。﹝一﹞","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":249,"anchor":null},"note_id":null,"start":0,"end":274},{"id":"gongsuntao-q-092dc63a1f96ce5f40a5","section":"chapter-008","block":"b-b560e7bc124199ffa479","layer":"pei","quote":"黑山、黄巾诸帅，本非冠盖；自相号字，谓骑白马者为‘张白骑’，谓轻捷者为‘张飞燕","attribution":"典略","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":249,"anchor":null},"note_id":"n-6c0b4fdbd0432367e810","start":7,"end":46},{"id":"gongsuntao-q-1a7ba03b46ca448f1f0b","section":"chapter-008","block":"b-25201fdc1649528fb337","layer":"original","quote":"燕遣人至京都乞降，拜燕平难中郎将","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":238,"anchor":null},"note_id":null,"start":72,"end":88},{"id":"gongsuntao-q-264bc28b0674e766523e","section":"chapter-008","block":"b-c0d16b36556ef444f7f5","layer":"original","quote":"张燕，常山真定人也〖1〗。本姓褚","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":237,"anchor":null},"note_id":null,"start":0,"end":16},{"id":"gongsuntao-q-352e875572083c579bf3","section":"chapter-008","block":"b-c0d16b36556ef444f7f5","layer":"original","quote":"博陵张牛角亦起众〖2〗，自号“将兵从事”，与燕合。燕推牛角为帅，俱攻%陶","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":237,"anchor":null},"note_id":null,"start":46,"end":82},{"id":"gongsuntao-q-4bfbe59d87df62dc7326","section":"chapter-008","block":"b-407d1dfcbd8cf81dc713","layer":"original","quote":"评曰：公孙瓒保京〖1〗，坐待夷灭。度残暴而不节〖2〗，渊仍业以载凶〖3〗，只足覆其族也。陶谦昏乱而忧死，张杨授首于臣下；皆拥据州郡，曾匹夫之不若：固无可论者也。燕、绣、鲁，舍群盗，列功臣；去危亡，保宗祀：则于彼为愈焉","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":314,"anchor":null},"note_id":null,"start":0,"end":108},{"id":"gongsuntao-q-4c15e4ee9d44d6ec38ef","section":"chapter-008","block":"b-c0d16b36556ef444f7f5","layer":"original","quote":"燕剽悍捷速过人，故军中号曰“飞燕","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":237,"anchor":null},"note_id":null,"start":128,"end":144},{"id":"gongsuntao-q-80aa92e124710a14b4f2","section":"chapter-008","block":"b-c0d16b36556ef444f7f5","layer":"original","quote":"黄巾起，燕合聚少年为群盗，在山泽间转攻；还真定，众万余人","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":237,"anchor":null},"note_id":null,"start":17,"end":45},{"id":"gongsuntao-q-82f8931ae2008a52d728","section":"chapter-008","block":"b-ec823ccdfae435a12436","layer":"pei","quote":"瓒遣行人文则，赍书告子续曰：‘袁氏之攻，似若神鬼；鼓角鸣于地中，梯冲舞吾楼上。日穷月蹴，无所聊赖。汝当碎首于张燕，速致轻骑；到者当起烽火于北，吾当从内出。不然，吾亡之后，天下虽广，汝欲求安足之地，其可得乎","attribution":"裴注·典略","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":102,"anchor":null},"note_id":"n-c97fbc22e62486ad902b","start":10,"end":112},{"id":"gongsuntao-q-87ffd1873a7cc9766308","section":"chapter-008","block":"b-c0d16b36556ef444f7f5","layer":"original","quote":"被创且死〖3〗；令众奉燕，告曰：“必以燕为帅！”牛角死，众奉燕，故改姓张","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":237,"anchor":null},"note_id":null,"start":91,"end":127},{"id":"gongsuntao-q-95e6846afe7e5fb96b3f","section":"chapter-008","block":"b-25201fdc1649528fb337","layer":"original","quote":"其后人众寝广，常山、赵郡、中山、上党、河内诸山谷，皆相通；其小帅孙轻、王当等，各以部众从燕，众至百万：号曰“黑山”。灵帝不能征，河北诸郡被其害","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":238,"anchor":null},"note_id":null,"start":0,"end":71},{"id":"gongsuntao-q-9a87ca7765a535739c8d","section":"chapter-008","block":"b-b624e6a80e58d2bc431a","layer":"original","quote":"太祖将定冀州，燕遣使求佐王师，拜平北将军〖5〗。率众诣邺，封安国亭侯，邑五百户","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":239,"anchor":null},"note_id":null,"start":63,"end":102},{"id":"gongsuntao-q-cda2e1ef94fa119ebf46","section":"chapter-008","block":"b-2bb54f68b8f1939ff638","layer":"original","quote":"燕薨，子方嗣。方薨，子融嗣","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":240,"anchor":null},"note_id":null,"start":0,"end":13},{"id":"gongsuntao-q-dddf0919a78e73c8fbb9","section":"chapter-008","block":"b-b624e6a80e58d2bc431a","layer":"original","quote":"是后，董卓迁天子于长安，天下兵数起。燕遂以其众与豪杰相结。袁绍与公孙瓒争冀州，燕遣将杜长等，助瓒。与绍战，为绍所败，人众稍散","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":239,"anchor":null},"note_id":null,"start":0,"end":62},{"id":"lvzang-q-36d12b824c4b3cd8157b","section":"chapter-007","block":"b-d7dccb90aa40b28ae072","layer":"original","quote":"北诣袁绍，绍与布击张燕于常山。燕精兵万余，骑数千。布有良马曰“赤兔”，﹝一﹞常与其亲近成廉、魏越等陷锋突阵，遂破燕军","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":34,"anchor":null},"note_id":null,"start":45,"end":103},{"id":"wudi-e-o102a-q","section":"chapter-001","block":"b-dd716ed320738744aced","layer":"original","quote":"夏四月，黑山贼张燕率其众十余万降〖1〗，封为列侯。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":574,"anchor":null},"note_id":null,"start":0,"end":25},{"id":"wudi-q-b-2e98e13ca098117a86e9","section":"chapter-001","block":"b-2e98e13ca098117a86e9","layer":"modern","quote":"〖1〗十年：建安十年（公元 205）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":560,"anchor":null},"note_id":"n-a9b0434ee8de64aed40f","start":0,"end":19},{"id":"wudi-q-o100","section":"chapter-001","block":"b-1ca17316b02d7b4d213c","layer":"original","quote":"十年春正月〖1〗，攻谭，破之。斩谭，诛其妻子〖2〗，冀州平。﹝一﹞下令曰：“其与袁氏同恶者，与之更始〖3〗。”令民不得复私仇，禁厚葬；皆一之于法〖4〗。是月，袁熙大将焦触、张南等叛〖5〗，攻熙、尚；熙、尚奔三郡乌丸〖6〗。触等举其县降，封为列侯。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":557,"anchor":null},"note_id":null,"start":0,"end":123},{"id":"wudi-q-o102","section":"chapter-001","block":"b-dd716ed320738744aced","layer":"original","quote":"夏四月，黑山贼张燕率其众十余万降〖1〗，封为列侯。故安赵犊、霍奴等杀幽州刺史、涿郡太守。三郡乌丸攻鲜于辅于犷平〖2〗。﹝一﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":574,"anchor":null},"note_id":null,"start":0,"end":62}],"profiles":{"wudi-p0224":{"fields":[],"directory":{"faction":"qunxiong"}}},"directory_counts":{}}
