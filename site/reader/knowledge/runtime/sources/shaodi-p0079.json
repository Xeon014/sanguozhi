dence":["xiahoucao-q-o107"]},{"id":"xiahoucao-m-p069-shaodi-p0079","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-p069"]},{"id":"xiahoucao-m-p070-shaodi-p0079","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-p070"]},{"id":"jfj-m-o042-shaodi-p0079","kind":"mention","text":"本段记载：姜维夏侯霸洮西破王经并围狄道","evidence":["jfj-q0020"]},{"id":"wgc-m-o056-shaodi-p0079","kind":"mention","text":"本段涉及王经","evidence":["wgc-q0044"]},{"id":"wgc-m-p063-shaodi-p0079","kind":"mention","text":"本段涉及王经","evidence":["wgc-q0138"]}]}],"evidence":[{"id":"dengzhang-q-a342a50fc1fc938d0d0d","section":"chapter-045","block":"b-9173784ede3ac5762e8f","layer":"original","quote":"维竟围经于狄道，城不能克","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":48,"anchor":null},"note_id":null,"start":111,"end":123},{"id":"dengzhang-q-c878b5ebddd5713257f4","section":"chapter-045","block":"b-9173784ede3ac5762e8f","layer":"original","quote":"维至狄道，大破魏雍州刺史王经，经众死于洮水者以万计","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":48,"anchor":null},"note_id":null,"start":47,"end":72},{"id":"fangji-q-1a8dcae84861e5bf933f","section":"chapter-029","block":"b-347d3b91452ef4aeea3e","layer":"pei","quote":"﹝一﹞《辂别传》曰：“经欲使辂卜，而有疑难之言。辂笑而答之曰：‘君侯，州里达人，何言之鄙！昔司马季主有言：夫卜者必法天地，象四时，顺仁义。伏羲作八卦，周文王三百八十四爻，而天下治。病者或以愈，且死或以生；患或以免，事或以成；嫁女娶妻，或以生长：岂直数千钱哉？以此推之，急务也。苟道之明，圣贤不让；况吾小人，敢以为难？’彦纬敛手谢辂：‘前言戏之耳。’于是辂为作卦，其言皆验。经每论辂，以为‘得龙云之精，能养和通幽者’，非徒合会之才也。”","attribution":"裴注引《辂别传》","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":306,"anchor":null},"note_id":"n-9931ac0c2f7fc5ebce4b","start":0,"end":217},{"id":"fangji-q-5ac29225870ca342b400","section":"chapter-029","block":"b-347d3b91452ef4aeea3e","layer":"pei","quote":"经欲使辂卜，而有疑难之言。辂笑而答之曰：‘君侯，州里达人，何言之鄙！昔司马季主有言：夫卜者必法天地，象四时，顺仁义。伏羲作八卦，周文王三百八十四爻，而天下治。病者或以愈，且死或以生；患或以免，事或以成；嫁女娶妻，或以生长：岂直数千钱哉？以此推之，急务也。苟道之明，圣贤不让；况吾小人，敢以为难？’彦纬敛手谢辂：‘前言戏之耳。’于是辂为作卦，其言皆验","attribution":"裴注·辂别传","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":306,"anchor":null},"note_id":"n-9931ac0c2f7fc5ebce4b","start":11,"end":185},{"id":"fangji-q-974e46d614e5d2133829","section":"chapter-029","block":"b-658b12fd77eff8175e89","layer":"original","quote":"清河王经去官还家","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":289,"anchor":null},"note_id":null,"start":0,"end":8},{"id":"fangji-q-be9b87c234811a358661","section":"chapter-029","block":"b-658b12fd77eff8175e89","layer":"original","quote":"近有一怪，大不喜之；欲烦作卦。”卦成，辂曰：“爻吉，不为怪也。君夜在堂户前，有一流光如燕雀者，入君怀中，殷殷有声；内神不安，解衣彷徉〖2〗，招呼妇人〖3〗，觅索余光。”经大笑曰：“实如君言！”辂曰：“吉，迁官之征也！其应行至。”顷之，经为江夏太守","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":289,"anchor":null},"note_id":null,"start":21,"end":144},{"id":"hancui-q-50cf8044c42b345e6b3b","section":"chapter-024","block":"b-e37e4fdc34ad6437711c","layer":"pei","quote":"初，林识拔同郡王经于民伍之中，卒为名士。世以此称之。","attribution":"裴注·晋诸公赞","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":135,"anchor":null},"note_id":"n-a397b652c52bb61c4e90","start":65,"end":91},{"id":"houzhu-q-O065","section":"chapter-033","block":"b-c3b5a23f5d44e3c1300b","layer":"original","quote":"夏，复率诸军出狄道，与魏雍州刺史王经战于洮西，大破之。经退保狄道城；维却住钟题〖14〗。","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":123,"anchor":null},"note_id":null,"start":0,"end":44},{"id":"huanchen-q-1730e68b8ac5ed677de6","section":"chapter-022","block":"b-3a485d54b8758fc5e646","layer":"original","quote":"经叹曰：“粮不至旬，向不应机〖35〗，举城屠裂〖36〗，覆丧一州矣〖37〗！”","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":240,"anchor":null},"note_id":null,"start":206,"end":245},{"id":"huanchen-q-92f1a2d42df1148035d3","section":"chapter-022","block":"b-d88d21630b5bfba5ede1","layer":"original","quote":"泰曰：“姜维提轻兵深入，正欲与我争锋原野，求一战之利。王经当高壁深垒，挫其锐气。今乃与战，使贼得计；走破王经，封之狄道。若维以战克之威，进兵东向；据栎阳积谷之实〖21〗，放兵收降，招纳羌胡，东争关、陇〖22〗，传檄四郡〖23〗：此我之所恶也。而维以乘胜之兵，挫峻城之下；锐气之卒，屈力致命。攻守势殊，客主不同；兵书云‘修橹（橨榅）〔轒辒〕〖24〗，三月乃成，拒堙三月而后已〖25〗’。诚非轻军远入、维之诡谋仓猝所办。悬军远侨〖26〗，粮谷不继，是我速进破贼之时也；所谓疾雷不及掩耳，自然之势也。洮水带其表〖27〗，维等在其内；今乘高据势，临其项领，不战必走。寇不可纵，围不可久，君等何言如此","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":239,"anchor":null},"note_id":null,"start":0,"end":295},{"id":"huanchen-q-9e754a9a399d9671f0b1","section":"chapter-022","block":"b-4595f049a60fc3e9a254","layer":"original","quote":"会经所统诸军于故关与贼战不利〖13〗，经辄渡洮〖14〗。泰以经不坚据狄道，必有他变；并遣五营在前，泰率诸军继之。经已与维战，大败；以万余人还保狄道城，余皆奔散。维乘胜围狄道","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":237,"anchor":null},"note_id":null,"start":0,"end":86},{"id":"huanchen-q-fee1e56b2ff0f7bf2a68","section":"chapter-022","block":"b-e937b650c6c050f8d9f6","layer":"original","quote":"后年〖2〗，雍州刺史王经白泰〖3〗，云：“姜维、夏侯霸欲三道向祁山、石营、金城〖4〗；求进兵为翅〖5〗，使凉州军至枹罕〖6〗，讨蜀护军向祁山〖7〗。”","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":235,"anchor":null},"note_id":null,"start":0,"end":75},{"id":"jfj-q0020","section":"chapter-044","block":"b-5af1c31721bbfd739fd3","layer":"original","quote":"后十八年〖3〗，复与车骑将军夏侯霸等，俱出狄道，大破魏雍州刺史王经于洮西。经众死者数万人。经退保狄道城。维围之。魏征西将军陈泰进兵解围，维却住钟题〖4〗。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":195,"anchor":null},"note_id":null,"start":0,"end":77},{"id":"jfj-q0159","section":"chapter-044","block":"b-5af1c31721bbfd739fd3","layer":"original","quote":"后十八年〖3〗，复与车骑将军夏侯霸等，俱出狄道，大破魏雍州刺史王经于洮西。经众死者数万人。经退保狄道城。维围之。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":195,"anchor":null},"note_id":null,"start":0,"end":56},{"id":"shaodi-e-o076a-q","section":"chapter-004","block":"b-f3fdf2376549fb1e7ad9","layer":"original","quote":"八月，辛亥〖25〗，蜀卫将军姜维寇狄道〖26〗。雍州刺史王经与战洮西〖27〗。经大败，还保狄道城。辛未〖28〗，以长水校尉邓艾行安西将军〖29〗，与征西将军陈泰并力拒维〖30〗。戊辰〖31〗，复遣太尉司马孚为后继。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":336,"anchor":null},"note_id":null,"start":0,"end":107},{"id":"shaodi-e-o142b-q","section":"chapter-004","block":"b-05a2669f0d367454195c","layer":"original","quote":"皇太后令曰：“吾以不德，‘遭家不造〖4〗’。昔援立东海王子髦，以为明帝嗣。见其好书疏文章，冀可成济；而情性暴戾，日月滋甚〖5〗。吾数呵责，遂更忿恚。造作丑逆不道之言以诬谤吾，遂隔绝两宫〖6〗。其所言道，不可忍听，非天地所覆载。吾即密有令，语大将军〖7〗：‘不可以奉宗庙！恐颠覆社稷，死无面目以见先帝。’大将军以其尚幼，谓当改心为善，殷勤执据〖8〗。而此儿忿戾，所行益甚。举弩遥射吾宫，祝当令中吾项；箭亲堕吾前。吾语大将军：‘不可不废之！’前后数十〖9〗。此儿具闻，自知罪重，便图为弑逆；赂遗吾左右人，令因吾服药，密行鸩毒〖10〗，重相设计〖11〗。事已觉露，直欲因际会举兵入西宫杀吾〖12〗，出取大将军〖13〗。呼侍中王沈、散骑常侍王业、﹝二﹞尚书王经〖14〗，出怀中黄素诏示之〖15〗，言‘今日便当施行’。吾之危殆，过于累卵！吾老寡，岂复多惜余命邪？但伤先帝遗意不遂，社稷颠覆为痛耳！赖宗庙之灵，沈、业即驰语大将军，得先严警〖16〗。而此儿便将左右出云龙门〖17〗，擂战鼓，躬自拔刃，与左右杂卫共入兵阵间〖18〗，为前锋所害。此儿既行悖逆不道，而又自陷大祸，重令吾悼心不可言〖19〗！昔汉昌邑王以罪废为庶人〖20〗。此儿亦宜以民礼葬之。当令内外咸知此儿所行。又尚书王经，凶逆无状〖21〗；其收经及家属，皆诣廷尉。”","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":48,"anchor":null},"note_id":null,"start":0,"end":558},{"id":"shaodi-e-p045a-q","section":"chapter-004","block":"b-7b9a7d8c7e1e41d12750","layer":"pei","quote":"﹝一﹞《汉晋春秋》曰：“帝见威权日去，不胜其忿。乃召侍中王沈、尚书王经、散骑常侍王业，谓曰：‘司马昭之心，路人所知也！吾不能坐受废辱！今日当与卿自出讨之。’王经曰：‘昔鲁昭公不忍季氏，败走失国，为天下笑。今权在其门，为日久矣。朝廷四方皆为之致死，不顾逆顺之理，非一日也。且宿卫空阙，兵甲寡弱，陛下何所资用？而一旦如此，无乃欲除疾而更深之邪？祸殆不测，宜见重详！’帝乃出怀中版令投地，曰：‘行之决矣！正使死，何所惧？况不必死邪！’于是入白太后。沈、业奔走告文王，文王为之备。帝遂帅僮仆数百，鼓噪而出。文王弟屯骑校尉伷入，遇帝于东止车门，左右呵之，伷众奔走。中护军贾充又逆帝，战于南阙下。帝自用剑，众欲退。太子舍人成济问充曰：‘事急矣。当云何？’充曰：‘畜养汝等，正谓今日！今日之事，无所问也！’济即前刺帝，刃出于背。文王闻，大惊，自投于地曰：‘天下其谓我何！’太傅孚奔往，枕帝股而哭，哀甚。曰：‘杀陛下者，臣之罪也！’”","attribution":"《汉晋春秋》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":72,"anchor":null},"note_id":"n-74646ac2cf964244648d","start":0,"end":409},{"id":"shaodi-e-p047a-q","section":"chapter-004","block":"b-a63897d3cdeb794501b2","layer":"pei","quote":"《世语》曰：“王沈、王业驰告文王；尚书王经，以正直，不出，因沈、业申意。”","attribution":"《世语》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":74,"anchor":null},"note_id":"n-74646ac2cf964244648d","start":0,"end":37},{"id":"shaodi-e-p048a-q","section":"chapter-004","block":"b-7549203c7ac05ed7c347","layer":"pei","quote":"《晋诸公赞》曰：“沈、业将出，呼王经。经不从，曰：‘吾子行矣！’”","attribution":"《晋诸公赞》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":75,"anchor":null},"note_id":"n-74646ac2cf964244648d","start":0,"end":33},{"id":"shaodi-q-b-2de9ea37d1e15a7d296f","section":"chapter-004","block":"b-2de9ea37d1e15a7d296f","layer":"modern","quote":"〖6〗二年：正元二年（公元 255）。乙丑：旧历十二日。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":346,"anchor":null},"note_id":"n-96103ace1e11ae4131ba","start":0,"end":28},{"id":"shaodi-q-b-77066dd061eb6a338ffa","section":"chapter-004","block":"b-77066dd061eb6a338ffa","layer":"modern","quote":"〖1〗五年：甘露五年（公元 260 ）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":50,"anchor":null},"note_id":"n-21e90e29c9fd438bba21","start":0,"end":20},{"id":"shaodi-q-o072","section":"chapter-004","block":"b-4b9070779d1c209c6814","layer":"original","quote":"二年春正月，乙丑〖6〗，镇东将军毌丘俭、扬州刺史文钦反。（戊戌）〔戊寅〕〖7〗，大将军司马景王征之。癸未〖8〗，车骑将军郭淮薨。闰月，己亥〖9〗，破钦于乐嘉〖10〗；钦遁走，遂奔吴。甲辰〖11〗，安风淮津都尉斩俭〖12〗，传首京都。﹝一﹞壬子〖13〗，复特赦淮南士民诸为俭、钦所诖误者〖14〗。以镇南将军诸葛诞为镇东大将军〖15〗。司马景王薨于许昌。二月，丁巳〖16〗，以卫将军司马文王为大将军〖17〗，录尚书事。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":332,"anchor":null},"note_id":null,"start":0,"end":207},{"id":"shaodi-q-o076","section":"chapter-004","block":"b-f3fdf2376549fb1e7ad9","layer":"original","quote":"八月，辛亥〖25〗，蜀卫将军姜维寇狄道〖26〗。雍州刺史王经与战洮西〖27〗。经大败，还保狄道城。辛未〖28〗，以长水校尉邓艾行安西将军〖29〗，与征西将军陈泰并力拒维〖30〗。戊辰〖31〗，复遣太尉司马孚为后继。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":336,"anchor":null},"note_id":null,"start":0,"end":107},{"id":"shaodi-q-o139","section":"chapter-004","block":"b-c33fc441ae4a3de17fb6","layer":"original","quote":"五年春正月朔〖1〗，日有食之。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":45,"anchor":null},"note_id":null,"start":0,"end":15},{"id":"shaodi-q-o142","section":"chapter-004","block":"b-05a2669f0d367454195c","layer":"original","quote":"皇太后令曰：“吾以不德，‘遭家不造〖4〗’。昔援立东海王子髦，以为明帝嗣。见其好书疏文章，冀可成济；而情性暴戾，日月滋甚〖5〗。吾数呵责，遂更忿恚。造作丑逆不道之言以诬谤吾，遂隔绝两宫〖6〗。其所言道，不可忍听，非天地所覆载。吾即密有令，语大将军〖7〗：‘不可以奉宗庙！恐颠覆社稷，死无面目以见先帝。’大将军以其尚幼，谓当改心为善，殷勤执据〖8〗。而此儿忿戾，所行益甚。举弩遥射吾宫，祝当令中吾项；箭亲堕吾前。吾语大将军：‘不可不废之！’前后数十〖9〗。此儿具闻，自知罪重，便图为弑逆；赂遗吾左右人，令因吾服药，密行鸩毒〖10〗，重相设计〖11〗。事已觉露，直欲因际会举兵入西宫杀吾〖12〗，出取大将军〖13〗。呼侍中王沈、散骑常侍王业、﹝二﹞尚书王经〖14〗，出怀中黄素诏示之〖15〗，言‘今日便当施行’。吾之危殆，过于累卵！吾老寡，岂复多惜余命邪？但伤先帝遗意不遂，社稷颠覆为痛耳！赖宗庙之灵，沈、业即驰语大将军，得先严警〖16〗。而此儿便将左右出云龙门〖17〗，擂战鼓，躬自拔刃，与左右杂卫共入兵阵间〖18〗，为前锋所害。此儿既行悖逆不道，而又自陷大祸，重令吾悼心不可言〖19〗！昔汉昌邑王以罪废为庶人〖20〗。此儿亦宜以民礼葬之。当令内外咸知此儿所行。又尚书王经，凶逆无状〖21〗；其收经及家属，皆诣廷尉。”","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":48,"anchor":null},"note_id":null,"start":0,"end":558},{"id":"shaodi-q-p045","section":"chapter-004","block":"b-7b9a7d8c7e1e41d12750","layer":"pei","quote":"﹝一﹞《汉晋春秋》曰：“帝见威权日去，不胜其忿。乃召侍中王沈、尚书王经、散骑常侍王业，谓曰：‘司马昭之心，路人所知也！吾不能坐受废辱！今日当与卿自出讨之。’王经曰：‘昔鲁昭公不忍季氏，败走失国，为天下笑。今权在其门，为日久矣。朝廷四方皆为之致死，不顾逆顺之理，非一日也。且宿卫空阙，兵甲寡弱，陛下何所资用？而一旦如此，无乃欲除疾而更深之邪？祸殆不测，宜见重详！’帝乃出怀中版令投地，曰：‘行之决矣！正使死，何所惧？况不必死邪！’于是入白太后。沈、业奔走告文王，文王为之备。帝遂帅僮仆数百，鼓噪而出。文王弟屯骑校尉伷入，遇帝于东止车门，左右呵之，伷众奔走。中护军贾充又逆帝，战于南阙下。帝自用剑，众欲退。太子舍人成济问充曰：‘事急矣。当云何？’充曰：‘畜养汝等，正谓今日！今日之事，无所问也！’济即前刺帝，刃出于背。文王闻，大惊，自投于地曰：‘天下其谓我何！’太傅孚奔往，枕帝股而哭，哀甚。曰：‘杀陛下者，臣之罪也！’”","attribution":"《汉晋春秋》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":72,"anchor":null},"note_id":"n-74646ac2cf964244648d","start":0,"end":409},{"id":"shaodi-q-p047","section":"chapter-004","block":"b-a63897d3cdeb794501b2","layer":"pei","quote":"《世语》曰：“王沈、王业驰告文王；尚书王经，以正直，不出，因沈、业申意。”","attribution":"《世语》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":74,"anchor":null},"note_id":"n-74646ac2cf964244648d","start":0,"end":37},{"id":"shaodi-q-p048","section":"chapter-004","block":"b-7549203c7ac05ed7c347","layer":"pei","quote":"《晋诸公赞》曰：“沈、业将出，呼王经。经不从，曰：‘吾子行矣！’”","attribution":"《晋诸公赞》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":75,"anchor":null},"note_id":"n-74646ac2cf964244648d","start":0,"end":33},{"id":"wgc-q0044","section":"chapter-028","block":"b-2daa15fa3f221c35ea82","layer":"original","quote":"其年征拜长水校尉〖8〗。以破钦等功，进封方城乡侯，行安西将军。解雍州刺史王经围于狄道，姜维退驻钟提〖9〗；乃以艾为安西将军，假节、领护东羌校尉〖10〗。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":296,"anchor":null},"note_id":null,"start":0,"end":76},{"id":"wgc-q0138","section":"chapter-028","block":"b-2734da889060ff3b807a","layer":"pei","quote":"《汉晋春秋》曰：“文王闻钟会功曹向雄之收葬会也，召而责之曰：‘往者王经之死，卿哭于东市而我不问，今钟会躬为叛逆而又辄收葬；若复相容，其如王法何！’雄曰：‘昔先王掩骼埋胔，仁流朽骨，当时岂先卜其功罪而后收葬哉？今王诛既加，于法已备；雄感义收葬，教亦无阙。法立于上，教弘于下；以此训物，雄曰可矣，何必使雄背死违生，以立于时？殿下仇对枯骨，捐之中野，百岁之后，为臧获所笑，岂仁贤所掩哉？’王悦，与宴谈而遣之。”习凿齿曰：“向伯茂，可谓勇于蹈义也！哭王经而哀感市人，葬钟会而义动明主；彼皆忠烈奋劲，知死而往，非存生也。况使经、会处世，或身在急难，而有不赴者乎？故寻其奉死之心，可以见事生之情；览其忠贞之节，足以愧背义之士矣。王加礼而遣，可谓明达。”","attribution":"汉晋春秋；习凿齿论","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":620,"anchor":null},"note_id":"n-b8c46d3147cdc6a86a2c","start":0,"end":320},{"id":"wgc-q0354","section":"chapter-028","block":"b-2daa15fa3f221c35ea82","layer":"original","quote":"解雍州刺史王经围于狄道，姜维退驻钟提","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":296,"anchor":null},"note_id":null,"start":31,"end":49},{"id":"xiahoucao-e-o107a-q","section":"chapter-009","block":"b-b62dfdbf80e8ceed005a","layer":"original","quote":"清河王经，亦与允俱称冀州名士。甘露中为尚书〖6〗，坐高贵乡公事诛。始，经为郡守，经母谓经曰：“汝田家子，今仕至二千石。物太过不祥〖7〗，可以止矣！”经不能从。历二州刺史，司隶校尉，终以致败。﹝二﹞允友人同郡崔赞，亦尝以处世太盛戒允云。﹝三﹞","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":626,"anchor":null},"note_id":null,"start":0,"end":120},{"id":"xiahoucao-e-p069a-q","section":"chapter-009","block":"b-85303da9d80e55d46607","layer":"pei","quote":"经字彦（伟）〔纬〕。初为江夏大守。大将军曹爽附绢（二十）〔二千〕匹令交市于吴；经不发书，弃官归。母问归状，经以实对。母以经典兵马而擅去，对送吏杖经五十；爽闻，不复罪。","attribution":"《世语》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":640,"anchor":null},"note_id":"n-73667ee44886c1a2557e","start":10,"end":93},{"id":"xiahoucao-e-p069b-q","section":"chapter-009","block":"b-85303da9d80e55d46607","layer":"pei","quote":"经为司隶校尉，辟河内向雄为都官从事。","attribution":"《世语》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":640,"anchor":null},"note_id":"n-73667ee44886c1a2557e","start":93,"end":111},{"id":"xiahoucao-e-p069c-q","section":"chapter-009","block":"b-85303da9d80e55d46607","layer":"pei","quote":"王业之出，不申经（竟）〔意〕以及难。经刑于东市，雄哭之，感动一市。刑及经母。雍州故吏皇甫晏，以家财收葬焉。","attribution":"《世语》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":640,"anchor":null},"note_id":"n-73667ee44886c1a2557e","start":111,"end":164},{"id":"xiahoucao-e-p070a-q","section":"chapter-009","block":"b-7f37a146755214a9b128","layer":"pei","quote":"经被收，辞母。母颜色不变，笑而应曰：‘人谁不死？往所以（不）止汝者，恐不得其所也。以此并命，何恨之有哉！","attribution":"《汉晋春秋》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":641,"anchor":null},"note_id":"n-73667ee44886c1a2557e","start":9,"end":61},{"id":"xiahoucao-f0066-q","section":"chapter-009","block":"b-85303da9d80e55d46607","layer":"pei","quote":"经字彦（伟）〔纬〕","attribution":"《世语》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":640,"anchor":null},"note_id":"n-73667ee44886c1a2557e","start":10,"end":19},{"id":"xiahoucao-q-o107","section":"chapter-009","block":"b-b62dfdbf80e8ceed005a","layer":"original","quote":"清河王经，亦与允俱称冀州名士。甘露中为尚书〖6〗，坐高贵乡公事诛。始，经为郡守，经母谓经曰：“汝田家子，今仕至二千石。物太过不祥〖7〗，可以止矣！”经不能从。历二州刺史，司隶校尉，终以致败。﹝二﹞允友人同郡崔赞，亦尝以处世太盛戒允云。﹝三﹞","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":626,"anchor":null},"note_id":null,"start":0,"end":120},{"id":"xiahoucao-q-p069","section":"chapter-009","block":"b-85303da9d80e55d46607","layer":"pei","quote":"﹝二﹞《世语》曰：“经字彦（伟）〔纬〕。初为江夏大守。大将军曹爽附绢（二十）〔二千〕匹令交市于吴；经不发书，弃官归。母问归状，经以实对。母以经典兵马而擅去，对送吏杖经五十；爽闻，不复罪。经为司隶校尉，辟河内向雄为都官从事。王业之出，不申经（竟）〔意〕以及难。经刑于东市，雄哭之，感动一市。刑及经母。雍州故吏皇甫晏，以家财收葬焉。”","attribution":"《世语》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":640,"anchor":null},"note_id":"n-73667ee44886c1a2557e","start":0,"end":165},{"id":"xiahoucao-q-p070","section":"chapter-009","block":"b-7f37a146755214a9b128","layer":"pei","quote":"《汉晋春秋》曰：“经被收，辞母。母颜色不变，笑而应曰：‘人谁不死？往所以（不）止汝者，恐不得其所也。以此并命，何恨之有哉！’晋武帝太始元年诏曰：‘故尚书王经，虽身陷法辟，然守志可嘉。门户堙没，意常愍之。其赐经孙郎中。’”","attribution":"《汉晋春秋》；裴注载晋武帝诏","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":641,"anchor":null},"note_id":"n-73667ee44886c1a2557e","start":0,"end":110}],"profiles":{},"directory_counts":{}}
