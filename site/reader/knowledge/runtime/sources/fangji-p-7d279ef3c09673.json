fangji-q-24757580b1fdc02a9375"]},"ordering_evidence":"fangji-q-24757580b1fdc02a9375","order":5984}],"persons":[{"id":"fangji-p-7d279ef3c09673","name":"单子春","evidence":["fangji-q-8d27cad4f13a139bf611","fangji-q-82fcfd2f9cd5050d5dec","fangji-q-24757580b1fdc02a9375"],"facts":[],"mentions":[],"aliases":[]}],"evidence":[{"id":"fangji-q-24757580b1fdc02a9375","section":"chapter-029","block":"b-e484b95331a6392b7063","layer":"pei","quote":"子春语众人曰：‘此年少盛有才器，听其言论，正似司马犬子游猎之赋，何其磊落雄壮！英神以茂，必能明天文地理变化之数，不徒有言也。’于是发声徐州，号之‘神童","attribution":"裴注·辂别传","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":262,"anchor":null},"note_id":"n-c8e89913cb43ed9c778e","start":697,"end":772},{"id":"fangji-q-82fcfd2f9cd5050d5dec","section":"chapter-029","block":"b-e484b95331a6392b7063","layer":"pei","quote":"辂问子春：‘府君名士，加有雄贵之姿；辂既年少，胆未坚刚，若欲相观，惧失精神；请先饮三升清酒，然后言之。’子春大喜，便酌三升清酒，独使饮之。酒尽之后，问子春：‘今欲与辂为对者，若府君四坐之士邪？’子春曰：‘吾欲自与卿旗鼓相当。’辂言：‘始读《诗》、《论》、《易》本；学问微浅，未能上引圣人之道，陈秦、汉之事；但欲论金木水火土、鬼神之情耳。’子春言：‘此最难者，而卿以为易邪？’于是倡大论之端，遂经于阴阳；文采葩流，枝叶横生，少引圣籍，多发天然。子春及众士互共攻劫，论难锋起；而辂，人人答对，言皆有余。至日向暮，酒食不行","attribution":"裴注·辂别传","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":262,"anchor":null},"note_id":"n-c8e89913cb43ed9c778e","start":438,"end":696},{"id":"fangji-q-8d27cad4f13a139bf611","section":"chapter-029","block":"b-e484b95331a6392b7063","layer":"pei","quote":"琅邪太守单子春，雅有材度；闻辂一黉之俊，欲得见，辂父即遣辂造之","attribution":"裴注·辂别传","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":262,"anchor":null},"note_id":"n-c8e89913cb43ed9c778e","start":390,"end":421}],"profiles":{},"directory_counts":{}}
