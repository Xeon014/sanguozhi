,"wuhuan-q-8ac5ab254708eb7fd012","wuhuan-q-f00b267e79948e49cdc8","wuhuan-q-e9565ac6cb9afee96c25","wuhuan-q-676780a535848ec30479","wuhuan-q-291613c697594c93d058","wuhuan-q-495f70d158c688a9e3b4"],"facts":[{"id":"wuhuan-f-6fad884145576247c3bf","text":"广阳人，少没乌丸鲜卑中，为其种归信。","evidence":["wuhuan-q-495f70d158c688a9e3b4"]}],"aliases":[],"mentions":[]}],"evidence":[{"id":"gongsuntao-q-03a6d2a08b38e5e28419","section":"chapter-008","block":"b-55f3f26d3d70db34ceba","layer":"original","quote":"柔招诱乌丸、鲜卑，得胡、汉数万人。与瓒所置渔阳太守邹丹，战于潞北。大破之，斩丹","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":72,"anchor":null},"note_id":null,"start":73,"end":112},{"id":"gongsuntao-q-28a8b4a197c108013638","section":"chapter-008","block":"b-24a65a7e5b5b8a913fe4","layer":"original","quote":"文帝践阼，拜辅虎牙将军〖9〗，柔度辽将军〖10〗；皆进封县侯，位特进","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":107,"anchor":null},"note_id":null,"start":0,"end":34},{"id":"gongsuntao-q-3e1592fed380538872b2","section":"chapter-008","block":"b-a4e2bbf216aa217112e8","layer":"pei","quote":"太祖甚爱阎柔，每谓之曰：‘我视卿如子，亦欲卿视我如父也。’柔由此自托于五官将，如兄弟","attribution":"裴注·魏略","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":121,"anchor":null},"note_id":"n-59106423bb8c8d1e522a","start":10,"end":52},{"id":"gongsuntao-q-9492c5cd587fb9d7de4c","section":"chapter-008","block":"b-55f3f26d3d70db34ceba","layer":"original","quote":"虞从事渔阳鲜于辅、齐周，骑都尉鲜于银等，率州兵欲报瓒；以燕国阎柔素有恩信〖4〗，共推柔为乌丸司马","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":72,"anchor":null},"note_id":null,"start":21,"end":69},{"id":"gongsuntao-q-a788815070f23af3b284","section":"chapter-008","block":"b-074a91dc3e7ceebc1243","layer":"original","quote":"太祖破南皮〖8〗，柔将部曲及鲜卑，献名马以奉军。从征三郡乌丸，以功封关内侯；﹝二﹞辅亦率其众从","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":106,"anchor":null},"note_id":null,"start":0,"end":47},{"id":"gongsuntao-q-d5b5abac46a5d96c34c8","section":"chapter-008","block":"b-a4d2e8ed9c02b3cf0d7e","layer":"original","quote":"太祖与袁绍相拒于官渡，阎柔遣使诣太祖，受事〖4〗，迁护乌丸校尉","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":105,"anchor":null},"note_id":null,"start":33,"end":64},{"id":"wuhuan-q-291613c697594c93d058","section":"chapter-030","block":"b-4dd367fecb7f6c7610ef","layer":"original","quote":"建安中，因阎柔上贡献，通市","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":75,"anchor":null},"note_id":null,"start":48,"end":61},{"id":"wuhuan-q-495f70d158c688a9e3b4","section":"chapter-030","block":"b-0b259fc94780e0681fd2","layer":"original","quote":"广阳阎柔〖4〗，少没乌丸、鲜卑中〖5〗，为其种所归信。柔乃因鲜卑众，杀乌丸校尉邢举代之〖6〗；绍因宠慰以安北边。后袁尚败奔蹋顿，凭其势，复图冀州。会太祖平河北，柔帅鲜卑、乌丸归附；遂因以柔为校尉〖7〗，犹持汉使节，治广宁如旧〖8〗。","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":44,"anchor":null},"note_id":null,"start":0,"end":116},{"id":"wuhuan-q-676780a535848ec30479","section":"chapter-030","block":"b-a1b338a00ad6850092a4","layer":"original","quote":"比能将三千余骑随柔击破银","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":68,"anchor":null},"note_id":null,"start":24,"end":36},{"id":"wuhuan-q-8ac5ab254708eb7fd012","section":"chapter-030","block":"b-0b259fc94780e0681fd2","layer":"original","quote":"遂因以柔为校尉〖7〗，犹持汉使节，治广宁如旧","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":44,"anchor":null},"note_id":null,"start":90,"end":112},{"id":"wuhuan-q-9b67d31531b24dcf3ed6","section":"chapter-030","block":"b-0b259fc94780e0681fd2","layer":"original","quote":"柔帅鲜卑、乌丸归附","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":44,"anchor":null},"note_id":null,"start":80,"end":89},{"id":"wuhuan-q-ca874562ed22dc79ff1b","section":"chapter-030","block":"b-0b259fc94780e0681fd2","layer":"original","quote":"柔乃因鲜卑众，杀乌丸校尉邢举代之","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":44,"anchor":null},"note_id":null,"start":27,"end":43},{"id":"wuhuan-q-d2866300f616fb7057cb","section":"chapter-030","block":"b-0b259fc94780e0681fd2","layer":"original","quote":"绍因宠慰以安北边","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":44,"anchor":null},"note_id":null,"start":47,"end":55},{"id":"wuhuan-q-e9565ac6cb9afee96c25","section":"chapter-030","block":"b-a1b338a00ad6850092a4","layer":"original","quote":"建安中，因阎柔上贡献","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":68,"anchor":null},"note_id":null,"start":0,"end":10},{"id":"wuhuan-q-f00b267e79948e49cdc8","section":"chapter-030","block":"b-7a2407d2753b29e36a3a","layer":"original","quote":"建安中，太祖定幽州，步度根与轲比能等因乌丸校尉阎柔上贡献","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":64,"anchor":null},"note_id":null,"start":0,"end":28}],"profiles":{},"directory_counts":{}}
