te_id":null,"start":73,"end":112,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-28a8b4a197c108013638","section":"chapter-008","block":"b-24a65a7e5b5b8a913fe4","layer":"original","quote":"文帝践阼，拜辅虎牙将军〖9〗，柔度辽将军〖10〗；皆进封县侯，位特进","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":107,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":34,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-3e1592fed380538872b2","section":"chapter-008","block":"b-a4e2bbf216aa217112e8","layer":"pei","quote":"太祖甚爱阎柔，每谓之曰：‘我视卿如子，亦欲卿视我如父也。’柔由此自托于五官将，如兄弟","attribution":"裴注·魏略","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":121,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-59106423bb8c8d1e522a","start":10,"end":52,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-9492c5cd587fb9d7de4c","section":"chapter-008","block":"b-55f3f26d3d70db34ceba","layer":"original","quote":"虞从事渔阳鲜于辅、齐周，骑都尉鲜于银等，率州兵欲报瓒；以燕国阎柔素有恩信〖4〗，共推柔为乌丸司马","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":72,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":21,"end":69,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-a788815070f23af3b284","section":"chapter-008","block":"b-074a91dc3e7ceebc1243","layer":"original","quote":"太祖破南皮〖8〗，柔将部曲及鲜卑，献名马以奉军。从征三郡乌丸，以功封关内侯；﹝二﹞辅亦率其众从","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":106,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":47,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-d5b5abac46a5d96c34c8","section":"chapter-008","block":"b-a4d2e8ed9c02b3cf0d7e","layer":"original","quote":"太祖与袁绍相拒于官渡，阎柔遣使诣太祖，受事〖4〗，迁护乌丸校尉","section_t