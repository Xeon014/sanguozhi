{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhanggu-e-o135","title":"顾悌拜跪读父书丧父毁悴而卒","accounts":[{"id":"zhanggu-a-fa9e0038b471c0bf23a1","label":"裴注·吴书","text":"顾悌拜跪读父书丧父毁悴而卒","evidence":["zhanggu-q-232bd59055a34c2d3309"]}],"participants":[{"person":"zhanggu-p0037","role":"每得父书常洒扫整衣服更设几筵舒书其上拜跪读之每句应诺毕复再拜、若父有疾耗之问至则临书垂涕声语哽咽、父以寿终饮浆不入口五日、虽以公议自割犹以不见父丧常画壁作棺柩象设神座于下每对之哭泣、服未阕而卒","evidence":["zhanggu-q-232bd59055a34c2d3309"]},{"person":"zhanggu-p0034","role":"历四县令、年老致仕、以寿终","evidence":["zhanggu-q-232bd59055a34c2d3309"]},{"person":"sun-quan","role":"为作布衣一袭皆摩絮著之强令悌释服","evidence":["zhanggu-q-232bd59055a34c2d3309"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["zhanggu-q-232bd59055a34c2d3309"]},"ordering_evidence":"zhanggu-q-232bd59055a34c2d3309","source_order":[52,173,494],"order":9312}],"persons":[{"id":"zhanggu-p0034","name":"顾向","evidence":["zhanggu-q-232bd59055a34c2d3309"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[{"id":"zhanggu-q-232bd59055a34c2d3309","section":"chapter-052","block":"b-731a4f7dcbb9861aef8c","layer":"pei","quote":"悌父向，历四县令，年老致仕。悌每得父书，常洒扫，整衣服，更设几筵，舒书其上，拜跪读之。每句应‘诺’，毕，复再拜。若父有疾耗之问至，则临书垂涕，声语哽咽。父以寿终，悌饮浆不入口五日。权为作布衣一袭，皆摩絮著之，强令悌释服。悌虽以公议自割，犹以不见父丧，常画壁作棺柩象，设神座于下，每对之哭泣。服未阕而卒","attribution":"裴注·吴书","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":172,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5a9c7df73f863da1ddae","start":494,"end":644,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
