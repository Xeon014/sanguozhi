l},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":66,"end":84,"offset_unit":"unicode_code_point"},{"id":"lizang-q-ec7306f0033e297f3403","section":"chapter-018","block":"b-3c8a1af669878a6576f9","layer":"pei","quote":"猛觉之，遂勒兵攻商","attribution":"裴注·典略","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":246,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0686fc8691bad454db46","start":171,"end":180,"offset_unit":"unicode_code_point"},{"id":"lizang-q-f22511299bc9a09642a7","section":"chapter-018","block":"b-3c8a1af669878a6576f9","layer":"pei","quote":"暨到，商欲诛猛","attribution":"裴注·典略","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":246,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0686fc8691bad454db46","start":163,"end":170,"offset_unit":"unicode_code_point"},{"id":"lizang-q-f6d744ba53c6574b0703","section":"chapter-018","block":"b-3c8a1af669878a6576f9","layer":"pei","quote":"是时河西四郡以去凉州治远，隔以河寇，上书求别置州。诏以陈留人邯郸商，为雍州刺史，别典四郡","attribution":"裴注·典略","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":246,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0686fc8691bad454db46","start":61,"end":105,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
