069e-q"]},{"person":"wudi-p0080","role":"被斩","evidence":["dongyuan-e-p069e-q"]},{"person":"dongyuan-p0120","role":"被斩","evidence":["dongyuan-e-p069e-q"]},{"person":"dongyuan-p0121","role":"被斩","evidence":["dongyuan-e-p069e-q"]},{"person":"dongyuan-p0122","role":"被破","evidence":["dongyuan-e-p069e-q"]},{"person":"dongyuan-p0123","role":"被破","evidence":["dongyuan-e-p069e-q"]},{"person":"dongyuan-p0124","role":"被破","evidence":["dongyuan-e-p069e-q"]},{"person":"dongyuan-p0125","role":"被破","evidence":["dongyuan-e-p069e-q"]},{"person":"dongyuan-p0126","role":"被破","evidence":["dongyuan-e-p069e-q"]},{"person":"dongyuan-p0127","role":"被破","evidence":["dongyuan-e-p069e-q"]},{"person":"dongyuan-p0128","role":"被破","evidence":["dongyuan-e-p069e-q"]}],"place":null,"time":{"label":"界桥及冀州诸战时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-p069e-q"]},"ordering_evidence":"dongyuan-e-p069e-q","source_order":[6,277,"P069e"],"order":1647},{"id":"gongsuntao-e-o217","title":"张角之反黑山诸部各起兵拜杨凤黑山校尉","accounts":[{"id":"gongsuntao-a-1ef0ed903db5494a867c","label":"裴注·九州春秋","text":"张角之反黑山诸部各起兵拜杨凤黑山校尉","evidence":["gongsuntao-q-17bf7b17b9e88027545e"]}],"participants":[{"person":"gongsuntao-p0051","role":"被遣使拜为黑山校尉领诸山贼得举孝廉计吏","evidence":["gongsuntao-q-17bf7b17b9e88027545e"]},{"person":"wudi-p0080","role":"等各起兵大者二三万小者不减数千","evidence":["gongsuntao-q-17bf7b17b9e88027545e"]},{"person":"sunshi-p0006","role":"之反","evidence":["gongsuntao-q-17bf7b17b9e88027545e"]},{"person":"wudi-p0025","role":"不能讨","evidence":["gongsuntao-q-17bf7b17b9e88027545e"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["gongsuntao-q-17bf7b17b9e88027545e"]},"ordering_evidence":"gongsuntao-q-17bf7b17b9e88027545e","source_order":[8,249,12],"order":2064}],"persons":[{"id":"wudi-p0080","name":"于毒","evidence":["wudi-q-o018","dongyuan-q-p069","gongsuntao-q-17bf7b17b9e88027545e"],"facts":[],"aliases":[],"mentions":[{"id":"wudi-m-o018-wudi-p0080","kind":"mention","text":"文中提及","evidence":["wudi-q-o018"]},{"id":"wudi-m-o019-wudi-p0080","kind":"mention","text":"文中提及","evidence":["wudi-q-o019"]},{"id":"wudi-m-p035-wudi-p0080","kind":"mention","text":"文中提及","evidence":["wudi-q-p035"]},{"id":"dongyuan-m-p069-wudi-p0080","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p069"]}]}],"evidence":[{"id":"dongyuan-e-p069d-q","section":"chapter-006","block":"b-e78509101d005195918b","layer":"pei","quote":"绍既破瓒，引军南到薄落津，方与宾客诸将共会。闻魏郡兵反，与黑山贼于毒共覆邺城，遂杀太守栗成；贼十余部，众数万人，聚会邺中。坐上诸客有家在邺者，皆忧怖失色，或起啼泣；绍容貌不变，自若也。贼陶升者，故内黄小吏也，有善心。独将部众逾西城入，闭守州门，不纳他贼；以车载绍家及诸衣冠在州内者，身自捍卫，送到斥丘，乃还。绍到，遂屯斥丘，以陶升为建义中郎将。","attribution":"《英雄记》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":276,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-14470fffeafe6a651893","start":534,"end":706,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p069e-q","section":"chapter-006","block":"b-e78509101d005195918b","layer":"pei","quote":"乃引军入朝歌鹿场山、苍岩谷，讨于毒。围攻五日，破之，斩毒及长安所署冀州牧壶寿；遂寻山北行，薄击诸贼左（发）〔髭〕丈八等，皆斩之；又击刘石、青牛角、黄龙、左校、郭大贤、李大目、于氐根等，皆屠其屯壁，奔走得脱，斩首数万级。绍复还屯邺。","attribution":"《英雄记》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":276,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-14470fffeafe6a651893","start":706,"end":821,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p069","section":"chapter-006","block":"b-e78509101d005195918b","layer":"pei","quote":"﹝四﹞《英雄记》曰：“公孙瓒击青州黄巾贼，大破之。还屯广宗，改易守令，冀州长吏，无不望风响应，开门受之。绍自往征瓒，合战于界桥南二十里。瓒步兵三万余人，为方阵；骑为两翼，左右各五千余匹；白马义从为中坚，亦分作两校；左射右，右射左；旌旗铠甲，光照天地。绍令麹义以八百兵为先登；强弩千张夹承之；绍自以步兵数万，结阵于后。义久在凉州，晓习羌斗，兵皆骁锐。瓒见其兵少，便放骑欲陵蹈之。义兵皆伏盾下不动，未至数十步，乃同时俱起；扬尘大叫，直前冲突；强弩雷发，所中必倒。临阵斩瓒所署冀州刺史严纲，甲首千余级。瓒军败绩，步骑奔走，不复还营。义追至界桥，瓒殿兵还战桥上，义复破之。遂到瓒营，拔其牙门；营中余众，皆复散走。绍在后，未到桥十数里，下马发鞍，见瓒已破，不为设备；惟帐下强弩数十张，大戟士百余人自随。瓒部迸骑二千余匹，猝至，便围绍数重，弓矢雨下。别驾从事田丰扶绍，欲却入空垣，绍以兜鍪扑地曰：‘大丈夫当前斗死！而入墙间，岂可得活乎？’强弩乃乱发，多所杀伤。瓒骑不知是绍，亦稍引却。会%义来迎，乃散去。瓒每与虏战，常乘白马，追不虚发，数获戎捷。虏相告云‘当避白马’。因虏所忌，简其白马数千匹，选骑射之士，号为‘白马义从’；一曰胡夷健者常乘白马，瓒有健骑数千，多乘白马，故以号焉。绍既破瓒，引军南到薄落津，方与宾客诸将共会。闻魏郡兵反，与黑山贼于毒共覆邺城，遂杀太守栗成；贼十余部，众数万人，聚会邺中。坐上诸客有家在邺者，皆忧怖失色，或起啼泣；绍容貌不变，自若也。贼陶升者，故内黄小吏也，有善心。独将部众逾西城入，闭守州门，不纳他贼；以车载绍家及诸衣冠在州内者，身自捍卫，送到斥丘，乃还。绍到，遂屯斥丘，以陶升为建义中郎将。乃引军入朝歌鹿场山、苍岩谷，讨于毒。围攻五日，破之，斩毒及长安所署冀州牧壶寿；遂寻山北行，薄击诸贼左（发）〔髭〕丈八等，皆斩之；又击刘石、青牛角、黄龙、左校、郭大贤、李大目、于氐根等，皆屠其屯壁，奔走得脱，斩首数万级。绍复还屯邺。初平四年，天子使太傅马日!、太仆赵岐和解关东。岐别诣河北，绍出迎于百里上，拜奉帝命。岐住绍营，移书告瓒。瓒遣使具与绍书曰：‘赵太仆以周召之德，衔命来征，宣扬朝恩，示以和睦；旷若开云见日，何喜如之？昔贾复、寇恂，亦争士卒，欲相危害；遇光武之宽，亲俱陛见，同舆共出，时人以为荣。自省边鄙，得与将军共同此福；此诚将军之眷，而瓒之幸也！’麹义，后恃功而骄恣，绍乃杀之。”","attribution":"《英雄记》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":276,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-14470fffeafe6a651893","start":0,"end":1002,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-17bf7b17b9e88027545e","section":"chapter-008","block":"b-9bdc891e043888f35a7b","layer":"pei","quote":"张角之反也，黑山、白波、黄龙、左校、牛角、五鹿、羝根、苦蝤、刘石、平汉、大洪、司隶、缘城、罗市、雷公、浮云、飞燕、白爵、杨凤、于毒等，各起兵，大者二三万，小者不减数千。灵帝不能讨，乃遣使拜杨凤为黑山校尉，领诸山贼，得举孝廉、计吏。后遂弥漫，不可复数","attribution":"裴注·九州春秋","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":248,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6c0b4fdbd0432367e810","start":12,"end":136,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o018b-q","section":"chapter-001","block":"b-1692e234ab7a13fd2792","layer":"original","quote":"黑山贼于毒、白绕、眭固等十余万众略魏郡、东郡〖3〗，﹝一﹞王肱不能御。太祖引兵入东郡，击白绕于濮阳〖4〗，破之。袁绍因表太祖为东郡太守；治东武阳〖5〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":141,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":17,"end":93,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o019a-q","section":"chapter-001","block":"b-43620706e925cc9a268c","layer":"original","quote":"三年春〖1〗，太祖军顿丘，毒等攻东武阳。太祖乃引兵西入山，攻毒等本屯〖2〗。﹝一﹞毒闻之，弃武阳还〖3〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":150,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":53,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-3863a19b555811d1f415","section":"chapter-001","block":"b-3863a19b555811d1f415","layer":"modern","quote":"〖1〗三年：初平三年（公元 192）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":152,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-2063caf2b642ce9ff2bc","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-51f98a867014d3fedddd","section":"chapter-001","block":"b-51f98a867014d3fedddd","layer":"modern","quote":"〖1〗二年：初平二年（公元 191）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":143,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-675465772382db7c3192","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o016","section":"chapter-001","block":"b-15ef6fb810e957089b24","layer":"original","quote":"二年春〖1〗，绍、馥遂立虞为帝，虞终不敢当。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":139,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":22,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o018","section":"chapter-001","block":"b-1692e234ab7a13fd2792","layer":"original","quote":"秋七月，袁绍胁韩馥，取冀州〖2〗。黑山贼于毒、白绕、眭固等十余万众略魏郡、东郡〖3〗，﹝一﹞王肱不能御。太祖引兵入东郡，击白绕于濮阳〖4〗，破之。袁绍因表太祖为东郡太守；治东武阳〖5〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":141,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":93,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o019","section":"chapter-001","block":"b-43620706e925cc9a268c","layer":"original","quote":"三年春〖1〗，太祖军顿丘，毒等攻东武阳。太祖乃引兵西入山，攻毒等本屯〖2〗。﹝一﹞毒闻之，弃武阳还〖3〗。太祖要击眭固〖4〗，又击匈奴于夫罗于内黄〖5〗，皆大破之。﹝二﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":150,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":85,"offset_unit":"unicode_code_point"},{"id":"wudi-q-p035","section":"chapter-001","block":"b-19133c09ee1496bbc7a1","layer":"pei","quote":"﹝一﹞《魏书》曰：“诸将皆以为当还自救。太祖曰：‘孙膑救赵而攻魏，耿弇欲走西安攻临淄。使贼闻我西而还，武阳自解也；不还，我能败其本屯。虏不能拔武阳，必矣！’遂乃行。”","attribution":"《魏书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":158,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-91301b1f109b6e39697c","start":0,"end":83,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
