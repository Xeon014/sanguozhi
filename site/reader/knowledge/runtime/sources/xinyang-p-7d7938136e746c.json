nchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-7ab6316d3e38e1652aa4","start":169,"end":289,"offset_unit":"unicode_code_point"},{"id":"xinyang-q-5e325ee2269f0e73a7ac","section":"chapter-025","block":"b-35f1226dab0503bd3b22","layer":"pei","quote":"谧又载赵昂妻曰：“赵昂妻异者，故益州刺史天水赵伟璋妻，王氏女也。昂为羌道令，留异在西。会同郡梁双反，攻破西城，害异两男。异女英，年六岁，独与异在城中。异见两男已死，又恐为双所侵，引刀欲自刎，顾英而叹曰：‘身死尔弃，当谁恃哉？吾闻西施蒙不洁之服，则人掩鼻，况我貌非西施乎？’乃以溷粪涅麻而被之，鲜食瘠形，自春至冬。双与州郡和，异竟以是免难。","attribution":"裴注·皇甫谧列女传","section_title":"辛毗杨阜高堂隆传第二十五","source":{"file":"OEBPS/Text/titlepage_0056.xhtml","index":175,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-7ab6316d3e38e1652aa4","start":0,"end":169,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
