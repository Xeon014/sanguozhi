5359e964e926f603f19","section":"chapter-039","block":"b-51d735f36effaacef8a2","layer":"original","quote":"还，迁益州太守","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":2,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":7,"offset_unit":"unicode_code_point"},{"id":"dongliu-q-aa9bcc54750d22c6bb76","section":"chapter-039","block":"b-8e9e3c4c6d67f5fa476c","layer":"original","quote":"自和居官食禄，外牧殊域〖14〗，内干机衡〖15〗，二十余年；死之日，家无儋石之（财）〔储〕","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":3,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":57,"end":102,"offset_unit":"unicode_code_point"},{"id":"dongliu-q-e3070df472d0b9c41900","section":"chapter-039","block":"b-8e9e3c4c6d67f5fa476c","layer":"original","quote":"先主定蜀，征和为掌军中郎将","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":3,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":13,"offset_unit":"unicode_code_point"},{"id":"dongliu-q-fda94ed89c8f8f762db2","section":"chapter-039","block":"b-49236227c84ad8d2c458","layer":"original","quote":"然县界豪强惮和严法，说璋转和为巴东属国都尉","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":1,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":138,"end":159,"offset_unit":"unicode_code_point"},{"id":"dongliu-q2-08960b4d0a5affce3ea1","section":"chapter-039","block":"b-434416551b1b07e500fd","layer":"original","quote":"亮后为丞相，教与群下曰〖17〗：“夫参署者〖18〗，集众思、广忠益也。若远小嫌〖19〗，难相违覆〖20〗，旷阙损矣〖21〗。违覆而得中〖22〗，犹弃弊v而获珠玉〖23〗。然人心苦不能尽〖24〗，惟徐元直处兹不惑〖25〗。又董幼宰参署七年，事有不至〖26〗，至于十返〖27〗，来相启告。苟能慕元直之十一〖28〗，幼宰之殷勤〖29〗，有忠于国，则亮可少过矣〖30〗。”","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":4,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":182,"offset_unit":"unicode_code_point"},{"id":"huangli-q-2a4a21a12a60c1bcbdd9","section":"chapter-043","block":"b-fcf72eef6831dec6891c","layer":"original","quote":"有违（犯）〔法〕之事；恢坐习免官，太守董和以习方土大姓〖3〗，寝而不许","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":56,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":33,"end":68,"offset_unit":"unicode_code_point"},{"id":"huangli-q-5e78963a4ec38fab75cb","section":"chapter-043","block":"b-fcf72eef6831dec6891c","layer":"original","quote":"后贡恢于州，涉道未至","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":56,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":75,"end":85,"offset_unit":"unicode_code_point"},{"id":"huangli-q-b685b1081f6c75c813e8","section":"chapter-043","block":"b-962c82ad79e50c7a0854","layer":"original","quote":"成都既定，先主领益州牧，以恢为功曹书佐、主簿","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":57,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":22,"offset_unit":"unicode_code_point"},{"id":"huangli-q2-7993a7c21702827973b6","section":"chapter-043","block":"b-fcf72eef6831dec6891c","layer":"original","quote":"李恢字德昂，建宁俞元人也〖1〗。仕郡督邮。姑夫爨习为建伶令〖2〗，有违（犯）〔法〕之事；恢坐习免官，太守董和以习方土大姓〖3〗，寝而不许〖4〗。﹝一﹞后贡恢于州，涉道未至〖5〗，闻先主自葭萌还攻刘璋。恢知璋之必败，先主必成；乃托名郡使，北诣先主。遇於绵竹，先主嘉之。从至雒城，遣恢至汉中交好马超，超遂从命。","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":56,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":153,"offset_unit":"unicode_code_point"},{"id":"huowang-q-225ed2d7e9d667049592","section":"chapter-041","block":"b-20cf9e4bd23391868d15","layer":"original","quote":"成都既定，先主领益州牧，以诗为督军从事","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":169,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":34,"end":53,"offset_unit":"unicode_code_point"},{"id":"jfj-q0087","section":"chapter-044","block":"b-39673f1f78c36c0a87b8","layer":"original","quote":"会先主定蜀，祎遂留益土。与汝南许叔龙、南郡董允齐名；时许靖丧子，允与祎欲共会其葬所。允白父和请车〖2〗，和遣开后鹿车给之〖3〗。允有难载之色〖4〗，祎便从前先上。及至丧所，诸葛亮及诸贵人悉集，车乘甚鲜〖5〗；允犹神色未泰〖6〗，而祎晏然自若。持车人还，和问之；知其如此，乃谓允曰：“吾常疑汝于文伟优劣未别也；而今而后，吾意了矣〖7〗。”先主立太子，祎与允俱为舍人。迁庶子。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":107,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":186,"offset_unit":"unicode_code_point"},{"id":"jfj-q0088","section":"chapter-044","block":"b-39673f1f78c36c0a87b8","layer":"original","quote":"时许靖丧子，允与祎欲共会其葬所。允白父和请车〖2〗，和遣开后鹿车给之〖3〗。允有难载之色〖4〗，祎便从前先上。及至丧所，诸葛亮及诸贵人悉集，车乘甚鲜〖5〗；允犹神色未泰〖6〗，而祎晏然自若。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":107,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":26,"end":121,"offset_unit":"unicode_code_point"},{"id":"jfj-q0089","section":"chapter-044","block":"b-39673f1f78c36c0a87b8","layer":"original","quote":"持车人还，和问之；知其如此，乃谓允曰：“吾常疑汝于文伟优劣未别也；而今而后，吾意了矣","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":107,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":121,"end":163,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o043c-q","section":"chapter-032","block":"b-4a221026fdb893201c62","layer":"original","quote":"先主复领益州牧：诸葛亮为股肱〖2〗，法正为谋主，关羽、张飞、马超为爪牙〖3〗，许靖、麋竺、简雍为宾友〖4〗。及董和、黄权、李严等〖5〗，本璋之所授用也，吴壹、费观等〖6〗，又璋之婚亲也；彭羕〖7〗，又璋之所排摈也；刘巴者〖8〗，宿昔之所忌恨也：皆处之显任，尽其器能。有志之士，无不竞劝。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":186,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":63,"end":206,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-b-dcc10490c7b3b72c467f","section":"chapter-032","block":"b-dcc10490c7b3b72c467f","layer":"modern","quote":"〖1〗十九年：建安十九年（公元 214）。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":188,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-dc65792cc6043766510a","start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o043","section":"chapter-032","block":"b-4a221026fdb893201c62","layer":"original","quote":"十九年夏〖1〗，雒城破；﹝一﹞进围成都，数十日，璋出降。﹝二﹞蜀中殷盛丰乐，先主置酒大飨士卒；取蜀城中金银分赐将士，还其谷帛。先主复领益州牧：诸葛亮为股肱〖2〗，法正为谋主，关羽、张飞、马超为爪牙〖3〗，许靖、麋竺、简雍为宾友〖4〗。及董和、黄权、李严等〖5〗，本璋之所授用也，吴壹、费观等〖6〗，又璋之婚亲也；彭羕〖7〗，又璋之所排摈也；刘巴者〖8〗，宿昔之所忌恨也：皆处之显任，尽其器能。有志之士，无不竞劝。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":186,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":206,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-9d9c6c3cd013f113898d","section":"chapter-038","block":"b-4724e70f37115927f07b","layer":"original","quote":"先主克蜀，以靖为左将军长史","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":148,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":7,"end":20,"offset_unit":"unicode_code_point"}],"profiles":{"xianzhu-p0061":{"fields":[],"directory":{"faction":"shu"}}},"directory_counts":{}}
