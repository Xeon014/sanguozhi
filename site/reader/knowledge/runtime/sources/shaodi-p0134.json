{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"shaodi-e-p050a","title":"曹髦与李昭焦伯授兵因雨却日","accounts":[{"id":"shaodi-e-p050a-account","label":"《魏氏春秋》","text":"曹髦与李昭焦伯授兵因雨却日","evidence":["shaodi-e-p050a-q"]}],"participants":[{"person":"shaodi-p0068","role":"授兵","evidence":["shaodi-e-p050a-q"]},{"person":"shaodi-p0133","role":"从行","evidence":["shaodi-e-p050a-q"]},{"person":"shaodi-p0134","role":"从行","evidence":["shaodi-e-p050a-q"]}],"place":null,"time":{"year":260,"label":"戊子夜","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"shaodi-y260","dating_review":{"reviewed":true,"anchor":"shaodi-q-o139","basis":"戊子夜"},"evidence":["shaodi-e-p050a-q","shaodi-q-o139","shaodi-q-b-77066dd061eb6a338ffa"]},"ordering_evidence":"shaodi-e-p050a-q","source_order":[4,670,"P050a"],"order":1233}],"persons":[{"id":"shaodi-p0134","name":"焦伯","evidence":["shaodi-q-p050"],"facts":[],"aliases":[],"mentions":[{"id":"shaodi-m-p050-shaodi-p0134","kind":"mention","text":"文中提及","evidence":["shaodi-q-p050"]}]}],"evidence":[{"id":"shaodi-e-p050a-q","section":"chapter-004","block":"b-95c20d9aaf1e6549fd28","layer":"pei","quote":"《魏氏春秋》曰：“戊子夜，帝自将冗从仆射李昭、黄门从官焦伯等，下陵云台，铠仗授兵；欲因际会，自出讨文王。会雨，有司奏却日。遂见王经等，出黄素诏于怀曰：‘是可忍也，孰不可忍也！今日便当决行此事。’入白太后。遂拔剑升辇，帅殿中宿卫、苍头官僮，击战鼓，出云龙门。贾充自外而入，帝师溃散；犹称‘天子’，手剑奋击，众莫敢逼。充帅厉将士，骑督成倅弟成济，以矛进，帝崩于师。时暴雨雷霆，晦冥。”","attribution":"《魏氏春秋》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":77,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-74646ac2cf964244648d","start":0,"end":190,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-b-77066dd061eb6a338ffa","section":"chapter-004","block":"b-77066dd061eb6a338ffa","layer":"modern","quote":"〖1〗五年：甘露五年（公元 260 ）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":50,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-21e90e29c9fd438bba21","start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o139","section":"chapter-004","block":"b-c33fc441ae4a3de17fb6","layer":"original","quote":"五年春正月朔〖1〗，日有食之。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":45,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":15,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-p050","section":"chapter-004","block":"b-95c20d9aaf1e6549fd28","layer":"pei","quote":"《魏氏春秋》曰：“戊子夜，帝自将冗从仆射李昭、黄门从官焦伯等，下陵云台，铠仗授兵；欲因际会，自出讨文王。会雨，有司奏却日。遂见王经等，出黄素诏于怀曰：‘是可忍也，孰不可忍也！今日便当决行此事。’入白太后。遂拔剑升辇，帅殿中宿卫、苍头官僮，击战鼓，出云龙门。贾充自外而入，帝师溃散；犹称‘天子’，手剑奋击，众莫敢逼。充帅厉将士，骑督成倅弟成济，以矛进，帝崩于师。时暴雨雷霆，晦冥。”","attribution":"《魏氏春秋》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":77,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-74646ac2cf964244648d","start":0,"end":190,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
