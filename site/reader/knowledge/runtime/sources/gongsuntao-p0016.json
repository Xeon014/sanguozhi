g_evidence":"gongsuntao-q-9a93839601e84480c82a","source_order":[8,51,0],"order":1938}],"persons":[{"id":"gongsuntao-p0016","name":"公孙越","evidence":["gongsuntao-q-8dc464efb5e0d01b3e8f","gongsuntao-q-9a93839601e84480c82a"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[{"id":"gongsuntao-q-8dc464efb5e0d01b3e8f","section":"chapter-008","block":"b-8e6e9116092025fbf916","layer":"original","quote":"瓒知术有异志，不欲遣兵，止虞；虞不可。瓒惧术闻而怨之，亦遣其从弟越，将千骑诣术以自结〖5〗；而阴教术执和〖6〗，夺其兵。由是虞、瓒益有隙。和逃术来北，复为绍所留","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":49,"anchor":null},"note_id":null,"start":0,"end":80},{"id":"gongsuntao-q-9a93839601e84480c82a","section":"chapter-008","block":"b-b2ad847988834f852565","layer":"original","quote":"是时，术遣孙坚屯阳城拒卓，绍使周昂夺其处。术遣越与坚攻昂，不胜；越为流矢所中死","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":50,"anchor":null},"note_id":null,"start":0,"end":39}],"profiles":{},"directory_counts":{}}
