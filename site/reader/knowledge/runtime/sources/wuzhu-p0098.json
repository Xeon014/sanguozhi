on":"wuzhu-p0098","role":"奉使受任","evidence":["wuzhu-e-p059c-q"]}],"place":null,"time":{"label":"郑胄及其父子仕宦时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["wuzhu-e-p059c-q"]},"ordering_evidence":"wuzhu-e-p059c-q","source_order":[47,702,"P059c"],"order":8358},{"id":"santizhu-e-o025f","title":"丁密郑胄钟离牧率军讨乱","accounts":[{"id":"santizhu-a-1c196667147548c46a95","label":"正文","text":"丁密郑胄钟离牧率军讨乱","evidence":["santizhu-q-83b0080f1458980b9f24"]}],"participants":[{"person":"santizhu-p0067","role":"与郑胄、钟离牧率军讨乱","evidence":["santizhu-q-83b0080f1458980b9f24"]},{"person":"wuzhu-p0098","role":"与丁固、钟离牧率军讨乱","evidence":["santizhu-q-83b0080f1458980b9f24"]},{"person":"santizhu-p0023","role":"与丁固、郑胄率军讨乱","evidence":["santizhu-q-83b0080f1458980b9f24"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["santizhu-q-83b0080f1458980b9f24"]},"ordering_evidence":"santizhu-q-83b0080f1458980b9f24","source_order":[48,25,77],"order":8520}],"persons":[{"id":"wuzhu-p0098","name":"郑胄","evidence":["wuzhu-q-o126","santizhu-q-83b0080f1458980b9f24"],"facts":[{"id":"wuzhu-f0020","label":"字","text":"敬先","evidence":["wuzhu-f0020-q"]},{"id":"wuzhu-f0021","label":"籍贯","text":"沛国","evidence":["wuzhu-f0021-q"]}],"aliases":[{"text":"敬先","evidence":["wuzhu-f0020-q"]}],"mentions":[{"id":"wuzhu-m-o126-wuzhu-p0098","kind":"mention","text":"文中提及","evidence":["wuzhu-q-o126"]},{"id":"wuzhu-m-p059-wuzhu-p0098","kind":"mention","text":"文中提及","evidence":["wuzhu-q-p059"]}]}],"evidence":[{"id":"houfei-q-o050","section":"chapter-005","block":"b-6dc749ac781a81d5a82f","layer":"original","quote":"帝疾困，遂立为皇后。齐王即位，尊后为皇太后，称“永宁宫”。追封谥太后父满，为西都定侯，以立子建绍其爵。封太后母杜，为郃阳君。芝迁散骑常侍、长水校尉；﹝一﹞立，宣德将军〖2〗；皆封列侯。建兄德，出养甄氏。德及建，俱为镇护将军〖3〗，皆封列侯，并掌宿卫。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":236,"anchor":null},"note_id":null,"start":0,"end":125},{"id":"mingdi-q-b-e59395a0e3cfa7e31144","section":"chapter-003","block":"b-e59395a0e3cfa7e31144","layer":"modern","quote":"〖4〗三年：景初三年（公元 239）。丁亥：旧历初一日。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":496,"anchor":null},"note_id":"n-271e1436daf6e49feb83","start":0,"end":28},{"id":"mingdi-q-o068","section":"chapter-003","block":"b-15faf626ce48eb2f68b4","layer":"original","quote":"三年春正月，丁亥〖4〗，太尉宣王还至河内；帝驿马召到〖5〗，引入卧内，执其手谓曰：“吾疾甚！以后事属君。君其与爽辅少子〖6〗。吾得见君，无所恨！”宣王顿首流涕〖7〗。﹝一﹞即日，帝崩于嘉福殿。﹝二﹞时年三十六〖8〗。﹝三﹞癸丑〖9〗，葬高平陵〖10〗。﹝四﹞","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":491,"anchor":null},"note_id":null,"start":0,"end":129},{"id":"santizhu-q-83b0080f1458980b9f24","section":"chapter-048","block":"b-67fc8774ec5679497e72","layer":"original","quote":"廷尉丁密、步兵校尉郑胄、将军钟离牧，率军讨之","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":95,"anchor":null},"note_id":null,"start":77,"end":99},{"id":"shaodi-q-o002","section":"chapter-004","block":"b-69d95c2d10b2c4a40b0c","layer":"original","quote":"青龙三年，立为齐王。景初三年正月，丁亥朔，帝病甚，乃立为皇太子。是日，即皇帝位。大赦。尊皇后曰皇太后〖2〗。大将军曹爽、太尉司马宣王辅政。诏曰：“朕以眇身〖3〗，继承鸿业。茕茕在疚〖4〗，靡所控告〖5〗。大将军、太尉奉受末命〖6〗，夹辅朕躬；司徒、司空，冢宰元辅总率百僚〖7〗，以宁社稷；其与群卿大夫勉勖乃心〖8〗，称朕意焉。”诸所兴作宫室之役，皆以遗诏罢之；官奴婢六十以上，免为良人〖9〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":2,"anchor":null},"note_id":null,"start":0,"end":196},{"id":"wuzhu-e-o126a-q","section":"chapter-047","block":"b-ab932a5023f68052057f","layer":"original","quote":"二年春三月〖1〗，﹝一﹞遣使者羊衜、郑胄、将军孙怡，之辽东，击魏守将张持、高虑等，虏得男女。﹝二﹞零陵言甘露降。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":161,"anchor":null},"note_id":null,"start":0,"end":56},{"id":"wuzhu-e-p059b-q","section":"chapter-047","block":"b-2fcac46deecf90721482","layer":"pei","quote":"胄，其少子，有文武姿局，少知名。举贤良，稍迁建安太守。吕壹宾客于郡犯法，胄收付狱，考竟。壹怀恨，后密谮胄。权大怒，召胄还。潘濬、陈表并为请，得释。","attribution":"《文士传》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":190,"anchor":null},"note_id":"n-436f44c3434f84aa19b6","start":55,"end":128},{"id":"wuzhu-e-p059c-q","section":"chapter-047","block":"b-2fcac46deecf90721482","layer":"pei","quote":"后拜宣信校尉，往救公孙渊；已为魏所破，还，迁执金吾。","attribution":"《文士传》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":190,"anchor":null},"note_id":"n-436f44c3434f84aa19b6","start":128,"end":154},{"id":"wuzhu-f0020-q","section":"chapter-047","block":"b-2fcac46deecf90721482","layer":"pei","quote":"胄字敬先","attribution":"《文士传》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":190,"anchor":null},"note_id":"n-436f44c3434f84aa19b6","start":11,"end":15},{"id":"wuzhu-f0021-q","section":"chapter-047","block":"b-2fcac46deecf90721482","layer":"pei","quote":"沛国人","attribution":"《文士传》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":190,"anchor":null},"note_id":"n-436f44c3434f84aa19b6","start":16,"end":19},{"id":"wuzhu-q-o126","section":"chapter-047","block":"b-ab932a5023f68052057f","layer":"original","quote":"二年春三月〖1〗，﹝一﹞遣使者羊衜、郑胄、将军孙怡，之辽东，击魏守将张持、高虑等，虏得男女。﹝二﹞零陵言甘露降。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":161,"anchor":null},"note_id":null,"start":0,"end":56},{"id":"wuzhu-q-p059","section":"chapter-047","block":"b-2fcac46deecf90721482","layer":"pei","quote":"﹝二﹞《文士传》曰：“胄字敬先，沛国人。父札，才学博达。权为骠骑将军，以札为从事中郎。与张昭、孙邵，共定朝仪。胄，其少子，有文武姿局，少知名。举贤良，稍迁建安太守。吕壹宾客于郡犯法，胄收付狱，考竟。壹怀恨，后密谮胄。权大怒，召胄还。潘濬、陈表并为请，得释。后拜宣信校尉，往救公孙渊；已为魏所破，还，迁执金吾。子丰，字曼季。有文学操行，与陆云善，与云诗（词）〔相〕往反。司空张华辟，未就，卒。”","attribution":"《文士传》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":190,"anchor":null},"note_id":"n-436f44c3434f84aa19b6","start":0,"end":196}],"profiles":{},"directory_counts":{}}
