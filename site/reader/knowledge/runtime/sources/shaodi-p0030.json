evidence":["shaodi-q-o043","xiahoucao-q-o069","huanchen-q-4acbb5c10c9b6ecef60e","zhonghua-q-b6fc9dd007cb857085d4"],"facts":[{"id":"xiahoucao-f0053","label":"字","text":"元则","evidence":["xiahoucao-f0053-q"]}],"aliases":[{"text":"元则","evidence":["xiahoucao-f0053-q"]}],"mentions":[{"id":"shaodi-m-o043-shaodi-p0030","kind":"mention","text":"文中提及","evidence":["shaodi-q-o043"]},{"id":"xiahoucao-m-o069-shaodi-p0030","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-o069"]},{"id":"xiahoucao-m-o071-shaodi-p0030","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-o071"]},{"id":"xiahoucao-m-p031-shaodi-p0030","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-p031"]},{"id":"xiahoucao-m-p034-shaodi-p0030","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-p034"]},{"id":"xiahoucao-m-p041-shaodi-p0030","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-p041"]},{"id":"xiahoucao-m-p066-shaodi-p0030","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-p066"]}]}],"evidence":[{"id":"houzhu-q-O053","section":"chapter-033","block":"b-4d2ab6578239f0eee393","layer":"original","quote":"十二年春正月，魏诛大将军曹爽等，右将军夏侯霸来降。","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":111,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":25,"offset_unit":"unicode_code_point"},{"id":"huanchen-q-4acbb5c10c9b6ecef60e","section":"chapter-022","block":"b-9a7fe236edb28f433514","layer":"original","quote":"明帝即位，封津阳亭侯，邑二百户。中领军桓范荐宣曰〖3〗：“臣闻帝王用人，度世授才〖4〗：争夺之时，以策略为先；分定之后〖5〗，以忠义为首。故晋文行舅犯之计，而赏雍季之言〖6〗；﹝一﹞高祖用陈平之智，而托后于周勃也〖7〗。窃见尚书徐宣，体忠厚之行，秉直亮之性；清雅特立，不（拘）〔随〕世俗；确然难动〖8〗，有社稷之节；历位州郡，所在称职。今仆射缺，宣行掌后事；腹心任重，莫宜宣者〖9〗。”帝遂以宣为左仆射。后加侍中、光禄大夫","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":401,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":211,"offset_unit":"unicode_code_point"},{"id":"shaodi-e-o043b-q","section":"chapter-004","block":"b-b1c990928436e9ed43da","layer":"original","quote":"嘉平元年春正月，甲午〖1〗，车驾谒高平陵。﹝一﹞太傅司马宣王奏免大将军曹爽、爽弟中领军羲、武卫将军训、散骑常侍彦官〖2〗，以侯就第。戊戌〖3〗，有司奏收黄门张当付廷尉〖4〗；考实其辞，爽与谋不轨。又尚书丁谧、邓飏、何晏，司隶校尉毕轨，荆州刺史李胜，大司农桓范，皆与爽通奸谋〖5〗，夷三族。语在《爽传》。丙午〖6〗，大赦。丁未〖7〗，以太傅司马宣王为丞相；固让，乃止。﹝二﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":180,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":186,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-b-33155276d789f594176b","section":"chapter-004","block":"b-33155276d789f594176b","layer":"modern","quote":"〖13〗二年：嘉平二年（公元 250）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":198,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-235bc158a4eae2a0609a","start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o043","section":"chapter-004","block":"b-b1c990928436e9ed43da","layer":"original","quote":"嘉平元年春正月，甲午〖1〗，车驾谒高平陵。﹝一﹞太傅司马宣王奏免大将军曹爽、爽弟中领军羲、武卫将军训、散骑常侍彦官〖2〗，以侯就第。戊戌〖3〗，有司奏收黄门张当付廷尉〖4〗；考实其辞，爽与谋不轨。又尚书丁谧、邓飏、何晏，司隶校尉毕轨，荆州刺史李胜，大司农桓范，皆与爽通奸谋〖5〗，夷三族。语在《爽传》。丙午〖6〗，大赦。丁未〖7〗，以太傅司马宣王为丞相；固让，乃止。﹝二﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":180,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":186,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o046","section":"chapter-004","block":"b-8bc97b77985c9cc83eeb","layer":"original","quote":"二年夏五月〖13〗，以征西将军郭淮为车骑将军〖14〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":183,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":27,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-91594aaa37c7f634c45a","section":"chapter-021","block":"b-217f7a92077c8b2f0cd5","layer":"original","quote":"曹爽诛","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":480,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":16,"end":19,"offset_unit":"unicode_code_point"},{"id":"wgc-q0006","section":"chapter-028","block":"b-48d8a8c3b1b7a3ef24e8","layer":"original","quote":"是时，凌外甥令狐愚以才能为兖州刺史，屯平阿〖3〗。舅甥并典兵，专淮南之重。凌就迁为司空〖4〗。司马宣王既诛曹爽，进凌为太尉，假节、钺。凌、愚密协计，谓齐王不任天位〖5〗，楚王彪长而才〖6〗，欲迎立彪都许昌。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":22,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":103,"offset_unit":"unicode_code_point"},{"id":"wgc-q0164","section":"chapter-028","block":"b-48d8a8c3b1b7a3ef24e8","layer":"original","quote":"司马宣王既诛曹爽","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":22,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":47,"end":55,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o069a-q","section":"chapter-009","block":"b-75b7c83ac76cada6ce82","layer":"original","quote":"大司农沛国桓范闻兵起，不应太后召〖1〗；矫诏开平昌门〖2〗；拔取剑戟，略将门候〖3〗；南奔爽。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":345,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":47,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o069b-q","section":"chapter-009","block":"b-75b7c83ac76cada6ce82","layer":"original","quote":"宣王知，曰：“范画策，爽必不能用范计。”范说爽，使车驾幸许昌，招外兵。爽兄弟犹豫未决，范重谓羲曰：“当今日〖4〗，卿门户求贫贱，复可得乎〖5〗！且匹夫持质一人，尚欲望活；今卿与天子相随，令于天下，谁敢不应者？”羲犹不能纳。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":345,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":47,"end":158,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o071b-q","section":"chapter-009","block":"b-650ce0d2c114d6dfb6ac","layer":"original","quote":"于是收晏等下狱，会公卿朝臣，廷议〖2〗，以为：“《春秋》之义，‘君亲无将，将而必诛’〖3〗。爽以支属〖4〗，世蒙殊宠，亲受先帝握手遗诏，托以天下；而包藏祸心，蔑弃顾命〖5〗，乃与晏、飏及当等谋图神器；范党同罪人：皆为大逆不道〖6〗。”于是收爽、羲、训、晏、飏、谧、轨、胜、范、当等，皆伏诛，夷三族。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":356,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":57,"end":206,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-p031a-q","section":"chapter-009","block":"b-9d9b9cc2a356c7d21b0c","layer":"pei","quote":"﹝一﹞《世语》曰：“爽兄弟，先是数俱出游；桓范谓曰：‘总万机，典禁兵，不宜并出；若有闭城门，谁复纳入者？’爽曰：‘谁敢尔邪！’由此不复并行。至是，乃尽出也。”","attribution":"《世语》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":342,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-3cbe4cbbfdb1c9659a37","start":0,"end":79,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-p034c-q","section":"chapter-009","block":"b-09d9efa3d0503db50c7a","layer":"pei","quote":"爽既罢兵，曰：‘我不失作富家翁。’范哭曰：‘曹子丹，佳人；生汝兄弟，犊耳！何图今日，坐汝等族灭矣！","attribution":"《魏氏春秋》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":354,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-396397b55629f744e16c","start":131,"end":180,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-p041a-q","section":"chapter-009","block":"b-e208aef32668918e941e","layer":"pei","quote":"桓范字元则。世为冠族。建安末，入丞相府。延康中，为羽林左监。以有文学，与王象等典集《皇览》。明帝时为中领军、尚书。迁征虏将军、东中郎将，使持节，都督青、徐诸军事，治下邳。","attribution":"《魏略》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":374,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-45775d68baddd17aab59","start":1,"end":86,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-p041b-q","section":"chapter-009","block":"b-e208aef32668918e941e","layer":"pei","quote":"与徐州刺史郑岐，争屋，引节，欲斩岐，为岐所奏；不直，坐免还。复为兖州刺史，怏怏不得意。又闻当转为冀州牧。是时冀州统属镇北，而镇北将军吕昭才实、仕进，本在范后。范谓其妻仲长曰：‘我宁作诸卿，向三公长跪耳；不能为吕子展屈也！’其妻曰：‘君前在东，坐欲擅斩徐州刺史，众人谓君难为作下；今复羞为吕屈，是复难为作上也。’范忿其言触实，乃以刀环撞其腹；妻时怀孕，遂堕胎，死。范亦竟称疾，不赴冀州。","attribution":"《魏略》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":374,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-45775d68baddd17aab59","start":86,"end":278,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-p041c-q","section":"chapter-009","block":"b-e208aef32668918e941e","layer":"pei","quote":"正始中拜大司农。范前在台阁，号为晓事；及为司农，又以清省称。范尝抄撮《汉书》中诸杂事，自以意斟酌之，名曰《世要论》。蒋济为太尉，尝与范会社下，群卿列坐有数人；范怀其所撰，欲以示济；谓济当虚心观之。范出其书以示左右，左右传之示济；济不肯视，范心恨之。因论他事，乃发怒谓济曰：‘我祖薄德，公辈何似邪！’济性虽强毅，亦知范刚毅，睨而不应；各罢。","attribution":"《魏略》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":374,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-45775d68baddd17aab59","start":278,"end":447,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-p041d-q","section":"chapter-009","block":"b-e208aef32668918e941e","layer":"pei","quote":"范于沛郡，仕次在曹真后。于时曹爽辅政，以范乡里老宿，于九卿中特敬之；然不甚亲也。及宣王起兵，闭城门；以范为晓事，乃指召之，欲使领中领军。范欲应召，而其子谏之；以为车驾在外，不如南出。范疑有顷，儿又促之。范欲去，而司农丞吏，皆止范。范不从，乃突出至平昌城门，城门已闭。门候司蕃，故范举吏也；范呼之，举手中版以示之，矫曰：‘有诏召我，卿促开门！’蕃欲求见诏书，范呵之，言：‘卿非我故吏邪，何以敢尔？’乃开之。范出城，顾谓蕃曰：‘太傅图逆，卿从我去！’蕃徒行不能及，遂避侧。","attribution":"《魏略》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":374,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-45775d68baddd17aab59","start":447,"end":681,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-p041e-q","section":"chapter-009","block":"b-e208aef32668918e941e","layer":"pei","quote":"范南见爽，劝爽兄弟以天子诣许昌，征四方以自辅。爽疑，羲又无言。范自谓羲曰：‘事昭然，卿用读书何为邪！于今日，卿等门户倒矣！’俱不言。范又谓羲曰：‘卿别营近在阙南，洛阳典农治在城外，呼召如意。今诣许昌，不过中宿；许昌别库，足相被假。所忧当在谷食，而大司农印章在我身。’羲兄弟默然不从。中夜至五鼓，爽乃投刀于地，谓诸从驾群臣曰：‘我度太傅意，亦不过欲令我兄弟向己也。我独有以不合于远近耳！’遂进谓帝曰：‘陛下作诏免臣官，报皇太后令。","attribution":"《魏略》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":374,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-45775d68baddd17aab59","start":681,"end":895,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-p041f-q","section":"chapter-009","block":"b-e208aef32668918e941e","layer":"pei","quote":"范知爽首免而己必坐倡义也，范乃曰：‘老子今兹坐卿兄弟族矣！’爽等既免，帝还宫，遂令范随从。到洛水浮桥北，望见宣王，下车叩头而无言。宣王呼范姓曰：‘桓大夫，何为尔邪？’车驾入宫，有诏范还复位。范诣阙拜章谢，待报。会司蕃诣鸿胪自首，具说范前临出所道。宣王乃忿然曰：‘诬人以反，于法何应？’主者曰：‘科律：反受其罪。’乃收范于阙下。时人持范甚急，范谓部官曰：‘徐之，我亦义士耳。’遂送廷尉。","attribution":"《魏略》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":374,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-45775d68baddd17aab59","start":896,"end":1088,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-p066d-q","section":"chapter-009","block":"b-b3fb00b23d11cf366efe","layer":"pei","quote":"允妻阮氏，贤明而丑，允始见愕然；交礼毕，无复入意。妻遣婢觇之，云：‘有客姓桓。’妻曰：‘是必桓范，将劝使入也。’既而范果劝之。允入，须臾便起，妻捉裾留之。允顾谓妇曰：‘妇有四德，卿有其几？’妇曰：‘新妇所乏唯容。士有百行，君有其几？’（许）〔允〕曰：‘皆备！’妇曰：‘士有百行，以德为首。君好色不好德，何谓皆备？’允有惭色，知其非凡，遂雅相亲重。","attribution":"《魏氏春秋》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":637,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0f3b23485549690803dc","start":356,"end":529,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-f0053-q","section":"chapter-009","block":"b-e208aef32668918e941e","layer":"pei","quote":"桓范字元则","attribution":"《魏略》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":374,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-45775d68baddd17aab59","start":1,"end":6,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-b-46588bc9fdcd4116f089","section":"chapter-009","block":"b-46588bc9fdcd4116f089","layer":"modern","quote":"〖1〗十年：正始十年（公元 249）。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":316,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5be1013409cc3f861402","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-o066","section":"chapter-009","block":"b-a06b19e7658aef13c99d","layer":"original","quote":"十年正月〖1〗，车驾朝高平陵〖2〗。爽兄弟皆从。﹝一﹞","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":312,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":27,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-o069","section":"chapter-009","block":"b-75b7c83ac76cada6ce82","layer":"original","quote":"大司农沛国桓范闻兵起，不应太后召〖1〗；矫诏开平昌门〖2〗；拔取剑戟，略将门候〖3〗；南奔爽。宣王知，曰：“范画策，爽必不能用范计。”范说爽，使车驾幸许昌，招外兵。爽兄弟犹豫未决，范重谓羲曰：“当今日〖4〗，卿门户求贫贱，复可得乎〖5〗！且匹夫持质一人，尚欲望活；今卿与天子相随，令于天下，谁敢不应者？”羲犹不能纳。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":345,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":158,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-o071","section":"chapter-009","block":"b-650ce0d2c114d6dfb6ac","layer":"original","quote":"初，张当私以所择才人张、何等，与爽。疑其有奸，收当治罪。当陈：“爽与晏等阴谋反逆〖1〗，并先习兵，须三月中欲发。”于是收晏等下狱，会公卿朝臣，廷议〖2〗，以为：“《春秋》之义，‘君亲无将，将而必诛’〖3〗。爽以支属〖4〗，世蒙殊宠，亲受先帝握手遗诏，托以天下；而包藏祸心，蔑弃顾命〖5〗，乃与晏、飏及当等谋图神器；范党同罪人：皆为大逆不道〖6〗。”于是收爽、羲、训、晏、飏、谧、轨、胜、范、当等，皆伏诛，夷三族。﹝一﹞","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":356,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":209,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-o108-review","section":"chapter-009","block":"b-e8aa83f31b75ca2487ba","layer":"original","quote":"评曰：夏侯、曹氏，世为婚姻。故惇、渊、仁、洪、休、尚、真等，并以亲旧肺腑〖1〗，贵重于时；左右勋业〖2〗，咸有效劳〖3〗。爽德薄位尊，沉溺盈溢〖4〗；此固大《易》所著〖5〗，道家所忌也〖6〗。玄以规格局度〖7〗，世称其名；然与曹爽中外缱绻〖8〗，荣位如斯；曾未闻匡弼其非，援致良才。举兹以论，焉能免之乎〖9〗？","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":643,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":155,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-p031","section":"chapter-009","block":"b-9d9b9cc2a356c7d21b0c","layer":"pei","quote":"﹝一﹞《世语》曰：“爽兄弟，先是数俱出游；桓范谓曰：‘总万机，典禁兵，不宜并出；若有闭城门，谁复纳入者？’爽曰：‘谁敢尔邪！’由此不复并行。至是，乃尽出也。”","attribution":"《世语》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":342,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-3cbe4cbbfdb1c9659a37","start":0,"end":79,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-p034","section":"chapter-009","block":"b-09d9efa3d0503db50c7a","layer":"pei","quote":"﹝一﹞干宝《晋书》曰：“桓范出赴爽，宣王谓蒋济曰：‘智囊往矣！’济曰：‘范则智矣；驽马恋栈豆，爽必不能用也。’”《世语》曰：“宣王使许允、陈泰解语爽，蒋济亦与书达宣王之旨；又使爽所信殿中校尉尹大目谓爽‘唯免官而已’，以洛水为誓。爽信之，罢兵。”《魏氏春秋》曰：“爽既罢兵，曰：‘我不失作富家翁。’范哭曰：‘曹子丹，佳人；生汝兄弟，犊耳！何图今日，坐汝等族灭矣！’”","attribution":"干宝《晋书》；《世语》；《魏氏春秋》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":354,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-396397b55629f744e16c","start":0,"end":182,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-p041","section":"chapter-009","block":"b-e208aef32668918e941e","layer":"pei","quote":"“桓范字元则。世为冠族。建安末，入丞相府。延康中，为羽林左监。以有文学，与王象等典集《皇览》。明帝时为中领军、尚书。迁征虏将军、东中郎将，使持节，都督青、徐诸军事，治下邳。与徐州刺史郑岐，争屋，引节，欲斩岐，为岐所奏；不直，坐免还。复为兖州刺史，怏怏不得意。又闻当转为冀州牧。是时冀州统属镇北，而镇北将军吕昭才实、仕进，本在范后。范谓其妻仲长曰：‘我宁作诸卿，向三公长跪耳；不能为吕子展屈也！’其妻曰：‘君前在东，坐欲擅斩徐州刺史，众人谓君难为作下；今复羞为吕屈，是复难为作上也。’范忿其言触实，乃以刀环撞其腹；妻时怀孕，遂堕胎，死。范亦竟称疾，不赴冀州。正始中拜大司农。范前在台阁，号为晓事；及为司农，又以清省称。范尝抄撮《汉书》中诸杂事，自以意斟酌之，名曰《世要论》。蒋济为太尉，尝与范会社下，群卿列坐有数人；范怀其所撰，欲以示济；谓济当虚心观之。范出其书以示左右，左右传之示济；济不肯视，范心恨之。因论他事，乃发怒谓济曰：‘我祖薄德，公辈何似邪！’济性虽强毅，亦知范刚毅，睨而不应；各罢。范于沛郡，仕次在曹真后。于时曹爽辅政，以范乡里老宿，于九卿中特敬之；然不甚亲也。及宣王起兵，闭城门；以范为晓事，乃指召之，欲使领中领军。范欲应召，而其子谏之；以为车驾在外，不如南出。范疑有顷，儿又促之。范欲去，而司农丞吏，皆止范。范不从，乃突出至平昌城门，城门已闭。门候司蕃，故范举吏也；范呼之，举手中版以示之，矫曰：‘有诏召我，卿促开门！’蕃欲求见诏书，范呵之，言：‘卿非我故吏邪，何以敢尔？’乃开之。范出城，顾谓蕃曰：‘太傅图逆，卿从我去！’蕃徒行不能及，遂避侧。范南见爽，劝爽兄弟以天子诣许昌，征四方以自辅。爽疑，羲又无言。范自谓羲曰：‘事昭然，卿用读书何为邪！于今日，卿等门户倒矣！’俱不言。范又谓羲曰：‘卿别营近在阙南，洛阳典农治在城外，呼召如意。今诣许昌，不过中宿；许昌别库，足相被假。所忧当在谷食，而大司农印章在我身。’羲兄弟默然不从。中夜至五鼓，爽乃投刀于地，谓诸从驾群臣曰：‘我度太傅意，亦不过欲令我兄弟向己也。我独有以不合于远近耳！’遂进谓帝曰：‘陛下作诏免臣官，报皇太后令。’范知爽首免而己必坐倡义也，范乃曰：‘老子今兹坐卿兄弟族矣！’爽等既免，帝还宫，遂令范随从。到洛水浮桥北，望见宣王，下车叩头而无言。宣王呼范姓曰：‘桓大夫，何为尔邪？’车驾入宫，有诏范还复位。范诣阙拜章谢，待报。会司蕃诣鸿胪自首，具说范前临出所道。宣王乃忿然曰：‘诬人以反，于法何应？’主者曰：‘科律：反受其罪。’乃收范于阙下。时人持范甚急，范谓部官曰：‘徐之，我亦义士耳。’遂送廷尉。”","attribution":"《魏略》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":374,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-45775d68baddd17aab59","start":0,"end":1089,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-p066","section":"chapter-009","block":"b-b3fb00b23d11cf366efe","layer":"pei","quote":"《魏氏春秋》曰：“允为吏部郎，选郡守。明帝疑其所用非次，召入，将加罪。允妻阮氏跣出，谓曰：‘明主可以理夺，难以情求！’允颔之而入。帝怒诘之，允对曰：‘某郡太守虽限满文书先至，年限在后；〔某守虽后，年〕限在前。’帝前，取事视之，乃释遣出。望其衣败，曰：‘清吏也。’赐之。允之出为镇北也，喜谓其妻曰：‘吾知免矣！’妻曰：‘祸见于此，何免之有！’允善相印；将拜，以印不善，使更刻之；如此者三。允曰：‘印虽始成，而已被辱。’问送印者，果怀之而坠于厕。《相印书》曰：‘相印法本出陈长文，长文以语韦仲将。印工杨利，从仲将受法，以语许士宗。利以法术占吉凶，十可中八九。仲将问长文：“从谁得法？”长文曰：“本出汉世，有《相印》、《相笏经》，又有《鹰经》、《牛经》、《马经》。印工宗养，以法语程申伯，是故有一十二家相法传于世。”’允妻阮氏，贤明而丑，允始见愕然；交礼毕，无复入意。妻遣婢觇之，云：‘有客姓桓。’妻曰：‘是必桓范，将劝使入也。’既而范果劝之。允入，须臾便起，妻捉裾留之。允顾谓妇曰：‘妇有四德，卿有其几？’妇曰：‘新妇所乏唯容。士有百行，君有其几？’（许）〔允〕曰：‘皆备！’妇曰：‘士有百行，以德为首。君好色不好德，何谓皆备？’允有惭色，知其非凡，遂雅相亲重。生二子：奇、猛，少有令闻。允后为景王所诛，门生走入告其妇。妇正在机，神色不变，曰：‘早知尔耳。’门生欲藏其子，女曰：‘无预诸儿事。’后移居墓所，景王遣钟会看之；若才艺德能及父，当收。儿以语母，母答：‘汝等虽佳，才具不多。率胸怀与会语，便自无忧；不须极哀，会止便止。又可多少问朝事。’儿从之。会反命，具以状对；卒免其祸，皆母之教也。虽会之识鉴，而输贤妇之智也。果庆及后嗣，追封子孙而已。”","attribution":"《魏氏春秋》引《相印书》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":637,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0f3b23485549690803dc","start":0,"end":722,"offset_unit":"unicode_code_point"},{"id":"zhonghua-q-37e07eae83e346bcd0ec","section":"chapter-013","block":"b-98a6c102516e282eb801","layer":"original","quote":"爽闻之，戒何晏等曰：“当共慎之！公卿已比诸君前世恶人矣。”","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":478,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":92,"end":121,"offset_unit":"unicode_code_point"},{"id":"zhonghua-q-b6fc9dd007cb857085d4","section":"chapter-013","block":"b-98a6c102516e282eb801","layer":"original","quote":"肃与太尉蒋济、司农桓范论及时政，肃正色曰：“此辈即弘恭、石显之属〖1〗，复称说邪！”","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":478,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":50,"end":92,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
