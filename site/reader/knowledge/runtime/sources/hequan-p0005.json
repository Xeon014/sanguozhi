7,0],"order":10558}],"persons":[{"id":"hequan-p0005","name":"全柔","evidence":["hequan-q-3a48ad10fbdb71edf13f","hequan-q-5d3202e3816928d9626c","hequan-q-d9b405b6babb7b433350"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[{"id":"hequan-q-3a48ad10fbdb71edf13f","section":"chapter-060","block":"b-3faf239f49926d501179","layer":"original","quote":"父柔，汉灵帝时举孝廉，补尚书郎，右丞〖1〗。董卓之乱，弃官归。州辟别驾从事〖2〗。诏书就拜会稽东部都尉。","section_title":"贺全吕周钟离传第十五","source":{"file":"OEBPS/Text/titlepage_0127.xhtml","index":105,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":13,"end":65,"offset_unit":"unicode_code_point"},{"id":"hequan-q-5d3202e3816928d9626c","section":"chapter-060","block":"b-3faf239f49926d501179","layer":"original","quote":"孙策到吴，柔举兵先附。策表柔为丹杨都尉。孙权为车骑将军，以柔为长史。徙桂阳太守","section_title":"贺全吕周钟离传第十五","source":{"file":"OEBPS/Text/titlepage_0127.xhtml","index":105,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":65,"end":104,"offset_unit":"unicode_code_point"},{"id":"hequan-q-d9b405b6babb7b433350","section":"chapter-060","block":"b-b667321ee92ff23353ed","layer":"original","quote":"柔尝使琮赍米数千斛到吴，有所市易〖3〗。琮至，皆散用，空船而还。柔大怒，琮顿首曰：“愚以所市非急，而士大夫方有倒悬之患；故便赈赡，不及启报。”柔更以奇之","section_title":"贺全吕周钟离传第十五","source":{"file":"OEBPS/Text/titlepage_0127.xhtml","index":106,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":76,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
