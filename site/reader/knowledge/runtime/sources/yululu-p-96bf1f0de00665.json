:"OEBPS/Text/titlepage_0121.xhtml","index":306,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":32,"end":125,"offset_unit":"unicode_code_point"},{"id":"yululu-q-a0bcbd91d8520add2121","section":"chapter-057","block":"b-27f6d050ea4a434c6b70","layer":"original","quote":"骆统字公绪，会稽乌伤人也〖1〗。父俊，官至陈相〖2〗，为袁术所害。﹝一﹞统母改适〖3〗，为华歆小妻〖4〗。统时八岁，遂与亲客归会稽，其母送之。拜辞上车，面而不顾〖5〗。其母泣涕于后，御者曰〖6〗：“夫人犹在也。”统曰：“不欲增母思，故不顾耳。”","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":305,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":122,"offset_unit":"unicode_code_point"},{"id":"yululu-q-e4b9861d7c7b82c99a0e","section":"chapter-057","block":"b-27f6d050ea4a434c6b70","layer":"original","quote":"统母改适〖3〗，为华歆小妻","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":305,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":36,"end":49,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
