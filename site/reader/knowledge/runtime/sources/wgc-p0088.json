{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wgc-e-14-e7","title":"郭玄信坐被刑求艾苞为御悦之","order":5634,"accounts":[{"id":"wgc-a-14-e7","label":"裴注·世语","text":"郭玄信坐被刑求艾苞为御悦之","evidence":["wgc-q0601","wgc-q0120"]}],"participants":[{"person":"wgc-p0088","role":"坐被刑在家、从典农司马求人御、与艾苞语悦之、谓皆当远至为佐相","evidence":["wgc-q0601","wgc-q0120"]},{"person":"shaodi-p0080","role":"为御并交谈","evidence":["wgc-q0601","wgc-q0120"]},{"person":"shaodi-p0138","role":"为御并交谈","evidence":["wgc-q0601","wgc-q0120"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0601","wgc-q0120"]},"ordering_evidence":"wgc-q0601"}],"persons":[{"id":"wgc-p0088","name":"郭玄信","evidence":["wgc-q0120"],"aliases":[],"facts":[],"mentions":[{"id":"wgc-m-p039-wgc-p0088","kind":"mention","text":"本段涉及郭玄信","evidence":["wgc-q0120"]}]}],"evidence":[{"id":"wgc-q0120","section":"chapter-028","block":"b-2c684f2b0eec488340ff","layer":"pei","quote":"﹝一﹞《世语》曰：“邓艾少为襄城典农部民，与石苞皆年十二三。谒者阳翟郭玄信，武帝监军郭诞元奕之子。建安中，少府吉本，起兵许都。玄信坐被刑，在家；从典农司马求人御。以艾、苞与御，行十余里，与语，悦之，谓二人皆当远至，为佐相。艾后为典农功曹，奉使诣宣王，由此见知，遂被拔擢。”","attribution":"世语","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":261,"anchor":null},"note_id":"n-f2e8626b788c9c29d72d","start":0,"end":136},{"id":"wgc-q0601","section":"chapter-028","block":"b-2c684f2b0eec488340ff","layer":"pei","quote":"玄信坐被刑，在家；从典农司马求人御。以艾、苞与御，行十余里，与语，悦之，谓二人皆当远至，为佐相","attribution":"裴注·世语","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":261,"anchor":null},"note_id":"n-f2e8626b788c9c29d72d","start":63,"end":110}],"profiles":{},"directory_counts":{}}
