yululu-q-2e7242f48337dd9a411a","section":"chapter-057","block":"b-050171ace44ad893ac4c","layer":"original","quote":"汜弟忠，宜都太守","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":111,"anchor":null},"note_id":null,"start":0,"end":8},{"id":"yululu-q-5b529c1f1557bf409928","section":"chapter-057","block":"b-83dec35c399f832d797d","layer":"pei","quote":"晋征吴，忠与夷道监陆晏、晏弟中夏督景，坚守不下，城溃被害","attribution":"裴注·《会稽典录》","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":120,"anchor":null},"note_id":"n-122f7f0974a37fbc5812","start":91,"end":119},{"id":"yululu-q-adca67f5606638bdbe9d","section":"chapter-057","block":"b-83dec35c399f832d797d","layer":"pei","quote":"交同县王岐于孤宦之族，仕进先至宜都太守；忠乃代之","attribution":"裴注·《会稽典录》","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":120,"anchor":null},"note_id":"n-122f7f0974a37fbc5812","start":66,"end":90},{"id":"yululu-q-e7ebdc907f127d86d269","section":"chapter-057","block":"b-83dec35c399f832d797d","layer":"pei","quote":"﹝二﹞《会稽典录》曰：“忠，字世方。翻第五子。贞固干事，好识人物；造吴郡陆机于童龀之年，称上虞魏迁于无名之初：终皆远致，为著闻之士。交同县王岐于孤宦之族，仕进先至宜都太守；忠乃代之。晋征吴，忠与夷道监陆晏、晏弟中夏督景，坚守不下，城溃被害。忠子谭，字思奥。”","attribution":"裴注·会稽典录","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":120,"anchor":null},"note_id":"n-122f7f0974a37fbc5812","start":0,"end":129}],"profiles":{},"directory_counts":{}}
