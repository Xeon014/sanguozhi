"file":"OEBPS/Text/titlepage_0048.xhtml","index":158,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-57f197b8737f0115a918","start":137,"end":152,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-7d590853ee5a8deccf14","section":"chapter-021","block":"b-0000c2d0cca1b750f0c4","layer":"pei","quote":"泰始五年卒","attribution":"裴注·文章叙录","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":158,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-57f197b8737f0115a918","start":216,"end":221,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-8ca99046e769f6a4d16e","section":"chapter-021","block":"b-0000c2d0cca1b750f0c4","layer":"pei","quote":"与太尉荀顗撰定《新礼》；事未施行","attribution":"裴注·文章叙录","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":158,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-57f197b8737f0115a918","start":199,"end":215,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-a900eadd84613776d855","section":"chapter-021","block":"b-0000c2d0cca1b750f0c4","layer":"pei","quote":"晋室践阼，迁太子中庶子、散骑常侍","attribution":"裴注·文章叙录","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":158,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-57f197b8737f0115a918","start":177,"end":193,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-c901b2cca3bb70309fa4","section":"chapter-021","block":"b-0000c2d0cca1b750f0c4","layer":"pei","quote":"﹝一﹞《文章叙录》曰：“璩字休琏。博学好属文，善为书记。文、明帝世，历官散骑常侍。齐王即位，稍迁侍中、大将军长史。曹爽秉政，多违法度，璩为诗以讽焉。其言虽颇谐合，多切时要，世共传之。复为侍中，典著作。嘉平四年卒，追赠卫尉。贞字吉甫，少以才闻，能谈论。正始中，夏侯玄盛有名势。贞尝在玄坐，作五言诗，玄嘉玩之。举高第，历显位。晋武帝为抚军大将军，以贞参军事。晋室践阼，迁太子中庶子、散骑常侍。又以儒学，与太尉荀顗撰定《新礼》；事未施行。泰始五年卒。贞弟纯。纯子绍，永嘉中为黄门侍郎，为司马越所杀。纯弟秀。秀子詹，镇南大将军、江州刺史。”","attribution":"裴注引《文章叙录》","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":158,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-57f197b8737f0115a918","start":0,"end":266,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-e251605193a4ef80995e","section":"chapter-021","block":"b-0000c2d0cca1b750f0c4","layer":"pei","quote":"举高第，历显位。","attribution":"裴注引《文章叙录》","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":158,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-57f197b8737f0115a918","start":153,"end":161,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-f3a7ce0906c05ed20e2a","section":"chapter-021","block":"b-4107203c34921a600c2a","layer":"original","quote":"贞咸熙中参相国军事","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":132,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":20,"end":29,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
