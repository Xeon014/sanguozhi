rson":"dengzhang-p0013","role":"受辟为掾，并进文武之士","evidence":["dengzhang-q-761052610f0e849180cd"]}],"place":null,"time":{"year":227,"label":"建兴五年","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"zhuge-y227","dating_review":{"reviewed":true,"anchor":"zhuge-q-o024","basis":"建兴五年"},"evidence":["zhuge-e-o024a-q","zhuge-q-o024","zhuge-q-b-bac68d65cbee34059b3b"]},"ordering_evidence":"zhuge-e-o024a-q","source_order":[35,153,"O024a"],"order":6787}],"persons":[{"id":"zhuge-p0027","name":"郭攸之","evidence":["zhuge-q-o027","dongliu-q-91af810846f5ae3f00a1"],"facts":[],"aliases":[],"mentions":[{"id":"zhuge-m-o027-zhuge-p0027","kind":"mention","text":"文中提及","evidence":["zhuge-q-o027"]},{"id":"zhuge-m-o028-zhuge-p0027","kind":"mention","text":"文中提及","evidence":["zhuge-q-o028"]},{"id":"zhuge-m-o029-zhuge-p0027","kind":"mention","text":"文中提及","evidence":["zhuge-q-o029"]}]}],"evidence":[{"id":"dengzhang-q-4f1170d60cbf239c5822","section":"chapter-045","block":"b-4d265048ad192f75537e","layer":"original","quote":"及亮北住汉中，以芝为中监军，扬武将军","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":6,"anchor":null},"note_id":null,"start":0,"end":18},{"id":"dengzhang-q-761052610f0e849180cd","section":"chapter-045","block":"b-9995cf8becf4afd358d6","layer":"original","quote":"丞相亮北驻汉中，辟为掾；并进文武之士","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":323,"anchor":null},"note_id":null,"start":34,"end":52},{"id":"dongliu-q-91af810846f5ae3f00a1","section":"chapter-039","block":"b-56bd53348c75c5b9fee8","layer":"original","quote":"上疏曰：“侍中郭攸之、费祎、侍郎董允等，先帝简拔以遗陛下","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":150,"anchor":null},"note_id":null,"start":62,"end":90},{"id":"dongliu-q-cd27e4cca7a9a20fc237","section":"chapter-039","block":"b-56bd53348c75c5b9fee8","layer":"original","quote":"亮寻请祎为参军","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":150,"anchor":null},"note_id":null,"start":161,"end":168},{"id":"houzhu-q-O014","section":"chapter-033","block":"b-6af7fe784f1e0008c0e9","layer":"original","quote":"五年春，丞相亮出屯汉中，营沔北阳平、石马〖6〗。﹝二﹞","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":38,"anchor":null},"note_id":null,"start":0,"end":27},{"id":"huangli-q-35d0854ebbacd22277ac","section":"chapter-043","block":"b-d2ec35871a73902cd80f","layer":"original","quote":"建兴五年，丞相亮北住汉中","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":193,"anchor":null},"note_id":null,"start":0,"end":12},{"id":"huowang-q-7deeebf0e8889001c1fc","section":"chapter-041","block":"b-06fb1f2ea118ceeed874","layer":"original","quote":"五年〖1〗，随亮汉中","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":39,"anchor":null},"note_id":null,"start":0,"end":10},{"id":"huowang-q-cf555a5e236ef873ec39","section":"chapter-041","block":"b-e6998c80678c2b5e8a5a","layer":"original","quote":"丞相诸葛亮北驻汉中，请为记室〖5〗，使与子乔共周旋游处","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":5,"anchor":null},"note_id":null,"start":27,"end":54},{"id":"huowang-q-d6bd9abf610f84d31df3","section":"chapter-041","block":"b-ddba202528f8d05c7b7b","layer":"original","quote":"诸葛亮当北行，表与后主曰","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":43,"anchor":null},"note_id":null,"start":0,"end":12},{"id":"liuliao-q-2ce94aa555b48d9d49d5","section":"chapter-040","block":"b-3432b319a4ef9b1daa34","layer":"original","quote":"五年〖1〗，诸葛亮驻汉中；更以延为督前部〖2〗，领丞相司马〖3〗，凉州刺史。","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":271,"anchor":null},"note_id":null,"start":10,"end":48},{"id":"zhuge-e-o024a-q","section":"chapter-035","block":"b-1cb2342652e8f8d4d768","layer":"original","quote":"五年〖1〗，率诸军北驻汉中。临发，上疏曰〖2〗：","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":152,"anchor":null},"note_id":null,"start":0,"end":24},{"id":"zhuge-q-b-bac68d65cbee34059b3b","section":"chapter-035","block":"b-bac68d65cbee34059b3b","layer":"modern","quote":"〖1〗五年：建兴五年（公元 227）。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":160,"anchor":null},"note_id":"n-7b55cee111ab139cccf8","start":0,"end":19},{"id":"zhuge-q-o024","section":"chapter-035","block":"b-1cb2342652e8f8d4d768","layer":"original","quote":"五年〖1〗，率诸军北驻汉中。临发，上疏曰〖2〗：","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":152,"anchor":null},"note_id":null,"start":0,"end":24},{"id":"zhuge-q-o025-judgment","section":"chapter-035","block":"b-f349f47d12e0cbd06380","layer":"original","quote":"先帝创业未半而中道崩殂〖3〗，今天下三分，益州疲弊〖4〗：此诚危急存亡之秋也〖5〗。然待卫之臣不懈于内〖6〗，忠志之士忘身于外者〖7〗，盖追先帝之殊遇〖8〗，欲报之于陛下也。诚宜开张圣听〖9〗，以光先帝遗德，恢弘志士之气；不宜妄自菲薄〖10〗，引喻失义〖11〗，以塞忠谏之路也。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":153,"anchor":null},"note_id":null,"start":0,"end":139},{"id":"zhuge-q-o026-judgment","section":"chapter-035","block":"b-b541f3054e32715de401","layer":"original","quote":"宫中、府中俱为一体；陟罚臧否〖12〗，不宜异同〖13〗。若有作奸犯科及为忠善者〖14〗，宜付有司论其刑赏〖15〗，以昭陛下平明之理〖16〗；不宜偏私，使内外异法也。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":154,"anchor":null},"note_id":null,"start":0,"end":82},{"id":"zhuge-q-o027","section":"chapter-035","block":"b-f53c08ba28ed4fadd5f0","layer":"original","quote":"侍中、侍郎郭攸之、费祎、董允等〖17〗，此皆良实，志虑忠纯，是以先帝简拔以遗陛下〖18〗。愚以为宫中之事〖19〗，事无大小，悉以咨之，然后施行；必能裨补阙漏〖20〗，有所广益。将军向宠〖21〗，性行淑均〖22〗，晓畅军事；试用于昔日，先帝称之曰能，是以众议举宠为督〖23〗。愚以为营中之事〖24〗，悉以咨之；必能使行阵和睦〖25〗，优劣得所。亲贤臣，远小人，此先汉所以兴隆也〖26〗；亲小人，远贤臣，此后汉所以倾颓也。先帝在时，每与臣论此事，未尝不叹息痛恨于桓、灵也〖27〗。侍中、尚书、长史、参军〖28〗，此悉贞良死节之臣〖29〗，愿陛下亲之信之，则汉室之隆，可计日而待也。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":155,"anchor":null},"note_id":null,"start":0,"end":288},{"id":"zhuge-q-o027-judgment","section":"chapter-035","block":"b-f53c08ba28ed4fadd5f0","layer":"original","quote":"侍中、侍郎郭攸之、费祎、董允等〖17〗，此皆良实，志虑忠纯，是以先帝简拔以遗陛下〖18〗。愚以为宫中之事〖19〗，事无大小，悉以咨之，然后施行；必能裨补阙漏〖20〗，有所广益。将军向宠〖21〗，性行淑均〖22〗，晓畅军事；试用于昔日，先帝称之曰能，是以众议举宠为督〖23〗。愚以为营中之事〖24〗，悉以咨之；必能使行阵和睦〖25〗，优劣得所。亲贤臣，远小人，此先汉所以兴隆也〖26〗；亲小人，远贤臣，此后汉所以倾颓也。先帝在时，每与臣论此事，未尝不叹息痛恨于桓、灵也〖27〗。侍中、尚书、长史、参军〖28〗，此悉贞良死节之臣〖29〗，愿陛下亲之信之，则汉室之隆，可计日而待也。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":155,"anchor":null},"note_id":null,"start":0,"end":288},{"id":"zhuge-q-o028","section":"chapter-035","block":"b-334ba1b152f8848f7ced","layer":"original","quote":"臣本布衣〖30〗，躬耕于南阳〖31〗；苟全性命于乱世〖32〗，不求闻达于诸侯〖33〗。先帝不以臣卑鄙〖34〗，猥自枉屈〖35〗，三顾臣于草庐之中，咨臣以当世之事；由是感激〖36〗，遂许先帝以驱驰〖37〗；后值倾覆〖38〗，受任于败军之际；奉命于危难之间：尔来二十有一年矣〖39〗。﹝一﹞先帝知臣谨慎，故临崩寄臣以大事也。受命以来，夙夜忧叹，恐托付不效〖40〗，以伤先帝之明；故五月渡泸〖41〗，深入不毛〖42〗。﹝二﹞今南方已定，兵甲已足；当奖率三军〖43〗，北定中原；庶竭驽钝〖44〗，攘除奸凶〖45〗；兴复汉室，还于旧都。此臣所以报先帝，而忠陛下之职分也。至于斟酌损益，进尽忠言，则攸之、袆、允之任也。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":156,"anchor":null},"note_id":null,"start":0,"end":303},{"id":"zhuge-q-o028-judgment","section":"chapter-035","block":"b-334ba1b152f8848f7ced","layer":"original","quote":"臣本布衣〖30〗，躬耕于南阳〖31〗；苟全性命于乱世〖32〗，不求闻达于诸侯〖33〗。先帝不以臣卑鄙〖34〗，猥自枉屈〖35〗，三顾臣于草庐之中，咨臣以当世之事；由是感激〖36〗，遂许先帝以驱驰〖37〗；后值倾覆〖38〗，受任于败军之际；奉命于危难之间：尔来二十有一年矣〖39〗。﹝一﹞先帝知臣谨慎，故临崩寄臣以大事也。受命以来，夙夜忧叹，恐托付不效〖40〗，以伤先帝之明；故五月渡泸〖41〗，深入不毛〖42〗。﹝二﹞今南方已定，兵甲已足；当奖率三军〖43〗，北定中原；庶竭驽钝〖44〗，攘除奸凶〖45〗；兴复汉室，还于旧都。此臣所以报先帝，而忠陛下之职分也。至于斟酌损益，进尽忠言，则攸之、袆、允之任也。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":156,"anchor":null},"note_id":null,"start":0,"end":303},{"id":"zhuge-q-o029","section":"chapter-035","block":"b-b687c1ebece526d57fd5","layer":"original","quote":"愿陛下托臣以讨贼兴复之效；不效，则治臣之罪，以告先帝之灵。〔若无兴德之言，则〕责攸之、祎、允等之慢〖46〗，以彰其咎。陛下亦宜自谋〖47〗，以咨诹善道〖48〗，察纳雅言〖49〗，深追先帝遗诏。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":157,"anchor":null},"note_id":null,"start":0,"end":96},{"id":"zhuge-q-o029-judgment","section":"chapter-035","block":"b-b687c1ebece526d57fd5","layer":"original","quote":"愿陛下托臣以讨贼兴复之效；不效，则治臣之罪，以告先帝之灵。〔若无兴德之言，则〕责攸之、祎、允等之慢〖46〗，以彰其咎。陛下亦宜自谋〖47〗，以咨诹善道〖48〗，察纳雅言〖49〗，深追先帝遗诏。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":157,"anchor":null},"note_id":null,"start":0,"end":96},{"id":"zhuge-q-o030-judgment","section":"chapter-035","block":"b-5b1e2aef1cc53d06cf76","layer":"original","quote":"臣不胜受恩感激；今当远离，临表涕零，不知所言！","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":158,"anchor":null},"note_id":null,"start":0,"end":23}],"profiles":{},"directory_counts":{}}
