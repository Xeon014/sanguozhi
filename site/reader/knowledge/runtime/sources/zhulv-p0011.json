epage_0119.xhtml","index":118,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":5,"end":33,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-560074f128f807a91eea","section":"chapter-056","block":"b-eaec6bfe2d2f9b11be75","layer":"pei","quote":"会疾卒","attribution":"裴注·吴书","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":52,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-427231ad3c8201c9d090","start":153,"end":156,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-735441f9015e3d3e91ff","section":"chapter-056","block":"b-eaec6bfe2d2f9b11be75","layer":"pei","quote":"于是更折节为恭，留意于宾客；轻财尚义，施不望报；又学兵法，名声始闻于远近","attribution":"裴注·吴书","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":52,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-427231ad3c8201c9d090","start":116,"end":152,"offset_unit":"unicode_code_point"},{"id":"zhulv-q2-b8db09f28f543c331c36","section":"chapter-056","block":"b-eaec6bfe2d2f9b11be75","layer":"pei","quote":"﹝一﹞《吴书》曰：“才，字君业。为人精敏，善骑射。权爱异之，常侍从游戏。少以父任为武卫校尉，领兵随从征伐，屡有功捷。本郡议者以才少处荣贵，未留意于乡党。才乃叹曰：‘我初为将，谓跨马蹈敌，当身履锋，足以扬名；不知乡党复追迹其举措乎！’于是更折节为恭，留意于宾客；轻财尚义，施不望报；又学兵法，名声始闻于远近。会疾卒。”","attribution":"裴注·吴书","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":52,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-427231ad3c8201c9d090","start":0,"end":158,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
