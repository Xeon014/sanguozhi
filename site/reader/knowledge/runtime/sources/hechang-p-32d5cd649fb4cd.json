{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"hechang-e-bf26c25b46e1e2aa40dd","title":"裴廓任中垒将军","accounts":[{"id":"hechang-a-bf26c25b46e1e2aa40dd","label":"裴注·传补叙及晋诸公赞","text":"裴廓任中垒将军","evidence":["hechang-q-2b48a826513eebcec317"]}],"participants":[{"person":"hechang-p-32d5cd649fb4cd","role":"任官","evidence":["hechang-q-2b48a826513eebcec317"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["hechang-q-2b48a826513eebcec317"]},"ordering_evidence":"hechang-q-2b48a826513eebcec317","order":4854}],"persons":[{"id":"hechang-p-32d5cd649fb4cd","name":"裴廓","evidence":["hechang-q-2b48a826513eebcec317","hechang-q-214881e1067a295619f0"],"facts":[{"id":"hechang-f-a78110b27888129b2281","text":"裴康之子。","evidence":["hechang-q-214881e1067a295619f0"]}],"mentions":[],"aliases":[]}],"evidence":[{"id":"hechang-q-214881e1067a295619f0","section":"chapter-023","block":"b-e2a23e9c7cee3f0be02f","layer":"pei","quote":"黎子苞，秦州刺史。康子纯，黄门侍郎；次盾，徐州刺史；次（郃）〔邵〕，有器望，晋元帝为安东将军，（郃）〔邵〕为长史，侍中王旷与司马越书曰：“裴（郃）〔邵〕在此，虽不治事，然识量弘淹，此下人士大敬附之。”次廓，中垒将军。楷子瓒，中书郎；次宪，豫州刺史。绰子遐，太傅主簿。瓒、遐并有盛名，早卒。《晋诸公赞》称宪“有清识”。","attribution":"裴注（引书见原文，待主审复核）","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":383,"anchor":null},"note_id":"n-e3d593d747be095d124a","start":0,"end":158},{"id":"hechang-q-2b48a826513eebcec317","section":"chapter-023","block":"b-e2a23e9c7cee3f0be02f","layer":"pei","quote":"次廓，中垒将军。","attribution":"裴注·传补叙及晋诸公赞","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":383,"anchor":null},"note_id":"n-e3d593d747be095d124a","start":100,"end":108}],"profiles":{},"directory_counts":{}}
