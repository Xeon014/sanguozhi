{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"huanchen-e-p154","title":"卢谌北投刘琨卒于胡中","accounts":[{"id":"huanchen-a-22899be07b5856e9f329","label":"裴注·《谌别传》","text":"卢谌北投刘琨卒于胡中","evidence":["huanchen-q-f692ddce11205ab15409"]}],"participants":[{"person":"huanchen-p0010","role":"洛阳倾覆、北投刘琨、琨败归段末波、元帝之初累召为散骑中书侍郎不得南赴、永和六年卒于胡、胡中子孙过江","evidence":["huanchen-q-f692ddce11205ab15409"]},{"person":"zhuge-p0043","role":"以为司空从事中郎、败","evidence":["huanchen-q-f692ddce11205ab15409"]},{"person":"huanchen-p0036","role":"谌归之","evidence":["huanchen-q-f692ddce11205ab15409"]},{"person":"zhuge-p0044","role":"之初累召不得南赴","evidence":["huanchen-q-f692ddce11205ab15409"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["huanchen-q-f692ddce11205ab15409"]},"ordering_evidence":"huanchen-q-f692ddce11205ab15409","source_order":[22,604,15],"order":4657}],"persons":[{"id":"zhuge-p0044","name":"晋元帝","evidence":["zhuge-q-p042","huanchen-q-f692ddce11205ab15409"],"facts":[],"aliases":[],"mentions":[{"id":"zhuge-m-p042-zhuge-p0044","kind":"mention","text":"文中提及","evidence":["zhuge-q-p042"]}]}],"evidence":[{"id":"huanchen-q-f692ddce11205ab15409","section":"chapter-022","block":"b-a9af726f9147ef923c3d","layer":"pei","quote":"洛阳倾覆，北投刘琨，琨以为司空从事中郎。琨败，谌归段末波。元帝之初，累召为散骑、中书侍郎，不得南赴。永和六年，卒于胡。胡中子孙，过江","attribution":"裴注·《谌别传》","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":603,"anchor":null},"note_id":"n-17a5ae21cfa0a4f42759","start":15,"end":81},{"id":"zhuge-q-p042","section":"chapter-035","block":"b-0a59dde320aea01c4c71","layer":"pei","quote":"臣松之以为：亮在渭滨，魏人蹑迹；胜负之形，未可测量。而云“呕血”，盖因亮自亡而自夸大也。夫以孔明之略，岂为仲达呕血乎？及至刘琨丧师，与晋元帝笺亦云“亮军败呕血”，此则引虚记以为言也。其云“入谷”而卒，缘蜀人入谷发丧故也。","attribution":"裴松之论","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":311,"anchor":null},"note_id":"n-b775a3de637528356864","start":0,"end":110}],"profiles":{}