bc","section":"chapter-034","block":"b-c938dd06ea7b294157c0","layer":"original","quote":"咸熙元年，随后主迁于洛阳","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":54,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":12,"offset_unit":"unicode_code_point"},{"id":"erfei-q-9a3af67d92e7eb56630f","section":"chapter-034","block":"b-f32c94405104cd60952a","layer":"original","quote":"建兴八年，改封为甘陵王","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":62,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":11,"offset_unit":"unicode_code_point"},{"id":"erfei-q-9b6489ed64b925f8beb5","section":"chapter-034","block":"b-4eab094a726e8ab41bd6","layer":"original","quote":"咸熙元年，永东迁洛阳","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":63,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":10,"offset_unit":"unicode_code_point"},{"id":"erfei-q-a1e3e3c10b184cee4a72","section":"chapter-034","block":"b-4eab094a726e8ab41bd6","layer":"original","quote":"拜奉车都尉，封为乡侯","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":63,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":11,"end":21,"offset_unit":"unicode_code_point"},{"id":"erfei-q-cddd39659e699985209f","section":"chapter-034","block":"b-f32c94405104cd60952a","layer":"original","quote":"皓既信任用事〖12〗，谮构永于后主","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":62,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":21,"end":38,"offset_unit":"unicode_code_point"},{"id":"erfei-q-d571d29f591fc5654bf4","section":"chapter-034","block":"b-73d59e5e28371f20461f","layer":"original","quote":"章武元年六月，使司徒靖立永为鲁王","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":61,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":19,"end":35,"offset_unit":"unicode_code_point"},{"id":"erfei-q-ef2e71f6cf4af67deea4","section":"chapter-034","block":"b-f32c94405104cd60952a","layer":"original","quote":"后主稍疏外永〖14〗，至不得朝见者十余年","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":62,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":43,"end":63,"offset_unit":"unicode_code_point"},{"id":"erfei-q2-4229ce73dacb4619a49b","section":"chapter-034","block":"b-73d59e5e28371f20461f","layer":"original","quote":"刘永字公寿。先主子，后主庶弟也〖1〗。章武元年六月，使司徒靖立永为鲁王〖2〗。策曰：“小子永〖3〗：受兹青土〖4〗。朕承天序〖5〗，继统大业。遵修稽古〖6〗，建尔国家：封于东土，奄有龟蒙〖7〗，世为藩辅。呜呼，恭朕之诏！惟彼鲁邦，一变适道〖8〗，风化存焉；人之好德，世滋懿美〖9〗。王其秉心率礼，绥尔士民〖10〗，是飨是宜〖11〗。其戒之哉！”","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":61,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":172,"offset_unit":"unicode_code_point"},{"id":"houzhu-q-O021","section":"chapter-033","block":"b-5ba39d4009c0b73e0bbd","layer":"original","quote":"八年秋，魏使司马懿由西城，张郃由子午，曹真由斜谷：﹝一﹞欲攻汉中。丞相亮待之于城固赤坂〖5〗。大雨道绝，真等皆还。是岁，魏延破魏雍州刺史郭淮于阳溪〖6〗。徙鲁王永为甘陵王，梁王理为安平王；皆以鲁、梁在吴分界故也〖7〗。","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":53,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":109,"offset_unit":"unicode_code_point"},{"id":"houzhu-q-O084","section":"chapter-033","block":"b-69369361a27c892bfdc4","layer":"original","quote":"后主举家东迁；既至洛阳，策命之曰：“惟景元五年三月丁亥〖1〗，皇帝临轩〖2〗，使太常嘉命刘禅为安乐县公〖3〗。於戏〖4〗，其进听朕命！盖统天载物，以咸宁为大〖5〗；光宅天下〖6〗，以时雍为盛〖7〗。故孕育群生者，君人之道也〖8〗；乃顺承天者〖9〗，坤元之义也〖10〗。上下交畅，然后万物协和，庶类获乂〖11〗。乃者汉氏失统〖12〗，六合震扰。我太祖承运龙兴，弘济八极〖13〗；是用应天顺民〖14〗，抚有区夏〖15〗。于时乃考因群杰虎争〖16〗，九服不静〖17〗，乘间阻远〖18〗，保据庸蜀〖19〗；遂使西隅殊封〖20〗，方外壅隔〖21〗。自是以来，干戈不戢〖22〗；元元之民，不得保安其性〖23〗，几将五纪〖24〗。朕永惟祖考遗志〖25〗，思在绥缉四海〖26〗，率土同轨；故爰整六师〖27〗，耀威梁、益〖28〗。公恢崇德度〖29〗，深秉大正；不惮屈身委质〖30〗，以爱民全国为贵〖31〗；降心回虑〖32〗，应机豹变〖33〗；履信思顺，以享左右无疆之休〖34〗。岂不远欤〖35〗！朕嘉与君公长飨显禄〖36〗，用考咨前训〖37〗，开国胙土〖38〗，率遵旧典，锡兹玄土〖39〗，苴以白茅〖40〗；永为魏藩辅。往钦哉〖41〗！公其祗服朕命〖42〗，克广德心，以终乃显烈〖43〗。”","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":207,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":536,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o066e-q","section":"chapter-032","block":"b-9899314a2556743b9f4b","layer":"original","quote":"六月，以子永为鲁王〖3〗，理为梁王〖4〗。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":399,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":69,"end":90,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-p050c-q","section":"chapter-032","block":"b-bbf1e8d2263342ea3d93","layer":"pei","quote":"临终时，呼鲁王与语：“吾亡之后，汝兄弟父事丞相，令卿与丞相共事而已。”","attribution":"《诸葛亮集》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":457,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fe13c85cd9ed1cb581d9","start":223,"end":258,"offset_unit":"unicode_code_point"},{"id":"xianzhu-f0031-q","section":"chapter-032","block":"b-9899314a2556743b9f4b","layer":"original","quote":"六月，以子永为鲁王〖3〗，理为梁王〖4〗。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":399,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":69,"end":90,"offset_unit":"unicode_code_point"},{"id":"xianzhu-f0033-q","section":"chapter-032","block":"b-bbf1e8d2263342ea3d93","layer":"pei","quote":"临终时，呼鲁王与语：“吾亡之后，汝兄弟父事丞相，令卿与丞相共事而已。”","attribution":"《诸葛亮集》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":457,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fe13c85cd9ed1cb581d9","start":223,"end":258,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-b-7396ee3085c96d5be06c","section":"chapter-032","block":"b-7396ee3085c96d5be06c","layer":"modern","quote":"〖22〗建安二十六年：公元 221 年。建安年号到二十四年为止。刘备不承认曹魏的年号，所以继续以建安年号记年。丙午：阴历初六日。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":380,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-dce0e27ac9260548c4b5","start":0,"end":64,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-b-c3a154cca1b5578eba4b","section":"chapter-032","block":"b-c3a154cca1b5578eba4b","layer":"modern","quote":"〖1〗三年：章武三年（公元 223）。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":435,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-51b38d25bb3f712211d0","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o065","section":"chapter-032","block":"b-3ec28bd830861da89fc0","layer":"original","quote":"即皇帝位于成都武担之南〖21〗，﹝一﹞为文曰：“惟建安二十六年四月丙午〖22〗，皇帝〔臣〕备，敢用玄牡〖23〗，昭告皇天上帝、后土神祇：汉有天下，历数无疆。曩者王莽篡盗〖24〗，光武皇帝震怒致诛，社稷复存。今曹操阻兵安忍〖25〗，戮杀主后；滔天泯夏〖26〗，罔顾天显〖27〗。操子丕，载其凶逆〖28〗，窃居神器。群臣将士以为社稷坠废，备宜修之；嗣武二祖〖29〗，龚行天罚。备惟否德〖30〗，惧忝帝位〖31〗；询于庶民，外及蛮夷君长，佥曰：‘天命不可以不答，祖业不可以久替，四海不可以无主；率土式望〖32〗，在备一人。’备畏天明命，又惧汉阼将湮于地；谨择元日〖33〗，与百僚登坛，受皇帝玺绶；修燔瘗〖34〗，告类于大神〖35〗。惟神〔尚〕飨〖36〗！祚于汉家，永绥四海〖37〗！”﹝二﹞","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":357,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":342,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o066","section":"chapter-032","block":"b-9899314a2556743b9f4b","layer":"original","quote":"章武元年夏四月，大赦，改年。以诸葛亮为丞相，许靖为司徒，置百官；立宗庙，祫祭高皇帝以下〖1〗。﹝一﹞五月，立皇后吴氏〖2〗，子禅为皇太子。六月，以子永为鲁王〖3〗，理为梁王〖4〗。车骑将军张飞为其左右所害。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":399,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":103,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o073","section":"chapter-032","block":"b-4232898cf1bcba6ab843","layer":"original","quote":"三年春二月〖1〗，丞相亮自成都到永安。三月，黄元进兵攻临邛县〖2〗。遣将军陈曶﹝一﹞讨元。元军败，顺流下江；为其亲兵所缚，生致成都，斩之。先主病笃，托孤于丞相亮〖3〗；尚书令李严为副。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":429,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":92,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-p050","section":"chapter-032","block":"b-bbf1e8d2263342ea3d93","layer":"pei","quote":"﹝二﹞《诸葛亮集》载先主遗诏敕后主曰：“朕初疾，但下痢耳；后转杂他病，殆不自济。人五十不称夭，年已六十有余，何所复恨！不复自伤，但以卿兄弟为念！射君到，说丞相叹卿‘智量甚大，增修过于所望’；审能如此，吾复何忧！勉之，勉之！勿以恶小而为之，勿以善小而不为；惟贤惟德，能服于人。汝父德薄，勿效之。可读《汉书》、《礼记》，闲暇历观诸子及《六韬》、《商君书》，益人意智。闻丞相为写《申》、《韩》、《管子》、《六韬》一通，已毕，未送；道亡，可自更求闻达。”临终时，呼鲁王与语：“吾亡之后，汝兄弟父事丞相，令卿与丞相共事而已。”","attribution":"《诸葛亮集》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":457,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fe13c85cd9ed1cb581d9","start":0,"end":258,"offset_unit":"unicode_code_point"}],"profiles":{"xianzhu-p0113":{"fields":[],"directory":{"faction":"shu"}}},"directory_counts":{}}
