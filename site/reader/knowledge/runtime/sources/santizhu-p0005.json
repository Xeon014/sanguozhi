c9f2ae","santizhu064-q-9738c31389ca10915f3b","santizhu064-q-2107c04577f0389f859b","santizhu064-q-040ef7a4797e98255c1e","santizhu064-q-048c9697467d1d96015a","santizhu064-q-d13c03c8f6acc467f271","hequan-q-58d838412166414edab0","zhanggu-q-f36f8e90b50cd4b0dbe0","zongshi-q-d263052f419cad467862","zongshi-q-1a1af169254a37193113"],"facts":[{"id":"santizhu064-f-sr-001","text":"北海剧人；伯父耽、父胄与刘繇州里通家，以世乱渡江依繇","evidence":["santizhu064-q-d13c03c8f6acc467f271"]}],"aliases":[],"mentions":[]}],"evidence":[{"id":"hequan-q-58d838412166414edab0","section":"chapter-060","block":"b-1017a8c1da2e3cef2cf5","layer":"pei","quote":"始兴太守羊衜，与太常滕胤书曰：‘钟离子幹，吾昔知之不熟；定见其在南海，威恩部伍，智勇分明；加操行清纯，有古人之风","attribution":"裴注·《会稽典录》","section_title":"贺全吕周钟离传第十五","source":{"file":"OEBPS/Text/titlepage_0127.xhtml","index":424,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-43dc051269e0fb8c25a0","start":96,"end":152,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-031eb9e989f1b32de8d0","section":"chapter-048","block":"b-827c97fc82e30ff0481c","layer":"original","quote":"据、钦、咨等，表荐卫将军滕胤为丞相；綝不听","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":74,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":86,"end":107,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-745b945b456c87eee365","section":"chapter-048","block":"b-db791b7bf69ac554e010","layer":"original","quote":"遣将军刘丞督步骑攻胤","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":75,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":33,"end":43,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-a8671dfa719ada9608d6","section":"chapter-048","block":"b-87c726d1b34c674ff45f","layer":"original","quote":"冬，权寝疾，征大将军诸葛恪为太子太傅，会稽太守滕胤为太常〖5〗：并受诏辅太子","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":4,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":38,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-bbb1d0fc2252ec971590","section":"chapter-048","block":"b-db791b7bf69ac554e010","layer":"original","quote":"胤兵败，夷灭","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":75,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":44,"end":50,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-e36af9202fa03bc99cbb","section":"chapter-048","block":"b-827c97fc82e30ff0481c","layer":"original","quote":"癸卯〖8〗，更以胤为大司马，代吕岱驻武昌","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":74,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":108,"end":128,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-f6dfa4f78ce6811645b9","section":"chapter-048","block":"b-a7ff4cab973329ac65da","layer":"original","quote":"〔建兴元年〕闰月〖1〗，以恪为帝太傅，胤为卫将军领尚书事〖2〗，上大将军吕岱为大司马；诸文武在位皆进爵班赏〖3〗，冗官加等〖4〗","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":13,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":64,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-01ac35039ef61997580b","section":"chapter-064","block":"b-abcd4067dd800ab40ef9","layer":"original","quote":"胤又劫融等，使诈〔为〕诏发兵。融等不从，胤皆杀之。﹝一﹞胤颜色不变，谈笑若常","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":417,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":27,"end":65,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-040ef7a4797e98255c1e","section":"chapter-064","block":"b-da2900eb25692ecb6e49","layer":"original","quote":"召典军杨崇、将军孙咨〖5〗，告以綝为乱，迫融等使（有）〔作〕书难綝","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":416,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":155,"end":188,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-048c9697467d1d96015a","section":"chapter-064","block":"b-abcd4067dd800ab40ef9","layer":"original","quote":"綝不听，表言胤反；许将军刘丞以封爵，使率兵骑急攻围胤","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":417,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":26,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-0af572f7d632a75c4086","section":"chapter-064","block":"b-a6908d269427a618f174","layer":"pei","quote":"后引恪等见卧内，受诏床下。权诏曰：‘吾疾困矣。恐不复相见，诸事一以相委！’恪歔欷流涕曰：‘臣等皆受厚恩，当以死奉诏！愿陛下安精神，损思虑，无以外事为念。’权诏有司：诸事一统于恪；惟杀生大事，然后以闻。为治第馆，设陪卫。群官百司，拜揖之仪，各有品叙。诸法令有不便者，条列以闻，权辄听之。中外翕然，人怀欢欣","attribution":"裴注·吴书","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":161,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-30fdc972641848aeb074","start":71,"end":222,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-0e7db2ae4b51bf6a222c","section":"chapter-064","block":"b-a6908d269427a618f174","layer":"pei","quote":"权寝疾，议所付托。时朝臣咸皆注意于恪，而孙峻表恪器任辅政，可付大事。权嫌恪刚狠自用；峻以当今朝臣皆莫及，遂固保之：乃征恪","attribution":"裴注·吴书","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":161,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-30fdc972641848aeb074","start":10,"end":70,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-0f283c6f3f145693be69","section":"chapter-064","block":"b-cc15ff565a536016b559","layer":"original","quote":"以胤为都下督〖16〗，掌统留事。胤白日接宾客，夜省文书，或通晓不寐。﹝三﹞","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":363,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":37,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-10c730b011e3a167ae06","section":"chapter-064","block":"b-c73d5f4083db490a9140","layer":"original","quote":"及将见，驻车宫门。峻已伏兵于帷中，恐恪不时入〖7〗，事泄；自出见恪曰：“使君若尊体不安〖8〗，自可须后〖9〗；峻当具白主上。”欲以尝知恪〖10〗。恪答曰：“当自力入","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":260,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":82,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-2107c04577f0389f859b","section":"chapter-064","block":"b-c73d5f4083db490a9140","layer":"original","quote":"散骑常侍张约、朱恩等，密书与恪曰〖12〗：“今日张设非常，疑有他故！”恪省书而去。未出路门，逢太常滕胤。恪曰：“猝腹痛，不任入。”胤不知峻阴计，谓恪曰：“君自行旋，未见〖13〗；今上置酒请君〖14〗，君已至门，宜当力进。”恪踌躇而还，剑履上殿","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":260,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":88,"end":209,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-35194a2d9a53e61adf93","section":"chapter-064","block":"b-646d5b188daa028d375a","layer":"original","quote":"峻欲城广陵〖12〗，朝臣知其不可城，而畏之莫敢言。唯滕胤谏止，不从；而功竟不就。","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":392,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":40,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-37e296af79b83e52916f","section":"chapter-064","block":"b-c73d5f4083db490a9140","layer":"original","quote":"谢亮，还坐。设酒，恪疑未饮。峻因曰：“使君病未善平〖16〗，当有常服药酒，自可取之。”恪意乃安，别饮所赍酒","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":260,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":214,"end":267,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-3cc1976dfa21cdc9f2ae","section":"chapter-064","block":"b-61205938aacc8d45ac58","layer":"original","quote":"綝兵大会，遂杀胤及将士数十人，夷胤三族","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":419,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-470f2ab45744bd1dd5e5","section":"chapter-064","block":"b-2f84ac958607dd827caa","layer":"original","quote":"孙亮即位，加卫将军〖9〗。","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":361,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":13,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-6e387014176f2cdc6a30","section":"chapter-064","block":"b-9d25e64235c0d861b5e6","layer":"original","quote":"太元元年，权寝疾〖7〗。诣都〖8〗，留为太常，与诸葛恪等俱受遗诏辅政。","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":360,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":35,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-6f977c582e5f6fc2fd9f","section":"chapter-064","block":"b-96a65b7a6a73cbfff8f8","layer":"original","quote":"始，恪退军还。聂友知其将败，书与滕胤曰：“当人强盛，河山可拔；一朝羸缩〖1〗，人情万端〖2〗。言之悲叹！”","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":349,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":53,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-713f0eefe20076200d0d","section":"chapter-064","block":"b-7df608b2f6abbcebd9ee","layer":"pei","quote":"《吴书》曰：“胤上表陈及时宜，及民间优劣，多所匡弼。权以胤故，增重公主之赐，屡加存问。胤每听辞讼，断罪法；察言观色，务尽情理。人有穷冤悲苦之言，对之流涕。”","attribution":"裴注·吴书","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":383,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ff57abe70dbdb00d975f","start":3,"end":81,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-7216ea41b317f50b4a1f","section":"chapter-064","block":"b-9e8341426d9ac906dc50","layer":"original","quote":"其明年，文钦说峻征魏。峻使钦与吕据、车骑刘纂、镇南朱异、前将军唐咨，自江都入淮、泗〖13〗，以图青、徐。峻与胤至石头〖14〗，因饯之","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":393,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":66,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-8db31efd03aa1d3fede1","section":"chapter-064","block":"b-1ceb036508e1f6a746e3","layer":"pei","quote":"《吴录》曰：“群臣上奏，共推峻为太尉，议胤为司徒。时有媚峻者，以为大统宜在公族；若滕胤为亚公，声名素重，众心所附，不可贰也。乃表以峻为丞相，又不置御史大夫。士人皆失望矣。”","attribution":"裴注·吴录","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":413,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0717b2f99a684dd2a98d","start":3,"end":89,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-9738c31389ca10915f3b","section":"chapter-064","block":"b-bb7af4361400a25e7d33","layer":"original","quote":"久之，权不豫〖1〗。而太子少，乃征恪以大将军领太子太傅〖2〗，中书令孙弘领少傅。权疾困，召恪、弘及太常滕胤、将军吕据、侍中孙峻，属以后事","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":128,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":68,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-9bdb9b5156fcb2101d50","section":"chapter-064","block":"b-05e29553087bd05cfd74","layer":"original","quote":"酒数行，亮还内。峻起如厕〖17〗，解长衣，著短服。出曰：“有诏收诸葛恪！”﹝二﹞恪惊起，拔剑未得，而峻刀交下。张约从旁斫峻，才伤左手；峻应手斫约，断右臂。武卫之士皆趋上殿，峻云：“所取者恪也！今已死。”悉令复刃〖18〗，乃除地更饮","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":261,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":115,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-b7e170871a90dbdffcd8","section":"chapter-064","block":"b-7a6fdbefc069d4df4919","layer":"pei","quote":"《吴录》曰：“峻提刀，称‘诏收恪’！亮起立曰：‘非我所为！非我所为！’乳母引亮还内。”","attribution":"裴注·吴录","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":285,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0f5229ba8104cfb1a21c","start":3,"end":46,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-bd55f33c530e82cf3ba2","section":"chapter-064","block":"b-6408d8b8d20bb8a849ce","layer":"pei","quote":"《吴历》曰：“张约、朱恩密疏告恪，恪以示滕胤，胤劝恪还。恪曰：‘峻小子，何能为邪！但恐因酒食中人耳。’乃以药酒入。”","attribution":"裴注·吴历","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":283,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-099bccdc1e55b4fc6066","start":3,"end":61,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-c0550bd176be26cade8d","section":"chapter-064","block":"b-da2900eb25692ecb6e49","layer":"original","quote":"吕据闻之大（恐）〔怒〕，与诸督将连名，共表荐滕胤为丞相；綝更以胤为大司马〖2〗，代吕岱驻武昌。","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":416,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":47,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-c63bcc038133fb8c1aa9","section":"chapter-064","block":"b-1dc4967a0ebb40a44e63","layer":"original","quote":"年三十，起家为丹杨太守〖5〗。徙吴郡、会稽〖6〗，所在见称。﹝二﹞","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":359,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":34,"end":67,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-d13c03c8f6acc467f271","section":"chapter-064","block":"b-0ad698812243a71f396c","layer":"original","quote":"滕胤字承嗣，北海剧人也〖1〗。伯父耽，父胄，与刘繇州里通家〖2〗；以世扰乱，渡江依繇。","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":357,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":43,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-d14aaec4798e4c86c446","section":"chapter-064","block":"b-bb7af4361400a25e7d33","layer":"original","quote":"久之，权不豫〖1〗。而太子少，乃征恪以大将军领太子太傅〖2〗，中书令孙弘领少傅。权疾困，召恪、弘及太常滕胤、将军吕据、侍中孙峻，属以后事。﹝一﹞","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":128,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":72,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-d291c494e8c9a9a2091f","section":"chapter-064","block":"b-da2900eb25692ecb6e49","layer":"original","quote":"据引兵还，使人报胤，欲共废綝。綝闻之，遣从兄（虑）〔宪〕，将兵逆据于江都〖3〗；使中使敕文钦、刘纂、唐咨等，合众击据；遣侍中、左将军华融、中书丞丁晏，告胤取据，并喻胤宜速去意〖4〗。胤自以祸及，因留融、晏，勒兵自卫","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":416,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":47,"end":154,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-d66af098b49647f92f4e","section":"chapter-064","block":"b-1dc4967a0ebb40a44e63","layer":"original","quote":"权为吴王，追录旧恩，封胤都亭侯。少有节操，美容仪。﹝一﹞","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":359,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":28,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-d6ea947a20342b6aaf48","section":"chapter-064","block":"b-516b7f04a1c442ad4cab","layer":"original","quote":"恪将悉众伐魏，胤谏恪曰：“君以丧代之际〖10〗，受伊、霍之托〖11〗。入安本朝，出摧强敌；名声振于海内，天下莫不震动。万姓之心，冀得蒙君而息〖12〗。今猥以劳役之后，兴师出征；民疲力屈，远主有备〖13〗。若攻城不克，野略无获，是丧前劳而招后责也。不如按甲息师，观隙而动。且兵者大事，事以众济；众苟不悦，君独安之？”恪曰：“诸云不可者，皆不见计算，怀居苟安者也。而子复以为然，吾何望焉？夫以曹芳暗劣〖14〗，而政在私门〖15〗；彼之臣民，固有离心。今吾因国家之资，借战胜之威，则何往而不克哉！”","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":362,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":246,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-d917f0aaf7f4c684c822","section":"chapter-064","block":"b-bbcb10197b6992a62f23","layer":"original","quote":"休又下诏曰：“诸葛恪、滕胤、吕据，盖以无罪为峻、綝兄弟所见残害，可为痛心！促皆改葬，各为祭奠。其罹恪等事见远徙者，一切召还〖10〗。”","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":519,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":67,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-ed9cdcdfa2a1dce4943e","section":"chapter-064","block":"b-31b9c0f48c1064f96e27","layer":"original","quote":"滕胤以恪子竦妻父，辞位，峻曰：“鲧、禹罪不相及〖5〗，滕侯何为？”峻、胤虽内不沾洽〖6〗，而外相包容；进胤爵高密侯，共事如前。﹝一﹞","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":387,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":30,"end":96,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-f38ecf16a8b16528b13b","section":"chapter-064","block":"b-7e045f8a73049ce1817c","layer":"original","quote":"孙峻因民之多怨，众之所嫌，构恪欲为变〖1〗。与亮谋，置酒请恪","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":258,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":30,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-f8a32c508487e18fba2e","section":"chapter-064","block":"b-1dc4967a0ebb40a44e63","layer":"original","quote":"弱冠尚公主。","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":359,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":28,"end":34,"offset_unit":"unicode_code_point"},{"id":"zhanggu-q-f36f8e90b50cd4b0dbe0","section":"chapter-052","block":"b-320f7a4f90b824e9bc04","layer":"pei","quote":"昭与孙绍、滕胤、郑礼等，采周、汉，撰定朝仪","attribution":"裴注·吴录","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":49,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f4aecc9082a97a5c7819","start":10,"end":31,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-1a1af169254a37193113","section":"chapter-051","block":"b-4d4c1542c098dab2b8c8","layer":"original","quote":"及孙綝诛滕胤、吕据，据、胤皆壹之妹夫也；壹弟封又知胤、据谋，自杀","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":72,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":50,"end":82,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-d263052f419cad467862","section":"chapter-051","block":"b-6f3d4f4597b61c4b220e","layer":"original","quote":"咨为滕胤所杀，仪为孙峻所害","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":41,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":81,"end":94,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
