74dfbe5a9f6153"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["dengzhang-q-1ecd2474dfbe5a9f6153"]},"ordering_evidence":"dengzhang-q-1ecd2474dfbe5a9f6153","source_order":[45,349,79],"order":7978}],"persons":[{"id":"jfj-p0025","name":"傅佥","evidence":["jfj-q0189","jfj-q0186","jfj-q0237","jfj-q0238","jfj-q0239","dengzhang-q-1ecd2474dfbe5a9f6153","dengzhang-q-7fc6b11a93337f86c71e","dengzhang-q-62e9da9582533b19ce51","dengzhang-q2-800d86a330c8ae293ffe"],"facts":[],"aliases":[],"mentions":[{"id":"jfj-m-o051-jfj-p0025","kind":"mention","text":"本段记载：傅佥格斗战死","evidence":["jfj-q0186"]},{"id":"jfj-m-p013-jfj-p0025","kind":"mention","text":"本段记载：《汉晋春秋》记蒋舒假称出战降胡烈","evidence":["jfj-q0238"]},{"id":"dengzhang-m2-role-83b6450bcf56ee36b54f","kind":"mention","text":"文中提及","evidence":["dengzhang-q-62e9da9582533b19ce51","dengzhang-q2-800d86a330c8ae293ffe"]}]}],"evidence":[{"id":"dengzhang-q-1ecd2474dfbe5a9f6153","section":"chapter-045","block":"b-4445e3e3e8a98a07754c","layer":"original","quote":"拜子佥为左中郎〖2〗，后为关中都督","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":348,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":79,"end":96,"offset_unit":"unicode_code_point"},{"id":"dengzhang-q-62e9da9582533b19ce51","section":"chapter-045","block":"b-e7333fcabcbf1943b561","layer":"pei","quote":"蜀将军傅佥：前在关城，身拒官军，致死不顾；佥父肜，复为刘备战亡。天下之善一也，岂由彼此以为异！佥息著、募，后没入奚官，免为庶人","attribution":"裴注·蜀记","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":354,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-549087e33d923b217398","start":15,"end":78,"offset_unit":"unicode_code_point"},{"id":"dengzhang-q-7fc6b11a93337f86c71e","section":"chapter-045","block":"b-4445e3e3e8a98a07754c","layer":"original","quote":"景耀六年，又临危授命","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":348,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":97,"end":107,"offset_unit":"unicode_code_point"},{"id":"dengzhang-q2-800d86a330c8ae293ffe","section":"chapter-045","block":"b-e7333fcabcbf1943b561","layer":"pei","quote":"﹝一﹞《蜀记》载晋武帝诏曰：“蜀将军傅佥：前在关城，身拒官军，致死不顾；佥父肜，复为刘备战亡。天下之善一也，岂由彼此以为异！佥息著、募，后没入奚官，免为庶人。”","attribution":"裴注（引书见原文）","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":354,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-549087e33d923b217398","start":0,"end":80,"offset_unit":"unicode_code_point"},{"id":"jfj-q0028","section":"chapter-044","block":"b-6e2f890762325a17fefa","layer":"original","quote":"六年〖1〗，维表后主：“闻钟会治兵关中，欲规进取；宜并遣张翼、廖化督诸军，分护阳安关口、阴平桥头，以防未然〖2〗。”皓征信鬼巫〖3〗，谓敌终不自致；启后主寝其事〖4〗，而群臣不知。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":228,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":90,"offset_unit":"unicode_code_point"},{"id":"jfj-q0029","section":"chapter-044","block":"b-244c42d136c1fc518809","layer":"modern","quote":"〖1〗六年：景耀六年（公元 263）。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":236,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-07b5919ab8c7edcb2376","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"jfj-q0186","section":"chapter-044","block":"b-d4a8e1aeaa400cdee772","layer":"original","quote":"月余，维为邓艾所摧，还住阴平。钟会攻围汉、乐二城，遣别将进攻关口；蒋舒开城出降，傅佥格斗而死。﹝一﹞会攻乐城，不能克；闻关口已下〖7〗，长驱而前。翼、厥甫至汉寿，维、化亦舍阴平而退，适与翼、厥合：皆退保剑阁以拒会。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":230,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":107,"offset_unit":"unicode_code_point"},{"id":"jfj-q0188","section":"chapter-044","block":"b-d4a8e1aeaa400cdee772","layer":"original","quote":"蒋舒开城出降","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":230,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":33,"end":39,"offset_unit":"unicode_code_point"},{"id":"jfj-q0189","section":"chapter-044","block":"b-d4a8e1aeaa400cdee772","layer":"original","quote":"傅佥格斗而死。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":230,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":40,"end":47,"offset_unit":"unicode_code_point"},{"id":"jfj-q0237","section":"chapter-044","block":"b-c26469c2c75e8ef75c58","layer":"pei","quote":"蒋舒将出降，乃诡谓傅佥曰：‘今贼至不击而闭城自守，非良图也。’佥曰：‘受命保城，惟全为功；今违命出战，若丧师负国，死无益矣！’舒曰：‘子以保城获全为功，我以出战克敌为功：请各行其志！’遂率众出，佥谓其战也；至阴平，以降胡烈","attribution":"《汉晋春秋》","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":255,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a486e4dc70581a9e3c21","start":12,"end":123,"offset_unit":"unicode_code_point"},{"id":"jfj-q0238","section":"chapter-044","block":"b-c26469c2c75e8ef75c58","layer":"pei","quote":"﹝一﹞《汉晋春秋》曰：“蒋舒将出降，乃诡谓傅佥曰：‘今贼至不击而闭城自守，非良图也。’佥曰：‘受命保城，惟全为功；今违命出战，若丧师负国，死无益矣！’舒曰：‘子以保城获全为功，我以出战克敌为功：请各行其志！’遂率众出，佥谓其战也；至阴平，以降胡烈，烈乘虚袭城。佥格斗而死，魏人义之。”","attribution":"《汉晋春秋》","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":255,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a486e4dc70581a9e3c21","start":0,"end":142,"offset_unit":"unicode_code_point"},{"id":"jfj-q0239","section":"chapter-044","block":"b-c26469c2c75e8ef75c58","layer":"pei","quote":"烈乘虚袭城。佥格斗而死，魏人义之。","attribution":"《汉晋春秋》","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":255,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a486e4dc70581a9e3c21","start":124,"end":141,"offset_unit":"unicode_code_point"},{"id":"jfj-q0240","section":"chapter-044","block":"b-f7fd52403b7538aeee81","layer":"pei","quote":"《蜀记》曰：“蒋舒为武兴督，在事无称。蜀命人代之，因留舒，助汉中守。舒恨，故开城出降。”","attribution":"《蜀记》","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":256,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a486e4dc70581a9e3c21","start":0,"end":44,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
