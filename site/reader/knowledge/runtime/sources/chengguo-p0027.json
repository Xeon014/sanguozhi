":[14,475,184],"order":3181},{"id":"chengguo-e-o009","title":"建安十年放与松俱至参司空军事","accounts":[{"id":"chengguo-a-e853dd004473e345ad74","label":"正文","text":"建安十年放与松俱至参司空军事","evidence":["chengguo-q-8c9c9a38775546fb2fb3"]}],"participants":[{"person":"mingdi-p0106","role":"与松俱至、参司空军事、历主簿记室、出为郃阳祋祤赞令","evidence":["chengguo-q-8c9c9a38775546fb2fb3"]},{"person":"chengguo-p0027","role":"俱至","evidence":["chengguo-q-8c9c9a38775546fb2fb3"]},{"person":"cao-cao","role":"大悦、谓放曰昔班彪依窦融而有河西之功今一何相似也","evidence":["chengguo-q-8c9c9a38775546fb2fb3"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["chengguo-q-8c9c9a38775546fb2fb3"]},"ordering_evidence":"chengguo-q-8c9c9a38775546fb2fb3","source_order":[14,476,0],"order":3183}],"persons":[{"id":"chengguo-p0027","name":"王松","evidence":["chengguo-q-b9f94d6b5cf4dff9d137","chengguo-q-214c5b6f34b51ab7fa14","chengguo-q-0821bc58f8373d49eb0a","chengguo-q-8c9c9a38775546fb2fb3"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[{"id":"chengguo-q-0821bc58f8373d49eb0a","section":"chapter-014","block":"b-644ba8ff373cd71764e8","layer":"original","quote":"会太祖讨袁谭于南皮，以书招松。松举雍奴、泉州、安次以附之〖7〗。","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":474,"anchor":null},"note_id":null,"start":184,"end":216},{"id":"chengguo-q-214c5b6f34b51ab7fa14","section":"chapter-014","block":"b-644ba8ff373cd71764e8","layer":"original","quote":"放说松曰：“往者董卓作逆，英雄并起；阻兵擅命，人自封殖〖2〗。惟曹公能拔拯危乱，翼戴天子；奉辞伐罪，所向必克。以二袁之强〖3〗，守则淮南冰消，战则官渡大败。乘胜席卷，将清河朔〖4〗；威刑既合，大势已现。速至者渐福，后服者先亡，此乃不俟终日、驰骛之时也〖5〗。昔黥布弃南面之尊〖6〗，仗剑归汉，诚识废兴之理，审去就之分也；将军宜投身委命，厚自结纳。”松然之。","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":474,"anchor":null},"note_id":null,"start":6,"end":184},{"id":"chengguo-q-8c9c9a38775546fb2fb3","section":"chapter-014","block":"b-1d08d6bcd22c274b210c","layer":"original","quote":"建安十年，与松俱至。太祖大悦，谓放曰：“昔班彪依窦融而有河西之功〖8〗，今一何相似也！”乃以放参司空军事。历主簿、记室〖9〗。出为郃阳、祋祤、赞令〖10〗","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":475,"anchor":null},"note_id":null,"start":0,"end":77},{"id":"chengguo-q-b9f94d6b5cf4dff9d137","section":"chapter-014","block":"b-a5c602a3f5d6dc0137b7","layer":"original","quote":"遭世大乱，时渔阳王松据其土，放往依之","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":473,"anchor":null},"note_id":null,"start":47,"end":65}],"profiles":{},"directory_counts":{}}
