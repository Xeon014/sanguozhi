{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"gongsuntao-e-o233","title":"习凿齿论太祖封阎圃知赏罚之本","accounts":[{"id":"gongsuntao-a-7444c6098580f53c3e61","label":"裴注·习凿齿","text":"习凿齿论太祖封阎圃知赏罚之本","evidence":["gongsuntao-q-58a8019eefc4b9367800"]}],"participants":[{"person":"gongsuntao-p0004","role":"曰鲁欲称王而阎圃谏止之今封圃为列侯、塞其本源而末流自止、太祖之此封可谓知赏罚之本虽汤武居之无以加也","evidence":["gongsuntao-q-58a8019eefc4b9367800"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["gongsuntao-q-58a8019eefc4b9367800"]},"ordering_evidence":"gongsuntao-q-58a8019eefc4b9367800","source_order":[8,312,0],"order":2095},{"id":"liuliao-e-o077","title":"习凿齿论亮能用刑","accounts":[{"id":"liuliao-a-5b5d836877c03f68bc4d","label":"裴注·习凿齿","text":"习凿齿论亮能用刑","evidence":["liuliao-q-c0bf4cf6fcf4c63a673a"]}],"participants":[{"person":"gongsuntao-p0004","role":"论诸葛亮能用刑","evidence":["liuliao-q-c0bf4cf6fcf4c63a673a"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liuliao-q-c0bf4cf6fcf4c63a673a"]},"ordering_evidence":"liuliao-q-c0bf4cf6fcf4c63a673a","source_order":[40,236,0],"order":7295},{"id":"zhanggu-e-o122","title":"习凿齿论昭不臣","accounts":[{"id":"zhanggu-a-14c2b3838af7eb74738e","label":"裴注·习凿齿","text":"习凿齿论昭不臣","evidence":["zhanggu-q-9680d4016f3c0b32de1c"]}],"participants":[{"person":"gongsuntao-p0004","role":"评论张昭闭户拒命为不臣","evidence":["zhanggu-q-9680d4016f3c0b32de1c"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["zhanggu-q-9680d4016f3c0b32de1c"]},"ordering_evidence":"zhanggu-q-9680d4016f3c0b32de1c","source_order":[52,88,0],"order":9267}],"persons":[{"id":"gongsuntao-p0004","name":"习凿齿","evidence":["gongsuntao-q-58a8019eefc4b9367800","zhanggu-q-9680d4016f3c0b32de1c","liuliao-q-c0bf4cf6fcf4c63a673a"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[{"id":"gongsuntao-q-58a8019eefc4b9367800","section":"chapter-008","block":"b-c9c994588a40222c87ac","layer":"pei","quote":"习凿齿曰：“鲁欲称王，而阎圃谏止之，今封圃为列侯。夫赏罚者，所以惩恶劝善也；苟其可以明轨训于物，无远近幽深矣。今阎圃谏鲁勿王，而太祖追封之，将来之人，孰不思顺？塞其本源而末流自止，其此之谓与！若乃不明于此而重焦烂之功，丰爵厚赏止于死战之士；则民利于有乱，俗竞于杀伐，阻兵仗力，干戈不戢矣。太祖之此封，可谓知赏罚之本；虽汤武居之，无以加也","attribution":"裴注·习凿齿","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":311,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-806df2bc8ac18c089fbe","start":0,"end":168,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-c0bf4cf6fcf4c63a673a","section":"chapter-040","block":"b-eea8178a96ccf332824e","layer":"pei","quote":"﹝四﹞习凿齿曰：“昔管仲夺伯氏骈邑三百，没齿而无怨言，圣人以为难；诸葛亮之使廖立垂泣，李平致死：岂徒无怨言而已哉！夫水至平而邪者取法，镜至明而丑者（亡）〔忘〕怒；水镜之所以能穷物而无怨者，以其无私也。水镜无私，犹以免谤；况大人君子怀乐生之心，流矜恕之德；法行于不可不用，刑加乎自犯之罪；爵之而非私，诛之而不怒：天下有不服者乎？诸葛亮于是可谓能用刑矣。自秦、汉以来，未之有也！”","attribution":"裴注·习凿齿","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":235,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-663ac9785137c14de303","start":0,"end":188,"offset_unit":"unicode_code_point"},{"id":"zhanggu-q-9680d4016f3c0b32de1c","section":"chapter-052","block":"b-70b7a3fe08e8dc6b7073","layer":"pei","quote":"﹝一﹞习凿齿曰：“张昭于是乎不臣矣！夫臣人者，三谏不从，则奉身而退；身苟不绝，何忿怼之有？且秦穆违谏，卒霸西戎；晋文暂怒，终成大业。遗誓以悔过见录，狐偃无怨绝之辞；君臣道泰，上下俱荣。今权悔往之非而求昭，后益回虑降心；不远而复，是其善也。昭为人臣，不度权得道，匡其后失，夙夜匪懈，以延来誉；乃追忿不用，归罪于君，闭户拒命，坐待焚灭：岂不悖哉！”","attribution":"裴注·习凿齿","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":87,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-232cca93d73c0d3d09de","start":0,"end":172,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
