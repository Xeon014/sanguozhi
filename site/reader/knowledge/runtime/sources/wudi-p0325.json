c5b597fec15a38","text":"字阳士，汝南西平人。","evidence":["hechang-q-38f3615cca5f7976a964"]}],"aliases":[],"mentions":[{"id":"wudi-m-p115-wudi-p0325","kind":"mention","text":"文中提及","evidence":["wudi-q-p115"]},{"id":"mingdi-m-p030-wudi-p0325","kind":"mention","text":"文中提及","evidence":["mingdi-q-p030"]}]}],"evidence":[{"id":"cuimao-q-1ca58c8c7c2a520497a4","section":"chapter-012","block":"b-b98fdf30cfe006001885","layer":"original","quote":"魏国既建，为尚书，复典选举","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":189,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":13,"offset_unit":"unicode_code_point"},{"id":"cuimao-q-a9104d6ad32d7e7c2dc6","section":"chapter-012","block":"b-a2a5937f000469042d73","layer":"original","quote":"时桓阶、和洽进言救玠〖45〗，玠遂免黜","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":137,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"cuimao-q-b2a734b1eb1d9b8f59b5","section":"chapter-012","block":"b-744efc38dc3e2f2fb8f8","layer":"original","quote":"魏国初建，拜尚书","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":30,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":8,"offset_unit":"unicode_code_point"},{"id":"hechang-q-01180428459a7b6e28fa","section":"chapter-023","block":"b-e5a635b82535598d0810","layer":"original","quote":"文帝践阼，为光禄勋，封安城亭侯。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":56,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":16,"offset_unit":"unicode_code_point"},{"id":"hechang-q-05b617a2a7f040355a16","section":"chapter-023","block":"b-ae0542736d690d2c2121","layer":"original","quote":"魏国既建，为侍中，与王粲、和洽并用。粲强识博闻〖7〗，故太祖游观出入，多得骖乘〖8〗；至其见敬，不及洽、袭。袭尝独见，至于夜半。粲性躁竞，起坐曰：“不知公对杜袭道何等也〖9〗？”洽笑答曰：“天下事岂有尽邪！卿昼侍可矣，悒悒于此，欲兼之乎？”","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":202,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":120,"offset_unit":"unicode_code_point"},{"id":"hechang-q-13acacfe32efcf6a50f3","section":"chapter-023","block":"b-a16d9a00034553e2d442","layer":"original","quote":"太祖克张鲁，洽陈便宜以时拔军徙民〖32〗，可省置守之费〖33〗。太祖未纳，其后竟徙民弃汉中","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":18,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":45,"offset_unit":"unicode_code_point"},{"id":"hechang-q-18e27f796ba60293cc72","section":"chapter-023","block":"b-bd677b0085b1b1b03118","layer":"original","quote":"转为太常，清贫守约，至卖田宅以自给。明帝闻之，加赐谷帛。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":60,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":28,"offset_unit":"unicode_code_point"},{"id":"hechang-q-38f3615cca5f7976a964","section":"chapter-023","block":"b-988228066c03fae399f4","layer":"original","quote":"和洽字阳士，汝南西平人也〖1〗。举孝廉，大将军辟；皆不就。袁绍在冀州，遣使迎汝南士大夫〖2〗。洽独以“冀州土平民强，英杰所利，四战之地〖3〗；本初乘资，虽能强大，然雄豪方起：全未可必也。荆州刘表，无他远志，爱人乐士；土地险阻，山夷民弱〖4〗：易依倚也”。遂与亲旧俱南从表；表以上客待之。洽曰：“所以不从本初〖5〗，避争地也〖6〗。昏世之主，不可黩近〖7〗；久而阽危，﹝一﹞必有谗慝间其中者〖8〗。”遂南度武陵〖9〗。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":1,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":208,"offset_unit":"unicode_code_point"},{"id":"hechang-q-47a228c44b2ba9746217","section":"chapter-023","block":"b-4eae1aa6eaf8dd106a16","layer":"original","quote":"太祖曰：“所以不考，欲两全玠及言事者耳。”洽对曰：“玠信有谤主之言〖27〗，当肆之市朝〖28〗；若玠无此，言事者加诬大臣以误主听。二者不加检核，臣窃不安。”太祖曰：“方有军事，安可受人言便考之邪〖29〗？狐射姑刺阳处父于朝〖30〗，此为君之诫也〖31〗。”","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":17,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":128,"offset_unit":"unicode_code_point"},{"id":"hechang-q-4b58a048c0f680b571a0","section":"chapter-023","block":"b-a16d9a00034553e2d442","layer":"original","quote":"出为郎中令。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":18,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":50,"end":56,"offset_unit":"unicode_code_point"},{"id":"hechang-q-76c2beb4200d459bc412","section":"chapter-023","block":"b-9adc0752099f754a588f","layer":"original","quote":"明帝即位，进封西陵乡侯，邑二百户。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":57,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":17,"offset_unit":"unicode_code_point"},{"id":"hechang-q-77db8167ab87e71e7e3f","section":"chapter-023","block":"b-17b65cb0b114084098b9","layer":"original","quote":"太祖定荆州，辟为丞相掾、属。时毛玠、崔琰并以忠清干事，其选用先尚俭节〖1〗。洽言曰：“天下大器，在位与人，不可以一节（俭）〔检〕也。俭素过中〖2〗，自以处身则可；以此节格物〖3〗，所失或多。今朝廷之议，吏有著新衣、乘好车者，谓之不清〖4〗；长吏过营〖5〗，形容不饰，衣裘敝坏者，谓之廉洁。至令士大夫故污辱其衣〖6〗，藏其舆服；朝府大吏〖7〗，或自挈壶餐以入官寺〖8〗。夫立教观俗，贵处中庸〖9〗：为可继也〖10〗。今崇一概难堪之行以检殊途〖11〗，勉而为之，必有疲瘁。古之大教，务在通人情而已；凡激诡之行〖12〗，则容隐伪矣。”﹝一﹞。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":14,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":268,"offset_unit":"unicode_code_point"},{"id":"hechang-q-81fa9072fcf3c98f822e","section":"chapter-023","block":"b-17b65cb0b114084098b9","layer":"original","quote":"太祖定荆州，辟为丞相掾、属。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":14,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":14,"offset_unit":"unicode_code_point"},{"id":"hechang-q-94297421971c340436b8","section":"chapter-023","block":"b-d0a6f9af702e2493d611","layer":"original","quote":"洽以为：“民稀耕少，浮食者多〖5〗。国以民为本，民以谷为命；故废一时之农，则失育命之本。是以先王务蠲烦费〖6〗，以专耕农。自春夏以来，民穷于役，农业有废，百姓嚣然〖7〗。时风不至，未必不由此也。消复之术，莫大于节俭。太祖建立洪业，奉师徒之费，供军赏之用；吏士丰于资食，仓府衍于谷帛；由不饰无用之宫〖8〗，绝浮华之费。方今之要，固在息省劳烦之役，损除他余之务〖9〗，以为军戎之储。三边守御〖10〗，宜在备豫。料贼虚实，蓄士养众；算庙胜之策〖11〗，明攻取之谋。详询众庶，以求厥中〖12〗。若谋不素定〖13〗，轻弱小敌〖14〗；军人数举，举而无庸〖15〗：所谓‘悦武无震〖16〗’，古人之诫也。”","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":59,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":296,"offset_unit":"unicode_code_point"},{"id":"hechang-q-9924dc6be70f77dc9031","section":"chapter-023","block":"b-988228066c03fae399f4","layer":"original","quote":"举孝廉，大将军辟；皆不就。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":1,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":16,"end":29,"offset_unit":"unicode_code_point"},{"id":"hechang-q-a6153efd00a429c80c1b","section":"chapter-023","block":"b-09ea6e777225a545c40c","layer":"original","quote":"洽对曰：“如言事者言，玠罪过深重，非天地所覆载；臣非敢曲理玠以枉大伦也〖19〗。以玠出群吏之中，特见拔擢，显在首职〖20〗；历年荷宠〖21〗，刚直忠公，为众所惮：不宜有此。然人情难保，要宜考核〖22〗，两验其实〖23〗。今圣恩垂含垢之仁〖24〗，不忍致之于理〖25〗；更使曲直之分不明，疑自近始〖26〗。”","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":16,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":153,"offset_unit":"unicode_code_point"},{"id":"hechang-q-b89895ab8d202881e7d3","section":"chapter-023","block":"b-bd677b0085b1b1b03118","layer":"original","quote":"薨，谥曰简侯。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":60,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":28,"end":35,"offset_unit":"unicode_code_point"},{"id":"hechang-q-d3a8dcb6753162068024","section":"chapter-023","block":"b-8859a6b609f47052c4b1","layer":"pei","quote":"﹝一﹞孙盛曰：“昔先王御世，观民设教；虽质文因时，损益代用，至于车服礼秩，贵贱等差，其归一揆。魏承汉乱，风俗侈泰；诚宜仰思古制，训以约简；使奢不陵肆，俭足中礼；进无蜉蝣之刺，退免采莫之讥。如此，则治道隆而颂声作矣。夫矫枉过正则巧伪滋生，以克训下则民志险隘；非圣王所以陶化民物，闲邪存诚之道。和洽之言，于是允矣。”","attribution":"裴注·孙盛评论","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":55,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c125063ebfed9af3d9ee","start":0,"end":156,"offset_unit":"unicode_code_point"},{"id":"hechang-q-e4447a1ff910a5fccf74","section":"chapter-023","block":"b-988228066c03fae399f4","layer":"original","quote":"洽独以“冀州土平民强，英杰所利，四战之地〖3〗；本初乘资，虽能强大，然雄豪方起：全未可必也。荆州刘表，无他远志，爱人乐士；土地险阻，山夷民弱〖4〗：易依倚也”。遂与亲旧俱南从表；表以上客待之。洽曰：“所以不从本初〖5〗，避争地也〖6〗。昏世之主，不可黩近〖7〗；久而阽危，﹝一﹞必有谗慝间其中者〖8〗。”遂南度武陵","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":1,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":47,"end":204,"offset_unit":"unicode_code_point"},{"id":"hechang-q-e718a6e06d9ecd9aab9e","section":"chapter-023","block":"b-348784738957769cd51f","layer":"original","quote":"魏国既建，为侍中。后有白毛玠谤毁太祖；太祖见近臣，怒甚。洽陈玠素行有本，求案实其事〖13〗。罢朝，太祖令曰；“今言事者白玠不但谤吾也，乃复为崔琰觖望〖14〗。此损君臣恩义，妄为死友怨叹〖15〗，殆不可忍也。昔萧、曹与高祖并起微贱〖16〗，致功立勋。高祖每在屈笮〖17〗，二相恭顺，臣道益彰，所以祚及后世也。和侍中比求实之，所以不听，欲重参之耳〖18〗。”","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":15,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":177,"offset_unit":"unicode_code_point"},{"id":"mingdi-e-p030a-q","section":"chapter-003","block":"b-fc3b2373ccedc94baa04","layer":"pei","quote":"“帝变服，率群臣哭之。使使持节、行司徒、太常和洽吊祭，又使持节、行大司空、大司农崔林监护丧事。诏曰：‘盖五帝之事尚矣！仲尼盛称尧、舜巍巍荡荡之功者，以为禅代乃大圣之懿事也。山阳公深识天禄永终之运，禅位文皇帝以顺天命。先帝命公行汉正朔，郊天祀祖以天子之礼，言事不称“臣”，此舜事尧之义也。昔放勋殂落，四海如丧考妣，遏密八音；明丧葬之礼，同于王者也。今有司奏丧礼比诸侯王，此岂古之遗制而先帝之至意哉？今谥公“汉孝献皇帝”。’","attribution":"裴注·献帝传","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":263,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-577bfabc3a4642d33616","start":0,"end":210,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-b-7a11c761ca65aeb3d195","section":"chapter-003","block":"b-7a11c761ca65aeb3d195","layer":"modern","quote":"〖1〗二年：青龙二年（公元 234）。己未：旧历初四日。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":252,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6c0753fe684a18a3a281","start":0,"end":28,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-o037","section":"chapter-003","block":"b-ff97c2d326d0fc08a9de","layer":"original","quote":"二年春二月，（乙）〔己〕未〖1〗，太白犯荧惑。癸酉〖2〗，诏曰：“‘鞭作官刑〖3〗’，所以纠慢怠也〖4〗；而顷多以无辜死。其减鞭杖之制〖5〗，著于令。”三月，庚寅〖6〗，山阳公薨；帝素服发哀〖7〗，遣使持节，典护丧事。己酉〖8〗，大赦。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":249,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":118,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-p030","section":"chapter-003","block":"b-fc3b2373ccedc94baa04","layer":"pei","quote":"“帝变服，率群臣哭之。使使持节、行司徒、太常和洽吊祭，又使持节、行大司空、大司农崔林监护丧事。诏曰：‘盖五帝之事尚矣！仲尼盛称尧、舜巍巍荡荡之功者，以为禅代乃大圣之懿事也。山阳公深识天禄永终之运，禅位文皇帝以顺天命。先帝命公行汉正朔，郊天祀祖以天子之礼，言事不称“臣”，此舜事尧之义也。昔放勋殂落，四海如丧考妣，遏密八音；明丧葬之礼，同于王者也。今有司奏丧礼比诸侯王，此岂古之遗制而先帝之至意哉？今谥公“汉孝献皇帝”。’","attribution":"裴注·献帝传","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":263,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-577bfabc3a4642d33616","start":0,"end":210,"offset_unit":"unicode_code_point"},{"id":"wudi-e-p115a-q","section":"chapter-001","block":"b-d31f474fc7e57ab9555e","layer":"pei","quote":"﹝二﹞《魏氏春秋》曰：“以荀攸为尚书令；凉茂为仆射；毛玠、崔琰、常林、徐奕、何夔为尚书；王粲、杜袭、卫觊、和洽为侍中。”","attribution":"《魏氏春秋》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":279,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-efecfa99851d5aa2b4e2","start":0,"end":60,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-b9d79988a2b2559f2bb5","section":"chapter-001","block":"b-b9d79988a2b2559f2bb5","layer":"modern","quote":"〖11〗十八年：建安十八年（公元 213）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":137,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-bec99dfe67d67ae54b06","start":0,"end":22,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o139","section":"chapter-001","block":"b-d44820525c4645832365","layer":"original","quote":"十八年春正月〖11〗，进军濡须口〖12〗；攻破权江西营，获权都督公孙阳〖13〗，乃引军还。诏书并十四州〖14〗，复为九州〖15〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":107,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":65,"offset_unit":"unicode_code_point"},{"id":"wudi-q-p115","section":"chapter-001","block":"b-d31f474fc7e57ab9555e","layer":"pei","quote":"﹝二﹞《魏氏春秋》曰：“以荀攸为尚书令；凉茂为仆射；毛玠、崔琰、常林、徐奕、何夔为尚书；王粲、杜袭、卫觊、和洽为侍中。”","attribution":"《魏氏春秋》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":279,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-efecfa99851d5aa2b4e2","start":0,"end":60,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
