hor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":12,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-b-ded6d700dc6f860d1670","section":"chapter-004","block":"b-ded6d700dc6f860d1670","layer":"modern","quote":"〖1〗四年：景元四年（公元 263）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":201,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ef642248e44d01f3825d","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o165","section":"chapter-004","block":"b-b35fdf03685051716720","layer":"original","quote":"四年春二月〖1〗，复命大将军进位、爵赐，一如前诏。又固辞，乃止。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":194,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":32,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o171","section":"chapter-004","block":"b-cef469d41ec5962b4e48","layer":"original","quote":"咸熙元年春正月，壬戌〖1〗，槛车征邓艾〖2〗。甲子〖3〗，行幸长安。壬申〖4〗，使使者以璧币祀华山〖5〗。是月，钟会反于蜀，为众所讨。邓艾亦见杀。二月，辛卯〖6〗，特赦诸在益土者。庚申〖7〗，葬明元郭后。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":220,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":102,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o179","section":"chapter-004","block":"b-82a7a4db771c72864e3d","layer":"original","quote":"辛未〖18〗，诏曰：“吴贼政刑暴虐，赋敛无极。孙休遣使邓句〖19〗，敕交阯太守锁送其民〖20〗，发以为兵。吴将吕兴，因民心愤怒，又承王师平定巴蜀；即纠合豪杰，诛除句等，驱逐太守长吏〖21〗；抚和吏民，以待国命〖22〗。九真、日南郡闻兴去逆即顺〖23〗，亦齐心响应，与兴协同。兴移书日南州郡〖24〗，开示大计〖25〗；兵临合浦〖26〗，告以祸福；遣都尉唐谱等诣进乘县〖27〗，因南中都督护军霍弋〖28〗，上表自陈。又交阯将吏各上表，言：‘兴创造事业〖29〗，大小承命〖30〗。郡有山寇，入连诸郡。惧其计异〖31〗，各有携贰。权时之宜，以兴为督交阯诸军事、上大将军、定安县侯〖32〗。乞赐褒奖，以慰边荒。’乃心款诚，形于辞旨〖33〗。昔仪父朝鲁〖34〗，《春秋》所美；窦融归汉〖35〗，待以殊礼。今国威远震，抚怀六合；方包举殊裔〖36〗，混一四表〖37〗。兴，首向王化，举众稽服；万里驰义〖38〗，请吏率职。宜加宠遇，崇其爵位；既使