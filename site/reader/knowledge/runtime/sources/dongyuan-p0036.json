{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o107a","title":"曹操破壶关，高幹败走被斩","accounts":[{"id":"wudi-e-o107a-account","label":"正文","text":"曹操亲征高幹，高幹赴匈奴求救未果。曹操围壶关三月拔城，高幹走荆州，被上洛都尉王琰捕斩。","evidence":["wudi-e-o107a-q"]},{"id":"dongyuan-e-o066b-account","label":"《董二袁刘传第六》正文","text":"曹操征高幹幹留夏昭邓升守关求匈奴援不得奔荆被斩","evidence":["dongyuan-e-o066b-q"]}],"participants":[{"person":"cao-cao","role":"围城","evidence":["wudi-e-o107a-q"]},{"person":"wudi-p0235","role":"求救败亡","evidence":["wudi-e-o107a-q"]},{"person":"wudi-p0238","role":"捕斩","evidence":["wudi-e-o107a-q"]},{"person":"dongyuan-p0035","role":"留守","evidence":["dongyuan-e-o066b-q"]},{"person":"dongyuan-p0036","role":"留守","evidence":["dongyuan-e-o066b-q"]}],"place":{"text":"壶关、荆州、上洛","evidence":["wudi-e-o107a-q"]},"time":{"label":"建安十一年春正月起","year":206,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o107a-q","wudi-q-o107","wudi-q-b-6509a80488ce395ecab9"],"chronology":"wudi-y206","dating_review":{"anchor":"wudi-q-o107","basis":"建安十一年春正月起","reviewed":true}},"source_order":[1,599,"O107a"],"related_events":[{"event":"rensu-e2-wei016-058","type":"related","evidence":["rensu-q-d016417cfa66f80fdc59","wudi-e-o107a-q"]}],"order":242}],"persons":[{"id":"dongyuan-p0036","name":"邓升","evidence":["dongyuan-q-o066"],"facts":[],"aliases":[],"mentions":[{"id":"dongyuan-m-o066-dongyuan-p0036","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o066"]}]}],"evidence":[{"id":"dongyuan-e-o066b-q","section":"chapter-006","block":"b-c04aa2e6c942c6cf2a0e","layer":"original","quote":"十一年，太祖征幹。幹乃留其将夏昭、邓升守城，自诣匈奴单于求救，不得。独与数骑亡，欲南奔荆州，上洛都尉捕斩之。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":373,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":29,"end":83,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o066","section":"chapter-006","block":"b-c04aa2e6c942c6cf2a0e","layer":"original","quote":"高幹叛，执上党太守，举兵守壶口关。遣乐进、李典击之，未拔。十一年，太祖征幹。幹乃留其将夏昭、邓升守城，自诣匈奴单于求救，不得。独与数骑亡，欲南奔荆州，上洛都尉捕斩之。﹝一﹞","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":373,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":86,"offset_unit":"unicode_code_point"},{"id":"rensu-q-d016417cfa66f80fdc59","section":"chapter-016","block":"b-14e81f2c7c0e488327c7","layer":"original","quote":"高幹入濩泽","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":87,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":11,"end":16,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o107a-q","section":"chapter-001","block":"b-25deb42237a5de280ce3","layer":"original","quote":"十一年春正月〖1〗，公征幹。幹闻之，乃留其别将守城，走入匈奴，求救于单于〖2〗。单于不受。公围壶关三月，拔之。幹遂走荆州〖3〗，上洛都尉王琰捕斩之。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":598,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":74,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-6509a80488ce395ecab9","section":"chapter-001","block":"b-6509a80488ce395ecab9","layer":"modern","quote":"〖1〗十一年：建安十一年（公元 206）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":603,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-60fd0962dbcc47eb5807","start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o107","section":"chapter-001","block":"b-25deb42237a5de280ce3","layer":"original","quote":"十一年春正月〖1〗，公征幹。幹闻之，乃留其别将守城，走入匈奴，求救于单于〖2〗。单于不受。公围壶关三月，拔之。幹遂走荆州〖3〗，上洛都尉王琰捕斩之。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":598,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c