,"participants":[{"person":"santizhu-p0035","role":"向孙休报告孙綝怨言","evidence":["santizhu064-q-943cbd7406a6ef5bb305"]},{"person":"shaodi-p0150","role":"听报后加赏孙綝及孙恩，并与孙綝分省文书","evidence":["santizhu064-q-943cbd7406a6ef5bb305"]},{"person":"houzhu-p0013","role":"与孙休分省文书","evidence":["santizhu064-q-943cbd7406a6ef5bb305"]},{"person":"santizhu-p0027","role":"被加侍中","evidence":["santizhu064-q-943cbd7406a6ef5bb305"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"未由相邻段落推算纪年；原文时间表达保留在来源引句中。","evidence":["santizhu064-q-943cbd7406a6ef5bb305"]},"ordering_evidence":"santizhu064-q-943cbd7406a6ef5bb305","source_order":[64,103,0],"order":11039}],"persons":[{"id":"santizhu-p0027","name":"孙恩","evidence":["santizhu-q-ff0d1a1a678defca6a64","santizhu-q-5ba03f9459c02fa94f61","santizhu-q-480724fe20f27df77482","santizhu-q-5ae60a02b3158490414f","santizhu-q-b61a33765ab50473b114","santizhu064-q-efee3ca1833ae60db26c","santizhu064-q-6faa3e4111191e498013","santizhu064-q-943cbd7406a6ef5bb305","santizhu064-q-904d090576b86d0524e6"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[{"id":"santizhu-q-384f38c51f9baf765151","section":"chapter-048","block":"b-fce5536b05cb3d0ea98d","layer":"original","quote":"綝以兵取尚","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":121,"anchor":null},"note_id":null,"start":29,"end":34},{"id":"santizhu-q-480724fe20f27df77482","section":"chapter-048","block":"b-d9fd2206a0f69fe47d60","layer":"original","quote":"使孙楷先见恩","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":131,"anchor":null},"note_id":null,"start":16,"end":22},{"id":"santizhu-q-5ae60a02b3158490414f","section":"chapter-048","block":"b-fb14779f09fa774f9ff4","layer":"original","quote":"永安元年冬十月，壬午〖1〗，诏曰：“夫褒德赏功，古今通义：其以大将军綝为丞相，荆州牧，增食五县；武卫将军恩为御史大夫，卫将军，中军督〖2〗，封县侯；威远将军（授）〔据〕为右将军，县侯〖3〗；偏将军幹杂号将军，亭侯；长水校尉张布辅导勤劳〖4〗，以布为辅义将军〖5〗，封永康侯；董朝亲迎，封为乡侯","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":149,"anchor":null},"note_id":null,"start":0,"end":146},{"id":"santizhu-q-5ba03f9459c02fa94f61","section":"chapter-048","block":"b-a59d4aeea3c916858304","layer":"original","quote":"武卫将军恩，行丞相事〖7〗，率百僚以乘舆法驾迎于永昌亭〖8〗","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":130,"anchor":null},"note_id":null,"start":59,"end":89},{"id":"santizhu-q-b61a33765ab50473b114","section":"chapter-048","block":"b-178650c026f51015888b","layer":"original","quote":"戊戌〖16〗，诏曰：“大将军掌中外诸军事，事统烦多；其加卫将军、御史大夫恩侍中，与大将军分省诸事","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":153,"anchor":null},"note_id":null,"start":0,"end":48},{"id":"santizhu-q-ff0d1a1a678defca6a64","section":"chapter-048","block":"b-fce5536b05cb3d0ea98d","layer":"original","quote":"遣弟恩攻杀丞于苍龙门外〖4〗","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":121,"anchor":null},"note_id":null,"start":35,"end":49},{"id":"santizhu064-q-6faa3e4111191e498013","section":"chapter-064","block":"b-4374336f1e304409b23e","layer":"original","quote":"而遣弟恩救。会诞败，引还","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":441,"anchor":null},"note_id":null,"start":23,"end":35},{"id":"santizhu064-q-75fa122396157be5217b","section":"chapter-064","block":"b-e9625f9b47fb4c167a95","layer":"original","quote":"綝以孙亮始亲政事，多所难问，甚惧。还建业，称疾不朝。筑室于朱雀桥南〖1〗，使弟威远将军据，入苍龙宿卫〖2〗；弟武卫将军恩、偏将军幹、长水校尉闿，分屯诸营：欲以专朝自固。","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":454,"anchor":null},"note_id":null,"start":0,"end":84},{"id":"santizhu064-q-7f20cc569ae15f362b09","section":"chapter-064","block":"b-5a68ad209c9913a5a2f5","layer":"pei","quote":"纪承诏，以告尚；尚无远虑，以语纪母。母使人密语綝。綝夜发严兵废亮，比明，兵已围宫","attribution":"裴注·江表传","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":477,"anchor":null},"note_id":"n-3c25a1ac71ab7fb35794","start":230,"end":270},{"id":"santizhu064-q-8cc8349758b19c0e3cd6","section":"chapter-064","block":"b-1ed48f2a0752e4fd8d7e","layer":"original","quote":"幹，杂号将军〖19〗，亭侯。闿，亦封亭侯。”","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":483,"anchor":null},"note_id":null,"start":157,"end":179},{"id":"santizhu064-q-904d090576b86d0524e6","section":"chapter-064","block":"b-1ed48f2a0752e4fd8d7e","layer":"original","quote":"休引见慰喻。又下诏曰：“朕以不德〖14〗，守藩于外。值兹际会，群公卿士，暨于朕躬，以奉宗庙。朕用怃然〖15〗，若涉渊冰〖16〗。大将军忠计内发，扶危定倾；安康社稷，功勋赫然。昔汉孝宣践阼〖17〗，霍光尊显；褒德赏功，古今之通义也。其以大将军为丞相，荆州牧，食五县〖18〗。恩为御史大夫，卫将军；据，右将军：皆县侯。幹，杂号将军〖19〗，亭侯。闿，亦封亭侯","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":483,"anchor":null},"note_id":null,"start":0,"end":177},{"id":"santizhu064-q-943cbd7406a6ef5bb305","section":"chapter-064","block":"b-4eb6fbc822bcae14383a","layer":"original","quote":"布以言闻休，休衔之〖21〗；恐其有变，数加赏赐。又复加恩侍中〖22〗，与綝分省文书","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":486,"anchor":null},"note_id":null,"start":0,"end":41},{"id":"santizhu064-q-efee3ca1833ae60db26c","section":"chapter-064","block":"b-95b6f4e559a9caf04f8a","layer":"original","quote":"綝率众夜袭全尚，遣弟恩杀刘（承）〔丞〕于苍龙门外，遂围宫","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":455,"anchor":null},"note_id":null,"start":109,"end":137}],"profiles":{},"directory_counts":{}}
