hu064-q-6faa3e4111191e498013"]}],"participants":[{"person":"houzhu-p0013","role":"遣孙恩救援诸葛诞","evidence":["santizhu064-q-6faa3e4111191e498013"]},{"person":"santizhu-p0027","role":"奉命救援诸葛诞，后引还","evidence":["santizhu064-q-6faa3e4111191e498013"]},{"person":"shaodi-p0044","role":"败后孙恩引军还","evidence":["santizhu064-q-6faa3e4111191e498013"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"未由相邻段落推算纪年；原文时间表达保留在来源引句中。","evidence":["santizhu064-q-6faa3e4111191e498013"]},"ordering_evidence":"santizhu064-q-6faa3e4111191e498013","source_order":[64,91,23],"order":11020},{"id":"santizhu064-e-sr-chen-fortification","title":"綝惧亮亲政、称疾不朝、筑室朱雀桥南、诸弟分屯自固","accounts":[{"id":"santizhu064-a-efe4a500e6b93a9a82f8","label":"正文","text":"綝以亮始亲政多所难问甚惧，还建业称疾不朝；筑室朱雀桥南，使弟据入苍龙宿卫，弟恩、幹、闿分屯诸营，欲以专朝自固","evidence":["santizhu064-q-75fa122396157be5217b"]}],"participants":[{"person":"houzhu-p0013","role":"称疾不朝、筑室布防欲专朝自固","evidence":["santizhu064-q-75fa122396157be5217b"]},{"person":"santizhu-p0034","role":"入苍龙宿卫（威远将军）","evidence":["santizhu064-q-75fa122396157be5217b"]},{"person":"santizhu-p0027","role":"分屯诸营（武卫将军）","evidence":["santizhu064-q-75fa122396157be5217b"]},{"person":"santizhu-p0033","role":"分屯诸营（偏将军）","evidence":["santizhu064-q-75fa122396157be5217b"]},{"person":"santizhu-p0166","role":"分屯诸营（长水校尉）","evidence":["santizhu064-q-75fa122396157be5217b"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"未由相邻段落推算纪年；原文时间表达保留在来源引句中。","evidence":["santizhu064-q-75fa122396157be5217b"]},"ordering_evidence":"santizhu064-q-75fa122396157be5217b","source_order":[64,455,0],"order":11021},{"id":"santizhu064-e-o094b","title":"孙綝夜袭全尚、遣弟杀刘丞并围宫","accounts":[{"id":"santizhu064-a-d31274945e9253d6901b","label":"正文","text":"孙綝夜袭全尚、遣弟杀刘丞并围宫","evidence":["santizhu064-q-efee3ca1833ae60db26c"]}],"participants":[{"person":"houzhu-p0013","role":"率众夜袭全尚、遣弟杀刘丞并围宫","evidence":["santizhu064-q-efee3ca1833ae60db26c"]},{"person":"santizhu-p0027","role":"受命在苍龙门外杀刘丞","evidence":["santizhu