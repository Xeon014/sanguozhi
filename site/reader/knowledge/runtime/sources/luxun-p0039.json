ce":["luxun-q-p012"]},{"id":"luxun-m-o050-luxun-p0039","kind":"mention","text":"文中提及","evidence":["luxun-q-o050"]}]}],"evidence":[{"id":"luxun-e-o049a-q","section":"chapter-058","block":"b-f473fbd1691d7907a00b","layer":"original","quote":"时谢渊、谢厷等各陈便宜，欲兴利改作。﹝一﹞以事下逊。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":230,"anchor":null},"note_id":null,"start":0,"end":26},{"id":"luxun-e-p012a-q","section":"chapter-058","block":"b-b7e7f86fd5e01c0c79fc","layer":"pei","quote":"谢渊字休德。少修德操，躬秉耒耜；既无戚容，又不易虑：由是知名。举孝廉，稍迁至建武将军。","attribution":"《会稽典录》","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":243,"anchor":null},"note_id":"n-4bb4ccb93c53bcb6a59d","start":12,"end":55},{"id":"luxun-e-p012b-q","section":"chapter-058","block":"b-b7e7f86fd5e01c0c79fc","layer":"pei","quote":"虽在戎旅，犹垂意人物。骆统子，名秀，被门庭之谤；众论狐疑，莫能证明。渊闻之叹息曰：‘公绪早夭，同盟所哀。闻其子志行明辩，而被暗昧之谤；望诸夫子烈然高断，而各怀迟疑，非所望也。’秀卒见明，无复瑕玷，终为显士；渊之力也。","attribution":"《会稽典录》","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":243,"anchor":null},"note_id":"n-4bb4ccb93c53bcb6a59d","start":55,"end":163},{"id":"luxun-f0008-q","section":"chapter-058","block":"b-b7e7f86fd5e01c0c79fc","layer":"pei","quote":"谢渊字休德","attribution":"《会稽典录》","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":243,"anchor":null},"note_id":"n-4bb4ccb93c53bcb6a59d","start":12,"end":17},{"id":"luxun-q-o049","section":"chapter-058","block":"b-f473fbd1691d7907a00b","layer":"original","quote":"时谢渊、谢厷等各陈便宜，欲兴利改作。﹝一﹞以事下逊。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":230,"anchor":null},"note_id":null,"start":0,"end":26},{"id":"luxun-q-o050","section":"chapter-058","block":"b-5398f8cec39e33c08ff0","layer":"original","quote":"逊议曰：“国以民为本：强由民力，财由民出。夫民殷国弱〖7〗，民瘠国强者，未之有也。故为国者，得民则治，失之则乱；若不受利，而令尽用立效〖8〗，亦为难也。是以《诗》叹‘宜民宜人〖9〗，受禄于天’。乞垂圣恩，宁济百姓。数年之间，国用少丰，然后更图。”","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":231,"anchor":null},"note_id":null,"start":0,"end":123},{"id":"luxun-q-p012","section":"chapter-058","block":"b-b7e7f86fd5e01c0c79fc","layer":"pei","quote":"﹝一﹞《会稽典录》曰：“谢渊字休德。少修德操，躬秉耒耜；既无戚容，又不易虑：由是知名。举孝廉，稍迁至建武将军。虽在戎旅，犹垂意人物。骆统子，名秀，被门庭之谤；众论狐疑，莫能证明。渊闻之叹息曰：‘公绪早夭，同盟所哀。闻其子志行明辩，而被暗昧之谤；望诸夫子烈然高断，而各怀迟疑，非所望也。’秀卒见明，无复瑕玷，终为显士；渊之力也。”","attribution":"《会稽典录》","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":243,"anchor":null},"note_id":"n-4bb4ccb93c53bcb6a59d","start":0,"end":164}],"profiles":{},"directory_counts":{}}
