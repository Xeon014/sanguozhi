{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[],"persons":[{"id":"yuanzhang-p2-yuanpang","name":"袁滂（袁涣父）","evidence":["yuanzhang-q2-f0d68bbc091908824aca"],"facts":[{"id":"yuanzhang-f2-1cf8bf2067ca9458049c","text":"袁滂为袁涣之父，任汉司徒。","evidence":["yuanzhang-q2-f0d68bbc091908824aca"]}],"aliases":[],"mentions":[]}],"evidence":[{"id":"yuanzhang-q2-f0d68bbc091908824aca","section":"chapter-011","block":"b-672fb0d4d54d6094f3c2","layer":"original","quote":"袁涣字曜卿，陈郡扶乐人也〖1〗。父滂，为汉司徒。﹝一﹞当时，诸公子多越法度；而涣清静，举动必以礼。郡命为功曹，郡中奸吏皆自引去〖2〗。后辟公府。举高第，迁侍御史。除谯令，不就。刘备之为豫州，举涣茂才。","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":1,"anchor":null},"note_id":null,"start":0,"end":100}],"profiles":{},"directory_counts":{}}
