893","chenghuang-q-e60f2742050b33357e8b","chenghuang-q-c85552986488749ec4d1","chenghuang-q-f367c03eb4fb3baf3c58","yaoci-q-7fb87c25d579494e1335","zongshi-q-11c86715125785962926","feipin-q-3f3a88590536b01cef40","shiyi-q-f32cc495fa8e785267ed","wufan-q-e297cdefd9d420d39248"],"facts":[],"aliases":[],"mentions":[{"id":"zhouyu-m-o040-zhouyu-p0033","kind":"mention","text":"文中提及","evidence":["zhouyu-q-o040"]},{"id":"zhouyu-m-o069-zhouyu-p0033","kind":"mention","text":"文中提及","evidence":["zhouyu-q-o069"]},{"id":"zhouyu-m-o008-zhouyu-p0033","kind":"mention","text":"文中提及","evidence":["zhouyu-q-o008"]},{"id":"xunyu-m-p011-zhouyu-p0033","kind":"mention","text":"文中提及","evidence":["xunyu-q-p011"]},{"id":"zhuge-m-o008-zhouyu-p0033","kind":"mention","text":"文中提及","evidence":["zhuge-q-o008"]},{"id":"sunshi-m-o021-zhouyu-p0033","kind":"mention","text":"文中提及","evidence":["sunshi-q-o021"]},{"id":"sunshi-m-p027-zhouyu-p0033","kind":"mention","text":"文中提及","evidence":["sunshi-q-p027"]},{"id":"sunshi-m-p034-zhouyu-p0033","kind":"allusion","text":"祖系或典故提及","evidence":["sunshi-q-p034"]},{"id":"sunshi-m-p046-zhouyu-p0033","kind":"mention","text":"文中提及","evidence":["sunshi-q-p046"]},{"id":"sunshi-m-p047-zhouyu-p0033","kind":"mention","text":"文中提及","evidence":["sunshi-q-p047"]},{"id":"sunshi-m-p056-zhouyu-p0033","kind":"allusion","text":"祖系或典故提及","evidence":["sunshi-q-p056"]},{"id":"sunshi-m-p057-zhouyu-p0033","kind":"allusion","text":"祖系或典故提及","evidence":["sunshi-q-p057"]},{"id":"wuzhu-m-o003-zhouyu-p0033","kind":"mention","text":"文中提及","evidence":["wuzhu-q-o003"]},{"id":"wuzhu-m-o008-zhouyu-p0033","kind":"mention","text":"文中提及","evidence":["wuzhu-q-o008"]},{"id":"wuzhu-m-o011-zhouyu-p0033","kind":"mention","text":"文中提及","evidence":["wuzhu-q-o011"]},{"id":"wuzhu-m-o012-zhouyu-p0033","kind":"mention","text":"文中提及","evidence":["wuzhu-q-o012"]},{"id":"chenghuang-m-44f898c161cf9a47757b","kind":"mention","text":"本段涉及黄祖","evidence":["chenghuang-q-c4317b4e1388ff3d1fea"]},{"id":"yaoci-m2-1ebe51c78abb4dbc7df0","kind":"mention","text":"文中提及","evidence":["yaoci-q-7fb87c25d579494e1335"]}]}],"evidence":[{"id":"chenghuang-q-5561b24ab3f1f8f64c96","section":"chapter-055","block":"b-471444036ab013326a61","layer":"original","quote":"建安十三年，权讨黄祖。祖横两蒙冲，挟守沔口；以栟闾大绁系石为碇〖7〗。上有千人，以弩交射，飞矢雨下，军不得前。袭与凌统俱为前部，各将敢死百人；人被两铠〖8〗，乘大舸船，突入蒙冲里〖9〗。袭身以刀断两绁，蒙冲乃横流。大兵遂进，祖便开门走，兵追斩之。明日大会，权举觞属袭曰〖10〗：“今日之会，断绁之功也","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":177,"anchor":null},"note_id":null,"start":0,"end":150},{"id":"chenghuang-q-5e912039169623726e29","section":"chapter-055","block":"b-5ecb4d52b1b6c18777c8","layer":"original","quote":"后拜荡寇中郎将〖6〗，领零陵太守。从讨刘勋于寻阳，进攻黄祖于沙羡，还镇石城","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":2,"anchor":null},"note_id":null,"start":164,"end":201},{"id":"chenghuang-q-660ab67432747d550b50","section":"chapter-055","block":"b-63a2b1115b7f25b863e6","layer":"original","quote":"迁破贼校尉〖4〗。及权统军，从讨江夏。入夏口，先登，破其前锋；轻舟独进，中流矢死","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":266,"anchor":null},"note_id":null,"start":62,"end":102},{"id":"chenghuang-q-69cc3d3ecb9e361bf893","section":"chapter-055","block":"b-7d27b253676ec2fc3561","layer":"original","quote":"孙权统事，以为别部司马；授兵五百人，守柴桑长：拒黄祖","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":306,"anchor":null},"note_id":null,"start":0,"end":26},{"id":"chenghuang-q-70ce0e3e23d54b26890c","section":"chapter-055","block":"b-8e066aabb4ba83e6e2cc","layer":"original","quote":"乃往依刘表，因居南阳：不见进用。后转托黄祖，祖又以凡人蓄之。﹝三﹞于是归吴","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":195,"anchor":null},"note_id":null,"start":155,"end":192},{"id":"chenghuang-q-a1970ba8acfd65577e93","section":"chapter-055","block":"b-ac3d85213e7994859abe","layer":"original","quote":"从征刘勋，破黄祖；还讨鄱阳，领乐安长，山越畏服","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":54,"anchor":null},"note_id":null,"start":30,"end":53},{"id":"chenghuang-q-ab1aac94ae904376b3bb","section":"chapter-055","block":"b-00c23367d4941f433595","layer":"original","quote":"权遂西，果擒祖，尽获其士众。遂授宁兵，屯当口","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":211,"anchor":null},"note_id":null,"start":0,"end":22},{"id":"chenghuang-q-c4317b4e1388ff3d1fea","section":"chapter-055","block":"b-f5b4e08a1f8d9bf1f79d","layer":"original","quote":"周瑜、吕蒙皆共荐达，孙权加异〖1〗，同于旧臣。宁陈计曰：“今汉祚日微，曹操弥骄〖2〗，终为篡盗。南荆之地，山陵形便，江川流通：诚是国之西势也。宁已观刘表，虑既不远；儿子又劣，非能承业传基者也。至尊当早规之，不可后操。图之之计，宜先取黄祖。祖今年老，昏耄已甚，财谷并乏；左右欺弄，务于货利，侵求吏士，吏士心怨；舟船战具，顿废不修；怠于耕农，军无法伍〖3〗。至尊今往，其破可必〖4〗！一破祖军，鼓行而西；西据楚关〖5〗，大势弥广，即可渐规巴蜀。”权深纳之","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":208,"anchor":null},"note_id":null,"start":0,"end":225},{"id":"chenghuang-q-c85552986488749ec4d1","section":"chapter-055","block":"b-49b0f5118da5406c8c09","layer":"pei","quote":"权讨祖，祖军败奔走；追兵急，宁以善射，将兵在后，射杀校尉凌操。祖既得免，军罢还营，待宁如初","attribution":"裴注·吴书","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":207,"anchor":null},"note_id":"n-4cdec240085a4d591c10","start":91,"end":136},{"id":"chenghuang-q-da98e2c12e8dd82f8cfd","section":"chapter-055","block":"b-2b92a0aa789685989e6a","layer":"original","quote":"从讨黄祖有功","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":105,"anchor":null},"note_id":null,"start":35,"end":41},{"id":"chenghuang-q-e60f2742050b33357e8b","section":"chapter-055","block":"b-49b0f5118da5406c8c09","layer":"pei","quote":"黄祖在夏口，军不得过；乃留依祖，三年，祖不礼之","attribution":"裴注·吴书","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":207,"anchor":null},"note_id":"n-4cdec240085a4d591c10","start":67,"end":90},{"id":"chenghuang-q-f367c03eb4fb3baf3c58","section":"chapter-055","block":"b-49b0f5118da5406c8c09","layer":"pei","quote":"祖都督苏飞，数荐宁，祖不用；令人化诱其客，客稍亡","attribution":"裴注·吴书","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":207,"anchor":null},"note_id":"n-4cdec240085a4d591c10","start":137,"end":161},{"id":"feipin-q-3f3a88590536b01cef40","section":"chapter-050","block":"b-c02a68458d713f31abe6","layer":"original","quote":"后从讨黄祖，中流矢，卒。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":43,"anchor":null},"note_id":null,"start":0,"end":12},{"id":"shiyi-q-f32cc495fa8e785267ed","section":"chapter-062","block":"b-274cf27e18898b898671","layer":"original","quote":"从讨黄祖，拜鄂长","section_title":"是仪胡综传第十七","source":{"file":"OEBPS/Text/titlepage_0131.xhtml","index":51,"anchor":null},"note_id":null,"start":21,"end":29},{"id":"sunshi-e-o021a-q","section":"chapter-046","block":"b-1d0f9de1e75c38a11c0e","layer":"original","quote":"初平（三）〔二〕年〖14〗，术使坚征荆州，击刘表〖15〗。表遣黄祖逆于樊、邓之间〖16〗。坚击破之，追渡汉水，遂围襄阳〖17〗；","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":132,"anchor":null},"note_id":null,"start":0,"end":64},{"id":"sunshi-e-p027a-q","section":"chapter-046","block":"b-760ad2c11830e05077b7","layer":"pei","quote":"坚悉其众攻表。表闭门，夜遣将黄祖潜出发兵。祖将兵欲还，坚逆与战；祖败走，窜岘山中。","attribution":"《典略》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":171,"anchor":null},"note_id":"n-c7bf5e729acd4a0d41f3","start":10,"end":51},{"id":"sunshi-e-p046f-q","section":"chapter-046","block":"b-0df888008b92c8896d19","layer":"pei","quote":"贲、辅又于彭泽破勋。勋走入楚江，从寻阳步上到置马亭；闻策等已克皖，乃投西塞。至沂，筑垒自守；告急于刘表，求救于黄祖。祖遣太子射、船军五千人，助勋。","attribution":"《江表传》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":257,"anchor":null},"note_id":"n-344fcece1d1f127d763a","start":325,"end":398},{"id":"sunshi-e-p046h-q","section":"chapter-046","block":"b-0df888008b92c8896d19","layer":"pei","quote":"遂前进夏口，攻黄祖。时刘表遣从子虎、南阳韩晞，将长矛五千，来为黄祖前锋。策与战，大破之。","attribution":"《江表传》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":257,"anchor":null},"note_id":"n-344fcece1d1f127d763a","start":435,"end":479},{"id":"sunshi-e-p047a-q","section":"chapter-046","block":"b-f9a911c6b81ca23bec0b","layer":"pei","quote":"臣讨黄祖，以十二月八日到祖所屯沙羡县。刘表遣将助祖，并来趋臣。臣以十一日平旦，部所领江夏太守、行建威中郎将周瑜，领桂阳太守、行征虏中郎将吕范，领零陵太守、行荡寇中郎将程普，行奉（业）〔义〕校尉孙权，行先登校尉韩当，行武锋校尉黄盖等，同时俱进。","attribution":"《吴录》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":258,"anchor":null},"note_id":"n-344fcece1d1f127d763a","start":10,"end":131},{"id":"sunshi-e-p047b-q","section":"chapter-046","block":"b-f9a911c6b81ca23bec0b","layer":"pei","quote":"身跨马綝阵，手击急鼓，以齐战势；吏士奋激，踊跃百倍，心精意果，各竞用命。越渡重堑，迅疾若飞；火放上风，兵激烟下；弓弩并发，流矢雨集；日加辰时，祖乃溃烂。锋刃所截，猋火所焚；前无生寇，惟祖迸走。获其妻、息男女七人，斩虎（狼）、韩晞以下二万余级，其赴水溺者一万余口；船六千余艘，财物山积。虽表未擒，祖宿狡猾，为表腹心，出作爪牙；表之鸱张，以祖气息；而祖家属部曲，扫地无余；表孤特之虏，成鬼行尸。诚皆圣朝，神武远振，臣讨有罪，得效微勤。","attribution":"《吴录》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":258,"anchor":null},"note_id":"n-344fcece1d1f127d763a","start":131,"end":346},{"id":"sunshi-q-b-8def9b9a583b6e66e28f","section":"chapter-046","block":"b-8def9b9a583b6e66e28f","layer":"modern","quote":"〖14〗初平二年：公元 191 年。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":149,"anchor":null},"note_id":"n-43f1998c7eea8e582a74","start":0,"end":18},{"id":"sunshi-q-o021","section":"chapter-046","block":"b-1d0f9de1e75c38a11c0e","layer":"original","quote":"初平（三）〔二〕年〖14〗，术使坚征荆州，击刘表〖15〗。表遣黄祖逆于樊、邓之间〖16〗。坚击破之，追渡汉水，遂围襄阳〖17〗；单马行岘山〖18〗，为祖军士所射杀。﹝六﹞","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":132,"anchor":null},"note_id":null,"start":0,"end":85},{"id":"sunshi-q-p027","section":"chapter-046","block":"b-760ad2c11830e05077b7","layer":"pei","quote":"﹝六﹞《典略》曰：“坚悉其众攻表。表闭门，夜遣将黄祖潜出发兵。祖将兵欲还，坚逆与战；祖败走，窜岘山中。坚乘胜夜追祖；祖部兵，从竹木间暗射坚，杀之。”","attribution":"《典略》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":171,"anchor":null},"note_id":"n-c7bf5e729acd4a0d41f3","start":0,"end":74},{"id":"sunshi-q-p034","section":"chapter-046","block":"b-4eedb9b9d0f4c495d16d","layer":"pei","quote":"﹝三﹞《吴历》曰：“初，策在江都时，张纮有母丧。策数诣纮，咨以世务，曰：‘方今汉祚中微，天下扰攘；英雄俊杰，各拥众营私，未有能扶危济乱者也。先君，与袁氏共破董卓；功业未遂，卒为黄祖所害。策虽暗稚，窃有微志：欲从袁扬州求先君余兵，就舅氏于丹杨；收合流散，东据吴、会；报仇雪耻，为朝廷外藩。君以为何如？’纮答曰：‘既素空劣，方居衰绖之中，无以奉赞盛略。’策曰：‘君高名播越，远近怀归。今日事计，决之于君；何得不纡虑启告，副其高山之望？若微志得展，血仇得报；此乃君之勋力，策心所望也！’因涕泣横流，颜色不变。纮见策忠壮内发，辞令慷慨，感其志言。乃答曰：‘昔周道陵迟，齐、晋并兴；王室以宁，诸侯贡职。今君绍先侯之轨，有骁武之名；若投丹杨，收兵吴、会；则荆、扬可一，仇敌可报。据长江，奋威德；诛除群秽，匡辅汉室：功业侔于桓、文，岂徒外藩而已哉！方今世乱多难，若功成事立，当与同好俱南济也！’策曰：‘一与君同符合契，同有永固之分！今便行矣，以老母、弱弟，委付于君，策无复回顾之忧。’”","attribution":"《吴历》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":210,"anchor":null},"note_id":"n-4c2b7b68e867c3227c2b","start":0,"end":436},{"id":"sunshi-q-p046","section":"chapter-046","block":"b-0df888008b92c8896d19","layer":"pei","quote":"﹝八﹞《江表传》曰：“策被诏敕，与司空曹公、卫将军董承、益州牧刘璋等，并力讨袁术、刘表。军严当进，会术死。术从弟胤、女婿黄猗等，畏惧曹公，不敢守寿春；乃共舁术棺柩，扶其妻子及部曲男女，就刘勋于皖城。勋粮食少，无以相赈；乃遣从弟偕，告籴于豫章太守华歆。歆郡素少谷，遣吏将偕，就海昏、上缭，使诸宗帅共出三万斛米以与偕。偕往历月，才得数千斛。偕乃报勋，具说形状，使勋来袭取之。勋得偕书，使潜军到海昏邑下。宗帅知之，空壁逃匿，勋了无所得。时策西讨黄祖，行及石城。闻勋轻身诣海昏，便分遣从兄贲、辅，率八千人，于彭泽待勋；自与周瑜率二万人，步袭皖城，即克之，得术百工及鼓吹部曲三万余人，并术、勋妻子。表用汝南李术为庐江太守，给兵三千人以守皖；皆徙所得人，东诣吴。贲、辅又于彭泽破勋。勋走入楚江，从寻阳步上到置马亭；闻策等已克皖，乃投西塞。至沂，筑垒自守；告急于刘表，求救于黄祖。祖遣太子射、船军五千人，助勋。策复就攻，大破勋。勋与偕，北归曹公，射亦遁走。策收得勋兵二千余人，船千艘；遂前进夏口，攻黄祖。时刘表遣从子虎、南阳韩晞，将长矛五千，来为黄祖前锋。策与战，大破之。”","attribution":"《江表传》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":257,"anchor":null},"note_id":"n-344fcece1d1f127d763a","start":0,"end":480},{"id":"sunshi-q-p047","section":"chapter-046","block":"b-f9a911c6b81ca23bec0b","layer":"pei","quote":"《吴录》载策表曰：“臣讨黄祖，以十二月八日到祖所屯沙羡县。刘表遣将助祖，并来趋臣。臣以十一日平旦，部所领江夏太守、行建威中郎将周瑜，领桂阳太守、行征虏中郎将吕范，领零陵太守、行荡寇中郎将程普，行奉（业）〔义〕校尉孙权，行先登校尉韩当，行武锋校尉黄盖等，同时俱进。身跨马綝阵，手击急鼓，以齐战势；吏士奋激，踊跃百倍，心精意果，各竞用命。越渡重堑，迅疾若飞；火放上风，兵激烟下；弓弩并发，流矢雨集；日加辰时，祖乃溃烂。锋刃所截，猋火所焚；前无生寇，惟祖迸走。获其妻、息男女七人，斩虎（狼）、韩晞以下二万余级，其赴水溺者一万余口；船六千余艘，财物山积。虽表未擒，祖宿狡猾，为表腹心，出作爪牙；表之鸱张，以祖气息；而祖家属部曲，扫地无余；表孤特之虏，成鬼行尸。诚皆圣朝，神武远振，臣讨有罪，得效微勤。”","attribution":"《吴录》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":258,"anchor":null},"note_id":"n-344fcece1d1f127d763a","start":0,"end":347},{"id":"sunshi-q-p056","section":"chapter-046","block":"b-966d90f694cd8ad2a5c6","layer":"pei","quote":"孙盛《异同评》曰：“凡此数书，各有所失。孙策虽威行江外，略有六郡；然黄祖乘其上流，陈登间其心腹；且深险强宗，未尽归复；曹、袁虎争，势倾山海：策岂暇远师汝、颍，而迁帝于吴、越哉！斯盖庸人之所鉴见，况策达于事势者乎？又按袁绍以建安五年至黎阳，而策以四月遇害；而《志》云策闻曹公与绍相拒于官渡，谬矣！伐登之言，为有证也。又《江表传》说策悉识韩当军士，疑此为诈，便射杀一人。夫三军将士，或有新附；策为大将，何能悉识？以所不识，便射杀之，非其论也。又策见杀在五年，柳城之役在十二年，《九州春秋》乖错尤甚矣！”","attribution":"孙盛《异同评》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":284,"anchor":null},"note_id":"n-26c0935904b6bc636b31","start":0,"end":249},{"id":"sunshi-q-p057","section":"chapter-046","block":"b-0bd05c5ba15e2fa499c7","layer":"pei","quote":"臣松之按：《傅子》亦云曹公征柳城，将袭许。记述若斯，何其疏哉！然孙盛所讥，未为悉是。黄祖始被策破，魂气未反；但刘表君臣，本无兼并之志，虽在上流，何办规拟吴、会？策之此举，理应先图陈登；但举兵所在，不止登而已。于时强宗骁帅，祖郎、严虎之徒，擒灭已尽；所余山越，盖何足虑？然则策之所规，未可谓之不暇也。若使策志获从，大权在手；淮、泗之间，所在皆可都；何必毕志江外，其当迁帝于扬、越哉！按《魏武纪》，武帝以建安四年已出屯官渡，乃策未死之前，久与袁绍交兵，则《国志》所云不为谬也。许贡客，无闻之小人；而能感识恩遇，临义忘生，猝然奋发，有侔古烈矣。《诗》云：“君子有徽猷，小人与属。”贡客其有焉。","attribution":"裴松之按语","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":285,"anchor":null},"note_id":"n-26c0935904b6bc636b31","start":0,"end":293},{"id":"wudi-q-b-51bced16741add42ff70","section":"chapter-001","block":"b-51bced16741add42ff70","layer":"modern","quote":"〖1〗四年：建安四年（公元 199）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":369,"anchor":null},"note_id":"n-20628d34a709162c77f0","start":0,"end":19},{"id":"wudi-q-o061","section":"chapter-001","block":"b-502d4e8c0ed143eaa30d","layer":"original","quote":"四年春二月〖1〗，公还至昌邑〖2〗。张杨将杨丑杀杨〖3〗。眭固又杀丑，以其众属袁绍，屯射犬〖4〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":358,"anchor":null},"note_id":null,"start":0,"end":49},{"id":"wufan-q-e297cdefd9d420d39248","section":"chapter-063","block":"b-b84cf48ba2c7aa9dcf0c","layer":"original","quote":"会孙权起于东南，范委身服事。每有灾祥，辄推数言状；其术多效，遂以显名。初，权在吴，欲讨黄祖。范曰：“今兹少利，不如明年。明年戊子〖4〗，荆州刘表亦身死国亡。”权遂征祖，卒不能克。明年，军出。行及寻阳，范见风气，因诣船贺，催兵急行。至即破祖，祖（得）夜亡〖5〗。权恐失之，范曰：“未远，必生擒祖。”至五更中，果得之。刘表竟死，荆州分割。","section_title":"吴范刘惇赵达传第十八","source":{"file":"OEBPS/Text/titlepage_0133.xhtml","index":2,"anchor":null},"note_id":null,"start":0,"end":167},{"id":"wuzhu-e-o003a-q","section":"chapter-047","block":"b-9dfc26d83bc6f0a49854","layer":"original","quote":"建安四年，从策征庐江太守刘勋。勋破，进讨黄祖于沙羡〖1〗。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":15,"anchor":null},"note_id":null,"start":0,"end":29},{"id":"wuzhu-e-o008a-q","section":"chapter-047","block":"b-7adf6fb487c32ced7646","layer":"original","quote":"八年〖20〗，权西伐黄祖，破其舟军，惟城未克；而山寇复动〖21〗，还过豫章，","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":20,"anchor":null},"note_id":null,"start":0,"end":38},{"id":"wuzhu-e-o011a-q","section":"chapter-047","block":"b-f715dc33a31e617fe160","layer":"original","quote":"十二年〖31〗，西征黄祖，虏其人民而还。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":23,"anchor":null},"note_id":null,"start":0,"end":20},{"id":"wuzhu-e-o012a-q","section":"chapter-047","block":"b-3843def972d8a772cdb3","layer":"original","quote":"十三年春〖1〗，权复征黄祖。祖先遣舟兵拒军，都尉吕蒙破其前锋；而凌统、董袭等尽锐攻之〖2〗，遂屠其城。祖挺身亡走〖3〗。骑士冯则追枭其首〖4〗，虏其男女数万口。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":60,"anchor":null},"note_id":null,"start":0,"end":80},{"id":"wuzhu-q-o003","section":"chapter-047","block":"b-9dfc26d83bc6f0a49854","layer":"original","quote":"建安四年，从策征庐江太守刘勋。勋破，进讨黄祖于沙羡〖1〗。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":15,"anchor":null},"note_id":null,"start":0,"end":29},{"id":"wuzhu-q-o008","section":"chapter-047","block":"b-7adf6fb487c32ced7646","layer":"original","quote":"八年〖20〗，权西伐黄祖，破其舟军，惟城未克；而山寇复动〖21〗，还过豫章，使吕范平鄱阳（会稽）〖22〗，程普讨乐安〖23〗；太史慈领海昏〖24〗，韩当、周泰、吕蒙等，为剧县令、长〖25〗。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":20,"anchor":null},"note_id":null,"start":0,"end":95},{"id":"wuzhu-q-o011","section":"chapter-047","block":"b-f715dc33a31e617fe160","layer":"original","quote":"十二年〖31〗，西征黄祖，虏其人民而还。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":23,"anchor":null},"note_id":null,"start":0,"end":20},{"id":"wuzhu-q-o012","section":"chapter-047","block":"b-3843def972d8a772cdb3","layer":"original","quote":"十三年春〖1〗，权复征黄祖。祖先遣舟兵拒军，都尉吕蒙破其前锋；而凌统、董袭等尽锐攻之〖2〗，遂屠其城。祖挺身亡走〖3〗。骑士冯则追枭其首〖4〗，虏其男女数万口。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":60,"anchor":null},"note_id":null,"start":0,"end":80},{"id":"xianzhu-q-o014","section":"chapter-032","block":"b-9236c229b2cd9315f1e3","layer":"original","quote":"袁术欲经徐州北就袁绍，曹公遣先主督朱灵、路招要击术〖4〗。未至，术病死。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":60,"anchor":null},"note_id":null,"start":0,"end":36},{"id":"xunyu-e-p011c-q","section":"chapter-010","block":"b-21873455cc9461d16e3e","layer":"pei","quote":"衡南见刘表，表甚礼之。将军黄祖屯夏口；祖子射，与衡善，随到夏口。祖嘉其才，每在坐，席有异宾，介使与衡谈。后衡骄蹇，答祖言‘俳优饶言’。祖以为骂己也，大怒；顾伍伯捉头出。左右遂扶以去，拉而杀之。","attribution":"《平原祢衡传》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":79,"anchor":null},"note_id":"n-c5cdbaf6b01ad416ab88","start":437,"end":533},{"id":"xunyu-q-b-ee371e4d38e13efa88cd","section":"chapter-010","block":"b-ee371e4d38e13efa88cd","layer":"modern","quote":"〖4〗八年：建安八年（公元 203）。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":128,"anchor":null},"note_id":"n-89fa02f36b1a0d0955da","start":0,"end":19},{"id":"xunyu-q-o023","section":"chapter-010","block":"b-64b6e45c68fb16b80ee9","layer":"original","quote":"太祖复次于河上，绍病死。太祖渡河，击绍子谭、尚。而高幹、郭援侵略河东，关右震动。钟繇帅马腾等，击破之，语在《繇传》。八年〖4〗，太祖录彧前后功，表封彧为万岁亭侯。﹝一﹞","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":120,"anchor":null},"note_id":null,"start":0,"end":84},{"id":"xunyu-q-o064","section":"chapter-010","block":"b-38f29d879d5ca24386ff","layer":"original","quote":"建安十三年，太祖破荆州，欲顺江东下。诩谏曰：“明公昔破袁氏，今收汉南；威名远著，军势既大。若乘旧楚之饶，以飨吏士；抚安百姓，使安土乐业；则可不劳众而江东稽服矣〖4〗。”太祖不从，军遂无利。﹝一﹞","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":314,"anchor":null},"note_id":null,"start":0,"end":97},{"id":"xunyu-q-p011","section":"chapter-010","block":"b-21873455cc9461d16e3e","layer":"pei","quote":"又《平原祢衡传》曰：“衡字正平。建安初，自荆州北游许都。恃才傲逸，臧否过差；见不如己者，不与语，人皆以是憎之。唯少府孔融，高贵其才，上书荐之曰：‘淑质贞亮，英才卓荦。初涉艺文，升堂睹奥。目所一见，辄诵于口；耳所暂闻，不忘于心。性与道合，思若有神。弘羊心计，安世默识；以衡准之，诚不足怪。’衡，时年二十四。是时许都虽新建，尚饶人士。衡尝书一刺怀之，字漫灭而无所适。或问之曰：‘何不从陈长文、司马伯达乎？’衡曰：‘卿欲使我从屠沽儿辈也！’又问曰：‘当今许中，谁最可者？’衡曰：‘大儿有孔文举，小儿有杨德祖。’又问：‘曹公、荀令君、赵荡寇，皆足盖世乎？’衡称曹公不甚多；又见荀有仪容，赵有腹尺，因答曰：‘文若可借面吊丧，稚长可使监厨请客。’其意以为荀但有貌，赵健啖肉也。于是众人皆切齿。衡知众不悦，将南还荆州；装束临发，众人为祖道。先设供帐于城南，自共相诫曰：‘衡数不逊，今因其后到，以不起，报之。’及衡至，众人皆坐不起。衡乃嚎啕大哭，众人问其故。衡曰：‘行尸柩之间，能不悲乎？’衡南见刘表，表甚礼之。将军黄祖屯夏口；祖子射，与衡善，随到夏口。祖嘉其才，每在坐，席有异宾，介使与衡谈。后衡骄蹇，答祖言‘俳优饶言’。祖以为骂己也，大怒；顾伍伯捉头出。左右遂扶以去，拉而杀之。”","attribution":"《平原祢衡传》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":79,"anchor":null},"note_id":"n-c5cdbaf6b01ad416ab88","start":0,"end":534},{"id":"yaoci-q-7fb87c25d579494e1335","section":"chapter-049","block":"b-2cdec7258908eadc1d9f","layer":"pei","quote":"策初遣慈，议者纷纭，谓慈未可信；或云与华子鱼州里，恐留彼为筹策；或疑慈西托黄祖，假路还北：多言遣之非计","attribution":"裴注·江表传","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":171,"anchor":null},"note_id":"n-321352b9fd1cdac5f263","start":11,"end":62},{"id":"zhouyu-e-o069d-q","section":"chapter-054","block":"b-c5dafa5a24682c296ffa","layer":"original","quote":"将士乘胜，进攻其城。祖闻就死，委城走，兵追擒之。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":316,"anchor":null},"note_id":null,"start":33,"end":57},{"id":"zhouyu-q-b-63f47c62fde80b3a0132","section":"chapter-054","block":"b-63f47c62fde80b3a0132","layer":"modern","quote":"〖6〗十三年：建安十三年（公元 208）。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":43,"anchor":null},"note_id":"n-8f109f42647e5ee8d831","start":0,"end":21},{"id":"zhouyu-q-o008","section":"chapter-054","block":"b-cb2469c06cb18878c8aa","layer":"original","quote":"十一年〖2〗，督孙瑜等讨麻、保二屯〖3〗，枭其渠帅〖4〗，囚俘万余口。还备（官）〔宫〕亭〖5〗。江夏太守黄祖遣将邓龙，将兵数千人入柴桑；瑜追讨击，生虏龙送吴。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":33,"anchor":null},"note_id":null,"start":0,"end":79},{"id":"zhouyu-q-o009","section":"chapter-054","block":"b-3661896c106f1817bf4b","layer":"original","quote":"十三年春〖6〗，权讨江夏，瑜为前部大督〖7〗。其年九月，曹公入荆州，刘琮举众降。曹公得其水军船，步兵数十万。将士闻之皆恐。（惧）〔权〕延见群下〖8〗，问以计策。议者咸曰：“曹公，豺虎也！然托名汉相，挟天子以征四方，动以朝廷为辞；今日拒之，事更不顺。且将军大势：可以拒操者，长江也。今操得荆州，奄有其地〖9〗；刘表治水军，蒙冲、斗舰〖10〗，乃以千数，操悉浮以沿江；兼有步兵，水陆俱下。此为长江之险，已与我共之矣。而势力众寡，又不可论。愚谓大计不如迎之。”","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":34,"anchor":null},"note_id":null,"start":0,"end":227},{"id":"zhouyu-q-o040","section":"chapter-054","block":"b-946768480b126c05a892","layer":"original","quote":"肃对曰：“昔高帝区区，欲尊事义帝而不获者〖12〗，以项羽为害也〖13〗。今之曹操，犹昔项羽；将军何由得为桓、文乎？肃窃料之：汉室不可复兴，曹操不可猝除。为将军计，惟有鼎足江东〖14〗，以观天下之衅〖15〗。规模如此〖16〗，亦自无嫌〖17〗。何者？北方诚多务也〖18〗。因其多务，剿除黄祖，进伐刘表；竟长江所极，据而有之；然后建号帝王，以图天下：此高帝之业也。”","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":187,"anchor":null},"note_id":null,"start":0,"end":181},{"id":"zhouyu-q-o069","section":"chapter-054","block":"b-c5dafa5a24682c296ffa","layer":"original","quote":"从征黄祖，祖令都督陈就，逆以水军出战。蒙勒前锋〖15〗，亲枭就首；将士乘胜，进攻其城。祖闻就死，委城走，兵追擒之。权曰：“事之克，由陈就先获也。”以蒙为横野中郎将〖16〗，赐钱千万。是岁，又与周瑜、程普等，西破曹公于乌林，围曹仁于南郡。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":316,"anchor":null},"note_id":null,"start":0,"end":118},{"id":"zhuge-q-b-40accddaa1b32119c6cb","section":"chapter-035","block":"b-40accddaa1b32119c6cb","layer":"modern","quote":"〖39〗尔来：从那以来。这一句总括上文，所以是从刘备三顾时的建安十二年（公元 207）算起。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":198,"anchor":null},"note_id":"n-1692331886f906f52ea2","start":0,"end":46},{"id":"zhuge-q-o005","section":"chapter-035","block":"b-e33c66499df69116b2fc","layer":"original","quote":"由是先主遂诣亮；凡三往，乃见。因屏人曰〖1〗：“汉室倾颓，奸臣窃命〖2〗，主上蒙尘〖3〗。孤不度德量力〖4〗，欲信大义于天下〖5〗；而智术短浅，遂用猖獗〖6〗。至于今日，然志犹未已，君谓计将安出？”","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":30,"anchor":null},"note_id":null,"start":0,"end":99},{"id":"zhuge-q-o008","section":"chapter-035","block":"b-5baeb7a9a85977757637","layer":"original","quote":"刘表长子琦，亦深器亮。表受后妻之言，爱少子琮，不悦于琦。琦每欲与亮谋自安之术，亮辄拒塞〖27〗，未与处画〖28〗。琦乃将亮游观后园，共上高楼；饮宴之间，令人去梯，因谓亮曰：“今日上不至天，下不至地；言出子口，入于吾耳：可以言未？”亮答曰：“君不见申生在内而危〖29〗，重耳在外而安乎？”琦意感悟，阴规出计〖30〗；会黄祖死〖31〗，得出，遂为江夏太守。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":33,"anchor":null},"note_id":null,"start":0,"end":176},{"id":"zongshi-q-11c86715125785962926","section":"chapter-051","block":"b-c529af783399939485ea","layer":"original","quote":"时策已平吴、会二郡，贲与策征庐江太守刘勋、江夏太守黄祖","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":95,"anchor":null},"note_id":null,"start":0,"end":27}],"profiles":{},"directory_counts":{}}
