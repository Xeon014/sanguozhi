"santizhu-q-9bd404f7b7d73d7cb2e2"]}],"participants":[{"person":"shaodi-p0131","role":"与裴秀、荀勖等以所不知相难张俨而未能屈之","evidence":["santizhu-q-9bd404f7b7d73d7cb2e2"]},{"person":"shaodi-p0104","role":"与贾充、荀勖等以所不知相难张俨而未能屈之","evidence":["santizhu-q-9bd404f7b7d73d7cb2e2"]},{"person":"xunyu-p0069","role":"与贾充、裴秀等以所不知相难张俨而未能屈之","evidence":["santizhu-q-9bd404f7b7d73d7cb2e2"]},{"person":"santizhu-p0073","role":"未被对方屈服","evidence":["santizhu-q-9bd404f7b7d73d7cb2e2"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["santizhu-q-9bd404f7b7d73d7cb2e2"]},"ordering_evidence":"santizhu-q-9bd404f7b7d73d7cb2e2","source_order":[48,25,113],"order":8731}],"persons":[{"id":"shaodi-p0104","name":"裴秀","evidence":["shaodi-q-p033","wgc-q0139","santizhu-q-9bd404f7b7d73d7cb2e2","hechang-q-b14d61169094d93a19b9","hechang-q-47eca328b4dc4dbbaf1d","hechang-q-665990ba7f1893e8be96","hechang-q-f268f47c11182c0a76a5","hechang-q-7233d263e0cff990e324","hechang-q-3e28a2213f479c69ae47","hechang-q-f00c35cfe29717f22235","hechang-q-2beb51a9dcb60099bc7d","hechang-q-e7526c3b3dbf0cbfd45f","hechang-q-3cb0b1a409bd38f7f692","hechang-q-b2a89d84e2c12497ee5e","fangji-q-702408c7da1263862416","fangji-q-38b11a1baf2154886def","fangji-q-c3ebd7f92f276c2c0d3d"],"facts":[{"id":"hechang-f-e354b5389393702ddec1","text":"裴潜之子。","evidence":["hechang-q-3cb0b1a409bd38f7f692"]},{"id":"hechang-f-5f577bad55978f48c221","text":"字季彦。","evidence":["hechang-q-b2a89d84e2c12497ee5e"]},{"id":"fangji-f-4618ae27903d9effbdf9","text":"傅玄序末释裴子为裴秀。","evidence":["fangji-q-c3ebd7f92f276c2c0d3d"]}],"aliases":[],"mentions":[{"id":"shaodi-m-p033-shaodi-p0104","kind":"mention","text":"文中提及","evidence":["shaodi-q-p033"]},{"id":"shaodi-m-o125-shaodi-p0104","kind":"mention","text":"文中提及","evidence":["shaodi-q-o125"]},{"id":"wgc-m-p064-shaodi-p0104","kind":"mention","text":"本段涉及裴秀","evidence":["wgc-q0139"]}]}],"evidence":[{"id":"fangji-q-38b11a1baf2154886def","section":"chapter-029","block":"b-e4ebde6dba1a248003cd","layer":"pei","quote":"傅子谓裴子曰：‘子所长者言也，所短者巧也；马氏所长者巧也，所短者言也。以子所长，击彼所短，则不得不屈；以子所短，难彼所长，则必有所不解者矣。夫巧，天下之微事也；有所不解而难之不已，其相击刺，必已远矣。心乖于内，口屈于外，此马氏所以不对也","attribution":"裴注·傅玄序","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":182,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4a01e585e104c2660e3b","start":51,"end":169,"offset_unit":"unicode_code_point"},{"id":"fangji-q-702408c7da1263862416","section":"chapter-029","block":"b-e4ebde6dba1a248003cd","layer":"pei","quote":"有裴子者，上国之士也，精通见理；闻而哂之，乃难先生，先生口屈不〔能〕对。裴子自以为难得其要，言之不已","attribution":"裴注·傅玄序","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":182,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4a01e585e104c2660e3b","start":0,"end":50,"offset_unit":"unicode_code_point"},{"id":"fangji-q-c3ebd7f92f276c2c0d3d","section":"chapter-029","block":"b-19669e6ac4a444d3d26b","layer":"pei","quote":"于是安乡侯悟，遂言之武安侯；武安侯忽之，不果试也。此既易试之事，又马氏巧名已定，犹忽而不察；况幽深之才，无名之璞乎？后之君子，其鉴之哉！马先生之巧，虽古公输般、墨翟、王尔，近汉世张平子，不能过也。公输般、墨翟，皆见用于时，乃有益于世。平子虽为侍中，马先生虽给事省中；俱不典工官，巧，无益于世。用人不当其才，闻贤不试以事：良可恨也！”裴子者，裴秀；安乡侯者，曹羲；武安侯者，曹爽也。","attribution":"裴注","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":184,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4a01e585e104c2660e3b","start":0,"end":190,"offset_unit":"unicode_code_point"},{"id":"hechang-q-2beb51a9dcb60099bc7d","section":"chapter-023","block":"b-6d43b10c81dbae4e9caf","layer":"pei","quote":"咸熙中，晋文王始建五等；命秀典为制度，封广川侯。","attribution":"裴注·文章叙录","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":380,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-e3d593d747be095d124a","start":93,"end":117,"offset_unit":"unicode_code_point"},{"id":"hechang-q-3cb0b1a409bd38f7f692","section":"chapter-023","block":"b-16aefddfb8d37b8a6699","layer":"original","quote":"正始五年薨，追赠太常，谥曰贞侯。﹝一﹞子秀嗣〖7〗。遗令俭葬：墓中惟置一坐，瓦器数枚，其余一无所设。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":368,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":50,"offset_unit":"unicode_code_point"},{"id":"hechang-q-3e28a2213f479c69ae47","section":"chapter-023","block":"b-6d43b10c81dbae4e9caf","layer":"pei","quote":"著《易》及《乐论》，又画《地域图》十八篇，传行于世。《盟会图》及《典治官制》皆未成。","attribution":"裴注·文章叙录","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":380,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-e3d593d747be095d124a","start":139,"end":181,"offset_unit":"unicode_code_point"},{"id":"hechang-q-47eca328b4dc4dbbaf1d","section":"chapter-023","block":"b-16aefddfb8d37b8a6699","layer":"original","quote":"子秀嗣〖7〗。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":368,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":19,"end":26,"offset_unit":"unicode_code_point"},{"id":"hechang-q-665990ba7f1893e8be96","section":"chapter-023","block":"b-6d43b10c81dbae4e9caf","layer":"pei","quote":"大将军曹爽辟。丧父服终，推财与兄弟。","attribution":"裴注·文章叙录","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":380,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-e3d593d747be095d124a","start":32,"end":50,"offset_unit":"unicode_code_point"},{"id":"hechang-q-7233d263e0cff990e324","section":"chapter-023","block":"b-6d43b10c81dbae4e9caf","layer":"pei","quote":"晋室受禅，进左光禄大夫，改封钜鹿公。迁司空。","attribution":"裴注·文章叙录","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":380,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-e3d593d747be095d124a","start":117,"end":139,"offset_unit":"unicode_code_point"},{"id":"hechang-q-b14d61169094d93a19b9","section":"chapter-023","block":"b-58dd485ad32aafea214f","layer":"original","quote":"秀，咸熙中为尚书仆射。﹝二﹞","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":369,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":14,"offset_unit":"unicode_code_point"},{"id":"hechang-q-b2a89d84e2c12497ee5e","section":"chapter-023","block":"b-6d43b10c81dbae4e9caf","layer":"pei","quote":"﹝二﹞《文章叙录》曰：“秀字季彦。弘通博济，八岁能属文，遂知名。大将军曹爽辟。丧父服终，推财与兄弟。年二十五，迁黄门侍郎。爽诛，以故吏免。迁卫国相，累迁散骑常侍，尚书仆射、令，光禄大夫。咸熙中，晋文王始建五等；命秀典为制度，封广川侯。晋室受禅，进左光禄大夫，改封钜鹿公。迁司空。著《易》及《乐论》，又画《地域图》十八篇，传行于世。《盟会图》及《典治官制》皆未成。年四十八，泰始七年薨。谥元公，配食宗庙。少子頠，字逸民。袭封。”","attribution":"裴注（引书见原文，待主审复核）","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":380,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-e3d593d747be095d124a","start":0,"end":213,"offset_unit":"unicode_code_point"},{"id":"hechang-q-e7526c3b3dbf0cbfd45f","section":"chapter-023","block":"b-6d43b10c81dbae4e9caf","layer":"pei","quote":"年四十八，泰始七年薨。谥元公，配食宗庙。","attribution":"裴注引《文章叙录》","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":380,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-e3d593d747be095d124a","start":181,"end":201,"offset_unit":"unicode_code_point"},{"id":"hechang-q-f00c35cfe29717f22235","section":"chapter-023","block":"b-6d43b10c81dbae4e9caf","layer":"pei","quote":"迁卫国相，累迁散骑常侍，尚书仆射、令，光禄大夫。","attribution":"裴注·文章叙录","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":380,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-e3d593d747be095d124a","start":69,"end":93,"offset_unit":"unicode_code_point"},{"id":"hechang-q-f268f47c11182c0a76a5","section":"chapter-023","block":"b-6d43b10c81dbae4e9caf","layer":"pei","quote":"年二十五，迁黄门侍郎。爽诛，以故吏免。","attribution":"裴注·文章叙录","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":380,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-e3d593d747be095d124a","start":50,"end":69,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-9bd404f7b7d73d7cb2e2","section":"chapter-048","block":"b-e476f067c552bc43ab1d","layer":"pei","quote":"既至，车骑将军贾充、尚书令裴秀、侍中荀勖等，欲傲以所不知而不能屈。","attribution":"裴注·吴录","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":371,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6b2af9c2569d5d36f768","start":113,"end":146,"offset_unit":"unicode_code_point"},{"id":"shaodi-e-o125a-q","section":"chapter-004","block":"b-4d6508daae08a729a65a","layer":"original","quote":"甲子〖27〗，诏曰：“今车驾驻项〖28〗。大将军恭行天罚，前临淮浦〖29〗。昔相国、大司马征讨〖30〗，皆与尚书俱行〖31〗。今宜如旧。”乃令散骑常侍裴秀、给事黄门侍郎钟会咸与大将军俱行〖32〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":530,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":98,"offset_unit":"unicode_code_point"},{"id":"shaodi-e-p033a-q","section":"chapter-004","block":"b-8eb21fb62289cb14e5cb","layer":"pei","quote":"傅畅《晋诸公赞》曰：“帝常与中护军司马望、侍中王沈、散骑常侍裴秀、黄门侍郎钟会等，讲宴于东堂，并属文论。名秀为‘儒林丈人’，沈为‘文籍先生’，望、会亦各有名号。帝性急，请召欲速。秀等在内职，到得及时；以望在外，特给追锋车，虎贲卒五人。每有集会，望辄奔驰而至。”","attribution":"傅畅《晋诸公赞》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":505,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-d25eba0115fddcee9a0f","start":0,"end":130,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-b-6209c552405e0ebbdf98","section":"chapter-004","block":"b-6209c552405e0ebbdf98","layer":"modern","quote":"〖1〗二年：甘露二年（公元 257 ）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":535,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4dd98e402a6a8de51491","start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o117","section":"chapter-004","block":"b-d021e0b00f489a01f208","layer":"original","quote":"二年春二月〖1〗，青龙现温县井中。三月，司空卢毓薨。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":522,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":26,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o125","section":"chapter-004","block":"b-4d6508daae08a729a65a","layer":"original","quote":"甲子〖27〗，诏曰：“今车驾驻项〖28〗。大将军恭行天罚，前临淮浦〖29〗。昔相国、大司马征讨〖30〗，皆与尚书俱行〖31〗。今宜如旧。”乃令散骑常侍裴秀、给事黄门侍郎钟会咸与大将军俱行〖32〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":530,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":98,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-p033","section":"chapter-004","block":"b-8eb21fb62289cb14e5cb","layer":"pei","quote":"傅畅《晋诸公赞》曰：“帝常与中护军司马望、侍中王沈、散骑常侍裴秀、黄门侍郎钟会等，讲宴于东堂，并属文论。名秀为‘儒林丈人’，沈为‘文籍先生’，望、会亦各有名号。帝性急，请召欲速。秀等在内职，到得及时；以望在外，特给追锋车，虎贲卒五人。每有集会，望辄奔驰而至。”","attribution":"傅畅《晋诸公赞》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":505,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-d25eba0115fddcee9a0f","start":0,"end":130,"offset_unit":"unicode_code_point"},{"id":"wgc-q0028","section":"chapter-028","block":"b-c135ec113c597ad4f2da","layer":"original","quote":"六月，车驾东征，至项。大将军司马文王督中外诸军二十六万众，临淮讨之。大将军屯丘头，使基及安东将军陈骞等四面合围，表里再重〖9〗，堑垒甚峻。又使监军石苞、兖州刺史州泰等〖10〗，简锐卒为游军〖11〗，备外寇。钦等数出犯围〖12〗，逆击走之。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":175,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":119,"offset_unit":"unicode_code_point"},{"id":"wgc-q0067","section":"chapter-028","block":"b-19a57525c37bf4f5767a","layer":"original","quote":"甘露二年，征诸葛诞为司空。时，会丧宁在家〖1〗，策诞必不从命，驰白文王。文王以事已施行，不复追改。﹝一﹞及诞反，车驾住项；文王至寿春，会复从行。初，吴大将全琮，孙权之婚亲重臣也〖2〗；琮子怿、孙静、从子端、翩、缉等，皆将兵来救诞。怿兄子辉、仪留建业，与其家内争讼；携其母，将部曲数十家渡江，自归文王。会建策，密为辉、仪作书，使辉、仪所亲信，赍入城告怿等，说“吴中怒怿等不能拔寿春，欲尽诛诸将家，故逃来归命”。怿等恐惧，遂将所领，开东城门出降，皆蒙封宠，城中由是乖离。寿春之破，会谋居多。亲待日隆，时人谓之子房〖3〗。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":455,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":258,"offset_unit":"unicode_code_point"},{"id":"wgc-q0139","section":"chapter-028","block":"b-9b251afc54919533df14","layer":"pei","quote":"﹝一﹞弼，字辅嗣。何劭为其传曰：“弼幼而察慧，年十余，好《老氏》，能辩能言。父业，为尚书郎。时裴徽为吏部郎，弼未弱冠，往造焉。徽一见而异之，问弼曰：‘夫无者，诚万物之所资也，然圣人莫肯致言，而老子申之无已者何？’弼曰：‘圣人体无，无又不可以训，故不说也。老子是有者也，故恒言（无）〔其〕所不足。’寻亦为傅嘏所知。于时何晏为吏部尚书，甚奇弼，叹之曰：‘仲尼称后生可畏。若斯人者，可与言天人之际乎！’正始中，黄门侍郎累缺。晏既用贾充、裴秀、朱整，又议用弼。时丁谧与晏争衡，致高邑王黎于曹爽，爽用黎；于是以弼补台郎。初除，觐爽，请闲；爽为屏左右，而弼与论道，移时无所他及，爽以此嗤之。时爽专朝政，党与共相进用，弼通俊，不治名高。寻黎无几时病亡，爽用王沈代黎；弼遂不得在门下，晏为之叹恨。弼在台既浅，事功亦雅非所长，益不留意焉。淮南人刘陶，善论纵横，为当时所推。每与弼语，常屈弼。弼天才卓出，当其所得，莫能夺也。性和理，乐游宴，解音律，善投壶。其论道：傅会文辞，不如何晏；自然有所拔得，多晏也。颇以所长笑人，故时为士君子所疾。弼与钟会善，会论议，以校练为家，然每服弼之高致。何晏以为圣人无喜怒哀乐，其论甚精，钟会等述之。弼与不同，以为：圣人茂于人者，神明也；同于人者，五情也；神明茂，故能体冲和以通无；五情同，故不能无哀乐以应物：然则圣人之情，应物而无累于物者也。今以其无累，便谓不复应物，失之多矣。弼注《易》，颍川人荀融难弼《大衍义》。弼答其意，白书以戏之曰：‘夫明足以寻极幽微，而不能去自然之性。颜子之量，孔父之所预在，然遇之不能无乐，丧之不能无哀。又常狭斯人，以为未能以情从理者也，而今乃知自然之不可革。足下之量，虽已定乎胸怀之内；然而隔逾旬朔，何其相思之多乎？故知尼父之于颜子，可以无大过矣。’弼注《老子》，为之指略，致有理统。著《道略论》，注《易》，往往有高丽言。太原王济好谈，病《老》、《庄》，常云：‘见弼《易注》，所悟者多。’然弼为人，浅而不识物情。初与王黎、荀融善，黎夺其黄门郎；于是恨黎，与融亦不终。正始十年，曹爽废，以公事免。其秋遇疠疾亡，时年二十四。无子，绝嗣。弼之卒也，晋景王闻之，嗟叹者累日，其为高识所惜如此。”","attribution":"何劭王弼传","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":627,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fd72bf831660f4aea13e","start":0,"end":915,"offset_unit":"unicode_code_point"},{"id":"wgc-q0279","section":"chapter-028","block":"b-c135ec113c597ad4f2da","layer":"original","quote":"车驾东征，至项","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":175,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":3,"end":10,"offset_unit":"unicode_code_point"},{"id":"wgc-q0433","section":"chapter-028","block":"b-19a57525c37bf4f5767a","layer":"original","quote":"及诞反，车驾住项；文王至寿春，会复从行","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":455,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":52,"end":71,"offset_unit":"unicode_code_point"},{"id":"wgc-q0708","section":"chapter-028","block":"b-9b251afc54919533df14","layer":"pei","quote":"正始中，黄门侍郎累缺。晏既用贾充、裴秀、朱整，又议用弼。","attribution":"何劭王弼传","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":627,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fd72bf831660f4aea13e","start":198,"end":226,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
