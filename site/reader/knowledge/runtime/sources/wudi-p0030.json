38864c80dc332","yaoci-q-8fb1a9cbe7fe3073806a","yaoci-q-b27d7ae93a6d72b0d0aa"]}],"order":8938}],"persons":[{"id":"wudi-p0030","name":"许子将","evidence":["wudi-q-p010","xunyu-q-p003","pangfa-q-p003","yaoci-q-4db03b80e389942ef4cb","yaoci-q-8fb1a9cbe7fe3073806a"],"facts":[],"aliases":[],"mentions":[{"id":"wudi-m-p010-wudi-p0030","kind":"mention","text":"文中提及","evidence":["wudi-q-p010"]},{"id":"wudi-m-p011-wudi-p0030","kind":"mention","text":"文中提及","evidence":["wudi-q-p011"]},{"id":"xunyu-m-p003-wudi-p0030","kind":"mention","text":"文中提及","evidence":["xunyu-q-p003"]},{"id":"pangfa-m-p003-wudi-p0030","kind":"mention","text":"文中提及","evidence":["pangfa-q-p003"]},{"id":"pangfa-m-p012-wudi-p0030","kind":"mention","text":"文中提及","evidence":["pangfa-q-p012"]}]}],"evidence":[{"id":"pangfa-q-p003","section":"chapter-037","block":"b-b4df90ce100c9bd6749b","layer":"pei","quote":"﹝三﹞蒋济《万机论》云“许子将褒贬不平，以拔樊子昭而抑许文休”。刘晔曰：“子昭拔自贾竖，年至耳顺，退能守静，进能不苟。”济答曰：“子昭诚自长幼完洁；然观其插齿牙，树颊胲，吐唇吻，自非文休敌也！”胲音改。","attribution":"蒋济《万机论》","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":24,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-e45409c6e27ebe6dfef9","start":0,"end":101,"offset_unit":"unicode_code_point"},{"id":"pangfa-q-p012","section":"chapter-037","block":"b-3aa125fc091356e842bd","layer":"pei","quote":"臣松之以为：郭隗非贤，犹以权计蒙宠；况文休名声夙著，天下谓之英伟？虽末年有瑕，而事不彰彻；若不加礼，何以释远近之惑乎？法正以靖方隗，未为不当；而盛以封墓式闾为难，何其迂哉！然则燕昭亦非，岂唯刘翁？至于友于不穆，失由子将；寻蒋济之论，知非文休之尤。盛又讥其受任非所，将谓仕于董卓。卓初秉政，显擢贤俊，受其策爵者，森然皆是。文休为选官，在卓未至之前；后迁中丞，不为超越。以此为贬，则荀爽、陈纪之俦，皆应摈弃于世矣。","attribution":"裴松之按","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":188,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c48e466d91b18972d6e3","start":0,"end":205,"offset_unit":"unicode_code_point"},{"id":"wudi-e-p010a-q","section":"chapter-001","block":"b-d52f4a808aa2fd44a80c","layer":"pei","quote":"《世语》曰：“玄谓太祖曰：‘君未有名，可交许子将。’太祖乃造子将。子将纳焉，由是知名。”","attribution":"《世语》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":35,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4b0db760310d0caa5fad","start":0,"end":44,"offset_unit":"unicode_code_point"},{"id":"wudi-e-p011c-q","section":"chapter-001","block":"b-d59dedd4570c7b96c5b1","layer":"pei","quote":"尝问许子将：‘我何如人？’子将不答。固问之，子将曰：‘子治世之能臣，乱世之奸雄。’太祖大笑。","attribution":"《异同杂语》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":36,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4b0db760310d0caa5fad","start":88,"end":134,"offset_unit":"unicode_code_point"},{"id":"wudi-q-p010","section":"chapter-001","block":"b-d52f4a808aa2fd44a80c","layer":"pei","quote":"《世语》曰：“玄谓太祖曰：‘君未有名，可交许子将。’太祖乃造子将。子将纳焉，由是知名。”","attribution":"《世语》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":35,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4b0db760310d0caa5fad","start":0,"end":44,"offset_unit":"unicode_code_point"},{"id":"wudi-q-p011","section":"chapter-001","block":"b-d59dedd4570c7b96c5b1","layer":"pei","quote":"孙盛《异同杂语》云：“太祖尝私入中常侍张让室，让觉之。乃舞手戟于庭，逾垣而出。才武绝人，莫之能害。博览群书，特好兵法。抄集诸家兵法，名曰《接要》；又注《孙武》十三篇：皆传于世。尝问许子将：‘我何如人？’子将不答。固问之，子将曰：‘子治世之能臣，乱世之奸雄。’太祖大笑。”","attribution":"《异同杂语》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":36,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4b0db760310d0caa5fad","start":0,"end":135,"offset_unit":"unicode_code_point"},{"id":"xunyu-e-p003a-q","section":"chapter-010","block":"b-b3af7d5b7883950a1fbb","layer":"pei","quote":"皇甫谧《逸士传》：“或问许子将：‘靖与爽，孰贤？’子将曰：‘二人皆玉也；慈明外朗，叔慈内润。’”","attribution":"皇甫谧《逸士传》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":18,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c347ca05b53d613cd76d","start":0,"end":48,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-p003","section":"chapter-010","block":"b-b3af7d5b7883950a1fbb","layer":"pei","quote":"皇甫谧《逸士传》：“或问许子将：‘靖与爽，孰贤？’子将曰：‘二人皆玉也；慈明外朗，叔慈内润。’”","attribution":"皇甫谧《逸士传》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":18,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c347ca05b53d613cd76d","start":0,"end":48,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-2df67c9c03fc9ba151e9","section":"chapter-049","block":"b-b11e4525d5674fad5f88","layer":"original","quote":"繇奔丹徒，﹝三﹞遂溯江，南保豫章〖19〗，驻彭泽","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":4,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":15,"end":39,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-382e6f977a0712f3a961","section":"chapter-049","block":"b-b11e4525d5674fad5f88","layer":"original","quote":"笮融先至，﹝四﹞杀太守朱皓，﹝五﹞入居郡中","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":4,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":44,"end":65,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-4b8d6f838864c80dc332","section":"chapter-049","block":"b-66f2d52fde94a20ba685","layer":"original","quote":"过杀礼，然后杀皓","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":7,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":84,"end":92,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-4db03b80e389942ef4cb","section":"chapter-049","block":"b-86c3957b244a59790263","layer":"pei","quote":"刘繇将奔会稽，许子将曰：‘会稽富实，策之所贪；且穷在海隅，不可往也！不如豫章：北连豫壤，西接荆州。若收合吏民，遣使贡献，与曹兖州相闻；虽有袁公路隔在其间，其人豺狼，不能久也。足下受王命，孟德、景升，必相救济！’繇从之","attribution":"裴注·袁宏汉纪","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":43,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-813d42bbf81ceec057f2","start":12,"end":120,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-8fb1a9cbe7fe3073806a","section":"chapter-049","block":"b-0352ce76d13020899e82","layer":"pei","quote":"许子将谓繇曰：‘笮融出军，不顾（命）名义者也！朱文明，善推诚以信人，宜使密防之","attribution":"裴注·献帝春秋","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":45,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f1c4a2446f35552ad79a","start":37,"end":76,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-b27d7ae93a6d72b0d0aa","section":"chapter-049","block":"b-0352ce76d13020899e82","layer":"pei","quote":"融到，果诈杀皓，代领郡事","attribution":"裴注·献帝春秋","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":45,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f1c4a2446f35552ad79a","start":78,"end":90,"offset_unit":"unicode_code_point"},{"id":"yaoci-q2-718668cce7d1cf0a4d6d","section":"chapter-049","block":"b-66f2d52fde94a20ba685","layer":"original","quote":"过杀礼，然后杀皓。","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":7,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":84,"end":93,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
