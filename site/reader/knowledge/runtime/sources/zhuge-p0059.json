"jfj-q0026","jfj-q0181","jfj-q0028","jfj-q0235","jfj-q0234","jfj-q0236","erfei-q-cddd39659e699985209f","dongliu-q-6fabf95b59e11db33ff6","dongliu-q-c94f732dc1d885c5ca38","dongliu-q-4bc6ed2bf3925b9314e5","dongliu-q-bab4eba5dad6b893430a","dongliu-q-e3d89b1a3c22e0045d9b","huowang-q-619c5e05ee785e9ee234","duzhou-q-3b9f7be8cfe87c04d56b"],"facts":[],"aliases":[],"mentions":[{"id":"zhuge-m-p051-zhuge-p0059","kind":"mention","text":"文中提及","evidence":["zhuge-q-p051"]},{"id":"zhuge-m-o089-zhuge-p0059","kind":"mention","text":"文中提及","evidence":["zhuge-q-o089"]},{"id":"zhuge-m-p054-zhuge-p0059","kind":"mention","text":"文中提及","evidence":["zhuge-q-p054"]},{"id":"houzhu-m-houzhu-q-O070-zhuge-p0059","kind":"mention","text":"文中提及","evidence":["houzhu-q-O070"]},{"id":"jfj-m-o048-zhuge-p0059","kind":"mention","text":"本段记载：黄皓欲废姜维而立阎宇","evidence":["jfj-q0026"]},{"id":"jfj-m-o049-zhuge-p0059","kind":"mention","text":"本段记载：黄皓信巫说请刘禅搁置姜维奏议","evidence":["jfj-q0028"]},{"id":"jfj-m-p012-zhuge-p0059","kind":"mention","text":"本段记载：刘禅命黄皓向姜维谢罪","evidence":["jfj-q0234"]}]}],"evidence":[{"id":"dongliu-q-4bc6ed2bf3925b9314e5","section":"chapter-039","block":"b-d1c4b34bb5398cc83d22","layer":"original","quote":"祗死后，皓从黄门令，为中常侍、奉车都尉〖2〗，操弄威柄，终至覆国","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":188,"anchor":null},"note_id":null,"start":25,"end":57},{"id":"dongliu-q-6fabf95b59e11db33ff6","section":"chapter-039","block":"b-41e87ca4801badabc2ea","layer":"original","quote":"允常上则正色匡主〖15〗，下则数责于皓；皓畏允，不敢为非","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":153,"anchor":null},"note_id":null,"start":31,"end":59},{"id":"dongliu-q-bab4eba5dad6b893430a","section":"chapter-039","block":"b-d1c4b34bb5398cc83d22","layer":"original","quote":"及邓艾至蜀，闻皓奸险，收闭〖3〗，将杀之；而皓厚赂艾左右，得免","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":188,"anchor":null},"note_id":null,"start":66,"end":97},{"id":"dongliu-q-c94f732dc1d885c5ca38","section":"chapter-039","block":"b-d1c4b34bb5398cc83d22","layer":"original","quote":"陈祗代允为侍中，与黄皓互相表里〖1〗；皓始预政事","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":188,"anchor":null},"note_id":null,"start":0,"end":24},{"id":"dongliu-q-e3d89b1a3c22e0045d9b","section":"chapter-039","block":"b-68451c2ed7a8a7585594","layer":"original","quote":"自祗之有宠，后主追怨允日深，谓为自轻〖14〗；由祗媚兹一人，皓构间浸润故耳","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":192,"anchor":null},"note_id":null,"start":0,"end":37},{"id":"dongliu-q2-f5a5fb1b5a0007c46c35","section":"chapter-039","block":"b-d1c4b34bb5398cc83d22","layer":"original","quote":"陈祗代允为侍中，与黄皓互相表里〖1〗；皓始预政事。祗死后，皓从黄门令，为中常侍、奉车都尉〖2〗，操弄威柄，终至覆国。蜀人无不追思允。及邓艾至蜀，闻皓奸险，收闭〖3〗，将杀之；而皓厚赂艾左右，得免。","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":188,"anchor":null},"note_id":null,"start":0,"end":98},{"id":"duzhou-q-3b9f7be8cfe87c04d56b","section":"chapter-042","block":"b-5e754a66b65a0d22ce89","layer":"original","quote":"自在内职〖12〗，与宦人黄皓比屋周旋〖13〗，经三十年。皓从微至贵，操弄威权；正既不为皓所爱，亦不为皓所憎。是以官不过六百石〖14〗，而免于忧患","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":367,"anchor":null},"note_id":null,"start":0,"end":72},{"id":"erfei-q-cddd39659e699985209f","section":"chapter-034","block":"b-f32c94405104cd60952a","layer":"original","quote":"皓既信任用事〖12〗，谮构永于后主","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":62,"anchor":null},"note_id":null,"start":21,"end":38},{"id":"houzhu-q-O070","section":"chapter-033","block":"b-2716021d4754d2fb64f1","layer":"original","quote":"景耀元年〖1〗，姜维还成都。史官言景星现〖2〗，于是大赦，改年。宦人黄皓始专政〖3〗。吴大将军孙綝废其主亮〖4〗，立琅邪王休〖5〗。","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":146,"anchor":null},"note_id":null,"start":0,"end":66},{"id":"huowang-q-619c5e05ee785e9ee234","section":"chapter-041","block":"b-4dcb6200f55cc020b124","layer":"pei","quote":"时黄皓预政，众多附之，宪独不与同；皓恚，左迁巴东太守","attribution":"裴注·襄阳记","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":25,"anchor":null},"note_id":"n-c480ade0f0913bd6d1da","start":82,"end":108},{"id":"jfj-q0026","section":"chapter-044","block":"b-7dd0b4702f1410f9e19f","layer":"original","quote":"五年〖7〗，维率众出（汉）侯和；为邓艾所破，还住沓中。维本羁旅托国，累年攻战，功绩不立；而宦官黄皓等弄权于内，右大将军阎宇与皓协比〖8〗，而皓阴欲废维树宇。维亦疑之，故自危惧，不复还成都。﹝一﹞","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":216,"anchor":null},"note_id":null,"start":0,"end":97},{"id":"jfj-q0028","section":"chapter-044","block":"b-6e2f890762325a17fefa","layer":"original","quote":"六年〖1〗，维表后主：“闻钟会治兵关中，欲规进取；宜并遣张翼、廖化督诸军，分护阳安关口、阴平桥头，以防未然〖2〗。”皓征信鬼巫〖3〗，谓敌终不自致；启后主寝其事〖4〗，而群臣不知。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":228,"anchor":null},"note_id":null,"start":0,"end":90},{"id":"jfj-q0029","section":"chapter-044","block":"b-244c42d136c1fc518809","layer":"modern","quote":"〖1〗六年：景耀六年（公元 263）。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":236,"anchor":null},"note_id":"n-07b5919ab8c7edcb2376","start":0,"end":19},{"id":"jfj-q0179","section":"chapter-044","block":"b-7dd0b4702f1410f9e19f","layer":"original","quote":"而宦官黄皓等弄权于内，右大将军阎宇与皓协比〖8〗，而皓阴欲废维树宇。维亦疑之，故自危惧，不复还成都。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":216,"anchor":null},"note_id":null,"start":44,"end":94},{"id":"jfj-q0181","section":"chapter-044","block":"b-6e2f890762325a17fefa","layer":"original","quote":"皓征信鬼巫〖3〗，谓敌终不自致；启后主寝其事〖4〗，而群臣不知。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":228,"anchor":null},"note_id":null,"start":58,"end":90},{"id":"jfj-q0234","section":"chapter-044","block":"b-c0266db4bcde577eb422","layer":"pei","quote":"﹝一﹞《华阳国志》曰：“维恶黄皓恣擅，启后主欲杀之。后主曰：‘皓趋走小臣耳！往董允切齿，吾常恨之，君何足介意！’维见皓枝附叶连，惧于失言，逊辞而出。后主敕皓诣维陈谢；维说皓求沓中种麦，以避内逼耳。”","attribution":"《华阳国志》","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":227,"anchor":null},"note_id":"n-22ccaba798fe6d967677","start":0,"end":99},{"id":"jfj-q0235","section":"chapter-044","block":"b-c0266db4bcde577eb422","layer":"pei","quote":"后主敕皓诣维陈谢","attribution":"《华阳国志》","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":227,"anchor":null},"note_id":"n-22ccaba798fe6d967677","start":74,"end":82},{"id":"jfj-q0236","section":"chapter-044","block":"b-c0266db4bcde577eb422","layer":"pei","quote":"维说皓求沓中种麦，以避内逼耳。","attribution":"《华阳国志》","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":227,"anchor":null},"note_id":"n-22ccaba798fe6d967677","start":83,"end":98},{"id":"zhuge-q-o089","section":"chapter-035","block":"b-8ad10299db2621d1c503","layer":"original","quote":"自瞻、厥、建统事，姜维常征伐在外，宦人黄皓窃弄机柄；咸共将护〖8〗，无能匡矫，﹝二﹞然建特不与皓和好往来。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":438,"anchor":null},"note_id":null,"start":0,"end":53},{"id":"zhuge-q-p051","section":"chapter-035","block":"b-c5be87db262322a80088","layer":"pei","quote":"﹝二﹞干宝曰：“瞻虽智不足以扶危，勇不足以拒敌；而能外不负国，内不改父之志：忠孝存焉。”《华阳国志》曰：“尚叹曰：‘父子荷国重恩，不早斩黄皓，以至倾败。用生何为！’乃驰赴魏军而死。”","attribution":"干宝论及《华阳国志》","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":435,"anchor":null},"note_id":"n-772b60847930376be7c7","start":0,"end":91},{"id":"zhuge-q-p054","section":"chapter-035","block":"b-c757579021f8983017ea","layer":"pei","quote":"﹝二﹞孙盛《异同记》曰：“瞻、厥等以维好战无功，国内疲弊；宜表后主，召还为益州刺史，夺其兵权。蜀长老犹有瞻表‘以阎宇代维’故事。晋永和三年，蜀史常璩说蜀长老云：‘陈寿尝为瞻吏，为瞻所辱；故因此事归恶黄皓，而云瞻不能匡矫也。’”","attribution":"孙盛《异同记》","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":453,"anchor":null},"note_id":"n-728adfc2b17d8d199f48","start":0,"end":113}],"profiles":{"zhuge-p0059":{"fields":[],"directory":{"faction":"shu"}}},"directory_counts":{}}
