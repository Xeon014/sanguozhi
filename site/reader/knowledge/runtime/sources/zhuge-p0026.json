{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhuge-e-o023a","title":"诸葛亮南征秋平南中备军资治戎","accounts":[{"id":"zhuge-e-o023a-account","label":"《诸葛亮传第五》正文","text":"诸葛亮南征秋平南中备军资治戎","evidence":["zhuge-e-o023a-q"]},{"id":"houzhu-a-cd09cc27d7c3","label":"《后主传》正文","text":"三年春三月，丞相亮南征四郡〖2〗，四郡皆平。改益州郡为建宁郡；分建宁、永昌郡为云南郡〖3〗；又分建宁、牂牁为兴古郡〖4〗。","evidence":["houzhu-q-O011"]},{"id":"houzhu-a-4be5073bc57a","label":"《后主传》正文","text":"十二月，亮还成都。","evidence":["houzhu-q-O012"]},{"id":"liuermu-a-4afa64d994032532ec41","label":"正文","text":"诸葛亮平南土","evidence":["liuermu-q-74c22b7e2a9d68bbb6e6"]},{"id":"dongliu-a-46c6b794eff2c6b27fe7","label":"裴注·襄阳记","text":"诸葛亮建兴三年征南中","evidence":["dongliu-q-e2c33f6fff716105c8c6"]},{"id":"dongliu-a-02cc262a250d7ab1640e","label":"裴注·襄阳记","text":"诸葛亮纳策赦孟获服南方","evidence":["dongliu-q-eb0b210fd16e9b4d714b"]},{"id":"huangli-a-702963f01a4ed94939d9","label":"正文","text":"诸葛亮南征先由越嶲","evidence":["huangli-q-6468462c5c9ba31b69b4"]},{"id":"huangli-a-5f4e1fdf9e62c6a816f5","label":"正文","text":"李恢向建宁被围昆泽","evidence":["huangli-q-e3ccf28eaf60b6787884"]},{"id":"huangli-a-9a24d5475d2059342dba","label":"正文","text":"李恢绐南人缓围守","evidence":["huangli-q-b5114bce442112fd9e76"]},{"id":"huangli-a-2c5e60e64ed818ef9a9f","label":"正文","text":"李恢出击大破南人","evidence":["huangli-q-4639de401721810ce6f4"]},{"id":"huangli-a-bab60bf8428c500b5743","label":"正文","text":"诸葛亮南征","evidence":["huangli-q-719f26aa2be89e5fdfc4"]},{"id":"huangli-a-50aacb7fbbc358afda51","label":"正文","text":"雍闿为高定部曲所杀","evidence":["huangli-q-8607804c6bf08d8f9001"]},{"id":"huowang-a-67657a9f3df20234f4e9","label":"正文","text":"向朗留统后事","evidence":["huowang-q-8f424ee850969da203c7"]},{"id":"huowang-a-490314c99ac4e6f8e34b","label":"正文","text":"费诗随亮南行","evidence":["huowang-q-9418f38e1a330c9a23fd"]},{"id":"dengzhang-a-cb17314a87967fd237ca","label":"正文","text":"亮南征留李邵为治中","evidence":["dengzhang-q-d5dbd61162ffdc44a5c9"]},{"id":"dengzhang-a-b5d5860a45d4a1b4cacc","label":"正文","text":"龚禄南征遇害","evidence":["dengzhang-q-b6ceaebbb6880816a85d"]},{"id":"dengzhang-a-dc5c9d9bf11fae034aa4","label":"正文","text":"王士南行遇害","evidence":["dengzhang-q-473b0c9081b5da467bd8"]}],"participants":[{"person":"zhuge-liang","role":"征讨","evidence":["zhuge-e-o023a-q"]},{"person":"zhuge-p0026","role":"被赦以服南方者","evidence":["dongliu-q-eb0b210fd16e9b4d714b"]},{"person":"huangli-p0016","role":"案道向建宁，诸县纠合围其军于昆（明）〔泽〕；众少敌倍，绐谓南人官军粮尽欲规退还，欲同计谋；出击大破之，追奔逐北，南至盘江，东接牂牁，与亮声势相连","evidence":["huangli-q-e3ccf28eaf60b6787884","huangli-q-b5114bce442112fd9e76","huangli-q-4639de401721810ce6f4"]},{"person":"mingdi-p0069","role":"其部曲杀雍闿","evidence":["huangli-q-8607804c6bf08d8f9001"]},{"person":"houzhu-p0022","role":"为高定部曲所杀","evidence":["huangli-q-8607804c6bf08d8f9001"]},{"person":"liuliao-p0019","role":"留统后事","evidence":["huowang-q-8f424ee850969da203c7"]},{"person":"huowang-p0030","role":"随诸葛亮南行，归至汉阳县","evidence":["huowang-q-9418f38e1a330c9a23fd"]},{"person":"shu8-p-lishao-yongnan","role":"受留为治中从事","evidence":["dengzhang-q-d5dbd61162ffdc44a5c9"]},{"person":"huangli-p0039","role":"随丞相亮南征，为蛮夷所害，时年三十一","evidence":["dengzhang-q-b6ceaebbb6880816a85d"]},{"person":"dengzhang-p0043","role":"会丞相亮南征转为益州太守，将南行，为蛮夷所害","evidence":["dengzhang-q-473b0c9081b5da467bd8"]}],"place":null,"time":{"year":225,"label":"建兴三年春至秋","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"zhuge-y225","dating_review":{"reviewed":true,"anchor":"zhuge-q-o023","basis":"建兴三年春至秋"},"evidence":["zhuge-e-o023a-q","zhuge-q-o023","zhuge-q-b-28bd067e0a3e898385bc"]},"ordering_evidence":"zhuge-e-o023a-q","source_order":[35,134,"O023a"],"order":6782},{"id":"zhuge-e-p023a","title":"汉晋春秋记诸葛亮七擒纵孟获至滇池","accounts":[{"id":"zhuge-e-p023a-account","label":"《汉晋春秋》","text":"汉晋春秋记诸葛亮七擒纵孟获至滇池","evidence":["zhuge-e-p023a-q"]}],"participants":[{"person":"zhuge-liang","role":"征讨释俘","evidence":["zhuge-e-p023a-q"]},{"person":"zhuge-p0026","role":"被擒归服","evidence":["zhuge-e-p023a-q"]}],"place":null,"time":{"label":"南征南中时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["zhuge-e-p023a-q"]},"ordering_evidence":"zhuge-e-p023a-q","source_order":[35,152,"P023a"],"order":6785}],"persons":[{"id":"zhuge-p0026","name":"孟获","evidence":["zhuge-q-p023","dongliu-q-eb0b210fd16e9b4d714b"],"facts":[],"aliases":[],"mentions":[{"id":"zhuge-m-p023-zhuge-p0026","kind":"mention","text":"文中提及","evidence":["zhuge-q-p023"]}]}],"evidence":[{"id":"dengzhang-q-473b0c9081b5da467bd8","section":"chapter-045","block":"b-521fa654b482befdc310","layer":"original","quote":"会丞相亮南征，转为益州太守。将南行，为蛮夷所害","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":327,"anchor":null},"note_id":null,"start":61,"end":84},{"id":"dengzhang-q-b6ceaebbb6880816a85d","section":"chapter-045","block":"b-5c28c096b533dff59f06","layer":"original","quote":"随丞相亮南征，为蛮夷所害，时年三十一","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":326,"anchor":null},"note_id":null,"start":42,"end":60},{"id":"dengzhang-q-d5dbd61162ffdc44a5c9","section":"chapter-045","block":"b-b45992c9c1a17284dbab","layer":"original","quote":"亮南征，留邵为治中从事","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":321,"anchor":null},"note_id":null,"start":40,"end":51},{"id":"dongliu-q-e2c33f6fff716105c8c6","section":"chapter-039","block":"b-4f59a98859b4f475164b","layer":"pei","quote":"建兴三年，亮征南中","attribution":"裴注·襄阳记","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":110,"anchor":null},"note_id":"n-b2f83c142b53ed7a6593","start":11,"end":20},{"id":"dongliu-q-eb0b210fd16e9b4d714b","section":"chapter-039","block":"b-4f59a98859b4f475164b","layer":"pei","quote":"亮纳其策，赦孟获以服南方","attribution":"裴注·襄阳记","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":110,"anchor":null},"note_id":"n-b2f83c142b53ed7a6593","start":163,"end":175},{"id":"houzhu-q-O011","section":"chapter-033","block":"b-354a0a35bf9887aa11d1","layer":"original","quote":"三年春三月，丞相亮南征四郡〖2〗，四郡皆平。改益州郡为建宁郡；分建宁、永昌郡为云南郡〖3〗；又分建宁、牂牁为兴古郡〖4〗。","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":35,"anchor":null},"note_id":null,"start":0,"end":61},{"id":"houzhu-q-O012","section":"chapter-033","block":"b-3529bcb2e8097984bcb5","layer":"original","quote":"十二月，亮还成都。","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":36,"anchor":null},"note_id":null,"start":0,"end":9},{"id":"huangli-q-4639de401721810ce6f4","section":"chapter-043","block":"b-e11f9e586959d73e2f0d","layer":"original","quote":"于是恢出击，大破之；追奔逐北，南至盘江〖19〗，东接牂牁，与亮声势相连","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":59,"anchor":null},"note_id":null,"start":170,"end":205},{"id":"huangli-q-6468462c5c9ba31b69b4","section":"chapter-043","block":"b-e11f9e586959d73e2f0d","layer":"original","quote":"丞相亮南征，先由越嶲","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":59,"anchor":null},"note_id":null,"start":32,"end":42},{"id":"huangli-q-719f26aa2be89e5fdfc4","section":"chapter-043","block":"b-1f594d574238f76d3965","layer":"original","quote":"及丞相亮南征讨阉，既发在道","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":93,"anchor":null},"note_id":null,"start":18,"end":31},{"id":"huangli-q-8607804c6bf08d8f9001","section":"chapter-043","block":"b-1f594d574238f76d3965","layer":"original","quote":"而闿已为高定部曲所杀","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":93,"anchor":null},"note_id":null,"start":32,"end":42},{"id":"huangli-q-b5114bce442112fd9e76","section":"chapter-043","block":"b-e11f9e586959d73e2f0d","layer":"original","quote":"时恢众少敌倍，又未得亮声息，绐谓南人曰〖15〗：“官军粮尽，欲规退还〖16〗；吾中间久斥乡里〖17〗，乃今得旋〖18〗，不能复北；欲还与汝等同计谋，故以诚相告。”南人信之，故围守怠缓","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":59,"anchor":null},"note_id":null,"start":78,"end":169},{"id":"huangli-q-e3ccf28eaf60b6787884","section":"chapter-043","block":"b-e11f9e586959d73e2f0d","layer":"original","quote":"而恢案道向建宁〖13〗，诸县大相纠合，围恢军于昆（明）〔泽〕","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":59,"anchor":null},"note_id":null,"start":43,"end":73},{"id":"huowang-q-8f424ee850969da203c7","section":"chapter-041","block":"b-5008b9b7cd23cd6b1641","layer":"original","quote":"丞相亮南征，朗留统后事","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":38,"anchor":null},"note_id":null,"start":20,"end":31},{"id":"huowang-q-9418f38e1a330c9a23fd","section":"chapter-041","block":"b-0331bba35be1e9a1beba","layer":"original","quote":"建兴三年，随诸葛亮南行，归至汉阳县","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":172,"anchor":null},"note_id":null,"start":0,"end":17},{"id":"liuermu-q-74c22b7e2a9d68bbb6e6","section":"chapter-031","block":"b-2a7eb34fd683676ae1b4","layer":"original","quote":"丞相诸葛亮平南土","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":75,"anchor":null},"note_id":null,"start":41,"end":49},{"id":"zhuge-e-o023a-q","section":"chapter-035","block":"b-862592827af5abe9feb3","layer":"original","quote":"三年春〖10〗，亮率众南征〖11〗。﹝三﹞其秋，悉平：军资所出〖12〗，国以富饶；﹝四﹞乃治戎讲武，以俟大举。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":133,"anchor":null},"note_id":null,"start":0,"end":55},{"id":"zhuge-e-p023a-q","section":"chapter-035","block":"b-46040a6f26155eb35632","layer":"pei","quote":"亮至南中，所在战捷。闻孟获者，为夷、汉所服，募生致之。既得，使观于营阵之间，问曰：‘此军何如？’获对曰：‘向者不知虚实，故败；今蒙赐观看营阵，若只如此，即定易胜耳！’亮笑，纵使更战。七纵七擒，而亮犹遣获；获止不去，曰：‘公，天威也！南人不复反矣。’遂至滇池。","attribution":"《汉晋春秋》","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":151,"anchor":null},"note_id":"n-a267b4d3364ab826d9c6","start":12,"end":141},{"id":"zhuge-q-b-28bd067e0a3e898385bc","section":"chapter-035","block":"b-28bd067e0a3e898385bc","layer":"modern","quote":"〖10〗三年：建兴三年（公元 225）。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":144,"anchor":null},"note_id":"n-d52302c7e46aff00f085","start":0,"end":20},{"id":"zhuge-q-o023","section":"chapter-035","block":"b-862592827af5abe9feb3","layer":"original","quote":"三年春〖10〗，亮率众南征〖11〗。﹝三﹞其秋，悉平：军资所出〖12〗，国以富饶；﹝四﹞乃治戎讲武，以俟大举。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":133,"anchor":null},"note_id":null,"start":0,"end":55},{"id":"zhuge-q-p023","section":"chapter-035","block":"b-46040a6f26155eb35632","layer":"pei","quote":"﹝四﹞《汉晋春秋》曰：“亮至南中，所在战捷。闻孟获者，为夷、汉所服，募生致之。既得，使观于营阵之间，问曰：‘此军何如？’获对曰：‘向者不知虚实，故败；今蒙赐观看营阵，若只如此，即定易胜耳！’亮笑，纵使更战。七纵七擒，而亮犹遣获；获止不去，曰：‘公，天威也！南人不复反矣。’遂至滇池。南中平，皆即其渠率而用之。或以谏亮，亮曰：‘若留外人，则当留兵；兵留，则无所食。一不易也；加夷新伤破，父兄死丧；留外人而无兵者，必成祸患。二不易也；又夷累有废杀之罪，自嫌衅重；若留外人，终不相信。三不易也。今吾欲使不留兵，不运粮；而纲纪粗定，夷、汉粗安，故耳。’”","attribution":"《汉晋春秋》","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":151,"anchor":null},"note_id":"n-a267b4d3364ab826d9c6","start":0,"end":273}],"profiles":{},"directory_counts":{}}
