{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"houzhu-e-o024a","title":"李平被废并迁往梓潼郡","accounts":[{"id":"houzhu-a-fc4251810314","label":"《后主传》正文","text":"秋八月，都护李平废徙梓潼郡。〖11〗﹝二﹞","evidence":["houzhu-q-O024"]},{"id":"liuliao-a-da9d774cab8fe6f1a875","label":"正文","text":"废平为民徙梓潼郡","evidence":["liuliao-q-c6e6f60db0bf0cbc289a"]},{"id":"liuliao-a-bb67d06d19382b1654b5","label":"裴注·诸葛亮公文上尚书","text":"诸葛亮与诸将议解李平任免官削爵","evidence":["liuliao-q-b30598f2b6891fcd098f"]},{"id":"dongliu-a-51838896e6cd6f853d65","label":"正文","text":"都护李平坐诬罔废","evidence":["dongliu-q-9b1b42eb9b3cad1c7740"]}],"participants":[{"person":"houzhu-p0023","role":"被废迁者","evidence":["houzhu-q-O024"]},{"person":"xianzhu-p0057","role":"废为民徙梓潼郡；公文议免官削爵者","evidence":["liuliao-q-c6e6f60db0bf0cbc289a","liuliao-q-b30598f2b6891fcd098f"]},{"person":"zhuge-liang","role":"联署上尚书议解李平任","evidence":["liuliao-q-b30598f2b6891fcd098f"]},{"person":"liuliao-p0002","role":"联署上尚书议解李平任","evidence":["liuliao-q-b30598f2b6891fcd098f"]},{"person":"xianzhu-p0091","role":"联署上尚书议解李平任","evidence":["liuliao-q-b30598f2b6891fcd098f"]},{"person":"liuliao-p0023","role":"联署上尚书议解李平任","evidence":["liuliao-q-b30598f2b6891fcd098f"]},{"person":"xianzhu-p0056","role":"联署上尚书议解李平任","evidence":["liuliao-q-b30598f2b6891fcd098f"]},{"person":"zhuge-p0042","role":"联署上尚书议解李平任","evidence":["liuliao-q-b30598f2b6891fcd098f"]},{"person":"xianzhu-p0118","role":"联署上尚书议解李平任","evidence":["liuliao-q-b30598f2b6891fcd098f"]},{"person":"zhuge-p0045","role":"联署上尚书议解李平任","evidence":["liuliao-q-b30598f2b6891fcd098f"]},{"person":"guanzhang-p0046","role":"联署上尚书议解李平任","evidence":["liuliao-q-b30598f2b6891fcd098f"]},{"person":"liuliao-p0024","role":"联署上尚书议解李平任","evidence":["liuliao-q-b30598f2b6891fcd098f"]},{"person":"shaodi-p0051","role":"联署上尚书议解李平任","evidence":["liuliao-q-b30598f2b6891fcd098f"]},{"person":"liuliao-p0025","role":"联署上尚书议解李平任","evidence":["liuliao-q-b30598f2b6891fcd098f"]},{"person":"liuliao-p0026",