{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"shaodi-e-o131a","title":"诏录应余孙应伦为吏以酬死节","accounts":[{"id":"shaodi-e-o131a-account","label":"《三少帝纪》正文","text":"诏录应余孙应伦为吏以酬死节","evidence":["shaodi-e-o131a-q"]}],"participants":[{"person":"shaodi-p0121","role":"被录用","evidence":["shaodi-e-o131a-q"]}],"place":null,"time":{"year":258,"label":"六月丙子","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"shaodi-y258","dating_review":{"reviewed":true,"anchor":"shaodi-q-o129","basis":"六月丙子"},"evidence":["shaodi-e-o131a-q","shaodi-q-o129","shaodi-q-b-ee7d999da8e03b038d07"]},"ordering_evidence":"shaodi-e-o131a-q","source_order":[4,578,"O131a"],"order":1198}],"persons":[{"id":"shaodi-p0121","name":"应伦","evidence":["shaodi-q-o131"],"facts":[],"aliases":[],"mentions":[{"id":"shaodi-m-o131-shaodi-p0121","kind":"mention","text":"文中提及","evidence":["shaodi-q-o131"]}]}],"evidence":[{"id":"shaodi-e-o131a-q","section":"chapter-004","block":"b-b757e5d43e0e9b9da4e8","layer":"original","quote":"六月，丙子〖14〗，诏曰：“昔南阳郡山贼扰攘〖15〗，欲劫质故太守东里衮〖16〗。功曹应余独身捍衮〖17〗，遂免于难。余颠沛殒毙，杀身济君〖18〗。其下司徒〖19〗：署余孙伦吏〖20〗，使蒙伏节之报〖21〗”﹝一﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":577,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":107,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-b-ee7d999da8e03b038d07","section":"chapter-004","block":"b-ee7d999da8e03b038d07","layer":"modern","quote":"〖1〗三年：甘露三年（公元 258）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":582,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-663d9ce877d00f2d0cbc","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o129","section":"chapter-004","block":"b-b1abcd215d0c852fc17c","layer":"original","quote":"三年春二月〖1〗，大将军司马文王陷寿春城，斩诸葛诞。三月，诏曰：“古者克敌，收其尸以为京观〖2〗，所以惩昏逆而彰武功也。汉孝武元鼎中〖3〗，改桐乡为闻喜〖4〗，新乡为获嘉〖5〗，以著南越之亡〖6〗。大将军亲总六戎〖7〗，营据丘头〖8〗；内夷群凶〖9〗，外殄寇虏〖10〗；功济兆民，声振四海。克敌之地，宜有令名〖11〗：其改‘丘头’为‘武丘’。明以武平乱，后世不忘；亦京观、二邑之义也〖12〗”。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":575,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":197,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o131","section":"chapter-004","block":"b-b757e5d43e0e9b9da4e8","layer":"original","quote":"六月，丙子〖14〗，诏曰：“昔南阳郡山贼扰攘〖15〗，欲劫质故太守东里衮〖16〗。功曹应余独身捍衮〖17〗，遂免于难。余颠沛殒毙，杀身济君〖18〗。其下司徒〖19〗：署余孙伦吏〖20〗，使蒙伏节之报〖21〗”﹝一﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":577,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":107,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
