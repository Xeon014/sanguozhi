antizhu-q-271fd58ce4bc07876cf3","zhangyan-q-61e712ca788470dc2973","zhangyan-q-ca3f7c38b63c77810d65","zhangyan-q-6d4937229d8bffc66cd5","zhangyan-q-c9678ea7d6c040e49578","zhangyan-q-ceecdf0ce0f57e1a0303","zhangyan-q-ba2a0403be17fdc1d225","zhangyan-q-1b8b6a592abcf0cb7e0d"],"facts":[{"id":"zhangyan-f-68d232ac38ab9ccc93d9","text":"薛综之子","evidence":["zhangyan-q-ceecdf0ce0f57e1a0303"]}],"aliases":[],"mentions":[{"id":"zhangyan-m-dbd8423f152bd41fc03a","kind":"mention","text":"薛莹献诗称“珝忝千里，受命南征”","evidence":["zhangyan-q-ba2a0403be17fdc1d225"]},{"id":"zhangyan-m-718c742829da21aa46f1","kind":"mention","text":"本篇原文记及薛珝，具体行动与称谓见引文。","evidence":["zhangyan-q-1b8b6a592abcf0cb7e0d"]}]}],"evidence":[{"id":"santizhu-q-271fd58ce4bc07876cf3","section":"chapter-048","block":"b-0480c5aebff66afe1ffb","layer":"original","quote":"遣监军虞汜、威南将军薛珝、苍梧太守陶璜由荆州〖1〗；监军李勖、督军徐存从建安海道〖2〗：皆就合浦，击交阯","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":395,"anchor":null},"note_id":null,"start":21,"end":73},{"id":"santizhu059-q-c2924431d1b83ac07886","section":"chapter-059","block":"b-995b1add40ee3ea39b31","layer":"original","quote":"宝鼎二年七月，使守大匠薛珝营立寝堂〖16〗，号曰“清庙”。","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":192,"anchor":null},"note_id":null,"start":0,"end":29},{"id":"zhangyan-q-1b8b6a592abcf0cb7e0d","section":"chapter-053","block":"b-b721d57d10d8dea78ec3","layer":"pei","quote":"﹝一﹞《汉晋春秋》曰：“孙休时，珝为五官中郎将，遣至蜀，求马。及还，休问蜀政得失。对曰：‘主暗而不知其过，臣下容身以求免罪；入其朝不闻正言，经其野民皆菜色。臣闻燕雀处堂，子母相乐，自以为安也；突决栋焚，而燕雀怡然不知祸之将及：其是之谓乎！’”","attribution":"裴注·汉晋春秋","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":329,"anchor":null},"note_id":"n-5539dc11ff2063bc564e","start":0,"end":121},{"id":"zhangyan-q-61e712ca788470dc2973","section":"chapter-053","block":"b-606cc23ede6891780b6d","layer":"original","quote":"官至威南将军","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":282,"anchor":null},"note_id":null,"start":3,"end":9},{"id":"zhangyan-q-6d4937229d8bffc66cd5","section":"chapter-053","block":"b-b721d57d10d8dea78ec3","layer":"pei","quote":"孙休时，珝为五官中郎将，遣至蜀，求马","attribution":"裴注·汉晋春秋","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":329,"anchor":null},"note_id":"n-5539dc11ff2063bc564e","start":12,"end":30},{"id":"zhangyan-q-ba2a0403be17fdc1d225","section":"chapter-053","block":"b-87bc0413c09c4df6d1f4","layer":"original","quote":"惟臣之先，昔仕于汉；奕世绵绵，颇涉台观〖4〗。暨臣父综〖5〗，遭时之难，卯金失御〖6〗，邦家毁乱。适兹乐土〖7〗，庶存孑遗〖8〗；天启其心，东南是归。厥初流隶，困于蛮垂〖9〗；大皇开基〖10〗，恩德远施。特蒙招命，拯擢泥污〖11〗；释放巾褐〖12〗，受职剖符〖13〗。作守合浦，在海之隅；迁入京辇〖14〗，遂升机枢〖15〗。枯瘁更荣，绝统复纪；自微而显，非愿之始〖16〗。亦惟宠遇，心存足止〖17〗。重值文皇〖18〗，建号东宫〖19〗；乃作少傅，光华益隆。明明圣嗣〖20〗，至德谦崇；礼遇兼加，惟渥惟丰〖21〗。哀哀先臣〖22〗，念竭其忠；洪恩未报，委世以终〖23〗。嗟臣蔑贱〖24〗，惟昆及弟〖25〗；幸生幸育，托综遗体。过庭既训〖26〗，顽蔽难启。堂构弗克，志存耦耕〖27〗；岂悟圣朝，仁泽流盈。追录先臣，愍其无成；是济是拔〖28〗，被以殊荣。珝忝千里〖29〗，受命南征；旌旗备物，金革扬声〖30〗。及臣斯陋，实暗实微；既显前轨〖31〗，人物之机〖32〗；复傅东宫〖33〗，继世荷辉〖34〗；才不逮先〖35〗，是忝是违。乾德博好〖36〗，文雅是贵；追悼亡臣，冀存遗类。如何愚胤〖37〗，曾无仿佛〖38〗！瞻彼旧宠，顾此顽虚；孰能忍愧，臣实与居。夙夜反侧，克心自论；父子兄弟，累世蒙恩。死惟结草〖39〗，生誓投身〖40〗；虽则灰陨〖41〗，无报万分〖42〗！","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":284,"anchor":null},"note_id":null,"start":0,"end":580},{"id":"zhangyan-q-c9678ea7d6c040e49578","section":"chapter-053","block":"b-b721d57d10d8dea78ec3","layer":"pei","quote":"及还，休问蜀政得失。对曰：‘主暗而不知其过，臣下容身以求免罪；入其朝不闻正言，经其野民皆菜色。臣闻燕雀处堂，子母相乐，自以为安也；突决栋焚，而燕雀怡然不知祸之将及：其是之谓乎！’","attribution":"裴注·汉晋春秋","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":329,"anchor":null},"note_id":"n-5539dc11ff2063bc564e","start":31,"end":120},{"id":"zhangyan-q-ca3f7c38b63c77810d65","section":"chapter-053","block":"b-606cc23ede6891780b6d","layer":"original","quote":"征交阯还，道病死","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":282,"anchor":null},"note_id":null,"start":13,"end":21},{"id":"zhangyan-q-ceecdf0ce0f57e1a0303","section":"chapter-053","block":"b-606cc23ede6891780b6d","layer":"original","quote":"子珝，官至威南将军〖1〗。征交阯还，道病死。﹝一﹞珝弟莹，字道言。初为秘府中书郎〖2〗。孙休即位，为散骑中常侍。数年，以病去官。孙皓初，为左执法〖3〗。迁选曹尚书。及立太子，又领少傅。","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":282,"anchor":null},"note_id":null,"start":0,"end":92}],"profiles":{},"directory_counts":{}}
