07ac4754461167","hechang-q-d8d3f93d4bca23407c18","hechang-q-b50e187dc153cda8e7d0","hechang-q-b0272118e914decf4524","hechang-q-df0360188eb15cb6b190","hechang-q-ce167960a9463f624505","hechang-q-9011fb5d3e2f710ea9dc","hechang-q-68ec7e57456618d3eba0","hechang-q-3683fe94c507540d70df","hechang-q-2a4286e815bba6bd2d84","hechang-q-1188ff996c42502d1f4f","hechang-q-cf76a09822bd451350f0","hechang-q-e9c1e0ec20eed3cb78b6"],"facts":[{"id":"hechang-f-2cb03b26efa5093b98b1","text":"字子绪，颍川定陵人；曾祖父杜安，祖父杜根。","evidence":["hechang-q-e9c1e0ec20eed3cb78b6"]}],"aliases":[],"mentions":[{"id":"wudi-m-p112-wudi-p0312","kind":"mention","text":"文中提及","evidence":["wudi-q-p112"]},{"id":"wudi-m-p115-wudi-p0312","kind":"mention","text":"文中提及","evidence":["wudi-q-p115"]},{"id":"xunyu-m-p022-wudi-p0312","kind":"mention","text":"文中提及","evidence":["xunyu-q-p022"]},{"id":"xiahoucao-m-o077-wudi-p0312","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-o077"]}]}],"evidence":[{"id":"cuimao-q-1ca58c8c7c2a520497a4","section":"chapter-012","block":"b-b98fdf30cfe006001885","layer":"original","quote":"魏国既建，为尚书，复典选举","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":189,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":13,"offset_unit":"unicode_code_point"},{"id":"cuimao-q-b2a734b1eb1d9b8f59b5","section":"chapter-012","block":"b-744efc38dc3e2f2fb8f8","layer":"original","quote":"魏国初建，拜尚书","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":30,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":8,"offset_unit":"unicode_code_point"},{"id":"hechang-q-05b617a2a7f040355a16","section":"chapter-023","block":"b-ae0542736d690d2c2121","layer":"original","quote":"魏国既建，为侍中，与王粲、和洽并用。粲强识博闻〖7〗，故太祖游观出入，多得骖乘〖8〗；至其见敬，不及洽、袭。袭尝独见，至于夜半。粲性躁竞，起坐曰：“不知公对杜袭道何等也〖9〗？”洽笑答曰：“天下事岂有尽邪！卿昼侍可矣，悒悒于此，欲兼之乎？”","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":202,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":120,"offset_unit":"unicode_code_point"},{"id":"hechang-q-1188ff996c42502d1f4f","section":"chapter-023","block":"b-1750e0ef165003bcc330","layer":"original","quote":"诸葛亮出秦川〖3〗，大将军曹真督诸军拒亮；徙袭为大将军军师〖4〗，","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":240,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":12,"end":45,"offset_unit":"unicode_code_point"},{"id":"hechang-q-1d367c0f1fe57badfa6f","section":"chapter-023","block":"b-27ee7d8a4f3629e4b865","layer":"original","quote":"时夏侯尚昵于太子〖18〗，情好至密。袭谓尚非益友，不足殊待，以闻太祖。文帝初甚不悦，后乃追思。语在《尚传》。其柔而不犯〖19〗，皆此类也。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":218,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":69,"offset_unit":"unicode_code_point"},{"id":"hechang-q-22a9e707ac4754461167","section":"chapter-023","block":"b-5867790b83fae39dc1de","layer":"original","quote":"荀彧又荐袭，太祖以为丞相军祭酒〖6〗。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":201,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":16,"end":35,"offset_unit":"unicode_code_point"},{"id":"hechang-q-2a4286e815bba6bd2d84","section":"chapter-023","block":"b-5cc187723bc00b02d15c","layer":"original","quote":"夏侯渊为刘备所没〖4〗，军丧元帅，将士失色。袭与张郃、郭淮纠摄诸军事〖5〗，权宜以郃为督〖6〗，以一众心；三军遂定。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":215,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":66,"end":124,"offset_unit":"unicode_code_point"},{"id":"hechang-q-3683fe94c507540d70df","section":"chapter-023","block":"b-d77c538321c0f0f42217","layer":"original","quote":"薨，追赠少府，谥曰定侯。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":241,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":11,"end":23,"offset_unit":"unicode_code_point"},{"id":"hechang-q-372e1461831f38a8e0b6","section":"chapter-023","block":"b-db2bf67949cb8c374cea","layer":"original","quote":"赵俨字伯然，颍川阳翟人也〖1〗。避乱荆州，与杜袭、繁钦通财同计，合为一家。太祖始迎献帝都许，俨谓钦曰：“曹镇东应期命世〖2〗，必能匡济华夏；吾知归矣！”","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":247,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":76,"offset_unit":"unicode_code_point"},{"id":"hechang-q-4f0cf8b217a47ac4e500","section":"chapter-023","block":"b-b5536308805884c62209","layer":"pei","quote":"﹝一﹞《九州春秋》曰：“建安六年，刘表攻西鄂。西鄂长杜子绪，帅县男女婴城而守。时南阳功曹柏孝长，亦在城中，闻兵攻声，恐惧；入室闭户，牵被覆头。相攻半日，稍敢出面；其明，侧立而听。二日，往出户问消息。至四五日，乃更负盾亲斗，语子绪曰：‘勇，可习也！’”","attribution":"裴注·九州春秋","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":214,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-7dd499e6fc20cb5cfb7c","start":0,"end":125,"offset_unit":"unicode_code_point"},{"id":"hechang-q-68ec7e57456618d3eba0","section":"chapter-023","block":"b-d77c538321c0f0f42217","layer":"original","quote":"以疾征还，拜太中大夫。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":241,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":11,"offset_unit":"unicode_code_point"},{"id":"hechang-q-7cfc96ef72e9ccdf5dc5","section":"chapter-023","block":"b-02da3dc5a9fcffd414b2","layer":"original","quote":"袭避乱荆州，刘表待以宾礼。同郡繁钦数现奇于表〖3〗，袭喻之曰：“吾所以与子俱来者，徒欲龙蟠幽薮〖4〗，待时凤翔；岂谓刘牧当为拨乱之主〖5〗，而规长者委身哉〖6〗！子若现能不已，非吾徒也；吾其与子绝矣！”钦慨然曰：“请敬受命。”袭遂南适长沙。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":189,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":36,"end":156,"offset_unit":"unicode_code_point"},{"id":"hechang-q-8783398f1cbc493e1071","section":"chapter-023","block":"b-e26d64c527a4061328fc","layer":"original","quote":"太祖东还，当选留府长史〖7〗，镇守长安，主者所选多不当。太祖令曰：“释骐骥而不乘〖8〗，焉皇皇而更索〖9〗？”遂以袭为留府长史，驻关中〖10〗。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":216,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":72,"offset_unit":"unicode_code_point"},{"id":"hechang-q-8824e7fc565c1a4297a5","section":"chapter-023","block":"b-656d822cbb5f25881c91","layer":"original","quote":"会荆州出步骑万人来攻城，袭乃悉召县吏民任拒守者五十余人，与之要誓〖3〗；其亲戚在外欲自营护者，恣听遣出；皆叩头愿致死。于是身执矢石，率与戮力；吏民感恩，咸为用命，临阵斩数百级；而袭众死者三十余人，其余十八人尽被创〖4〗，贼得入城。袭帅伤痍吏民决围得出，死丧略尽，而无反背者。遂收散民，徙至摩陂营，吏民慕而从之如归。﹝一﹞","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":200,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":160,"offset_unit":"unicode_code_point"},{"id":"hechang-q-89190644c659cdb16aca","section":"chapter-023","block":"b-5867790b83fae39dc1de","layer":"original","quote":"司隶钟繇表拜议郎、参军事〖5〗。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":201,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":16,"offset_unit":"unicode_code_point"},{"id":"hechang-q-9011fb5d3e2f710ea9dc","section":"chapter-023","block":"b-1750e0ef165003bcc330","layer":"original","quote":"明帝即位，进封平阳乡侯。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":240,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":12,"offset_unit":"unicode_code_point"},{"id":"hechang-q-b0272118e914decf4524","section":"chapter-023","block":"b-9cb5951cf1bb3e4d5319","layer":"original","quote":"文帝即王位，赐爵关内侯。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":239,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":12,"offset_unit":"unicode_code_point"},{"id":"hechang-q-b263b6a625d1461b6b6d","section":"chapter-023","block":"b-930d403ea5efb5686a84","layer":"original","quote":"时将军许攸拥部曲〖11〗，不附太祖而有慢言〖12〗。太祖大怒，先欲伐之。群臣多谏：“可招怀攸，共讨强敌。”太祖横刀于膝，作色不听。袭入欲谏，太祖逆谓之曰：“吾计已定，卿勿复言！”袭曰：“若殿下计是邪，臣方助殿下成之；若殿下计非邪，虽成宜改之。殿下逆臣，令勿言之，何待下之不阐乎〖13〗？”太祖曰：“许攸慢吾，如何可置乎〖14〗！”袭曰：“殿下谓许攸何如人邪？”太祖曰：“凡人也。”袭曰：“夫惟贤知贤，惟圣知圣；凡人安能知非凡人邪？方今豺狼当路而狐狸是先〖15〗，人将谓殿下避强攻弱；进不为勇，退不为仁。臣闻千钧之弩不为鼷鼠发机〖16〗，万石之钟不以莛撞起音〖17〗；今区区之许攸，何足以劳神武哉？”太祖曰：“善！”遂厚抚攸，攸即归服。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":217,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":317,"offset_unit":"unicode_code_point"},{"id":"hechang-q-b50e187dc153cda8e7d0","section":"chapter-023","block":"b-5cc187723bc00b02d15c","layer":"original","quote":"太祖还，拜袭驸马都尉〖1〗，留督汉中军事。绥怀开导〖2〗，百姓自乐出徙洛、邺者〖3〗，八万余口。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":215,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":18,"end":66,"offset_unit":"unicode_code_point"},{"id":"hechang-q-ce167960a9463f624505","section":"chapter-023","block":"b-9cb5951cf1bb3e4d5319","layer":"original","quote":"更为督军粮执法〖2〗，入为尚书。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":239,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":32,"end":48,"offset_unit":"unicode_code_point"},{"id":"hechang-q-cf76a09822bd451350f0","section":"chapter-023","block":"b-1750e0ef165003bcc330","layer":"original","quote":"真薨，司马宣王代之；袭复为军师，增邑三百，并前五百五十户。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":240,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":57,"end":86,"offset_unit":"unicode_code_point"},{"id":"hechang-q-d8d3f93d4bca23407c18","section":"chapter-023","block":"b-5cc187723bc00b02d15c","layer":"original","quote":"后袭领丞相长史，随太祖到汉中讨张鲁。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":215,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":18,"offset_unit":"unicode_code_point"},{"id":"hechang-q-de85a5ba047f536cb816","section":"chapter-023","block":"b-3245a64fb30178ea2661","layer":"original","quote":"建安初，太祖迎天子都许。袭逃还乡里，太祖以为西鄂长〖1〗。县滨南境，寇贼纵横。时长吏皆敛民保城郭，不得农业；野荒民困，仓庾空虚。袭自知恩结于民，乃遣老弱各分散就田业，留丁强备守〖2〗；吏民欢悦。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":199,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":97,"offset_unit":"unicode_code_point"},{"id":"hechang-q-df0360188eb15cb6b190","section":"chapter-023","block":"b-9cb5951cf1bb3e4d5319","layer":"original","quote":"及践阼，为督军粮御史〖1〗，封武平亭侯","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":239,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":12,"end":31,"offset_unit":"unicode_code_point"},{"id":"hechang-q-e9c1e0ec20eed3cb78b6","section":"chapter-023","block":"b-02da3dc5a9fcffd414b2","layer":"original","quote":"杜袭字子绪，颍川定陵人也〖1〗。曾祖父安，祖父根〖2〗，著名前世。﹝一﹞袭避乱荆州，刘表待以宾礼。同郡繁钦数现奇于表〖3〗，袭喻之曰：“吾所以与子俱来者，徒欲龙蟠幽薮〖4〗，待时凤翔；岂谓刘牧当为拨乱之主〖5〗，而规长者委身哉〖6〗！子若现能不已，非吾徒也；吾其与子绝矣！”钦慨然曰：“请敬受命。”袭遂南适长沙。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":189,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":156,"offset_unit":"unicode_code_point"},{"id":"liusima-q-478b4e688807d9582709","section":"chapter-015","block":"b-ebe6e961a0acc51041fa","layer":"pei","quote":"亮后出祁山，答司马宣王书，使杜子绪宣意于公威也","attribution":"裴注·魏略","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":226,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-236f3205e9503042f77c","start":24,"end":47,"offset_unit":"unicode_code_point"},{"id":"wudi-e-p112a-q","section":"chapter-001","block":"b-9536581b8deb5e7104e4","layer":"pei","quote":"《魏书》载：“公令曰：‘夫受九锡，广开土宇，周公其人也。汉之异姓八王者，与高祖俱起布衣，创定王业，其功至大。吾何可比之？’前后三让。于是中军师、陵树亭侯荀攸，前军师、东武亭侯钟繇，左军师凉茂，右军师毛玠，平虏将军、华乡侯刘勋，建武将军、清苑亭侯刘若，伏波将军、高安侯夏侯惇，扬武将军、都亭侯王忠，奋威将军、乐乡侯（刘）〔邓〕展，建忠将军、昌乡亭侯鲜于辅，奋武将军、安国亭侯程昱，太中大夫、都乡侯贾诩，军师祭酒、千秋亭侯董昭，都亭侯薛洪，南乡亭侯董蒙，关内侯王粲、傅巽，祭酒王选、袁涣、王朗、张承、任藩、杜袭，中护军、国明亭侯曹洪，中领军、万岁亭侯韩浩，行骁骑将军、安平亭侯曹仁，领护军将军王图，长史万潜、谢奂、袁霸等，劝进曰：‘自古三代，胙臣以土；受命中兴，封秩辅佐。皆所以褒功赏德，为国藩卫也。往者天下崩乱，群凶豪起；颠越跋扈之险，不可忍言。明公奋身出命以徇其难，诛二袁篡盗之逆，灭黄巾贼乱之类，殄夷首逆，芟拨荒秽，沐浴霜露二十余年。书契以来，未有若此功者。昔周公承文、武之迹，受已成之业，高枕墨笔，拱揖群后，商、奄之勤，不过二年；吕望因三分有二之形，据八百诸侯之势，暂把旄钺，一时指麾：然皆大启土宇，跨州兼国。周公八子，并为侯伯：白牡骍刚，郊祀天地；典策备物，拟则王室。荣章宠盛如此之弘也。逮至汉兴，佐命之臣张耳、吴芮，其功至薄，亦连城开地，南面称孤。此皆明君达主行之于上，贤臣圣宰受之于下；三代令典，汉帝明制。今比劳则周、吕逸，计功则张、吴微，论制则齐、鲁重，言地则长沙多；然则魏国之封，九锡之荣，况于旧赏，犹怀玉而被褐也。且列侯、诸将，幸攀龙骥，得窃微劳，佩紫怀黄，盖以百数，亦将因此传之万世。而明公独辞赏于上，将使其下怀不自安。上违圣朝欢心，下失冠带至望；忘辅弼之大业，信匹夫之细行。攸等所大惧也！’于是公敕外为章，但受魏郡。攸等复曰：‘伏见魏国初封，圣朝发虑，稽谋群僚，然后策命；而明公久违上指，不即大礼。今既虔奉诏命，副顺众望；又欲辞多当少，让九受一。是犹汉朝之赏不行，而攸等之请未许也。昔齐、鲁之封，奄有东海；疆域井赋，四百万家；基隆业广，易以立功；故能成翼戴之勋，立一匡之绩。今魏国虽有十郡之名，犹减于曲阜；计其户数，不能参半：以藩卫王室，立垣树屏，犹未足也。且圣上览亡秦无辅之祸，惩曩日震荡之艰；托建忠贤，废坠是为。愿明公恭承帝命，无或拒违。’公乃受命。”","attribution":"《魏书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":262,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-97e94061646080072adf","start":0,"end":988,"offset_unit":"unicode_code_point"},{"id":"wudi-e-p115a-q","section":"chapter-001","block":"b-d31f474fc7e57ab9555e","layer":"pei","quote":"﹝二﹞《魏氏春秋》曰：“以荀攸为尚书令；凉茂为仆射；毛玠、崔琰、常林、徐奕、何夔为尚书；王粲、杜袭、卫觊、和洽为侍中。”","attribution":"《魏氏春秋》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":279,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-efecfa99851d5aa2b4e2","start":0,"end":60,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-b9d79988a2b2559f2bb5","section":"chapter-001","block":"b-b9d79988a2b2559f2bb5","layer":"modern","quote":"〖11〗十八年：建安十八年（公元 213）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":137,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-bec99dfe67d67ae54b06","start":0,"end":22,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o139","section":"chapter-001","block":"b-d44820525c4645832365","layer":"original","quote":"十八年春正月〖11〗，进军濡须口〖12〗；攻破权江西营，获权都督公孙阳〖13〗，乃引军还。诏书并十四州〖14〗，复为九州〖15〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":107,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":65,"offset_unit":"unicode_code_point"},{"id":"wudi-q-p112","section":"chapter-001","block":"b-9536581b8deb5e7104e4","layer":"pei","quote":"《魏书》载：“公令曰：‘夫受九锡，广开土宇，周公其人也。汉之异姓八王者，与高祖俱起布衣，创定王业，其功至大。吾何可比之？’前后三让。于是中军师、陵树亭侯荀攸，前军师、东武亭侯钟繇，左军师凉茂，右军师毛玠，平虏将军、华乡侯刘勋，建武将军、清苑亭侯刘若，伏波将军、高安侯夏侯惇，扬武将军、都亭侯王忠，奋威将军、乐乡侯（刘）〔邓〕展，建忠将军、昌乡亭侯鲜于辅，奋武将军、安国亭侯程昱，太中大夫、都乡侯贾诩，军师祭酒、千秋亭侯董昭，都亭侯薛洪，南乡亭侯董蒙，关内侯王粲、傅巽，祭酒王选、袁涣、王朗、张承、任藩、杜袭，中护军、国明亭侯曹洪，中领军、万岁亭侯韩浩，行骁骑将军、安平亭侯曹仁，领护军将军王图，长史万潜、谢奂、袁霸等，劝进曰：‘自古三代，胙臣以土；受命中兴，封秩辅佐。皆所以褒功赏德，为国藩卫也。往者天下崩乱，群凶豪起；颠越跋扈之险，不可忍言。明公奋身出命以徇其难，诛二袁篡盗之逆，灭黄巾贼乱