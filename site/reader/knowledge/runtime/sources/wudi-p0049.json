-02916fc2e5c67b0d58f9"]}],"participants":[{"person":"wendi-p0074","role":"进言者","evidence":["zhonghua-q-02916fc2e5c67b0d58f9"]},{"person":"cao-cao","role":"西征疑谒而纳言者","evidence":["zhonghua-q-02916fc2e5c67b0d58f9"]},{"person":"wudi-p0049","role":"冢被过而未谒者","evidence":["zhonghua-q-02916fc2e5c67b0d58f9"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["zhonghua-q-02916fc2e5c67b0d58f9"]},"ordering_evidence":"zhonghua-q-02916fc2e5c67b0d58f9","source_order":[13,515,145],"order":2933}],"persons":[{"id":"wudi-p0049","name":"刘辩","evidence":["wudi-q-o007","sunshi-q-p041","dongyuan-q-o005","zhonghua-q-02916fc2e5c67b0d58f9"],"facts":[],"aliases":[],"mentions":[{"id":"wudi-m-o007-wudi-p0049","kind":"mention","text":"文中提及","evidence":["wudi-q-o007"]},{"id":"wudi-m-o008-wudi-p0049","kind":"mention","text":"文中提及","evidence":["wudi-q-o008"]},{"id":"sunshi-m-p041-wudi-p0049","kind":"allusion","text":"祖系或典故提及","evidence":["sunshi-q-p041"]},{"id":"dongyuan-m-o005-wudi-p0049","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o005"]},{"id":"dongyuan-m-o007-wudi-p0049","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o007"]},{"id":"dongyuan-m-o032-wudi-p0049","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o032"]},{"id":"dongyuan-m-o033-wudi-p0049","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o033"]},{"id":"dongyuan-m-p007-wudi-p0049","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p007"]},{"id":"dongyuan-m-p008-wudi-p0049","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p008"]},{"id":"dongyuan-m-p009-wudi-p0049","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p009"]},{"id":"dongyuan-m-p011-wudi-p0049","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p011"]},{"id":"dongyuan-m-p016-wudi-p0049","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p016"]},{"id":"dongyuan-m-p060-wudi-p0049","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p060"]},{"id":"dongyuan-m-o004-wudi-p0049","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o004"]},{"id":"dongyuan-m-o034-wudi-p0049","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o034"]}]}],"evidence":[{"id":"dongyuan-e-o005a-q","section":"chapter-006","block":"b-ef2d794a3a83d523b5a3","layer":"original","quote":"卓未至，进败。﹝一﹞中常侍段珪等，劫帝走小平津〖4〗；卓遂将其众迎帝于北芒〖5〗，还宫。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":27,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":44,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-o007b-q","section":"chapter-006","block":"b-144d3bd484d996d23718","layer":"original","quote":"遂废帝为弘农王；","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":29,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":34,"end":42,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-o007c-q","section":"chapter-006","block":"b-144d3bd484d996d23718","layer":"original","quote":"寻又杀王及何太后；","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":29,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":42,"end":51,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-o007e-q","section":"chapter-006","block":"b-144d3bd484d996d23718","layer":"original","quote":"立灵帝少子陈留王，是为献帝。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":29,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":51,"end":65,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-o032a-q","section":"chapter-006","block":"b-ebfd66c9c853e0cbb822","layer":"original","quote":"中常侍段珪等，矫太后命，召进入议，遂杀之。宫中乱。﹝四﹞术将虎贲烧南宫嘉德殿青琐门〖12〗，欲以迫出珪等。珪等不出，劫帝及帝弟陈留王，走小平津。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":194,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":72,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-o033b-q","section":"chapter-006","block":"b-7f9d355b395577aab159","layer":"original","quote":"急追珪等，珪等悉赴河死。帝得还宫。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":195,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":90,"end":107,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p007a-q","section":"chapter-006","block":"b-e120da4cf721f9072f73","layer":"pei","quote":"﹝二﹞张璠《汉纪》曰：“帝以八月庚午，为诸黄门所劫，步出穀门，走至河上。诸黄门既投河死，时帝年十（四）〔七〕，陈留王年九岁。兄弟独夜步行，欲还宫。暗暝，逐萤火而行。数里，得民家，以露车载送。辛未，公卿以下与卓，共迎帝于北芒坂下。”","attribution":"张璠《汉纪》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":46,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cbc1d2a2f124a8616d88","start":0,"end":115,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p008a-q","section":"chapter-006","block":"b-34faef6da14064c00de5","layer":"pei","quote":"《献帝春秋》曰：“先是，童谣曰：‘侯非侯，王非王；千乘万骑走北芒。’卓时适至，屯显阳苑。闻帝当还，率众迎帝。”","attribution":"《献帝春秋》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":47,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cbc1d2a2f124a8616d88","start":0,"end":55,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p009a-q","section":"chapter-006","block":"b-cc11da660a751d9cf454","layer":"pei","quote":"《典略》曰：“帝望见卓兵，涕泣。群公谓卓曰：‘有诏却兵！’卓曰：‘公诸人为国大臣，不能匡正王室，至使国家播荡，何却兵之有！’遂俱入城。”","attribution":"《典略》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":48,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cbc1d2a2f124a8616d88","start":0,"end":68,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p011a-q","section":"chapter-006","block":"b-cdac6233c17ed1dee3c9","layer":"pei","quote":"河南中部掾闵贡，扶帝及陈留王，上至雒舍止。帝独乘一马，陈留王与贡共乘一马，从雒舍南行。","attribution":"《英雄记》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":50,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cbc1d2a2f124a8616d88","start":8,"end":51,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p011b-q","section":"chapter-006","block":"b-cdac6233c17ed1dee3c9","layer":"pei","quote":"公卿百官奉迎于北芒坂下，故太尉崔烈在前导。卓将步骑数千来迎，烈呵使避。卓骂烈曰：‘昼夜三百里来，何云避！我不能断卿头邪？’前见帝曰：‘陛下令常侍、小黄门作乱乃尔，以取祸败。为负不小邪！’又趋陈留王，曰：‘我董卓也，从我抱来！’乃于贡抱中取王。","attribution":"《英雄记》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":50,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cbc1d2a2f124a8616d88","start":51,"end":172,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p016a-q","section":"chapter-006","block":"b-3a3a3bfdb7e407ad21bb","layer":"pei","quote":"策曰：‘孝灵皇帝不究高宗眉寿之祚，早弃臣子。皇帝承绍，海内侧望。而帝天姿轻佻，威仪不恪；在丧慢惰，衰如故焉。凶德既彰，淫秽发闻；损辱神器，忝污宗庙。皇太后教无母仪，统政荒乱。永乐太后暴崩，众论惑焉。三纲之道，天地之纪，而乃有阙，罪之大者。陈留王协，圣德伟茂，规矩邈然；丰下兑上，有尧图之表。居丧哀戚，言不及邪；岐嶷之性，有周成之懿。休声美称，天下所闻。宜承洪业，为万世统，可以承宗庙。废皇帝为弘农王。皇太后还政。’尚书读册毕，群臣莫有言。尚书丁宫曰：‘天祸汉室，丧乱弘多。昔祭仲废忽立突，《春秋》大其权。今大臣量宜为社稷计，诚合天人，请称“万岁”。’","attribution":"《献帝起居注》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":55,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-04146f894cef8a06feb3","start":10,"end":285,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o004","section":"chapter-006","block":"b-84c2342f9d49bfb5684b","layer":"original","quote":"灵帝崩，少帝即位。大将军何进与司隶校尉袁绍，谋诛诸阉官，太后不从。进乃召卓，使将兵诣京师；并密令上书曰：“中常侍张让等窃幸乘宠〖1〗，浊乱海内。昔赵鞅兴晋阳之甲〖2〗，以逐君侧之恶。臣辄鸣钟鼓如洛阳〖3〗，即讨让等。”欲以胁迫太后。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":26,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":116,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o005","section":"chapter-006","block":"b-ef2d794a3a83d523b5a3","layer":"original","quote":"卓未至，进败。﹝一﹞中常侍段珪等，劫帝走小平津〖4〗；卓遂将其众迎帝于北芒〖5〗，还宫。﹝二﹞时进弟车骑将军苗，为进众所杀〖6〗。﹝三﹞进、苗部曲无所属〖7〗，皆诣卓；卓又使吕布杀执金吾丁原〖8〗，并其众：故京都兵权唯在卓。﹝四﹞","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":27,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":115,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o007","section":"chapter-006","block":"b-144d3bd484d996d23718","layer":"original","quote":"于是以久不雨，策免司空刘弘而卓代之〖10〗。俄迁太尉，假节钺、虎贲。遂废帝为弘农王；寻又杀王及何太后；立灵帝少子陈留王，是为献帝。﹝五﹞","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":29,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":68,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o032","section":"chapter-006","block":"b-ebfd66c9c853e0cbb822","layer":"original","quote":"中常侍段珪等，矫太后命，召进入议，遂杀之。宫中乱。﹝四﹞术将虎贲烧南宫嘉德殿青琐门〖12〗，欲以迫出珪等。珪等不出，劫帝及帝弟陈留王，走小平津。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":194,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":72,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o033","section":"chapter-006","block":"b-7f9d355b395577aab159","layer":"original","quote":"绍既斩宦者所署司隶校尉〔樊陵、河南尹〕许相〖13〗；遂勒兵捕诸阉人，无少长皆杀之；或有无须而误死者；至自发露形体而后得免。宦者或有行善自守而犹见及〖14〗，其滥如此，死者二千余人。急追珪等，珪等悉赴河死。帝得还宫。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":195,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":107,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o034","section":"chapter-006","block":"b-649952def6f7f8e56b0c","layer":"original","quote":"董卓呼绍议，欲废帝，立陈留王。是时绍叔父隗为太傅〖1〗，绍伪许之，曰：“此大事，出当与太傅议。”卓曰：“刘氏种，不足复遗〖2〗！”绍不应，横刀长揖而去。﹝一﹞","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":219,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":79,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p007","section":"chapter-006","block":"b-e120da4cf721f9072f73","layer":"pei","quote":"﹝二﹞张璠《汉纪》曰：“帝以八月庚午，为诸黄门所劫，步出穀门，走至河上。诸黄门既投河死，时帝年十（四）〔七〕，陈留王年九岁。兄弟独夜步行，欲还宫。暗暝，逐萤火而行。数里，得民家，以露车载送。辛未，公卿以下与卓，共迎帝于北芒坂下。”","attribution":"张璠《汉纪》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":46,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cbc1d2a2f124a8616d88","start":0,"end":115,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p008","section":"chapter-006","block":"b-34faef6da14064c00de5","layer":"pei","quote":"《献帝春秋》曰：“先是，童谣曰：‘侯非侯，王非王；千乘万骑走北芒。’卓时适至，屯显阳苑。闻帝当还，率众迎帝。”","attribution":"《献帝春秋》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":47,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cbc1d2a2f124a8616d88","start":0,"end":55,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p009","section":"chapter-006","block":"b-cc11da660a751d9cf454","layer":"pei","quote":"《典略》曰：“帝望见卓兵，涕泣。群公谓卓曰：‘有诏却兵！’卓曰：‘公诸人为国大臣，不能匡正王室，至使国家播荡，何却兵之有！’遂俱入城。”","attribution":"《典略》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":48,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cbc1d2a2f124a8616d88","start":0,"end":68,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p011","section":"chapter-006","block":"b-cdac6233c17ed1dee3c9","layer":"pei","quote":"《英雄记》曰：“河南中部掾闵贡，扶帝及陈留王，上至雒舍止。帝独乘一马，陈留王与贡共乘一马，从雒舍南行。公卿百官奉迎于北芒坂下，故太尉崔烈在前导。卓将步骑数千来迎，烈呵使避。卓骂烈曰：‘昼夜三百里来，何云避！我不能断卿头邪？’前见帝曰：‘陛下令常侍、小黄门作乱乃尔，以取祸败。为负不小邪！’又趋陈留王，曰：‘我董卓也，从我抱来！’乃于贡抱中取王。”","attribution":"《英雄记》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":50,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cbc1d2a2f124a8616d88","start":0,"end":173,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p016","section":"chapter-006","block":"b-3a3a3bfdb7e407ad21bb","layer":"pei","quote":"《献帝起居注》载：“策曰：‘孝灵皇帝不究高宗眉寿之祚，早弃臣子。皇帝承绍，海内侧望。而帝天姿轻佻，威仪不恪；在丧慢惰，衰如故焉。凶德既彰，淫秽发闻；损辱神器，忝污宗庙。皇太后教无母仪，统政荒乱。永乐太后暴崩，众论惑焉。三纲之道，天地之纪，而乃有阙，罪之大者。陈留王协，圣德伟茂，规矩邈然；丰下兑上，有尧图之表。居丧哀戚，言不及邪；岐嶷之性，有周成之懿。休声美称，天下所闻。宜承洪业，为万世统，可以承宗庙。废皇帝为弘农王。皇太后还政。’尚书读册毕，群臣莫有言。尚书丁宫曰：‘天祸汉室，丧乱弘多。昔祭仲废忽立突，《春秋》大其权。今大臣量宜为社稷计，诚合天人，请称“万岁”。’卓以太后见废，故公卿以下不布服；会葬，素衣而已。”","attribution":"《献帝起居注》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":55,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-04146f894cef8a06feb3","start":0,"end":310,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p060","section":"chapter-006","block":"b-3c498933c751d69e13dd","layer":"pei","quote":"﹝一﹞《献帝春秋》曰：“卓欲废帝，谓绍曰：‘皇帝冲暗，非万乘之主。陈留王犹胜，今欲立之。人有少智，大或痴，亦知复何如？为当且尔。卿不见灵帝乎？念此令人愤毒！’绍曰：‘汉家君天下，四百许年，恩泽深渥，兆民戴之来久。今帝虽幼冲，未有不善宣闻天下；公欲废嫡立庶，恐众不从公议也。’卓谓绍曰：‘竖子！天下事岂不决我？我今为之，谁敢不从？尔谓董卓刀为不利乎！’绍曰：‘天下健者，岂唯董公！’引佩刀横揖而出。”","attribution":"《献帝春秋》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":228,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ca82cc66f8330aa4ef22","start":0,"end":199,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-p041","section":"chapter-046","block":"b-a3e28c40707ef00a5549","layer":"pei","quote":"﹝六﹞《吴录》载策使张纮为书曰：“盖上天垂司过之星；圣王建敢谏之鼓，设非谬之备，急箴阙之言。何哉？凡有所长，必有所短也。去冬传有大计，无不悚惧；旋知供备贡献，万夫解惑。顷闻建议，复欲追遵前图；即事之期，便有定月；益使怃然，想是流妄；设其必尔，民何望乎？曩日之举义兵也，天下之士所以响应者，董卓擅废置，害太后、弘农王，略烝宫人，发掘园陵。暴逆至此，故诸州郡雄豪，闻声慕义。神武外振，卓遂内歼；元恶既毙，幼主东顾；俾保傅宣命，欲令诸军振旅。（于）〔然而〕河北通谋黑山，曹操放毒东徐；刘表称乱南荆，公孙瓒咆哮北幽；刘繇决力江浒，刘备争盟淮隅：是以未获承命，櫜弓戢戈也。今备、繇既破，操等饥馁；谓当与天下合谋，以诛丑类。舍而不图，有自取之志，非海内所望。一也。昔成汤伐桀，称有夏多罪；武王伐纣，曰殷有罪罚重哉。此二王者，虽有圣德，宜当君世；如使不遭其时，亦无由兴矣。幼主非有恶于天下，徒以春秋尚少，胁于强臣；若无过而夺之，惧未合于汤、武之事。二也。卓虽狂狡，至废主自与，亦犹未也。而天下闻其桀虐，攘臂同心而疾之；以中土希战之兵，当边地劲悍之虏：所以斯须游魂也。今四方之人，皆玩敌而便战斗矣，可得而胜者，以彼乱而我治，彼逆而我顺也。见当世之纷若，欲大举以临之，适足趋祸。三也。天下神器，不可虚干，必须天赞与人力也。殷汤有白鸠之祥，周武有赤乌之瑞；汉高有星聚之符，世祖有神光之征；皆因民困悴于桀、纣之政，毒苦于秦、莽之役：故能芟去无道，致成其志。今天下非患于幼主，未见受命之应验；而欲一旦猝然登即尊号，未之或有。四也。天子之贵，四海之富，谁不欲焉？义不可，势不得耳。陈胜、项籍、王莽、公孙述之徒，皆南面称孤，莫之能济。帝王之位，不可横冀。五也。幼主岐嶷；若除其逼，去其鲠，必成中兴之业。夫致主于周成之盛，自受旦、奭之美，此诚所望于尊明也。纵使幼主有他改异，犹望推宗室之谱属，论近亲之贤良；以绍刘统，以固汉宗。皆所以书功金石，图形丹青；流庆无穷，垂声管弦。舍而不为，为其难者；想明明之素，必所不忍。六也。五世为相，权之重，势之盛，天下莫得而比焉。忠贞者必曰宜夙夜思惟，所以扶国家之踬顿，念社稷之危殆；以奉祖考之志，以报汉室之恩。其忽履道之节而强进取之欲者，将曰天下之人，非家吏则门生也，孰不从我？四方之敌，非吾匹则吾役也，谁能违我？盍乘累世之势，起而取之哉？二者殊数，不可不详察。七也。所贵于圣哲者，以其审于机宜，慎于举措。若难图之事，难保之势；以激群敌之气，以生众人之心；公义故不可，私计又不利：明哲不处。八也。世人多惑于图纬而牵非类，比合文字以悦所事；苟以阿上惑众，终有后悔者；自往迄今，未尝无之。不可不深择而熟思。九也。九者，尊明所见之余耳。庶备‘起予’，补所遗忘；忠言逆耳，幸留神听！”","attribution":"《吴录》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":252,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-27b78c5c04cdd7d0543b","start":0,"end":1140,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o007a-q","section":"chapter-001","block":"b-50b64ee18ec5610ba8a9","layer":"original","quote":"会灵帝崩，太子即位〖3〗，太后临朝〖4〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":60,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o008a-q","section":"chapter-001","block":"b-9faaac9907c958c4d4d1","layer":"original","quote":"卓到，废帝为弘农王而立献帝〖7〗，京都大乱。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":61,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":22,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o008d-q","section":"chapter-001","block":"b-9faaac9907c958c4d4d1","layer":"original","quote":"卓遂杀太后及弘农王〖14〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":61,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":107,"end":121,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-4a17eb75600ced2abdde","section":"chapter-001","block":"b-4a17eb75600ced2abdde","layer":"modern","quote":"〖1〗初平元年：公元 190 年。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":86,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-93d66253e23c705b336d","start":0,"end":17,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-c8312ddce42041c69855","section":"chapter-001","block":"b-c8312ddce42041c69855","layer":"modern","quote":"〖14〗杀太后及弘农王：董卓杀何太后在中平六年（公元 189），但杀弘农王则在第二年的正月。见《后汉书》卷八《灵帝纪》、卷九《献帝纪》。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":76,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-449cc7b499c8a1fee35c","start":0,"end":68,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o007","section":"chapter-001","block":"b-50b64ee18ec5610ba8a9","layer":"original","quote":"会灵帝崩，太子即位〖3〗，太后临朝〖4〗。大将军何进与袁绍谋诛宦官〖5〗，太后不听；进乃召董卓〖6〗，欲以胁太后。﹝一﹞卓未至而进见杀。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":60,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":68,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o008","section":"chapter-001","block":"b-9faaac9907c958c4d4d1","layer":"original","quote":"卓到，废帝为弘农王而立献帝〖7〗，京都大乱。卓表太祖为骁骑校尉〖8〗，欲与计事。太祖乃变易姓名，间行东归〖9〗；﹝二﹞出关〖10〗，过中牟〖11〗。为亭长所疑〖12〗，执诣县。邑中或窃识之〖13〗，为请得解。﹝三﹞卓遂杀太后及弘农王〖14〗。太祖至陈留〖15〗，散家财，合义兵，将以诛卓。冬十二月，始起兵于己吾〖16〗。﹝四﹞是岁，中平六年也。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":61,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":172,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o009","section":"chapter-001","block":"b-20c7e941eb42ee97df8c","layer":"original","quote":"初平元年春正月〖1〗，后将军袁术、冀州牧韩馥、﹝一﹞豫州刺史孔伷、﹝二﹞兖州刺史刘岱、﹝三﹞河内太守王匡、﹝四﹞勃海太守袁绍、陈留太守张邈、东郡太守桥瑁、﹝五﹞山阳太守袁遗、﹝六﹞济北相鲍信，﹝七﹞同时俱起兵〖2〗。众各数万，推绍为盟主。太祖行奋武将军〖3〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":84,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":130,"offset_unit":"unicode_code_point"},{"id":"zhonghua-q-02916fc2e5c67b0d58f9","section":"chapter-013","block":"b-de3f70d0362ef11d699c","layer":"pei","quote":"常从太祖西征，道由孟津，过弘农王冢。太祖疑欲谒，顾问左右，左右莫对。遇乃越第进曰：‘《春秋》之义，国君即位未逾年而卒，未成为君。弘农王即阼既浅；又为暴臣所制，降在藩国：不应谒。’太祖乃过。","attribution":"裴注·魏略","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":514,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-29aaab3281d7871e6af5","start":145,"end":239,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
