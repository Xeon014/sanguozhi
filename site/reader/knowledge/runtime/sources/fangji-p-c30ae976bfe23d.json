r":5908}],"persons":[{"id":"fangji-p-c30ae976bfe23d","name":"吴普","evidence":["fangji-q-fae455c434a33933c703","fangji-q-bd56c61f7581704044d3","fangji-q-2c250b1609be2ea2e491","fangji-q-6ceff68aaa4b9af2f106","fangji-q-c47ed2af68cc514dfc06"],"facts":[{"id":"fangji-f-84a64a06f7ff51f1d748","text":"广陵人，华佗弟子。","evidence":["fangji-q-6ceff68aaa4b9af2f106"]},{"id":"fangji-f-883e42a38cd34f0dfe29","text":"本传记施行五禽戏至九十余岁耳目聪明、齿牙完坚。","evidence":["fangji-q-c47ed2af68cc514dfc06"]}],"mentions":[],"aliases":[]}],"evidence":[{"id":"fangji-q-2c250b1609be2ea2e491","section":"chapter-029","block":"b-eeefe0b86ab698f029dc","layer":"original","quote":"普依准佗治〖1〗，多所全济。","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":128,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":14,"offset_unit":"unicode_code_point"},{"id":"fangji-q-6ceff68aaa4b9af2f106","section":"chapter-029","block":"b-1aa028ba198ab5f85bb6","layer":"original","quote":"广陵吴普，彭城樊阿，皆从佗学。","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":127,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":15,"offset_unit":"unicode_code_point"},{"id":"fangji-q-bd56c61f7581704044d3","section":"chapter-029","block":"b-eeefe0b86ab698f029dc","layer":"original","quote":"佗语普曰：“人体欲得劳动〖2〗，但不当使极尔〖3〗。动摇则谷气得消〖4〗，血脉流通，病不得生；譬犹户枢不朽是也。是以古之仙者为导引之事〖5〗，熊（颈）〔经〕鸱顾〖6〗，引輓腰体〖7〗；动诸关节，以求难老。吾有一术，名五禽之戏：一曰虎，二曰鹿，三曰熊，四曰猿，五曰鸟；亦以除疾，并利蹄足〖8〗，以当导引。体中不快，起作一禽之戏；沾濡汗出，因（上）〔以〕著粉：身体轻便，腹中欲食","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":128,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":14,"end":201,"offset_unit":"unicode_code_point"},{"id":"fangji-q-c47ed2af68cc514dfc06","section":"chapter-029","block":"b-eeefe0b86ab698f029dc","layer":"original","quote":"普依准佗治〖1〗，多所全济。佗语普曰：“人体欲得劳动〖2〗，但不当使极尔〖3〗。动摇则谷气得消〖4〗，血脉流通，病不得生；譬犹户枢不朽是也。是以古之仙者为导引之事〖5〗，熊（颈）〔经〕鸱顾〖6〗，引輓腰体〖7〗；动诸关节，以求难老。吾有一术，名五禽之戏：一曰虎，二曰鹿，三曰熊，四曰猿，五曰鸟；亦以除疾，并利蹄足〖8〗，以当导引。体中不快，起作一禽之戏；沾濡汗出，因（上）〔以〕著粉：身体轻便，腹中欲食。”普施行之，年九十余，耳目聪明，齿牙完坚。","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":128,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":223,"offset_unit":"unicode_code_point"},{"id":"fangji-q-fae455c434a33933c703","section":"chapter-029","block":"b-1aa028ba198ab5f85bb6","layer":"original","quote":"广陵吴普，彭城樊阿，皆从佗学","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":127,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":14,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
