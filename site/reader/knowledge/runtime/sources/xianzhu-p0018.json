{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-o007c","title":"刘平遣客刺刘备未遂","accounts":[{"id":"xianzhu-e-o007c-account","label":"《先主传》正文","text":"平原刘平遣刺客杀刘备，刺客不忍，告知刘备而离去。","evidence":["xianzhu-e-o007c-q"]},{"id":"xianzhu-a-p007-weishu","label":"《魏书》","text":"《魏书》补记刘备厚待刺客，刺客告知实情而去。","evidence":["xianzhu-q-p007-weishu"]}],"participants":[{"person":"xianzhu-p0018","role":"使客刺杀","evidence":["xianzhu-e-o007c-q"]},{"person":"liu-bei","role":"被刺未遂","evidence":["xianzhu-e-o007c-q"]}],"place":{"text":"平原","evidence":["xianzhu-e-o007c-q"]},"time":{"label":"领平原相时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xianzhu-e-o007c-q"]},"source_order":[32,22,"O007c"],"order":6503}],"persons":[{"id":"xianzhu-p0018","name":"刘平（平原人）","evidence":["xianzhu-q-o007"],"facts":[],"aliases":[],"mentions":[{"id":"xianzhu-m-o007-xianzhu-p0018","kind":"mention","text":"文中提及","evidence":["xianzhu-q-o007"]},{"id":"xianzhu-m-p007-xianzhu-p0018","kind":"mention","text":"文中提及","evidence":["xianzhu-q-p007"]}]}],"evidence":[{"id":"xianzhu-e-o007c-q","section":"chapter-032","block":"b-7cab87f85bc6fc204329","layer":"original","quote":"郡民刘平，素轻先主，耻为之下，使客刺之；客不忍刺，语之而去〖9〗。其得人心如此。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":21,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":75,"end":115,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o007","section":"chapter-032","block":"b-7cab87f85bc6fc204329","layer":"original","quote":"后为高唐尉，迁为令。﹝四﹞为贼所破，往奔中郎将公孙瓒。瓒表为别部司马，使为青州刺史田楷〖7〗，以拒冀州牧袁绍。数有战功，试守平原令〖8〗。后领平原相；郡民刘平，素轻先主，耻为之下，使客刺之；客不忍刺，语之而去〖9〗。其得人心如此。﹝五﹞","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":21,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":118,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-p007","section":"chapter-032","block":"b-067722e3347e05dd02cc","layer":"pei","quote":"﹝五﹞《魏书》曰：“刘平结客刺备，备不知，而待客甚厚；客以状语之而去。是时人民饥馑，屯聚抄暴。备外御寇难，内丰财施；士之下者，必与同席而坐，同簋而食，无所简择。众多归焉。”","attribution":"《魏书》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":37,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-326a02677e3c7507930d","start":0,"end":86,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-p007-weishu","section":"chapter-032","block":"b-067722e3347e05dd02cc","layer":"pei","quote":"刘平结客刺备，备不知，而待客甚厚；客以状语之而去。","attribution":"《魏书》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":37,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-326a02677e3c7507930d","start":10,"end":35,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
