xhtml","index":2,"anchor":null},"note_id":null,"start":153,"end":181},{"id":"liusima-q-4d70403d4e98a47b6945","section":"chapter-015","block":"b-e03e118fcee75a0aa821","layer":"original","quote":"于是聚诸生，立学校","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":2,"anchor":null},"note_id":null,"start":143,"end":152},{"id":"liusima-q-9db77a53ff9a1b0a6e9d","section":"chapter-015","block":"b-e03e118fcee75a0aa821","layer":"original","quote":"南怀绪等，皆安集之，贡献相继。数年中，恩化大行；百姓乐其政，流民越江山而归者以万数","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":2,"anchor":null},"note_id":null,"start":101,"end":142},{"id":"liusima-q-a4ea0d1a675cc8b2fabd","section":"chapter-015","block":"b-646e3c701b54bceaa7da","layer":"original","quote":"建安十三年，卒","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":3,"anchor":null},"note_id":null,"start":0,"end":7},{"id":"liusima-q-ac988067ecb75556ddf7","section":"chapter-015","block":"b-e03e118fcee75a0aa821","layer":"original","quote":"又高为城垒，多积木石，编作草苫数千万枚〖3〗，益贮鱼膏数千斛，为战守备","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":2,"anchor":null},"note_id":null,"start":190,"end":225},{"id":"liusima-q-c8184820f4828001d235","section":"chapter-015","block":"b-73bbe9df1d00ba7dea83","layer":"original","quote":"建安初，说袁术将戚寄、秦翊，使率众与俱诣太祖，太祖悦之","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":1,"anchor":null},"note_id":null,"start":17,"end":44},{"id":"liusima-q-de48a60e1b34c1eb6619","section":"chapter-015","block":"b-e03e118fcee75a0aa821","layer":"original","quote":"馥既受命，单马造合肥空城，建立州治","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":2,"anchor":null},"note_id":null,"start":83,"end":100},{"id":"liusima-q-fef7821e14b668d50425","section":"chapter-015","block":"b-e03e118fcee75a0aa821","layer":"original","quote":"太祖方有袁绍之难，谓馥可任以东南之事，遂表为扬州刺史","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":2,"anchor":null},"note_id":null,"start":56,"end":82},{"id":"liusima-q2-024742e4da308273e3de","section":"chapter-015","block":"b-646e3c701b54bceaa7da","layer":"original","quote":"建安十三年，卒。","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":3,"anchor":null},"note_id":null,"start":0,"end":8},{"id":"liusima-q2-f6d3f1de61c77c8e3617","section":"chapter-015","block":"b-73bbe9df1d00ba7dea83","layer":"original","quote":"刘馥字元颖，沛国相人也。避乱扬州。建安初，说袁术将戚寄、秦翊，使率众与俱诣太祖，太祖悦之。司徒辟为掾。","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":1,"anchor":null},"note_id":null,"start":0,"end":51},{"id":"zongshi-q-f9675961290df4357938","section":"chapter-051","block":"b-b01cfcdeadd92ea5d12f","layer":"original","quote":"二人议曰：“伯海与将军疏远〖9〗，而责我乃（耳）〔尔〕〖10〗；讨虏若来〖11〗，吾属无遗矣〖12〗！”遂杀河，使人北迎扬州刺史刘馥〖13〗；令住历阳，以丹杨应之","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":173,"anchor":null},"note_id":null,"start":118,"end":199}],"profiles":{},"directory_counts":{}}
