{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhangle-e-o042f","title":"徐晃解张顺围破陈福诸屯","accounts":[{"id":"zhangle-e-o042f-account","label":"《张乐于张徐传第十七》正文","text":"徐晃解张顺围破陈福诸屯","evidence":["zhangle-e-o042f-q"]}],"participants":[{"person":"wudi-p0180","role":"解围","evidence":["zhangle-e-o042f-q"]},{"person":"zhangle-p0033","role":"被援","evidence":["zhangle-e-o042f-q"]},{"person":"zhangle-p0034","role":"被破","evidence":["zhangle-e-o042f-q"]}],"place":null,"time":{"label":"关右反时及以后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["zhangle-e-o042f-q"]},"ordering_evidence":"zhangle-e-o042f-q","source_order":[17,148,"O042f"],"order":3590}],"persons":[{"id":"zhangle-p0033","name":"张顺","evidence":["zhangle-q-o042"],"facts":[],"aliases":[],"mentions":[{"id":"zhangle-m-o042-zhangle-p0033","kind":"mention","text":"文中提及","evidence":["zhangle-q-o042"]}]}],"evidence":[{"id":"zhangle-e-o042f-q","section":"chapter-017","block":"b-8c77e7bb7badfaad69ba","layer":"original","quote":"解将军张顺围，击贼陈福等三十余屯，皆破之。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":147,"anchor":null},"note_id":null,"start":254,"end":275},{"id":"zhangle-q-o042","section":"chapter-017","block":"b-8c77e7bb7badfaad69ba","layer":"original","quote":"韩遂、马超等反关右，遣晃屯汾阴以抚河东〖10〗；赐牛酒，令上先人墓〖11〗。太祖至潼关，恐不得渡，召问晃。晃曰：“公盛兵于此，而贼不复别守蒲坂，知其无谋也。今假臣精兵﹝二﹞，渡蒲坂津；为军先置，以截其里〖12〗：贼可擒也。”太祖曰：“善！”使晃以步骑四千人，渡津。作堑栅未成，贼梁兴夜将步骑五千余人攻晃；晃击走之，太祖军得渡，遂破超等。使晃与夏侯渊平隃麋、汧诸氐，与太祖会安定。太祖还邺，使晃与夏侯渊平鄜、夏阳余贼，斩梁兴，降三千余户。从征张鲁。别遣晃讨攻椟、仇夷诸山氐〖13〗，皆降之。迁平寇将军〖14〗。解将军张顺围，击贼陈福等三十余屯，皆破之。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":147,"anchor":null},"note_id":null,"start":0,"end":275}],"profiles":{},"directory_counts":{}}
