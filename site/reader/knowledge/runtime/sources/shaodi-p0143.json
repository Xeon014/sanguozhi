5fbe57a5a8d3a38","start":185,"end":194,"offset_unit":"unicode_code_point"},{"id":"dengzhang-q-c7fe162d3a19f8c097a8","section":"chapter-045","block":"b-025b5642eaafd2e6fb88","layer":"original","quote":"明年正月，随会至成都，为乱兵所杀","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":50,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":44,"end":60,"offset_unit":"unicode_code_point"},{"id":"duzhou-q-101af547a39be75104df","section":"chapter-042","block":"b-63b42641a680eadddce4","layer":"original","quote":"明年正月，钟会作乱成都","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":580,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":11,"offset_unit":"unicode_code_point"},{"id":"erfei-q-4ab49b058c3f91a0cda7","section":"chapter-034","block":"b-caa1bd390bc6a9f3db51","layer":"original","quote":"咸熙元年正月，钟会作乱于成都","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":93,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":9,"end":23,"offset_unit":"unicode_code_point"},{"id":"houzhu-q-O080","section":"chapter-033","block":"b-5d3fe85765efd9badd26","layer":"original","quote":"资严未发〖44〗，明年春正月，艾见收〖45〗。钟会自涪至成都，作乱。会既死，蜀中军众抄略，死丧狼藉；数日乃安集。","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":156,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":56,"offset_unit":"unicode_code_point"},{"id":"huowang-q-0f16df90b6f05e680a83","section":"chapter-041","block":"b-fec186c9562152cd4da0","layer":"pei","quote":"魏咸熙元年六月，镇西将军卫瓘，至于成都，得璧、玉印各一枚，文似‘成信’字。魏人宣示百官，藏于相国府","attribution":"裴注·襄阳记","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":65,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5078c16e094c6d2cad41","start":11,"end":60,"offset_unit":"unicode_code_point"},{"id":"huowang-q-754ccf4ce6acd1a6c792","section":"chapter-041","block":"b-fec186c9562152cd4da0","layer":"pei","quote":"充闻之曰：‘吾闻谯周之言：先帝讳备，其训具也；后主讳禅，其训授也：如言刘已具矣，当授与人也。今中抚军名炎，而汉年极于炎兴；瑞出成都，而藏之于相国府：此殆天意也！","attribution":"裴注·襄阳记","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":65,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5078c16e094c6d2cad41","start":61,"end":141,"offset_unit":"unicode_code_point"},{"id":"huowang-q2-5c1d6a5cdf1f9ce6f0c6","section":"chapter-041","block":"b-fec186c9562152cd4da0","layer":"pei","quote":"﹝五﹞《襄阳记》曰：“魏咸熙元年六月，镇西将军卫瓘，至于成都，得璧、玉印各一枚，文似‘成信’字。魏人宣示百官，藏于相国府。充闻之曰：‘吾闻谯周之言：先帝讳备，其训具也；后主讳禅，其训授也：如言刘已具矣，当授与人也。今中抚军名炎，而汉年极于炎兴；瑞出成都，而藏之于相国府：此殆天意也！’是岁，拜充为梓潼太守。明年十二月而晋武帝即尊位，‘炎兴’于是乎征焉。”","attribution":"裴注（引书见原文）","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":65,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5078c16e094c6d2cad41","start":0,"end":177,"offset_unit":"unicode_code_point"},{"id":"jfj-q0204","section":"chapter-044","block":"b-09db8f32c9900218f0c8","layer":"original","quote":"会既构邓艾〖17〗，艾槛车征","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":234,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":73,"end":87,"offset_unit":"unicode_code_point"},{"id":"jfj-q0205","section":"chapter-044","block":"b-09db8f32c9900218f0c8","layer":"original","quote":"因将维等诣成都，自称益州牧以叛；","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":234,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":92,"end":108,"offset_unit":"unicode_code_point"},{"id":"jfj-q0207","section":"chapter-044","block":"b-09db8f32c9900218f0c8","layer":"original","quote":"魏将士愤怒，杀会及维，维妻子皆伏诛。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":234,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":124,"end":142,"offset_unit":"unicode_code_point"},{"id":"mantian-q-3e940fb057fddf197cad","section":"chapter-026","block":"b-dde10bd46d8f983c023a","layer":"pei","quote":"弱冠得美名，于太康中为卫瓘、崔洪、石崇等所提携，以新安令、博士为司空从事中郎","attribution":"裴注·荀绰《冀州记》","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":280,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-aeaedf6f24d38daee210","start":61,"end":99,"offset_unit":"unicode_code_point"},{"id":"shaodi-e-o171d-q","section":"chapter-004","block":"b-cef469d41ec5962b4e48","layer":"original","quote":"咸熙元年春正月，壬戌〖1〗，槛车征邓艾〖2〗。甲子〖3〗，行幸长安。壬申〖4〗，使使者以璧币祀华山〖5〗。是月，钟会反于蜀，为众所讨。邓艾亦见杀。二月，辛卯〖6〗，特赦诸在益土者。庚申〖7〗，葬明元郭后。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":220,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":102,"offset_unit":"unicode_code_point"},{"id":"shaodi-e-o173d-q","section":"chapter-004","block":"b-0d498240479dc97aa25b","layer":"original","quote":"夏五月，庚申〖14〗，相国晋王奏复五等爵〖15〗。甲戌〖16〗，改年。癸未〖17〗，追命舞阳宣文侯为晋宣王〖18〗，舞阳忠武侯为晋景王〖19〗。六月，镇西将军卫瓘，上雍州兵于成都县获璧、玉印各一〖20〗；印文似“成信”字。依周成王归禾之义〖21〗，宣示百官，藏于相国府。﹝二﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":222,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":138,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-b-ded6d700dc6f860d1670","section":"chapter-004","block":"b-ded6d700dc6f860d1670","layer":"modern","quote":"〖1〗四年：景元四年（公元 263）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":201,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ef642248e44d01f3825d","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o165","section":"chapter-004","block":"b-b35fdf03685051716720","layer":"original","quote":"四年春二月〖1〗，复命大将军进位、爵赐，一如前诏。又固辞，乃止。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":194,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":32,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o171","section":"chapter-004","block":"b-cef469d41ec5962b4e48","layer":"original","quote":"咸熙元年春正月，壬戌〖1〗，槛车征邓艾〖2〗。甲子〖3〗，行幸长安。壬申〖4〗，使使者以璧币祀华山〖5〗。是月，钟会反于蜀，为众所讨。邓艾亦见杀。二月，辛卯〖6〗，特赦诸在益土者。庚申〖7〗，葬明元郭后。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":220,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":102,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o173","section":"chapter-004","block":"b-0d498240479dc97aa25b","layer":"original","quote":"夏五月，庚申〖14〗，相国晋王奏复五等爵〖15〗。甲戌〖16〗，改年。癸未〖17〗，追命舞阳宣文侯为晋宣王〖18〗，舞阳忠武侯为晋景王〖19〗。六月，镇西将军卫瓘，上雍州兵于成都县获璧、玉印各一〖20〗；印文似“成信”字。依周成王归禾之义〖21〗，宣示百官，藏于相国府。﹝二﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":222,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":138,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-p058-judgment","section":"chapter-004","block":"b-b0d1cfc49b8b0f1f4a77","layer":"pei","quote":"﹝二﹞孙盛曰：“昔公孙述自以起成都，号曰‘成’。二玉之文，殆述所作也。”","attribution":"孙盛论","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":247,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-bf3273b99ef37ddb0a62","start":0,"end":36,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-8ebbb68437bbb839a35b","section":"chapter-021","block":"b-eadbf3b7f3afd9ed803b","layer":"pei","quote":"惠帝初辅政，为楚王玮所害","attribution":"裴注·晋阳秋","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":255,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0f97d4d74273948382d8","start":54,"end":66,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-937a36231639d480ab94","section":"chapter-021","block":"b-eadbf3b7f3afd9ed803b","layer":"pei","quote":"弱冠为尚书郎，遂历位内外。为晋尚书令、司空、太保","attribution":"裴注·晋阳秋","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":255,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0f97d4d74273948382d8","start":29,"end":53,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-dee31d6b404cfa9d6f09","section":"chapter-021","block":"b-eadbf3b7f3afd9ed803b","layer":"pei","quote":"﹝四﹞《晋阳秋》曰：“瓘字伯玉。清贞有名理，少为傅嘏所知。弱冠为尚书郎，遂历位内外。为晋尚书令、司空、太保。惠帝初辅政，为楚王玮所害。”《世语》曰：“瓘与扶风内史敦煌索靖，并善草书。瓘子恒，字巨山。黄门侍郎。恒子玠，字叔宝。有盛名，为太子洗马，早卒。”","attribution":"裴注引《晋阳秋》","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":255,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0f97d4d74273948382d8","start":0,"end":126,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-e1feffd0390849c3a206","section":"chapter-021","block":"b-fa421aa2e199183eb2d0","layer":"original","quote":"子瓘嗣","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":211,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":16,"end":19,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-e4e7a9581268064e8e0b","section":"chapter-021","block":"b-fa421aa2e199183eb2d0","layer":"original","quote":"瓘咸熙中为镇西将军","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":211,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":24,"end":33,"offset_unit":"unicode_code_point"},{"id":"wgc-q0055","section":"chapter-028","block":"b-7d7e8c746eb814d164cd","layer":"original","quote":"文王使监军卫瓘喻艾：“事当须报〖23〗，不宜辄行！”","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":352,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":26,"offset_unit":"unicode_code_point"},{"id":"wgc-q0057","section":"chapter-028","block":"b-2e26eca35db56085032f","layer":"original","quote":"艾父子既囚，钟会至成都；先送艾，然后作乱。会已死，艾本营将士追出艾槛车，迎还。瓘遣田续等讨艾，遇于绵竹西；斩之，子忠与艾俱死。余子在洛阳者悉诛，徙艾妻（子）及孙于西（域）〔城〕〖1〗。﹝一﹞","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":388,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":95,"offset_unit":"unicode_code_point"},{"id":"wgc-q0079","section":"chapter-028","block":"b-513967ffa2e8c3abfabc","layer":"original","quote":"会内有异志〖1〗，因邓艾承制专事，密白“艾有反状”；﹝一﹞于是诏书槛车征艾。司马文王惧艾或不从命，敕会并进军成都。监军卫瓘在会前行，以文王手笔令宣喻艾军；艾军皆释仗，遂收艾入槛车。会所惮惟艾，艾既擒而会寻至，独统大众，威震西土。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":558,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":114,"offset_unit":"unicode_code_point"},{"id":"wgc-q0123","section":"chapter-028","block":"b-46cb05252baea122f899","layer":"pei","quote":"﹝一﹞《汉晋春秋》曰：“初，艾之下江由也，以续不进，欲斩，既而舍之。及瓘遣续，谓曰：‘可以报江由之辱矣！’杜预言于众曰：‘伯玉其不免乎！身为名士，位望已高。既无德音，又不御下以正；是小人而乘君子之器，将何以堪其责乎？’瓘闻之，不俟驾而谢。”《世语》曰：“师纂亦与艾俱死。纂，性急少恩，死之日体无完皮。”","attribution":"汉晋春秋；世语","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":400,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-708919d257dd4281bec0","start":0,"end":151,"offset_unit":"unicode_code_point"},{"id":"wgc-q0130","section":"chapter-028","block":"b-49dfaa2bd5b40cf13e38","layer":"pei","quote":"﹝一﹞会，时遭所生母丧。其母传曰：“夫人性矜严，明于教训；会虽童稚，勤见规诲。年四岁授《孝经》，七岁诵《论语》，八岁诵《诗》，十岁诵《尚书》，十一诵《易》，十二诵《春秋左氏传》、《国语》，十三诵《周礼》、《礼记》，十四诵成侯《易记》，十五使入太学，问四方奇文异训。谓会曰：‘学猥则倦，倦则意怠；吾惧汝之意怠，故以渐训汝，今可以独学矣。’雅好书籍，涉历众书，特好《易》、《老子》。每读《易》孔子说鸣鹤在阴、劳谦君子、籍用白茅、不出户庭之义，每使会反覆读之，曰：‘《易》三百余爻，仲尼特说此者，以谦恭慎密，枢机之发，行己至要，荣身所由故也。顺斯术以往，足为君子矣。’正始八年，会为尚书郎，夫人执会手而诲之曰：‘汝弱冠见叙。人情不能不自足，则损在其中矣，勉思其戒！’是时大将军曹爽专朝政，日纵酒沉醉。会兄侍中毓，宴还，言其事。夫人曰：‘乐则乐矣，然难久也。居上不骄，制节谨度，然后乃无危溢之患。今奢僭若此，非长守富贵之道。’嘉平元年，车驾朝高平陵，会为中书郎，从行。相国宣文侯始举兵，众人恐惧，而夫人自若。中书令刘放、侍郎卫瓘、夏侯和等家，皆怪问：‘夫人一子在危难之中，可能无忧？’答曰：‘大将军奢僭无度，吾常疑其不安。太傅义不危国，必为大将军举耳。吾儿在帝侧，何忧？闻且出兵无他重器，其势必不久战。’果如其言，一时称明。会历机密十余年，颇预政谋。夫人谓曰：‘昔范氏少子，为赵简子设伐邾之计，事从民悦，可谓功矣。然其母以为乘伪作诈，末业鄙事，必不能久。其识本深远，非近人所言，吾常乐其为人。汝居心正，吾知免矣。但当修所志，以辅益时化，不忝先人耳。常言：人谁能皆体自然？但力行不倦，抑亦其次。虽接鄙贱，必以言信。取与之间，分画分明。’或问：‘此无乃小乎？’答曰：‘君子之行，皆积小以致高大。若以小善为无益而弗为，此乃小人之事耳。希通慕大者，吾所不好。’会自幼少，衣不过青绀，亲营家事，自知恭俭；然见得思义，临财必让。会前后赐钱帛，数百万计，悉送，供公家之用，一无所取。年五十有九，甘露二年二月暴疾，薨。比葬，天子有手诏：命大将军高都侯厚加赗赠；丧事无巨细，一皆供给。议者以为：侯有夫人，有世妇，有妻，有妾，所谓外命妇也；依《春秋》成风、定姒之义，宜崇典礼，不得总称妾名；于是称‘成侯命妇’。殡葬之事，有取于古制，礼也。”","attribution":"钟会母传","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":468,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-896a85c3fec9044a28d4","start":0,"end":956,"offset_unit":"unicode_code_point"},{"id":"wgc-q0135","section":"chapter-028","block":"b-a344b1173e6856a98116","layer":"pei","quote":"﹝四﹞《晋诸公赞》曰：“胡烈儿名渊，字世元。遵之孙也。遵，安定人，以才兼文武，累居藩镇，至车骑将军。子奋，字玄威。亦历方任。女为晋武帝贵人，有宠。太康中，以奋为尚书仆射，加镇军大将军，开府。弟广，字宣祖，少府；次烈，字玄武，秦州刺史；次岐，字玄嶷，并州刺史。广子喜，凉州刺史。渊小字鹞鸱。时年十八，既杀会救父，名震远近。后赵王伦篡位，三王兴义，伦使渊与张泓，将兵御齐王，屡破齐军。会成都战克，渊乃归降，伏法。”","attribution":"晋诸公赞","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":593,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-7dfa0827333ec78b2b0e","start":0,"end":205,"offset_unit":"unicode_code_point"},{"id":"wgc-q0394","section":"chapter-028","block":"b-7d7e8c746eb814d164cd","layer":"original","quote":"文王使监军卫瓘喻艾：“事当须报〖23〗，不宜辄行","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":352,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":24,"offset_unit":"unicode_code_point"},{"id":"wgc-q0401","section":"chapter-028","block":"b-2e26eca35db56085032f","layer":"original","quote":"瓘遣田续等讨艾，遇于绵竹西；斩之，子忠与艾俱死","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":388,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":39,"end":62,"offset_unit":"unicode_code_point"},{"id":"wgc-q0487","section":"chapter-028","block":"b-513967ffa2e8c3abfabc","layer":"original","quote":"监军卫瓘在会前行，以文王手笔令宣喻艾军；艾军皆释仗，遂收艾入槛车","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":558,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":57,"end":89,"offset_unit":"unicode_code_point"},{"id":"wgc-q0501","section":"chapter-028","block":"b-89b8e850e65ff34865e9","layer":"original","quote":"十八日日中，烈军兵与烈儿擂鼓出门，诸军兵不期皆鼓噪出〖20〗；曾无督促之者，而争先赴城。时方给与姜维铠杖，白“外有匈匈声，似失火”。有顷，白“兵走向城〖21〗”。会惊，谓维曰：“兵来似欲作恶〖22〗，当云何〖23〗？”维曰：“但当击之耳！”会遣兵悉杀所闭诸牙门、郡守，内人共举几以柱门〖24〗；兵斫门，不能破。斯须，门外倚梯登城，或烧城屋，蚁附乱进，矢下如雨；牙门、郡守各缘屋出，与其卒兵相得〖25〗。姜维率会左右战，手杀五六人；众既格斩维，争赴杀会。会时年四十。将士死者数百人。﹝四﹞","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":562,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":243,"offset_unit":"unicode_code_point"},{"id":"wgc-q0504","section":"chapter-028","block":"b-89b8e850e65ff34865e9","layer":"original","quote":"姜维率会左右战，手杀五六人；众既格斩维，争赴杀会","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":562,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":201,"end":225,"offset_unit":"unicode_code_point"},{"id":"wgc-q0605","section":"chapter-028","block":"b-46cb05252baea122f899","layer":"pei","quote":"及瓘遣续，谓曰：‘可以报江由之辱矣","attribution":"裴注·汉晋春秋","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":400,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-708919d257dd4281bec0","start":34,"end":51,"offset_unit":"unicode_code_point"},{"id":"wgc-q0606","section":"chapter-028","block":"b-46cb05252baea122f899","layer":"pei","quote":"杜预言于众曰：‘伯玉其不免乎！身为名士，位望已高。既无德音，又不御下以正；是小人而乘君子之器，将何以堪其责乎？’瓘闻之，不俟驾而谢","attribution":"裴注·汉晋春秋","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":400,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-708919d257dd4281bec0","start":53,"end":118,"offset_unit":"unicode_code_point"},{"id":"wgc-q0638","section":"chapter-028","block":"b-a344b1173e6856a98116","layer":"pei","quote":"渊小字鹞鸱。时年十八，既杀会救父，名震远近","attribution":"裴注·晋诸公赞","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":593,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-7dfa0827333ec78b2b0e","start":138,"end":159,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
