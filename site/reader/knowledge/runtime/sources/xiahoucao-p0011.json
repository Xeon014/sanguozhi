{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[],"persons":[{"id":"xiahoucao-p0011","name":"庭坚","evidence":["xiahoucao-q-p005"],"facts":[],"aliases":[],"mentions":[{"id":"xiahoucao-m-p005-xiahoucao-p0011","kind":"allusion","text":"祖系或典故提及","evidence":["xiahoucao-q-p005"]}]}],"evidence":[{"id":"xiahoucao-q-p005","section":"chapter-009","block":"b-f5ed06863622dcf81cbc","layer":"pei","quote":"﹝四﹞《晋阳秋》曰：“泰始二年，高安乡侯夏侯佐卒；惇之孙也，嗣绝。诏曰：‘惇，魏之元功，勋书竹帛。昔庭坚不祀，犹或悼之；况朕受禅于魏，而可以忘其功臣哉！宜择惇近属（劭）〔绍〕封之。’”","attribution":"《晋阳秋》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":39,"anchor":null},"note_id":"n-35b23b4bbd013ba8a7c0","start":0,"end":92}],"profiles":{},"directory_counts":{}}
