":[{"id":"zhulv-a-90b91b5725a908100d5b","label":"正文","text":"先是，归义马茂怀奸，觉，诛；权深忿之","evidence":["zhulv-q-33b4bd9001b4d7756aa4"]}],"participants":[{"person":"wuzhu-p0119","role":"怀奸而被诛者","evidence":["zhulv-q-33b4bd9001b4d7756aa4"]},{"person":"sun-quan","role":"深忿者","evidence":["zhulv-q-33b4bd9001b4d7756aa4"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["zhulv-q-33b4bd9001b4d7756aa4"]},"ordering_evidence":"zhulv-q-33b4bd9001b4d7756aa4","source_order":[56,90,0],"order":9979}],"persons":[{"id":"wuzhu-p0119","name":"马茂","evidence":["wuzhu-q-o146","zhulv-q-33b4bd9001b4d7756aa4","zhulv-q-aafa30d3561817387a4e"],"facts":[],"aliases":[],"mentions":[{"id":"wuzhu-m-o146-wuzhu-p0119","kind":"mention","text":"文中提及","evidence":["wuzhu-q-o146"]},{"id":"wuzhu-m-p063-wuzhu-p0119","kind":"mention","text":"文中提及","evidence":["wuzhu-q-p063"]},{"id":"zhulv-m2-5e1597c617bdceb4cf66","kind":"mention","text":"文中提及","evidence":["zhulv-q-aafa30d3561817387a4e"]}]}],"evidence":[{"id":"shaodi-q-b-ffaf273e80312d879f6a","section":"chapter-004","block":"b-ffaf273e80312d879f6a","layer":"modern","quote":"〖1〗六年：正始六年（公元 245）。丁卯：旧历十七日。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":117,"anchor":null},"note_id":"n-6a775c04ceecfbe9bbb8","start":0,"end":28},{"id":"shaodi-q-o027","section":"chapter-004","block":"b-8413104b61ef295c89cc","layer":"original","quote":"六年春二月，丁卯〖1〗，南安郡地震。丙子〖2〗，以骠骑将军赵俨为司空〖3〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":108,"anchor":null},"note_id":null,"start":0,"end":38},{"id":"wuzhu-e-o146a-q","section":"chapter-047","block":"b-4fcd97b6e86a5e44d2a0","layer":"original","quote":"秋七月，将军马茂等图逆，夷三族。﹝一﹞","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":231,"anchor":null},"note_id":null,"start":0,"end":19},{"id":"wuzhu-e-p063a-q","section":"chapter-047","block":"b-4577dc0a75bef87ef519","layer":"pei","quote":"茂，本淮南钟离长，而为王凌所失，叛归吴。吴以为征西将军、九江太守、外部督，封侯，领千兵。","attribution":"《吴历》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":257,"anchor":null},"note_id":"n-a25cc8407b63b7e376ee","start":10,"end":54},{"id":"wuzhu-e-p063b-q","section":"chapter-047","block":"b-4577dc0a75bef87ef519","layer":"pei","quote":"权数出苑中，与公卿诸将射。茂与兼符节令朱贞、无难督虞钦、牙门将朱志等，合计：伺权在苑中，公卿诸将在门未入，令贞持节称诏，悉收缚之；茂引兵入苑，击权；分据宫中及石头坞，遣人报魏。事觉，皆族之。","attribution":"《吴历》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":257,"anchor":null},"note_id":"n-a25cc8407b63b7e376ee","start":54,"end":149},{"id":"wuzhu-q-o144","section":"chapter-047","block":"b-d7e78b5a560a4e6c82c5","layer":"original","quote":"八年春二月〖1〗，丞相陆逊卒。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":229,"anchor":null},"note_id":null,"start":0,"end":15},{"id":"wuzhu-q-o146","section":"chapter-047","block":"b-4fcd97b6e86a5e44d2a0","layer":"original","quote":"秋七月，将军马茂等图逆，夷三族。﹝一﹞","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":231,"anchor":null},"note_id":null,"start":0,"end":19},{"id":"wuzhu-q-p063","section":"chapter-047","block":"b-4577dc0a75bef87ef519","layer":"pei","quote":"﹝一﹞《吴历》曰：“茂，本淮南钟离长，而为王凌所失，叛归吴。吴以为征西将军、九江太守、外部督，封侯，领千兵。权数出苑中，与公卿诸将射。茂与兼符节令朱贞、无难督虞钦、牙门将朱志等，合计：伺权在苑中，公卿诸将在门未入，令贞持节称诏，悉收缚之；茂引兵入苑，击权；分据宫中及石头坞，遣人报魏。事觉，皆族之。”","attribution":"《吴历》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":257,"anchor":null},"note_id":"n-a25cc8407b63b7e376ee","start":0,"end":150},{"id":"zhulv-q-33b4bd9001b4d7756aa4","section":"chapter-056","block":"b-8c755c1644faed92ff42","layer":"original","quote":"先是，归义马茂怀奸〖6〗，觉，诛；权深忿之","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":89,"anchor":null},"note_id":null,"start":0,"end":21},{"id":"zhulv-q-aafa30d3561817387a4e","section":"chapter-056","block":"b-8c755c1644faed92ff42","layer":"original","quote":"然临行上疏曰：“马茂小子，敢负恩养！臣今奉天威，事蒙克捷，欲令所获，震耀远近，方舟塞江〖7〗，使足可观：以解上下之忿。惟陛下识臣先言〖8〗，责臣后效","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":89,"anchor":null},"note_id":null,"start":22,"end":96}],"profiles":{},"directory_counts":{}}
