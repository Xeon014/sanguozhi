_id":null,"start":14,"end":68,"offset_unit":"unicode_code_point"},{"id":"xunyu-e-o032a-q","section":"chapter-010","block":"b-d8deea5750fd311b5afa","layer":"original","quote":"恽早卒。子甝、霬，﹝一﹞以外甥故犹宠待。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":172,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"xunyu-f0012-q","section":"chapter-010","block":"b-dfbaeb048700cd5bb971","layer":"pei","quote":"恽字长倩","attribution":"《荀氏家传》《世语》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":184,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-91315725914c064021bb","start":12,"end":16,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-o027","section":"chapter-010","block":"b-fff11a0e234ba9cb8c24","layer":"original","quote":"是时，荀攸常为谋主〖1〗。彧兄衍，以监军校尉守邺〖2〗，都督河北事。太祖之征袁尚也，高幹密遣兵谋袭邺；衍逆觉〖3〗，尽诛之，以功封列侯。﹝一﹞太祖以女，妻彧长子恽，后称安阳公主。彧及攸并贵重，皆谦冲节俭；禄赐散之宗族、知旧〖4〗，家无余财。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":142,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":120,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-o031","section":"chapter-010","block":"b-160350399d5217988d11","layer":"original","quote":"子恽，嗣侯。官至虎贲中郎将。初，文帝与平原侯植并有拟论〖1〗；文帝曲礼事彧〖2〗。及彧卒，恽又与植善，而与夏侯尚不穆〖3〗；文帝深恨恽。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":171,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":68,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-o032","section":"chapter-010","block":"b-d8deea5750fd311b5afa","layer":"original","quote":"恽早卒。子甝、霬，﹝一﹞以外甥故犹宠待。恽弟俣，御史中丞〖4〗；俣弟诜，大将军从事中郎：皆知名，早卒。﹝二﹞诜弟顗，咸熙中为司空〖5〗。﹝三﹞","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":172,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":71,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-p026","section":"chapter-010","block":"b-dfbaeb048700cd5bb971","layer":"pei","quote":"﹝二﹞《荀氏家传》曰：“恽字长倩，俣字叔倩，诜字曼倩；俣子寓，字景伯。”《世语》曰：“寓少与裴楷、王戎、杜默，俱有名京邑。仕晋，位至尚书，名见显著。子羽嗣，位至尚书。”","attribution":"《荀氏家传》《世语》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":184,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-91315725914c064021bb","start":0,"end":84,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
