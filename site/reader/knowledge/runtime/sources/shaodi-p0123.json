ll},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":33,"end":55,"offset_unit":"unicode_code_point"},{"id":"lizang-q-aaa9a330f0a2a8cda15d","section":"chapter-018","block":"b-f3c9370bada62331f7ff","layer":"pei","quote":"迁司空、太尉","attribution":"裴注·王隐《晋书》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":128,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-bac345b63c40d7fb8707","start":41,"end":47,"offset_unit":"unicode_code_point"},{"id":"lizang-q-b9d5ba69fb7aa9082a25","section":"chapter-018","block":"b-3594cd5bd76d5ee810f5","layer":"pei","quote":"盛寒之月，后母曰：‘吾思食生鱼。’祥脱衣，将剖冰求之。有（少）〔顷〕坚冰解，下有鱼跃出，因奉以供","attribution":"裴注·孙盛《杂语》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":127,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-bac345b63c40d7fb8707","start":39,"end":87,"offset_unit":"unicode_code_point"},{"id":"lizang-q-d771994e8414cccb7e54","section":"chapter-018","block":"b-3594cd5bd76d5ee810f5","layer":"pei","quote":"后母苛虐，每欲危害祥，祥色养无怠","attribution":"裴注·孙盛《杂语》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":127,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-bac345b63c40d7fb8707","start":22,"end":38,"offset_unit":"unicode_code_point"},{"id":"lizang-q-f0f1aaa1ab20ecad6ac8","section":"chapter-018","block":"b-f3c9370bada62331f7ff","layer":"pei","quote":"高贵乡公入学，以祥为三老","attribution":"裴注·王隐《晋书》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":128,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-bac345b63c40d7fb8707","start":28,"end":40,"offset_unit":"unicode_code_point"},{"id":"lizang-q2-6680092b35bb7fd83592","section":"chapter-018","block":"b-f3c9370bada62331f7ff","layer":"pei","quote":"王隐《晋书》曰：“祥始出仕，年过五十矣。稍迁至司隶校尉。高贵乡公入学，以祥为三老。迁司空、太尉。”司马文王初为晋王，司空荀顗要祥尽敬，祥不从。语在《三少帝纪》。晋武践阼，拜祥为太保，封睢陵公。泰始四年，年八十九薨。祥弟览，字玄通。光禄大夫。《晋诸公赞》称览“率素有至行”。览子孙繁衍，颇有贤才相系；奕世之盛，古今少比焉。","attribution":"裴注（引书见原文）","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":128,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-bac345b63c40d7fb8707","start":0,"end":160,"offset_unit":"unicode_code_point"},{"id":"lizang-q2-c5a426721073662594d5","section":"chapter-018","block":"b-f3c9370bada62331f7ff","layer":"pei","quote":"迁司空、太尉。","attribution":"裴注·王隐晋书","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":128,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-bac345b63c40d7fb8707","start":41,"end":48,"offset_unit":"unicode_code_point"},{"id":"shaodi-e-o133b-q","section":"chapter-004","block":"b-af667b138ffffa42f780","layer":"original","quote":"秋八月，甲戌〖23〗，以骠骑将军王昶为司空。丙寅〖24〗，诏曰：“夫养老兴教，三代所以树风化垂不朽也。必有三老、五更以崇至敬〖25〗，乞言纳诲〖26〗，著在惇史〖27〗；然后六合承流〖28〗，下观而化〖29〗。宜妙简德行〖30〗，以充其选。关内侯王祥〖31〗，履仁秉义，雅志淳固。关内侯郑小同，温恭孝友，率礼不忒〖32〗。其以祥为三老，小同为五更。”车驾亲率群司〖33〗，躬行古礼焉。﹝二﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":579,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":195,"offset_unit":"unicode_code_point"},{"id":"shaodi-e-o158b-q","section":"chapter-004","block":"b-7fab9eefaac0c622ac1e","layer":"original","quote":"十二月，甲申〖27〗，黄龙现华阴县井中〖28〗。甲午〖29〗，以司隶校尉王祥为司空。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":144,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":42,"offset_unit":"unicode_code_point"},{"id":"shaodi-e-o172a-q","section":"chapter-004","block":"b-7741168fd487e5577b62","layer":"original","quote":"三月，丁丑〖8〗，以司空王祥为太尉，征北将军何曾为司徒，尚书左仆射荀顗为司空〖9〗。己卯〖10〗，进晋公爵为王〖11〗； 〔增〕 封十郡，并前二十。﹝一﹞丁亥〖12〗，封刘禅为安乐公〖13〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":221,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":96,"offset_unit":"unicode_code_point"},{"id":"shaodi-e-p037a-q","section":"chapter-004","block":"b-5602060662d0de5514f6","layer":"pei","quote":"﹝二﹞《汉晋春秋》曰：“帝乞言于祥，祥对曰：‘昔者明王，礼乐既备，加之以忠诚。忠诚之发，形于言行。夫大人者，行动乎天地；天且弗违，况于人乎？’”","attribution":"《汉晋春秋》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":27,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5ea9c99daa0ff9239ccd","start":0,"end":72,"offset_unit":"unicode_code_point"},{"id":"shaodi-e-p057a-q","section":"chapter-004","block":"b-a9aba59d5fa2ff03e048","layer":"pei","quote":"﹝一﹞《汉晋春秋》曰：“晋公既进爵为王，太尉王祥、司从何曾、司空荀顗并诣王。顗曰：‘相王尊重，何侯与一朝之臣皆已尽敬。今日便当相率而拜，无所疑也。’祥曰：‘相国位势，诚为尊贵，然要是魏之宰相；吾等，魏之三公。公、王相去，一阶而已，班列大同。安有天子三公，可辄拜人者！损魏朝之望，亏晋王之德；君子爱人以礼，吾不为也！’及入，顗遂拜，而祥独长揖。王谓祥曰：‘今日然后知君见顾之重！’”","attribution":"《汉晋春秋》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":246,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-493794a4280db39895d4","start":0,"end":190,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-b-77066dd061eb6a338ffa","section":"chapter-004","block":"b-77066dd061eb6a338ffa","layer":"modern","quote":"〖1〗五年：甘露五年（公元 260 ）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":50,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-21e90e29c9fd438bba21","start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-b-ded6d700dc6f860d1670","section":"chapter-004","block":"b-ded6d700dc6f860d1670","layer":"modern","quote":"〖1〗四年：景元四年（公元 263）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":201,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ef642248e44d01f3825d","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-b-ee7d999da8e03b038d07","section":"chapter-004","block":"b-ee7d999da8e03b038d07","layer":"modern","quote":"〖1〗三年：甘露三年（公元 258）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":582,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-663d9ce877d00f2d0cbc","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o129","section":"chapter-004","block":"b-b1abcd215d0c852fc17c","layer":"original","quote":"三年春二月〖1〗，大将军司马文王陷寿春城，斩诸葛诞。三月，诏曰：“古者克敌，收其尸以为京观〖2〗，所以惩昏逆而彰武功也。汉孝武元鼎中〖3〗，改桐乡为闻喜〖4〗，新乡为获嘉〖5〗，以著南越之亡〖6〗。大将军亲总六戎〖7〗，营据丘头〖8〗；内夷群凶〖9〗，外殄寇虏〖10〗；功济兆民，声振四海。克敌之地，宜有令名〖11〗：其改‘丘头’为‘武丘’。明以武平乱，后世不忘；亦京观、二邑之义也〖12〗”。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":575,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":197,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o133","section":"chapter-004","block":"b-af667b138ffffa42f780","layer":"original","quote":"秋八月，甲戌〖23〗，以骠骑将军王昶为司空。丙寅〖24〗，诏曰：“夫养老兴教，三代所以树风化垂不朽也。必有三老、五更以崇至敬〖25〗，乞言纳诲〖26〗，著在惇史〖27〗；然后六合承流〖28〗，下观而化〖29〗。宜妙简德行〖30〗，以充其选。关内侯王祥〖31〗，履仁秉义，雅志淳固。关内侯郑小同，温恭孝友，率礼不忒〖32〗。其以祥为三老，小同为五更。”车驾亲率群司〖33〗，躬行古礼焉。﹝二﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":579,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":195,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o139","section":"chapter-004","block":"b-c33fc441ae4a3de17fb6","layer":"original","quote":"五年春正月朔〖1〗，日有食之。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":45,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":15,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o158","section":"chapter-004","block":"b-7fab9eefaac0c622ac1e","layer":"original","quote":"十二月，甲申〖27〗，黄龙现华阴县井中〖28〗。甲午〖29〗，以司隶校尉王祥为司空。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":144,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":42,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o165","section":"chapter-004","block":"b-b35fdf03685051716720","layer":"original","quote":"四年春二月〖1〗，复命大将军进位、爵赐，一如前诏。又固辞，乃止。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":194,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":32,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o171","section":"chapter-004","block":"b-cef469d41ec5962b4e48","layer":"original","quote":"咸熙元年春正月，壬戌〖1〗，槛车征邓艾〖2〗。甲子〖3〗，行幸长安。壬申〖4〗，使使者以璧币祀华山〖5〗。是月，钟会反于蜀，为众所讨。邓艾亦见杀。二月，辛卯〖6〗，特赦诸在益土者。庚申〖7〗，葬明元郭后。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":220,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":102,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o172","section":"chapter-004","block":"b-7741168fd487e5577b62","layer":"original","quote":"三月，丁丑〖8〗，以司空王祥为太尉，征北将军何曾为司徒，尚书左仆射荀顗为司空〖9〗。己卯〖10〗，进晋公爵为王〖11〗； 〔增〕 封十郡，并前二十。﹝一﹞丁亥〖12〗，封刘禅为安乐公〖13〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":221,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":96,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-p037","section":"chapter-004","block":"b-5602060662d0de5514f6","layer":"pei","quote":"﹝二﹞《汉晋春秋》曰：“帝乞言于祥，祥对曰：‘昔者明王，礼乐既备，加之以忠诚。忠诚之发，形于言行。夫大人者，行动乎天地；天且弗违，况于人乎？’”","attribution":"《汉晋春秋》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":27,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5ea9c99daa0ff9239ccd","start":0,"end":72,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-p038","section":"chapter-004","block":"b-70ccd2e7d602c17f00f9","layer":"pei","quote":"祥事，别见《吕虔传》。","attribution":"裴注指引","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":28,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5ea9c99daa0ff9239ccd","start":0,"end":11,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-p057","section":"chapter-004","block":"b-a9aba59d5fa2ff03e048","layer":"pei","quote":"﹝一﹞《汉晋春秋》曰：“晋公既进爵为王，太尉王祥、司从何曾、司空荀顗并诣王。顗曰：‘相王尊重，何侯与一朝之臣皆已尽敬。今日便当相率而拜，无所疑也。’祥曰：‘相国位势，诚为尊贵，然要是魏之宰相；吾等，魏之三公。公、王相去，一阶而已，班列大同。安有天子三公，可辄拜人者！损魏朝之望，亏晋王之德；君子爱人以礼，吾不为也！’及入，顗遂拜，而祥独长揖。王谓祥曰：‘今日然后知君见顾之重！’”","attribution":"《汉晋春秋》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":246,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-493794a4280db39895d4","start":0,"end":190,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-p010","section":"chapter-046","block":"b-ed3db13017b81a546e70","layer":"pei","quote":"﹝二﹞按《王氏谱》：叡，字通耀。晋太保祥伯父也。","attribution":"裴松之按《王氏谱》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":122,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1c3a6f7b42da18d32bae","start":0,"end":24,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
