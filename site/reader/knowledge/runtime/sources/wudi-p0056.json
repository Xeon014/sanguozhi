{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p021a","title":"卫兹出资助曹操起兵","accounts":[{"id":"wudi-e-p021a-account","label":"《世语》","text":"《世语》记卫兹以家财资助曹操起兵，聚众五千。","evidence":["wudi-e-p021a-q"]}],"participants":[{"person":"wudi-p0056","role":"出资","evidence":["wudi-e-p021a-q"]},{"person":"cao-cao","role":"起兵","evidence":["wudi-e-p021a-q"]}],"place":{"text":"陈留","evidence":["wudi-e-p021a-q"]},"time":{"label":"中平六年起兵时","year":189,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-p021a-q","wudi-q-o008","wudi-q-b-c8312ddce42041c69855"],"chronology":"wudi-y189","dating_review":{"anchor":"wudi-q-o008","basis":"中平六年起兵时","reviewed":true}},"source_order":[1,84,"P021a"],"order":48},{"id":"wudi-e-o012a","title":"汴水战败与曹洪救曹操","accounts":[{"id":"wudi-e-o012a-account","label":"正文","text":"卫兹分兵随曹操，与徐荣战于汴水而败；曹操受伤失马，曹洪让马，曹操夜间脱身。","evidence":["wudi-e-o012a-q"]},{"id":"xiahoucao-e-o035a-account","label":"《诸夏侯曹传第九》正文","text":"曹洪下马授曹操步从寻船同济汴水奔谯","evidence":["xiahoucao-e-o035a-q"]},{"id":"lvzang-a-0ef472110aff40854909","label":"正文","text":"董卓之乱太祖与邈首举义兵汴水之战邈遣卫兹将兵随太祖","evidence":["lvzang-q-8313539e9d272536b98f"]},{"id":"cuimao-a-d8328e9ab4f232096d5a","label":"裴注·《魏书》","text":"汴水之败鲍信被创，鲍韬在阵战亡","evidence":["cuimao-q-b47d6ab0cc4198f95915"]}],"participants":[{"person":"wudi-p0062","role":"遣将","evidence":["wudi-e-o012a-q"]},{"person":"wudi-p0056","role":"助战","evidence":["wudi-e-o012a-q"]},{"person":"cao-cao","role":"战败脱身","evidence":["wudi-e-o012a-q"]},{"person":"wudi-p0074","role":"交战退军","evidence":["wudi-e-o012a-q"]},{"person":"wudi-p0075","role":"让马救援","evidence":["wudi-e-o012a-q"]},{"person":"wudi-p0065","role":"被创者","evidence":["cuimao-q-b47d6ab0cc4198f95915"]},{"person":"cuimao-p0071","role":"在阵战亡者","evidence":["cuimao-q-b47d6ab0cc4198f95915"]}],"place":{"text":"荥阳汴水","evidence":["wudi-e-o012a-q"]},"time":{"label":"初平元年","year":190,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。"