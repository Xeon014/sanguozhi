{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"hechang-e-798ef484ac28f65c1996","title":"裴盾任徐州刺史","accounts":[{"id":"hechang-a-798ef484ac28f65c1996","label":"裴注·传补叙及晋诸公赞","text":"裴盾任徐州刺史","evidence":["hechang-q-4034306937678d3e0d6a"]}],"participants":[{"person":"hechang-p-f3ac1d823dd8d1","role":"任官","evidence":["hechang-q-4034306937678d3e0d6a"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["hechang-q-4034306937678d3e0d6a"]},"ordering_evidence":"hechang-q-4034306937678d3e0d6a","order":4852}],"persons":[{"id":"hechang-p-f3ac1d823dd8d1","name":"裴盾","evidence":["hechang-q-4034306937678d3e0d6a","hechang-q-214881e1067a295619f0"],"facts":[{"id":"hechang-f-1c78fcfb4cbca3d752b8","text":"裴康之子。","evidence":["hechang-q-214881e1067a295619f0"]}],"mentions":[],"aliases":[]}],"evidence":[{"id":"hechang-q-214881e1067a295619f0","section":"chapter-023","block":"b-e2a23e9c7cee3f0be02f","layer":"pei","quote":"黎子苞，秦州刺史。康子纯，黄门侍郎；次盾，徐州刺史；次（郃）〔邵〕，有器望，晋元帝为安东将军，（郃）〔邵〕为长史，侍中王旷与司马越书曰：“裴（郃）〔邵〕在此，虽不治事，然识量弘淹，此下人士大敬附之。”次廓，中垒将军。楷子瓒，中书郎；次宪，豫州刺史。绰子遐，太傅主簿。瓒、遐并有盛名，早卒。《晋诸公赞》称宪“有清识”。","attribution":"裴注（引书见原文，待主审复核）","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":383,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-e3d593d747be095d124a","start":0,"end":158,"offset_unit":"unicode_code_point"},{"id":"hechang-q-4034306937678d3e0d6a","section":"chapter-023","block":"b-e2a23e9c7cee3f0be02f","layer":"pei","quote":"次盾，徐州刺史","attribution":"裴注·传补叙及晋诸公赞","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":383,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-e3d593d747be095d124a","start":18,"end":25,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
