],"participants":[{"person":"zhangle-p0008","role":"任隆止隆","evidence":["xinyang-q-6fddfaea9219ff7f8ba9"]},{"person":"mingdi-p0041","role":"任官叱督军","evidence":["xinyang-q-6fddfaea9219ff7f8ba9"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["xinyang-q-6fddfaea9219ff7f8ba9"]},"ordering_evidence":"xinyang-q-6fddfaea9219ff7f8ba9","order":5091}],"persons":[{"id":"zhangle-p0008","name":"薛悌","evidence":["zhangle-q-o008","huanchen-q-4ab4ceb021fd502ac56a","huanchen-q-c23f3457f701b7df727f","chengguo-q-051652e52eec9071a1d8","liusima-q-f1cf8d1e83815d6127ae","xinyang-q-6fddfaea9219ff7f8ba9"],"facts":[],"aliases":[],"mentions":[{"id":"zhangle-m-o008-zhangle-p0008","kind":"mention","text":"文中提及","evidence":["zhangle-q-o008"]}]}],"evidence":[{"id":"chengguo-q-051652e52eec9071a1d8","section":"chapter-014","block":"b-ef6e6d390c285fe0d80e","layer":"original","quote":"昱至东阿，东阿令枣祗已率厉吏民，拒城坚守。又兖州从事薛悌，与昱协谋，卒完三城，以待太祖","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":14,"anchor":null},"note_id":null,"start":342,"end":385},{"id":"huanchen-q-4ab4ceb021fd502ac56a","section":"chapter-022","block":"b-36911014e2aba4efaef8","layer":"original","quote":"初，矫为郡功曹，使过泰山〖8〗。泰山太守东郡薛悌异之〖9〗，结为亲友〖10〗；戏谓矫曰：“以郡吏而交二千石〖11〗，邻国君屈从陪臣游〖12〗，不亦可乎！”悌后为魏郡及尚书令，皆承代矫云。","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":365,"anchor":null},"note_id":null,"start":28,"end":121},{"id":"huanchen-q-c23f3457f701b7df727f","section":"chapter-022","block":"b-c077f02a361bfac87c61","layer":"pei","quote":"太祖定冀州，以悌及东平王国，为左、右长史，后至中领军；并悉忠贞练事，为世吏表","attribution":"裴注·《世语》","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":381,"anchor":null},"note_id":"n-7c38a9cb82d570a6a43f","start":33,"end":71},{"id":"liusima-q-f1cf8d1e83815d6127ae","section":"chapter-015","block":"b-bb200ef69e2cdfce863a","layer":"pei","quote":"文帝诏曰：‘薛悌驳吏，王思、郤嘉纯吏也；各赐关内侯，以报其勤","attribution":"裴注·魏略·苛吏传","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":135,"anchor":null},"note_id":"n-0c093becb80c15c165cb","start":58,"end":88},{"id":"xinyang-q-6fddfaea9219ff7f8ba9","section":"chapter-025","block":"b-9ddafb5cbef8b441513c","layer":"original","quote":"少为诸生〖3〗，泰山太守薛悌命为督邮〖4〗。郡督军与悌争论，名悌而呵之〖5〗。隆按剑叱督军曰：“昔鲁定见侮〖6〗，仲尼历阶〖7〗；赵弹秦筝，相如进缶〖8〗。临臣名君，义之所讨也！”督军失色，悌惊起止之。","section_title":"辛毗杨阜高堂隆传第二十五","source":{"file":"OEBPS/Text/titlepage_0056.xhtml","index":282,"anchor":null},"note_id":null,"start":29,"end":130},{"id":"zhangle-e-o008a-q","section":"chapter-017","block":"b-de092265329b0ffd8021","layer":"original","quote":"太祖既征孙权还，使辽与乐进、李典等，将七千余人屯合肥。太祖征张鲁，教与护军薛悌〖7〗，署函边曰“贼至乃发”。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":19,"anchor":null},"note_id":null,"start":0,"end":54},{"id":"zhangle-q-o008","section":"chapter-017","block":"b-de092265329b0ffd8021","layer":"original","quote":"太祖既征孙权还，使辽与乐进、李典等，将七千余人屯合肥。太祖征张鲁，教与护军薛悌〖7〗，署函边曰“贼至乃发”。俄而权率十万众，围合肥，乃共发教。教曰：“若孙权至者，张、李将军出战；乐将军守；护军，勿得与战！”诸将皆疑，辽曰：“公远征在外，比救至，彼破我必矣。是以教指及其未合逆击之，折其盛势，以安众心，然后可守也。成败之机，在此一战，诸君何疑！”李典亦与辽同。于是辽夜募敢从之士，得八百人；椎牛飨将士〖8〗，明日大战。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":19,"anchor":null},"note_id":null,"start":0,"end":208}],"profiles":{},"directory_counts":{}}
