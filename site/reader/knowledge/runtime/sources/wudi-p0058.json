,"zhangle-q-o028","xunyu-q-o004","dongyuan-q-o010","lvzang-q-2701a536347d80e6f81a","gongsuntao-q-7d69aa23334ce852958f","gongsuntao-q-f6697f6ee9e4e59c1d5b","gongsuntao-q-3f7c446e6f6552a4954d","gongsuntao-q-35ffb965551fc4aadf3e","xumisun-q-eef790522c664266530f","xumisun-q-50c00fbc52e4c7ccad2a","cuimao-q-7eda2f7583880694b55a"],"facts":[{"id":"wudi-f-p022-wudi-p0058-c55038","label":"字","text":"文节","evidence":["wudi-q-p022"]},{"id":"wudi-f-p022-wudi-p0058-3d9187","label":"籍贯","text":"颍川","evidence":["wudi-q-p022"]}],"aliases":[{"text":"文节","evidence":["wudi-q-p022"]}],"mentions":[{"id":"wudi-m-o009-wudi-p0058","kind":"mention","text":"文中提及","evidence":["wudi-q-o009"]},{"id":"wudi-m-p022-wudi-p0058","kind":"mention","text":"文中提及","evidence":["wudi-q-p022"]},{"id":"wudi-m-o010-wudi-p0058","kind":"mention","text":"文中提及","evidence":["wudi-q-o010"]},{"id":"wudi-m-o015-wudi-p0058","kind":"mention","text":"文中提及","evidence":["wudi-q-o015"]},{"id":"wudi-m-o016-wudi-p0058","kind":"mention","text":"文中提及","evidence":["wudi-q-o016"]},{"id":"wudi-m-o018-wudi-p0058","kind":"mention","text":"文中提及","evidence":["wudi-q-o018"]},{"id":"wudi-m-p061-wudi-p0058","kind":"mention","text":"文中提及","evidence":["wudi-q-p061"]},{"id":"zhangle-m-o028-wudi-p0058","kind":"mention","text":"文中提及","evidence":["zhangle-q-o028"]},{"id":"xunyu-m-o004-wudi-p0058","kind":"mention","text":"文中提及","evidence":["xunyu-q-o004"]},{"id":"dongyuan-m-o010-wudi-p0058","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o010"]},{"id":"dongyuan-m-o037-wudi-p0058","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o037"]},{"id":"dongyuan-m-o038-wudi-p0058","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o038"]},{"id":"dongyuan-m-o039-wudi-p0058","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o039"]},{"id":"dongyuan-m-o042-wudi-p0058","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o042"]},{"id":"dongyuan-m-p062-wudi-p0058","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p062"]},{"id":"dongyuan-m-p063-wudi-p0058","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p063"]},{"id":"dongyuan-m-p064-wudi-p0058","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p064"]},{"id":"dongyuan-m-p068-wudi-p0058","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p068"]},{"id":"dongyuan-m-p100-wudi-p0058","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p100"]},{"id":"lvzang-m-review-808226d4857eb0b4da12","kind":"mention","text":"韩馥见于相关言论或记载。","evidence":["lvzang-q-2701a536347d80e6f81a"]}]}],"evidence":[{"id":"cuimao-q-7eda2f7583880694b55a","section":"chapter-012","block":"b-08203b2976224e5bbb3f","layer":"pei","quote":"绍劫夺韩馥位，遂据冀州","attribution":"裴注·《魏书》","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":296,"anchor":null},"note_id":"n-678dfc7a2f3975ac89c5","start":272,"end":283},{"id":"dongyuan-e-o010a-q","section":"chapter-006","block":"b-ce439e218b8e8adda84d","layer":"original","quote":"初，卓信任尚书周毖、城门校尉伍琼等。用其所举韩馥、刘岱、孔伷、张（资）〔咨〕、张邈等出宰州郡〖8〗；","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":57,"anchor":null},"note_id":null,"start":0,"end":50},{"id":"dongyuan-e-o010b-q","section":"chapter-006","block":"b-ce439e218b8e8adda84d","layer":"original","quote":"而馥等至官，皆合兵将以讨卓。卓闻之，以为毖、琼等通情卖己，皆斩之。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":57,"anchor":null},"note_id":null,"start":50,"end":83},{"id":"dongyuan-e-o036a-q","section":"chapter-006","block":"b-5c715668eee2a0a99811","layer":"original","quote":"绍遂以勃海起兵，将以诛卓。语在《武纪》。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":221,"anchor":null},"note_id":null,"start":0,"end":20},{"id":"dongyuan-e-o037a-q","section":"chapter-006","block":"b-1f48d089e276d5b77fa3","layer":"original","quote":"绍自号车骑将军，主盟；与冀州牧韩馥，立幽州牧刘虞为帝。遣使奉章诣虞〖1〗，虞不敢受。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":230,"anchor":null},"note_id":null,"start":0,"end":42},{"id":"dongyuan-e-o037b-q","section":"chapter-006","block":"b-1f48d089e276d5b77fa3","layer":"original","quote":"后馥军安平，为公孙瓒所败。瓒遂引兵入冀州，以讨卓为名，内欲袭馥。馥怀不自安。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":230,"anchor":null},"note_id":null,"start":42,"end":80},{"id":"dongyuan-e-o038a-q","section":"chapter-006","block":"b-7d2984aa42c7b84600cb","layer":"original","quote":"会卓西入关〖2〗，绍还军延津。因馥惶遽，使陈留高幹、颍川荀谌等说馥曰：“公孙瓒乘胜来向南，而诸郡应之。袁车骑引军东向〖3〗，此其意不可知。窃为将军危之！”馥曰：“为之奈何？”谌曰：“公孙提燕、代之卒，其锋不可当。袁氏一时之杰，必不为将军下。夫冀州，天下之重资也〖4〗。若两雄并力，兵交于城下，危亡可立而待也！夫袁氏，将军之旧〖5〗，且同盟也。当今为将军计，莫若举冀州以让袁氏。袁氏得冀州，则瓒不能与之争，必厚德将军〖6〗。冀州入于亲交，是将军有让贤之名，而身安于泰山也。愿将军勿疑！”馥素恇怯〖7〗，因然其计。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":231,"anchor":null},"note_id":null,"start":0,"end":255},{"id":"dongyuan-e-o039a-q","section":"chapter-006","block":"b-cc00a1d34aed4013ad69","layer":"original","quote":"馥长史耿武、别驾闵纯、治中李历谏馥曰〖8〗：“冀州虽鄙，带甲百万〖9〗，谷支十年。袁绍孤客穷军，仰我鼻息〖10〗。譬如婴儿，在股掌之上；绝其哺乳，立可饿杀！奈何乃欲以州与之？”馥曰：“吾，袁氏故吏，且才不如本初。度德而让，古人所贵；诸君独何病焉〖11〗？”","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":232,"anchor":null},"note_id":null,"start":0,"end":128},{"id":"dongyuan-e-o039b-q","section":"chapter-006","block":"b-cc00a1d34aed4013ad69","layer":"original","quote":"乃让绍。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":232,"anchor":null},"note_id":null,"start":150,"end":154},{"id":"dongyuan-e-o039c-q","section":"chapter-006","block":"b-cc00a1d34aed4013ad69","layer":"original","quote":"从事赵浮、程奂请以兵拒之〖12〗，馥又不听。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":232,"anchor":null},"note_id":null,"start":128,"end":150},{"id":"dongyuan-e-o042a-q","section":"chapter-006","block":"b-97b64d23433fc91c5e05","layer":"original","quote":"馥怀惧，从绍索去〖15〗，往依张邈。﹝三﹞后绍遣使诣邈，有所计议。与邈耳语，馥在坐上，谓见图构〖16〗。无何起，至溷自杀〖17〗。﹝四﹞","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":251,"anchor":null},"note_id":null,"start":0,"end":68},{"id":"dongyuan-e-p063a-q","section":"chapter-006","block":"b-501b9aaae088f305661d","layer":"pei","quote":"馥遣都督从事赵浮、程奂，将强弩万张，屯河阳。浮等闻馥欲以冀州与绍，自孟津驰东下。时绍尚在朝歌清水口。浮等从后来，船数百艘，众万余人。整兵鼓，夜过绍营，绍甚恶之。","attribution":"《九州春秋》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":248,"anchor":null},"note_id":"n-7c576da3d950edb687e2","start":12,"end":92},{"id":"dongyuan-e-p063b-q","section":"chapter-006","block":"b-501b9aaae088f305661d","layer":"pei","quote":"浮等到，谓馥曰：‘袁本初军无斗粮，各已离散；虽有张杨、于扶罗新附，未肯为用：不足敌也。小从事等请自以现兵拒之，旬日之间，必土崩瓦解。明将军但当开阽閤高枕，何忧何惧！’馥不从，乃避位，出居赵忠故舍。遣子赍冀州印绶，于黎阳与绍。","attribution":"《九州春秋》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":248,"anchor":null},"note_id":"n-7c576da3d950edb687e2","start":92,"end":204},{"id":"dongyuan-e-p064a-q","section":"chapter-006","block":"b-872172974dbe86704555","layer":"pei","quote":"沮授，广平人。少有大志，多权略。仕州别驾，举茂才，历二县令；又为韩馥别驾，表拜骑都尉。袁绍得冀州，又辟焉。","attribution":"《献帝纪》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":271,"anchor":null},"note_id":"n-fbe17cf9b3bfd4706379","start":16,"end":69},{"id":"dongyuan-e-p068a-q","section":"chapter-006","block":"b-9fbd6968fc9eda53a581","layer":"pei","quote":"﹝三﹞《英雄记》曰：“绍以河内朱汉为都官从事。汉，先时为馥所不礼，内怀怨恨；且欲邀迎绍意，擅发城郭兵，围守馥第，拔刃登屋。馥走上楼，收得馥大儿，槌折两脚。绍亦立收汉，杀之。馥犹忧怖，故报绍，索去。”","attribution":"《英雄记》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":275,"anchor":null},"note_id":"n-20ee17c570b229d0c19e","start":0,"end":99},{"id":"dongyuan-q-o010","section":"chapter-006","block":"b-ce439e218b8e8adda84d","layer":"original","quote":"初，卓信任尚书周毖、城门校尉伍琼等。用其所举韩馥、刘岱、孔伷、张（资）〔咨〕、张邈等出宰州郡〖8〗；而馥等至官，皆合兵将以讨卓。卓闻之，以为毖、琼等通情卖己，皆斩之。﹝二﹞","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":57,"anchor":null},"note_id":null,"start":0,"end":86},{"id":"dongyuan-q-o037","section":"chapter-006","block":"b-1f48d089e276d5b77fa3","layer":"original","quote":"绍自号车骑将军，主盟；与冀州牧韩馥，立幽州牧刘虞为帝。遣使奉章诣虞〖1〗，虞不敢受。后馥军安平，为公孙瓒所败。瓒遂引兵入冀州，以讨卓为名，内欲袭馥。馥怀不自安。﹝一﹞","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":230,"anchor":null},"note_id":null,"start":0,"end":83},{"id":"dongyuan-q-o038","section":"chapter-006","block":"b-7d2984aa42c7b84600cb","layer":"original","quote":"会卓西入关〖2〗，绍还军延津。因馥惶遽，使陈留高幹、颍川荀谌等说馥曰：“公孙瓒乘胜来向南，而诸郡应之。袁车骑引军东向〖3〗，此其意不可知。窃为将军危之！”馥曰：“为之奈何？”谌曰：“公孙提燕、代之卒，其锋不可当。袁氏一时之杰，必不为将军下。夫冀州，天下之重资也〖4〗。若两雄并力，兵交于城下，危亡可立而待也！夫袁氏，将军之旧〖5〗，且同盟也。当今为将军计，莫若举冀州以让袁氏。袁氏得冀州，则瓒不能与之争，必厚德将军〖6〗。冀州入于亲交，是将军有让贤之名，而身安于泰山也。愿将军勿疑！”馥素恇怯〖7〗，因然其计。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":231,"anchor":null},"note_id":null,"start":0,"end":255},{"id":"dongyuan-q-o039","section":"chapter-006","block":"b-cc00a1d34aed4013ad69","layer":"original","quote":"馥长史耿武、别驾闵纯、治中李历谏馥曰〖8〗：“冀州虽鄙，带甲百万〖9〗，谷支十年。袁绍孤客穷军，仰我鼻息〖10〗。譬如婴儿，在股掌之上；绝其哺乳，立可饿杀！奈何乃欲以州与之？”馥曰：“吾，袁氏故吏，且才不如本初。度德而让，古人所贵；诸君独何病焉〖11〗？”从事赵浮、程奂请以兵拒之〖12〗，馥又不听。乃让绍。﹝二﹞","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":232,"anchor":null},"note_id":null,"start":0,"end":157},{"id":"dongyuan-q-o042","section":"chapter-006","block":"b-97b64d23433fc91c5e05","layer":"original","quote":"馥怀惧，从绍索去〖15〗，往依张邈。﹝三﹞后绍遣使诣邈，有所计议。与邈耳语，馥在坐上，谓见图构〖16〗。无何起，至溷自杀〖17〗。﹝四﹞","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":251,"anchor":null},"note_id":null,"start":0,"end":68},{"id":"dongyuan-q-p062","section":"chapter-006","block":"b-0d2ca865f7e357470d97","layer":"pei","quote":"﹝一﹞《英雄记》曰：“逢纪说绍曰：‘将军举大事，而仰人资给；不据一州，无以自全。’绍答云：‘冀州兵强，吾士饥乏；设不能办，无所容立。’纪曰：‘可与公孙瓒相闻，导使来南，击取冀州。公孙必至而馥惧矣；因使说利害，为陈祸福，馥必逊让。于此之际，可据其位。’绍从其言，而瓒果来。”","attribution":"《英雄记》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":247,"anchor":null},"note_id":"n-259bb103eabe6e5c2450","start":0,"end":136},{"id":"dongyuan-q-p063","section":"chapter-006","block":"b-501b9aaae088f305661d","layer":"pei","quote":"﹝二﹞《九州春秋》曰：“馥遣都督从事赵浮、程奂，将强弩万张，屯河阳。浮等闻馥欲以冀州与绍，自孟津驰东下。时绍尚在朝歌清水口。浮等从后来，船数百艘，众万余人。整兵鼓，夜过绍营，绍甚恶之。浮等到，谓馥曰：‘袁本初军无斗粮，各已离散；虽有张杨、于扶罗新附，未肯为用：不足敌也。小从事等请自以现兵拒之，旬日之间，必土崩瓦解。明将军但当开阽閤高枕，何忧何惧！’馥不从，乃避位，出居赵忠故舍。遣子赍冀州印绶，于黎阳与绍。”","attribution":"《九州春秋》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":248,"anchor":null},"note_id":"n-7c576da3d950edb687e2","start":0,"end":205},{"id":"dongyuan-q-p064","section":"chapter-006","block":"b-872172974dbe86704555","layer":"pei","quote":"沮授，广平人。少有大志，多权略。仕州别驾，举茂才，历二县令；又为韩馥别驾，表拜骑都尉。袁绍得冀州，又辟焉。","attribution":"《献帝纪》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":271,"anchor":null},"note_id":"n-fbe17cf9b3bfd4706379","start":16,"end":69},{"id":"dongyuan-q-p068","section":"chapter-006","block":"b-9fbd6968fc9eda53a581","layer":"pei","quote":"﹝三﹞《英雄记》曰：“绍以河内朱汉为都官从事。汉，先时为馥所不礼，内怀怨恨；且欲邀迎绍意，擅发城郭兵，围守馥第，拔刃登屋。馥走上楼，收得馥大儿，槌折两脚。绍亦立收汉，杀之。馥犹忧怖，故报绍，索去。”","attribution":"《英雄记》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":275,"anchor":null},"note_id":"n-20ee17c570b229d0c19e","start":0,"end":99},{"id":"dongyuan-q-p100","section":"chapter-006","block":"b-3ec5f06a5eafed7965fb","layer":"pei","quote":"﹝一﹞《吴书》曰：“时议者以‘灵帝失道，使天下叛乱；少帝幼弱，为贼臣所立，又不识母氏所出’，幽州牧刘虞宿有德望，绍等欲立之以安当时。使人报术。术观汉室衰陵，阴怀异志，故外托公义以拒绍。绍复与术书曰：‘前与韩文节共建永世之道，欲海内见再兴之主。今西名有幼君，无血脉之属；公卿以下皆媚事卓，安可复信！但当使兵往屯关要，皆自蹙死于西。东立圣君，太平可冀，如何有疑！又室家见戮，不念子胥，可复北面乎？违天不祥，愿详思之！’术答曰：‘圣主聪叡，有周成之质。贼卓因危乱之际，威服百僚，此乃汉家小厄之会。乱尚未厌，复欲兴之；乃云今主“无血脉之属”，岂不诬乎！先人以来，奕世相承，忠义为先。太傅公，仁慈恻隐，虽知贼卓必为祸害，以信徇义，不忍去也。门户灭绝，死亡流漫；幸蒙远近，来相赴助。不因此时上讨国贼，下刷家耻，而图于此，非所闻也。又曰“室家见戮，可复北面”，此卓所为，岂国家哉！君命，天也，天不可仇，况非君命乎！&&赤心，志在灭卓，不识其他！’”","attribution":"《吴书》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":399,"anchor":null},"note_id":"n-0d88f44e57fbd5ef47f8","start":0,"end":417},{"id":"gongsuntao-q-35ffb965551fc4aadf3e","section":"chapter-008","block":"b-e0445b0ec5a9980feb4c","layer":"pei","quote":"昔光武去定王五世，以大司马领河北，耿弇、冯异劝即尊号，卒代更始。今刘公自恭王枝别，其数亦五；以大司马领幽州牧，此其与光武同。’是时有四星会于箕尾，馥称《谶》云：‘神人将在燕分。’又言济阴男子王定得玉印，文曰‘虞为天子’。又见两日出于代郡，谓虞当代立","attribution":"裴注·吴书","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":69,"anchor":null},"note_id":"n-30181e0ea6d86486fa57","start":68,"end":192},{"id":"gongsuntao-q-3f7c446e6f6552a4954d","section":"chapter-008","block":"b-e0445b0ec5a9980feb4c","layer":"pei","quote":"馥以书与袁术，云‘帝非孝灵子，欲依绛、灌诛废少主，迎立代王故事’；称虞功德治行，华夏少二，当今公室枝属，皆莫能及","attribution":"裴注·吴书","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":69,"anchor":null},"note_id":"n-30181e0ea6d86486fa57","start":7,"end":63},{"id":"gongsuntao-q-7d69aa23334ce852958f","section":"chapter-008","block":"b-8137405df29c7bc38e0b","layer":"original","quote":"袁绍、韩馥议，以为：“少帝制于奸臣，天下无所归心。虞，宗室知名，民之望也〖2〗。”遂推虞为帝，遣使诣虞；虞终不肯受","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":47,"anchor":null},"note_id":null,"start":56,"end":113},{"id":"gongsuntao-q-9fac2b611e458706d832","section":"chapter-008","block":"b-e0445b0ec5a9980feb4c","layer":"pei","quote":"绍又别书报术。是时术阴有不臣之心，不利国家有长主，外托公义以答拒之。绍亦使人私报虞。虞以国有正统，非人臣所宜言，固辞不许","attribution":"裴注·吴书","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":69,"anchor":null},"note_id":"n-30181e0ea6d86486fa57","start":193,"end":253},{"id":"gongsuntao-q-f6697f6ee9e4e59c1d5b","section":"chapter-008","block":"b-f9271c47fb8be15e781b","layer":"pei","quote":"绍、馥使故乐浪太守甘陵张岐，赍议诣虞，使即尊号。虞厉声呵岐曰：‘卿敢出此言乎！忠孝之道，既不能济；孤受国恩，天下扰乱，未能竭命以除国耻；望诸州郡烈义之士，戮力西面，援迎幼主。而乃妄造逆谋，欲涂污忠臣邪","attribution":"裴注·九州春秋","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":68,"anchor":null},"note_id":"n-30181e0ea6d86486fa57","start":12,"end":112},{"id":"liusima-q-1dea94bc4c56b3bfe0b5","section":"chapter-015","block":"b-511f012c14f14dff5c5b","layer":"original","quote":"后数月，关东诸州郡起兵，众数十万，皆集荥阳及河内。诸将不能相一〖10〗，纵兵抄掠，民人死者且半","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":58,"anchor":null},"note_id":null,"start":25,"end":72},{"id":"lvzang-q-2701a536347d80e6f81a","section":"chapter-007","block":"b-b5a8e80047e9a4963fee","layer":"pei","quote":"臣松之按《英雄记》云：“袁绍使张景明、郭公则、高元才等，说韩馥，使让冀州。”然馥之让位，景明亦有其功；其余之事未详","attribution":"裴注·注家按语","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":332,"anchor":null},"note_id":"n-4aeb0f163ff8b37978d7","start":3,"end":60},{"id":"rensu-q-f64cf1a8c7978e162aed","section":"chapter-016","block":"b-c172c36c6f19e1d68402","layer":"pei","quote":"关东义兵起，卓会议大发兵；群僚咸惮卓，莫敢忤旨","attribution":"裴注·张璠《汉纪》","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":338,"anchor":null},"note_id":"n-011440cf6742ee5cb197","start":246,"end":269},{"id":"wudi-e-o009a-q","section":"chapter-001","block":"b-20c7e941eb42ee97df8c","layer":"original","quote":"初平元年春正月〖1〗，后将军袁术、冀州牧韩馥、﹝一﹞豫州刺史孔伷、﹝二﹞兖州刺史刘岱、﹝三﹞河内太守王匡、﹝四﹞勃海太守袁绍、陈留太守张邈、东郡太守桥瑁、﹝五﹞山阳太守袁遗、﹝六﹞济北相鲍信，﹝七﹞同时俱起兵〖2〗。众各数万，推绍为盟主。太祖行奋武将军〖3〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":84,"anchor":null},"note_id":null,"start":0,"end":130},{"id":"wudi-e-o010b-q","section":"chapter-001","block":"b-c3c5890f31591fa3c33e","layer":"original","quote":"是时。绍屯河内〖2〗，邈、岱、瑁、遗屯酸枣〖3〗，术屯南阳〖4〗，伷屯颍川，馥在邺〖5〗。卓兵强，绍等莫敢先进。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":99,"anchor":null},"note_id":null,"start":30,"end":86},{"id":"wudi-e-o015a-q","section":"chapter-001","block":"b-1fad0ca8925dabf48f3f","layer":"original","quote":"袁绍与韩馥谋立幽州牧刘虞为帝〖27〗，太祖拒之。﹝二﹞绍又尝得一玉印〖28〗，于太祖坐中，举向其肘〖29〗；太祖由是笑而恶焉。﹝三﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":104,"anchor":null},"note_id":null,"start":0,"end":66},{"id":"wudi-e-o016a-q","section":"chapter-001","block":"b-15ef6fb810e957089b24","layer":"original","quote":"二年春〖1〗，绍、馥遂立虞为帝，虞终不敢当。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":139,"anchor":null},"note_id":null,"start":0,"end":22},{"id":"wudi-e-o018a-q","section":"chapter-001","block":"b-1692e234ab7a13fd2792","layer":"original","quote":"秋七月，袁绍胁韩馥，取冀州〖2〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":141,"anchor":null},"note_id":null,"start":0,"end":17},{"id":"wudi-e-p022a-q","section":"chapter-001","block":"b-8628e740812ad3fcff78","layer":"pei","quote":"馥字文节，颍川人。为御史中丞。董卓举为冀州牧。","attribution":"《英雄记》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":90,"anchor":null},"note_id":"n-6e459510c0c0ec488b06","start":11,"end":34},{"id":"wudi-e-p022c-q","section":"chapter-001","block":"b-8628e740812ad3fcff78","layer":"pei","quote":"馥得移，请诸从事问曰：‘今当助袁氏邪，助董卓邪？’治中从事刘子惠曰：‘今兴兵为国，何谓袁、董！’馥自知言短，而有惭色。子惠复言：‘兵者凶事，不可为首。今宜往视他州，有发动者，然后和之。冀州于他州不为弱也，他人功未有在冀州之右者也。’馥然之。馥乃作书与绍，道卓之恶，听其举兵。","attribution":"《英雄记》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":90,"anchor":null},"note_id":"n-6e459510c0c0ec488b06","start":121,"end":258},{"id":"wudi-q-b-4a17eb75600ced2abdde","section":"chapter-001","block":"b-4a17eb75600ced2abdde","layer":"modern","quote":"〖1〗初平元年：公元 190 年。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":86,"anchor":null},"note_id":"n-93d66253e23c705b336d","start":0,"end":17},{"id":"wudi-q-b-51f98a867014d3fedddd","section":"chapter-001","block":"b-51f98a867014d3fedddd","layer":"modern","quote":"〖1〗二年：初平二年（公元 191）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":143,"anchor":null},"note_id":"n-675465772382db7c3192","start":0,"end":19},{"id":"wudi-q-o009","section":"chapter-001","block":"b-20c7e941eb42ee97df8c","layer":"original","quote":"初平元年春正月〖1〗，后将军袁术、冀州牧韩馥、﹝一﹞豫州刺史孔伷、﹝二﹞兖州刺史刘岱、﹝三﹞河内太守王匡、﹝四﹞勃海太守袁绍、陈留太守张邈、东郡太守桥瑁、﹝五﹞山阳太守袁遗、﹝六﹞济北相鲍信，﹝七﹞同时俱起兵〖2〗。众各数万，推绍为盟主。太祖行奋武将军〖3〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":84,"anchor":null},"note_id":null,"start":0,"end":130},{"id":"wudi-q-o010","section":"chapter-001","block":"b-c3c5890f31591fa3c33e","layer":"original","quote":"二月，卓闻兵起，乃徙天子都长安〖1〗。卓留屯洛阳，遂焚宫室。是时。绍屯河内〖2〗，邈、岱、瑁、遗屯酸枣〖3〗，术屯南阳〖4〗，伷屯颍川，馥在邺〖5〗。卓兵强，绍等莫敢先进。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":99,"anchor":null},"note_id":null,"start":0,"end":86},{"id":"wudi-q-o015","section":"chapter-001","block":"b-1fad0ca8925dabf48f3f","layer":"original","quote":"袁绍与韩馥谋立幽州牧刘虞为帝〖27〗，太祖拒之。﹝二﹞绍又尝得一玉印〖28〗，于太祖坐中，举向其肘〖29〗；太祖由是笑而恶焉。﹝三﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":104,"anchor":null},"note_id":null,"start":0,"end":66},{"id":"wudi-q-o016","section":"chapter-001","block":"b-15ef6fb810e957089b24","layer":"original","quote":"二年春〖1〗，绍、馥遂立虞为帝，虞终不敢当。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":139,"anchor":null},"note_id":null,"start":0,"end":22},{"id":"wudi-q-o018","section":"chapter-001","block":"b-1692e234ab7a13fd2792","layer":"original","quote":"秋七月，袁绍胁韩馥，取冀州〖2〗。黑山贼于毒、白绕、眭固等十余万众略魏郡、东郡〖3〗，﹝一﹞王肱不能御。太祖引兵入东郡，击白绕于濮阳〖4〗，破之。袁绍因表太祖为东郡太守；治东武阳〖5〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":141,"anchor":null},"note_id":null,"start":0,"end":93},{"id":"wudi-q-p022","section":"chapter-001","block":"b-8628e740812ad3fcff78","layer":"pei","quote":"﹝一﹞《英雄记》曰：“馥字文节，颍川人。为御史中丞。董卓举为冀州牧。于时冀州民人殷盛，兵粮优足。袁绍之在勃海，馥恐其兴兵，遣数部从事守之，不得动摇。东郡太守桥瑁，诈作京师三公移书，与州郡，陈卓罪恶，云‘见逼迫，无以自救；企望义兵，解国患难’。馥得移，请诸从事问曰：‘今当助袁氏邪，助董卓邪？’治中从事刘子惠曰：‘今兴兵为国，何谓袁、董！’馥自知言短，而有惭色。子惠复言：‘兵者凶事，不可为首。今宜往视他州，有发动者，然后和之。冀州于他州不为弱也，他人功未有在冀州之右者也。’馥然之。馥乃作书与绍，道卓之恶，听其举兵。”","attribution":"《英雄记》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":90,"anchor":null},"note_id":"n-6e459510c0c0ec488b06","start":0,"end":259},{"id":"wudi-q-p061","section":"chapter-001","block":"b-346c577b4a71c73e6226","layer":"pei","quote":"﹝二﹞《献帝起居注》曰：“公上言：‘大将军邺侯袁绍，前与冀州牧韩馥立故大司马刘虞，刻作金玺；遣故任长毕瑜，诣虞，为说命录之数。又绍与臣书云：“可都鄄城，当有所立。”擅铸金银印，孝廉、计吏，皆往诣绍。从弟济阴太守叙，与绍书云：“今海内丧败，天意实在我家；神应有征，当在尊兄。南兄臣下欲使即位，南兄言：以年则北兄长，以位则北兄重；便欲送玺，会曹操断道。”绍宗族累世受国重恩，而凶逆无道，乃至于此。辄勒兵马，与战官渡；乘圣朝之威，得斩绍大将淳于琼等八人首，遂大破溃。绍与子谭轻身迸走。凡斩首七万余级，辎重财物巨亿。’”","attribution":"《献帝起居注》所载曹操上言","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":453,"anchor":null},"note_id":"n-3663cf74d422f76a0a08","start":0,"end":256},{"id":"xumisun-q-50c00fbc52e4c7ccad2a","section":"chapter-038","block":"b-c3b105ae63105e37b3ab","layer":"original","quote":"馥等到官，各举兵还向京都，欲以诛卓","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":2,"anchor":null},"note_id":null,"start":173,"end":190},{"id":"xumisun-q-eef790522c664266530f","section":"chapter-038","block":"b-c3b105ae63105e37b3ab","layer":"original","quote":"拜尚书韩馥为冀州牧〖13〗，侍中刘岱为兖州刺史〖14〗，颍川张咨为南阳太守〖15〗，陈留孔伷为豫州刺史〖16〗，东郡张邈为陈留太守","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":2,"anchor":null},"note_id":null,"start":82,"end":147},{"id":"xunyu-e-o004a-q","section":"chapter-010","block":"b-976aa8aeb866c7b60ba5","layer":"original","quote":"会冀州牧同郡韩馥，遣骑迎之，莫有随者，彧独将宗族，至冀州。而袁绍已夺馥位，待彧以上宾之礼；彧弟谌及同郡辛评、郭图，皆为绍所任。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":4,"anchor":null},"note_id":null,"start":0,"end":63},{"id":"xunyu-q-o004","section":"chapter-010","block":"b-976aa8aeb866c7b60ba5","layer":"original","quote":"会冀州牧同郡韩馥，遣骑迎之，莫有随者，彧独将宗族，至冀州。而袁绍已夺馥位，待彧以上宾之礼；彧弟谌及同郡辛评、郭图，皆为绍所任。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":4,"anchor":null},"note_id":null,"start":0,"end":63},{"id":"zhangle-q-o028","section":"chapter-017","block":"b-54ef805fac5cecbf4778","layer":"original","quote":"张郃字*乂，河间鄚人也。汉末，应募讨黄巾，为军司马，属韩馥。馥败，以兵归袁绍。绍以郃为校尉，使拒公孙瓒。瓒破，郃功多，迁宁国中郎将〖1〗。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":100,"anchor":null},"note_id":null,"start":0,"end":69}],"profiles":{},"directory_counts":{}}
