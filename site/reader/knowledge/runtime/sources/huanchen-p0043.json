{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"rensu-e-o104","title":"杜恕与阮武同簿廷尉，阮武评其才性劝成一家言，杜恕后著论","accounts":[{"id":"rensu-a-ed9237b4014b1ac772c5","label":"正文","text":"初杜恕从赵郡还、陈留阮武亦从清河太守征，俱自（薄）〔簿〕廷尉","evidence":["rensu-q-15abe4ed9d7945c76658"]},{"id":"rensu-a-8ff387781e4d0d6f91f5","label":"正文","text":"阮武评杜恕才性并劝潜思成一家言","evidence":["rensu-q-373d48af88d61f692b37"]},{"id":"rensu-a-20b06ef001393f1ea8fb","label":"正文","text":"杜恕在章武著《体论》八篇，又著《兴性论》一篇","evidence":["rensu-q-9d9fafbf0bddcdcc996f"]}],"participants":[{"person":"yuanzhang-p0049","role":"自赵郡还而簿廷尉者；受劝者；著者","evidence":["rensu-q-15abe4ed9d7945c76658","rensu-q-373d48af88d61f692b37","rensu-q-9d9fafbf0bddcdcc996f"]},{"person":"huanchen-p0043","role":"自清河太守征而簿廷尉者；劝勉者","evidence":["rensu-q-15abe4ed9d7945c76658","rensu-q-373d48af88d61f692b37"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["rensu-q-15abe4ed9d7945c76658","rensu-q-373d48af88d61f692b37","rensu-q-9d9fafbf0bddcdcc996f"]},"ordering_evidence":"rensu-q-15abe4ed9d7945c76658","source_order":[16,298,0],"order":3437},{"id":"huanchen-e-o137b","title":"毓举郑冲帝更举未闻者用孙邕","accounts":[{"id":"huanchen-a-4cf9933d2df0c98e405a","label":"正文","text":"毓举郑冲帝更举未闻者用孙邕","evidence":["huanchen-q-c5b52f32d56aede8af4c"]}],"participants":[{"person":"wendi-p0127","role":"举郑冲、乃举阮武孙邕","evidence":["huanchen-q-c5b52f32d56aede8af4c"]},{"person":"shaodi-p0039","role":"被举、帝自知之","evidence":["huanchen-q-c5b52f32d56aede8af4c"]},{"person":"huanchen-p0020","role":"帝于是用邕","evidence":["huanchen-q-c5b52f32d56aede8af4c"]},{"person":"huanchen-p0043","role":"同被举","evidence":["huanchen-q-c5b52f32d56aede8af4c"]},{"person":"wendi-p0005","role":"曰文和吾自知之，更举未闻者；用孙邕","evidence":["huanchen-q-c5b52f32d56aede8af4c"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["huanchen-q-c5b52f32d56aede8af4c"]},"ordering_evidence":"huanchen-q-c5b52f32d56aede8af4c","source_order":[22,544,87],"order":4640}],"persons":[{"id":"huanchen-p0043","name":"阮武","evidence":["huanchen-q-c5b52f32d56aede8af4c","rensu-q-15abe4ed9d7945c76658","rensu-q-373d48af88d61f692b37","rensu-q-3c9a4cdad23e45939f70"],"facts":[{"id":"rensu-f2-d817a49ea44fbbe60380","text":"《阮氏谱》记父谌作《三礼图》；《杜氏新书》记武为清河太守，弟炳为河南尹、撰药方，炳子坦为晋太子少傅、平东将军；《兖州记》记坦选濮阳王文学、迁领军长史，丧官。","evidence":["rensu-q-3c9a4cdad23e45939f70"]}],"aliases":[],"mentions":[]}],"evidence":[{"id":"huanchen-q-c5b52f32d56aede8af4c","section":"chapter-022","block":"b-5297a3a57834eafd96dc","layer":"original","quote":"使毓自选代〖19〗，曰：“得如卿者，乃可。”毓举常侍郑冲〖20〗，帝曰：“文和，吾自知之；更举吾所未闻者。”乃举阮武、孙邕，帝于是用邕","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":543,"anchor":null},"note_id":null,"start":87,"end":154},{"id":"rensu-q-15abe4ed9d7945c76658","section":"chapter-016","block":"b-e1e0355b624d135a86b4","layer":"original","quote":"初，恕从赵郡还，陈留阮武亦从清河太守征；俱自（薄）〔簿〕廷尉","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":297,"anchor":null},"note_id":null,"start":0,"end":30},{"id":"rensu-q-373d48af88d61f692b37","section":"chapter-016","block":"b-e1e0355b624d135a86b4","layer":"original","quote":"谓恕曰：“相观才性可以由公道而持之不厉〖2〗，器能可以处大官而求之不顺〖3〗，才学可以述古今而志之不一〖4〗：此所谓有其才而无其用。今向闲暇，可试潜思，成一家言","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":297,"anchor":null},"note_id":null,"start":34,"end":114},{"id":"rensu-q-3c9a4cdad23e45939f70","section":"chapter-016","block":"b-14b8b0cb7699cc762ab4","layer":"pei","quote":"阮武者，亦拓落大才也。案《阮氏谱》：“武父谌，字士信。征辟无所就，造《三礼图》传于世。”《杜氏新书》曰：“武字文业。阔达博通，渊雅之士。位止清河太守。武弟炳，字叔文。河南尹。精意医术，撰药方一部。炳子坦，字弘舒。晋太子少傅，平东将军。坦弟柯，字士度。”荀绰《兖州记》曰：“坦，出绍伯父，亡，次兄当袭爵；父爱柯，言名传之，遂承封。时幼小，不能让；及长，悔恨，遂幅巾而居；后虽出身，未尝释也。性纯笃闲雅，好礼无违；存心经诰，博学洽闻。选为濮阳王文学，迁领军长史，丧官。王衍，时为领军，哭之甚恸。”","attribution":"裴注（引书见引句）","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":314,"anchor":null},"note_id":"n-aa7fb6e44a9fc589ae4e","start":0,"end":246},{"id":"rensu-q-9d9fafbf0bddcdcc996f","section":"chapter-016","block":"b-e1e0355b624d135a86b4","layer":"original","quote":"在章武，遂著《体论》八篇。﹝一﹞又著《兴性论》一篇","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":297,"anchor":null},"note_id":null,"start":116,"end":141}],"profiles":{},"directory_counts":{}}
