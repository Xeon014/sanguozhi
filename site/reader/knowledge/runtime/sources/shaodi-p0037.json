-q0103"]},{"id":"wgc-m-o008-shaodi-p0037","kind":"mention","text":"本段涉及曹彪","evidence":["wgc-q0007"]},{"id":"wgc-m-o011-shaodi-p0037","kind":"mention","text":"本段涉及曹彪","evidence":["wgc-q0010"]},{"id":"wgc-m-p003-shaodi-p0037","kind":"mention","text":"本段涉及曹彪","evidence":["wgc-q0090"]}]}],"evidence":[{"id":"fangji-q-5d12283daac5c6f774f5","section":"chapter-029","block":"b-ed173d9001fa7429bc23","layer":"original","quote":"谓曹彪曰：“君据藩国，至五十七，当厄于兵，宜善防之","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":190,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":25,"offset_unit":"unicode_code_point"},{"id":"fangji-q-9cb0bd1ada5440d74d74","section":"chapter-029","block":"b-9d9f0df7e311dea39df5","layer":"original","quote":"坐与王凌通谋，赐死","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":195,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":12,"end":21,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-71a94bcca56696a01663","section":"chapter-019","block":"b-c4f19efe0dc366c28ef5","layer":"pei","quote":"《魏氏春秋》曰：“是时，待遇诸国法峻。任城王暴薨，诸王既怀友于之痛；植及白马王彪还国，欲同路东归，以叙隔阔之思，而监国使者不听。植发愤告离而作诗曰：‘谒帝承明庐，逝将归旧疆。清晨发皇邑，日夕过首阳。伊、洛旷且深，欲济川无梁；泛舟越洪涛，怨彼东路长。回顾恋城阙，引领情内伤。大谷何寥廓！山树郁苍苍。霖雨泥我途，流潦浩从横；中逵绝无轨，改辙登高冈。修坂造云日，我马玄以黄。玄黄犹能进，我思郁以纡。郁纡将何念？亲爱在离居。本图相与偕，中更不克俱。鸱枭鸣衡轭，豺狼当路衢。苍蝇间白黑，谗巧（反）〔令〕亲疏。欲还绝无蹊，揽辔止踟蹰。踟蹰亦何留，相思无终极：秋风发微凉，寒蝉鸣我侧。原野何萧条！白日忽西匿。孤兽走索群，衔草不遑食；归鸟赴高林，翩翩厉羽翼。感物伤我怀，抚心长叹息！叹息亦何为，天命与我违。奈何念同生，一往形不归！孤魂翔故域，灵柩寄京师。存者勿复过，亡没身自衰。人生处一世，忽若朝露晞。年在桑榆间，影响不能追。自顾非金石，咄咤令心悲！心悲动我神，弃置莫复陈。丈夫志四海，万里犹比邻。恩爱苟不亏，在远分日亲。何必同衾帱，然后展殷勤？〔忧思成疾疚，无乃儿女仁。〕仓猝骨肉情，能不怀苦辛！苦辛何虑思，天命信可疑。虚无求列仙，松子久吾欺。变故在斯须，百年谁能持？离别永无会，执手将何时？王其爱玉体，俱享黄发期！收涕即长途，援笔从此辞。’”","attribution":"裴注引《魏氏春秋》","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":195,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0a878bba935f7bb4469c","start":146,"end":711,"offset_unit":"unicode_code_point"},{"id":"shaodi-e-o049e-q","section":"chapter-004","block":"b-4379f656c1344049e595","layer":"original","quote":"四月，甲申〖5〗，以征南将军王昶为征南大将军。壬辰〖6〗，大赦。丙午〖7〗，闻太尉王凌谋废帝，立楚王彪〖8〗；太傅司马宣王东征凌。五月，甲寅〖9〗，凌自杀。六月，彪赐死。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":207,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":85,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-b-068bc9d40974f88b77f9","section":"chapter-004","block":"b-068bc9d40974f88b77f9","layer":"modern","quote":"〖1〗三年：嘉平三年（公元 251）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":214,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-563b7a630850bbcc0541","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o048","section":"chapter-004","block":"b-214613f5a625f33a352f","layer":"original","quote":"三年春正月〖1〗，荆州刺史王基、新城太守（陈）〔州〕泰攻吴〖2〗。破之，降者数千口。二月，置南郡之夷陵县以居降附〖3〗。三月，以尚书令司马孚为司空〖4〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":206,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":77,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o049","section":"chapter-004","block":"b-4379f656c1344049e595","layer":"original","quote":"四月，甲申〖5〗，以征南将军王昶为征南大将军。壬辰〖6〗，大赦。丙午〖7〗，闻太尉王凌谋废帝，立楚王彪〖8〗；太傅司马宣王东征凌。五月，甲寅〖9〗，凌自杀。六月，彪赐死。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":207,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":85,"offset_unit":"unicode_code_point"},{"id":"wgc-q0006","section":"chapter-028","block":"b-48d8a8c3b1b7a3ef24e8","layer":"original","quote":"是时，凌外甥令狐愚以才能为兖州刺史，屯平阿〖3〗。舅甥并典兵，专淮南之重。凌就迁为司空〖4〗。司马宣王既诛曹爽，进凌为太尉，假节、钺。凌、愚密协计，谓齐王不任天位〖5〗，楚王彪长而才〖6〗，欲迎立彪都许昌。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":22,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":103,"offset_unit":"unicode_code_point"},{"id":"wgc-q0007","section":"chapter-028","block":"b-ddf21975cc3880c084aa","layer":"original","quote":"嘉平元年九月，愚遣将张式至白马〖7〗，与彪相问往来。凌又遣舍人劳精诣洛阳，语子广。广言：“废立大事，勿为祸先〖8〗！”﹝一﹞其十一月，愚复遣式诣彪，未还，会愚病死。﹝二﹞二年〖9〗，荧惑守南斗〖10〗，凌谓：“斗中有星，当有暴贵者。”﹝三﹞","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":23,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":120,"offset_unit":"unicode_code_point"},{"id":"wgc-q0010","section":"chapter-028","block":"b-c5b208d206b4f5dd30b6","layer":"original","quote":"宣王遂至寿春，张式等皆自首，乃穷治其事。彪赐死〖19〗，诸相连者悉夷三族〖20〗。﹝五﹞朝议咸以为：“《春秋》之义，齐崔杼、郑归生皆加追戮〖21〗，陈尸斲棺〖22〗，载在方策〖23〗。凌、愚罪，宜如旧典。”乃发凌、愚冢，剖棺，暴尸于所近市三日；烧其印绶、朝服，亲土埋之〖24〗。﹝六﹞进弘、华爵为乡侯。广有志尚学行，死时年四十余。﹝七﹞","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":26,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":168,"offset_unit":"unicode_code_point"},{"id":"wgc-q0089","section":"chapter-028","block":"b-38d197ffbf2f29a2df5f","layer":"pei","quote":"﹝一﹞《汉晋春秋》曰：“凌、愚谋，以帝幼，制于强臣，不堪为主；楚王彪长而才，欲迎立之，以兴曹氏。凌使人告广，广曰：‘凡举大事，应本人情。今曹爽以矫奢失民；何平叔虚而不治；丁、毕、桓、邓，虽并有宿望，皆专竞于世。加变易朝典，政令数改；所存虽高，而事不下接；民习于旧，众莫之从。故虽势倾四海，声震天下，同日斩戮，名士减半；而百姓安之，莫或之哀：失民故也。今懿情虽难量，事未有逆；而擢用贤能，广树胜己；修先朝之政令，副众心之所求。爽之所以为恶者，彼莫不必改；夙夜匪懈，以恤民为先；父子兄弟，并握兵要：未易亡也！’凌不从。”臣松之以为：如此言之类，皆前史所不载，而犹出习氏；且制言法体不似于昔：疑悉凿齿所自造者也。","attribution":"汉晋春秋；裴松之按","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":53,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-bbdf8c981acf9fda8742","start":0,"end":303,"offset_unit":"unicode_code_point"},{"id":"wgc-q0090","section":"chapter-028","block":"b-16101e80dd1e52b3a276","layer":"pei","quote":"﹝二﹞《魏书》曰：“愚字公治。本名浚。黄初中，为和戎护军。乌丸校尉田豫讨胡有功，小违节度，愚以法绳之。帝怒，械系愚，免官治罪，诏曰：‘浚何愚！’遂以名之。正始中，为曹爽长史，后出为兖州刺史。”《魏略》曰：“愚闻楚王彪有智勇。初，东郡有讹言云：‘白马河出妖马，夜过官牧边鸣呼，众马皆应。明日见其迹，大如斛，行数里，还入河中。’又有谣言：‘白马素羁西南驰，其谁乘者朱虎骑。’楚王小字‘朱虎’，故愚与王凌阴谋立楚王。乃先使人通意于王，言‘使君谢王，天下事不可知，愿王自爱’！彪亦阴知其意，答言‘谢使君，知厚意也’。”","attribution":"魏书；魏略","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":54,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-81528d5bf8ffad6565b9","start":0,"end":255,"offset_unit":"unicode_code_point"},{"id":"wgc-q0103","section":"chapter-028","block":"b-660cbe8e5bab1896945c","layer":"pei","quote":"﹝二﹞钦与郭淮书曰：“大将军昭伯，与太傅（伯）俱受顾命，登床把臂，托付天下，此远近所知。后以势利，乃绝其祀，及其亲党，皆一时之俊；可为痛心，奈何奈何！公侯（恃）〔特〕与大司马公恩亲分著，义贯金石；当此之时，想益毒痛，有不可堪也！王太尉嫌其专朝，潜欲举兵，事竟不捷，复受诛夷，害及楚王，想甚追恨！太傅既亡，然其子师继承父业，肆其虐暴，日月滋甚；放主弑后，残戮忠良，包藏祸心，遂至篡弑。此可忍也，孰不可忍？钦以名义大故，事君有节，忠愤内发，忘寝与食，无所吝顾也。会毌丘子邦自与父书，腾说公侯尽事主之义，欲奋白发，同符太公，惟须东问，影响相应；闻问之日，能不慷慨！是以不顾妻孥之痛，即与毌丘镇东举义兵三万余人，西趋京师，欲扶持王室，扫除奸逆。企踵西望，不得声问；鲁望高子，不足喻急！夫当仁不让，况救君之难？度道远艰，故不果期要耳。然同舟共济，安危势同，祸痛已连，非言饰所解，自公侯所明也。共事曹氏，积信魏朝，行道之人，皆所知见。然在朝之士，冒利偷生，烈士所耻，公侯所贱；贾竖所不忍为也，况当途之士邪？军屯住项，小人以闰月十六日别进兵，就于乐嘉城讨师；师之徒众，寻时崩溃，其所斩截，不复訾原，但当长驱径至京师；而流言先至，毌丘不复详之，更谓小人为误，诸军便尔瓦解。毌丘还走，追寻释解，无所及。小人还项，复遇王基等十二军追寻毌丘，进兵讨之，即时克破，所向全胜，要那后无继何？孤军梁昌，进退失所；还据寿春，寿春复走；狼狈踬阂，无复他计，惟当归命大吴，借兵乞食，继踵伍员耳。不若仆隶，如何快心？复君之仇，永使曹氏少享血食，此亦大国之所祐念也。想公侯不使程婴、杵臼擅名于前代，而使大魏独无鹰扬之士与？今大吴敦崇大义，深见愍悼。然仆于国，大分连接，远同一势；日欲俱举，瓜分中国，不愿偏取以为已有。公侯必欲共忍师胸怀，宜广大势，恐秦川之卒不可孤举。今者之计，宜屈己伸人，托命归汉，东西俱举，尔乃可克定师党耳。深思鄙言，若愚计可从，宜使汉军克制期要，使六合校考，与周、召同封，以托付儿孙。此亦非小事也，大丈夫宁处其落落，是以远呈忠心，时望嘉应。”时郭淮已卒，钦未知，故有此书。","attribution":"文钦与郭淮书","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":135,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a8c1b3f399f382605fdc","start":0,"end":877,"offset_unit":"unicode_code_point"},{"id":"wgc-q0167","section":"chapter-028","block":"b-ddf21975cc3880c084aa","layer":"original","quote":"嘉平元年九月，愚遣将张式至白马〖7〗，与彪相问往来","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":23,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":25,"offset_unit":"unicode_code_point"},{"id":"wgc-q0181","section":"chapter-028","block":"b-c5b208d206b4f5dd30b6","layer":"original","quote":"彪赐死〖19〗，诸相连者悉夷三族","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":26,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":20,"end":36,"offset_unit":"unicode_code_point"},{"id":"wgc-q0526","section":"chapter-028","block":"b-16101e80dd1e52b3a276","layer":"pei","quote":"乃先使人通意于王，言‘使君谢王，天下事不可知，愿王自爱’！彪亦阴知其意，答言‘谢使君，知厚意也","attribution":"裴注·魏略","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":54,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-81528d5bf8ffad6565b9","start":205,"end":252,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-0616275dc9d083f56554","section":"chapter-020","block":"b-9c18dbbe2f1c753f59d4","layer":"original","quote":"黄初二年，进爵，徙封汝阳公。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":162,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":20,"end":34,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-2ea9aeb5f175c960575f","section":"chapter-020","block":"b-daa9e860aaadc2b68b6b","layer":"original","quote":"于是依汉燕王旦故事〖7〗，使兼廷尉、大鸿胪持节，赐彪玺书切责之〖8〗，使自图焉〖9〗。﹝一﹞彪乃自杀；妃及诸子皆免为庶人，徙平原；彪之官属以下及监国谒者，坐知情无辅导之义，皆伏诛；国除，为淮南郡。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":164,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":65,"end":163,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-30b52d7f505b9e023b89","section":"chapter-020","block":"b-9c18dbbe2f1c753f59d4","layer":"original","quote":"五年〖2〗，改封寿春县。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":162,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":52,"end":64,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-3c9616c3d10aa355cbc9","section":"chapter-020","block":"b-0fe9303ef30986ea355b","layer":"pei","quote":"﹝一﹞孔衍《汉魏春秋》载玺书曰：“夫先王行赏，不遗仇雠；用戮，不违亲戚：至公之义也。故周公流涕，而决二叔之罪；孝武伤怀，而断昭平之狱：古今常典也。惟王：国之至亲，作藩于外；不能祗奉王度，表率宗室；而谋于奸邪，乃与太尉王凌，兖州刺史令狐愚，构通逆谋，图危社稷；有悖忒之心，无忠孝之意。宗庙有灵，王其何面目以见先帝？朕深痛王，自陷罪辜；既得王情，深用怃然。有司奏王当就大理，朕惟公族甸师之义，不忍肆王市朝，故遣使者赐书。王自作孽，匪由于他；燕刺之事，宜足以观。王其自图之！”","attribution":"裴注·汉魏春秋","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":180,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0d5c753355d6159f3687","start":0,"end":235,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-43d12f859d2b8355f1e8","section":"chapter-020","block":"b-9c18dbbe2f1c753f59d4","layer":"original","quote":"楚王彪，字朱虎。建安二十一年，封寿春侯。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":162,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-451261057c25cb0fc660","section":"chapter-020","block":"b-4ed7a9af36faf96acb6f","layer":"original","quote":"初，彪来朝，犯禁；〔青龙〕元年，为有司所奏，诏削县三，户千五百。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":163,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":32,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-6d25c0bc48f1a4e00abd","section":"chapter-020","block":"b-9c18dbbe2f1c753f59d4","layer":"original","quote":"七年〖3〗，徙封白马。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":162,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":64,"end":75,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-7a8a12a16a6e6de0319b","section":"chapter-020","block":"b-9c18dbbe2f1c753f59d4","layer":"original","quote":"其年徙封吴王。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":162,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":45,"end":52,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-8d1cf062fa0e21bb5a21","section":"chapter-020","block":"b-9c18dbbe2f1c753f59d4","layer":"original","quote":"三年〖1〗，封弋阳王。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":162,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":34,"end":45,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-8ffdd20d36fa657ca57e","section":"chapter-020","block":"b-4ed7a9af36faf96acb6f","layer":"original","quote":"景初三年，增户五百，并前三千户。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":163,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":46,"end":62,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-93ca89723cd6195bbac4","section":"chapter-020","block":"b-daa9e860aaadc2b68b6b","layer":"original","quote":"乃遣傅及侍御史〖6〗，就国案验，收治诸相连及者。廷尉请征彪治罪。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":164,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":33,"end":65,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-b8359cdf2e1a69fe9364","section":"chapter-020","block":"b-9c18dbbe2f1c753f59d4","layer":"original","quote":"太和五年冬，朝京都。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":162,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":75,"end":85,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-c2f55f326342aebf012b","section":"chapter-020","block":"b-87027621c423a4f13bd6","layer":"original","quote":"武皇帝二十五男：卞皇后生文皇帝、任城威王彰、陈思王植、萧怀王熊；刘夫人生丰愍王昂、相殇王铄；环夫人生邓哀王冲、彭城王据、燕王宇；杜夫人生沛穆王林、中山恭王衮；秦夫人生济阳怀王玹、陈留恭王峻；尹夫人生范阳闵王矩；王昭仪生赵王幹；孙姬生临邑殇公子上、楚王彪、刚殇公子勤；李姬生谷城殇公子乘、郿戴公子整、灵殇公子京；周姬生樊安公均；刘姬生广宗殇公子棘；宋姬生东平灵王徽；赵姬生乐陵王茂。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":1,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":190,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-c7321fd90322ad253ab5","section":"chapter-020","block":"b-9c18dbbe2f1c753f59d4","layer":"original","quote":"楚王彪，字朱虎。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":162,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":8,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-d192e2c4727c53a97b52","section":"chapter-020","block":"b-9c18dbbe2f1c753f59d4","layer":"original","quote":"六年〖4〗，改封楚。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":162,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":85,"end":95,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-fd6455350cb25b8b7581","section":"chapter-020","block":"b-4ed7a9af36faf96acb6f","layer":"original","quote":"二年〖5〗，大赦，复所削县。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":163,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":32,"end":46,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
