a0c7"],"facts":[],"aliases":[],"mentions":[{"id":"hequan-m-000b1d98b5423298bbe1","kind":"mention","text":"本段涉及全绪","evidence":["hequan-q-6b4d44b969b61f74d8d2"]}]}],"evidence":[{"id":"chenghuang-q-1da7562bc4ca7ae07bed","section":"chapter-055","block":"b-f6550e25d92fd67b6b52","layer":"original","quote":"天寒，雪，敌诸将置酒高会。奉见其前部兵少，相谓曰：“取封侯爵赏，正在今日！”乃使兵解铠著胄，持短兵〖7〗。敌人从而笑焉，不为设备。奉纵兵斫之，大破敌前屯；会据等至，魏军遂溃。迁灭寇将军〖8〗，进封都（亭）〔乡〕侯","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":356,"anchor":null},"note_id":null,"start":0,"end":106},{"id":"chenghuang-q-6a6c8553c5614eb1ca01","section":"chapter-055","block":"b-87fe2456927ad072130b","layer":"original","quote":"东兴之役〖15〗，综为前锋，军败身死。诸葛恪斩送其首，以白权庙","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":59,"anchor":null},"note_id":null,"start":26,"end":57},{"id":"hancui-q-2554659cfd2fbba6bd23","section":"chapter-024","block":"b-f3afcdb8c325c1801064","layer":"original","quote":"吴大将全琮帅数万众来侵寇〖21〗；时州兵休使〖22〗，在者无几。礼躬勒卫兵御之，战于芍陂〖23〗；自旦及暮，将士死伤过半。礼犯蹈白刃，马被数创，手秉枹鼓〖24〗，奋不顾身；贼众乃退。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":338,"anchor":null},"note_id":null,"start":42,"end":133},{"id":"hequan-q-615eefb257697c7b4a15","section":"chapter-060","block":"b-6c5f593279f7e62e0019","layer":"pei","quote":"年四十四卒","attribution":"裴注·《吴书》","section_title":"贺全吕周钟离传第十五","source":{"file":"OEBPS/Text/titlepage_0127.xhtml","index":159,"anchor":null},"note_id":"n-745969b04e6140fa105c","start":77,"end":82},{"id":"hequan-q-6b4d44b969b61f74d8d2","section":"chapter-060","block":"b-6c5f593279f7e62e0019","layer":"pei","quote":"孙亮即位，迁镇北将军","attribution":"裴注·《吴书》","section_title":"贺全吕周钟离传第十五","source":{"file":"OEBPS/Text/titlepage_0127.xhtml","index":159,"anchor":null},"note_id":"n-745969b04e6140fa105c","start":38,"end":48},{"id":"hequan-q-ae4ded7244b535b59ef0","section":"chapter-060","block":"b-6c5f593279f7e62e0019","layer":"pei","quote":"东关之役，绪与丁奉，建议引兵先出；以破魏军，封一子亭侯","attribution":"裴注·《吴书》","section_title":"贺全吕周钟离传第十五","source":{"file":"OEBPS/Text/titlepage_0127.xhtml","index":159,"anchor":null},"note_id":"n-745969b04e6140fa105c","start":49,"end":76},{"id":"hequan-q-d1b07df776747058959f","section":"chapter-060","block":"b-6c5f593279f7e62e0019","layer":"pei","quote":"琮长子绪，幼知名。奉朝请。出授兵，稍迁扬武将军，牛渚督","attribution":"裴注·《吴书》","section_title":"贺全吕周钟离传第十五","source":{"file":"OEBPS/Text/titlepage_0127.xhtml","index":159,"anchor":null},"note_id":"n-745969b04e6140fa105c","start":10,"end":37},{"id":"santizhu-q-8812753a9ed1bf501f17","section":"chapter-048","block":"b-9b3f5181b40c2019f20c","layer":"original","quote":"甲寅〖11〗，恪以大兵赴敌。戊午〖12〗，兵及东兴，交战；大破魏军，杀将军韩综、桓嘉等","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":14,"anchor":null},"note_id":null,"start":102,"end":145},{"id":"santizhu064-q-c0aaa14c0306cbe5684d","section":"chapter-064","block":"b-d3196146b5b40af27868","layer":"original","quote":"恪兴军四万，晨夜赴救。遵等敕其诸军：作浮桥渡，阵于堤上〖6〗，分兵攻两城。城在高峻，不可猝拔。恪遣将军留赞、吕据、唐咨、丁奉为前部。时天寒，雪，魏诸将会饮。见赞等兵少，而解置铠甲，不持矛戟；但兜鍪刀盾〖7〗，裸身缘遏〖8〗：大笑之，不即严兵〖9〗。兵得上，便鼓噪乱斫〖10〗。魏军惊扰散走，争渡浮桥；桥坏绝，自投于水，更相蹈藉。乐安太守桓嘉等，同时并没〖11〗，死者数万。故叛将韩综为魏前军督〖12〗，亦斩之。获车乘牛、马、驴、骡各数千，资器山积，振旅而归〖13〗。","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":164,"anchor":null},"note_id":null,"start":0,"end":233},{"id":"shaodi-e-o013a-q","section":"chapter-004","block":"b-0cd1e6082bde64409582","layer":"original","quote":"夏五月，吴将朱然等围襄阳之樊城，太傅司马宣王率众拒之。﹝一﹞六月，辛丑〖5〗，退。己卯〖6〗，以征东将军王凌为车骑将军〖7〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":59,"anchor":null},"note_id":null,"start":0,"end":63},{"id":"shaodi-q-b-f56b355cff79244bd89c","section":"chapter-004","block":"b-f56b355cff79244bd89c","layer":"modern","quote":"〖1〗二年：正始二年（公元 241）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":62,"anchor":null},"note_id":"n-bf9ccbeb544f540e6afb","start":0,"end":19},{"id":"shaodi-q-o012","section":"chapter-004","block":"b-33e60ac0c003858f0640","layer":"original","quote":"二年春二月〖1〗，帝初通《论语》〖2〗。使太常以太牢祭孔子于辟雍〖3〗，以颜渊配〖4〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":58,"anchor":null},"note_id":null,"start":0,"end":44},{"id":"wgc-q0005","section":"chapter-028","block":"b-280a1e8d1f852b5e78af","layer":"original","quote":"二年〖1〗，吴大将全琮数万众寇芍陂〖2〗。凌率诸军逆讨，与贼争塘，力战连日，贼退走。进封南乡侯，邑千三百五十户；迁车骑将军，仪同三司。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":21,"anchor":null},"note_id":null,"start":0,"end":67},{"id":"wgc-q0159","section":"chapter-028","block":"b-280a1e8d1f852b5e78af","layer":"original","quote":"吴大将全琮数万众寇芍陂〖2〗。凌率诸军逆讨，与贼争塘，力战连日，贼退走","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":21,"anchor":null},"note_id":null,"start":6,"end":41},{"id":"wuzhu-e-o133b-q","section":"chapter-047","block":"b-8af6f7908a818f7cd9b1","layer":"original","quote":"琮与魏将王凌，战于芍陂；中郎将秦晃等十余人，战死。车骑将军朱然围樊，大将军诸葛瑾取柤中〖15〗。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":168,"anchor":null},"note_id":null,"start":56,"end":104},{"id":"wuzhu-q-o132","section":"chapter-047","block":"b-339340f557e9065aedfa","layer":"original","quote":"四年春正月〖10〗，大雪，平地深三尺，鸟兽死者太半。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":167,"anchor":null},"note_id":null,"start":0,"end":26},{"id":"zhanggu-q-2113b80d6f9f8a3da0c7","section":"chapter-052","block":"b-027aa53bd5dbba95ebf6","layer":"original","quote":"时长公主婿卫将军全琮子寄，为霸宾客〖19〗；寄素倾邪〖20〗，谭所不纳。先是，谭弟承与张休俱北征寿春，全琮时为大都督；与魏将王凌战于芍陂，军不利，魏兵乘胜陷没五营将秦（儿）〔晃〕军；休、承奋击之，遂驻魏师〖21〗。时琮群子绪、端，亦并为将，因敌既驻，乃进击之：凌军用退","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":197,"anchor":null},"note_id":null,"start":0,"end":134},{"id":"zhulv-q-305b4439281ed74f2920","section":"chapter-056","block":"b-604767dbf5853a5d004b","layer":"original","quote":"魏出东兴，据赴讨有功","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":199,"anchor":null},"note_id":null,"start":10,"end":20},{"id":"zhulv-q-77551a11b8ee4f203b3f","section":"chapter-056","block":"b-abd659c367dbc19a7af5","layer":"original","quote":"是岁，魏遣胡遵、诸葛诞等出东兴。异督水军攻浮梁〖6〗，坏之，魏军大破","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":285,"anchor":null},"note_id":null,"start":11,"end":45}],"profiles":{},"directory_counts":{}}
