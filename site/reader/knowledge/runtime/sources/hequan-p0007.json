"id":"santizhu-a-18665e6f5decf439d8f2","label":"正文","text":"诸葛恪赴援东兴戊午交战大破魏军","evidence":["santizhu-q-8812753a9ed1bf501f17"]},{"id":"santizhu064-a-3ec507660e3f43424f78","label":"正文","text":"恪兴军四万晨夜赴救东兴，遣留赞、吕据、唐咨、丁奉为前部；雪中解甲缘遏鼓噪，魏军争渡浮桥，桥坏自溺死者数万，桓嘉并没，斩故叛将韩综，获资器山积而还","evidence":["santizhu064-q-c0aaa14c0306cbe5684d"]},{"id":"hequan-a-d5028d0d76fb7c0b2aa5","label":"裴注·《吴书》","text":"东关之役全绪与丁奉建议引兵先出破魏军","evidence":["hequan-q-ae4ded7244b535b59ef0"]},{"id":"chenghuang-a-f5817e61cfb8c3186c99","label":"正文","text":"东兴之役综为前锋军败身死恪斩首白庙","evidence":["chenghuang-q-6a6c8553c5614eb1ca01"]},{"id":"chenghuang-a-fe57b12b518a30474084","label":"正文","text":"东兴雪中奋短兵大破魏前屯","evidence":["chenghuang-q-1da7562bc4ca7ae07bed"]},{"id":"zhulv-a-433c35e0cba0625c4782","label":"正文","text":"魏出东兴，据赴讨有功","evidence":["zhulv-q-305b4439281ed74f2920"]},{"id":"zhulv-a-9a1f642773fb323a3b31","label":"正文","text":"是岁，魏遣胡遵、诸葛诞等出东兴；异督水军攻浮梁，坏之，魏军大破","evidence":["zhulv-q-77551a11b8ee4f203b3f"]}],"participants":[{"person":"shaodi-p0041","role":"率军赴援并于东兴交战","evidence":["santizhu-q-8812753a9ed1bf501f17"]},{"person":"wuzhu-p0056","role":"被杀的魏将","evidence":["santizhu-q-8812753a9ed1bf501f17"]},{"person":"santizhu-p0006","role":"被杀的魏将","evidence":["santizhu-q-8812753a9ed1bf501f17"]},{"person":"shaodi-p0076","role":"为前部，解甲缘遏先登","evidence":["santizhu064-q-c0aaa14c0306cbe5684d"]},{"person":"wuzhu-p0088","role":"为前部","evidence":["santizhu064-q-c0aaa14c0306cbe5684d"]},{"person":"santizhu-p0017","role":"为前部，解甲缘遏先登","evidence":["santizhu064-q-c0aaa14c0306cbe5684d"]},{"person":"hequan-p0007","role":"与丁奉建议引兵先出、破魏军、封一子亭侯","evidence":["hequan-q-ae4ded7244b535b59ef0"]},{"person":"wuzhu-p0127","role":"会至，魏军遂溃","evidence":["chenghuang-q-1da7562bc4ca7ae07bed"]},{"person":"mingdi-p0033","role":"出东兴者","evidence":["zhulv-q-77551a11b8ee4f203b3f"]},{"person":"shaodi-p0044","role":"出东兴者","evidence":["zhulv-q-77551a11b8ee4f203b3f"]},{"person":"wuzhu-p0126","role":"督水军坏浮梁者","evidence":["zhulv-q-77551a11b8ee4f203b3f"]}],"place":null,"time":{"label":"原