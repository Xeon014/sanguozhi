{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o092b","title":"袁尚再攻袁谭与曹操围邺","accounts":[{"id":"wudi-e-o092b-account","label":"正文","text":"袁尚留苏由、审配守邺而再攻袁谭；曹操至洹水受苏由降，进围邺并作土山地道，尹楷屯毛城维持粮道。","evidence":["wudi-e-o092b-q"]},{"id":"chengguo-a-eef35bdc063a2a945e18","label":"正文","text":"董昭进围邺城","evidence":["chengguo-q-3dd3a1390375a0b1eaee"]},{"id":"liusima-a-e597b9b0866a3f29a6a5","label":"裴注·魏略列传","text":"太祖围邺，尚还救未到，与李孚议遣使令审配知外动止","evidence":["liusima-q-4e4e9578692fd04fae52"]},{"id":"lizang-a-022adfa7139e5cb09ad0","label":"正文","text":"李典从围邺，邺定","evidence":["lizang-q-87d8343c262aebe7d2dc"]},{"id":"lizang-a-67c8ef615ff9b479b2d3","label":"正文","text":"许褚从围邺力战有功，赐爵关内侯","evidence":["lizang-q-5f35228d0fe3ed7cf018"]}],"participants":[{"person":"wudi-p0198","role":"出攻","evidence":["wudi-e-o092b-q"]},{"person":"wudi-p0163","role":"被攻","evidence":["wudi-e-o092b-q"]},{"person":"wudi-p0207","role":"投降","evidence":["wudi-e-o092b-q"]},{"person":"wudi-p0208","role":"守邺","evidence":["wudi-e-o092b-q"]},{"person":"cao-cao","role":"围城","evidence":["wudi-e-o092b-q"]},{"person":"wudi-p0209","role":"屯兵通粮","evidence":["wudi-e-o092b-q"]},{"person":"wudi-p0122","role":"进围邺城","evidence":["chengguo-q-3dd3a1390375a0b1eaee"]},{"person":"liusima-p0035","role":"与尚议所遣","evidence":["liusima-q-4e4e9578692fd04fae52"]},{"person":"wudi-p0237","role":"从围邺","evidence":["lizang-q-87d8343c262aebe7d2dc"]},{"person":"shaodi-p0015","role":"从围邺力战赐爵关内侯","evidence":["lizang-q-5f35228d0fe3ed7cf018"]}],"place":{"text":"邺、洹水、毛城、上党","evidence":["wudi-e-o092b-q"]},"time":{"label":"建安九年二月","year":204,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o092b-q","wudi-q-o092","wudi-q-b-6787e3ddd3e334b677d4"],"chronology":"wudi-y204","dating_review":{"anchor":"wudi-q-o092","basis":"建安九年二月","reviewed":true}},"source_order":[1,507,"O092b"],"order":218},{"id":"dongyuan-e-o060a","title":"袁尚复攻袁谭审配苏由守邺苏由反败奔曹","accounts":[{"id":"dongyuan-e-o060a-account","label":"《董二袁刘传第六》正文","text":"袁尚复攻袁谭审配苏由守邺苏由反败奔曹","evidence":["dongyuan-e-o060a-q"]}],"participants":[{"person":"wudi-p0198","role":"攻谭","evidence":["dongyuan-e-o060a-q"]},{"person":"wudi-p0208","role":"守城拒叛","evidence":["dongyuan-e-o060a-q"]},{"person":"wudi-p0207","role":"谋应败走","evidence":["dongyuan-e-o060a-q"]},{"person":"cao-cao","role":"进军","evidence":["dongyuan-e-o060a-q"]}],"place":null,"time":{"label":"曹操攻邺时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-o060a-q"]},"ordering_evidence":"dongyuan-e-o060a-q","source_order":[6,342,"O060a"],"order":1692}],"persons":[{"id":"wudi-p0207","name":"苏由","evidence":["wudi-q-o092","dongyuan-q-o060"],"facts":[],"aliases":[],"mentions":[{"id":"wudi-m-o092-wudi-p0207","kind":"mention","text":"文中提及","evidence":["wudi-q-o092"]},{"id":"dongyuan-m-o060-wudi-p0207","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o060"]}]}],"evidence":[{"id":"chengguo-q-3dd3a1390375a0b1eaee","section":"chapter-014","block":"b-546398c9e99f491661e8","layer":"original","quote":"良死后，进围邺城","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":178,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":115,"end":123,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-o060a-q","section":"chapter-006","block":"b-523fd61ee056a488fead","layer":"original","quote":"尚使审配、苏由守邺，复攻谭平原。太祖进军将攻邺，到洹水，去邺五十里。由欲为内应，谋泄；与配战城中，败，出奔太祖。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":341,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":56,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o060","section":"chapter-006","block":"b-523fd61ee056a488fead","layer":"original","quote":"尚使审配、苏由守邺，复攻谭平原。太祖进军将攻邺，到洹水，去邺五十里。由欲为内应，谋泄；与配战城中，败，出奔太祖。太祖遂进攻之，为地道；配亦于内作堑以当之〖8〗。配将冯礼开突门〖9〗，纳太祖兵三百余人；配觉之，从城上以大石击突中栅门，栅门闭，入者皆没。太祖遂围之，为堑，周四十里。初令浅，示若可越。配望而笑之，不出争利〖10〗。太祖一夜掘之，广深二丈；决漳水以灌之。自五月至八月，城中饿死者过半。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":341,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":197,"offset_unit":"unicode_code_point"},{"id":"liusima-q-4e4e9578692fd04fae52","section":"chapter-015","block":"b-2fb260215c97884ad3d8","layer":"pei","quote":"会太祖围邺，尚还欲救邺；行未到，尚疑邺中守备少，复欲令配知外动止，与孚议所遣","attribution":"裴注·魏略列传","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":300,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-aaaf08e9bea919e96c3f","start":110,"end":148,"offset_unit":"unicode_code_point"},{"id":"lizang-q-5f35228d0fe3ed7cf018","section":"chapter-018","block":"b-8b66deb3a2ffff0f086b","layer":"original","quote":"从围邺，力战有功，赐爵关内侯","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":130,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":174,"end":188,"offset_unit":"unicode_code_point"},{"id":"lizang-q-87d8343c262aebe7d2dc","section":"chapter-018","block":"b-2d2b7f4d5bd4d51b6feb","layer":"original","quote":"从围邺。邺定","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":3,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":110,"end":116,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o092b-q","section":"chapter-001","block":"b-3e549c423b15df48398a","layer":"original","quote":"二月，尚复攻谭，留苏由、审配守邺〖3〗。公进军到洹水〖4〗，由降；既至，攻邺，为土山、地道。武安长尹楷屯毛城〖5〗，通上党粮道〖6〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":506,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":26,"end":93,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-6787e3ddd3e334b677d4","section":"chapter-001","block":"b-6787e3ddd3e334b677d4","layer":"modern","quote":"〖1〗九年：建安九年（公元 204）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":510,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c8fff97bafc82c655f3f","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o092","section":"chapter-001","block":"b-3e549c423b15df48398a","layer":"original","quote":"九年春正月〖1〗，济河，遏淇水入白沟以通粮道〖2〗。二月，尚复攻谭，留苏由、审配守邺〖3〗。公进军到洹水〖4〗，由降；既至，攻邺，为土山、地道。武安长尹楷屯毛城〖5〗，通上党粮道〖6〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":506,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":93,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
