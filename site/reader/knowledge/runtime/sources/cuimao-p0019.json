2e","label":"正文","text":"司马岐居家未期而卒，年三十五，子肇嗣","evidence":["cuimao-q-1bc6b2dd0245f84ec52d"]}],"participants":[{"person":"cuimao-p0019","role":"以疾去官者；卒者（年三十五）","evidence":["cuimao-q-472438e145c4a5042ccd","cuimao-q-1bc6b2dd0245f84ec52d"]},{"person":"cuimao-p0020","role":"嗣者","evidence":["cuimao-q-1bc6b2dd0245f84ec52d"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["cuimao-q-472438e145c4a5042ccd","cuimao-q-1bc6b2dd0245f84ec52d"]},"ordering_evidence":"cuimao-q-472438e145c4a5042ccd","source_order":[12,402,115],"order":2845}],"persons":[{"id":"cuimao-p0019","name":"司马岐","evidence":["cuimao-q-dc84bf970ce5d3dc3622","cuimao-q-dafce03ea96c23eb1ba8","cuimao-q-01300d70372557e1c746","cuimao-q-472438e145c4a5042ccd","cuimao-q-1bc6b2dd0245f84ec52d","cuimao-q2-4145827f8b7e3f9791ec"],"facts":[{"id":"cuimao-f2-728338c654f281f9bb15","text":"司马岐为司马芝子，父亡后嗣；从河南丞转廷尉正，迁陈留相。","evidence":["cuimao-q2-4145827f8b7e3f9791ec"]}],"aliases":[],"mentions":[]}],"evidence":[{"id":"cuimao-q-01300d70372557e1c746","section":"chapter-012","block":"b-a86b26286383fccaf981","layer":"original","quote":"飏讯狱，将致泰重刑。岐数飏曰〖6〗：“夫枢机大臣，王室之佐；既不能辅化成德，齐美古人；而乃肆其私忿，枉论无辜〖7〗。使百姓危心，非此焉在！”飏于是惭怒而退","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":401,"anchor":null},"note_id":null,"start":37,"end":114},{"id":"cuimao-q-1bc6b2dd0245f84ec52d","section":"chapter-012","block":"b-a5e5ec3f4a47eb2eb018","layer":"original","quote":"居家未期而卒〖8〗，年三十五。子肇嗣","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":402,"anchor":null},"note_id":null,"start":0,"end":18},{"id":"cuimao-q-3eba29525514a7f6ae05","section":"chapter-012","block":"b-a86b26286383fccaf981","layer":"original","quote":"南阳圭泰尝以言迕指，考系廷尉","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":401,"anchor":null},"note_id":null,"start":22,"end":36},{"id":"cuimao-q-472438e145c4a5042ccd","section":"chapter-012","block":"b-a86b26286383fccaf981","layer":"original","quote":"岐终恐久获罪，以疾去官","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":401,"anchor":null},"note_id":null,"start":115,"end":126},{"id":"cuimao-q-dafce03ea96c23eb1ba8","section":"chapter-012","block":"b-b49c77998858c51fdcb7","layer":"original","quote":"及囚至，诘之，皆莫敢匿诈；一朝决竟〖5〗，遂超为廷尉","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":400,"anchor":null},"note_id":null,"start":102,"end":128},{"id":"cuimao-q-dc84bf970ce5d3dc3622","section":"chapter-012","block":"b-b49c77998858c51fdcb7","layer":"original","quote":"梁郡有系囚，多所连及，数岁不决。诏书徙狱于岐属县〖2〗，县请预治牢具〖3〗。岐曰：“今囚有数十，既巧诈难符，且已倦楚毒〖4〗；其情易见，岂当复久处囹圄邪","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":400,"anchor":null},"note_id":null,"start":24,"end":100},{"id":"cuimao-q2-4145827f8b7e3f9791ec","section":"chapter-012","block":"b-b49c77998858c51fdcb7","layer":"original","quote":"芝亡，子岐嗣。从河南丞转廷尉正〖1〗。迁陈留相。梁郡有系囚，多所连及，数岁不决。诏书徙狱于岐属县〖2〗，县请预治牢具〖3〗。岐曰：“今囚有数十，既巧诈难符，且已倦楚毒〖4〗；其情易见，岂当复久处囹圄邪！”及囚至，诘之，皆莫敢匿诈；一朝决竟〖5〗，遂超为廷尉。","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":400,"anchor":null},"note_id":null,"start":0,"end":129}],"profiles":{},"directory_counts":{}}
