{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"yuanzhang-e-o223","title":"至十六年关中乱，石德林南入汉中，不治产业不蓄妻孥，常读《老子》五千文及诸内书昼夜吟咏","accounts":[{"id":"yuanzhang-a-a7189f64bf3f2fda10c0","label":"裴注·魏略","text":"至十六年关中乱，石德林南入汉中，不治产业不蓄妻孥，常读《老子》五千文及诸内书昼夜吟咏","evidence":["yuanzhang-q-c30f479ba2139c6ff696"]},{"id":"yuanzhang-a-4b402e8f41b723110796","label":"裴注·魏略","text":"到二十五年汉中破，石德林随众还长安，遂痴愚不复识人","evidence":["yuanzhang-q-782a333dd682ad7609aa"]},{"id":"yuanzhang-a-3ad4e56b6da836c3b7c5","label":"裴注·魏略","text":"石德林食不求味冬夏常衣弊布连结衣，独居穷巷小屋无亲里；人与衣食不肯取，郡县以其鳏穷给廪日五升，食不足颇行乞乞不取多；人问姓字不肯言，故号之曰寒贫","evidence":["yuanzhang-q-819c77721608d4d9a327"]},{"id":"yuanzhang-a-bb75017634d0b11e6911","label":"裴注·魏略","text":"或素有与石德林相知者往存恤之，辄拜跪，由是人谓其不痴；车骑将军郭淮以意气呼之问其所欲亦不肯言，淮与脯糒及衣，不取其衣，取脯一朐糒一升而止","evidence":["yuanzhang-q-230b8ebf80c062222e40"]}],"participants":[{"person":"yuanzhang-p0021","role":"关中乱后南入汉中，初不治产业不蓄妻孥，常读《老子》五千文及诸内书，昼夜吟咏；汉中破后随众还长安，遂痴愚不复识人；独居穷巷小屋无亲里，人与衣食不肯取，郡县以其鳏穷给廪日五升，食不足颇行乞乞不取多，人问姓字不肯言，故因号之曰寒贫；对存恤者辄拜跪，人谓其不痴，不取其衣，取其脯一朐糒一升而止","evidence":["yuanzhang-q-c30f479ba2139c6ff696","yuanzhang-q-782a333dd682ad7609aa","yuanzhang-q-819c77721608d4d9a327","yuanzhang-q-230b8ebf80c062222e40"]},{"person":"mingdi-p0100","role":"车骑将军，以意气呼寒贫问其所欲，因与脯糒及衣","evidence":["yuanzhang-q-230b8ebf80c062222e40"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["yuanzhang-q-c30f479ba2139c6ff696","yuanzhang-q-782a333dd682ad7609aa","yuanzhang-q-819c77721608d4d9a327","yuanzhang-q-230b8ebf80c062222e40"]},"ordering_evidence":"yuanzhang-q-c30f479ba2139c6ff696","source_order":[11,587,371],"order":2699}],"persons":[{"id":"yuanzhang-p0021","name":"寒贫","evidence":["yuanzhang-q-c30f479ba2139c6ff696","yuanzhang-q-782a333dd682ad7609aa","yuanzhang-q-819c77721608d4d9a327","yuanzhang-q-230b8ebf80c062222e40"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[{"id":"yuanzhang-q-230b8ebf80c062222e40","section":"chapter-011","block":"b-b231154adff6ffdc2e1e","layer":"pei","quote":"或素有与相知者，往存恤之；辄拜跪，由是人谓其不痴。车骑将军郭淮，以意气呼之，问其所欲，亦不肯言。淮因与脯糒及衣；不取其衣，取其脯一朐、糒一升而止","attribution":"裴注·魏略","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":586,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b7cd54da3218ee27e64c","start":536,"end":608,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-782a333dd682ad7609aa","section":"chapter-011","block":"b-b231154adff6ffdc2e1e","layer":"pei","quote":"到二十五年，汉中破；随众还长安，遂痴愚不复识人","attribution":"裴注·魏略","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":586,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b7cd54da3218ee27e64c","start":415,"end":438,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-819c77721608d4d9a327","section":"chapter-011","block":"b-b231154adff6ffdc2e1e","layer":"pei","quote":"食不求味，冬夏常衣弊布连结衣。体如无所胜，目如无所见。独居穷巷小屋，无亲里。人与之衣食，不肯取。郡县以其鳏穷，给廪，日五升。食不足，颇行乞，乞不取多。人问其姓字，又不肯言，故因号之曰‘寒贫’也","attribution":"裴注·魏略","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":586,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b7cd54da3218ee27e64c","start":439,"end":535,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-c30f479ba2139c6ff696","section":"chapter-011","block":"b-b231154adff6ffdc2e1e","layer":"pei","quote":"至十六年，关中乱，南入汉中。初不治产业，不蓄妻孥，常读《老子》五千文及诸内书，昼夜吟咏","attribution":"裴注·魏略","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":586,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b7cd54da3218ee27e64c","start":371,"end":414,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
