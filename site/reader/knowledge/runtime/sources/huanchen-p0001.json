9f52aa289","huanchen-q-01fca3bdbcbaaa53a0c6","cuimao-q-08eae4615eac3e446549","cuimao-q-aef71fd078e809554b66","cuimao-q-18835d2af1db80476b35","cuimao-q-011dbd59c82b45223044","rencheng-q-d03686e2606537d5155a","rencheng-q-c26de6f52a75b26f2d21","rencheng-q-66fa15f05eac02e10fe0","rencheng-q-9c6fd9c2d4f66390b099","rencheng-q-2176b93e8e7aa0f1f6ee","rencheng-q-c81712bc09e84e801f87","rencheng-q-5b6b2113e5bb34e8c8f2","wangwei-q-e7d757239e9bee096300"],"facts":[{"id":"rencheng-f-21f3de1b6b2f7aa00901","text":"字正礼，沛郡人，丁冲之子。","evidence":["rencheng-q-5b6b2113e5bb34e8c8f2"]}],"aliases":[],"mentions":[]}],"evidence":[{"id":"cuimao-q-011dbd59c82b45223044","section":"chapter-012","block":"b-12ec9479cee2fb4b3c56","layer":"pei","quote":"夔终不屈志，仪后果以凶伪，败","attribution":"裴注·《魏书》","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":255,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cdde0917d9029a309b9c","start":99,"end":113,"offset_unit":"unicode_code_point"},{"id":"cuimao-q-08eae4615eac3e446549","section":"chapter-012","block":"b-cd085f0bc2343b371c06","layer":"original","quote":"丁仪等见宠于时，并害之，而奕终不为动","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":188,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":67,"end":85,"offset_unit":"unicode_code_point"},{"id":"cuimao-q-18835d2af1db80476b35","section":"chapter-012","block":"b-12ec9479cee2fb4b3c56","layer":"pei","quote":"尚书傅巽谓夔曰：‘仪不相好已甚。子友毛玠，玠等，仪已害之矣。子宜少下之","attribution":"裴注·《魏书》","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":255,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cdde0917d9029a309b9c","start":25,"end":60,"offset_unit":"unicode_code_point"},{"id":"cuimao-q-aef71fd078e809554b66","section":"chapter-012","block":"b-6c778cf54c0f22a327b0","layer":"pei","quote":"或谓奕曰：‘夫以史鱼之直，孰与蘧伯玉之智？丁仪方贵重，宜思所以下之。’奕曰：‘以公明圣，仪岂得久行其伪乎！且奸以事君者，吾所能御也。子宁以他规我","attribution":"裴注·《魏书》","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":201,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0c3116d0d2e2506eb32b","start":10,"end":82,"offset_unit":"unicode_code_point"},{"id":"cuimao-q-e1b4ef7696e8c5bb3c3e","section":"chapter-012","block":"b-12ec9479cee2fb4b3c56","layer":"pei","quote":"夔曰：‘为不义，适足害其身，焉能害人？且怀奸佞之心，立于明朝，其得久乎","attribution":"裴注·《魏书》","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":255,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cdde0917d9029a309b9c","start":62,"end":97,"offset_unit":"unicode_code_point"},{"id":"huanchen-q-01fca3bdbcbaaa53a0c6","section":"chapter-022","block":"b-fde3ea16fb0f48bf4083","layer":"original","quote":"又毛玠、徐奕以刚謇少党〖7〗，而为西曹掾丁仪所不善〖8〗；仪屡言其短，赖阶左右以自全保〖9〗。其将顺匡救，多此类也","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":21,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":54,"end":111,"offset_unit":"unicode_code_point"},{"id":"huanchen-q-c7f8aa442079f52aa289","section":"chapter-022","block":"b-62ccfab46bacc14e8c55","layer":"original","quote":"太祖久不立太子，而方奇贵临淄侯〖1〗。丁仪等为之羽翼，劝臻自结〖2〗；臻以大义拒之","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":492,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":22,"end":63,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-2176b93e8e7aa0f1f6ee","section":"chapter-019","block":"b-9ce02f626f30b519d511","layer":"pei","quote":"及太子立，欲治仪罪，转仪为右刺奸掾，欲仪自裁；而仪不能，乃对中领军夏侯尚叩头求哀。尚为涕泣而不能救。后遂因职事收付狱，杀之。”","attribution":"裴注引《魏略》","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":77,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-970c26b9a52ff7495abf","start":296,"end":359,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-5b6b2113e5bb34e8c8f2","section":"chapter-019","block":"b-9ce02f626f30b519d511","layer":"pei","quote":"﹝一﹞《魏略》曰：“丁仪字正礼，沛郡人也。父冲，宿与太祖亲善。时随乘舆，见国家未定，乃与太祖书曰：‘足下平生，常喟然有匡佐之志，今其时矣。’是时张杨适还河内，太祖得其书；乃引军迎天子，东诣许，以冲为司隶校尉。后，数来过诸将饮，酒美不能止，醉烂肠死。太祖以冲前见开导，常德之。闻仪为令士，虽未见，欲以爱女妻之，以问五官将。五官将曰：‘女人观貌；而正礼，目不便，诚恐爱女未必悦也。以为不如与伏波子楙。’太祖从之。寻辟仪为掾，到，与论议，嘉其才朗，曰：‘丁掾，好士也！即使其两目盲，尚当与女，何况但眇？是吾儿误我。’时，仪亦恨不得尚公主，而与临淄侯亲善，数称其奇才。太祖既有意欲立植，而仪又共赞之。及太子立，欲治仪罪，转仪为右刺奸掾，欲仪自裁；而仪不能，乃对中领军夏侯尚叩头求哀。尚为涕泣而不能救。后遂因职事收付狱，杀之。”","attribution":"裴注（引书见原文）","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":77,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-970c26b9a52ff7495abf","start":0,"end":359,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-66fa15f05eac02e10fe0","section":"chapter-019","block":"b-9ce02f626f30b519d511","layer":"pei","quote":"太祖以冲前见开导，常德之。闻仪为令士，虽未见，欲以爱女妻之，以问五官将。五官将曰：‘女人观貌；而正礼，目不便，诚恐爱女未必悦也。以为不如与伏波子楙。’太祖从之。寻辟仪为掾，到，与论议，嘉其才朗，曰：‘丁掾，好士也！即使其两目盲，尚当与女，何况但眇？是吾儿误我。’","attribution":"裴注引《魏略》","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":77,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-970c26b9a52ff7495abf","start":124,"end":255,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-9c6fd9c2d4f66390b099","section":"chapter-019","block":"b-9ce02f626f30b519d511","layer":"pei","quote":"时，仪亦恨不得尚公主，而与临淄侯亲善，数称其奇才。太祖既有意欲立植，而仪又共赞之。","attribution":"裴注引《魏略》","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":77,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-970c26b9a52ff7495abf","start":255,"end":296,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-c26de6f52a75b26f2d21","section":"chapter-019","block":"b-306bfb9ac55b91914ad4","layer":"original","quote":"文帝即王位，诛丁仪、丁廙，并其男口；","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":69,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":18,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-c81712bc09e84e801f87","section":"chapter-019","block":"b-9ce02f626f30b519d511","layer":"pei","quote":"寻辟仪为掾，到，与论议，嘉其才朗，曰：‘丁掾，好士也！即使其两目盲，尚当与女，何况但眇？是吾儿误我。’","attribution":"裴注引《魏略》","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":77,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-970c26b9a52ff7495abf","start":204,"end":255,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-d03686e2606537d5155a","section":"chapter-019","block":"b-164b5c3133348c981cf3","layer":"original","quote":"植既以才见异，而丁仪、丁廙、杨修等为之羽翼。太祖狐疑，几为太子者，数矣〖6〗。而植任性而行，不自雕励〖7〗，饮酒不节；文帝御之以术，矫情自饰，宫人左右，并为之说：故遂定为嗣。","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":43,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":56,"end":143,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-e7d757239e9bee096300","section":"chapter-021","block":"b-a558b1b96b787b665e02","layer":"original","quote":"及与丁仪共论刑礼，皆传于世","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":285,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":7,"end":20,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
