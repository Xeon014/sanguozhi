{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[],"persons":[{"id":"dengzhang-p2-lixiang","name":"李骧（李福子）","evidence":["dengzhang-q2-f46c6578f33e567665bf"],"facts":[{"id":"dengzhang-f2-7a74ce6540e163ccdb77","text":"李骧为李福子，字叔龙，官至尚书郎、广汉太守。","evidence":["dengzhang-q2-f46c6578f33e567665bf"]}],"aliases":[],"mentions":[]}],"evidence":[{"id":"dengzhang-q2-f46c6578f33e567665bf","section":"chapter-045","block":"b-d6e88dadedcbc541c974","layer":"pei","quote":"﹝二﹞《益部耆旧杂记》曰：“诸葛亮于武功病笃。后主遣福省侍，遂因咨以国家大计。福往具宣圣旨，听亮所言；至别去数日，忽驰思未尽其意，遂却骑驰还见亮。亮语福曰：‘孤知君还意。近日言语，虽弥日，有所不尽，更来（一）〔求〕决耳。君所问者，公琰其宜也。’福谢：‘前实失不咨请公：如公百年后，谁可任大事者；故辄还耳。乞复请，蒋琬之后，谁可任者？’亮曰：‘文伟可以继之。’又复问其次，亮不答。福还，奉使称旨。福为人精识果锐，敏于从政。子骧，字叔龙。亦有名，官至尚书郎、广汉太守。”","attribution":"裴注（引书见原文）","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":344,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c6aee412dd18dafa1749","start":0,"end":233,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
