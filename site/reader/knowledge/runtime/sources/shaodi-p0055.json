{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"shaodi-e-p017b","title":"张特乐方守城伤亡过半","accounts":[{"id":"shaodi-e-p017b-account","label":"《魏略》","text":"张特乐方守城伤亡过半","evidence":["shaodi-e-p017b-q"]}],"participants":[{"person":"shaodi-p0054","role":"守城","evidence":["shaodi-e-p017b-q"]},{"person":"shaodi-p0055","role":"守城","evidence":["shaodi-e-p017b-q"]},{"person":"shaodi-p0041","role":"攻城","evidence":["shaodi-e-p017b-q"]}],"place":null,"time":{"year":253,"label":"诸葛恪围新城","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"shaodi-y253","dating_review":{"reviewed":true,"anchor":"shaodi-q-o055","basis":"诸葛恪围新城"},"evidence":["shaodi-e-p017b-q","shaodi-q-o055","shaodi-q-b-aa6ace448e938821edac"]},"ordering_evidence":"shaodi-e-p017b-q","source_order":[4,264,"P017b"],"order":1103}],"persons":[{"id":"shaodi-p0055","name":"乐方","evidence":["shaodi-q-p017"],"facts":[],"aliases":[],"mentions":[{"id":"shaodi-m-p017-shaodi-p0055","kind":"mention","text":"文中提及","evidence":["shaodi-q-p017"]}]}],"evidence":[{"id":"shaodi-e-p017b-q","section":"chapter-004","block":"b-06305742464d5112ec77","layer":"pei","quote":"《魏略》曰：“特字子产。涿郡人。先时领牙门，给事镇东诸葛诞。诞不以为能也，欲遣还护军。会毌丘俭代诞，遂使特屯守合肥新城。及诸葛恪围城，特与将军乐方等三军，众合有三千人，吏兵疾病及战死者过半。而恪起土山急攻，城将陷，不可护。特乃谓吴人曰：‘今我无心复战也！然魏法：被攻过百日而救不至者，虽降，家不坐也。自受敌以来，已九十余日矣。此城中本有四千余人，而战死者已过半；城虽陷，尚有半人不欲降：我当还为相语之，条名别善恶，明日早送名。且持我印绶去，以为信。’乃投其印绶以与之。吴人听其辞而不取印绶，不攻。顷之，特还，乃夜彻诸屋材栅，补其缺为二重。明日，谓吴人曰：‘我但有斗死耳！’吴人大怒，进攻之，不能拔，遂引去。朝廷嘉之，加杂号将军，封列侯，又迁安丰太守。”","attribution":"《魏略》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":263,"anchor":null},"note_id":"n-2eca2c634a1bdb5db974","start":0,"end":326},{"id":"shaodi-q-b-aa6ace448e938821edac","section":"chapter-004","block":"b-aa6ace448e938821edac","layer":"modern","quote":"〖1〗五年：嘉平五年（公元 253）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":244,"anchor":null},"note_id":"n-4e568bedcd1f34c38680","start":0,"end":19},{"id":"shaodi-q-o055","section":"chapter-004","block":"b-2d3651c906b3924f6677","layer":"original","quote":"五年夏四月〖1〗，大赦。五月，吴太傅诸葛恪围合肥新城；诏太尉司马孚拒之。﹝一﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":239,"anchor":null},"note_id":null,"start":0,"end":39},{"id":"shaodi-q-p017","section":"chapter-004","block":"b-06305742464d5112ec77","layer":"pei","quote":"《魏略》曰：“特字子产。涿郡人。先时领牙门，给事镇东诸葛诞。诞不以为能也，欲遣还护军。会毌丘俭代诞，遂使特屯守合肥新城。及诸葛恪围城，特与将军乐方等三军，众合有三千人，吏兵疾病及战死者过半。而恪起土山急攻，城将陷，不可护。特乃谓吴人曰：‘今我无心复战也！然魏法：被攻过百日而救不至者，虽降，家不坐也。自受敌以来，已九十余日矣。此城中本有四千余人，而战死者已过半；城虽陷，尚有半人不欲降：我当还为相语之，条名别善恶，明日早送名。且持我印绶去，以为信。’乃投其印绶以与之。吴人听其辞而不取印绶，不攻。顷之，特还，乃夜彻诸屋材栅，补其缺为二重。明日，谓吴人曰：‘我但有斗死耳！’吴人大怒，进攻之，不能拔，遂引去。朝廷嘉之，加杂号将军，封列侯，又迁安丰太守。”","attribution":"《魏略》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":263,"anchor":null},"note_id":"n-2eca2c634a1bdb5db974","start":0,"end":326}],"profiles":{},"directory_counts":{}}
