ea7471a824564e27","source_order":[51,146,20],"order":9188},{"id":"zongshi-e-o082","title":"建安八年，翊以偏将军领丹杨太守，时年二十","accounts":[{"id":"zongshi-a-46a702e7c4a9048681dd","label":"正文","text":"建安八年，翊以偏将军领丹杨太守，时年二十","evidence":["zongshi-q-0a6c8d86ae13e539cd63"]}],"participants":[{"person":"sunshi-p0028","role":"领郡者","evidence":["zongshi-q-0a6c8d86ae13e539cd63"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["zongshi-q-0a6c8d86ae13e539cd63"]},"ordering_evidence":"zongshi-q-0a6c8d86ae13e539cd63","source_order":[51,147,0],"order":9189},{"id":"zongshi-e-o083","title":"翊后卒为左右边鸿所杀，鸿亦即诛","accounts":[{"id":"zongshi-a-84e6d7ec14448efe1fdc","label":"正文","text":"翊后卒为左右边鸿所杀，鸿亦即诛","evidence":["zongshi-q-c9387adcb31248735ccc"]},{"id":"zongshi-a-b0c1d0c399c963847b2f","label":"裴注·吴历","text":"妫览、戴员亲近边鸿等数为翊所困，常欲叛逆；因吴主出征，遂其奸计","evidence":["zongshi-q-06cb38c40c30257ca0a5"]},{"id":"zongshi-a-98dcb7cdaa423d101862","label":"裴注·吴历","text":"翊以妻徐氏颇晓卜，入语徐：吾明日欲为长吏作主人，卿试卜之；徐言卦不能佳，可须异日；翊以长吏来久宜速遣，乃大请宾客","evidence":["zongshi-q-6c296446abde8dae28e8"]},{"id":"zongshi-a-48cfba6008fdeee9d984","label":"裴注·吴历","text":"翊出入常持刀，尔时有酒色，空手送客；鸿从后斫翊，郡中扰乱，无救翊者，遂为鸿所杀，迸走入山","evidence":["zongshi-q-feb340e6a390f4c8beb6"]}],"participants":[{"person":"sunshi-p0028","role":"被杀者；所困之主（背景）；问卜设宴者","evidence":["zongshi-q-c9387adcb31248735ccc","zongshi-q-06cb38c40c30257ca0a5","zongshi-q-6c296446abde8dae28e8","zongshi-q-feb340e6a390f4c8beb6"]},{"person":"zongshi-p0048","role":"杀翊而被诛者；欲叛者；斫翊者","evidence":["zongshi-q-c9387adcb31248735ccc","zongshi-q-06cb38c40c30257ca0a5","zongshi-q-feb340e6a390f4c8beb6"]},{"person":"zongshi-p0005","role":"欲叛者","evidence":["zongshi-q-06cb38c40c30257ca0a5"]},{"person":"zongshi-p0042","role":"欲叛者","evidence":["zongshi-q-06cb38c40c30257ca0a5"]},{"person":"sun-quan","role":"出征（背景）","evidence":["zongshi-q-06cb38c40c30257ca0a5"]},{"person":"zongshi-p0041","role":"试卜者","evidence":["zongshi-q-6c296446abde8dae28e8"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["zongshi-q-c9387adcb31248735ccc","zongshi-q-06cb38c40c30257ca0a5","zongshi-q-6c296446abde8dae28e8","zongshi-q-feb340e6a390f4c8beb6"]},"ordering_evidence":"zongshi-q-c9387adcb31248735ccc","source_order":[51,147,20],"order":9190},{"id":"zongshi-e-o091","title":"孙翊为丹杨太守，皆礼致妫览、戴员；览为丹杨都尉督兵，员为郡丞","accounts":[{"id":"zongshi-a-08bee46e278115c58efe","label":"正文","text":"孙翊为丹杨太守，皆礼致妫览、戴员；览为丹杨都尉督兵，员为郡丞","evidence":["zongshi-q-02273604f428006e07b4"]}],"participants":[{"person":"sunshi-p0028","role":"礼致者","evidence":["zongshi-q-02273604f428006e07b4"]},{"person":"zongshi-p0005","role":"受礼任都尉督兵者","evidence":["zongshi-q-02273604f428006e07b4"]},{"person":"zongshi-p0042","role":"受礼任郡丞者","evidence":["zongshi-q-02273604f428006e07b4"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["zongshi-q-02273604f428006e07b4"]},"ordering_evidence":"zongshi-q-02273604f428006e07b4","source_order":[51,174,44],"order":9205},{"id":"zongshi-e-o092","title":"及翊遇害，河驰赴宛陵，责怒览、员以不能全（权）〔翊〕，令使奸变得施","accounts":[{"id":"zongshi-a-0668b7b0a3cba1156a6a","label":"正文","text":"及翊遇害，河驰赴宛陵，责怒览、员以不能全（权）〔翊〕，令使奸变得施","evidence":["zongshi-q-123a16ed7398c9e69dac"]}],"participants":[{"person":"sunshi-p0040","role":"驰赴责怒者","evidence":["zongshi-q-123a16ed7398c9e69dac"]},{"person":"zongshi-p0005","role":"被责者","evidence":["zongshi-q-123a16ed7398c9e69dac"]},{"person":"zongshi-p0042","role":"被责者","evidence":["zongshi-q-123a16ed7398c9e69dac"]},{"person":"sunshi-p0028","role":"遇害者（背景）","evidence":["zongshi-q-123a16ed7398c9e69dac"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["zongshi-q-123a16ed7398c9e69dac"]},"ordering_evidence":"zongshi-q-123a16ed7398c9e69dac","source_order":[51,174,78],"order":9206},{"id":"zongshi-e-o094","title":"会翊帐下徐元、孙高、傅婴等杀览、员","accounts":[{"id":"zongshi-a-fe8845b35557640ae2f2","label":"正文","text":"会翊帐下徐元、孙高、傅婴等杀览、员","evidence":["zongshi-q-38e3831bb79e583e86b5"]},{"id":"zongshi-a-8ddceacfedcf8ec3dc24","label":"裴注·吴历","text":"徐氏购募追捕，中宿乃得；览、员归罪杀鸿","evidence":["zongshi-q-b7c66ed0bd6d185d3ce7"]},{"id":"zongshi-a-b1bbf396e5634191fff8","label":"裴注·吴历","text":"诸将皆知览、员所为而力不能讨；览入居军府中，悉取翊嫔妾及左右侍御，欲复取徐；徐绐之曰乞须晦日设祭除服","evidence":["zongshi-q-023f5437b202ea0123d7"]},{"id":"zongshi-a-2faf0bb633cec23050b6","label":"裴注·吴历","text":"时月垂竟，览听须祭毕；徐潜使所亲信语翊旧将孙高、傅婴等：览已虏略婢妾今又欲见逼，欲立微计，愿二君哀救；高、婴涕泣答言受府君恩遇，今日之事实夙夜所怀","evidence":["zongshi-q-f322729b1771bdb3ae8a"]},{"id":"zongshi-a-4b2afda87c3034d97d5f","label":"裴注·吴历","text":"乃密呼翊时侍养者二十余人，以徐意语之，共盟誓合谋","evidence":["zongshi-q-d6ff96725d7ebcf306dd"]},{"id":"zongshi-a-97b5a304b6b1fa889833","label":"裴注·吴历","text":"到晦日设祭；徐氏哭泣尽哀毕，乃徐服、熏香沐浴，更于他室安施帏帐，言笑欢悦示无戚容；览密觇视，无复疑意","evidence":["zongshi-q-5cae10fb73526a68fd7f"]},{"id":"zongshi-a-ff459a75a2dca80b6ca2","label":"裴注·吴历","text":"徐呼高、婴与诸婢罗住户内，使人报览说已除凶即吉；览盛意入，徐出户拜；览适得一拜，徐便大呼二君可起；高、婴俱出共得杀览；余人即就外杀员","evidence":["zongshi-q-d1a125929176ccc56336"]},{"id":"zongshi-a-68877fcb44eb9847b8c8","label":"裴注·吴历","text":"夫人乃还缞绖，奉览、员首以祭翊墓；举军震骇，以为神异","evidence":["zongshi-q-e0f7b97e0f4b4257d2b7"]},{"id":"zongshi-a-c382b2d2a67403796451","label":"裴注·吴历","text":"吴主续至，悉族诛览、员余党；擢高、婴为牙门；其余皆加赐金帛，殊其门户","evidence":["zongshi-q-b5917c4ae17a2c4d11ea"]}],"participants":[{"person":"zongshi-p0040","role":"杀览员者","evidence":["zongshi-q-38e3831bb79e583e86b5"]},{"person":"zongshi-p0038","role":"杀览员者；泣答共谋者；盟誓者；出而杀览者；受擢牙门者","evidence":["zongshi-q-38e3831bb79e583e86b5","zongshi-q-f322729b1771bdb3ae8a","zongshi-q-d6ff96725d7ebcf306dd","zongshi-q-d1a125929176ccc56336","zongshi-q-b5917c4ae17a2c4d11ea"]},{"person":"zongshi-p0001","role":"杀览员者；泣答共谋者；盟誓者；出而杀览者；受擢牙门者","evidence":["zongshi-q-38e3831bb79e583e86b5","zongshi-q-f322729b1771bdb3ae8a","zongshi-q-d6ff96725d7ebcf306dd","zongshi-q-d1a125929176ccc56336","zongshi-q-b5917c4ae17a2c4d11ea"]},{"person":"zongshi-p0005","role":"被杀者；归罪杀鸿者；居府取妾而欲取徐者；觇视而中计者（背景）","evidence":["zongshi-q-38e3831bb79e583e86b5","zongshi-q-b7c66ed0bd6d185d3ce7","zongshi-q-023f5437b202ea0123d7","zongshi-q-5cae10fb73526a68fd7f","zongshi-q-d1a125929176ccc56336"]},{"person":"zongshi-p0042","role":"被杀者；归罪杀鸿者","evidence":["zongshi-q-38e3831bb79e583e86b5","zongshi-q-b7c66ed0bd6d185d3ce7","zongshi-q-d1a125929176ccc56336"]},{"person":"zongshi-p0041","role":"购募者；绐之者；密遣信者；谋主；设祭诱敌者；设计主杀者；祭夫者","evidence":["zongshi-q-b7c66ed0bd6d185d3ce7","zongshi-q-023f5437b202ea0123d7","zongshi-q-f322729b1771bdb3ae8a","zongshi-q-d6ff96725d7ebcf306dd","zongshi-q-5cae10fb73526a68fd7f","zongshi-q-d1a125929176ccc56336","zongshi-q-e0f7b97e0f4b4257d2b7"]},{"person":"zongshi-p0048","role":"被捕杀者","evidence":["zongshi-q-b7c66ed0bd6d185d3ce7"]},{"person":"sunshi-p0028","role":"墓被祭者（背景）","evidence":["zongshi-q-e0f7b97e0f4b4257d2b7"]},{"person":"sun-quan","role":"族诛擢赏者","evidence":["zongshi-q-b5917c4ae17a2c4d11ea"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["zongshi-q-38e3831bb79e583e86b5","zongshi-q-b7c66ed0bd6d185d3ce7","zongshi-q-023f5437b202ea0123d7","zongshi-q-f322729b1771bdb3ae8a","zongshi-q-d6ff96725d7ebcf306dd","zongshi-q-5cae10fb73526a68fd7f","zongshi-q-d1a125929176ccc56336","zongshi-q-e0f7b97e0f4b4257d2b7","zongshi-q-b5917c4ae17a2c4d11ea"]},"ordering_evidence":"zongshi-q-38e3831bb79e583e86b5","source_order":[51,174,200],"order":9208},{"id":"zhulv-e-o023","title":"初，权弟翊性峭急，喜怒快意，治数责数，喻以道义","accounts":[{"id":"zhulv-a-6d954547459f29cbae25","label":"正文","text":"初，权弟翊性峭急，喜怒快意，治数责数，喻以道义","evidence":["zhulv-q-7772c2905aa6b5842382"]}],"participants":[{"person":"sunshi-p0052","role":"责教者","evidence":["zhulv-q-7772c2905aa6b5842382"]},{"person":"sunshi-p0028","role":"被责教者","evidence":["zhulv-q-7772c2905aa6b5842382"]},{"person":"sun-quan","role":"翊之兄（背景）","evidence":["zhulv-q-7772c2905aa6b5842382"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["zhulv-q-7772c2905aa6b5842382"]},"ordering_evidence":"zhulv-q-7772c2905aa6b5842382","source_order":[56,23,0],"order":9963}],"perso