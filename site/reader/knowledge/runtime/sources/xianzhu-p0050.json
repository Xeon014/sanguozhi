{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-o041a","title":"刘备斩杨怀并进据涪城","accounts":[{"id":"xianzhu-e-o041a-account","label":"《先主传》正文","text":"刘备斩白水军督杨怀，遣黄忠、卓膺进兵，至关中质诸将士卒妻子，再进据涪城。","evidence":["xianzhu-e-o041a-q"]},{"id":"liuermu-a-9950c1dbb06fd3732ca1","label":"正文","text":"刘备还兵南向所在皆克","evidence":["liuermu-q-4d23bb4578b63b8f2031"]},{"id":"huangli-a-e1faa2d45e906e4b5d80","label":"正文","text":"刘备袭取益州下郡县","evidence":["huangli-q-bd474f24d9b352df893a"]},{"id":"huowang-a-b6195a3f3729c872c239","label":"正文","text":"刘备留霍峻守葭萌","evidence":["huowang-q-a085f159439635932339"]}],"participants":[{"person":"liu-bei","role":"斩将进军","evidence":["xianzhu-e-o041a-q"]},{"person":"xianzhu-p0050","role":"被斩","evidence":["xianzhu-e-o041a-q"]},{"person":"xianzhu-p0051","role":"进兵","evidence":["xianzhu-e-o041a-q"]},{"person":"xianzhu-p0052","role":"进兵","evidence":["xianzhu-e-o041a-q"]},{"person":"wudi-p0253","role":"刘备南向所攻者","evidence":["liuermu-q-4d23bb4578b63b8f2031"]},{"person":"huowang-p0032","role":"受留镇守葭萌城","evidence":["huowang-q-a085f159439635932339"]}],"place":{"text":"白水、涪","evidence":["xianzhu-e-o041a-q"]},"time":{"year":212,"label":"张松被杀后","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xianzhu-y212","dating_review":{"reviewed":true,"anchor":"xianzhu-q-o039","basis":"张松被杀后"},"evidence":["xianzhu-e-o041a-q","xianzhu-q-o039","xianzhu-q-o034","xianzhu-q-b-09400c250015597cdc75"]},"source_order":[32,167,"O041a"],"order":6475},{"id":"pangfa-e-o007a","title":"刘备从庞统中计斩杨怀高沛","accounts":[{"id":"pangfa-e-o007a-account","label":"《庞统法正传第七》正文","text":"刘备采用中计，斩杨怀、高沛，回军向成都，所过攻克。","evidence":["pangfa-e-o007a-q"]}],"participants":[{"person":"liu-bei","role":"采策进军","evidence":["pangfa-e-o007a-q"]},{"person":"xianzhu-p0050","role":"被斩","evidence":["pangfa-e-o007a-q"]},{"person":"pangfa-p0007","role":"被斩","evidence":["pangfa-e-o007a-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["pangfa-e-o007a-q"]},"ordering_evidence":"pangfa-e-o007a-q","source_order":[37,38,"O007a"],"order":6970}],"persons":[{"id":"xianzhu-p0050","name":"杨怀","evidence":["xianzhu-q-o041","pangfa-q-o006"],"facts":[],"aliases":[],"mentions":[{"id":"xianzhu-m-o041-xianzhu-p0050","kind":"mention","text":"文中提及","evidence":["xianzhu-q-o041"]},{"id":"pangfa-m-o006-xianzhu-p0050","kind":"mention","text":"文中提及","evidence":["pangfa-q-o006"]},{"id":"pangfa-m-o007-xianzhu-p0050","kind":"mention","text":"文中提及","evidence":["pangfa-q-o007"]}]}],"evidence":[{"id":"huangli-q-bd474f24d9b352df893a","section":"chapter-043","block":"b-f5314af9b98692ce672f","layer":"original","quote":"及先主袭取益州，将帅分下郡县，郡县望风影附","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":2,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"huowang-q-a085f159439635932339","section":"chapter-041","block":"b-05065728d211baad4f67","layer":"original","quote":"先主自葭萌南还袭刘璋，留峻守葭萌城","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":2,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":19,"end":36,"offset_unit":"unicode_code_point"},{"id":"liuermu-q-4d23bb4578b63b8f2031","section":"chapter-031","block":"b-9368771bcb03c6644bf6","layer":"original","quote":"还兵南向〖25〗，所在皆克","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":72,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":13,"end":26,"offset_unit":"unicode_code_point"},{"id":"pangfa-e-o007a-q","section":"chapter-037","block":"b-157f3f9a87f77a559bba","layer":"original","quote":"先主然其中计，即斩怀、沛，还向成都。所过辄克，","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":37,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":23,"offset_unit":"unicode_code_point"},{"id":"pangfa-q-o006","section":"chapter-037","block":"b-41f6bd9703fba913edaa","layer":"original","quote":"璋既还成都，先主当为璋北征汉中。统复说曰：“阴选精兵，昼夜兼道，径袭成都；璋既不武〖1〗，又素无预备〖2〗；大军猝至，一举便定。此上计也。杨怀、高沛，璋之名将；各仗强兵，据守关头〖3〗。闻数有笺谏璋，使发遣将军还荆州。将军未至，遣与相闻〖4〗；说荆州有急，欲还救之；并使装束〖5〗，外作归形。此二子既服将军英名，又喜将军之去，计必乘轻骑来见；将军因此执之，进取其兵，乃向成都。此中计也。退还白帝，连引荆州，徐还图之。此下计也。若沉吟不去〖6〗，将致大困，不可久矣！”","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":36,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":233,"offset_unit":"unicode_code_point"},{"id":"pangfa-q-o007","section":"chapter-037","block":"b-157f3f9a87f77a559bba","layer":"original","quote":"先主然其中计，即斩怀、沛，还向成都。所过辄克，于涪大会，置酒作乐。谓统曰：“今日之会，可谓乐矣！”统曰：“伐人之国而以为欢，非仁者之兵也！”先主醉，怒曰：“武王伐纣，前歌后舞〖7〗，非仁者邪？卿言不当，宜速起出！”于是统逡巡引退〖8〗。先主寻悔，请还。统复故位，初不顾谢〖9〗，饮食自若。先主谓曰：“向者之论，阿谁为失〖10〗？”统对曰：“君臣俱失。”先主大笑，宴乐如初。﹝一﹞","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":37,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":189,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o041a-q","section":"chapter-032","block":"b-c205af65c5b891e6a027","layer":"original","quote":"先主大怒，召璋白水军督杨怀，责以无礼，斩之。乃使黄忠、卓膺勒兵向璋〖9〗。先主径至关中〖10〗，质诸将并士卒妻子〖11〗；引兵与忠、膺等进到涪，据其城。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":166,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":76,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-b-09400c250015597cdc75","section":"chapter-032","block":"b-09400c250015597cdc75","layer":"modern","quote":"〖10〗十六年：建安十六年（公元 211 ）。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":152,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8471d798647e2ff3307a","start":0,"end":23,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o034","section":"chapter-032","block":"b-464a6d3ab5db13314b70","layer":"original","quote":"十六年〖10〗，益州牧刘璋，遥闻曹公将遣钟繇等向汉中讨张鲁，内怀恐惧。别驾从事蜀郡张松说璋曰：“曹公兵强，无敌于天下；若因张鲁之资以取蜀土〖11〗，谁能御之者乎？”璋曰：“吾固忧之而未有计。”松曰：“刘豫州，使君之宗室，而曹公之深仇也，善用兵；若使之讨鲁，鲁必破；鲁破，则益州强；曹公虽来，无能为也。”","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":140,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":151,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o039","section":"chapter-032","block":"b-3fc74e22c633afc483a4","layer":"original","quote":"明年，曹公征孙权，权呼先主自救〖4〗。先主遣使告璋曰：“曹公征吴，吴忧危急；孙氏与孤，本为唇齿。又乐进在青泥与关羽相拒〖5〗；今不往救羽，进必大克；转侵州界〖6〗，其忧有甚于鲁。鲁，自守之贼，不足虑也。”乃从璋求万兵及资（宝）〔实〕〖7〗，欲以东行。璋但许兵四千，其余皆给半。﹝一﹞","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":164,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":141,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o041","section":"chapter-032","block":"b-c205af65c5b891e6a027","layer":"original","quote":"先主大怒，召璋白水军督杨怀，责以无礼，斩之。乃使黄忠、卓膺勒兵向璋〖9〗。先主径至关中〖10〗，质诸将并士卒妻子〖11〗；引兵与忠、膺等进到涪，据其城。璋遣刘z 、冷苞、张任、邓贤〔、吴懿〕等拒先主于涪；﹝三﹞皆破败，退保绵竹。璋复遣李严督绵竹诸军〖12〗，严率众降先主。先主军益强，分遣诸将平下属县。诸葛亮、张飞、赵云等将兵溯流定白帝、江州、江阳〖13〗，唯关羽留镇荆州。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":166,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":187,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
