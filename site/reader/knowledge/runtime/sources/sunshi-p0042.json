{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dongyuan-e-o071c","title":"袁术以张勋桥蕤为大将","accounts":[{"id":"dongyuan-e-o071c-account","label":"《董二袁刘传第六》正文","text":"袁术任张勋、桥蕤等为大将。","evidence":["dongyuan-e-o071c-q"]}],"participants":[{"person":"wudi-p0057","role":"授官","evidence":["dongyuan-e-o071c-q"]},{"person":"sunshi-p0042","role":"受任","evidence":["dongyuan-e-o071c-q"]},{"person":"wudi-p0134","role":"受任","evidence":["dongyuan-e-o071c-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-o071c-q"]},"ordering_evidence":"dongyuan-e-o071c-q","source_order":[6,391,"O071c"],"order":1720},{"id":"lvzang-e-o038","title":"术与韩暹杨奉连势遣张勋攻布","accounts":[{"id":"lvzang-a-1cf15498d58810873f7b","label":"正文","text":"术与韩暹杨奉连势遣张勋攻布","evidence":["lvzang-q-23a27027d215e0a24739"]}],"participants":[{"person":"wudi-p0057","role":"怒、与韩暹杨奉等连势遣大将张勋攻布","evidence":["lvzang-q-23a27027d215e0a24739"]},{"person":"sunshi-p0042","role":"袁术大将、攻布","evidence":["lvzang-q-23a27027d215e0a24739"]},{"person":"wudi-p0121","role":"与术连势","evidence":["lvzang-q-23a27027d215e0a24739"]},{"person":"wudi-p0120","role":"与术连势","evidence":["lvzang-q-23a27027d215e0a24739"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["lvzang-q-23a27027d215e0a24739"]},"ordering_evidence":"lvzang-q-23a27027d215e0a24739","source_order":[7,96,0],"order":1834},{"id":"lvzang-e-o039","title":"布用珪策离暹奉并力击术勋大破败","accounts":[{"id":"lvzang-a-bb0fa430952b1580f492","label":"正文","text":"布用珪策离暹奉并力击术勋大破败","evidence":["lvzang-q-8c16a5237fcdeea47140"]},{"id":"lvzang-a-3a3ea43c200b6a24fa74","label":"裴注·九州春秋","text":"布与暹奉书劝共击术暹奉回计从布","evidence":["lvzang-q-62f6f06678aca807f40c"]},{"id":"lvzang-a-a3c37ba6537e6e75a991","label":"裴注·九州春秋","text":"布进军暹奉兵并发大破勋军","evidence":["lvzang-q-0ea390afd2c83caa18a9"]}],"participants":[{"person":"wudi-p0088","role":"问珪今致术军卿之由也为之奈何、用珪策遣人说暹奉使与己并力共击术军、军资所有悉许暹奉；与暹奉书曰二将军拔大驾来东有元功于国当书勋竹帛万世不朽今袁术造逆当共诛讨奈何与贼臣还共伐布布有杀董卓之功与二将军俱为功臣可因今共击破术建功于天下此时不可失也；进军去勋等营百步","evidence":["lvzang-q-8c16a5237fcdeea47140","lvzang-q-62f6f06678aca807f40c","lvzang-q-0ea390afd2c83caa18a9"]},{"person":"dongyuan-p0039","role":"答暹奉与术猝合之军耳策谋不素定不能相维持、子登策之比之连鸡势不俱栖可解离也","evidence":["lvzang-q-8c16a5237fcdeea47140"]},{"person":"wudi-p0121","role":"从布并力共击术军；得书即回计从布；兵同时并发","evidence":["lvzang-q-8c16a5237fcdeea47140","lvzang-q-62f6f06678aca807f40c","lvzang-q-0ea390afd2c83caa18a9"]},{"person":"wudi-p0120","role":"从布并力共击术军；得书即回计从布；兵同时并发","evidence":["lvzang-q-8c16a5237fcdeea47140","lvzang-q-62f6f06678aca807f40c","lvzang-q-0ea390afd2c83caa18a9"]},{"person":"sunshi-p0042","role":"大破败；营被攻、将十将被斩、杀伤堕水死者不可胜数","evidence":["lvzang-q-8c16a5237fcdeea47140","lvzang-q-0ea390afd2c83caa18a9"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["lvzang-q-8c16a5237fcdeea47140","lvzang-q-62f6f06678aca807f40c","lvzang-q-0ea390afd2c83caa18a9"]},"ordering_evidence":"lvzang-q-8c16a5237fcdeea47140","source_order":[7,96,22],"order":1835},{"id":"sunshi-e-o025b","title":"马日！礼辟孙策表怀义校尉乔蕤张勋敬重","accounts":[{"id":"sunshi-e-o025b-account","label":"《孙破虏讨逆传第一》正文","text":"马日！礼辟孙策表怀义校尉乔蕤张勋敬重","evidence":["sunshi-e-o025b-q"]}],"participants":[{"person":"sunshi-p0041","role":"礼辟表官","evidence":["sunshi-e-o025b-q"]},{"person":"wudi-p0099","role":"受辟受官","evidence":["sunshi-e-o025b-q"]},{"person":"wudi-p0134","role":"敬重","evidence":["sunshi-e-o025b-q"]},{"person":"sunshi-p0042","role":"敬重","evidence":["sunshi-e-o025b-q"]}],"place":null,"time":{"year":194,"label":"兴平元年","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"sunshi-y194","dating_review":{"reviewed":true,"anchor":"sunshi-q-o025","basis":"兴平元年"},"evidence":["sunshi-e-o025b-q","sunshi-q-o025","xunyu-q-o007","xianzhu-q-o009","wudi-q-o028","wudi-q-b-927979d68d5dacfd36fe"]},"ordering_evidence":"sunshi-e-o025b-q","source_order":[46,178,"O025b"],"order":8070},{"id":"sunshi-e-o032c","title":"杨弘张勋率袁术余众欲就孙策被刘勋要击","accounts":[{"id":"sunshi-e-o032c-account","label":"《孙破虏讨逆传第一》正文","text":"杨弘张勋率袁术余众欲就孙策被刘勋要击","evidence":["sunshi-e-o032c-q"]}],"participants":[{"person":"sunshi-p0054","role":"率众","evidence":["sunshi-e-o032c-q"]},{"person":"sunshi-p0042","role":"率众","evidence":["sunshi-e-o032c-q"]},{"person":"wudi-p0168","role":"截获","evidence":["sunshi-e-o032c-q"]}],"place":null,"time":{"label":"袁术僭号至死后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["sunshi-e-o032c-q"]},"ordering_evidence":"sunshi-e-o032c-q","source_order":[46,217,"O032c"],"order":8091}],"persons":[{"id":"sunshi-p0042","name":"张勋","evidence":["sunshi-q-o025","dongyuan-q-o071","lvzang-q-23a27027d215e0a24739","lvzang-q-8c16a5237fcdeea47140","lvzang-q-0ea390afd2c83caa18a9"],"facts":[],"aliases":[],"mentions":[{"id":"sunshi-m-o025-sunshi-p0042","kind":"mention","text":"文中提及","evidence":["sunshi-q-o025"]},{"id":"sunshi-m-o032-sunshi-p0042","kind":"mention","text":"文中提及","evidence":["sunshi-q-o032"]},{"id":"dongyuan-m-o071-sunshi-p0042","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o071"]}]}],"evidence":[{"id":"dongyuan-e-o071c-q","section":"chapter-006","block":"b-e7fa65d5e1ea25c916b0","layer":"original","quote":"以张勋、桥蕤等为大将（军）。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":390,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":41,"end":55,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o071","section":"chapter-006","block":"b-e7fa65d5e1ea25c916b0","layer":"original","quote":"引军入陈留，太祖与绍合击，大破术军；术以余众奔九江，杀扬州刺史陈温，领其州，﹝二﹞以张勋、桥蕤等为大将（军）。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":390,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":55,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-0ea390afd2c83caa18a9","section":"chapter-007","block":"b-fe60abe324d40d59e61e","layer":"pei","quote":"布进军，去勋等营百步，暹、奉兵同时并发。斩十将首，杀伤堕水死者不可胜数","attribution":"裴注·九州春秋","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":117,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a7ab9de04a39324dfeda","start":119,"end":154,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-23a27027d215e0a24739","section":"chapter-007","block":"b-0c7981b3fdfd16298529","layer":"original","quote":"术怒，与韩暹、杨奉等连势，遣大将张勋，攻布","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":95,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-62f6f06678aca807f40c","section":"chapter-007","block":"b-fe60abe324d40d59e61e","layer":"pei","quote":"布与暹、奉书曰：‘二将军拔大驾来东，有元功于国；当书勋竹帛，万世不朽。今袁术造逆，当共诛讨，奈何与贼臣还共伐布？布有杀董卓之功，与二将军俱为功臣；可因今共击破术，建功于天下，此时不可失也！’暹、奉得书，即回计从布","attribution":"裴注·九州春秋","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":117,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a7ab9de04a39324dfeda","start":12,"end":118,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-8c16a5237fcdeea47140","section":"chapter-007","block":"b-0c7981b3fdfd16298529","layer":"original","quote":"布谓珪曰：“今致术军，卿之由也。为之奈何？”珪曰：“暹、奉与术，猝合之军耳！策谋不素定，不能相维持。子登策之，比之连鸡〖1〗：势不俱栖，可解离也。”布用珪策，遣人说暹、奉，使与己并力共击术军；军资所有，悉许暹、奉。于是暹、奉从之，勋大破败","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":95,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":22,"end":141,"offset_unit":"unicode_code_point"},{"id":"sunshi-e-o025b-q","section":"chapter-046","block":"b-0ad407171fe244241c8d","layer":"original","quote":"太傅马日！仗节安集关东〖10〗；在寿春以礼辟策〖11〗，表拜怀义校尉〖12〗。术大将乔蕤、张勋，皆倾心敬焉。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":177,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":24,"end":78,"offset_unit":"unicode_code_point"},{"id":"sunshi-e-o032c-q","section":"chapter-046","block":"b-5201386903331e2f3688","layer":"original","quote":"后术死，长史杨弘、大将张勋等，将其众欲就策；庐江太守刘勋要击〖21〗，悉虏之，收其珍宝以归。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":216,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":43,"end":89,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-o025","section":"chapter-046","block":"b-0ad407171fe244241c8d","layer":"original","quote":"兴平元年，从袁术。术甚奇之，以坚部曲还策。﹝三﹞太傅马日！仗节安集关东〖10〗；在寿春以礼辟策〖11〗，表拜怀义校尉〖12〗。术大将乔蕤、张勋，皆倾心敬焉。术常叹曰：“使术有子如孙郎，死复何恨！”策骑士有罪，逃入术营，隐于内厩；策指使人就斩之〖13〗，讫，诣术谢〖14〗。术曰：“兵人好叛，当共疾之！何为谢也？”由是军中益畏惮之。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":177,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":165,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-o032","section":"chapter-046","block":"b-5201386903331e2f3688","layer":"original","quote":"时袁术僭号〖19〗，策以书责而绝之。﹝六﹞曹公表策为讨逆将军〖20〗，封为吴侯。﹝七﹞后术死，长史杨弘、大将张勋等，将其众欲就策；庐江太守刘勋要击〖21〗，悉虏之，收其珍宝以归。策闻之，伪与勋好盟〖22〗。勋新得术众，时豫章上缭宗民万余家在江东〖23〗，策劝勋攻取之。勋既行，策轻军晨夜袭拔庐江〖24〗，勋众尽降；勋独与麾下数百人，自归曹公。﹝八﹞","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":216,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":174,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-927979d68d5dacfd36fe","section":"chapter-001","block":"b-927979d68d5dacfd36fe","layer":"modern","quote":"〖1〗二年：兴平二年（公元 195）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":246,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8c38464987eb86819ded","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o028","section":"chapter-001","block":"b-fefe0240b8480efce927","layer":"original","quote":"兴平元年春，太祖自徐州还〖1〗。初，太祖父嵩，去官后还谯。董卓之乱，避难琅邪〖2〗。为陶谦所害，故太祖志在复仇东伐。﹝一﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":204,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":61,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o009","section":"chapter-032","block":"b-939a0c2b5149377c476b","layer":"original","quote":"谦表先主为豫州刺史，屯小沛〖2〗。谦病笃，谓别驾麋竺曰〖3〗：“非刘备，不能安此州也！”谦死，竺率州人迎先主。先主未敢当，下邳陈登谓先主曰：“今汉室陵迟，海内倾覆；立功立事，在于今日！（彼）〔鄙〕州殷富〖4〗，户口百万；欲屈使君，抚临州事。”先主曰：“袁公路近在寿春〖5〗；此君四世五公〖6〗，海内所归；君可以州与之。”登曰：“公路骄豪，非治乱之主！今欲为使君合步骑十万：上可以匡主济民，成五霸之业〖7〗；下可以割地守境，书功于竹帛。若使君不见听许，登亦未敢听使君也！”北海相孔融谓先主曰：“袁公路岂忧国忘家者邪？冢中枯骨〖8〗，何足介意！今日之事，百姓与能〖9〗；天与不取，悔不可追！”先主遂领徐州。﹝一﹞","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":39,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":304,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-o007","section":"chapter-010","block":"b-0a1838dcb6c559056287","layer":"original","quote":"兴平元年，太祖征陶谦，任彧留事〖4〗。会张邈、陈宫以兖州反，潜迎吕布。布既至，邈乃使刘翊告彧曰：“吕将军来助曹使君击陶谦〖5〗。宜亟供其军食！”众疑惑。彧知邈为乱，即勒兵设备〖6〗；驰召东郡太守夏侯惇。而兖州诸城皆应布矣。时太祖悉军攻谦，留守兵少；而督将、大吏多与邈、宫通谋〖7〗。惇至，其夜诛谋叛者数十人，众乃定。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":24,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":158,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
