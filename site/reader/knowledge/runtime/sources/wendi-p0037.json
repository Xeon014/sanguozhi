set_unit":"unicode_code_point"},{"id":"wendi-q-b-e28c5cd47fe98ad60171","section":"chapter-002","block":"b-e28c5cd47fe98ad60171","layer":"modern","quote":"〖1〗六年：黄初六年（公元 225）。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":467,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-61512c4ade75d71d6a76","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wendi-q-o049","section":"chapter-002","block":"b-d5847039c2d504d36e8e","layer":"original","quote":"六年春二月〖1〗，遣使者循行许昌以东，尽沛郡〖2〗。问民所疾苦，贫者赈贷之。﹝一﹞三月，行幸召陵〖3〗，通讨虏渠〖4〗。乙巳〖5〗，还许昌宫。并州刺史梁习讨鲜卑轲比能〖6〗，大破之。辛未〖7〗，帝为舟师，东征。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":461,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":105,"offset_unit":"unicode_code_point"},{"id":"wendi-q-o052","section":"chapter-002","block":"b-75c79d53e5050da7e17d","layer":"original","quote":"秋七月，立皇子鉴为东武阳王〖13〗。八月，帝遂以舟师自谯循涡入淮。从陆道幸徐〖14〗。九月，筑东巡台。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":464,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":51,"offset_unit":"unicode_code_point"},{"id":"wendi-q-o053","section":"chapter-002","block":"b-1d30ef656dda0ab13df8","layer":"original","quote":"冬十月，行幸广陵故城〖15〗，临江观兵〖16〗。戎卒十余万，旌旗数百里。﹝二﹞是岁，大寒，水道冰，舟不得入江；乃引还。十一月，东武阳王鉴薨。十二月，行自谯过梁〖17〗，遣使以太牢祀故汉太尉桥玄。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":465,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":97,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-05b940771cd81e1f6a77","section":"chapter-020","block":"b-9bb740b44dae212613c8","layer":"original","quote":"东武阳怀王鉴，黄初六年，立。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":231,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":14,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-7a3bfc423abc8f9951ee","section":"chapter-020","block":"b-9bb740b44dae212613c8","layer":"original","quote":"青龙三年，赐谥。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":231,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":18,"end":26,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-7ce1991c2b52380d3b11","section":"chapter-020","block":"b-08bc87032dff67a1e7b2","layer":"original","quote":"文皇帝九男：甄氏皇后生明帝；李贵人生赞哀王协；潘淑媛生北海悼王蕤；朱淑媛生东武阳怀王鉴；仇昭仪生东海定王霖；徐姬生元城哀王礼；苏姬生邯郸怀王邕；张姬生清河悼王贡；宋姬生广平哀王俨。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":228,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":90,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-cdbf930e218aca317d5a","section":"chapter-020","block":"b-9bb740b44dae212613c8","layer":"original","quote":"其年薨。青龙三年，赐谥。无子，国除。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":231,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":14,"end":32,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
