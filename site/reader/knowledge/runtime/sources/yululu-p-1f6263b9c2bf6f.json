/Text/titlepage_0121.xhtml","index":192,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":188,"offset_unit":"unicode_code_point"},{"id":"yululu-q-ef69b86456094b34cf65","section":"chapter-057","block":"b-dbd9eec59a2f34faeadf","layer":"original","quote":"而怨愤之声积，浸润之谮行矣〖8〗。竞言艳及选曹郎徐彪，﹝一﹞专用私情，爱憎不由公理。艳、彪皆坐自杀","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":192,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":135,"end":184,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
