100ccc747284"]},"ordering_evidence":"santizhu059-q-4d108a85100ccc747284","source_order":[59,224,0],"related_events":[{"event":"santizhu-e-o079e","type":"related","evidence":["santizhu059-q-4d108a85100ccc747284","santizhu-q-40a51f0cdaaaeb785aa1"]}],"order":10477},{"id":"santizhu059-e-p017a","title":"丁固不杀孙谦并将情况报告孙皓","accounts":[{"id":"santizhu059-a-9763da54d0c406de45f3","label":"裴注·吴历","text":"丁固不杀孙谦并将情况报告孙皓","evidence":["santizhu059-q-a3ff231915c24af0a1d2"]}],"participants":[{"person":"santizhu-p0067","role":"不敢杀孙谦并将情况告孙皓","evidence":["santizhu059-q-a3ff231915c24af0a1d2"]},{"person":"santizhu-p0037","role":"被生擒后未被丁固杀","evidence":["santizhu059-q-a3ff231915c24af0a1d2"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"未由相邻段落推算纪年；原文时间表达保留在来源引句中。","evidence":["santizhu059-q-a3ff231915c24af0a1d2"]},"ordering_evidence":"santizhu059-q-a3ff231915c24af0a1d2","source_order":[59,17,152],"order":10478},{"id":"panlu-e-o088","title":"或曰凯与丁奉丁固谋废皓立孙休子","accounts":[{"id":"panlu-a-5b4a416c9d2764ea384b","label":"正文","text":"或曰凯与丁奉丁固谋废皓立孙休子","evidence":["panlu-q-94d4208c50105d566366"]}],"participants":[{"person":"wuzhu-p0115","role":"与右大司马丁奉、御史大夫丁固谋、因皓谒庙欲废皓立孙休子、密语留平、所图不果","evidence":["panlu-q-94d4208c50105d566366"]},{"person":"santizhu-p0017","role":"右大司马、同谋","evidence":["panlu-q-94d4208c50105d566366"]},{"person":"santizhu-p0067","role":"御史大夫、同谋","evidence":["panlu-q-94d4208c50105d566366"]},{"person":"santizhu-p0053","role":"左将军领兵先驱、拒而不许誓以不泄","evidence":["panlu-q-94d4208c50105d566366"]},{"person":"shaodi-p0162","role":"被谋废者、闻陈苗奏深警惧","evidence":["panlu-q-94d4208c50105d566366"]},{"person":"panlu-p0029","role":"太史郎、奏皓久阴不雨风气回逆将有阴谋","evidence":["panlu-q-94d4208c50105d566366"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["panlu-q-94d4208c50105d566366"]},"ordering_evidence":"panlu-q-94d4208c50105d566366","source_order":[61,134,0],"related_events":[{"event":"panlu-e-p051","type":"alternative","evidence":["panlu-q-94d4208c50105d566366","panlu-q-9a0172edb3016f9bf296"],"note":"正文“或曰”与《吴录》拜庙谋为废皓密谋两源传闻，互为异说并立。"}],"order":10752}],"persons":[{"id":"santizhu-p0067","name":"丁固","evidence":["santizhu-q-83b0080f1458980b9f24","santizhu-q-5e126f7762744020d84a","santizhu-q-4569120a42261330eb66","santizhu-q-40a51f0cdaaaeb785aa1","santizhu-q-71ccaf0817f445fd2e30","santizhu-q-96302ef9c48d031394fa","santizhu-q-0beeb591109fe7af65ff","santizhu-q-7ff108ffdb77de6bb081","santizhu-q-ebdea4271c65398e37bd","santizhu-q-e0cbdc2b9992edfc62f4","santizhu059-q-a3ff231915c24af0a1d2","santizhu059-q-d2615d1a0ee788fc16c2","panlu-q-94d4208c50105d566366","yululu-q-1cd42ee15a560caa0f85","yululu-q-a2cfae7d54aa2152d90b","yululu-q-561aa3213ff97085ae1d","yululu-q-d1df8def0c26b8b76aa2","yululu-q-a7c835f82230b992cee9"],"facts":[{"id":"yululu-f-8feceb36ae78143e7edb","text":"字子贱，本名密，避滕密改作固；丁览之子","evidence":["yululu-q-a7c835f82230b992cee9"]},{"id":"yululu-f-dd7a91e2728ceb5279f6","text":"少丧父独与母居，家贫守约，色养致敬；族弟孤弱与同寒温","evidence":["yululu-q-a7c835f82230b992cee9"]}],"aliases":[],"mentions":[]}],"evidence":[{"id":"panlu-q-94d4208c50105d566366","section":"chapter-061","block":"b-6eeada7f4655703a7e98","layer":"original","quote":"或曰：“宝鼎元年十二月，凯与右大司马丁奉、御史大夫丁固谋〖19〗：因皓谒庙〖20〗，欲废皓立孙休子。时左将军留平领兵先驱，故密语平。平拒而不许，誓以不泄；是以所图不果。太史郎陈苗奏皓〖21〗，久阴不雨，风气回逆，将有阴谋：皓深警惧云","section_title":"潘濬陆凯传第十六","source":{"file":"OEBPS/Text/titlepage_0129.xhtml","index":133,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":116,"offset_unit":"unicode_code_point"},{"id":"panlu-q-9a0172edb3016f9bf296","section":"chapter-061","block":"b-e2b0533f92b634d91b43","layer":"pei","quote":"旧拜庙，选兼大将军领三千兵为卫；凯欲因此兵以图之，令选曹白用丁奉。皓偶不欲，曰：‘更选。’凯令执据：‘虽暂兼，然宜得其人。’皓曰：‘用留平","attribution":"裴注·《吴录》","section_title":"潘濬陆凯传第十六","source":{"file":"OEBPS/Text/titlepage_0129.xhtml","index":157,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-34c1b7061cd32124db22","start":10,"end":79,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-0beeb591109fe7af65ff","section":"chapter-048","block":"b-98a4a0886ab49c6852d9","layer":"pei","quote":"自表先帝旧人，求还内侍。皓以为楼下都尉，典知酤籴事。专为威福，而皓信任，委以众事","attribution":"裴注·江表传","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":451,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f591d97ba67974d4ecc7","start":35,"end":75,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-40a51f0cdaaaeb785aa1","section":"chapter-048","block":"b-c05881b31e86595c49f9","layer":"original","quote":"丁固、诸葛靓逆之于牛屯〖15〗；大战","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":349,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":66,"end":84,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-4569120a42261330eb66","section":"chapter-048","block":"b-ad64edf1bd4ad11e3e6d","layer":"original","quote":"御史大夫丁固、右将军诸葛靓，镇建业","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":329,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":19,"end":36,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-5e126f7762744020d84a","section":"chapter-048","block":"b-31685d9067fb5e5662da","layer":"original","quote":"冬十月，以卫将军濮阳兴为丞相〖7〗；廷尉丁密、光禄勋孟宗，为左、右御史大夫","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":233,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":37,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-71ccaf0817f445fd2e30","section":"chapter-048","block":"b-bb02ac90d073f111aa7b","layer":"original","quote":"三年春二月〖3〗，以左、右御史大夫丁固、孟仁，为司徒、司空","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":379,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":29,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-7ff108ffdb77de6bb081","section":"chapter-048","block":"b-98a4a0886ab49c6852d9","layer":"pei","quote":"定为子求少府李勖女，不许。定挟忿，谮勖于皓","attribution":"裴注·江表传","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":451,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f591d97ba67974d4ecc7","start":76,"end":97,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-83b0080f1458980b9f24","section":"chapter-048","block":"b-67fc8774ec5679497e72","layer":"original","quote":"廷尉丁密、步兵校尉郑胄、将军钟离牧，率军讨之","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":95,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":77,"end":99,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-96302ef9c48d031394fa","section":"chapter-048","block":"b-9745fcca96e85bab2b79","layer":"original","quote":"司徒丁固卒","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":427,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":17,"end":22,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-e0cbdc2b9992edfc62f4","section":"chapter-048","block":"b-4c77631a05446910df8b","layer":"pei","quote":"《吴历》曰：“牧本名密；避丁密，改名牧。丁密避牧，改名为固。”","attribution":"裴注（引书见引句）","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":324,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ba660c623bc8655fba3c","start":3,"end":34,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-ebdea4271c65398e37bd","section":"chapter-048","block":"b-98a4a0886ab49c6852d9","layer":"pei","quote":"定又使诸将，各上好犬；皆千里远求，一犬至直数千匹。御犬率具缨，直钱一万。一犬一兵，养以捕兔，供厨，所获无几。吴人皆归罪于定，而皓以为忠勤，赐爵列侯","attribution":"裴注·江表传","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":451,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f591d97ba67974d4ecc7","start":108,"end":181,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-4d108a85100ccc747284","section":"chapter-059","block":"b-993d070ed932e05166ec","layer":"pei","quote":"但遂前到九里，固、靓出击，大破之。但兵裸身，无铠甲，临陈皆披散。谦独坐车中，遂生获之。","attribution":"裴注·吴历","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":223,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-77168bfdc9a211c11e33","start":109,"end":152,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-a3ff231915c24af0a1d2","section":"chapter-059","block":"b-993d070ed932e05166ec","layer":"pei","quote":"固不敢杀，以状告皓","attribution":"裴注·吴历","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":223,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-77168bfdc9a211c11e33","start":152,"end":161,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-d2615d1a0ee788fc16c2","section":"chapter-059","block":"b-993d070ed932e05166ec","layer":"pei","quote":"未至三十里，住，择吉日，但遣使以谦命诏丁固、诸葛靓。靓即斩其使","attribution":"裴注·吴历","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":223,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-77168bfdc9a211c11e33","start":77,"end":108,"offset_unit":"unicode_code_point"},{"id":"yululu-q-1cd42ee15a560caa0f85","section":"chapter-057","block":"b-139fef0974ff4bd2c7d6","layer":"pei","quote":"历显位。孙休时固为左御史大夫","attribution":"裴注·《会稽典录》","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":103,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0fc9542c4adb6310827d","start":220,"end":234,"offset_unit":"unicode_code_point"},{"id":"yululu-q-561aa3213ff97085ae1d","section":"chapter-057","block":"b-139fef0974ff4bd2c7d6","layer":"pei","quote":"皓悖虐，固与陆凯、孟宗同心忧国","attribution":"裴注·《会稽典录》","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":103,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0fc9542c4adb6310827d","start":244,"end":259,"offset_unit":"unicode_code_point"},{"id":"yululu-q-a2cfae7d54aa2152d90b","section":"chapter-057","block":"b-139fef0974ff4bd2c7d6","layer":"pei","quote":"孙皓即位，迁司徒","attribution":"裴注·《会稽典录》","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":103,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0fc9542c4adb6310827d","start":235,"end":243,"offset_unit":"unicode_code_point"},{"id":"yululu-q-a7c835f82230b992cee9","section":"chapter-057","block":"b-139fef0974ff4bd2c7d6","layer":"pei","quote":"﹝三﹞《会稽典录》曰：“览字孝连。八岁而孤，家又单微；清身立行，用意不苟。推财从弟，以义让称。仕郡至功曹，守始平长。为人精微洁净，门无杂宾。孙权深贵待之。未及擢用，会病卒；甚见痛惜，殊其门户。览子固，字子贱。本名密，避滕密，改作固。固在襁褓中，阚泽见而异之，曰：‘此儿后必致公辅。’固少丧父，独与母居；家贫守约，色养致敬。族弟孤弱，与同寒温。翻与固同僚书曰：‘丁子贱塞渊好德，堂构克举，野无遗薪。斯之为懿，其美优矣。令德之后，惟此君嘉耳！’历显位。孙休时固为左御史大夫。孙皓即位，迁司徒。皓悖虐，固与陆凯、孟宗同心忧国。年七十六卒。子弥，字钦远。仕晋，至梁州刺史。孙潭，光禄大夫。徐陵字元大。历三县长，所在著称。迁零陵太守。时朝廷俟以列卿之位。故翻书曰：‘元大受上卿之遇；叔向在晋，未若于今。’其见重如此。陵卒，僮客土田或见侵夺；骆统为陵家讼之，求与丁览、卜清等为比：权许焉。陵子平，字伯先。童龀知名，翻甚爱之，屡称叹焉。诸葛恪为丹杨太守，讨山越；以平威重思虑，可与效力，请平为丞。稍迁武昌左部督，倾心接物，士卒皆为尽力。初，平为恪从事，意甚薄；及恪辅政，待平益疏。恪被害，子建亡走，为平部曲所得；平使遣去，别为他军所获。平两妇归宗，敬奉情过乎厚。其行义敦笃，皆此类也。”","attribution":"裴注·会稽典录","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":103,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0fc9542c4adb6310827d","start":0,"end":536,"offset_unit":"unicode_code_point"},{"id":"yululu-q-d1df8def0c26b8b76aa2","section":"chapter-057","block":"b-139fef0974ff4bd2c7d6","layer":"pei","quote":"年七十六卒","attribution":"裴注·《会稽典录》","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":103,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0fc9542c4adb6310827d","start":260,"end":265,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
