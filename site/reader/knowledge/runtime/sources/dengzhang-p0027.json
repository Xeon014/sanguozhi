ence":["dengzhang-q2-5a92d1e334871e2a304d"]},{"id":"dengzhang-f2-6738e18701f53278c0ac","text":"李密去官，为州大中正。","evidence":["dengzhang-q2-0ad4e08c935a462d3e64","dengzhang-q2-e4d6ae6c5bf187f7c9bd"]},{"id":"dengzhang-f2-c18a98004257461302ff","text":"李密著《述理论》十篇，胡（熊）〔罴〕与皇甫士安并善之。","evidence":["dengzhang-q2-5a4e2c662510586e7036"]}],"aliases":[],"mentions":[]}],"evidence":[{"id":"dengzhang-q-20e9cc88655c6e9c97de","section":"chapter-045","block":"b-a18576355756b91a64c7","layer":"pei","quote":"事祖母以孝闻，其侍疾则泣涕侧息，日夜不解带，膳饮汤药，必自口尝","attribution":"裴注·华阳国志","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":129,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-25da51a83de7af60fa07","start":76,"end":107,"offset_unit":"unicode_code_point"},{"id":"dengzhang-q-2f0b95a1e96720d51772","section":"chapter-045","block":"b-a18576355756b91a64c7","layer":"pei","quote":"后失荀勖、张华指，左迁汉中太守。诸王多以为冤","attribution":"裴注·华阳国志","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":129,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-25da51a83de7af60fa07","start":1086,"end":1108,"offset_unit":"unicode_code_point"},{"id":"dengzhang-q-3e47ab01245916cfe0ef","section":"chapter-045","block":"b-a18576355756b91a64c7","layer":"pei","quote":"奉使聘吴，吴主问：‘蜀马多少？’对曰：‘官用有余，人间自足。’吴主与群臣泛论道义，谓宁为人弟。密曰：‘愿为人兄矣。’吴主曰：‘何以为兄？’密曰：‘为兄供养之日长。’吴主及群臣皆称善","attribution":"裴注·华阳国志","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":129,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-25da51a83de7af60fa07","start":136,"end":226,"offset_unit":"unicode_code_point"},{"id":"dengzhang-q-5b389de42d839eb7a2f8","section":"chapter-045","block":"b-a18576355756b91a64c7","layer":"pei","quote":"及祖母卒，服终，（从）〔徙〕尚书郎","attribution":"裴注·华阳国志","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":129,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-25da51a83de7af60fa07","start":904,"end":921,"offset_unit":"unicode_code_point"},{"id":"dengzhang-q-762cfb11080709bca9c4","section":"chapter-045","block":"b-a18576355756b91a64c7","layer":"pei","quote":"蜀平后，征西将军邓艾闻其名，请为主簿；及书招，欲与相见；皆不往。以祖母年老，心在色养","attribution":"裴注·华阳国志","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":129,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-25da51a83de7af60fa07","start":227,"end":269,"offset_unit":"unicode_code_point"},{"id":"dengzhang-q-7ffb329fee6ed2de0bc5","section":"chapter-045","block":"b-a18576355756b91a64c7","layer":"pei","quote":"于是密上书曰：‘臣以险衅，夙遭闵凶；生孩六月，慈父见背；行年四岁，舅夺母志。祖母刘，愍臣孤弱，躬见抚养。臣少多疾病，九岁不行；零丁孤苦，至于成立。既无伯叔，终鲜兄弟；门衰祚薄，晚有儿息。外无期功强近之亲，内无应门五尺之童；茕茕孑立，形影相吊。而刘早婴疾病，常在床蓐；臣侍汤药，未曾废离。逮奉圣朝，沐浴清化。前太守臣逵，察臣孝廉；后刺史臣荣，举臣秀才。臣以供养无主，辞不赴命。诏书特下，拜臣郎中；寻蒙国恩，除臣洗马；猥以微贱，当侍东宫，非臣陨首所能上报。臣具表闻，辞不就职。诏书切峻，责臣逋慢；郡县逼迫，催臣上道；州司临门，急于星火。臣欲奉诏奔驰，则刘病日笃；苟顺私情，则告诉不许：臣之进退，实为狼狈！伏惟圣朝以孝治天下：凡在故老，犹蒙矜愍；况臣孤苦，特为尤甚。且臣少仕伪朝，历职郎署；本图宦达，不矜名节。今臣亡国贱俘，至微至陋；猥蒙拔擢，宠命优渥；岂敢盘桓，有所希冀？但以刘日薄西山，气息奄奄；人命危浅，朝不虑夕。臣无祖母，无以至今日；祖母无臣，亦无以终余年：母孙二人，更相为命，是以区区不敢废远。臣今年四十有四，祖母刘今年九十有六：是臣尽节于陛下之日长，报养刘之日短也！乌鸟私情，愿乞终养。臣之辛苦，非徒蜀之人士及二州牧伯所见明知；皇天后土，实所共鉴。愿陛下矜愍愚诚，听臣微志；庶刘侥幸，保卒余年。臣生当陨首，死当结草。臣不胜犬马怖惧之情！","attribution":"裴注·华阳国志","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":129,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-25da51a83de7af60fa07","start":294,"end":865,"offset_unit":"unicode_code_point"},{"id":"dengzhang-q-ad7e90c53866325cdd61","section":"chapter-045","block":"b-a18576355756b91a64c7","layer":"pei","quote":"本郡礼命，不应","attribution":"裴注·华阳国志","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":129,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-25da51a83de7af60fa07","start":108,"end":115,"offset_unit":"unicode_code_point"},{"id":"dengzhang-q-b87c0a70b68d0b0cf637","section":"chapter-045","block":"b-a18576355756b91a64c7","layer":"pei","quote":"为河内温县令，政化严明。中山诸王每过温县，必责求供给，温吏民患之。及密至，中山王过县，欲求刍茭薪蒸；密笺引高祖过沛，宾礼老幼，桑梓之供，一无烦扰，‘伏惟明王孝思惟则，动识先戒；本国望风，式歌且舞；诛求之碎，所未闻命’。自后诸王过，不敢有烦","attribution":"裴注·华阳国志","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":129,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-25da51a83de7af60fa07","start":922,"end":1041,"offset_unit":"unicode_code_point"},{"id":"dengzhang-q-bbe396e609549a9a37ab","section":"chapter-045","block":"b-a18576355756b91a64c7","layer":"pei","quote":"晋武帝立太子，征为太子洗马。诏书累下，郡县逼遣","attribution":"裴注·华阳国志","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":129,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-25da51a83de7af60fa07","start":270,"end":293,"offset_unit":"unicode_code_point"},{"id":"dengzhang-q-e44de36ebc5bf6d838ca","section":"chapter-045","block":"b-a18576355756b91a64c7","layer":"pei","quote":"一年去官，年六十四卒","attribution":"裴注·华阳国志","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":129,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-25da51a83de7af60fa07","start":1109,"end":1119,"offset_unit":"unicode_code_point"},{"id":"dengzhang-q2-0ad4e08c935a462d3e64","section":"chapter-045","block":"b-a18576355756b91a64c7","layer":"pei","quote":"密去官，为州大中正。","attribution":"裴注（引书见原文）","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":129,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-25da51a83de7af60fa07","start":1066,"end":1076,"offset_unit":"unicode_code_point"},{"id":"dengzhang-q2-5a4e2c662510586e7036","section":"chapter-045","block":"b-a18576355756b91a64c7","layer":"pei","quote":"著《述理论》十篇，安东将军胡（熊）〔罴〕与皇甫士安并善之。","attribution":"裴注（引书见原文）","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":129,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-25da51a83de7af60fa07","start":1120,"end":1149,"offset_unit":"unicode_code_point"},{"id":"dengzhang-q2-5a92d1e334871e2a304d","section":"chapter-045","block":"b-a18576355756b91a64c7","layer":"pei","quote":"州辟从事。尚书郎，大将军主簿，太子洗马。","attribution":"裴注（引书见原文）","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":129,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-25da51a83de7af60fa07","start":116,"end":136,"offset_unit":"unicode_code_point"},{"id":"dengzhang-q2-e4d6ae6c5bf187f7c9bd","section":"chapter-045","block":"b-a18576355756b91a64c7","layer":"pei","quote":"陇西王司马子舒，深敬友密；而贵势之家，惮其公直。","attribution":"裴注（引书见原文）","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":129,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-25da51a83de7af60fa07","start":1042,"end":1066,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
