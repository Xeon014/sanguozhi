{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p016a","title":"襄楷言天象促成王芬密谋","accounts":[{"id":"wudi-e-p016a-account","label":"《九州春秋》","text":"襄楷在王芬座中谈宦官将灭，陈逸、王芬等由此结谋。","evidence":["wudi-e-p016a-q"]}],"participants":[{"person":"wudi-p0043","role":"谈天象","evidence":["wudi-e-p016a-q"]},{"person":"wudi-p0042","role":"参与谋议","evidence":["wudi-e-p016a-q"]},{"person":"wudi-p0037","role":"谋划","evidence":["wudi-e-p016a-q"]},{"person":"wudi-p0038","role":"结谋","evidence":["wudi-e-p016a-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p016a-q"]},"source_order":[1,58,"P016a"],"order":33}],"persons":[{"id":"wudi-p0043","name":"襄楷","evidence":["wudi-q-p016"],"facts":[],"aliases":[],"mentions":[{"id":"wudi-m-p016-wudi-p0043","kind":"mention","text":"文中提及","evidence":["wudi-q-p016"]}]}],"evidence":[{"id":"wudi-e-p016a-q","section":"chapter-001","block":"b-27342ea0cc40a8b4e589","layer":"pei","quote":"于是陈蕃子逸与术士平原襄楷，会于芬坐，楷曰：‘天文不利宦者，黄门、常侍（贵）〔真〕族灭矣。’逸喜。芬曰：‘若然者，芬愿驱除。’于是与攸等结谋。","attribution":"《九州春秋》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":57,"anchor":null},"note_id":"n-4ada009fc136a7fb3275","start":15,"end":86},{"id":"wudi-q-p016","section":"chapter-001","block":"b-27342ea0cc40a8b4e589","layer":"pei","quote":"﹝三﹞司马彪《九州春秋》曰：“于是陈蕃子逸与术士平原襄楷，会于芬坐，楷曰：‘天文不利宦者，黄门、常侍（贵）〔真〕族灭矣。’逸喜。芬曰：‘若然者，芬愿驱除。’于是与攸等结谋。灵帝欲北巡河间旧宅，芬等谋因此作难，上书言黑山贼攻劫郡县，求得起兵。会北方有赤气，东西竟天。太史上言‘当有阴谋，不宜北行’，帝乃止。敕芬罢兵，俄而征之；芬惧，自杀。”","attribution":"《九州春秋》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":57,"anchor":null},"note_id":"n-4ada009fc136a7fb3275","start":0,"end":169}],"profiles":{},"directory_counts":{}}
