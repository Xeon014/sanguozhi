":[26,332,54],"order":5271},{"id":"houzhu-e-o050m0","title":"白虎文、治无戴等降蜀并安置繁县","accounts":[{"id":"houzhu-a-9e40135692ed","label":"《后主传》正文","text":"白虎文、治无戴等降蜀并安置繁县","evidence":["houzhu-q-O050"]},{"id":"jfj-a-o037d","label":"正文 · 延熙十年","text":"治无戴举部落降姜维安置","evidence":["jfj-q0149"]}],"participants":[{"person":"houzhu-p0030","role":"率众降蜀者","evidence":["houzhu-q-O050"]},{"person":"houzhu-p0031","role":"率众降蜀者","evidence":["houzhu-q-O050"]},{"person":"shaodi-p0050","role":"迎逆安抚者","evidence":["houzhu-q-O050"]}],"place":null,"time":{"label":"十年","precision":"undated","basis":"保留本段原始时间表达；没有直接绑定的公元年证据，未补公元年。","evidence":["houzhu-q-O050"]},"ordering_evidence":"houzhu-q-O050","source_order":[33,50,"O050m0"],"order":6667}],"persons":[{"id":"houzhu-p0031","name":"治无戴","evidence":["houzhu-q-O050","jfj-q0149","jfj-q0011","mantian-q-1320cbe04e793793b82a","mantian-q-452edaaac78ed4b31dec"],"facts":[],"aliases":[],"mentions":[{"id":"houzhu-m-houzhu-q-O050-houzhu-p0031","kind":"mention","text":"文中提及","evidence":["houzhu-q-O050"]},{"id":"jfj-m-o037-houzhu-p0031","kind":"mention","text":"本段记载：治无戴举部落降姜维安置","evidence":["jfj-q0011"]}]}],"evidence":[{"id":"houzhu-q-O050","section":"chapter-033","block":"b-6d27c3dc885733cd4c62","layer":"original","quote":"十年，凉州胡王白虎文、治无戴等率众降〖8〗；卫将军姜维迎逆安抚，居之于繁县〖9〗。是岁，汶山平康夷反〖10〗，维往讨，破平之。","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":108,"anchor":null},"note_id":null,"start":0,"end":63},{"id":"jfj-q0011","section":"chapter-044","block":"b-14772b9a3b2be1bc9c4e","layer":"original","quote":"十年〖4〗，迁卫将军；与大将军费祎共录尚书事。是岁，汶山平康夷反〖5〗，维率众讨定之。又出陇西、南安、金城界，与魏大将（军）郭淮、夏侯霸等战于洮西。胡王治无戴等举部落降，维将还安处之。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":177,"anchor":null},"note_id":null,"start":0,"end":92},{"id":"jfj-q0149","section":"chapter-044","block":"b-14772b9a3b2be1bc9c4e","layer":"original","quote":"胡王治无戴等举部落降，维将还安处之。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":177,"anchor":null},"note_id":null,"start":74,"end":92},{"id":"mantian-q-1320cbe04e793793b82a","section":"chapter-026","block":"b-6e1328e6a740a128ec3d","layer":"original","quote":"陇西、南安、金城、西平诸羌饿何、烧戈、伐同、蛾遮塞等，相结叛乱〖11〗，攻围城邑，南招蜀兵；凉州名胡治无戴复叛应之","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":330,"anchor":null},"note_id":null,"start":7,"end":64},{"id":"mantian-q-452edaaac78ed4b31dec","section":"chapter-026","block":"b-a5b1ad11436e99dbc058","layer":"original","quote":"治无戴围武威〖18〗，家属留在西海〖19〗。淮进军趋西海，欲掩取其累重〖20〗；会无戴折还，与战于龙夷之北〖21〗，破走之","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":331,"anchor":null},"note_id":null,"start":54,"end":115},{"id":"mantian-q-b7104f78b76870df9f04","section":"chapter-026","block":"b-c94e51255b13f14c5ce0","layer":"modern","quote":"〖10〗八年：正始八年（公元 247）。","attribution":"现代注释","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":345,"anchor":null},"note_id":"n-322e12a2da059d43d188","start":0,"end":20},{"id":"mantian-q-c44c6e7c29f0e387b75e","section":"chapter-026","block":"b-35426a824e988af35226","layer":"modern","quote":"〖15〗九年：正始九年（公元 248）。","attribution":"现代注释","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":350,"anchor":null},"note_id":"n-7a85f1e5a526a58dd446","start":0,"end":20}],"profiles":{},"directory_counts":{}}
