{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"sunshi-e-p037c","title":"孙策中箭后设伏败于兹逼笮融固守","accounts":[{"id":"sunshi-e-p037c-account","label":"《江表传》","text":"孙策中箭后设伏败于兹逼笮融固守","evidence":["sunshi-e-p037c-q"]}],"participants":[{"person":"wudi-p0099","role":"伤而设伏","evidence":["sunshi-e-p037c-q"]},{"person":"zhouyu-p0005","role":"遣将坚守","evidence":["sunshi-e-p037c-q"]},{"person":"sunshi-p0055","role":"出战被破","evidence":["sunshi-e-p037c-q"]}],"place":null,"time":{"year":195,"label":"兴平二年","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"sunshi-y195","dating_review":{"reviewed":true,"anchor":"sunshi-q-p037","basis":"兴平二年"},"evidence":["sunshi-e-p037c-q","sunshi-q-p037","xunyu-q-o009","xunyu-q-b-c63b764c8d77474949e4"]},"ordering_evidence":"sunshi-e-p037c-q","source_order":[46,249,"P037c"],"order":8098}],"persons":[{"id":"sunshi-p0055","name":"于兹","evidence":["sunshi-q-p037"],"facts":[],"aliases":[],"mentions":[{"id":"sunshi-m-p037-sunshi-p0055","kind":"mention","text":"文中提及","evidence":["sunshi-q-p037"]}]}],"evidence":[{"id":"sunshi-e-p037c-q","section":"chapter-046","block":"b-8ad4a2f852325dd4ff74","layer":"pei","quote":"复下攻融，为流矢所中，伤股；不能乘马，因自舆，还牛渚营。或叛告融曰：‘孙郎被箭，已死！’融大喜，即遣将于兹向策。策遣步骑数百挑战，设伏于后。贼出击之，锋刃未接而伪走；贼追入伏中，乃大破之，斩首千余级。策因往到融营下，令左右大呼曰：‘孙郎竟云何！’贼于是惊怖，夜遁。融闻策尚在，更深沟高垒，缮治守备。","attribution":"《江表传》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":248,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6fa39d8ee05c62716a11","start":141,"end":290,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-p037","section":"chapter-046","block":"b-8ad4a2f852325dd4ff74","layer":"pei","quote":"﹝二﹞《江表传》曰：“策渡江，攻繇牛渚营，尽得邸阁粮谷、战具。是岁兴平二年也。时彭城相薛礼、下邳相笮融，依繇为盟主；礼据秣陵城，融屯县南。策先攻融，融出兵交战；斩首五百余级，融即闭门，不敢动。因渡江攻礼，礼突走；而樊能、于麋等，复合众，袭夺牛渚屯。策闻之，还攻破能等，获男女万余人。复下攻融，为流矢所中，伤股；不能乘马，因自舆，还牛渚营。或叛告融曰：‘孙郎被箭，已死！’融大喜，即遣将于兹向策。策遣步骑数百挑战，设伏于后。贼出击之，锋刃未接而伪走；贼追入伏中，乃大破之，斩首千余级。策因往到融营下，令左右大呼曰：‘孙郎竟云何！’贼于是惊怖，夜遁。融闻策尚在，更深沟高垒，缮治守备。策以融所屯地势险固，乃舍去；攻破繇别将于海陵，转攻湖孰、江乘，皆下之。”","attribution":"《江表传》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":248,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6fa39d8ee05c62716a11","start":0,"end":326,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-b-c63b764c8d77474949e4","section":"chapter-010","block":"b-c63b764c8d77474949e4","layer":"modern","quote":"〖11〗二年：兴平二年（公元 195）。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":38,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c70b78b19d5fc0e5d4ef","start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-o009","section":"chapter-010","block":"b-867468e927405dc6280f","layer":"original","quote":"二年夏〖11〗，太祖军乘氏。大饥，人相食。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":26,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":21,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
