ge_0094.xhtml","index":228,"anchor":null},"note_id":null,"start":0,"end":90},{"id":"jfj-q0029","section":"chapter-044","block":"b-244c42d136c1fc518809","layer":"modern","quote":"〖1〗六年：景耀六年（公元 263）。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":236,"anchor":null},"note_id":"n-07b5919ab8c7edcb2376","start":0,"end":19},{"id":"jfj-q0185","section":"chapter-044","block":"b-d4a8e1aeaa400cdee772","layer":"original","quote":"月余，维为邓艾所摧，还住阴平。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":230,"anchor":null},"note_id":null,"start":0,"end":15},{"id":"wgc-q0046","section":"chapter-028","block":"b-23e8850b8ee57e7e439c","layer":"original","quote":"四年秋，诏诸军征蜀，大将军司马文王皆指授节度。使艾与维相缀连〖2〗，雍州刺史诸葛绪邀维〖3〗：令不得归。艾遣天水太守王颀等直攻维营，陇西太守牵弘等邀其前，金城太守杨欣等诣甘松〖4〗。维闻钟会诸军已入汉中，引退还。欣等追蹑于强川口〖5〗，大战。维败走。闻雍州已塞道〖6〗，屯桥头〖7〗；从孔函谷入北道〖8〗，欲出雍州后。诸葛绪闻之，却还三十里〖9〗。维入北道三十余里，闻绪军却，寻还，从桥头过；绪趋截维，较一日不及〖10〗。维遂东引，还守剑阁〖11〗。钟会攻维未能克。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":322,"anchor":null},"note_id":null,"start":0,"end":233},{"id":"wgc-q0371","section":"chapter-028","block":"b-23e8850b8ee57e7e439c","layer":"original","quote":"艾遣天水太守王颀等直攻维营，陇西太守牵弘等邀其前，金城太守杨欣等诣甘松","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":322,"anchor":null},"note_id":null,"start":52,"end":87},{"id":"wgc-q0373","section":"chapter-028","block":"b-23e8850b8ee57e7e439c","layer":"original","quote":"欣等追蹑于强川口〖5〗，大战。维败走","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":322,"anchor":null},"note_id":null,"start":106,"end":124}],"profiles":{},"directory_counts":{}}
