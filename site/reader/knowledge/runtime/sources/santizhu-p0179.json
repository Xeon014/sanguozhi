{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"santizhu064-e-sr-ke-family-execution","title":"峻遣刘承追斩诸葛竦、诸葛建北走被逮、张震朱恩夷三族","accounts":[{"id":"santizhu064-a-f6572737b396a3b034eb","label":"正文","text":"恪诛，中子竦少子建车载其母而走；峻遣骑督刘承追斩竦于白都；建得渡江欲北走魏，行数十里为追兵所逮；恪外甥都乡侯张震及常侍朱恩等皆夷三族","evidence":["santizhu064-q-e406c4a86bfe598e88ee"]}],"participants":[{"person":"shaodi-p0075","role":"遣刘承追斩诸葛竦等","evidence":["santizhu064-q-e406c4a86bfe598e88ee"]},{"person":"santizhu-p0020","role":"奉命追斩诸葛竦于白都","evidence":["santizhu064-q-e406c4a86bfe598e88ee"]},{"person":"santizhu-p0203","role":"车载母走、被追斩","evidence":["santizhu064-q-e406c4a86bfe598e88ee"]},{"person":"santizhu-p0204","role":"渡江欲奔魏、为追兵所逮","evidence":["santizhu064-q-e406c4a86bfe598e88ee"]},{"person":"santizhu-p0162","role":"夷三族（诸葛恪外甥）","evidence":["santizhu064-q-e406c4a86bfe598e88ee"]},{"person":"santizhu-p0179","role":"夷三族（常侍）","evidence":["santizhu064-q-e406c4a86bfe598e88ee"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"未由相邻段落推算纪年；原文时间表达保留在来源引句中。","evidence":["santizhu064-q-e406c4a86bfe598e88ee"]},"ordering_evidence":"santizhu064-q-e406c4a86bfe598e88ee","source_order":[64,293,0],"order":10977},{"id":"santizhu064-e-r-postke-2","title":"诸葛建渡江欲奔魏而被追兵捕获；原文记诸葛恪外甥张震、常侍朱恩等夷三族。","accounts":[{"id":"santizhu064-a-2e0fd2950dcd652f5e54","label":"正文","text":"诸葛建渡江欲奔魏而被追兵捕获；原文记诸葛恪外甥张震、常侍朱恩等夷三族。","evidence":["santizhu064-q-042649f0f84e8ef15fa7"]}],"participants":[{"person":"santizhu-p0175","role":"渡江欲北奔魏，为追兵所逮","evidence":["santizhu064-q-042649f0f84e8ef15fa7"]},{"person":"santizhu-p0176","role":"与朱恩等被诛三族","evidence":["santizhu064-q-042649f0f84e8ef15fa7"]},{"person":"santizhu-p0179","role":"与张震等被诛三族","evidence":["santizhu064-q-042649f0f84e8ef15fa7"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"原文未给本行动独立绝对纪年，不据相邻史事推算。","evidence":["santizhu064-q-042649f0f84e8ef15fa7"]},"ordering_evidence":"santizhu064-q-042649f0f84e8ef15