e1a915df74236b65f"]},"ordering_evidence":"santizhu-q-83fe1a915df74236b65f","source_order":[48,17,75],"order":8470},{"id":"santizhu064-e-sr-dongxing-works","title":"恪建兴元年十月会众东兴更作大堤筑两城、全端留略守之","accounts":[{"id":"santizhu064-a-7ec9396b8ec9f985fd4d","label":"正文","text":"权黄龙二年所筑东兴堤废后，恪以建兴元年十月会众东兴更作大堤，左右结山夹筑两城各留千人，使全端、留略守之，引军而还","evidence":["santizhu064-q-bda3edc70fea50eb99fc"]}],"participants":[{"person":"shaodi-p0041","role":"会众作大堤筑两城并遣将守之","evidence":["santizhu064-q-bda3edc70fea50eb99fc"]},{"person":"shaodi-p0042","role":"奉命守城","evidence":["santizhu064-q-bda3edc70fea50eb99fc"]},{"person":"shaodi-p0043","role":"奉命守城","evidence":["santizhu064-q-bda3edc70fea50eb99fc"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"未由相邻段落推算纪年；原文时间表达保留在来源引句中。","evidence":["santizhu064-q-bda3edc70fea50eb99fc"]},"ordering_evidence":"santizhu064-q-bda3edc70fea50eb99fc","source_order":[64,163,0],"order":10951}],"persons":[{"id":"shaodi-p0043","name":"留略","evidence":["shaodi-q-p012","santizhu-q-d2ee51eebfa6287a6fe6","santizhu-q-83fe1a915df74236b65f"],"facts":[],"aliases":[],"mentions":[{"id":"shaodi-m-p012-shaodi-p0043","kind":"mention","text":"文中提及","evidence":["shaodi-q-p012"]}]}],"evidence":[{"id":"santizhu-q-83fe1a915df74236b65f","section":"chapter-048","block":"b-08113f5ec29645bebbf2","layer":"original","quote":"留略为东海太守〖14〗","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":54,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":75,"end":86,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-d2ee51eebfa6287a6fe6","section":"chapter-048","block":"b-9b3f5181b40c2019f20c","layer":"original","quote":"使将军全端守西城〖7〗，都尉留略守东城〖8〗","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":14,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":26,"end":48,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-bda3edc70fea50eb99fc","section":"chapter-064","block":"b-95838e6de2d2433642f5","layer":"original","quote":"恪以建兴元年十月，会众于东兴，更作大堤；左右结山夹筑两城〖3〗，各留千人；使全端、留略守之，引军而还。","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":162,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":46,"end":97,"offset_unit":"unicode_code_point"},{"id":"shaodi-e-p012a-q","section":"chapter-004","block":"b-b21524fb470242deda03","layer":"pei","quote":"﹝一﹞《汉晋春秋》曰：“初，孙权筑东兴堤，以遏巢湖。后征淮南，坏不复修。是岁，诸葛恪帅军更于堤左右，结山挟筑两城；使全端、留略守之，引军而还。诸葛诞言于司马景王曰：‘致人而不致于人者，此之谓也。今因其内侵，使文舒逼江陵，仲恭向武昌，以羁吴之上流；然后简精卒，攻两城：比救至，可大获也！’景王从之。”","attribution":"《汉晋春秋》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":236,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8fa5c9b0224b3bacd13f","start":0,"end":149,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-b-20272e7cc5379b3fe346","section":"chapter-004","block":"b-20272e7cc5379b3fe346","layer":"modern","quote":"〖17〗四年：嘉平四年（公元252）。癸卯：旧历初二日。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":230,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-db96ad991a403b6a010e","start":0,"end":28,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o052","section":"chapter-004","block":"b-944c76689fd8a3e8fa86","layer":"original","quote":"四年春正月，癸卯〖17〗，以抚军大将军司马景王为大将军。二月，立皇后张氏〖18〗，大赦。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":210,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":44,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-p012","section":"chapter-004","block":"b-b21524fb470242deda03","layer":"pei","quote":"﹝一﹞《汉晋春秋》曰：“初，孙权筑东兴堤，以遏巢湖。后征淮南，坏不复修。是岁，诸葛恪帅军更于堤左右，结山挟筑两城；使全端、留略守之，引军而还。诸葛诞言于司马景王曰：‘致人而不致于人者，此之谓也。今因其内侵，使文舒逼江陵，仲恭向武昌，以羁吴之上流；然后简精卒，攻两城：比救至，可大获也！’景王从之。”","attribution":"《汉晋春秋》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":236,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8fa5c9b0224b3bacd13f","start":0,"end":149,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
