BPS/Text/titlepage_0054.xhtml","index":40,"anchor":null},"note_id":"n-d880aa7224b10e5780cc","start":13,"end":63},{"id":"hancui-q-2ad10c861310cb5f4555","section":"chapter-024","block":"b-9d18cfaa5bd1a3916712","layer":"pei","quote":"﹝三﹞《楚国先贤传》曰：“邦字长林。少有才学。晋武帝时为野王令，有称绩。为新城太守，坐举野王故吏为新城计吏，武帝大怒，遂杀邦。暨次子繇，高阳太守。繇子洪，侍御史。洪子寿，字德贞。”","attribution":"裴注（引书见原文，待主审复核）","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":40,"anchor":null},"note_id":"n-d880aa7224b10e5780cc","start":0,"end":90},{"id":"hancui-q-350b99ff712103e32312","section":"chapter-024","block":"b-eead853d8d29889bbf8b","layer":"original","quote":"肇薨，子邦嗣。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":28,"anchor":null},"note_id":null,"start":93,"end":100},{"id":"hancui-q-e4ecaa189402e40a5604","section":"chapter-024","block":"b-eead853d8d29889bbf8b","layer":"original","quote":"景初二年春，诏曰：“太中大夫韩暨，澡身浴德，志节高洁；年逾八十，守道弥固，可谓纯笃，老而益劭者也〖6〗。其以暨为司徒。”夏四月，薨；遗令敛以时服，葬为土藏〖7〗。谥曰恭侯。﹝二﹞子肇嗣。肇薨，子邦嗣。﹝三﹞","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":28,"anchor":null},"note_id":null,"start":0,"end":103}],"profiles":{},"directory_counts":{}}
