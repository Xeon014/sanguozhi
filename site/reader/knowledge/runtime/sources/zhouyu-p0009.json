{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhouyu-e-o006c","title":"孙策纳大桥","accounts":[{"id":"zhouyu-e-o006c-account","label":"《周瑜鲁肃吕蒙传》正文","text":"孙策攻皖后纳大桥。","evidence":["zhouyu-e-o006c-q"]}],"participants":[{"person":"wudi-p0099","role":"纳妻","evidence":["zhouyu-e-o006c-q"]},{"person":"zhouyu-p0009","role":"成婚","evidence":["zhouyu-e-o006c-q"]}],"place":null,"time":{"label":"孙策取荆州时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["zhouyu-e-o006c-q"]},"ordering_evidence":"zhouyu-e-o006c-q","source_order":[54,7,"O006c"],"order":9573}],"persons":[{"id":"zhouyu-p0009","name":"大桥","evidence":["zhouyu-q-o006"],"facts":[],"aliases":[],"mentions":[{"id":"zhouyu-m-o006-zhouyu-p0009","kind":"mention","text":"文中提及","evidence":["zhouyu-q-o006"]},{"id":"zhouyu-m-p004-zhouyu-p0009","kind":"mention","text":"文中提及","evidence":["zhouyu-q-p004"]}]}],"evidence":[{"id":"zhouyu-e-o006c-q","section":"chapter-054","block":"b-89c42951b7ba509f25e8","layer":"original","quote":"时得桥公两女，皆国色也〖16〗：策自纳大桥，瑜纳小桥。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":6,"anchor":null},"note_id":null,"start":33,"end":60},{"id":"zhouyu-q-o006","section":"chapter-054","block":"b-89c42951b7ba509f25e8","layer":"original","quote":"顷之，策欲取荆州，以瑜为中护军〖15〗，领江夏太守。从攻皖，拔之。时得桥公两女，皆国色也〖16〗：策自纳大桥，瑜纳小桥。﹝三﹞复进寻阳〖17〗，破刘勋。讨江夏，还定豫章、庐陵，留镇巴丘〖18〗。﹝四﹞","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":6,"anchor":null},"note_id":null,"start":0,"end":100},{"id":"zhouyu-q-p004","section":"chapter-054","block":"b-55149cdbbcea899469a1","layer":"pei","quote":"﹝三﹞《江表传》曰：“策从容戏瑜曰：‘桥公二女，虽流离，得吾二人做婿，亦足为欢。’”","attribution":"《江表传》","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":30,"anchor":null},"note_id":"n-d0d37a2ec54753a211f3","start":0,"end":42}],"profiles":{},"directory_counts":{}}
