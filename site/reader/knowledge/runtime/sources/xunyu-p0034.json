{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xunyu-e-o027a","title":"荀衍守邺觉高幹密袭诛之封侯","accounts":[{"id":"xunyu-e-o027a-account","label":"《荀彧荀攸贾诩传第十》正文","text":"荀衍守邺觉高幹密袭诛之封侯","evidence":["xunyu-e-o027a-q"]}],"participants":[{"person":"xunyu-p0034","role":"守城平谋","evidence":["xunyu-e-o027a-q"]},{"person":"wudi-p0235","role":"谋袭","evidence":["xunyu-e-o027a-q"]}],"place":null,"time":{"label":"曹操征袁尚时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xunyu-e-o027a-q"]},"ordering_evidence":"xunyu-e-o027a-q","source_order":[10,143,"O027a"],"order":2434}],"persons":[{"id":"xunyu-p0034","name":"荀衍","evidence":["xunyu-q-o027"],"facts":[{"id":"xunyu-f0010","label":"字","text":"休若","evidence":["xunyu-f0010-q"]}],"aliases":[{"text":"休若","evidence":["xunyu-f0010-q"]}],"mentions":[{"id":"xunyu-m-o027-xunyu-p0034","kind":"mention","text":"文中提及","evidence":["xunyu-q-o027"]},{"id":"xunyu-m-p019-xunyu-p0034","kind":"mention","text":"文中提及","evidence":["xunyu-q-p019"]}]}],"evidence":[{"id":"xunyu-e-o027a-q","section":"chapter-010","block":"b-fff11a0e234ba9cb8c24","layer":"original","quote":"是时，荀攸常为谋主〖1〗。彧兄衍，以监军校尉守邺〖2〗，都督河北事。太祖之征袁尚也，高幹密遣兵谋袭邺；衍逆觉〖3〗，尽诛之，以功封列侯。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":142,"anchor":null},"note_id":null,"start":0,"end":68},{"id":"xunyu-f0010-q","section":"chapter-010","block":"b-310798880b116dcdf9cc","layer":"pei","quote":"衍，字休若","attribution":"《荀氏家传》及裴注","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":154,"anchor":null},"note_id":"n-75cfb114317a4cad6048","start":12,"end":17},{"id":"xunyu-q-o027","section":"chapter-010","block":"b-fff11a0e234ba9cb8c24","layer":"original","quote":"是时，荀攸常为谋主〖1〗。彧兄衍，以监军校尉守邺〖2〗，都督河北事。太祖之征袁尚也，高幹密遣兵谋袭邺；衍逆觉〖3〗，尽诛之，以功封列侯。﹝一﹞太祖以女，妻彧长子恽，后称安阳公主。彧及攸并贵重，皆谦冲节俭；禄赐散之宗族、知旧〖4〗，家无余财。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":142,"anchor":null},"note_id":null,"start":0,"end":120},{"id":"xunyu-q-p019","section":"chapter-010","block":"b-310798880b116dcdf9cc","layer":"pei","quote":"﹝一﹞《荀氏家传》曰：“衍，字休若。彧第三兄。”彧第四兄谌，字友若。事见《袁绍传》。陈群与孔融，论汝、颍人物，群曰：“荀文若、公达、休若、友若、仲豫，当今并无对。”衍子绍，位至太仆。绍子融，字伯雅；与王弼、钟会俱知名；为洛阳令，参大将军军事；与弼、会论《易》、《老》义，传于世。谌子闳，字仲茂。为太子文学掾。时有甲、乙疑论，闳与钟繇、王朗、袁涣，议各不同。文帝与繇书曰：“袁、王国士，更为唇齿；荀闳劲悍，往来锐师：真君侯之勍敌，左右之深忧也。”终黄门侍郎。闳从孙（恽）〔煇〕，字景文。太子中庶子，亦知名。与贾充共定（音）〔晋〕律，又作《易集解》。仲豫名悦，朗陵长俭之少子，彧从父兄也。","attribution":"《荀氏家传》及裴注","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":154,"anchor":null},"note_id":"n-75cfb114317a4cad6048","start":0,"end":292}],"profiles":{},"directory_counts":{}}
