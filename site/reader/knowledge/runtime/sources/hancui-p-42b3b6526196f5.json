{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"hancui-e-51d9562f4273882e4e70","title":"高昌高赐历刺史郡守高弘举孝廉","accounts":[{"id":"hancui-a-51d9562f4273882e4e70","label":"裴注·陈留耆旧传","text":"高昌高赐历刺史郡守高弘举孝廉","evidence":["hancui-q-b369084c193c53e15edc"]}],"participants":[{"person":"hancui-p-6bc454c2b7f8e8","role":"任官","evidence":["hancui-q-b369084c193c53e15edc"]},{"person":"hancui-p-fb06d2bf71cc10","role":"任官","evidence":["hancui-q-b369084c193c53e15edc"]},{"person":"hancui-p-42b3b6526196f5","role":"获举","evidence":["hancui-q-b369084c193c53e15edc"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["hancui-q-b369084c193c53e15edc"]},"ordering_evidence":"hancui-q-b369084c193c53e15edc","order":4940}],"persons":[{"id":"hancui-p-42b3b6526196f5","name":"高弘","evidence":["hancui-q-b369084c193c53e15edc","hancui-q-520558038dc7d9d2677d"],"facts":[{"id":"hancui-f-b9695e6424171e9c9970","text":"高式之子，高靖之父。","evidence":["hancui-q-520558038dc7d9d2677d"]}],"mentions":[],"aliases":[]}],"evidence":[{"id":"hancui-q-520558038dc7d9d2677d","section":"chapter-024","block":"b-636538eb5af9c7c34526","layer":"pei","quote":"﹝一﹞《陈留耆旧传》曰：“靖高祖父固，不仕王莽世。为淮阳太守所害，以烈节垂名。固子慎，字孝甫。敦厚少华，有沉深之量。抚育孤兄子五人，恩义甚笃。琅邪相何英嘉其行履，以女妻焉。英即车骑将军熙之父也。慎历二县令、东莱太守。老病归家，草屋蓬户，瓮缶无储。其妻谓之曰：‘君累经宰守，积有年岁，何能不少为储蓄以遗子孙乎？’慎曰：‘我以勤身清名为之基，以二千石遗之，不亦可乎！’子式，至孝，常尽力供养。永初中，螟蝗为害，独不食式麦；圉令周强以表州郡。太守杨舜举式孝子；让，不行。后以孝廉为郎。次子昌，昌弟赐；并为刺史、郡守。式子弘，孝廉。弘生靖。”","attribution":"裴注（引书见原文，待主审复核）","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":147,"anchor":null},"note_id":"n-1cdde7f49e866c28648d","start":0,"end":267},{"id":"hancui-q-b369084c193c53e15edc","section":"chapter-024","block":"b-636538eb5af9c7c34526","layer":"pei","quote":"次子昌，昌弟赐；并为刺史、郡守。式子弘，孝廉。","attribution":"裴注·陈留耆旧传","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":147,"anchor":null},"note_id":"n-1cdde7f49e866c28648d","start":239,"end":262}],"profiles":{},"directory_counts":{}}
