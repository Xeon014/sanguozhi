huan-q-29a85aad39fa02b66c08"],"facts":[{"id":"wuhuan-f-96be87a2dfbf8cf7972b","text":"牛加兄子，为大使；区别同篇夫余王简位居及高句丽驳位居。","evidence":["wuhuan-q-29a85aad39fa02b66c08"]}],"mentions":[],"aliases":[]}],"evidence":[{"id":"wuhuan-q-29a85aad39fa02b66c08","section":"chapter-030","block":"b-913e4b4dc1858efb4f54","layer":"original","quote":"夫余本属玄菟。汉末，公孙度雄张海东〖21〗，威服外夷；夫余王尉仇台更属辽东。时句丽、鲜卑强〖22〗，度以夫余在二虏之间，妻以宗女〖23〗。尉仇台死，〔至孙〕简位居立。无適子〖24〗，有孽子麻余〖25〗。位居死，诸加共立麻余。牛加兄子名位居，为大使；轻财善施，国人附之，岁岁遣使诣京都贡献。","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":142,"anchor":null},"note_id":null,"start":0,"end":144},{"id":"wuhuan-q-989c48d9b6a66e819ddf","section":"chapter-030","block":"b-913e4b4dc1858efb4f54","layer":"original","quote":"岁岁遣使诣京都贡献","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":142,"anchor":null},"note_id":null,"start":134,"end":143},{"id":"wuhuan-q-afd27beca545c9166087","section":"chapter-030","block":"b-e6e49a573d831a14d039","layer":"original","quote":"季父牛加有二心〖26〗，位居杀季父父子，籍没财物〖27〗，遣使（簿）〔薄〕敛送官","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":143,"anchor":null},"note_id":null,"start":38,"end":78},{"id":"wuhuan-q-e89debddd0aa14f47bb0","section":"chapter-030","block":"b-e6e49a573d831a14d039","layer":"original","quote":"位居遣大加郊迎，供军粮","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":143,"anchor":null},"note_id":null,"start":26,"end":37}],"profiles":{},"directory_counts":{}}
