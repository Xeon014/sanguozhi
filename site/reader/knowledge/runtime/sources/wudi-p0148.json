l","index":50,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":39,"end":52,"offset_unit":"unicode_code_point"},{"id":"lizang-q-ac794450a01cb61cc9a5","section":"chapter-018","block":"b-eb5fdf6d1207ecfe4545","layer":"original","quote":"割青、徐二州〖6〗，委之于霸","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":49,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":67,"end":81,"offset_unit":"unicode_code_point"},{"id":"lizang-q-af7ff31f71d7488727ca","section":"chapter-018","block":"b-eb5fdf6d1207ecfe4545","layer":"original","quote":"太祖以霸为琅邪相，敦利城、礼东莞、观北海、康城阳太守","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":49,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":37,"end":63,"offset_unit":"unicode_code_point"},{"id":"lizang-q-cc54e4d38b897a1687ed","section":"chapter-018","block":"b-c6a0a059639efb25cb0e","layer":"pei","quote":"与霸俱战伐，观常为先登。征定青、徐群贼，功次于霸，封吕都亭侯","attribution":"裴注·魏书","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":86,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-3739094c48cc566b91a4","start":53,"end":83,"offset_unit":"unicode_code_point"},{"id":"lizang-q-db1cc61283eb5f60ed7a","section":"chapter-018","block":"b-c6a0a059639efb25cb0e","layer":"pei","quote":"太祖劳之曰：‘将军被创深重，而猛气益奋，不当为国爱身乎","attribution":"裴注·魏书","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":86,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-3739094c48cc566b91a4","start":149,"end":176,"offset_unit":"unicode_code_point"},{"id":"lizang-q-fb238dde2bfc2b1074fe","section":"chapter-018","block":"b-c6a0a059639efb25cb0e","layer":"pei","quote":"太祖破吕布，使霸招观兄弟，皆厚遇之","attribution":"裴注·魏书","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":86,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-3739094c48cc566b91a4","start":35,"end":52,"offset_unit":"unicode_code_point"},{"id":"lizang-q2-242a9c76e85ead401030","section":"chapter-018","block":"b-c6a0a059639efb25cb0e","layer":"pei","quote":"﹝四﹞《魏书》曰：“孙观字仲台，泰山人。与臧霸俱起，讨黄巾，拜骑都尉。太祖破吕布，使霸招观兄弟，皆厚遇之。与霸俱战伐，观常为先登。征定青、徐群贼，功次于霸，封吕都亭侯。康，亦以功封列侯。与太祖会南皮，遣子弟入居邺。拜观偏将军，迁青州刺史。从征孙权于濡须口，假节。攻权，为流矢所中，伤左足，力战不顾。太祖劳之曰：‘将军被创深重，而猛气益奋，不当为国爱身乎？’转振威将军。创甚，遂卒。”","attribution":"裴注·魏书","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":86,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-3739094c48cc566b91a4","start":0,"end":191,"offset_unit":"unicode_code_point"},{"id":"lizang-q2-9c6338e94b3437d9785b","section":"chapter-018","block":"b-be8de3afb0e99a0dc4d7","layer":"original","quote":"而孙观，亦至青州刺史，假节；从太祖讨孙权，战被创，薨。子毓嗣，亦至青州刺史。﹝四﹞","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":54,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":41,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o059a-q","section":"chapter-001","block":"b-c0c387dd79d2675c22f6","layer":"original","quote":"太山臧霸、孙观、吴敦、尹礼、昌豨〖7〗，各聚众。布之破刘备也，霸等悉从布。布败，获霸等，公厚纳待，遂割青、徐二州附于海以委焉〖8〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":339,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":66,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-4269a9733b31c7ed1578","section":"chapter-001","block":"b-4269a9733b31c7ed1578","layer":"modern","quote":"〖1〗三年：建安三年（公元 198）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":327,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1273453201e8129c485c","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o054","section":"chapter-001","block":"b-ec1ae0750950ac5532fb","layer":"original","quote":"三年春正月〖1〗，公还许。初置军师祭酒〖2〗。三月，公围张绣于穰。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":323,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":33,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o059","section":"chapter-001","block":"b-c0c387dd79d2675c22f6","layer":"original","quote":"太山臧霸、孙观、吴敦、尹礼、昌豨〖7〗，各聚众。布之破刘备也，霸等悉从布。布败，获霸等，公厚纳待，遂割青、徐二州附于海以委焉〖8〗。分琅邪、东海、北海为城阳、利城、昌虑郡〖9〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":339,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":89,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
