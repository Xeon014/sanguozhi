{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o057a","title":"高顺破刘备与曹操征吕布","accounts":[{"id":"wudi-e-o057a-account","label":"正文","text":"吕布助袁术，遣高顺攻刘备；夏侯惇救援不利，刘备战败，曹操九月东征吕布。","evidence":["wudi-e-o057a-q"]},{"id":"xianzhu-e-o013c-account","label":"《先主传》正文","text":"高顺攻刘备，夏侯惇不能救；曹操亲征，与刘备围吕布于下邳并生擒之，刘备取回妻子。","evidence":["xianzhu-e-o013c-q"]},{"id":"xianzhu-e-p012b-account","label":"《英雄记》","text":"《英雄记》记高顺、张辽攻沛，九月破城，十月刘备在梁国界迎曹操东征。","evidence":["xianzhu-e-p012b-q"]},{"id":"lvzang-a-785e5cc417581d1eb3ac","label":"正文","text":"建安三年布复叛为术遣高顺攻备于沛破之","evidence":["lvzang-q-4fe6a800149fd9eee435"]},{"id":"lvzang-a-e720d1198d79a702e79c","label":"正文","text":"太祖遣夏侯惇救备为顺所败","evidence":["lvzang-q-292cdc633bfd71d74aca"]}],"participants":[{"person":"wudi-p0088","role":"遣将","evidence":["wudi-e-o057a-q"]},{"person":"wudi-p0057","role":"获吕布协助","evidence":["wudi-e-o057a-q"]},{"person":"wudi-p0140","role":"攻破刘备","evidence":["wudi-e-o057a-q"]},{"person":"liu-bei","role":"战败","evidence":["wudi-e-o057a-q"]},{"person":"cao-cao","role":"遣救东征","evidence":["wudi-e-o057a-q"]},{"person":"wudi-p0027","role":"救援不利","evidence":["wudi-e-o057a-q"]},{"person":"wudi-p0178","role":"攻沛","evidence":["xianzhu-e-p012b-q"]}],"place":null,"time":{"label":"建安三年九月东征","year":198,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o057a-q","wudi-q-o054","wudi-q-b-4269a9733b31c7ed1578"],"chronology":"wudi-y198","dating_review":{"anchor":"wudi-q-o054","basis":"建安三年九月东征","reviewed":true}},"source_order":[1,338,"O057a"],"order":148},{"id":"wudi-e-o058b","title":"水灌下邳与吕布陈宫被杀","accounts":[{"id":"wudi-e-o058b-account","label":"正文","text":"曹操用荀攸、郭嘉计引水灌城，月余后宋宪、魏续等执陈宫降城，吕布、陈宫被擒杀。","evidence":["wudi-e-o058b-q"]},{"id":"lvzang-a-5ecdd541774cb62577b2","label":"正文","text":"太祖堑围三月侯成宋宪魏续缚陈宫以其众降","evidence":["lvzang-q-c2847a531d2132afe2d2"]},{"id":"lvzang-a-1baedb446978a1e4ad2e","label":"正文","text":"布登白门楼兵围急乃下降被生缚","evidence":["lvzang-q-75cbe570c70c5329d02f"]},{"id":"lvzang-a-66136842a118a696acdd","label":"正文","text":"备进言太祖缢杀布宫顺等枭首送许","evidence":["lvzang-q-1d5c9a6c11cb5bec3896"]},{"id":"lvzang-a-b6b1d24ddf409c28ed21","label":"裴注·九州春秋","text":"会太祖围下邳侯成遂领众降","evidence":["lvzang-q-041ab5ab00c4a4c06c3e"]},{"id":"yuanzhang-a-1b9e9aa7b3b3aa0b3531","label":"正文","text":"吕布被诛后袁涣得归太祖","evidence":["yuanzhang-q-6bf1b1254f8ab107a819"]}],"participants":[{"person":"cao-cao","role":"灌城擒杀","evidence":["wudi-e-o058b-q"]},{"person":"wudi-p0143","role":"献计","evidence":["wudi-e-o058b-q"]},{"person":"wudi-p0144","role":"献计","evidence":["wudi-e-o058b-q"]},{"person":"wudi-p0145","role":"执宫投降","evidence":["wudi-e-o058b-q"]},{"person":"wudi-p0146","role":"执宫投降","evidence":["wudi-e-o058b-q"]},{"person":"wudi-p0088","role":"被杀","evidence":["wudi-e-o058b-q"]},{"person":"wudi-p0096","role":"被杀","evidence":["wudi-e-o058b-q"]},{"person":"lvzang-p0001","role":"布将、缚陈宫将其众降；遂领众降","evidence":["lvzang-q-c2847a531d2132afe2d2","lvzang-q-041ab5ab00c4a4c06c3e"]},{"person":"liu-bei","role":"进曰明公不见布之事丁建阳及董太师乎","evidence":["lvzang-q-1d5c9a6c11cb5bec3896"]},{"person":"wudi-p0140","role":"枭首送许","evidence":["lvzang-q-1d5c9a6c11cb5bec3896"]},{"person":"wudi-p0308","role":"吕布被诛后归太祖","evidence":["yuanzhang-q-6bf1b1254f8ab107a819"]}],"place":{"text":"下邳、泗水、沂水","evidence":["wudi-e-o058b-q"]},"time":{"label":"建安三年（围攻月余后）","year":198,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o058b-q","wudi-q-o054","wudi-q-b-4269a9733b31c7ed1578"],"chronology":"wudi-y198","dating_review":{"anchor":"wudi-q-o054","basis":"建安三年（围攻月余后）","reviewed":true}},"source_order":[1,339,"O058b"],"order":150},{"id":"lvzang-e-o090","title":"布诣高顺营顺严兵射萌众萌众还故营","accounts":[{"id":"lvzang-a-24753e6ba22508aafa2f","label":"裴注·英雄记","text":"布诣高顺营顺严兵射萌众萌众还故营","evidence":["lvzang-q-f8915f4f016e3fbb0ee0"]}],"participants":[{"person":"wudi-p0088","role":"诣都督高顺营直排顺门入、言河内儿声","evidence":["lvzang-q-f8915f4f016e3fbb0ee0"]},{"person":"wudi-p0140","role":"问将军有所隐不、言此郝萌也、即严兵入府弓弩并射萌众","evidence":["lvzang-q-f8915f4f016e3fbb0ee0"]},{"person":"lvzang-p0023","role":"众乱走天明还故营","evidence":["lvzang-q-f8915f4f016e3fbb0ee0"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["lvzang-q-f8915f4f016e3fbb0ee0"]},"ordering_evidence":"lvzang-q-f8915f4f016e3fbb0ee0","source_order":[7,77,252],"order":1818},{"id":"lvzang-e-o091","title":"曹性反萌与战萌刺伤性顺斫萌首舆性诣布","accounts":[{"id":"lvzang-a-8d4243b4e7c580a1368d","label":"裴注·英雄记","text":"曹性反萌与战萌刺伤性顺斫萌首舆性诣布","evidence":["lvzang-q-77fcb395a910b6776708"]}],"participants":[{"person":"lvzang-p0009","role":"萌将、反萌与对战、被萌刺伤、斫萌一臂","evidence":["lvzang-q-77fcb395a910b6776708"]},{"person":"lvzang-p0023","role":"刺伤性、被斫一臂、被顺斩首","evidence":["lvzang-q-77fcb395a910b6776708"]},{"person":"wudi-p0140","role":"斫萌首、床舆性送诣布","evidence":["lvzang-q-77fcb395a910b6776708"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["lvzang-q-77fcb395a910b6776708"]},"ordering_evidence":"lvzang-q-77fcb395a910b6776708","source_order":[7,77,322],"order":1819},{"id":"lvzang-e-o104","title":"布自将向莒高顺谏不从霸登城拒守布不能拔引还","accounts":[{"id":"lvzang-a-e50a8a16601aabb33525","label":"裴注·英雄记","text":"布自将向莒高顺谏不从霸登城拒守布不能拔引还","evidence":["lvzang-q-7b9e6230d9c398eff09a"]}],"participants":[{"person":"wudi-p0088","role":"闻之自将步骑向莒、不从顺谏、不能拔引还下邳","evidence":["lvzang-q-7b9e6230d9c398eff09a"]},{"person":"wudi-p0140","role":"谏曰将军躬杀董卓威震夷狄端坐顾盼远近自然畏服不宜轻自出军如或不捷损名非小","evidence":["lvzang-q-7b9e6230d9c398eff09a"]},{"person":"wudi-p0147","role":"畏布引还抄暴、果登城拒守、后复与布和","evidence":["lvzang-q-7b9e6230d9c398eff09a"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["lvzang-q-7b9e6230d9c398eff09a"]},"ordering_evidence":"lvzang-q-7b9e6230d9c398eff09a","source_order":[7,119,433],"order":1843},{"id":"lvzang-e-o109","title":"布欲自将断粮道妻谏宫顺不和布不能自决","accounts":[{"id":"lvzang-a-445b15dfe031d6b35d0e","label":"裴注·英雄记","text":"布欲自将断粮道妻谏宫顺不和布不能自决","evidence":["lvzang-q-cd24258052e243fc9830"]},{"id":"lvzang-a-02728928e693479dae8a","label":"裴注·魏氏春秋","text":"宫劝布出屯内外夹击布妻谏布乃止","evidence":["lvzang-q-c077f5e3db2ee782c27e"]}],"participants":[{"person":"wudi-p0088","role":"欲令陈宫高顺守城自将骑断太祖粮道、得妻言愁闷不能自决；然之、乃止","evidence":["lvzang-q-cd24258052e243fc9830","lvzang-q-c077f5e3db2ee782c27e"]},{"person":"lvzang-p0004","role":"谓曰将军自出断曹公粮道是也宫顺素不和将军一出宫顺必不同心共城守也如有蹉跌将军当于何自立乎愿将军谛计之无为宫等所误也妾昔在长安已为将军所弃赖得庞舒私藏妾身耳今不须顾妾也；曰昔曹氏待公台如赤子犹舍而来今将军厚公台不过于曹公而欲委全城捐妻子孤军远出若一旦有变妾岂得为将军妻哉","evidence":["lvzang-q-cd24258052e243fc9830","lvzang-q-c077f5e3db2ee782c27e"]},{"person":"wudi-p0096","role":"素与顺不和者；谓布曰曹公远来势不能久若将军以步骑出屯为势于外宫将余众闭守于内若向将军宫引兵而攻其背若来攻城将军为救于外不过旬日军食必尽击之可破","evidence":["lvzang-q-cd24258052e243fc9830","lvzang-q-c077f5e3db2ee782c27e"]},{"person":"wudi-p0140","role":"素与宫不和者","evidence":["lvzang-q-cd24258052e243fc9830"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["lvzang-q-cd24258052e243fc9830","lvzang-q-c077f5e3db2ee782c27e"]},"ordering_evidence":"lvzang-q-cd24258052e243fc9830","source_order":[7,121,151],"order":1848},{"id":"lvzang-e-o117","title":"顺每谏布布不能用郝萌反后夺顺兵与魏续","accounts":[{"id":"lvzang-a-46e081e2eb10a46ba18c","label":"裴注·英雄记","text":"顺每谏布布不能用郝萌反后夺顺兵与魏续","evidence":["lvzang-q-dbfdaeb2ed7f928bc45e"]}],"participants":[{"person":"wudi-p0140","role":"每谏布言凡破家亡国非无忠臣明智者也但患不见用耳将军举动不肯详思辄喜言误误不可数也、当攻战仍将续所领兵、终无恨意","evidence":["lvzang-q-dbfdaeb2ed7f928bc45e"]},{"person":"wudi-p0088","role":"知其忠然不能用、从郝萌反后更疏顺、以魏续有外内之亲悉夺顺所将兵以与续","evidence":["lvzang-q-dbfdaeb2ed7f928bc45e"]},{"person":"wudi-p0146","role":"有外内之亲、受顺所将兵","evidence":["lvzang-q-dbfdaeb2ed7f928bc45e"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["lvzang-q-dbfdaeb2ed7f928bc45e"]},"ordering_evidence":"lvzang-q-dbfdaeb2ed7f928bc45e","source_order":[7,126,70],"order":1855}],"persons":[{"id":"wudi-p0140","name":"高顺","evidence":["wudi-q-o057","xianzhu-q-o013","lvzang-q-4fe6a800149fd9eee435","lvzang-q-292cdc633bfd71d74aca","lvzang-q-1d5c9a6c11cb5bec3896","lvzang-q-f8915f4f016e3fbb0ee0","lvzang-q-77fcb395a910b6776708","lvzang-q-7b9e6230d9c398eff09a","lvzang-q-cd24258052e243fc9830","lvzang-q-dbfdaeb2ed7f928bc45e","lvzang-q-ec51daeef30a723ebf93"],"facts":[{"id":"lvzang-f-review-e9129c5f984437f2bae6","text":"英雄记记：为人清白有威严，不饮酒，不受馈遗；所将七百余兵号为千人，铠甲斗具皆精练齐整，名为陷阵营","evidence":["lvzang-q-ec51daeef30a723ebf93"]}],"aliases":[],"mentions":[{"id":"wudi-m-o057-wudi-p0140","kind":"mention","text":"文中提及","evidence":["wudi-q-o057"]},{"id":"xianzhu-m-o013-wudi-p0140","kind":"mention","text":"文中提及","evidence":["xianzhu-q-o013"]},{"id":"xianzhu-m-p012-wudi-p0140","kind":"mention","text":"文中提及","evidence":["xianzhu-q-p012"]}]}],"evidence":[{"id":"lvzang-q-041ab5ab00c4a4c06c3e","section":"chapter-007","block":"b-3641f77987147c318cae","layer":"pei","quote":"会太祖围下邳，成遂领众降","attribution":"裴注·九州春秋","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":122,"anchor":null},"note_id":"n-8e2c5f07165c04d36c9a","start":187,"end":199},{"id":"lvzang-q-1d5c9a6c11cb5bec3896","section":"chapter-007","block":"b-66d8ed1a8c5b129739ae","layer":"original","quote":"刘备进曰：“明公不见布之事丁建阳及董太师乎〖8〗！”太祖颔之〖9〗。布因指备曰：“是儿最叵信者〖10〗！”﹝五﹞于是缢杀布〖11〗。布与宫、顺等皆枭首送许，然后葬之","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":99,"anchor":null},"note_id":null,"start":0,"end":82},{"id":"lvzang-q-292cdc633bfd71d74aca","section":"chapter-007","block":"b-40fdcaab8e953c623e46","layer":"original","quote":"太祖遣夏侯惇救备，为顺所败","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":96,"anchor":null},"note_id":null,"start":23,"end":36},{"id":"lvzang-q-4fe6a800149fd9eee435","section":"chapter-007","block":"b-40fdcaab8e953c623e46","layer":"original","quote":"建安三年，布复叛为术；遣高顺攻刘备于沛，破之","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":96,"anchor":null},"note_id":null,"start":0,"end":22},{"id":"lvzang-q-75cbe570c70c5329d02f","section":"chapter-007","block":"b-89207ecfdd74ae282a34","layer":"original","quote":"布与其麾下登白门楼〖4〗，兵围急，乃下降，遂生缚布","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":98,"anchor":null},"note_id":null,"start":39,"end":64},{"id":"lvzang-q-77fcb395a910b6776708","section":"chapter-007","block":"b-630d90f48255ffda7b80","layer":"pei","quote":"萌将曹性，反萌，与对战；萌刺伤性，性斫萌一臂。顺斫萌首，床舆性，送诣布","attribution":"裴注·英雄记","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":76,"anchor":null},"note_id":"n-c3c03b97c67239fef561","start":322,"end":357},{"id":"lvzang-q-7b9e6230d9c398eff09a","section":"chapter-007","block":"b-283cedb7fa0273b89062","layer":"pei","quote":"布闻之，自将步骑向莒。高顺谏曰：‘将军躬杀董卓，威震夷狄；端坐顾盼，远近自然畏服，不宜轻自出军。如或不捷，损名非小！’布不从。霸畏布引还抄暴，果登城拒守。布不能拔，引还下邳","attribution":"裴注·英雄记","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":118,"anchor":null},"note_id":"n-a7ab9de04a39324dfeda","start":433,"end":519},{"id":"lvzang-q-c077f5e3db2ee782c27e","section":"chapter-007","block":"b-159cd164ea69a63a78e2","layer":"pei","quote":"陈宫谓布曰：‘曹公远来，势不能久。若将军以步骑出屯，为势于外，宫将余众闭守于内：若向将军，宫引兵而攻其背；若来攻城，将军为救于外。不过旬日，军食必尽，击之可破。’布然之。布妻曰：‘昔曹氏待公台如赤子，犹舍而来。今将军厚公台不过于曹公，而欲委全城，捐妻子，孤军远出；若一旦有变，妾岂得为将军妻哉！’布乃止","attribution":"裴注·魏氏春秋","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":121,"anchor":null},"note_id":"n-0324e650424a8aac337a","start":9,"end":160},{"id":"lvzang-q-c2847a531d2132afe2d2","section":"chapter-007","block":"b-89207ecfdd74ae282a34","layer":"original","quote":"太祖堑围之三月〖3〗，上下离心。其将侯成、宋宪、魏续，缚陈宫，将其众降","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":98,"anchor":null},"note_id":null,"start":0,"end":35},{"id":"lvzang-q-cd24258052e243fc9830","section":"chapter-007","block":"b-34ee8404b5682e6bd0e4","layer":"pei","quote":"布欲令陈宫、高顺守城，自将骑断太祖粮道；布妻谓曰：‘将军自出断曹公粮道，是也。宫、顺素不和，将军一出，宫、顺必不同心共城守也。如有蹉跌，将军当于何自立乎？愿将军谛计之，无为宫等所误也！妾昔在长安，已为将军所弃，赖得庞舒私藏妾身耳。今不须顾妾也。’布得妻言，愁闷不能自决","attribution":"裴注·英雄记","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":120,"anchor":null},"note_id":"n-0324e650424a8aac337a","start":151,"end":285},{"id":"lvzang-q-dbfdaeb2ed7f928bc45e","section":"chapter-007","block":"b-7d0314fe476e3e227dc0","layer":"pei","quote":"顺每谏布，言：‘凡破家亡国，非无忠臣明智者也，但患不见用耳。将军举动，不肯详思，辄喜言误，误不可数也。’布知其忠，然不能用；布从郝萌反后，更疏顺。以魏续有外内之亲，悉夺顺所将兵以与续。及当攻战，故令顺将续所领兵，顺亦终无恨意","attribution":"裴注·英雄记","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":125,"anchor":null},"note_id":"n-880e0e85c592af5b5051","start":70,"end":182},{"id":"lvzang-q-ec51daeef30a723ebf93","section":"chapter-007","block":"b-7d0314fe476e3e227dc0","layer":"pei","quote":"顺为人，清白有威严，不饮酒，不受馈遗。所将七百余兵，号为千人，铠甲斗具皆精练齐整。每所攻击，无不破者，名为‘陷阵营","attribution":"英雄记","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":125,"anchor":null},"note_id":"n-880e0e85c592af5b5051","start":11,"end":68},{"id":"lvzang-q-f8915f4f016e3fbb0ee0","section":"chapter-007","block":"b-630d90f48255ffda7b80","layer":"pei","quote":"诣都督高顺营，直排顺门入。顺问：‘将军有所隐不？’布言：‘河内儿声。’顺言：‘此郝萌也。’顺即严兵入府，弓弩并射萌众。萌众乱走，天明还故营","attribution":"裴注·英雄记","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":76,"anchor":null},"note_id":"n-c3c03b97c67239fef561","start":252,"end":321},{"id":"wudi-e-o057a-q","section":"chapter-001","block":"b-961dbaf078534b1eab6b","layer":"original","quote":"吕布复为袁术，使高顺攻刘备〖1〗。公遣夏侯惇救之，不利；备为顺所败。九月，公东征布。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":337,"anchor":null},"note_id":null,"start":0,"end":42},{"id":"wudi-e-o058b-q","section":"chapter-001","block":"b-1e667d99069ce89fe4e0","layer":"original","quote":"攻之不下。时公连战，士卒疲，欲还；用荀攸、郭嘉计〖5〗，遂决泗、沂水以灌城〖6〗。月余，布将宋宪、魏续等执陈宫，举城降。生擒布、宫，皆杀之。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":338,"anchor":null},"note_id":null,"start":83,"end":153},{"id":"wudi-q-b-4269a9733b31c7ed1578","section":"chapter-001","block":"b-4269a9733b31c7ed1578","layer":"modern","quote":"〖1〗三年：建安三年（公元 198）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":327,"anchor":null},"note_id":"n-1273453201e8129c485c","start":0,"end":19},{"id":"wudi-q-o054","section":"chapter-001","block":"b-ec1ae0750950ac5532fb","layer":"original","quote":"三年春正月〖1〗，公还许。初置军师祭酒〖2〗。三月，公围张绣于穰。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":323,"anchor":null},"note_id":null,"start":0,"end":33},{"id":"wudi-q-o057","section":"chapter-001","block":"b-961dbaf078534b1eab6b","layer":"original","quote":"吕布复为袁术，使高顺攻刘备〖1〗。公遣夏侯惇救之，不利；备为顺所败。九月，公东征布。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":337,"anchor":null},"note_id":null,"start":0,"end":42},{"id":"xianzhu-e-o013c-q","section":"chapter-032","block":"b-2bcaabf007ae7b6068f2","layer":"original","quote":"布遣高顺攻之〖3〗；曹公遣夏侯惇往，不能救；为顺所败，复虏先主妻子送布。曹公自出东征，﹝二﹞助先主围布于下邳。生擒布，先主复得妻子。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":59,"anchor":null},"note_id":null,"start":76,"end":142},{"id":"xianzhu-e-p012b-q","section":"chapter-032","block":"b-65b45459ea9295068b1f","layer":"pei","quote":"布由是遣中郎将高顺、北地太守张辽等，攻备。九月，遂破沛城，备单身走，获其妻息。十月，曹公自征布；备于梁国界中，与曹公相遇，遂随公俱东征。","attribution":"《英雄记》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":69,"anchor":null},"note_id":"n-3ea9ec85d80bc5c5b2e4","start":36,"end":104},{"id":"xianzhu-q-o013","section":"chapter-032","block":"b-2bcaabf007ae7b6068f2","layer":"original","quote":"先主还小沛，﹝一﹞复合兵得万余人。吕布恶之，自出兵攻先主。先主败走归曹公〖1〗，曹公厚遇之〖2〗，以为豫州牧。将至沛收散卒，给其军粮；益与兵，使东击布。布遣高顺攻之〖3〗；曹公遣夏侯惇往，不能救；为顺所败，复虏先主妻子送布。曹公自出东征，﹝二﹞助先主围布于下邳。生擒布，先主复得妻子。从曹公还许，表先主为左将军；礼之愈重，出则同舆，坐则同席。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":59,"anchor":null},"note_id":null,"start":0,"end":171},{"id":"xianzhu-q-p012","section":"chapter-032","block":"b-65b45459ea9295068b1f","layer":"pei","quote":"﹝二﹞《英雄记》曰：“建安三年春，布使人赍金，欲诣河内买马，为备兵所抄。布由是遣中郎将高顺、北地太守张辽等，攻备。九月，遂破沛城，备单身走，获其妻息。十月，曹公自征布；备于梁国界中，与曹公相遇，遂随公俱东征。”","attribution":"《英雄记》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":69,"anchor":null},"note_id":"n-3ea9ec85d80bc5c5b2e4","start":0,"end":105},{"id":"yuanzhang-q-6bf1b1254f8ab107a819","section":"chapter-011","block":"b-e051f0c32d3c8e964731","layer":"original","quote":"布诛，涣得归太祖","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":21,"anchor":null},"note_id":null,"start":0,"end":8}],"profiles":{},"directory_counts":{}}
