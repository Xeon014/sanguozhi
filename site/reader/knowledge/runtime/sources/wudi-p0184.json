{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o081a","title":"张郃高览降曹与袁军溃败","accounts":[{"id":"wudi-e-o081a-account","label":"正文","text":"袁绍遣张郃、高览攻曹洪，二将闻粮营败而投降，袁军大溃，袁绍、袁谭渡河北逃。","evidence":["wudi-e-o081a-q"]},{"id":"dongyuan-e-o052a-account","label":"《董二袁刘传第六》正文","text":"张郃高览降曹袁绍袁谭败渡河","evidence":["dongyuan-e-o052a-q"]}],"participants":[{"person":"wudi-p0052","role":"遣军败逃","evidence":["wudi-e-o081a-q"]},{"person":"wudi-p0163","role":"败逃","evidence":["wudi-e-o081a-q"]},{"person":"wudi-p0183","role":"攻营后降","evidence":["wudi-e-o081a-q"]},{"person":"wudi-p0184","role":"攻营后降","evidence":["wudi-e-o081a-q"]},{"person":"wudi-p0075","role":"守营","evidence":["wudi-e-o081a-q"]},{"person":"cao-cao","role":"获胜收军资","evidence":["wudi-e-o081a-q"]}],"place":null,"time":{"label":"建安五年冬十月","year":200,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o081a-q","wudi-q-o071","wudi-q-b-9900125064e5d85f08ad"],"chronology":"wudi-y200","dating_review":{"anchor":"wudi-q-o071","basis":"建安五年冬十月","reviewed":true}},"source_order":[1,438,"O081a"],"order":192},{"id":"xunyu-e-o044b","title":"张郃高览降曹袁绍走","accounts":[{"id":"xunyu-e-o044b-account","label":"《荀彧荀攸贾诩传第十》正文","text":"张郃高览降曹袁绍走","evidence":["xunyu-e-o044b-q"]}],"participants":[{"person":"wudi-p0183","role":"归降","evidence":["xunyu-e-o044b-q"]},{"person":"wudi-p0184","role":"归降","evidence":["xunyu-e-o044b-q"]},{"person":"wudi-p0052","role":"败走","evidence":["xunyu-e-o044b-q"]}],"place":null,"time":{"label":"官渡乌巢之战","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xunyu-e-o044b-q"]},"ordering_evidence":"xunyu-e-o044b-q","source_order":[10,223,"O044b"],"order":2492}],"persons":[{"id":"wudi-p0184","name":"高览","evidence":["wudi-q-o081","zhangle-q-p007","xunyu-q-o044","dongyuan-q-o052"],"facts":[],"aliases":[],"mentions":[{"id":"wudi-m-o081-wudi-p0184","kind":"mention","text":"文中提及","evidence":["wudi-q-o081"]},{"id":"zhangle-m-p007-wudi-p0184","kind":"mention","text":"文中提及","evidence":["zhangle-q-p007"]},{"id":"xunyu-m-o044-wudi-p0184","kind":"mention","text":"文中提及","evidence":["xunyu-q-o044"]},{"id":"dongyuan-m-o052-wudi-p0184","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o052"]}]}],"evidence":[{"id":"dongyuan-e-o052a-q","section":"chapter-006","block":"b-43c272f7e21f12a6ee2b","layer":"original","quote":"太祖还，未至营；绍将高览、张郃等率其众降。绍众大溃。绍与谭，单骑退渡河。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":310,"anchor":null},"note_id":null,"start":0,"end":36},{"id":"dongyuan-q-o052","section":"chapter-006","block":"b-43c272f7e21f12a6ee2b","layer":"original","quote":"太祖还，未至营；绍将高览、张郃等率其众降。绍众大溃。绍与谭，单骑退渡河。余众伪降，尽坑之。﹝四﹞沮授不及绍渡，为人所执；诣太祖，﹝五﹞太祖厚待之。后谋还袁氏，见杀。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":310,"anchor":null},"note_id":null,"start":0,"end":82},{"id":"wudi-e-o081a-q","section":"chapter-001","block":"b-d290b834f75bdba2142b","layer":"original","quote":"绍初闻公之击琼，谓长子谭曰〖7〗：“就彼（攻）〔破〕琼等〖8〗，吾攻拔其营，彼固无所归矣！”乃使张郃、高览攻曹洪〖9〗。郃等闻琼破，遂来降，绍众大溃。绍及谭弃军走，渡河，追之不及。尽收其辎重、图书、珍宝，虏其众。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":437,"anchor":null},"note_id":null,"start":0,"end":106},{"id":"wudi-q-b-9900125064e5d85f08ad","section":"chapter-001","block":"b-9900125064e5d85f08ad","layer":"modern","quote":"〖1〗五年：建安五年（公元 200）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":403,"anchor":null},"note_id":"n-744e4aee7f5ff14cca85","start":0,"end":19},{"id":"wudi-q-o071","section":"chapter-001","block":"b-c9f735ddad48a8f5c2b6","layer":"original","quote":"五年春正月〖1〗，董承等谋泄，皆伏诛。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":400,"anchor":null},"note_id":null,"start":0,"end":19},{"id":"wudi-q-o081","section":"chapter-001","block":"b-d290b834f75bdba2142b","layer":"original","quote":"绍初闻公之击琼，谓长子谭曰〖7〗：“就彼（攻）〔破〕琼等〖8〗，吾攻拔其营，彼固无所归矣！”乃使张郃、高览攻曹洪〖9〗。郃等闻琼破，遂来降，绍众大溃。绍及谭弃军走，渡河，追之不及。尽收其辎重、图书、珍宝，虏其众。﹝二﹞公收绍书中，得许下及军中人书，皆焚之。﹝三﹞冀州诸郡，多举城邑降者。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":437,"anchor":null},"note_id":null,"start":0,"end":143},{"id":"xunyu-e-o044b-q","section":"chapter-010","block":"b-00e277486b15d03f6566","layer":"original","quote":"绍将张郃、高览，烧攻橹降，绍遂弃军走。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":222,"anchor":null},"note_id":null,"start":70,"end":89},{"id":"xunyu-q-o044","section":"chapter-010","block":"b-00e277486b15d03f6566","layer":"original","quote":"会许攸来降，言：“绍遣淳于琼等将万余兵迎运粮，将骄卒惰，可邀击也。”众皆疑，唯攸与贾诩劝太祖。太祖乃留攸及曹洪守，太祖自将攻破之，尽斩琼等。绍将张郃、高览，烧攻橹降，绍遂弃军走。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":222,"anchor":null},"note_id":null,"start":0,"end":89},{"id":"zhangle-q-p007","section":"chapter-017","block":"b-cfe26b6568d95feca7e6","layer":"pei","quote":"﹝二﹞臣松之按《武纪》及《袁绍传》，并云：袁绍使张郃、高览攻太祖营，郃等闻淳于琼破，遂来降，绍众于是大溃。是则缘郃等降，而后绍军坏也。至如此传，为绍军先溃，惧郭图之谮，然后归太祖：为参错不同矣。","attribution":"裴松之按","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":118,"anchor":null},"note_id":"n-35bb4026c88951933765","start":0,"end":97}],"profiles":{},"directory_counts":{}}
