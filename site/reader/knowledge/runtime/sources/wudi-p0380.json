6ba04c7a53d40d7c","mantian-q-d80df8d6201bf670791e","liusima-q-0804408fc2f2a2c04cce","liusima-q-7cd6ab34f901dab204a7","rencheng-q-0e47c84d9b461c6af6a1","rencheng-q-8c7ab4f1f91400195f5b","rencheng-q-3a91043326310f5f4e43","rencheng-q-dcf4617d2d2b4746aa58","rencheng-q-b45b61354b406adfd060","rencheng-q-479da0564d307675282d","rencheng-q-3ccf40502e774809179a","rencheng-q-636357154be9eb1bb450","rencheng-q-bcb6f00ca46ea2abaf7e","rencheng-q-c020cdbf77a824bb1555","rencheng-q-77567bd2af77055502fe","rencheng-q-e3f77ec2cb5f6da806e0","rencheng-q-5336e47142b837778ce5","rencheng-q-809db7336f8d2aff01e4","rencheng-q-c1e3ba937cabfc2d2e9e","rencheng-q-732549a8b81348e4d3ca","wuwen-q-c2f55f326342aebf012b","hechang-q-b27e05f56a5965814db0","wuhuan-q-05d47b5fb0e452554a24","wuhuan-q-e96cf4b24c7d7e801b5a","wuhuan-q-9152fc93c751ab33fe65"],"facts":[{"id":"rencheng-f-ba64c6ada08cb9b7b53e","text":"字子文。","evidence":["rencheng-q-0e47c84d9b461c6af6a1"]},{"id":"wuwen-f-f69a56440b661900e3e1","text":"父为曹操；本传记母为卞皇后。","evidence":["wuwen-q-c2f55f326342aebf012b"]}],"aliases":[{"text":"鄢陵侯彰","evidence":["wuhuan-q-9152fc93c751ab33fe65"]}],"mentions":[{"id":"wudi-m-o190-wudi-p0380","kind":"mention","text":"文中提及","evidence":["wudi-q-o190"]},{"id":"wendi-m-o030-wudi-p0380","kind":"mention","text":"文中提及","evidence":["wendi-q-o030"]},{"id":"wendi-m-o041-wudi-p0380","kind":"mention","text":"文中提及","evidence":["wendi-q-o041"]},{"id":"sunshi-m-o033-wudi-p0380","kind":"mention","text":"文中提及","evidence":["sunshi-q-o033","sunshi-q-b-fdca5de11c2870304290"]},{"id":"xiahoucao-m-o028-wudi-p0380","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-o028"]},{"id":"xiahoucao-m-o074-wudi-p0380","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-o074"]},{"id":"liusima-m2-2e03bb14f14d001da1d2","kind":"mention","text":"文中提及","evidence":["liusima-q-7cd6ab34f901dab204a7"]}]}],"evidence":[{"id":"hechang-q-b27e05f56a5965814db0","section":"chapter-023","block":"b-70b462befe881dec6b24","layer":"original","quote":"后数十日，三单于反问至〖17〗。乃遣鄢陵侯彰为骁骑将军征之〖18〗。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":341,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":123,"end":157,"offset_unit":"unicode_code_point"},{"id":"liusima-q-0804408fc2f2a2c04cce","section":"chapter-015","block":"b-ceeabba7326adc815c60","layer":"original","quote":"时鄢陵侯彰行越骑将军〖4〗，从长安来赴，问逵：“先王玺绶所在？”逵正色曰：“太子在邺，国有储副。先王玺绶，非君侯所宜问也","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":247,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":14,"end":74,"offset_unit":"unicode_code_point"},{"id":"liusima-q-7cd6ab34f901dab204a7","section":"chapter-015","block":"b-93dd085e510c1be2b33d","layer":"pei","quote":"时太子在邺，鄢陵侯未到。士民颇苦劳役，又有疾疠，于是军中骚动。群僚恐天下有变，欲不发丧。逵建议为不可秘；乃发哀，令内外皆入临；临讫，各安叙不得动","attribution":"裴注·魏略","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":255,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-431424450984aebb9adc","start":10,"end":82,"offset_unit":"unicode_code_point"},{"id":"liusima-q-b7e69e3585eae9352e51","section":"chapter-015","block":"b-ceeabba7326adc815c60","layer":"original","quote":"遂奉梓宫还邺","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":247,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":76,"end":82,"offset_unit":"unicode_code_point"},{"id":"mantian-q-59096ba04c7a53d40d7c","section":"chapter-026","block":"b-77b85e9a782ccc2b9d26","layer":"original","quote":"鄢陵侯彰征代郡〖2〗，以豫为相〖3〗","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":132,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":18,"offset_unit":"unicode_code_point"},{"id":"mantian-q-d80df8d6201bf670791e","section":"chapter-026","block":"b-77b85e9a782ccc2b9d26","layer":"original","quote":"军次易北〖4〗，虏伏骑击之。军人扰乱，莫知所为。豫因地形，回车结圆阵〖5〗；弓弩持满于内，疑兵塞其隙。胡不能进，散去。追击，大破之；遂前平代：皆豫策也","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":132,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":19,"end":94,"offset_unit":"unicode_code_point"},{"id":"mingdi-e-o001c-q","section":"chapter-003","block":"b-fe69417d79b76e276a24","layer":"original","quote":"明皇帝讳叡，字元仲。文帝太子也。生而太祖爱之，常令在左右。﹝一﹞年十五，封武德侯。黄初二年为齐公。三年为平原王〖1〗。以其母诛，故未建为嗣。﹝二﹞七年夏五月〖2〗，帝病笃，乃立为皇太子。丁巳〖3〗，即皇帝位。大赦；尊皇太后曰太皇太后〖4〗，皇后曰皇太后〖5〗；诸臣封爵各有差。﹝三﹞〔六月〕，癸未〖6〗，追谥母甄夫人曰文昭皇后〖7〗。壬辰〖8〗，立皇弟蕤为阳平王〖9〗。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":1,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":185,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-0e47c84d9b461c6af6a1","section":"chapter-019","block":"b-6cf9ce0d89ea1d6fa646","layer":"original","quote":"任城威王彰〖1〗，字子文。少善射御，膂力过人，手格猛兽，不避险阻。数从征伐，志意慷慨。太祖尝抑之曰：“汝不念读书慕圣道，而好乘汗马击剑：此一夫之用，何足贵也！”课彰读《诗》、《书》。彰谓左右曰：“丈夫一为卫、霍〖2〗，将十万骑驰沙漠，驱戎狄，立功建号耳！何能做博士邪！”","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":1,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":135,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-3a91043326310f5f4e43","section":"chapter-019","block":"b-0fd4abfd4b629e185b55","layer":"original","quote":"建安二十一年，封鄢陵侯。","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":3,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":12,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-3ccf40502e774809179a","section":"chapter-019","block":"b-e4476272b59c9824c4a2","layer":"original","quote":"时太祖在长安，召彰诣行在所〖9〗。彰自代过邺，太子谓彰曰〖10〗：“卿新有功，今西见上；宜勿自伐〖11〗，应对常若不足者〖12〗。”彰到，如太子言，归功诸将。太祖喜，持彰须曰：“黄须儿，竟大奇也！”","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":4,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":99,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-479da0564d307675282d","section":"chapter-019","block":"b-0fd4abfd4b629e185b55","layer":"original","quote":"长史、诸将皆以为：“新涉远，士马疲顿；又受节度，不得过代：不可深进违令轻敌！”彰曰：“率师而行，唯利所在，何节度乎！胡走未远，追之必破；从令纵敌，非良将也。”遂上马，令军中：“后出者，斩！”一日一夜与虏相及；击，大破之，斩首、获生以千数。彰乃倍常科大赐将士〖8〗，将士无不悦喜。时鲜卑大人轲比能，将数万骑观望强弱；见彰力战，所向皆破，乃请服。北方悉平。","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":3,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":194,"end":370,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-5336e47142b837778ce5","section":"chapter-019","block":"b-3b25314bad4afd3b0d72","layer":"pei","quote":"﹝二﹞《魏略》曰：“太祖在汉中，而刘备栖于山头，使刘封下挑战。太祖骂曰：‘卖履舍儿，长使假子拒汝公乎？待呼我黄须来，令击之！’乃召彰。彰晨夜进道，西到长安；而太祖已还，从汉中而归。彰须黄，故以呼之。”","attribution":"裴注·魏略","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":36,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-3843ab27452efd271684","start":0,"end":100,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-636357154be9eb1bb450","section":"chapter-019","block":"b-e4476272b59c9824c4a2","layer":"original","quote":"太祖东还，以彰行越骑将军〖13〗，留长安。","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":4,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":102,"end":123,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-732549a8b81348e4d3ca","section":"chapter-019","block":"b-23ade84234473b2424ed","layer":"pei","quote":"﹝五﹞《魏氏春秋》曰：“初，彰问玺绶，将有异志；故来朝，不即得见。彰忿怒，暴薨。”","attribution":"裴注·魏氏春秋","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":39,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8e93f1d2e6fb1dcb7be6","start":0,"end":41,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-77567bd2af77055502fe","section":"chapter-019","block":"b-fc65ddc82bffa504d4f1","layer":"original","quote":"三年〖19〗，立为任城王。","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":5,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":133,"end":146,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-809db7336f8d2aff01e4","section":"chapter-019","block":"b-5d1ad35dce551b617bd2","layer":"pei","quote":"﹝三﹞《魏略》曰：“彰至，谓临淄侯植曰：‘先王召我者，欲立汝也。’植曰：‘不可！不见袁氏兄弟乎？’”","attribution":"裴注·魏略","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":37,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-76640922b3bb10b4dfd1","start":0,"end":50,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-8c7ab4f1f91400195f5b","section":"chapter-019","block":"b-6d805395d5e0bc9c1ea2","layer":"original","quote":"太祖尝问诸子所好，使各言其志。彰曰：“好为将。”太祖曰：“为将奈何？”对曰：“被坚执锐〖3〗，临难不顾，为士卒先；赏必行，罚必信。”太祖大笑。","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":2,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":71,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-b45b61354b406adfd060","section":"chapter-019","block":"b-0fd4abfd4b629e185b55","layer":"original","quote":"彰北征，入涿郡界；叛胡数千骑，猝至。时兵马未集，唯有步卒千人，骑数百匹；用田豫计，固守要隙〖5〗，虏乃退散。彰追之，身自搏战，射胡骑，应弦而倒者前后相属。战过半日，彰铠中数箭，意气益厉；乘胜逐北，至于桑干〖6〗，﹝一﹞去代二百余里","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":3,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":75,"end":190,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-bcb6f00ca46ea2abaf7e","section":"chapter-019","block":"b-fc65ddc82bffa504d4f1","layer":"original","quote":"文帝即王位，彰与诸侯就国〖14〗。﹝四﹞诏曰：“先王之道，庸勋亲亲〖15〗，并建母弟〖16〗，开国承家；故能藩屏大宗，御侮厌难〖17〗。彰前受命北伐，清定朔土〖18〗，厥功茂焉。增邑五千，并前万户。”","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":5,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":23,"end":123,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-c020cdbf77a824bb1555","section":"chapter-019","block":"b-fc65ddc82bffa504d4f1","layer":"original","quote":"黄初二年，进爵为公。","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":5,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":123,"end":133,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-c1e3ba937cabfc2d2e9e","section":"chapter-019","block":"b-4ad9d6b87a03c8f2e852","layer":"pei","quote":"﹝四﹞《魏略》曰：“太子嗣立，既葬，遣彰之国。始，彰自以先王见任有功，冀因此遂见授用；而闻当随例，意甚不悦，不待遣而去。时以鄢陵瘠薄，使治中牟。及帝受禅，因封为中牟王。是后大驾幸许昌，北州诸侯上下，皆畏彰之刚严；每过中牟，不敢不速。”","attribution":"裴注·魏略","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":38,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4eb48c89a470c9408e45","start":0,"end":117,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-dcf4617d2d2b4746aa58","section":"chapter-019","block":"b-0fd4abfd4b629e185b55","layer":"original","quote":"二十三年〖4〗，代郡乌丸反，以彰为北中郎将，行骁骑将军。临发，太祖戒彰曰：“居家为父子，受事为君臣；动以王法从事，尔其戒之！”","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":3,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":12,"end":75,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-e3f77ec2cb5f6da806e0","section":"chapter-019","block":"b-fc65ddc82bffa504d4f1","layer":"original","quote":"四年〖20〗，朝京都，疾薨于邸〖21〗。谥曰威。﹝五﹞至葬，赐銮辂、龙旂〖22〗，虎贲百人：如汉东平王故事","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":5,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":146,"end":199,"offset_unit":"unicode_code_point"},{"id":"sunshi-e-o033a-q","section":"chapter-046","block":"b-fe64807ea9dcb47036d8","layer":"original","quote":"是时，袁绍方强〖25〗，而策并江东。曹公力未能逞，且欲抚之：﹝九﹞乃以弟女配策小弟匡，又为子（章）〔彰〕取贲女〖26〗；","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":217,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":60,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-b-fdca5de11c2870304290","section":"chapter-046","block":"b-fdca5de11c2870304290","layer":"modern","quote":"〖26〗彰：即曹彰（？—公元 223）。传见本书卷十九。贲：即孙贲。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":244,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8107c2a0ef694591acff","start":0,"end":34,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-o033","section":"chapter-046","block":"b-fe64807ea9dcb47036d8","layer":"original","quote":"是时，袁绍方强〖25〗，而策并江东。曹公力未能逞，且欲抚之：﹝九﹞乃以弟女配策小弟匡，又为子（章）〔彰〕取贲女〖26〗；皆礼辟策弟权、翊；又命扬州刺吏严象，举权茂才〖27〗。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":217,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":87,"offset_unit":"unicode_code_point"},{"id":"wendi-e-o030a-q","section":"chapter-002","block":"b-08bfc42f1e31260da240","layer":"original","quote":"三月，乙丑〖14〗，立齐公叡，为平原王；帝弟鄢陵公彰等十一人，皆为王。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":283,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":35,"offset_unit":"unicode_code_point"},{"id":"wendi-e-o041a-q","section":"chapter-002","block":"b-ea6bb7501238a3d2181b","layer":"original","quote":"六月，甲戌〖5〗，任城王彰，薨于京都。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":405,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wendi-q-b-94d58550e3abb558ad13","section":"chapter-002","block":"b-94d58550e3abb558ad13","layer":"modern","quote":"〖1〗四年：黄初四年（公元 223）。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":394,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-2950ca88709b8c25fb44","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wendi-q-b-ffbd612d6e6a445d21d8","section":"chapter-002","block":"b-ffbd612d6e6a445d21d8","layer":"modern","quote":"〖1〗三年：黄初三年（公元 222 ）。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":287,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-2c01bc8dd8508fc686e1","start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"wendi-q-o028","section":"chapter-002","block":"b-9204f4c854f659a541df","layer":"original","quote":"三年春正月〖1〗，丙寅朔，日有食之。庚午〖2〗，行幸许昌宫。诏曰：“今之计、（考）〔孝〕〖3〗，古之贡士也。十室之邑，必有忠信。若限年然后取士〖4〗，是吕尚、周晋不显于前世也〖5〗。其令郡国所选，勿拘老幼；儒通经术，吏达文法〖6〗，到，皆试用。有司纠故不以实者〖7〗。”﹝一﹞","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":281,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":138,"offset_unit":"unicode_code_point"},{"id":"wendi-q-o030","section":"chapter-002","block":"b-08bfc42f1e31260da240","layer":"original","quote":"三月，乙丑〖14〗，立齐公叡，为平原王；帝弟鄢陵公彰等十一人，皆为王。初制封王之庶子为乡公〖15〗；嗣王之庶子为亭侯〖16〗；公之庶子为亭伯。甲戌〖17〗，立皇子霖为河东王〖18〗。甲午〖19〗，行幸襄邑。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":283,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":103,"offset_unit":"unicode_code_point"},{"id":"wendi-q-o038","section":"chapter-002","block":"b-62c39b4b73d5f8874468","layer":"original","quote":"四年春正月〖1〗，诏曰：“丧乱以来，兵革未戢〖2〗。天下之人，互相残杀。今海内初定，敢有私复仇者，皆族之〖3〗！”筑南巡台于宛。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":391,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":64,"offset_unit":"unicode_code_point"},{"id":"wendi-q-o041","section":"chapter-002","block":"b-ea6bb7501238a3d2181b","layer":"original","quote":"六月，甲戌〖5〗，任城王彰，薨于京都。甲申〖6〗，太尉贾诩薨。太白昼现〖7〗。是月大雨，伊、洛溢流〖8〗，杀人民，坏庐宅。﹝二﹞","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":405,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":64,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o190a-q","section":"chapter-001","block":"b-5c3f2aa022959a9cbb2b","layer":"original","quote":"夏四月，代郡、上谷乌丸无臣氐等叛〖7〗。遣鄢陵侯彰讨破之〖8〗。﹝三﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":398,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":35,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-ac93ccb47f6e7be3aea4","section":"chapter-001","block":"b-ac93ccb47f6e7be3aea4","layer":"modern","quote":"〖1〗二十三年：建安二十三年（公元 218）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":403,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8cae36984cdc22e48444","start":0,"end":23,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o188","section":"chapter-001","block":"b-1336d4803d0b76311776","layer":"original","quote":"二十三年春正月〖1〗，汉太医令吉本与少府耿纪、司直韦晃等反〖2〗。攻许，烧丞相长史王必营〖3〗。﹝一﹞必与颍川典农中郎将严匡讨斩之〖4〗。﹝二﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":396,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":72,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o190","section":"chapter-001","block":"b-5c3f2aa022959a9cbb2b","layer":"original","quote":"夏四月，代郡、上谷乌丸无臣氐等叛〖7〗。遣鄢陵侯彰讨破之〖8〗。﹝三﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":398,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":35,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-05d47b5fb0e452554a24","section":"chapter-030","block":"b-a1b338a00ad6850092a4","layer":"original","quote":"太祖以鄢陵侯彰为骁骑将军","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":68,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":52,"end":64,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-9152fc93c751ab33fe65","section":"chapter-030","block":"b-a1b338a00ad6850092a4","layer":"original","quote":"建安中，因阎柔上贡献。太祖西征关中，田银反河间，比能将三千余骑随柔击破银。后代郡乌丸反，比能复助为寇害，太祖以鄢陵侯彰为骁骑将军〖15〗，北征，大破之。比能走出塞，后复通贡献。","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":68,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":88,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-e96cf4b24c7d7e801b5a","section":"chapter-030","block":"b-a1b338a00ad6850092a4","layer":"original","quote":"北征，大破之。比能走出塞","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":68,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":69,"end":81,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-c2f55f326342aebf012b","section":"chapter-020","block":"b-87027621c423a4f13bd6","layer":"original","quote":"武皇帝二十五男：卞皇后生文皇帝、任城威王彰、陈思王植、萧怀王熊；刘夫人生丰愍王昂、相殇王铄；环夫人生邓哀王冲、彭城王据、燕王宇；杜夫人生沛穆王林、中山恭王衮；秦夫人生济阳怀王玹、陈留恭王峻；尹夫人生范阳闵王矩；王昭仪生赵王幹；孙姬生临邑殇公子上、楚王彪、刚殇公子勤；李姬生谷城殇公子乘、郿戴公子整、灵殇公子京；周姬生樊安公均；刘姬生广宗殇公子棘；宋姬生东平灵王徽；赵姬生乐陵王茂。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":1,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":190,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o028a-q","section":"chapter-009","block":"b-d330640a0bec61e79724","layer":"original","quote":"鄢陵侯彰北征乌丸〖7〗；文帝在东宫，为书戒彰曰：“为将奉法，不当如征南邪〖8〗？","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":134,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":44,"end":84,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o074b-q","section":"chapter-009","block":"b-46bbebdbffc814a8723d","layer":"original","quote":"代郡胡叛，遣鄢陵侯彰征讨之，以尚参彰军事，定代地。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":389,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":65,"end":90,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-o028","section":"chapter-009","block":"b-d330640a0bec61e79724","layer":"original","quote":"仁少时，不修行检〖3〗。及长为将，严整奉法令〖4〗。常置科于左右〖5〗，案以从事〖6〗。鄢陵侯彰北征乌丸〖7〗；文帝在东宫，为书戒彰曰：“为将奉法，不当如征南邪〖8〗？”","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":134,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":85,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-o074","section":"chapter-009","block":"b-46bbebdbffc814a8723d","layer":"original","quote":"夏侯尚字伯仁。渊从子也。文帝与之亲友。﹝一﹞太祖定冀州，尚为军司马，将骑从征伐。后为五官将文学〖1〗。魏国初建〖2〗，迁黄门侍郎。代郡胡叛，遣鄢陵侯彰征讨之，以尚参彰军事，定代地。还，太祖崩于洛阳，尚持节，奉梓宫还邺〖3〗。并录前功，封平陵亭侯，拜散骑常侍。迁中领军。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":389,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":134,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
