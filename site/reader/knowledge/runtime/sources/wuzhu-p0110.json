er":10414},{"id":"luxun-e-p018c","title":"司马颖任陆机平原相陆云清河内史及右司马","accounts":[{"id":"luxun-e-p018c-account","label":"《机云别传》","text":"陆机陆云自结成都王，获任平原相、清河内史及右司马。","evidence":["luxun-e-p018c-q"]}],"participants":[{"person":"luxun-p0082","role":"任用","evidence":["luxun-e-p018c-q"]},{"person":"luxun-p0076","role":"任官","evidence":["luxun-e-p018c-q"]},{"person":"wuzhu-p0110","role":"任官","evidence":["luxun-e-p018c-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["luxun-e-p018c-q"]},"ordering_evidence":"luxun-e-p018c-q","source_order":[58,455,"P018c"],"order":10415},{"id":"luxun-e-p018d","title":"司马颖攻洛以陆机督军陆云作赋","accounts":[{"id":"luxun-e-p018d-account","label":"《机云别传》","text":"成都王与长沙王构隙攻洛，以陆机督王粹牵秀诸军，陆云作南征赋。","evidence":["luxun-e-p018d-q"]}],"participants":[{"person":"luxun-p0082","role":"举兵","evidence":["luxun-e-p018d-q"]},{"person":"luxun-p0076","role":"督军","evidence":["luxun-e-p018d-q"]},{"person":"luxun-p0084","role":"领军","evidence":["luxun-e-p018d-q"]},{"person":"luxun-p0085","role":"领军","evidence":["luxun-e-p018d-q"]},{"person":"wuzhu-p0110","role":"作赋","evidence":["luxun-e-p018d-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["luxun-e-p018d-q"]},"ordering_evidence":"luxun-e-p018d-q","source_order":[58,455,"P018d"],"order":10416},{"id":"luxun-e-p018f","title":"陆云数言孟玖之短司马颖不纳孟玖谮毁","accounts":[{"id":"luxun-e-p018f-account","label":"《机云别传》","text":"陆云数言孟玖之短，司马颖不纳，孟玖毁陆云。","evidence":["luxun-e-p018f-q"]}],"participants":[{"person":"wuzhu-p0110","role":"进言","evidence":["luxun-e-p018f-q"]},{"person":"luxun-p0082","role":"不纳","evidence":["luxun-e-p018f-q"]},{"person":"luxun-p0086","role":"谮毁","evidence":["luxun-e-p018f-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["luxun-e-p018f-q"]},"ordering_evidence":"luxun-e-p018f-q","source_order":[58,455,"P018f"],"order":10418},{"id":"luxun-e-p018h","title":"牵