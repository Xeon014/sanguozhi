hi-p0081","role":"备船","evidence":["sunshi-e-p049d-q"]}],"place":null,"time":{"label":"高岱受孙策召前后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["sunshi-e-p049d-q"]},"ordering_evidence":"sunshi-e-p049d-q","source_order":[46,278,"P049d"],"order":8133},{"id":"sunshi-e-p054b","title":"许贡上表请召孙策孙策得表责而绞杀许贡","accounts":[{"id":"sunshi-e-p054b-account","label":"《江表传》","text":"许贡上表请召孙策孙策得表责而绞杀许贡","evidence":["sunshi-e-p054b-q"]},{"id":"sunshi-e-o035a-account","label":"《孙破虏讨逆传第一》正文","text":"孙策先杀许贡","evidence":["sunshi-e-o035a-q"]}],"participants":[{"person":"sunshi-p0036","role":"上表遇害","evidence":["sunshi-e-p054b-q"]},{"person":"wudi-p0099","role":"杀人","evidence":["sunshi-e-p054b-q"]}],"place":null,"time":{"label":"孙策西征及归军时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["sunshi-e-p054b-q"]},"ordering_evidence":"sunshi-e-p054b-q","source_order":[46,283,"P054b"],"order":8141},{"id":"zhulv-e-o013","title":"治从钱唐欲进到吴，吴郡太守许贡拒之于由拳；治与战，大破之；贡南就山贼严白虎","accounts":[{"id":"zhulv-a-8b72e6e68ce85d9fde5f","label":"正文","text":"治从钱唐欲进到吴，吴郡太守许贡拒之于由拳；治与战，大破之；贡南就山贼严白虎","evidence":["zhulv-q-b2ec842802a6d073330c"]}],"participants":[{"person":"sunshi-p0052","role":"进兵而破贡者","evidence":["zhulv-q-b2ec842802a6d073330c"]},{"person":"sunshi-p0036","role":"拒战被破者","evidence":["zhulv-q-b2ec842802a6d073330c"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["zhulv-q-b2ec842802a6d073330c"]},"ordering_evidence":"zhulv-q-b2ec842802a6d073330c","source_order":[56,6,0],"order":9956}],"persons":[{"id":"sunshi-p0036","name":"许贡","evidence":["sunshi-q-p026","xumisun-q-f9f787c4651eccae8a27","zhulv-q-b2ec842802a6d073330c"],"facts":[],"aliases":[],"mentions":[{"id":"sunshi-m-p026-sunshi-p0036","kind":"mention","text":"文中提及","evidence":["sunshi-q-p026"]},{"id":"sunshi-m-o035-sunshi-p0036","kind":"mention","text":"文中提及","evidence":["sunshi-q-o035"]},{"id":"sunshi-m-p049-sunshi-p0036","kind":"mention","text":"文中提及","evidence":["sunshi-q-p049"]},{"id":"sunshi-m-p054-sunshi-p0036","kind":"mention","text":"文中提及","evidence":["sunshi-q-p054"]},{"id":"sunshi-m-p057-sunshi-p0036","kind":"allusion","text":"祖系或典故提及","evidence":["sunshi-q-p057"]}]}],"evidence":[{"id":"sunshi-e-o035a-q","section":"chapter-046","block":"b-18e349ce1607f40f98f6","layer":"original","quote":"先是，策杀贡；","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":261,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":7,"offset_unit":"unicode_code_point"},{"id":"sunshi-e-p026b-q","section":"chapter-046","block":"b-aca9f0afeaaa1ed9fd6e","layer":"pei","quote":"后与坚争豫州，屡战失利。会次兄九江太守昂，为袁术所攻。㬂往助之，军败；还乡里，为许贡所害。","attribution":"《会稽典录》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":170,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-094b7d654dbb413a3f27","start":44,"end":89,"offset_unit":"unicode_code_point"},{"id":"sunshi-e-p049d-q","section":"chapter-046","block":"b-96d4b25d5c0244aea4a1","layer":"pei","quote":"岱得谦书以还，而贡已囚其母。吴人大小，皆为危竦；以贡宿忿，往必见害。岱言：‘在君则为君；且母在牢狱，期于当往；若得入见，事自当解。’遂通书自白，贡即与相见。才辞敏捷，好自陈谢，贡登时出其母。岱将见贡，语友人张允、沈3 ，令预具船。以贡必悔，当追逐之；出便将母乘船，易道而逃。贡须臾遣人追之，令追者：‘若及于船，江上便杀之！已过则止。’使与岱错道，遂免。","attribution":"《吴录》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":277,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9299c159b0512c392271","start":326,"end":502,"offset_unit":"unicode_code_point"},{"id":"sunshi-e-p054b-q","section":"chapter-046","block":"b-430edbfbd26777ab1c88","layer":"pei","quote":"初，吴郡太守许贡，上表于汉帝曰：‘孙策骁雄，与项籍相似；宜加贵宠，召还京邑。若被诏，不得不还；若放于外，必作世患！’策候吏得贡表，以示策。策请贡相见，以责让贡。贡辞无表，策即令武士绞杀之。","attribution":"《江表传》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":282,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-26c0935904b6bc636b31","start":114,"end":208,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-o035","section":"chapter-046","block":"b-18e349ce1607f40f98f6","layer":"original","quote":"先是，策杀贡；贡小子与客，亡匿江边。策单骑出，猝与客遇。客击伤策，﹝二﹞创甚〖5〗。请张昭等谓曰：“中国方乱〖6〗；夫以吴、越之众〖7〗，三江之固〖8〗，足以观成败。公等善相吾弟〖9〗！”呼权，佩以印绶，谓曰：“举江东之众，决机于两阵之间〖10〗，与天下争衡，卿不如我；举贤任能，各尽其心，以保江东，我不如卿。”至夜卒，时年二十六。﹝三﹞","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":261,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":169,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-p026","section":"chapter-046","block":"b-aca9f0afeaaa1ed9fd6e","layer":"pei","quote":"《会稽典录》曰：“初，曹公兴义兵，遣人要㬂；㬂即收合兵众，得二千人；从公征伐，以为军师。后与坚争豫州，屡战失利。会次兄九江太守昂，为袁术所攻。㬂往助之，军败；还乡里，为许贡所害。”","attribution":"《会稽典录》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":170,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-094b7d654dbb413a3f27","start":0,"end":90,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-p049","section":"chapter-046","block":"b-96d4b25d5c0244aea4a1","layer":"pei","quote":"﹝一﹞《吴录》曰：“时有高岱者，隐于余姚。策命出，使会稽丞陆昭逆之，策虚己候焉。闻其善《左传》，乃自玩读，欲与论讲。或谓之曰：‘高岱以将军但英武而已，无文学之才；若与论《传》而或云不知者，则某言符矣。’又谓岱曰：‘孙将军为人，恶胜己者；若每问，当言不知，乃合意耳；如皆辨义，此必危殆！’岱以为然，及与论《传》，或答不知。策果怒，以为轻己，乃囚之。知交及时人，皆露坐为请。策登楼，望见数里中填满。策恶其收众心，遂杀之。岱字孔文。吴郡人也。受性聪达，轻财贵义。其友士拔奇，取于未显；所友八人，皆世之英伟也。太守盛宪以为上计，举孝廉。许贡来领郡，岱将宪避难于许昭家，求救于陶谦。谦未即救，岱憔悴泣血，水浆不入口。谦感其忠壮，有申包胥之义；许为出军，以书与贡。岱得谦书以还，而贡已囚其母。吴人大小，皆为危竦；以贡宿忿，往必见害。岱言：‘在君则为君；且母在牢狱，期于当往；若得入见，事自当解。’遂通书自白，贡即与相见。才辞敏捷，好自陈谢，贡登时出其母。岱将见贡，语友人张允、沈3 ，令预具船。以贡必悔，当追逐之；出便将母乘船，易道而逃。贡须臾遣人追之，令追者：‘若及于船，江上便杀之！已过则止。’使与岱错道，遂免。被诛时，年三十余。”","attribution":"《吴录》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":277,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9299c159b0512c392271","start":0,"end":512,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-p054","section":"chapter-046","block":"b-430edbfbd26777ab1c88","layer":"pei","quote":"﹝二﹞《江表传》曰：“广陵太守陈登，治射阳；登，即瑀之从兄子也。策前西征，登阴复遣间使，以印绶与严白虎余党，图为后害，以报瑀见破之辱。策归，复讨登。军到丹徒，须待运粮。策性好猎，将步骑数出。策驱驰逐鹿，所乘马精骏，从骑绝不能及。初，吴郡太守许贡，上表于汉帝曰：‘孙策骁雄，与项籍相似；宜加贵宠，召还京邑。若被诏，不得不还；若放于外，必作世患！’策候吏得贡表，以示策。策请贡相见，以责让贡。贡辞无表，策即令武士绞杀之。贡奴客潜民间，欲为贡报仇。猎日，猝有三人，即贡客也。策问：‘尔等何人？’答云：‘是韩当兵，在此射鹿耳。’策曰：‘当兵，吾皆识之，未尝见汝等！’因射一人，应弦而倒。余二人怖急，便举弓射策，中颊。后骑寻至，皆刺杀之。”","attribution":"《江表传》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":282,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-26c0935904b6bc636b31","start":0,"end":315,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-p057","section":"chapter-046","block":"b-0bd05c5ba15e2fa499c7","layer":"pei","quote":"臣松之按：《傅子》亦云曹公征柳城，将袭许。记述若斯，何其疏哉！然孙盛所讥，未为悉是。黄祖始被策破，魂气未反；但刘表君臣，本无兼并之志，虽在上流，何办规拟吴、会？策之此举，理应先图陈登；但举兵所在，不止登而已。于时强宗骁帅，祖郎、严虎之徒，擒灭已尽；所余山越，盖何足虑？然则策之所规，未可谓之不暇也。若使策志获从，大权在手；淮、泗之间，所在皆可都；何必毕志江外，其当迁帝于扬、越哉！按《魏武纪》，武帝以建安四年已出屯官渡，乃策未死之前，久与袁绍交兵，则《国志》所云不为谬也。许贡客，无闻之小人；而能感识恩遇，临义忘生，猝然奋发，有侔古烈矣。《诗》云：“君子有徽猷，小人与属。”贡客其有焉。","attribution":"裴松之按语","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":285,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-26c0935904b6bc636b31","start":0,"end":293,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-f9f787c4651eccae8a27","section":"chapter-038","block":"b-3048dcb770e0662f6cb2","layer":"original","quote":"祎死，吴郡（都尉）〔太守〕许贡、会稽太守王朗素与靖有旧〖22〗，故往保焉","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":4,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":36,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-b2ec842802a6d073330c","section":"chapter-056","block":"b-6e29ea033fd039ec581b","layer":"original","quote":"治从钱唐欲进到吴〖11〗，吴郡太守许贡拒之于由拳。治与战，大破之。贡南就山贼严白虎","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":5,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":41,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
