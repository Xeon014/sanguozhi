-p0368","role":"率偏军入武都而没不还","evidence":["duzhou-q2-c32b1f1313d012f88537"]},{"person":"xianzhu-p0068","role":"率偏军入武都而没不还","evidence":["duzhou-q2-c32b1f1313d012f88537"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"第二轮逐项审定；仅保原文时序，不另行推年。","evidence":["duzhou-q2-c32b1f1313d012f88537"]},"ordering_evidence":"duzhou-q2-c32b1f1313d012f88537","order":7478}],"persons":[{"id":"xianzhu-p0068","name":"雷铜","evidence":["xianzhu-q-o047","duzhou-q-2784cb73507b6d18fece","duzhou-q2-c32b1f1313d012f88537"],"facts":[],"aliases":[],"mentions":[{"id":"xianzhu-m-o047-xianzhu-p0068","kind":"mention","text":"文中提及","evidence":["xianzhu-q-o047"]}]}],"evidence":[{"id":"duzhou-q-2784cb73507b6d18fece","section":"chapter-042","block":"b-7a053fe7d388236a173e","layer":"original","quote":"遣将军吴兰、雷铜等入武都，皆没不还","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":34,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":63,"end":80,"offset_unit":"unicode_code_point"},{"id":"duzhou-q2-c32b1f1313d012f88537","section":"chapter-042","block":"b-7a053fe7d388236a173e","layer":"original","quote":"时州后部司马蜀郡张裕，亦晓占候〖8〗，而天才过群；﹝二﹞谏先主曰：“不可争汉中，军必不利！”先主竟不用裕言，果得地而不得民也。遣将军吴兰、雷铜等入武都，皆没不还：悉如群言。于是举群茂才。","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":34,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":93,"offset_unit":"unicode_code_point"},{"id":"liusima-q-89f74de11fac53f9e2e9","section":"chapter-015","block":"b-c2d5a8344f52b1d128d0","layer":"original","quote":"其后与曹洪破吴兰于下辩","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":139,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":88,"end":99,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o189a-q","section":"chapter-001","block":"b-48c05f2ce20929618c3d","layer":"original","quote":"曹洪破吴兰，斩其将任夔等。三月，张飞、马超走汉中。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":397,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":25,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-ac93ccb47f6e7be3aea4","section":"chapter-001","block":"b-ac93ccb47f6e7be3aea4","layer":"modern","quote":"〖1〗二十三年：建安二十三年（公元 218）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":403,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8cae36984cdc22e48444","start":0,"end":23,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o188","section":"chapter-001","block":"b-1336d4803d0b76311776","layer":"original","quote":"二十三年春正月〖1〗，汉太医令吉本与少府耿纪、司直韦晃等反〖2〗。攻许，烧丞相长史王必营〖3〗。﹝一﹞必与颍川典农中郎将严匡讨斩之〖4〗。﹝二﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":396,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":72,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o042b-q","section":"chapter-009","block":"b-3a2ab390101b81a15491","layer":"original","quote":"备遣张飞屯固山〖3〗，欲断军后。众议狐疑，休曰：“贼实断道者〖4〗，当伏兵潜行；今乃先张声势，此其不能也。宜及其未集，促击兰；兰破，则飞自走矣。”洪从之，进兵击兰，大破之，飞果走。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":189,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":59,"end":149,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o047a-q","section":"chapter-032","block":"b-44db547f089e12d33623","layer":"original","quote":"二十三年〖10〗，先主率诸将进兵汉中。分遣将军吴兰、雷铜等入武都；皆为曹公军所没。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":202,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":41,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o047","section":"chapter-032","block":"b-44db547f089e12d33623","layer":"original","quote":"二十三年〖10〗，先主率诸将进兵汉中。分遣将军吴兰、雷铜等入武都；皆为曹公军所没。先主次于阳平关，与渊、郃等相拒。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":202,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":57,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
