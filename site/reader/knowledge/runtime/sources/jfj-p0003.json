{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dengzhang-e-o084","title":"刘邕随刘备入蜀","accounts":[{"id":"dengzhang-a-6ac6a641f0df97346eb6","label":"正文","text":"刘邕随刘备入蜀","evidence":["dengzhang-q-7fd2079f7b65d51f167f"]}],"participants":[{"person":"jfj-p0003","role":"随先主入蜀","evidence":["dengzhang-q-7fd2079f7b65d51f167f"]},{"person":"liu-bei","role":"入蜀，刘邕随行","evidence":["dengzhang-q-7fd2079f7b65d51f167f"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["dengzhang-q-7fd2079f7b65d51f167f"]},"ordering_evidence":"dengzhang-q-7fd2079f7b65d51f167f","source_order":[45,269,11],"order":7955}],"persons":[{"id":"jfj-p0003","name":"刘邕","evidence":["jfj-q0042","dengzhang-q-7fd2079f7b65d51f167f","dengzhang-q2-0633cd8146b77491007d"],"facts":[{"id":"dengzhang-f2-06fcf97b0211479b129c","text":"刘邕在益州既定后为江阳太守，建兴中稍迁监军、后将军，赐关内侯；卒后子式嗣。","evidence":["dengzhang-q2-0633cd8146b77491007d"]}],"aliases":[],"mentions":[{"id":"jfj-m-o005-jfj-p0003","kind":"mention","text":"本段人物记载：刘邕","evidence":["jfj-q0042"]}]}],"evidence":[{"id":"dengzhang-q-7fd2079f7b65d51f167f","section":"chapter-045","block":"b-34dce2813758cdad4b52","layer":"original","quote":"随先主入蜀","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":268,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":11,"end":16,"offset_unit":"unicode_code_point"},{"id":"dengzhang-q2-0633cd8146b77491007d","section":"chapter-045","block":"b-34dce2813758cdad4b52","layer":"original","quote":"益州既定，为江阳太守。建兴中，稍迁至监军，后将军，赐爵关内侯。卒，子式嗣。","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":268,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":17,"end":54,"offset_unit":"unicode_code_point"},{"id":"jfj-q0042","section":"chapter-044","block":"b-cdd5bc4f6ea240d4f01e","layer":"original","quote":"建兴元年，丞相亮开府，辟琬为东曹掾。举茂才〖1〗，琬固让刘邕、阴化、庞延、廖淳。亮教答曰：“思惟背亲舍德〖2〗，以腆百姓〖3〗；众人既不隐于心〖4〗，实又使远近不解其义；是以君宜显其功举〖5〗，以明此选之清重也〖6〗。”迁为参军。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":14,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":115,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
