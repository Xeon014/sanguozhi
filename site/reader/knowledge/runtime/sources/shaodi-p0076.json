行换算。"},"chronology":"santizhu064-y255"},"ordering_evidence":"santizhu064-q-20d87b32e3639cb4e23a","source_order":[64,391,0],"related_events":[{"event":"shaodi-e-o073a","type":"related","evidence":["santizhu064-q-20d87b32e3639cb4e23a","shaodi-e-o073a-q"]},{"event":"santizhu-e-sr-lejia-campaign","type":"related","evidence":["santizhu064-q-20d87b32e3639cb4e23a","santizhu-q-dd4508cca788282ba550"]},{"event":"chenghuang-e-o155","type":"related","evidence":["chenghuang-q-4d5638cb7d8311cc5354","santizhu064-q-20d87b32e3639cb4e23a"]}],"order":10996},{"id":"santizhu064-e-sr-liuzan-early","title":"《吴书》留赞早年斩吴桓、自割足筋、凌统表荐","accounts":[{"id":"santizhu064-a-53c168a85dd8a744c070","label":"裴注·吴书","text":"赞少为郡吏与黄巾帅吴桓战手斩得桓，一足被创屈不伸；欲割引其足，以刀自割其筋，足申创愈得蹉步；凌统闻之请见奇之，表荐被试用，累迁屯骑校尉；每常规谏好直言权以此惮之","evidence":["santizhu064-q-5049b4d06bc397b993c8"]}],"participants":[{"person":"shaodi-p0076","role":"斩吴桓、自割足筋、被凌统表荐","evidence":["santizhu064-q-5049b4d06bc397b993c8"]},{"person":"ling-tong","role":"表荐留赞","evidence":["santizhu064-q-5049b4d06bc397b993c8"]},{"person":"santizhu-p0202","role":"被留赞斩（黄巾贼帅）","evidence":["santizhu064-q-5049b4d06bc397b993c8"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"未由相邻段落推算纪年；原文时间表达保留在来源引句中。","evidence":["santizhu064-q-5049b4d06bc397b993c8"]},"ordering_evidence":"santizhu064-q-5049b4d06bc397b993c8","source_order":[64,415,0],"order":11002},{"id":"santizhu064-e-p022a","title":"东兴战留赞为前部陷阵","accounts":[{"id":"santizhu064-a-94d6100020938a946e64","label":"裴注·吴书","text":"东兴战留赞为前部陷阵","evidence":["santizhu064-q-f8f97c6c6617f309f670"]}],"participants":[{"person":"shaodi-p0041","role":"征东兴","evidence":["santizhu064-q-f8f97c6c6617f309f670"]},{"person":"shaodi-p0076","role":"任前部、交战先陷阵，后迁左将军","evidence":["santizhu064-q-f8f97c6c6617f309f670"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"未由相邻段落推算纪年；原文时间表达保留在来源引句中。","evidence":["santizhu064-q-f8f97c6c6617f309f670"]},"ordering_evidence":"santizhu064-q-f8f97c6c6617f309f670","source_order":[64,22,270],"order":11003},{"id":"santizhu064-e-sr-liuzan-death-wushu","title":"《吴书》留赞之死：蒋班追击、赞付印弟子被害","accounts":[{"id":"santizhu064-a-8d18ba03de1fa97ddc35","label":"裴注·吴书","text":"孙峻征淮南授赞节拜左护军；未至寿春道病，峻令赞将车重先还；魏将蒋班以步骑四千追赞，赞病困不能整阵，解曲盖印绶付弟子；临敌被发叫天抗音而歌毕乃进战；及败叹曰吾战有常术今病困若此固命也，遂被害，时年七十三；二子略、平并为大将","evidence":["santizhu064-q-51aceda50efd02b54ab2"]}],"participants":[{"person":"shaodi-p0076","role":"授节左护军、病中还师、解印付弟子、被害","evidence":["santizhu064-q-51aceda50efd02b54ab2"]},{"person":"shaodi-p0075","role":"征淮南授赞节、令赞将车重先还","evidence":["santizhu064-q-51aceda50efd02b54ab2"]},{"person":"wgc-p0019","role":"以步骑四千追留赞（wgc-p0019）","evidence":["santizhu064-q-51aceda50efd02b54ab2"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"未由相邻段落推算纪年；原文时间表达保留在来源引句中。","evidence":["santizhu064-q-51aceda50efd02b54ab2"]},"ordering_evidence":"santizhu064-q-51aceda50efd02b54ab2","source_order":[64,415,0],"related_events":[{"event":"shaodi-e-o073a","type":"alternative","evidence":["santizhu064-q-51aceda50efd02b54ab2","shaodi-e-o073a-q"]},{"event":"santizhu-e-sr-liuzan-death","type":"alternative","evidence":["santizhu064-q-51aceda50efd02b54ab2","santizhu-q-9b248481834fb33d577b"]}],"order":11004}],"persons":[{"id":"shaodi-p0076","name":"留赞","evidence":["shaodi-q-o073","wgc-q0024","santizhu-q-5197ab7b145c362567a8","santizhu-q-b2b3977b84b3b8706bb3","santizhu064-q-f8f97c6c6617f309f670","santizhu064-q-20d87b32e3639cb4e23a","chenghuang-q-43b7eb41151cc3920037"],"facts":[],"aliases":[],"mentions":[{"id":"shaodi-m-o073-shaodi-p0076","kind":"mention","text":"文中提及","evidence":["shaodi-q-o073"]},{"id":"wgc-m-o030-shaodi-p0076","kind":"mention","text":"本段涉及留赞","evidence":["wgc-q0024"]}]}],"evidence":[{"id":"chenghuang-q-1da7562bc4ca7ae07bed","section":"chapter-055","block":"b-f6550e25d92fd67b6b52","layer":"original","quote":"天寒，雪，敌诸将置酒高会。奉见其前部兵少，相谓曰：“取封侯爵赏，正在今日！”乃使兵解铠著胄，持短兵〖7〗。敌人从而笑焉，不为设备。奉纵兵斫之，大破敌前屯；会据等至，魏军遂溃。迁灭寇将军〖8〗，进封都（亭）〔乡〕侯","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":356,"anchor":null},"note_id":null,"start":0,"end":106},{"id":"chenghuang-q-43b7eb41151cc3920037","section":"chapter-055","block":"b-876b9e224f245867d86d","layer":"original","quote":"及恪上岸，奉与将军唐咨、吕据、留赞等，俱从山西上。奉曰：“今诸军行迟；若敌据便地〖4〗，则难与争锋矣！”乃辟诸军，使下道〖5〗；帅麾下三千人，径进。时北风，奉举帆二日至，遂据徐塘","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":355,"anchor":null},"note_id":null,"start":112,"end":201},{"id":"chenghuang-q-4d5638cb7d8311cc5354","section":"chapter-055","block":"b-b287d0c141ab344f0274","layer":"original","quote":"魏将文钦来降，以奉为虎威将军，从孙峻至寿春迎之〖9〗。与敌追军战于高亭，奉跨马持矛，突入其阵中；斩首数百，获其军器。进封安丰侯","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":357,"anchor":null},"note_id":null,"start":0,"end":63},{"id":"chenghuang-q-6a6c8553c5614eb1ca01","section":"chapter-055","block":"b-87fe2456927ad072130b","layer":"original","quote":"东兴之役〖15〗，综为前锋，军败身死。诸葛恪斩送其首，以白权庙","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":59,"anchor":null},"note_id":null,"start":26,"end":57},{"id":"hequan-q-ae4ded7244b535b59ef0","section":"chapter-060","block":"b-6c5f593279f7e62e0019","layer":"pei","quote":"东关之役，绪与丁奉，建议引兵先出；以破魏军，封一子亭侯","attribution":"裴注·《吴书》","section_title":"贺全吕周钟离传第十五","source":{"file":"OEBPS/Text/titlepage_0127.xhtml","index":159,"anchor":null},"note_id":"n-745969b04e6140fa105c","start":49,"end":76},{"id":"santizhu-q-5197ab7b145c362567a8","section":"chapter-048","block":"b-d33ac4d7966626cd5c5b","layer":"original","quote":"闰月壬辰〖4〗，峻及骠骑将军吕据、左将军留赞，率兵袭寿春〖5〗；军及东兴，闻钦等败","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":53,"anchor":null},"note_id":null,"start":44,"end":85},{"id":"santizhu-q-8812753a9ed1bf501f17","section":"chapter-048","block":"b-9b3f5181b40c2019f20c","layer":"original","quote":"甲寅〖11〗，恪以大兵赴敌。戊午〖12〗，兵及东兴，交战；大破魏军，杀将军韩综、桓嘉等","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":14,"anchor":null},"note_id":null,"start":102,"end":145},{"id":"santizhu-q-9b248481834fb33d577b","section":"chapter-048","block":"b-d33ac4d7966626cd5c5b","layer":"original","quote":"留赞为诞别将蒋班所败于菰陂〖9〗，赞及将军孙楞、蒋修等，皆遇害。","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":53,"anchor":null},"note_id":null,"start":153,"end":185},{"id":"santizhu-q-b2b3977b84b3b8706bb3","section":"chapter-048","block":"b-d33ac4d7966626cd5c5b","layer":"original","quote":"留赞为诞别将蒋班所败于菰陂〖9〗，赞及将军孙楞、蒋修等，皆遇害","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":53,"anchor":null},"note_id":null,"start":153,"end":184},{"id":"santizhu-q-dd4508cca788282ba550","section":"chapter-048","block":"b-d33ac4d7966626cd5c5b","layer":"original","quote":"二年春正月〖1〗，魏镇东大将军毌丘俭、前将军文钦，以淮南之众西入〖2〗，战于乐嘉〖3〗。","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":53,"anchor":null},"note_id":null,"start":0,"end":44},{"id":"santizhu064-q-155c121d1b344531cadb","section":"chapter-064","block":"b-76cb3429cd16dda88c09","layer":"modern","quote":"〖9〗二年：五凤二年（公元 255）。","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":404,"anchor":null},"note_id":"n-c74c07c3ecd7068db28a","start":0,"end":19},{"id":"santizhu064-q-20d87b32e3639cb4e23a","section":"chapter-064","block":"b-c440da85565fe532313d","layer":"original","quote":"二年〖9〗，魏将毌丘俭、文钦以众叛，与魏人战于乐嘉〖10〗。峻帅骠骑将军吕据、左将军留赞袭寿春；会钦败降，军还","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":390,"anchor":null},"note_id":null,"start":0,"end":55},{"id":"santizhu064-q-5049b4d06bc397b993c8","section":"chapter-064","block":"b-d6d1b5c9cae4cad8e15d","layer":"pei","quote":"留赞字正明，会稽长山人。少为郡吏，与黄巾贼帅吴桓战，手斩得桓；赞一足被创，遂屈不伸。然性烈，好读兵书及‘三史’，每览古良将战攻之势，辄对书独叹。因呼诸近亲谓曰：‘今天下扰乱，英豪并起。历观前世，富贵非有常人；而我屈躄在闾巷之间，存亡无以异。今欲割引吾足，幸不死而足申，几复见用；死，则已矣！’亲戚皆难之。有间，赞乃以刀自割其筋；血流滂沱，气绝良久。家人惊怖，亦以既尔，遂引申其足。足申创愈，以得蹉步。凌统闻之，请与相见，甚奇之。乃表荐赞，遂被试用。累有战功，稍迁屯骑校尉。时事得失，每常规谏，好直言，不阿旨，权以此惮之。","attribution":"裴注·吴书","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":414,"anchor":null},"note_id":"n-9d9f10434c65e6735646","start":10,"end":270},{"id":"santizhu064-q-51aceda50efd02b54ab2","section":"chapter-064","block":"b-d6d1b5c9cae4cad8e15d","layer":"pei","quote":"孙峻征淮南，授赞节，拜左护军。未至寿春，道路病发，峻令赞将车重先还。魏将蒋班，以步骑四千追赞。赞病困，不能整阵；知必败，乃解曲盖、印绶，付弟子以归，曰：‘吾自为将，破敌搴旗，未尝负败。今病困兵羸，众寡不敌；汝速去矣，俱死无益于国，适所以快敌耳。’弟子不肯受，拔刀欲斫之，乃去。初，赞为将，临敌必先被发叫天，因抗音而歌，左右应之；毕，乃进战，战无不克。及败，叹曰：‘吾战有常术，今病困若此，固命也！’遂被害，时年七十三。众庶痛惜焉。二子：略、平，并为大将。”","attribution":"裴注·吴书","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":414,"anchor":null},"note_id":"n-9d9f10434c65e6735646","start":299,"end":527},{"id":"santizhu064-q-c0aaa14c0306cbe5684d","section":"chapter-064","block":"b-d3196146b5b40af27868","layer":"original","quote":"恪兴军四万，晨夜赴救。遵等敕其诸军：作浮桥渡，阵于堤上〖6〗，分兵攻两城。城在高峻，不可猝拔。恪遣将军留赞、吕据、唐咨、丁奉为前部。时天寒，雪，魏诸将会饮。见赞等兵少，而解置铠甲，不持矛戟；但兜鍪刀盾〖7〗，裸身缘遏〖8〗：大笑之，不即严兵〖9〗。兵得上，便鼓噪乱斫〖10〗。魏军惊扰散走，争渡浮桥；桥坏绝，自投于水，更相蹈藉。乐安太守桓嘉等，同时并没〖11〗，死者数万。故叛将韩综为魏前军督〖12〗，亦斩之。获车乘牛、马、驴、骡各数千，资器山积，振旅而归〖13〗。","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":164,"anchor":null},"note_id":null,"start":0,"end":233},{"id":"santizhu064-q-f8f97c6c6617f309f670","section":"chapter-064","block":"b-d6d1b5c9cae4cad8e15d","layer":"pei","quote":"诸葛恪征东兴，赞为前部；合战，先陷阵，大败魏师。迁左将军","attribution":"裴注·吴书","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":414,"anchor":null},"note_id":"n-9d9f10434c65e6735646","start":270,"end":298},{"id":"shaodi-e-o073a-q","section":"chapter-004","block":"b-edb853525f526ca4c6d7","layer":"original","quote":"甲子〖18〗，吴大将孙峻等众号十万〖19〗，至寿春；诸葛诞拒击破之，斩吴左将军留赞〖20〗，献捷于京都。三月，立皇后卞氏〖21〗，大赦。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":333,"anchor":null},"note_id":null,"start":0,"end":68},{"id":"shaodi-q-b-2de9ea37d1e15a7d296f","section":"chapter-004","block":"b-2de9ea37d1e15a7d296f","layer":"modern","quote":"〖6〗二年：正元二年（公元 255）。乙丑：旧历十二日。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":346,"anchor":null},"note_id":"n-96103ace1e11ae4131ba","start":0,"end":28},{"id":"shaodi-q-o072","section":"chapter-004","block":"b-4b9070779d1c209c6814","layer":"original","quote":"二年春正月，乙丑〖6〗，镇东将军毌丘俭、扬州刺史文钦反。（戊戌）〔戊寅〕〖7〗，大将军司马景王征之。癸未〖8〗，车骑将军郭淮薨。闰月，己亥〖9〗，破钦于乐嘉〖10〗；钦遁走，遂奔吴。甲辰〖11〗，安风淮津都尉斩俭〖12〗，传首京都。﹝一﹞壬子〖13〗，复特赦淮南士民诸为俭、钦所诖误者〖14〗。以镇南将军诸葛诞为镇东大将军〖15〗。司马景王薨于许昌。二月，丁巳〖16〗，以卫将军司马文王为大将军〖17〗，录尚书事。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":332,"anchor":null},"note_id":null,"start":0,"end":207},{"id":"shaodi-q-o073","section":"chapter-004","block":"b-edb853525f526ca4c6d7","layer":"original","quote":"甲子〖18〗，吴大将孙峻等众号十万〖19〗，至寿春；诸葛诞拒击破之，斩吴左将军留赞〖20〗，献捷于京都。三月，立皇后卞氏〖21〗，大赦。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":333,"anchor":null},"note_id":null,"start":0,"end":68},{"id":"wgc-q0024","section":"chapter-028","block":"b-b65f0eafd40a24300f7f","layer":"original","quote":"吴大将孙峻、吕据、留赞等闻淮南乱〖10〗，会文钦往，乃帅众将钦径至寿春。时诞诸军已至，城不可攻，乃走。诞遣将军蒋班追击之，斩赞；传首，收其印、节。进封高平侯，邑三千五百户；转为征东大将军。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":153,"anchor":null},"note_id":null,"start":0,"end":94},{"id":"wgc-q0263","section":"chapter-028","block":"b-b65f0eafd40a24300f7f","layer":"original","quote":"吴大将孙峻、吕据、留赞等闻淮南乱〖10〗，会文钦往，乃帅众将钦径至寿春。时诞诸军已至，城不可攻，乃走","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":153,"anchor":null},"note_id":null,"start":0,"end":50},{"id":"wgc-q0264","section":"chapter-028","block":"b-b65f0eafd40a24300f7f","layer":"original","quote":"诞遣将军蒋班追击之，斩赞；传首，收其印、节","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":153,"anchor":null},"note_id":null,"start":51,"end":72},{"id":"zhulv-q-305b4439281ed74f2920","section":"chapter-056","block":"b-604767dbf5853a5d004b","layer":"original","quote":"魏出东兴，据赴讨有功","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":199,"anchor":null},"note_id":null,"start":10,"end":20},{"id":"zhulv-q-77551a11b8ee4f203b3f","section":"chapter-056","block":"b-abd659c367dbc19a7af5","layer":"original","quote":"是岁，魏遣胡遵、诸葛诞等出东兴。异督水军攻浮梁〖6〗，坏之，魏军大破","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":285,"anchor":null},"note_id":null,"start":11,"end":45}],"profiles":{},"directory_counts":{}}
