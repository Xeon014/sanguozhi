{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o013b","title":"曹操赴扬州募兵并遇兵变","accounts":[{"id":"wudi-e-o013b-account","label":"正文","text":"曹操与夏侯惇赴扬州募兵，陈温、周昕资兵四千余；返至龙亢多有叛卒，后再募千余人屯河内。","evidence":["wudi-e-o013b-q"]}],"participants":[{"person":"cao-cao","role":"募兵","evidence":["wudi-e-o013b-q"]},{"person":"wudi-p0027","role":"同行","evidence":["wudi-e-o013b-q"]},{"person":"wudi-p0076","role":"资兵","evidence":["wudi-e-o013b-q"]},{"person":"wudi-p0077","role":"资兵","evidence":["wudi-e-o013b-q"]}],"place":{"text":"扬州、龙亢、铚、建平、河内","evidence":["wudi-e-o013b-q"]},"time":{"label":"初平元年","year":190,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o013b-q","wudi-q-o009","wudi-q-b-4a17eb75600ced2abdde"],"chronology":"wudi-y190","dating_review":{"anchor":"wudi-q-o009","basis":"初平元年","reviewed":true}},"source_order":[1,103,"O013b"],"order":63},{"id":"dongyuan-e-o071b","title":"袁术杀陈温领扬州","accounts":[{"id":"dongyuan-e-o071b-account","label":"《董二袁刘传第六》正文","text":"本传记袁术杀陈温而领扬州。","evidence":["dongyuan-e-o071b-q"]}],"participants":[{"person":"wudi-p0057","role":"杀官领州","evidence":["dongyuan-e-o071b-q"]},{"person":"wudi-p0076","role":"被杀","evidence":["dongyuan-e-o071b-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-o071b-q"]},"ordering_evidence":"dongyuan-e-o071b-q","source_order":[6,391,"O071b"],"order":1719},{"id":"dongyuan-e-p101a","title":"陈温扬州刺史自病死","accounts":[{"id":"dongyuan-e-p101a-account","label":"裴松之按《英雄记》","text":"陈温扬州刺史自病死","evidence":["dongyuan-e-p101a-q"]}],"participants":[{"person":"wudi-p0076","role":"病卒","evidence":["dongyuan-e-p101a-q"]}],"place":null,"time":{"label":"陈温袁遗陈瑀领扬州时异说","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-p101a-q"]},"ordering_evidence":"dongyuan-e-p101a-q","source_order":[6,401,"P101a"],"related_events":[{"event":"wudi-e-p028a","type":"related",