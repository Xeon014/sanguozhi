":"dongyuan-m-p101-wudi-p0076","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p101"]}]}],"evidence":[{"id":"dongyuan-e-o071b-q","section":"chapter-006","block":"b-e7fa65d5e1ea25c916b0","layer":"original","quote":"杀扬州刺史陈温，领其州，","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":390,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":26,"end":38,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p101a-q","section":"chapter-006","block":"b-dd2315fa487eddcf425c","layer":"pei","quote":"陈温字元悌，汝南人。先为扬州刺史，自病死。","attribution":"裴松之按《英雄记》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":400,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cfd59ac468ffd86d6e36","start":14,"end":35,"offset_unit":"unicode_code_point"},{"id":"dongyuan-f0044-q","section":"chapter-006","block":"b-dd2315fa487eddcf425c","layer":"pei","quote":"陈温字元悌","attribution":"裴松之按《英雄记》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":400,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cfd59ac468ffd86d6e36","start":14,"end":19,"offset_unit":"unicode_code_point"},{"id":"dongyuan-f0045-q","section":"chapter-006","block":"b-dd2315fa487eddcf425c","layer":"pei","quote":"汝南人","attribution":"裴松之按《英雄记》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":400,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cfd59ac468ffd86d6e36","start":20,"end":23,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o071","section":"chapter-006","block":"b-e7fa65d5e1ea25c916b0","layer":"original","quote":"引军入陈留，太祖与绍合击，大破术军；术以余众奔九江，杀扬州刺史陈温，领其州，﹝二﹞以张勋、桥蕤等为大将（军）。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":390,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":55,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p101","section":"chapter-006","block":"b-dd2315fa487eddcf425c","layer":"pei","quote":"﹝二﹞臣松之按《英雄记》：“陈温字元悌，汝南人。先为扬州刺史，自病死。袁绍遣袁遗领州，败散，奔沛国，为兵所杀。袁术更用陈瑀为扬州。瑀字公玮，下邳人。瑀既领州，而术败于封丘，南向寿春；瑀拒术不纳，术退保阴陵。更合军攻瑀，瑀惧走归下邳。”如此，则温不为术所杀，与本传不同。","attribution":"裴松之按《英雄记》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":400,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cfd59ac468ffd86d6e36","start":0,"end":134,"offset_unit":"unicode_code_point"},{"id":"huanchen-q-87051db984fd00dca095","section":"chapter-022","block":"b-1b90e315ea7fd45eb452","layer":"original","quote":"子恂嗣。恂薨，无嗣；弟温绍封〖19〗。咸熙中，开建五等；以泰著勋前朝，改封温为慎子","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":285,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":19,"end":60,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o013b-q","section":"chapter-001","block":"b-6d90d341ed08685dd83b","layer":"original","quote":"太祖兵少，乃与夏侯惇等诣扬州募兵〖21〗。刺史陈温、丹杨太守周昕与兵四千余人〖22〗；还到龙亢〖23〗，士卒多叛。﹝一﹞至铚、建平〖24〗，复收兵得千余人。进屯河内。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":102,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":196,"end":279,"offset_unit":"unicode_code_point"},{"id":"wudi-e-p028a-q","section":"chapter-001","block":"b-b1207e1cae0a3a88c76c","layer":"pei","quote":"《英雄记》曰：“绍后用遗为扬州刺史，为袁术所败。”","attribution":"《英雄记》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":96,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-faef7ba1f606d6346fa6","start":0,"end":25,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-4a17eb75600ced2abdde","section":"chapter-001","block":"b-4a17eb75600ced2abdde","layer":"modern","quote":"〖1〗初平元年：公元 190 年。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":86,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-93d66253e23c705b336d","start":0,"end":17,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o009","section":"chapter-001","block":"b-20c7e941eb42ee97df8c","layer":"original","quote":"初平元年春正月〖1〗，后将军袁术、冀州牧韩馥、﹝一﹞豫州刺史孔伷、﹝二﹞兖州刺史刘岱、﹝三﹞河内太守王匡、﹝四﹞勃海太守袁绍、陈留太守张邈、东郡太守桥瑁、﹝五﹞山阳太守袁遗、﹝六﹞济北相鲍信，﹝七﹞同时俱起兵〖2〗。众各数万，推绍为盟主。太祖行奋武将军〖3〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":84,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":130,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o013","section":"chapter-001","block":"b-6d90d341ed08685dd83b","layer":"original","quote":"太祖到酸枣。诸军兵十余万，日置酒高会，不图进取。太祖责让之〖13〗，因为谋曰：“诸君听吾计：使勃海引河内之众临孟津〖14〗；酸枣诸将守成皋，据敖仓〖15〗，塞轘辕、太谷〖16〗，全制其险；使袁将军率南阳之军军丹、析〖17〗，入武关〖18〗，以震三辅〖19〗。皆高垒深壁，勿与战；益为疑兵〖20〗，示天下形势。以顺诛逆，可立定也！今兵以义动，持疑而不进，失天下之望。窃为诸君耻之！”邈等不能用。太祖兵少，乃与夏侯惇等诣扬州募兵〖21〗。刺史陈温、丹杨太守周昕与兵四千余人〖22〗；还到龙亢〖23〗，士卒多叛。﹝一﹞至铚、建平〖24〗，复收兵得千余人。进屯河内。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":102,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":279,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o035b-q","section":"chapter-009","block":"b-879705d364554277c415","layer":"original","quote":"扬州刺史陈温素与洪善，洪将家兵千余人，就温募兵；得庐江上甲二千人〖1〗，东到丹杨，复得数千人，与太祖会龙亢。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":166,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":105,"end":159,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-o035","section":"chapter-009","block":"b-879705d364554277c415","layer":"original","quote":"曹洪字子廉。太祖从弟也。﹝一﹞太祖起义兵讨董卓，至荥阳，为卓将徐荣所败。太祖失马，贼追甚急；洪下，以马授太祖；太祖辞让，洪曰：“天下可无洪，不可无君！”遂步从到汴水。水深不得渡，洪循水得船；与太祖俱济，还奔谯。扬州刺史陈温素与洪善，洪将家兵千余人，就温募兵；得庐江上甲二千人〖1〗，东到丹杨，复得数千人，与太祖会龙亢。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":166,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":159,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
