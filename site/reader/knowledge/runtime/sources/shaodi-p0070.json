050d-q"]},"ordering_evidence":"houfei-e-o050d-q","source_order":[5,237,"O050d"],"order":1463},{"id":"houfei-e-p024a","title":"郭芝以他功封侯","accounts":[{"id":"houfei-e-p024a-account","label":"《魏略》","text":"郭芝以他功封侯","evidence":["houfei-e-p024a-q"]}],"participants":[{"person":"shaodi-p0070","role":"受封","evidence":["houfei-e-p024a-q"]}],"place":null,"time":{"label":"先时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["houfei-e-p024a-q"]},"ordering_evidence":"houfei-e-p024a-q","source_order":[5,248,"P024a"],"order":1468}],"persons":[{"id":"shaodi-p0070","name":"郭芝","evidence":["shaodi-q-p022","houfei-q-o049"],"facts":[],"aliases":[],"mentions":[{"id":"shaodi-m-p022-shaodi-p0070","kind":"mention","text":"文中提及","evidence":["shaodi-q-p022"]},{"id":"houfei-m-o049-shaodi-p0070","kind":"mention","text":"文中提及","evidence":["houfei-q-o049"]},{"id":"houfei-m-o050-shaodi-p0070","kind":"mention","text":"文中提及","evidence":["houfei-q-o050"]},{"id":"houfei-m-p024-shaodi-p0070","kind":"mention","text":"文中提及","evidence":["houfei-q-p024"]}]}],"evidence":[{"id":"houfei-e-o049b-q","section":"chapter-005","block":"b-f669d0efeea97feb8953","layer":"original","quote":"明元郭皇后，西平人也。世河右大族〖1〗。黄初中，本郡反叛，遂没入宫。明帝即位，甚见爱幸，拜为夫人；叔父立为骑都尉，从父芝为虎贲中郎将。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":235,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":67,"offset_unit":"unicode_code_point"},{"id":"houfei-e-o050d-q","section":"chapter-005","block":"b-6dc749ac781a81d5a82f","layer":"original","quote":"帝疾困，遂立为皇后。齐王即位，尊后为皇太后，称“永宁宫”。追封谥太后父满，为西都定侯，以立子建绍其爵。封太后母杜，为郃阳君。芝迁散骑常侍、长水校尉；﹝一﹞立，宣德将军〖2〗；皆封列侯。建兄德，出养甄氏。德及建，俱为镇护将军〖3〗，皆封列侯，并掌宿卫。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":236,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":125,"offset_unit":"unicode_code_point"},{"id":"houfei-e-p024a-q","section":"chapter-005","block":"b-c08ca9165cb229449ea8","layer":"pei","quote":"﹝一﹞《魏略》曰：“诸郭之中，芝最壮直。先时，自以他功封侯。”","attribution":"《魏略》","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":247,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-73bfa35798a4d757187e","start":0,"end":31,"offset_unit":"unicode_code_point"},{"id":"houfei-q-o014","section":"chapter-005","block":"b-87bc74c5c9a764cda8ec","layer":"original","quote":"初，太后弟秉，以功封都乡侯。黄初七年，进封开阳侯，邑千二百户，为昭烈将军〖15〗。﹝二﹞秉薨，子兰嗣。少有才学，﹝三﹞为奉车都尉，游击将军〖16〗，加散骑常侍。兰薨，子晖嗣。﹝四﹞又分秉爵，封兰弟琳为列侯，官至步兵校尉。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":46,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":110,"offset_unit":"unicode_code_point"},{"id":"houfei-q-o049","section":"chapter-005","block":"b-f669d0efeea97feb8953","layer":"original","quote":"明元郭皇后，西平人也。世河右大族〖1〗。黄初中，本郡反叛，遂没入宫。明帝即位，甚见爱幸，拜为夫人；叔父立为骑都尉，从父芝为虎贲中郎将。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":235,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":67,"offset_unit":"unicode_code_point"},{"id":"houfei-q-o050","section":"chapter-005","block":"b-6dc749ac781a81d5a82f","layer":"original","quote":"帝疾困，遂立为皇后。齐王即位，尊后为皇太后，称“永宁宫”。追封谥太后父满，为西都定侯，以立子建绍其爵。封太后母杜，为郃阳君。芝迁散骑常侍、长水校尉；﹝一﹞立，宣德将军〖2〗；皆封列侯。建兄德，出养甄氏。德及建，俱为镇护将军〖3〗，皆封列侯，并掌宿卫。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":236,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":125,"offset_unit":"unicode_code_point"},{"id":"houfei-q-p024","section":"chapter-005","block":"b-c08ca9165cb229449ea8","layer":"pei","quote":"﹝一﹞《魏略》曰：“诸郭之中，芝最壮直。先时，自以他功封侯。”","attribution":"《魏略》","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":247,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-73bfa35798a4d757187e","start":0,"end":31,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-b-b7b4e1eced04c86a11c0","section":"chapter-003","block":"b-b7b4e1eced04c86a11c0","layer":"modern","quote":"〖2〗七年：黄初七年（公元226）。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":4,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-7290e2008f81d6cad349","start":0,"end":18,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-o001","section":"chapter-003","block":"b-fe69417d79b76e276a24","layer":"original","quote":"明皇帝讳叡，字元仲。文帝太子也。生而太祖爱之，常令在左右。﹝一﹞年十五，封武德侯。黄初二年为齐公。三年为平原王〖1〗。以其母诛，故未建为嗣。﹝二﹞七年夏五月〖2〗，帝病笃，乃立为皇太子。丁巳〖3〗，即皇帝位。大赦；尊皇太后曰太皇太后〖4〗，皇后曰皇太后〖5〗；诸臣封爵各有差。﹝三﹞〔六月〕，癸未〖6〗，追谥母甄夫人曰文昭皇后〖7〗。壬辰〖8〗，立皇弟蕤为阳平王〖9〗。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":1,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":185,"offset_unit":"unicode_code_point"},{"id":"shaodi-e-p022a-q","section":"chapter-004","block":"b-d30a83ecef7e92642fb2","layer":"pei","quote":"﹝三﹞《魏略》曰：“景王将废帝，遣郭芝入白太后。太后与帝对坐，芝谓帝曰：‘大将军欲废陛下，立彭城王据。’帝乃起去。太后不悦。芝曰：‘太后有子不能教，今大将军意已成，又勒兵于外以备非常。但当顺旨，将复何言！’太后曰：‘我欲见大将军！口有所说。’芝曰：‘何可见邪？但当速取玺绶！’太后意折，乃遣傍侍御取玺绶，著坐侧。芝出报景王，景王甚欢。又遣使者授齐王印绶，当出就西宫。帝受命，遂载王车；与太后别，垂涕。始从太极殿南出，群臣送者数十人。太尉司马孚悲不自胜，余多流涕。王出后，景王又使使者请玺绶。太后曰：‘彭城王，我之季叔也。今来立，我当何之！且明皇帝当绝嗣乎？吾以为高贵乡公者，文皇帝之长孙，明皇帝之弟子。于礼，小宗有后大宗之义，其详议之。’景王乃更召群臣，以皇太后令示之；乃定迎高贵乡公。是时太常已发二日，待玺绶于温。事定，又请玺绶。太后令曰：‘我见高贵乡公，小时识之；明日我自欲以玺绶手授之。’”","attribution":"《魏略》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":304,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-aad7486801fbf98d7830","start":0,"end":398,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-b-91c7db3288e80e5b9e4b","section":"chapter-004","block":"b-91c7db3288e80e5b9e4b","layer":"modern","quote":"〖1〗六年：嘉平六年（公元 254）。己丑：旧历初一日。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":275,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-386affd091adab4ef2df","start":0,"end":28,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o059","section":"chapter-004","block":"b-83849af55ebd17291970","layer":"original","quote":"六年春二月，己丑〖1〗，镇东将军毌丘俭上言：“昔诸葛恪围合肥新城，城中遣士刘整出围〖2〗，传消息，为贼所得。考问所传，语整曰：‘诸葛公欲活汝，汝可具服〖3〗。’整骂曰：‘死狗，此何言也！我当必死为魏国鬼！不苟求活逐汝去也。欲杀我者，便速杀之！’终无他辞。又遣士郑像出城传消息。或以语恪，恪遣马骑寻围迹索，得像还。四五人的头面缚〖4〗，将绕城表。敕语像〖5〗，使大呼，言：‘大军已还洛，不如早降！’像不从其言，更大呼城中曰：‘大军近在围外，壮士努力！’贼以刀筑其口，使不得言。像遂大呼，令城中闻知。整、像为兵，能守义执节，子弟宜有差异〖6〗。”","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":266,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":271,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-p022","section":"chapter-004","block":"b-d30a83ecef7e92642fb2","layer":"pei","quote":"﹝三﹞《魏略》曰：“景王将废帝，遣郭芝入白太后。太后与帝对坐，芝谓帝曰：‘大将军欲废陛下，立彭城王据。’帝乃起去。太后不悦。芝曰：‘太后有子不能教，今大将军意已成，又勒兵于外以备非常。但当顺旨，将复何言！’太后曰：‘我欲见大将军！口有所说。’芝曰：‘何可见邪？但当速取玺绶！’太后意折，乃遣傍侍御取玺绶，著坐侧。芝出报景王，景王甚欢。又遣使者授齐王印绶，当出就西宫。帝受命，遂载王车；与太后别，垂涕。始从太极殿南出，群臣送者数十人。太尉司马孚悲不自胜，余多流涕。王出后，景王又使使者请玺绶。太后曰：‘彭城王，我之季叔也。今来立，我当何之！且明皇帝当绝嗣乎？吾以为高贵乡公者，文皇帝之长孙，明皇帝之弟子。于礼，小宗有后大宗之义，其详议之。’景王乃更召群臣，以皇太后令示之；乃定迎高贵乡公。是时太常已发二日，待玺绶于温。事定，又请玺绶。太后令曰：‘我见高贵乡公，小时识之；明日我自欲以玺绶手授之。’”","attribution":"《魏略》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":304,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-aad7486801fbf98d7830","start":0,"end":398,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
