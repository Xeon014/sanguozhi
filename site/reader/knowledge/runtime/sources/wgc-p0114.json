{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wgc-e-add074","title":"王宏任司隶校尉","order":5860,"accounts":[{"id":"wgc-a-add074","label":"博物记","text":"王宏任司隶校尉","evidence":["wgc-q0717","wgc-q0140"]}],"participants":[{"person":"wgc-p0114","role":"任官","evidence":["wgc-q0717","wgc-q0140"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0717","wgc-q0140"]},"ordering_evidence":"wgc-q0717"}],"persons":[{"id":"wgc-p0114","name":"王宏","evidence":["wgc-q0140"],"aliases":[],"facts":[],"mentions":[{"id":"wgc-m-p066-wgc-p0114","kind":"mention","text":"本段涉及王宏","evidence":["wgc-q0140"]}]}],"evidence":[{"id":"wgc-q0140","section":"chapter-028","block":"b-916e3150373d4079c2cd","layer":"pei","quote":"《博物记》曰：“初，王粲与族兄凯，俱避地荆州。刘表欲以女妻粲，而嫌其形陋而用率；以凯有风貌，乃以妻凯。凯生业，业即刘表外孙也。蔡邕有书近万卷，末年载数车与粲。粲亡后，相国掾魏讽谋反，粲子与焉；既被诛，邕所与书，悉入业。业字长绪。位至谒者仆射。子宏字正宗。司隶校尉。宏，弼之兄也。”","attribution":"博物记","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":629,"anchor":null},"note_id":"n-fd72bf831660f4aea13e","start":0,"end":140},{"id":"wgc-q0717","section":"chapter-028","block":"b-916e3150373d4079c2cd","layer":"pei","quote":"子宏字正宗。司隶校尉。宏，弼之兄也。","attribution":"博物记","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":629,"anchor":null},"note_id":"n-fd72bf831660f4aea13e","start":121,"end":139}],"profiles":{},"directory_counts":{}}
