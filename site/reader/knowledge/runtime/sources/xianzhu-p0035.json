{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dongyuan-e-o088b","title":"刘表蔡氏爱刘琮蔡瑁张允附之刘琦出江夏刘琮继","accounts":[{"id":"dongyuan-e-o088b-account","label":"《董二袁刘传第六》正文","text":"刘表蔡氏爱刘琮蔡瑁张允附之刘琦出江夏刘琮继","evidence":["dongyuan-e-o088b-q"]}],"participants":[{"person":"liu-biao","role":"欲立琮","evidence":["dongyuan-e-o088b-q"]},{"person":"dongyuan-p0051","role":"爱琮","evidence":["dongyuan-e-o088b-q"]},{"person":"xianzhu-p0033","role":"支持","evidence":["dongyuan-e-o088b-q"]},{"person":"dongyuan-p0052","role":"支持","evidence":["dongyuan-e-o088b-q"]},{"person":"xianzhu-p0035","role":"出守","evidence":["dongyuan-e-o088b-q"]},{"person":"liu-cong","role":"继位","evidence":["dongyuan-e-o088b-q"]}],"place":null,"time":{"year":208,"label":"建安十三年","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"dongyuan-y208","dating_review":{"reviewed":true,"anchor":"dongyuan-q-o088","basis":"建安十三年"},"evidence":["dongyuan-e-o088b-q","dongyuan-q-o088","wuzhu-q-o012","xunyu-q-o064","zhouyu-q-o009","zhouyu-q-b-63f47c62fde80b3a0132"]},"ordering_evidence":"dongyuan-e-o088b-q","source_order":[6,486,"O088b"],"order":1763},{"id":"dongyuan-e-p116a","title":"蔡瑁张允阻刘琦省父疾刘琦泣去","accounts":[{"id":"dongyuan-e-p116a-account","label":"《典略》","text":"蔡瑁张允阻刘琦省父疾刘琦泣去","evidence":["dongyuan-e-p116a-q"]}],"participants":[{"person":"xianzhu-p0033","role":"阻见","evidence":["dongyuan-e-p116a-q"]},{"person":"dongyuan-p0052","role":"阻见","evidence":["dongyuan-e-p116a-q"]},{"person":"xianzhu-p0035","role":"省疾被阻","evidence":["dongyuan-e-p116a-q"]}],"place":null,"time":{"label":"刘表病时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-p116a-q"]},"ordering_evidence":"dongyuan-e-p116a-q","source_order":[6,497,"P116a"],"order":1767},{"id":"xianzhu-e-o028a","title":"刘备会关羽刘琦军至夏口","accounts":[{"id":"xianzhu-e-o028a-account","label":"《先主传》正文","text":"刘备在汉津与关羽船会合，渡沔水后遇刘琦万余人，与俱到夏口。","evidence":["xianzhu-e-o028a-q"]}],"participants":[{"person":"liu-bei","role":"会军","evidence":["xianzhu-e-o028a-q"]},{"person":"wudi-p0172","role":"接应","evidence":["xianzhu-e-o028a-q"]},{"person":"xianzhu-p0035","role":"合军","evidence":["xianzhu-e-o028a-q"]}],"place":{"text":"汉津、夏口","evidence":["xianzhu-e-o028a-q"]},"time":{"year":208,"label":"长坂败走后","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xianzhu-y208","dating_review":{"reviewed":true,"anchor":"xianzhu-q-o024","basis":"长坂败走后"},"evidence":["xianzhu-e-o028a-q","xianzhu-q-o024","wudi-q-o119","wudi-q-b-888495d8be7766faf20c"]},"source_order":[32,113,"O028a"],"order":6533},{"id":"xianzhu-e-o030a","title":"刘备表刘琦为荆州刺史","accounts":[{"id":"xianzhu-e-o030a-account","label":"《先主传》正文","text":"刘备上表以刘琦为荆州刺史。","evidence":["xianzhu-e-o030a-q"]},{"id":"dongliu-a-b09358cdaad19770b5a6","label":"正文","text":"刘备略有三郡","evidence":["dongliu-q-dddcc33d3003ae997cfa"]}],"participants":[{"person":"liu-bei","role":"表荐","evidence":["xianzhu-e-o030a-q"]},{"person":"xianzhu-p0035","role":"被表荐","evidence":["xianzhu-e-o030a-q"]}],"place":{"text":"荆州","evidence":["xianzhu-e-o030a-q"]},"time":{"label":"赤壁战后","precision":"relative","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xianzhu-e-o030a-q"],"after":"cao-retreat"},"source_order":[32,137,"O030a"],"order":6544},{"id":"xianzhu-e-o031a","title":"刘琦卒与刘备领荆州牧","accounts":[{"id":"xianzhu-e-o031a-account","label":"《先主传》正文","text":"刘琦病死，群下推刘备为荆州牧，治公安。","evidence":["xianzhu-e-o031a-q"]}],"participants":[{"person":"xianzhu-p0035","role":"病卒","evidence":["xianzhu-e-o031a-q"]},{"person":"liu-bei","role":"领荆州牧","evidence":["xianzhu-e-o031a-q"]}],"place":{"text":"公安","evidence":["xianzhu-e-o031a-q"]},"time":{"label":"刘琦领荆州刺史之后","precision":"relative","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xianzhu-e-o031a-q"],"after":"xianzhu-e-o030a"},"source_order":[32,138,"O031a"],"order":6547},{"id":"zhuge-e-o008a","title":"刘琦去梯问计诸葛亮示外出之理刘琦任江夏","accounts":[{"id":"zhuge-e-o008a-account","label":"《诸葛亮传第五》正文","text":"刘琦去梯问计诸葛亮示外出之理刘琦任江夏","evidence":["zhuge-e-o008a-q"]}],"participants":[{"person":"xianzhu-p0035","role":"求策出任","evidence":["zhuge-e-o008a-q"]},{"person":"zhuge-liang","role":"献策","evidence":["zhuge-e-o008a-q"]}],"place":null,"time":{"label":"刘琦求安时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["zhuge-e-o008a-q"]},"ordering_evidence":"zhuge-e-o008a-q","source_order":[35,34,"O008a"],"order":6759}],"persons":[{"id":"xianzhu-p0035","name":"刘琦","evidence":["xianzhu-q-o028","zhuge-q-o008","dongyuan-q-o088"],"facts":[],"aliases":[],"mentions":[{"id":"xianzhu-m-o028-xianzhu-p0035","kind":"mention","text":"文中提及","evidence":["xianzhu-q-o028"]},{"id":"xianzhu-m-o030-xianzhu-p0035","kind":"mention","text":"文中提及","evidence":["xianzhu-q-o030"]},{"id":"xianzhu-m-o031-xianzhu-p0035","kind":"mention","text":"文中提及","evidence":["xianzhu-q-o031"]},{"id":"zhuge-m-o008-xianzhu-p0035","kind":"mention","text":"文中提及","evidence":["zhuge-q-o008"]},{"id":"zhuge-m-o013-xianzhu-p0035","kind":"mention","text":"文中提及","evidence":["zhuge-q-o013"]},{"id":"dongyuan-m-o088-xianzhu-p0035","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o088"]},{"id":"dongyuan-m-p116-xianzhu-p0035","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p116"]}]}],"evidence":[{"id":"dongliu-q-dddcc33d3003ae997cfa","section":"chapter-039","block":"b-25116ac3db8470a65d86","layer":"original","quote":"会先主略有三郡","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":45,"anchor":null},"note_id":null,"start":52,"end":59},{"id":"dongyuan-e-o088b-q","section":"chapter-006","block":"b-36c489d1f93241a324d4","layer":"original","quote":"初，表及妻爱少子琮，欲以为后，而蔡瑁、张允为之支党〖1〗；乃出长子琦为江夏太守，众遂奉琮为嗣：琦与琮遂为仇隙。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":485,"anchor":null},"note_id":null,"start":18,"end":73},{"id":"dongyuan-e-p116a-q","section":"chapter-006","block":"b-c6dc21a2f388f35ad430","layer":"pei","quote":"﹝二﹞《典略》曰：“表疾病，琦还省疾。琦性慈孝，瑁、允恐琦见表，父子相感，更有托后之意。谓曰：‘将军命君，抚临江夏，为国东藩，其任至重。今释众而来，必见谴怒；伤亲之欢心以增其疾，非孝敬也。’遂遏于户外，使不得见。琦流涕而去。”","attribution":"《典略》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":496,"anchor":null},"note_id":"n-c67f7ef4c5e9d529d70f","start":0,"end":113},{"id":"dongyuan-q-o088","section":"chapter-006","block":"b-36c489d1f93241a324d4","layer":"original","quote":"建安十三年，太祖征表；未至，表病死。初，表及妻爱少子琮，欲以为后，而蔡瑁、张允为之支党〖1〗；乃出长子琦为江夏太守，众遂奉琮为嗣：琦与琮遂为仇隙。﹝二﹞越、嵩及东曹掾傅巽等说琮归太祖〖2〗。琮曰：“今与诸君据全楚之地〖3〗，守先君之业；以观天下，何为不可乎？”巽对曰：“逆顺有大体，强弱有定势。以人臣而拒人主，逆也；以新造之楚而御国家，其势弗当也；以刘备而敌曹公，又弗当也。三者皆短，欲以抗王兵之锋，必亡之道也！将军自料何与刘备〖4〗？”琮曰：“吾不若也。”巽曰：“诚以刘备不足御曹公乎〖5〗，则虽保楚之地，不足以自存也；诚以刘备足御曹公乎，则备不为将军下也〖6〗。愿将军勿疑！”","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":485,"anchor":null},"note_id":null,"start":0,"end":290},{"id":"dongyuan-q-p116","section":"chapter-006","block":"b-c6dc21a2f388f35ad430","layer":"pei","quote":"﹝二﹞《典略》曰：“表疾病，琦还省疾。琦性慈孝，瑁、允恐琦见表，父子相感，更有托后之意。谓曰：‘将军命君，抚临江夏，为国东藩，其任至重。今释众而来，必见谴怒；伤亲之欢心以增其疾，非孝敬也。’遂遏于户外，使不得见。琦流涕而去。”","attribution":"《典略》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":496,"anchor":null},"note_id":"n-c67f7ef4c5e9d529d70f","start":0,"end":113},{"id":"wudi-q-b-888495d8be7766faf20c","section":"chapter-001","block":"b-888495d8be7766faf20c","layer":"modern","quote":"〖1〗十三年：建安十三年（公元 208）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":666,"anchor":null},"note_id":"n-0bae348fdb687025113d","start":0,"end":21},{"id":"wudi-q-o119","section":"chapter-001","block":"b-4bcffcc4ee709a4e5ea3","layer":"original","quote":"十三年春正月〖1〗，公还邺。作玄武池以肄舟师〖2〗。﹝一﹞汉罢三公官，置丞相、御史大夫〖3〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":661,"anchor":null},"note_id":null,"start":0,"end":47},{"id":"wuzhu-q-o012","section":"chapter-047","block":"b-3843def972d8a772cdb3","layer":"original","quote":"十三年春〖1〗，权复征黄祖。祖先遣舟兵拒军，都尉吕蒙破其前锋；而凌统、董袭等尽锐攻之〖2〗，遂屠其城。祖挺身亡走〖3〗。骑士冯则追枭其首〖4〗，虏其男女数万口。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":60,"anchor":null},"note_id":null,"start":0,"end":80},{"id":"xianzhu-e-o028a-q","section":"chapter-032","block":"b-4e8f92a9c4f1a36ac09a","layer":"original","quote":"先主斜趋汉津〖7〗，适与羽船会，得济沔；遇表长子江夏太守琦众万余人〖8〗，与俱到夏口。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":112,"anchor":null},"note_id":null,"start":0,"end":43},{"id":"xianzhu-e-o030a-q","section":"chapter-032","block":"b-eb597d5d4ba0ca04fe0c","layer":"original","quote":"先主表琦为荆州刺史；","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":136,"anchor":null},"note_id":null,"start":0,"end":10},{"id":"xianzhu-e-o031a-q","section":"chapter-032","block":"b-a5287409ad1bb0d56cad","layer":"original","quote":"琦病死，群下推先主为荆州牧，治公安。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":137,"anchor":null},"note_id":null,"start":0,"end":18},{"id":"xianzhu-q-o024","section":"chapter-032","block":"b-c857386227851cc86ab3","layer":"original","quote":"（曹公南征表）〔及曹公南征〕，会表卒，﹝二﹞子琮代立〖2〗，遣使请降。先主屯樊，不知曹公猝至；至宛乃闻之，遂将其众去。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":108,"anchor":null},"note_id":null,"start":0,"end":59},{"id":"xianzhu-q-o028","section":"chapter-032","block":"b-4e8f92a9c4f1a36ac09a","layer":"original","quote":"先主斜趋汉津〖7〗，适与羽船会，得济沔；遇表长子江夏太守琦众万余人〖8〗，与俱到夏口。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":112,"anchor":null},"note_id":null,"start":0,"end":43},{"id":"xianzhu-q-o030","section":"chapter-032","block":"b-eb597d5d4ba0ca04fe0c","layer":"original","quote":"先主表琦为荆州刺史；又南征四郡〖1〗：武陵太守金旋、长沙太守韩玄、桂阳太守赵范、零陵太守刘度〖2〗，皆降。﹝一﹞庐江雷绪率部曲数万口稽颡〖3〗。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":136,"anchor":null},"note_id":null,"start":0,"end":72},{"id":"xianzhu-q-o031","section":"chapter-032","block":"b-a5287409ad1bb0d56cad","layer":"original","quote":"琦病死，群下推先主为荆州牧，治公安。权稍畏之，进妹固好〖4〗；先主至京见权〖5〗，绸缪恩纪〖6〗。﹝二﹞","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":137,"anchor":null},"note_id":null,"start":0,"end":52},{"id":"xunyu-q-o064","section":"chapter-010","block":"b-38f29d879d5ca24386ff","layer":"original","quote":"建安十三年，太祖破荆州，欲顺江东下。诩谏曰：“明公昔破袁氏，今收汉南；威名远著，军势既大。若乘旧楚之饶，以飨吏士；抚安百姓，使安土乐业；则可不劳众而江东稽服矣〖4〗。”太祖不从，军遂无利。﹝一﹞","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":314,"anchor":null},"note_id":null,"start":0,"end":97},{"id":"zhouyu-q-b-63f47c62fde80b3a0132","section":"chapter-054","block":"b-63f47c62fde80b3a0132","layer":"modern","quote":"〖6〗十三年：建安十三年（公元 208）。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":43,"anchor":null},"note_id":"n-8f109f42647e5ee8d831","start":0,"end":21},{"id":"zhouyu-q-o009","section":"chapter-054","block":"b-3661896c106f1817bf4b","layer":"original","quote":"十三年春〖6〗，权讨江夏，瑜为前部大督〖7〗。其年九月，曹公入荆州，刘琮举众降。曹公得其水军船，步兵数十万。将士闻之皆恐。（惧）〔权〕延见群下〖8〗，问以计策。议者咸曰：“曹公，豺虎也！然托名汉相，挟天子以征四方，动以朝廷为辞；今日拒之，事更不顺。且将军大势：可以拒操者，长江也。今操得荆州，奄有其地〖9〗；刘表治水军，蒙冲、斗舰〖10〗，乃以千数，操悉浮以沿江；兼有步兵，水陆俱下。此为长江之险，已与我共之矣。而势力众寡，又不可论。愚谓大计不如迎之。”","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":34,"anchor":null},"note_id":null,"start":0,"end":227},{"id":"zhuge-e-o008a-q","section":"chapter-035","block":"b-5baeb7a9a85977757637","layer":"original","quote":"刘表长子琦，亦深器亮。表受后妻之言，爱少子琮，不悦于琦。琦每欲与亮谋自安之术，亮辄拒塞〖27〗，未与处画〖28〗。琦乃将亮游观后园，共上高楼；饮宴之间，令人去梯，因谓亮曰：“今日上不至天，下不至地；言出子口，入于吾耳：可以言未？”亮答曰：“君不见申生在内而危〖29〗，重耳在外而安乎？”琦意感悟，阴规出计〖30〗；会黄祖死〖31〗，得出，遂为江夏太守。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":33,"anchor":null},"note_id":null,"start":0,"end":176},{"id":"zhuge-q-o008","section":"chapter-035","block":"b-5baeb7a9a85977757637","layer":"original","quote":"刘表长子琦，亦深器亮。表受后妻之言，爱少子琮，不悦于琦。琦每欲与亮谋自安之术，亮辄拒塞〖27〗，未与处画〖28〗。琦乃将亮游观后园，共上高楼；饮宴之间，令人去梯，因谓亮曰：“今日上不至天，下不至地；言出子口，入于吾耳：可以言未？”亮答曰：“君不见申生在内而危〖29〗，重耳在外而安乎？”琦意感悟，阴规出计〖30〗；会黄祖死〖31〗，得出，遂为江夏太守。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":33,"anchor":null},"note_id":null,"start":0,"end":176},{"id":"zhuge-q-o013","section":"chapter-035","block":"b-a994e8623dcb2244d347","layer":"original","quote":"权勃然曰：“吾不能举全吴之地，十万之众，受制于人。吾计决矣！非刘豫州，莫可以当曹操者；然豫州新败之后，安能抗此难乎？”亮曰：“豫州军虽败于长坂，今战士还者及关羽水军，精甲万人；刘琦合江夏战士，亦不下万人。曹操之众，远来疲弊；闻追豫州，轻骑一日一夜行三百余里。此所谓‘强弩之末〖12〗，势不能穿鲁缟’者也〖13〗。故兵法忌之，曰‘必蹶上将军’〖14〗。且北方之人，不习水战；又荆州之民附操者，逼兵势耳，非心服也。今将军诚能命猛将统兵数万〖15〗，与豫州协规同力，破操军必矣！操军破，必北还；如此则荆、吴之势强〖16〗，鼎足之形成矣。成败之机，在于今日！”","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":74,"anchor":null},"note_id":null,"start":0,"end":276}],"profiles":{},"directory_counts":{}}
