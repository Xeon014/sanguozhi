yu-q-o014"]},{"id":"sunshi-m-o033-xunyu-p0030","kind":"mention","text":"文中提及","evidence":["sunshi-q-o033"]},{"id":"wuzhu-m-p003-xunyu-p0030","kind":"mention","text":"文中提及","evidence":["wuzhu-q-p003"]}]}],"evidence":[{"id":"liusima-q-7a0441251c419c72e361","section":"chapter-015","block":"b-e03e118fcee75a0aa821","layer":"original","quote":"后孙策所置庐江太守李（述）〔术〕，攻杀扬州刺史严象","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":2,"anchor":null},"note_id":null,"start":0,"end":25},{"id":"sunshi-e-o033c-q","section":"chapter-046","block":"b-fe64807ea9dcb47036d8","layer":"original","quote":"又命扬州刺吏严象，举权茂才〖27〗。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":217,"anchor":null},"note_id":null,"start":69,"end":87},{"id":"sunshi-q-o033","section":"chapter-046","block":"b-fe64807ea9dcb47036d8","layer":"original","quote":"是时，袁绍方强〖25〗，而策并江东。曹公力未能逞，且欲抚之：﹝九﹞乃以弟女配策小弟匡，又为子（章）〔彰〕取贲女〖26〗；皆礼辟策弟权、翊；又命扬州刺吏严象，举权茂才〖27〗。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":217,"anchor":null},"note_id":null,"start":0,"end":87},{"id":"wangwei-q-75e74c500a2d13a91eef","section":"chapter-021","block":"b-d5b0a51a480ce1371298","layer":"pei","quote":"（像）〔象〕以兼有文武，出为扬州刺史","attribution":"裴注·典略","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":129,"anchor":null},"note_id":"n-cdb5776a7cfbd5fbdd22","start":55,"end":73},{"id":"wangwei-q-d50add701f6528514ffa","section":"chapter-021","block":"b-d5b0a51a480ce1371298","layer":"pei","quote":"建安初，以高才与京兆严（像）〔象〕擢拜尚书郎","attribution":"裴注·典略","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":129,"anchor":null},"note_id":"n-cdb5776a7cfbd5fbdd22","start":32,"end":54},{"id":"wuzhu-q-p003","section":"chapter-047","block":"b-8322015c67cf9bd0fd9e","layer":"pei","quote":"﹝二﹞《江表传》曰：“初，策表用李术为庐江太守；策亡之后，术不肯事权，而多纳其亡叛。权移书求索，术报曰：‘有德见归，无德见叛：不应复还！’权大怒，乃以状白曹公曰：‘严刺史昔为公所用，又是州举将；而李术凶恶，轻犯汉制，残害州司，肆其无道：宜速诛灭，以惩丑类！今欲讨之，进为国朝扫除鲸鲵，退为举将报塞怨仇：此天下达义，夙夜所甘心。术必惧诛，复诡说求救。明公所居，阿衡之任，海内所瞻；愿敕执事，勿复听受。’是岁，举兵攻术于皖城。术闭门自守，求救于曹公。曹公不救，粮食乏尽，妇女或丸泥而吞之。遂屠其城，枭术首，徙其部曲（三）〔二〕万余人。”","attribution":"《江表传》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":58,"anchor":null},"note_id":"n-cfc7749b7799d7fd876a","start":0,"end":266},{"id":"xunyu-e-p015a-q","section":"chapter-010","block":"b-2778025a5b5e80b4b41b","layer":"pei","quote":"象字文则，京兆人。少聪博，有胆智。以督军御史中丞，诣扬州，讨袁术；会术病卒，因以为扬州刺史。建安五年，为孙策庐江太守李术所杀。时年三十八。","attribution":"《三辅决录》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":83,"anchor":null},"note_id":"n-41f82e7b36f1dab6010f","start":12,"end":81},{"id":"xunyu-e-p015b-q","section":"chapter-010","block":"b-2778025a5b5e80b4b41b","layer":"pei","quote":"象同郡赵岐，作《三辅决录》，恐时人不尽其意，故隐其书，唯以示象。","attribution":"《三辅决录》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":83,"anchor":null},"note_id":"n-41f82e7b36f1dab6010f","start":82,"end":114},{"id":"xunyu-f0008-q","section":"chapter-010","block":"b-2778025a5b5e80b4b41b","layer":"pei","quote":"象字文则","attribution":"《三辅决录》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":83,"anchor":null},"note_id":"n-41f82e7b36f1dab6010f","start":12,"end":16},{"id":"xunyu-q-o014","section":"chapter-010","block":"b-9ae5af5eea55486407f3","layer":"original","quote":"太祖问彧：“谁能代卿为我谋者？”言彧：“荀攸、钟繇。”先是，彧言策谋士，进戏志才；志才卒，又进郭嘉：太祖以彧为知人。诸所进达，皆称职；唯严象为扬州，韦康为凉州，后败亡。﹝三﹞","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":59,"anchor":null},"note_id":null,"start":0,"end":87},{"id":"xunyu-q-p015","section":"chapter-010","block":"b-2778025a5b5e80b4b41b","layer":"pei","quote":"﹝三﹞《三辅决录》曰：“象字文则，京兆人。少聪博，有胆智。以督军御史中丞，诣扬州，讨袁术；会术病卒，因以为扬州刺史。建安五年，为孙策庐江太守李术所杀。时年三十八。”象同郡赵岐，作《三辅决录》，恐时人不尽其意，故隐其书，唯以示象。","attribution":"《三辅决录》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":83,"anchor":null},"note_id":"n-41f82e7b36f1dab6010f","start":0,"end":114}],"profiles":{},"directory_counts":{}}
