88c7631151d983"]},"ordering_evidence":"santizhu064-q-948ebe88c7631151d983","source_order":[64,2,0],"order":10921}],"persons":[{"id":"wgc-p0072","name":"张休","evidence":["wgc-q0101","santizhu059-q-e6d45d4a1d69982d86a6","santizhu059-q-6363347a540d2d9170bb","santizhu059-q-35be8287455e56599f63","chenghuang-q-926c04f21090efbba781","zhanggu-q-a1c1612ad282c0f79b27","zhanggu-q-c717b14f5045b93be823","zhanggu-q-15beb61d3a1fa38d0cf0","zhanggu-q-d95ac6b70220ae016119","zhanggu-q-23a17f954aec89d98b81","zhanggu-q-2113b80d6f9f8a3da0c7","zhanggu-q-d8d548abae9ff752f208","zhanggu-q-8efdeacaedbf5b3118a2","zhanggu-q-d0dbbb7f5888a03c83db","zhanggu-q-0436ab4fab48307232e3"],"aliases":[],"facts":[{"id":"zhanggu-f-c0f7b93fe435ea1e069f","text":"字叔嗣。","evidence":["zhanggu-q-0436ab4fab48307232e3"]}],"mentions":[{"id":"wgc-m-p016-wgc-p0072","kind":"mention","text":"本段涉及张休","evidence":["wgc-q0101"]},{"id":"zhanggu-m-f2d1eb32d24cb33f8679","kind":"mention","text":"本段涉及张休","evidence":["zhanggu-q-3daa3c56b9872fdc7a53"]}]}],"evidence":[{"id":"chenghuang-q-926c04f21090efbba781","section":"chapter-055","block":"b-6c7c391ddc76f3325329","layer":"original","quote":"与诸葛恪、顾谭、张休等并侍东宫，皆共亲友。尚书暨艳亦与表善〖10〗。后艳遇罪，时人咸自营护〖11〗，信厚言薄〖12〗；表独不然，士以此重之。（徙）〔从〕太子中庶子，（拜）〔转〕翼正都尉","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":130,"anchor":null},"note_id":null,"start":19,"end":111},{"id":"hancui-q-2554659cfd2fbba6bd23","section":"chapter-024","block":"b-f3afcdb8c325c1801064","layer":"original","quote":"吴大将全琮帅数万众来侵寇〖21〗；时州兵休使〖22〗，在者无几。礼躬勒卫兵御之，战于芍陂〖23〗；自旦及暮，将士死伤过半。礼犯蹈白刃，马被数创，手秉枹鼓〖24〗，奋不顾身；贼众乃退。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":338,"anchor":null},"note_id":null,"start":42,"end":133},{"id":"panlu-q-4e85b27a24e2bbb0087d","section":"chapter-061","block":"b-de5d6c412a1c6dd60cc2","layer":"original","quote":"权称尊号〖10〗","section_title":"潘濬陆凯传第十六","source":{"file":"OEBPS/Text/titlepage_0129.xhtml","index":4,"anchor":null},"note_id":null,"start":0,"end":8},{"id":"santizhu059-q-35be8287455e56599f63","section":"chapter-059","block":"b-91e8cecd70f6f0423363","layer":"original","quote":"黄龙元年，权称尊号，立为皇太子。以恪为左辅〖14〗，休右弼；谭为辅正，表为翼正都尉：是为“四友”。而谢景、范慎、刁玄、羊衜等，皆为宾客。﹝一﹞于是东宫号为多士","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":5,"anchor":null},"note_id":null,"start":0,"end":79},{"id":"santizhu059-q-6363347a540d2d9170bb","section":"chapter-059","block":"b-df588cafb2f961735039","layer":"original","quote":"权欲登读《汉书》，习知近代之事。以张昭有师法〖5〗，重烦劳之〖6〗；乃令休从昭受读〖7〗，还以授登","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":3,"anchor":null},"note_id":null,"start":0,"end":49},{"id":"santizhu059-q-6e995c73673dbd70d0c9","section":"chapter-059","block":"b-812b635bdb003f1dd7f3","layer":"original","quote":"是后王夫人与全公主有隙〖1〗。权尝寝疾〖2〗，和祠祭于庙；和妃叔父张休居近庙，邀和过所居〖3〗。全公主使人觇视〖4〗，因言太子不在庙中，专就妃家计议；又言王夫人见上寝疾，有喜色。权由是发怒，夫人忧死","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":159,"anchor":null},"note_id":null,"start":0,"end":99},{"id":"santizhu059-q-e6d45d4a1d69982d86a6","section":"chapter-059","block":"b-596a36f6bf0b6112c3af","layer":"original","quote":"是岁，立登为太子。选置师傅；铨简秀士，以为宾友。于是诸葛恪、张休、顾谭、陈表等以选入〖4〗，侍讲诗书，出从骑射","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":2,"anchor":null},"note_id":null,"start":0,"end":55},{"id":"santizhu064-q-948ebe88c7631151d983","section":"chapter-064","block":"b-cc31a8020d94eea20679","layer":"original","quote":"弱冠拜骑都尉〖2〗，与顾谭、张休等，侍太子登讲论道艺〖3〗，并为宾友。从中庶子转为左辅都尉。","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":1,"anchor":null},"note_id":null,"start":22,"end":68},{"id":"shaodi-e-o013a-q","section":"chapter-004","block":"b-0cd1e6082bde64409582","layer":"original","quote":"夏五月，吴将朱然等围襄阳之樊城，太傅司马宣王率众拒之。﹝一﹞六月，辛丑〖5〗，退。己卯〖6〗，以征东将军王凌为车骑将军〖7〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":59,"anchor":null},"note_id":null,"start":0,"end":63},{"id":"shaodi-q-b-f56b355cff79244bd89c","section":"chapter-004","block":"b-f56b355cff79244bd89c","layer":"modern","quote":"〖1〗二年：正始二年（公元 241）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":62,"anchor":null},"note_id":"n-bf9ccbeb544f540e6afb","start":0,"end":19},{"id":"shaodi-q-o012","section":"chapter-004","block":"b-33e60ac0c003858f0640","layer":"original","quote":"二年春二月〖1〗，帝初通《论语》〖2〗。使太常以太牢祭孔子于辟雍〖3〗，以颜渊配〖4〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":58,"anchor":null},"note_id":null,"start":0,"end":44},{"id":"wgc-q0005","section":"chapter-028","block":"b-280a1e8d1f852b5e78af","layer":"original","quote":"二年〖1〗，吴大将全琮数万众寇芍陂〖2〗。凌率诸军逆讨，与贼争塘，力战连日，贼退走。进封南乡侯，邑千三百五十户；迁车骑将军，仪同三司。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":21,"anchor":null},"note_id":null,"start":0,"end":67},{"id":"wgc-q0101","section":"chapter-028","block":"b-7350e34eaab803d02ca2","layer":"pei","quote":"臣等先人，皆随从太祖武皇帝征讨凶暴，获成大功；与高祖文皇帝即受汉禅，开国承家，犹尧、舜相传也。臣与安丰护军郑翼、庐江护军吕宣、太守张休、淮南太守丁尊、督守合肥护军王休等议，各以累世受恩，千载风尘，思尽躯命，以完全社稷安主为效。斯义苟立，虽焚妻子，吞炭漆身，死而不恨也。按师之罪，宜加大辟，以彰奸慝。《春秋》之义，一世为善，十世宥之；懿有大功，海内所书。依古典议：废师，以侯就第。弟昭，忠肃宽明，乐善好士，有高世君子之度，忠诚为国，不与师同。臣等碎首所保，可以代师辅导圣躬。太尉孚，忠孝小心，所宜亲宠，授以保、傅。护军、散骑常侍望，忠公亲事，当官称能，远迎乘舆，有宿卫之功，可为中领军。《春秋》之义，大义灭亲。故周公诛弟，石碏戮子，季友鸩兄；上为国计，下全宗族。殛鲧用禹，圣人明典，古今所称。乞陛下：下臣等所奏，朝堂博议。臣言当道，使师逊位避贤者，罢兵去备，如三皇旧法，则天下协同；若师负势恃众不自退者，臣等率将所领，昼夜兼行，惟命是授。","attribution":"毌丘俭文钦表","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":119,"anchor":null},"note_id":"n-6d2d8c49ddd3275ba483","start":0,"end":418},{"id":"wgc-q0159","section":"chapter-028","block":"b-280a1e8d1f852b5e78af","layer":"original","quote":"吴大将全琮数万众寇芍陂〖2〗。凌率诸军逆讨，与贼争塘，力战连日，贼退走","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":21,"anchor":null},"note_id":null,"start":6,"end":41},{"id":"wuzhu-e-o133b-q","section":"chapter-047","block":"b-8af6f7908a818f7cd9b1","layer":"original","quote":"琮与魏将王凌，战于芍陂；中郎将秦晃等十余人，战死。车骑将军朱然围樊，大将军诸葛瑾取柤中〖15〗。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":168,"anchor":null},"note_id":null,"start":56,"end":104},{"id":"wuzhu-q-o132","section":"chapter-047","block":"b-339340f557e9065aedfa","layer":"original","quote":"四年春正月〖10〗，大雪，平地深三尺，鸟兽死者太半。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":167,"anchor":null},"note_id":null,"start":0,"end":26},{"id":"zhanggu-q-0436ab4fab48307232e3","section":"chapter-052","block":"b-125f1c811c0beb60a9de","layer":"original","quote":"休字叔嗣。弱冠与诸葛恪、顾谭等俱为太子登僚友〖14〗，以《汉书》授登；﹝三﹞从中庶子转为右弼都尉〖15〗。权常游猎，迨暮乃归〖16〗。休上疏谏戒，权大善之，以示于昭。及登卒后，为侍中；拜羽林都督〖17〗，平三典军事〖18〗。迁扬武将军。","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":95,"anchor":null},"note_id":null,"start":0,"end":118},{"id":"zhanggu-q-15beb61d3a1fa38d0cf0","section":"chapter-052","block":"b-125f1c811c0beb60a9de","layer":"original","quote":"权常游猎，迨暮乃归〖16〗。休上疏谏戒，权大善之，以示于昭。及登卒后，为侍中；拜羽林都督〖17〗，平三典军事〖18〗。迁扬武将军","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":95,"anchor":null},"note_id":null,"start":53,"end":117},{"id":"zhanggu-q-2113b80d6f9f8a3da0c7","section":"chapter-052","block":"b-027aa53bd5dbba95ebf6","layer":"original","quote":"时长公主婿卫将军全琮子寄，为霸宾客〖19〗；寄素倾邪〖20〗，谭所不纳。先是，谭弟承与张休俱北征寿春，全琮时为大都督；与魏将王凌战于芍陂，军不利，魏兵乘胜陷没五营将秦（儿）〔晃〕军；休、承奋击之，遂驻魏师〖21〗。时琮群子绪、端，亦并为将，因敌既驻，乃进击之：凌军用退","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":197,"anchor":null},"note_id":null,"start":0,"end":134},{"id":"zhanggu-q-23a17f954aec89d98b81","section":"chapter-052","block":"b-0ccf265f45e5a3e57842","layer":"original","quote":"中书令孙弘佞伪险诐〖21〗，休素所忿。﹝四﹞弘因是谮诉〖22〗，下诏书赐休死，时年四十一","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":96,"anchor":null},"note_id":null,"start":53,"end":97},{"id":"zhanggu-q-3daa3c56b9872fdc7a53","section":"chapter-052","block":"b-60fc7c60c8160373a740","layer":"original","quote":"评曰：张昭受遗辅佐，功勋克举；忠謇方直，动不为己。而以严见惮〖1〗，以高见外；既不处宰相，又不登师保〖2〗；从容闾巷〖3〗，养老而已：以此明权之不及策也！顾雍依仗素业〖4〗，而将之智局〖5〗：故能究极荣位。诸葛瑾、步骘，并以德度规检，见器当世〖6〗；张承、顾邵，虚心长者，好尚人物；周昭之论，称之甚美：故详录焉。谭献纳在公，有忠贞之节；休、承修志，咸庶为善；爱恶相攻〖7〗，流播南裔〖8〗：哀哉！","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":519,"anchor":null},"note_id":null,"start":0,"end":198},{"id":"zhanggu-q-8efdeacaedbf5b3118a2","section":"chapter-052","block":"b-efd7f2714884a69f9b1d","layer":"pei","quote":"休进授，指摘文义，分别事物，并有章条。每升堂宴饮，酒酣乐作，登辄降意与同欢乐。休为人解达；登甚爱之，常在左右","attribution":"裴注·吴书","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":123,"anchor":null},"note_id":"n-6abc50b2cf47e6767b4b","start":10,"end":64},{"id":"zhanggu-q-a1c1612ad282c0f79b27","section":"chapter-052","block":"b-cde85c9c0e9765bc5163","layer":"original","quote":"长子承，已自封侯；少子休，袭爵","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":89,"anchor":null},"note_id":null,"start":0,"end":15},{"id":"zhanggu-q-c717b14f5045b93be823","section":"chapter-052","block":"b-125f1c811c0beb60a9de","layer":"original","quote":"休字叔嗣。弱冠与诸葛恪、顾谭等俱为太子登僚友〖14〗，以《汉书》授登；﹝三﹞从中庶子转为右弼都尉","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":95,"anchor":null},"note_id":null,"start":0,"end":48},{"id":"zhanggu-q-d0dbbb7f5888a03c83db","section":"chapter-052","block":"b-6eb0af4c477f92dd3257","layer":"pei","quote":"﹝三﹞《吴录》曰：“全琮父子屡言：‘芍陂之役，为典军陈恂诈增张休、顾承之功，而休、承与恂通情。’休坐系狱；权为谭故，沉吟不决，欲令谭谢而释之。及大会，以问谭；谭不谢，而曰：‘陛下，谗言其兴乎？’”","attribution":"裴注·吴录","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":234,"anchor":null},"note_id":"n-0e9e6cb7871c9e632d55","start":0,"end":98},{"id":"zhanggu-q-d8d548abae9ff752f208","section":"chapter-052","block":"b-27c78b18246ae3b6bd51","layer":"original","quote":"数年，与兄谭、张休等，俱徙交州。年三十七卒","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":200,"anchor":null},"note_id":null,"start":0,"end":21},{"id":"zhanggu-q-d95ac6b70220ae016119","section":"chapter-052","block":"b-0ccf265f45e5a3e57842","layer":"original","quote":"为鲁王霸友党所谮，与顾谭、承俱以“芍陂论功事〖19〗，休、承与典军陈恂通情，诈增其伐〖20〗”，并徙交州","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":96,"anchor":null},"note_id":null,"start":0,"end":52}],"profiles":{"wgc-p0072":{"fields":[{"id":"wgc-p0072-directory-courtesy","key":"courtesy","label":"字","text":"叔嗣","evidence":["zhanggu-q-c717b14f5045b93be823"]}],"directory":{"faction":"wu"}}},"directory_counts":{}}
