ec17e","hancui-q-30ef1176b0da05abd569","hancui-q-ec6bb026d3bff1bc251e"],"facts":[{"id":"hancui-f-97713c192c7c376c9072","text":"字德儒，清河东武城人；崔琰为其从兄。","evidence":["hancui-q-ec6bb026d3bff1bc251e"]}],"aliases":[],"mentions":[{"id":"mingdi-m-o065-mingdi-p0053","kind":"mention","text":"文中提及","evidence":["mingdi-q-o065"]},{"id":"mingdi-m-p030-mingdi-p0053","kind":"mention","text":"文中提及","evidence":["mingdi-q-p030"]},{"id":"shaodi-m-o026-mingdi-p0053","kind":"mention","text":"文中提及","evidence":["shaodi-q-o026"]}]}],"evidence":[{"id":"cuimao-q-1f4a0e63b07fa40868d3","section":"chapter-012","block":"b-506a3916ecaea0880e7a","layer":"pei","quote":"明帝时，崔林尝与司空陈群，共论冀州人士，称琰为首","attribution":"裴注·《魏略》","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":94,"anchor":null},"note_id":"n-c7e3a366aa59b57e9552","start":10,"end":34},{"id":"cuimao-q-505c454253ac410d5358","section":"chapter-012","block":"b-510c6e1e3f077d574c36","layer":"original","quote":"琰从弟林，少无名望；虽姻族，犹多轻之。而琰常曰：“此所谓大器晚成者也，终必远至","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":69,"anchor":null},"note_id":null,"start":72,"end":111},{"id":"cuimao-q-8e2c68709eb3b73f5020","section":"chapter-012","block":"b-506a3916ecaea0880e7a","layer":"pei","quote":"群以‘智不存身’贬之。林曰：‘大丈夫为有邂逅耳！即如卿诸人，良足贵乎","attribution":"裴注·《魏略》","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":94,"anchor":null},"note_id":"n-c7e3a366aa59b57e9552","start":35,"end":69},{"id":"cuimao-q2-caa2909299c779e56679","section":"chapter-012","block":"b-506a3916ecaea0880e7a","layer":"pei","quote":"﹝四﹞《魏略》曰：“明帝时，崔林尝与司空陈群，共论冀州人士，称琰为首。群以‘智不存身’贬之。林曰：‘大丈夫为有邂逅耳！即如卿诸人，良足贵乎？’”","attribution":"裴注（引书见原文）","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":94,"anchor":null},"note_id":"n-c7e3a366aa59b57e9552","start":0,"end":72},{"id":"hancui-q-24384af5b12c85b10d77","section":"chapter-024","block":"b-295376bea6b0350e9a27","layer":"original","quote":"明帝即位，赐爵关内侯，转光禄勋，司隶校尉。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":77,"anchor":null},"note_id":null,"start":0,"end":21},{"id":"hancui-q-25af6afd313a5069383e","section":"chapter-024","block":"b-74fce0f98849d3b3d185","layer":"original","quote":"后年，遂为司空，封安阳亭侯，邑六百户。三公封列侯，自林始也。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":81,"anchor":null},"note_id":null,"start":0,"end":30},{"id":"hancui-q-30ef1176b0da05abd569","section":"chapter-024","block":"b-d9eebab382f9031831f0","layer":"original","quote":"出为幽州刺史。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":44,"anchor":null},"note_id":null,"start":9,"end":16},{"id":"hancui-q-3389e490c7380ecf34b9","section":"chapter-024","block":"b-052318a44f11fc04586f","layer":"original","quote":"景初元年，司徒、司空并缺，散骑侍郎孟康荐林曰：“夫宰相者〖15〗，天下之所瞻效；诚宜得秉忠履正本德仗义之士，足为海内所师表者。窃见司隶校尉崔林，禀自然之正性，体高雅之弘量。论其所长以比古人：忠直不回，则史鱼之俦〖16〗；清俭守约，则季文之匹也〖17〗。牧守州郡，所在而治；及为外司〖18〗，万里肃齐〖19〗；减台辅之妙器〖20〗，衮职之良才也〖21〗。”","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":80,"anchor":null},"note_id":null,"start":0,"end":177},{"id":"hancui-q-440874d4b22076576045","section":"chapter-024","block":"b-4e320573057b8c6254e9","layer":"original","quote":"正始五年，薨，谥曰孝侯。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":110,"anchor":null},"note_id":null,"start":0,"end":12},{"id":"hancui-q-4fbb66784b9b4f0efcbf","section":"chapter-024","block":"b-295376bea6b0350e9a27","layer":"original","quote":"属郡皆罢非法除过员吏〖1〗。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":77,"anchor":null},"note_id":null,"start":21,"end":35},{"id":"hancui-q-50cf8044c42b345e6b3b","section":"chapter-024","block":"b-e37e4fdc34ad6437711c","layer":"pei","quote":"初，林识拔同郡王经于民伍之中，卒为名士。世以此称之。","attribution":"裴注·晋诸公赞","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":135,"anchor":null},"note_id":"n-a397b652c52bb61c4e90","start":65,"end":91},{"id":"hancui-q-60813447cf47bcb07154","section":"chapter-024","block":"b-d9eebab382f9031831f0","layer":"original","quote":"北中郎将吴质统河北军事〖8〗，涿郡太守王雄谓林别驾曰：“吴中郎将，上所亲重〖9〗，国之贵臣也。仗节统事〖10〗，州郡莫不奉笺致敬，而崔使君初不与相闻〖11〗。若以边塞不修斩卿，使君宁能护卿邪？”","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":44,"anchor":null},"note_id":null,"start":16,"end":113},{"id":"hancui-q-6d211796e3eeb0dee898","section":"chapter-024","block":"b-5084d3acfa7140382e55","layer":"original","quote":"别驾具以白林，林曰：“刺史视去此州如脱屣〖12〗，宁当相累邪〖13〗？此州与胡虏接，宜镇之以静；扰之则动其逆心，特为国家生北顾忧，以此为寄〖14〗。”在官一期〖15〗，寇窃寝息；﹝一﹞犹以不事上司〖16〗，左迁河间太守。清论多为林怨也〖17〗。﹝二﹞","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":45,"anchor":null},"note_id":null,"start":0,"end":125},{"id":"hancui-q-774b13927850cb8a89af","section":"chapter-024","block":"b-cf65fb98737c28d1d756","layer":"original","quote":"太祖定冀州，召除邬长〖4〗；贫无车马，单步之官〖5〗。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":43,"anchor":null},"note_id":null,"start":0,"end":27},{"id":"hancui-q-8909b324ac052009d0ce","section":"chapter-024","block":"b-317362d4f3072ba551dc","layer":"original","quote":"林议曰：“案《周官》考课〖2〗，其文备矣；自康王以下〖3〗，遂以陵迟〖4〗，此即考课之法存乎其人也〖5〗。及汉之季〖6〗，其失岂在乎佐吏之职不密哉？方今军旅，或猥或猝〖7〗；备之以科条，申之以内外；增减无常，固难一矣。且万目不张举其纲，众毛不整振其领。皋陶仕虞〖8〗，伊尹臣殷〖9〗，不仁者远。五帝、三王未必如一，而各以治乱。《易》曰：‘易简〖10〗，而天下之理得矣。’太祖随宜设辟〖11〗，以遗来今，不患不法古也。以为今之制度，不为疏阔〖12〗，惟在守一勿失而已。若朝臣能任仲山甫之重〖13〗，‘式是百辟〖14〗’，则孰敢不肃？”","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":79,"anchor":null},"note_id":null,"start":0,"end":266},{"id":"hancui-q-8ca3db9c6a15b87ec17e","section":"chapter-024","block":"b-d9eebab382f9031831f0","layer":"original","quote":"文帝践阼，拜尚书。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":44,"anchor":null},"note_id":null,"start":0,"end":9},{"id":"hancui-q-9bc6393060972e742e0b","section":"chapter-024","block":"b-79edcd7298f3d52b0257","layer":"pei","quote":"﹝一﹞臣松之以为：汉封丞相邑，为荀悦所讥；魏封三公，其失同也。","attribution":"裴注·裴松之评论","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":105,"anchor":null},"note_id":"n-90491e541dbabf9c6065","start":0,"end":31},{"id":"hancui-q-a362fd2fcc5def4ead6c","section":"chapter-024","block":"b-74fce0f98849d3b3d185","layer":"original","quote":"顷之，又进封安阳乡侯。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":81,"anchor":null},"note_id":null,"start":33,"end":44},{"id":"hancui-q-a90cd01de48db37c2020","section":"chapter-024","block":"b-a95417fd50b34fdb3de2","layer":"original","quote":"林议以为：“宗圣侯亦以王命祀，不为未有命也。周武王封黄帝、尧、舜之后〖13〗，及立三恪〖14〗；禹、汤之世〖15〗，不列于时，复特命他官祭也。今周公以上〖16〗，达于三皇〖17〗，忽焉不祀，而其礼经亦存其言〖18〗；今独祀孔子者，以世近故也。以大夫之后〖19〗，特受无疆之祀〖20〗；礼过古帝，义逾汤、武。可谓崇明报德矣，无复重祀于非族也〖21〗。”﹝一﹞","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":108,"anchor":null},"note_id":null,"start":0,"end":178},{"id":"hancui-q-acf8710510b3b772555a","section":"chapter-024","block":"b-17550ad301cf38d67635","layer":"pei","quote":"﹝二﹞《魏名臣奏》载侍中辛毗奏曰：“昔桓阶为尚书令，以崔林非尚书才，迁以为河间太守。”与此传不同。","attribution":"裴注·魏名臣奏·辛毗奏","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":76,"anchor":null},"note_id":"n-cbbf4911c0987174013d","start":0,"end":49},{"id":"hancui-q-b3c58a342c48a9187281","section":"chapter-024","block":"b-f9faf0e3543fd84c0775","layer":"original","quote":"鲁相上言：“汉旧立孔子庙〖1〗，褒成侯岁时奉祠〖2〗；辟雍行礼〖3〗，必祭先师；王家出谷〖4〗，春秋祭祀。今宗圣侯奉嗣〖5〗，未有命祭之礼〖6〗；宜给牲牢〖7〗，长吏奉祀，尊为贵神。”制三府议。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":106,"anchor":null},"note_id":null,"start":0,"end":97},{"id":"hancui-q-d29bae2c4129fbdf68c8","section":"chapter-024","block":"b-b5dbe24a58e2150a9108","layer":"original","quote":"博士傅祗以“《春秋》传言立在祀典〖8〗，则孔子是也。宗圣适足继绝世〖9〗，彰盛德耳〖10〗；至于显立言〖11〗，崇明德〖12〗，则宜如鲁相所上。”","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":107,"anchor":null},"note_id":null,"start":0,"end":73},{"id":"hancui-q-d2eaeb869a1d64bcb306","section":"chapter-024","block":"b-cf65fb98737c28d1d756","layer":"original","quote":"徙署别驾、丞相掾属。魏国既建，稍迁御史中丞〖7〗。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":43,"anchor":null},"note_id":null,"start":63,"end":88},{"id":"hancui-q-dbef3a9a803e74c54d15","section":"chapter-024","block":"b-cf65fb98737c28d1d756","layer":"original","quote":"太祖征壶关〖6〗，问长吏德政最者，并州刺史张陟以林对；于是擢为冀州主簿。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":43,"anchor":null},"note_id":null,"start":27,"end":63},{"id":"hancui-q-dc15ead35d4031ada361","section":"chapter-024","block":"b-03292772724d0c648cad","layer":"original","quote":"迁大鸿胪〖18〗。龟兹王遣侍子宋朝〖19〗，朝廷嘉其远至，褒赏其王甚厚。余国各遣子来朝，间使连属〖20〗。林恐所遣或非真的〖21〗，权取疏属贾胡〖22〗，因通使命，利得印绶〖23〗；而道路护送，所损滋多；劳所养之民，资无益之事，为夷狄所笑。此曩时之所患也〖24〗。乃移书敦煌喻指〖25〗，并录前世待遇诸国丰约故事，使有恒常。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":46,"anchor":null},"note_id":null,"start":0,"end":162},{"id":"hancui-q-ec6bb026d3bff1bc251e","section":"chapter-024","block":"b-ff0d28ef7bbf73837201","layer":"original","quote":"崔林字德儒，清河东武城人也〖1〗。少时晚成〖2〗，宗族莫知，惟从兄琰异之〖3〗。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":42,"anchor":null},"note_id":null,"start":0,"end":40},{"id":"hancui-q-f3e0a53500861d874806","section":"chapter-024","block":"b-2d2985d7613a788051e9","layer":"pei","quote":"﹝一﹞臣松之以为：孟轲称宰我之辞曰：“以予观夫子，贤于尧舜远矣！”又曰：“生民以来，未有盛于孔子者也。”斯非通贤之格言，商较之定准乎！虽妙极则同，万圣犹一；然淳薄异时，质文殊用；或当时则荣，没则已焉；是以遗风所被，实有深浅。若乃经纬天人，立言垂制；百王莫之能违，彝伦资之以立：诚一人而已耳！周监二代，斯文为盛。然于六经之道，未能及其精致。加以圣贤不兴，旷年五百，道化陵夷，宪章殆灭；若使时无孔门，则周典几乎息矣。夫能光明先王之道，以成万世之功；齐天地之无穷，等日月之久照：岂不有逾于群圣哉？林，曾无史迁洞想之诚，梅真慷慨之志，而守其蓬心以塞明义，可谓多见其不知量也。","attribution":"裴注·裴松之评论","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":134,"anchor":null},"note_id":"n-6ef6eb809e465ce950a4","start":0,"end":283},{"id":"hechang-q-c5436243046046ce9ad9","section":"chapter-023","block":"b-d3e70b7777a5c7fad254","layer":"pei","quote":"﹝一﹞《魏略》曰：“林性既清白，当官又严。少府寺与鸿胪对门，时崔林为鸿胪。崔性阔达，不与林同；数数闻林挝吏声，不以为可。林夜挝吏，不胜痛，叫呼敖敖，彻曙。明日，崔出门，与林车相遇，乃啁林曰：‘闻卿为廷尉，尔邪？’林不觉，答曰：‘不也。’崔曰：‘卿不为廷尉，昨夜何故考囚乎？’林大惭，然不能自止。”","attribution":"裴注·魏略","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":137,"anchor":null},"note_id":"n-17ae8294c3594dd7da78","start":0,"end":148},{"id":"huanchen-q-0eead8a94bea2511cebc","section":"chapter-022","block":"b-34d411f478d6319156f9","layer":"original","quote":"会司徒缺，毓举处士管宁〖28〗；帝不能用，更问其次。毓对曰：“敦笃至行〖29〗，则太中大夫韩暨〖30〗；亮直清方，则司隶校尉崔林〖31〗；贞固纯粹，则太常常林〖32〗。”帝乃用暨","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":545,"anchor":null},"note_id":null,"start":0,"end":89},{"id":"mingdi-e-o065a-q","section":"chapter-003","block":"b-7fe896f4b9a9286dc45d","layer":"original","quote":"壬午〖14〗，以司空卫臻为司徒，司隶校尉崔林为司空〖15〗。闰月〔癸丑〕〖16〗，月犯心中央大星。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":460,"anchor":null},"note_id":null,"start":0,"end":49},{"id":"mingdi-e-p030a-q","section":"chapter-003","block":"b-fc3b2373ccedc94baa04","layer":"pei","quote":"“帝变服，率群臣哭之。使使持节、行司徒、太常和洽吊祭，又使持节、行大司空、大司农崔林监护丧事。诏曰：‘盖五帝之事尚矣！仲尼盛称尧、舜巍巍荡荡之功者，以为禅代乃大圣之懿事也。山阳公深识天禄永终之运，禅位文皇帝以顺天命。先帝命公行汉正朔，郊天祀祖以天子之礼，言事不称“臣”，此舜事尧之义也。昔放勋殂落，四海如丧考妣，遏密八音；明丧葬之礼，同于王者也。今有司奏丧礼比诸侯王，此岂古之遗制而先帝之至意哉？今谥公“汉孝献皇帝”。’","attribution":"裴注·献帝传","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":263,"anchor":null},"note_id":"n-577bfabc3a4642d33616","start":0,"end":210},{"id":"mingdi-q-b-78ee587f18f11aa30bd9","section":"chapter-003","block":"b-78ee587f18f11aa30bd9","layer":"modern","quote":"〖1〗二年：景初二年（公元 238 ）。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":438,"anchor":null},"note_id":"n-917b5dc4aecce5a0dcf4","start":0,"end":20},{"id":"mingdi-q-b-7a11c761ca65aeb3d195","section":"chapter-003","block":"b-7a11c761ca65aeb3d195","layer":"modern","quote":"〖1〗二年：青龙二年（公元 234）。己未：旧历初四日。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":252,"anchor":null},"note_id":"n-6c0753fe684a18a3a281","start":0,"end":28},{"id":"mingdi-q-o037","section":"chapter-003","block":"b-ff97c2d326d0fc08a9de","layer":"original","quote":"二年春二月，（乙）〔己〕未〖1〗，太白犯荧惑。癸酉〖2〗，诏曰：“‘鞭作官刑〖3〗’，所以纠慢怠也〖4〗；而顷多以无辜死。其减鞭杖之制〖5〗，著于令。”三月，庚寅〖6〗，山阳公薨；帝素服发哀〖7〗，遣使持节，典护丧事。己酉〖8〗，大赦。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":249,"anchor":null},"note_id":null,"start":0,"end":118},{"id":"mingdi-q-o059","section":"chapter-003","block":"b-5790b2efe14805978c50","layer":"original","quote":"二年春正月〖1〗，诏太尉司马宣王。率众讨辽东。﹝一﹞","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":434,"anchor":null},"note_id":null,"start":0,"end":26},{"id":"mingdi-q-o065","section":"chapter-003","block":"b-7fe896f4b9a9286dc45d","layer":"original","quote":"壬午〖14〗，以司空卫臻为司徒，司隶校尉崔林为司空〖15〗。闰月〔癸丑〕〖16〗，月犯心中央大星。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":460,"anchor":null},"note_id":null,"start":0,"end":49},{"id":"mingdi-q-p030","section":"chapter-003","block":"b-fc3b2373ccedc94baa04","layer":"pei","quote":"“帝变服，率群臣哭之。使使持节、行司徒、太常和洽吊祭，又使持节、行大司空、大司农崔林监护丧事。诏曰：‘盖五帝之事尚矣！仲尼盛称尧、舜巍巍荡荡之功者，以为禅代乃大圣之懿事也。山阳公深识天禄永终之运，禅位文皇帝以顺天命。先帝命公行汉正朔，郊天祀祖以天子之礼，言事不称“臣”，此舜事尧之义也。昔放勋殂落，四海如丧考妣，遏密八音；明丧葬之礼，同于王者也。今有司奏丧礼比诸侯王，此岂古之遗制而先帝之至意哉？今谥公“汉孝献皇帝”。’","attribution":"裴注·献帝传","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":263,"anchor":null},"note_id":"n-577bfabc3a4642d33616","start":0,"end":210},{"id":"shaodi-e-o026c-q","section":"chapter-004","block":"b-54b33a41b7fb2d927aae","layer":"original","quote":"冬十一月，癸卯〖19〗，诏祀故尚书令荀攸于太祖庙庭。﹝一﹞己酉〖20〗，复秦国为京兆郡〖21〗。十二月，司空崔林薨〖22〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":82,"anchor":null},"note_id":null,"start":0,"end":62},{"id":"shaodi-q-b-7eb87839c414a706f2aa","section":"chapter-004","block":"b-7eb87839c414a706f2aa","layer":"modern","quote":"〖13〗五年：正始五年（公元 244）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":96,"anchor":null},"note_id":"n-f0539e2dfb395a33b142","start":0,"end":20},{"id":"shaodi-q-o022","section":"chapter-004","block":"b-93d5da2e078d5ca12eb0","layer":"original","quote":"五年春二月〖13〗，诏大将军曹爽率众征蜀。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":78,"anchor":null},"note_id":null,"start":0,"end":21},{"id":"shaodi-q-o026","section":"chapter-004","block":"b-54b33a41b7fb2d927aae","layer":"original","quote":"冬十一月，癸卯〖19〗，诏祀故尚书令荀攸于太祖庙庭。﹝一﹞己酉〖20〗，复秦国为京兆郡〖21〗。十二月，司空崔林薨〖22〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":82,"anchor":null},"note_id":null,"start":0,"end":62}],"profiles":{},"directory_counts":{}}
