{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o001b","title":"曹嵩袭爵并官至太尉","accounts":[{"id":"wudi-e-o001b-account","label":"正文","text":"曹腾养子曹嵩袭爵，官至太尉。","evidence":["wudi-e-o001b-q"]}],"participants":[{"person":"wudi-p0003","role":"袭爵任官","evidence":["wudi-e-o001b-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-o001b-q"]},"source_order":[1,2,"O001b"],"order":2},{"id":"wudi-e-p004a","title":"曹嵩历任朝官","accounts":[{"id":"wudi-e-p004a-account","label":"《续汉书》","text":"曹嵩曾任司隶校尉，灵帝擢拜其为大司农、大鸿胪，后代崔烈为太尉。","evidence":["wudi-e-p004a-q"]}],"participants":[{"person":"wudi-p0003","role":"任官","evidence":["wudi-e-p004a-q"]},{"person":"wudi-p0025","role":"擢拜","evidence":["wudi-e-p004a-q"]},{"person":"wudi-p0026","role":"被接任","evidence":["wudi-e-p004a-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p004a-q"]},"source_order":[1,16,"P004a"],"order":9},{"id":"wudi-e-p004b","title":"曹嵩被追尊太皇帝","accounts":[{"id":"wudi-e-p004b-account","label":"《续汉书》","text":"《续汉书》记黄初元年追尊曹嵩为太皇帝。","evidence":["wudi-e-p004b-q"]}],"participants":[{"person":"wudi-p0003","role":"被追尊","evidence":["wudi-e-p004b-q"]}],"place":null,"time":{"label":"黄初元年","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p004b-q"]},"source_order":[1,16,"P004b"],"order":10},{"id":"wudi-e-p006a","title":"曹操佯病离间父叔","accounts":[{"id":"wudi-e-p006a-account","label":"《曹瞒传》","text":"《曹瞒传》记曹操佯装中风，使父亲曹嵩不再相信叔父对他的告诫。","evidence":["wudi-e-p006a-q"]}],"participants":[{"person":"cao-cao","role":"佯病","evidence":["wudi-e-p006a-q"]},{"person":"wudi-p0003","role":"听信其说","evidence":["wudi-e-p006a-q"]}],"place":null,"time":{"label":"曹操少年时","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p006a-q"]},"source_order":[1,32,"P006a"],"order":14},{"id":"wudi-e-o028b","title":"曹嵩避难后遇害","accounts":[{"id":"wudi-e-o028b-account","label":"正文","text":"正文回叙曹嵩去官归谯，董卓之乱时避难琅邪，并将其遇害归于陶谦。","evidence":["wudi-e-o028b-q"]}],"participants":[{"person":"wudi-p0003","role":"避难遇害","evidence":["wudi-e-o028b-q"]},{"person":"wudi-p0095","role":"正文所指加害者","evidence":["wudi-e-o028b-q"]}],"place":{"text":"谯、琅邪","evidence":["wudi-e-o028b-q"]},"time":{"label":"曹操东征复仇之前","precision":"relative","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-o028b-q"]},"source_order":[1,205,"O028b"],"order":96},{"id":"wudi-e-p039a","title":"曹嵩遇害的两种裴注记载","accounts":[{"id":"wudi-e-p039a-account","label":"《世语》、韦曜《吴书》","text":"《世语》称陶谦遣骑袭曹嵩家，曹德等俱死；《吴书》称护送的张闿杀曹嵩取财。两种叙述分别保留。","evidence":["wudi-e-p039a-q"]}],"participants":[{"person":"wudi-p0003","role":"遇害","evidence":["wudi-e-p039a-q"]},{"person":"wudi-p0104","role":"《世语》记被杀","evidence":["wudi-e-p039a-q"]},{"person":"wudi-p0103","role":"《世语》记未及迎送","evidence":["wudi-e-p039a-q"]},{"person":"wudi-p0095","role":"两说所涉","evidence":["wudi-e-p039a-q"]},{"person":"wudi-p0105","role":"《吴书》记杀人取财","evidence":["wudi-e-p039a-q"]}],"place":{"text":"泰山华、费之间","evidence":["wudi-e-p039a-q"]},"time":{"label":"曹操征陶谦之前","precision":"relative","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p039a-q"]},"source_order":[1,216,"P039a"],"order":98},{"id":"gongsuntao-e-o187","title":"曹公父于泰山被杀归咎谦曹公表罢州郡兵","accounts":[{"id":"gongsuntao-a-1ee79436e6ed82580281","label":"裴注·吴书","text":"曹公父于泰山被杀归咎谦曹公表罢州郡兵","evidence":["gongsuntao-q-0b3d7d83c03f9c86856e"]}],"participants":[{"person":"wudi-p0003","role":"于泰山被杀","evidence":["gongsuntao-q-0b3d7d83c03f9c86856e"]},{"person":"cao-cao","role":"归咎于谦、欲伐谦而畏其强、乃表令州郡一时罢兵","evidence":["gongsuntao-q-0b3d7d83c03f9c86856e"]},{"person":"wudi-p0095","role":"被归咎者","evidence":["gongsuntao-q-0b3d7d83c03f9c86856e"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["gongsuntao-q-0b3d7d83c03f9c86856e"]},"ordering_evidence":"gongsuntao-q-0b3d7d83c03f9c86856e","source_order":[8,141,10],"order":1998}],"persons":[{"id":"wudi-p0003","name":"曹嵩","evidence":["wudi-q-o001","wendi-q-o007","mingdi-q-o016","dongyuan-q-p078","gongsuntao-q-0b3d7d83c03f9c86856e"],"facts":[{"id":"wudi-f-p004-wudi-p0003-c55038","label":"字","text":"巨高","evidence":["wudi-q-p004"]},{"id":"wudi-f-p005-wudi-p0003-d47376","label":"出身记载","text":"《曹瞒传》《世语》称曹嵩出自夏侯氏；正文则称其生出本末不能审明。","evidence":["wudi-q-p005"]}],"aliases":[{"text":"巨高","evidence":["wudi-q-p004"]}],"mentions":[{"id":"wudi-m-o001-wudi-p0003","kind":"mention","text":"文中提及","evidence":["wudi-q-o001"]},{"id":"wudi-m-p004-wudi-p0003","kind":"mention","text":"文中提及","evidence":["wudi-q-p004"]},{"id":"wudi-m-p005-wudi-p0003","kind":"mention","text":"文中提及","evidence":["wudi-q-p005"]},{"id":"wudi-m-o002-wudi-p0003","kind":"mention","text":"文中提及","evidence":["wudi-q-o002"]},{"id":"wudi-m-p006-wudi-p0003","kind":"mention","text":"文中提及","evidence":["wudi-q-p006"]},{"id":"wudi-m-o028-wudi-p0003","kind":"mention","text":"文中提及","evidence":["wudi-q-o028"]},{"id":"wudi-m-p039-wudi-p0003","kind":"mention","text":"文中提及","evidence":["wudi-q-p039"]},{"id":"wendi-m-o007-wudi-p0003","kind":"mention","text":"文中提及","evidence":["wendi-q-o007"]},{"id":"wendi-m-o015-wudi-p0003","kind":"mention","text":"文中提及","evidence":["wendi-q-o015"]},{"id":"wendi-m-p088-wudi-p0003","kind":"allusion","text":"祖系或典故提及","evidence":["wendi-q-p088"]},{"id":"mingdi-m-o016-wudi-p0003","kind":"allusion","text":"祖系或典故提及","evidence":["mingdi-q-o016"]},{"id":"mingdi-m-p014-wudi-p0003","kind":"allusion","text":"祖系或典故提及","evidence":["mingdi-q-p014"]},{"id":"dongyuan-m-p078-wudi-p0003","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p078"]}]}],"evidence":[{"id":"dongyuan-q-p078","section":"chapter-006","block":"b-6b96931a3754c6e644e2","layer":"pei","quote":"﹝一﹞《魏氏春秋》载绍檄州郡文曰：“盖闻明主图危以制变，忠臣虑难以立权。曩者，强秦弱主，赵高执柄；专制朝命，威福由己；终有望夷之祸，污辱至今。及臻吕后，禄、产专政；擅断万机，决事省禁；下陵上替，海内寒心。于是绛侯、朱虚，兴威奋怒，诛夷逆乱，尊立太宗；故能道化兴隆，光明显融，此则大臣立权之明表也。司空曹操：祖父腾，故中常侍，与左悺、徐璜并作妖孽，饕餮放横，伤化虐民；父嵩，乞匄携养，因赃假位，舆金辇璧，输货权门，窃盗鼎司，倾覆重器。操，赘阉遗丑，本无令德，僄狡锋侠，好乱乐祸。幕府昔统鹰扬，扫夷凶逆。续遇董卓侵官暴国，于是提剑挥鼓，发命东夏。方收罗英雄，弃瑕录用，故遂与操参咨策略，谓其鹰犬之才，爪牙可任。至乃愚佻短虑，轻进易退，伤夷折衄，数丧师徒。幕府辄复分兵命锐，修完补辑，表行东郡太守、兖州刺史；被以虎文，授以偏师，奖蹙威柄，冀获秦师一克之报。而操遂乘资跋扈，肆行酷烈，割剥元元，残贤害善。故九江太守边让，英才俊逸，天下知名；以直言正色，论不阿谄；身〔首〕被枭悬之戮，妻孥受灰灭之咎。自是士林愤痛，民怨弥重；一夫奋臂，举州同声；故躬破于徐方，地夺于吕布；彷徨东裔，蹈据无所。幕府惟强干弱枝之义，且不登叛人之党，故复援旌擐甲，席卷赴征。金鼓响震，布众破沮，拯其死亡之患，复其方伯之任：是则幕府无德于兖土之民，而有大造于操也。后会銮驾东反，群虏乱政。时冀州方有北鄙之警，匪遑离局，故使从事中郎徐勋，就发遣操，使缮修郊庙，翼卫幼主。而便放志专行，胁迁省禁；卑侮王（官）〔室〕，败法乱纪；坐召三台，专制朝政；爵赏由心，刑戮在口；所爱光五宗，所恶灭三族；群谈者蒙显诛，腹议者蒙隐戮；道路以目，百僚钳口；尚书记朝会，公卿充员品而已。故太尉杨彪，历典三司，享国极位；操因睚眦，被以非罪，榜楚并兼，五毒俱至，触情放慝，不顾宪章。又议郎赵彦，忠谏直言，议有可纳，故圣朝含听，改容加锡；操欲迷夺时权，杜绝言路，擅收立杀，不俟报闻。又梁孝王，先帝母弟，坟陵尊显，松柏桑梓，犹宜恭肃；而操率将校吏士，亲临发掘，破棺裸尸，略取金宝，至令圣朝流涕，士民伤怀。又署发丘中郎将、摸金校尉，所过堕突，无骸不露。身处三公之官，而行桀虏之态；殄国虐民，毒流人鬼。加其细政苛惨，科防互设；缯缴充蹊，坑阱塞路；举手挂网罗，动足蹈机陷；是以兖、豫有无聊之民，帝都有吁嗟之怨。历观古今书籍，所载贪残虐烈无道之臣，于操为甚！幕府方诘外奸，未及整训；加意含覆，冀可弥缝。而操豺狼野心，潜苞祸谋；乃欲挠折栋梁，孤弱汉室；除灭中正，专为枭雄。往岁伐鼓北征，讨公孙瓒，强御桀逆，拒围一年。操因其未破，阴交书命，欲托助王师，以相掩袭；故引兵造河，方舟北济。会其行人发露，瓒亦枭夷；故使锋芒挫缩，厥图不果。屯据敖仓，阻河为固；乃欲以螳螂之斧，御隆车之隧。幕府奉汉威灵，折冲宇宙；长戟百万，胡骑千群；奋中黄、育、获之材，骋良弓劲弩之势；并州越太行，青州涉济、漯；大军泛黄河以角其前，荆州下宛、叶而掎其后；雷震虎步，并集虏庭；若举炎火以热飞蓬，覆沧海而沃熛炭：有何不消灭者哉！当今汉道陵迟，纲弛纪绝。操以精兵七百，围守宫阙；外称陪卫，内以拘执。惧其篡逆之祸，因斯而作：乃忠臣肝脑涂地之秋，烈士立功之会也。可不勖哉！”","attribution":"《魏氏春秋》载袁绍檄文","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":304,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ef8dfcd73c19211fc9ea","start":0,"end":1329,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-0b3d7d83c03f9c86856e","section":"chapter-008","block":"b-b003f52427451302a092","layer":"pei","quote":"曹公父，于泰山被杀，归咎于谦。欲伐谦而畏其强，乃表令州郡一时罢兵","attribution":"裴注·吴书","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":140,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-df575ef0b922cb13c6c5","start":10,"end":42,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-o016","section":"chapter-003","block":"b-7813ae24084c75e21fe4","layer":"original","quote":"初，洛阳宗庙未成，神主在邺庙。十一月，庙始成。使太常韩暨持节迎高皇帝、太皇帝、武帝、文帝神主于邺〖26〗。十二月，己丑至〖27〗，奉安神主于庙〖28〗。﹝一﹞癸卯〖29〗，大月氏王波调遣使奉献〖30〗，以调为亲魏大月氏王。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":90,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":111,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-p014","section":"chapter-003","block":"b-12b95468f927119072bb","layer":"pei","quote":"﹝一﹞臣松之按：黄初四年，“有司奏立二庙：太皇帝、大长秋与文帝之高祖共一庙；特立武帝庙，百世不毁”。今此无高祖神主，盖以亲尽毁也。此则魏初唯立亲庙，祀四室而已。至景初元年，始定七庙之制。","attribution":"裴注·裴松之按","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":123,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-37c6e74c89ba66eb8b9e","start":0,"end":93,"offset_unit":"unicode_code_point"},{"id":"wendi-q-o007","section":"chapter-002","block":"b-aff500edc4a38bf656c0","layer":"original","quote":"五月戊寅〖4〗，天子命王追尊皇祖太尉曰“太王”〖5〗，夫人丁氏曰“太王后”〖6〗；封王子叡为武德侯〖7〗。﹝三﹞是月，冯翊山贼郑甘、王照率众降〖8〗，皆封列侯。﹝四﹞酒泉黄华、张掖张进等各执太守以叛〖9〗。金城太守苏则讨进，斩之〖10〗。华降。﹝五﹞","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":40,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":125,"offset_unit":"unicode_code_point"},{"id":"wendi-q-o015","section":"chapter-002","block":"b-e41eca13a778c26b7c5f","layer":"original","quote":"黄初元年十一月，癸酉〖1〗，以河内之山阳，邑万户，奉汉帝为山阳公〖2〗；行汉正朔〖3〗；以天子之礼郊祭〖4〗；上书不称“臣”〖5〗；京都有事于太庙〖6〗，致胙〖7〗；封公之四子为列侯。追尊皇祖太王曰太皇帝，考武王曰武皇帝，尊王太后曰皇太后。赐男子爵人一级〖8〗；为父后及孝悌、力田人二级〖9〗。以汉诸侯王为崇德侯〖10〗，列侯为关中侯。以颍阴之繁阳亭为繁昌县。封爵、增位各有差。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":182,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":189,"offset_unit":"unicode_code_point"},{"id":"wendi-q-p088","section":"chapter-002","block":"b-3a9221a3c4d64ee93399","layer":"pei","quote":"﹝一﹞《魏书》曰：“辛酉，有司奏造二庙：立太皇帝庙，大长秋特进侯与高祖合祭，亲尽以次毁；特立武皇帝庙，四时享祀，为魏太祖，万载不毁也。”","attribution":"裴注·魏书","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":420,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-55fa2810a9044e8fae36","start":0,"end":68,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o001b-q","section":"chapter-001","block":"b-acdd0481f4a63ccf47c8","layer":"original","quote":"养子嵩嗣，官至太尉〖7〗；莫能审其生出本末〖8〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":1,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":73,"end":98,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o028b-q","section":"chapter-001","block":"b-fefe0240b8480efce927","layer":"original","quote":"初，太祖父嵩，去官后还谯。董卓之乱，避难琅邪〖2〗。为陶谦所害，故太祖志在复仇东伐。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":204,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":16,"end":58,"offset_unit":"unicode_code_point"},{"id":"wudi-e-p004a-q","section":"chapter-001","block":"b-e90db5467d9d5623caa7","layer":"pei","quote":"为司隶校尉。灵帝擢拜大司农、大鸿胪，代崔烈为太尉。","attribution":"《续汉书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":15,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-32f37ed50b79cc722888","start":26,"end":51,"offset_unit":"unicode_code_point"},{"id":"wudi-e-p004b-q","section":"chapter-001","block":"b-e90db5467d9d5623caa7","layer":"pei","quote":"黄初元年，追尊嵩曰太皇帝。","attribution":"《续汉书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":15,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-32f37ed50b79cc722888","start":51,"end":64,"offset_unit":"unicode_code_point"},{"id":"wudi-e-p006a-q","section":"chapter-001","block":"b-0cefa3b0c2e2968fd83c","layer":"pei","quote":"﹝一﹞《曹瞒传》云：“太祖少好飞鹰走狗，游荡无度。其叔父数言之于嵩，太祖患之。后逢叔父于路，乃佯败面口。叔父怪而问其故，太祖曰：‘猝中恶风。’叔父以告嵩，嵩惊愕。呼太祖，太祖口貌如故。嵩问曰：‘叔父言汝中风，已差乎？’太祖曰：‘初不中风，但失爱于叔父，故见罔耳。’嵩乃疑焉。自后叔父有所告，嵩终不复信。太祖于是益得肆意矣。”","attribution":"《曹瞒传》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":31,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a493b9d4ce2760e7585c","start":0,"end":163,"offset_unit":"unicode_code_point"},{"id":"wudi-e-p039a-q","section":"chapter-001","block":"b-0bae69d5f033a4e86d7e","layer":"pei","quote":"﹝一﹞《世语》曰：“嵩在泰山华县，太祖令泰山太守应劭，送家诣兖州。劭兵未至，陶谦密遣数千骑掩捕。嵩家以为劭迎，不设备。谦兵至，杀太祖弟德于门中。嵩惧，穿后垣，先出其妾；妾肥，不时得出。嵩逃于厕，与妾俱被害，阖门皆死。劭惧，弃官赴袁绍。后太祖定冀州，劭时已死。”韦曜《吴书》曰：“太祖迎嵩，辎重百余辆。陶谦遣都尉张闿，将骑二百卫送。闿于泰山华、费间杀嵩，取财物，因奔淮南。太祖归咎于陶谦，故伐之。”","attribution":"《世语》、韦曜《吴书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":215,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c661f0fd20f06baa48e6","start":0,"end":198,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o001","section":"chapter-001","block":"b-acdd0481f4a63ccf47c8","layer":"original","quote":"太祖武皇帝〖1〗，沛国谯人也〖2〗。姓曹，讳操〖3〗，字孟德。汉相国参之后〖4〗。﹝一﹞桓帝世〖5〗，曹腾为中常侍、大长秋〖6〗，封费亭侯。﹝二﹞养子嵩嗣，官至太尉〖7〗；莫能审其生出本末〖8〗。﹝三﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":1,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":101,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o002","section":"chapter-001","block":"b-be6ee1955b4d2400e13d","layer":"original","quote":"嵩生太祖。太祖少机警，有权数〖1〗。而任侠放荡〖2〗，不治行业〖3〗，故世人未之奇也〖4〗。﹝一﹞惟梁国桥玄、南阳何颙异焉〖5〗。玄谓太祖曰：“天下将乱，非命世之才不能济也〖6〗。能安之者，其在君乎！”﹝二﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":17,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":104,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o028","section":"chapter-001","block":"b-fefe0240b8480efce927","layer":"original","quote":"兴平元年春，太祖自徐州还〖1〗。初，太祖父嵩，去官后还谯。董卓之乱，避难琅邪〖2〗。为陶谦所害，故太祖志在复仇东伐。﹝一﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":204,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":61,"offset_unit":"unicode_code_point"},{"id":"wudi-q-p004","section":"chapter-001","block":"b-e90db5467d9d5623caa7","layer":"pei","quote":"﹝三﹞《续汉书》曰：“嵩字巨高。质性敦慎，所在忠孝。为司隶校尉。灵帝擢拜大司农、大鸿胪，代崔烈为太尉。黄初元年，追尊嵩曰太皇帝。”","attribution":"《续汉书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":15,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-32f37ed50b79cc722888","start":0,"end":65,"offset_unit":"unicode_code_point"},{"id":"wudi-q-p005","section":"chapter-001","block":"b-be498a66d7a0eac75f23","layer":"pei","quote":"吴人作《曹瞒传》及郭颁《世语》并云：“嵩，夏侯氏之子，夏侯惇之叔父。”太祖于惇为从父兄弟。","attribution":"《曹瞒传》、郭颁《世语》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":16,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-32f37ed50b79cc722888","start":0,"end":45,"offset_unit":"unicode_code_point"},{"id":"wudi-q-p006","section":"chapter-001","block":"b-0cefa3b0c2e2968fd83c","layer":"pei","quote":"﹝一﹞《曹瞒传》云：“太祖少好飞鹰走狗，游荡无度。其叔父数言之于嵩，太祖患之。后逢叔父于路，乃佯败面口。叔父怪而问其故，太祖曰：‘猝中恶风。’叔父以告嵩，嵩惊愕。呼太祖，太祖口貌如故。嵩问曰：‘叔父言汝中风，已差乎？’太祖曰：‘初不中风，但失爱于叔父，故见罔耳。’嵩乃疑焉。自后叔父有所告，嵩终不复信。太祖于是益得肆意矣。”","attribution":"《曹瞒传》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":31,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a493b9d4ce2760e7585c","start":0,"end":163,"offset_unit":"unicode_code_point"},{"id":"wudi-q-p039","section":"chapter-001","block":"b-0bae69d5f033a4e86d7e","layer":"pei","quote":"﹝一﹞《世语》曰：“嵩在泰山华县，太祖令泰山太守应劭，送家诣兖州。劭兵未至，陶谦密遣数千骑掩捕。嵩家以为劭迎，不设备。谦兵至，杀太祖弟德于门中。嵩惧，穿后垣，先出其妾；妾肥，不时得出。嵩逃于厕，与妾俱被害，阖门皆死。劭惧，弃官赴袁绍。后太祖定冀州，劭时已死。”韦曜《吴书》曰：“太祖迎嵩，辎重百余辆。陶谦遣都尉张闿，将骑二百卫送。闿于泰山华、费间杀嵩，取财物，因奔淮南。太祖归咎于陶谦，故伐之。”","attribution":"《世语》、韦曜《吴书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":215,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c661f0fd20f06baa48e6","start":0,"end":198,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
