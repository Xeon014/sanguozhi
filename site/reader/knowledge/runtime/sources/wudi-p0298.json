t/titlepage_0029.xhtml","index":1,"anchor":null},"note_id":null,"start":85,"end":101},{"id":"cuimao-q-36c91f78679e9ef4ee4e","section":"chapter-012","block":"b-591fa63689368e8ab703","layer":"pei","quote":"高密郑玄，称之‘郑公’，执子孙礼","attribution":"裴注·《九州春秋》","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":96,"anchor":null},"note_id":"n-0ed74dd0dffffddb82dc","start":128,"end":144},{"id":"cuimao-q-be4f53cc3f7b17acac6c","section":"chapter-012","block":"b-71af50ed5989381e6496","layer":"pei","quote":"告高密县：为郑玄特立一乡，名为‘郑公乡","attribution":"裴注·《续汉书》","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":95,"anchor":null},"note_id":"n-0ed74dd0dffffddb82dc","start":597,"end":616},{"id":"cuimao-q-ddd26e070b11150ba957","section":"chapter-012","block":"b-931a7a92ca8db7294dce","layer":"original","quote":"至年二十九，乃结公孙方等，就郑玄受学","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":1,"anchor":null},"note_id":null,"start":66,"end":84},{"id":"dongyuan-e-p073b-q","section":"chapter-006","block":"b-0f026a4b92b94cf55d21","layer":"pei","quote":"绍延征北海郑玄，而不礼，赵融闻之曰：‘贤人者，君子之望也；不礼贤，是失君子之望也。夫有为之君，不敢失万民之欢心，况于君子乎？失君子之望，难乎以有为矣！","attribution":"《九州春秋》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":291,"anchor":null},"note_id":"n-f4c09d5ee318224fbd08","start":90,"end":165},{"id":"dongyuan-q-p074","section":"chapter-006","block":"b-a9042501da6042ed936a","layer":"pei","quote":"《英雄记》载太祖作《董卓歌》，辞云：“德行不亏缺，变故自难常。郑康成，行酒伏地气绝；郭景图，命尽于园桑。”如此之文，则玄无病而卒。余书不见，故载录之。","attribution":"《英雄记》及裴注说明","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":292,"anchor":null},"note_id":"n-f4c09d5ee318224fbd08","start":0,"end":75},{"id":"shaodi-e-p039b-q","section":"chapter-004","block":"b-414429c712cb18a821b0","layer":"pei","quote":"小同，郑玄孙也。《玄别传》曰：“玄有子，为孔融吏，举孝廉。融之被围，往赴，为贼所害。有遗腹子，以丁卯日生；而玄以丁卯岁生，故名曰小同。”","attribution":"《玄别传》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":29,"anchor":null},"note_id":"n-5ea9c99daa0ff9239ccd","start":0,"end":68},{"id":"shaodi-q-o085","section":"chapter-004","block":"b-ead1d935118013c72759","layer":"original","quote":"帝又问曰：“孔子作《彖》、《象》〖16〗，郑玄作注〖17〗；虽圣、贤不同〖18〗，其所释经义，一也〖19〗。今《彖》、《象》不与经文相连；而注连之〖20〗，何也？”","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":402,"anchor":null},"note_id":null,"start":0,"end":82},{"id":"shaodi-q-o086","section":"chapter-004","block":"b-998e12a5fdca2569f81b","layer":"original","quote":"俊对曰：“郑玄合《彖》、《象》于经者，欲使学者寻省易了也〖21〗。”","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":403,"anchor":null},"note_id":null,"start":0,"end":34},{"id":"shaodi-q-o089","section":"chapter-004","block":"b-ed18acce43ae53ea0ca7","layer":"original","quote":"帝曰：“若圣人以不合为谦，则郑玄何独不谦邪？”","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":406,"anchor":null},"note_id":null,"start":0,"end":23},{"id":"shaodi-q-o095","section":"chapter-004","block":"b-1c8f388e391772caf0c7","layer":"original","quote":"讲《易》毕，复命讲《尚书》。帝问曰：“郑玄曰‘稽古，同天’〖1〗，言尧同于天也。王肃云‘尧顺考古道而行之’〖2〗：二义不同，何者为是？”","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":445,"anchor":null},"note_id":null,"start":0,"end":68},{"id":"shaodi-q-p039","section":"chapter-004","block":"b-414429c712cb18a821b0","layer":"pei","quote":"小同，郑玄孙也。《玄别传》曰：“玄有子，为孔融吏，举孝廉。融之被围，往赴，为贼所害。有遗腹子，以丁卯日生；而玄以丁卯岁生，故名曰小同。”","attribution":"《玄别传》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":29,"anchor":null},"note_id":"n-5ea9c99daa0ff9239ccd","start":0,"end":68},{"id":"shaodi-q-p040","section":"chapter-004","block":"b-1331c8a8945d90019e99","layer":"pei","quote":"《魏名臣奏》载太尉华歆表曰：“臣闻励俗宣化，莫先于表善；班禄叙爵，莫美于显能。是以楚人思子文之治，复命其胤；汉室嘉江公之德，用显其世。伏见故汉大司农北海郑玄，当时之学，名冠华夏，为世儒宗。文皇帝旌录先贤，拜玄嫡孙小同以为郎中，长假在家。小同年逾三十，少有令质；学综六经，行著乡邑。海、岱之人，莫不嘉其自然，美其（气）〔器〕量。迹其所履，有质直不渝之性；然而恪恭静默，色养其亲；不治可见之美，不竞人间之名。斯诚清时所宜式叙，前后明诏所斟酌而求也。臣老病委顿，无益视听，谨具以闻。”","attribution":"《魏名臣奏》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":30,"anchor":null},"note_id":"n-5ea9c99daa0ff9239ccd","start":0,"end":239},{"id":"shaodi-q-p042","section":"chapter-004","block":"b-17897a413727d582abce","layer":"pei","quote":"郑玄注《文王世子》曰：“三老、五更各一人，皆年老更事致仕者也。”注《乐记》曰：“皆老人更知三德、五事者也。”","attribution":"郑玄注《文王世子》《乐记》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":32,"anchor":null},"note_id":"n-5ea9c99daa0ff9239ccd","start":0,"end":54},{"id":"wudi-e-p101a-q","section":"chapter-001","block":"b-fda1ef38dc4ec1a397f0","layer":"pei","quote":"﹝一﹞《续汉书》曰：“虑字鸿豫，山阳高平人。少受业于郑玄。建安初，为侍中。”","attribution":"《续汉书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":251,"anchor":null},"note_id":"n-3bf786bbee2fe2b8e5ac","start":0,"end":38},{"id":"wudi-q-p101","section":"chapter-001","block":"b-fda1ef38dc4ec1a397f0","layer":"pei","quote":"﹝一﹞《续汉书》曰：“虑字鸿豫，山阳高平人。少受业于郑玄。建安初，为侍中。”","attribution":"《续汉书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":251,"anchor":null},"note_id":"n-3bf786bbee2fe2b8e5ac","start":0,"end":38},{"id":"wuzhu-q-p002","section":"chapter-047","block":"b-34d49faca046a8e03214","layer":"pei","quote":"﹝一﹞臣松之按《礼记•曾子问》：“子夏曰：‘三年之丧，金革之事无避也者，礼与？初有司与？’孔子曰：‘吾闻诸老聃曰：昔者鲁公伯禽，有为为之也。’”郑玄注曰：“周人卒哭而致事。时有徐戎作难，伯禽卒哭而征之：急王事也。”昭所云“伯禽不师”，盖谓此也。","attribution":"裴松之按《礼记·曾子问》及郑玄注","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":57,"anchor":null},"note_id":"n-313ba23914d7f6c8b8c7","start":0,"end":122},{"id":"xumisun-q-bb92539297f2da44da5b","section":"chapter-038","block":"b-632ebc8c7d6e16ecc789","layer":"pei","quote":"玄荐乾于州：乾被辟命，玄所举也","attribution":"裴注·郑玄传","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":209,"anchor":null},"note_id":"n-05cede68e8cf6850413a","start":11,"end":26},{"id":"yuanzhang-q-761de986981b11866a8d","section":"chapter-011","block":"b-a548a698ffed38a35d9a","layer":"pei","quote":"时鲁国孔融在郡，教：‘选计当任公卿之才。’乃以郑玄为计掾，彭璆为计吏，原为计佐","attribution":"裴注·原别传","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":340,"anchor":null},"note_id":"n-73e160afdb3d08400061","start":13,"end":52},{"id":"yuanzhang-q-cb14e406ac6cfb3c9b6f","section":"chapter-011","block":"b-d2963402cbd1e6424af2","layer":"pei","quote":"欲远游学，诣安丘孙崧。崧辞曰：‘君乡里郑君，君知之乎？’原答曰：‘然。’崧曰：‘郑君学览古今，博闻强识，钩深致远，诚学者之师模也。君乃舍之，蹑屣千里；所谓以郑为“东家丘”者也。君似不知，而曰“然者”，何？’原曰：‘先生之说，诚可谓苦药良针矣；然犹未达仆之微趣也。人各有志，所规不同；故乃有登山而采玉者，有入海而采珠者；岂可谓登山者不知海之深，入海者不知山之高哉！君谓仆以郑为“东家丘”，君以仆为西家愚夫邪？’崧辞谢焉。又曰：‘兖、豫之士，吾多所识，未有若君者；当以书相（分）〔介〕。’原重其意，难辞之，持书而别。原心以为：‘求师启学，志高者通；非若交游，待（分）〔介〕而成也，书何为哉？’乃藏书于家而行","attribution":"裴注·原别传","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":339,"anchor":null},"note_id":"n-73e160afdb3d08400061","start":179,"end":480},{"id":"yuanzhang-q-dc0deb739d18cf90f558","section":"chapter-011","block":"b-f117f39bbee4400e1c45","layer":"pei","quote":"自返国土，原于是讲述礼乐，吟咏诗书；门徒数百，服道数十。时郑玄，博学洽闻，注解典籍：故儒雅之士集焉。原亦自以高远清白，颐志澹泊；口无择言，身无择行：故英伟之士向焉。是时海内清议，云青州有邴、郑之学","attribution":"裴注·原别传","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":341,"anchor":null},"note_id":"n-73e160afdb3d08400061","start":440,"end":538},{"id":"yuanzhang-q-dda59e434bad2c78a511","section":"chapter-011","block":"b-531c1ea6a68e01ba7aea","layer":"pei","quote":"渊，始未知名，玄称之曰：‘国子尼，美才也。吾观其人，必为国器","attribution":"裴注·玄别传","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":149,"anchor":null},"note_id":"n-32757c2bf418dfc90f56","start":11,"end":41},{"id":"yululu-q-6a1b0055ad615742f4fe","section":"chapter-057","block":"b-7f39fcbbd52d282d4fc2","layer":"pei","quote":"“翻初立《易》注，奏上曰：‘臣闻六经之始，莫大阴阳；是以伏羲仰天悬象，而建八卦，观变动六爻为六十四：以通神明，以类万物。臣高祖父故零陵太守光，少治孟氏《易》；曾祖父故平舆令成，缵述其业；至臣祖父凤，为之最密。臣亡考故日南太守歆，受本于凤，最有旧书，世传其业：至臣五世。前人通讲，多玩章句；虽有秘说，于经疏阔。臣生遇世乱，长于军旅；习经于桴鼓之间，讲论于戎马之上；蒙先师之说，依经立注。又臣郡吏陈桃，梦臣与道士相遇，放发被鹿裘，布《易》六爻，挠其三以饮臣；臣乞尽吞之，道士言《易》道在天，三爻足矣：岂臣受命，应当知经！所览诸家解不离流俗，义有不当实，辄悉改定，以就其正。孔子曰：“乾元用九而天下治。”圣人南面，盖取诸离，斯诚天子所宜协阴阳、致麟凤之道矣。谨正书副上，惟不罪戾。’翻又奏曰：‘经之大者，莫过于《易》。自汉初以来，海内英才，其读《易》者，解之率少。至孝灵之际，颍川荀谞，号为知《易》。臣得其注，有愈俗儒，至所说西南得朋，东北丧朋，颠倒反逆，了不可知。孔子叹《易》曰：“知变化之道者，其知神之所为乎！”以美大衍四象之作，而上为章首，尤可怪笑。又南郡太守马融，名有俊才；其所解释，复不及谞。孔子曰：“可与共学，未可与适道。”岂不其然！若乃北海郑玄，南阳宋忠，虽各立注，忠小差玄而皆未得其门，难以示世。’","attribution":"裴注·翻别传","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":98,"anchor":null},"note_id":"n-cf2e95497321a7d81cf8","start":0,"end":554},{"id":"zhangyan-q-2f47a64f03bd94137618","section":"chapter-053","block":"b-3cb1d4864b2f127e69a3","layer":"original","quote":"逮事郑玄","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":100,"anchor":null},"note_id":null,"start":16,"end":20},{"id":"zhangyan-q-d7503dd43194a49833bd","section":"chapter-053","block":"b-3cb1d4864b2f127e69a3","layer":"original","quote":"程秉字德枢，汝南南顿人也〖1〗。逮事郑玄〖2〗。后避乱交州，与刘熙考论大义〖3〗：遂博通五经。士燮命为长史。","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":100,"anchor":null},"note_id":null,"start":0,"end":54},{"id":"zhonghua-q-818848e123c396022261","section":"chapter-013","block":"b-a92e790e24ee273975a7","layer":"original","quote":"肃集《圣证论》以讥短玄，叔然驳而释之。","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":500,"anchor":null},"note_id":null,"start":36,"end":55}],"profiles":{},"directory_counts":{}}
