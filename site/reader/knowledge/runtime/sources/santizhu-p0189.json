:["santizhu059-q-6e995c73673dbd70d0c9"]}],"participants":[{"person":"santizhu-p0001","role":"使人窥察并向孙权报告","evidence":["santizhu059-q-6e995c73673dbd70d0c9"]},{"person":"sun-quan","role":"听闻报告后发怒","evidence":["santizhu059-q-6e995c73673dbd70d0c9"]},{"person":"santizhu-p0189","role":"被谗有喜色后忧死","evidence":["santizhu059-q-6e995c73673dbd70d0c9"]},{"person":"wuzhu-p0113","role":"被谗宠损惧废","evidence":["santizhu059-q-6e995c73673dbd70d0c9"]},{"person":"wgc-p0072","role":"和妃叔父，居近庙邀和过所居","evidence":["santizhu059-q-6e995c73673dbd70d0c9"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"未由相邻段落推算纪年；原文时间表达保留在来源引句中。","evidence":["santizhu059-q-6e995c73673dbd70d0c9"]},"ordering_evidence":"santizhu059-q-6e995c73673dbd70d0c9","source_order":[59,42,0],"order":10454}],"persons":[{"id":"santizhu-p0189","name":"王夫人","evidence":["santizhu059-q-d858242acc544ac010ba","feipin-q-6defd4fdbed71288d138","feipin-q-c701d8162608ccf7931d","feipin-q-bd0e033b259316844b91","feipin-q-dea769056cd2a9186a4c","feipin-q-e5ac9d3dfd94a961cbb6"],"facts":[{"id":"feipin-f-fbfe65ef7b5b63d35127","text":"籍贯：琅邪","evidence":["feipin-q-dea769056cd2a9186a4c"]},{"id":"feipin-f-94fd4eb823eeced8de4c","text":"《吴书》记其父名卢九。","evidence":["feipin-q-e5ac9d3dfd94a961cbb6"]}],"aliases":[],"mentions":[]}],"evidence":[{"id":"feipin-q-6defd4fdbed71288d138","section":"chapter-050","block":"b-b3537f577f70b90ae3df","layer":"original","quote":"吴主权王夫人，琅邪人也。﹝一﹞夫人以选入宫，黄武中得幸；生孙和，宠次步氏。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":85,"anchor":null},"note_id":null,"start":0,"end":37},{"id":"feipin-q-bd0e033b259316844b91","section":"chapter-050","block":"b-c1db69dafd59121d87ca","layer":"original","quote":"和子皓立，追尊夫人曰大懿皇后，封三弟皆列侯〖2〗。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":86,"anchor":null},"note_id":null,"start":57,"end":82},{"id":"feipin-q-c701d8162608ccf7931d","section":"chapter-050","block":"b-c1db69dafd59121d87ca","layer":"original","quote":"及权寝疾，言有喜色；由是权深责怒，以忧死。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":86,"anchor":null},"note_id":null,"start":36,"end":57},{"id":"feipin-q-dea769056cd2a9186a4c","section":"chapter-050","block":"b-b3537f577f70b90ae3df","layer":"original","quote":"吴主权王夫人，琅邪人也。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":85,"anchor":null},"note_id":null,"start":0,"end":12},{"id":"feipin-q-e5ac9d3dfd94a961cbb6","section":"chapter-050","block":"b-3a4e06be90c0973768b1","layer":"pei","quote":"夫人父，名卢九。","attribution":"裴注·谱系/人物资料（具体引书见原块）","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":91,"anchor":null},"note_id":"n-9d0d5e96db6d08dd5ff6","start":10,"end":18},{"id":"santizhu059-q-6e995c73673dbd70d0c9","section":"chapter-059","block":"b-812b635bdb003f1dd7f3","layer":"original","quote":"是后王夫人与全公主有隙〖1〗。权尝寝疾〖2〗，和祠祭于庙；和妃叔父张休居近庙，邀和过所居〖3〗。全公主使人觇视〖4〗，因言太子不在庙中，专就妃家计议；又言王夫人见上寝疾，有喜色。权由是发怒，夫人忧死","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":159,"anchor":null},"note_id":null,"start":0,"end":99},{"id":"santizhu059-q-d858242acc544ac010ba","section":"chapter-059","block":"b-812b635bdb003f1dd7f3","layer":"original","quote":"是后王夫人与全公主有隙〖1〗。","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":159,"anchor":null},"note_id":null,"start":0,"end":15}],"profiles":{},"directory_counts":{}}
