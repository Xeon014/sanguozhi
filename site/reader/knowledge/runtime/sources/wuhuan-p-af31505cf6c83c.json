7f393108542d65579","wuhuan-q-a7b923dd64f6224fbc6a","wuhuan-q-7811a80f6a735342c0f8","wuhuan-q-013abfb24dc1058e7fdb","wuhuan-q-48e63a5d33f0f131b220"],"facts":[{"id":"wuhuan-f-6dcaf9055ecdd3ac8158","text":"投鹿侯妻所生；其母述感雷吞电而孕，属传说，不作可证生物事实。","evidence":["wuhuan-q-48e63a5d33f0f131b220"]}],"mentions":[],"aliases":[]}],"evidence":[{"id":"wuhuan-q-013abfb24dc1058e7fdb","section":"chapter-030","block":"b-b719f989159c76febbc6","layer":"pei","quote":"檀石槐年四十五死，子和连，代立","attribution":"裴注·《魏书》","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":111,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c75611b8bc4bb2c4f479","start":0,"end":15,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-2b11a505b9e40411390c","section":"chapter-030","block":"b-e9a454234ba7f931bce2","layer":"pei","quote":"檀石槐策骑追击，所向无前；悉还得所亡，由是部落畏服","attribution":"裴注·《魏书》","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":110,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c75611b8bc4bb2c4f479","start":128,"end":153,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-486bb4978315eefdf74d","section":"chapter-030","block":"b-e9a454234ba7f931bce2","layer":"pei","quote":"乃更遣使者赍印绶，即封檀石槐为王，欲与和亲","attribution":"裴注·《魏书》","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":110,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c75611b8bc4bb2c4f479","start":298,"end":319,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-48e63a5d33f0f131b220","section":"chapter-030","block":"b-e9a454234ba7f931bce2","layer":"pei","quote":"投鹿侯从匈奴军三年；其妻在家，有子。投鹿侯归，怪欲杀之。妻言：‘尝昼行闻雷震，仰天视而电入其口，因吞之，遂妊身，十月而产；此子必有奇异，且长之！’投鹿侯固不信。妻乃语家，令收养焉，号‘檀石槐’；长大勇健，智略绝众。年十四五，异部大人卜贲邑，抄取其外家牛羊。檀石槐策骑追击，所向无前；悉还得所亡，由是部落畏服；施法禁，〔平〕曲直，莫敢犯者：遂推以为大人。檀石槐既立，乃为庭于高柳北三百余里弹汗山啜仇水上，东、西部大人皆归焉。兵马甚盛，南抄汉边，北拒丁令，东却夫余，西击乌孙；尽据匈奴故地，东西万（二）〔四〕千余里，南北七千余里，网罗山川、水泽、盐池甚广。汉患之，桓帝时，使匈奴中郎将张奂征之，不克；乃更遣使者赍印绶，即封檀石槐为王，欲与和亲。檀石槐拒不肯受，寇抄滋甚，乃分其地为中、东、西三部。从右北平以东至辽，东接夫余、〔濊〕貊，为东部；二十余邑，其大人曰弥加、阙机、素利、槐头。从右北平以西至上谷，为中部；十余邑，其大人曰柯最、阙居，慕容等为大帅。从上谷以西至敦煌，西接乌孙，为西部；二十余邑，其大人曰置鞬落罗、日律推演，宴荔游等皆为大帅：而制属檀石槐。至灵帝时，大抄略幽、并二州；缘边诸郡，无岁不被其毒。（嘉）〔熹〕平六年，遣护乌丸校尉夏育、破鲜卑中郎将田晏、匈奴中郎将臧旻与南单于，出雁门塞，三道并进，径二千余里，征之。檀石槐帅部众逆击，旻等败走，兵马还者，什一而已。鲜卑众日多，田畜射猎，不足给食。后檀石槐乃案行乌侯秦水，广袤数百里，渟不流，中有鱼而不能得。闻汗人善捕鱼，于是檀石槐东击汗国，得千余家，徙置乌侯秦水上，使捕鱼以助粮。至于今，乌侯秦水上有汗人数百户。","attribution":"裴注引《魏书》","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":110,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c75611b8bc4bb2c4f479","start":0,"end":686,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-4dbd406aae384d537d88","section":"chapter-030","block":"b-e9a454234ba7f931bce2","layer":"pei","quote":"投鹿侯归，怪欲杀之","attribution":"裴注·《魏书》","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":110,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c75611b8bc4bb2c4f479","start":18,"end":27,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-63048db2e82afa0edc57","section":"chapter-030","block":"b-e9a454234ba7f931bce2","layer":"pei","quote":"乃分其地为中、东、西三部","attribution":"裴注·《魏书》","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":110,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c75611b8bc4bb2c4f479","start":333,"end":345,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-7811a80f6a735342c0f8","section":"chapter-030","block":"b-e9a454234ba7f931bce2","layer":"pei","quote":"后檀石槐乃案行乌侯秦水，广袤数百里，渟不流，中有鱼而不能得。闻汗人善捕鱼，于是檀石槐东击汗国，得千余家，徙置乌侯秦水上，使捕鱼以助粮","attribution":"裴注·《魏书》","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":110,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6