tml","index":54,"anchor":null},"note_id":null,"start":0,"end":34},{"id":"houzhu-q-O026","section":"chapter-033","block":"b-bafe2f7b1f96fe96ef47","layer":"original","quote":"十一年冬，亮使诸军运米，集于斜谷口〖13〗，治斜谷邸阁〖14〗。是岁，南夷刘胄反〖15〗，将军马忠破平之〖16〗。","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":58,"anchor":null},"note_id":null,"start":0,"end":57},{"id":"huangli-q-02bad82b8cf939146783","section":"chapter-043","block":"b-eeece5f7b734fad61b54","layer":"original","quote":"八年〖7〗，召为丞相参军，副长史蒋琬署留府事〖8〗；又领州治中从事","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":127,"anchor":null},"note_id":null,"start":63,"end":96},{"id":"huangli-q-02df7aecbde3b58032b4","section":"chapter-043","block":"b-aee919abbbe09159ecc2","layer":"modern","quote":"〖14〗七年：延熙七年（公元 244）。","attribution":"现代注释","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":149,"anchor":null},"note_id":"n-79fda4f6726a5582f159","start":0,"end":20},{"id":"huangli-q-0d892d7b87461dc1adc1","section":"chapter-043","block":"b-767631e81dd8dda4c940","layer":"original","quote":"加拜镇南大将军","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":130,"anchor":null},"note_id":null,"start":28,"end":35},{"id":"huangli-q-162efa4bc3090aad6ece","section":"chapter-043","block":"b-5e649ba4c0a4d5847655","layer":"modern","quote":"〖9〗十一年：建兴十一年（公元 233 ）。","attribution":"现代注释","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":144,"anchor":null},"note_id":"n-d056702573533b198a9c","start":0,"end":22},{"id":"huangli-q-1a5993111ad2d51313e2","section":"chapter-043","block":"b-6f5d0f2c904adccd1410","layer":"original","quote":"巴西太守阎芝，发诸县兵五千人以补遗缺〖3〗，遣忠送往","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":126,"anchor":null},"note_id":null,"start":10,"end":36},{"id":"huangli-q-1b1853cebbc3a6702f50","section":"chapter-043","block":"b-4f522ca81aac07a647f6","layer"