ngli-q-33829d4cd87417432699","section":"chapter-043","block":"b-1746a0d2571753023d6c","layer":"pei","quote":"后南夷刘胄又反，以马忠为督�降，讨胄，嶷复属焉","attribution":"裴注·益部耆旧传","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":217,"anchor":null},"note_id":"n-d540924cb1d899ab1d51","start":235,"end":258},{"id":"huangli-q-3c50cbb1227a51d75cee","section":"chapter-043","block":"b-b48049f6acec1e6228ee","layer":"original","quote":"子修嗣","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":132,"anchor":null},"note_id":null,"start":9,"end":12},{"id":"huangli-q-403b0d6717c6c241dced","section":"chapter-043","block":"b-eeece5f7b734fad61b54","layer":"original","quote":"叛乱之后，忠抚育恤理，甚有威惠","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":127,"anchor":null},"note_id":null,"start":47,"end":62},{"id":"huangli-q-4be68c834eab122aebc9","section":"chapter-043","block":"b-eeece5f7b734fad61b54","layer":"original","quote":"建兴元年，丞相亮开府，以忠为门下督","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":127,"anchor":null},"note_id":null,"start":0,"end":17},{"id":"huangli-q-57bbaca0bbccc800e346","section":"chapter-043","block":"b-073f8aa6e597cbc1398c","layer":"original","quote":"至忠，乃移治味县〖10〗，处民夷之间","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":129,"anchor":null},"note_id":null,"start":34,"end":52},{"id":"huangli-q-675491c27e5f0ceb7d15","section":"chapter-043","block":"b-159661f288315df2032f","layer":"modern","quote":"〖15〗十二年：延熙十二年（公元 249）。","attribution":"现代注释","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":150,"anchor":null},"note_id":"n-d4066c12afd3d0c2932f","start":0,"end":22},{"id":"huangli-q-695e82286a0ca0f759c7","section":"chapter-043","block":"b-767631e81dd8dda4c940","layer":"original","quote":"延熙五年还朝，因至汉中；见大司马蒋琬，宣传诏旨","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":130,"anchor":null},"note_id":null,"start":0,"end":23},{"id":"huangli-q-72a1d2c20e04bb1041ba","section":"chapter-043","block":"b-98b0e1404ee51bca9e50","layer":"original","quote":"建安末举孝廉，除汉昌长","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":125,"anchor":null},"note_id":null,"start":40,"end":51},{"id":"huangli-q-8418e29dcfa6b3ee093d","section":"chapter-043","block":"b-6f5d0f2c904adccd1410","layer":"original","quote":"先主已还永安，见忠与语","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":126,"anchor":null},"note_id":null,"start":37,"end":48},{"id":"huangli-q-8d40ffa2436b587c016c","section":"chapter-043","block":"b-aaee59131dac67f8709d","layer":"original","quote":"张郃攻平，平坚守不动，郃不能克","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":160,"anchor":null},"note_id":null,"start":28,"end":43},{"id":"huangli-q-987a9b65128c58657b47","section":"chapter-043","block":"b-eeece5f7b734fad61b54","layer":"original","quote":"三年〖5〗，亮入南〖6〗，拜忠牂牁太守","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":127,"anchor":null},"note_id":null,"start":21,"end":40},{"id":"huangli-q-a05105436f36afb9e8f5","section":"chapter-043","block":"b-87771553ec3a6949874d","layer":"original","quote":"及卒，莫不自致丧庭〖16〗，流涕尽哀；为之立庙祀，迄今犹在","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":133,"anchor":null},"note_id":null,"start":42,"end":71},{"id":"huangli-q-a167d8694b0ff6b1a909","section":"chapter-043","block":"b-eeece5f7b734fad61b54","layer":"original","quote":"军还，督将军张嶷等，讨汶山郡叛羌","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":127,"anchor":null},"note_id":null,"start":115,"end":131},{"id":"huangli-q-b277abdfc4537e704586","section":"chapter-043","block":"b-fd790649bdbaf9324225","layer":"original","quote":"忠遂斩胄，平南土","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":128,"anchor":null},"note_id":null,"start":33,"end":41},{"id":"huangli-q-b4d38117702a1461b922","section":"chapter-043","block":"b-fd790649bdbaf9324225","layer":"original","quote":"征降都督张翼还，以忠代翼","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":128,"anchor":null},"note_id":null,"start":20,"end":32},{"id":"huangli-q-be826136b45092b3d061","section":"chapter-043","block":"b-3b1e78311495b397db4d","layer":"original","quote":"留忠成都，平尚书事。祎还，忠乃归南","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":131,"anchor":null},"note_id":null,"start":18,"end":35},{"id":"huangli-q-ce9bd34c151c0e41757a","section":"chapter-043","block":"b-073f8aa6e597cbc1398c","layer":"original","quote":"由此就加安南将军〖11〗，进封彭乡侯","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":129,"anchor":null},"note_id":null,"start":76,"end":94},{"id":"huangli-q-d1735a694936d3c0a8cf","section":"chapter-043","block":"b-aaee59131dac67f8709d","layer":"original","quote":"九年〖3〗，亮围祁山，平别守南围","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":160,"anchor":null},"note_id":null,"start":0,"end":16},{"id":"huangli-q-e2aa97dc7cb77dcd2082","section":"chapter-043","block":"b-fd790649bdbaf9324225","layer":"original","quote":"加忠监军，奋威将军，封博阳亭侯","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":128,"anchor":null},"note_id":null,"start":42,"end":57},{"id":"huangli-q-f85fb9152264d54f4f52","section":"chapter-043","block":"b-1746a0d2571753023d6c","layer":"pei","quote":"战斗常冠军首，遂斩胄","attribution":"裴注·益部耆旧传","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":217,"anchor":null},"note_id":"n-d540924cb1d899ab1d51","start":259,"end":269},{"id":"huangli-q-fe812bf03b9d2df618d3","section":"chapter-043","block":"b-aaee59131dac67f8709d","layer":"original","quote":"魏大将军司马宣王攻亮","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":160,"anchor":null},"note_id":null,"start":17,"end":27},{"id":"huangli-q-fe915ae23e70ef508718","section":"chapter-043","block":"b-eeece5f7b734fad61b54","layer":"original","quote":"明年，亮出祁山；忠诣亮所，经营戎事","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":127,"anchor":null},"note_id":null,"start":97,"end":114},{"id":"huangli-q2-818feec8ad0d5b019ec8","section":"chapter-043","block":"b-6f5d0f2c904adccd1410","layer":"original","quote":"先主东征，败绩猇亭。巴西太守阎芝，发诸县兵五千人以补遗缺〖3〗，遣忠送往。先主已还永安，见忠与语。谓尚书令刘巴曰：“虽亡黄权，复得狐笃；此为世不乏贤也。”","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":126,"anchor":null},"note_id":null,"start":0,"end":77},{"id":"huangli-q2-a738bf8e854dc9413ae1","section":"chapter-043","block":"b-98b0e1404ee51bca9e50","layer":"original","quote":"马忠字德信，巴西阆中人也。少养外家〖1〗，姓狐，名笃；后乃复姓，改名忠。","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":125,"anchor":null},"note_id":null,"start":0,"end":36},{"id":"mingdi-e-o021c-q","section":"chapter-003","block":"b-b3a0b254d489f1ed2693","layer":"original","quote":"五年春正月〖1〗，帝耕于籍田。三月，大司马曹真薨。诸葛亮寇天水。诏大将军司马宣王拒之。自去冬十月至此月，不雨。辛巳〖2〗，大雩〖3〗。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":161,"anchor":null},"note_id":null,"start":0,"end":67},{"id":"mingdi-q-b-c8dc64098d12ed2b34ee","section":"chapter-003","block":"b-c8dc64098d12ed2b34ee","layer":"modern","quote":"〖1〗五年：太和五年（公元 231 ）。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":167,"anchor":null},"note_id":"n-99c1873dc57e954cfdf4","start":0,"end":20},{"id":"mingdi-q-o021","section":"chapter-003","block":"b-b3a0b254d489f1ed2693","layer":"original","quote":"五年春正月〖1〗，帝耕于籍田。三月，大司马曹真薨。诸葛亮寇天水。诏大将军司马宣王拒之。自去冬十月至此月，不雨。辛巳〖2〗，大雩〖3〗。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":161,"anchor":null},"note_id":null,"start":0,"end":67}],"profiles":{},"directory_counts":{}}
