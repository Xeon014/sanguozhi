cision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["santizhu-q-ae20c43a7dce42189db2"]},"ordering_evidence":"santizhu-q-ae20c43a7dce42189db2","source_order":[48,47,486],"order":8913}],"persons":[{"id":"santizhu-p0123","name":"沈莹","evidence":["santizhu-q-1283bfd4d6765e17b41e","santizhu-q-ecd7e1ee0fc79697a0d8","santizhu-q-1b13478b0f5af0ad26fb","santizhu-q-8625954cb33d4468d47f","santizhu-q-ae20c43a7dce42189db2"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[{"id":"santizhu-q-1283bfd4d6765e17b41e","section":"chapter-048","block":"b-45c0aa4ad8cd7d95dfdc","layer":"original","quote":"浑复斩丞相张悌、丹杨太守沈莹等","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":521,"anchor":null},"note_id":null,"start":29,"end":44},{"id":"santizhu-q-1b13478b0f5af0ad26fb","section":"chapter-048","block":"b-4311ae30072f04acbaa0","layer":"pei","quote":"与讨吴护军张翰、扬州刺史周浚成阵相对。沈莹领丹杨锐卒刀盾五千，号曰‘青巾兵’，前后屡陷坚阵：于是以驰淮南军，三冲不动；退引，乱。薛胜、蒋班，因其乱而乘之，吴军以次土崩，将帅不能止；张乔又出其后：大败吴军于版桥，获悌、震、莹等","attribution":"裴注·干宝《晋纪》","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":548,"anchor":null},"note_id":"n-5564fe5f445521640591","start":169,"end":281},{"id":"santizhu-q-8625954cb33d4468d47f","section":"chapter-048","block":"b-644eb57c9a126837f3a6","layer":"pei","quote":"晋来伐吴，皓使悌督沈莹、诸葛靓，率众三万渡江逆之","attribution":"裴注·襄阳记","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":549,"anchor":null},"note_id":"n-5564fe5f445521640591","start":461,"end":485},{"id":"santizhu-q-ae20c43a7dce42189db2","section":"chapter-048","block":"b-644eb57c9a126837f3a6","layer":"pei","quote":"至牛渚，沈莹曰：‘晋治水军于蜀，久矣。今倾国大举，万里齐力，必悉益州之众，浮江而下。我上流诸军，无有戒备；名将皆死，幼少当任；恐边江诸城，尽莫能御也。晋之水军，必至于此矣！宜蓄众力，待来一战。若胜之日，江西自清；上方虽坏，可还取之","attribution":"裴注·襄阳记","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":549,"anchor":null},"note_id":"n-5564fe5f445521640591","start":486,"end":601},{"id":"santizhu-q-ecd7e1ee0fc79697a0d8","section":"chapter-048","block":"b-4311ae30072f04acbaa0","layer":"pei","quote":"吴丞相、军师张悌，护军孙震，丹杨太守沈莹，帅众三万济江，围成阳都尉张乔于杨荷桥；众才七千，闭栅自守，举白接告降","attribution":"裴注·干宝《晋纪》","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":548,"anchor":null},"note_id":"n-5564fe5f445521640591","start":12,"end":67}],"profiles":{},"directory_counts":{}}
