b752e9e1f89c2a3","label":"正文","text":"赤乌五年，然征柤中；魏将蒲忠、胡质各将数千人，忠要遮险隘图断然后，质为忠继援","evidence":["zhulv-q-f70ae773f634852498ed"]},{"id":"zhulv-a-8ef38ae58639a7628fc4","label":"正文","text":"时然所督兵将先四出，闻问不暇收合，便将帐下现兵八百人逆掩；忠战不利，质等皆退","evidence":["zhulv-q-fb5dc1c14b65381c4d72"]}],"participants":[{"person":"mingdi-p0046","role":"征柤中者；以八百人逆掩者","evidence":["zhulv-q-f70ae773f634852498ed","zhulv-q-fb5dc1c14b65381c4d72"]},{"person":"zhulv-p0017","role":"要遮险隘者；战不利者","evidence":["zhulv-q-f70ae773f634852498ed","zhulv-q-fb5dc1c14b65381c4d72"]},{"person":"mingdi-p0047","role":"为忠继援者；退者","evidence":["zhulv-q-f70ae773f634852498ed","zhulv-q-fb5dc1c14b65381c4d72"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"多时段分列，不推年。","evidence":["zhulv-q-f70ae773f634852498ed","zhulv-q-fb5dc1c14b65381c4d72"]},"ordering_evidence":"zhulv-q-f70ae773f634852498ed","source_order":[56,88,0],"related_events":[{"event":"zhulv-e-o056-s2-1","type":"related","evidence":["zhulv-q-0401b7188a7b776f048a","zhulv-q-f70ae773f634852498ed","zhulv-q-fb5dc1c14b65381c4d72"]},{"event":"zhulv-e-o056-s2-1","type":"disputes","evidence":["zhulv-q-0401b7188a7b776f048a","zhulv-q-f70ae773f634852498ed","zhulv-q-fb5dc1c14b65381c4d72"]}],"order":9977}],"persons":[{"id":"mingdi-p0047","name":"胡质","evidence":["mingdi-q-o055","chengguo-q-360c0160f138477a5b1c","liusima-q-370dbbad6a87363b1da8","zhulv-q-f70ae773f634852498ed","zhulv-q-fb5dc1c14b65381c4d72","xuhuwang-q-209217d1ab174c5230be","xuhuwang-q-179d2d80ab96d9383d70","xuhuwang-q-716342682eca6a605d9c","xuhuwang-q-492c0be1aba021b02cb1","xuhuwang-q-bb88301d892c593e41ac","xuhuwang-q-63345239bdbdcdea85d0","xuhuwang-q-c85c7f8a22377fdb5fc1","xuhuwang-q-cf9b2908dc72bd9a9120","xuhuwang-q-c03d164c15eba6b605b9","xuhuwang-q-79cb06c69a5e29962d6e","xuhuwang-q-64bc00a9b5331921b367","xuhuwang-q-d5a163be90f163f2c753","xuhuwang-q-60cc4c7fffe8f755c183","xuhuwang-q-65c4e9c5eaee1009331b","xuhuwang-q-ce71e33e8b7d9de2d65d","xuhuwang-q-4d8313baa5c80abc663f"],"facts":[{"id":"xuhuwang-f-79070628053f5dd82726","text":"字文德，楚国寿春人；胡通达之子。","evidence":["xuhuwang-q-4d8313baa5c80abc663f"]}],"aliases":[],"mentions":[{"id":"mingdi-m-o055-mingdi-p0047","kind":"mention","text":"文中提及","evidence":["mingdi-q-o055"]}]}],"evidence":[{"id":"chengguo-q-360c0160f138477a5b1c","section":"chapter-014","block":"b-9bd4e971ad7b9b42da29","layer":"pei","quote":"太祖征晔及蒋济、胡质等五人，皆扬州名士。每舍亭传，未曾不讲，所以见重：内论国邑先贤、御贼固守、行军进退之宜；外料敌之变化、彼我虚实、战争之术。夙夜不解，而晔独卧车中，终不一言。济怪而问之，晔答曰：‘对明主，非精神不接，精神可学而得乎？’及见太祖，太祖果问扬州先贤，贼之形势。四人争对，待次而言；再见如此。太祖每和悦，而晔终不一言。四人笑之。后一见太祖止，无所复问，晔乃设远言，以动太祖。太祖适知便止，若是者三。其旨趣以为：远言宜征精神，独见以尽其机，不宜于猥坐说也。太祖已探见其心矣，坐罢，寻以四人为令，而授晔以心腹之任。每有疑事，辄以函问晔，至一夜数十至","attribution":"裴注·《傅子》","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":315,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8402ac2b9162b8938cc2","start":10,"end":288,"offset_unit":"unicode_code_point"},{"id":"chengguo-q-669f81846adbd9bfb438","section":"chapter-014","block":"b-95aff85da71c9c1e1384","layer":"original","quote":"会休军已败，尽弃器仗辎重，退还。吴欲塞夹石〖3〗，遇救兵至，是以官军得不没","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":404,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":106,"end":143,"offset_unit":"unicode_code_point"},{"id":"hequan-q-2afeb15e4179e2c6965f","section":"chapter-060","block":"b-eb3cad55b9f9c0780fa1","layer":"original","quote":"七年〖4〗，权到皖。使琮与辅国将军陆逊击曹休，破之于石亭","section_title":"贺全吕周钟离传第十五","source":{"file":"OEBPS/Text/titlepage_0127.xhtml","index":125,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":28,"offset_unit":"unicode_code_point"},{"id":"hequan-q-9c04392ea2c13e9d3f34","section":"chapter-060","block":"b-20e5d84c088b067e210c","layer":"original","quote":"鲂亦合众，随陆逊横截休；休幅裂瓦解，斩获万计","section_title":"贺全吕周钟离传第十五","source":{"file":"OEBPS/Text/titlepage_0127.xhtml","index":349,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":26,"end":48,"offset_unit":"unicode_code_point"},{"id":"hequan-q-ed9abb31471fb1300eba","section":"chapter-060","block":"b-20e5d84c088b067e210c","layer":"original","quote":"被报施行。休果信鲂，帅步骑十万，辎重满道，径来入皖","section_title":"贺全吕周钟离传第十五","source":{"file":"OEBPS/Text/titlepage_0127.xhtml","index":349,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":25,"offset_unit":"unicode_code_point"},{"id":"liusima-q-34ebc4333e41238cb1f8","section":"chapter-015","block":"b-ab043c3c626c0afdec2c","layer":"original","quote":"行二百里，得生贼〖3〗，言“休战败，权遣兵断夹石”。诸将不知所出，或欲待后军","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":280,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":36,"end":74,"offset_unit":"unicode_code_point"},{"id":"liusima-q-370dbbad6a87363b1da8","section":"chapter-015","block":"b-0985d8c8acf24f9c721e","layer":"original","quote":"太和二年，帝使逵督前将军满宠、东莞太守胡质等四军，从西阳直向东关〖2〗；曹休从皖；司马宣王从江陵","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":279,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":12,"end":60,"offset_unit":"unicode_code_point"},{"id":"liusima-q-514a28cf96f2848649c5","section":"chapter-015","block":"b-ab043c3c626c0afdec2c","layer":"original","quote":"逵度贼无东关之备，必并军于皖；休深入与贼战，必败。乃部署诸将，水陆并进","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":280,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":35,"offset_unit":"unicode_code_point"},{"id":"liusima-q-60815b50b05409c75607","section":"chapter-015","block":"b-ab043c3c626c0afdec2c","layer":"original","quote":"贼见逵军，遂退。逵据夹石，以兵粮给休，休军乃振","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":280,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":180,"end":203,"offset_unit":"unicode_code_point"},{"id":"liusima-q-61347dbba77a5b3a2780","section":"chapter-015","block":"b-0985d8c8acf24f9c721e","layer":"original","quote":"逵至五将山，休更表贼有请降者，求深入应之。诏宣王驻军；逵东，与休合进","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":279,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":61,"end":95,"offset_unit":"unicode_code_point"},{"id":"liusima-q-94f46ae12716d005b862","section":"chapter-015","block":"b-ab043c3c626c0afdec2c","layer":"original","quote":"逵曰：“休兵败于外，路绝于内；进不能战，退不得还：安危之机，不及终日！贼以军无后继，故至此。今疾进，出其不意，此所谓先人以夺其心也，贼见吾兵必走。若待后军，贼已断险，兵虽多，何益！”乃兼道进军，多设旗鼓为疑兵","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":280,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":75,"end":179,"offset_unit":"unicode_code_point"},{"id":"luxun-e-o028a-q","section":"chapter-058","block":"b-25441637d6731269f663","layer":"original","quote":"逊自为中部，令朱桓、全琮为左、右翼，三道俱进。果冲休伏兵，因驱走之；追亡逐北〖4〗，径至夹石。斩获万余，牛马骡驴车乘万两，军资器械略尽。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":136,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":68,"offset_unit":"unicode_code_point"},{"id":"mingdi-e-o011a-q","section":"chapter-003","block":"b-0f7011a011e59527fd63","layer":"original","quote":"秋九月，曹休率诸军至皖〖16〗，与吴将陆议战于石亭〖17〗，败绩〖18〗。乙酉〖19〗，立皇子穆为繁阳王。庚子〖20〗，大司马曹休薨。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":57,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":67,"offset_unit":"unicode_code_point"},{"id":"mingdi-e-o055b-q","section":"chapter-003","block":"b-955a979a396107f90820","layer":"original","quote":"秋七月，丁卯〖1〗，司徒陈矫薨。孙权遣将朱然等二万人，围江夏郡〖2〗；荆州刺史胡质等击之〖3〗，然退走。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":397,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":52,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-b-76fba510250937628a99","section":"chapter-003","block":"b-76fba510250937628a99","layer":"modern","quote":"〖1〗二年：太和二年（公元 228）。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":60,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-38a74578b09178cb1fd4","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-b-78ee587f18f11aa30bd9","section":"chapter-003","block":"b-78ee587f18f11aa30bd9","layer":"modern","quote":"〖1〗二年：景初二年（公元 238 ）。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":438,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-917b5dc4aecce5a0dcf4","start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-o008","section":"chapter-003","block":"b-bec9198de0001b0aa26c","layer":"original","quote":"二年春正月〖1〗，宣王攻破新城。斩达，传其首〖2〗。﹝一﹞分新城之上庸、武陵、巫县为上庸郡〖3〗，锡县为锡郡。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":54,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":55,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-o052","section":"chapter-003","block":"b-26b7ecd6c3ecce777040","layer":"original","quote":"景初元年春（正）〔二〕月，壬辰〖1〗，山茌县言黄龙现〖2〗。﹝一﹞于是有司奏，以为魏得地统〖3〗，宜以建丑之月为正〖4〗。三月，定历改年为孟夏四月；﹝二﹞服色尚黄〖5〗；牺牲用白〖6〗；戎事乘黑首白马〖7〗，建大赤之旂〖8〗；朝会，建大白之旗。﹝三﹞改太和历曰景初历〖9〗：其春夏秋冬孟仲季月，虽与正岁不同〖10〗，至于郊祀、迎气、礿祠、蒸尝、巡狩、蒐田、分至启闭、班宣时令、中气早晚、敬授民事〖11〗，皆以正岁斗建为历数之序〖12〗。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":363,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":218,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-o055","section":"chapter-003","block":"b-955a979a396107f90820","layer":"original","quote":"秋七月，丁卯〖1〗，司徒陈矫薨。孙权遣将朱然等二万人，围江夏郡〖2〗；荆州刺史胡质等击之〖3〗，然退走。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":397,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":52,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-o059","section":"chapter-003","block":"b-5790b2efe14805978c50","layer":"original","quote":"二年春正月〖1〗，诏太尉司马宣王。率众讨辽东。﹝一﹞","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":434,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":26,"offset_unit":"unicode_code_point"},{"id":"shiyi-q-88c9220ecaf50448e4df","section":"chapter-062","block":"b-575fa66bbceefbf95dd0","layer":"original","quote":"休到，大破之","section_title":"是仪胡综传第十七","source":{"file":"OEBPS/Text/titlepage_0131.xhtml","index":6,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":24,"end":30,"offset_unit":"unicode_code_point"},{"id":"wgc-q0003","section":"chapter-028","block":"b-6b32530f1b0a1d7ab598","layer":"original","quote":"转在青州。是时海滨乘丧乱之后，法度未整。凌布政施教，赏善罚恶，甚有纲纪〖6〗；百姓称之，不容于口〖7〗。后从曹休征吴，与贼遇于夹石。休军失利，凌力战决围，休得免难。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":3,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":82,"offset_unit":"unicode_code_point"},{"id":"wgc-q0154","section":"chapter-028","block":"b-6b32530f1b0a1d7ab598","layer":"original","quote":"后从曹休征吴，与贼遇于夹石。休军失利，凌力战决围，休得免难","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":3,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":52,"end":81,"offset_unit":"unicode_code_point"},{"id":"wuzhu-e-o082a-q","section":"chapter-047","block":"b-c344c51caf4dab973911","layer":"original","quote":"秋八月，权至皖口；使将军陆逊，督诸将大破休于石亭〖36〗。大司马吕范卒〖37〗。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":397,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":40,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o045d-q","section":"chapter-009","block":"b-772f3a3de27ca1a3e015","layer":"original","quote":"贼将伪降〖12〗，休深入；战不利，退还宿石亭。军夜惊，士卒乱，弃甲兵辎重甚多。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":192,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":36,"end":75,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-179d2d80ab96d9383d70","section":"chapter-027","block":"b-ca1dff78cc0172f432c8","layer":"original","quote":"县民郭政通于从妹〖6〗，杀其夫程他，郡吏冯谅系狱为证。政与妹皆耐掠隐抵〖7〗；谅不胜痛，自诬〖8〗，当反其罪〖9〗。质至官，察其情色，更详其事，检验具服。","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":61,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":77,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-209217d1ab174c5230be","section":"chapter-027","block":"b-f3c5100a4a0cbf1a1286","layer":"original","quote":"太祖即召质为顿丘令〖5〗。","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":60,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":110,"end":123,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-492c0be1aba021b02cb1","section":"chapter-027","block":"b-f4fb197aeb5241edd0b4","layer":"original","quote":"州请为治中〖10〗。将军张辽与其护军武周有隙。辽见刺史温恢求请质〖11〗，质辞以疾。辽出谓质曰：“仆委意于君，何以相辜如此？”质曰：“古人之交也，取多知其不贪〖12〗，奔北知其不怯〖13〗，闻流言而不信；故可终也。武伯南身为雅士〖14〗，往者将军称之不容于口；今以睚眦之恨〖15〗，﹝二﹞乃成嫌隙；况质才薄，岂能终好？是以不愿也。”辽感言，复与周平〖16〗。","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":62,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":179,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-4d8313baa5c80abc663f","section":"chapter-027","block":"b-f3c5100a4a0cbf1a1286","layer":"original","quote":"胡质字文德，楚国寿春人也〖1〗。少与蒋济、朱绩俱知名于江、淮间，仕州郡。蒋济为别驾，使见太祖。太祖问曰：“胡通达，长者也〖2〗！宁有子孙不？”济曰：“有子曰质。规模大略，不及于父〖3〗；至于精良综事，过之〖4〗。”﹝一﹞太祖即召质为顿丘令〖5〗。","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":60,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":123,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-60cc4c7fffe8f755c183","section":"chapter-027","block":"b-ab8e2277c8155c7bb84a","layer":"original","quote":"嘉平二年薨，家无余财，惟有赐衣书箧而已。军师以闻","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":88,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":24,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-63345239bdbdcdea85d0","section":"chapter-027","block":"b-de021033693d14a953d9","layer":"original","quote":"黄初中，徙吏部郎。为常山太守〖1〗，迁任东莞〖2〗。","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":85,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":26,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-64bc00a9b5331921b367","section":"chapter-027","block":"b-61ce6c2c5f06168bb1cd","layer":"original","quote":"迁征东将军，假节，都督青、徐诸军事。","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":87,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":18,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-65c4e9c5eaee1009331b","section":"chapter-027","block":"b-ab8e2277c8155c7bb84a","layer":"original","quote":"追进封阳陵亭侯，邑百户，谥曰贞侯。","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":88,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":29,"end":46,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-716342682eca6a605d9c","section":"chapter-027","block":"b-ca1dff78cc0172f432c8","layer":"original","quote":"入为丞相东曹议令史。","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":61,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":77,"end":87,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-79cb06c69a5e29962d6e","section":"chapter-027","block":"b-e24bdc41eb46174ac55d","layer":"original","quote":"吴大将朱然围樊城，质轻军赴之。议者皆以为“贼盛不可迫”；质曰：“樊城卑下，兵少，故当进军为之外援；不然，危矣！”遂勒兵临围，城中乃安。","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":86,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":18,"end":85,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-bb88301d892c593e41ac","section":"chapter-027","block":"b-f4fb197aeb5241edd0b4","layer":"original","quote":"太祖辟为丞相属。","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":62,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":182,"end":190,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-c03d164c15eba6b605b9","section":"chapter-027","block":"b-e24bdc41eb46174ac55d","layer":"original","quote":"迁荆州刺史，加振威将军，赐爵关内侯。","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":86,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":18,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-c85c7f8a22377fdb5fc1","section":"chapter-027","block":"b-de021033693d14a953d9","layer":"original","quote":"士卢显，为人所杀，质曰：“此士无仇而有少妻，所以死乎！”悉见其比居年少〖3〗；书吏李若见问而色动〖4〗，遂穷诘情状。若即自首，罪人斯得。","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":85,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":26,"end":94,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-ce71e33e8b7d9de2d65d","section":"chapter-027","block":"b-2ca66686fb59291c3c67","layer":"pei","quote":"《晋阳秋》曰：“威字伯虎。少有志尚，厉操清白。质之为荆州也，威自京都省之。家贫，无车马童仆；威自驱驴单行，拜见父。停厩中十余日，告归。临辞，质赐绢一疋，为道路粮。威跪曰：‘大人清白，不审于何得此绢？’质曰：‘是吾俸禄之余，故以为汝粮耳。’威受之，辞归。每至客舍，自放驴，取樵炊爨；食毕，复随旅进道，往还如是。质帐下都督，素不相识；先其将归，请假还家，阴资装百余里，要之；因与为伴，每事佐助经营之，又少进饮食。行数百里，威疑之，密诱问，乃知其都督也，因取向所赐绢答谢而遣之。后因他信，具以白质。质杖其都督一百，除吏名。其父子清慎如此。","attribution":"裴注·晋阳秋","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":105,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9beb8bc557f58ac63c4b","start":3,"end":269,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-cf9b2908dc72bd9a9120","section":"chapter-027","block":"b-de021033693d14a953d9","layer":"original","quote":"每军功赏赐，皆散之于众，无入家者。在郡九年，吏民便安，将士用命。","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":85,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":94,"end":126,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-d5a163be90f163f2c753","section":"chapter-027","block":"b-61ce6c2c5f06168bb1cd","layer":"original","quote":"广农积谷，有兼年之储〖5〗，置东征台〖6〗，且佃且守。又通渠诸郡，利舟楫，严设备以待敌〖7〗。海边无事。","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":87,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":18,"end":70,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-0401b7188a7b776f048a","section":"chapter-056","block":"b-3c7784d6ff3304e90fd2","layer":"pei","quote":"《魏（志）〔书〕》及《江表传》云，然以景初元年、正始二年再出为寇，所破胡质、蒲忠在景初元年。《魏志》承《魏书》，依违不说质等为然所破，而直云然退耳。《吴志》说赤乌五年，于魏为正始三年，魏将蒲忠与朱然战，忠不利，质等皆退。按《魏少帝纪》及《孙权传》，是岁并无事，当是陈寿误以吴嘉禾六年为赤乌五年耳","attribution":"裴注·孙氏异同评","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":117,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b1b0c390611b3e5b2143","start":13,"end":160,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-577e1bad3da930cf0e7e","section":"chapter-056","block":"b-f6c93f523095dbe1d1e8","layer":"original","quote":"休知见欺，当引军还；自负众盛，（徼）〔邀〕于一战","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":241,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":62,"end":86,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-5bf1aafd1427750a4ac5","section":"chapter-056","block":"b-f6c93f523095dbe1d1e8","layer":"original","quote":"黄武七年，鄱阳太守周鲂谲诱魏大司马曹休〖1〗；休将步骑十万，至皖城以迎鲂","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":241,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":36,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-7f64cfcd6eebc75196a2","section":"chapter-056","block":"b-f6c93f523095dbe1d1e8","layer":"original","quote":"时陆逊为元帅；全琮与桓为左、右督，各督三万人击休","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":241,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":37,"end":61,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-f70ae773f634852498ed","section":"chapter-056","block":"b-631a4037ea975379aab6","layer":"original","quote":"赤乌五年，征柤中〖1〗。﹝一﹞魏将蒲忠、胡质各将数千人〖2〗。忠要遮险隘〖3〗，图断然后：质为忠继援","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":87,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":50,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-fb5dc1c14b65381c4d72","section":"chapter-056","block":"b-631a4037ea975379aab6","layer":"original","quote":"时然所督兵将先四出，闻问不暇收合〖4〗，便将帐下现兵八百人逆掩。忠战不利，质等皆退","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":87,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":51,"end":92,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
