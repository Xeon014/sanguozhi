{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wuzhu-e-p059a","title":"郑札为从事中郎与张昭孙邵定朝仪","accounts":[{"id":"wuzhu-e-p059a-account","label":"《文士传》","text":"郑札为从事中郎与张昭孙邵定朝仪","evidence":["wuzhu-e-p059a-q"]}],"participants":[{"person":"wuzhu-p0107","role":"定仪","evidence":["wuzhu-e-p059a-q"]},{"person":"wendi-p0133","role":"定仪","evidence":["wuzhu-e-p059a-q"]},{"person":"wuzhu-p0037","role":"定仪","evidence":["wuzhu-e-p059a-q"]},{"person":"sun-quan","role":"任用","evidence":["wuzhu-e-p059a-q"]}],"place":null,"time":{"label":"郑胄及其父子仕宦时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["wuzhu-e-p059a-q"]},"ordering_evidence":"wuzhu-e-p059a-q","source_order":[47,702,"P059a"],"order":8356}],"persons":[{"id":"wuzhu-p0107","name":"郑札","evidence":["wuzhu-q-p059"],"facts":[],"aliases":[],"mentions":[{"id":"wuzhu-m-p059-wuzhu-p0107","kind":"mention","text":"文中提及","evidence":["wuzhu-q-p059"]}]}],"evidence":[{"id":"wuzhu-e-p059a-q","section":"chapter-047","block":"b-2fcac46deecf90721482","layer":"pei","quote":"父札，才学博达。权为骠骑将军，以札为从事中郎。与张昭、孙邵，共定朝仪。","attribution":"《文士传》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":190,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-436f44c3434f84aa19b6","start":20,"end":55,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-p059","section":"chapter-047","block":"b-2fcac46deecf90721482","layer":"pei","quote":"﹝二﹞《文士传》曰：“胄字敬先，沛国人。父札，才学博达。权为骠骑将军，以札为从事中郎。与张昭、孙邵，共定朝仪。胄，其少子，有文武姿局，少知名。举贤良，稍迁建安太守。吕壹宾客于郡犯法，胄收付狱，考竟。壹怀恨，后密谮胄。权大怒，召胄还。潘濬、陈表并为请，得释。后拜宣信校尉，往救公孙渊；已为魏所破，还，迁执金吾。子丰，字曼季。有文学操行，与陆云善，与云诗（词）〔相〕往反。司空张华辟，未就，卒。”","attribution":"《文士传》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":190,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-436f44c3434f84aa19b6","start":0,"end":196,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
