e":["shaodi-q-o020"]},{"id":"zhangle-m-o026-shaodi-p0011","kind":"mention","text":"文中提及","evidence":["zhangle-q-o026"]},{"id":"guanzhang-m-o008-shaodi-p0011","kind":"mention","text":"文中提及","evidence":["guanzhang-q-o008"]},{"id":"guanzhang-m-p014-shaodi-p0011","kind":"mention","text":"文中提及","evidence":["guanzhang-q-p014"]},{"id":"guanzhang-m-o026-shaodi-p0011","kind":"mention","text":"文中提及","evidence":["guanzhang-q-o026"]}]}],"evidence":[{"id":"cuimao-q-33453425b6eebf4ac153","section":"chapter-012","block":"b-cd085f0bc2343b371c06","layer":"original","quote":"从西征马超。超破，军还","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":188,"anchor":null},"note_id":null,"start":11,"end":22},{"id":"cuimao-q-581b101be0243db9d787","section":"chapter-012","block":"b-b98fdf30cfe006001885","layer":"original","quote":"魏讽等谋反，中尉杨俊左迁","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":189,"anchor":null},"note_id":null,"start":25,"end":37},{"id":"cuimao-q-db2ebd12ac1479f03092","section":"chapter-012","block":"b-ecadc2b94d58e0bc3ac4","layer":"pei","quote":"从破马超等，子伯功为多。曹公常叹曰：‘子伯之计，孤不及也","attribution":"裴注·《吴书》","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":103,"anchor":null},"note_id":"n-4d3d422b1c33b802fc46","start":363,"end":391},{"id":"guanzhang-e-o008b-q","section":"chapter-036","block":"b-b96955cde6bd0ef2541b","layer":"original","quote":"是岁，羽率众攻曹仁于樊。曹公遣于禁助仁。秋，大霖雨，汉水泛溢，禁所督七军皆没；禁降羽，羽又斩将军庞德〖2〗；梁、郏、陆浑群盗或遥受羽印号〖3〗，为之支党。羽威震华夏〖4〗，","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":35,"anchor":null},"note_id":null,"start":27,"end":113},{"id":"guanzhang-e-o026b-q","section":"chapter-036","block":"b-ebcd92d1abd43d6e866a","layer":"original","quote":"腾遣超随繇讨郭援、高幹于平阳，超将庞德亲斩援首。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":111,"anchor":null},"note_id":null,"start":38,"end":62},{"id":"guanzhang-q-o008","section":"chapter-036","block":"b-b96955cde6bd0ef2541b","layer":"original","quote":"二十四年〖1〗，先主为汉中王；拜羽为前将军，假节、钺。是岁，羽率众攻曹仁于樊。曹公遣于禁助仁。秋，大霖雨，汉水泛溢，禁所督七军皆没；禁降羽，羽又斩将军庞德〖2〗；梁、郏、陆浑群盗或遥受羽印号〖3〗，为之支党。羽威震华夏〖4〗，曹公议徙许都，以避其锐。司马宣王、蒋济以为：“关羽得志，孙权必不愿也。可遣人劝权蹑其后〖5〗，许割江南以封权，则樊围自解。”曹公从之。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":35,"anchor":null},"note_id":null,"start":0,"end":180},{"id":"guanzhang-q-o026","section":"chapter-036","block":"b-ebcd92d1abd43d6e866a","layer":"original","quote":"后腾袭长安；败走，退还凉州。司隶校尉钟繇镇关中，移书遂、腾〖4〗，为陈祸福。腾遣超随繇讨郭援、高幹于平阳，超将庞德亲斩援首。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":111,"anchor":null},"note_id":null,"start":0,"end":62},{"id":"guanzhang-q-p014","section":"chapter-036","block":"b-0746814bfdce95386c0a","layer":"pei","quote":"﹝五﹞《蜀记》曰：“庞德子会，随钟、邓伐蜀；蜀破，尽灭关氏家。”","attribution":"《蜀记》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":61,"anchor":null},"note_id":"n-7ad2e8ad36156d73fd75","start":0,"end":32},{"id":"hequan-q-ca8e4a8dd9b29a576654","section":"chapter-060","block":"b-b5253083967b499636ae","layer":"original","quote":"建安二十四年，刘备将关羽围樊、襄阳","section_title":"贺全吕周钟离传第十五","source":{"file":"OEBPS/Text/titlepage_0127.xhtml","index":109,"anchor":null},"note_id":null,"start":0,"end":17},{"id":"liusima-q-1c8aa779ac389f7303e7","section":"chapter-015","block":"b-dfd76f5cb0dc84d92f59","layer":"original","quote":"后超反，既从太祖破超于华阴","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":138,"anchor":null},"note_id":null,"start":96,"end":109},{"id":"liusima-q-5228f5d8a72814c227f1","section":"chapter-015","block":"b-d158b35e0c99bd1badc0","layer":"original","quote":"司隶校尉钟繇遣既，说将军马腾等。既为言利害，腾等从之","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":137,"anchor":null},"note_id":null,"start":50,"end":76},{"id":"liusima-q-af31a676aa3b231c22c0","section":"chapter-015","block":"b-d158b35e0c99bd1badc0","layer":"original","quote":"袁尚拒太祖于黎阳，遣所置河东太守郭援，并州刺史高幹及匈奴单于，取平阳；发使，西与关中诸将合从","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":137,"anchor":null},"note_id":null,"start":0,"end":46},{"id":"liusima-q-f2479d99d841b7989d13","section":"chapter-015","block":"b-d158b35e0c99bd1badc0","layer":"original","quote":"腾遣子超将兵万余人，与繇会击幹、援；大破之，斩援首，幹及单于皆降","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":137,"anchor":null},"note_id":null,"start":77,"end":109},{"id":"lizang-q-0100a16c14f345e696d5","section":"chapter-018","block":"b-600ec9e048958a94c35d","layer":"original","quote":"德将所领与曹仁共攻拔宛，斩音、开","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":202,"anchor":null},"note_id":null,"start":46,"end":62},{"id":"lizang-q-1dac388345849d522b2f","section":"chapter-018","block":"b-5f9b8e0248da72ebfeb8","layer":"original","quote":"文帝即王位，乃遣使就德墓，赐谥，策曰：“昔先轸丧元〖7〗，王蠋绝脰〖8〗；陨身徇节，前代美之。惟侯式昭果毅〖9〗，蹈难成名；声溢当时，义高在昔：寡人愍焉，谥曰壮侯","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":206,"anchor":null},"note_id":null,"start":0,"end":81},{"id":"lizang-q-45b0aacbba69dbd57302","section":"chapter-018","block":"b-76f360b0363911f34631","layer":"original","quote":"立而不跪。羽谓曰：“卿兄在汉中。我欲以卿为将，不早降何为？”德骂羽曰：“竖子，何谓降也！魏王带甲百万，威振天下。汝刘备庸才耳，岂能敌邪？我宁为国家鬼，不为贼将也！”遂为羽所杀","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":205,"anchor":null},"note_id":null,"start":0,"end":87},{"id":"lizang-q-4924e47843d48d5bf19e","section":"chapter-018","block":"b-bfe551423d3150bed6a9","layer":"pei","quote":"繇见之而哭。德谢繇，繇曰：‘援虽我甥，乃国贼也！卿何谢之","attribution":"裴注·魏略","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":220,"anchor":null},"note_id":"n-6cf0ffc369313cfa3fa7","start":55,"end":83},{"id":"lizang-q-4e9d00399c0ce2056d13","section":"chapter-018","block":"b-77cf8e238c8aa2ff298d","layer":"original","quote":"太祖使钟繇率关中诸将讨之","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":201,"anchor":null},"note_id":null,"start":80,"end":92},{"id":"lizang-q-4ef32b63a7f5ff4d8c5b","section":"chapter-018","block":"b-600ec9e048958a94c35d","layer":"original","quote":"德常曰：“我受国恩，义在效死〖4〗。我欲身自击羽。今年我不杀羽，羽当杀我","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":202,"anchor":null},"note_id":null,"start":94,"end":130},{"id":"lizang-q-52876f56216b11500e33","section":"chapter-018","block":"b-77cf8e238c8aa2ff298d","layer":"original","quote":"太祖破超于渭南，德随超亡入汉阳，保冀城","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":201,"anchor":null},"note_id":null,"start":193,"end":212},{"id":"lizang-q-56bae898459683465bc1","section":"chapter-018","block":"b-600ec9e048958a94c35d","layer":"original","quote":"遂南屯樊，讨关羽","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":202,"anchor":null},"note_id":null,"start":63,"end":71},{"id":"lizang-q-5a93e70efcc761a6aa0a","section":"chapter-018","block":"b-600ec9e048958a94c35d","layer":"original","quote":"太祖定汉中，德随众降","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":202,"anchor":null},"note_id":null,"start":0,"end":10},{"id":"lizang-q-5b99cf8e7236f639d2b5","section":"chapter-018","block":"b-77cf8e238c8aa2ff298d","layer":"original","quote":"谭遣郭援、高幹等略取河东","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":201,"anchor":null},"note_id":null,"start":67,"end":79},{"id":"lizang-q-62d8aaefbdc8fc883318","section":"chapter-018","block":"b-76f360b0363911f34631","layer":"original","quote":"太祖闻而悲之，为之流涕，封其二子为列侯","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":205,"anchor":null},"note_id":null,"start":88,"end":107},{"id":"lizang-q-66c8264ad0149c8289af","section":"chapter-018","block":"b-cc028a9b73eabe99bd16","layer":"original","quote":"仁使德屯樊北十里","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":203,"anchor":null},"note_id":null,"start":0,"end":8},{"id":"lizang-q-69855be200c46f885683","section":"chapter-018","block":"b-77cf8e238c8aa2ff298d","layer":"original","quote":"初平中，从马腾击反羌、叛氐，数有功","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":201,"anchor":null},"note_id":null,"start":28,"end":45},{"id":"lizang-q-8c88bc2da322d3c42519","section":"chapter-018","block":"b-77cf8e238c8aa2ff298d","layer":"original","quote":"后张白骑叛于弘农，德复随腾征之，破白骑于两崤间","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":201,"anchor":null},"note_id":null,"start":140,"end":163},{"id":"lizang-q-96c1d73292e41f48fa17","section":"chapter-018","block":"b-5f9b8e0248da72ebfeb8","layer":"original","quote":"又赐子会等四人爵关内侯，邑各百户","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":206,"anchor":null},"note_id":null,"start":83,"end":99},{"id":"lizang-q-a42bdab47df3e1ccd9e5","section":"chapter-018","block":"b-df77ae73c13b4a78c06c","layer":"pei","quote":"﹝三﹞《魏略》曰：“德从兄名柔，时在蜀。”","attribution":"裴注（引书见引句）","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":221,"anchor":null},"note_id":"n-46544081c13faa140090","start":0,"end":21},{"id":"lizang-q-ae7afaab0329f7bde126","section":"chapter-018","block":"b-cc028a9b73eabe99bd16","layer":"original","quote":"将军董衡、部曲将董超等欲降，德皆收斩之","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":203,"anchor":null},"note_id":null,"start":66,"end":85},{"id":"lizang-q-d1ff6efce8f94c6690bb","section":"chapter-018","block":"b-cc028a9b73eabe99bd16","layer":"original","quote":"会天霖雨十余日，汉水暴溢；樊下平地五六丈，德与诸将避水，上堤。羽乘船攻之，以大船四面射堤上。德被甲持弓，箭不虚发","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":203,"anchor":null},"note_id":null,"start":9,"end":65},{"id":"lizang-q-d43cbf6f9121717251c4","section":"chapter-018","block":"b-54a51096c7c075758eb4","layer":"original","quote":"德谓督将成何曰：“吾闻良将不怯死以苟免，烈士不毁节以求生；今日，我死日也","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":204,"anchor":null},"note_id":null,"start":0,"end":36},{"id":"lizang-q-d5573e7894d8f4ba3e69","section":"chapter-018","block":"b-54a51096c7c075758eb4","layer":"original","quote":"战益怒，气愈壮；而水浸盛，吏士皆降。德与麾下将一人，伍伯二人〖5〗，弯弓傅矢〖6〗，乘小船，欲还仁营；水盛船覆，失弓矢；独抱船覆水中，为羽所得","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":204,"anchor":null},"note_id":null,"start":38,"end":109},{"id":"lizang-q-d9c6a20001d63fc4e6c2","section":"chapter-018","block":"b-bfe551423d3150bed6a9","layer":"pei","quote":"德手斩一级，不知是援。战罢之后，众人皆言援死而不得其首。援，钟繇之甥。德晚后于鞬中出一头","attribution":"裴注·魏略","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":220,"anchor":null},"note_id":"n-6cf0ffc369313cfa3fa7","start":10,"end":54},{"id":"lizang-q-e521121329ff29a1cea8","section":"chapter-018","block":"b-2791e4960695e3d97a40","layer":"original","quote":"后数日会战，大破超等，褚身斩首级","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":132,"anchor":null},"note_id":null,"start":99,"end":115},{"id":"lizang-q-e8c144058b1ba9ddbc2c","section":"chapter-018","block":"b-600ec9e048958a94c35d","layer":"original","quote":"后亲与羽交战，射羽中额","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":202,"anchor":null},"note_id":null,"start":132,"end":143},{"id":"lizang-q-ee0fcf8d9d95a8a89aea","section":"chapter-018","block":"b-77cf8e238c8aa2ff298d","layer":"original","quote":"德随腾子超，拒援、幹于平阳。德为军锋，进攻援、幹，大破之，亲斩援首","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":201,"anchor":null},"note_id":null,"start":93,"end":126},{"id":"lizang-q-ee14036e58a0b89ec583","section":"chapter-018","block":"b-cc028a9b73eabe99bd16","layer":"original","quote":"自平旦力战至日过中，羽攻益急；矢尽，短兵接战","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":203,"anchor":null},"note_id":null,"start":86,"end":108},{"id":"lizang-q2-02d3fa2fbd0043b8a0d0","section":"chapter-018","block":"b-600ec9e048958a94c35d","layer":"original","quote":"太祖定汉中，德随众降。太祖素闻其骁勇，拜立义将军，封关门亭侯，邑三百户。侯音、卫开等以宛叛，德将所领与曹仁共攻拔宛，斩音、开；遂南屯樊，讨关羽。樊下诸将，以德兄在汉中〖3〗，颇疑之。﹝三﹞德常曰：“我受国恩，义在效死〖4〗。我欲身自击羽。今年我不杀羽，羽当杀我！”后亲与羽交战，射羽中额。时德常乘白马，羽军谓之“白马将军”，皆惮之。","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":202,"anchor":null},"note_id":null,"start":0,"end":166},{"id":"lizang-q2-c7ad0fdb88016d26b9cc","section":"chapter-018","block":"b-77cf8e238c8aa2ff298d","layer":"original","quote":"庞德字令明，南安狟道人也〖1〗。﹝一﹞少为郡吏，州从事。初平中，从马腾击反羌、叛氐，数有功。稍迁至校尉。建安中，太祖讨袁谭、尚于黎阳。谭遣郭援、高幹等略取河东，太祖使钟繇率关中诸将讨之。德随腾子超，拒援、幹于平阳。德为军锋，进攻援、幹，大破之，亲斩援首。﹝二﹞拜中郎将，封都亭侯。后张白骑叛于弘农，德复随腾征之，破白骑于两崤间〖2〗。每战，常陷阵却敌，勇冠腾军。后腾征为卫尉，德留属超。太祖破超于渭南，德随超亡入汉阳，保冀城。后复随超奔汉中，从张鲁。","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":201,"anchor":null},"note_id":null,"start":0,"end":225},{"id":"shaodi-q-o020","section":"chapter-004","block":"b-fd5fa6caa10793fbca36","layer":"original","quote":"秋七月，诏祀故大司马曹真、曹休，征南大将军夏侯尚，太常桓阶，司空陈群，太傅钟繇，车骑将军张郃，（左）〔右〕将军徐晃，前将军张辽，右将军乐进，太尉华歆，司徒王朗，骠骑将军曹洪，征西将军夏侯渊，后将军朱灵、文聘，执金吾臧霸，破虏将军李典，立义将军庞德，武猛校尉典韦于太祖庙庭〖11〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":76,"anchor":null},"note_id":null,"start":0,"end":140},{"id":"wudi-e-o132b-q","section":"chapter-001","block":"b-e0f9191c7bec5bbb7c81","layer":"original","quote":"公乃与克日会战〖14〗，先以轻兵挑之。战良久，乃纵虎骑夹击〖15〗；大破之，斩成宜、李堪等。遂、超等走凉州〖16〗，杨秋奔安定〖17〗，关中平。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":66,"anchor":null},"note_id":null,"start":165,"end":237},{"id":"wudi-e-o179a-q","section":"chapter-001","block":"b-5b628cceb1d057936ae4","layer":"original","quote":"十一月，鲁自巴中将其余众降。封鲁及五子皆为列侯。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":325,"anchor":null},"note_id":null,"start":0,"end":24},{"id":"wudi-e-o194a-q","section":"chapter-001","block":"b-adb6682558d65fc17e1a","layer":"original","quote":"二十四年春正月〖1〗，仁屠宛，斩音。﹝一﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":422,"anchor":null},"note_id":null,"start":0,"end":21},{"id":"wudi-e-o197b-q","section":"chapter-001","block":"b-01554a0b2561dc520574","layer":"original","quote":"遣于禁助曹仁，击关羽。八月，汉水溢，灌禁军，军没。羽获禁，遂围仁。使徐晃救之。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":425,"anchor":null},"note_id":null,"start":16,"end":55},{"id":"wudi-q-b-1e7ae1441471aa22d204","section":"chapter-001","block":"b-1e7ae1441471aa22d204","layer":"modern","quote":"〖1〗二十四年：建安二十四年（公元 219）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":428,"anchor":null},"note_id":"n-f2589f07b550616f1e63","start":0,"end":23},{"id":"wudi-q-b-2dc1a34b174874acae8b","section":"chapter-001","block":"b-2dc1a34b174874acae8b","layer":"modern","quote":"〖1〗十六年：建安十六年（公元 211）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":54,"anchor":null},"note_id":"n-889c5acff5776ef2f54b","start":0,"end":21},{"id":"wudi-q-o128","section":"chapter-001","block":"b-37e542ccc37d1632e170","layer":"original","quote":"十六年春正月〖1〗，﹝一﹞天子命公世子丕为五官中郎将〖2〗，置官属〖3〗；为丞相副。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":51,"anchor":null},"note_id":null,"start":0,"end":42},{"id":"wudi-q-o194","section":"chapter-001","block":"b-adb6682558d65fc17e1a","layer":"original","quote":"二十四年春正月〖1〗，仁屠宛，斩音。﹝一﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":422,"anchor":null},"note_id":null,"start":0,"end":21},{"id":"wuzhu-e-o034a-q","section":"chapter-047","block":"b-39b849dfb87fdd3c9c49","layer":"original","quote":"二十四年〖8〗，关羽围曹仁于襄阳；曹公遣左将军于禁救之〖9〗。会汉水暴起，羽以舟兵尽虏禁等步骑三万，送江陵，惟城未拔。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":151,"anchor":null},"note_id":null,"start":0,"end":59},{"id":"xiahoucao-e-o027a-q","section":"chapter-009","block":"b-7eef8a1f58fc0a970c7b","layer":"original","quote":"复以仁行征南将军，假节，屯樊，镇荆州。侯音以宛叛，略傍县众数千人。仁率诸军攻破音，斩其首。还屯樊，即拜征南将军。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":133,"anchor":null},"note_id":null,"start":0,"end":56},{"id":"xianzhu-e-o060b-q","section":"chapter-032","block":"b-4b69b4fde2ac4ee74852","layer":"original","quote":"时关羽攻曹公将曹仁，擒于禁于樊。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":279,"anchor":null},"note_id":null,"start":25,"end":41},{"id":"xunyu-e-o023b-q","section":"chapter-010","block":"b-64b6e45c68fb16b80ee9","layer":"original","quote":"而高幹、郭援侵略河东，关右震动。钟繇帅马腾等，击破之，语在《繇传》。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":120,"anchor":null},"note_id":null,"start":24,"end":58},{"id":"zhangle-e-o026b-q","section":"chapter-017","block":"b-b487aba048617fe0bc2c","layer":"original","quote":"建安二十四年，太祖在长安，使曹仁讨关羽于樊，又遣禁助仁。秋，大霖雨，汉水溢，平地水数丈，禁等七军皆没。禁与诸将登高望水，无所回避。羽乘大船就攻禁等，禁遂降；惟庞德不屈节而死。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":78,"anchor":null},"note_id":null,"start":22,"end":109},{"id":"zhangle-q-o026","section":"chapter-017","block":"b-b487aba048617fe0bc2c","layer":"original","quote":"迁左将军，假节、钺；分邑五百户，封一子列侯。建安二十四年，太祖在长安，使曹仁讨关羽于樊，又遣禁助仁。秋，大霖雨，汉水溢，平地水数丈，禁等七军皆没。禁与诸将登高望水，无所回避。羽乘大船就攻禁等，禁遂降；惟庞德不屈节而死。太祖闻之，哀叹者久之，曰：“吾知禁三十年，何意临危处难，反不如庞德邪！”会孙权擒羽，获其众，禁复在吴。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":78,"anchor":null},"note_id":null,"start":0,"end":160},{"id":"zhonghua-q-04a7d3de46fac2ba1c59","section":"chapter-013","block":"b-6ee93dddf14ade60e6ec","layer":"original","quote":"袁尚所置河东太守郭援到河东，众甚盛，诸将议欲释之去。","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":21,"anchor":null},"note_id":null,"start":23,"end":49},{"id":"zhonghua-q-19fd1c45e7c404c4e12f","section":"chapter-013","block":"b-02d2da358aaec0e17eb7","layer":"pei","quote":"幹曰：‘智者转祸为福。今曹公与袁氏相持，而高幹、郭援独制河东；曹公虽有万全之计，不能禁河东之不危也。将军诚能引兵讨援，内外击之，其势必举。是将军一举，断袁氏之臂，解一方之急：曹公必重德将军。将军功名，竹帛不能尽载也。唯将军审所择！’","attribution":"裴注·司马彪战略","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":45,"anchor":null},"note_id":"n-3d2327301bdfe436b774","start":205,"end":321},{"id":"zhonghua-q-21fd55277324a512ed9e","section":"chapter-013","block":"b-02d2da358aaec0e17eb7","layer":"pei","quote":"腾曰：‘敬从教！’于是遣子超，将精兵万余人，并将遂等兵，与繇会击援等，大破之。”","attribution":"裴注·司马彪战略","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":45,"anchor":null},"note_id":"n-3d2327301bdfe436b774","start":321,"end":361},{"id":"zhonghua-q-2a97759cb8565524e9b2","section":"chapter-013","block":"b-02d2da358aaec0e17eb7","layer":"pei","quote":"傅幹说腾曰：‘古人有言：“顺道者昌，逆德者亡。”曹公奉天子诛暴乱；法明国治，上下用命；有义必赏，无义必罚：可谓顺道矣。袁氏背王命；驱胡虏以陵中国，宽而多忌，仁而无断；兵虽强，实失天下心：可谓逆德矣。今将军既事有道，不尽其力，阴怀两端，欲以坐观成败；吾恐成败既定，奉辞责罪，将军先为诛首矣。’于是腾惧。","attribution":"裴注·司马彪战略","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":45,"anchor":null},"note_id":"n-3d2327301bdfe436b774","start":55,"end":205},{"id":"zhonghua-q-2e8887a3c16d01c3eeb0","section":"chapter-013","block":"b-6ee93dddf14ade60e6ec","layer":"original","quote":"援至，果轻渡汾〖6〗；众止之，不从。济水未半，击，大破之。﹝一﹞斩援，降单于","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":21,"anchor":null},"note_id":null,"start":179,"end":217},{"id":"zhonghua-q-7cba893c0ffd0bddf47d","section":"chapter-013","block":"b-6ee93dddf14ade60e6ec","layer":"original","quote":"张既说马腾会击援〖5〗，腾遣子超，将精兵逆之。","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":21,"anchor":null},"note_id":null,"start":156,"end":179},{"id":"zhonghua-q-9fdc2a4faf98bee96821","section":"chapter-013","block":"b-6ee93dddf14ade60e6ec","layer":"original","quote":"繇曰：“袁氏方强，援之来，关中阴与之通；所以未悉叛者，顾吾威名故耳。若弃而去，示之以弱；所在之民，谁非寇仇？纵吾欲归，其得至乎？此为未战先自败也！且援刚愎好胜，必易吾军〖4〗；若渡汾为营，及其未济击之，可大克也。","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":21,"anchor":null},"note_id":null,"start":49,"end":155},{"id":"zhonghua-q-f6295e9b48de7d7415cc","section":"chapter-013","block":"b-6ee93dddf14ade60e6ec","layer":"original","quote":"其后，匈奴单于作乱平阳，繇帅诸军围之，未拔。","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":21,"anchor":null},"note_id":null,"start":0,"end":22},{"id":"zhonghua-q-f7bba20e9f2113d463ac","section":"chapter-013","block":"b-02d2da358aaec0e17eb7","layer":"pei","quote":"袁尚遣高幹、郭援，将兵数万人，与匈奴单于寇河东。遣使与马腾、韩遂等连和，腾等阴许之。","attribution":"裴注·司马彪战略","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":45,"anchor":null},"note_id":"n-3d2327301bdfe436b774","start":13,"end":55}],"profiles":{},"directory_counts":{}}
