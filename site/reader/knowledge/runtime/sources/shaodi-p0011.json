正文","text":"天霖雨汉水暴溢，德避水上堤，羽乘船四面射之，德被甲持弓箭不虚发","evidence":["lizang-q-d1ff6efce8f94c6690bb"]},{"id":"lizang-a-684d084fe7330f9fc26c","label":"正文","text":"将军董衡、部曲将董超等欲降，庞德皆收斩之","evidence":["lizang-q-ae7afaab0329f7bde126"]},{"id":"lizang-a-718fe3c01e7c88c351d3","label":"正文","text":"庞德自平旦力战至日过中，羽攻益急，矢尽短兵接战","evidence":["lizang-q-ee14036e58a0b89ec583"]},{"id":"lizang-a-b3c4770da273fffa046c","label":"正文","text":"庞德谓督将成何曰今日我死日也，战益怒气愈壮","evidence":["lizang-q-d43cbf6f9121717251c4"]},{"id":"lizang-a-7500837f3c330040fc4d","label":"正文","text":"水浸盛吏士皆降，德与麾下乘小船欲还仁营，水盛船覆，为羽所得","evidence":["lizang-q-d5573e7894d8f4ba3e69"]},{"id":"lizang-a-9de41ec13f7f612ca57d","label":"正文","text":"庞德立而不跪，骂羽宁为国家鬼不为贼将，遂为羽所杀","evidence":["lizang-q-45b0aacbba69dbd57302"]}],"participants":[{"person":"lizang-p0062","role":"欲降被斩","evidence":["lizang-q-ae7afaab0329f7bde126"]},{"person":"lizang-p0063","role":"欲降被斩","evidence":["lizang-q-ae7afaab0329f7bde126"]},{"person":"lizang-p0030","role":"所语之督将","evidence":["lizang-q-d43cbf6f9121717251c4"]},{"person":"shaodi-p0011","role":"屯樊战关羽，拒降被杀","evidence":["lizang-q-56bae898459683465bc1","lizang-q-4ef32b63a7f5ff4d8c5b","lizang-q-e8c144058b1ba9ddbc2c","lizang-q-66c8264ad0149c8289af","lizang-q-d1ff6efce8f94c6690bb","lizang-q-ae7afaab0329f7bde126","lizang-q-ee14036e58a0b89ec583","lizang-q-d43cbf6f9121717251c4","lizang-q-d5573e7894d8f4ba3e69","lizang-q-45b0aacbba69dbd57302"]},{"person":"wudi-p0172","role":"攻庞德，获后杀之","evidence":["lizang-q-56bae898459683465bc1","lizang-q-4ef32b63a7f5ff4d8c5b","lizang-q-e8c144058b1ba9ddbc2c","lizang-q-66c8264ad0149c8289af","lizang-q-d1ff6efce8f94c6690bb","lizang-q-ae7afaab0329f7bde126","lizang-q-ee14036e58a0b89ec583","lizang-q-d43cbf6f9121717251c4","lizang-q-d5573e7894d8f4ba3e69","lizang-q-45b0aacbba69dbd57302"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本篇独立行动，未继承范围不同的旧事件日期。","evidence":["lizang-q-56bae898459683465bc1","lizang-q-4ef32b63a7f5ff4d8c5b","lizang-q-e8c144058b1ba9ddbc2c","lizang-q-66c8264ad0149c8289af"