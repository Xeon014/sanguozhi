"file":"OEBPS/Text/titlepage_0090.xhtml","index":359,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-42809b8a0b3c90b8de16","start":104,"end":184,"offset_unit":"unicode_code_point"},{"id":"duzhou-q-77ec3a258aa2228abc7c","section":"chapter-042","block":"b-c6cbffcb1ef527fedb0b","layer":"pei","quote":"晋泰始二年，拜济阴太守。迁太子中庶子","attribution":"裴注·华阳国志","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":359,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-42809b8a0b3c90b8de16","start":85,"end":103,"offset_unit":"unicode_code_point"},{"id":"duzhou-q-af781386a604799f78eb","section":"chapter-042","block":"b-c6cbffcb1ef527fedb0b","layer":"pei","quote":"刺史费祎命为从事","attribution":"裴注·华阳国志","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":359,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-42809b8a0b3c90b8de16","start":35,"end":43,"offset_unit":"unicode_code_point"},{"id":"duzhou-q-cde57baedb335072971f","section":"chapter-042","block":"b-c4533519288fb7ac4fb2","layer":"original","quote":"周语次，因书版示立曰：“典午忽兮〖3〗，月酉没兮","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":340,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":23,"end":47,"offset_unit":"unicode_code_point"},{"id":"duzhou-q-e1e079a116404b04350b","section":"chapter-042","block":"b-c4533519288fb7ac4fb2","layer":"original","quote":"咸熙二年夏，巴郡文立从洛阳还蜀，过见周","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":340,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"duzhou-q-f7ef224bc67ce134524f","section":"chapter-042","block":"b-c6cbffcb1ef527fedb0b","layer":"pei","quote":"咸宁末卒","attribution":"裴注·华阳国志","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":359,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-42809b8a0b3c90b8de16","start":218,"end":222,"offset_unit":"unicode_code_point"},{"id":"duzhou-q2-ede0a9f966cc5baf4fa3","section":"chapter-042","block":"b-c6cbffcb1ef527fedb0b","layer":"pei","quote":"﹝一﹞《华阳国志》曰：“文立字广休。少治《毛诗》、《三礼》，兼通群书。刺史费祎命为从事。入为尚书郎，复辟祎大将军东曹掾，稍迁尚书。蜀并于魏，梁州建，首为别驾从事。举秀才。晋泰始二年，拜济阴太守。迁太子中庶子。立上言：‘故蜀大官及尽忠死事者子孙，虽仕郡国；或有不才，同之齐民为剧。又诸葛亮、蒋琬、费祎等子孙，流徙中畿。各宜量才叙用，以慰巴、蜀之心，倾吴人之望。’事皆施行。转散骑常侍，献可替否，多所补纳。稍迁卫尉。中朝服其贤雅，为时名卿。咸宁末卒。立章奏诗赋论颂，凡数十篇。”","attribution":"裴注（引书见原文）","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":359,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-42809b8a0b3c90b8de16","start":0,"end":237,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
