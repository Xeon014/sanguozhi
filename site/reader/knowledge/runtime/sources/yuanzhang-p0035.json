:"yuanzhang-f2-3f7b5be3282064e01a4f","text":"张承为张范之弟，以方正征，拜议郎，迁伊阙都尉。","evidence":["yuanzhang-q2-b587789d33253e5b5c5f"]}],"aliases":[],"mentions":[]}],"evidence":[{"id":"yuanzhang-q-0ab4cb212d128f2fc19d","section":"chapter-011","block":"b-47035c9b2392662d743d","layer":"original","quote":"太祖将西征〖22〗，征承参军事；至长安，病卒","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":86,"anchor":null},"note_id":null,"start":33,"end":55},{"id":"yuanzhang-q-11657430094aa021bc23","section":"chapter-011","block":"b-8dfbdb8ba5786a75295c","layer":"original","quote":"董卓作乱，承欲合徒众，与天下共诛卓","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":81,"anchor":null},"note_id":null,"start":32,"end":49},{"id":"yuanzhang-q-126f2072fc72d5f95be6","section":"chapter-011","block":"b-e6aeb1deb467ed07cee3","layer":"original","quote":"太祖表以为谏议大夫","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":83,"anchor":null},"note_id":null,"start":24,"end":33},{"id":"yuanzhang-q-33491d114944f4cc5136","section":"chapter-011","block":"b-8dfbdb8ba5786a75295c","layer":"original","quote":"与范避地扬州","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":81,"anchor":null},"note_id":null,"start":162,"end":168},{"id":"yuanzhang-q-3f826f5fcf992356d778","section":"chapter-011","block":"b-8dfbdb8ba5786a75295c","layer":"original","quote":"承然之，乃解印绶间行归家","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":81,"anchor":null},"note_id":null,"start":146,"end":158},{"id":"yuanzhang-q-75d67cf00da6604c86a8","section":"chapter-011","block":"b-0efd1a37f4da41cd753a","layer":"original","quote":"术问曰：“昔周室陵迟，则有桓、文之霸。秦失其政，汉接而用之。今孤以土地之广，士民之众；欲徼福齐桓〖7〗，拟迹高祖〖8〗。何如？”承对曰：“在德不在强！夫能用德以同天下之欲〖9〗，虽由匹夫之资，而兴霸王之功，不足为难。若苟僭拟，干时而动〖10〗；众之所弃，谁能兴之！”术不悦","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":82,"anchor":null},"note_id":null,"start":25,"end":161},{"id":"yuanzhang-q-8fac8c1410b44ba09de1","section":"chapter-011","block":"b-e6aeb1deb467ed07cee3","layer":"original","quote":"太祖平冀州，遣使迎范","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":83,"anchor":null},"note_id":null,"start":0,"end":10},{"id":"yuanzhang-q-918704e031a306f13793","section":"chapter-011","block":"b-0efd1a37f4da41cd753a","layer":"original","quote":"术复问曰：“今曹公欲以弊兵数千，敌十万之众，可谓不量力矣！子以为何如？”承乃曰：“汉德虽衰〖11〗，天命未改；今曹公挟天子以令天下，虽敌百万之众，可也。”术作色不怿〖12〗。承去之","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":82,"anchor":null},"note_id":null,"start":172,"end":262},{"id":"yuanzhang-q-968e6e2d5dd6406ac7b1","section":"chapter-011","block":"b-0efd1a37f4da41cd753a","layer":"original","quote":"袁术备礼招请。范称疾不往，术不强屈也；遣承与相见","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":82,"anchor":null},"note_id":null,"start":0,"end":24},{"id":"yuanzhang-q-bd8814fb3a4983557b88","section":"chapter-011","block":"b-47035c9b2392662d743d","layer":"original","quote":"魏国初建，承以丞相参军祭酒，领赵郡太守〖20〗，政化大行","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":86,"anchor":null},"note_id":null,"start":0,"end":28},{"id":"yuanzhang-q-c69973b637ffde9160de","section":"chapter-011","block":"b-8dfbdb8ba5786a75295c","layer":"original","quote":"谓承曰：“今欲诛卓，众寡不敌；且起一朝之谋，战阡陌之民〖4〗；士不素抚，兵不练习：难以成功。卓阻兵而无义〖5〗，固不能久。不若择所归附，待时而动；然后可以如志","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":81,"anchor":null},"note_id":null,"start":65,"end":144},{"id":"yuanzhang-q-ca2a7b8df9e699a38933","section":"chapter-011","block":"b-e6aeb1deb467ed07cee3","layer":"original","quote":"范以疾留彭城，遣承诣太祖","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":83,"anchor":null},"note_id":null,"start":11,"end":23},{"id":"yuanzhang-q2-a33b676da36dfadbf93d","section":"chapter-011","block":"b-47035c9b2392662d743d","layer":"original","quote":"魏国初建，承以丞相参军祭酒，领赵郡太守〖20〗，政化大行〖21〗。太祖将西征〖22〗，征承参军事；至长安，病卒。﹝一﹞","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":86,"anchor":null},"note_id":null,"start":0,"end":59},{"id":"yuanzhang-q2-a80d6a3fc47eb1e5bf66","section":"chapter-011","block":"b-0efd1a37f4da41cd753a","layer":"original","quote":"袁术备礼招请。范称疾不往，术不强屈也；遣承与相见，术问曰：“昔周室陵迟，则有桓、文之霸。秦失其政，汉接而用之。今孤以土地之广，士民之众；欲徼福齐桓〖7〗，拟迹高祖〖8〗。何如？”承对曰：“在德不在强！夫能用德以同天下之欲〖9〗，虽由匹夫之资，而兴霸王之功，不足为难。若苟僭拟，干时而动〖10〗；众之所弃，谁能兴之！”术不悦。是时，太祖将征冀州。术复问曰：“今曹公欲以弊兵数千，敌十万之众，可谓不量力矣！子以为何如？”承乃曰：“汉德虽衰〖11〗，天命未改；今曹公挟天子以令天下，虽敌百万之众，可也。”术作色不怿〖12〗。承去之。","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":82,"anchor":null},"note_id":null,"start":0,"end":263},{"id":"yuanzhang-q2-b587789d33253e5b5c5f","section":"chapter-011","block":"b-8dfbdb8ba5786a75295c","layer":"original","quote":"弟承，字公先，亦知名。以方正征〖2〗，拜议郎，迁伊阙都尉〖3〗。董卓作乱，承欲合徒众，与天下共诛卓。承弟昭，时为议郎，适从长安来，谓承曰：“今欲诛卓，众寡不敌；且起一朝之谋，战阡陌之民〖4〗；士不素抚，兵不练习：难以成功。卓阻兵而无义〖5〗，固不能久。不若择所归附，待时而动；然后可以如志。”承然之，乃解印绶间行归家〖6〗，与范避地扬州。","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":81,"anchor":null},"note_id":null,"start":0,"end":169}],"profiles":{},"directory_counts":{}}
