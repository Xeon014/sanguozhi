{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-o041b","title":"刘备破刘璋诸将并受李严降","accounts":[{"id":"xianzhu-e-o041b-account","label":"《先主传》正文","text":"刘璋诸将在涪败退绵竹，李严督绵竹军后率众降刘备。","evidence":["xianzhu-e-o041b-q"]},{"id":"xianzhu-a-p038-fucheng","label":"《益部耆旧杂记》","text":"《益部耆旧杂记》记张任、刘璝在涪败退，与刘循同守雒城。","evidence":["xianzhu-q-p038-fucheng"]},{"id":"liuliao-a-8336e0c7b0b844544758","label":"正文","text":"建安十八年严率众降先主拜裨将军","evidence":["liuliao-q-bff53060b5c21dc2f8b9"]},{"id":"huowang-a-3a6ff661ef31c5b5b5ee","label":"正文","text":"费诗举城降刘备","evidence":["huowang-q-aa9daafd244650a509ad"]},{"id":"dengzhang-a-8423036e1b270c09a0ba","label":"正文","text":"费观拒先主于绵竹后降","evidence":["dengzhang-q-3b1cd3ca2791ffff16c8"]}],"participants":[{"person":"liu-bei","role":"破军受降","evidence":["xianzhu-e-o041b-q"]},{"person":"wudi-p0253","role":"遣军","evidence":["xianzhu-e-o041b-q"]},{"person":"xianzhu-p0053","role":"拒守","evidence":["xianzhu-e-o041b-q"]},{"person":"xianzhu-p0054","role":"拒守","evidence":["xianzhu-e-o041b-q"]},{"person":"xianzhu-p0055","role":"拒守","evidence":["xianzhu-e-o041b-q"]},{"person":"xianzhu-p0056","role":"拒守","evidence":["xianzhu-e-o041b-q"]},{"person":"xianzhu-p0057","role":"率众降","evidence":["xianzhu-e-o041b-q"]},{"person":"xianzhu-p0066","role":"据《益部耆旧杂记》拒守败退","evidence":["xianzhu-q-p038-fucheng"]},{"person":"huowang-p0030","role":"先举城降","evidence":["huowang-q-aa9daafd244650a509ad"]},{"person":"xianzhu-p0063","role":"建安十八年参李严军，拒先主于绵竹，与严俱降","evidence":["dengzhang-q-3b1cd3ca2791ffff16c8"]}],"place":{"text":"涪、绵竹","evidence":["xianzhu-e-o041b-q"]},"time":{"label":"进据涪城后","precision":"relative","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xianzhu-e-o041b-q"],"after":"xianzhu-e-o041a"},"source_order":[32,167,"O041b"],"order":6561},{"id":"xianzhu-e-o043c","title":"刘备领益州牧并任用新旧诸臣","accounts":[{"id":"xianzhu-e-o043c-account","label":"《先主传》正文","text":"刘备领益州牧，以诸葛亮、法正等为辅，也显任刘璋旧臣、姻亲和曾受排斥者。","evidence":["xianzhu-e-o043c