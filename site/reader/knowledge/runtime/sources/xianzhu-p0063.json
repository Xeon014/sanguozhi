-q2-5e0f81287a5522082318","section":"chapter-045","block":"b-edd49427946d69daf035","layer":"original","quote":"刘璋母，观之族姑；璋又以女妻观。","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":174,"anchor":null},"note_id":null,"start":11,"end":27},{"id":"dongliu-q-e3070df472d0b9c41900","section":"chapter-039","block":"b-8e9e3c4c6d67f5fa476c","layer":"original","quote":"先主定蜀，征和为掌军中郎将","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":3,"anchor":null},"note_id":null,"start":0,"end":13},{"id":"huangli-q-b685b1081f6c75c813e8","section":"chapter-043","block":"b-962c82ad79e50c7a0854","layer":"original","quote":"成都既定，先主领益州牧，以恢为功曹书佐、主簿","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":57,"anchor":null},"note_id":null,"start":0,"end":22},{"id":"huowang-q-225ed2d7e9d667049592","section":"chapter-041","block":"b-20cf9e4bd23391868d15","layer":"original","quote":"成都既定，先主领益州牧，以诗为督军从事","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":169,"anchor":null},"note_id":null,"start":34,"end":53},{"id":"huowang-q-aa9daafd244650a509ad","section":"chapter-041","block":"b-20cf9e4bd23391868d15","layer":"original","quote":"先主攻绵竹时，诗先举城降","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":169,"anchor":null},"note_id":null,"start":21,"end":33},{"id":"liuliao-q-bff53060b5c21dc2f8b9","section":"chapter-040","block":"b-c85321149a539f796ae2","layer":"original","quote":"建安十八年，署严为护军，拒先主于绵竹。严率众降先主，先主拜严裨将军","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":186,"anchor":null},"note_id":null,"start":0,"end":33},{"id":"xianzhu-e-o041b-q","section":"chapter-032","block":"b-c205af65c5b891e6a027","layer":"original","quote":"璋遣刘z 、冷苞、张任、邓贤〔、吴懿〕等拒先主于涪；﹝三﹞皆破败，退保绵竹。璋复遣李严督绵竹诸军〖12〗，严率众降先主。先主军益强，分遣诸将平下属县。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":166,"anchor":null},"note_id":null,"start":76,"end":151},{"id":"xianzhu-e-o043c-q","section":"chapter-032","block":"b-4a221026fdb893201c62","layer":"original","quote":"先主复领益州牧：诸葛亮为股肱〖2〗，法正为谋主，关羽、张飞、马超为爪牙〖3〗，许靖、麋竺、简雍为宾友〖4〗。及董和、黄权、李严等〖5〗，本璋之所授用也，吴壹、费观等〖6〗，又璋之婚亲也；彭羕〖7〗，又璋之所排摈也；刘巴者〖8〗，宿昔之所忌恨也：皆处之显任，尽其器能。有志之士，无不竞劝。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":186,"anchor":null},"note_id":null,"start":63,"end":206},{"id":"xianzhu-q-b-dcc10490c7b3b72c467f","section":"chapter-032","block":"b-dcc10490c7b3b72c467f","layer":"modern","quote":"〖1〗十九年：建安十九年（公元 214）。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":188,"anchor":null},"note_id":"n-dc65792cc6043766510a","start":0,"end":21},{"id":"xianzhu-q-o043","section":"chapter-032","block":"b-4a221026fdb893201c62","layer":"original","quote":"十九年夏〖1〗，雒城破；﹝一﹞进围成都，数十日，璋出降。﹝二﹞蜀中殷盛丰乐，先主置酒大飨士卒；取蜀城中金银分赐将士，还其谷帛。先主复领益州牧：诸葛亮为股肱〖2〗，法正为谋主，关羽、张飞、马超为爪牙〖3〗，许靖、麋竺、简雍为宾友〖4〗。及董和、黄权、李严等〖5〗，本璋之所授用也，吴壹、费观等〖6〗，又璋之婚亲也；彭羕〖7〗，又璋之所排摈也；刘巴者〖8〗，宿昔之所忌恨也：皆处之显任，尽其器能。有志之士，无不竞劝。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":186,"anchor":null},"note_id":null,"start":0,"end":206},{"id":"xianzhu-q-p038-fucheng","section":"chapter-032","block":"b-8aa718c2e93c0cc7db20","layer":"pei","quote":"刘璋遣张任、刘璝，率精兵拒捍先主于涪；为先主所破，退与璋子循守雒城。","attribution":"《益部耆旧杂记》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":197,"anchor":null},"note_id":"n-9652930478437e755980","start":14,"end":48},{"id":"xumisun-q-9d9c6c3cd013f113898d","section":"chapter-038","block":"b-4724e70f37115927f07b","layer":"original","quote":"先主克蜀，以靖为左将军长史","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":148,"anchor":null},"note_id":null,"start":7,"end":20}],"profiles":{},"directory_counts":{}}
