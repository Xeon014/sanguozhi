{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"lizang-e-o278","title":"《勇侠传》：噉人贼数十人略鲍出之母，以绳贯其手掌驱去；初等怖恐不敢追逐","accounts":[{"id":"lizang-a-12f288cca57486b7c647","label":"裴注·魏略《勇侠传》","text":"《勇侠传》：噉人贼数十人略鲍出之母，以绳贯其手掌驱去；初等怖恐不敢追逐","evidence":["lizang-q-3910b73398dee857b96b"]},{"id":"lizang-a-6dc55fc14597e073765a","label":"裴注·魏略《勇侠传》","text":"《勇侠传》：鲍出到知母被略，兄弟皆云贼众当如何，出怒曰有母而使贼贯其手用活何为，乃独追之","evidence":["lizang-q-7216379afdfa1040f9a9"]},{"id":"lizang-a-20fd55e8090260c3efe4","label":"裴注·魏略《勇侠传》","text":"《勇侠传》：贼布列待出，出回从一头斫贼四五人；贼复合聚围出，出跳越围斫之又杀十余人","evidence":["lizang-q-95c18a7973cdde199a29"]},{"id":"lizang-a-9b28e9803376aee751dc","label":"裴注·魏略《勇侠传》","text":"《勇侠传》：贼驱出母前去，连击出不胜走与前辈合；出复追击之，还见其母与比舍妪同贯相连","evidence":["lizang-q-4c8ef5b6af8bae23baa8"]},{"id":"lizang-a-fd4109cfa5085bed42fa","label":"裴注·魏略《勇侠传》","text":"《勇侠传》：出奋击贼，责数指母以示，贼乃解还出母；比舍妪求哀，出指言此我嫂也，贼复解还之","evidence":["lizang-q-9239222a497e25d05d3a"]},{"id":"lizang-a-8a50d737d77a6e41469a","label":"裴注·魏略《勇侠传》","text":"《勇侠传》：出得母还，遂相扶侍，客南阳","evidence":["lizang-q-76167db6717a5f9afbb1"]}],"participants":[{"person":"lizang-p0082","role":"怖恐不敢追；谏疑","evidence":["lizang-q-3910b73398dee857b96b","lizang-q-7216379afdfa1040f9a9"]},{"person":"lizang-p0084","role":"怖恐不敢追；谏疑","evidence":["lizang-q-3910b73398dee857b96b","lizang-q-7216379afdfa1040f9a9"]},{"person":"lizang-p0083","role":"怖恐不敢追；谏疑","evidence":["lizang-q-3910b73398dee857b96b","lizang-q-7216379afdfa1040f9a9"]},{"person":"lizang-p0081","role":"怒而独追及贼；斫贼杀十余人；复追击贼；责贼得还其母并比舍妪；得母客南阳","evidence":["lizang-q-7216379afdfa1040f9a9","lizang-q-95c18a7973cdde199a29","lizang-q-4c8ef5b6af8bae23baa8","lizang-q-9239222a497e25d05d3a","lizang-q-76167db6717a5f9afbb1"]},{"person":"lizang-p-baochu","role":"持粮归家遇贼、怖恐不敢追逐","evidence":["lizang-q-3910b73398dee857b96b"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["lizang-q-3910b73398dee857b96b","lizang-q-7216379afdfa1040f9a9","lizang-q-95c18a7973cdde199a29","lizang-q-4c8ef5b6af8bae23baa8","lizang-q-9239222a497e25d05d3a","lizang-q-76167db6717a5f9afbb1"]},"ordering_evidence":"lizang-q-3910b73398dee857b96b","source_order":[18,281,94],"order":3728},{"id":"lizang-e-o279","title":"《勇侠传》：建安五年关中始开，出北归；母不能步行，出以笼盛母独自负之到乡里","accounts":[{"id":"lizang-a-0e16d3ce69959109c150","label":"裴注·魏略《勇侠传》","text":"《勇侠传》：建安五年关中始开，出北归；母不能步行，出以笼盛母独自负之到乡里","evidence":["lizang-q-6bd5e76bbd6c15f735ee"]}],"participants":[{"person":"lizang-p0081","role":"以笼盛母自负北归","evidence":["lizang-q-6bd5e76bbd6c15f735ee"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["lizang-q-6bd5e76bbd6c15f735ee"]},"ordering_evidence":"lizang-q-6bd5e76bbd6c15f735ee","source_order":[18,281,409],"order":3729},{"id":"lizang-e-o280","title":"《勇侠传》：乡里士大夫嘉其孝烈欲荐州郡，郡辟召出，出辞曰田民不堪冠带","accounts":[{"id":"lizang-a-f1e1834f7502b8939be5","label":"裴注·魏略《勇侠传》","text":"《勇侠传》：乡里士大夫嘉其孝烈欲荐州郡，郡辟召出，出辞曰田民不堪冠带","evidence":["lizang-q-4aeec64f3e5f302e8010"]}],"participants":[{"person":"lizang-p0081","role":"辞郡辟召","evidence":["lizang-q-4aeec64f3e5f302e8010"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["lizang-q-4aeec64f3e5f302e8010"]},"ordering_evidence":"lizang-q-4aeec64f3e5f302e8010","source_order":[18,281,471],"order":3730},{"id":"lizang-e-o281","title":"《勇侠传》：至青龙中母年百余岁乃终，出时年七十余，行丧如礼","accounts":[{"id":"lizang-a-2b72141d1ecbdb020a53","label":"裴注·魏略《勇侠传》","text":"《勇侠传》：至青龙中母年百余岁乃终，出时年七十余，行丧如礼","evidence":["lizang-q-be4aaf6df2b72cc70a6e"]}],"participants":[{"person":"lizang-p0081","role":"行丧如礼","evidence":["lizang-q-be4aaf6df2b72cc70a6e"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["lizang-q-be4aaf6df2b72cc70a6e"]},"ordering_evidence":"lizang-q-be4aaf6df2b72cc70a6e","source_order":[18,281,505],"order":3731}],"persons":[{"id":"lizang-p0081","name":"鲍出","evidence":["lizang-q-7216379afdfa1040f9a9","lizang-q-95c18a7973cdde199a29","lizang-q-4c8ef5b6af8bae23baa8","lizang-q-9239222a497e25d05d3a","lizang-q-76167db6717a5f9afbb1","lizang-q-6bd5e76bbd6c15f735ee","lizang-q-4aeec64f3e5f302e8010","lizang-q-be4aaf6df2b72cc70a6e"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[{"id":"lizang-q-3910b73398dee857b96b","section":"chapter-018","block":"b-edafdfb7985563e25ca5","layer":"pei","quote":"初等到家，而噉人贼数十人，已略其母；以绳贯其手掌，驱去。初等怖恐，不敢追逐","attribution":"裴注·魏略《勇侠传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":280,"anchor":null},"note_id":"n-48d5c144befb35f43c2d","start":94,"end":131},{"id":"lizang-q-4aeec64f3e5f302e8010","section":"chapter-018","block":"b-edafdfb7985563e25ca5","layer":"pei","quote":"乡里士大夫，嘉其孝烈，欲荐州郡；郡辟召出，出曰：‘田民，不堪冠带","attribution":"裴注·魏略《勇侠传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":280,"anchor":null},"note_id":"n-48d5c144befb35f43c2d","start":471,"end":503},{"id":"lizang-q-4c8ef5b6af8bae23baa8","section":"chapter-018","block":"b-edafdfb7985563e25ca5","layer":"pei","quote":"时贼分布，驱出母，前去。贼连击出，不胜，乃走与前辈合。出复追击之，还见其母，与比舍妪同贯相连","attribution":"裴注·魏略《勇侠传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":280,"anchor":null},"note_id":"n-48d5c144befb35f43c2d","start":255,"end":301},{"id":"lizang-q-6bd5e76bbd6c15f735ee","section":"chapter-018","block":"b-edafdfb7985563e25ca5","layer":"pei","quote":"建安五年，关中始开，出来北归；而其母不能步行。兄弟欲共舆之，出以舆车历山险危，不如负之安稳；乃以笼盛其母，独自负之，到乡里","attribution":"裴注·魏略《勇侠传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":280,"anchor":null},"note_id":"n-48d5c144befb35f43c2d","start":409,"end":470},{"id":"lizang-q-7216379afdfa1040f9a9","section":"chapter-018","block":"b-edafdfb7985563e25ca5","layer":"pei","quote":"须臾，出从后到，知母为贼所略，欲追贼。兄弟皆云：‘贼众，当如何？’出怒曰：‘有母而使贼贯其手，将去煮噉之，用活何为！’乃攘臂结衽独追之，行数里及贼","attribution":"裴注·魏略《勇侠传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":280,"anchor":null},"note_id":"n-48d5c144befb35f43c2d","start":132,"end":205},{"id":"lizang-q-76167db6717a5f9afbb1","section":"chapter-018","block":"b-edafdfb7985563e25ca5","layer":"pei","quote":"出得母还，遂相扶侍，客南阳","attribution":"裴注·魏略《勇侠传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":280,"anchor":null},"note_id":"n-48d5c144befb35f43c2d","start":395,"end":408},{"id":"lizang-q-9239222a497e25d05d3a","section":"chapter-018","block":"b-edafdfb7985563e25ca5","layer":"pei","quote":"出遂复奋击贼，贼问出曰：‘卿欲何得？’出责数贼，指其母以示之；贼乃解还出母。比舍妪独不解，遥望出求哀。出复斫贼，贼谓出曰：‘已还卿母，何为不止？’出又指求哀妪：‘此我嫂也！’贼复解还之","attribution":"裴注·魏略《勇侠传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":280,"anchor":null},"note_id":"n-48d5c144befb35f43c2d","start":302,"end":394},{"id":"lizang-q-95c18a7973cdde199a29","section":"chapter-018","block":"b-edafdfb7985563e25ca5","layer":"pei","quote":"贼望见出，乃共布列待之。出到，回从一头，斫贼四五人。贼走，复合聚围出；出跳越围，斫之，又杀十余人","attribution":"裴注·魏略《勇侠传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":280,"anchor":null},"note_id":"n-48d5c144befb35f43c2d","start":206,"end":254},{"id":"lizang-q-be4aaf6df2b72cc70a6e","section":"chapter-018","block":"b-edafdfb7985563e25ca5","layer":"pei","quote":"至青龙中，母年百余岁乃终，出时年七十余，行丧如礼","attribution":"裴注·魏略《勇侠传》","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":280,"anchor":null},"note_id":"n-48d5c144befb35f43c2d","start":505,"end":529}],"profiles":{},"directory_counts":{}}
