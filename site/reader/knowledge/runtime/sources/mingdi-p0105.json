s":[{"id":"xiahoucao-f0045","label":"字","text":"长思","evidence":["xiahoucao-f0045-q"]}],"aliases":[{"text":"长思","evidence":["xiahoucao-f0045-q"]}],"mentions":[{"id":"mingdi-m-p058-mingdi-p0105","kind":"mention","text":"文中提及","evidence":["mingdi-q-p058"]},{"id":"xiahoucao-m-o046-mingdi-p0105","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-o046"]},{"id":"xiahoucao-m-p022-mingdi-p0105","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-p022"]}]}],"evidence":[{"id":"chengguo-q-029b7356f91faf07f7f6","section":"chapter-014","block":"b-a638d9784fc427a6f989","layer":"pei","quote":"放、资久典机任，献、肇心内不平。殿中有鸡栖树，二人相谓：‘此亦久矣！其能复几？’指谓放、资。放、资惧，乃劝帝召宣王。帝作手诏，令给使辟邪，至以授宣王。宣王在汲，献等先诏，令于轵关西还长安；辟邪又至，宣王疑有变。呼辟邪具问，乃乘追锋车驰至京师。帝问放、资：‘谁可与太尉对者？’放曰：‘曹爽。’帝曰：‘堪其事不？’爽在左右，流汗不能对。放蹑其足，耳之曰：‘臣以死奉社稷！’","attribution":"正文","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":533,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f69dd3b4e827e95f0087","start":10,"end":194,"offset_unit":"unicode_code_point"},{"id":"chengguo-q-1523903c75411dafc09b","section":"chapter-014","block":"b-a453325bbcfb30926f5f","layer":"original","quote":"其年，帝寝疾，欲以燕王宇为大将军，及领军将军夏侯献、武卫将军曹爽、屯骑校尉曹肇、骁骑将军秦朗共辅政〖1〗。宇性恭良，陈诚固辞","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":511,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":62,"offset_unit":"unicode_code_point"},{"id":"chengguo-q-7493277632efc144fd31","section":"chapter-014","block":"b-a638d9784fc427a6f989","layer":"pei","quote":"曹肇弟纂为大将军司马。燕王颇失指，肇出，纂见，惊曰：‘上不安，云何悉共出？宜还！’已暮，放、资宣诏宫门：“不得复纳肇等，罢燕王。”肇明日至门，不得入；惧，诣廷尉，以处事失宜免。帝谓献曰：‘吾已差，便出。’献流涕而出，亦免","attribution":"裴注·《世语》","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":533,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f69dd3b4e827e95f0087","start":194,"end":304,"offset_unit":"unicode_code_point"},{"id":"chengguo-q-7b46e61e56260dc2cd6f","section":"chapter-014","block":"b-0658bbe4420b47d45ac8","layer":"original","quote":"放、资既出，帝意复变，诏止宣王勿使来。寻更见放、资，曰：“我自召太尉，而曹肇等反使吾止之。几败吾事！”命更为诏。帝独召爽与放、资，俱受诏命","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":512,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":101,"end":170,"offset_unit":"unicode_code_point"},{"id":"chengguo-q-da19071eaa5b283f269b","section":"chapter-014","block":"b-0658bbe4420b47d45ac8","layer":"original","quote":"遂免宇、献、肇、朗官。太尉亦至，登床受诏，然后帝崩","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":512,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":171,"end":196,"offset_unit":"unicode_code_point"},{"id":"mingdi-e-p058a-q","section":"chapter-003","block":"b-479566b169dbc75ea2fe","layer":"pei","quote":"帝以燕王宇为大将军，使与领军将军夏侯献、武卫将军曹爽、屯骑校尉曹肇、骁骑将军秦朗等，对辅政。","attribution":"裴注·汉晋春秋","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":489,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-3df5334abffeb752155c","start":12,"end":58,"offset_unit":"unicode_code_point"},{"id":"mingdi-e-p058c-q","section":"chapter-003","block":"b-479566b169dbc75ea2fe","layer":"pei","quote":"放、资出，曹肇入，泣涕固谏，帝使肇敕停。肇出户，放、资趋而往，复说止帝，帝又从其言。放曰：‘宜为手诏。’帝曰：‘我困笃，不能。’放即上床，执帝手强作之；遂赍出，大言曰：‘有诏免燕王宇等官，不得停省中！’于是宇、肇、献、朗，相与泣而归第。","attribution":"裴注·汉晋春秋","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":489,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-3df5334abffeb752155c","start":401,"end":519,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-b-78ee587f18f11aa30bd9","section":"chapter-003","block":"b-78ee587f18f11aa30bd9","layer":"modern","quote":"〖1〗二年：景初二年（公元 238 ）。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":438,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-917b5dc4aecce5a0dcf4","start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-o059","section":"chapter-003","block":"b-5790b2efe14805978c50","layer":"original","quote":"二年春正月〖1〗，诏太尉司马宣王。率众讨辽东。﹝一﹞","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":434,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":26,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-p058","section":"chapter-003","block":"b-479566b169dbc75ea2fe","layer":"pei","quote":"﹝二﹞《汉晋春秋》曰：“帝以燕王宇为大将军，使与领军将军夏侯献、武卫将军曹爽、屯骑校尉曹肇、骁骑将军秦朗等，对辅政。中书监刘放、令孙资，久专权宠，为朗等素所不善，惧有后害，阴图间之；而宇常在帝侧，故未得有言。甲申，帝气微，宇下殿呼曹肇有所议，未还。而帝少间，惟曹爽独在。放知之，呼资与谋。资曰：‘不可动也！’放曰：‘俱入鼎镬，何不可之有？’乃突前见帝，垂泣曰：‘陛下气微，若有不讳，将以天下付谁？’帝曰：‘卿不闻用燕王耶？’放曰：‘陛下忘先帝诏敕：藩王不得辅政。且陛下方病，而曹肇、秦朗等便与才人侍疾者言戏；燕王拥兵南面，不听臣等入：此即竖刁、赵高也。今皇太子幼弱，未能统政；外有强暴之寇，内有劳怨之民。陛下不远虑存亡，而近系恩旧；委祖宗之业，付二三凡士；寝疾数日，外内壅隔；社稷危殆，而己不知：此臣等所以痛心也。’帝得放言，大怒曰：‘谁可任者？’放、资乃举爽代宇，又白‘宜诏司马宣王使相参’，帝从之。放、资出，曹肇入，泣涕固谏，帝使肇敕停。肇出户，放、资趋而往，复说止帝，帝又从其言。放曰：‘宜为手诏。’帝曰：‘我困笃，不能。’放即上床，执帝手强作之；遂赍出，大言曰：‘有诏免燕王宇等官，不得停省中！’于是宇、肇、献、朗，相与泣而归第。”","attribution":"裴注·汉晋春秋","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":489,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-3df5334abffeb752155c","start":0,"end":520,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o046a-q","section":"chapter-009","block":"b-743255c2ff91643e1b02","layer":"original","quote":"子肇嗣。﹝三﹞肇有当世才度〖14〗，为散骑常侍、屯骑校尉。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":193,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":29,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o046b-q","section":"chapter-009","block":"b-743255c2ff91643e1b02","layer":"original","quote":"明帝寝疾，方与燕王宇等属以后事〖15〗。帝意寻变，诏肇以侯归第。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":193,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":29,"end":61,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o046c-q","section":"chapter-009","block":"b-743255c2ff91643e1b02","layer":"original","quote":"正始中薨，追赠卫将军。子兴嗣。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":193,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":61,"end":76,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-f0045-q","section":"chapter-009","block":"b-1a71feb1f2d4ee321f41","layer":"pei","quote":"肇字长思","attribution":"《世语》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":215,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ffa58c1f5016347f7740","start":10,"end":14,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-o046","section":"chapter-009","block":"b-743255c2ff91643e1b02","layer":"original","quote":"子肇嗣。﹝三﹞肇有当世才度〖14〗，为散骑常侍、屯骑校尉。明帝寝疾，方与燕王宇等属以后事〖15〗。帝意寻变，诏肇以侯归第。正始中薨，追赠卫将军。子兴嗣。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":193,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":76,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-p022","section":"chapter-009","block":"b-1a71feb1f2d4ee321f41","layer":"pei","quote":"﹝三﹞《世语》曰：“肇字长思。”","attribution":"《世语》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":215,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ffa58c1f5016347f7740","start":0,"end":16,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
