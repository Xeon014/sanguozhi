ll,"start":0,"end":32,"offset_unit":"unicode_code_point"},{"id":"chenghuang-q-e18f917d554e5c87c184","section":"chapter-055","block":"b-e72fef5ce21e92071b11","layer":"original","quote":"及权为魏称藩，魏使邢贞拜权为吴王。权出都亭〖5〗，候贞：贞有骄色。张昭既怒，而盛忿愤，顾谓同列曰：“盛等不能奋身出命，为国家并许、洛，吞巴、蜀；而令吾君与贞盟，不亦辱乎","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":309,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":84,"offset_unit":"unicode_code_point"},{"id":"shiyi-q-9714004db8375492106e","section":"chapter-062","block":"b-b31f3eb400a8ebab33df","layer":"original","quote":"魏拜权为吴王","section_title":"是仪胡综传第十七","source":{"file":"OEBPS/Text/titlepage_0131.xhtml","index":53,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":56,"end":62,"offset_unit":"unicode_code_point"},{"id":"wendi-e-o024b-q","section":"chapter-002","block":"b-9a2a78a2554a86eba350","layer":"original","quote":"丁巳〖2〗，使太常邢贞，持节拜权为大将军，封吴王，加九锡。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":265,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":21,"end":50,"offset_unit":"unicode_code_point"},{"id":"wendi-q-b-ec88012a7f6c352d0e04","section":"chapter-002","block":"b-ec88012a7f6c352d0e04","layer":"modern","quote":"〖1〗二年：黄初二年（公元 221）。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":210,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8fff547b113ffa36bbc1","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wendi-q-o019","section":"chapter-002","block":"b-8820e5c7f9006d364c44","layer":"original","quote":"二年春正月〖1〗，郊祀天地、明堂〖2〗。甲戌〖3〗，校猎至原陵〖4〗。遣使者，以太牢祠汉世祖〖5〗。乙亥〖6〗，朝日于东郊〖7〗。﹝一﹞初令郡国口满十万者〖8〗，岁察孝廉一人；其有秀异〖9〗，无拘户口。辛巳〖10〗，分三公户邑，封子弟各一人为列侯。壬午〖11〗，复颍川郡一年田租〖12〗。﹝二﹞改许县为许昌县。以魏郡东部为阳平郡〖13〗，西部为广平郡〖14〗。﹝三﹞","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":208,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":183,"offset_unit":"unicode_code_point"},{"id":"wendi-q-o024","section":"chapter-002","block":"b-9a2a78a2554a86eba350","layer":"original","quote":"秋八月，孙权遣使奉章，并遣于禁等还〖1〗。丁巳〖2〗，使太常邢贞，持节拜权为大将军，封吴王，加九锡。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":265,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":50,"offset_unit":"unicode_code_point"},{"id":"wufan-q-3e759ce5b16277af6c9b","section":"chapter-063","block":"b-2917683be1b448479475","layer":"original","quote":"范秘惜其术，不以至要语权〖1〗：权由是恨之。﹝一﹞初，权为将军时，范尝白言：“江南有王气，亥子之间有大福庆〖2〗。”权曰：“若终如言，以君为侯。”及立为吴王，范时侍宴，曰：“昔在吴中〖3〗，尝言此事；大王识之邪〖4〗？”权曰：“有之。”因呼左右，以侯绶带范〖5〗。范知权欲以厌当前言〖6〗，辄手推不受。及后论功行封，以范为都亭侯。诏临当出，权恚其爱道于己也〖7〗，削除其名。","section_title":"吴范刘惇赵达传第十八","source":{"file":"OEBPS/Text/titlepage_0133.xhtml","index":27,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":187,"offset_unit":"unicode_code_point"},{"id":"wuzhu-e-o048a-q","section":"chapter-047","block":"b-12badf2c8b3af876e3d1","layer":"original","quote":"今封君为吴王。使使持节、太常、高平侯贞〖42〗，授君玺绶、策书；金虎符第一至第五左，竹使符第一至第十〖43〗；以大将军，使持节，督交州〖44〗，领荆州牧事；锡君青土〖45〗，苴以白茅〖46〗：对扬朕命〖47〗，以尹东夏〖48〗。其上故骠骑将军、南昌侯印绶、符、策〖49〗。今又加君九锡〖50〗，其敬听后命：","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":194,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":153,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-b-1840417ed1a4f3620717","section":"chapter-047","block":"b-1840417ed1a4f3620717","layer":"modern","quote":"〖42〗使持节：一种表示享有诛杀威权的名号。魏晋时类似的名号有使持节、持节、假节三种。使持节可杀二千石以下的官员，持节可杀无官位的人，假节可在出兵时杀违犯军令者。上述名号通常给予统兵的重要将领，有时也给予担负特殊使命的官员。太常：官名。九卿之首。主管国家礼仪制度和祭祀活动。贞：即邢贞。事见本书卷五十五《徐盛传》。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":242,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-879a7508a1768ef08c4c","start":0,"end":157,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o046-judgment","section":"chapter-047","block":"b-1235cbaed93d5a84ad0d","layer":"original","quote":"盖圣王之法，以德设爵，以功制禄；劳大者禄厚，德盛者礼丰。故叔旦有夹辅之勋〖19〗，太公有鹰扬之功〖20〗；并启土宇〖21〗，并受备物〖22〗：所以表章元功〖23〗，殊异贤哲也〖24〗。近汉高祖受命之初〖25〗，分裂膏腴以王八姓〖26〗。斯则前世之懿事〖27〗，后王之元龟也〖28〗。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":192,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":141,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o047-judgment","section":"chapter-047","block":"b-56badd6664cf499ab057","layer":"original","quote":"朕以不德〖29〗，承运革命〖30〗；君临万国，秉统天机；思齐先代〖31〗，坐而待旦〖32〗。惟君天资忠亮〖33〗，命世作佐〖34〗；深睹历数〖35〗，达见废兴；远遣行人〖36〗，浮于潜、汉〖37〗；﹝三﹞望风影附，抗疏称藩〖38〗；兼纳纤6 南方之贡〖39〗，普遣诸将来还本朝〖40〗；忠肃内发，款诚外昭〖41〗；信著金石，义盖山河：朕甚嘉焉！","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":193,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":172,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o048","section":"chapter-047","block":"b-12badf2c8b3af876e3d1","layer":"original","quote":"今封君为吴王。使使持节、太常、高平侯贞〖42〗，授君玺绶、策书；金虎符第一至第五左，竹使符第一至第十〖43〗；以大将军，使持节，督交州〖44〗，领荆州牧事；锡君青土〖45〗，苴以白茅〖46〗：对扬朕命〖47〗，以尹东夏〖48〗。其上故骠骑将军、南昌侯印绶、符、策〖49〗。今又加君九锡〖50〗，其敬听后命：","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":194,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":153,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o049-judgment","section":"chapter-047","block":"b-330dad6a13a8a6ee35b2","layer":"original","quote":"以君绥安东南，纲纪江外〖51〗；民夷安业〖52〗，无或携贰〖53〗。是用锡君大辂、戎辂各一〖54〗，玄牡二驷〖55〗。君务财劝农，仓库盈积。是用锡君衮冕之服〖56〗，赤舄副焉〖57〗。君化民以德，礼教兴行。是用锡君轩悬之乐〖58〗。君宣导休风〖59〗，怀柔百越〖60〗。是用锡君朱户以居〖61〗。君运其才谋，官方任贤。是用锡君纳陛以登〖62〗。君忠勇并奋，清除奸慝〖63〗。是用锡君虎贲之士百人〖64〗。君振威陵迈，宣力荆南〖65〗；枭灭凶丑〖66〗，罪人斯得。是用锡君&钺各一〖67〗。君文和于内，武信于外。是用锡君彤弓一、彤矢百、玈弓十、玈矢千〖68〗。君以忠肃为基，恭俭为德。是用锡君秬鬯一卣〖69〗，圭瓒副焉〖70〗。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":195,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":313,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o050-judgment","section":"chapter-047","block":"b-98a7edf2a802d75c1593","layer":"original","quote":"钦哉〖71〗！敬敷训典〖72〗，以服朕命，以勖相我国家〖73〗，永终尔显烈〖74〗！﹝四﹞","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":196,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":45,"offset_unit":"unicode_code_point"},{"id":"zhanggu-q-e878294a84c0f64341e0","section":"chapter-052","block":"b-9f04aeb4c8d4166b3e95","layer":"original","quote":"魏黄初二年，遣使者邢贞，拜权为吴王。贞入门，不下车。昭谓贞曰：“夫礼无不敬，故法无不行。而君敢自尊大，岂以江南寡弱，无方寸之刃故乎！”贞即遽下车〖10〗。拜昭为绥远将军，封由拳侯","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":24,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":89,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
