{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dongyuan-e-p101c","title":"袁术任陈瑀陈瑀拒术入寿春术攻之瑀奔下邳","accounts":[{"id":"dongyuan-e-p101c-account","label":"裴松之按《英雄记》","text":"袁术任陈瑀陈瑀拒术入寿春术攻之瑀奔下邳","evidence":["dongyuan-e-p101c-q"]},{"id":"zhulv-a-2185b3fb7660ade4e6b2","label":"裴注·九州春秋","text":"初平三年，扬州刺史陈祎死，袁术使瑀领扬州牧","evidence":["zhulv-q-4630ec617ea6042f8d68"]},{"id":"zhulv-a-5885709174cd6691c7ef","label":"裴注·九州春秋","text":"后术为曹公所败于封丘，南人叛瑀，瑀拒之","evidence":["zhulv-q-9fa58c8f15bfcfd0fb17"]},{"id":"zhulv-a-715fe540df31ac0030d8","label":"裴注·九州春秋","text":"术走阴陵，好辞以下瑀；瑀不知权而又怯，不即攻术；术于淮北集兵，向寿春","evidence":["zhulv-q-94bffb52918b1d9d4422"]},{"id":"zhulv-a-7f3671a142f6f44137a7","label":"裴注·九州春秋","text":"瑀惧，使其弟公琰请和于术；术执之而进，瑀走归下邳","evidence":["zhulv-q-f8c485d3cf68b7829db1"]}],"participants":[{"person":"wudi-p0057","role":"任将进攻","evidence":["dongyuan-e-p101c-q"]},{"person":"sunshi-p0066","role":"拒守败走","evidence":["dongyuan-e-p101c-q"]},{"person":"identity-six-20261024-p-chen-yi-yangzhou","role":"死者","evidence":["zhulv-q-4630ec617ea6042f8d68"]},{"person":"cao-cao","role":"破术者","evidence":["zhulv-q-9fa58c8f15bfcfd0fb17"]},{"person":"zhulv-p0019","role":"请和而被执者","evidence":["zhulv-q-f8c485d3cf68b7829db1"]}],"place":null,"time":{"label":"陈温袁遗陈瑀领扬州时异说","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-p101c-q"]},"ordering_evidence":"dongyuan-e-p101c-q","source_order":[6,401,"P101c"],"order":1724},{"id":"sunshi-e-p043b","title":"汉诏孙策与吕布陈瑀合讨袁术","accounts":[{"id":"sunshi-e-p043b-account","label":"《江表传》","text":"汉诏孙策与吕布陈瑀合讨袁术","evidence":["sunshi-e-p043b-q"]}],"participants":[{"person":"wudi-p0099","role":"奉诏","evidence":["sunshi-e-p043b-q"]},{"person":"wudi-p0088","role":"被诏协讨","evidence":["sunshi-e-p043b-q"]},{"person":"sunshi-p0066","role":"被诏协讨","evidence":["sunshi-e-p043b-q"]}],"place":null,"time":{"year":197,"label":"建安二年夏","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"sunshi-