3973ee446239797a2d8b","gongsuntao-q-d0e7ebb86ceef656cc51","gongsuntao-q-d5b48e7e8e273ee81eb1","gongsuntao-q-be397858d78490ad5185","hechang-q-3517092086a46fea71c6"],"facts":[{"id":"gongsuntao-f-review-a42afe99618f03a61092","text":"字稚叔，云中人；以武勇给并州，为武猛从事","evidence":["gongsuntao-q-3973ee446239797a2d8b"]},{"id":"gongsuntao-f-review-c462ef73f78a64eb3efb","text":"英雄记记：性仁和，无威刑；下人谋反发觉，对之涕泣，辄原不问","evidence":["gongsuntao-q-d0e7ebb86ceef656cc51"]}],"aliases":[],"mentions":[{"id":"wudi-m-p043-wudi-p0123","kind":"mention","text":"文中提及","evidence":["wudi-q-p043"]},{"id":"wudi-m-o061-wudi-p0123","kind":"mention","text":"文中提及","evidence":["wudi-q-o061"]},{"id":"wudi-m-o143-wudi-p0123","kind":"mention","text":"文中提及","evidence":["wudi-q-o143"]},{"id":"xunyu-m-o012-wudi-p0123","kind":"mention","text":"文中提及","evidence":["xunyu-q-o012"]},{"id":"dongyuan-m-o024-wudi-p0123","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o024"]},{"id":"dongyuan-m-p063-wudi-p0123","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p063"]},{"id":"gongsuntao-m-review-c8967fe23d6c5b6fb2bd","kind":"mention","text":"张杨见于相关言论或记载。","evidence":["gongsuntao-q-4bfbe59d87df62dc7326"]}]}],"evidence":[{"id":"chengguo-q-18e7df018d24c580109c","section":"chapter-014","block":"b-d8c6ae6df95ba88cf5a4","layer":"original","quote":"张杨为其将杨丑所杀，杨长史薛洪、河内太守缪尚，城守，待绍救","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":177,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":14,"end":43,"offset_unit":"unicode_code_point"},{"id":"chengguo-q-1e212c3fbd80dda62e9e","section":"chapter-014","block":"b-b1674351a179433bc204","layer":"original","quote":"杨亦遣使诣太祖。太祖遗杨犬马金帛，遂与西方往来。","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":153,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":203,"end":227,"offset_unit":"unicode_code_point"},{"id":"chengguo-q-34bc311ca8f69b01c8fb","section":"chapter-014","block":"b-b1674351a179433bc204","layer":"original","quote":"昭说杨曰：“袁、曹虽为一家，势不久群〖10〗。曹今虽弱，然实天下之英雄也。当故结之，况今有缘？宜通其上事〖11〗，并表荐之；若事有成，永为深分〖12〗。”杨于是通太祖上事，表荐太祖。","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":153,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":86,"end":177,"offset_unit":"unicode_code_point"},{"id":"chengguo-q-41de9a4d30ecd2dd09f4","section":"chapter-014","block":"b-b1674351a179433bc204","layer":"original","quote":"因杨上还印绶〖8〗。拜骑都尉","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":153,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":43,"end":57,"offset_unit":"unicode_code_point"},{"id":"chengguo-q-580ba27586037604a4f0","section":"chapter-014","block":"b-b1674351a179433bc204","layer":"original","quote":"时太祖领兖州，遣使诣杨；欲令假途西至长安〖9〗，杨不听。","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":153,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":58,"end":86,"offset_unit":"unicode_code_point"},{"id":"chengguo-q-870905889adeb4523c8f","section":"chapter-014","block":"b-b1674351a179433bc204","layer":"original","quote":"昭欲诣汉献帝，至河内，为张杨所留；","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":153,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":26,"end":43,"offset_unit":"unicode_code_point"},{"id":"chengguo-q-a8500e619a687d1c8e48","section":"chapter-014","block":"b-d63745ed601e2334eece","layer":"original","quote":"遣使诣河东，会天子还洛阳，韩暹、杨奉、董承及杨，各违戾不和","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":154,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":13,"end":42,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-o024f-q","section":"chapter-006","block":"b-4952f69b7a7ab8eb99b0","layer":"original","quote":"诸将不能相率〖7〗，上下乱，粮食尽。奉、暹、承乃以天子还洛阳；出箕关〖8〗，下轵道〖9〗。张杨以食迎道路，拜大司马。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":163,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":283,"end":341,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o024","section":"chapter-006","block":"b-4952f69b7a7ab8eb99b0","layer":"original","quote":"郭汜复欲胁天子，还都郿。天子奔奉营，奉击汜，破之。汜走南山〖2〗。奉及将军董承，以天子还洛阳。傕、汜悔遣天子，复相与和，追及天子于弘农之曹阳。奉急招河东故白波帅韩暹、胡才、李乐等合〖3〗，与傕、汜大战。奉兵败，傕等纵兵杀公卿百官，略宫人入弘农。﹝二﹞天子走陕，北渡河。失辎重，步行；唯皇后、贵人从。至大阳〖4〗，止人家屋中〖5〗﹝三﹞。奉、暹等遂以天子都安邑，御乘牛车；太尉杨彪、太仆韩融近臣从者十余人〖6〗。以暹为征东，才为征西，乐征北将军，并与奉、承持政。遣融至弘农，与傕、汜等连和；还所略宫人、公卿百官，及乘舆车马数乘。是时蝗虫起，岁旱无谷；从官食枣菜。﹝四﹞诸将不能相率〖7〗，上下乱，粮食尽。奉、暹、承乃以天子还洛阳；出箕关〖8〗，下轵道〖9〗。张杨以食迎道路，拜大司马。语在《杨传》。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":163,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":348,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p063","section":"chapter-006","block":"b-501b9aaae088f305661d","layer":"pei","quote":"﹝二﹞《九州春秋》曰：“馥遣都督从事赵浮、程奂，将强弩万张，屯河阳。浮等闻馥欲以冀州与绍，自孟津驰东下。时绍尚在朝歌清水口。浮等从后来，船数百艘，众万余人。整兵鼓，夜过绍营，绍甚恶之。浮等到，谓馥曰：‘袁本初军无斗粮，各已离散；虽有张杨、于扶罗新附，未肯为用：不足敌也。小从事等请自以现兵拒之，旬日之间，必土崩瓦解。明将军但当开阽閤高枕，何忧何惧！’馥不从，乃避位，出居赵忠故舍。遣子赍冀州印绶，于黎阳与绍。”","attribution":"《九州春秋》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":248,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-7c576da3d950edb687e2","start":0,"end":205,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-0eb3b22bb963155c3e9f","section":"chapter-008","block":"b-ff04eca961a238e032ba","layer":"original","quote":"卓以杨为建义将军、河内太守","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":145,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":93,"end":106,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-3973ee446239797a2d8b","section":"chapter-008","block":"b-d25c86999204304eab6c","layer":"original","quote":"张杨字稚叔，云中人也。以武勇给并州，为武猛从事","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":143,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":23,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-4a48d26a1b86055f66a2","section":"chapter-008","block":"b-ff04eca961a238e032ba","layer":"original","quote":"单于欲叛绍，杨不从。单于执杨，与俱去；绍使将麹义追击于邺南，破之。单于（执）〔与〕杨至黎阳，攻破度辽将军耿祉军，众复振","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":145,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":33,"end":92,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-4bfbe59d87df62dc7326","section":"chapter-008","block":"b-407d1dfcbd8cf81dc713","layer":"original","quote":"评曰：公孙瓒保京〖1〗，坐待夷灭。度残暴而不节〖2〗，渊仍业以载凶〖3〗，只足覆其族也。陶谦昏乱而忧死，张杨授首于臣下；皆拥据州郡，曾匹夫之不若：固无可论者也。燕、绣、鲁，舍群盗，列功臣；去危亡，保宗祀：则于彼为愈焉","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":314,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":108,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-4ed1ce43548031317d1d","section":"chapter-008","block":"b-ff04eca961a238e032ba","layer":"original","quote":"杨欲迎天子还洛，诸将不听，杨还野王","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":145,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":138,"end":155,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-6cdd8716389eabf9cab4","section":"chapter-008","block":"b-5a06f5471508744b051d","layer":"original","quote":"进败，董卓作乱。杨遂以所将，攻上党太守于壶关，不下；略诸县，众至数千人","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":144,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":129,"end":164,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-7970a3af5fbc2c5f9c92","section":"chapter-008","block":"b-5a06f5471508744b051d","layer":"original","quote":"并州刺史丁原，遣杨将兵诣硕，为假司马","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":144,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":69,"end":87,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-7a1ee6070a9c8e366faf","section":"chapter-008","block":"b-ff04eca961a238e032ba","layer":"original","quote":"天子之在河东，杨将兵至安邑，拜安国将军〖6〗，封晋阳侯","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":145,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":110,"end":137,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-8b2d447c179f5fa02f2e","section":"chapter-008","block":"b-6625e15615544094ec8f","layer":"original","quote":"粮乏，杨以粮迎道路，遂至洛阳。谓诸将曰：“天子，当与天下共之。幸有公卿大臣；杨当捍外难〖8〗，何事京都〖9〗？”遂还野王。即拜为大司马","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":146,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":20,"end":87,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-aeb88901afccd8c20e83","section":"chapter-008","block":"b-ff04eca961a238e032ba","layer":"original","quote":"山东兵起，欲诛卓。袁绍至河内，杨与绍合，复与匈奴单于于夫罗屯漳水","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":145,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":32,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-b08678be56e2c5e8582c","section":"chapter-008","block":"b-e96ffada202f222baadb","layer":"original","quote":"其将杨丑，杀杨以应太祖","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":147,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":11,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-be397858d78490ad5185","section":"chapter-008","block":"b-c45272d8c0e5e9ba2011","layer":"pei","quote":"下人谋反，发觉，对之涕泣，辄原不问","attribution":"英雄记","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":161,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-7e968c0f6df6ba1149e9","start":21,"end":38,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-bec3188cfa2c7b265ac9","section":"chapter-008","block":"b-6625e15615544094ec8f","layer":"original","quote":"建安元年，杨奉、董承、韩暹挟天子还旧京","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":146,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-d0e7ebb86ceef656cc51","section":"chapter-008","block":"b-c45272d8c0e5e9ba2011","layer":"pei","quote":"杨，性仁和，无威刑。下人谋反，发觉，对之涕泣，辄原不问","attribution":"英雄记","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":161,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-7e968c0f6df6ba1149e9","start":11,"end":38,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-d5b48e7e8e273ee81eb1","section":"chapter-008","block":"b-d25c86999204304eab6c","layer":"original","quote":"以武勇给并州，为武猛从事","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":143,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":11,"end":23,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-dba8d768022566fbb809","section":"chapter-008","block":"b-5a06f5471508744b051d","layer":"original","quote":"灵帝崩，硕为何进所杀。杨复为进所遣，归本州募兵，得千余人。因留上党，击山贼","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":144,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":91,"end":128,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-eeaf76ab59aadb594653","section":"chapter-008","block":"b-6625e15615544094ec8f","layer":"original","quote":"杨素与吕布善，太祖之围布，杨欲救之；不能，乃出兵东市〖10〗，遥为之势","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":146,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":91,"end":126,"offset_unit":"unicode_code_point"},{"id":"hechang-q-3517092086a46fea71c6","section":"chapter-023","block":"b-5901e12e333f8c028391","layer":"original","quote":"依故河间太守陈延壁〖19〗。陈、冯二姓，旧族冠冕〖20〗。张杨利其妇女〖21〗，贪其资货。林率其宗族，为之策谋。见围六十余日，卒全堡壁。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":87,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":40,"end":108,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-471396e1ce8f2ad5c3bd","section":"chapter-007","block":"b-a78f12643658c8f80e43","layer":"pei","quote":"布自以有功于袁氏，轻傲绍下诸将；以为擅相署置，不足贵也。布求还洛，绍假布领司隶校尉：外言当遣，内欲杀布","attribution":"裴注·英雄记","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":40,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c4804c8fb87a1d97aef5","start":11,"end":62,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-9a35c4110cb4e28acc66","section":"chapter-007","block":"b-d7dccb90aa40b28ae072","layer":"original","quote":"而求益兵众，将士抄掠；绍患忌之。布觉其意，从绍求去；绍恐还为己害，遣壮士夜掩杀布。不获，事露，布走河内，﹝二﹞与张杨合。绍令众追之，皆畏布，莫敢逼近者","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":34,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":104,"end":179,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-a8bac1ecd116712cb9d8","section":"chapter-007","block":"b-26bfcb8938a83a3494de","layer":"pei","quote":"杨及部曲诸将，皆受傕、汜购募，共图布。布闻之，谓杨曰：‘布，卿州里也。卿杀布，于卿弱；不如卖布，可极得汜、傕爵宠。’杨于是外许汜、傕，内实保护布。汜、傕患之，更下大封诏书，以布为颍川太守","attribution":"裴注·英雄记","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":41,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-d4cb01724584cb47e01f","start":11,"end":104,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-dd6b91d3d319f28fcd22","section":"chapter-007","block":"b-a78f12643658c8f80e43","layer":"pei","quote":"明日当发，绍遣甲士三十人，辞以送布。布使止于帐侧，伪使人于帐中鼓筝。绍兵卧，布无何出帐去，而兵不觉。夜半兵起，乱斫布床被，谓为已死。明日，绍讯问，知布尚在，乃闭城门。布遂引去","attribution":"裴注·英雄记","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":40,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c4804c8fb87a1d97aef5","start":63,"end":150,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o061b-q","section":"chapter-001","block":"b-502d4e8c0ed143eaa30d","layer":"original","quote":"张杨将杨丑杀杨〖3〗。眭固又杀丑，以其众属袁绍，屯射犬〖4〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":358,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":18,"end":49,"offset_unit":"unicode_code_point"},{"id":"wudi-e-p043a-q","section":"chapter-001","block":"b-f0e2cb19925f21116fbb","layer":"pei","quote":"﹝一﹞《献帝春秋》曰：“天子初至洛阳，幸城西故中常侍赵忠宅。使张杨缮治宫室，名殿曰‘杨安殿’。八月，帝乃迁居。”","attribution":"《献帝春秋》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":279,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-066505794915ec82cc60","start":0,"end":56,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-16a5462151b1cfe5142d","section":"chapter-001","block":"b-16a5462151b1cfe5142d","layer":"modern","quote":"〖1〗建安元年：公元 196 年。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":264,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-df2756e12f4ac1fef3c4","start":0,"end":17,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-51bced16741add42ff70","section":"chapter-001","block":"b-51bced16741add42ff70","layer":"modern","quote":"〖1〗四年：建安四年（公元 199）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":369,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-20628d34a709162c77f0","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o040","section":"chapter-001","block":"b-c71d10ef121af30ac6b7","layer":"original","quote":"建安元年春正月〖1〗，太祖军临武平〖2〗。袁术所置陈相袁嗣，降。太祖将迎天子，诸将或疑；荀彧、程昱劝之。乃遣曹洪将兵西迎。卫将军董承与袁术将苌奴拒险〖3〗，洪不得进。汝南、颍川黄巾何仪、刘辟、黄邵、何曼等〖4〗，众各数万。初应袁术，又附孙坚〖5〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":258,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":124,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o061","section":"chapter-001","block":"b-502d4e8c0ed143eaa30d","layer":"original","quote":"四年春二月〖1〗，公还至昌邑〖2〗。张杨将杨丑杀杨〖3〗。眭固又杀丑，以其众属袁绍，屯射犬〖4〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":358,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":49,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o143","section":"chapter-001","block":"b-87c7d8a437d7c846207e","layer":"original","quote":"昔者董卓初兴国难，群后释位以谋王室〖31〗；﹝四﹞君则摄进〖32〗，首启戎行〖33〗。此君之忠于本朝也。后及黄巾反易天常〖34〗，侵我三州〖35〗，延及平民；君又翦之以宁东夏〖36〗。此又君之功也。韩暹、杨奉专用威命；君则致讨，克黜其难，遂迁许都，造我京畿，设官兆祀〖37〗，不失旧物〖38〗，天地鬼神于是获乂〖39〗。此又君之功也。袁术僭逆〖40〗，肆于淮南；慑惮君灵，用丕显谋〖41〗，蕲阳之役〖42〗，桥蕤授首〖43〗，稜威南迈，术以陨溃。此又君之功也。回戈东征，吕布就戮；乘辕将返，张杨殂毙，眭固伏罪，张绣稽服〖44〗。此又君之功也。袁绍逆乱天常，谋危社稷，凭恃其众，称兵内侮〖45〗。当此之时，王师寡弱，天下寒心，莫有固志；君执大节〖46〗，精贯白日，奋其武怒，运其神策，致届官渡〖47〗，大歼丑类，﹝五﹞俾我国家拯于危坠。此又君之功也。济师洪河〖48〗，拓定四州〖49〗，袁谭、高幹，咸枭其首，海盗奔进，黑山顺轨〖50〗。此又君之功也。乌丸三种〖51〗，崇乱二世〖52〗，袁尚因之，逼据塞北；束马悬车〖53〗，一征而灭。此又君之功也。刘表背诞，不供贡职〖54〗；王师首路〖55〗，威风先逝，百城八郡〖56〗，交臂屈膝。此又君之功也。马超、成宜，同恶相济，滨据河、潼，求逞所欲；殄之渭南，献馘万计〖57〗，遂定边境，抚和戎狄。此又君之功也。鲜卑、丁零〖58〗，重译而至〖59〗；（单）〔箄〕于、白屋〖60〗，请吏率职〖61〗。此又君之功也。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":111,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":625,"offset_unit":"unicode_code_point"},{"id":"wudi-q-p043","section":"chapter-001","block":"b-f0e2cb19925f21116fbb","layer":"pei","quote":"﹝一﹞《献帝春秋》曰：“天子初至洛阳，幸城西故中常侍赵忠宅。使张杨缮治宫室，名殿曰‘杨安殿’。八月，帝乃迁居。”","attribution":"《献帝春秋》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":279,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-066505794915ec82cc60","start":0,"end":56,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-o012","section":"chapter-010","block":"b-e204c2e6a37c8c4659f5","layer":"original","quote":"建安元年，太祖击破黄巾。汉献帝自河东，还洛阳。太祖议奉迎，都许，或以“山东未平，韩暹、杨奉新将天子到洛阳，北连张杨，未可猝制〖1〗”。彧劝太祖曰：“〔昔晋文纳周襄王而诸侯景从〕〖2〗，高祖东伐为义帝缟素而天下归心〖3〗。自天子播越〖4〗，将军首倡义兵，徒以山东扰乱〖5〗，未能远赴关右；然犹分遣将帅，蒙险通使〖6〗；虽御难于外〖7〗，乃心无不在王室〖8〗：是将军匡天下之素志也〖9〗。今车驾旋轸〖10〗，〔东京榛芜〕；义士有存本之思，百姓感旧而增哀。诚因此时，奉主上以从民望，大顺也；秉至公以服雄杰，大略也；扶弘义以致英俊〖11〗，大德也。天下虽有逆节〖12〗，必不能为累〖13〗，明矣。韩暹、杨奉其敢为害！若不时定〖14〗，四方生心；后虽虑之，无及！”","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":57,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":327,"offset_unit":"unicode_code_point"}],"profiles":{"wudi-p0123":{"fields":[{"id":"wudi-p0123-directory-courtesy","key":"courtesy","label":"字","text":"稚叔","evidence":["gongsuntao-q-3973ee446239797a2d8b"]}],"directory":{"faction":"qunxiong"}}},"directory_counts":{}}
