{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"huangli-e-o146","title":"叟夷反杀龚禄焦璜","accounts":[{"id":"huangli-a-e90e849abe1c35739ec7","label":"正文","text":"叟夷反杀龚禄焦璜","evidence":["huangli-q-4aa9858ac36de319395f","huangli-q2-6914ffe659a9ed87ba0b"]}],"participants":[{"person":"huangli-p0039","role":"太守，被叟夷所杀","evidence":["huangli-q-4aa9858ac36de319395f"]},{"person":"huangli-p0022","role":"太守，被叟夷所杀","evidence":["huangli-q-4aa9858ac36de319395f"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["huangli-q-4aa9858ac36de319395f"]},"ordering_evidence":"huangli-q-4aa9858ac36de319395f","source_order":[43,219,0],"order":7679}],"persons":[{"id":"huangli-p0022","name":"焦璜","evidence":["huangli-q-4aa9858ac36de319395f"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[{"id":"huangli-q-4aa9858ac36de319395f","section":"chapter-043","block":"b-74ba52c6bd47eaeb5dd6","layer":"original","quote":"初，越嶲郡自丞相亮讨高定之后，叟夷数反，杀太守龚禄、焦璜","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":218,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":28,"offset_unit":"unicode_code_point"},{"id":"huangli-q2-6914ffe659a9ed87ba0b","section":"chapter-043","block":"b-74ba52c6bd47eaeb5dd6","layer":"original","quote":"初，越嶲郡自丞相亮讨高定之后，叟夷数反，杀太守龚禄、焦璜。是后太守不敢之郡，只住安（定）〔上〕县〖1〗；去郡八百余里〖2〗，其郡徒有名而已。时论欲复旧郡，除嶷为越嶲太守。嶷将所领往之郡，诱以恩信，蛮夷皆服，颇来降附。北徼捉马最骁劲〖3〗，不承节度；嶷乃往讨，生缚其帅魏狼；又解纵告喻〖4〗，使招怀余类。表拜狼为邑侯，种落三千余户皆安土供职；诸种闻之〖5〗，多渐降服，嶷以功赐爵关内侯。","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":218,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":192,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
