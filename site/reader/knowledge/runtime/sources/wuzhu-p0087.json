wuzhu-m-o113-wuzhu-p0087","kind":"mention","text":"文中提及","evidence":["wuzhu-q-o113"]},{"id":"luxun-m-o054-wuzhu-p0087","kind":"mention","text":"文中提及","evidence":["luxun-q-o054"]},{"id":"zhanggu-m-087dc654ddbdcd0b063d","kind":"mention","text":"本段涉及吾粲","evidence":["zhanggu-q-5f211045471a25fc2444"]},{"id":"yululu-m-6e6158052c272c1596b5","kind":"mention","text":"评曰：遭罹屯蹇，以正丧身","evidence":["yululu-q-f2c083caa7bec7299207"]},{"id":"yululu-m-34ab37883af9d3fe1023","kind":"mention","text":"本篇原文记及吾粲，具体行动与称谓见引文。","evidence":["yululu-q-9aa254890f9913575ddd"]}]}],"evidence":[{"id":"hequan-q-e3d8ee9f560c65f499ea","section":"chapter-060","block":"b-95778efaeb0bf3c60266","layer":"original","quote":"吾粲、唐咨尝以三千兵攻守〖2〗，连月不能拔","section_title":"贺全吕周钟离传第十五","source":{"file":"OEBPS/Text/titlepage_0127.xhtml","index":372,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":25,"end":46,"offset_unit":"unicode_code_point"},{"id":"houfei-q-b-64a27e8dc3dd5339d73a","section":"chapter-005","block":"b-64a27e8dc3dd5339d73a","layer":"modern","quote":"〖16〗四年：青龙四年（公元 236）。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":114,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-bd98b8bd7ce8c71de9ac","start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"houfei-q-o025","section":"chapter-005","block":"b-0744a279ae4c62a54e64","layer":"original","quote":"青龙二年春，追谥后兄俨曰安城乡穆侯。夏，吴贼寇扬州，以像为伏波将军〖12〗，持节，监诸将东征〖13〗。还，复为射声校尉〖14〗。三年薨〖15〗，追赠卫将军，改封魏昌县，谥曰贞侯。子畅嗣。又封畅弟温、4 、艳，皆为列侯。四年〖16〗，改逸、俨本封，皆曰魏昌侯，谥因故〖17〗。封俨世妇刘为东乡君〖18〗，又追封逸世妇张为安喜君。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":97,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":163,"offset_unit":"unicode_code_point"},{"id":"luxun-e-o054c-q","section":"chapter-058","block":"b-03ef9029e4f75daea2ea","layer":"original","quote":"太子太傅吾粲，坐数与逊交书，下狱死。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":248,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":61,"end":79,"offset_unit":"unicode_code_point"},{"id":"luxun-q-o054","section":"chapter-058","block":"b-03ef9029e4f75daea2ea","layer":"original","quote":"书三四上，及求诣都，欲口论嫡庶之分，以匡得失。既不听许，而逊外生顾谭、顾承、姚信〖23〗，并以亲附太子，枉见流徙〖24〗。太子太傅吾粲，坐数与逊交书，下狱死。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":248,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":79,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-60e5b248903bb26daf08","section":"chapter-059","block":"b-f77eaac96e37b2d3db4c","layer":"original","quote":"陆逊、吾粲、顾谭等数陈嫡庶之义，理不可夺；全寄、杨竺为鲁王霸支党，谮诉日兴〖6〗。粲遂下狱诛，谭徙交州","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":160,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":51,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-f5c695232dc8ff7315a1","section":"chapter-059","block":"b-f77eaac96e37b2d3db4c","layer":"original","quote":"陆逊、吾粲、顾谭等数陈嫡庶之义，理不可夺；全寄、杨竺为鲁王霸支党，谮诉日兴〖6〗。粲遂下狱诛，谭徙交州","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":160,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":51,"offset_unit":"unicode_code_point"},{"id":"wuzhu-e-o113d-q","section":"chapter-047","block":"b-56f9d22ba18041334d05","layer":"original","quote":"中郎将吾粲获李桓〖20〗；将军唐咨〖21〗，获罗厉等。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":52,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":78,"end":105,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o113","section":"chapter-047","block":"b-56f9d22ba18041334d05","layer":"original","quote":"五年春〖15〗，铸大钱，一当五百。诏使吏民输铜〖16〗，计铜畀直〖17〗；设盗铸之科〖18〗。（二）〔三〕月，武昌言甘露降于礼宾殿。辅吴将军张昭卒〖19〗。中郎将吾粲获李桓〖20〗；将军唐咨〖21〗，获罗厉等。自十月不雨，至于夏。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":52,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":115,"offset_unit":"unicode_code_point"},{"id":"yululu-q-075d6341deddc33a3b41","section":"chapter-057","block":"b-a83a75941a9d6bc19950","layer":"original","quote":"其大船尚存者，水中生人皆攀缘号呼〖7〗；他吏士恐船倾没，皆以戈矛撞击，不受。粲与黄渊，独令船人以承取之。左右以为船重必败，粲曰：“船败，当俱死耳！人穷〖8〗，奈何弃之！”粲、渊所活者百余人","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":444,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":58,"end":152,"offset_unit":"unicode_code_point"},{"id":"yululu-q-077c4d79e48d5843a589","section":"chapter-057","block":"b-79dea07027e2a2ad41a0","layer":"original","quote":"孙河为县长，粲为小吏，河深奇之","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":442,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":16,"end":31,"offset_unit":"unicode_code_point"},{"id":"yululu-q-46f184d6bd2ded36fcb3","section":"chapter-057","block":"b-12487deb4f8058d89b8b","layer":"original","quote":"又数以消息语陆逊，逊时驻武昌，连表谏争","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":447,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":55,"end":74,"offset_unit":"unicode_code_point"},{"id":"yululu-q-4831a1c1375b8043c709","section":"chapter-057","block":"b-12487deb4f8058d89b8b","layer":"original","quote":"迁太子太傅，遭二宫之变","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":447,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":11,"offset_unit":"unicode_code_point"},{"id":"yululu-q-4a511263f429adb46c57","section":"chapter-057","block":"b-12487deb4f8058d89b8b","layer":"original","quote":"抗言执正〖15〗，明嫡庶之分；欲使鲁王霸出驻夏口，遣杨竺不得令在都邑","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":447,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":16,"end":50,"offset_unit":"unicode_code_point"},{"id":"yululu-q-5042433d2b319d71168c","section":"chapter-057","block":"b-e71f0fab6b41173b467b","layer":"original","quote":"粲募合人众，拜昭义中郎将，与吕岱讨平山越","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":446,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"yululu-q-594536078e7f81a749da","section":"chapter-057","block":"b-0e7f28ad7d32e76ebcec","layer":"original","quote":"孙权为车骑将军，召为主簿","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":443,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":12,"offset_unit":"unicode_code_point"},{"id":"yululu-q-672a361df47ae6d7331b","section":"chapter-057","block":"b-f6130f489569c023a859","layer":"original","quote":"召处士谢谭为功曹〖9〗，谭以疾不诣。粲教曰〖10〗：“夫应龙以屈伸为神〖11〗，凤凰以嘉鸣为贵；何必隐形于天外，潜鳞于重渊者哉","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":445,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":63,"offset_unit":"unicode_code_point"},{"id":"yululu-q-6f16e8486a9254a3fe1c","section":"chapter-057","block":"b-a83a75941a9d6bc19950","layer":"original","quote":"黄武元年，与吕范、贺齐等，俱以舟师拒魏将曹休于洞口","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":444,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":25,"offset_unit":"unicode_code_point"},{"id":"yululu-q-715d3201e4b91dc9a135","section":"chapter-057","block":"b-12487deb4f8058d89b8b","layer":"original","quote":"由此为霸、竺等所谮害，下狱诛","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":447,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":75,"end":89,"offset_unit":"unicode_code_point"},{"id":"yululu-q-8953011467b73ec72144","section":"chapter-057","block":"b-79dea07027e2a2ad41a0","layer":"original","quote":"河后为将军，得自选长吏〖1〗，表粲为曲阿丞〖2〗。迁为长史〖3〗，治有名迹","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":442,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":32,"end":69,"offset_unit":"unicode_code_point"},{"id":"yululu-q-9aa254890f9913575ddd","section":"chapter-057","block":"b-a2c7c37f80fb4e53b9bb","layer":"pei","quote":"﹝一﹞《吴录》曰：“粲生数岁，孤城妪见之。谓其母曰：‘是儿有卿相之骨。’”","attribution":"裴注·吴录","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":467,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-227f72573effe26638cd","start":0,"end":37,"offset_unit":"unicode_code_point"},{"id":"yululu-q-a5dd0d58dd657a129675","section":"chapter-057","block":"b-e71f0fab6b41173b467b","layer":"original","quote":"入为屯骑校尉，少府","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":446,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":21,"end":30,"offset_unit":"unicode_code_point"},{"id":"yululu-q-e69914a0610285f8a301","section":"chapter-057","block":"b-0e7f28ad7d32e76ebcec","layer":"original","quote":"出为山阴令。还为参军校尉","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":443,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":13,"end":25,"offset_unit":"unicode_code_point"},{"id":"yululu-q-e6d7f4552ca4be9f3fb2","section":"chapter-057","block":"b-79dea07027e2a2ad41a0","layer":"original","quote":"吾粲字孔休，吴郡乌程人也。﹝一﹞孙河为县长，粲为小吏，河深奇之。河后为将军，得自选长吏〖1〗，表粲为曲阿丞〖2〗。迁为长史〖3〗，治有名迹。虽起孤微〖4〗，与同郡陆逊、卜静等比肩齐声矣。","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":442,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":93,"offset_unit":"unicode_code_point"},{"id":"yululu-q-f1f73a250172958bb8f7","section":"chapter-057","block":"b-a83a75941a9d6bc19950","layer":"original","quote":"还，迁会稽太守","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":444,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":153,"end":160,"offset_unit":"unicode_code_point"},{"id":"yululu-q-f2c083caa7bec7299207","section":"chapter-057","block":"b-88aca22865401281bdfd","layer":"original","quote":"评曰：虞翻古之狂直〖1〗，固难免乎末世〖2〗；然权不能容，非旷宇也〖3〗！陆绩之于扬《玄》〖4〗，是仲尼之左丘明〖5〗，老聃之严周矣〖6〗；以瑚琏之器〖7〗，而作守南越〖8〗：不亦贼夫人欤〖9〗？张温才藻俊茂；而智防未备，用致艰患。骆统抗明大义〖10〗，辞切理至，值权方闭不开。陆瑁笃义规谏，君子有称焉。吾粲、朱据遭罹屯蹇〖11〗，以正丧身：悲夫！","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":490,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":174,"offset_unit":"unicode_code_point"},{"id":"zhanggu-q-5f211045471a25fc2444","section":"chapter-052","block":"b-145a6f5a67c459da712d","layer":"original","quote":"昔丁谞出于孤家〖14〗，吾粲由于牧竖〖15〗；豫章扬其善，以并陆、全之列〖16〗：是以人无幽滞而风俗厚焉〖17〗。使君、丞相、卫尉三君，昔以布衣俱相友善〖18〗，诸论者因各叙其优劣：初，先卫尉，次丞相，而后（有）使君也。其后并事明主，经营世务〖19〗；出处之才有不同〖20〗，先后之名须反其初〖21〗：此世常人所决勤薄也〖22〗。至于三君分好〖23〗，卒无亏损，岂非古人交哉！又鲁横江昔杖万兵〖24〗，屯据陆口，当世之美业也；能与不能，孰不愿焉〖25〗？而横江既亡，卫尉应其选；自以才非将帅，深辞固让，终于不就。后徙九列〖26〗，迁典八座〖27〗；荣不足以自曜，禄不足以自奉。至于二君〖28〗，皆位为上将，穷富极贵。卫尉既无求欲，二君又不称荐；各守所志，保其名好。孔子曰：","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":470,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":336,"offset_unit":"unicode_code_point"},{"id":"zhanggu-q-c9f942188159de7cc6c2","section":"chapter-052","block":"b-88ac1b3a4b744cc5260f","layer":"original","quote":"初，钱唐丁谞出于役伍〖8〗，阳羡张秉生于庶民，乌程吾粲、云阳殷礼起乎微贱〖9〗。邵皆拔而友之，为立声誉","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":175,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":51,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
