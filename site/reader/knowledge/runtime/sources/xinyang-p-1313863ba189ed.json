{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xinyang-e-2a376ac77a1718d78995","title":"高堂隆杨伟骆禄参校太和历互劾帝从太史","accounts":[{"id":"xinyang-a-2a376ac77a1718d78995","label":"裴注·魏略","text":"高堂隆杨伟骆禄参校太和历互劾帝从太史","evidence":["xinyang-q-92333186eb3b5ca98bb9"]}],"participants":[{"person":"mingdi-p0041","role":"参校历法争论","evidence":["xinyang-q-92333186eb3b5ca98bb9"]},{"person":"xiahoucao-p0073","role":"参校争论","evidence":["xinyang-q-92333186eb3b5ca98bb9"]},{"person":"xinyang-p-1313863ba189ed","role":"参校争论","evidence":["xinyang-q-92333186eb3b5ca98bb9"]},{"person":"wendi-p0005","role":"诏取太史历","evidence":["xinyang-q-92333186eb3b5ca98bb9"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["xinyang-q-92333186eb3b5ca98bb9"]},"ordering_evidence":"xinyang-q-92333186eb3b5ca98bb9","order":5105}],"persons":[{"id":"xinyang-p-1313863ba189ed","name":"骆禄","evidence":["xinyang-q-92333186eb3b5ca98bb9"],"facts":[],"mentions":[],"aliases":[]}],"evidence":[{"id":"xinyang-q-92333186eb3b5ca98bb9","section":"chapter-025","block":"b-0f8637d3e6b79ec73f25","layer":"pei","quote":"﹝一﹞《魏略》曰：“太史上汉历不及天时，因更推步弦、望、朔、晦，为《太和历》。帝以隆学问优深，于天文又精，乃诏使隆与尚书郎杨伟、太史待诏骆禄，参共推校。伟、禄，是太史；隆故据旧历。更相劾奏，纷纭数岁。伟称：禄得日蚀而月晦不尽；隆不得日蚀而月晦尽。诏从太史。隆所争虽不得，而远近犹知其精微也。”","attribution":"裴注·魏略","section_title":"辛毗杨阜高堂隆传第二十五","source":{"file":"OEBPS/Text/titlepage_0056.xhtml","index":373,"anchor":null},"note_id":"n-5bd986b17d5a910db409","start":0,"end":146}],"profiles":{},"directory_counts":{}}
