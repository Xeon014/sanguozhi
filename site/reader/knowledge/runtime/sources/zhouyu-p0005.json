"evidence":["zhulv-q-769b6b6dcac67d39e310"]},{"id":"zhangyan-m-b5b482044ebf399310c6","kind":"mention","text":"本篇原文记及笮融，具体行动与称谓见引文。","evidence":["zhangyan-q-838d68a9587b0e44b895"]}]}],"evidence":[{"id":"feipin-q-5b2e6a9e47cae4430fe9","section":"chapter-050","block":"b-1644b583470b219bfb40","layer":"original","quote":"坚薨，随孙策讨樊能、于麋等于横江，击张英于当利口〖1〗；而船少，欲驻军更求。琨母时在军中，谓琨曰：“恐州家多发水军来逆人〖2〗，则不利矣，如何可驻邪！宜伐芦苇以为泭〖3〗，佐船渡军。”﹝一﹞琨具启策，策即行之，众悉俱济；遂破英，击走笮融、刘繇。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":41,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":26,"end":148,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-f21fa73bebceec33ffdc","section":"chapter-008","block":"b-3f8716405c0509ef7aba","layer":"pei","quote":"贼笮融从临淮见讨，进入郡界。昱将兵拒战，败绩，见害","attribution":"裴注·后汉书（谢承）","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":139,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-337cc662c06000f4518b","start":296,"end":321,"offset_unit":"unicode_code_point"},{"id":"sunshi-e-p037b-q","section":"chapter-046","block":"b-8ad4a2f852325dd4ff74","layer":"pei","quote":"时彭城相薛礼、下邳相笮融，依繇为盟主；礼据秣陵城，融屯县南。策先攻融，融出兵交战；斩首五百余级，融即闭门，不敢动。因渡江攻礼，礼突走；","attribution":"《江表传》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":248,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6fa39d8ee05c62716a11","start":39,"end":106,"offset_unit":"unicode_code_point"},{"id":"sunshi-e-p037c-q","section":"chapter-046","block":"b-8ad4a2f852325dd4ff74","layer":"pei","quote":"复下攻融，为流矢所中，伤股；不能乘马，因自舆，还牛渚营。或叛告融曰：‘孙郎被箭，已死！’融大喜，即遣将于兹向策。策遣步骑数百挑战，设伏于后。贼出击之，锋刃未接而伪走；贼追入伏中，乃大破之，斩首千余级。策因往到融营下，令左右大呼曰：‘孙郎竟云何！’贼于是惊怖，夜遁。融闻策尚在，更深沟高垒，缮治守备。","attribution":"《江表传》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":248,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6fa39d8ee05c62716a11","start":141,"end":290,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-p037","section":"chapter-046","block":"b-8ad4a2f852325dd4ff74","layer":"pei","quote":"﹝二﹞《江表传》曰：“策渡江，攻繇牛渚营，尽得邸阁粮谷、战具。是岁兴平二年也。时彭城相薛礼、下邳相笮融，依繇为盟主；礼据秣陵城，融屯县南。策先攻融，融出兵交战；斩首五百余级，融即闭门，不敢动。因渡江攻礼，礼突走；而樊能、于麋等，复合众，袭夺牛渚屯。策闻之，还攻破能等，获男女万余人。复下攻融，为流矢所中，伤股；不能乘马，因自舆，还牛渚营。或叛告融曰：‘孙郎被箭，已死！’融大喜，即遣将于兹向策。策遣步骑数百挑战，设伏于后。贼出击之，锋刃未接而伪走；贼追入伏中，乃大破之，斩首千余级。策因往到融营下，令左右大呼曰：‘孙郎竟云何！’贼于是惊怖，夜遁。融闻策尚在，更深沟高垒，缮治守备。策以融所屯地势险固，乃舍去；攻破繇别将于海陵，转攻湖孰、江乘，皆下之。”","attribution":"《江表传》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":248,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6fa39d8ee05c62716a11","start":0,"end":326,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-b-c63b764c8d77474949e4","section":"chapter-010","block":"b-c63b764c8d77474949e4","layer":"modern","quote":"〖11〗二年：兴平二年（公元 195）。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":38,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c70b78b19d5fc0e5d4ef","start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-o009","section":"chapter-010","block":"b-867468e927405dc6280f","layer":"original","quote":"二年夏〖11〗，太祖军乘氏。大饥，人相食。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":26,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-1f59eec47900f5803a50","section":"chapter-049","block":"b-890a3b949df453079363","layer":"original","quote":"悉课读佛经〖25〗；令界内及旁郡人有好佛者听受道〖26〗，复其他役以招致之〖27〗，由此远近前后至者五千余人户","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":6,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":50,"end":105,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-330b8f2990913aafb1e2","section":"chapter-049","block":"b-b11e4525d5674fad5f88","layer":"original","quote":"更复招合属县，攻破融","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":4,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":76,"end":86,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-382e6f977a0712f3a961","section":"chapter-049","block":"b-b11e4525d5674fad5f88","layer":"original","quote":"笮融先至，﹝四﹞杀太守朱皓，﹝五﹞入居郡中","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":4,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":44,"end":65,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-3a0978efacd79467aefb","section":"chapter-049","block":"b-e09c99d9535e8d4aa378","layer":"original","quote":"初聚众数百，往依徐州牧陶谦","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":5,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":8,"end":21,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-4b8d6f838864c80dc332","section":"chapter-049","block":"b-66f2d52fde94a20ba685","layer":"original","quote":"过杀礼，然后杀皓","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":7,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":84,"end":92,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-542193332fd8436d54e2","section":"chapter-049","block":"b-e09c99d9535e8d4aa378","layer":"original","quote":"谦使督广陵、〔下邳、〕彭城运漕","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":5,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":22,"end":37,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-5e5ea5ac57def59ccef0","section":"chapter-049","block":"b-890a3b949df453079363","layer":"original","quote":"乃大起浮图祠〖23〗：以铜为人，黄金涂身，衣以锦采；垂铜盘九重，下为重楼阁道〖24〗；可容三千余人","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":6,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":49,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-64accee8bd45d632b287","section":"chapter-049","block":"b-66f2d52fde94a20ba685","layer":"original","quote":"融利广陵之众〖30〗，因酒酣杀昱；放兵大略，因载而去","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":7,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":57,"end":83,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-6798b4c99d7c926c6eca","section":"chapter-049","block":"b-0352ce76d13020899e82","layer":"pei","quote":"是岁，繇屯彭泽。又使融助皓，讨刘表所用太守诸葛玄","attribution":"裴注·献帝春秋","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":45,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f1c4a2446f35552ad79a","start":12,"end":36,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-680efa52d819e8dea4e4","section":"chapter-049","block":"b-e09c99d9535e8d4aa378","layer":"original","quote":"遂放纵擅杀，坐断三郡委输以自入","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":5,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":42,"end":57,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-6bcb897a27f1c50c5b51","section":"chapter-049","block":"b-66f2d52fde94a20ba685","layer":"original","quote":"广陵太守赵昱待以宾礼","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":7,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":27,"end":37,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-723807545dc756e86b99","section":"chapter-049","block":"b-b11e4525d5674fad5f88","layer":"original","quote":"繇进讨融，为融所破","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":4,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":66,"end":75,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-72aea34b910a2bd73592","section":"chapter-049","block":"b-66f2d52fde94a20ba685","layer":"original","quote":"融将男女万口，马三千匹，走广陵","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":7,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":11,"end":26,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-8fb1a9cbe7fe3073806a","section":"chapter-049","block":"b-0352ce76d13020899e82","layer":"pei","quote":"许子将谓繇曰：‘笮融出军，不顾（命）名义者也！朱文明，善推诚以信人，宜使密防之","attribution":"裴注·献帝春秋","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":45,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f1c4a2446f35552ad79a","start":37,"end":76,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-9198a717b35ddb855ea1","section":"chapter-049","block":"b-890a3b949df453079363","layer":"original","quote":"每浴佛〖28〗，多设酒饭，布席于路，经数十里；民人来观及就食且万人，费以巨亿计","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":6,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":106,"end":145,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-b27d7ae93a6d72b0d0aa","section":"chapter-049","block":"b-0352ce76d13020899e82","layer":"pei","quote":"融到，果诈杀皓，代领郡事","attribution":"裴注·献帝春秋","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":45,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f1c4a2446f35552ad79a","start":78,"end":90,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-c2755372987f70ecf021","section":"chapter-049","block":"b-b11e4525d5674fad5f88","layer":"original","quote":"融败走入山，为民所杀","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":4,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":87,"end":97,"offset_unit":"unicode_code_point"},{"id":"yaoci-q2-718668cce7d1cf0a4d6d","section":"chapter-049","block":"b-66f2d52fde94a20ba685","layer":"original","quote":"过杀礼，然后杀皓。","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":7,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":84,"end":93,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-128083f33178fdf1d643","section":"chapter-053","block":"b-ba6e583185faf20d4400","layer":"pei","quote":"昱后为笮融所杀，纮甚伤愤，而力不能讨，昱门户绝灭","attribution":"裴注·吴书","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":32,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-911a32786eb288af892f","start":207,"end":231,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-838d68a9587b0e44b895","section":"chapter-053","block":"b-ba6e583185faf20d4400","layer":"pei","quote":"﹝五﹞《吴书》曰：“权初承统，春秋方富。太夫人以方外多难，深怀忧劳；数有优令辞谢，付属以辅助之义：纮辄拜笺答谢，思惟补察。每有异事密计及章表书记，与四方交结，常令纮与张昭草创撰作。纮以破虏有破走董卓、扶持汉室之勋，讨逆平定江外、建立大业：宜有纪颂，以昭公（义）〔美〕。既成，呈权。权省读悲感，曰：‘君真识孤家门阀阅也！’乃遣纮之部。或以纮本受北任，嫌其志趣不止于此，权不以介意。初，琅邪赵昱，为广陵太守，察纮孝廉；昱后为笮融所杀，纮甚伤愤，而力不能讨，昱门户绝灭。及纮在东部，遣主簿至琅邪设祭；并求亲戚为之后，以书属琅邪相臧宣：宣以赵宗中五岁男，奉昱祀。权闻而嘉之。及讨江夏，以东部少事，命纮居守，遥领所职。孔融遗纮书曰：‘闻大军西征，足下留镇。不有居者，谁守社稷？深固折冲，亦大勋也。无乃李广之气，苍发益怒，乐一当单于，以尽余愤乎？南北并定，世将无事；（孙叔）〔叔孙〕投戈，绛、灌俎豆，亦在今日；但用离析，无缘会面，为愁叹耳！道直途清，相见岂复难哉！’权以纮有镇守之劳，欲论功加赏。纮厚自挹损，不敢蒙宠：权不夺其志。每从容侍宴，微言密指，常有以规讽。”","attribution":"裴注·吴书","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":32,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-911a32786eb288af892f","start":0,"end":477,"offset_unit":"unicode_code_point"},{"id":"zhouyu-e-o003c-q","section":"chapter-054","block":"b-31b40d63d1cd4e25427e","layer":"original","quote":"乃渡江击秣陵，破笮融、薛礼。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":3,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":51,"end":65,"offset_unit":"unicode_code_point"},{"id":"zhouyu-q-o003","section":"chapter-054","block":"b-31b40d63d1cd4e25427e","layer":"original","quote":"会策将东渡，到历阳；驰书报瑜，瑜将兵迎策。策大喜曰：“吾得卿，谐也〖7〗！”遂从攻横江、当利，皆拔之。乃渡江击秣陵，破笮融、薛礼。转下湖孰、江乘〖8〗，进入曲阿，刘繇奔走：而策之众已数万矣。因谓瑜曰：“吾以此众取吴、会，平山越，已足〖9〗。卿还镇丹杨。”瑜还。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":3,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":130,"offset_unit":"unicode_code_point"},{"id":"zhuge-e-p001a-q","section":"chapter-035","block":"b-0ba957ed490b6345b7bd","layer":"pei","quote":"初，豫章太守周术病卒，刘表上诸葛玄为豫章太守，治南昌。汉朝闻周术死，遣朱皓代玄。皓从扬州刺史刘繇求兵，击玄；玄退屯西城：皓入南昌。","attribution":"《献帝春秋》","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":23,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-43698058f80b13e4af1b","start":12,"end":77,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-769b6b6dcac67d39e310","section":"chapter-056","block":"b-03a8558afb4d94614edf","layer":"original","quote":"策定秣陵、曲阿，收笮融、刘繇余众；增范兵二千，骑五十匹","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":150,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":48,"end":75,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
