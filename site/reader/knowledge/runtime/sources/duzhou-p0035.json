0.xhtml","index":207,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":78,"end":82,"offset_unit":"unicode_code_point"},{"id":"duzhou-q-db6e9cc5bbcea8add60a","section":"chapter-042","block":"b-77d55e3e1f4565408fd8","layer":"original","quote":"譔具传其业，又从默讲论义理，五经、诸子，无不该览","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":205,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":39,"end":63,"offset_unit":"unicode_code_point"},{"id":"duzhou-q2-83907fdd3bf2006188d1","section":"chapter-042","block":"b-77d55e3e1f4565408fd8","layer":"original","quote":"李譔字钦仲，梓潼涪人也。父仁，字德贤；与同县尹默俱游荆州，从司马徽、宋忠等学。譔具传其业，又从默讲论义理，五经、诸子，无不该览〖1〗；加博好技艺，算术、卜数，医药、弓弩、机械之巧，皆致思焉。始，为州书佐，尚书令史〖2〗。","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":205,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":110,"offset_unit":"unicode_code_point"},{"id":"duzhou-q2-a50ff2ce85dc3a8e5df6","section":"chapter-042","block":"b-b7f303e0c6f2806f4396","layer":"original","quote":"著古文《易》、《尚书》、《毛诗》、《三礼》、《左氏传》，《太玄指归》：皆依准贾、马〖6〗，异于郑玄；与王氏殊隔〖7〗，初不见其所述〖8〗，而意归多同〖9〗。景耀中卒。","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":207,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":83,"offset_unit":"unicode_code_point"}],"profiles":{"duzhou-p0035":{"fields":[],"directory":{"faction":"shu"}}},"directory_counts":{}}
