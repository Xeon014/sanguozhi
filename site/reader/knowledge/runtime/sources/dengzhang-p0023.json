ence":["dengzhang-q-497cf7104b2de26a03f6"]}],"participants":[{"person":"dengzhang-p0023","role":"益州从事，善相术，为芝相面并预言","evidence":["dengzhang-q-497cf7104b2de26a03f6"]},{"person":"guanzhang-p0046","role":"往从张裕问相","evidence":["dengzhang-q-497cf7104b2de26a03f6"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["dengzhang-q-497cf7104b2de26a03f6"]},"ordering_evidence":"dengzhang-q-497cf7104b2de26a03f6","source_order":[45,2,36],"order":7856}],"persons":[{"id":"dengzhang-p0023","name":"张裕","evidence":["dengzhang-q-497cf7104b2de26a03f6","duzhou-q-c4b054c4b0d03b142cd8","duzhou-q-268b0bcd8918b3c25f1d","duzhou-q-8330e1750221cc63d84f","duzhou-q-4762458c6518eb60a951","duzhou-q-518cfb4398476a65ea72","duzhou-q-4500bfa51865931d8625"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[{"id":"dengzhang-q-497cf7104b2de26a03f6","section":"chapter-045","block":"b-de68bbc9c81cd1ec1901","layer":"original","quote":"时益州从事张裕善相〖3〗，芝往从之。裕谓芝曰：“君年过七十，位至大将军，封侯。”","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":1,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":36,"end":76,"offset_unit":"unicode_code_point"},{"id":"duzhou-q-268b0bcd8918b3c25f1d","section":"chapter-042","block":"b-5486ef9fd9f979995eb5","layer":"original","quote":"裕又私语人曰：“岁在庚子，天下当易代〖9〗：刘氏祚尽矣〖10〗。主公得益州，九年之后，寅卯之间当失之〖11〗。”人密白其言","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":35,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":61,"offset_unit":"unicode_code_point"},{"id":"duzhou-q-4500bfa51865931d8625","section":"chapter-042","block":"b-a5fddb39cfd1b003aa1e","layer":"original","quote":"裕遂弃市","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":36,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":76,"end":80,"offset_unit":"unicode_code_point"},{"id":"duzhou-q-4762458c6518eb60a951","section":"chapter-042","block":"b-a5fddb39cfd1b003aa1e","layer":"original","quote":"先主常衔其不逊〖16〗，加忿其漏言〖17〗；乃显裕谏争汉中不验〖18〗，下狱，将诛之","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":36,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":42,"offset_unit":"unicode_code_point"},{"id":"duzhou-q-518cfb4398476a65ea72","section":"chapter-042","block":"b-a5fddb39cfd1b003aa1e","layer":"original","quote":"诸葛亮表请其罪〖19〗，先主答曰，“芳兰生门〖20〗，不得不锄","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":36,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":43,"end":74,"offset_unit":"unicode_code_point"},{"id":"duzhou-q-8330e1750221cc63d84f","section":"chapter-042","block":"b-5486ef9fd9f979995eb5","layer":"original","quote":"初，先主与刘璋会涪时，裕为璋从事，侍坐。其人饶须，先主嘲之曰：“昔吾居家涿县〖12〗，特多毛姓；东西南北皆诸毛也。涿令称曰‘诸毛绕涿居乎〖13〗’？”裕即答曰：“昔有作上党潞长〖14〗，迁为涿令者，去官还家。时人与书，欲署‘潞’则失‘涿’，欲署‘涿’则失‘潞’，乃署曰‘潞涿君〖15〗’。”先主无须，故裕以此及之","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":35,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":62,"end":218,"offset_unit":"unicode_code_point"},{"id":"duzhou-q-c4b054c4b0d03b142cd8","section":"chapter-042","block":"b-7a053fe7d388236a173e","layer":"original","quote":"谏先主曰：“不可争汉中，军必不利！”先主竟不用裕言，果得地而不得民也","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":34,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":28,"end":62,"offset_unit":"unicode_code_point"},{"id":"duzhou-q2-ae080b1d64d13032e4d7","section":"chapter-042","block":"b-a5fddb39cfd1b003aa1e","layer":"original","quote":"先主常衔其不逊〖16〗，加忿其漏言〖17〗；乃显裕谏争汉中不验〖18〗，下狱，将诛之。诸葛亮表请其罪〖19〗，先主答曰，“芳兰生门〖20〗，不得不锄！”裕遂弃市。后魏氏之立，先主之薨，皆如裕所刻。又晓相术，每举镜视面，自知刑死，未尝不扑之于地也〖21〗。","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":36,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":127,"offset_unit":"unicode_code_point"},{"id":"liuermu-q-285d180609591d54248a","section":"chapter-031","block":"b-cd2715048d75eb8ace1d","layer":"original","quote":"璋率步骑三万余人，车乘帐幔，精光曜日，往就与会。先主所将将士，更相之适〖23〗，欢饮百余日","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":71,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":47,"end":92,"offset_unit":"unicode_code_point"},{"id":"liuermu-q-f5a19800b02708db6cc6","section":"chapter-031","block":"b-cd2715048d75eb8ace1d","layer":"original","quote":"先主至江州〖21〗，北由垫江水，﹝五﹞诣涪〖22〗；﹝六﹞去成都三百六十里，是岁建安十六年也","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":71,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":46,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o036a-q","section":"chapter-032","block":"b-0e5a4f9cc0d9229b2789","layer":"original","quote":"先主留诸葛亮、关羽等据荆州；将步卒数万人入益州。至涪，璋自出迎，相见甚欢。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":161,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":37,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-b-09400c250015597cdc75","section":"chapter-032","block":"b-09400c250015597cdc75","layer":"modern","quote":"〖10〗十六年：建安十六年（公元 211 ）。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":152,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8471d798647e2ff3307a","start":0,"end":23,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o034","section":"chapter-032","block":"b-464a6d3ab5db13314b70","layer":"original","quote":"十六年〖10〗，益州牧刘璋，遥闻曹公将遣钟繇等向汉中讨张鲁，内怀恐惧。别驾从事蜀郡张松说璋曰：“曹公兵强，无敌于天下；若因张鲁之资以取蜀土〖11〗，谁能御之者乎？”璋曰：“吾固忧之而未有计。”松曰：“刘豫州，使君之宗室，而曹公之深仇也，善用兵；若使之讨鲁，鲁必破；鲁破，则益州强；曹公虽来，无能为也。”","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":140,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":151,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
