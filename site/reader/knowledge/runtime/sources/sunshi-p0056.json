{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"sunshi-e-p038b","title":"孙策入曲阿遣陈宝迎母弟颁令招降得众","accounts":[{"id":"sunshi-e-p038b-account","label":"《江表传》","text":"孙策入曲阿遣陈宝迎母弟颁令招降得众","evidence":["sunshi-e-p038b-q"]}],"participants":[{"person":"wudi-p0099","role":"安抚招众","evidence":["sunshi-e-p038b-q"]},{"person":"sunshi-p0056","role":"迎家","evidence":["sunshi-e-p038b-q"]},{"person":"zhouyu-p0018","role":"被迎","evidence":["sunshi-e-p038b-q"]}],"place":null,"time":{"label":"刘繇败走孙策入曲阿时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["sunshi-e-p038b-q"]},"ordering_evidence":"sunshi-e-p038b-q","source_order":[46,250,"P038b"],"order":8101}],"persons":[{"id":"sunshi-p0056","name":"陈宝","evidence":["sunshi-q-p038"],"facts":[],"aliases":[],"mentions":[{"id":"sunshi-m-p038-sunshi-p0056","kind":"mention","text":"文中提及","evidence":["sunshi-q-p038"]}]}],"evidence":[{"id":"sunshi-e-p038b-q","section":"chapter-046","block":"b-5f757ec511b7e216d4ae","layer":"pei","quote":"刘繇既走，策入曲阿，劳赐将士，遣将陈宝诣阜陵迎母及弟。发恩布令，告诸县：‘其刘繇、笮融等故乡部曲来降首者，一无所问；乐从军者，一身行，复除门户；不乐者，勿强也！’旬日之间，四面云集，得现兵二万余人，马千余匹。威震江东，形势转盛。","attribution":"《江表传》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":249,"anchor":null},"note_id":"n-d5b74ea6079ebf46452d","start":90,"end":204},{"id":"sunshi-q-p038","section":"chapter-046","block":"b-5f757ec511b7e216d4ae","layer":"pei","quote":"﹝三﹞《江表传》曰：“策时年少，虽有位号，而士民皆呼为‘孙郎’。百姓闻孙郎至，皆失魂魄；长吏委城郭，窜伏山草。及至，军士奉令，不敢虏略，鸡犬菜茹，一无所犯；民乃大悦，竞以牛酒诣军。刘繇既走，策入曲阿，劳赐将士，遣将陈宝诣阜陵迎母及弟。发恩布令，告诸县：‘其刘繇、笮融等故乡部曲来降首者，一无所问；乐从军者，一身行，复除门户；不乐者，勿强也！’旬日之间，四面云集，得现兵二万余人，马千余匹。威震江东，形势转盛。”","attribution":"《江表传》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":249,"anchor":null},"note_id":"n-d5b74ea6079ebf46452d","start":0,"end":205}],"profiles":{},"directory_counts":{}}
