-085e4594049ec7baaebb"]},{"person":"shaodi-p0107","role":"本弟、咸熙中为车骑将军","evidence":["huanchen-q-085e4594049ec7baaebb"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["huanchen-q-085e4594049ec7baaebb"]},"ordering_evidence":"huanchen-q-085e4594049ec7baaebb","source_order":[22,366,2],"order":4579}],"persons":[{"id":"huanchen-p0051","name":"陈本","evidence":["huanchen-q-2414d0eff0ed26150f01","huanchen-q-085e4594049ec7baaebb","huanchen-q-a2bbfc82c7d1e23f74a3"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[{"id":"huanchen-q-085e4594049ec7baaebb","section":"chapter-022","block":"b-36911014e2aba4efaef8","layer":"original","quote":"薨，子粲嗣。本弟骞〖6〗，咸熙中为车骑将军〖7〗。","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":365,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":25,"offset_unit":"unicode_code_point"},{"id":"huanchen-q-2414d0eff0ed26150f01","section":"chapter-022","block":"b-da0a2e885c004d9c5075","layer":"original","quote":"子本嗣，历位郡守、九卿〖1〗。所在操纲领，举大体；能使群下自尽，有统御之才，不亲小事。不读法律而得廷尉之称〖2〗，优于司马岐等〖3〗，精练文理〖4〗。迁镇北将军〖5〗，假节，都督河北诸军事。","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":364,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":95,"offset_unit":"unicode_code_point"},{"id":"huanchen-q-a2bbfc82c7d1e23f74a3","section":"chapter-022","block":"b-b81bfbf76058f3460286","layer":"pei","quote":"刘晔以先进见幸，因谮矫专权。矫惧，以问长子本，本不知所出。次子骞曰：‘主上明圣，大人大臣；今若不合，不过不作公耳。’后数日，帝见矫；矫又问二子。骞曰：‘陛下意解，故见大人也。’既入，尽日。帝曰：‘刘晔构君，朕有以迹君；朕心故已了。’以金五1 授之，矫辞。帝曰：‘岂以为小惠？君已知朕心，顾君妻子未知故也","attribution":"裴注·《世语》","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":362,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6ec4238f909f9a25cd48","start":10,"end":161,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
