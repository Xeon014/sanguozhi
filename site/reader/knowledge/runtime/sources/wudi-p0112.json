{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o040a","title":"袁嗣向曹操投降","accounts":[{"id":"wudi-e-o040a-account","label":"正文","text":"曹操进军武平，袁术所置陈相袁嗣投降。","evidence":["wudi-e-o040a-q"]}],"participants":[{"person":"cao-cao","role":"受降","evidence":["wudi-e-o040a-q"]},{"person":"wudi-p0112","role":"投降","evidence":["wudi-e-o040a-q"]}],"place":{"text":"武平","evidence":["wudi-e-o040a-q"]},"time":{"label":"建安元年春正月","year":196,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o040a-q","wudi-q-o040","wudi-q-b-16a5462151b1cfe5142d"],"chronology":"wudi-y196","dating_review":{"anchor":"wudi-q-o040","basis":"建安元年春正月","reviewed":true}},"source_order":[1,259,"O040a"],"order":116}],"persons":[{"id":"wudi-p0112","name":"袁嗣","evidence":["wudi-q-o040"],"facts":[],"aliases":[],"mentions":[{"id":"wudi-m-o040-wudi-p0112","kind":"mention","text":"文中提及","evidence":["wudi-q-o040"]}]}],"evidence":[{"id":"wudi-e-o040a-q","section":"chapter-001","block":"b-c71d10ef121af30ac6b7","layer":"original","quote":"建安元年春正月〖1〗，太祖军临武平〖2〗。袁术所置陈相袁嗣，降。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":258,"anchor":null},"note_id":null,"start":0,"end":32},{"id":"wudi-q-b-16a5462151b1cfe5142d","section":"chapter-001","block":"b-16a5462151b1cfe5142d","layer":"modern","quote":"〖1〗建安元年：公元 196 年。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":264,"anchor":null},"note_id":"n-df2756e12f4ac1fef3c4","start":0,"end":17},{"id":"wudi-q-o040","section":"chapter-001","block":"b-c71d10ef121af30ac6b7","layer":"original","quote":"建安元年春正月〖1〗，太祖军临武平〖2〗。袁术所置陈相袁嗣，降。太祖将迎天子，诸将或疑；荀彧、程昱劝之。乃遣曹洪将兵西迎。卫将军董承与袁术将苌奴拒险〖3〗，洪不得进。汝南、颍川黄巾何仪、刘辟、黄邵、何曼等〖4〗，众各数万。初应袁术，又附孙坚〖5〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":258,"anchor":null},"note_id":null,"start":0,"end":124}],"profiles":{},"directory_counts":{