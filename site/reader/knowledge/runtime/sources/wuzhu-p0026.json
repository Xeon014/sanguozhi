{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o177a","title":"张辽李典破孙权合肥军","accounts":[{"id":"wudi-e-o177a-account","label":"正文","text":"孙权围合肥，被张辽、李典击破。","evidence":["wudi-e-o177a-q"]},{"id":"zhouyu-e-o085b-account","label":"《周瑜鲁肃吕蒙传》正文","text":"三郡罢军后至再战濡须：孙权征合肥撤兵遭张辽袭吕蒙凌统扞卫","evidence":["zhouyu-e-o085b-q"]},{"id":"zhangle-e-o009a-account","label":"《张乐于张徐传第十七》正文","text":"张辽突击孙权军复入围救部众","evidence":["zhangle-e-o009a-q"]},{"id":"zhangle-e-o009b-account","label":"《张乐于张徐传第十七》正文","text":"孙权退军张辽追击受征东将军","evidence":["zhangle-e-o009b-q"]},{"id":"wuzhu-e-o030a-account","label":"《吴主传第二》正文","text":"孙权征合肥退军遭张辽袭凌统甘宁扞卫越津桥得免","evidence":["wuzhu-e-o030a-q"]},{"id":"hequan-a-a06957c6b5b825b0b90d","label":"裴注·《江表传》","text":"张辽掩袭权于津北齐迎于津南","evidence":["hequan-q-70589874176e47a80f82"]},{"id":"hequan-a-2fda064dea06a8cfa23c","label":"正文","text":"贺齐传“从权征合肥……徐盛被创失矛牙……齐引兵拒击”与魏纪 wudi-e-o177a“孙权围合肥；张辽、李典击破之”为同一战役两侧记载","evidence":["hequan-q-fa635cf609ade308bebc"]},{"id":"chenghuang-a-152378ae71e08772436e","label":"正文","text":"从征合肥张辽袭权津北钦力战有功","evidence":["chenghuang-q-bbdae7d754c04167e68f"]},{"id":"chenghuang-a-d9b3e148186a42092011","label":"正文","text":"建安二十年武从击合肥奋命战死","evidence":["chenghuang-q-c9178e4de5e1f4d5f1c0"]},{"id":"chenghuang-a-8ef6b3f1c1ad4b276353","label":"正文","text":"逍遥津北宁引弓射敌厉问鼓吹","evidence":["chenghuang-q-30bc891313fd88e2f571"]},{"id":"chenghuang-a-b5813f480b65349e7b25","label":"正文","text":"逍遥津统陷围扶扞权出","evidence":["chenghuang-q-dfa8281d3da2ee994167"]},{"id":"chenghuang-a-73545f385449d776e0cb","label":"正文","text":"合肥张辽奄至璋斩走者兵皆还战","evidence":["chenghuang-q-7f09015d19a4599e5bc0"]},{"id":"lizang-a-c760164c2f50a362982c","label":"正文","text":"李典与张辽乐进屯合肥","evidence":["lizang-q-05f0fb998bfc8704c14b"]},{"id":"lizang-a-4e74afeaed7f3a096d98","label":"正文","text":"孙权率众围合肥","evidence":["lizang-q-b36ec05beaafe3e95b4a"]},{"id":"lizang-a-537f1f9f42fdd46d5990","label":"正文","text":"张辽欲奉曹操之教出战，素与进典不睦恐其不从","evidence":["liza