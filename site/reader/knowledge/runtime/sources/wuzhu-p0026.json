zhu-q-o054"]},{"id":"luxun-m-o016-wuzhu-p0026","kind":"mention","text":"文中提及","evidence":["luxun-q-o016"]},{"id":"luxun-m-o025-wuzhu-p0026","kind":"mention","text":"文中提及","evidence":["luxun-q-o025"]}]}],"evidence":[{"id":"chenghuang-q-30bc891313fd88e2f571","section":"chapter-055","block":"b-59188630395876d5b2b2","layer":"original","quote":"建安二十年，从攻合肥。会疫疾，军旅皆已引出；唯车下虎士千余人〖2〗，并吕蒙、蒋钦、凌统及宁，从权逍遥津北。张辽觇望知之〖3〗，即将步骑奄至。宁引弓射敌，与统等死战。宁厉声问：“鼓吹何以不作〖4〗！”壮气毅然，权尤嘉之","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":247,"anchor":null},"note_id":null,"start":0,"end":108},{"id":"chenghuang-q-7f09015d19a4599e5bc0","section":"chapter-055","block":"b-1c84071264809633ecc0","layer":"original","quote":"合肥之役，张辽奄至，诸将不备。陈武斗死，宋谦、徐盛皆披走。璋身次在后，便驰进；横马斩谦、盛兵走者二人，兵皆还战：权甚壮之。拜偏将军，遂领（百）〔五〕校，屯半州","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":330,"anchor":null},"note_id":null,"start":52,"end":131},{"id":"chenghuang-q-bbdae7d754c04167e68f","section":"chapter-055","block":"b-09bba882c0c6e26f80f2","layer":"original","quote":"从征合肥，魏将张辽袭权于津北〖6〗，钦力战有功","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":82,"anchor":null},"note_id":null,"start":82,"end":105},{"id":"chenghuang-q-c9178e4de5e1f4d5f1c0","section":"chapter-055","block":"b-fc775defe345ffb22e72","layer":"original","quote":"建安二十年，从击合肥，奋命战死。权哀之，自临其葬","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":128,"anchor":null},"note_id":null,"start":0,"end":24},{"id":"chenghuang-q-dfa8281d3da2ee994167","section":"chapter-055","block":"b-6c8f6e6155dc4b71961f","layer":"original","quote":"时权撤军，前部已发；魏将张辽等，奄至津北。权使追还前兵，兵去已远，势不相及；统率亲近三百人陷围，扶扞权出。敌已毁桥，桥之属者两版〖15〗，权策马驱驰；统复还战，左右尽死，身亦被创，所杀数十人；度权已免，乃还。桥败路绝，统被甲潜行","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":272,"anchor":null},"note_id":null,"start":0,"end":114},{"id":"guanzhang-q-b-be58a15ce144f67b67a5","section":"chapter-036","block":"b-be58a15ce144f67b67a5","layer":"modern","quote":"〖13〗二年：章武二年（公元 222）。马超的祠墓遗址，相传在今四川成都市新都区城南的马超小学内，曾有墓碑出土。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":158,"anchor":null},"note_id":"n-1fcace810489e51a4218","start":0,"end":56},{"id":"guanzhang-q-o034","section":"chapter-036","block":"b-7ddd1fa08ce5c9feb1d4","layer":"original","quote":"二年卒〖13〗，时年四十七。临没上疏曰：“臣门宗二百余口〖14〗，为孟德所诛略尽〖15〗；惟有从弟岱，当为微宗血食之继〖16〗，深托陛下。余无复言。”","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":143,"anchor":null},"note_id":null,"start":0,"end":75},{"id":"hequan-q-70589874176e47a80f82","section":"chapter-060","block":"b-5e810aa332c2516ac50a","layer":"pei","quote":"权征合肥还，为张辽所掩袭于津北：几至危殆。齐时率三千兵，在津南迎权。权既入大船，会诸将饮宴","attribution":"裴注·《江表传》","section_title":"贺全吕周钟离传第十五","source":{"file":"OEBPS/Text/titlepage_0127.xhtml","index":85,"anchor":null},"note_id":"n-eb3c2cf75ce087f62140","start":11,"end":56},{"id":"hequan-q-fa635cf609ade308bebc","section":"chapter-060","block":"b-13fedaa660ef9dfd713e","layer":"original","quote":"二十年〖13〗，从权征合肥。时城中出战，徐盛被创失（矛）〔牙〕〖14〗。齐引兵拒击，得盛所失","section_title":"贺全吕周钟离传第十五","source":{"file":"OEBPS/Text/titlepage_0127.xhtml","index":59,"anchor":null},"note_id":null,"start":0,"end":46},{"id":"lizang-q-05f0fb998bfc8704c14b","section":"chapter-018","block":"b-64eb7ed11151550d0650","layer":"original","quote":"与张辽、乐进屯合肥","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":5,"anchor":null},"note_id":null,"start":0,"end":9},{"id":"lizang-q-34c79c216a498f50c9b2","section":"chapter-018","block":"b-64eb7ed11151550d0650","layer":"original","quote":"乃率众与辽破走权","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":5,"anchor":null},"note_id":null,"start":76,"end":84},{"id":"lizang-q-b2a7cbf802ececc91f14","section":"chapter-018","block":"b-64eb7ed11151550d0650","layer":"original","quote":"辽欲奉教出战〖12〗；进、典、辽，皆素不睦，辽恐其不从","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":5,"anchor":null},"note_id":null,"start":17,"end":44},{"id":"lizang-q-b36ec05beaafe3e95b4a","section":"chapter-018","block":"b-64eb7ed11151550d0650","layer":"original","quote":"孙权率众围之","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":5,"anchor":null},"note_id":null,"start":10,"end":16},{"id":"lizang-q-ef25d47a4d54797ab7f5","section":"chapter-018","block":"b-64eb7ed11151550d0650","layer":"original","quote":"典慨然曰：“此国家大事，顾君计何如耳！吾可以私憾而忘公义乎","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":5,"anchor":null},"note_id":null,"start":45,"end":74},{"id":"luxun-e-o016a-q","section":"chapter-058","block":"b-91a1c767b310bb1e937f","layer":"original","quote":"黄武元年，刘备率大众来向西界。权命逊为大都督，假节，督朱然、潘璋、宋谦、韩当、徐盛、鲜于丹、孙桓等五万人拒之〖5〗。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":85,"anchor":null},"note_id":null,"start":0,"end":58},{"id":"luxun-e-o025b-q","section":"chapter-058","block":"b-9aa843011c5bd123fd7c","layer":"original","quote":"又备既住白帝，徐盛、潘璋、宋谦等各竞表言“备必可擒，乞复攻之”。权以问逊，逊与朱然、骆统以为：“曹丕大合士众，外托助国讨备，内实有奸心。谨决计辄还。”","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":118,"anchor":null},"note_id":null,"start":26,"end":101},{"id":"luxun-q-o016","section":"chapter-058","block":"b-91a1c767b310bb1e937f","layer":"original","quote":"黄武元年，刘备率大众来向西界。权命逊为大都督，假节，督朱然、潘璋、宋谦、韩当、徐盛、鲜于丹、孙桓等五万人拒之〖5〗。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":85,"anchor":null},"note_id":null,"start":0,"end":58},{"id":"luxun-q-o025","section":"chapter-058","block":"b-9aa843011c5bd123fd7c","layer":"original","quote":"权大笑称善。加拜逊辅国将军，领荆州牧，即改封江陵侯。又备既住白帝，徐盛、潘璋、宋谦等各竞表言“备必可擒，乞复攻之”。权以问逊，逊与朱然、骆统以为：“曹丕大合士众，外托助国讨备，内实有奸心。谨决计辄还。”无几，魏军果出，三方受敌也〖11〗。﹝一﹞","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":118,"anchor":null},"note_id":null,"start":0,"end":122},{"id":"pangfa-q-o027","section":"chapter-037","block":"b-6b23f8730a9cef243526","layer":"original","quote":"诸葛亮与正，虽好尚不同〖31〗，以公义相取〖32〗；亮每奇正智术。先主既即尊号，将东征孙权以复关羽之耻，群臣多谏，一不从。章武二年，大军败绩，还住白帝。亮叹曰：“法孝直若在，则能制主上，令不东行；就复东行，必不倾危矣！”﹝四﹞","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":152,"anchor":null},"note_id":null,"start":0,"end":113},{"id":"wudi-e-o177a-q","section":"chapter-001","block":"b-56be09918e62007ce730","layer":"original","quote":"八月，孙权围合肥；张辽、李典击破之。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":323,"anchor":null},"note_id":null,"start":0,"end":18},{"id":"wudi-q-b-e0a96bdd9353a663e5ab","section":"chapter-001","block":"b-e0a96bdd9353a663e5ab","layer":"modern","quote":"〖1〗二十年：建安二十年（公元 215 ）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":328,"anchor":null},"note_id":"n-3bb2f11071aab1690790","start":0,"end":22},{"id":"wudi-q-o173","section":"chapter-001","block":"b-fc2c779b81f1c3c13b40","layer":"original","quote":"二十年春正月〖1〗，天子立公中女为皇后〖2〗。省云中、定襄、五原、朔方郡〖3〗，郡置一县领其民；合以为新兴郡〖4〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":319,"anchor":null},"note_id":null,"start":0,"end":58},{"id":"wuzhu-e-o030a-q","section":"chapter-047","block":"b-c5544862d0f0dbfb0095","layer":"original","quote":"权返自陆口，遂征合肥。合肥未下，撤军还，兵皆就路。权与凌统、甘宁等在津北，为魏将张辽所袭〖15〗；统等以死捍权，权乘骏马越津桥，得去。﹝二﹞","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":128,"anchor":null},"note_id":null,"start":0,"end":70},{"id":"wuzhu-e-o054a-q","section":"chapter-047","block":"b-7e0fdf82962252602cbd","layer":"original","quote":"黄武元年春正月〖1〗，陆逊部将军宋谦等〖2〗，攻蜀五屯；皆破之，斩其将。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":293,"anchor":null},"note_id":null,"start":0,"end":36},{"id":"wuzhu-q-o054","section":"chapter-047","block":"b-7e0fdf82962252602cbd","layer":"original","quote":"黄武元年春正月〖1〗，陆逊部将军宋谦等〖2〗，攻蜀五屯；皆破之，斩其将。三月，鄱阳言黄龙现〖3〗。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":293,"anchor":null},"note_id":null,"start":0,"end":49},{"id":"yaoci-q-d7d4aca1e2d1cfd99607","section":"chapter-049","block":"b-db9521ca359ae78fa90e","layer":"original","quote":"时独与一骑，猝遇策。策从骑十三，皆韩当、宋谦、黄盖辈也〖20〗。慈便前斗，正与策对。策刺慈马，而揽得慈项上手戟〖21〗；慈亦得策兜鍪〖22〗。会两家兵骑并各来赴，于是解散","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":113,"anchor":null},"note_id":null,"start":89,"end":174},{"id":"zhangle-e-o009a-q","section":"chapter-017","block":"b-7aaac17cec433f853374","layer":"original","quote":"平旦〖9〗，辽被甲持戟，先登陷阵；杀数十人，斩二将；大呼自名〖10〗，冲垒入，至权麾下。权大惊，众不知所为；走登高冢，以长戟自守。辽叱权“下战”，权不敢动；望见辽所将众少，乃聚围辽数重。辽左右麾围〖11〗，直前急击；围开，辽将麾下数十人得出。余众号呼曰：“将军弃我乎！”辽复还，突围，拔出余众。权人马皆披靡，无敢当者。自旦战至日中，吴人夺气〖12〗。还修守备，众心乃安，诸将咸服。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":20,"anchor":null},"note_id":null,"start":0,"end":190},{"id":"zhangle-e-o009b-q","section":"chapter-017","block":"b-7aaac17cec433f853374","layer":"original","quote":"权守合肥十余日〖13〗，城不可拔，乃引退。辽率诸军追击，几复获权。太祖大壮辽，拜征东将军。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":20,"anchor":null},"note_id":null,"start":190,"end":235},{"id":"zhouyu-e-o085b-q","section":"chapter-054","block":"b-1827f70f66ba5b4938c3","layer":"original","quote":"师还，遂征合肥。既撤兵，为张辽等所袭，蒙与凌统，以死扞卫。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":384,"anchor":null},"note_id":null,"start":11,"end":40}],"profiles":{},"directory_counts":{}}
