{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-p045a","title":"韩冉奉刘备书吊曹操之丧","accounts":[{"id":"xianzhu-e-p045a-account","label":"《魏书》","text":"《魏书》称刘备遣韩冉奉书吊曹操，曹丕恶其因丧求好，命荆州刺史斩韩冉、断绝使命。","evidence":["xianzhu-e-p045a-q"]},{"id":"xianzhu-a-p045-dianlue","label":"《典略》","text":"《典略》称韩冉病留上庸，由上庸转书；适逢曹丕受终，诏书答复，刘备得书后称制。韩冉结局与《魏书》不同。","evidence":["xianzhu-q-p045-dianlue"]}],"participants":[{"person":"liu-bei","role":"遣使","evidence":["xianzhu-e-p045a-q"]},{"person":"xianzhu-p0110","role":"出使","evidence":["xianzhu-e-p045a-q"]},{"person":"wudi-p0170","role":"据魏书命斩使","evidence":["xianzhu-e-p045a-q"]}],"place":null,"time":{"year":220,"label":"曹操死后","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xianzhu-y220","dating_review":{"reviewed":true,"anchor":"xianzhu-q-o061","basis":"曹操死后"},"evidence":["xianzhu-e-p045a-q","xianzhu-q-o061","xianzhu-q-b-702ed09e6ffd28cb4f1b"]},"source_order":[32,399,"P045a"],"order":6601}],"persons":[{"id":"xianzhu-p0110","name":"韩冉","evidence":["xianzhu-q-p045"],"facts":[],"aliases":[],"mentions":[{"id":"xianzhu-m-p045-xianzhu-p0110","kind":"mention","text":"文中提及","evidence":["xianzhu-q-p045"]}]}],"evidence":[{"id":"xianzhu-e-p045a-q","section":"chapter-032","block":"b-95d790092606bb4daa34","layer":"pei","quote":"《魏书》曰：“备闻曹公薨，遣掾韩冉奉书吊，并致赙赠之礼。文帝恶其因丧求好，敕荆州刺史斩冉，绝使命。”","attribution":"《魏书》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":398,"anchor":null},"note_id":"n-2cd66f2cbe5a2ad2731c","start":3,"end":53},{"id":"xianzhu-q-b-702ed09e6ffd28cb4f1b","section":"chapter-032","block":"b-702ed09e6ffd28cb4f1b","layer":"modern","quote":"〖1〗二十五年：建安二十五年（公元 220）。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":320,"anchor":null},"note_id":"n-05fade9a1016742646ad","start":0,"end":23},{"id":"xianzhu-q-o061","section":"chapter-032","block":"b-fb8f2a2c4ba112009d00","layer":"original","quote":"二十五年〖1〗，魏文帝称尊号，改年曰“黄初”。或传闻汉帝见害，先主乃发丧制服〖2〗，追谥曰“孝愍皇帝”。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":316,"anchor":null},"note_id":null,"start":0,"end":52},{"id":"xianzhu-q-p045","section":"chapter-032","block":"b-95d790092606bb4daa34","layer":"pei","quote":"﹝二﹞《魏书》曰：“备闻曹公薨，遣掾韩冉奉书吊，并致赙赠之礼。文帝恶其因丧求好，敕荆州刺史斩冉，绝使命。”《典略》曰：“备遣军谋掾韩冉，赍书吊，并贡锦布。冉称疾，住上庸。上庸致其书，适会受终，有诏报答，以引致之。备得报书，遂称制。”","attribution":"《魏书》；《典略》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":398,"anchor":null},"note_id":"n-2cd66f2cbe5a2ad2731c","start":0,"end":116},{"id":"xianzhu-q-p045-dianlue","section":"chapter-032","block":"b-95d790092606bb4daa34","layer":"pei","quote":"《典略》曰：“备遣军谋掾韩冉，赍书吊，并贡锦布。冉称疾，住上庸。上庸致其书，适会受终，有诏报答，以引致之。备得报书，遂称制。”","attribution":"《典略》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":398,"anchor":null},"note_id":"n-2cd66f2cbe5a2ad2731c","start":53,"end":116}],"profiles":{},"directory_counts":{}}
