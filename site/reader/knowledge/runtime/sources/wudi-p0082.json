":162,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9a4e1c3763a7d22a5e04","start":10,"end":25,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-b08678be56e2c5e8582c","section":"chapter-008","block":"b-e96ffada202f222baadb","layer":"original","quote":"其将杨丑，杀杨以应太祖","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":147,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":11,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-cb8516a343c32ccc5838","section":"chapter-008","block":"b-56904fd1db04b70697d8","layer":"pei","quote":"时有巫，诫固曰：‘将军字“兔”而此邑名“犬”，兔见犬，其势必惊，宜急移去！’固不从，遂战死","attribution":"裴注·典略","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":162,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9a4e1c3763a7d22a5e04","start":26,"end":71,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-f3d13d4c430c2aebb31a","section":"chapter-008","block":"b-e96ffada202f222baadb","layer":"original","quote":"杨将眭固杀丑，将其众，欲北合袁绍。太祖遣史涣邀击，破之于犬城，斩固，尽收其众也","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":147,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":12,"end":51,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o018b-q","section":"chapter-001","block":"b-1692e234ab7a13fd2792","layer":"original","quote":"黑山贼于毒、白绕、眭固等十余万众略魏郡、东郡〖3〗，﹝一﹞王肱不能御。太祖引兵入东郡，击白绕于濮阳〖4〗，破之。袁绍因表太祖为东郡太守；治东武阳〖5〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":141,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":17,"end":93,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o019b-q","section":"chapter-001","block":"b-43620706e925cc9a268c","layer":"original","quote":"太祖要击眭固〖4〗，又击匈奴于夫罗于内黄〖5〗，皆大破之。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":150,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":53,"end":82,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o061b-q","section":"chapter-001","block":"b-502d4e8c0ed143eaa30d","layer":"original","quote":"张杨将杨丑杀杨〖3〗。眭固又杀丑，以其众属袁绍，屯射犬〖4〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":358,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":18,"end":49,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o062a-q","section":"chapter-001","block":"b-01656b554fda06a0ac10","layer":"original","quote":"夏四月，进军临河，使史涣、曹仁渡河击之〖5〗。固使杨故长史薛洪、河内太守缪尚留守〖6〗，自将兵北迎绍求救。与涣、仁相遇犬城〖7〗，交战；大破之，斩固。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":359,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":75,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-3863a19b555811d1f415","section":"chapter-001","block":"b-3863a19b555811d1f415","layer":"modern","quote":"〖1〗三年：初平三年（公元 192）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":152,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-2063caf2b642ce9ff2bc","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-51bced16741add42ff70","section":"chapter-001","block":"b-51bced16741add42ff70","layer":"modern","quote":"〖1〗四年：建安四年（公元 199）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":369,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-20628d34a709162c77f0","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-51f98a867014d3fedddd","section":"chapter-001","block":"b-51f98a867014d3fedddd","layer":"modern","quote":"〖1〗二年：初平二年（公元 191）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":143,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-675465772382db7c3192","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o016","section":"chapter-001","block":"b-15ef6fb810e957089b24","layer":"original","quote":"二年春〖1〗，绍、馥遂立虞为帝，虞终不敢当。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":139,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":22,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o018","section":"chapter-001","block":"b-1692e234ab7a13fd2792","layer":"original","quote":"秋七月，袁绍胁韩馥，取冀州〖2〗。黑山贼于毒、白绕、眭固等十余万众略魏郡、东郡〖3〗，﹝一﹞王肱不能御。太祖引兵入东郡，击白绕于濮阳〖4〗，破之。袁绍因表太祖为东郡太守；治东武阳〖5〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":141,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":93,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o019","section":"chapter-001","block":"b-43620706e925cc9a268c","layer":"original","quote":"三年春〖1〗，太祖军顿丘，毒等攻东武阳。太祖乃引兵西入山，攻毒等本屯〖2〗。﹝一﹞毒闻之，弃武阳还〖3〗。太祖要击眭固〖4〗，又击匈奴于夫罗于内黄〖5〗，皆大破之。﹝二﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":150,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":85,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o061","section":"chapter-001","block":"b-502d4e8c0ed143eaa30d","layer":"original","quote":"四年春二月〖1〗，公还至昌邑〖2〗。张杨将杨丑杀杨〖3〗。眭固又杀丑，以其众属袁绍，屯射犬〖4〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":358,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":49,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o062","section":"chapter-001","block":"b-01656b554fda06a0ac10","layer":"original","quote":"夏四月，进军临河，使史涣、曹仁渡河击之〖5〗。固使杨故长史薛洪、河内太守缪尚留守〖6〗，自将兵北迎绍求救。与涣、仁相遇犬城〖7〗，交战；大破之，斩固。公遂济河，围射犬。洪、尚率众降，封为列侯〖8〗。还军敖仓。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":359,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":104,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o143","section":"chapter-001","block":"b-87c7d8a437d7c846207e","layer":"original","quote":"昔者董卓初兴国难，群后释位以谋王室〖31〗；﹝四﹞君则摄进〖32〗，首启戎行〖33〗。此君之忠于本朝也。后及黄巾反易天常〖34〗，侵我三州〖35〗，延及平民；君又翦之以宁东夏〖36〗。此又君之功也。韩暹、杨奉专用威命；君则致讨，克黜其难，遂迁许都，造我京畿，设官兆祀〖37〗，不失旧物〖38〗，天地鬼神于是获乂〖39〗。此又君之功也。袁术僭逆〖40〗，肆于淮南；慑惮君灵，用丕显谋〖41〗，蕲阳之役〖42〗，桥蕤授首〖43〗，稜威南迈，术以陨溃。此又君之功也。回戈东征，吕布就戮；乘辕将返，张杨殂毙，眭固伏罪，张绣稽服〖44〗。此又君之功也。袁绍逆乱天常，谋危社稷，凭恃其众，称兵内侮〖45〗。当此之时，王师寡弱，天下寒心，莫有固志；君执大节〖46〗，精贯白日，奋其武怒，运其神策，致届官渡〖47〗，大歼丑类，﹝五﹞俾我国家拯于危坠。此又君之功也。济师洪河〖48〗，拓定四州〖49〗，袁谭、高幹，咸枭其首，海盗奔进，黑山顺轨〖50〗。此又君之功也。乌丸三种〖51〗，崇乱二世〖52〗，袁尚因之，逼据塞北；束马悬车〖53〗，一征而灭。此又君之功也。刘表背诞，不供贡职〖54〗；王师首路〖55〗，威风先逝，百城八郡〖56〗，交臂屈膝。此又君之功也。马超、成宜，同恶相济，滨据河、潼，求逞所欲；殄之渭南，献馘万计〖57〗，遂定边境，抚和戎狄。此又君之功也。鲜卑、丁零〖58〗，重译而至〖59〗；（单）〔箄〕于、白屋〖60〗，请吏率职〖61〗。此又君之功也。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":111,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":625,"offset_unit":"unicode_code_point"},{"id":"wudi-q-p034","section":"chapter-001","block":"b-254320fef043104de388","layer":"pei","quote":"﹝一﹞眭，申随反。","attribution":"裴松之音释","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":149,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ac3c6e2c07274f0e1e73","start":0,"end":9,"offset_unit":"unicode_code_point"},{"id":"zhangle-e-o015c-q","section":"chapter-017","block":"b-ed66dc626c10ce5c9c00","layer":"original","quote":"从征张绣于安众；围吕布于下邳，破别将。击眭固于射犬，攻刘备于沛；皆破之，拜讨寇校尉〖3〗。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":56,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":91,"end":136,"offset_unit":"unicode_code_point"},{"id":"zhangle-e-o022a-q","section":"chapter-017","block":"b-3c2b1d6da151e5fdfca1","layer":"original","quote":"复从攻张绣于穰，擒吕布于下邳；别与史涣、曹仁攻眭固于射犬，破斩之。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":74,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":33,"offset_unit":"unicode_code_point"},{"id":"zhangle-e-o040c-q","section":"chapter-017","block":"b-e7ed3fa863e93b8dd8f5","layer":"original","quote":"与史涣斩眭固于河内。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":145,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":44,"end":54,"offset_unit":"unicode_code_point"},{"id":"zhangle-q-o015","section":"chapter-017","block":"b-ed66dc626c10ce5c9c00","layer":"original","quote":"乐进字文谦，阳平卫国人也〖1〗。容貌短小，以胆烈从太祖，为帐下吏。遣还本郡募兵，得千余人；还为军假司马、陷阵都尉〖2〗。从击吕布于濮阳，张超于雍丘，桥蕤于苦；皆先登有功，封广昌亭侯。从征张绣于安众；围吕布于下邳，破别将。击眭固于射犬，攻刘备于沛；皆破之，拜讨寇校尉〖3〗。渡河攻获嘉〖4〗。还，从击袁绍于官渡；力战，斩绍将淳于琼。从击谭、尚于黎阳，斩其大将严敬，行游击将军〖5〗。别击黄巾，破之，定乐安郡。从围邺。邺定，从击袁谭于南皮；先登，入谭东门。谭败，别攻雍奴，破之。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":56,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":237,"offset_unit":"unicode_code_point"},{"id":"zhangle-q-o022","section":"chapter-017","block":"b-3c2b1d6da151e5fdfca1","layer":"original","quote":"复从攻张绣于穰，擒吕布于下邳；别与史涣、曹仁攻眭固于射犬，破斩之。太祖初征袁绍，绍兵盛，禁愿为先登。太祖壮之，乃遣步卒二千人，使禁将，守延津以拒绍；太祖引军还官渡。刘备以徐州叛，太祖东征之。绍攻禁，禁坚守，绍不能拔。复与乐进等将步骑五千，击绍别营：从延津西南，缘河至汲、获嘉二县〖9〗，焚烧堡聚三十余屯；斩首、获生各数千，降绍将何茂、王摩等二十余人。太祖复使禁别将屯原武，击绍别营于杜氏津〖10〗，破之。迁裨将军。后从还官渡。太祖与绍连营，起土山相对。绍射营中，士卒多死伤，军中惧。禁督守土山，力战，气益奋。绍破，迁偏将军。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":74,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":262,"offset_unit":"unicode_code_point"},{"id":"zhangle-q-o040","section":"chapter-017","block":"b-e7ed3fa863e93b8dd8f5","layer":"original","quote":"太祖授晃兵，使击卷、﹝一﹞原武贼〖1〗；破之，拜裨将军。从征吕布，别降布将赵庶、李邹等。与史涣斩眭固于河内。从破刘备。又从破颜良，拔白马；进至延津，破文丑，拜偏将军。与曹洪击！强贼祝臂，破之。又与史涣击袁绍运车于故市〖2〗，功最多，封都亭侯〖3〗。太祖既围邺，破邯郸。易阳令韩范，伪以城降而拒守，太祖遣晃攻之。晃至，飞矢城中，为陈成败；范悔，晃辄降之〖4〗。既而言于太祖曰：“二袁未破，诸城未下者倾耳而听；今日灭易阳〖5〗，明日皆以死守：恐河北无定时也。愿公降易阳以示诸诚，则莫不望风。”太祖善之。别讨毛城，设伏兵掩击，破三屯。从破袁谭于南皮，讨平原叛贼，克之。从征蹋顿，拜横野将军〖6〗。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":145,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":295,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
