:"luxun-p0038","name":"吴遽","evidence":["luxun-q-o046","chenghuang-q-68555c284fe2d48cb7b2"],"facts":[],"aliases":[],"mentions":[{"id":"luxun-m-o046-luxun-p0038","kind":"mention","text":"文中提及","evidence":["luxun-q-o046"]},{"id":"luxun-m-o047-luxun-p0038","kind":"mention","text":"文中提及","evidence":["luxun-q-o047"]}]}],"evidence":[{"id":"chenghuang-q-68555c284fe2d48cb7b2","section":"chapter-055","block":"b-24eb50d92b2e22f7c778","layer":"original","quote":"事捷当出，会鄱阳民吴遽等为乱，攻没城郭，属县摇动。表便越界赴讨，遽以破败，遂降","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":136,"anchor":null},"note_id":null,"start":17,"end":56},{"id":"luxun-e-o046b-q","section":"chapter-058","block":"b-508d313e4945c4b92d80","layer":"original","quote":"郡民吴遽等，果作贼杀祗〖4〗，攻没诸县。豫章、庐陵宿恶民，并应遽为寇。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":227,"anchor":null},"note_id":null,"start":60,"end":95},{"id":"luxun-e-o047a-q","section":"chapter-058","block":"b-fce345b7014021c541cb","layer":"original","quote":"逊自闻，辄讨，即破之，遽等相率降；逊料得精兵八千余人〖5〗，三郡平。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":228,"anchor":null},"note_id":null,"start":0,"end":34},{"id":"luxun-q-b-40e1f18c241312408404","section":"chapter-058","block":"b-40e1f18c241312408404","layer":"modern","quote":"〖1〗六年：嘉禾六年（公元 237）。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":233,"anchor":null},"note_id":"n-ea2722028be4230bd30d","start":0,"end":19},{"id":"luxun-q-o046","section":"chapter-058","block":"b-508d313e4945c4b92d80","layer":"original","quote":"六年〖1〗，中郎将周祗乞于鄱阳召募〖2〗，事下问逊〖3〗。逊以为：“此郡民易动难安，不可与召，恐致贼寇。”而祗固陈取之。郡民吴遽等，果作贼杀祗〖4〗，攻没诸县。豫章、庐陵宿恶民，并应遽为寇。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":227,"anchor":null},"note_id":null,"start":0,"end":95},{"id":"luxun-q-o047","section":"chapter-058","block":"b-fce345b7014021c541cb","layer":"original","quote":"逊自闻，辄讨，即破之，遽等相率降；逊料得精兵八千余人〖5〗，三郡平。","sec