wuwen-q-92c917c7ef8e02d47f77"]}],"aliases":[{"text":"景明","evidence":["shaodi-f0007-q"]}],"mentions":[{"id":"shaodi-m-o145-shaodi-p0137","kind":"mention","text":"文中提及","evidence":["shaodi-q-o145"]},{"id":"shaodi-m-o150-shaodi-p0137","kind":"mention","text":"文中提及","evidence":["shaodi-q-o150"]},{"id":"shaodi-m-o151-shaodi-p0137","kind":"mention","text":"文中提及","evidence":["shaodi-q-o151"]},{"id":"shaodi-m-o152-shaodi-p0137","kind":"mention","text":"文中提及","evidence":["shaodi-q-o152"]},{"id":"shaodi-m-o154-shaodi-p0137","kind":"mention","text":"文中提及","evidence":["shaodi-q-o154"]},{"id":"shaodi-m-o156-shaodi-p0137","kind":"mention","text":"文中提及","evidence":["shaodi-q-o156"]},{"id":"shaodi-m-o171-shaodi-p0137","kind":"mention","text":"文中提及","evidence":["shaodi-q-o171"]},{"id":"shaodi-m-o192-shaodi-p0137","kind":"mention","text":"文中提及","evidence":["shaodi-q-o192"]},{"id":"shaodi-m-p059-shaodi-p0137","kind":"mention","text":"文中提及","evidence":["shaodi-q-p059"]},{"id":"shaodi-m-o193-shaodi-p0137","kind":"mention","text":"文中提及","evidence":["shaodi-q-o193"]}]}],"evidence":[{"id":"atlas-close-q-cession","section":"chapter-004","block":"b-edc0dcc1040b3fe5b942","layer":"original","quote":"十二月，壬戌〖30〗，天禄永终，历数在晋。诏群公、卿士，具仪设坛于南郊。使使者，奉皇帝玺、绶、册，禅位于晋嗣王，如汉魏故事〖31〗。甲子〖32〗，使使者，奉策〖33〗。遂改次于金墉城〖34〗，而终馆于邺〖35〗。时年二十。﹝一﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":342,"anchor":null},"note_id":null,"start":0,"end":114},{"id":"atlas-close-q-cession-date","section":"chapter-004","block":"b-8abf101ce18961734498","layer":"modern","quote":"〖34〗改次：改变住处。禅位策书发出之后，当天曹奂就搬出皇宫，把皇宫让给新皇帝。金墉城：城名。在当时洛阳城西北角。曹魏时筑。城小而坚固。魏晋时被废黜的帝后，常安置在这里，以便看管。现今称其故址为阿斗城。据《晋书》卷三《武帝纪》，司马炎正式登坛受禅，是在十二月丙寅，即旧历十七日。据陈垣《二十史朔闰表》，这一天相当于公元266 年的 2 月 8 日。因此，曹魏的灭亡和西晋的建立，准确记载应当是公元 266 年。但是，现今各种历史著作和年表，都记为公元 265 年。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":377,"anchor":null},"note_id":"n-d95feb0f252b5b7eb9ee","start":0,"end":232},{"id":"atlas-close-q-jin-successor","section":"chapter-004","block":"b-da129eb97e46a9aa0d42","layer":"original","quote":"秋八月，辛卯〖17〗，相国晋王薨。壬辰〖18〗，晋太子炎，绍封袭位，总摄百揆〖19〗。备物典册〖20〗，一皆如前。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":339,"anchor":null},"note_id":null,"start":0,"end":57},{"id":"huowang-q-eca849571f2a79217ee0","section":"chapter-041","block":"b-fec186c9562152cd4da0","layer":"pei","quote":"明年十二月而晋武帝即尊位，‘炎兴’于是乎征焉","attribution":"裴注·襄阳记","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":65,"anchor":null},"note_id":"n-5078c16e094c6d2cad41","start":153,"end":175},{"id":"shaodi-e-o145a-q","section":"chapter-004","block":"b-de0a6c58f97f641a997d","layer":"original","quote":"使使持节、行中护军、中垒将军司马炎，北迎常道乡公璜〖1〗，嗣明帝后。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":91,"anchor":null},"note_id":null,"start":0,"end":34},{"id":"shaodi-e-o151a-q","section":"chapter-004","block":"b-838d4edda8e54fc8ac78","layer":"original","quote":"陈留王讳奂，字景明。武帝孙，燕王宇子也。甘露三年，封安次县常道乡公〖1〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":127,"anchor":null},"note_id":null,"start":0,"end":37},{"id":"shaodi-e-o152a-q","section":"chapter-004","block":"b-9a699abc49a143945c79","layer":"original","quote":"高贵乡公卒，公卿议迎立公。六月，甲寅〖2〗，入于洛阳，见皇太后。是日，即皇帝位于太极前殿。大赦，改年，赐民爵及谷帛各有差。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":128,"anchor":null},"note_id":null,"start":0,"end":61},{"id":"shaodi-e-o154a-q","section":"chapter-004","block":"b-e338619a5503030f1d3a","layer":"original","quote":"己未〖6〗，故汉献帝夫人节，薨；帝临于华林园〖7〗。使使持节，追谥夫人为献穆皇后。及葬，车服制度皆如汉氏故事。癸亥〖8〗，以尚书右仆射王观为司空〖9〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":130,"anchor":null},"note_id":null,"start":0,"end":76},{"id":"shaodi-e-o156a-q","section":"chapter-004","block":"b-16a89a67831148806499","layer":"original","quote":"十一月，燕王上表贺冬至〖1〗，称“臣”。诏曰：“古之王者，或有所不臣〖2〗；王将宜依此义。表不称‘臣’乎，又当为报〖3〗。夫后大宗者，降其私亲〖4〗，况所继者重邪〖5〗！若便同之臣妾〖6〗，亦情所未安。其皆依礼典处，当务尽其宜。”","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":142,"anchor":null},"note_id":null,"start":0,"end":115},{"id":"shaodi-e-o171b-q","section":"chapter-004","block":"b-cef469d41ec5962b4e48","layer":"original","quote":"咸熙元年春正月，壬戌〖1〗，槛车征邓艾〖2〗。甲子〖3〗，行幸长安。壬申〖4〗，使使者以璧币祀华山〖5〗。是月，钟会反于蜀，为众所讨。邓艾亦见杀。二月，辛卯〖6〗，特赦诸在益土者。庚申〖7〗，葬明元郭后。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":220,"anchor":null},"note_id":null,"start":0,"end":102},{"id":"shaodi-e-o192a-q","section":"chapter-004","block":"b-edc0dcc1040b3fe5b942","layer":"original","quote":"十二月，壬戌〖30〗，天禄永终，历数在晋。诏群公、卿士，具仪设坛于南郊。使使者，奉皇帝玺、绶、册，禅位于晋嗣王，如汉魏故事〖31〗。甲子〖32〗，使使者，奉策〖33〗。遂改次于金墉城〖34〗，而终馆于邺〖35〗。时年二十。﹝一﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":342,"anchor":null},"note_id":null,"start":0,"end":114},{"id":"shaodi-e-o192b-q","section":"chapter-004","block":"b-edc0dcc1040b3fe5b942","layer":"original","quote":"十二月，壬戌〖30〗，天禄永终，历数在晋。诏群公、卿士，具仪设坛于南郊。使使者，奉皇帝玺、绶、册，禅位于晋嗣王，如汉魏故事〖31〗。甲子〖32〗，使使者，奉策〖33〗。遂改次于金墉城〖34〗，而终馆于邺〖35〗。时年二十。﹝一﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":342,"anchor":null},"note_id":null,"start":0,"end":114},{"id":"shaodi-e-p059a-q","section":"chapter-004","block":"b-b5f697bfa7750e53c840","layer":"pei","quote":"﹝一﹞《魏世谱》曰：“封帝为陈留王。年五十八，太安元年崩。谥曰元皇帝。”","attribution":"《魏世谱》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":380,"anchor":null},"note_id":"n-80535c5769440330c029","start":0,"end":36},{"id":"shaodi-e-p059b-q","section":"chapter-004","block":"b-b5f697bfa7750e53c840","layer":"pei","quote":"﹝一﹞《魏世谱》曰：“封帝为陈留王。年五十八，太安元年崩。谥曰元皇帝。”","attribution":"《魏世谱》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":380,"anchor":null},"note_id":"n-80535c5769440330c029","start":0,"end":36},{"id":"shaodi-f0007-q","section":"chapter-004","block":"b-838d4edda8e54fc8ac78","layer":"original","quote":"字景明","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":127,"anchor":null},"note_id":null,"start":6,"end":9},{"id":"shaodi-f0008-q","section":"chapter-004","block":"b-838d4edda8e54fc8ac78","layer":"original","quote":"燕王宇子也。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":127,"anchor":null},"note_id":null,"start":14,"end":20},{"id":"shaodi-f0016-q","section":"chapter-004","block":"b-838d4edda8e54fc8ac78","layer":"original","quote":"讳奂","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":127,"anchor":null},"note_id":null,"start":3,"end":5},{"id":"shaodi-q-b-77066dd061eb6a338ffa","section":"chapter-004","block":"b-77066dd061eb6a338ffa","layer":"modern","quote":"〖1〗五年：甘露五年（公元 260 ）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":50,"anchor":null},"note_id":"n-21e90e29c9fd438bba21","start":0,"end":20},{"id":"shaodi-q-b-ded6d700dc6f860d1670","section":"chapter-004","block":"b-ded6d700dc6f860d1670","layer":"modern","quote":"〖1〗四年：景元四年（公元 263）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":201,"anchor":null},"note_id":"n-ef642248e44d01f3825d","start":0,"end":19},{"id":"shaodi-q-b-ee7d999da8e03b038d07","section":"chapter-004","block":"b-ee7d999da8e03b038d07","layer":"modern","quote":"〖1〗三年：甘露三年（公元 258）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":582,"anchor":null},"note_id":"n-663d9ce877d00f2d0cbc","start":0,"end":19},{"id":"shaodi-q-o129","section":"chapter-004","block":"b-b1abcd215d0c852fc17c","layer":"original","quote":"三年春二月〖1〗，大将军司马文王陷寿春城，斩诸葛诞。三月，诏曰：“古者克敌，收其尸以为京观〖2〗，所以惩昏逆而彰武功也。汉孝武元鼎中〖3〗，改桐乡为闻喜〖4〗，新乡为获嘉〖5〗，以著南越之亡〖6〗。大将军亲总六戎〖7〗，营据丘头〖8〗；内夷群凶〖9〗，外殄寇虏〖10〗；功济兆民，声振四海。克敌之地，宜有令名〖11〗：其改‘丘头’为‘武丘’。明以武平乱，后世不忘；亦京观、二邑之义也〖12〗”。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":575,"anchor":null},"note_id":null,"start":0,"end":197},{"id":"shaodi-q-o139","section":"chapter-004","block":"b-c33fc441ae4a3de17fb6","layer":"original","quote":"五年春正月朔〖1〗，日有食之。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":45,"anchor":null},"note_id":null,"start":0,"end":15},{"id":"shaodi-q-o145","section":"chapter-004","block":"b-de0a6c58f97f641a997d","layer":"original","quote":"使使持节、行中护军、中垒将军司马炎，北迎常道乡公璜〖1〗，嗣明帝后。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":91,"anchor":null},"note_id":null,"start":0,"end":34},{"id":"shaodi-q-o150","section":"chapter-004","block":"b-d7bc0f55ba72e31279cb","layer":"original","quote":"六月，癸丑〖1〗，诏曰：“古者人君之为名字，难犯而易讳。今常道乡公讳字甚难避〖2〗；其朝臣博议改易，列奏。”","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":123,"anchor":null},"note_id":null,"start":0,"end":54},{"id":"shaodi-q-o151","section":"chapter-004","block":"b-838d4edda8e54fc8ac78","layer":"original","quote":"陈留王讳奂，字景明。武帝孙，燕王宇子也。甘露三年，封安次县常道乡公〖1〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":127,"anchor":null},"note_id":null,"start":0,"end":37},{"id":"shaodi-q-o152","section":"chapter-004","block":"b-9a699abc49a143945c79","layer":"original","quote":"高贵乡公卒，公卿议迎立公。六月，甲寅〖2〗，入于洛阳，见皇太后。是日，即皇帝位于太极前殿。大赦，改年，赐民爵及谷帛各有差。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":128,"anchor":null},"note_id":null,"start":0,"end":61},{"id":"shaodi-q-o154","section":"chapter-004","block":"b-e338619a5503030f1d3a","layer":"original","quote":"己未〖6〗，故汉献帝夫人节，薨；帝临于华林园〖7〗。使使持节，追谥夫人为献穆皇后。及葬，车服制度皆如汉氏故事。癸亥〖8〗，以尚书右仆射王观为司空〖9〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":130,"anchor":null},"note_id":null,"start":0,"end":76},{"id":"shaodi-q-o156","section":"chapter-004","block":"b-16a89a67831148806499","layer":"original","quote":"十一月，燕王上表贺冬至〖1〗，称“臣”。诏曰：“古之王者，或有所不臣〖2〗；王将宜依此义。表不称‘臣’乎，又当为报〖3〗。夫后大宗者，降其私亲〖4〗，况所继者重邪〖5〗！若便同之臣妾〖6〗，亦情所未安。其皆依礼典处，当务尽其宜。”","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":142,"anchor":null},"note_id":null,"start":0,"end":115},{"id":"shaodi-q-o157-judgment","section":"chapter-004","block":"b-e53c9dd696d7849bbcb1","layer":"original","quote":"有司奏以为：“礼莫崇于尊祖，制莫大于正典。陛下稽德期运〖7〗，抚临万国；绍大宗之重〖8〗，隆三祖之基。伏惟燕王体尊戚属〖9〗，正位藩服〖10〗；躬秉虔肃，率蹈恭德以先万国〖11〗：其于正典，阐济大顺〖12〗，所不得制〖13〗。圣朝诚宜崇以非常之制，奉以不臣之礼。臣等平议以为〖14〗：燕王章表，可听如旧式〖15〗。中诏所施，或存好问〖16〗，准之义类，则宴觌之族也〖17〗；可少顺圣敬〖18〗，加崇仪称〖19〗，示不敢斥〖20〗，宜曰‘皇帝敬问大王侍御’。至于制书，国之正典，朝廷所以辨章公制〖21〗，宣昭轨仪于天下者也〖22〗；宜循法，故曰‘制诏燕王’。凡诏命、制书、奏事、上书诸称‘燕王’者，可皆上平〖23〗。其非宗庙助祭之事，皆不得称王名；奏事、上书、文书及吏民，皆不得触王讳：以彰殊礼加于群后〖24〗。上遵王典尊祖之制，俯顺圣敬烝烝之心〖25〗；二者不愆〖26〗，礼实宜之。可普告施行。”","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":143,"anchor":null},"note_id":null,"start":0,"end":398},{"id":"shaodi-q-o165","section":"chapter-004","block":"b-b35fdf03685051716720","layer":"original","quote":"四年春二月〖1〗，复命大将军进位、爵赐，一如前诏。又固辞，乃止。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":194,"anchor":null},"note_id":null,"start":0,"end":32},{"id":"shaodi-q-o171","section":"chapter-004","block":"b-cef469d41ec5962b4e48","layer":"original","quote":"咸熙元年春正月，壬戌〖1〗，槛车征邓艾〖2〗。甲子〖3〗，行幸长安。壬申〖4〗，使使者以璧币祀华山〖5〗。是月，钟会反于蜀，为众所讨。邓艾亦见杀。二月，辛卯〖6〗，特赦诸在益土者。庚申〖7〗，葬明元郭后。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":220,"anchor":null},"note_id":null,"start":0,"end":102},{"id":"shaodi-q-o192","section":"chapter-004","block":"b-edc0dcc1040b3fe5b942","layer":"original","quote":"十二月，壬戌〖30〗，天禄永终，历数在晋。诏群公、卿士，具仪设坛于南郊。使使者，奉皇帝玺、绶、册，禅位于晋嗣王，如汉魏故事〖31〗。甲子〖32〗，使使者，奉策〖33〗。遂改次于金墉城〖34〗，而终馆于邺〖35〗。时年二十。﹝一﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":342,"anchor":null},"note_id":null,"start":0,"end":114},{"id":"shaodi-q-o193","section":"chapter-004","block":"b-b56f73a4ac227b69b59e","layer":"original","quote":"评曰：古者以天下为公〖1〗，唯贤是与〖2〗。后代世位〖3〗，立子以嫡；若嫡嗣不继，则宜取旁亲明德〖4〗，若汉之文、宣者：斯不易之常准也。明帝既不能然〖5〗，情系私爱；抚养婴孩，传以大器〖6〗。托付不专，必参支族〖7〗；终于曹爽诛夷，齐王替位。高贵公，才慧夙成，好问尚辞〖8〗，盖亦文帝之风流也〖9〗；然轻躁忿肆，自蹈大祸。陈留王，恭己南面〖10〗，宰辅统政；仰遵前式，揖让而禅；遂飨封大国，作宾于晋〖11〗：比之山阳〖12〗，班宠有加焉〖13〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":381,"anchor":null},"note_id":null,"start":0,"end":223},{"id":"shaodi-q-p059","section":"chapter-004","block":"b-b5f697bfa7750e53c840","layer":"pei","quote":"﹝一﹞《魏世谱》曰：“封帝为陈留王。年五十八，太安元年崩。谥曰元皇帝。”","attribution":"《魏世谱》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":380,"anchor":null},"note_id":"n-80535c5769440330c029","start":0,"end":36},{"id":"wuwen-q-92c917c7ef8e02d47f77","section":"chapter-020","block":"b-f0a1deb453ed989c4310","layer":"original","quote":"常道乡公奂，宇之子，入继大宗。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":53,"anchor":null},"note_id":null,"start":0,"end":15}],"profiles":{"shaodi-p0137":{"fields":[{"id":"shaodi-f0007","key":"courtesy","label":"字","text":"景明","evidence":["shaodi-f0007-q"]}],"directory":{"faction":"wei"}}},"directory_counts":{}}
