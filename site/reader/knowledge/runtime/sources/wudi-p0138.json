{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o053a","title":"曹操擒邓济并取湖阳舞阴","accounts":[{"id":"wudi-e-o053a-account","label":"正文","text":"曹操南征到宛，攻下刘表将邓济据守的湖阳，擒邓济，再取舞阴。","evidence":["wudi-e-o053a-q"]}],"participants":[{"person":"cao-cao","role":"攻城擒将","evidence":["wudi-e-o053a-q"]},{"person":"wudi-p0138","role":"被擒","evidence":["wudi-e-o053a-q"]},{"person":"liu-biao","role":"所属将领参战","evidence":["wudi-e-o053a-q"]}],"place":{"text":"宛、湖阳、舞阴","evidence":["wudi-e-o053a-q"]},"time":{"label":"建安二年冬十一月","year":197,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o053a-q","wudi-q-o050","wudi-q-b-40d8b7057f4a29d6fe0d"],"chronology":"wudi-y197","dating_review":{"anchor":"wudi-q-o050","basis":"建安二年冬十一月","reviewed":true}},"source_order":[1,302,"O053a"],"order":139}],"persons":[{"id":"wudi-p0138","name":"邓济","evidence":["wudi-q-o053"],"facts":[],"aliases":[],"mentions":[{"id":"wudi-m-o053-wudi-p0138","kind":"mention","text":"文中提及","evidence":["wudi-q-o053"]}]}],"evidence":[{"id":"wudi-e-o053a-q","section":"chapter-001","block":"b-52bec363594071a2bd97","layer":"original","quote":"冬十一月，公自南征，至宛。﹝三﹞表将邓济，据湖阳〖16〗。攻拔之，生擒济，湖阳降。攻舞阴，下之。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":301,"anchor":null},"note_id":null,"start":0,"end":48},{"id":"wudi-q-b-40d8b7057f4a29d6fe0d","section":"chapter-001","block":"b-40d8b7057f4a29d6fe0d","layer":"modern","quote":"〖3〗二年：建安二年（公元 197）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":305,"anchor":null},"note_id":"n-de6807349faf5c41a470","start":0,"end":19},{"id":"wudi-q-o050","section":"chapter-001","block":"b-c2d0fc350fb933237a70","layer":"original","quote":"二年春正月〖3〗，公到宛〖4〗。张绣降，既而悔之，复反。公与战，军败，为流矢所中。长子昂、弟子安民遇害〖5〗。﹝一﹞公乃引兵还舞阴〖6〗，绣将骑来抄〖7〗。公击破之，绣奔穰〖8〗，与刘表合。公谓诸将曰：“吾降张绣等，失不便取其质〖9〗，以至于此。吾知所以败。诸卿观之：自今以后，不复败矣！”遂还许。﹝二﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":298,"anchor":null},"note_id":null,"start":0,"end":152},{"id":"wudi-q-o053","section":"chapter-001","block":"b-52bec363594071a2bd97","layer":"original","quote":"冬十一月，公自南征，至宛。﹝三﹞表将邓济，据湖阳〖16〗。攻拔之，生擒济，湖阳降。攻舞阴，下之。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":301,"anchor":null},"note_id":null,"start":0,"end":48}],"profiles":{},"directory_counts":{}}
