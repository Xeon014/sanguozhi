{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"chengguo-e-p105","title":"孙盛评济辞邑不负心","accounts":[{"id":"chengguo-a-affd5e5f455afc2beca2","label":"裴注·孙盛曰","text":"孙盛评济辞邑不负心","evidence":["chengguo-q-b1193d5cbee1684761a6"]}],"participants":[{"person":"shaodi-p0086","role":"评蒋济之辞邑可谓不负心矣、语曰不为利回不为义疚、蒋济其有焉","evidence":["chengguo-q-b1193d5cbee1684761a6"]},{"person":"shaodi-p0009","role":"被评者","evidence":["chengguo-q-b1193d5cbee1684761a6"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["chengguo-q-b1193d5cbee1684761a6"]},"ordering_evidence":"chengguo-q-b1193d5cbee1684761a6","source_order":[14,472,8],"order":3177},{"id":"huanchen-e-p183","title":"孙盛驳崇饰宫室萧何之过议","accounts":[{"id":"huanchen-a-64056805b3468d775c63","label":"裴注·孙盛曰","text":"孙盛驳崇饰宫室萧何之过议","evidence":["huanchen-q-edb262b43e405b7ac91e"]}],"participants":[{"person":"shaodi-p0086","role":"曰汉承周秦之弊宜敦简约之化而何崇饰宫室示侈后嗣、魏氏方有吴蜀之难而述萧何之过议以为令轨、岂不惑于大道而昧得失之辨哉","evidence":["huanchen-q-edb262b43e405b7ac91e"]},{"person":"wudi-p0394","role":"其述萧何之议被驳者","evidence":["huanchen-q-edb262b43e405b7ac91e"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["huanchen-q-edb262b43e405b7ac91e"]},"ordering_evidence":"huanchen-q-edb262b43e405b7ac91e","source_order":[22,202,18],"order":4523},{"id":"erfei-e-o059","title":"孙盛参戎行见刘玄于成都","accounts":[{"id":"erfei-a-f3e3d47f93ddb9dab673","label":"裴注·蜀世谱","text":"孙盛参戎行见刘玄于成都","evidence":["erfei-q-2d3f6e4fa1246974784a"]}],"participants":[{"person":"shaodi-p0086","role":"永和三年讨李势之役参戎行，于成都见刘玄","evidence":["erfei-q-2d3f6e4fa1246974784a"]},{"person":"erfei-p0002","role":"孙盛于成都所见之人","evidence":["erfei-q-2d3f6e4fa1246974784a"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["erfei-q-2d3f6e4fa1246974784a"]},"ordering_evidence":"erfei-q-2d3f6e4fa