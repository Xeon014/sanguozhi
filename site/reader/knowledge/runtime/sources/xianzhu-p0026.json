{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-o015b","title":"刘备与董承等谋诛曹操","accounts":[{"id":"xianzhu-e-o015b-account","label":"《先主传》正文","text":"董承声称受衣带密诏诛曹操，刘备与董承、种辑、吴子兰、王子服同谋，因被遣出而尚未发动。","evidence":["xianzhu-e-o015b-q"]},{"id":"xianzhu-a-p015-qiju","label":"《献帝起居注》","text":"《献帝起居注》记董承与王子服议谋，称种辑、吴硕为腹心；此处吴硕与正文吴子兰的差异不强作同一人。","evidence":["xianzhu-q-p015-qiju"]}],"participants":[{"person":"liu-bei","role":"同谋","evidence":["xianzhu-e-o015b-q"]},{"person":"wudi-p0113","role":"组织谋议","evidence":["xianzhu-e-o015b-q"]},{"person":"xianzhu-p0024","role":"同谋","evidence":["xianzhu-e-o015b-q"]},{"person":"xianzhu-p0025","role":"同谋","evidence":["xianzhu-e-o015b-q"]},{"person":"xianzhu-p0026","role":"同谋","evidence":["xianzhu-e-o015b-q"]},{"person":"xianzhu-p0029","role":"据《献帝起居注》同谋","evidence":["xianzhu-q-p015-qiju"]}],"place":null,"time":{"year":199,"label":"刘备受遣出许前","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xianzhu-y199","dating_review":{"reviewed":true,"anchor":"xianzhu-q-o014","basis":"刘备受遣出许前"},"evidence":["xianzhu-e-o015b-q","xianzhu-q-o014","wudi-q-o061","wudi-q-b-51bced16741add42ff70"]},"source_order":[32,71,"O015b"],"order":6520}],"persons":[{"id":"xianzhu-p0026","name":"王子服","evidence":["xianzhu-q-o015"],"facts":[],"aliases":[],"mentions":[{"id":"xianzhu-m-o015-xianzhu-p0026","kind":"mention","text":"文中提及","evidence":["xianzhu-q-o015"]},{"id":"xianzhu-m-p015-xianzhu-p0026","kind":"mention","text":"文中提及","evidence":["xianzhu-q-p015"]}]}],"evidence":[{"id":"wudi-q-b-51bced16741add42ff70","section":"chapter-001","block":"b-51bced16741add42ff70","layer":"modern","quote":"〖1〗四年：建安四年（公元 199）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":369,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-20628d34a709162c77f0","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o061","section":"chapter-001","block":"b-502d4e8c0ed143eaa30d","layer":"original","quote":"四年春二月〖1〗，公还至昌邑〖2〗。张杨将杨丑杀杨〖3〗。眭固又杀丑，以其众属袁绍，屯射犬〖4〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":358,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":49,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o015b-q","section":"chapter-032","block":"b-98e30108a13f2ee6046a","layer":"original","quote":"先主未出时，献帝舅车骑将军董承，﹝一﹞辞受帝衣带中密诏〖1〗，当诛曹公。先主未发。是时，曹公从容谓先主曰〖2〗：“今天下英雄，唯使君与操耳！本初之徒〖3〗，不足数也〖4〗。”先主方食，失匕箸〖5〗。﹝二﹞遂与承及长水校尉种辑、将军吴子兰、王子服等同谋。会见使〖6〗，未发。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":70,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":136,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o014","section":"chapter-032","block":"b-9236c229b2cd9315f1e3","layer":"original","quote":"袁术欲经徐州北就袁绍，曹公遣先主督朱灵、路招要击术〖4〗。未至，术病死。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":60,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":36,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o015","section":"chapter-032","block":"b-98e30108a13f2ee6046a","layer":"original","quote":"先主未出时，献帝舅车骑将军董承，﹝一﹞辞受帝衣带中密诏〖1〗，当诛曹公。先主未发。是时，曹公从容谓先主曰〖2〗：“今天下英雄，唯使君与操耳！本初之徒〖3〗，不足数也〖4〗。”先主方食，失匕箸〖5〗。﹝二﹞遂与承及长水校尉种辑、将军吴子兰、王子服等同谋。会见使〖6〗，未发。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":70,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":136,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-p015","section":"chapter-032","block":"b-0d8e9f21bdf4f1bf3c89","layer":"pei","quote":"﹝三﹞《献帝起居注》曰：“承等与备谋，未发，而备出。承谓服曰：‘郭多有数百兵，坏李傕数万人；但足下与我同不耳？昔吕不韦之门，须子楚而后高；今吾与子由是也。’服曰：‘惶惧，不敢当；且兵又少。’承曰：‘举事讫，得曹公成兵，顾不足邪？’服曰：‘今京师岂有所任乎？’承曰：‘长水校尉种辑、议郎吴硕，是我腹心办事者。’遂定计。”","attribution":"《献帝起居注》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":87,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-76002ddfdc53c4d46244","start":0,"end":159,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-p015-qiju","section":"chapter-032","block":"b-0d8e9f21bdf4f1bf3c89","layer":"pei","quote":"﹝三﹞《献帝起居注》曰：“承等与备谋，未发，而备出。承谓服曰：‘郭多有数百兵，坏李傕数万人；但足下与我同不耳？昔吕不韦之门，须子楚而后高；今吾与子由是也。’服曰：‘惶惧，不敢当；且兵又少。’承曰：‘举事讫，得曹公成兵，顾不足邪？’服曰：‘今京师岂有所任乎？’承曰：‘长水校尉种辑、议郎吴硕，是我腹心办事者。’遂定计。”","attribution":"《献帝起居注》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":87,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-76002ddfdc53c4d46244","start":0,"end":159,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
