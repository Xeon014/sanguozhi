-o070","wendi-q-p106","zhouyu-q-o006","sunshi-q-o026","wuzhu-q-o003","dongyuan-q-o078","chengguo-q-eca0047c7227697f8508","chengguo-q-94ee46471f15eae2dadc","chengguo-q-d25a04f411a9989d3ac9","chengguo-q-52b8dcc64bb588ccf6d3","chenghuang-q-5e912039169623726e29","chenghuang-q-a1970ba8acfd65577e93","chenghuang-q-35e7e91bd8a5e739159c","cuimao-q-d0bc48dfc1428371f783","cuimao-q-bb998b9186119faf818b","cuimao-q-f72abd9813563d62df2c","cuimao-q-2d4a48d3774996402b17","cuimao-q-e1b7b0248849ac3c50cd","cuimao-q2-76a701e10b017f643ca9","liusima-q-6fb9697750ed0231d0e9","rensu-q-6117ad6b2aca9a885e8f","rensu-q-bfe244ee631b8ea9357d","zongshi-q-11c86715125785962926","zongshi-q-3a88a976131224511612"],"facts":[{"id":"cuimao-f2-8e37e1191076a6aceacb","text":"《魏略》记刘勋字子台，琅邪人，中平末为沛国建平长，后封列侯；其兄任豫州刺史，病亡，兄子威代从政。","evidence":["cuimao-q2-76a701e10b017f643ca9"]}],"aliases":[],"mentions":[{"id":"wudi-m-o070-wudi-p0168","kind":"mention","text":"文中提及","evidence":["wudi-q-o070"]},{"id":"wudi-m-p112-wudi-p0168","kind":"mention","text":"文中提及","evidence":["wudi-q-p112"]},{"id":"wendi-m-p106-wudi-p0168","kind":"mention","text":"文中提及","evidence":["wendi-q-p106"]},{"id":"zhouyu-m-o006-wudi-p0168","kind":"mention","text":"文中提及","evidence":["zhouyu-q-o006"]},{"id":"sunshi-m-o026-wudi-p0168","kind":"mention","text":"文中提及","evidence":["sunshi-q-o026"]},{"id":"sunshi-m-o032-wudi-p0168","kind":"mention","text":"文中提及","evidence":["sunshi-q-o032"]},{"id":"sunshi-m-p046-wudi-p0168","kind":"mention","text":"文中提及","evidence":["sunshi-q-p046"]},{"id":"wuzhu-m-o003-wudi-p0168","kind":"mention","text":"文中提及","evidence":["wuzhu-q-o003"]},{"id":"dongyuan-m-o078-wudi-p0168","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o078"]}]}],"evidence":[{"id":"chengguo-q-52b8dcc64bb588ccf6d3","section":"chapter-014","block":"b-916d1a005b14c2bdce88","layer":"original","quote":"晔睹汉室渐微，己为支属，不欲拥兵；遂委其部曲与庐江太守刘勋。勋怪其故，晔曰：“宝无法制，其众素以抄略为利。仆宿无资〖11〗，而整齐之〖12〗，必怀怨难久，故相与耳","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":270,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":81,"offset_unit":"unicode_code_point"},{"id":"chengguo-q-94ee46471f15eae2dadc","section":"chapter-014","block":"b-cf3355075398e837cf7c","layer":"original","quote":"勋信之，又得策珠宝、葛越〖16〗，喜悦。外内尽贺，而晔独否，勋问其故。对曰：“上缭虽小，城坚池深，攻难守易，不可旬日而举〖17〗；则兵疲于外，而国内虚。策乘虚而袭我，则后不能独守。是将军进屈于敌，退无所归。若军必出〖18〗，祸今至矣","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":271,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":94,"end":210,"offset_unit":"unicode_code_point"},{"id":"chengguo-q-d25a04f411a9989d3ac9","section":"chapter-014","block":"b-cf3355075398e837cf7c","layer":"original","quote":"勋不从，兴兵伐上缭。策果袭其后；勋穷蹙〖19〗，遂奔太祖","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":271,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":212,"end":240,"offset_unit":"unicode_code_point"},{"id":"chengguo-q-eca0047c7227697f8508","section":"chapter-014","block":"b-cf3355075398e837cf7c","layer":"original","quote":"时勋兵，强于江、淮之间。孙策恶之。遣使卑辞厚币，以书说勋曰：“上缭宗民〖13〗，数欺下国〖14〗，忿之有年矣。击之，路不便；愿因大国，伐之〖15〗。上缭甚实，得之可以富国。请出兵为外援。”","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":271,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":94,"offset_unit":"unicode_code_point"},{"id":"chenghuang-q-35e7e91bd8a5e739159c","section":"chapter-055","block":"b-8923fb1e9c459ccd4355","layer":"original","quote":"策破刘勋，多得庐江人；料其精锐〖3〗，乃以武为督：所向无前","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":126,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":56,"end":85,"offset_unit":"unicode_code_point"},{"id":"chenghuang-q-5e912039169623726e29","section":"chapter-055","block":"b-5ecb4d52b1b6c18777c8","layer":"original","quote":"后拜荡寇中郎将〖6〗，领零陵太守。从讨刘勋于寻阳，进攻黄祖于沙羡，还镇石城","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":2,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":164,"end":201,"offset_unit":"unicode_code_point"},{"id":"chenghuang-q-a1970ba8acfd65577e93","section":"chapter-055","block":"b-ac3d85213e7994859abe","layer":"original","quote":"从征刘勋，破黄祖；还讨鄱阳，领乐安长，山越畏服","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":54,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":30,"end":53,"offset_unit":"unicode_code_point"},{"id":"cuimao-q-2d4a48d3774996402b17","section":"chapter-012","block":"b-2badfeb40d4b5cdbfbba","layer":"pei","quote":"勋自恃与太祖有宿，日骄慢，数犯法，又诽谤","attribution":"裴注·《魏略》","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":355,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f74a969f7a7c1e39cded","start":86,"end":106,"offset_unit":"unicode_code_point"},{"id":"cuimao-q-bb998b9186119faf818b","section":"chapter-012","block":"b-810acc97b4dae77e02db","layer":"original","quote":"后勋以不轨诛，交关者皆获罪，而芝以见称","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":333,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":61,"end":80,"offset_unit":"unicode_code_point"},{"id":"cuimao-q-d0bc48dfc1428371f783","section":"chapter-012","block":"b-810acc97b4dae77e02db","layer":"original","quote":"宾客子弟在界，数犯法。勋与芝书，不著姓名，而多所属托；芝不报其书，一皆如法","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":333,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":23,"end":60,"offset_unit":"unicode_code_point"},{"id":"cuimao-q-e1b7b0248849ac3c50cd","section":"chapter-012","block":"b-2badfeb40d4b5cdbfbba","layer":"pei","quote":"为李申成所白，收治；并免威官","attribution":"裴注·《魏略》","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":355,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f74a969f7a7c1e39cded","start":107,"end":121,"offset_unit":"unicode_code_point"},{"id":"cuimao-q-f72abd9813563d62df2c","section":"chapter-012","block":"b-2badfeb40d4b5cdbfbba","layer":"pei","quote":"后为庐江太守，为孙策所破，自归太祖","attribution":"裴注·《魏略》","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":355,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f74a969f7a7c1e39cded","start":36,"end":53,"offset_unit":"unicode_code_point"},{"id":"cuimao-q2-76a701e10b017f643ca9","section":"chapter-012","block":"b-2badfeb40d4b5cdbfbba","layer":"pei","quote":"﹝一﹞《魏略》曰：“勋字子台，琅邪人。中平末，为沛国建平长，与太祖有旧。后为庐江太守，为孙策所破，自归太祖；封列侯，遂从在散伍议中。勋兄为豫州刺史，病亡。兄子威，又代从政。勋自恃与太祖有宿，日骄慢，数犯法，又诽谤。为李申成所白，收治；并免威官。”","attribution":"裴注（引书见原文）","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":355,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f74a969f7a7c1e39cded","start":0,"end":123,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-o078a-q","section":"chapter-006","block":"b-ee550b31094c2ed0da95","layer":"original","quote":"妻子依术故吏庐江太守刘勋。孙策破勋，复见收视〖15〗。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":427,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":27,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o078","section":"chapter-006","block":"b-ee550b31094c2ed0da95","layer":"original","quote":"妻子依术故吏庐江太守刘勋。孙策破勋，复见收视〖15〗。术女入孙权宫，子燿拜郎中；燿女又配于权子奋。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":427,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":49,"offset_unit":"unicode_code_point"},{"id":"liusima-q-6fb9697750ed0231d0e9","section":"chapter-015","block":"b-917aeff0af2d8ac16c44","layer":"pei","quote":"沛辞去，未到邺；而军中豪右曹洪、刘勋等畏沛名，遣家驰骑告子弟，使各自检敕","attribution":"裴注·魏略列传","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":301,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-aaaf08e9bea919e96c3f","start":326,"end":362,"offset_unit":"unicode_code_point"},{"id":"liusima-q-c27076749c9dd3cc9d53","section":"chapter-015","block":"b-917aeff0af2d8ac16c44","layer":"pei","quote":"输作未竟，会太祖出征，在谯；闻邺下颇不奉科禁，乃发教选邺令：‘当得严能如杨沛比。’故沛从徒中起为邺令","attribution":"裴注·魏略列传","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":301,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-aaaf08e9bea919e96c3f","start":194,"end":244,"offset_unit":"unicode_code_point"},{"id":"liusima-q-cd5a6ef9a980db9145a2","section":"chapter-015","block":"b-917aeff0af2d8ac16c44","layer":"pei","quote":"已拜，太祖见之，问曰：‘以何治邺？’沛曰：‘竭尽心力，奉宣科法。’太祖曰：‘善！’顾谓坐席曰：‘诸君，此可畏也！’赐其生口十人，绢百匹，既欲以励之，且以报干椹也","attribution":"裴注·魏略列传","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":301,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-aaaf08e9bea919e96c3f","start":245,"end":325,"offset_unit":"unicode_code_point"},{"id":"rensu-q-6117ad6b2aca9a885e8f","section":"chapter-016","block":"b-c43dfaf211c631acc9e8","layer":"pei","quote":"平虏将军刘勋，为太祖所亲，贵震朝廷。尝从畿求大枣，畿拒以他故","attribution":"裴注·杜氏新书","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":129,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5eb8e6e07121864099a3","start":12,"end":42,"offset_unit":"unicode_code_point"},{"id":"rensu-q-676a1ed677a2d724ae63","section":"chapter-016","block":"b-c43dfaf211c631acc9e8","layer":"pei","quote":"称畿功美，以下州郡；曰：‘昔仲尼之于颜子，每言不能不叹；既情爱发中，又宜率马以骥。今吾亦冀众人仰高山、慕景行也","attribution":"裴注·杜氏新书","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":129,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5eb8e6e07121864099a3","start":72,"end":127,"offset_unit":"unicode_code_point"},{"id":"rensu-q-bfe244ee631b8ea9357d","section":"chapter-016","block":"b-c43dfaf211c631acc9e8","layer":"pei","quote":"后勋伏法，太祖得其书，叹曰：‘杜畿可谓“不媚于灶”者也","attribution":"裴注·杜氏新书","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":129,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5eb8e6e07121864099a3","start":43,"end":70,"offset_unit":"unicode_code_point"},{"id":"sunshi-e-o026c-q","section":"chapter-046","block":"b-b7d697cd1a21ff6c147e","layer":"original","quote":"策攻康，拔之；术复用其故吏刘勋为太守〖19〗，策益失望。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":178,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":121,"end":149,"offset_unit":"unicode_code_point"},{"id":"sunshi-e-o032c-q","section":"chapter-046","block":"b-5201386903331e2f3688","layer":"original","quote":"后术死，长史杨弘、大将张勋等，将其众欲就策；庐江太守刘勋要击〖21〗，悉虏之，收其珍宝以归。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":216,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":43,"end":89,"offset_unit":"unicode_code_point"},{"id":"sunshi-e-o032d-q","section":"chapter-046","block":"b-5201386903331e2f3688","layer":"original","quote":"策闻之，伪与勋好盟〖22〗。勋新得术众，时豫章上缭宗民万余家在江东〖23〗，策劝勋攻取之。勋既行，","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":216,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":89,"end":138,"offset_unit":"unicode_code_point"},{"id":"sunshi-e-o032f-q","section":"chapter-046","block":"b-5201386903331e2f3688","layer":"original","quote":"勋独与麾下数百人，自归曹公。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":216,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":157,"end":171,"offset_unit":"unicode_code_point"},{"id":"sunshi-e-p046b-q","section":"chapter-046","block":"b-0df888008b92c8896d19","layer":"pei","quote":"术从弟胤、女婿黄猗等，畏惧曹公，不敢守寿春；乃共舁术棺柩，扶其妻子及部曲男女，就刘勋于皖城。","attribution":"《江表传》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":257,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-344fcece1d1f127d763a","start":53,"end":99,"offset_unit":"unicode_code_point"},{"id":"sunshi-e-p046c-q","section":"chapter-046","block":"b-0df888008b92c8896d19","layer":"pei","quote":"勋粮食少，无以相赈；乃遣从弟偕，告籴于豫章太守华歆。歆郡素少谷，遣吏将偕，就海昏、上缭，使诸宗帅共出三万斛米以与偕。偕往历月，才得数千斛。偕乃报勋，具说形状，使勋来袭取之。勋得偕书，使潜军到海昏邑下。宗帅知之，空壁逃匿，勋了无所得。","attribution":"《江表传》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":257,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-344fcece1d1f127d763a","start":99,"end":215,"offset_unit":"unicode_code_point"},{"id":"sunshi-e-p046f-q","section":"chapter-046","block":"b-0df888008b92c8896d19","layer":"pei","quote":"贲、辅又于彭泽破勋。勋走入楚江，从寻阳步上到置马亭；闻策等已克皖，乃投西塞。至沂，筑垒自守；告急于刘表，求救于黄祖。祖遣太子射、船军五千人，助勋。","attribution":"《江表传》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":257,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-344fcece1d1f127d763a","start":325,"end":398,"offset_unit":"unicode_code_point"},{"id":"sunshi-e-p046g-q","section":"chapter-046","block":"b-0df888008b92c8896d19","layer":"pei","quote":"策复就攻，大破勋。","attribution":"《江表传》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":257,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-344fcece1d1f127d763a","start":398,"end":407,"offset_unit":"unicode_code_point"},{"id":"sunshi-e-p046i-q","section":"chapter-046","block":"b-0df888008b92c8896d19","layer":"pei","quote":"勋与偕，北归曹公，","attribution":"《江表传》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":257,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-344fcece1d1f127d763a","start":407,"end":416,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-o026","section":"chapter-046","block":"b-b7d697cd1a21ff6c147e","layer":"original","quote":"术初许策为九江太守〖15〗，已而更用丹杨陈纪〖16〗。后术欲攻徐州，从庐江太守陆康求米三万斛〖17〗；康不与，术大怒。策昔曾诣康，康不见；使主簿接之，策尝衔恨。术遣策攻康，谓曰：“前错用陈纪，每恨本意不遂。今若得康，庐江，真卿有也〖18〗！”策攻康，拔之；术复用其故吏刘勋为太守〖19〗，策益失望。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":178,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":149,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-o032","section":"chapter-046","block":"b-5201386903331e2f3688","layer":"original","quote":"时袁术僭号〖19〗，策以书责而绝之。﹝六﹞曹公表策为讨逆将军〖20〗，封为吴侯。﹝七﹞后术死，长史杨弘、大将张勋等，将其众欲就策；庐江太守刘勋要击〖21〗，悉虏之，收其珍宝以归。策闻之，伪与勋好盟〖22〗。勋新得术众，时豫章上缭宗民万余家在江东〖23〗，策劝勋攻取之。勋既行，策轻军晨夜袭拔庐江〖24〗，勋众尽降；勋独与麾下数百人，自归曹公。﹝八﹞","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":216,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":174,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-p046","section":"chapter-046","block":"b-0df888008b92c8896d19","layer":"pei","quote":"﹝八﹞《江表传》曰：“策被诏敕，与司空曹公、卫将军董承、益州牧刘璋等，并力讨袁术、刘表。军严当进，会术死。术从弟胤、女婿黄猗等，畏惧曹公，不敢守寿春；乃共舁术棺柩，扶其妻子及部曲男女，就刘勋于皖城。勋粮食少，无以相赈；乃遣从弟偕，告籴于豫章太守华歆。歆郡素少谷，遣吏将偕，就海昏、上缭，使诸宗帅共出三万斛米以与偕。偕往历月，才得数千斛。偕乃报勋，具说形状，使勋来袭取之。勋得偕书，使潜军到海昏邑下。宗帅知之，空壁逃匿，勋了无所得。时策西讨黄祖，行及石城。闻勋轻身诣海昏，便分遣从兄贲、辅，率八千人，于彭泽待勋；自与周瑜率二万人，步袭皖城，即克之，得术百工及鼓吹部曲三万余人，并术、勋妻子。表用汝南李术为庐江太守，给兵三千人以守皖；皆徙所得人，东诣吴。贲、辅又于彭泽破勋。勋走入楚江，从寻阳步上到置马亭；闻策等已克皖，乃投西塞。至沂，筑垒自守；告急于刘表，求救于黄祖。祖遣太子射、船军五千人，助勋。策复就攻，大破勋。勋与偕，北归曹公，射亦遁走。策收得勋兵二千余人，船千艘；遂前进夏口，攻黄祖。时刘表遣从子虎、南阳韩晞，将长矛五千，来为黄祖前锋。策与战，大破之。”","attribution":"《江表传》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":257,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-344fcece1d1f127d763a","start":0,"end":480,"offset_unit":"unicode_code_point"},{"id":"wendi-e-p106h-q","section":"chapter-002","block":"b-6eb68753e8e520d9914c","layer":"pei","quote":"尝与平虏将军刘勋、奋威将军邓展等共饮。宿闻展善有手臂，晓五兵，又称其能空手入白刃。余与论剑良久，谓言：‘将军法非也！余顾尝好之，又得善术。’因求与余对。时酒酣耳热，方食甘蔗，便以为杖；下殿数交，三中其臂，左右大笑。展意不平，求更为之。余言：‘吾法急属，难相中面，故齐臂耳！’展言‘愿复一交’。余知其欲突以取交中也，因伪深进；展果寻前，余却脚鄛，正截其颡，坐中惊视。余还坐，笑曰：‘昔阳庆使淳于意去其故方，更授以秘术。今余亦愿邓将军捐弃故伎，更受要道也！’一坐尽欢。","attribution":"裴注·典论自叙","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":521,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-2aa5d4559ce229d0d61c","start":695,"end":927,"offset_unit":"unicode_code_point"},{"id":"wendi-q-p106","section":"chapter-002","block":"b-6eb68753e8e520d9914c","layer":"pei","quote":"﹝一﹞《典论》帝《自叙》曰：“初平之元，董卓杀主鸩后，荡覆王室。是时四海既困中平之政，兼恶卓之凶逆；家家思乱，人人自危。山东牧守，咸以《春秋》之义，‘卫人讨州吁于濮’，言人人皆得讨贼。于是大兴义兵，名豪大侠，富室强族；飘扬云会，万里相赴。兖、豫之师战于荥阳，河内之甲军于孟津。卓遂迁大驾，西都长安。而山东大者连郡国，中者婴城邑，小者聚阡陌，以还相吞灭。会黄巾盛于海岱，山寇暴于并、冀；乘胜转攻，席卷而南，乡邑望烟而奔，城郭睹尘而溃；百姓死亡，暴骨如莽。余时年五岁，上以世方扰乱，教余学射，六岁而知射，又教余骑马；八岁而能骑射矣。以时之多（故）〔难〕，每征〔伐〕，余〔乘马〕常从。建安初，上南征荆州，至宛，张绣降，旬日而反；亡兄孝廉子修、从兄安民遇害。时余年十一岁，乘马得脱。夫文武之道，各随时而用；生于中平之季，长于戎旅之间；是以少好弓马，于今不衰；逐禽辄十里，驰射常百步；日多体健，心每不厌。建安十年，始定冀州；濊、貊贡良弓，燕、代献名马。时岁之暮春，勾芒司节，和风扇物；弓燥手柔，草浅兽肥。与族兄子丹，猎于邺西，终日手获獐鹿九，雉兔三十。后军南征次曲蠡，尚书令荀彧奉使犒军。见余，谈论之末，彧言：‘闻君善左右射，此实难能。’余言：‘执事未睹夫项发口纵，俯马蹄而仰月支也。’彧喜笑曰：‘乃尔！’余曰：‘埒有常径，的有常所；虽每发辄中，非至妙也！若驰平原，赴丰草，要狡兽，截轻禽；使弓不虚弯，所中必洞，斯则妙矣！’时军祭酒张京在坐，顾彧拊手曰：“善！”余又学击剑，阅师多矣；四方之法各异，唯京师为善。桓、灵之间，有虎贲王越，善斯术，称于京师。河南史阿，言昔与越游，具得其法；余从阿学之精熟。尝与平虏将军刘勋、奋威将军邓展等共饮。宿闻展善有手臂，晓五兵，又称其能空手入白刃。余与论剑良久，谓言：‘将军法非也！余顾尝好之，又得善术。’因求与余对。时酒酣耳热，方食甘蔗，便以为杖；下殿数交，三中其臂，左右大笑。展意不平，求更为之。余言：‘吾法急属，难相中面，故齐臂耳！’展言‘愿复一交’。余知其欲突以取交中也，因伪深进；展果寻前，余却脚鄛，正截其颡，坐中惊视。余还坐，笑曰：‘昔阳庆使淳于意去其故方，更授以秘术。今余亦愿邓将军捐弃故伎，更受要道也！’一坐尽欢。夫事不可自谓己长。余少晓持复，自谓无对；俗名双戟为‘坐铁室’，镶盾为‘蔽木户’。后从陈国袁敏学，以单攻复，每为若神，对家不知所出。先日若逢敏于狭路，直决耳！余于他戏弄之事少所喜，唯弹棋略尽其巧，少为之赋。昔京师先工有马合乡侯、东方安世、张公子，常恨不得与彼数子者对。上雅好诗书文籍，虽在军旅，手不释卷。每每定省从容，常言：‘人少好学则思专，长则善忘；长大而能勤学者，唯吾与袁伯业耳！’余是以少诵诗、论，及长而备历五经、四部，《史》、《汉》、诸子百家之言，靡不毕览。”","attribution":"裴注·典论自叙","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":521,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-2aa5d4559ce229d0d61c","start":0,"end":1160,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o070a-q","section":"chapter-001","block":"b-3c2a3ed742a2f965ebdc","layer":"original","quote":"庐江太守刘勋率众降〖27〗，封为列侯。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":367,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wudi-e-p112a-q","section":"chapter-001","block":"b-9536581b8deb5e7104e4","layer":"pei","quote":"《魏书》载：“公令曰：‘夫受九锡，广开土宇，周公其人也。汉之异姓八王者，与高祖俱起布衣，创定王业，其功至大。吾何可比之？’前后三让。于是中军师、陵树亭侯荀攸，前军师、东武亭侯钟繇，左军师凉茂，右军师毛玠，平虏将军、华乡侯刘勋，建武将军、清苑亭侯刘若，伏波将军、高安侯夏侯惇，扬武将军、都亭侯王忠，奋威将军、乐乡侯（刘）〔邓〕展，建忠将军、昌乡亭侯鲜于辅，奋武将军、安国亭侯程昱，太中大夫、都乡侯贾诩，军师祭酒、千秋亭侯董昭，都亭侯薛洪，南乡亭侯董蒙，关内侯王粲、傅巽，祭酒王选、袁涣、王朗、张承、任藩、杜袭，中护军、国明亭侯曹洪，中领军、万岁亭侯韩浩，行骁骑将军、安平亭侯曹仁，领护军将军王图，长史万潜、谢奂、袁霸等，劝进曰：‘自古三代，胙臣以土；受命中兴，封秩辅佐。皆所以褒功赏德，为国藩卫也。往者天下崩乱，群凶豪起；颠越跋扈之险，不可忍言。明公奋身出命以徇其难，诛二袁篡盗之逆，灭黄巾贼乱之类，殄夷首逆，芟拨荒秽，沐浴霜露二十余年。书契以来，未有若此功者。昔周公承文、武之迹，受已成之业，高枕墨笔，拱揖群后，商、奄之勤，不过二年；吕望因三分有二之形，据八百诸侯之势，暂把旄钺，一时指麾：然皆大启土宇，跨州兼国。周公八子，并为侯伯：白牡骍刚，郊祀天地；典策备物，拟则王室。荣章宠盛如此之弘也。逮至汉兴，佐命之臣张耳、吴芮，其功至薄，亦连城开地，南面称孤。此皆明君达主行之于上，贤臣圣宰受之于下；三代令典，汉帝明制。今比劳则周、吕逸，计功则张、吴微，论制则齐、鲁重，言地则长沙多；然则魏国之封，九锡之荣，况于旧赏，犹怀玉而被褐也。且列侯、诸将，幸攀龙骥，得窃微劳，佩紫怀黄，盖以百数，亦将因此传之万世。而明公独辞赏于上，将使其下怀不自安。上违圣朝欢心，下失冠带至望；忘辅弼之大业，信匹夫之细行。攸等所大惧也！’于是公敕外为章，但受魏郡。攸等复曰：‘伏见魏国初封，圣朝发虑，稽谋群僚，然后策命；而明公久违上指，不即大礼。今既虔奉诏命，副顺众望；又欲辞多当少，让九受一。是犹汉朝之赏不行，而攸等之请未许也。昔齐、鲁之封，奄有东海；疆域井赋，四百万家；基隆业广，易以立功；故能成翼戴之勋，立一匡之绩。今魏国虽有十郡之名，犹减于曲阜；计其户数，不能参半：以藩卫王室，立垣树屏，犹未足也。且圣上览亡秦无辅之祸，惩曩日震荡之艰；托建忠贤，废坠是为。愿明公恭承帝命，无或拒违。’公乃受命。”","attribution":"《魏书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":262,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-97e94061646080072adf","start":0,"end":988,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-51bced16741add42ff70","section":"chapter-001","block":"b-51bced16741add42ff70","layer":"modern","quote":"〖1〗四年：建安四年（公元 199）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":369,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-20628d34a709162c77f0","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-b9d79988a2b2559f2bb5","section":"chapter-001","block":"b-b9d79988a2b2559f2bb5","layer":"modern","quote":"〖11〗十八年：建安十八年（公元 213）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":137,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-bec99dfe67d67ae54b06","start":0,"end":22,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o061","section":"chapter-001","block":"b-502d4e8c0ed143eaa30d","layer":"original","quote":"四年春二月〖1〗，公还至昌邑〖2〗。张杨将杨丑杀杨〖3〗。眭固又杀丑，以其众属袁绍，屯射犬〖4〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":358,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":49,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o070","section":"chapter-001","block":"b-3c2a3ed742a2f965ebdc","layer":"original","quote":"庐江太守刘勋率众降〖27〗，封为列侯。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":367,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o139","section":"chapter-001","block":"b-d44820525c4645832365","layer":"original","quote":"十八年春正月〖11〗，进军濡须口〖12〗；攻破权江西营，获权都督公孙阳〖13〗，乃引军还。诏书并十四州〖14〗，复为九州〖15〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":107,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":65,"offset_unit":"unicode_code_point"},{"id":"wudi-q-p112","section":"chapter-001","block":"b-9536581b8deb5e7104e4","layer":"pei","quote":"《魏书》载：“公令曰：‘夫受九锡，广开土宇，周公其人也。汉之异姓八王者，与高祖俱起布衣，创定王业，其功至大。吾何可比之？’前后三让。于是中军师、陵树亭侯荀攸，前军师、东武亭侯钟繇，左军师凉茂，右军师毛玠，平虏将军、华乡侯刘勋，建武将军、清苑亭侯刘若，伏波将军、高安侯夏侯惇，扬武将军、都亭侯王忠，奋威将军、乐乡侯（刘）〔邓〕展，建忠将军、昌乡亭侯鲜于辅，奋武将军、安国亭侯程昱，太中大夫、都乡侯贾诩，军师祭酒、千秋亭侯董昭，都亭侯薛洪，南乡亭侯董蒙，关内侯王粲、傅巽，祭酒王选、袁涣、王朗、张承、任藩、杜袭，中护军、国明亭侯曹洪，中领军、万岁亭侯韩浩，行骁骑将军、安平亭侯曹仁，领护军将军王图，长史万潜、谢奂、袁霸等，劝进曰：‘自古三代，胙臣以土；受命中兴，封秩辅佐。皆所以褒功赏德，为国藩卫也。往者天下崩乱，群凶豪起；颠越跋扈之险，不可忍言。明公奋身出命以徇其难，诛二袁篡盗之逆，灭黄巾贼乱之类，殄夷首逆，芟拨荒秽，沐浴霜露二十余年。书契以来，未有若此功者。昔周公承文、武之迹，受已成之业，高枕墨笔，拱揖群后，商、奄之勤，不过二年；吕望因三分有二之形，据八百诸侯之势，暂把旄钺，一时指麾：然皆大启土宇，跨州兼国。周公八子，并为侯伯：白牡骍刚，郊祀天地；典策备物，拟则王室。荣章宠盛如此之弘也。逮至汉兴，佐命之臣张耳、吴芮，其功至薄，亦连城开地，南面称孤。此皆明君达主行之于上，贤臣圣宰受之于下；三代令典，汉帝明制。今比劳则周、吕逸，计功则张、吴微，论制则齐、鲁重，言地则长沙多；然则魏国之封，九锡之荣，况于旧赏，犹怀玉而被褐也。且列侯、诸将，幸攀龙骥，得窃微劳，佩紫怀黄，盖以百数，亦将因此传之万世。而明公独辞赏于上，将使其下怀不自安。上违圣朝欢心，下失冠带至望；忘辅弼之大业，信匹夫之细行。攸等所大惧也！’于是公敕外为章，但受魏郡。攸等复曰：‘伏见魏国初封，圣朝发虑，稽谋群僚，然后策命；而明公久违上指，不即大礼。今既虔奉诏命，副顺众望；又欲辞多当少，让九受一。是犹汉朝之赏不行，而攸等之请未许也。昔齐、鲁之封，奄有东海；疆域井赋，四百万家；基隆业广，易以立功；故能成翼戴之勋，立一匡之绩。今魏国虽有十郡之名，犹减于曲阜；计其户数，不能参半：以藩卫王室，立垣树屏，犹未足也。且圣上览亡秦无辅之祸，惩曩日震荡之艰；托建忠贤，废坠是为。愿明公恭承帝命，无或拒违。’公乃受命。”","attribution":"《魏书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":262,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-97e94061646080072adf","start":0,"end":988,"offset_unit":"unicode_code_point"},{"id":"wuzhu-e-o003a-q","section":"chapter-047","block":"b-9dfc26d83bc6f0a49854","layer":"original","quote":"建安四年，从策征庐江太守刘勋。勋破，进讨黄祖于沙羡〖1〗。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":15,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":29,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o003","section":"chapter-047","block":"b-9dfc26d83bc6f0a49854","layer":"original","quote":"建安四年，从策征庐江太守刘勋。勋破，进讨黄祖于沙羡〖1〗。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":15,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":29,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o014","section":"chapter-032","block":"b-9236c229b2cd9315f1e3","layer":"original","quote":"袁术欲经徐州北就袁绍，曹公遣先主督朱灵、路招要击术〖4〗。未至，术病死。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":60,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":36,"offset_unit":"unicode_code_point"},{"id":"zhouyu-e-o006d-q","section":"chapter-054","block":"b-89c42951b7ba509f25e8","layer":"original","quote":"复进寻阳〖17〗，破刘勋。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":6,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":63,"end":76,"offset_unit":"unicode_code_point"},{"id":"zhouyu-q-o006","section":"chapter-054","block":"b-89c42951b7ba509f25e8","layer":"original","quote":"顷之，策欲取荆州，以瑜为中护军〖15〗，领江夏太守。从攻皖，拔之。时得桥公两女，皆国色也〖16〗：策自纳大桥，瑜纳小桥。﹝三﹞复进寻阳〖17〗，破刘勋。讨江夏，还定豫章、庐陵，留镇巴丘〖18〗。﹝四﹞","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":6,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":100,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-11c86715125785962926","section":"chapter-051","block":"b-c529af783399939485ea","layer":"original","quote":"时策已平吴、会二郡，贲与策征庐江太守刘勋、江夏太守黄祖","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":95,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":27,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-3a88a976131224511612","section":"chapter-051","block":"b-107b5b6395a4b3b6b579","layer":"original","quote":"策西袭庐江太守刘勋，辅随从；身先士卒，有功","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":135,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":77,"end":98,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
