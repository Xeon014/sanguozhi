50","chenghuang-q-c85552986488749ec4d1","chenghuang-q-8d1042266d0b2b8c1c83"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[{"id":"chenghuang-q-660ab67432747d550b50","section":"chapter-055","block":"b-63a2b1115b7f25b863e6","layer":"original","quote":"迁破贼校尉〖4〗。及权统军，从讨江夏。入夏口，先登，破其前锋；轻舟独进，中流矢死","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":266,"anchor":null},"note_id":null,"start":62,"end":102},{"id":"chenghuang-q-8d1042266d0b2b8c1c83","section":"chapter-055","block":"b-63a2b1115b7f25b863e6","layer":"original","quote":"孙策初兴，每从征伐，常冠军履锋〖1〗。守永平长〖2〗，平治山越，奸猾敛手〖3〗。迁破贼校尉〖4〗。","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":266,"anchor":null},"note_id":null,"start":22,"end":71},{"id":"chenghuang-q-c85552986488749ec4d1","section":"chapter-055","block":"b-49b0f5118da5406c8c09","layer":"pei","quote":"权讨祖，祖军败奔走；追兵急，宁以善射，将兵在后，射杀校尉凌操。祖既得免，军罢还营，待宁如初","attribution":"裴注·吴书","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":207,"anchor":null},"note_id":"n-4cdec240085a4d591c10","start":91,"end":136}],"profiles":{"chenghuang-p0002":{"fields":[],"directory":{"faction":"wu"}}},"directory_counts":{}}
