ce_order":[5,124,"O030a"],"order":1406}],"persons":[{"id":"houfei-p0035","name":"甄畅","evidence":["houfei-q-o025"],"facts":[],"aliases":[],"mentions":[{"id":"houfei-m-o025-houfei-p0035","kind":"mention","text":"文中提及","evidence":["houfei-q-o025"]},{"id":"houfei-m-o029-houfei-p0035","kind":"mention","text":"文中提及","evidence":["houfei-q-o029"]},{"id":"houfei-m-o030-houfei-p0035","kind":"mention","text":"文中提及","evidence":["houfei-q-o030"]}]}],"evidence":[{"id":"houfei-e-o025c-q","section":"chapter-005","block":"b-0744a279ae4c62a54e64","layer":"original","quote":"青龙二年春，追谥后兄俨曰安城乡穆侯。夏，吴贼寇扬州，以像为伏波将军〖12〗，持节，监诸将东征〖13〗。还，复为射声校尉〖14〗。三年薨〖15〗，追赠卫将军，改封魏昌县，谥曰贞侯。子畅嗣。又封畅弟温、4 、艳，皆为列侯。四年〖16〗，改逸、俨本封，皆曰魏昌侯，谥因故〖17〗。封俨世妇刘为东乡君〖18〗，又追封逸世妇张为安喜君。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":97,"anchor":null},"note_id":null,"start":0,"end":163},{"id":"houfei-e-o029a-q","section":"chapter-005","block":"b-3b14070b8464278ab27f","layer":"original","quote":"帝思念舅氏不已。畅尚幼，景初末，以畅为射声校尉，加散骑常侍。又特为起大第〖20〗，车驾亲自临之。又于其后园，为像母起观庙，名其里曰“渭阳里”〖21〗，以追思母氏也。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":122,"anchor":null},"note_id":null,"start":0,"end":82},{"id":"houfei-e-o030a-q","section":"chapter-005","block":"b-3246574a0401a9de5d60","layer":"original","quote":"嘉平三年正月，畅薨，追赠车骑将军，谥曰恭侯。子绍嗣。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":123,"anchor":null},"note_id":null,"start":0,"end":26},{"id":"houfei-q-b-e47ffea5cca5eab53d92","section":"chapter-005","block":"b-e47ffea5cca5eab53d92","layer":"modern","quote":"〖15〗三年：青龙三年（公元 235）。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":113,"anchor":null},"note_id":"n-4aa0b3373c71cedadeb9","start":0,"end":20},{"id":"houfei-q-o025","section":"chapter-005","block":"b-0744a279ae4c62a54e64","layer":"original","quote":"青龙二年春，追谥后兄俨曰安城乡穆侯。夏，吴贼寇扬州，以像为伏波将军〖12〗，持节，监诸将东征〖13〗。还，复为射声校尉〖14〗。三年薨〖15〗，追赠卫将军，改封魏昌县，谥曰贞侯。子畅嗣。又封畅弟温、4 、艳，皆为列侯。四年〖16〗，改逸、俨本封，皆曰魏昌侯，谥因故〖17〗。封俨世妇刘为东乡君〖18〗，又追封逸世妇张为安喜君。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":97,"anchor":null},"note_id":null,"start":0,"end":163},{"id":"houfei-q-o029","section":"chapter-005","block":"b-3b14070b8464278ab27f","layer":"original","quote":"帝思念舅氏不已。畅尚幼，景初末，以畅为射声校尉，加散骑常侍。又特为起大第〖20〗，车驾亲自临之。又于其后园，为像母起观庙，名其里曰“渭阳里”〖21〗，以追思母氏也。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":122,"anchor":null},"note_id":null,"start":0,"end":82},{"id":"houfei-q-o030","section":"chapter-005","block":"b-3246574a0401a9de5d60","layer":"original","quote":"嘉平三年正月，畅薨，追赠车骑将军，谥曰恭侯。子绍嗣。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":123,"anchor":null},"note_id":null,"start":0,"end":26},{"id":"shaodi-q-b-068bc9d40974f88b77f9","section":"chapter-004","block":"b-068bc9d40974f88b77f9","layer":"modern","quote":"〖1〗三年：嘉平三年（公元 251）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":214,"anchor":null},"note_id":"n-563b7a630850bbcc0541","start":0,"end":19},{"id":"shaodi-q-o048","section":"chapter-004","block":"b-214613f5a625f33a352f","layer":"original","quote":"三年春正月〖1〗，荆州刺史王基、新城太守（陈）〔州〕泰攻吴〖2〗。破之，降者数千口。二月，置南郡之夷陵县以居降附〖3〗。三月，以尚书令司马孚为司空〖4〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":206,"anchor":null},"note_id":null,"start":0,"end":77}],"profiles":{},"directory_counts":{}}
