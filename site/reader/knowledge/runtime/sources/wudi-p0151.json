{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o059a","title":"曹操收纳臧霸诸将并付以沿海","accounts":[{"id":"wudi-e-o059a-account","label":"正文","text":"吕布败后，曹操收纳曾从吕布的臧霸等人，将青徐沿海之地交其经营。","evidence":["wudi-e-o059a-q"]}],"participants":[{"person":"cao-cao","role":"收纳任用","evidence":["wudi-e-o059a-q"]},{"person":"wudi-p0147","role":"被任用","evidence":["wudi-e-o059a-q"]},{"person":"wudi-p0148","role":"被收纳","evidence":["wudi-e-o059a-q"]},{"person":"wudi-p0149","role":"被收纳","evidence":["wudi-e-o059a-q"]},{"person":"wudi-p0150","role":"被收纳","evidence":["wudi-e-o059a-q"]},{"person":"wudi-p0151","role":"被收纳","evidence":["wudi-e-o059a-q"]}],"place":{"text":"青州、徐州","evidence":["wudi-e-o059a-q"]},"time":{"label":"建安三年吕布败后","year":198,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o059a-q","wudi-q-o054","wudi-q-b-4269a9733b31c7ed1578"],"chronology":"wudi-y198","dating_review":{"anchor":"wudi-q-o054","basis":"建安三年吕布败后","reviewed":true}},"source_order":[1,340,"O059a"],"order":151},{"id":"wudi-e-o072b","title":"关羽投降与昌豨被破","accounts":[{"id":"wudi-e-o072b-account","label":"正文","text":"曹操攻下邳，关羽投降；再破为刘备叛的昌豨，回官渡，袁绍始终未出兵。","evidence":["wudi-e-o072b-q"]}],"participants":[{"person":"cao-cao","role":"进攻回军","evidence":["wudi-e-o072b-q"]},{"person":"wudi-p0172","role":"投降","evidence":["wudi-e-o072b-q"]},{"person":"wudi-p0151","role":"被击破","evidence":["wudi-e-o072b-q"]},{"person":"wudi-p0052","role":"未出兵","evidence":["wudi-e-o072b-q"]}],"place":{"text":"下邳、官渡","evidence":["wudi-e-o072b-q"]},"time":{"label":"建安五年","year":200,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o072b-q","wudi-q-o071","wudi-q-b-9900125064e5d85f08ad"],"chronology":"wudi-y200","dating_review":{"anchor":"wudi-q-o071","basis":"建安五年","reviewed":true}},"source_order":[1,402,"O072b"],"order":176},{"id":"xiahoucao-e-o012b","title":"夏侯渊于禁讨昌豨下十余屯昌豨降于禁","accounts":[{"id":"xiahoucao-e-o012b-account","label":"《