"evidence":["lizang-q-caa7a7330b02ff5922a6"]}],"participants":[{"person":"wudi-p0147","role":"讨昌豨","evidence":["lizang-q-caa7a7330b02ff5922a6"]},{"person":"wudi-p0162","role":"同讨","evidence":["lizang-q-caa7a7330b02ff5922a6"]},{"person":"wudi-p0151","role":"被讨","evidence":["lizang-q-caa7a7330b02ff5922a6"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["lizang-q-caa7a7330b02ff5922a6"]},"ordering_evidence":"lizang-q-caa7a7330b02ff5922a6","source_order":[18,51,191],"order":3641},{"id":"lizang-e-o118","title":"襄贲校尉杜松部民炅母等作乱，与昌豨通","accounts":[{"id":"lizang-a-88e70bb7cfa47bf372d0","label":"正文","text":"襄贲校尉杜松部民炅母等作乱，与昌豨通","evidence":["lizang-q-cb52498d713d9737fa3a"]},{"id":"lizang-a-7e965009ba8ad880ab58","label":"正文","text":"太祖以吕虔代杜松","evidence":["lizang-q-a24b1186082c1394d634"]},{"id":"lizang-a-31d950ca0b22213751f1","label":"正文","text":"吕虔招诱炅母渠率等赐酒食，伏兵尽格杀之","evidence":["lizang-q-1742b6969084b501a8fd"]},{"id":"lizang-a-905fa96510633969a275","label":"正文","text":"吕虔抚其余众，群贼乃平","evidence":["lizang-q-ca51688a7a4a03dcbd2b"]}],"participants":[{"person":"lizang-p0056","role":"作乱；被诱杀","evidence":["lizang-q-cb52498d713d9737fa3a","lizang-q-1742b6969084b501a8fd"]},{"person":"wudi-p0151","role":"与炅母相通","evidence":["lizang-q-cb52498d713d9737fa3a"]},{"person":"lizang-p0048","role":"所部校尉；被代","evidence":["lizang-q-cb52498d713d9737fa3a","lizang-q-a24b1186082c1394d634"]},{"person":"cao-cao","role":"以虔代松","evidence":["lizang-q-a24b1186082c1394d634"]},{"person":"lizang-p0008","role":"代松；设宴伏兵尽杀炅母等；抚其余众群贼乃平","evidence":["lizang-q-a24b1186082c1394d634","lizang-q-1742b6969084b501a8fd","lizang-q-ca51688a7a4a03dcbd2b"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["lizang-q-cb52498d713d9737fa3a","lizang-q-a24b1186082c1394d634","lizang-q-1742b6969084b501a8fd","lizang-q-ca51688a7a4a03dcbd2b"]},"ordering_evidence":"lizang-q-cb52498d713d9737fa3a","source_order":[18,110,38],"order":3663},{"id":"xianzhu-e-o017a","title":"昌霸等叛曹归刘备与孙乾通袁绍","accounts":[{"id":"xianzhu-e-o017a-account","label":"《先主传》正文","text":"昌霸即已登记的昌豨反曹，郡县归附刘备；刘备遣孙乾与袁绍连和。","evidence":["xianzhu-e-o017a-q"]}],"participants":[{"person":"wudi-p0151","role":"反曹","evidence":["xianzhu-e-o017a-q"]},{"person":"liu-bei","role":"遣使","evidence":["xianzhu-e-o017a-q"]},{"person":"xianzhu-p0027","role":"使袁绍","evidence":["xianzhu-e-o017a-q"]}],"place":{"text":"东海","evidence":["xianzhu-e-o017a-q"]},"time":{"year":199,"label":"刘备据徐州后","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xianzhu-y199","dating_review":{"reviewed":true,"anchor":"xianzhu-q-o014","basis":"刘备据徐州后"},"evidence":["xianzhu-e-o017a-q","xianzhu-q-o014","wudi-q-o061","wudi-q-b-51bced16741add42ff70"]},"source_order":[32,73,"O017a"],"order":6522}],"persons":[{"id":"wudi-p0151","name":"昌豨","evidence":["wudi-q-o059","xianzhu-q-o017","zhangle-q-o003","xiahoucao-q-o012","lizang-q-caa7a7330b02ff5922a6","lizang-q-cb52498d713d9737fa3a"],"facts":[{"id":"wudi-f-b-d52178226956d357f9a1-wudi-p0151-28b059","label":"又名","text":"昌霸","evidence":["wudi-q-b-d52178226956d357f9a1"]}],"aliases":[{"text":"昌霸","evidence":["wudi-q-b-d52178226956d357f9a1"]}],"mentions":[{"id":"wudi-m-o059-wudi-p0151","kind":"mention","text":"文中提及","evidence":["wudi-q-o059"]},{"id":"wudi-m-o072-wudi-p0151","kind":"mention","text":"文中提及","evidence":["wudi-q-o072"]},{"id":"xianzhu-m-o017-wudi-p0151","kind":"mention","text":"文中提及","evidence":["xianzhu-q-o017","wudi-q-b-d52178226956d357f9a1"]},{"id":"zhangle-m-o003-wudi-p0151","kind":"mention","text":"文中提及","evidence":["zhangle-q-o003"]},{"id":"zhangle-m-o023-wudi-p0151","kind":"mention","text":"文中提及","evidence":["zhangle-q-o023"]},{"id":"zhangle-m-p004-wudi-p0151","kind":"mention","text":"文中提及","evidence":["zhangle-q-p004"]},{"id":"xiahoucao-m-o012-wudi-p0151","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-o012"]}]}],"evidence":[{"id":"lizang-q-1742b6969084b501a8fd","section":"chapter-018","block":"b-22069ccbcac65cf41bb1","layer":"original","quote":"虔到，招诱炅母渠率及同恶数十人〖3〗，赐酒食；简壮士伏其侧，虔察炅母等皆醉，使伏兵尽格杀之","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":109,"anchor":null},"note_id":null,"start":72,"end":117},{"id":"lizang-q-a24b1186082c1394d634","section":"chapter-018","block":"b-22069ccbcac65cf41bb1","layer":"original","quote":"太祖以虔代松","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":109,"anchor":null},"note_id":null,"start":65,"end":71},{"id":"lizang-q-ca51688a7a4a03dcbd2b","section":"chapter-018","block":"b-22069ccbcac65cf41bb1","layer":"original","quote":"抚其余众，群贼乃平","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":109,"anchor":null},"note_id":null,"start":118,"end":127},{"id":"lizang-q-caa7a7330b02ff5922a6","section":"chapter-018","block":"b-225cd229025c9ed1b3d2","layer":"original","quote":"又与于禁讨昌豨","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":50,"anchor":null},"note_id":null,"start":191,"end":198},{"id":"lizang-q-cb52498d713d9737fa3a","section":"chapter-018","block":"b-22069ccbcac65cf41bb1","layer":"original","quote":"襄（陵）〔贲〕校尉杜松部民炅母等作乱〖2〗，与昌豨通","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":109,"anchor":null},"note_id":null,"start":38,"end":64},{"id":"wudi-e-o059a-q","section":"chapter-001","block":"b-c0c387dd79d2675c22f6","layer":"original","quote":"太山臧霸、孙观、吴敦、尹礼、昌豨〖7〗，各聚众。布之破刘备也，霸等悉从布。布败，获霸等，公厚纳待，遂割青、徐二州附于海以委焉〖8〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":339,"anchor":null},"note_id":null,"start":0,"end":66},{"id":"wudi-e-o072b-q","section":"chapter-001","block":"b-27a4f6d4ec7d03ce2963","layer":"original","quote":"备将关羽屯下邳〖3〗，复进攻之，羽降。昌豨叛为备，又攻破之。公还官渡，绍卒不出〖4〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":401,"anchor":null},"note_id":null,"start":121,"end":164},{"id":"wudi-q-b-4269a9733b31c7ed1578","section":"chapter-001","block":"b-4269a9733b31c7ed1578","layer":"modern","quote":"〖1〗三年：建安三年（公元 198）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":327,"anchor":null},"note_id":"n-1273453201e8129c485c","start":0,"end":19},{"id":"wudi-q-b-51bced16741add42ff70","section":"chapter-001","block":"b-51bced16741add42ff70","layer":"modern","quote":"〖1〗四年：建安四年（公元 199）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":369,"anchor":null},"note_id":"n-20628d34a709162c77f0","start":0,"end":19},{"id":"wudi-q-b-9900125064e5d85f08ad","section":"chapter-001","block":"b-9900125064e5d85f08ad","layer":"modern","quote":"〖1〗五年：建安五年（公元 200）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":403,"anchor":null},"note_id":"n-744e4aee7f5ff14cca85","start":0,"end":19},{"id":"wudi-q-b-d52178226956d357f9a1","section":"chapter-001","block":"b-d52178226956d357f9a1","layer":"modern","quote":"〖7〗太山：即泰山。臧霸：传见本书卷十八。孙观：传附本书卷十八《臧霸传》。昌豨（xī）：又名昌霸，事附本书卷十七《张辽传》。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":348,"anchor":null},"note_id":"n-7d14b312597a034346e9","start":0,"end":62},{"id":"wudi-q-o054","section":"chapter-001","block":"b-ec1ae0750950ac5532fb","layer":"original","quote":"三年春正月〖1〗，公还许。初置军师祭酒〖2〗。三月，公围张绣于穰。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":323,"anchor":null},"note_id":null,"start":0,"end":33},{"id":"wudi-q-o059","section":"chapter-001","block":"b-c0c387dd79d2675c22f6","layer":"original","quote":"太山臧霸、孙观、吴敦、尹礼、昌豨〖7〗，各聚众。布之破刘备也，霸等悉从布。布败，获霸等，公厚纳待，遂割青、徐二州附于海以委焉〖8〗。分琅邪、东海、北海为城阳、利城、昌虑郡〖9〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":339,"anchor":null},"note_id":null,"start":0,"end":89},{"id":"wudi-q-o061","section":"chapter-001","block":"b-502d4e8c0ed143eaa30d","layer":"original","quote":"四年春二月〖1〗，公还至昌邑〖2〗。张杨将杨丑杀杨〖3〗。眭固又杀丑，以其众属袁绍，屯射犬〖4〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":358,"anchor":null},"note_id":null,"start":0,"end":49},{"id":"wudi-q-o071","section":"chapter-001","block":"b-c9f735ddad48a8f5c2b6","layer":"original","quote":"五年春正月〖1〗，董承等谋泄，皆伏诛。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":400,"anchor":null},"note_id":null,"start":0,"end":19},{"id":"wudi-q-o072","section":"chapter-001","block":"b-27a4f6d4ec7d03ce2963","layer":"original","quote":"公将自东征备，诸将皆曰：“与公争天下者，袁绍也。今绍方来，而弃之东；绍乘人后〖2〗，若何？”公曰：“夫刘备，人杰也。今不击，必为后患！﹝一﹞袁绍虽有大志，而见事迟；必不动也。”郭嘉亦劝公，遂东击备。破之，生擒其将夏侯博。备走，奔绍；获其妻子。备将关羽屯下邳〖3〗，复进攻之，羽降。昌豨叛为备，又攻破之。公还官渡，绍卒不出〖4〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":401,"anchor":null},"note_id":null,"start":0,"end":164},{"id":"xiahoucao-e-o012b-q","section":"chapter-009","block":"b-594aafbe9f825ff421de","layer":"original","quote":"昌豨反，遣于禁击之，未拔；复遣渊与禁并力。遂击豨，降其十余屯，豨诣禁降。渊还，拜典军校尉。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":42,"anchor":null},"note_id":null,"start":76,"end":121},{"id":"xiahoucao-q-o012","section":"chapter-009","block":"b-594aafbe9f825ff421de","layer":"original","quote":"太祖起兵，以别部司马、骑都尉从，迁陈留、颍川太守。及与袁绍战于官渡，行督军校尉〖3〗。绍破，使督兖、豫、徐州军粮。时军食少，渊传馈相继〖4〗，军以复振。昌豨反，遣于禁击之，未拔；复遣渊与禁并力。遂击豨，降其十余屯，豨诣禁降。渊还，拜典军校尉。﹝二﹞济南、乐安黄巾徐和、司马俱等攻城〖5〗，杀长吏。渊将泰山、齐、平原郡兵击〖6〗，大破之；斩和，平诸县，收其粮谷以给军士。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":42,"anchor":null},"note_id":null,"start":0,"end":184},{"id":"xianzhu-e-o017a-q","section":"chapter-032","block":"b-7cba73e5d6ee78cda30a","layer":"original","quote":"东海昌霸反，郡县多叛曹公为先主〖7〗。众数万人，遣孙乾与袁绍连和〖8〗。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":72,"anchor":null},"note_id":null,"start":0,"end":36},{"id":"xianzhu-q-o014","section":"chapter-032","block":"b-9236c229b2cd9315f1e3","layer":"original","quote":"袁术欲经徐州北就袁绍，曹公遣先主督朱灵、路招要击术〖4〗。未至，术病死。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":60,"anchor":null},"note_id":null,"start":0,"end":36},{"id":"xianzhu-q-o017","section":"chapter-032","block":"b-7cba73e5d6ee78cda30a","layer":"original","quote":"东海昌霸反，郡县多叛曹公为先主〖7〗。众数万人，遣孙乾与袁绍连和〖8〗。曹公遣刘岱、王忠击之，不克。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":72,"anchor":null},"note_id":null,"start":0,"end":50},{"id":"zhangle-e-o003c-q","section":"chapter-017","block":"b-2e46a837d8e6474824c2","layer":"original","quote":"与夏侯渊围昌豨于东海，数月粮尽，议引军还。辽谓渊曰：“数日以来，每行诸围〖3〗，豨辄属目视辽；又其射矢更豨，此必豨计犹豫，故不力战。辽欲挑与语，傥可诱也〖4〗。”乃使谓豨曰：“公有命，使辽传之！”豨果下，与辽语，辽为说：“太祖神武，方以德怀四方，先附者受大赏。”豨乃许降。辽遂单身上三公山〖5〗，入豨家，拜妻子〖6〗；豨欢喜，随诣太祖。太祖遣豨还，责辽曰：“此非大将法也！”辽谢曰：“以明公威信著于四海，辽奉圣旨，豨必不敢害故也。”","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":3,"anchor":null},"note_id":null,"start":50,"end":266},{"id":"zhangle-e-o023a-q","section":"chapter-017","block":"b-44c775ef4d6017a4554c","layer":"original","quote":"冀州平。昌豨复叛，遣禁征之。禁急进攻豨；豨与禁有旧，诣禁降。诸将皆以为豨已降，当送诣太祖。禁曰：“诸君不知公常令乎〖11〗？围而后降者，不赦。夫奉法行令，事上之节也。豨虽旧友，禁可失节乎！”自临，与豨决，陨涕而斩之〖12〗。是时太祖军淳于，闻而叹曰：“豨降，不诣吾而归禁，岂非命耶！”益重禁。﹝一﹞东海平，拜禁虎威将军。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":75,"anchor":null},"note_id":null,"start":0,"end":160},{"id":"zhangle-q-o003","section":"chapter-017","block":"b-2e46a837d8e6474824c2","layer":"original","quote":"太祖破吕布于下邳，辽将其众降；拜中郎将，赐爵关内侯。数有战功，迁裨将军。袁绍破，别遣辽，定鲁国诸县。与夏侯渊围昌豨于东海，数月粮尽，议引军还。辽谓渊曰：“数日以来，每行诸围〖3〗，豨辄属目视辽；又其射矢更豨，此必豨计犹豫，故不力战。辽欲挑与语，傥可诱也〖4〗。”乃使谓豨曰：“公有命，使辽传之！”豨果下，与辽语，辽为说：“太祖神武，方以德怀四方，先附者受大赏。”豨乃许降。辽遂单身上三公山〖5〗，入豨家，拜妻子〖6〗；豨欢喜，随诣太祖。太祖遣豨还，责辽曰：“此非大将法也！”辽谢曰：“以明公威信著于四海，辽奉圣旨，豨必不敢害故也。”","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":3,"anchor":null},"note_id":null,"start":0,"end":266},{"id":"zhangle-q-o023","section":"chapter-017","block":"b-44c775ef4d6017a4554c","layer":"original","quote":"冀州平。昌豨复叛，遣禁征之。禁急进攻豨；豨与禁有旧，诣禁降。诸将皆以为豨已降，当送诣太祖。禁曰：“诸君不知公常令乎〖11〗？围而后降者，不赦。夫奉法行令，事上之节也。豨虽旧友，禁可失节乎！”自临，与豨决，陨涕而斩之〖12〗。是时太祖军淳于，闻而叹曰：“豨降，不诣吾而归禁，岂非命耶！”益重禁。﹝一﹞东海平，拜禁虎威将军。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":75,"anchor":null},"note_id":null,"start":0,"end":160},{"id":"zhangle-q-p004","section":"chapter-017","block":"b-8b37295d72b16119fb00","layer":"pei","quote":"﹝一﹞臣松之以为：围而后降，法虽不赦；囚而送之，未为违命。禁曾不为旧交，希冀万一；而肆其好杀之心，以戾众人之议。所以卒为降虏，死加恶谥，宜哉！","attribution":"裴松之论","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":98,"anchor":null},"note_id":"n-dea6733370b7dd5b47c1","start":0,"end":71},{"id":"zhangle-q-p004-judgment","section":"chapter-017","block":"b-8b37295d72b16119fb00","layer":"pei","quote":"﹝一﹞臣松之以为：围而后降，法虽不赦；囚而送之，未为违命。禁曾不为旧交，希冀万一；而肆其好杀之心，以戾众人之议。所以卒为降虏，死加恶谥，宜哉！","attribution":"裴松之论","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":98,"anchor":null},"note_id":"n-dea6733370b7dd5b47c1","start":0,"end":71}],"profiles":{},"directory_counts":{}}
