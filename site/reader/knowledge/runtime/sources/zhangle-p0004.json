{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhangle-e-o004d","title":"张辽从破袁谭别破柳毅曹操迎接","accounts":[{"id":"zhangle-e-o004d-account","label":"《张乐于张徐传第十七》正文","text":"张辽从破袁谭别破柳毅曹操迎接","evidence":["zhangle-e-o004d-q"]}],"participants":[{"person":"wudi-p0178","role":"从征","evidence":["zhangle-e-o004d-q"]},{"person":"cao-cao","role":"迎劳","evidence":["zhangle-e-o004d-q"]},{"person":"zhangle-p0004","role":"被破","evidence":["zhangle-e-o004d-q"]}],"place":null,"time":{"label":"从讨袁氏时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["zhangle-e-o004d-q"]},"ordering_evidence":"zhangle-e-o004d-q","source_order":[17,5,"O004d"],"order":3483}],"persons":[{"id":"zhangle-p0004","name":"柳毅","evidence":["zhangle-q-o004"],"facts":[],"aliases":[],"mentions":[{"id":"zhangle-m-o004-zhangle-p0004","kind":"mention","text":"文中提及","evidence":["zhangle-q-o004"]}]}],"evidence":[{"id":"zhangle-e-o004d-q","section":"chapter-017","block":"b-bb2000f2e2cf52ea36fc","layer":"original","quote":"从攻袁谭。谭破，别将徇海滨，破辽东贼柳毅等。还邺，太祖自出迎辽，引共载。以辽为荡寇将军，","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":4,"anchor":null},"note_id":null,"start":86,"end":130},{"id":"zhangle-q-o004","section":"chapter-017","block":"b-bb2000f2e2cf52ea36fc","layer":"original","quote":"从讨袁谭、袁尚于黎阳，有功，行中坚将军。从攻尚于邺，尚坚守，不下。太祖还许，使辽与乐进拔阴安，徙其民河南。复从攻邺。邺破，辽别徇赵国、常山〖7〗，招降缘山诸贼及黑山孙轻等。从攻袁谭。谭破，别将徇海滨，破辽东贼柳毅等。还邺，太祖自出迎辽，引共载。以辽为荡寇将军，复别击荆州，定江夏诸县。还屯临颍，封都亭侯。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":4,"anchor":null},"note_id":null,"start":0,"end":152}],"profiles":{},"directory_counts":{}}
