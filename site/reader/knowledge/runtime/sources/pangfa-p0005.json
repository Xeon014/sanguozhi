{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"pangfa-e-p001d","title":"庞涣太康中任牂牁太守","accounts":[{"id":"pangfa-e-p001d-account","label":"《襄阳记》","text":"《襄阳记》记庞涣在晋太康中任牂牁太守。","evidence":["pangfa-e-p001d-q"]}],"participants":[{"person":"pangfa-p0005","role":"任太守","evidence":["pangfa-e-p001d-q"]}],"place":null,"time":{"label":"晋太康中","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["pangfa-e-p001d-q"]},"ordering_evidence":"pangfa-e-p001d-q","source_order":[37,23,"P001d"],"order":6958}],"persons":[{"id":"pangfa-p0005","name":"庞涣","evidence":["pangfa-q-p001"],"facts":[{"id":"pangfa-f0004","label":"字","text":"世文","evidence":["pangfa-f0004-q"]}],"aliases":[{"text":"世文","evidence":["pangfa-f0004-q"]}],"mentions":[{"id":"pangfa-m-p001-pangfa-p0005","kind":"mention","text":"文中提及","evidence":["pangfa-q-p001"]}]}],"evidence":[{"id":"pangfa-e-p001d-q","section":"chapter-037","block":"b-67cdb392b3293b4195ae","layer":"pei","quote":"子涣，字世文。晋太康中，为牂牁太守。","attribution":"《襄阳记》","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":22,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-952f093ecb11b9f464e8","start":230,"end":248,"offset_unit":"unicode_code_point"},{"id":"pangfa-f0004-q","section":"chapter-037","block":"b-67cdb392b3293b4195ae","layer":"pei","quote":"子涣，字世文。","attribution":"《襄阳记》","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":22,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-952f093ecb11b9f464e8","start":230,"end":237,"offset_unit":"unicode_code_point"},{"id":"pangfa-q-p001","section":"chapter-037","block":"b-67cdb392b3293b4195ae","layer":"pei","quote":"﹝一﹞《襄阳记》曰：“诸葛孔明为‘卧龙’，庞士元为‘凤雏’，司马德操为‘水镜’，皆庞德公语也。德公，襄阳人。孔明每至其家，独拜床下，德公初不令止。德操尝造德公，值其渡沔，上祀先人墓；德操径入其室，呼德公妻子，使速作黍：‘徐元直向云有客当来，就我与庞公谈。’其妻子皆罗列拜于堂下，奔走供设；须臾，德公还，直入相就：不知何者是客也。德操年小德公十岁，兄事之，呼作庞公；故世人遂谓‘庞公’是德公名，非也。德公子山民，亦有令名。娶诸葛孔明小姊。为魏黄门、吏部郎，早卒。子涣，字世文。晋太康中，为牂牁太守。统，德公从子也。少未有识者，惟德公重之；年十八，使往见德操。德操与语，既而叹曰：‘德公诚知人！此实盛德也。’”","attribution":"《襄阳记》","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":22,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-952f093ecb11b9f464e8","start":0,"end":303,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
