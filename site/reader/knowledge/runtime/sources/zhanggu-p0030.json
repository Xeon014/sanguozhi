9ee97cf1","source_order":[52,336,10],"order":9359},{"id":"zhanggu-e-o146","title":"公安灵鼍童谣融刮金印服死","accounts":[{"id":"zhanggu-a-c71abc731303513d7341","label":"裴注·江表传","text":"公安灵鼍童谣融刮金印服死","evidence":["zhanggu-q-3d05fa04d78b16120b22"]}],"participants":[{"person":"zhanggu-p0030","role":"《江表传》记刮金印龟服死","evidence":["zhanggu-q-3d05fa04d78b16120b22"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["zhanggu-q-3d05fa04d78b16120b22"]},"ordering_evidence":"zhanggu-q-3d05fa04d78b16120b22","source_order":[52,337,11],"order":9360},{"id":"zhulv-e-o060","title":"诸葛瑾子融、步骘子协虽各袭任，权特复使然总为大督","accounts":[{"id":"zhulv-a-7372b6e9d8fbef94fdd4","label":"正文","text":"诸葛瑾子融、步骘子协虽各袭任，权特复使然总为大督","evidence":["zhulv-q-7b376d7e2c916b9995fc"]}],"participants":[{"person":"sun-quan","role":"使然总大督者","evidence":["zhulv-q-7b376d7e2c916b9995fc"]},{"person":"mingdi-p0046","role":"总为大督者","evidence":["zhulv-q-7b376d7e2c916b9995fc"]},{"person":"zhanggu-p0030","role":"袭任者（背景）","evidence":["zhulv-q-7b376d7e2c916b9995fc"]},{"person":"santizhu-p0054","role":"袭任者（背景）","evidence":["zhulv-q-7b376d7e2c916b9995fc"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["zhulv-q-7b376d7e2c916b9995fc"]},"ordering_evidence":"zhulv-q-7b376d7e2c916b9995fc","source_order":[56,92,119],"order":9981},{"id":"zhulv-e-o070","title":"绩与奋威将军诸葛融书曰：昶远来疲困、马无所食，力屈而走，此天助也；今追之力少，可引兵相继，吾欲破之于前，足下乘之于后，宜同断金之义；融答许绩","accounts":[{"id":"zhulv-a-2fb20a0e752817907192","label":"正文","text":"绩与奋威将军诸葛融书曰：昶远来疲困、马无所食，力屈而走，此天助也；今追之力少，可引兵相继，吾欲破之于前，足下乘之于后，宜同断金之义；融答许绩","evidence":["zhulv-q-44a86491fc0a66fb96ed"]},{"id":"zhulv-a-a9ef95e32216e3ec20a3","label":"正文","text":"绩便引兵及昶于纪南；纪南去城三十里，绩先战胜而融不进，绩后失利","evidence":["zhulv-q-2fa86e07083ac4e62f2a"]},{"id":"zhulv-a-a46707378044429cefb6","label":"正文","text":"权深嘉绩，盛责怒融；融兄大将军恪贵重，故融得不废","evidence":["zhulv-q-e894d375af904df023f6"]},{"id":"zhulv-a-4d4f4555a510057b7280","label":"正文","text":"初绩与恪、融不平，及此事变，为隙益甚","evidence":["zhulv-q-d14072171647868c3cd3"]}],"participants":[{"person":"shaodi-p0155","role":"约分击者；先胜后失利者；被嘉者；不平者","evidence":["zhulv-q-44a86491fc0a66fb96ed","zhulv-q-2fa86e07083ac4e62f2a","zhulv-q-e894d375af904df023f6","zhulv-q-d14072171647868c3cd3"]},{"person":"zhanggu-p0030","role":"答许者；不进者；被责而得不废者；不平之另一方","evidence":["zhulv-q-44a86491fc0a66fb96ed","zhulv-q-2fa86e07083ac4e62f2a","zhulv-q-e894d375af904df023f6","zhulv-q-d14072171647868c3cd3"]},{"person":"shaodi-p0032","role":"所约追击之对象（背景）；被及而战者","evidence":["zhulv-q-44a86491fc0a66fb96ed","zhulv-q-2fa86e07083ac4e62f2a"]},{"person":"sun-quan","role":"嘉绩责融者","evidence":["zhulv-q-e894d375af904df023f6"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["zhulv-q-44a86491fc0a66fb96ed","zhulv-q-2fa86e07083ac4e62f2a","zhulv-q-e894d375af904df023f6","zhulv-q-d14072171647868c3cd3"]},"ordering_evidence":"zhulv-q-44a86491fc0a66fb96ed","source_order":[56,120,47],"order":9991},{"id":"zhulv-e-o073","title":"冬，恪、融被害，绩复还乐乡，假节","accounts":[{"id":"zhulv-a-67a2d6dd97486aa8bf9b","label":"正文","text":"冬，恪、融被害，绩复还乐乡，假节","evidence":["zhulv-q-d2485065cc8e793b858d"]}],"participants":[{"person":"shaodi-p0041","role":"被害者","evidence":["zhulv-q-d2485065cc8e793b858d"]},{"person":"zhanggu-p0030","role":"被害者","evidence":["zhulv-q-d2485065cc8e793b858d"]},{"person":"shaodi-p0155","role":"还乐乡假节者","evidence":["zhulv-q-d2485065cc8e793b858d"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["zhulv-q-d2485065cc8e793b858d"]},"ordering_evidence":"zhulv-q-d2485065cc8e793b858d","source_order":[56,121,45],"order":9992},{"id":"santizhu064-e-sr-ke-rong-letter","title":"诸葛恪与弟公安督融书嘱边备（全文）","accounts":[{"id":"santizhu064-a-d451f2eb832fd3f2a596","label":"正文","text":"恪与大行皇帝崩后皇太子践尊号，自陈受顾命才非博陆惧忝辅汉之效；嘱融所在与贼犬牙，当整顿军具率厉将士警备过常、边邑诸曹已下约敕不得妄委所戍径来奔赴；以亲正疏古人明戒","evidence":["santizhu064-q-f091b79eb5f29f6165c2"]}],"participants":[{"person":"shaodi-p0041","role":"与弟融书嘱边备","evidence":["santizhu064-q-f091b79eb5f29f6165c2"]},{"person":"zhanggu-p0030","role":"受书之公安督（zhanggu-p0030，见notes跨篇）","evidence":["santizhu064-q-f091b79eb5f29f6165c2"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"未由相邻段落推算纪年；原文时间表达保留在来源引句中。","evidence":["santizhu064-q-f091b79eb5f29f6165c2"]},"ordering_evidence":"santizhu064-q-f091b79eb5f29f6165c2","source_order":[64,131,0],"order":10948}],"persons":[{"id":"zhanggu-p0030","name":"诸葛融","evidence":["zhanggu-q-547556b3854c9940d1ca","zhanggu-q-42d1861fd94ff5d2f53c","zhanggu-q-8b9e70c5556972f45fd9","zhanggu-q-e98cc63703819ee97cf1","zhanggu-q-3d05fa04d78b16120b22","zhanggu-q-69d52233e7647cecb619","santizhu064-q-97f565b2dba90010c18a","zongshi-q-ecaf8adc789ce848f183","zhulv-q-7b376d7e2c916b9995fc","zhulv-q-44a86491fc0a66fb96ed","zhulv-q-2fa86e07083ac4e62f2a","zhulv-q-e894d375af904df023f6","zhulv-q-d14072171647868c3cd3","zhulv-q-05fcc5a99f3be1ae7882","zhulv-q-d2485065cc8e793b858d"],"facts":[{"id":"zhanggu-f-937d4e65eebbda60b78b","text":"字叔长。","evidence":["zhanggu-q-69d52233e7647cecb619"]}],"aliases":[],"mentions":[]}],"evidence":[{"id":"huangli-q-1c19a53fc2fdfca557a9","section":"chapter-043","block":"b-ffc116c405cea888a171","layer":"original","quote":"吴太傅诸葛恪以初破魏军，大兴兵众以图攻取","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":246,"anchor":null},"note_id":null,"start":0,"end":20},{"id":"santizhu064-q-97f565b2dba90010c18a","section":"chapter-064","block":"b-f1a4235460a269f95ce7","layer":"original","quote":"与弟公安督融书曰〖7〗：“今月〔二〕十六日乙未，大行皇帝委弃万国〖8〗。群下大小，莫不伤悼。至吾父子兄弟，并受殊恩，非徒凡庸之隶；是以悲恸，肝心圮裂〖9〗。皇太子以丁酉践尊号〖10〗，哀喜交并，不知所措。吾身受顾命，辅相幼主。窃自揆度：才非博陆而受姬公负图之托〖11〗，惧忝丞相辅汉之效〖12〗，恐损先帝委付之明；是以忧惭惶惶，所虑万端。且民恶其上，动见瞻观，何时易哉？今以顽钝之姿，处保傅之位〖13〗；艰多智寡，任重谋浅：谁为唇齿〖14〗？近汉之世，燕、盖交构〖15〗，有上官之变〖16〗。以身值此，何敢怡豫邪〖17〗？又弟所在，与贼犬牙相错；当于今时整顿军具，率厉将士，警备过常〖18〗；念出万死〖19〗，无顾一生；以报朝廷，无忝尔先。又诸将备守各有境界，犹恐贼虏闻讳〖20〗，恣睢寇窃。边邑诸曹，已别下约敕：所部督将，不得妄委所戍，径来奔赴〖21〗。虽怀怆怛不忍之心〖22〗，公义夺私〖23〗，伯禽服戎〖24〗；若苟违戾，非徒小故。以亲正疏，古人明戒也。”","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":130,"anchor":null},"note_id":null,"start":0,"end":431},{"id":"santizhu064-q-f091b79eb5f29f6165c2","section":"chapter-064","block":"b-f1a4235460a269f95ce7","layer":"original","quote":"与弟公安督融书曰〖7〗：“今月〔二〕十六日乙未，大行皇帝委弃万国〖8〗。群下大小，莫不伤悼。至吾父子兄弟，并受殊恩，非徒凡庸之隶；是以悲恸，肝心圮裂〖9〗。皇太子以丁酉践尊号〖10〗，哀喜交并，不知所措。吾身受顾命，辅相幼主。窃自揆度：才非博陆而受姬公负图之托〖11〗，惧忝丞相辅汉之效〖12〗，恐损先帝委付之明；是以忧惭惶惶，所虑万端。且民恶其上，动见瞻观，何时易哉？今以顽钝之姿，处保傅之位〖13〗；艰多智寡，任重谋浅：谁为唇齿〖14〗？近汉之世，燕、盖交构〖15〗，有上官之变〖16〗。以身值此，何敢怡豫邪〖17〗？又弟所在，与贼犬牙相错；当于今时整顿军具，率厉将士，警备过常〖18〗；念出万死〖19〗，无顾一生；以报朝廷，无忝尔先。又诸将备守各有境界，犹恐贼虏闻讳〖20〗，恣睢寇窃。边邑诸曹，已别下约敕：所部督将，不得妄委所戍，径来奔赴〖21〗。虽怀怆怛不忍之心〖22〗，公义夺私〖23〗，伯禽服戎〖24〗；若苟违戾，非徒小故。以亲正疏，古人明戒也。”","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":130,"anchor":null},"note_id":null,"start":0,"end":431},{"id":"shaodi-e-o055b-q","section":"chapter-004","block":"b-2d3651c906b3924f6677","layer":"original","quote":"五年夏四月〖1〗，大赦。五月，吴太傅诸葛恪围合肥新城；诏太尉司马孚拒之。﹝一﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":239,"anchor":null},"note_id":null,"start":0,"end":39},{"id":"shaodi-q-b-aa6ace448e938821edac","section":"chapter-004","block":"b-aa6ace448e938821edac","layer":"modern","quote":"〖1〗五年：嘉平五年（公元 253）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":244,"anchor":null},"note_id":"n-4e568bedcd1f34c38680","start":0,"end":19},{"id":"shaodi-q-o055","section":"chapter-004","block":"b-2d3651c906b3924f6677","layer":"original","quote":"五年夏四月〖1〗，大赦。五月，吴太傅诸葛恪围合肥新城；诏太尉司马孚拒之。﹝一﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":239,"anchor":null},"note_id":null,"start":0,"end":39},{"id":"wgc-q0016","section":"chapter-028","block":"b-7bd943dc7147c2f75ba7","layer":"original","quote":"转为镇南将军。诸葛诞战于东关，不利；乃令诞、俭对换。诞为镇南，都督豫州。俭为镇东，都督扬州。吴太傅诸葛恪围合肥新城，俭与文钦御之；太尉司马孚督中军东，解围，恪退还。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":85,"anchor":null},"note_id":null,"start":0,"end":82},{"id":"wgc-q0041","section":"chapter-028","block":"b-0c032a6da7eae7e225ce","layer":"original","quote":"诸葛恪围合肥新城，不克，退归。艾言景王曰：“孙权已没，大臣未附；吴名宗大族，皆有部曲〖20〗；阻兵仗势，足以（建）〔违〕命。恪新秉国政，而内无其主；不念抚恤上下以立根基，竞于外事〖21〗，虐用其民；悉国之众，顿于坚城，死者万数，载祸而归。此恪获罪之日也。昔子胥、吴起、商鞅、乐毅皆见任时君〖22〗，主没而败。况恪才非四贤，而不虑不患，其亡可待也。”恪归，果见诛。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":267,"anchor":null},"note_id":null,"start":0,"end":181},{"id":"wgc-q0221","section":"chapter-028","block":"b-7bd943dc7147c2f75ba7","layer":"original","quote":"吴太傅诸葛恪围合肥新城，俭与文钦御之；太尉司马孚督中军东，解围，恪退还","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":85,"anchor":null},"note_id":null,"start":46,"end":81},{"id":"wgc-q0340","section":"chapter-028","block":"b-0c032a6da7eae7e225ce","layer":"original","quote":"诸葛恪围合肥新城，不克，退归","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":267,"anchor":null},"note_id":null,"start":0,"end":14},{"id":"zhanggu-q-3d05fa04d78b16120b22","section":"chapter-052","block":"b-86dccb927f1c7a42b4e4","layer":"pei","quote":"先是，公安有灵鼍鸣。童谣曰：‘白鼍鸣，龟背平。南郡城中可长生。守死不去义无成。’及恪被诛，融果刮金印龟，服之而死","attribution":"裴注·江表传","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":336,"anchor":null},"note_id":"n-303d967a37e2060ea7da","start":11,"end":67},{"id":"zhanggu-q-42d1861fd94ff5d2f53c","section":"chapter-052","block":"b-08da7328bb1216b3b24f","layer":"original","quote":"孙权薨，徙奋威将军。后恪征淮南，假融节，令引军入沔，以击西兵","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":315,"anchor":null},"note_id":null,"start":0,"end":30},{"id":"zhanggu-q-547556b3854c9940d1ca","section":"chapter-052","block":"b-49621ebbc32db0851f15","layer":"original","quote":"恪已自封侯；故弟融袭爵，摄兵业驻公安〖4〗，﹝二﹞部曲吏士亲附之。疆外无事，秋冬则射猎讲武，春夏则延宾高会；休吏假卒〖5〗，或不远千里而造焉〖6〗。每会，辄历问宾客，各言其能；乃合榻促席〖7〗，量敌选对〖8〗；或有博弈〖9〗，或有摴蒱〖10〗，投壶弓弹〖11〗，部别类分；于是甘果继进，清酒徐行；融周流观览，终日不倦。融父兄质素〖12〗，虽在军旅，身无采饰；而融锦罽文绣〖13〗，独为奢绮","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":314,"anchor":null},"note_id":null,"start":0,"end":194},{"id":"zhanggu-q-69d52233e7647cecb619","section":"chapter-052","block":"b-ef98b9d83cfff8092fa7","layer":"pei","quote":"﹝二﹞《吴书》曰：“融字叔长。生于宠贵，少而骄乐。学为章句，博而不精。性宽容，多技艺。数以巾褐奉朝请。后拜骑都尉。赤乌中，诸郡出部伍。新都都尉陈表、吴郡都尉顾承，各率所领人，会佃毗陵，男女各数万口。表病死，权以融代表。后代父瑾领摄。”","attribution":"裴注·吴书","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":335,"anchor":null},"note_id":"n-b40cbb929728fe480dd3","start":0,"end":117},{"id":"zhanggu-q-8b9e70c5556972f45fd9","section":"chapter-052","block":"b-33dcd8c4dccefbc86e0b","layer":"original","quote":"恪既诛，遣无难督施宽，就将军施绩、孙壹、全熙等，取融。融猝闻兵士至，惶惧犹豫，不能决计；兵到围城，饮药而死。三子，皆伏诛","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":316,"anchor":null},"note_id":null,"start":0,"end":60},{"id":"zhanggu-q-e98cc63703819ee97cf1","section":"chapter-052","block":"b-ef98b9d83cfff8092fa7","layer":"pei","quote":"融字叔长。生于宠贵，少而骄乐。学为章句，博而不精。性宽容，多技艺。数以巾褐奉朝请。后拜骑都尉。赤乌中，诸郡出部伍。新都都尉陈表、吴郡都尉顾承，各率所领人，会佃毗陵，男女各数万口。表病死，权以融代表。后代父瑾领摄","attribution":"裴注·吴书","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":335,"anchor":null},"note_id":"n-b40cbb929728fe480dd3","start":10,"end":115},{"id":"zhulv-q-05fcc5a99f3be1ae7882","section":"chapter-056","block":"b-2644798b5c13bf211507","layer":"original","quote":"二年春〖14〗，恪向新城，要绩并力〖15〗；而留置半州，使融兼其任","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":120,"anchor":null},"note_id":null,"start":11,"end":44},{"id":"zhulv-q-28a47a1f106a8b7b801a","section":"chapter-056","block":"b-6da951f01660a7939664","layer":"pei","quote":"异又随诸葛恪围新城，城既不拔；异等皆言宜速还豫章，袭石头城，不过数日可拔","attribution":"裴注·吴书","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":295,"anchor":null},"note_id":"n-c647a7a3182c67039e5c","start":10,"end":46},{"id":"zhulv-q-2fa86e07083ac4e62f2a","section":"chapter-056","block":"b-c9cf0497c6ffd682f91e","layer":"original","quote":"绩便引兵及昶于纪南〖12〗。纪南去城三十里，绩先战胜而融不进，绩后失利","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":119,"anchor":null},"note_id":null,"start":131,"end":166},{"id":"zhulv-q-44a86491fc0a66fb96ed","section":"chapter-056","block":"b-c9cf0497c6ffd682f91e","layer":"original","quote":"绩与奋威将军诸葛融书曰：“昶远来疲困，马无所食；力屈而走，此天助也。今追之力少，可引兵相继；吾欲破之于前，足下乘之于后。岂一人之功哉？宜同断金之义〖11〗！”融答许绩","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":119,"anchor":null},"note_id":null,"start":47,"end":130},{"id":"zhulv-q-7b376d7e2c916b9995fc","section":"chapter-056","block":"b-dc938f3589852f99c02f","layer":"original","quote":"诸葛瑾子融，步骘子协，虽各袭任，权特复使然总为大督","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":91,"anchor":null},"note_id":null,"start":119,"end":144},{"id":"zhulv-q-d14072171647868c3cd3","section":"chapter-056","block":"b-c9cf0497c6ffd682f91e","layer":"original","quote":"初绩与恪、融不平〖13〗，及此事变，为隙益甚","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":119,"anchor":null},"note_id":null,"start":192,"end":214},{"id":"zhulv-q-d2485065cc8e793b858d","section":"chapter-056","block":"b-2644798b5c13bf211507","layer":"original","quote":"冬，恪、融被害，绩复还乐乡，假节","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":120,"anchor":null},"note_id":null,"start":45,"end":61},{"id":"zhulv-q-e894d375af904df023f6","section":"chapter-056","block":"b-c9cf0497c6ffd682f91e","layer":"original","quote":"权深嘉绩，盛责怒融。融兄大将军恪贵重，故融得不废","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":119,"anchor":null},"note_id":null,"start":167,"end":191},{"id":"zongshi-q-ecaf8adc789ce848f183","section":"chapter-051","block":"b-4d4c1542c098dab2b8c8","layer":"original","quote":"孙峻之诛诸葛恪也，壹与全熙、施绩攻恪弟公安督融〖10〗，融自杀","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":72,"anchor":null},"note_id":null,"start":0,"end":31}],"profiles":{"zhanggu-p0030":{"fields":[],"directory":{"faction":"wu"}}},"directory_counts":{}}
