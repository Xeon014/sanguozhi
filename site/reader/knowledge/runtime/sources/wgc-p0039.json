{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wgc-e-5-e26","title":"全怿等将兵来救诸葛诞","order":5748,"accounts":[{"id":"wgc-a-5-e26","label":"正文","text":"全怿等将兵来救诸葛诞","evidence":["wgc-q0434","wgc-q0067"]}],"participants":[{"person":"shaodi-p0118","role":"将兵来救诞","evidence":["wgc-q0434","wgc-q0067"]},{"person":"wgc-p0038","role":"同来救诞","evidence":["wgc-q0434","wgc-q0067"]},{"person":"shaodi-p0042","role":"同来救诞","evidence":["wgc-q0434","wgc-q0067"]},{"person":"wgc-p0039","role":"同来救诞","evidence":["wgc-q0434","wgc-q0067"]},{"person":"wgc-p0040","role":"同来救诞","evidence":["wgc-q0434","wgc-q0067"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0434","wgc-q0067"]},"ordering_evidence":"wgc-q0434"}],"persons":[{"id":"wgc-p0039","name":"全翩","evidence":["wgc-q0067"],"aliases":[],"facts":[],"mentions":[{"id":"wgc-m-o086-wgc-p0039","kind":"mention","text":"本段涉及全翩","evidence":["wgc-q0067"]}]}],"evidence":[{"id":"wgc-q0067","section":"chapter-028","block":"b-19a57525c37bf4f5767a","layer":"original","quote":"甘露二年，征诸葛诞为司空。时，会丧宁在家〖1〗，策诞必不从命，驰白文王。文王以事已施行，不复追改。﹝一﹞及诞反，车驾住项；文王至寿春，会复从行。初，吴大将全琮，孙权之婚亲重臣也〖2〗；琮子怿、孙静、从子端、翩、缉等，皆将兵来救诞。怿兄子辉、仪留建业，与其家内争讼；携其母，将部曲数十家渡江，自归文王。会建策，密为辉、仪作书，使辉、仪所亲信，赍入城告怿等，说“吴中怒怿等不能拔寿春，欲尽诛诸将家，故逃来归命”。怿等恐惧，遂将所领，开东城门出降，皆蒙封宠，城中由是乖离。寿春之破，会谋居多。亲待日隆，时人谓之子房〖3〗。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":455,"anchor":null},"note_id":null,"start":0,"end":258},{"id":"wgc-q0434","section":"chapter-028","block":"b-19a57525c37bf4f5767a","layer":"original","quote":"琮子怿、孙静、从子端、翩、缉等，皆将兵来救诞","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":455,"anchor":null},"note_id":null,"start":92,"end":114}],"profiles":{},"directory_counts":{}}
