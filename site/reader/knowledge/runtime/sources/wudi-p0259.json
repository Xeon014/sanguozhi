{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p087a","title":"王儁少时交游","accounts":[{"id":"wudi-e-p087a-account","label":"皇甫谧《逸士传》","text":"王儁少为范滂、许章赏识，与岑晊友善，曹操为布衣时亦爱重他。","evidence":["wudi-e-p087a-q"]}],"participants":[{"person":"wudi-p0259","role":"被赏识交游","evidence":["wudi-e-p087a-q"]},{"person":"wudi-p0260","role":"赏识","evidence":["wudi-e-p087a-q"]},{"person":"wudi-p0261","role":"赏识","evidence":["wudi-e-p087a-q"]},{"person":"wudi-p0262","role":"友善","evidence":["wudi-e-p087a-q"]},{"person":"cao-cao","role":"爱重","evidence":["wudi-e-p087a-q"]}],"place":null,"time":{"label":"王儁少时及曹操布衣时","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p087a-q"]},"source_order":[1,689,"P087a"],"order":284},{"id":"wudi-e-p087b","title":"曹操王儁赴袁氏母丧论二袁","accounts":[{"id":"wudi-e-p087b-account","label":"皇甫谧《逸士传》","text":"曹操、王儁在袁绍与袁术母丧时相会，曹操私下称二袁将为乱首，应先诛之；王儁以平天下相期。","evidence":["wudi-e-p087b-q"]}],"participants":[{"person":"cao-cao","role":"议论","evidence":["wudi-e-p087b-q"]},{"person":"wudi-p0259","role":"对答","evidence":["wudi-e-p087b-q"]},{"person":"wudi-p0052","role":"治母丧","evidence":["wudi-e-p087b-q"]},{"person":"wudi-p0057","role":"治母丧","evidence":["wudi-e-p087b-q"]}],"place":{"text":"汝南","evidence":["wudi-e-p087b-q"]},"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p087b-q"]},"source_order":[1,689,"P087b"],"order":285},{"id":"wudi-e-p087c","title":"王儁避居武陵拒征","accounts":[{"id":"wudi-e-p087c-account","label":"皇甫谧《逸士传》","text":"王儁不应州郡三府及公车征召，避居武陵，百余家归附；汉都许后再征尚书，仍未就任。","evidence":["wudi-e-p087c-q"]}],"participants":[{"person":"wudi-p0259","role":"拒征避居","evidence":["wudi-e-p087c-q"]}],"place":{"text":"武陵","evidence":["wudi-e-p087c-q"]},"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p087c-q"]},"source_order":[1,689,"P087c"],"order":286},{"id":"wudi-e-p087d","title":"王儁劝刘表结曹未被采纳","accounts":[{"id":"wudi-e-p087d-account","label":"皇甫谧《逸士传》","text":"王儁得知刘表暗通袁绍，劝其就近结曹，刘表不从。","evidence":["wudi-e-p087d-q"]}],"participants":[{"person":"wudi-p0259","role":"进谏","evidence":["wudi-e-p087d-q"]},{"person":"liu-biao","role":"不从","evidence":["wudi-e-p087d-q"]},{"person":"wudi-p0052","role":"被联络","evidence":["wudi-e-p087d-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p087d-q"]},"source_order":[1,689,"P087d"],"order":287},{"id":"wudi-e-p087e","title":"王儁卒于武陵","accounts":[{"id":"wudi-e-p087e-account","label":"皇甫谧《逸士传》","text":"王儁六十四岁卒于武陵，曹操闻讯哀伤。","evidence":["wudi-e-p087e-q"]}],"participants":[{"person":"wudi-p0259","role":"去世","evidence":["wudi-e-p087e-q"]},{"person":"cao-cao","role":"哀悼","evidence":["wudi-e-p087e-q"]}],"place":{"text":"武陵","evidence":["wudi-e-p087e-q"]},"time":{"label":"王儁年六十四","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p087e-q"]},"source_order":[1,689,"P087e"],"order":288},{"id":"wudi-e-p087f","title":"曹操迎王儁丧改葬","accounts":[{"id":"wudi-e-p087f-account","label":"皇甫谧《逸士传》","text":"平荆州后曹操临江迎王儁丧，改葬江陵，表为先贤。","evidence":["wudi-e-p087f-q"]}],"participants":[{"person":"cao-cao","role":"迎丧改葬","evidence":["wudi-e-p087f-q"]},{"person":"wudi-p0259","role":"被改葬","evidence":["wudi-e-p087f-q"]}],"place":{"text":"江陵","evidence":["wudi-e-p087f-q"]},"time":{"label":"平荆州后","year":208,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-p087f-q","wudi-q-o119","wudi-q-b-888495d8be7766faf20c"],"chronology":"wudi-y208","dating_review":{"anchor":"wudi-q-o119","basis":"平荆州后","reviewed":true}},"source_order":[1,689,"P087f"],"order":289}],"persons":[{"id":"wudi-p0259","name":"王儁","evidence":["wudi-q-p087"],"facts":[{"id":"wudi-f-p087-wudi-p0259-c55038","label":"字","text":"子文","evidence":["wudi-f-p087-wudi-p0259-c55038-q"]},{"id":"wudi-f-p087-wudi-p0259-3d9187","label":"籍贯","text":"汝南","evidence":["wudi-f-p087-wudi-p0259-3d9187-q"]}],"aliases":