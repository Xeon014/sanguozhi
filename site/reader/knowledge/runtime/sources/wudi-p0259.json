03e333bc0a14a28","note_id":"n-cf8a0075075368325cde","start":212,"end":285,"offset_unit":"unicode_code_point"},{"id":"wudi-e-p087e-q","section":"chapter-001","block":"b-ea056e74ee4abddcf775","layer":"pei","quote":"儁年六十四，以寿终于武陵。公闻而哀伤。","attribution":"皇甫谧《逸士传》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":13,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cf8a0075075368325cde","start":285,"end":304,"offset_unit":"unicode_code_point"},{"id":"wudi-e-p087f-q","section":"chapter-001","block":"b-ea056e74ee4abddcf775","layer":"pei","quote":"及平荆州，自临江迎丧：改葬于江陵，表为先贤也。","attribution":"皇甫谧《逸士传》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":13,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cf8a0075075368325cde","start":304,"end":327,"offset_unit":"unicode_code_point"},{"id":"wudi-f-p087-wudi-p0259-3d9187-q","section":"chapter-001","block":"b-ea056e74ee4abddcf775","layer":"pei","quote":"汝南王儁，字子文。","attribution":"皇甫谧《逸士传》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":13,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cf8a0075075368325cde","start":11,"end":20,"offset_unit":"unicode_code_point"},{"id":"wudi-f-p087-wudi-p0259-c55038-q","section":"chapter-001","block":"b-ea056e74ee4abddcf775","layer":"pei","quote":"汝南王儁，字子文。","attribution":"皇甫谧《逸士传》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":13,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cf8a0075075368325cde","start":11,"end":20,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-888495d8be7766faf20c","section":"chapter-001","block":"b-888495d8be7766faf20c","layer":"modern","quote":"〖1〗十三年：建安十三年（公元 208）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":666,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0bae348fdb687025113d","start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o119","section":"chapter-001","block":"b-4bcffcc4ee709a4e5ea3","layer":"original","quote":"十三年春正月〖1〗，公还邺。作玄武池以肄舟师〖2〗。﹝一﹞汉罢三公官，置丞相、御史大夫〖3〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":661,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":47,"offset_unit":"unicode_code_point"},{"id":"wudi-q-p087","section":"chapter-001","block":"b-ea056e74ee4abddcf775","layer":"pei","quote":"皇甫谧《逸士传》曰：“汝南王儁，字子文。少为范滂、许章所识，与南阳岑晊善。公之为布衣，特爱儁；儁亦称公有治世之具。及袁绍与弟术丧母，归葬汝南；儁与公会之，会者三万人。公于外密语儁曰：‘天下将乱，为乱魁者，必此二人也！欲济天下，为百姓请命；不先诛此二子，乱今作矣。’儁曰：‘如卿之言，济天下者，舍卿复谁？’相对而笑。儁为人外静而内明，不应州郡、三府之命。公车征，不到。避地居武陵，归儁者一百余家。帝之都许，复征为尚书，又不就。刘表见绍强，阴与绍通。儁谓表曰：‘曹公，天下之雄也！必能兴霸道，继桓、文之功者也。今乃释近而就远；如有一朝之急，遥望漠北之救，不亦难乎？’表不从。儁年六十四，以寿终于武陵。公闻而哀伤。及平荆州，自临江迎丧：改葬于江陵，表为先贤也。”","attribution":"皇甫谧《逸士传》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":13,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cf8a0075075368325cde","start":0,"end":328,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
