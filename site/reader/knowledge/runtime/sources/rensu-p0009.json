{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o047a","title":"曹操采枣祗韩浩议兴屯田","accounts":[{"id":"wudi-e-o047a-account","label":"正文","text":"曹操采用枣祗、韩浩等建议，开始推行屯田。","evidence":["wudi-e-o047a-q"]},{"id":"yuanzhang-a-d42fab507b5ae25f2704","label":"正文","text":"袁涣白太祖屯田宜顺民之意，太祖从之百姓大悦","evidence":["yuanzhang-q-eb7264c567ccb419c713"]},{"id":"yuanzhang-a-3e75e5d635aa703b34c1","label":"正文","text":"太祖欲广置屯田使国渊典其事，渊屡陈损益相土处民计民置吏明功课之法，五年中仓廪丰实","evidence":["yuanzhang-q-5f59791b711af6d8f180"]},{"id":"rensu-a-8e3cf9ba2f243df149f6","label":"正文","text":"枣祗建议建置屯田（时岁饥旱军食不足）","evidence":["rensu-q-eb157a835335512305f2"]},{"id":"rensu-a-c404988ef1b393cc63e0","label":"裴注·魏武故事","text":"破黄巾定许后得贼资业，当兴立屯田；时议者皆言当\"计牛输谷\"，佃科以定","evidence":["rensu-q-2896b220ddbfd8398ae0"]},{"id":"rensu-a-5cca460d954317d4f4a5","label":"裴注·魏武故事","text":"施行后枣祗白以为\"僦牛输谷，大收不增谷，有水旱灾除，大不便\"，反覆来说；曹操犹以为当如故","evidence":["rensu-q-dc1d182c299189b9db4f"]},{"id":"rensu-a-69ed3de8172192459920","label":"裴注·魏武故事","text":"曹操不知所从，使枣祗与荀令君（荀彧）议之","evidence":["rensu-q-8cce79dcc70862fa26e7"]},{"id":"rensu-a-1a4648ca7d7ec45f93f8","label":"裴注·魏武故事","text":"故军祭酒侯声云\"科取官牛，为官田计，如祗议：于官便，于客不便\"，怀此以疑令君","evidence":["rensu-q-115cc53b14dac13a0107"]},{"id":"rensu-a-dfd2a5b3c2ea67d47ba8","label":"裴注·魏武故事","text":"枣祗犹自信，据计画还白，执分田之术","evidence":["rensu-q-a023a92ed4ca3239e318"]},{"id":"rensu-a-0e924c1ae4e5ef74cf24","label":"裴注·魏武故事","text":"曹操然之，使枣祗为屯田都尉，施设田业；其时岁则大收，后遂因此大田，丰足军用","evidence":["rensu-q-c7c7db2c71c7099618b5"]}],"participants":[{"person":"cao-cao","role":"采议推行","evidence":["wudi-e-o047a-q"]},{"person":"wudi-p0127","role":"建议","evidence":["wudi-e-o047a-q"]},{"person":"wudi-p0128","role":"建议","evidence":["wudi-e-o047a-q"]},{"person":"wudi-p0308","role":"白太祖民安土重迁，乐之者乃取，不欲者勿强","evidence":["yuanzhang-q-eb7264c567ccb419c713"]},{"person":"wendi-p0054","role":"屡陈损益，相土处民，计民置吏，明功课之法，五年中仓廪丰实百姓竞劝乐业","evidence":["yuanzhang-q-5f59791b711af6d8f180"]},{"person":"wudi-p0100","role":"与议之令君；被惑之议者","evidence":["rensu-q-8cce79dcc70862fa26e7","rensu-q-115cc53b14dac13a0107"]},{"person":"rensu-p0009","role":"进言者","evidence":["rensu-q-115cc53b14dac13a0107"]}],"place":null,"time":{"label":"建安元年","year":196,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o047a-q","wudi-q-o040","wudi-q-b-16a5462151b1cfe5142d"],"chronology":"wudi-y196","dating_review":{"anchor":"wudi-q-o040","basis":"建安元年","reviewed":true}},"source_order":[1,285,"O047a"],"order":130}],"persons":[{"id":"rensu-p0009","name":"侯声","evidence":["rensu-q-115cc53b14dac13a0107"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[{"id":"rensu-q-115cc53b14dac13a0107","section":"chapter-016","block":"b-f7bf4f39640b854492a0","layer":"pei","quote":"时故军祭酒侯声云：‘科取官牛，为官田计，如祗议：于官便，于客不便。’声怀此云云，以疑令君","attribution":"裴注·魏武故事","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":17,"anchor":null},"note_id":"n-60f466d9d92c616eb2c9","start":221,"end":265},{"id":"rensu-q-2896b220ddbfd8398ae0","section":"chapter-016","block":"b-f7bf4f39640b854492a0","layer":"pei","quote":"及破黄巾，定许，得贼资业，当兴立屯田。时议者皆言当‘计牛输谷’，佃科以定","attribution":"裴注·魏武故事","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":17,"anchor":null},"note_id":"n-60f466d9d92c616eb2c9","start":111,"end":147},{"id":"rensu-q-8cce79dcc70862fa26e7","section":"chapter-016","block":"b-f7bf4f39640b854492a0","layer":"pei","quote":"孤不知所从，使与荀令君议之","attribution":"裴注·魏武故事","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":17,"anchor":null},"note_id":"n-60f466d9d92c616eb2c9","start":207,"end":220},{"id":"rensu-q-a023a92ed4ca3239e318","section":"chapter-016","block":"b-f7bf4f39640b854492a0","layer":"pei","quote":"祗犹自信，据计画还白，执分田之术","attribution":"裴注·魏武故事","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":17,"anchor":null},"note_id":"n-60f466d9d92c616eb2c9","start":266,"end":282},{"id":"rensu-q-c7c7db2c71c7099618b5","section":"chapter-016","block":"b-f7bf4f39640b854492a0","layer":"pei","quote":"孤乃然之，使为屯田都尉，施设田业。其时，岁则大收，后遂因此大田，丰足军用","attribution":"裴注·魏武故事","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":17,"anchor":null},"note_id":"n-60f466d9d92c616eb2c9","start":283,"end":319},{"id":"rensu-q-dc1d182c299189b9db4f","section":"chapter-016","block":"b-f7bf4f39640b854492a0","layer":"pei","quote":"施行后，祗白以为：‘僦牛输谷，大收不增谷，有水旱灾除，大不便。’反覆来说，孤犹以为当如故，大收，不可复改易","attribution":"裴注·魏武故事","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":17,"anchor":null},"note_id":"n-60f466d9d92c616eb2c9","start":148,"end":201},{"id":"rensu-q-eb157a835335512305f2","section":"chapter-016","block":"b-e04a88325a01db0dc84a","layer":"original","quote":"是时岁饥旱，军食不足；羽林监颍川枣祗，建置屯田","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":3,"anchor":null},"note_id":null,"start":0,"end":23},{"id":"wudi-e-o047a-q","section":"chapter-001","block":"b-bbb49ee5ce4b090e1111","layer":"original","quote":"是岁，用枣祗、韩浩等议〖5〗，始兴屯田〖6〗。﹝一﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":284,"anchor":null},"note_id":null,"start":0,"end":26},{"id":"wudi-q-b-16a5462151b1cfe5142d","section":"chapter-001","block":"b-16a5462151b1cfe5142d","layer":"modern","quote":"〖1〗建安元年：公元 196 年。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":264,"anchor":null},"note_id":"n-df2756e12f4ac1fef3c4","start":0,"end":17},{"id":"wudi-q-o040","section":"chapter-001","block":"b-c71d10ef121af30ac6b7","layer":"original","quote":"建安元年春正月〖1〗，太祖军临武平〖2〗。袁术所置陈相袁嗣，降。太祖将迎天子，诸将或疑；荀彧、程昱劝之。乃遣曹洪将兵西迎。卫将军董承与袁术将苌奴拒险〖3〗，洪不得进。汝南、颍川黄巾何仪、刘辟、黄邵、何曼等〖4〗，众各数万。初应袁术，又附孙坚〖5〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":258,"anchor":null},"note_id":null,"start":0,"end":124},{"id":"yuanzhang-q-5f59791b711af6d8f180","section":"chapter-011","block":"b-65d1896f1f9ded3e140d","layer":"original","quote":"太祖欲广置屯田，使渊典其事。渊屡陈损益，相土处民〖5〗，计民置吏；明功课之法〖6〗。五年中，仓廪丰实，百姓竞劝乐业","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":134,"anchor":null},"note_id":null,"start":0,"end":57},{"id":"yuanzhang-q-eb7264c567ccb419c713","section":"chapter-011","block":"b-12e51a7896aa63a3c457","layer":"original","quote":"涣白太祖曰：“夫民安土重迁，不可卒变；易以顺行，难以逆动；宜顺其意，乐之者乃取，不欲者勿强。”太祖从之，百姓大悦","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":22,"anchor":null},"note_id":null,"start":35,"end":91}],"profiles":{},"directory_counts":{}}
