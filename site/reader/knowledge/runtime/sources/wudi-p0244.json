nts":[{"person":"wuhuan-p-43fe6a894afcc9","role":"兵败走辽东、被辽东斩首传送者","evidence":["wuhuan-q-38c0eed0802d69399d32"]},{"person":"wudi-p0244","role":"兵败走辽东、被辽东斩首传送者","evidence":["wuhuan-q-38c0eed0802d69399d32"]},{"person":"wuhuan-p-37ee27cc27c055","role":"兵败走辽东、被辽东斩首传送者","evidence":["wuhuan-q-38c0eed0802d69399d32"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["wuhuan-q-38c0eed0802d69399d32"]},"ordering_evidence":"wuhuan-q-38c0eed0802d69399d32","order":6140}],"persons":[{"id":"wudi-p0244","name":"楼班","evidence":["wudi-q-o114","wuhuan-q-3575dddede24f50821df","wuhuan-q-38c0eed0802d69399d32","wuhuan-q-7dd8994935c6805db46c"],"facts":[{"id":"wuhuan-f-08a6ede490cb65ba02eb","text":"丘力居子。","evidence":["wuhuan-q-7dd8994935c6805db46c"]}],"aliases":[],"mentions":[{"id":"wudi-m-o114-wudi-p0244","kind":"mention","text":"文中提及","evidence":["wudi-q-o114"]}]}],"evidence":[{"id":"wudi-e-o114b-q","section":"chapter-001","block":"b-450f7815dc8f8edb5b1d","layer":"original","quote":"未至二百里，虏乃知之。尚、熙与蹋顿、辽西单于楼班、右北平单于能臣抵之等〖10〗，将数万骑逆军。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":633,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":87,"end":134,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-fbc277caaf5ad8b958df","section":"chapter-001","block":"b-fbc277caaf5ad8b958df","layer":"modern","quote":"〖1〗十二年：建安十二年（公元 207）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":623,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-20efb4f3aff50357a189","start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o111","section":"chapter-001","block":"b-01eaf58b917a530c61d5","layer":"original","quote":"十二年春二月〖1〗，公自淳于还邺。丁酉〖2〗，令曰：“吾起义兵诛暴乱，于今十九年；所征必克，岂吾功哉？乃贤士大夫之力也！天下虽未悉定，吾当要与贤士大夫共定之；而专享其劳〖3〗，吾何以安焉？其促定功行封〖4〗。”于是大封功臣二十余人，皆为列侯；其余各以次受封；及复死事之孤〖5〗：轻重各有差〖6〗。﹝一﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":621,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":151,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o114","section":"chapter-001","block":"b-450f7815dc8f8edb5b1d","layer":"original","quote":"秋七月，大水，傍海道不通；田畴请为乡导〖3〗，公从之。引军出卢龙塞〖4〗，塞外道绝不通。乃堑山堙谷五百余里〖5〗，经白檀〖6〗，历平冈〖7〗；涉鲜卑庭〖8〗，东指柳城〖9〗。未至二百里，虏乃知之。尚、熙与蹋顿、辽西单于楼班、右北平单于能臣抵之等〖10〗，将数万骑逆军。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":633,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":134,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-3575dddede24f50821df","section":"chapter-030","block":"b-228521c23fcc33c40b25","layer":"original","quote":"后楼班大，峭王率其部众奉楼班为单于；蹋顿为王，然蹋顿多画计策","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":43,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":122,"end":152,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-38c0eed0802d69399d32","section":"chapter-030","block":"b-2a3e7083cec67ed88076","layer":"original","quote":"速附丸、楼班、乌延等，走辽东〖11〗；辽东悉斩，传送其首","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":45,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":102,"end":130,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-7dd8994935c6805db46c","section":"chapter-030","block":"b-228521c23fcc33c40b25","layer":"original","quote":"灵帝末，以刘虞为幽州牧〖2〗；募胡斩纯首，北州乃定。后丘力居死，子楼班年小。从子蹋顿有武略，代立；总摄三王部，众皆从其教令。袁绍与公孙瓒连战不决；蹋顿遣使诣绍求和亲，助绍击瓒，破之。绍矫制赐蹋顿、（难）峭王、汗鲁王印绶〖3〗，皆以为单于。﹝一﹞后楼班大，峭王率其部众奉楼班为单于；蹋顿为王，然蹋顿多画计策。","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":43,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":153,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
