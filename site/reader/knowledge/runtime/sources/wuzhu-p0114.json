{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wuzhu-e-o137a","title":"聂友陆凯率三万讨珠崖儋耳","accounts":[{"id":"wuzhu-e-o137a-account","label":"《吴主传第二》正文","text":"聂友陆凯率三万讨珠崖儋耳","evidence":["wuzhu-e-o137a-q"]}],"participants":[{"person":"wuzhu-p0114","role":"征讨","evidence":["wuzhu-e-o137a-q"]},{"person":"wuzhu-p0115","role":"征讨","evidence":["wuzhu-e-o137a-q"]}],"place":null,"time":{"year":242,"label":"秋七月至八月","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"wuzhu-y242","dating_review":{"reviewed":true,"anchor":"wuzhu-q-o135","basis":"秋七月至八月"},"evidence":["wuzhu-e-o137a-q","wuzhu-q-o135","shaodi-q-o015","shaodi-q-b-f25c29f875d80e25ad66"]},"ordering_evidence":"wuzhu-e-o137a-q","source_order":[47,707,"O137a"],"order":8363},{"id":"santizhu064-e-sr-nieyou-letter","title":"聂友书谏恪宜按兵养锐","accounts":[{"id":"santizhu064-a-fcae1a642b02a0a669a4","label":"正文","text":"丹杨太守聂友素与恪善，书谏：成先帝遏东关之志已有非常之功，宜且按兵养锐观衅而动，今乘势复大出天时未可而苟任盛意，私心以为不安","evidence":["santizhu064-q-9e8934f92344ed0c3b5d"]}],"participants":[{"person":"wuzhu-p0114","role":"书谏诸葛恪","evidence":["santizhu064-q-9e8934f92344ed0c3b5d"]},{"person":"shaodi-p0041","role":"受谏者","evidence":["santizhu064-q-9e8934f92344ed0c3b5d"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"未由相邻段落推算纪年；原文时间表达保留在来源引句中。","evidence":["santizhu064-q-9e8934f92344ed0c3b5d"]},"ordering_evidence":"santizhu064-q-9e8934f92344ed0c3b5d","source_order":[64,233,0],"order":10958},{"id":"santizhu064-e-sr-nieyou-letter-yin","title":"聂友知恪将败、书与滕胤悲叹","accounts":[{"id":"santizhu064-a-ec8c87c984477eb75a7a","label":"正文","text":"恪退军还，聂友知其将败，书与滕胤曰当人强盛河山可拔、一朝羸缩人情万端，言之悲叹","evidence":["santizhu064-q-6f977c582e5f6fc2fd9f"]}],"participants":[{"person":"wuzhu-p0114","role":"书与滕胤","evidence":["santizhu064-q-6f977c582e5f6fc2fd9f"]},{"person":"santizhu-p0005","role":"受书者","evidence":["santizhu064-q-6f977c582e5f6fc2fd9f"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"未由相邻段落推算纪年；原文时间表达保留在来源引句中。","evidence":["santizhu064-q-6f977c582e5f6fc2fd9f"]},"ordering_evidence":"santizhu064-q-6f977c582e5f6fc2fd9f","source_order":[64,350,0],"order":10983},{"id":"santizhu064-e-sr-nieyou-ostracism","title":"峻忌聂友、欲授郁林太守、友发病忧死","accounts":[{"id":"santizhu064-a-bbe118a32e6cf09bc283","label":"正文","text":"恪诛后孙峻忌聂友，欲以为郁林太守；友发病，忧死","evidence":["santizhu064-q-371ad14a6b56214913c3"]}],"participants":[{"person":"shaodi-p0075","role":"忌友欲出为郁林太守","evidence":["santizhu064-q-371ad14a6b56214913c3"]},{"person":"wuzhu-p0114","role":"发病忧死","evidence":["santizhu064-q-371ad14a6b56214913c3"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"未由相邻段落推算纪年；原文时间表达保留在来源引句中。","evidence":["santizhu064-q-371ad14a6b56214913c3"]},"ordering_evidence":"santizhu064-q-371ad14a6b56214913c3","source_order":[64,351,0],"order":10984}],"persons":[{"id":"wuzhu-p0114","name":"聂友","evidence":["wuzhu-q-o137","santizhu064-q-57c726ad65446bd7dea3","santizhu064-q-6f98de729bd97183e9ae"],"facts":[{"id":"santizhu064-f-sr-048","text":"字文悌，豫章人；《吴录》称友有唇吻少为县吏，虞翻徙交州县令使友送之，翻奇之为书豫章太守谢斐荐为功曹；使至都诸葛恪友之，时论谓顾子嘿子直其间无所复容，恪欲以友居其间由是知名；后为将讨儋耳，还拜丹杨太守，年五十三卒","evidence":["santizhu064-q-6f98de729bd97183e9ae"]}],"aliases":[],"mentions":[{"id":"wuzhu-m-o137-wuzhu-p0114","kind":"mention","text":"文中提及","evidence":["wuzhu-q-o137"]}]}],"evidence":[{"id":"santizhu064-q-371ad14a6b56214913c3","section":"chapter-064","block":"b-fe6c3b22c8a1d262004e","layer":"original","quote":"恪诛后，孙峻忌友，欲以为郁林太守；友发病，忧死。友字文悌，豫章人也〖3〗。﹝一﹞","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":350,"anchor":null},"note_id":null,"start":0,"end":40},{"id":"santizhu064-q-57c726ad65446bd7dea3","section":"chapter-064","block":"b-d78592e145dbc33cf518","layer":"original","quote":"丹杨太守聂友素与恪善，书谏恪曰","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":232,"anchor":null},"note_id":null,"start":0,"end":15},{"id":"santizhu064-q-6f977c582e5f6fc2fd9f","section":"chapter-064","block":"b-96a65b7a6a73cbfff8f8","layer":"original","quote":"始，恪退军还。聂友知其将败，书与滕胤曰：“当人强盛，河山可拔；一朝羸缩〖1〗，人情万端〖2〗。言之悲叹！”","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":349,"anchor":null},"note_id":null,"start":0,"end":53},{"id":"santizhu064-q-6f98de729bd97183e9ae","section":"chapter-064","block":"b-0d7675edad018d804359","layer":"pei","quote":"﹝一﹞《吴录》曰：“友有唇吻，少为县吏。虞翻徙交州，县令使友送之。翻与语而奇焉，为书与豫章太守谢斐，令以为功曹。郡时现有功曹，斐见之，问曰：‘县吏聂友，可堪何职？’对曰：‘此人县间小吏耳，犹可堪曹佐。’斐曰：‘论者以为宜作功曹，君其避之。’乃用为功曹。使至都，诸葛恪友之。时论谓‘顾子嘿、子直其间无所复容’，恪欲以友居其间，由是知名。后为将，讨儋耳，还拜丹杨太守，年五十三卒。”","attribution":"裴注·吴录","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":356,"anchor":null},"note_id":"n-eddd8402c191dbf7cc0e","start":0,"end":189},{"id":"santizhu064-q-9e8934f92344ed0c3b5d","section":"chapter-064","block":"b-d78592e145dbc33cf518","layer":"original","quote":"丹杨太守聂友素与恪善，书谏恪曰：“大行皇帝本有遏东关之计，计未施行。今公辅赞大业〖1〗，成先帝之志；寇远自送，将士凭赖威德，出身用命〖2〗：一旦有非常之功〖3〗，岂非宗庙神灵社稷之福邪！宜且按兵养锐，观衅而动。今乘此势，欲复大出；天时未可，而苟任盛意：私心以为不安。”","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":232,"anchor":null},"note_id":null,"start":0,"end":134},{"id":"shaodi-q-b-f25c29f875d80e25ad66","section":"chapter-004","block":"b-f25c29f875d80e25ad66","layer":"modern","quote":"〖1〗三年：正始三年（公元 242）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":84,"anchor":null},"note_id":"n-0c94d6c7ec4663a4ff7d","start":0,"end":19},{"id":"shaodi-q-o015","section":"chapter-004","block":"b-928dff832b77cf5f2f14","layer":"original","quote":"三年春正月〖1〗，东平王徽薨〖2〗。三月，太尉满宠薨。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":71,"anchor":null},"note_id":null,"start":0,"end":27},{"id":"wuzhu-e-o137a-q","section":"chapter-047","block":"b-fb43c4f02a5cae882f38","layer":"original","quote":"秋七月，遣将军聂友、校尉陆凯，以兵三万讨珠崖儋耳〖8〗。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":195,"anchor":null},"note_id":null,"start":0,"end":28},{"id":"wuzhu-q-o135","section":"chapter-047","block":"b-692e948ed8fd30650c98","layer":"original","quote":"五年春正月〖1〗，立子和为太子〖2〗。大赦，改禾兴为嘉兴。百官奏立皇后及四王，诏曰：“今天下不定，民物劳瘁〖3〗；且有功者或未录，饥寒者尚未恤；猥割土壤以丰子弟〖4〗，崇爵位以宠妃妾：孤甚不取。其释此议。”三月，海盐县言黄龙现〖5〗。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":193,"anchor":null},"note_id":null,"start":0,"end":117},{"id":"wuzhu-q-o137","section":"chapter-047","block":"b-fb43c4f02a5cae882f38","layer":"original","quote":"秋七月，遣将军聂友、校尉陆凯，以兵三万讨珠崖儋耳〖8〗。是岁大疫。有司又奏立后及诸王。八月，立子霸为鲁王〖9〗。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":195,"anchor":null},"note_id":null,"start":0,"end":56}],"profiles":{},"directory_counts":{}}
