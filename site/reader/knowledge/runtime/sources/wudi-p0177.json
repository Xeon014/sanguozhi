{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o073a","title":"袁绍遣军围白马","accounts":[{"id":"wudi-e-o073a-account","label":"正文","text":"袁绍遣郭图、淳于琼、颜良攻白马刘延，自至黎阳准备渡河。","evidence":["wudi-e-o073a-q"]},{"id":"chengguo-a-aadf0aad8e15ce945a92","label":"正文","text":"袁绍遣颜良攻东郡","evidence":["chengguo-q-4b38bb4beccdfc00ad0c"]}],"participants":[{"person":"wudi-p0052","role":"遣军","evidence":["wudi-e-o073a-q"]},{"person":"wudi-p0174","role":"攻白马","evidence":["wudi-e-o073a-q"]},{"person":"wudi-p0175","role":"攻白马","evidence":["wudi-e-o073a-q"]},{"person":"wudi-p0176","role":"攻白马","evidence":["wudi-e-o073a-q"]},{"person":"wudi-p0177","role":"被围","evidence":["wudi-e-o073a-q"]}],"place":{"text":"白马、黎阳","evidence":["wudi-e-o073a-q"]},"time":{"label":"建安五年二月","year":200,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o073a-q","wudi-q-o071","wudi-q-b-9900125064e5d85f08ad"],"chronology":"wudi-y200","dating_review":{"anchor":"wudi-q-o071","basis":"建安五年二月","reviewed":true}},"source_order":[1,411,"O073a"],"order":177},{"id":"wudi-e-o074a","title":"曹操解白马围并斩颜良","accounts":[{"id":"wudi-e-o074a-account","label":"正文","text":"曹操用荀攸声东击西之策，使袁绍分兵，轻军趋白马，以张辽、关羽为前锋破颜良并斩之，迁民西行。","evidence":["wudi-e-o074a-q"]},{"id":"guanzhang-e-o003b-account","label":"《关张马黄赵传第六》正文","text":"关羽张辽先锋击颜良关羽刺斩解白马围封汉寿亭侯","evidence":["guanzhang-e-o003b-q"]},{"id":"xunyu-e-o042a-account","label":"《荀彧荀攸贾诩传第十》正文","text":"荀攸策解白马斩颜良","evidence":["xunyu-e-o042a-q"]},{"id":"dongyuan-e-o048c-account","label":"《董二袁刘传第六》正文","text":"曹操救刘延，击破斩颜良。","evidence":["dongyuan-e-o048c-q"]}],"participants":[{"person":"cao-cao","role":"救援","evidence":["wudi-e-o074a-q"]},{"person":"wudi-p0143","role":"献策","evidence":["wudi-e-o074a-q"]},{"person":"wudi-p0052","role":"分兵","evidence":["wudi-e-o074a-q"]},{"person":"wudi-p0176","role":"战败被斩","evidence":["wudi-e-o074a-q"]},{"person":"wudi-p0178","role":"前锋","evidence":["wudi-e-o074a-q"]},{"person":"wudi-p0172","role":"前锋","evidence":["wudi-e-o074a-q"]},{"person":"wudi-p0177","role":"获救","evidence":["wudi-e-o074a-q"]}],"place":{"text":"延津、白马","evidence":["wudi-e-o074a-q"]},"time":{"label":"建安五年夏四月","year":200,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o074a-q","wudi-q-o071","wudi-q-b-9900125064e5d85f08ad"],"chronology":"wudi-y200","dating_review":{"anchor":"wudi-q-o071","basis":"建安五年夏四月","reviewed":true}},"source_order":[1,412,"O074a"],"order":178},{"id":"dongyuan-e-o048a","title":"袁绍遣颜良攻刘延沮授谏独任不从","accounts":[{"id":"dongyuan-e-o048a-account","label":"《董二袁刘传第六》正文","text":"袁绍遣颜良攻刘延沮授谏独任不从","evidence":["dongyuan-e-o048a-q"]}],"participants":[{"person":"wudi-p0052","role":"遣军","evidence":["dongyuan-e-o048a-q"]},{"person":"wudi-p0176","role":"攻城战死","evidence":["dongyuan-e-o048a-q"]},{"person":"wudi-p0177","role":"守城","evidence":["dongyuan-e-o048a-q"]},{"person":"wudi-p0218","role":"谏诤","evidence":["dongyuan-e-o048a-q"]}],"place":null,"time":{"year":200,"label":"白马延津战时","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"dongyuan-y200","dating_review":{"reviewed":true,"anchor":"dongyuan-q-o046","basis":"白马延津战时"},"evidence":["dongyuan-e-o048a-q","dongyuan-q-o046","xiahoucao-q-p009","wuzhu-q-o004","sunshi-q-o034","xunyu-q-o020","xunyu-q-b-3c961618b484f81c3582"]},"ordering_evidence":"dongyuan-e-o048a-q","source_order":[6,307,"O048a"],"order":1669}],"persons":[{"id":"wudi-p0177","name":"刘延","evidence":["wudi-q-o073","guanzhang-q-o003","xunyu-q-o042","dongyuan-q-o048"],"facts":[],"aliases":[],"mentions":[{"id":"wudi-m-o073-wudi-p0177","kind":"mention","text":"文中提及","evidence":["wudi-q-o073"]},{"id":"wudi-m-o074-wudi-p0177","kind":"mention","text":"文中提及","evidence":["wudi-q-o074"]},{"id":"guanzhang-m-o003-wudi-p0177","kind":"mention","text":"文中提及","evidence":["guanzhang-q-o003"]},{"id":"xunyu-m-o042-wudi-p0177","kind":"mention","text":"文中提及","evidence":["xunyu-q-o042"]},{"id":"dongyuan-m-o048-wudi-p0177","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o048"]}]}],"evidence":[{"id":"chengguo-q-4b38bb4beccdfc00ad0c","section":"chapter-014","block":"b-546398c9e99f491661e8","layer":"original","quote":"袁绍遣将颜良攻东郡，","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":178,"anchor":null},"note_id":null,"start":92,"end":102},{"id":"dongyuan-e-o048a-q","section":"chapter-006","block":"b-839daef927a1c0dd9463","layer":"original","quote":"绍进军黎阳，遣颜良攻刘延于白马。沮授又谏绍：“良性促狭〖1〗，虽骁勇，不可独任！”绍不听。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":306,"anchor":null},"note_id":null,"start":0,"end":45},{"id":"dongyuan-e-o048c-q","section":"chapter-006","block":"b-839daef927a1c0dd9463","layer":"original","quote":"太祖救延，与良战，破斩良。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":306,"anchor":null},"note_id":null,"start":45,"end":58},{"id":"dongyuan-q-o046","section":"chapter-006","block":"b-c25c6aad78e1f784d5f8","layer":"original","quote":"建安五年，太祖自东征备〖1〗。田丰说绍，袭太祖后〖2〗；绍辞以子疾，不许〖3〗。丰举杖击地曰：“夫遭难遇之机，而以婴儿之病失其会。惜哉！”","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":297,"anchor":null},"note_id":null,"start":0,"end":69},{"id":"dongyuan-q-o048","section":"chapter-006","block":"b-839daef927a1c0dd9463","layer":"original","quote":"绍进军黎阳，遣颜良攻刘延于白马。沮授又谏绍：“良性促狭〖1〗，虽骁勇，不可独任！”绍不听。太祖救延，与良战，破斩良。﹝一﹞绍渡河，壁延津南〖2〗；使刘备、文丑挑战。太祖击破之，斩丑。再战，擒绍大将，绍军大震。﹝二﹞","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":306,"anchor":null},"note_id":null,"start":0,"end":107},{"id":"guanzhang-e-o003b-q","section":"chapter-036","block":"b-8598d8002cca4ca06d2c","layer":"original","quote":"绍遣大将（军）颜良，攻东郡太守刘延于白马。曹公使张辽及羽为先锋击之。羽望见良麾盖〖2〗，策马刺良于万众之中，斩其首还；绍诸将莫能当者，遂解白马围。曹公即表封羽为汉寿亭侯。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":9,"anchor":null},"note_id":null,"start":34,"end":119},{"id":"guanzhang-q-o003","section":"chapter-036","block":"b-8598d8002cca4ca06d2c","layer":"original","quote":"建安五年，曹公东征，先主奔袁绍。曹公擒羽以归，拜为偏将军，礼之甚厚。绍遣大将（军）颜良，攻东郡太守刘延于白马。曹公使张辽及羽为先锋击之。羽望见良麾盖〖2〗，策马刺良于万众之中，斩其首还；绍诸将莫能当者，遂解白马围。曹公即表封羽为汉寿亭侯。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":9,"anchor":null},"note_id":null,"start":0,"end":119},{"id":"sunshi-q-o034","section":"chapter-046","block":"b-8480cc17db549540a4f6","layer":"original","quote":"建安五年，曹公与袁绍相拒于官渡〖1〗。策阴欲袭许〖2〗，迎汉帝〖3〗；﹝一﹞密治兵，部署诸将。未发，会为故吴郡太守许贡客所杀〖4〗。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":260,"anchor":null},"note_id":null,"start":0,"end":66},{"id":"wudi-e-o073a-q","section":"chapter-001","block":"b-bdf74b1bb7e00110c2b0","layer":"original","quote":"二月，绍遣郭图、淳于琼、颜良攻东郡太守刘延于白马〖1〗；绍引兵至黎阳，将渡河。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":410,"anchor":null},"note_id":null,"start":0,"end":39},{"id":"wudi-e-o074a-q","section":"chapter-001","block":"b-d459f6854c24b119312f","layer":"original","quote":"夏四月，公北救延。荀攸说公曰：“今兵少，不敌，分其势乃可。公到延津〖2〗，若将渡兵向其后者，绍必西应之。然后轻兵袭白马，掩其不备〖3〗；颜良可擒也。”公从之。绍闻兵渡，即分兵西应之。公乃引军兼行趋白马〖4〗。未至十余里，良大惊，来逆战。使张辽、关羽前登〖5〗，击破，斩良；遂解白马围，徙其民，循河而西。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":411,"anchor":null},"note_id":null,"start":0,"end":151},{"id":"wudi-q-b-9900125064e5d85f08ad","section":"chapter-001","block":"b-9900125064e5d85f08ad","layer":"modern","quote":"〖1〗五年：建安五年（公元 200）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":403,"anchor":null},"note_id":"n-744e4aee7f5ff14cca85","start":0,"end":19},{"id":"wudi-q-o071","section":"chapter-001","block":"b-c9f735ddad48a8f5c2b6","layer":"original","quote":"五年春正月〖1〗，董承等谋泄，皆伏诛。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":400,"anchor":null},"note_id":null,"start":0,"end":19},{"id":"wudi-q-o073","section":"chapter-001","block":"b-bdf74b1bb7e00110c2b0","layer":"original","quote":"二月，绍遣郭图、淳于琼、颜良攻东郡太守刘延于白马〖1〗；绍引兵至黎阳，将渡河。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":410,"anchor":null},"note_id":null,"start":0,"end":39},{"id":"wudi-q-o074","section":"chapter-001","block":"b-d459f6854c24b119312f","layer":"original","quote":"夏四月，公北救延。荀攸说公曰：“今兵少，不敌，分其势乃可。公到延津〖2〗，若将渡兵向其后者，绍必西应之。然后轻兵袭白马，掩其不备〖3〗；颜良可擒也。”公从之。绍闻兵渡，即分兵西应之。公乃引军兼行趋白马〖4〗。未至十余里，良大惊，来逆战。使张辽、关羽前登〖5〗，击破，斩良；遂解白马围，徙其民，循河而西。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":411,"anchor":null},"note_id":null,"start":0,"end":151},{"id":"wuzhu-q-o004","section":"chapter-047","block":"b-d714325f2e71e77ac236","layer":"original","quote":"五年〖2〗，策薨，以事授权；权哭，未及息，策长史张昭谓权曰：“孝廉！此宁哭时邪〖3〗？且周公立法，而伯禽不师〖4〗；非欲违父，时不得行也〖5〗。﹝一﹞况今奸宄竞逐〖6〗，豺狼满道；乃欲哀亲戚，顾礼制；是犹开门而揖盗〖7〗，未可以为仁也！”乃改易权服〖8〗，扶令上马，使出巡军。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":16,"anchor":null},"note_id":null,"start":0,"end":138},{"id":"xiahoucao-q-p009","section":"chapter-009","block":"b-94b2d845b1656ec51166","layer":"pei","quote":"﹝一﹞《魏略》曰：“霸字仲权。渊为蜀所害，故霸常切齿，欲有报蜀意。黄初中，为偏将军。子午之役，霸召为前锋；进至兴势围，安营在曲谷中。蜀人望知其是霸也，指下兵攻之。霸手战鹿角间，赖救至，然后解。后为右将军，屯陇西。其养士、和戎，并得其欢心。至正始中，代夏侯儒为征蜀护军，统属征西：时征西将军夏侯玄，于霸为从子；而玄于曹爽为外弟。及司马宣王诛曹爽，遂召玄，玄来东。霸闻曹爽被诛而玄又征，以为祸必转相及，心既内恐；又霸先与雍州刺史郭淮不和，而淮代玄为征西；霸尤不安，故遂奔蜀。南趋阴平而失道，入穷谷中。粮尽，杀马步行。足破，卧岩石上；使人求道，未知何之。蜀闻之，乃使人迎霸。初，建安五年，时霸从妹，年十三四，在本郡。出行樵采，为张飞所得。飞知其良家女，遂以为妻；产息女，为刘禅皇后。故渊之初亡，飞妻请而葬之。及霸入蜀，禅与相见，释之曰：‘卿父自遇害于行间耳，非我先人之手刃也。’指其儿子以示之曰：‘此夏侯氏之甥也。’厚加爵宠。”","attribution":"《魏略》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":101,"anchor":null},"note_id":"n-25ffcef69065f027e431","start":0,"end":411},{"id":"xunyu-e-o042a-q","section":"chapter-010","block":"b-c726b53542d9123e59fd","layer":"original","quote":"后从救刘延于白马，攸画策斩颜良。语在《武纪》。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":220,"anchor":null},"note_id":null,"start":0,"end":23},{"id":"xunyu-q-b-3c961618b484f81c3582","section":"chapter-010","block":"b-3c961618b484f81c3582","layer":"modern","quote":"〖3〗五年：建安五年（公元 200）。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":115,"anchor":null},"note_id":"n-3bbb3ef01ba77a895b2f","start":0,"end":19},{"id":"xunyu-q-o020","section":"chapter-010","block":"b-ae8147f907358950d8ac","layer":"original","quote":"五年〖3〗，与绍连战。太祖保官渡，绍围之；太祖军粮方尽，书与彧，议欲还许，以引绍〖4〗。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":110,"anchor":null},"note_id":null,"start":0,"end":44},{"id":"xunyu-q-o042","section":"chapter-010","block":"b-c726b53542d9123e59fd","layer":"original","quote":"后从救刘延于白马，攸画策斩颜良。语在《武纪》。太祖拔白马还，遣辎重循河而西。袁绍渡河追，猝与太祖遇。诸将皆恐，说太祖还保营。攸曰：“此所以（擒）〔饵〕敌〖1〗，奈何去之？”太祖目攸而笑，遂以辎重饵贼；贼竞奔之，阵乱。乃纵步骑击，大破之，斩其骑将文丑。太祖遂与绍相拒于官渡。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":220,"anchor":null},"note_id":null,"start":0,"end":136}],"profiles":{},"directory_counts":{}}
