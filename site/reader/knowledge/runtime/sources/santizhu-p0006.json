{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"shaodi-e-o054b","title":"诸葛恪东关大破魏军","accounts":[{"id":"shaodi-e-o054b-account","label":"《三少帝纪》正文","text":"诸葛恪东关大破魏军","evidence":["shaodi-e-o054b-q"]},{"id":"wgc-a-1-e7","label":"正文","text":"诸葛诞战于东关不利","evidence":["wgc-q0219","wgc-q0016"]},{"id":"wgc-a-1-e41","label":"正文","text":"诸葛恪兴东关诸葛诞讨之战不利","evidence":["wgc-q0255","wgc-q0023"]},{"id":"huanchen-a-14d91a4a72d37bd594e7","label":"正文","text":"嘉平中桓嘉以乐安太守与吴战东关军败没","evidence":["huanchen-q-ec00d526cbc1ee2d8466"]},{"id":"yuanzhang-a-5b06a8511d59b140ada4","label":"裴注·晋书","text":"司马文王为安东时王仪为司马，东关之败后问谁任其咎，仪曰责在军帅，文王怒遂杀之","evidence":["yuanzhang-q-075d09466ebaf4ebd6c6"]}],"participants":[{"person":"shaodi-p0041","role":"拒战","evidence":["shaodi-e-o054b-q"]},{"person":"shaodi-p0044","role":"战于东关不利","evidence":["wgc-q0219","wgc-q0016"]},{"person":"santizhu-p0006","role":"以乐安太守与吴战于东关、军败没、谥壮侯","evidence":["huanchen-q-ec00d526cbc1ee2d8466"]},{"person":"huanchen-p0030","role":"嗣","evidence":["huanchen-q-ec00d526cbc1ee2d8466"]},{"person":"shaodi-p0045","role":"为安东，东关之败后问近日之事谁任其咎，怒曰司马欲委罪于孤邪，遂杀王仪","evidence":["yuanzhang-q-075d09466ebaf4ebd6c6"]},{"person":"yuanzhang-p0054","role":"为司马，答责在军帅，被杀","evidence":["yuanzhang-q-075d09466ebaf4ebd6c6"]}],"place":{"text":"东关","evidence":["shaodi-q-o054"]},"time":{"year":252,"label":"十二月","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"shaodi-y252","dating_review":{"reviewed":true,"anchor":"shaodi-q-o052","basis":"十二月"},"evidence":["shaodi-e-o054b-q","shaodi-q-o052","shaodi-q-b-20272e7cc5379b3fe346"]},"ordering_evidence":"shaodi-e-o054b-q","source_order":[4,213,"O054b"],"related_events":[{"event":"wangwei-e-42a5df79cfa25c03ecf9","type":"alternative","evidence":["wangwei-q-eb7155e684829da3d57d","shaodi-e-o054b-q"]}],"order":1087},{"id":"huanchen-e-o106a","title":"桓嘉嗣尚升迁亭公主桓纂赐爵","accounts":[{"id":"huanchen-a-d9f8a56ac8eb70d0541f","label":"正文","text":"桓嘉嗣尚升迁亭公主桓纂赐爵","evidence":["huanchen-q-45276c27062a15cba808"]}],"participants":[{"person":"santizhu-p0006","role":"嗣、尚升迁亭公主","evidence":["huanchen-q-45276c27062a15cba808"]},{"person":"huanchen-p0029","role":"为散骑侍郎赐爵关内侯","evidence":["huanchen-q-45276c27062a15cba808"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["huanchen-q-45276c27062a15cba808"]},"ordering_evidence":"huanchen-q-45276c27062a15cba808","source_order":[22,26,0],"order":4494},{"id":"santizhu-e-o007f","title":"诸葛恪赴援东兴戊午交战大破魏军","accounts":[{"id":"santizhu-a-18665e6f5decf439d8f2","label":"正文","text":"诸葛恪赴援东兴戊午交战大破魏军","evidence":["santizhu-q-8812753a9ed1bf501f17"]},{"id":"santizhu064-a-3ec507660e3f43424f78","label":"正文","text":"恪兴军四万晨夜赴救东兴，遣留赞、吕据、唐咨、丁奉为前部；雪中解甲缘遏鼓噪，魏军争渡浮桥，桥坏自溺死者数万，桓嘉并没，斩故叛将韩综，获资器山积而还","evidence":["santizhu064-q-c0aaa14c0306cbe5684d"]},{"id":"hequan-a-d5028d0d76fb7c0b2aa5","label":"裴注·《吴书》","text":"东关之役全绪与丁奉建议引兵先出破魏军","evidence":["hequan-q-ae4ded7244b535b59ef0"]},{"id":"chenghuang-a-f5817e61cfb8c3186c99","label":"正文","text":"东兴之役综为前锋军败身死恪斩首白庙","evidence":["chenghuang-q-6a6c8553c5614eb1ca01"]},{"id":"chenghuang-a-fe57b12b518a30474084","label":"正文","text":"东兴雪中奋短兵大破魏前屯","evidence":["chenghuang-q-1da7562bc4ca7ae07bed"]},{"id":"zhulv-a-433c35e0cba0625c4782","label":"正文","text":"魏出东兴，据赴讨有功","evidence":["zhulv-q-305b4439281ed74f2920"]},{"id":"zhulv-a-9a1f642773fb323a3b31","label":"正文","text":"是岁，魏遣胡遵、诸葛诞等出东兴；异督水军攻浮梁，坏之，魏军大破","evidence":["zhulv-q-77551a11b8ee4f203b3f"]}],"participants":[{"person":"shaodi-p0041","role":"率军赴援并于东兴交战","evidence":["santizhu-q-8812753a9ed1bf501f17"]},{"person":"wuzhu-p0056","role":"被杀的魏将","evidence":["santizhu-q-8812753a9ed1bf501f17"]},{"person":"santizhu-p0006","role":"被杀的魏将","evidence":["santizhu-q-8812753a9ed1bf501f17"]},{"person":"shaodi-p0076","role":"为前部，解甲缘遏先登","evidence":["santizhu064-q-c0aaa14c0306cbe5684d"]},{"person":"wuzhu-p0088","role":"为前部","evidence":["santizhu064-q-c0aaa14c0306cbe5684d"]},{"person":"santizhu-p0017","role":"为前部，解甲缘遏先登","evidence":["santizhu064-q-c0aaa14c0306cbe5684d"]},{"person":"hequan-p0007","role":"与丁奉建议引兵先出、破魏军、封一子亭侯","evidence":["hequan-q-ae4ded7244b535b59ef0"]},{"person":"wuzhu-p0127","role":"会至，魏军遂溃","evidence":["chenghuang-q-1da7562bc4ca7ae07bed"]},{"person":"mingdi-p0033","role":"出东兴者","evidence":["zhulv-q-77551a11b8ee4f203b3f"]},{"person":"shaodi-p0044","role":"出东兴者","evidence":["zhulv-q-77551a11b8ee4f203b3f"]},{"person":"wuzhu-p0126","role":"督水军坏浮梁者","evidence":["zhulv-q-77551a11b8ee4f203b3f"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["santizhu-q-8812753a9ed1bf501f17"]},"ordering_evidence":"santizhu-q-8812753a9ed1bf501f17","source_order":[48,7,102],"order":8433}],"persons":[{"id":"santizhu-p0006","name":"桓嘉","evidence":["santizhu-q-8812753a9ed1bf501f17","huanchen-q-45276c27062a15cba808","huanchen-q-ca0c985e4117c412d1b5"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[{"id":"chenghuang-q-1da7562bc4ca7ae07bed","section":"chapter-055","block":"b-f6550e25d92fd67b6b52","layer":"original","quote":"天寒，雪，敌诸将置酒高会。奉见其前部兵少，相谓曰：“取封侯爵赏，正在今日！”乃使兵解铠著胄，持短兵〖7〗。敌人从而笑焉，不为设备。奉纵兵斫之，大破敌前屯；会据等至，魏军遂溃。迁灭寇将军〖8〗，进封都（亭）〔乡〕侯","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":356,"anchor":null},"note_id":null,"start":0,"end":106},{"id":"chenghuang-q-6a6c8553c5614eb1ca01","section":"chapter-055","block":"b-87fe2456927ad072130b","layer":"original","quote":"东兴之役〖15〗，综为前锋，军败身死。诸葛恪斩送其首，以白权庙","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":59,"anchor":null},"note_id":null,"start":26,"end":57},{"id":"hequan-q-ae4ded7244b535b59ef0","section":"chapter-060","block":"b-6c5f593279f7e62e0019","layer":"pei","quote":"东关之役，绪与丁奉，建议引兵先出；以破魏军，封一子亭侯","attribution":"裴注·《吴书》","section_title":"贺全吕周钟离传第十五","source":{"file":"OEBPS/Text/titlepage_0127.xhtml","index":159,"anchor":null},"note_id":"n-745969b04e6140fa105c","start":49,"end":76},{"id":"huanchen-q-45276c27062a15cba808","section":"chapter-022","block":"b-54b50034ba4196132eac","layer":"original","quote":"子嘉嗣。以阶弟纂为散骑侍郎，赐爵关内侯。嘉尚升迁亭公主〖24〗","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":25,"anchor":null},"note_id":null,"start":0,"end":31},{"id":"huanchen-q-ca0c985e4117c412d1b5","section":"chapter-022","block":"b-54b50034ba4196132eac","layer":"original","quote":"会嘉平中，以乐安太守与吴战于东关〖25〗；军败，没〖26〗。谥曰壮侯。子翊嗣","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":25,"anchor":null},"note_id":null,"start":32,"end":70},{"id":"huanchen-q-ec00d526cbc1ee2d8466","section":"chapter-022","block":"b-54b50034ba4196132eac","layer":"original","quote":"会嘉平中，以乐安太守与吴战于东关〖25〗；军败，没〖26〗","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":25,"anchor":null},"note_id":null,"start":32,"end":61},{"id":"santizhu-q-8812753a9ed1bf501f17","section":"chapter-048","block":"b-9b3f5181b40c2019f20c","layer":"original","quote":"甲寅〖11〗，恪以大兵赴敌。戊午〖12〗，兵及东兴，交战；大破魏军，杀将军韩综、桓嘉等","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":14,"anchor":null},"note_id":null,"start":102,"end":145},{"id":"santizhu064-q-c0aaa14c0306cbe5684d","section":"chapter-064","block":"b-d3196146b5b40af27868","layer":"original","quote":"恪兴军四万，晨夜赴救。遵等敕其诸军：作浮桥渡，阵于堤上〖6〗，分兵攻两城。城在高峻，不可猝拔。恪遣将军留赞、吕据、唐咨、丁奉为前部。时天寒，雪，魏诸将会饮。见赞等兵少，而解置铠甲，不持矛戟；但兜鍪刀盾〖7〗，裸身缘遏〖8〗：大笑之，不即严兵〖9〗。兵得上，便鼓噪乱斫〖10〗。魏军惊扰散走，争渡浮桥；桥坏绝，自投于水，更相蹈藉。乐安太守桓嘉等，同时并没〖11〗，死者数万。故叛将韩综为魏前军督〖12〗，亦斩之。获车乘牛、马、驴、骡各数千，资器山积，振旅而归〖13〗。","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":164,"anchor":null},"note_id":null,"start":0,"end":233},{"id":"shaodi-e-o054b-q","section":"chapter-004","block":"b-aa16c067e880a0a5a64a","layer":"original","quote":"冬十一月，诏征南大将军王昶、征东将军胡遵、镇南将军毌丘俭等，征吴。十二月，吴大将军诸葛恪拒战〖20〗，大破众军于东关〖21〗。不利而还。﹝二﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":212,"anchor":null},"note_id":null,"start":0,"end":71},{"id":"shaodi-q-b-20272e7cc5379b3fe346","section":"chapter-004","block":"b-20272e7cc5379b3fe346","layer":"modern","quote":"〖17〗四年：嘉平四年（公元252）。癸卯：旧历初二日。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":230,"anchor":null},"note_id":"n-db96ad991a403b6a010e","start":0,"end":28},{"id":"shaodi-q-o052","section":"chapter-004","block":"b-944c76689fd8a3e8fa86","layer":"original","quote":"四年春正月，癸卯〖17〗，以抚军大将军司马景王为大将军。二月，立皇后张氏〖18〗，大赦。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":210,"anchor":null},"note_id":null,"start":0,"end":44},{"id":"shaodi-q-o054","section":"chapter-004","block":"b-aa16c067e880a0a5a64a","layer":"original","quote":"冬十一月，诏征南大将军王昶、征东将军胡遵、镇南将军毌丘俭等，征吴。十二月，吴大将军诸葛恪拒战〖20〗，大破众军于东关〖21〗。不利而还。﹝二﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":212,"anchor":null},"note_id":null,"start":0,"end":71},{"id":"wangwei-q-eb7155e684829da3d57d","section":"chapter-021","block":"b-40db16cbc0a5788fa626","layer":"pei","quote":"五年正月，诸葛恪拒战，大破众军于东关","attribution":"裴注·司马彪《战略》","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":521,"anchor":null},"note_id":"n-95568ac79fb311f2266b","start":1118,"end":1136},{"id":"wgc-q0016","section":"chapter-028","block":"b-7bd943dc7147c2f75ba7","layer":"original","quote":"转为镇南将军。诸葛诞战于东关，不利；乃令诞、俭对换。诞为镇南，都督豫州。俭为镇东，都督扬州。吴太傅诸葛恪围合肥新城，俭与文钦御之；太尉司马孚督中军东，解围，恪退还。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":85,"anchor":null},"note_id":null,"start":0,"end":82},{"id":"wgc-q0023","section":"chapter-028","block":"b-60f24ec82e3162ca0f99","layer":"original","quote":"出为扬州刺史，加昭武将军〖5〗。王凌之阴谋也〖6〗，太傅司马宣王潜军东伐〖7〗；以诞为镇东将军、假节，都督扬州诸军事，封山阳亭侯。诸葛恪兴东关〖8〗，遣诞督诸军讨之；与战，不利。还，徙为镇南将军。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":151,"anchor":null},"note_id":null,"start":0,"end":98},{"id":"wgc-q0219","section":"chapter-028","block":"b-7bd943dc7147c2f75ba7","layer":"original","quote":"诸葛诞战于东关，不利","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":85,"anchor":null},"note_id":null,"start":7,"end":17},{"id":"wgc-q0255","section":"chapter-028","block":"b-60f24ec82e3162ca0f99","layer":"original","quote":"诸葛恪兴东关〖8〗，遣诞督诸军讨之；与战，不利","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":151,"anchor":null},"note_id":null,"start":65,"end":88},{"id":"yuanzhang-q-075d09466ebaf4ebd6c6","section":"chapter-011","block":"b-d755c8e0c6dbb83b5748","layer":"pei","quote":"修一子，名仪，字朱表。高亮雅直。司马文王为安东，仪为司马。东关之败，文王曰：‘近日之事，谁任其咎？’仪曰：‘责在军帅。’文王怒曰：‘司马欲委罪于孤邪？’遂杀之","attribution":"裴注·晋书","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":308,"anchor":null},"note_id":"n-5b92ebcb47664c80df05","start":12,"end":91},{"id":"zhulv-q-305b4439281ed74f2920","section":"chapter-056","block":"b-604767dbf5853a5d004b","layer":"original","quote":"魏出东兴，据赴讨有功","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":199,"anchor":null},"note_id":null,"start":10,"end":20},{"id":"zhulv-q-77551a11b8ee4f203b3f","section":"chapter-056","block":"b-abd659c367dbc19a7af5","layer":"original","quote":"是岁，魏遣胡遵、诸葛诞等出东兴。异督水军攻浮梁〖6〗，坏之，魏军大破","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":285,"anchor":null},"note_id":null,"start":11,"end":45}],"profiles":{},"directory_counts":{}}
