cc"]},{"person":"santizhu-p0049","role":"并述吴书者","evidence":["zhanggu-q-c266c92f4ae16f57e3cc"]},{"person":"luxun-p0072","role":"并述吴书者","evidence":["zhanggu-q-c266c92f4ae16f57e3cc"]},{"person":"santizhu-p0085","role":"表救之","evidence":["zhanggu-q-c266c92f4ae16f57e3cc"]},{"person":"shaodi-p0150","role":"不听","evidence":["zhanggu-q-c266c92f4ae16f57e3cc"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["zhanggu-q-c266c92f4ae16f57e3cc"]},"ordering_evidence":"zhanggu-q-c266c92f4ae16f57e3cc","source_order":[52,474,0],"order":9395}],"persons":[{"id":"zhanggu-p0006","name":"周昭","evidence":["zhanggu-q-69c49b727d00b321b52e","zhanggu-q-e04ac29cba45dc64dbdb","zhanggu-q-0596c31ce6387ff34892","zhanggu-q-5f211045471a25fc2444","zhanggu-q-f00afa6623cd827b5aff","zhanggu-q-5979a844ea9f6cc50318","zhanggu-q-c266c92f4ae16f57e3cc","zhanggu-q-64313ca354ee2a0121cb","zhangyan-q-f9f2704563d4f3148aab"],"facts":[{"id":"zhanggu-f-e459d0a35fdf62e2dfd1","text":"字恭远。","evidence":["zhanggu-q-64313ca354ee2a0121cb"]}],"aliases":[],"mentions":[{"id":"zhangyan-m-624f291bf106ac8f14b3","kind":"mention","text":"本篇原文记及周昭，具体行动与称谓见引文。","evidence":["zhangyan-q-f9f2704563d4f3148aab"]}]}],"evidence":[{"id":"zhanggu-q-0596c31ce6387ff34892","section":"chapter-052","block":"b-b150f524fed4051c8a1a","layer":"original","quote":"当世君子能不然者，亦比有之〖2〗，岂独古人乎？然论其绝异，未若顾豫章、诸葛使君、步丞相、严卫尉、张奋威之为美也〖3〗。《论语》言“夫子恂恂然善诱人〖4〗”，又曰“成人之美，不成人之恶”：豫章有之矣。“望之俨然〖5〗，即之也温〖6〗，听其言也厉〖7〗”：使君体之矣〖8〗。“恭而安〖9〗，威而不猛”：丞相履之矣。学不求禄，心无苟得〖10〗：卫尉、奋威蹈之矣。此五君者，虽德实有差〖11〗，轻重不同；至于趋舍大检〖12〗，不犯四者，俱一揆也〖13〗。","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":469,"anchor":null},"note_id":null,"start":0,"end":223},{"id":"zhanggu-q-5979a844ea9f6cc50318","section":"chapter-052","block":"b-741f7bb5edae3222195f","layer":"original","quote":"若乃经国家〖40〗，当军旅；于驰骛之际〖41〗，立霸王之功：此五〔君〕者未为过人。至其纯粹履道，求不苟得；升降当世，保全名行；邈然绝俗〖42〗，实有所师。故粗论其事，以示后之君子。","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":472,"anchor":null},"note_id":null,"start":0,"end":90},{"id":"zhanggu-q-5f211045471a25fc2444","section":"chapter-052","block":"b-145a6f5a67c459da712d","layer":"original","quote":"昔丁谞出于孤家〖14〗，吾粲由于牧竖〖15〗；豫章扬其善，以并陆、全之列〖16〗：是以人无幽滞而风俗厚焉〖17〗。使君、丞相、卫尉三君，昔以布衣俱相友善〖18〗，诸论者因各叙其优劣：初，先卫尉，次丞相，而后（有）使君也。其后并事明主，经营世务〖19〗；出处之才有不同〖20〗，先后之名须反其初〖21〗：此世常人所决勤薄也〖22〗。至于三君分好〖23〗，卒无亏损，岂非古人交哉！又鲁横江昔杖万兵〖24〗，屯据陆口，当世之美业也；能与不能，孰不愿焉〖25〗？而横江既亡，卫尉应其选；自以才非将帅，深辞固让，终于不就。后徙九列〖26〗，迁典八座〖27〗；荣不足以自曜，禄不足以自奉。至于二君〖28〗，皆位为上将，穷富极贵。卫尉既无求欲，二君又不称荐；各守所志，保其名好。孔子曰：","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":470,"anchor":null},"note_id":null,"start":0,"end":336},{"id":"zhanggu-q-64313ca354ee2a0121cb","section":"chapter-052","block":"b-f45dd121de51681a7018","layer":"original","quote":"周昭者，字恭远。与韦曜、薛莹、华覈并述《吴书》〖43〗。后为中书郎，坐事下狱。覈表救之，孙休不听，遂伏法云〖44〗。","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":473,"anchor":null},"note_id":null,"start":0,"end":58},{"id":"zhanggu-q-69c49b727d00b321b52e","section":"chapter-052","block":"b-c30fe96f26c9dda6799c","layer":"original","quote":"颍川周昭，著书称步骘及严畯等曰","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":467,"anchor":null},"note_id":null,"start":0,"end":15},{"id":"zhanggu-q-c266c92f4ae16f57e3cc","section":"chapter-052","block":"b-f45dd121de51681a7018","layer":"original","quote":"周昭者，字恭远。与韦曜、薛莹、华覈并述《吴书》〖43〗。后为中书郎，坐事下狱。覈表救之，孙休不听，遂伏法云","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":473,"anchor":null},"note_id":null,"start":0,"end":53},{"id":"zhanggu-q-e04ac29cba45dc64dbdb","section":"chapter-052","block":"b-43ccad8a48b51ffa6b2f","layer":"original","quote":"古今贤士大夫所以失名丧身、倾家害国者，其由非一也。然要其大归〖1〗，总其常患，四者而已：急论议一也，争名势二也，重朋党三也，务欲速四也。急论议则伤人，争名势则败友，重朋党则蔽主，务欲速则失德。此四者不除，未有能全〔者〕也。","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":468,"anchor":null},"note_id":null,"start":0,"end":111},{"id":"zhanggu-q-f00afa6623cd827b5aff","section":"chapter-052","block":"b-e95888bc39a76aea9336","layer":"original","quote":"“君子矜而不争〖29〗，群而不党〖30〗。”斯有风矣。又奋威之名，亦三君之次也；当一方之戍，受上将之任，与使君、丞相不异也。然历国事，论功劳，实有先后，故爵位之荣殊焉〖31〗。而奋威将处此，决能明其部分；心无失道之欲〖32〗，事无充诎之求〖33〗；每升朝堂，循礼而动；辞气謇謇〖34〗，罔不惟忠。（叔嗣）〔元逊〕虽亲贵〖35〗，言忧其败；蔡文至虽疏贱〖36〗，谈称其贤。女配太子，受礼若吊〖37〗。慷慨之趋〖38〗，惟笃人物〖39〗；成败得失，皆如所虑。可谓守道见机，好古之士也。","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":471,"anchor":null},"note_id":null,"start":0,"end":240},{"id":"zhangyan-q-f9f2704563d4f3148aab","section":"chapter-053","block":"b-0466cbcbb7e629f68050","layer":"original","quote":"右国史华覈上疏曰〖4〗：“臣闻五帝三王，皆立史官〖5〗；叙录功美，垂之无穷。汉时司马迁、班固〖6〗，咸命世大才〖7〗；所撰精妙，与六经俱传。大吴受命，建国南土。大皇帝末年，命太史令丁孚、郎中项峻，始撰《吴书》〖8〗。孚、峻俱非史才，其所撰作，不足纪录。至少帝时〖9〗，更差韦曜、周昭、薛莹、梁广及臣五人，访求往事；所共撰立，备有本末。昭、广先亡；曜负恩蹈罪；莹出为将，复以过徙：其书遂委滞〖10〗，迄今未撰奏。臣愚浅才劣，适可为莹等记注而已〖11〗；若使撰合，必袭孚、峻之迹；惧坠大皇帝之元功〖12〗，损当世之盛美。莹涉学既博，文章尤妙；同僚之中，莹为冠首。今者现吏，虽多经学；记述之才，如莹者少：是以\"\"，为国惜之〖13〗。实欲使卒垂成之功〖14〗，编于前史之末。奏上之后，退填沟壑，无所复恨。”","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":331,"anchor":null},"note_id":null,"start":0,"end":349}],"profiles":{},"directory_counts":{}}
