{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"yululu-e-595071743550cecf3c2f","title":"张允为孙权东曹掾，卒","accounts":[{"id":"yululu-a-595071743550cecf3c2f","label":"正文","text":"张允为孙权东曹掾，卒","evidence":["yululu-q-61cd12cb312b8e71b945"]}],"participants":[{"person":"yululu-p-399fe43211ddef","role":"任官","evidence":["yululu-q-61cd12cb312b8e71b945"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["yululu-q-61cd12cb312b8e71b945"]},"ordering_evidence":"yululu-q-61cd12cb312b8e71b945","order":10178}],"persons":[{"id":"yululu-p-399fe43211ddef","name":"张允（张温父）","evidence":["yululu-q-61cd12cb312b8e71b945","yululu-q-9922c0493b7d96c7ca8d"],"facts":[{"id":"yululu-f-c855a0683b7d35f79d5a","text":"以轻财重士名显州郡；张温之父","evidence":["yululu-q-9922c0493b7d96c7ca8d"]}],"mentions":[],"aliases":[]}],"evidence":[{"id":"yululu-q-61cd12cb312b8e71b945","section":"chapter-057","block":"b-0821c8300c19c470958b","layer":"original","quote":"为孙权东曹掾，卒","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":156,"anchor":null},"note_id":null,"start":28,"end":36},{"id":"yululu-q-9922c0493b7d96c7ca8d","section":"chapter-057","block":"b-0821c8300c19c470958b","layer":"original","quote":"张温字惠恕，吴郡〔吴〕人也。父允，以轻财重士，名显州郡。为孙权东曹掾，卒。温少修节操，容貌奇伟。权闻之，以问公卿曰：“温当今与谁为比〔也〕？”大司农刘基曰：“可与全琮为辈。”太常顾雍曰〖1〗：“基未详其为人也。温当今无辈〖2〗！”权曰：“如是，张允不死也！”征到（延）〔廷〕见，文辞占对，观者倾竦〖3〗，权改容加礼〖4〗。罢出，张昭执其手曰：“老夫托意，君宜明之。”拜议郎，选曹尚书〖5〗。徙太子太傅，甚见信重，时年三十二。","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":156,"anchor":null},"note_id":null,"start":0,"end":212}],"profiles":{},"directory_counts":{}}
