12deb5195a5343","fangji-q-e2eb3fc770aab77dc6e5","fangji-q-456c19c94267093f70ef","fangji-q-bcc2e471bb467940dc2a","fangji-q-4c41b41d2b0d56cf3ac4","fangji-q-e2e30be1e88d09076397","fangji-q-d2fd01a23076155079cd","fangji-q-8c97303d58e3cc4f3777","fangji-q-2aa8e98aacc4ea38481b","fangji-q-26533eb321167813efc1","fangji-q-df59219825c6ac4c197e","fangji-q-ee83cab7f15854deabf0","fangji-q-ba2bab367325ccef2e4d","fangji-q-bdbc9e5455071e591f17","fangji-q-be6836e998aa7793d3fa","fangji-q-a8a2cea791730ecbc64b","fangji-q-4badb1b426075e7d18a9","fangji-q-2a9e8f3baaeff0fa09f5","fangji-q-663b76c7b9d432907b56","fangji-q-984c1d0ff19f4144c4de","fangji-q-7747c7c381d85b275b1a","fangji-q-369e0f3a2fa69d8f3645","fangji-q-6e20fa1f483cad80f2dd","fangji-q-4eafec5ef93ba7bc5777","fangji-q-27962408784f8cc7fde7","fangji-q-fae455c434a33933c703","fangji-q-bd56c61f7581704044d3","fangji-q-1a76d53a88edf8248d55","fangji-q-5530da3d387b4e5657cb","fangji-q-44836f904895287c18a1","fangji-q-c14533b38454374de3b8","fangji-q-3f703b27e8156d86a5fe","fangji-q-b577ed5c9eed6952017e","fangji-q-a7b2713107693d7228d4","fangji-q-716084bb992fc08da305","fangji-q-0aaa97b21d2fe3b98a5b","fangji-q-c47e678e494fa07f2e8e","fangji-q-31105a4f411d2cb6d88d","fangji-q-9e281828fdef4931a32b"],"facts":[{"id":"fangji-f-5cfc92084a334274aee8","text":"字元化，沛国谯人；一名旉，裴松之另辨敷、專字形。","evidence":["fangji-q-31105a4f411d2cb6d88d"]},{"id":"fangji-f-ee5c2566848eb656635b","text":"本作士人，以医见业，意常自悔；为本传所述志趣。","evidence":["fangji-q-9e281828fdef4931a32b"]}],"aliases":[{"text":"旉","evidence":["fangji-q-31105a4f411d2cb6d88d"]}],"mentions":[{"id":"wudi-m-p155-wudi-p0407","kind":"mention","text":"文中提及","evidence":["wudi-q-p155"]},{"id":"fangji-m-c78e7b3056cb7475af11","kind":"mention","text":"陈寿述华佗养性、方药、针灸与麻沸散刳割之术","evidence":["fangji-q-0aaa97b21d2fe3b98a5b"]},{"id":"fangji-m-da1db5a12ce28a656566","kind":"mention","text":"陈寿评华佗、杜夔、朱建平、周宣、管辂方技","evidence":["fangji-q-c47e678e494fa07f2e8e"]}]}],"evidence":[{"id":"fangji-q-0aaa97b21d2fe3b98a5b","section":"chapter-029","block":"b-38f18ab17968af4a8111","layer":"original","quote":"晓养性之术〖5〗，时人以为〔仙〕，年且百岁而貌有壮容〖6〗。又精方药：其疗疾，合汤不过数种；心解分剂〖7〗，不复称量；煮熟便饮，语其节度〖8〗，舍去辄愈〖9〗。若当灸，不过一两处；每处不过七八壮〖10〗，病亦应除。若当针〖11〗，亦不过一两处；下针言“当引某许〖12〗，若至，语人〖13〗”；病者言“已到”，应便拔针，病亦行差〖14〗。若病结积在内，针药所不能及，当须刳割者；便饮其麻沸散〖15〗，须臾便如醉死无所知，因破取。病若在肠中，便断肠湔洗〖16〗；缝腹，膏摩〖17〗，四五日差；不痛，人亦不自寤〖18〗；一月之间，即平复矣。","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":2,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":267,"offset_unit":"unicode_code_point"},{"id":"fangji-q-1a76d53a88edf8248d55","section":"chapter-029","block":"b-bc692ba43f977cfda2ab","layer":"original","quote":"阿从佗求可服食益于人者，佗授以漆叶青黏散〖12〗：漆叶屑一升，青黏屑十四两，以是为率〖13〗；言“久服去三虫〖14〗，利五藏〖15〗，轻体，使人头不白","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":129,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":67,"end":142,"offset_unit":"unicode_code_point"},{"id":"fangji-q-26533eb321167813efc1","section":"chapter-029","block":"b-077793e85e4d25224f23","layer":"original","quote":"又有一郡守病。佗以为，其人盛怒则差；乃多受其货而不加治〖31〗，无何弃去〖32〗，留书骂之","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":34,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":45,"offset_unit":"unicode_code_point"},{"id":"fangji-q-27962408784f8cc7fde7","section":"chapter-029","block":"b-9ba37ea4afd09764534c","layer":"original","quote":"初，军吏李成苦咳嗽；昼夜不（寤）〔寐〕，时吐脓血。以问佗，佗言：“君病肠痈；咳之所吐，非从肺来也。与君散两钱〖17〗，当吐二升余脓血讫；快自养，一月可小起；好自将爱〖18〗，一年便健。十八岁，当一小发；服此散，亦行复差。若不得此药，故当死〖19〗。”复与两钱散","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":94,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":130,"offset_unit":"unicode_code_point"},{"id":"fangji-q-2a9e8f3baaeff0fa09f5","section":"chapter-029","block":"b-20e121af771c1056ca8b","layer":"original","quote":"后太祖亲理〖2〗，得病笃重，使佗专视。佗曰：“此近难济〖3〗。恒事攻治〖4〗，可延岁月","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":91,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":29,"end":72,"offset_unit":"unicode_code_point"},{"id":"fangji-q-2aa8e98aacc4ea38481b","section":"chapter-029","block":"b-f1cd3867e9c37ce2b00a","layer":"original","quote":"佗行道，见一人病咽塞〖25〗，嗜食而不得下。家人车载欲往就医。佗闻其呻吟，驻车往视。语之曰：“向来道边有卖饼家蒜i大酢〖26〗；从取三升饮之，病自当去。”即如佗言，立吐蛇一枚〖27〗；悬车边，欲造佗〖28〗。佗尚未还，小儿戏门前，逆见〖29〗。自相谓曰：“似逢我公，车边病是也〖30〗。”疾者前入坐，见佗北壁悬此蛇辈，约以十数","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":33,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":163,"offset_unit":"unicode_code_point"},{"id":"fangji-q-31105a4f411d2cb6d88d","section":"chapter-029","block":"b-ce3329711a4ddcc33a21","layer":"original","quote":"华佗字元化，沛国谯人也。一名旉〖1〗。﹝一﹞游学徐土〖2〗，兼通数经。沛相陈珪举孝廉〖3〗，太尉黄琬辟〖4〗；皆不就。","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":1,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":59,"offset_unit":"unicode_code_point"},{"id":"fangji-q-369e0f3a2fa69d8f3645","section":"chapter-029","block":"b-d09f79d363bf79e861d3","layer":"original","quote":"荀彧或请曰：“佗术实工。人命所悬，宜含宥之","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":92,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":61,"end":82,"offset_unit":"unicode_code_point"},{"id":"fangji-q-3f703b27e8156d86a5fe","section":"chapter-029","block":"b-9d0f01ea2a521f0e69f5","layer":"pei","quote":"又有妇人，长病经年，世谓寒热注病者。冬十一月中，佗令坐石槽中，平旦用寒水汲灌，云当满百。始七八灌，会战欲死；灌者惧，欲止。佗令满数。将至八十灌，热气乃蒸出，嚣嚣高二三尺。满百灌，佗乃使燃火温床，厚覆；良久，汗洽出，著粉，汗燥便愈","attribution":"裴注·佗别传","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":126,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-521f8437ebe4c4b08734","start":406,"end":520,"offset_unit":"unicode_code_point"},{"id":"fangji-q-44836f904895287c18a1","section":"chapter-029","block":"b-9d0f01ea2a521f0e69f5","layer":"pei","quote":"琅邪刘勋，为河内太守，有女年几二十；左脚膝里上有疮，痒而不痛。疮愈，数十日复发，如此七八年。迎佗使视，佗曰：‘是，易治之。当得稻糠黄色犬一头，好马二疋。’以绳系犬颈，使走马牵犬，马极辄易；计马走三十余里，犬不能行；复令步人拖曳，计向五十里。乃以药饮女，女即安卧不知人。因取大刀，断犬腹近后脚之前，以所断之处向疮口，令去二三寸。停之须臾，有若蛇者从疮中而出，便以铁椎横贯蛇头。蛇在皮中动摇良久，须臾不动；乃牵出，长三尺所，纯是蛇；但有眼处而无童子，又逆鳞耳。以膏散著疮中，七日愈","attribution":"裴注·佗别传","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":126,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-521f8437ebe4c4b08734","start":58,"end":296,"offset_unit":"unicode_code_point"},{"id":"fangji-q-456c19c94267093f70ef","section":"chapter-029","block":"b-ce5cbdfc0da35db27128","layer":"original","quote":"盐渎严昕与数人共候佗〖9〗，适至。佗谓昕曰：“君身中佳否？”昕曰：“自如常。”佗曰：“君有急病现于面，莫多饮酒！”坐毕归，行数里，昕猝头眩堕车。人扶将还，载归家，中宿死","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":27,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":84,"offset_unit":"unicode_code_point"},{"id":"fangji-q-4badb1b426075e7d18a9","section":"chapter-029","block":"b-17c6269fa3782dab0c3c","layer":"original","quote":"李将军妻病甚，呼佗视脉。曰：“伤娠而胎不去〖42〗。”将军言：“（闻）〔间〕实伤娠〖43〗，胎已去矣。”佗曰：“案脉，胎未去也。”将军以为不然。佗舍去，妇稍小差。百余日复动〖44〗，更呼佗。佗曰：“此脉故事有胎〖45〗。前当生两儿：一儿先出，血出甚多；后儿不及生，母不自觉；旁人亦不悟〖46〗，不复迎〖47〗，遂不得生。胎死，血脉不复归，必燥著母脊〖48〗，故使多脊痛。今当与汤，并针一处，此死胎必出。”汤、针既加，妇痛急如欲生者〖49〗。佗曰：“此死胎久枯，不能自出，宜使人探之。”果得一死男，手足完具，色黑，长可尺所","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":38,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":260,"offset_unit":"unicode_code_point"},{"id":"fangji-q-4c41b41d2b0d56cf3ac4","section":"chapter-029","block":"b-291ed36c34a2ed40a2f5","layer":"original","quote":"督邮徐毅得病，佗往省之。毅谓佗曰：“昨使医曹吏刘租针胃管讫〖15〗，便苦咳嗽，欲卧不安。”佗曰：“刺不得胃管〖16〗，误中肝也。食当日减，五日不救。”遂如佗言","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":29,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":79,"offset_unit":"unicode_code_point"},{"id":"fangji-q-4eafec5ef93ba7bc5777","section":"chapter-029","block":"b-e1d64438b9fefe3c3e7c","layer":"original","quote":"佗临死〖13〗，出一卷书与狱吏，曰：“此可以活人。”吏畏法不受。佗亦不强，索火烧之","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":93,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":41,"offset_unit":"unicode_code_point"},{"id":"fangji-q-5530da3d387b4e5657cb","section":"chapter-029","block":"b-136b841b548ff6b2c0a2","layer":"pei","quote":"有人病两脚躄，不能行。舆诣佗，佗望见云：‘已饱针灸服药矣：不复须看脉。’便使解衣，点背数十处；相去或一寸，或五寸，纵邪不相当。言：‘灸此各十壮；灸创愈，即行。’后灸处夹脊一寸，上下行端直均调，如引绳也","attribution":"裴注·佗别传","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":90,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9cd9b7270efa9e224280","start":11,"end":111,"offset_unit":"unicode_code_point"},{"id":"fangji-q-59c45d12deb5195a5343","section":"chapter-029","block":"b-786564f81ca8dece6505","layer":"original","quote":"县吏尹世苦四肢烦〖3〗，口中乾，不欲闻人声，小便不利。佗曰：“试作热食：得汗则愈；不汗，后三日死。”即作热食而不汗出，佗曰：“藏气已绝于内〖4〗，当啼泣而绝。”果如佗言","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":25,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":84,"offset_unit":"unicode_code_point"},{"id":"fangji-q-663b76c7b9d432907b56","section":"chapter-029","block":"b-20e121af771c1056ca8b","layer":"original","quote":"因曰：“当得家书〖7〗，方欲暂还耳。”到家，辞以妻病，数乞期不反","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":91,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":87,"end":119,"offset_unit":"unicode_code_point"},{"id":"fangji-q-6e20fa1f483cad80f2dd","section":"chapter-029","block":"b-d09f79d363bf79e861d3","layer":"original","quote":"不忧，天下当无此鼠辈耶！”遂考竟佗","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":92,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":89,"end":106,"offset_unit":"unicode_code_point"},{"id":"fangji-q-716084bb992fc08da305","section":"chapter-029","block":"b-ce3329711a4ddcc33a21","layer":"original","quote":"游学徐土〖2〗，兼通数经。","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":1,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":22,"end":35,"offset_unit":"unicode_code_point"},{"id":"fangji-q-7747c7c381d85b275b1a","section":"chapter-029","block":"b-d09f79d363bf79e861d3","layer":"original","quote":"于是传付许狱〖11〗，考验首服","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":92,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":41,"end":56,"offset_unit":"unicode_code_point"},{"id":"fangji-q-8c97303d58e3cc4f3777","section":"chapter-029","block":"b-9c6997cafd6a7ca33d39","layer":"original","quote":"军吏梅平得病，除名还家。家居广陵，未至二百里，止亲人舍。有顷，佗偶至主人许，主人令佗视平。佗谓平曰：“君早见我，可不至此。今疾已结，促去，可得与家相见，五日卒。”应时归，如佗所刻","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":32,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":89,"offset_unit":"unicode_code_point"},{"id":"fangji-q-984c1d0ff19f4144c4de","section":"chapter-029","block":"b-20e121af771c1056ca8b","layer":"original","quote":"太祖累书呼，又敕郡县发遣；佗恃能厌食事〖9〗，犹不上道","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":91,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":123,"end":150,"offset_unit":"unicode_code_point"},{"id":"fangji-q-9e281828fdef4931a32b","section":"chapter-029","block":"b-20e121af771c1056ca8b","layer":"original","quote":"佗之绝技，凡此类也。然本作士人〖1〗；以医见业，意常自悔。后太祖亲理〖2〗，得病笃重，使佗专视。佗曰：“此近难济〖3〗。恒事攻治〖4〗，可延岁月〖5〗。”佗久远家思归〖6〗，因曰：“当得家书〖7〗，方欲暂还耳。”到家，辞以妻病，数乞期不反〖8〗。太祖累书呼，又敕郡县发遣；佗恃能厌食事〖9〗，犹不上道。","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":91,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":151,"offset_unit":"unicode_code_point"},{"id":"fangji-q-a7b2713107693d7228d4","section":"chapter-029","block":"b-d109820d62c6bab69d15","layer":"pei","quote":"佗以为佳，辄语阿，阿又秘之。近者人见阿之寿而气力强盛，怪之；遂责阿所服，因醉乱，误道之。法一施，人多服者，皆有大验","attribution":"裴注·佗别传","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":149,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-66c2e7fedf68bad14c99","start":52,"end":109,"offset_unit":"unicode_code_point"},{"id":"fangji-q-a8a2cea791730ecbc64b","section":"chapter-029","block":"b-2cb7b9c1b7c4747b9e4e","layer":"original","quote":"太祖苦头风〖40〗，每发，心乱目眩；佗针鬲〖41〗，随手而差","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":37,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":13,"end":43,"offset_unit":"unicode_code_point"},{"id":"fangji-q-b577ed5c9eed6952017e","section":"chapter-029","block":"b-9d0f01ea2a521f0e69f5","layer":"pei","quote":"又有人病腹中半切痛，十余日中，鬓眉堕落。佗曰：‘是脾半腐，可刳腹养治也。’使饮药，令卧，破腹就视，脾果半腐坏。以刀断之，刮去恶内，以膏傅疮，饮之以药，百日平复","attribution":"裴注·佗别传","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":126,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-521f8437ebe4c4b08734","start":521,"end":600,"offset_unit":"unicode_code_point"},{"id":"fangji-q-b721e75a2c4e04e58bbc","section":"chapter-029","block":"b-ce3329711a4ddcc33a21","layer":"original","quote":"沛相陈珪举孝廉〖3〗，太尉黄琬辟〖4〗；皆不就","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":1,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":35,"end":58,"offset_unit":"unicode_code_point"},{"id":"fangji-q-ba2bab367325ccef2e4d","section":"chapter-029","block":"b-d00f11fb429a34ea5aa1","layer":"original","quote":"广陵太守陈登得病：胸中烦懑，面赤，不食。佗脉之曰：“府君胃中有虫数升，欲成内疽；食腥物所为也。”即作汤二升：先服一升，斯须尽服之〖36〗。食顷〖37〗，吐出三升许虫；赤头，皆动，半身是生鱼脍也〖38〗。所苦便愈","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":36,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":105,"offset_unit":"unicode_code_point"},{"id":"fangji-q-bcc2e471bb467940dc2a","section":"chapter-029","block":"b-d29b6a41ad99c2218822","layer":"original","quote":"故督邮顿子献得病，已差，诣佗视脉。曰：“尚虚，未得复；勿为劳事〖11〗，御内即死〖12〗：临死，当吐舌数寸。”其妻闻其病除，从百余里来省之；止宿交接〖13〗，中间三日发病〖14〗：一如佗言","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":28,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":94,"offset_unit":"unicode_code_point"},{"id":"fangji-q-bd56c61f7581704044d3","section":"chapter-029","block":"b-eeefe0b86ab698f029dc","layer":"original","quote":"佗语普曰：“人体欲得劳动〖2〗，但不当使极尔〖3〗。动摇则谷气得消〖4〗，血脉流通，病不得生；譬犹户枢不朽是也。是以古之仙者为导引之事〖5〗，熊（颈）〔经〕鸱顾〖6〗，引輓腰体〖7〗；动诸关节，以求难老。吾有一术，名五禽之戏：一曰虎，二曰鹿，三曰熊，四曰猿，五曰鸟；亦以除疾，并利蹄足〖8〗，以当导引。体中不快，起作一禽之戏；沾濡汗出，因（上）〔以〕著粉：身体轻便，腹中欲食","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":128,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":14,"end":201,"offset_unit":"unicode_code_point"},{"id":"fangji-q-bdbc9e5455071e591f17","section":"chapter-029","block":"b-d00f11fb429a34ea5aa1","layer":"original","quote":"此病后三期当发〖39〗，遇良医乃可济救。”依期果发动，时佗不在，如言而死","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":36,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":110,"end":146,"offset_unit":"unicode_code_point"},{"id":"fangji-q-be6836e998aa7793d3fa","section":"chapter-029","block":"b-2cb7b9c1b7c4747b9e4e","layer":"original","quote":"太祖闻而召佗，佗常在左右","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":37,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":12,"offset_unit":"unicode_code_point"},{"id":"fangji-q-c14533b38454374de3b8","section":"chapter-029","block":"b-9d0f01ea2a521f0e69f5","layer":"pei","quote":"又有人苦头眩，头不得举，目不得视，积年。佗使悉解衣倒悬，令头去地一二寸，濡布拭身体，令周匝；候视诸脉，尽出，五色。佗令弟子数人，以铍刀决脉，五色血尽；视赤血〔出〕，乃下，以膏摩，被覆，汗自出周匝；饮以亭历犬血散，立愈","attribution":"裴注·佗别传","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":126,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-521f8437ebe4c4b08734","start":297,"end":405,"offset_unit":"unicode_code_point"},{"id":"fangji-q-c47e678e494fa07f2e8e","section":"chapter-029","block":"b-18cfff7c6f84b0a80c2c","layer":"original","quote":"评曰：华佗之医诊，杜夔之声乐，朱建平之相术，周宣之相梦，管辂之术筮：诚皆玄妙之殊巧，非常之绝技矣。昔史迁著扁鹊、仓公、日者之传〖1〗，所以广异闻而表奇事也；故存录云尔。","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":463,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":84,"offset_unit":"unicode_code_point"},{"id":"fangji-q-d2fd01a23076155079cd","section":"chapter-029","block":"b-99614f4862369f18de25","layer":"original","quote":"彭城夫人夜之厕〖21〗；虿螫其手〖22〗，呻呼无赖〖23〗。佗令温汤近热，渍手其中，卒可得寐；但旁人数为易汤，汤令暖之，其旦即愈","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":31,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":64,"offset_unit":"unicode_code_point"},{"id":"fangji-q-df59219825c6ac4c197e","section":"chapter-029","block":"b-03a46122ad6f727d63d9","layer":"original","quote":"又有一士大夫不快〖34〗，佗云：“君病深，当破腹取。然君寿亦不过十年，病不能杀君；忍病十岁，寿俱当尽：不足故自刳裂","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":35,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":57,"offset_unit":"unicode_code_point"},{"id":"fangji-q-e2e30be1e88d09076397","section":"chapter-029","block":"b-5163937e98ffba49278d","layer":"original","quote":"东阳陈叔山小男二岁得疾〖17〗：下利常先啼〖18〗，日以羸困〖19〗。问佗，佗曰：“其母怀躯，阳气内养，乳中虚冷；儿得母寒，故令不时愈。”佗与四物女宛丸〖20〗；十日即除","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":30,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":85,"offset_unit":"unicode_code_point"},{"id":"fangji-q-e2eb3fc770aab77dc6e5","section":"chapter-029","block":"b-9aae56e88073e51471a1","layer":"original","quote":"府吏倪寻、李延共止〖5〗，俱头痛身热，所苦正同。佗曰：“寻，当下之〖6〗；延，当发汗。”或难其异〖7〗。佗曰：“寻外实〖8〗，延内实；故治之宜殊。”即各与药；明旦并起","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":26,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":83,"offset_unit":"unicode_code_point"},{"id":"fangji-q-ee83cab7f15854deabf0","section":"chapter-029","block":"b-03a46122ad6f727d63d9","layer":"original","quote":"士大夫不耐痛痒，必欲除之；佗遂下手，所患寻差。十年竟死","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":35,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":63,"end":90,"offset_unit":"unicode_code_point"},{"id":"fangji-q-f23eafeb00cecf1d1158","section":"chapter-029","block":"b-f24c1530958ccb1922fe","layer":"original","quote":"故甘陵相夫人有娠六月〖1〗，腹痛不安。佗视脉〖2〗，曰：“胎已死矣。”使人手摸知所在：在左则男，在右则女。人云“在左”，于是为汤下之；果下男形，即愈","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":24,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":74,"offset_unit":"unicode_code_point"},{"id":"fangji-q-fae455c434a33933c703","section":"chapter-029","block":"b-1aa028ba198ab5f85bb6","layer":"original","quote":"广陵吴普，彭城樊阿，皆从佗学","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":127,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":14,"offset_unit":"unicode_code_point"},{"id":"wudi-e-p155a-q","section":"chapter-001","block":"b-d76d672bc0848c8009df","layer":"pei","quote":"招引方术之士，庐江左慈、谯郡华佗、甘陵甘始、阳城郄俭，无不毕至。","attribution":"张华《博物志》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":459,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6c928ccff5d542bc3225","start":86,"end":118,"offset_unit":"unicode_code_point"},{"id":"wudi-q-p155","section":"chapter-001","block":"b-d76d672bc0848c8009df","layer":"pei","quote":"张华《博物志》曰：“汉世，安平崔瑗、瑗子寔，弘农张芝、芝弟昶，并善草书；而太祖亚之。桓谭、蔡邕善音乐，冯翊山子道、王九真、郭凯等善围棋；太祖皆与埒能。又好养性法，亦解方药。招引方术之士，庐江左慈、谯郡华佗、甘陵甘始、阳城郄俭，无不毕至。又习啖野葛至一尺，亦得少多饮鸩酒。”","attribution":"张华《博物志》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":459,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6c928ccff5d542bc3225","start":0,"end":136,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
