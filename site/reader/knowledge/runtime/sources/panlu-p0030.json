s":[]}],"evidence":[{"id":"panlu-q-cfee3ab516107e349b92","section":"chapter-061","block":"b-dcf2946ad7ac37bd1e03","layer":"pei","quote":"归义隐蕃，以口辩为豪杰所善；濬子翥，亦与周旋，馈饷之。濬闻大怒，疏责翥曰：‘吾受国厚恩，志报以命；尔辈在都，当念恭顺，亲贤慕善；何故与降虏交，以粮饷之？在远闻此，心震面热，惆怅累旬。疏到，急就往使，受杖一百，促责所饷","attribution":"裴注·《吴书》","section_title":"潘濬陆凯传第十六","source":{"file":"OEBPS/Text/titlepage_0129.xhtml","index":24,"anchor":null},"note_id":"n-b199fd00f2a7f26892cf","start":133,"end":241},{"id":"panlu-q-f517e2226bc13bf26aec","section":"chapter-061","block":"b-dcf2946ad7ac37bd1e03","layer":"pei","quote":"而蕃果图叛诛夷，众乃归服","attribution":"裴注·《吴书》","section_title":"潘濬陆凯传第十六","source":{"file":"OEBPS/Text/titlepage_0129.xhtml","index":24,"anchor":null},"note_id":"n-b199fd00f2a7f26892cf","start":250,"end":262},{"id":"shiyi-q-2517a3dc27ffb702cb93","section":"chapter-062","block":"b-bbef289ad14182ba819e","layer":"pei","quote":"吴主使将入，谓曰：‘何乃以肌肉为人受毒乎？’蕃曰：‘孙君，丈夫图事，岂有无伴！烈士死，不足相牵耳。’遂闭口而死","attribution":"裴注·吴录","section_title":"是仪胡综传第十七","source":{"file":"OEBPS/Text/titlepage_0131.xhtml","index":197,"anchor":null},"note_id":"n-03af5d33c13053b69c65","start":92,"end":147},{"id":"shiyi-q-d979b508e2d50a56b6c4","section":"chapter-062","block":"b-1bfab7b7bf3112c80af4","layer":"original","quote":"后蕃谋叛，事觉伏诛","section_title":"是仪胡综传第十七","source":{"file":"OEBPS/Text/titlepage_0131.xhtml","index":178,"anchor":null},"note_id":null,"start":54,"end":63}],"profiles":{},"directory_counts":{}}
