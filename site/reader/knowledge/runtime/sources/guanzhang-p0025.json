{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"gongsuntao-e-o238","title":"程银侯选李堪与马超合堪死银选降","accounts":[{"id":"gongsuntao-a-422843f403c473fd9f0a","label":"裴注·魏略","text":"程银侯选李堪与马超合堪死银选降","evidence":["gongsuntao-q-5970c8da65c81f28f9b5"]}],"participants":[{"person":"guanzhang-p0025","role":"河东人、兴平之乱有众千余家、建安十六年并与马超合、超破走后南入汉中、汉中破诣太祖降复官爵","evidence":["gongsuntao-q-5970c8da65c81f28f9b5"]},{"person":"guanzhang-p0024","role":"河东人、同与马超合、南入汉中、诣太祖降复官爵","evidence":["gongsuntao-q-5970c8da65c81f28f9b5"]},{"person":"wudi-p0284","role":"河东人、兴平之乱有众千余家、与马超合、临阵死","evidence":["gongsuntao-q-5970c8da65c81f28f9b5"]},{"person":"wudi-p0282","role":"等反、超破走","evidence":["gongsuntao-q-5970c8da65c81f28f9b5"]},{"person":"cao-cao","role":"受降复官爵者","evidence":["gongsuntao-q-5970c8da65c81f28f9b5"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["gongsuntao-q-5970c8da65c81f28f9b5"]},"ordering_evidence":"gongsuntao-q-5970c8da65c81f28f9b5","source_order":[8,314,240],"order":2100}],"persons":[{"id":"guanzhang-p0025","name":"程银","evidence":["guanzhang-q-p018","gongsuntao-q-5970c8da65c81f28f9b5"],"facts":[],"aliases":[],"mentions":[{"id":"guanzhang-m-p018-guanzhang-p0025","kind":"mention","text":"文中提及","evidence":["guanzhang-q-p018"]}]}],"evidence":[{"id":"gongsuntao-q-5970c8da65c81f28f9b5","section":"chapter-008","block":"b-97eb311121e3002971a1","layer":"pei","quote":"时又有程银、侯选、李堪，皆河东人也；兴平之乱，各有众千余家。建安十六年，并与马超合。超破走，堪临阵死；银、选南入汉中，汉中破，诣太祖降，皆复官爵","attribution":"裴注·魏略","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":313,"anchor":null},"note_id":"n-866f31ffb4c5cf065e10","start":240,"end":312},{"id":"guanzhang-q-p018","section":"chapter-036","block":"b-107ac81294c6a7f9bb40","layer":"pei","quote":"﹝三﹞《典略》曰：“建安十六年，超与关中诸将侯选、程银、李堪、张横、梁兴、成宜、马玩、杨秋、韩遂等，凡十部，俱反；其众十万，同据河、潼，建列营阵。是岁，曹公西征，与超等战于河、渭之交，超等败走。超至安定，遂奔凉州。诏收灭超家属。超复败于陇上，后奔汉中，张鲁以为都讲祭酒，欲妻之以女。或谏鲁曰：‘有人若此不爱其亲，焉能爱人？’鲁乃止。初，超未反时，其小妇弟种，留三辅；及超败，种先入汉中。正旦，种上寿于超。超捶胸吐血曰：‘阖门百口，一旦同命，今二人相贺邪！’后数从鲁求兵，欲北取凉州；鲁遣往，无利。又鲁将杨（白）〔昂〕等（欲）〔数〕害其能，超遂从武都逃入氐中，转奔往蜀。是岁，建安十九年也。”","attribution":"《典略》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":138,"anchor":null},"note_id":"n-7c0270dd171b6d970305","start":0,"end":295}],"profiles":{},"directory_counts":{}}
