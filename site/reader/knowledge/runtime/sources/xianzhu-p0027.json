{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o084b","title":"曹操南征使刘备投刘表","accounts":[{"id":"wudi-e-o084b-account","label":"正文","text":"曹操九月回许后南征刘备，刘备闻曹操亲来而奔刘表，共都等部散去。","evidence":["wudi-e-o084b-q"]},{"id":"xianzhu-e-o021c-account","label":"《先主传》正文","text":"《先主传》记曹操破袁绍后亲自南击刘备。","evidence":["xianzhu-e-o021c-q"]},{"id":"xianzhu-e-o022a-account","label":"《先主传》正文","text":"刘备遣麋竺、孙乾通刘表；刘表郊迎并增兵，使屯新野。","evidence":["xianzhu-e-o022a-q"]}],"participants":[{"person":"cao-cao","role":"南征","evidence":["wudi-e-o084b-q"]},{"person":"liu-bei","role":"退奔","evidence":["wudi-e-o084b-q"]},{"person":"liu-biao","role":"投奔对象","evidence":["wudi-e-o084b-q"]},{"person":"wudi-p0192","role":"部众散去","evidence":["wudi-e-o084b-q"]},{"person":"xianzhu-p0021","role":"通使","evidence":["xianzhu-e-o022a-q"]},{"person":"xianzhu-p0027","role":"通使","evidence":["xianzhu-e-o022a-q"]}],"place":{"text":"许、汝南","evidence":["wudi-e-o084b-q"]},"time":{"label":"建安六年九月","year":201,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o084b-q","wudi-q-o083","wudi-q-b-9c802125724c98d43dbe"],"chronology":"wudi-y201","dating_review":{"anchor":"wudi-q-o083","basis":"建安六年九月","reviewed":true}},"source_order":[1,458,"O084b"],"order":200},{"id":"wudi-e-o084a","title":"蔡扬击共都不利","accounts":[{"id":"wudi-e-o084a-account","label":"正文","text":"正文补述袁绍令刘备略汝南，共都等响应，曹操遣蔡扬进攻而失利。","evidence":["wudi-e-o084a-q"]},{"id":"xianzhu-e-o021b-account","label":"《先主传》正文","text":"《先主传》称曹操遣蔡杨来攻，蔡杨为刘备所杀；作为《武帝纪》蔡扬不利的补充记载。","evidence":["xianzhu-e-o021b-q"]},{"id":"xumisun-a-d3c0a5d8839ce04b3f8b","label":"正文","text":"孙乾麋竺俱使刘表","evidence":["xumisun-q-727212c1a286e8fa4d24"]}],"participants":[{"person":"wudi-p0052","role":"遣刘备","evidence":["wudi-e-o084a-q"]},{"person":"liu-bei","role":"略地","evidence":["wudi-e-o084a-q"]},{"person":"wudi-p0192","role":"响应并击败蔡扬","evidence":["wudi-e-o084a-q"]},{"person":"wudi-p0193","role":"战败","evidence":["wudi-e-o084a-q"]},{"person":"cao-cao","role":"遣军","evidence":["wudi-e-o084a-q"]},{"person":"xianzhu-p0027","role":"与麋竺俱使刘表","evidence":["xumisun-q-727212c1a286e8fa4d24"]},{"person":"xianzhu-p0021","role":"与孙乾俱使刘表","evidence":["xumisun-q-727212c1a286e8fa4d24"]},{"person":"liu-biao","role":"受孙乾、麋竺之使","evidence":["xumisun-q-727212c1a286e8fa4d24"]}],"place":{"text":"汝南","evidence":["wudi-e-o084a-q"]},"time":{"label":"曹操亲征刘备之前","precision":"relative","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-o084a-q"]},"source_order":[1,458,"O084a"],"order":201},{"id":"xianzhu-e-o017a","title":"昌霸等叛曹归刘备与孙乾通袁绍","accounts":[{"id":"xianzhu-e-o017a-account","label":"《先主传》正文","text":"昌霸即已登记的昌豨反曹，郡县归附刘备；刘备遣孙乾与袁绍连和。","evidence":["xianzhu-e-o017a-q"]}],"participants":[{"person":"wudi-p0151","role":"反曹","evidence":["xianzhu-e-o017a-q"]},{"person":"liu-bei","role":"遣使","evidence":["xianzhu-e-o017a-q"]},{"person":"xianzhu-p0027","role":"使袁绍","evidence":["xianzhu-e-o017a-q"]}],"place":{"text":"东海","evidence":["xianzhu-e-o017a-q"]},"time":{"year":199,"label":"刘备据徐州后","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xianzhu-y199","dating_review":{"reviewed":true,"anchor":"xianzhu-q-o014","basis":"刘备据徐州后"},"evidence":["xianzhu-e-o017a-q","xianzhu-q-o014","wudi-q-o061","wudi-q-b-51bced16741add42ff70"]},"source_order":[32,73,"O017a"],"order":6522},{"id":"xumisun-e-o049","title":"刘备辟孙乾为从事","accounts":[{"id":"xumisun-a-64d554952e62c760307a","label":"正文","text":"刘备辟孙乾为从事","evidence":["xumisun-q-1c2f4314a4fc24763c48"]}],"participants":[{"person":"liu-bei","role":"领徐州，辟孙乾为从事","evidence":["xumisun-q-1c2f4314a4fc24763c48"]},{"person":"xianzhu-p0027","role":"被辟为从事","evidence":["xumisun-q-1c2f4314a4fc24763c48"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["xumisun-q-1c2f4314a4fc24763c48"]},"ordering_evidence":"xumisun-q-1c2f4314a4fc24763c48","source_order":[38,200,14],"order":7064},{"id":"xumisun-e-o050","title":"刘备遣孙乾结袁绍","accounts":[{"id":"xumisun-a-8433a1c7a0760cce1e4f","label":"正文","text":"刘备遣孙乾结袁绍","evidence":["xumisun-q-752447933991ea8457b1"]}],"participants":[{"person":"liu-bei","role":"背离曹操后，遣孙乾自结袁绍","evidence":["xumisun-q-752447933991ea8457b1"]},{"person":"wudi-p0052","role":"孙乾奉命自结之对象","evidence":["xumisun-q-752447933991ea8457b1"]},{"person":"xianzhu-p0027","role":"奉遣自结袁绍","evidence":["xumisun-q-752447933991ea8457b1"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["xumisun-q-752447933991ea8457b1"]},"ordering_evidence":"xumisun-q-752447933991ea8457b1","source_order":[38,201,0],"order":7065},{"id":"xumisun-e-o053","title":"刘备任孙乾秉忠将军","accounts":[{"id":"xumisun-a-46c70762c49c531700c3","label":"正文","text":"刘备任孙乾秉忠将军","evidence":["xumisun-q-516007fef0c8e25f7e9d"]}],"participants":[{"person":"liu-bei","role":"定益州后以孙乾为秉忠将军","evidence":["xumisun-q-516007fef0c8e25f7e9d"]},{"person":"xianzhu-p0027","role":"自从事中郎为秉忠将军","evidence":["xumisun-q-516007fef0c8e25f7e9d"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["xumisun-q-516007fef0c8e25f7e9d"]},"ordering_evidence":"xumisun-q-516007fef0c8e25f7e9d","source_order":[38,202,0],"order":7067},{"id":"xumisun-e-o054","title":"孙乾卒","accounts":[{"id":"xumisun-a-23e5935217ca650060f8","label":"正文","text":"孙乾卒","evidence":["xumisun-q-75fd4974d00ac0b0894a"]}],"participants":[{"person":"xianzhu-p0027","role":"任秉忠将军后不久去世","evidence":["xumisun-q-75fd4974d00ac0b0894a"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["xumisun-q-75fd4974d00ac0b0894a"]},"ordering_evidence":"xumisun-q-75fd4974d00ac0b0894a","source_order":[38,202,36],"order":7068},{"id":"xumisun-e-o114","title":"郑玄荐孙乾于州","accounts":[{"id":"xumisun-a-bb932310b31377ec3455","label":"裴注·郑玄传","text":"郑玄荐孙乾于州","evidence":["xumisun-q-bb92539297f2da44da5b"]}],"participants":[{"person":"wudi-p0298","role":"荐孙乾于州","evidence":["xumisun-q-bb92539297f2da44da5b"]},{"person":"xianzhu-p0027","role":"被郑玄荐于州，被辟命为郑玄所举","evidence":["xumisun-q-bb92539297f2da44da5b"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["xumisun-q-bb92539297f2da44da5b"]},"ordering_evidence":"xumisun-q-bb92539297f2da44da5b","source_order":[38,210,11],"order":7069}],"persons":[{"id":"xianzhu-p0027","name":"孙乾","evidence":["xianzhu-q-o017","xumisun-q-1c2f4314a4fc24763c48","xumisun-q-752447933991ea8457b1","xumisun-q-727212c1a286e8fa4d24","xumisun-q-e4ceabd8aeaed311117c","xumisun-q-516007fef0c8e25f7e9d","xumisun-q-75fd4974d00ac0b0894a","xumisun-q-bb92539297f2da44da5b","xumisun-q2-0baebf1812702c3ab9f1","xumisun-q2-04d5d955e288785a7a1e"],"facts":[{"id":"xumisun-f2-a050d93ce42b3d47ffd5","text":"孙乾与简雍、麋竺同为从事中郎。","evidence":["xumisun-q2-04d5d955e288785a7a1e"]}],"aliases":[],"mentions":[{"id":"xianzhu-m-o017-xianzhu-p0027","kind":"mention","text":"文中提及","evidence":["xianzhu-q-o017"]},{"id":"xianzhu-m-o022-xianzhu-p0027","kind":"mention","text":"文中提及","evidence":["xianzhu-q-o022"]},{"id":"xumisun-m2-role-2428bbd4ea8e59924902","kind":"mention","text":"文中提及","evidence":["xumisun-q-e4ceabd8aeaed311117c","xumisun-q2-0baebf1812702c3ab9f1"]}]}],"evidence":[{"id":"wudi-e-o084a-q","section":"chapter-001","block":"b-f1ba2e0f53a15df9cff8","layer":"original","quote":"绍之未破也，使刘备略汝南；汝南贼共都等应之〖4〗。遣蔡扬击都，不利，为都所破。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":457,"anchor":null},"note_id":null,"start":7,"end":46},{"id":"wudi-e-o084b-q","section":"chapter-001","block":"b-f1ba2e0f53a15df9cff8","layer":"original","quote":"九月，公还许。绍之未破也，使刘备略汝南；汝南贼共都等应之〖4〗。遣蔡扬击都，不利，为都所破。公南征备。备闻公自行，走奔刘表；都等皆散。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":457,"anchor":null},"note_id":null,"start":0,"end":67},{"id":"wudi-q-b-51bced16741add42ff70","section":"chapter-001","block":"b-51bced16741add42ff70","layer":"modern","quote":"〖1〗四年：建安四年（公元 199）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":369,"anchor":null},"note_id":"n-20628d34a709162c77f0","start":0,"end":19},{"id":"wudi-q-b-9c802125724c98d43dbe","section":"chapter-001","block":"b-9c802125724c98d43dbe","layer":"modern","quote":"〖1〗六年：建安六年（公元 201）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":460,"anchor":null},"note_id":"n-9b6cfac8aaa83b85aeb7","start":0,"end":19},{"id":"wudi-q-o061","section":"chapter-001","block":"b-502d4e8c0ed143eaa30d","layer":"original","quote":"四年春二月〖1〗，公还至昌邑〖2〗。张杨将杨丑杀杨〖3〗。眭固又杀丑，以其众属袁绍，屯射犬〖4〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":358,"anchor":null},"note_id":null,"start":0,"end":49},{"id":"wudi-q-o083","section":"chapter-001","block":"b-1558c8ed4ee1b2768986","layer":"original","quote":"六年夏四月〖1〗，扬兵河上〖2〗。击绍仓亭军〖3〗，破之。绍归，复收散卒，攻定诸叛郡县。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":456,"anchor":null},"note_id":null,"start":0,"end":44},{"id":"xianzhu-e-o017a-q","section":"chapter-032","block":"b-7cba73e5d6ee78cda30a","layer":"original","quote":"东海昌霸反，郡县多叛曹公为先主〖7〗。众数万人，遣孙乾与袁绍连和〖8〗。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":72,"anchor":null},"note_id":null,"start":0,"end":36},{"id":"xianzhu-e-o021b-q","section":"chapter-032","block":"b-89994d2c61c1d14e6400","layer":"original","quote":"曹公遣蔡杨击之，为先主所杀。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":92,"anchor":null},"note_id":null,"start":24,"end":38},{"id":"xianzhu-e-o021c-q","section":"chapter-032","block":"b-89994d2c61c1d14e6400","layer":"original","quote":"曹公既破绍，自南击先主。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":92,"anchor":null},"note_id":null,"start":38,"end":50},{"id":"xianzhu-e-o022a-q","section":"chapter-032","block":"b-2d6f229edbd08467d35a","layer":"original","quote":"先主遣麋竺、孙乾，与刘表相闻〖6〗。表自郊迎〖7〗，以上宾礼待之；益其兵，使屯新野。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":93,"anchor":null},"note_id":null,"start":0,"end":42},{"id":"xianzhu-q-o014","section":"chapter-032","block":"b-9236c229b2cd9315f1e3","layer":"original","quote":"袁术欲经徐州北就袁绍，曹公遣先主督朱灵、路招要击术〖4〗。未至，术病死。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":60,"anchor":null},"note_id":null,"start":0,"end":36},{"id":"xianzhu-q-o017","section":"chapter-032","block":"b-7cba73e5d6ee78cda30a","layer":"original","quote":"东海昌霸反，郡县多叛曹公为先主〖7〗。众数万人，遣孙乾与袁绍连和〖8〗。曹公遣刘岱、王忠击之，不克。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":72,"anchor":null},"note_id":null,"start":0,"end":50},{"id":"xianzhu-q-o022","section":"chapter-032","block":"b-2d6f229edbd08467d35a","layer":"original","quote":"先主遣麋竺、孙乾，与刘表相闻〖6〗。表自郊迎〖7〗，以上宾礼待之；益其兵，使屯新野。荆州豪杰归先主者日益多，表疑其心；阴御之，﹝二﹞使拒夏侯惇、于禁等于博望〖8〗。久之，先主设伏兵，一旦自烧屯伪遁〖9〗；惇等追之，为伏兵所破。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":93,"anchor":null},"note_id":null,"start":0,"end":113},{"id":"xumisun-q-1c2f4314a4fc24763c48","section":"chapter-038","block":"b-5281f484a91fb394450e","layer":"original","quote":"先主领徐州，辟为从事","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":199,"anchor":null},"note_id":null,"start":14,"end":24},{"id":"xumisun-q-516007fef0c8e25f7e9d","section":"chapter-038","block":"b-5f2a20bb63d8044c30f1","layer":"original","quote":"先主定益州，乾自从事中郎为秉忠将军","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":201,"anchor":null},"note_id":null,"start":0,"end":17},{"id":"xumisun-q-727212c1a286e8fa4d24","section":"chapter-038","block":"b-7adb7d1923d89c2c9673","layer":"original","quote":"将适荆州，乾又与麋竺俱使刘表：皆如意指","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":200,"anchor":null},"note_id":null,"start":14,"end":33},{"id":"xumisun-q-752447933991ea8457b1","section":"chapter-038","block":"b-7adb7d1923d89c2c9673","layer":"original","quote":"先主之背曹公，遣乾自结袁绍","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":200,"anchor":null},"note_id":null,"start":0,"end":13},{"id":"xumisun-q-75fd4974d00ac0b0894a","section":"chapter-038","block":"b-5f2a20bb63d8044c30f1","layer":"original","quote":"顷之〖5〗，卒","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":201,"anchor":null},"note_id":null,"start":36,"end":43},{"id":"xumisun-q-bb92539297f2da44da5b","section":"chapter-038","block":"b-632ebc8c7d6e16ecc789","layer":"pei","quote":"玄荐乾于州：乾被辟命，玄所举也","attribution":"裴注·郑玄传","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":209,"anchor":null},"note_id":"n-05cede68e8cf6850413a","start":11,"end":26},{"id":"xumisun-q-e4ceabd8aeaed311117c","section":"chapter-038","block":"b-7adb7d1923d89c2c9673","layer":"original","quote":"后表与袁尚书，说其兄弟分争之变，曰：“每与刘左将军、孙公佑共论此事，未尝不痛心入骨，相为悲伤也。”其见重如此","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":200,"anchor":null},"note_id":null,"start":37,"end":91},{"id":"xumisun-q2-04d5d955e288785a7a1e","section":"chapter-038","block":"b-a99f4e860b172c5b859d","layer":"original","quote":"简雍字宪和，涿郡人也。少与先主有旧，随从周旋。先主至荆州，雍与麋竺、孙乾同为从事中郎；常为谈客，往来使命。","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":210,"anchor":null},"note_id":null,"start":0,"end":53},{"id":"xumisun-q2-0baebf1812702c3ab9f1","section":"chapter-038","block":"b-7adb7d1923d89c2c9673","layer":"original","quote":"先主之背曹公，遣乾自结袁绍；将适荆州，乾又与麋竺俱使刘表：皆如意指〖2〗。后表与袁尚书，说其兄弟分争之变，曰：“每与刘左将军、孙公佑共论此事，未尝不痛心入骨，相为悲伤也。”其见重如此。","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":200,"anchor":null},"note_id":null,"start":0,"end":92}],"profiles":{"xianzhu-p0027":{"fields":[],"directory":{"faction":"shu"}}},"directory_counts":{}}
