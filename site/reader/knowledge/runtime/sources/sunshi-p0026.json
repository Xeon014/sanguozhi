{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"liusima-e-o198","title":"胡轸诬构杀游殷，月余自说伏罪而死","accounts":[{"id":"liusima-a-f5893ae4b487d3bf609f","label":"裴注·三辅决录注","text":"胡轸诬构杀游殷，月余自说伏罪而死","evidence":["liusima-q-3eb8663b276159cc9428"]}],"participants":[{"person":"sunshi-p0026","role":"司录校尉，与游殷有隙，诬构杀殷；殷死月余得疾患，自说但言伏罪伏罪游功曹将鬼来，于是遂死","evidence":["liusima-q-3eb8663b276159cc9428"]},{"person":"liusima-p0046","role":"被诬构杀","evidence":["liusima-q-3eb8663b276159cc9428"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liusima-q-3eb8663b276159cc9428"]},"ordering_evidence":"liusima-q-3eb8663b276159cc9428","source_order":[15,159,141],"order":3298},{"id":"sunshi-e-p015a","title":"董卓命胡轸吕布迎孙坚","accounts":[{"id":"sunshi-e-p015a-account","label":"《英雄记》","text":"董卓命胡轸吕布迎孙坚","evidence":["sunshi-e-p015a-q"]}],"participants":[{"person":"wudi-p0053","role":"遣军","evidence":["sunshi-e-p015a-q"]},{"person":"sunshi-p0026","role":"统军","evidence":["sunshi-e-p015a-q"]},{"person":"wudi-p0088","role":"骑督","evidence":["sunshi-e-p015a-q"]},{"person":"wudi-p0119","role":"被攻","evidence":["sunshi-e-p015a-q"]}],"place":null,"time":{"label":"阳人战时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["sunshi-e-p015a-q"]},"ordering_evidence":"sunshi-e-p015a-q","source_order":[46,128,"P015a"],"order":8041},{"id":"sunshi-e-p015b","title":"吕布等恶胡轸伪称敌逃乱军致攻阳人失败","accounts":[{"id":"sunshi-e-p015b-account","label":"《英雄记》","text":"吕布等恶胡轸伪称敌逃乱军致攻阳人失败","evidence":["sunshi-e-p015b-q"]}],"participants":[{"person":"wudi-p0088","role":"扰军","evidence":["sunshi-e-p015b-q"]},{"person":"sunshi-p0026","role":"攻城失败","evidence":["sunshi-e-p015b-q"]}],"place":null,"time":{"label":"阳人战时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["sunshi-e-p015b-q"]},"ordering_evidence":"sunshi-e-p015b-q","source_order":[46,128,"P015b"],"order":8042}],"persons":[{"id":"sunshi-p0026","name":"胡轸","evidence":["sunshi-q-p015","liusima-q-3eb8663b276159cc9428"],"facts":[{"id":"sunshi-f0009","label":"字","text":"文才","evidence":["sunshi-f0009-q"]}],"aliases":[{"text":"文才","evidence":["sunshi-f0009-q"]}],"mentions":[{"id":"sunshi-m-p015-sunshi-p0026","kind":"mention","text":"文中提及","evidence":["sunshi-q-p015"]}]}],"evidence":[{"id":"liusima-q-3eb8663b276159cc9428","section":"chapter-015","block":"b-473bdeabf9a9e3929915","layer":"pei","quote":"殷先与司录校尉胡轸有隙，轸诬构，杀殷。殷死月余，轸得疾患；自说，但言‘伏罪，伏罪，游功曹将鬼来’。于是遂死","attribution":"裴注·三辅决录注","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":158,"anchor":null},"note_id":"n-4feaf9d5c7378b57140d","start":141,"end":194},{"id":"sunshi-e-p015a-q","section":"chapter-046","block":"b-6d0f497e31a00b1d031a","layer":"pei","quote":"初，坚讨董卓，到梁县之阳人。卓亦遣兵步骑五千迎之：陈郡太守胡轸为大督护，吕布为骑督，其余步骑将、校、都督者甚众。","attribution":"《英雄记》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":127,"anchor":null},"note_id":"n-91605f7caa3206871742","start":11,"end":67},{"id":"sunshi-e-p015b-q","section":"chapter-046","block":"b-6d0f497e31a00b1d031a","layer":"pei","quote":"轸字文才。性急，预宣言曰：‘今此行也，要当斩一青绶，乃整齐耳！’诸将闻而恶之。军到广成，去阳人城数十里；日暮，士马疲极，当止宿。又本受卓节度：宿广成，秣马饮食；以夜进兵，投晓攻城。诸将恶惮轸，欲贼败其事。布等宣言：‘阳人城中贼已走，当追寻之；不然失之矣！’便夜进军，城中守备甚设，不可掩袭。于是吏士饥渴，人马甚疲；且夜至，又无堑垒。释甲休息，而布又宣言相惊，云：‘城中贼出来！’军众扰乱奔走，皆弃甲，失鞍马；行十余里，定无贼。会天明，便还，拾取兵器，欲进攻城；城守已固，穿堑已深，轸等不能攻而还。","attribution":"《英雄记》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":127,"anchor":null},"note_id":"n-91605f7caa3206871742","start":67,"end":315},{"id":"sunshi-f0009-q","section":"chapter-046","block":"b-6d0f497e31a00b1d031a","layer":"pei","quote":"轸字文才","attribution":"《英雄记》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":127,"anchor":null},"note_id":"n-91605f7caa3206871742","start":67,"end":71},{"id":"sunshi-q-p015","section":"chapter-046","block":"b-6d0f497e31a00b1d031a","layer":"pei","quote":"﹝五﹞《英雄记》曰：“初，坚讨董卓，到梁县之阳人。卓亦遣兵步骑五千迎之：陈郡太守胡轸为大督护，吕布为骑督，其余步骑将、校、都督者甚众。轸字文才。性急，预宣言曰：‘今此行也，要当斩一青绶，乃整齐耳！’诸将闻而恶之。军到广成，去阳人城数十里；日暮，士马疲极，当止宿。又本受卓节度：宿广成，秣马饮食；以夜进兵，投晓攻城。诸将恶惮轸，欲贼败其事。布等宣言：‘阳人城中贼已走，当追寻之；不然失之矣！’便夜进军，城中守备甚设，不可掩袭。于是吏士饥渴，人马甚疲；且夜至，又无堑垒。释甲休息，而布又宣言相惊，云：‘城中贼出来！’军众扰乱奔走，皆弃甲，失鞍马；行十余里，定无贼。会天明，便还，拾取兵器，欲进攻城；城守已固，穿堑已深，轸等不能攻而还。”","attribution":"《英雄记》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":127,"anchor":null},"note_id":"n-91605f7caa3206871742","start":0,"end":316}],"profiles":{},"directory_counts":{}}
