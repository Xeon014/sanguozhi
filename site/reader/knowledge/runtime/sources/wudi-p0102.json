{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o029a","title":"曹操再征陶谦并破郯东军","accounts":[{"id":"wudi-e-o029a-account","label":"正文","text":"曹操留荀彧、程昱守鄄城，再征陶谦至东海；回经郯时击破曹豹、刘备，攻拔襄贲，所过多有杀戮。","evidence":["wudi-e-o029a-q"]},{"id":"lvzang-a-6f8d16c34ebaae68bf05","label":"正文","text":"兴平元年太祖复征陶谦","evidence":["lvzang-q-74319c5176f2b48f6187"]},{"id":"gongsuntao-a-b555ffd1adae6a584b89","label":"正文","text":"兴平元年太祖复东征略定琅邪东海","evidence":["gongsuntao-q-77e3697f3dcf475bd022"]}],"participants":[{"person":"cao-cao","role":"征讨","evidence":["wudi-e-o029a-q"]},{"person":"wudi-p0100","role":"留守","evidence":["wudi-e-o029a-q"]},{"person":"wudi-p0101","role":"留守","evidence":["wudi-e-o029a-q"]},{"person":"wudi-p0095","role":"被征讨","evidence":["wudi-e-o029a-q"]},{"person":"wudi-p0102","role":"邀击战败","evidence":["wudi-e-o029a-q"]},{"person":"liu-bei","role":"邀击战败","evidence":["wudi-e-o029a-q"]}],"place":{"text":"鄄城、东海、郯、襄贲","evidence":["wudi-e-o029a-q"]},"time":{"label":"兴平元年夏","year":194,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o029a-q","wudi-q-o028","wudi-q-b-927979d68d5dacfd36fe"],"chronology":"wudi-y194","dating_review":{"anchor":"wudi-q-o028","basis":"兴平元年夏","reviewed":true}},"source_order":[1,206,"O029a"],"order":97},{"id":"wudi-e-o048a","title":"刘备失下邳来投曹操","accounts":[{"id":"wudi-e-o048a-account","label":"正文","text":"吕布袭取下邳，刘备来投曹操；程昱建议早图刘备，曹操以招纳英雄为由拒绝。","evidence":["wudi-e-o048a-q"]},{"id":"xianzhu-e-o011a-account","label":"《先主传》正文","text":"刘备与袁术相持时，曹豹内应吕布，下邳失守，刘备妻子被虏，刘备转军海西。","evidence":["xianzhu-e-o011a-q"]},{"id":"xianzhu-a-p009-yingxiong","label":"《英雄记》","text":"《英雄记》记张飞欲杀曹豹，曹豹部众招吕布，张飞败走；与正文的守城叙述分列。","evidence":["xianzhu-q-p009-yingxiong"]},{"id":"xianzhu-e-o013a-account","label":"《先主传》正文","text":"刘备还小沛重聚万余兵，吕布出兵击败他；刘备归曹操，获厚遇并为豫州牧。","evidence":["xianzhu-e-o013a-q"]},{"id":"chengguo-a-d39ee7b7aa1f72659b7b","label":"正文","text":"刘备失徐州来归太祖","evidence":["chengguo-q-705e3235b353e56fbd21"]}],"participants":[{"person":"wudi-p0088","role":"袭取","evidence":["wudi-e-o048a-q"]},{"person":"liu-bei","role":"来投","evidence":["wudi-e-o048a-q"]},{"person":"wudi-p0101","role":"进言","evidence":["wudi-e-o048a-q"]},{"person":"cao-cao","role":"拒绝杀备","evidence":["wudi-e-o048a-q"]},{"person":"wudi-p0102","role":"迎吕布","evidence":["xianzhu-e-o011a-q"]},{"person":"wudi-p0367","role":"据《英雄记》守下邳败走","evidence":["xianzhu-q-p009-yingxiong"]}],"place":{"text":"下邳","evidence":["wudi-e-o048a-q"]},"time":{"label":"建安元年","year":196,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o048a-q","wudi-q-o040","wudi-q-b-16a5462151b1cfe5142d"],"chronology":"wudi-y196","dating_review":{"anchor":"wudi-q-o040","basis":"建安元年","reviewed":true}},"source_order":[1,286,"O048a"],"order":131},{"id":"lvzang-e-o026","title":"备东击术布袭取下邳备还归布","accounts":[{"id":"lvzang-a-8ddf58a6da2aa80f3e65","label":"正文","text":"备东击术布袭取下邳备还归布","evidence":["lvzang-q-c2736f75092f4f47b6db"]},{"id":"lvzang-a-8a245b07b51fbc5bb22f","label":"裴注·英雄记","text":"许耽夜遣司马章诳诣布约开门纳布","evidence":["lvzang-q-13dc8ea2fc86f34a5ffb"]},{"id":"lvzang-a-d61b2e601ef351209fd0","label":"裴注·英雄记","text":"张飞与曹豹共争杀豹城中大乱","evidence":["lvzang-q-5101f049546298ab705f"]},{"id":"lvzang-a-fc4ff60b5bf89aa5fc95","label":"裴注·英雄记","text":"布夜进丹杨兵开门纳布大破张飞兵获备妻子","evidence":["lvzang-q-4363f895496c8c4093a4"]},{"id":"xumisun-a-9520c14cbe21d0864e82","label":"正文","text":"吕布袭下邳虏刘备妻子","evidence":["xumisun-q-7cf2833d6b8800fdba3b"]}],"participants":[{"person":"liu-bei","role":"东击术、还归布","evidence":["lvzang-q-c2736f75092f4f47b6db"]},{"person":"wudi-p0088","role":"袭取下邳；被约开门者；遂夜进晨到城下、于门上坐步骑放火大破益德兵、获备妻子军资及部曲将吏士家口","evidence":["lvzang-q-c2736f75092f4f47b6db","lvzang-q-13dc8ea2fc86f34a5ffb","lvzang-q-4363f895496c8c4093a4"]},{"person":"wudi-p0057","role":"被击","evidence":["lvzang-q-c2736f75092f4f47b6db"]},{"person":"lvzang-p0021","role":"备中郎将丹杨人、夜遣司马章诳来诣布","evidence":["lvzang-q-13dc8ea2fc86f34a5ffb"]},{"person":"lvzang-p0015","role":"许耽司马、言张益德杀豹城中大乱不相信丹杨兵有千人屯西白门城内闻将军来东大小踊跃如复更生将军兵向城西门丹杨军便开门纳将军矣","evidence":["lvzang-q-13dc8ea2fc86f34a5ffb"]},{"person":"wudi-p0367","role":"与下邳相曹豹共争、杀豹；兵被破","evidence":["lvzang-q-5101f049546298ab705f","lvzang-q-4363f895496c8c4093a4"]},{"person":"wudi-p0102","role":"下邳相、被杀","evidence":["lvzang-q-5101f049546298ab705f"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["lvzang-q-c2736f75092f4f47b6db","lvzang-q-13dc8ea2fc86f34a5ffb","lvzang-q-5101f049546298ab705f","lvzang-q-4363f895496c8c4093a4"]},"ordering_evidence":"lvzang-q-c2736f75092f4f47b6db","source_order":[7,64,0],"order":1806}],"persons":[{"id":"wudi-p0102","name":"曹豹","evidence":["wudi-q-o029","xianzhu-q-o011","lvzang-q-5101f049546298ab705f"],"facts":[],"aliases":[],"mentions":[{"id":"wudi-m-o029-wudi-p0102","kind":"mention","text":"文中提及","evidence":["wudi-q-o029"]},{"id":"xianzhu-m-o011-wudi-p0102","kind":"mention","text":"文中提及","evidence":["xianzhu-q-o011"]},{"id":"xianzhu-m-p009-wudi-p0102","kind":"mention","text":"文中提及","evidence":["xianzhu-q-p009"]}]}],"evidence":[{"id":"chengguo-q-705e3235b353e56fbd21","section":"chapter-014","block":"b-e9401b31a90b17c74409","layer":"original","quote":"刘备失徐州，来归太祖","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":33,"anchor":null},"note_id":null,"start":0,"end":10},{"id":"gongsuntao-q-77e3697f3dcf475bd022","section":"chapter-008","block":"b-d4288ccd4470bb04ff2a","layer":"original","quote":"兴平元年，复东征，略定琅邪、东海诸县；谦恐，欲走归丹杨","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":126,"anchor":null},"note_id":null,"start":0,"end":27},{"id":"lvzang-q-13dc8ea2fc86f34a5ffb","section":"chapter-007","block":"b-630d90f48255ffda7b80","layer":"pei","quote":"备中郎将丹杨许耽，夜遣司马章诳来诣布，言：‘张益德与下邳相曹豹共争，益德杀豹；城中大乱，不相信。丹杨兵有千人屯西白门城内，闻将军来东，大小踊跃，如复更生。将军兵向城西门，丹杨军便开门纳将军矣","attribution":"裴注·英雄记","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":76,"anchor":null},"note_id":"n-c3c03b97c67239fef561","start":23,"end":118},{"id":"lvzang-q-4363f895496c8c4093a4","section":"chapter-007","block":"b-630d90f48255ffda7b80","layer":"pei","quote":"布遂夜进，晨到城下。天明，丹杨兵悉开门，纳布兵。布于门上坐，步骑放火，大破益德兵，获备妻子军资及部曲将吏士家口","attribution":"裴注·英雄记","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":76,"anchor":null},"note_id":"n-c3c03b97c67239fef561","start":120,"end":175},{"id":"lvzang-q-5101f049546298ab705f","section":"chapter-007","block":"b-630d90f48255ffda7b80","layer":"pei","quote":"张益德与下邳相曹豹共争，益德杀豹；城中大乱，不相信","attribution":"裴注·英雄记","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":76,"anchor":null},"note_id":"n-c3c03b97c67239fef561","start":45,"end":70},{"id":"lvzang-q-74319c5176f2b48f6187","section":"chapter-007","block":"b-3ecb53f343c9ec34aa0e","layer":"original","quote":"兴平元年，太祖复征谦","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":44,"anchor":null},"note_id":null,"start":0,"end":10},{"id":"lvzang-q-c2736f75092f4f47b6db","section":"chapter-007","block":"b-f03f33c3a4feb9149046","layer":"original","quote":"备东击术，布袭取下邳。备还归布","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":63,"anchor":null},"note_id":null,"start":0,"end":15},{"id":"wudi-e-o029a-q","section":"chapter-001","block":"b-8f42ea81154b4797c2b1","layer":"original","quote":"夏，使荀彧、程昱守鄄城〖3〗；复征陶谦，拔五城，遂略地至东海〖4〗。还过郯〖5〗；谦将曹豹与刘备屯郯东，要太祖〖6〗。太祖击破之，遂攻拔襄贲〖7〗。所过多所残戮。﹝二﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":205,"anchor":null},"note_id":null,"start":0,"end":84},{"id":"wudi-e-o048a-q","section":"chapter-001","block":"b-76c1b3b4753740d2a425","layer":"original","quote":"吕布袭刘备，取下邳〖7〗，备来奔。程昱说公曰：“观刘备有雄才而甚得众心，终不为人下；不如早图之〖8〗。”公曰：“方今收英雄时也；杀一人而失天下之心，不可！”","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":285,"anchor":null},"note_id":null,"start":0,"end":78},{"id":"wudi-q-b-16a5462151b1cfe5142d","section":"chapter-001","block":"b-16a5462151b1cfe5142d","layer":"modern","quote":"〖1〗建安元年：公元 196 年。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":264,"anchor":null},"note_id":"n-df2756e12f4ac1fef3c4","start":0,"end":17},{"id":"wudi-q-b-927979d68d5dacfd36fe","section":"chapter-001","block":"b-927979d68d5dacfd36fe","layer":"modern","quote":"〖1〗二年：兴平二年（公元 195）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":246,"anchor":null},"note_id":"n-8c38464987eb86819ded","start":0,"end":19},{"id":"wudi-q-o028","section":"chapter-001","block":"b-fefe0240b8480efce927","layer":"original","quote":"兴平元年春，太祖自徐州还〖1〗。初，太祖父嵩，去官后还谯。董卓之乱，避难琅邪〖2〗。为陶谦所害，故太祖志在复仇东伐。﹝一﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":204,"anchor":null},"note_id":null,"start":0,"end":61},{"id":"wudi-q-o029","section":"chapter-001","block":"b-8f42ea81154b4797c2b1","layer":"original","quote":"夏，使荀彧、程昱守鄄城〖3〗；复征陶谦，拔五城，遂略地至东海〖4〗。还过郯〖5〗；谦将曹豹与刘备屯郯东，要太祖〖6〗。太祖击破之，遂攻拔襄贲〖7〗。所过多所残戮。﹝二﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":205,"anchor":null},"note_id":null,"start":0,"end":84},{"id":"wudi-q-o040","section":"chapter-001","block":"b-c71d10ef121af30ac6b7","layer":"original","quote":"建安元年春正月〖1〗，太祖军临武平〖2〗。袁术所置陈相袁嗣，降。太祖将迎天子，诸将或疑；荀彧、程昱劝之。乃遣曹洪将兵西迎。卫将军董承与袁术将苌奴拒险〖3〗，洪不得进。汝南、颍川黄巾何仪、刘辟、黄邵、何曼等〖4〗，众各数万。初应袁术，又附孙坚〖5〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":258,"anchor":null},"note_id":null,"start":0,"end":124},{"id":"xianzhu-e-o011a-q","section":"chapter-032","block":"b-50264f958d931f9c772f","layer":"original","quote":"先主与术相持经月，吕布乘虚袭下邳；下邳守将曹豹反，间迎布〖11〗，布虏先主妻子。先主转军海西。﹝二﹞","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":41,"anchor":null},"note_id":null,"start":0,"end":50},{"id":"xianzhu-e-o013a-q","section":"chapter-032","block":"b-2bcaabf007ae7b6068f2","layer":"original","quote":"先主还小沛，﹝一﹞复合兵得万余人。吕布恶之，自出兵攻先主。先主败走归曹公〖1〗，曹公厚遇之〖2〗，以为豫州牧。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":59,"anchor":null},"note_id":null,"start":0,"end":55},{"id":"xianzhu-q-o011","section":"chapter-032","block":"b-50264f958d931f9c772f","layer":"original","quote":"先主与术相持经月，吕布乘虚袭下邳；下邳守将曹豹反，间迎布〖11〗，布虏先主妻子。先主转军海西。﹝二﹞杨奉、韩暹寇徐、扬间，先主邀击，尽斩之〖12〗。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":41,"anchor":null},"note_id":null,"start":0,"end":74},{"id":"xianzhu-q-p009","section":"chapter-032","block":"b-ef8a371cd9d1306e2091","layer":"pei","quote":"﹝二﹞《英雄记》曰：“备留张飞，守下邳；引兵，与袁术战于淮阴石亭，更有胜负。陶谦故将曹豹，在下邳，张飞欲杀之。豹众坚营自守，使人招吕布。布取下邳，张飞败走。备闻之，引兵还；比至下邳，兵溃。收散卒东取广陵，与袁术战，又败。”","attribution":"《英雄记》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":57,"anchor":null},"note_id":"n-b611f3a7f8dac2f2633d","start":0,"end":111},{"id":"xianzhu-q-p009-yingxiong","section":"chapter-032","block":"b-ef8a371cd9d1306e2091","layer":"pei","quote":"备留张飞，守下邳；引兵，与袁术战于淮阴石亭，更有胜负。陶谦故将曹豹，在下邳，张飞欲杀之。豹众坚营自守，使人招吕布。布取下邳，张飞败走。","attribution":"《英雄记》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":57,"anchor":null},"note_id":"n-b611f3a7f8dac2f2633d","start":11,"end":78},{"id":"xumisun-q-7cf2833d6b8800fdba3b","section":"chapter-038","block":"b-9dceb360e52be8061153","layer":"original","quote":"建安元年，吕布乘先主之出拒袁术，袭下邳，虏先主妻子","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":174,"anchor":null},"note_id":null,"start":0,"end":25}],"profiles":{},"directory_counts":{}}
