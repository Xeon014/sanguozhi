f954","order":9108}],"persons":[{"id":"santizhu-p0064","name":"滕氏","evidence":["santizhu-q-7736251588e57a18edc4","feipin-q-2fead510f96cdddb5730","feipin-q-6b30bba72d9c7973cfb8","feipin-q-b955df082796fdc3f954","feipin-q-b3584fd1c8b80cd596c9","feipin-q-6a99221153a8f41417b6","feipin-q-bc9eea6589e7f8c1af03","feipin-q-58068ccc8e37347b3c09","feipin-q-0f27e139775d2922cc4b"],"facts":[{"id":"feipin-f-123753d04d6aa8a11aec","text":"父：滕牧","evidence":["feipin-q-58068ccc8e37347b3c09"]},{"id":"feipin-f-06d93bb101a745c427ca","text":"族属：滕胤族女","evidence":["feipin-q-0f27e139775d2922cc4b"]}],"aliases":[],"mentions":[]}],"evidence":[{"id":"feipin-q-0f27e139775d2922cc4b","section":"chapter-050","block":"b-e1826f754b9123141685","layer":"original","quote":"孙皓滕夫人，故太常胤之族女也。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":147,"anchor":null},"note_id":null,"start":0,"end":15},{"id":"feipin-q-2fead510f96cdddb5730","section":"chapter-050","block":"b-09aa26dfcc979122d530","layer":"original","quote":"后朝士以牧尊戚〖3〗，颇推令谏争。而夫人宠渐衰，皓滋不悦〖4〗；皓母何，恒左右之〖5〗。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":148,"anchor":null},"note_id":null,"start":38,"end":82},{"id":"feipin-q-58068ccc8e37347b3c09","section":"chapter-050","block":"b-e1826f754b9123141685","layer":"original","quote":"夫人父牧，以疏远徙边郡","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":147,"anchor":null},"note_id":null,"start":19,"end":30},{"id":"feipin-q-6a99221153a8f41417b6","section":"chapter-050","block":"b-09aa26dfcc979122d530","layer":"original","quote":"皓既封乌程侯，聘牧女为妃。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":148,"anchor":null},"note_id":null,"start":0,"end":13},{"id":"feipin-q-6b30bba72d9c7973cfb8","section":"chapter-050","block":"b-09aa26dfcc979122d530","layer":"original","quote":"又太史言〖6〗：于运历〖7〗，后不可易〖8〗；皓信巫觋〖9〗，故得不废，常供养升平宫。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":148,"anchor":null},"note_id":null,"start":82,"end":125},{"id":"feipin-q-b3584fd1c8b80cd596c9","section":"chapter-050","block":"b-a4df55f65ecc17e8d314","layer":"original","quote":"天纪四年，随皓迁于洛阳。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":150,"anchor":null},"note_id":null,"start":0,"end":12},{"id":"feipin-q-b955df082796fdc3f954","section":"chapter-050","block":"b-dd96e7dd37b1c8b40940","layer":"original","quote":"长秋官僚〖10〗，备员而已〖11〗，受朝贺表疏如故；而皓内诸宠姬，佩皇后玺（绂）〔绶〕者多矣。﹝一﹞","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":149,"anchor":null},"note_id":null,"start":30,"end":80},{"id":"feipin-q-bc9eea6589e7f8c1af03","section":"chapter-050","block":"b-09aa26dfcc979122d530","layer":"original","quote":"皓即位，立为皇后。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":148,"anchor":null},"note_id":null,"start":13,"end":22},{"id":"santizhu-q-42922673a1cfdb2b4e50","section":"chapter-048","block":"b-bdc91c75897c00a521d5","layer":"original","quote":"皓举家西迁，以太康元年五月丁亥集于京邑〖14〗","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":525,"anchor":null},"note_id":null,"start":14,"end":37},{"id":"santizhu-q-7736251588e57a18edc4","section":"chapter-048","block":"b-b5a09828df335fbb4456","layer":"original","quote":"立皇后滕氏","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":310,"anchor":null},"note_id":null,"start":37,"end":42}],"profiles":{},"directory_counts":{}}
