d51ea073f"]},"ordering_evidence":"feipin-q-6d61eca1778d51ea073f","order":9076},{"id":"hequan-e-o138","title":"祎仪静等降魏历郡守列侯","accounts":[{"id":"hequan-a-e8fce090eac6e795e1ea","label":"正文","text":"祎仪静等降魏历郡守列侯","evidence":["hequan-q-cb35c6332b8f1c8d4e39"]}],"participants":[{"person":"santizhu-p0024","role":"全怿兄子、降魏、历郡守列侯","evidence":["hequan-q-cb35c6332b8f1c8d4e39"]},{"person":"wgc-p0042","role":"降魏、历郡守列侯","evidence":["hequan-q-cb35c6332b8f1c8d4e39"]},{"person":"wgc-p0038","role":"降魏、历郡守列侯","evidence":["hequan-q-cb35c6332b8f1c8d4e39"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["hequan-q-cb35c6332b8f1c8d4e39"]},"ordering_evidence":"hequan-q-cb35c6332b8f1c8d4e39","source_order":[60,149,44],"order":10580}],"persons":[{"id":"wgc-p0042","name":"全仪","evidence":["wgc-q0067","santizhu-q-a4c506d10781afc85076","hequan-q-cb35c6332b8f1c8d4e39","feipin-q-6d61eca1778d51ea073f"],"aliases":[],"facts":[],"mentions":[{"id":"wgc-m-o086-wgc-p0042","kind":"mention","text":"本段涉及全仪","evidence":["wgc-q0067"]}]}],"evidence":[{"id":"feipin-q-6d61eca1778d51ea073f","section":"chapter-050","block":"b-133fdadf2671af7b34a3","layer":"original","quote":"及魏大将诸葛诞以寿春来附，而全怿、全端、全祎、全仪等，并因此际降魏；全熙谋泄见杀：由是诸全衰弱。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":113,"anchor":null},"note_id":null,"start":0,"end":48},{"id":"hequan-q-cb35c6332b8f1c8d4e39","section":"chapter-060","block":"b-7d40498a2406c90a8f04","layer":"original","quote":"怿兄子祎、仪、静等，亦降魏，皆历郡守、列侯","section_title":"贺全吕周钟离传第十五","source":{"file":"OEBPS/Text/titlepage_0127.xhtml","index":148,"anchor":null},"note_id":null,"start":44,"end":65},{"id":"santizhu-q-a4c506d10781afc85076","section":"chapter-048","block":"b-42b7e8e5ba14bda04d7d","layer":"original","quote":"十一月，全绪子祎、仪，以其母奔魏","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":96,"anchor":null},"note_id":null,"start":0,"end":16},{"id":"wgc-q0067","section":"chapter-028","block":"b-19a57525c37bf4f5767a","layer":"original","quote":"甘露二年，征诸葛诞为司空。时，会丧宁在家〖1〗，策诞必不从命，驰白文王。文王以事已施行，不复追改。﹝一﹞及诞反，车驾住项；文王至寿春，会复从行。初，吴大将全琮，孙权之婚亲重臣也〖2〗；琮子怿、孙静、从子端、翩、缉等，皆将兵来救诞。怿兄子辉、仪留建业，与其家内争讼；携其母，将部曲数十家渡江，自归文王。会建策，密为辉、仪作书，使辉、仪所亲信，赍入城告怿等，说“吴中怒怿等不能拔寿春，欲尽诛诸将家，故逃来归命”。怿等恐惧，遂将所领，开东城门出降，皆蒙封宠，城中由是乖离。寿春之破，会谋居多。亲待日隆，时人谓之子房〖3〗。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":455,"anchor":null},"note_id":null,"start":0,"end":258},{"id":"wgc-q0435","section":"chapter-028","block":"b-19a57525c37bf4f5767a","layer":"original","quote":"辉、仪留建业，与其家内争讼；携其母，将部曲数十家渡江，自归文王","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":455,"anchor":null},"note_id":null,"start":118,"end":149}],"profiles":{},"directory_counts":{}}
