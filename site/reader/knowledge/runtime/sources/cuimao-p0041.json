151ca6070e3a","hechang-q-6d1758efc3f5d6f35792","hechang-q-ece5c4d574c4fc74c3d5","hechang-q-22eb0cefaa9caa62ad33","hechang-q-865ad0fed0e33e0ea875","hechang-q-ad03a383239f383e7d42","hechang-q-756730fc29fa0ae234a1","hechang-q-b890de04a005f66fe56b","hechang-q-40c70253dbf875c9e97e","hechang-q-79f3ac5b87acc684c65c","hechang-q-d5d28ae82e54076a161a","hechang-q-f498d76b830ccfe270ec"],"facts":[{"id":"hechang-f-8b617407149793a70f88","text":"字季才，河内获嘉人。","evidence":["hechang-q-f498d76b830ccfe270ec"]}],"aliases":[],"mentions":[]}],"evidence":[{"id":"cuimao-q-581b101be0243db9d787","section":"chapter-012","block":"b-b98fdf30cfe006001885","layer":"original","quote":"魏讽等谋反，中尉杨俊左迁","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":189,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":25,"end":37,"offset_unit":"unicode_code_point"},{"id":"cuimao-q-8fd4808d2660c994efd7","section":"chapter-012","block":"b-a2e3d13b9c0739908e8a","layer":"original","quote":"太祖乃以奕为中尉，手令曰：“昔楚有子玉〖5〗，文公为之侧席而坐〖6〗；汲黯在朝〖7〗，淮南为之折谋〖8〗。《诗》称‘邦之司直’，君之谓与","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":190,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":68,"offset_unit":"unicode_code_point"},{"id":"cuimao-q-b4c9a17a0d2dac2e0b22","section":"chapter-012","block":"b-b98fdf30cfe006001885","layer":"original","quote":"太祖叹曰：“讽所以敢生乱心，以吾爪牙之臣无遏奸防谋者故也。安得如诸葛丰者〖4〗，使代俊乎？”桓阶曰：“徐奕其人也","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":189,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":41,"end":97,"offset_unit":"unicode_code_point"},{"id":"guanzhang-e-o008b-q","section":"chapter-036","block":"b-b96955cde6bd0ef2541b","layer":"original","quote":"是岁，羽率众攻曹仁于樊。曹公遣于禁助仁。秋，大霖雨，汉水泛溢，禁所督七军皆没；禁降羽，羽又斩将军庞德〖2〗；梁、郏、陆浑群盗或遥受羽印号〖3〗，为之支党。羽威震华夏〖4〗，","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":35,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":27,"end":113,"offset_unit":"unicode_code_point"},{"id":"hechang-q-22eb0cefaa9caa62ad33","section":"chapter-023","block":"b-3b8ff2c2fddfc45f6c4f","layer":"original","quote":"司马宣王年十六七，与俊相遇。俊曰：“此非常之人也。”又司马朗早有声名〖5〗；其族兄芝〖6〗，众未之知。惟俊言曰：“芝虽夙望不及朗〖7〗，实理但有优耳","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":145,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":74,"offset_unit":"unicode_code_point"},{"id":"hechang-q-2d7d3826f2ff061c20bb","section":"chapter-023","block":"b-15e74fbb83c4abf58213","layer":"original","quote":"文帝践阼，复在南阳。时王象为散骑常侍，荐俊曰：“伏见南阳太守杨俊，秉纯粹之茂质，履忠肃之弘量；体仁足以育物，笃实足以动众〖1〗；克长后进〖2〗，惠训不倦；外宽内直，仁而有断。自初弹冠〖3〗，所历垂化〖4〗；再守南阳〖5〗，恩德流著；殊邻异党〖6〗，襁负而至〖7〗。今境守清静，无所展其智能；宜还本朝，宣力辇毂〖8〗，熙帝之载〖9〗。”","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":166,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":167,"offset_unit":"unicode_code_point"},{"id":"hechang-q-40c70253dbf875c9e97e","section":"chapter-023","block":"b-ae76479fd4313f88addf","layer":"original","quote":"徙为征南军师〖13〗。魏国既建，迁中尉〖14〗。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":146,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":51,"end":75,"offset_unit":"unicode_code_point"},{"id":"hechang-q-6d1758efc3f5d6f35792","section":"chapter-023","block":"b-15c36722dad634b46ebb","layer":"original","quote":"受学陈留边让〖2〗，让器异之。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":144,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":16,"end":31,"offset_unit":"unicode_code_point"},{"id":"hechang-q-72111c3c787ddbad6138","section":"chapter-023","block":"b-66af4b5f3871179a7ccb","layer":"original","quote":"太祖征汉中，魏讽反于邺，俊自劾诣行在所〖15〗。俊以身方罪免，笺辞太子〖16〗。太子不悦，曰：“杨中尉便去，何太高远邪〖17〗！”遂被书左迁平原太守。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":147,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":75,"offset_unit":"unicode_code_point"},{"id":"hechang-q-756730fc29fa0ae234a1","section":"chapter-023","block":"b-ae76479fd4313f88addf","layer":"original","quote":"入为丞相掾、属。举茂才，安陵令〖12〗。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":146,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":12,"end":32,"offset_unit":"unicode_code_point"},{"id":"hechang-q-79f3ac5b87acc684c65c","section":"chapter-023","block":"b-89b0dbd6f8f4599ec881","layer":"original","quote":"俊自少及长，以人伦自任〖10〗。同郡审固、陈留卫恂，本皆出自兵伍；俊资拔奖致，咸作佳士。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":167,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":44,"offset_unit":"unicode_code_point"},{"id":"hechang-q-82ae2818151ca6070e3a","section":"chapter-023","block":"b-ab97e3071a95f7f68c96","layer":"original","quote":"后刺史梁习，荐州界名士林及杨俊、王凌、王象、荀纬〖1〗，太祖皆以为县长。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":114,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":36,"offset_unit":"unicode_code_point"},{"id":"hechang-q-865ad0fed0e33e0ea875","section":"chapter-023","block":"b-3b8ff2c2fddfc45f6c4f","layer":"original","quote":"俊转避地并州。本郡王象，少孤特〖9〗。为人仆隶，年十七八，见使牧羊而私读书，因被箠楚〖10〗。俊嘉其才质，即赎象著家；聘娶立屋，然后与别。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":145,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":79,"end":148,"offset_unit":"unicode_code_point"},{"id":"hechang-q-874de2199c50e9856683","section":"chapter-023","block":"b-4e01b5b45bf228d7cf29","layer":"original","quote":"初，临淄侯与俊善。太祖嫡嗣未定，密访群司〖11〗。俊虽并论文帝、临淄才分所长〖12〗，不适有所据当〖13〗；然称临淄尤美，文帝常以恨之。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":168,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":68,"offset_unit":"unicode_code_point"},{"id":"hechang-q-ad03a383239f383e7d42","section":"chapter-023","block":"b-ae76479fd4313f88addf","layer":"original","quote":"太祖除俊曲梁长〖11〗。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":146,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":12,"offset_unit":"unicode_code_point"},{"id":"hechang-q-b890de04a005f66fe56b","section":"chapter-023","block":"b-ae76479fd4313f88addf","layer":"original","quote":"迁南阳太守。宣德教，立学校，吏民称之。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":146,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":32,"end":51,"offset_unit":"unicode_code_point"},{"id":"hechang-q-ba2cc62f0a8fcbcaa694","section":"chapter-023","block":"b-9f843515ac2d0078199f","layer":"original","quote":"黄初三年，车驾至宛〖14〗，以市不丰乐，发怒收俊。尚书仆射司马宣王、常侍王象、苟纬请俊〖15〗，叩头流血；帝不许。俊曰：“吾知罪矣！”遂自杀。众冤痛之。﹝一﹞","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":169,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":79,"offset_unit":"unicode_code_point"},{"id":"hechang-q-d5d28ae82e54076a161a","section":"chapter-023","block":"b-ae4bff4520e3cf6e72c3","layer":"pei","quote":"车驾南巡，未到宛，有诏：‘百官不得干豫郡县。’及车驾到，而宛令不解诏旨，闭市门。帝闻之，忿然曰：‘吾是寇邪？’乃收宛令及太守杨俊。诏问尚书：‘汉明帝杀几二千石？’时象见诏文，知俊必不免。乃当帝前叩头，流血竟面，请俊减死一等。帝不答，欲释，入禁中。象引帝衣，帝顾谓象曰：‘我知杨俊与卿本末耳。今听卿，是无我也！卿宁无俊邪？无我邪？’象以帝言切，乃缩手。帝遂入，决俊法，然后乃出。","attribution":"裴注引《魏略》","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":188,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-782ce6c2a2abb258a623","start":171,"end":359,"offset_unit":"unicode_code_point"},{"id":"hechang-q-ece5c4d574c4fc74c3d5","section":"chapter-023","block":"b-15c36722dad634b46ebb","layer":"original","quote":"俊以兵乱方起，而河内处四达之衢，必为战场；乃扶持老弱诣京、密山间〖3〗，同行者百余家。俊赈济贫乏，通共有无。宗族、知故为人所略作奴仆者凡六家〖4〗，俊皆倾财赎之。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":144,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":31,"end":112,"offset_unit":"unicode_code_point"},{"id":"hechang-q-f498d76b830ccfe270ec","section":"chapter-023","block":"b-15c36722dad634b46ebb","layer":"original","quote":"杨俊字季才，河内获嘉人也〖1〗。受学陈留边让〖2〗，让器异之。俊以兵乱方起，而河内处四达之衢，必为战场；乃扶持老弱诣京、密山间〖3〗，同行者百余家。俊赈济贫乏，通共有无。宗族、知故为人所略作奴仆者凡六家〖4〗，俊皆倾财赎之。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":144,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":112,"offset_unit":"unicode_code_point"},{"id":"hequan-q-ca8e4a8dd9b29a576654","section":"chapter-060","block":"b-b5253083967b499636ae","layer":"original","quote":"建安二十四年，刘备将关羽围樊、襄阳","section_title":"贺全吕周钟离传第十五","source":{"file":"OEBPS/Text/titlepage_0127.xhtml","index":109,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":17,"offset_unit":"unicode_code_point"},{"id":"lizang-q-45b0aacbba69dbd57302","section":"chapter-018","block":"b-76f360b0363911f34631","layer":"original","quote":"立而不跪。羽谓曰：“卿兄在汉中。我欲以卿为将，不早降何为？”德骂羽曰：“竖子，何谓降也！魏王带甲百万，威振天下。汝刘备庸才耳，岂能敌邪？我宁为国家鬼，不为贼将也！”遂为羽所杀","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":205,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":87,"offset_unit":"unicode_code_point"},{"id":"lizang-q-4ef32b63a7f5ff4d8c5b","section":"chapter-018","block":"b-600ec9e048958a94c35d","layer":"original","quote":"德常曰：“我受国恩，义在效死〖4〗。我欲身自击羽。今年我不杀羽，羽当杀我","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":202,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":94,"end":130,"offset_unit":"unicode_code_point"},{"id":"lizang-q-56bae898459683465bc1","section":"chapter-018","block":"b-600ec9e048958a94c35d","layer":"original","quote":"遂南屯樊，讨关羽","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":202,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":63,"end":71,"offset_unit":"unicode_code_point"},{"id":"lizang-q-66c8264ad0149c8289af","section":"chapter-018","block":"b-cc028a9b73eabe99bd16","layer":"original","quote":"仁使德屯樊北十里","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":203,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":8,"offset_unit":"unicode_code_point"},{"id":"lizang-q-ae7afaab0329f7bde126","section":"chapter-018","block":"b-cc028a9b73eabe99bd16","layer":"original","quote":"将军董衡、部曲将董超等欲降，德皆收斩之","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":203,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":66,"end":85,"offset_unit":"unicode_code_point"},{"id":"lizang-q-d1ff6efce8f94c6690bb","section":"chapter-018","block":"b-cc028a9b73eabe99bd16","layer":"original","quote":"会天霖雨十余日，汉水暴溢；樊下平地五六丈，德与诸将避水，上堤。羽乘船攻之，以大船四面射堤上。德被甲持弓，箭不虚发","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":203,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":9,"end":65,"offset_unit":"unicode_code_point"},{"id":"lizang-q-d43cbf6f9121717251c4","section":"chapter-018","block":"b-54a51096c7c075758eb4","layer":"original","quote":"德谓督将成何曰：“吾闻良将不怯死以苟免，烈士不毁节以求生；今日，我死日也","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":204,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":36,"offset_unit":"unicode_code_point"},{"id":"lizang-q-d5573e7894d8f4ba3e69","section":"chapter-018","block":"b-54a51096c7c075758eb4","layer":"original","quote":"战益怒，气愈壮；而水浸盛，吏士皆降。德与麾下将一人，伍伯二人〖5〗，弯弓傅矢〖6〗，乘小船，欲还仁营；水盛船覆，失弓矢；独抱船覆水中，为羽所得","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":204,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":38,"end":109,"offset_unit":"unicode_code_point"},{"id":"lizang-q-e8c144058b1ba9ddbc2c","section":"chapter-018","block":"b-600ec9e048958a94c35d","layer":"original","quote":"后亲与羽交战，射羽中额","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":202,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":132,"end":143,"offset_unit":"unicode_code_point"},{"id":"lizang-q-ee14036e58a0b89ec583","section":"chapter-018","block":"b-cc028a9b73eabe99bd16","layer":"original","quote":"自平旦力战至日过中，羽攻益急；矢尽，短兵接战","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":203,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":86,"end":108,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o197b-q","section":"chapter-001","block":"b-01554a0b2561dc520574","layer":"original","quote":"遣于禁助曹仁，击关羽。八月，汉水溢，灌禁军，军没。羽获禁，遂围仁。使徐晃救之。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":425,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":16,"end":55,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-1e7ae1441471aa22d204","section":"chapter-001","block":"b-1e7ae1441471aa22d204","layer":"modern","quote":"〖1〗二十四年：建安二十四年（公元 219）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":428,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f2589f07b550616f1e63","start":0,"end":23,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o194","section":"chapter-001","block":"b-adb6682558d65fc17e1a","layer":"original","quote":"二十四年春正月〖1〗，仁屠宛，斩音。﹝一﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":422,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"wuzhu-e-o034a-q","section":"chapter-047","block":"b-39b849dfb87fdd3c9c49","layer":"original","quote":"二十四年〖8〗，关羽围曹仁于襄阳；曹公遣左将军于禁救之〖9〗。会汉水暴起，羽以舟兵尽虏禁等步骑三万，送江陵，惟城未拔。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":151,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":59,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o060b-q","section":"chapter-032","block":"b-4b69b4fde2ac4ee74852","layer":"original","quote":"时关羽攻曹公将曹仁，擒于禁于樊。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":279,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":25,"end":41,"offset_unit":"unicode_code_point"},{"id":"zhangle-e-o026b-q","section":"chapter-017","block":"b-b487aba048617fe0bc2c","layer":"original","quote":"建安二十四年，太祖在长安，使曹仁讨关羽于樊，又遣禁助仁。秋，大霖雨，汉水溢，平地水数丈，禁等七军皆没。禁与诸将登高望水，无所回避。羽乘大船就攻禁等，禁遂降；惟庞德不屈节而死。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":78,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":22,"end":109,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
