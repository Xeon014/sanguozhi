{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[],"persons":[{"id":"zhangyan-p-d1566afa505af0","name":"国（孟尝君后）","evidence":["zhangyan-q-ec03752330d0ac27eb01"],"facts":[],"mentions":[{"id":"zhangyan-m-cfd103e00524948b09c4","kind":"mention","text":"《吴录》称孟尝君之孙，与兄陵相推莫适受封，乃去之竹邑，故薛氏世典州郡自国始","evidence":["zhangyan-q-ec03752330d0ac27eb01"]}],"aliases":[]}],"evidence":[{"id":"zhangyan-q-ec03752330d0ac27eb01","section":"chapter-053","block":"b-18d287f880472b612eed","layer":"pei","quote":"﹝一﹞《吴录》曰：“其先齐孟尝君，封于薛。秦灭六国，而失其祀，子孙分散。汉祖定天下，过齐；求孟尝后，得其孙陵、国二人，欲复其封。陵、国兄弟相推，莫适受；乃去，之竹邑，因家焉，故遂氏薛。自国至综，世典州郡，为著姓。综少明经，善属文，有秀才。”","attribution":"裴注·吴录","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":162,"anchor":null},"note_id":"n-4e63e9f45d7036b7ec60","start":0,"end":120}],"profiles":{},"directory_counts":{}}
