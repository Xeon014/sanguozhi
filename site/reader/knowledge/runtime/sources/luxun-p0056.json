p015a-q"]}],"participants":[{"person":"luxun-p0056","role":"怀民","evidence":["luxun-e-p015a-q"]},{"person":"luxun-p0048","role":"诫边戍","evidence":["luxun-e-p015a-q"]}],"place":null,"time":{"label":"羊祜归军后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["luxun-e-p015a-q"]},"ordering_evidence":"luxun-e-p015a-q","source_order":[58,377,"P015a"],"order":10398},{"id":"luxun-e-p015b","title":"陆抗病求羊祜药而服不答诸将之谏","accounts":[{"id":"luxun-e-p015b-account","label":"《汉晋春秋》","text":"陆抗病求羊祜药而服不答诸将之谏","evidence":["luxun-e-p015b-q"]}],"participants":[{"person":"luxun-p0048","role":"求药服药","evidence":["luxun-e-p015b-q"]},{"person":"luxun-p0056","role":"赠药","evidence":["luxun-e-p015b-q"]}],"place":null,"time":{"label":"羊祜归军后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["luxun-e-p015b-q"]},"ordering_evidence":"luxun-e-p015b-q","source_order":[58,377,"P015b"],"order":10399}],"persons":[{"id":"luxun-p0056","name":"羊祜","evidence":["luxun-q-o071","santizhu-q-8c8f8db2723f7d72ccdc","zhanggu-q-4e6bf5ff89170aad6e55","zhanggu-q-12a904f491b9d053a45f","xinyang-q-bbec4cb3478035ff81ad"],"facts":[],"aliases":[],"mentions":[{"id":"luxun-m-o071-luxun-p0056","kind":"mention","text":"文中提及","evidence":["luxun-q-o071"]},{"id":"luxun-m-o072-luxun-p0056","kind":"mention","text":"文中提及","evidence":["luxun-q-o072"]},{"id":"luxun-m-o074-luxun-p0056","kind":"mention","text":"文中提及","evidence":["luxun-q-o074"]},{"id":"luxun-m-p014-luxun-p0056","kind":"mention","text":"文中提及","evidence":["luxun-q-p014"]},{"id":"luxun-m-p015-luxun-p0056","kind":"mention","text":"文中提及","evidence":["luxun-q-p015"]},{"id":"luxun-m-p016-luxun-p0056","kind":"mention","text":"文中提及","evidence":["luxun-q-p016"]},{"id":"luxun-m-o073-luxun-p0056","kind":"mention","text":"文中提及","evidence":["luxun-q-o073"]}]}],"evidence":[{"id":"luxun-e-o071a-q","section":"chapter-058","block":"b-94f14aac77ba81b02a56","layer":"original","quote":"围备始合，晋车骑将军羊祜率师向江陵；诸将咸以抗不宜上〖8〗，抗曰：“江陵城固兵足，无所忧患。假令敌没江陵，必不能守，所损者小。如使西陵盘结〖9〗，则南山群夷皆当扰动；则所忧虑，难可竟言也！吾宁弃江陵而赴西陵，况江陵牢固乎？”","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":348,"anchor":null},"note_id":null,"start":0,"end":112},{"id":"luxun-e-o072b-q","section":"chapter-058","block":"b-1d3568cbbcce75558f17","layer":"original","quote":"祜欲因所遏水，浮船运粮，扬声将破堰以通步军。抗闻，使咸亟破之。诸将皆惑，屡谏；不听。祜至当阳，闻堰败，乃改船以车运，大费损功力。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":349,"anchor":null},"note_id":null,"start":44,"end":108},{"id":"luxun-e-o074b-q","section":"chapter-058","block":"b-076b63a347bfe52cc440","layer":"original","quote":"肇至经月，计屈夜遁。抗欲追之，而虑阐蓄力项领〖16〗，伺视间隙，兵不足分；于是但鸣鼓戒众〖17〗，若将追者。肇众汹惧〖18〗，悉解甲挺走〖19〗。抗使轻兵蹑之〖20〗，肇大破败。祜等皆引军还。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":351,"anchor":null},"note_id":null,"start":31,"end":127},{"id":"luxun-e-o075a-q","section":"chapter-058","block":"b-4a26ea8a0f80eb1773d2","layer":"original","quote":"抗遂陷西陵城；诛夷阐族及其大将吏，自此以下，所请赦者数万口。修治城围，东还乐乡；貌无矜色，谦冲如常，故得将士欢心。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":352,"anchor":null},"note_id":null,"start":0,"end":57},{"id":"luxun-e-p014a-q","section":"chapter-058","block":"b-9537d945914385ce2ed4","layer":"pei","quote":"﹝一﹞《晋阳秋》曰：“抗与羊祜，推侨、札之好。抗尝遗祜酒，祜饮之不疑。抗有疾，祜馈之药，抗亦推心服之。于时以为华元、子反，复现于今。”","attribution":"《晋阳秋》","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":375,"anchor":null},"note_id":"n-5019fc846dfb3be1a549","start":0,"end":67},{"id":"luxun-e-p015a-q","section":"chapter-058","block":"b-5952071f67f973afbfc5","layer":"pei","quote":"羊祜既归，增修德信，以怀吴人。陆抗每告其边戍曰：‘彼专为德，我专为暴：是不战而自服也。各保分界，无求细益而已。’于是吴、晋之间，余粮栖亩而不犯；牛马逸而入境，可宣告而取也。沔上猎，吴获晋人先伤者，皆送而相还。","attribution":"《汉晋春秋》","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":376,"anchor":null},"note_id":"n-5019fc846dfb3be1a549","start":9,"end":113},{"id":"luxun-e-p015b-q","section":"chapter-058","block":"b-5952071f67f973afbfc5","layer":"pei","quote":"抗尝疾，求药于祜；祜以成合与之，曰：‘此上药也，近始自作。未及服，以君疾急，故相致。’抗得而服之，诸将或谏，抗不答。","attribution":"《汉晋春秋》","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":376,"anchor":null},"note_id":"n-5019fc846dfb3be1a549","start":113,"end":171},{"id":"luxun-q-o071","section":"chapter-058","block":"b-94f14aac77ba81b02a56","layer":"original","quote":"围备始合，晋车骑将军羊祜率师向江陵；诸将咸以抗不宜上〖8〗，抗曰：“江陵城固兵足，无所忧患。假令敌没江陵，必不能守，所损者小。如使西陵盘结〖9〗，则南山群夷皆当扰动；则所忧虑，难可竟言也！吾宁弃江陵而赴西陵，况江陵牢固乎？”","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":348,"anchor":null},"note_id":null,"start":0,"end":112},{"id":"luxun-q-o072","section":"chapter-058","block":"b-1d3568cbbcce75558f17","layer":"original","quote":"初，江陵平衍，道路通利；抗敕江陵督张咸：作大堰遏水〖10〗，渐渍平中〖11〗，以绝寇叛。祜欲因所遏水，浮船运粮，扬声将破堰以通步军。抗闻，使咸亟破之。诸将皆惑，屡谏；不听。祜至当阳，闻堰败，乃改船以车运，大费损功力。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":349,"anchor":null},"note_id":null,"start":0,"end":108},{"id":"luxun-q-o073","section":"chapter-058","block":"b-00c7d3403d867b106f10","layer":"original","quote":"晋巴东监军徐胤率水军诣建平〖12〗，荆州刺史杨肇至西陵。抗令张咸固守其城；公安督孙遵巡南岸御祜〖13〗；水军督留虑、镇西将军朱琬拒胤；身率三军，凭围对肇。将军朱乔、营都督俞赞，亡诣肇〖14〗。抗曰：“赞军中旧吏，知吾虚实者。吾常虑夷兵素不简练〖15〗，若敌攻围，必先此处！”即夜易夷（民）〔兵〕，皆以旧将充之。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":350,"anchor":null},"note_id":null,"start":0,"end":155},{"id":"luxun-q-o074","section":"chapter-058","block":"b-076b63a347bfe52cc440","layer":"original","quote":"明日，肇果攻故夷兵处，抗命旋军击之；矢石雨下，肇众伤死者相属。肇至经月，计屈夜遁。抗欲追之，而虑阐蓄力项领〖16〗，伺视间隙，兵不足分；于是但鸣鼓戒众〖17〗，若将追者。肇众汹惧〖18〗，悉解甲挺走〖19〗。抗使轻兵蹑之〖20〗，肇大破败。祜等皆引军还。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":351,"anchor":null},"note_id":null,"start":0,"end":127},{"id":"luxun-q-p014","section":"chapter-058","block":"b-9537d945914385ce2ed4","layer":"pei","quote":"﹝一﹞《晋阳秋》曰：“抗与羊祜，推侨、札之好。抗尝遗祜酒，祜饮之不疑。抗有疾，祜馈之药，抗亦推心服之。于时以为华元、子反，复现于今。”","attribution":"《晋阳秋》","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":375,"anchor":null},"note_id":"n-5019fc846dfb3be1a549","start":0,"end":67},{"id":"luxun-q-p015","section":"chapter-058","block":"b-5952071f67f973afbfc5","layer":"pei","quote":"《汉晋春秋》曰：“羊祜既归，增修德信，以怀吴人。陆抗每告其边戍曰：‘彼专为德，我专为暴：是不战而自服也。各保分界，无求细益而已。’于是吴、晋之间，余粮栖亩而不犯；牛马逸而入境，可宣告而取也。沔上猎，吴获晋人先伤者，皆送而相还。抗尝疾，求药于祜；祜以成合与之，曰：‘此上药也，近始自作。未及服，以君疾急，故相致。’抗得而服之，诸将或谏，抗不答。孙皓闻二境交和，以诘于抗。抗曰：‘夫一邑一乡，不可以无信义之人，而况大国乎？臣不如是，正足以彰其德耳，于祜无伤也。’或以祜、抗为失臣节，两讥之。”","attribution":"《汉晋春秋》","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":376,"anchor":null},"note_id":"n-5019fc846dfb3be1a549","start":0,"end":244},{"id":"luxun-q-p016","section":"chapter-058","block":"b-b9434de062c5f8a4ac06","layer":"pei","quote":"习凿齿曰：“夫理胜者，天下之所保；信顺者，万人之所宗。虽大猷既丧，义声久沦；狙诈驰于当途，权略周乎急务。负力纵横之人，臧获牧竖之智；未有不凭此以创功，舍兹而独立者也。是故晋文退舍，而原城请命；穆子围鼓，训之以力；冶夫献策，而费人斯归；乐毅缓攻，而风烈长流。观其所以服物制胜者，岂徒威力相诈而已哉！自今三家鼎足，四十有余年矣！吴人不能越淮、沔而进取中国，中国不能陵长江以争利者；力均而智侔，道不足以相倾也。夫残彼而利我，未若利我而无残；振武以惧物，未若德广而民怀。匹夫犹不可以力服，而况一国乎？力服犹不如以德来，而况不制乎？是以羊祜恢大同之略，思五兵之则；齐其民人，均其施泽；振义网以罗强吴，明兼爱以革暴俗；易生民之视听，驰不战乎江表。故能德音悦畅，而襁负云集；殊邻异域，义让交弘：自吴之遇敌，未有若此者也。抗见国小主暴，而晋德弥昌；人积兼己之善，而己无固本之规；百姓怀严敌之德，阖境有弃主之虑。思所以镇定民心，缉宁外内，奋其危弱，抗权上国者，莫若亲行斯道，以侔其胜。使彼德靡加吾，而此善流闻；归重邦国，弘明远风；折冲于枕席之上，校胜于帷幄之内；倾敌而不以甲兵之力，保国而不浚沟池之固；信义感于寇仇，丹怀体于先日。岂设狙诈以危贤，徇己身之私名；贪外物之重我，暗服之而不备者哉！由是论之，苟守局而保疆，一卒之所能；协数以相危，小人之近事；积诈以防物，臧获之余虑；威胜以求安，明哲之所贱。贤人君子所以拯世垂范，舍此而取彼者，其道良弘故也！”","attribution":"习凿齿论","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":377,"anchor":null},"note_id":"n-5019fc846dfb3be1a549","start":0,"end":617},{"id":"santizhu-q-72dd776e7f89a6336198","section":"chapter-048","block":"b-fa0fe4a3ed8ad4520955","layer":"original","quote":"阐不应，据城降晋","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":425,"anchor":null},"note_id":null,"start":18,"end":26},{"id":"santizhu-q-8c8f8db2723f7d72ccdc","section":"chapter-048","block":"b-e476f067c552bc43ab1d","layer":"pei","quote":"尚书仆射羊祜、尚书何桢，并结缟带之好。","attribution":"裴注·吴录","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":371,"anchor":null},"note_id":"n-6b2af9c2569d5d36f768","start":146,"end":165},{"id":"xinyang-q-bbec4cb3478035ff81ad","section":"chapter-025","block":"b-b0b2610dbf6aae49b0db","layer":"pei","quote":"逮钟会为镇西将军，宪英谓从子羊祜曰：“钟士季何故西出？”祜曰：“将为灭蜀也。”宪英曰：“会，在事纵恣，非持久处下之道；吾畏其有他志也。”祜曰：“季母勿多言。","attribution":"裴注·世语引夏侯湛辛宪英传","section_title":"辛毗杨阜高堂隆传第二十五","source":{"file":"OEBPS/Text/titlepage_0056.xhtml","index":120,"anchor":null},"note_id":"n-5ca035192d84ad8d726a","start":485,"end":563},{"id":"zhanggu-q-12a904f491b9d053a45f","section":"chapter-052","block":"b-abb819d300d36cb02c9f","layer":"original","quote":"孙皓使陆抗西行，祜等遁退。抗陷城，斩阐等。步氏泯灭，惟璿绍祀","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":456,"anchor":null},"note_id":null,"start":0,"end":30},{"id":"zhanggu-q-4e6bf5ff89170aad6e55","section":"chapter-052","block":"b-924121af7bdd349c256c","layer":"original","quote":"凤凰元年，召为绕帐督。阐累世在西陵，猝被征命，自以失职，又惧有谗祸；于是据城降晋，遣玑弟璿诣洛阳为任〖5〗。晋以阐为都督西陵诸军事，卫将军，仪同三司，加侍中，假节，领交州牧，封宜都公〖6〗；玑监江陵诸军事，左将军，加散骑常侍，领（庐陵）〔庐江〕太守，改封江陵侯；璿给事中，宣威将军〖7〗，封都乡侯。命车骑将军羊祜、荆州刺史杨肇，往赴救阐","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":455,"anchor":null},"note_id":null,"start":0,"end":168}],"profiles":{},"directory_counts":{}}
