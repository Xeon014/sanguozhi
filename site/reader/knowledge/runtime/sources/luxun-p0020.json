{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-o069b","title":"陆议猇亭破刘备冯习张南战死","accounts":[{"id":"xianzhu-e-o069b-account","label":"《先主传》正文","text":"黄气记载后十余日，陆议大破刘备军，冯习、张南等战死。","evidence":["xianzhu-e-o069b-q"]},{"id":"wendi-e-o032a-account","label":"《文帝纪》正文","text":"黄初三年闰月，孙权于夷陵破刘备。","evidence":["wendi-e-o032a-q"]},{"id":"wuzhu-e-o055a-account","label":"《吴主传第二》正文","text":"陆逊破蜀诸营刘备败走","evidence":["wuzhu-e-o055a-q"]},{"id":"luxun-e-o021b-account","label":"《陆逊传第十三》正文","text":"陆议命持茅火攻诸军破营斩将受降","evidence":["luxun-e-o021b-q"]},{"id":"chenghuang-a-3031b7ed32ab7604e611","label":"正文","text":"夷陵璋与陆逊拒备部下斩冯习","evidence":["chenghuang-q-b5bf74db1c826dfa961a"]},{"id":"dongliu-a-c7afeeb23b4de680799c","label":"正文","text":"刘备败绩于夷陵","evidence":["dongliu-q-c0644cd45cb4f702516d"]},{"id":"dongliu-a-5e4b1a516e24db16a68e","label":"正文","text":"马良遇害","evidence":["dongliu-q-25211585ffcc2365b464"]},{"id":"huangli-a-bb675fc02dbdab33c5e7","label":"正文","text":"陆逊乘流断围，刘备败退","evidence":["huangli-q-f120862d5699e9b578c9"]},{"id":"huangli-a-274eedfab07c354b719a","label":"正文","text":"刘备东征败于猇亭","evidence":["huangli-q-1cb5e0273ed0af39abc6"]},{"id":"huowang-a-7b5a3f002fd86423db09","label":"正文","text":"秭归之败向宠营完","evidence":["huowang-q-7c6eeec51538912b9b6d"]},{"id":"dengzhang-a-49e31ae28921909ce18a","label":"正文","text":"王甫遇害于秭归","evidence":["dengzhang-q-ef6e93679179b6c18260"]},{"id":"dengzhang-a-ff96514ff8de3ca340a4","label":"正文","text":"冯习领军败于猇亭","evidence":["dengzhang-q-44dded103d55f29ebfe9"]},{"id":"dengzhang-a-017f531a3d582ce651bd","label":"正文","text":"张南与冯习俱死于吴役","evidence":["dengzhang-q-7b18684e8ffd04292b00"]},{"id":"dengzhang-a-357d786f386b0d8f580d","label":"正文","text":"傅肜断后战死","evidence":["dengzhang-q-412416358d4db55f12ea"]},{"id":"dengzhang-a-a54b080ee54598e42846","label":"正文","text":"程畿执戟战死","evidence":["dengzhang-q-67e4f9b2b1bed056a47b"]},{"id":"zongshi-a-666bb9805219e2b2d9cb","label":"正文","text":"桓与陆逊共拒刘备，备军众甚盛，弥山盈谷；桓投刀奋命，与逊戮力，备遂败走","evidence":["zongshi-q-9d9cb181df7b17ae9deb"]},{"id":"zongshi-a-088c90499934bf7962b3","label":"正文","text":"桓斩上（兜）〔夔〕道，截其径要","evidence":["zongshi-q-fd7d20b4b4223a4457f7"]},{"id":"zongshi-a-b0aad961acd2d86ec13c","label":"正文","text":"备逾山越险，仅乃得免，忿恚叹曰：吾昔初至京城，桓尚小儿，而今迫孤，乃至此也","evidence":["zongshi-q-a9b2efcfa5afd7f77f4c"]},{"id":"zhulv-a-ebb9f68c4650560ea6e3","label":"正文","text":"黄武元年，刘备举兵攻宜都；然督五千人，与陆逊并力拒备","evidence":["zhulv-q-0f64e349b7617004ae8b"]},{"id":"zhulv-a-c2041007383fddf1326a","label":"正文","text":"然别攻破备前锋，断其后道，备遂破走","evidence":["zhulv-q-91f98b8cef7e20d317da"]}],"participants":[{"person":"xianzhu-p0115","role":"破军","evidence":["xianzhu-e-o069b-q"]},{"person":"liu-bei","role":"败军","evidence":["xianzhu-e-o069b-q"]},{"person":"xianzhu-p0119","role":"战死","evidence":["xianzhu-e-o069b-q"]},{"person":"xianzhu-p0122","role":"战死","evidence":["xianzhu-e-o069b-q"]},{"person":"sun-quan","role":"破敌","evidence":["wendi-e-o032a-q"]},{"person":"luxun-p0021","role":"战死","evidence":["luxun-e-o021b-q"]},{"person":"luxun-p0022","role":"投降","evidence":["luxun-e-o021b-q"]},{"person":"luxun-p0023","role":"投降","evidence":["luxun-e-o021b-q"]},{"person":"zhouyu-p0055","role":"与陆逊并力拒刘备，部下斩冯习等","evidence":["chenghuang-q-b5bf74db1c826dfa961a"]},{"person":"xianzhu-p0121","role":"夷陵之败中遇害","evidence":["dongliu-q-25211585ffcc2365b464"]},{"person":"zhuge-p0029","role":"秭归之败中其营垒独完好","evidence":["huowang-q-7c6eeec51538912b9b6d"]},{"person":"dengzhang-p0044","role":"随先主征吴，军败于秭归，遇害","evidence":["dengzhang-q-ef6e93679179b6c18260"]},{"person":"luxun-p0020","role":"先主退军时断后拒战，兵人死尽，骂吴将曰吴狗何有汉将军降者，遂战死","evidence":["dengzhang-q-412416358d4db55f12ea"]},{"person":"dengzhang-p0047","role":"拒解船轻去之劝，称未曾为敌走况从天子而见危，身执戟战，敌船有覆者，众大至共击之，乃死","evidence":["dengzhang-q-67e4f9b2b1bed056a47b"]},{"person":"luxun-p0016","role":"投刀奋命者；截道者；迫备者（背景）","evidence":["zongshi-q-9d9cb181df7b17ae9deb","zongshi-q-fd7d20b4b4223a4457f7","zongshi-q-a9b2efcfa5afd7f77f4c"]},{"person":"mingdi-p0046","role":"督众拒备者；破前锋断道者","evidence":["zhulv-q-0f64e349b7617004ae8b","zhulv-q-91f98b8cef7e20d317da"]}],"place":{"text":"猇亭","evidence":["xianzhu-e-o069b-q"]},"time":{"year":222,"label":"章武二年夏六月、黄气现后十余日","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xianzhu-y222","dating_review":{"reviewed":true,"anchor":"xianzhu-q-o068","basis":"章武二年夏六月、黄气现后十余日"},"evidence":["xianzhu-e-o069b-q","xianzhu-q-o068","xianzhu-q-b-e2b85eacbc16310809ee"]},"source_order":[32,403,"O069b"],"related_events":[{"event":"wendi-e-o033b","type":"related","evidence":["wendi-e-o033b-q","xianzhu-e-o069b-q"]}],"order":607},{"id":"luxun-e-o017a","title":"刘备立数十屯诱夷任冯习张南等分督","accounts":[{"id":"luxun-e-o017a-account","label":"《陆逊传第十三》正文","text":"刘备立数十屯诱夷任冯习张南等分督","evidence":["luxun-e-o017a-q"]}],"participants":[{"person":"liu-bei","role":"结营部署","evidence":["luxun-e-o017a-q"]},{"person":"xianzhu-p0119","role":"大督","evidence":["luxun-e-o017a-q"]},{"person":"xianzhu-p0122","role":"前部","evidence":["luxun-e-o017a-q"]},{"person":"luxun-p0017","role":"别督","evidence":["luxun-e-o017a-q"]},{"person":"luxun-p0018","role":"别督","evidence":["luxun-e-o017a-q"]},{"person":"luxun-p0019","role":"别督","evidence":["luxun-e-o017a-q"]},{"person":"luxun-p0020","role":"别督","evidence":["luxun-e-o017a-q"]}],"place":null,"time":{"label":"刘备东征时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["luxun-e-o017a-q"]},"ordering_evidence":"luxun-e-o017a-q","source_order":[58,87,"O017a"],"order":10312}],"persons":[{"id":"luxun-p0020","name":"傅肜","evidence":["luxun-q-o017","dengzhang-q-412416358d4db55f12ea","dengzhang-q-62e9da9582533b19ce51","dengzhang-q2-800d86a330c8ae293ffe"],"facts":[],"aliases":[],"mentions":[{"id":"luxun-m-o017-luxun-p0020","kind":"mention","text":"文中提及","evidence":["luxun-q-o017"]},{"id":"dengzhang-m2-role-559d7b8a33ebaa678e1c","kind":"mention","text":"文中提及","evidence":["dengzhang-q-62e9da9582533b19ce51","dengzhang-q2-800d86a330c8ae293ffe"]}]}],"evidence":[{"id":"chenghuang-q-b5bf74db1c826dfa961a","section":"chapter-055","block":"b-708161e3f591bac9e404","layer":"original","quote":"甘宁卒，又并其军。刘备出夷陵，璋与陆逊并力拒之。璋部下斩备护军冯习等〖11〗，所杀伤甚众。拜平北将军，襄阳太守","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":332,"anchor":null},"note_id":null,"start":0,"end":55},{"id":"dengzhang-q-412416358d4db55f12ea","section":"chapter-045","block":"b-4445e3e3e8a98a07754c","layer":"original","quote":"时又有义阳傅肜，先主退军，断后拒战。兵人死尽，吴将语肜令降。肜骂曰：“吴狗！何有汉将军降者！”遂战死","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":348,"anchor":null},"note_id":null,"start":28,"end":78},{"id":"dengzhang-q-44dded103d55f29ebfe9","section":"chapter-045","block":"b-b1ca2b95c1a4aed6d951","layer":"original","quote":"先主东征吴，习为领军，统诸军；大败于猇亭","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":347,"anchor":null},"note_id":null,"start":15,"end":35},{"id":"dengzhang-q-62e9da9582533b19ce51","section":"chapter-045","block":"b-e7333fcabcbf1943b561","layer":"pei","quote":"蜀将军傅佥：前在关城，身拒官军，致死不顾；佥父肜，复为刘备战亡。天下之善一也，岂由彼此以为异！佥息著、募，后没入奚官，免为庶人","attribution":"裴注·蜀记","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":354,"anchor":null},"note_id":"n-549087e33d923b217398","start":15,"end":78},{"id":"dengzhang-q-67e4f9b2b1bed056a47b","section":"chapter-045","block":"b-ae37311a660d50a1ec42","layer":"original","quote":"或告之曰：“后追已至！解船轻去，乃可以免。”畿曰：“吾在军，未曾为敌走〖10〗；况从天子而见危哉！”追人遂及畿船，畿身执戟战，敌船有覆者。众大至，共击之，乃死","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":356,"anchor":null},"note_id":null,"start":331,"end":410},{"id":"dengzhang-q-7b18684e8ffd04292b00","section":"chapter-045","block":"b-4445e3e3e8a98a07754c","layer":"original","quote":"领兵从先主征吴，与习俱死","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":348,"anchor":null},"note_id":null,"start":15,"end":27},{"id":"dengzhang-q-ef6e93679179b6c18260","section":"chapter-045","block":"b-48db56fffb91683be546","layer":"original","quote":"随先主征吴，军败于秭归，遇害","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":320,"anchor":null},"note_id":null,"start":49,"end":63},{"id":"dengzhang-q2-800d86a330c8ae293ffe","section":"chapter-045","block":"b-e7333fcabcbf1943b561","layer":"pei","quote":"﹝一﹞《蜀记》载晋武帝诏曰：“蜀将军傅佥：前在关城，身拒官军，致死不顾；佥父肜，复为刘备战亡。天下之善一也，岂由彼此以为异！佥息著、募，后没入奚官，免为庶人。”","attribution":"裴注（引书见原文）","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":354,"anchor":null},"note_id":"n-549087e33d923b217398","start":0,"end":80},{"id":"dongliu-q-25211585ffcc2365b464","section":"chapter-039","block":"b-7239366a53921085f610","layer":"original","quote":"良亦遇害","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":67,"anchor":null},"note_id":null,"start":61,"end":65},{"id":"dongliu-q-c0644cd45cb4f702516d","section":"chapter-039","block":"b-7239366a53921085f610","layer":"original","quote":"会先主败绩于夷陵","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":67,"anchor":null},"note_id":null,"start":52,"end":60},{"id":"huangli-q-1cb5e0273ed0af39abc6","section":"chapter-043","block":"b-6f5d0f2c904adccd1410","layer":"original","quote":"先主东征，败绩猇亭","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":126,"anchor":null},"note_id":null,"start":0,"end":9},{"id":"huangli-q-f120862d5699e9b578c9","section":"chapter-043","block":"b-0996c97d882e13e06732","layer":"original","quote":"及吴将军陆议乘流断围〖5〗，南军败绩，先主引退","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":13,"anchor":null},"note_id":null,"start":0,"end":23},{"id":"huowang-q-7c6eeec51538912b9b6d","section":"chapter-041","block":"b-e690691aa6a425fbd55b","layer":"original","quote":"秭归之败〖11〗，宠营特完","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":42,"anchor":null},"note_id":null,"start":13,"end":26},{"id":"luxun-e-o017a-q","section":"chapter-058","block":"b-ae072ca443ff6153c66c","layer":"original","quote":"备从巫峡、建平，连围至夷陵界〖6〗，立数十屯；以金锦爵赏诱动诸夷。使将军冯习为大督，张南为前部，辅匡、赵融、廖淳、傅肜等各为别督〖7〗；","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":86,"anchor":null},"note_id":null,"start":0,"end":68},{"id":"luxun-e-o021b-q","section":"chapter-058","block":"b-485f5750e7c476ae4cfe","layer":"original","quote":"乃敕各持一把茅，以火攻拔之。一尔势成〖15〗，通率诸军同时俱攻；斩张南、冯习及胡王沙摩柯等首〖16〗，破其四十余营。备将杜路、刘宁等，穷逼请降。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":90,"anchor":null},"note_id":null,"start":34,"end":106},{"id":"luxun-q-o017","section":"chapter-058","block":"b-ae072ca443ff6153c66c","layer":"original","quote":"备从巫峡、建平，连围至夷陵界〖6〗，立数十屯；以金锦爵赏诱动诸夷。使将军冯习为大督，张南为前部，辅匡、赵融、廖淳、傅肜等各为别督〖7〗；先遣吴班将数千人于平地立营，欲以挑战。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":86,"anchor":null},"note_id":null,"start":0,"end":87},{"id":"wendi-e-o032a-q","section":"chapter-002","block":"b-4189701a92b124deb712","layer":"original","quote":"闰月〖26〗，孙权破刘备于夷陵〖27〗。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":285,"anchor":null},"note_id":null,"start":0,"end":20},{"id":"wendi-e-o033b-q","section":"chapter-002","block":"b-a5bf91c6f666aa87700c","layer":"original","quote":"八月，蜀大将黄权率众降〖2〗。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":320,"anchor":null},"note_id":null,"start":29,"end":44},{"id":"wuzhu-e-o055a-q","section":"chapter-047","block":"b-59fa99f2e0e3c37653aa","layer":"original","quote":"蜀军分据险地，前后五十余营；逊随轻重，以兵应拒。自正月至闰月〖4〗，大破之，临阵所斩及投兵降首数万人〖5〗；刘备奔走，仅以身免。﹝一﹞","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":294,"anchor":null},"note_id":null,"start":0,"end":67},{"id":"xianzhu-e-o069b-q","section":"chapter-032","block":"b-5398e8ba8cc35262f80d","layer":"original","quote":"后十余日，陆议大破先主军于犹亭；将军冯习、张南等皆没〖12〗。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":402,"anchor":null},"note_id":null,"start":20,"end":51},{"id":"xianzhu-q-b-e2b85eacbc16310809ee","section":"chapter-032","block":"b-e2b85eacbc16310809ee","layer":"modern","quote":"〖7〗二年：章武二年（公元 222）。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":413,"anchor":null},"note_id":"n-18295fa1c5ff11c612db","start":0,"end":19},{"id":"xianzhu-q-o068","section":"chapter-032","block":"b-8136daaf302c35b9c188","layer":"original","quote":"二年春正月〖7〗，先主军还秭归；将军吴班、陈式水军屯夷陵，夹江东西岸〖8〗。二月，先主自秭归率诸将进军，缘山截岭，于夷道猇亭﹝二﹞驻营〖9〗。自佷山﹝三﹞通武陵〖10〗，遣侍中马良安慰五溪蛮夷〖11〗，咸相率响应。镇北将军黄权督江北诸军，与吴军相拒于夷陵道。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":401,"anchor":null},"note_id":null,"start":0,"end":129},{"id":"zhulv-q-0f64e349b7617004ae8b","section":"chapter-056","block":"b-573074f8b77bb485b3b8","layer":"original","quote":"黄武元年，刘备举兵攻宜都；然督五千人，与陆逊并力拒备","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":57,"anchor":null},"note_id":null,"start":0,"end":26},{"id":"zhulv-q-91f98b8cef7e20d317da","section":"chapter-056","block":"b-573074f8b77bb485b3b8","layer":"original","quote":"然别攻破备前锋，断其后道：备遂破走","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":57,"anchor":null},"note_id":null,"start":27,"end":44},{"id":"zongshi-q-9d9cb181df7b17ae9deb","section":"chapter-051","block":"b-7798609de1816f91666c","layer":"original","quote":"与陆逊共拒刘备，备军众甚盛，弥山盈谷。桓投刀奋命，与逊戮力，备遂败走","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":221,"anchor":null},"note_id":null,"start":29,"end":63},{"id":"zongshi-q-a9b2efcfa5afd7f77f4c","section":"chapter-051","block":"b-b64d8aec66ed57f089fa","layer":"original","quote":"备逾山越险，仅乃得免，忿恚叹曰：“吾昔初至京城，桓尚小儿；而今迫孤，乃至此也","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":222,"anchor":null},"note_id":null,"start":0,"end":38},{"id":"zongshi-q-fd7d20b4b4223a4457f7","section":"chapter-051","block":"b-7798609de1816f91666c","layer":"original","quote":"桓斩上（兜）〔夔〕道〖2〗，截其径要","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":221,"anchor":null},"note_id":null,"start":64,"end":82}],"profiles":{},"directory_counts":{}}
