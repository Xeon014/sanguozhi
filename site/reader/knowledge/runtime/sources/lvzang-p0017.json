ence":["lvzang-q-aa56469105848ae6d443"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["lvzang-q-aa56469105848ae6d443"]},"ordering_evidence":"lvzang-q-aa56469105848ae6d443","source_order":[7,337,197],"order":1904},{"id":"lvzang-e-o076","title":"洪先遣司马二人求救于吕布比还城陷皆赴敌死","accounts":[{"id":"lvzang-a-b88b029e98891791733d","label":"正文","text":"洪先遣司马二人求救于吕布比还城陷皆赴敌死","evidence":["lvzang-q-785bd471badf426b9fe3"]}],"participants":[{"person":"lvzang-p0017","role":"遣司马二人出求救于吕布","evidence":["lvzang-q-785bd471badf426b9fe3"]},{"person":"wudi-p0088","role":"被求救者","evidence":["lvzang-q-785bd471badf426b9fe3"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["lvzang-q-785bd471badf426b9fe3"]},"ordering_evidence":"lvzang-q-785bd471badf426b9fe3","source_order":[7,338,26],"order":1905}],"persons":[{"id":"lvzang-p0017","name":"臧洪","evidence":["lvzang-q-0f025883f3e6494ab446","lvzang-q-9b866eed6e8b5f2560c3","lvzang-q-75262aee20282a5ea06b","lvzang-q-3a5faddd1c7ffd25d148","lvzang-q-95201aaf1eeb8abf31f9","lvzang-q-13735003f5d4790c9d1e","lvzang-q-97153a77f484b72e8a96","lvzang-q-0c0e990ee4b0bea7826f","lvzang-q-38689f8d87ac6db8cb62","lvzang-q-19d7374b7ada9f4d802c","lvzang-q-f645e47ced285340b865","lvzang-q-239e6f207f586a3009fd","lvzang-q-958709ecf08b676ec628","lvzang-q-96e5a50bf0635b1c63b7","lvzang-q-f077d52503dff5b680fb","lvzang-q-30ddecb294b9756de644","lvzang-q-413daf0293d28ebaaad5","lvzang-q-1be2d32e9ccf13542ea1","lvzang-q-c911adff3bb431063311","lvzang-q-fedfb15625c8c5be2e72","lvzang-q-87b414b65cbf5d61a922","lvzang-q-3bb51e2a9e0a90e06e82","lvzang-q-12090314f74678992761","lvzang-q-aa56469105848ae6d443","lvzang-q-785bd471badf426b9fe3","lvzang-q-3d10b611ffc7052ddc5a","lvzang-q-b386fe7c21e9a0b9923f","lvzang-q-78721838795d202f3dfa","lvzang-q-a619df2b2f1d6b8a9540","lvzang-q-a8bc6ac5a2f9466496ad","lvzang-q-759c2bbe6fc353306f47","lvzang-q-c8c69e693d78a25bd288","lvzang-q-0bb7d14f640332a37e8a","lvzang-q-938b2f015837ddb177e4","lvzang-q-5c079b7668e867b12337","lvzang-q-42098eed47f3012e53f9","lvzang-q-db95b2fcdb5f1b61f01a","lvzang-q-cf03bcdae5676b2d9032","lvzang-q-24781acf1c2f1a9a4ca9"],"facts":[{"id":"lvzang-f-review-2c501ebd0b1aedfdd703","text":"字子源，广陵射阳人","evidence":["lvzang-q-a619df2b2f1d6b8a9540"]},{"id":"lvzang-f-review-a2bfda7f4ce85603bcc6","text":"体貌魁梧有异于人；举孝廉为郎","evidence":["lvzang-q-a8bc6ac5a2f9466496ad"]}],"aliases":[],"mentions":[{"id":"lvzang-m-review-8c0be1fe13137f3ebf62","kind":"mention","text":"臧洪见于相关言论或记载。","evidence":["lvzang-q-b386fe7c21e9a0b9923f","lvzang-q-78721838795d202f3dfa","lvzang-q-3d10b611ffc7052ddc5a","lvzang-q-958709ecf08b676ec628"]}]}],"evidence":[{"id":"lvzang-q-0bb7d14f640332a37e8a","section":"chapter-007","block":"b-5b7e6f83e695759ce271","layer":"original","quote":"重获来命〖36〗，援引古今，纷纭六纸〖37〗；虽欲不言，焉得已哉！仆小人也〖38〗，本因行役〖39〗，寇窃大州〖40〗。恩深分厚，宁乐今日自还接刃〖41〗？每登城勒兵，望主人之旗鼓〖42〗，感故友之周旋〖43〗，抚弦搦矢〖44〗，不觉流涕之覆面也！何者？自以辅佐主人，无以为悔〖45〗；主人相接，过绝等伦〖46〗。当受任之初，自谓究竟大事〖47〗，共尊王室。岂悟天子不悦，本州见侵〖48〗；郡将遘牖里之厄〖49〗，陈留克创兵之谋〖50〗。谋计栖迟〖51〗，丧忠孝之名〖52〗；杖策携背〖53〗，亏交友之分。揆此二者〖54〗，与其不得已，丧忠孝之名与亏交友之道，轻重殊途〖55〗，亲疏异画〖56〗，故便收泪告绝。","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":196,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":305,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-0c0e990ee4b0bea7826f","section":"chapter-007","block":"b-e38569d56e09470a97bd","layer":"original","quote":"乃设坛场，方共盟誓；诸州郡更相让，莫敢当〖9〗，咸共推洪。洪乃升坛，操盘歃血而盟曰〖10〗：“汉室不幸，皇纲失统；贼臣董卓乘衅纵害，祸加至尊〖11〗，虐流百姓；大惧沦丧社稷，翦覆四海〖12〗。兖州刺史岱、豫州刺史伷、陈留太守邈、东郡太守瑁、广陵太守超等，纠合义兵，并赴国难。凡我同盟，齐心戮力，以致臣节；殒首丧元〖13〗，必无二志！有渝此盟，俾坠其命〖14〗，无克遗育〖15〗！皇天后土，祖宗明灵：实皆鉴之〖16〗！”洪辞气慷慨，涕泣横下。闻其言者，虽卒伍厮养〖17〗，莫不激扬，人思致节","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":166,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":244,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-0f025883f3e6494ab446","section":"chapter-007","block":"b-718ad3d8e8b38caf44f8","layer":"original","quote":"时选三署郎，以补县长〖3〗：琅邪赵昱为莒长〖4〗，东莱刘繇下邑长〖5〗，东海王朗菑丘长〖6〗，洪即丘长","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":152,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":18,"end":69,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-12090314f74678992761","section":"chapter-007","block":"b-afee1171f0be37dc4055","layer":"original","quote":"绍本爱洪，意欲令屈服，原之；见洪辞切，知终不为己用，乃杀之","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":336,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":164,"end":193,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-13735003f5d4790c9d1e","section":"chapter-007","block":"b-870f11ca48ec6ada82bc","layer":"original","quote":"邈谓超曰：“闻弟为郡守，政教威恩〖5〗，不由己出，动任臧洪〖6〗。洪者何人？”超曰：“洪才略智数优超〖7〗，超甚爱之，海内奇士也！”邈即引见洪，与语，大异之","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":165,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":78,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-19d7374b7ada9f4d802c","section":"chapter-007","block":"b-085ac22828a40a0f8c6e","layer":"original","quote":"袁绍见洪，又奇重之，与结分合好","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":168,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":1,"end":16,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-1be2d32e9ccf13542ea1","section":"chapter-007","block":"b-0fc04adc514f754579ad","layer":"original","quote":"城中粮谷已尽，外无强救；洪自度必不免，呼吏士谓曰：“袁氏无道，所图不轨，且不救洪郡将。洪于大义，不得不死；念诸君无事空与此祸〖1〗，可先城未败，将妻子出！”将吏士民皆垂泣曰：“明府与袁氏，本无怨隙。今为本朝郡将之故，自致残困；吏民何忍当舍明府去也","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":334,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":15,"end":138,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-239e6f207f586a3009fd","section":"chapter-007","block":"b-085ac22828a40a0f8c6e","layer":"original","quote":"洪在州二年，群盗奔走。绍叹其能，徙为东郡太守，治东武阳","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":168,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":45,"end":72,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-24781acf1c2f1a9a4ca9","section":"chapter-007","block":"b-150fab3e22009685681e","layer":"original","quote":"悲哉！本同而末离。努力努力！夫复何言〖127〗！","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":202,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":24,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-30ddecb294b9756de644","section":"chapter-007","block":"b-f7bc578c9c6099d10d7d","layer":"original","quote":"绍令洪邑人陈琳书与洪〖6〗，喻以祸福，责以恩义〖7〗。洪答曰","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":194,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":25,"end":55,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-38689f8d87ac6db8cb62","section":"chapter-007","block":"b-dca2dfed5977f0cec5d2","layer":"original","quote":"超遣洪诣大司马刘虞谋。值公孙瓒之难，至河间，遇幽、冀二州交兵，使命不达","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":167,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":20,"end":55,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-3a5faddd1c7ffd25d148","section":"chapter-007","block":"b-66fc926cc2e5c044d3d7","layer":"original","quote":"董卓杀帝，图危社稷。洪说超曰：“明府历世受恩〖1〗，兄弟并据大郡〖2〗。今王室将危，贼臣未枭，此诚天下义烈报恩效命之秋也〖3〗。今郡境尚全，吏民殷富；若动桴鼓〖4〗，可得二万人：以此诛除国贼，为天下倡先，义之大者也","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":163,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":19,"end":126,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-3bb51e2a9e0a90e06e82","section":"chapter-007","block":"b-afee1171f0be37dc4055","layer":"original","quote":"洪据地嗔目曰：“诸袁事汉，四世五公，可谓受恩。今王室衰弱，无扶翼之意；欲因际会，希冀非望〖4〗；多杀忠良，以立奸威。洪亲见呼张陈留为‘兄’〖5〗，则洪府君亦宜为‘弟’〖6〗；同共戮力，为国除害：何为拥众观人屠灭？惜洪力劣，不能推刃为天下报仇，何谓服乎","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":336,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":37,"end":162,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-3d10b611ffc7052ddc5a","section":"chapter-007","block":"b-6b753cdef1b6356c5658","layer":"original","quote":"评曰：吕布有虓虎之勇〖1〗，而无英奇之略；轻狡反覆，唯利是视〖2〗：自古及今，未有若此不夷灭也。昔汉光武谬于庞萌〖3〗，近魏太祖亦蔽于张邈〖4〗。“知人则哲”，“唯帝难之”，信矣！陈登、臧洪，并有雄气壮节：登降年夙陨〖5〗，功业未遂；洪以兵弱敌强，烈志不立。惜哉","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":351,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":131,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-413daf0293d28ebaaad5","section":"chapter-007","block":"b-0fc04adc514f754579ad","layer":"original","quote":"绍见洪书，知无降意，增兵急攻","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":334,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":14,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-42098eed47f3012e53f9","section":"chapter-007","block":"b-d286a8fd1823b92f9c0c","layer":"original","quote":"吾闻之也：义不背亲，忠不违君；故东宗本州以为亲援，中扶郡将以安社稷。一举二得，以徼忠孝，何以为非？而足下欲使吾轻本破家〖93〗，均君主人〖94〗。主人之于我也，年为吾兄，分为笃友；道乖告去〖95〗，以安君亲，可谓顺矣。若子之言，则包胥宜致命于伍员〖96〗，不当号哭于秦庭矣。苟区区于攘患〖97〗，不知言乖乎道理矣。足下或者见城围不解，救兵未至，感婚姻之义〖98〗，惟平生之好，以屈节而苟生，胜守义而倾覆也〖99〗。","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":199,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":207,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-5c079b7668e867b12337","section":"chapter-007","block":"b-1de2ec4217366daf61be","layer":"original","quote":"何以效之〖62〗？昔张景明亲登坛歃血〖63〗，奉辞奔走〖64〗；卒使韩牧让印〖65〗，主人得地〖66〗。然后但以拜章朝主赐爵获传之故〖67〗，旋时之间，不蒙观过之贷〖68〗，而受夷灭之祸。﹝一﹞吕奉先讨卓来奔〖69〗，请兵不获〖70〗，告去何罪？复见斫刺，滨于死亡〖71〗。刘子璜奉使逾时〖72〗，辞不获命〖73〗，畏（威）〔君〕怀亲，以诈求归〖74〗；可谓有志忠孝，无损霸道者也〖75〗。然辄僵毙麾下〖76〗，不蒙亏除〖77〗。﹝二﹞仆虽不敏〖78〗，又素不能原始见终〖79〗，睹微知著〖80〗；窃度主人之心，岂谓三子宜死〖81〗，罚当刑中哉〖82〗！实且欲一统山东，增兵讨仇；惧战士狐疑，无以沮劝〖83〗；故抑废王命以崇承制〖84〗，慕义者蒙荣〖85〗，待放者被戮〖86〗：此乃主人之利，非游士之愿也〖87〗。故仆鉴戒前人，困穷死战；仆虽下愚，亦尝闻君子之言矣。此实非吾心也，乃主人招焉。凡吾所以背弃国民，用命此城者〖88〗，正以君子之违不适敌国故也〖89〗。是以获罪主人，见攻逾时；而足下更引此义以为吾规〖90〗，无乃辞同趋异〖91〗，非君子所为休戚者哉〖92〗！","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":198,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":485,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-75262aee20282a5ea06b","section":"chapter-007","block":"b-66fc926cc2e5c044d3d7","layer":"original","quote":"太守张超请洪为功曹","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":163,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":9,"end":18,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-759c2bbe6fc353306f47","section":"chapter-007","block":"b-718ad3d8e8b38caf44f8","layer":"original","quote":"举孝廉，为郎","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":152,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":11,"end":17,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-785bd471badf426b9fe3","section":"chapter-007","block":"b-a30e3312aeeb19301e33","layer":"original","quote":"先是，洪遣司马二人出，求救于吕布；比还，城已陷，皆赴敌死","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":337,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":26,"end":54,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-78721838795d202f3dfa","section":"chapter-007","block":"b-a65cc4a19089e8c41bed","layer":"pei","quote":"洪，敦天下名义，救旧君之危；其恩足以感人情，义足以励薄俗。然袁亦知己亲友，致位州郡；虽非君臣，且实盟主；既受其命，义不应贰。袁、曹方睦，夹辅王室；吕布反覆无义，志在逆乱；而邈、超擅立布为州牧：其于王法，乃一罪人也。曹公讨之，袁氏弗救，未为非理也。洪本不当就袁请兵，又不当还为怨仇。为洪计者，苟力所不足，可奔他国以求赴救；若谋力未展以待事机，则宜徐更观衅，效死于超。何必誓守穷城而无变通？身死殄民，功名不立：良可哀也","attribution":"裴注·三国评（徐众）","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":350,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5920242ecba5fe334310","start":13,"end":220,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-87b414b65cbf5d61a922","section":"chapter-007","block":"b-afee1171f0be37dc4055","layer":"original","quote":"绍素亲洪，盛施帏幔，大会诸将，见洪。谓曰：“臧洪，何相负若此！今日服未","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":336,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":35,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-938b2f015837ddb177e4","section":"chapter-007","block":"b-4afe973cb6a14c324053","layer":"original","quote":"若使主人少垂故人〖57〗，住者侧席〖58〗，去者克己〖59〗，不汲汲于离友，信刑戮以自辅〖60〗；则仆抗季札之志〖61〗，不为今日之战矣。","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":197,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":69,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-95201aaf1eeb8abf31f9","section":"chapter-007","block":"b-3cd68107c2514e6c5a1a","layer":"original","quote":"超然其言，与洪西至陈留，见兄邈计事。邈亦素有心，会于酸枣","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":164,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":28,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-958709ecf08b676ec628","section":"chapter-007","block":"b-fd5412255d7bf648300b","layer":"original","quote":"太祖围张超于雍丘。超言：“唯恃臧洪，当来救吾。”众人以为袁、曹方睦；而洪为绍所表用，必不败好招祸，远来赴此。超曰：“子源，天下义士，终不背本者；但恐见禁制〖1〗，不相及逮耳","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":192,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":86,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-96e5a50bf0635b1c63b7","section":"chapter-007","block":"b-a32db29158afdd48ebac","layer":"original","quote":"洪闻之，果徒跣号泣〖3〗，并勒所领兵〖4〗；又从绍请兵马，求欲救超。而绍终不听许，超遂族灭","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":193,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":45,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-97153a77f484b72e8a96","section":"chapter-007","block":"b-870f11ca48ec6ada82bc","layer":"original","quote":"致之于刘兖州公山、孔豫州公绪〖8〗，皆与洪亲善","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":165,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":79,"end":102,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-9b866eed6e8b5f2560c3","section":"chapter-007","block":"b-66fc926cc2e5c044d3d7","layer":"original","quote":"灵帝末，弃官还家","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":163,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":8,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-a619df2b2f1d6b8a9540","section":"chapter-007","block":"b-d5bef40364f70827ec99","layer":"original","quote":"臧洪字子源，广陵射阳人也","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":151,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":12,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-a8bc6ac5a2f9466496ad","section":"chapter-007","block":"b-718ad3d8e8b38caf44f8","layer":"original","quote":"洪体貌魁梧，有异于人。举孝廉，为郎","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":152,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":17,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-aa56469105848ae6d443","section":"chapter-007","block":"b-afee1171f0be37dc4055","layer":"original","quote":"洪邑人陈容，少为书生，亲慕洪，随洪为东郡丞〖7〗。城未败，洪遣出。绍令在坐，见洪当死，起谓绍曰：“将军举大事，欲为天下除暴；而专先诛忠义，岂合天意！臧洪发举为郡将〖8〗，奈何杀之？”绍惭，左右使人牵出，谓曰：“汝非臧洪俦〖9〗，空复尔为〖10〗？”容顾曰：“夫仁义岂有常！蹈之则君子，背之则小人。今日宁与臧洪同日而死，不与将军同日而生！”复见杀","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":336,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":197,"end":369,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-b386fe7c21e9a0b9923f","section":"chapter-007","block":"b-6013aea2bfb778ef1605","layer":"pei","quote":"臣松之按：于时此盟，止有刘岱等五人而已。《魏氏春秋》横纳刘表等数人，皆非事实：表保据江、汉，身未尝出境，何由得与洪同坛而盟乎","attribution":"裴注·注家按语","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":190,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-3d746fae7bef8e44e705","start":3,"end":65,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-c8c69e693d78a25bd288","section":"chapter-007","block":"b-373b48d8a3c0a48ce966","layer":"original","quote":"隔阔相思〖8〗，发于寤寐〖9〗，幸相去步武之间耳〖10〗。而以趋舍异规〖11〗，不得相见，其为怆悢〖12〗，可为心哉〖13〗！前日不遗〖14〗，比辱雅贶〖15〗；述叙祸福，公私切至〖16〗。所以不即奉答者，既学薄才钝，不足塞诘〖17〗；亦以吾子携负侧室〖18〗，息肩主人〖19〗，家在东州〖20〗，仆为仇敌〖21〗，以是事人〖22〗，虽披中情〖23〗，堕肝胆〖24〗，犹身疏有罪〖25〗，言甘见怪〖26〗，方首尾不救〖27〗，何能恤人〖28〗？且以子之才，穷该典籍；岂将暗于大道，不达余趣哉〖29〗？然犹复云云者〖30〗，仆以是知足下之言，信不由衷，将以救祸也〖31〗。必欲算计长短，辩咨是非；是非之论，言满天下；陈之更不明〖32〗，不言无所损。又言伤告绝之义〖33〗，非吾所忍行也。是以捐弃纸笔〖34〗，一无所答。亦冀遥忖其心〖35〗，知其计定，不复渝变也。","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":195,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":380,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-c911adff3bb431063311","section":"chapter-007","block":"b-9e7d9e5140e6c2b63398","layer":"original","quote":"初尚掘鼠，煮筋角〖2〗，后无可复食者。主簿启内厨米三斗，请中分，稍以为糜粥。洪叹曰：“独食此何为！”使作薄粥，众分啜之〖3〗；杀其爱妾以食将士。将士咸流涕，无能仰视者","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":335,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":83,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-cf03bcdae5676b2d9032","section":"chapter-007","block":"b-6159e65bf2d2d864caaa","layer":"original","quote":"主人当鉴我曹辈〖113〗，反旌退师〖114〗，治兵邺垣；何宜久辱盛怒，暴威于吾城下哉〖115〗！足下讥吾恃黑山以为救，独不念黄巾之合从邪！加飞燕之属，悉以受王命矣〖116〗。昔高祖取彭越于钜野〖117〗，光武创基兆于绿林〖118〗，卒能龙飞中兴〖119〗，以成帝业；苟可辅主兴化，夫何嫌哉〖120〗？况仆亲奉玺书与之从事〖121〗。行矣孔璋〖122〗：足下徼利于境外〖123〗，臧洪授命于君亲〖124〗；吾子托身于盟主〖125〗，臧洪策名于长安〖126〗；子谓余身死而名灭，仆亦笑子生死而无闻焉。","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":201,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":248,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-db95b2fcdb5f1b61f01a","section":"chapter-007","block":"b-329c09ed29d75472ba2f","layer":"original","quote":"昔晏婴不降志于白刃〖100〗，南史不曲笔以求生〖101〗；故身著图像〖102〗，名垂后世。况仆据金城之固〖103〗，驱士民之力；散三年之蓄〖104〗，以为一年之资〖105〗；匡困补乏〖106〗，以悦天下〖107〗？何图筑室反耕哉〖108〗！但惧秋风扬尘，伯珪马首南向〖109〗；张杨、飞燕〖110〗，膂力作难；北鄙将告倒悬之急〖111〗，股肱奏乞归之诚耳〖112〗。","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":200,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":183,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-f077d52503dff5b680fb","section":"chapter-007","block":"b-f7bc578c9c6099d10d7d","layer":"original","quote":"洪由是怨绍，绝不与通〖5〗。绍兴兵围之，历年不下","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":194,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":24,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-f645e47ced285340b865","section":"chapter-007","block":"b-085ac22828a40a0f8c6e","layer":"original","quote":"会青州刺史焦和卒，绍使洪领青州，以抚其众","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":168,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":21,"end":41,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-fedfb15625c8c5be2e72","section":"chapter-007","block":"b-9e7d9e5140e6c2b63398","layer":"original","quote":"男女七八千人相枕而死，莫有离叛。城陷，绍生执洪","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":335,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":84,"end":107,"offset_unit":"unicode_code_point"}],"profiles":{"lvzang-p0017":{"fields":[{"id":"lvzang-p0017-directory-courtesy","key":"courtesy","label":"字","text":"子源","evidence":["lvzang-q-a619df2b2f1d6b8a9540"]}],"directory":{"faction":"qunxiong"}}},"directory_counts":{}}
