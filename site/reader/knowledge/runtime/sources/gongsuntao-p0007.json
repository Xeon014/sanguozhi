ngsuntao-q-21e3ad8d112aa0f24f52","gongsuntao-q-3dba4d9cc68a0daf23be","gongsuntao-q-a442b4306256794d0236","gongsuntao-q-4a6affd3b653876e3f9c","gongsuntao-q-3dfda7291a97e1e462c4","gongsuntao-q-4bfbe59d87df62dc7326","gongsuntao-q-c1325ed76fc9f11ba1af","gongsuntao-q-6d42d8c08d3de2799666","gongsuntao-q-02a3a079f7d97718ce47","yuanzhang-q-63689d14ddfd4d2a88ff","yuanzhang-q-0e6be9f28951f5563d73","yuanzhang-q-3ecdd9d9a7cd4151e1e5","yuanzhang-q-4c17dcdf60d8a5ff1675","yuanzhang-q-a8b7fc9c72a8ccd83d20","yuanzhang-q-fa7e3a8a03772f8c9107","yuanzhang-q-f3e693cb8a541deb2815","yuanzhang-q-b544f326557667b08a3f","yuanzhang-q-f1b5e6b1fe5404f0e36f","yuanzhang-q-94f6027c43150af08126","yuanzhang-q-7e7d7673b4f816bff292","wuhuan-q-6eeabcbbf12e8dac1583","wuhuan-q-afe13baf08cf05d5447c","wuhuan-q-8bd3a11f901551d35791"],"facts":[{"id":"gongsuntao-f-review-977cc12b93d37a28d1b9","text":"字升济，本辽东襄平人","evidence":["gongsuntao-q-6d42d8c08d3de2799666"]},{"id":"gongsuntao-f-review-4aca6ef5eac98b0934b3","text":"以中平六年据辽东，至渊三世，凡五十年而灭","evidence":["gongsuntao-q-02a3a079f7d97718ce47"]}],"aliases":[],"mentions":[{"id":"gongsuntao-m-review-d3ea2dae11f2751448f5","kind":"mention","text":"公孙度见于相关言论或记载。","evidence":["gongsuntao-q-4bfbe59d87df62dc7326"]}]}],"evidence":[{"id":"gongsuntao-q-02a3a079f7d97718ce47","section":"chapter-008","block":"b-55e2f40548e9c9f2ad52","layer":"original","quote":"始，度以中平六年据辽东，至渊三世，凡五十年而灭","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":230,"anchor":null},"note_id":null,"start":83,"end":106},{"id":"gongsuntao-q-21e3ad8d112aa0f24f52","section":"chapter-008","block":"b-43bcae5a2ba3983c049c","layer":"original","quote":"故河内太守李敏，郡中知名。恶度所为，恐为所害，乃将家属入于海。度大怒，掘其父冢，剖棺焚尸，诛其宗族","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":165,"anchor":null},"note_id":null,"start":128,"end":177},{"id":"gongsuntao-q-328b4af76f6a7febb76f","section":"chapter-008","block":"b-bf2386222059a536e906","layer":"original","quote":"后举有道〖2〗，除尚书郎〖3〗。稍迁冀州刺史，以谣言免","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":163,"anchor":null},"note_id":null,"start":84,"end":111},{"id":"gongsuntao-q-3dba4d9cc68a0daf23be","section":"chapter-008","block":"b-67ba674280f51fb2079c","layer":"original","quote":"分辽东郡为辽西、中辽郡，置太守。越海收东莱诸县〖13〗，置营州刺史。自立为辽东侯、平州牧","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":166,"anchor":null},"note_id":null,"start":0,"end":44},{"id":"gongsuntao-q-3dfda7291a97e1e462c4","section":"chapter-008","block":"b-32cde7e21d373e6d01d7","layer":"original","quote":"度死，子康嗣位，以永宁乡侯封弟恭。是岁，建安九年也","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":191,"anchor":null},"note_id":null,"start":0,"end":25},{"id":"gongsuntao-q-4a6affd3b653876e3f9c","section":"chapter-008","block":"b-67ba674280f51fb2079c","layer":"original","quote":"太祖表度为武威将军〖18〗，封永宁乡侯。度曰：“我王辽东〖19〗，何永宁也！”藏印绶武库","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":166,"anchor":null},"note_id":null,"start":110,"end":154},{"id":"gongsuntao-q-4bfbe59d87df62dc7326","section":"chapter-008","block":"b-407d1dfcbd8cf81dc713","layer":"original","quote":"评曰：公孙瓒保京〖1〗，坐待夷灭。度残暴而不节〖2〗，渊仍业以载凶〖3〗，只足覆其族也。陶谦昏乱而忧死，张杨授首于臣下；皆拥据州郡，曾匹夫之不若：固无可论者也。燕、绣、鲁，舍群盗，列功臣；去危亡，保宗祀：则于彼为愈焉","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":314,"anchor":null},"note_id":null,"start":0,"end":108},{"id":"gongsuntao-q-55241c6afa90d62b0d81","section":"chapter-008","block":"b-43bcae5a2ba3983c049c","layer":"original","quote":"初平元年，度知中国扰攘〖9〗，语所亲吏柳毅、阳仪等曰：“汉祚将绝，当与诸卿图王耳","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":165,"anchor":null},"note_id":null,"start":0,"end":40},{"id":"gongsuntao-q-6b4bee3c93ad25da7ca0","section":"chapter-008","block":"b-9b100edc000c32804ff5","layer":"original","quote":"东伐高句骊，西击乌丸，威行海外","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":164,"anchor":null},"note_id":null,"start":111,"end":126},{"id":"gongsuntao-q-6d42d8c08d3de2799666","section":"chapter-008","block":"b-bf2386222059a536e906","layer":"original","quote":"公孙度字升济，本辽东襄平人也","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":163,"anchor":null},"note_id":null,"start":0,"end":14},{"id":"gongsuntao-q-71433aae97a709f21d26","section":"chapter-008","block":"b-9b100edc000c32804ff5","layer":"original","quote":"郡中名豪大姓田韶等宿遇无恩〖8〗，皆以法诛。所夷灭百余家，郡中震栗","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":164,"anchor":null},"note_id":null,"start":77,"end":110},{"id":"gongsuntao-q-a442b4306256794d0236","section":"chapter-008","block":"b-67ba674280f51fb2079c","layer":"original","quote":"追封父延为建义侯。立汉二祖庙〖14〗；承制设坛？于襄平城南〖15〗，郊祀天地；籍田，治兵；乘鸾路〖16〗，九旒，旄头羽骑","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":166,"anchor":null},"note_id":null,"start":45,"end":105},{"id":"gongsuntao-q-a614cfc45063becfb535","section":"chapter-008","block":"b-9b100edc000c32804ff5","layer":"original","quote":"同郡徐荣为董卓中郎将，荐度为辽东太守","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":164,"anchor":null},"note_id":null,"start":0,"end":18},{"id":"gongsuntao-q-c1325ed76fc9f11ba1af","section":"chapter-008","block":"b-7eeb98f7e133596c6872","layer":"pei","quote":"度语毅、仪：‘谶书云“孙登当为天子”。太守姓公孙；字升济，升即登也","attribution":"裴注·魏书","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":189,"anchor":null},"note_id":"n-d63afc09a8fe61a3167d","start":10,"end":43},{"id":"gongsuntao-q-d3ace95e363d5e8ea7c7","section":"chapter-008","block":"b-43bcae5a2ba3983c049c","layer":"original","quote":"时襄平延里社生大石〖11〗，长丈余，下有三小石为之足。或谓度曰：“此汉宣帝冠石之祥〖12〗。而里名，与先君同。社主土地，明当有土地；而三公为辅也。”度益喜","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":165,"anchor":null},"note_id":null,"start":50,"end":127},{"id":"gongsuntao-q-e3abbb8198793ba00251","section":"chapter-008","block":"b-bf2386222059a536e906","layer":"original","quote":"时玄菟太守公孙琙，子豹，年十八岁早死。度少时名“豹”，又与琙子同年；琙见而亲爱之，遣就师学，为取妻","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":163,"anchor":null},"note_id":null,"start":34,"end":83},{"id":"gongsuntao-q-f7fb013a4539624c60b2","section":"chapter-008","block":"b-9b100edc000c32804ff5","layer":"original","quote":"先时，属国公孙昭守襄平令〖5〗，召度子康为伍长〖6〗。度到官，收昭，笞杀于襄平市","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":164,"anchor":null},"note_id":null,"start":33,"end":73},{"id":"wuhuan-q-6eeabcbbf12e8dac1583","section":"chapter-030","block":"b-913e4b4dc1858efb4f54","layer":"original","quote":"汉末，公孙度雄张海东〖21〗，威服外夷","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":142,"anchor":null},"note_id":null,"start":7,"end":26},{"id":"wuhuan-q-8bd3a11f901551d35791","section":"chapter-030","block":"b-4d02ad55cd430f983268","layer":"original","quote":"公孙度之雄海东也，伯固遣大加优居、主簿然人等助度击富山贼〖36〗，破之","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":190,"anchor":null},"note_id":null,"start":47,"end":82},{"id":"wuhuan-q-afe13baf08cf05d5447c","section":"chapter-030","block":"b-913e4b4dc1858efb4f54","layer":"original","quote":"时句丽、鲜卑强〖22〗，度以夫余在二虏之间，妻以宗女","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":142,"anchor":null},"note_id":null,"start":38,"end":64},{"id":"yuanzhang-q-00d48f5c3d0b7a24b6ea","section":"chapter-011","block":"b-616f1086bdb6d3f6ca69","layer":"original","quote":"原在辽东，一年中往归原居者数百家。游学之士，教授之声，不绝。后得归","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":314,"anchor":null},"note_id":null,"start":248,"end":281},{"id":"yuanzhang-q-0e6be9f28951f5563d73","section":"chapter-011","block":"b-3d3fa41457345efff9ba","layer":"original","quote":"度谓茂及诸将曰：“闻曹公远征，邺无守备；今吾欲以步卒三万，骑万匹，直指邺。谁能御之！”诸将皆曰：“然！”","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":114,"anchor":null},"note_id":null,"start":33,"end":85},{"id":"yuanzhang-q-3714345cc1a4c26c3034","section":"chapter-011","block":"b-c71970db92c5d0c6164f","layer":"original","quote":"太祖命为丞相掾、征事；未至，卒于海表","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":351,"anchor":null},"note_id":null,"start":42,"end":60},{"id":"yuanzhang-q-3ecdd9d9a7cd4151e1e5","section":"chapter-011","block":"b-3d3fa41457345efff9ba","layer":"original","quote":"又顾谓茂曰：“于君意何如？”茂答曰：“比者海内大乱〖4〗，社稷将倾；将军拥十万之众，安坐而观成败；夫为人臣者，固若是邪〖5〗！曹公忧国家之危败，愍百姓之苦毒；率义兵为天下诛残贼，功高而德广，可谓无二矣。以海内初定，民始安集，故未责将军之罪耳！而将军乃欲称兵西向，则存亡之效，不崇朝而决〖6〗。将军其勉之〖7〗！”诸将闻茂言，皆震动。良久，度曰：“凉君言是也","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":114,"anchor":null},"note_id":null,"start":88,"end":266},{"id":"yuanzhang-q-4c17dcdf60d8a5ff1675","section":"chapter-011","block":"b-616f1086bdb6d3f6ca69","layer":"original","quote":"辽东太守公孙度畏恶，欲杀之，尽收捕其家；政得脱","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":314,"anchor":null},"note_id":null,"start":57,"end":80},{"id":"yuanzhang-q-63689d14ddfd4d2a88ff","section":"chapter-011","block":"b-3d3fa41457345efff9ba","layer":"original","quote":"公孙度在辽东，擅留茂；不遣之官〖3〗，然茂终不为屈","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":114,"anchor":null},"note_id":null,"start":7,"end":32},{"id":"yuanzhang-q-76f59d6d2fe3754e40ef","section":"chapter-011","block":"b-616f1086bdb6d3f6ca69","layer":"original","quote":"原又资送政家，皆得归故郡","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":314,"anchor":null},"note_id":null,"start":235,"end":247},{"id":"yuanzhang-q-7df57792a625f953b933","section":"chapter-011","block":"b-616f1086bdb6d3f6ca69","layer":"original","quote":"时东莱太史慈，当归〖4〗，原因以政付之","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":314,"anchor":null},"note_id":null,"start":115,"end":134},{"id":"yuanzhang-q-7e7d7673b4f816bff292","section":"chapter-011","block":"b-1e77d6c23c1dd6d6ec82","layer":"pei","quote":"邴原性刚直，清议以格物；度以下，心不安之。宁谓原曰：‘潜龙以不现成德；言非其时，皆招祸之道也。’密遣令西还","attribution":"裴注·傅子","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":363,"anchor":null},"note_id":"n-4958052ff2433e6ba0c5","start":99,"end":152},{"id":"yuanzhang-q-94f6027c43150af08126","section":"chapter-011","block":"b-1e77d6c23c1dd6d6ec82","layer":"pei","quote":"宁往见度，语惟经典，不及世事。还，乃因山为庐，凿坏为室。越海避难者，皆来就之而居，旬月而成邑。遂讲《诗》、《书》，陈俎豆，饰威仪，明礼让；非学者，无见也。由是度安其贤，民化其德","attribution":"裴注·傅子","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":363,"anchor":null},"note_id":"n-4958052ff2433e6ba0c5","start":10,"end":98},{"id":"yuanzhang-q-a8b7fc9c72a8ccd83d20","section":"chapter-011","block":"b-616f1086bdb6d3f6ca69","layer":"original","quote":"度告诸县：“敢有藏政者，与同罪！”政窘急，往投原，﹝一﹞原匿之月余","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":314,"anchor":null},"note_id":null,"start":81,"end":114},{"id":"yuanzhang-q-b544f326557667b08a3f","section":"chapter-011","block":"b-c71970db92c5d0c6164f","layer":"original","quote":"辞公孙度长史，商贾自秽","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":351,"anchor":null},"note_id":null,"start":27,"end":38},{"id":"yuanzhang-q-ee3abd3d9accb1026a70","section":"chapter-011","block":"b-8763480f5449ff879f44","layer":"pei","quote":"政，投原，曰：‘穷鸟入怀！’原曰：‘安知斯怀之可入邪","attribution":"裴注·魏氏春秋","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":336,"anchor":null},"note_id":"n-2ceca3f8bacb29056457","start":12,"end":38},{"id":"yuanzhang-q-f1b5e6b1fe5404f0e36f","section":"chapter-011","block":"b-f117f39bbee4400e1c45","layer":"pei","quote":"积十余年，后乃遁还。南行已数日，而度甫觉。度知原之不可复追也，因曰：‘邴君所谓云中白鹤，非鹑鷃之网所能罗矣！又吾自遣之，勿复求也。’遂免危难","attribution":"裴注·原别传","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":341,"anchor":null},"note_id":"n-73e160afdb3d08400061","start":369,"end":439},{"id":"yuanzhang-q-f3e693cb8a541deb2815","section":"chapter-011","block":"b-c95cfb5d17dd1992e875","layer":"original","quote":"天下大乱，闻公孙度令行于海外，遂与原及平原王烈等，至于辽东。度虚馆以候之","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":350,"anchor":null},"note_id":null,"start":0,"end":36},{"id":"yuanzhang-q-fa7e3a8a03772f8c9107","section":"chapter-011","block":"b-616f1086bdb6d3f6ca69","layer":"original","quote":"既而谓度曰：“将军前日欲杀刘政，以其为己害〖5〗。今政已去，君之害岂不除哉？”度曰：“然。”原曰：“君之畏政者，以其有智也。今政已免〖6〗，智将用矣，尚奚拘政之家？不若赦之，无重怨〖7〗。”度乃出之","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":314,"anchor":null},"note_id":null,"start":135,"end":234},{"id":"yuanzhang-q2-b0e6bf00aa0831e758e5","section":"chapter-011","block":"b-57aaa4264f738b218818","layer":"pei","quote":"﹝二﹞臣松之按：此传云公孙度“闻曹公远征，邺无守备”，则太祖定邺后也。按《度传》，度以建安九年卒，太祖亦以此年定邺；自后远征，唯有北征柳城耳：征柳城之年，度已不复在矣。","attribution":"裴注（引书见原文）","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":131,"anchor":null},"note_id":"n-65b3ccecac42d3b40763","start":0,"end":84}],"profiles":{"gongsuntao-p0007":{"fields":[{"id":"gongsuntao-p0007-directory-courtesy","key":"courtesy","label":"字","text":"升济","evidence":["gongsuntao-q-6d42d8c08d3de2799666"]}],"directory":{"faction":"qunxiong"}}},"directory_counts":{}}
