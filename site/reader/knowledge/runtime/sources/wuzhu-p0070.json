{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"mingdi-e-o036a","title":"公孙渊斩吴使首级受封乐浪公","accounts":[{"id":"mingdi-e-o036a-account","label":"《明帝纪》正文","text":"公孙渊斩吴使首级受封乐浪公","evidence":["mingdi-e-o036a-q"]},{"id":"gongsuntao-a-d07f42b7e68b690bc6fe","label":"正文","text":"权遣张弥许晏赍金玉珍宝立渊为燕王","evidence":["gongsuntao-q-5142fa488a5a72920ad6"]},{"id":"gongsuntao-a-6655074ef16bea1c8518","label":"正文","text":"渊诱致其使悉斩送弥晏等首","evidence":["gongsuntao-q-300d73ca9e9fa45a3e3a"]},{"id":"gongsuntao-a-d53be1a94aee402f9e62","label":"正文","text":"明帝拜渊大司马封乐浪公","evidence":["gongsuntao-q-75b8a8597115fe3b632e"]},{"id":"gongsuntao-a-d1eaa95b9891166471fd","label":"正文","text":"渊设甲兵军阵出见使者数出恶言","evidence":["gongsuntao-q-0d33a544103290c4fdc2"]},{"id":"gongsuntao-a-583125cb9f719336f05e","label":"裴注·魏略","text":"渊进兵围取斩吴使弥晏泰潜等徙其众","evidence":["gongsuntao-q-af990d6b6c015f930f27"]},{"id":"gongsuntao-a-d99c1e73ab0386bd1339","label":"裴注·吴书","text":"魏遣傅容聂夔拜渊为乐浪公","evidence":["gongsuntao-q-450019c87c19652b684e"]},{"id":"gongsuntao-a-6aa2f3c7f0189bf000d6","label":"裴注·吴书","text":"渊疑怖先围学馆而后受拜容夔还洛言状","evidence":["gongsuntao-q-53fdc8ca1012e256aba3"]},{"id":"wangwei-a-3161988ff8c646039b2c","label":"正文","text":"后公孙渊果斩送孙权使张弥等首","evidence":["wangwei-q-2cdad682994e598680a1"]}],"participants":[{"person":"mingdi-p0013","role":"杀使受封","evidence":["mingdi-e-o036a-q"]},{"person":"mingdi-p0035","role":"被杀","evidence":["mingdi-e-o036a-q"]},{"person":"mingdi-p0036","role":"被杀","evidence":["mingdi-e-o036a-q"]},{"person":"sun-quan","role":"遣使","evidence":["mingdi-e-o036a-q"]},{"person":"wendi-p0005","role":"拜渊大司马封乐浪公持节领郡如故","evidence":["gongsuntao-q-75b8a8597115fe3b632e"]},{"person":"gongsuntao-p0001","role":"中郎将、被斩","evidence":["gongsuntao-q-af990d6b6c015f930f27"]},{"person":"gongsuntao-p0070","role":"校尉、别赍致遣货物欲因市马、被斩","evidence":["gongsuntao-q-af990d6b6c015f930f27"]},{"person":"wuzhu-p0070","role":"军将、领余众在船所","evidence":["gongsuntao-q-af990d6b6c015f930f27"]},{"person":"gongsuntao-p0069","role":"军将、领余众在船所","evidence":["gongsuntao-q-af990d6b6c015f930f27"]},{"person":"wuzhu-p0068","role":"校尉、先遣诱吴","evidence":["gongsuntao-q-af990d6b6c015f930f27"]},{"person":"wuzhu-p0069","role":"郎中令、先遣诱吴","evidence":["gongsuntao-q-af990d6b6c015f930f27"]},{"person":"mantian-p0003","role":"魏使者、拜渊为乐浪公；至住学馆中、大怖、还洛言状","evidence":["gongsuntao-q-450019c87c19652b684e","gongsuntao-q-53fdc8ca1012e256aba3"]},{"person":"gongsuntao-p0066","role":"魏使者、同拜渊；同住学馆、大怖还洛言状","evidence":["gongsuntao-q-450019c87c19652b684e","gongsuntao-q-53fdc8ca1012e256aba3"]}],"place":null,"time":{"year":233,"label":"青龙元年十二月","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"mingdi-y233","dating_review":{"reviewed":true,"anchor":"mingdi-q-o030","basis":"青龙元年十二月"},"evidence":["mingdi-e-o036a-q","mingdi-q-o030","mingdi-q-o037","mingdi-q-b-7a11c761ca65aeb3d195"]},"ordering_evidence":"mingdi-e-o036a-q","source_order":[3,217,"O036a"],"order":828},{"id":"gongsuntao-e-o201","title":"《魏略》载公孙渊表称韩起诱市伏击吴人","accounts":[{"id":"gongsuntao-a-be34122a8ecb52affa7b","label":"裴注·魏略","text":"《魏略》载公孙渊表称韩起诱市伏击吴人","evidence":["gongsuntao-q-6192c0faef65eaf59eb0"]}],"participants":[{"person":"mingdi-p0013","role":"别遣将韩起等率将三军驰行至沓","evidence":["gongsuntao-q-6192c0faef65eaf59eb0"]},{"person":"gongsuntao-p0082","role":"率将三军驰行至沓","evidence":["gongsuntao-q-6192c0faef65eaf59eb0"]},{"person":"gongsuntao-p0054","role":"领长史、设宾主礼诱请达咨","evidence":["gongsuntao-q-6192c0faef65eaf59eb0"]},{"person":"wuzhu-p0070","role":"公孙渊表称怀疑不下船，遣市买者下船","evidence":["gongsuntao-q-6192c0faef65eaf59eb0"]},{"person":"gongsuntao-p0069","role":"公孙渊表称与贺达怀疑不下船","evidence":["gongsuntao-q-6192c0faef65eaf59eb0"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["gongsuntao-q-6192c0faef65eaf59eb0"]},"ordering_evidence":"gongsuntao-q-6192c0faef65eaf59eb0","source_order":[8,222,307],"order":2044},{"id":"wuzhu-e-o104a","title":"孙权遣宿舒孙综还使张弥许晏贺达率万人授公孙渊九锡","accounts":[{"id":"wuzhu-e-o104a-account","label":"《吴主传第二》正文","text":"孙权遣宿舒孙综还使张弥许晏贺达率万人授公孙渊九锡","evidence":["wuzhu-e-o104a-q"]},{"id":"wuzhu-a-p054-judgment","label":"裴松之论","text":"裴松之认为信渊已定而以万人宣命，是不爱其民。","evidence":["wuzhu-q-p054-judgment"]}],"participants":[{"person":"sun-quan","role":"遣使","evidence":["wuzhu-e-o104a-q"]},{"person":"wuzhu-p0068","role":"返辽东","evidence":["wuzhu-e-o104a-q"]},{"person":"wuzhu-p0069","role":"返辽东","evidence":["wuzhu-e-o104a-q"]},{"person":"mingdi-p0035","role":"奉使","evidence":["wuzhu-e-o104a-q"]},{"person":"mingdi-p0036","role":"奉使","evidence":["wuzhu-e-o104a-q"]},{"person":"wuzhu-p0070","role":"领军","evidence":["wuzhu-e-o104a-q"]},{"person":"mingdi-p0013","role":"被授","evidence":["wuzhu-e-o104a-q"]}],"place":null,"time":{"year":233,"label":"三月","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"wuzhu-y233","dating_review":{"reviewed":true,"anchor":"wuzhu-q-o103","basis":"三月"},"evidence":["wuzhu-e-o104a-q","wuzhu-q-o103","mingdi-q-o030","mingdi-q-o037","mingdi-q-b-7a11c761ca65aeb3d195"]},"ordering_evidence":"wuzhu-e-o104a-q","source_order":[47,526,"O104a"],"order":8305}],"persons":[{"id":"wuzhu-p0070","name":"贺达","evidence":["wuzhu-q-o104","gongsuntao-q-af990d6b6c015f930f27","gongsuntao-q-6192c0faef65eaf59eb0"],"facts":[],"aliases":[],"mentions":[{"id":"wuzhu-m-o104-wuzhu-p0070","kind":"mention","text":"文中提及","evidence":["wuzhu-q-o104"]}]}],"evidence":[{"id":"gongsuntao-q-0d33a544103290c4fdc2","section":"chapter-008","block":"b-34ca3fec9b802239e28e","layer":"original","quote":"使者至，渊设甲兵为军阵，出见使者；又数对国中宾客出恶言","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":195,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":27,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-300d73ca9e9fa45a3e3a","section":"chapter-008","block":"b-6c1a02548b17f7317c2e","layer":"original","quote":"渊亦恐权远不可恃，且贪货物〖5〗；诱致其使，悉斩送弥、晏等首","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":194,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":41,"end":71,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-450019c87c19652b684e","section":"chapter-008","block":"b-caaadaeaef77c1527927","layer":"pei","quote":"魏遣使者傅容、聂夔，拜渊为乐浪公","attribution":"裴注·吴书","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":227,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-bd15304ac108864907ba","start":10,"end":26,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-5142fa488a5a72920ad6","section":"chapter-008","block":"b-6c1a02548b17f7317c2e","layer":"original","quote":"权遣使张弥、许晏等，赍金玉珍宝，立渊为燕王","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":194,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":19,"end":40,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-53fdc8ca1012e256aba3","section":"chapter-008","block":"b-caaadaeaef77c1527927","layer":"pei","quote":"渊计吏从洛阳还，语渊曰：‘使者左骏伯，使皆择勇力者，非凡人也！’渊由是疑怖。容、夔至，住学馆中。渊先以步骑围之，乃入受拜。容、夔大怖，由是还洛言状","attribution":"裴注·吴书","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":227,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-bd15304ac108864907ba","start":27,"end":100,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-6192c0faef65eaf59eb0","section":"chapter-008","block":"b-c385fdb879704d169d8a","layer":"pei","quote":"别遣将韩起等，率将三军，驰行至沓。使领长史柳远，设宾主礼诱请达、咨，三军潜伏以待其下；又驱群马货物，欲与交市。达、咨怀疑，不下，使诸市买者五六百人下，欲交市。起等金鼓始震，锋矢乱发，斩首三百余级，被创赴水没溺者可二百余人；其散走山谷，来归降及藏窜饥饿死者，不在数中。得银印、铜印、兵器、资货，不可胜数","attribution":"裴注·魏略","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":221,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-14d174739835bc97c008","start":307,"end":457,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-75b8a8597115fe3b632e","section":"chapter-008","block":"b-6c1a02548b17f7317c2e","layer":"original","quote":"明帝于是拜渊大司马，封乐浪公，持节、领郡如故","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":194,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":75,"end":97,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-af990d6b6c015f930f27","section":"chapter-008","block":"b-c385fdb879704d169d8a","layer":"pei","quote":"臣前遣校尉宿舒、郎中令孙综，甘言厚礼，以诱吴贼。幸赖天道福助大魏，使此贼虏暗然迷惑；违戾群下，不从众谏；承信臣言，远遣船使；多将士卒，来致封拜。臣之所执，得如本志；虽忧罪衅，私怀幸甚。贼众本号‘万人’，舒、综伺察，可七八千人。到沓津，伪使者张弥、许晏，与中郎将万泰、校尉裴潜，将吏兵四百余人，赍文书、命服、什物，下到臣郡。泰、潜别赍致遣货物，欲因市马。军将贺达、虞咨，领余众在船所。臣本欲须凉节乃取弥等；而弥等人兵众多，见臣不便承受吴命，意有猜疑；惧其先作，变态妄生：即进兵围取，斩弥、晏、泰、潜等首级。其吏从兵众，皆士伍小人，给使东西，不得自由；面缚乞降，不忍诛杀，辄听纳受，徙充边城","attribution":"裴注·魏略","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":221,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-14d174739835bc97c008","start":13,"end":306,"offset_unit":"unicode_code_point"},{"id":"mingdi-e-o036a-q","section":"chapter-003","block":"b-6ff54fbfca62786685fb","layer":"original","quote":"十二月，公孙渊斩送孙权所遣使张弥、许晏首〖20〗；以渊为大司马、乐浪公。﹝三﹞","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":216,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":39,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-b-7a11c761ca65aeb3d195","section":"chapter-003","block":"b-7a11c761ca65aeb3d195","layer":"modern","quote":"〖1〗二年：青龙二年（公元 234）。己未：旧历初四日。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":252,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6c0753fe684a18a3a281","start":0,"end":28,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-o030","section":"chapter-003","block":"b-cb99fef1996d806deb1c","layer":"original","quote":"青龙元年春正月，甲申〖1〗，青龙现郏之摩陂井中〖2〗。二月，丁酉〖3〗，幸摩陂观龙。于是改年，改摩陂为龙陂。赐男子爵，人二级；鳏寡孤独。无出今年租赋。三月，甲子〖4〗，诏公卿举贤良、笃行之士。各一人。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":210,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":100,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-o037","section":"chapter-003","block":"b-ff97c2d326d0fc08a9de","layer":"original","quote":"二年春二月，（乙）〔己〕未〖1〗，太白犯荧惑。癸酉〖2〗，诏曰：“‘鞭作官刑〖3〗’，所以纠慢怠也〖4〗；而顷多以无辜死。其减鞭杖之制〖5〗，著于令。”三月，庚寅〖6〗，山阳公薨；帝素服发哀〖7〗，遣使持节，典护丧事。己酉〖8〗，大赦。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":249,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":118,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-2cdad682994e598680a1","section":"chapter-021","block":"b-e3933b3cde655110e1e9","layer":"original","quote":"后渊果斩送权使张弥等首","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":347,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":109,"end":120,"offset_unit":"unicode_code_point"},{"id":"wuzhu-e-o104a-q","section":"chapter-047","block":"b-c08f51e897f709524a8b","layer":"original","quote":"三月，遣舒、综还；使太常张弥、执金吾许晏、将军贺达等将兵万人〖18〗，金宝珍货，九锡备物，乘海授渊。﹝二﹞","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":14,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":53,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o103","section":"chapter-047","block":"b-f2d17fe961012277706a","layer":"original","quote":"二年春正月〖4〗，诏曰：“朕以不德，肇受元命〖5〗；夙夜兢兢，不遑假寝〖6〗。思平世难，救济黎庶〖7〗；上答神祇，下慰民望。是以眷眷〖8〗，勤求俊杰；将与戮力，共定海内；苟在同心〖9〗，与之偕老。今使持节、督幽州、领青州牧、辽东太守、燕王〖10〗，久胁贼虏，隔在一方；虽乃心于国，其路靡缘〖11〗。今因天命，远遣二使；款诚显露，章表殷勤。朕之得此，何喜如之！虽汤遇伊尹〖12〗，周获吕望〖13〗，世祖未定而得河右〖14〗；方之今日，岂复是过？普天一统，于是定矣！《书》不云乎：‘一人有庆，兆民赖之〖15〗。’其大赦天下，与之更始〖16〗。其明下州郡，咸使闻知。特下燕国，奉宣诏恩。令普天率土〖17〗，备闻斯庆。”","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":13,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":306,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o104","section":"chapter-047","block":"b-c08f51e897f709524a8b","layer":"original","quote":"三月，遣舒、综还；使太常张弥、执金吾许晏、将军贺达等将兵万人〖18〗，金宝珍货，九锡备物，乘海授渊。﹝二﹞","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":14,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":53,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-p054-judgment","section":"chapter-047","block":"b-0463d6981fba6fc7711b","layer":"pei","quote":"﹝三﹞臣松之以为：权愎谏违众，信渊意了，非有攻伐之规，重复之虑；宣达锡命，乃用万人：是何不爱其民，昏虐之甚乎？此役也，非惟暗塞，实为无道！","attribution":"裴松之论","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":43,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-de341329beeeef7c7dd5","start":0,"end":69,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
