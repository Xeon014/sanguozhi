{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wuwen-e-ea211c28577f5a7f0a74","title":"魏书曹据玺书述董和作禁物之奏，宥而削县户（全文）","accounts":[{"id":"wuwen-a-ea211c28577f5a7f0a74","label":"裴注·魏书","text":"魏书曹据玺书述董和作禁物之奏，宥而削县户（全文）","evidence":["wuwen-q-30de9653d5114fdc5d0a"]}],"participants":[{"person":"wudi-p0281","role":"被奏削封者","evidence":["wuwen-q-30de9653d5114fdc5d0a"]},{"person":"wuwen-p-031a65927b653f","role":"奏中被述作物者","evidence":["wuwen-q-30de9653d5114fdc5d0a"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["wuwen-q-30de9653d5114fdc5d0a"]},"ordering_evidence":"wuwen-q-30de9653d5114fdc5d0a","order":3881}],"persons":[{"id":"wuwen-p-031a65927b653f","name":"董和（曹据司马）","evidence":["wuwen-q-30de9653d5114fdc5d0a"],"facts":[],"mentions":[],"aliases":[]}],"evidence":[{"id":"wuwen-q-30de9653d5114fdc5d0a","section":"chapter-020","block":"b-0d194bc26897a8d0634c","layer":"pei","quote":"﹝一﹞《魏书》载玺书曰：“制诏彭城王：有司奏，王遣司马董和，赍珠玉，来到京师中尚方，多作禁物，交通工官，出入近署，逾侈非度；慢令违制，绳王以法。朕用怃然，不宁于心。王以懿亲之重，处藩辅之位；典籍日陈于前，勤诵不辍于侧；加雅素奉修，恭肃敬慎；务在蹈道，孜孜不衰：岂忘率意正身，考终厥行哉？若然小疵，或谬于细人；忽不觉悟，以斯为失耳。《书》云：‘惟圣罔念作狂，惟狂克念作圣。’古人垂诰，乃至于此；故君子思心，无斯须远道焉。常虑所以累德者而去之，则德明矣；开心所以为塞者而通之，则心夷矣；慎行所以为尤者而修之，则行全矣：三者，王之所能备也。今诏有司宥王，削县二，千户；以彰八柄与夺之法。昔羲、文作《易》，著休复之诰；仲尼论行，既过能改。王其改行，茂昭斯义，率意无怠。”","attribution":"裴注·魏书","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":49,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1a9c5eeed81ee2d105b2","start":0,"end":331,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
