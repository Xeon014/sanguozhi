{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[],"persons":[{"id":"zhuge-p0008","name":"周术","evidence":["zhuge-q-p001"],"facts":[],"aliases":[],"mentions":[{"id":"zhuge-m-p001-zhuge-p0008","kind":"mention","text":"文中提及","evidence":["zhuge-q-p001"]}]}],"evidence":[{"id":"zhuge-q-p001","section":"chapter-035","block":"b-0ba957ed490b6345b7bd","layer":"pei","quote":"﹝一﹞《献帝春秋》曰：“初，豫章太守周术病卒，刘表上诸葛玄为豫章太守，治南昌。汉朝闻周术死，遣朱皓代玄。皓从扬州刺史刘繇求兵，击玄；玄退屯西城：皓入南昌。建安二年正月，西城民反，杀玄，送首诣繇。”此书所云，与本传不同。","attribution":"《献帝春秋》","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":23,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-43698058f80b13e4af1b","start":0,"end":109,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
