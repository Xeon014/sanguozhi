EBPS/Text/titlepage_0103.xhtml","index":423,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f2b1c35672a6ca8714ea","start":21,"end":55,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-76075b0a412a66a03ab9","section":"chapter-048","block":"b-d7f8233ea732bc33e866","layer":"pei","quote":"初，霍弋遣杨稷、毛炅等戍，与之誓曰：‘若贼围城，未百日而降者，家属诛；若过百日而城没者，刺史受其罪","attribution":"裴注·汉晋春秋","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":422,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f2b1c35672a6ca8714ea","start":12,"end":61,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-e2ff19ec77b468e2d62d","section":"chapter-048","block":"b-9a7cf4443f939e02dfaa","layer":"pei","quote":"孙皓使送稷下都；稷至合浦，呕血死","attribution":"裴注·华阳国志","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":423,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f2b1c35672a6ca8714ea","start":56,"end":72,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
