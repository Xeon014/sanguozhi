d":"zhonghua-a-d78817710eba2b2dc5e8","label":"正文","text":"黄初中诏公卿举独行君子，华歆举管宁，帝以安东征之","evidence":["zhonghua-q-56166747e6635aa4db2c"]}],"participants":[{"person":"wudi-p0340","role":"为司徒，荐管宁","evidence":["yuanzhang-q-870cd6af7bf3c206c73f"]},{"person":"wudi-p0170","role":"即位征管宁","evidence":["yuanzhang-q-870cd6af7bf3c206c73f"]},{"person":"huanchen-p0600","role":"被荐被征；将家属浮海还郡；受而藏公孙度、康、恭前后所资遗，既已西渡，尽封还之；曰废嫡立庶下有异心乱之所由起也，乃将家属乘海即受征，在辽东积三十七年乃归；海中遇暴风船皆没唯其乘船自若，望火光趋之得岛，行人咸异以为神光之祐","evidence":["yuanzhang-q-870cd6af7bf3c206c73f","yuanzhang-q-d001cc765ba4361532f4","yuanzhang-q-ea624a9e4f8c6e81ea55","yuanzhang-q-87d4f9c5b0e3f715babb","yuanzhang-q-093b09c6157e1c3a725a"]},{"person":"wendi-p0015","role":"送之南郊，加赠服物；康弟，懦弱，被立","evidence":["yuanzhang-q-d001cc765ba4361532f4","yuanzhang-q-87d4f9c5b0e3f715babb"]},{"person":"wudi-p0247","role":"已死","evidence":["yuanzhang-q-87d4f9c5b0e3f715babb"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["yuanzhang-q-870cd6af7bf3c206c73f","yuanzhang-q-d001cc765ba4361532f4","yuanzhang-q-ea624a9e4f8c6e81ea55","yuanzhang-q-87d4f9c5b0e3f715babb","yuanzhang-q-093b09c6157e1c3a725a"]},"ordering_evidence":"yuanzhang-q-870cd6af7bf3c206c73f","source_order":[11,368,0],"order":2660},{"id":"yuanzhang-e-o195","title":"公孙渊果袭夺恭位，叛国家南连吴僭号称王；明帝使相国、宣文侯征灭之，辽东死者以万计，如宁所筹","accounts":[{"id":"yuanzhang-a-06e8860923952a07bf5e","label":"裴注·傅子","text":"公孙渊果袭夺恭位，叛国家南连吴僭号称王；明帝使相国、宣文侯征灭之，辽东死者以万计，如宁所筹","evidence":["yuanzhang-q-1d933edd3bee001456c4"]}],"participants":[{"person":"mingdi-p0013","role":"果袭夺恭位，叛国家而南连吴，僭号称王","evidence":["yuanzhang-q-1d933edd3bee001456c4"]},{"person":"wendi-p0005","role":"使相国、宣文侯征灭公孙渊","evidence":["yuanzhang-q-1d933edd3bee001456c4"]},{"person":"wendi-p0015","role":"位被袭夺","evidence":["yuanzhang-q-1d933edd3bee001456c4"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["yuanzhang-q-1d933edd3bee001456c4"]},"ordering_evidence":"yua