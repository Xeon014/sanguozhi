evidence":["liusima-q-1dea94bc4c56b3bfe0b5","wudi-e-o010b-q"]}],"order":59},{"id":"dongyuan-e-p101b","title":"袁绍遣袁遗领州袁遗败奔沛被杀","accounts":[{"id":"dongyuan-e-p101b-account","label":"裴松之按《英雄记》","text":"袁绍遣袁遗领州袁遗败奔沛被杀","evidence":["dongyuan-e-p101b-q"]}],"participants":[{"person":"wudi-p0052","role":"遣任","evidence":["dongyuan-e-p101b-q"]},{"person":"wudi-p0064","role":"受任败走被杀","evidence":["dongyuan-e-p101b-q"]}],"place":null,"time":{"label":"陈温袁遗陈瑀领扬州时异说","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-p101b-q"]},"ordering_evidence":"dongyuan-e-p101b-q","source_order":[6,401,"P101b"],"order":1723}],"persons":[{"id":"wudi-p0064","name":"袁遗","evidence":["wudi-q-o009","wendi-q-p106","dongyuan-q-p101"],"facts":[{"id":"wudi-f-p027-wudi-p0064-c55038","label":"字","text":"伯业","evidence":["wudi-q-p027"]},{"id":"wudi-f-p027-wudi-p0064-6167ce","label":"任官记载","text":"曾任长安令","evidence":["wudi-q-p027"]},{"id":"wudi-f-p029-wudi-p0064-c06625","label":"人物评价","text":"曹操称其成年之后仍勤学。","evidence":["wudi-q-p029"]},{"id":"wendi-f0007","label":"本篇称名","text":"袁伯业","evidence":["wendi-f0007-q"]}],"aliases":[{"text":"伯业","evidence":["wudi-q-p027"]},{"text":"袁伯业","evidence":["wendi-f0007-q"]}],"mentions":[{"id":"wudi-m-o009-wudi-p0064","kind":"mention","text":"文中提及","evidence":["wudi-q-o009"]},{"id":"wudi-m-p027-wudi-p0064","kind":"mention","text":"文中提及","evidence":["wudi-q-p027"]},{"id":"wudi-m-p028-wudi-p0064","kind":"mention","text":"文中提及","evidence":["wudi-q-p028"]},{"id":"wudi-m-p029-wudi-p0064","kind":"mention","text":"文中提及","evidence":["wudi-q-p029"]},{"id":"wudi-m-o010-wudi-p0064","kind":"mention","text":"文中提及","evidence":["wudi-q-o010"]},{"id":"wendi-m-p106-wudi-p0064","kind":"mention","text":"文中提及","evidence":["wendi-q-p106"]},{"id":"dongyuan-m-p101-wudi-p0064","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p101"]}]}],"evidence":[{"id":"dongyuan-e-o036a-q","section":"chapter-006","block":"b-5c715668eee2a0a99811","layer":"original","quote":"绍遂以勃海起兵，将以诛卓。语在《武纪》。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":221,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p101a-q","section":"chapter-006","block":"b-dd2315fa487eddcf425c","layer":"pei","quote":"陈温字元悌，汝南人。先为扬州刺史，自病死。","attribution":"裴松之按《英雄记》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":400,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cfd59ac468ffd86d6e36","start":14,"end":35,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p101b-q","section":"chapter-006","block":"b-dd2315fa487eddcf425c","layer":"pei","quote":"袁绍遣袁遗领州，败散，奔沛国，为兵所杀。","attribution":"裴松之按《英雄记》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":400,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cfd59ac468ffd86d6e36","start":35,"end":55,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p101","section":"chapter-006","block":"b-dd2315fa487eddcf425c","layer":"pei","quote":"﹝二﹞臣松之按《英雄记》：“陈温字元悌，汝南人。先为扬州刺史，自病死。袁绍遣袁遗领州，败散，奔沛国，为兵所杀。袁术更用陈瑀为扬州。瑀字公玮，下邳人。瑀既领州，而术败于封丘，南向寿春；瑀拒术不纳，术退保阴陵。更合军攻瑀，瑀惧走归下邳。”如此，则温不为术所杀，与本传不同。","attribution":"裴松之按《英雄记》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":400,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cfd59ac468ffd86d6e36","start":0,"end":134,"offset_unit":"unicode_code_point"},{"id":"liusima-q-1dea94bc4c56b3bfe0b5","section":"chapter-015","block":"b-511f012c14f14dff5c5b","layer":"original","quote":"后数月，关东诸州郡起兵，众数十万，皆集荥阳及河内。诸将不能相一〖10〗，纵兵抄掠，民人死者且半","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":58,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":25,"end":72,"offset_unit":"unicode_code_point"},{"id":"rensu-q-f64cf1a8c7978e162aed","section":"chapter-016","block":"b-c172c36c6f19e1d68402","layer":"pei","quote":"关东义兵起，卓会议大发兵；群僚咸惮卓，莫敢忤旨","attribution":"裴注·张璠《汉纪》","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":338,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-011440cf6742ee5cb197","start":246,"end":269,"offset_unit":"unicode_code_point"},{"id":"wendi-f0007-q","section":"chapter-002","block":"b-6eb68753e8e520d9914c","layer":"pei","quote":"袁伯业","attribution":"裴注·典论自叙","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":521,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-2aa5d4559ce229d0d61c","start":1113,"end":1116,"offset_unit":"unicode_code_point"},{"id":"wendi-q-p106","section":"chapter-002","block":"b-6eb68753e8e520d9914c","layer":"pei","quote":"﹝一﹞《典论》帝《自叙》曰：“初平之元，董卓杀主鸩后，荡覆王室。是时四海既困中平之政，兼恶卓之凶逆；家家思乱，人人自危。山东牧守，咸以《春秋》之义，‘卫人讨州吁于濮’，言人人皆得讨贼。于是大兴义兵，名豪大侠，富室强族；飘扬云会，万里相赴。兖、豫之师战于荥阳，河内之甲军于孟津。卓遂迁大驾，西都长安。而山东大者连郡国，中者婴城邑，小者聚阡陌，以还相吞灭。会黄巾盛于海岱，山寇暴于并、冀；乘胜转攻，席卷而南，乡邑望烟而奔，城郭睹尘而溃；百姓死亡，暴骨如莽。余时年五岁，上以世方扰乱，教余学射，六岁而知射，又教余骑马；八岁而能骑射矣。以时之多（故）〔难〕，每征〔伐〕，余〔乘马〕常从。建安初，上南征荆州，至宛，张绣降，旬日而反；亡兄孝廉子修、从兄安民遇害。时余年十一岁，乘马得脱。夫文武之道，各随时而用；生于中平之季，长于戎旅之间；是以少好弓马，于今不衰；逐禽辄十里，驰射常百步；日多体健，心每不厌。建安十年，始定冀州；濊、貊贡良弓，燕、代献名马。时岁之暮春，勾芒司节，和风扇物；弓燥手柔，草浅兽肥。与族兄子丹，猎于邺西，终日手获獐鹿九，雉兔三十。后军南征次曲蠡，尚书令荀彧奉使犒军。见余，谈论之末，彧言：‘闻君善左右射，此实难能。’余言：‘执事未睹夫项发口纵，俯马蹄而仰月支也。’彧喜笑曰：‘乃尔！’余曰：‘埒有常径，的有常所；虽每发辄中，非至妙也！若驰平原，赴丰草，要狡兽，截轻禽；使弓不虚弯，所中必洞，斯则妙矣！’时军祭酒张京在坐，顾彧拊手曰：“善！”余又学击剑，阅师多矣；四方之法各异，唯京师为善。桓、灵之间，有虎贲王越，善斯术，称于京师。河南史阿，言昔与越游，具得其法；余从阿学之精熟。尝与平虏将军刘勋、奋威将军邓展等共饮。宿闻展善有手臂，晓五兵，又称其能空手入白刃。余与论剑良久，谓言：‘将军法非也！余顾尝好之，又得善术。’因求与余对。时酒酣耳热，方食甘蔗，便以为杖；下殿数交，三中其臂，左右大笑。展意不平，求更为之。余言：‘吾法急属，难相中面，故齐臂耳！’展言‘愿复一交’。余知其欲突以取交中也，因伪深进；展果寻前，余却脚鄛，正截其颡，坐中惊视。余还坐，笑曰：‘昔阳庆使淳于意去其故方，更授以秘术。今余亦愿邓将军捐弃故伎，更受要道也！’一坐尽欢。夫事不可自谓己长。余少晓持复，自谓无对；俗名双戟为‘坐铁室’，镶盾为‘蔽木户’。后从陈国袁敏学，以单攻复，每为若神，对家不知所出。先日若逢敏于狭路，直决耳！余于他戏弄之事少所喜，唯弹棋略尽其巧，少为之赋。昔京师先工有马合乡侯、东方安世、张公子，常恨不得与彼数子者对。上雅好诗书文籍，虽在军旅，手不释卷。每每定省从容，常言：‘人少好学则思专，长则善忘；长大而能勤学者，唯吾与袁伯业耳！’余是以少诵诗、论，及长而备历五经、四部，《史》、《汉》、诸子百家之言，靡不毕览。”","attribution":"裴注·典论自叙","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":521,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-2aa5d4559ce229d0d61c","start":0,"end":1160,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o009a-q","section":"chapter-001","block":"b-20c7e941eb42ee97df8c","layer":"original","quote":"初平元年春正月〖1〗，后将军袁术、冀州牧韩馥、﹝一﹞豫州刺史孔伷、﹝二﹞兖州刺史刘岱、﹝三﹞河内太守王匡、﹝四﹞勃海太守袁绍、陈留太守张邈、东郡太守桥瑁、﹝五﹞山阳太守袁遗、﹝六﹞济北相鲍信，﹝七﹞同时俱起兵〖2〗。众各数万，推绍为盟主。太祖行奋武将军〖3〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":84,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":130,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o010b-q","section":"chapter-001","block":"b-c3c5890f31591fa3c33e","layer":"original","quote":"是时。绍屯河内〖2〗，邈、岱、瑁、遗屯酸枣〖3〗，术屯南阳〖4〗，伷屯颍川，馥在邺〖5〗。卓兵强，绍等莫敢先进。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":99,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":30,"end":86,"offset_unit":"unicode_code_point"},{"id":"wudi-e-p027a-q","section":"chapter-001","block":"b-23a5b83b139d33c00b65","layer":"pei","quote":"﹝六﹞遗字伯业。绍从兄，为长安令。河间张超尝荐遗于太尉朱儁，称遗“有冠世之懿，干时之量；其忠允亮直，固天所纵。若乃包罗载籍，管综百氏；登高能赋，睹物知名；求之今日，邈焉靡俦”。事在《超集》。","attribution":"裴松之引河间张超《超集》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":95,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-faef7ba1f606d6346fa6","start":0,"end":95,"offset_unit":"unicode_code_point"},{"id":"wudi-e-p028a-q","section":"chapter-001","block":"b-b1207e1cae0a3a88c76c","layer":"pei","quote":"《英雄记》曰：“绍后用遗为扬州刺史，为袁术所败。”","attribution":"《英雄记》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":96,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-faef7ba1f606d6346fa6","start":0,"end":25,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-4a17eb75600ced2abdde","section":"chapter-001","block":"b-4a17eb75600ced2abdde","layer":"modern","quote":"〖1〗初平元年：公元 190 年。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":86,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-93d66253e23c705b336d","start":0,"end":17,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o009","section":"chapter-001","block":"b-20c7e941eb42ee97df8c","layer":"original","quote":"初平元年春正月〖1〗，后将军袁术、冀州牧韩馥、﹝一﹞豫州刺史孔伷、﹝二﹞兖州刺史刘岱、﹝三﹞河内太守王匡、﹝四﹞勃海太守袁绍、陈留太守张邈、东郡太守桥瑁、﹝五﹞山阳太守袁遗、﹝六﹞济北相鲍信，﹝七﹞同时俱起兵〖2〗。众各数万，推绍为盟主。太祖行奋武将军〖3〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":84,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":130,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o010","section":"chapter-001","block":"b-c3c5890f31591fa3c33e","layer":"original","quote":"二月，卓闻兵起，乃徙天子都长安〖1〗。卓留屯洛阳，遂焚宫室。是时。绍屯河内〖2〗，邈、岱、瑁、遗屯酸枣〖3〗，术屯南阳〖4〗，伷屯颍川，馥在邺〖5〗。卓兵强，绍等莫敢先进。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":99,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":86,"offset_unit":"unicode_code_point"},{"id":"wudi-q-p027","section":"chapter-001","block":"b-23a5b83b139d33c00b65","layer":"pei","quote":"﹝六﹞遗字伯业。绍从兄，为长安令。河间张超尝荐遗于太尉朱儁，称遗“有冠世之懿，干时之量；其忠允亮直，固天所纵。若乃包罗载籍，管综百氏；登高能赋，睹物知名；求之今日，邈焉靡俦”。事在《超集》。","attribution":"裴松之引河间张超《超集》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":95,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-faef7ba1f606d6346fa6","start":0,"end":95,"offset_unit":"unicode_code_point"},{"id":"wudi-q-p028","section":"chapter-001","block":"b-b1207e1cae0a3a88c76c","layer":"pei","quote":"《英雄记》曰：“绍后用遗为扬州刺史，为袁术所败。”","attribution":"《英雄记》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":96,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-faef7ba1f606d6346fa6","start":0,"end":25,"offset_unit":"unicode_code_point"},{"id":"wudi-q-p029","section":"chapter-001","block":"b-8dc5699e4c49a5f55b93","layer":"pei","quote":"太祖称“长大而能勤学者，惟吾与袁伯业耳”。语在文帝《典论》。","attribution":"裴松之引曹丕《典论》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":97,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-faef7ba1f606d6346fa6","start":0,"end":30,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
