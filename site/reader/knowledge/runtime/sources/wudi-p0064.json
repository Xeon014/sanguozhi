{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o009a","title":"诸军起兵推袁绍为盟主","accounts":[{"id":"wudi-e-o009a-account","label":"正文","text":"袁术、韩馥等同时起兵，各有数万众，共推袁绍为盟主；曹操行奋武将军。","evidence":["wudi-e-o009a-q"]},{"id":"dongyuan-e-o036a-account","label":"《董二袁刘传第六》正文","text":"袁绍勃海起兵讨董卓","evidence":["dongyuan-e-o036a-q"]}],"participants":[{"person":"wudi-p0057","role":"起兵","evidence":["wudi-e-o009a-q"]},{"person":"wudi-p0058","role":"起兵","evidence":["wudi-e-o009a-q"]},{"person":"wudi-p0059","role":"起兵","evidence":["wudi-e-o009a-q"]},{"person":"wudi-p0060","role":"起兵","evidence":["wudi-e-o009a-q"]},{"person":"wudi-p0061","role":"起兵","evidence":["wudi-e-o009a-q"]},{"person":"wudi-p0052","role":"受推盟主","evidence":["wudi-e-o009a-q"]},{"person":"wudi-p0062","role":"起兵","evidence":["wudi-e-o009a-q"]},{"person":"wudi-p0063","role":"起兵","evidence":["wudi-e-o009a-q"]},{"person":"wudi-p0064","role":"起兵","evidence":["wudi-e-o009a-q"]},{"person":"wudi-p0065","role":"起兵","evidence":["wudi-e-o009a-q"]},{"person":"cao-cao","role":"行奋武将军","evidence":["wudi-e-o009a-q"]}],"place":null,"time":{"label":"初平元年春正月","year":190,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o009a-q","wudi-q-o009","wudi-q-b-4a17eb75600ced2abdde"],"chronology":"wudi-y190","dating_review":{"anchor":"wudi-q-o009","basis":"初平元年春正月","reviewed":true}},"source_order":[1,85,"O009a"],"related_events":[{"event":"rensu-e2-wei016-062","type":"related","evidence":["rensu-q-f64cf1a8c7978e162aed","wudi-e-o009a-q"]}],"order":49},{"id":"wudi-e-p027a","title":"河间张超向朱儁荐袁遗","accounts":[{"id":"wudi-e-p027a-account","label":"裴松之引河间张超《超集》","text":"河间张超向太尉朱儁荐举袁遗，称赞其才量、忠直与学识。","evidence":["wudi-e-p027a-q"]}],"participants":[{"person":"wudi-p0071","role":"荐举","evidence":["wudi-e-p027a-q"]},{"person":"wudi-p0072","role":"受荐","evidence":["wudi-e-p027a-q"]},{"person":"wudi-p0064","role":"被荐","evidence":["wudi-e-p027a-q"]}],"place":null,"time