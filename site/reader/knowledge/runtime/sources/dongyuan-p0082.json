{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dongyuan-e-p038b","title":"李傕郭汜杀鲁旭周奂崔烈王颀乱兵杀吏民","accounts":[{"id":"dongyuan-e-p038b-account","label":"张璠《汉纪》","text":"李傕郭汜杀鲁旭周奂崔烈王颀乱兵杀吏民","evidence":["dongyuan-e-p038b-q"]}],"participants":[{"person":"wudi-p0089","role":"入城杀官","evidence":["dongyuan-e-p038b-q"]},{"person":"wudi-p0090","role":"入城杀官","evidence":["dongyuan-e-p038b-q"]},{"person":"dongyuan-p0081","role":"被杀","evidence":["dongyuan-e-p038b-q"]},{"person":"dongyuan-p0082","role":"被杀","evidence":["dongyuan-e-p038b-q"]},{"person":"wudi-p0026","role":"被杀","evidence":["dongyuan-e-p038b-q"]},{"person":"dongyuan-p0083","role":"被杀","evidence":["dongyuan-e-p038b-q"]}],"place":null,"time":{"label":"长安陷时及王允早仕","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-p038b-q"]},"ordering_evidence":"dongyuan-e-p038b-q","source_order":[6,141,"P038b"],"order":1557}],"persons":[{"id":"dongyuan-p0082","name":"周奂","evidence":["dongyuan-q-p038"],"facts":[],"aliases":[],"mentions":[{"id":"dongyuan-m-p038-dongyuan-p0082","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p038"]}]}],"evidence":[{"id":"dongyuan-e-p038b-q","section":"chapter-006","block":"b-8af5e76b0ed888dab0d3","layer":"pei","quote":"傕、汜入长安城，屯南宫掖门，杀太仆鲁（馗）〔旭〕、大鸿胪周奂、城门校尉崔烈、越骑校尉王颀。吏民死者不可胜数。","attribution":"张璠《汉纪》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":140,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-3cfb2aeb829267780c42","start":94,"end":148,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p038","section":"chapter-006","block":"b-8af5e76b0ed888dab0d3","layer":"pei","quote":"﹝三﹞张璠《汉纪》曰：“布兵败，驻马青琐门外。谓允曰：‘公可以去！’允曰：‘安国家，吾之上愿也；若不获，则奉身以死！朝廷幼主，恃我而已；临难苟免，吾不为也。努力！谢关东诸公，以国家为念。’傕、汜入长安城，屯南宫掖门，杀太仆鲁（馗）〔旭〕、大鸿胪周奂、城门校尉崔烈、越骑校尉王颀。吏民死者不可胜数。司徒王允挟天子，上宣平城门避兵。傕等于城门下拜，伏地叩头。帝谓傕等曰：‘卿无作威福！而乃放兵纵横，欲何为乎？’傕等曰：‘董卓忠于陛下，而无故为吕布所杀。臣等为卓报仇，弗敢为逆也！请事竟，诣廷尉，受罪。’允穷逼，出见傕；傕诛允及妻子宗族十余人。长安城中男女大小莫不流涕。允字子师，太原祁人也。少有大节，郭泰见而奇之，曰：‘王生一日千里，王佐之才也！’泰虽先达，遂与定交。三公并辟。历豫州刺史，辟荀爽、孔融为从事。迁河南尹，尚书令。及为司徒，其所以扶持王室，甚得大臣之节。自天子以下，皆倚赖焉。卓亦推信之，委以朝廷。”","attribution":"张璠《汉纪》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":140,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-3cfb2aeb829267780c42","start":0,"end":405,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
