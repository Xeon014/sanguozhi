{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o089a","title":"曹操进邺后还许留贾信","accounts":[{"id":"wudi-e-o089a-account","label":"正文","text":"曹操四月进军邺，五月回许，留贾信屯黎阳。","evidence":["wudi-e-o089a-q"]}],"participants":[{"person":"cao-cao","role":"进军回师","evidence":["wudi-e-o089a-q"]},{"person":"wudi-p0199","role":"留屯","evidence":["wudi-e-o089a-q"]}],"place":{"text":"邺、许、黎阳","evidence":["wudi-e-o089a-q"]},"time":{"label":"建安八年夏四月至五月","year":203,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o089a-q","wudi-q-o088","wudi-q-b-fa887192716200f6f3cb"],"chronology":"wudi-y203","dating_review":{"anchor":"wudi-q-o088","basis":"建安八年夏四月至五月","reviewed":true}},"source_order":[1,479,"O089a"],"order":207},{"id":"chengguo-e-p135b","title":"田银苏伯反河间贾信讨之","accounts":[{"id":"chengguo-a-dcf3f27bac5a0898cb94","label":"裴注·《魏书》","text":"田银苏伯反河间贾信讨之","evidence":["chengguo-q-e9ef9fa4cd8124a6b902"]},{"id":"yuanzhang-a-33ba57616dbc07d430a6","label":"正文","text":"田银、苏伯反河间，既破余党皆应伏法，国渊请不行刑，太祖从之，赖渊得生者千余人","evidence":["yuanzhang-q-633f2b32d3418b62af7a"]},{"id":"yuanzhang-a-e64146fce3aa046ec3d4","label":"正文","text":"破贼文书旧以一为十，国渊上首级如其实数，对太祖河间在封域之内窃耻之，太祖大悦","evidence":["yuanzhang-q-4dc80276d8d3acaff680"]}],"participants":[{"person":"xiahoucao-p0039","role":"反河间","evidence":["chengguo-q-e9ef9fa4cd8124a6b902"]},{"person":"xiahoucao-p0038","role":"反河间","evidence":["chengguo-q-e9ef9fa4cd8124a6b902"]},{"person":"wudi-p0199","role":"奉遣讨之","evidence":["chengguo-q-e9ef9fa4cd8124a6b902"]},{"person":"wendi-p0054","role":"以为余党非首恶，请不行刑；上首级如其实数，对曰征讨外寇多斩获欲大武功示民听，河间在封域之内，银等叛逆虽克捷有功窃耻之","evidence":["yuanzhang-q-633f2b32d3418b62af7a","yuanzhang-q-4dc80276d8d3acaff680"]},{"person":"cao-cao","role":"从国渊之请；问其故，大悦","evidence":["yuanzhang-q-633f2b32d3418b62af7a","yuanzhang-q-4dc80276d8d3acaff680"]}],"place":null,"time":{"label":"原文纪年见引文","precision":"undated","basis":"拆分行动分别核对；无本条直接释年，不承袭复合候选公元年。","evidence":["chengguo-q-e9ef9fa4cd8124a6b902"]},"ordering_evidence":"chengguo-q-e9ef9fa4cd8124a6b902","source_order":[14,52,27],"order":2990}],"persons":[{"id":"wudi-p0199","name":"贾信","evidence":["wudi-q-o089","chengguo-q-e9ef9fa4cd8124a6b902"],"facts":[],"aliases":[],"mentions":[{"id":"wudi-m-o089-wudi-p0199","kind":"mention","text":"文中提及","evidence":["wudi-q-o089"]}]}],"evidence":[{"id":"chengguo-q-e9ef9fa4cd8124a6b902","section":"chapter-014","block":"b-685583fef1cb76e4430b","layer":"pei","quote":"田银、苏伯等反河间，遣将军贾信讨之","attribution":"裴注·《魏书》","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":51,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-2bef09437466bf4731b4","start":27,"end":44,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o089a-q","section":"chapter-001","block":"b-998ae89932deee6878ad","layer":"original","quote":"夏四月，进军邺。五月，还许，留贾信屯黎阳。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":478,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-fa887192716200f6f3cb","section":"chapter-001","block":"b-fa887192716200f6f3cb","layer":"modern","quote":"〖2〗八年：建安八年（公元 203）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":481,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-09a0cf6c0d76993997e0","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o088","section":"chapter-001","block":"b-b55e52dce3d59a3bbee9","layer":"original","quote":"八年春三月〖2〗，攻其郭〖3〗；乃出战。击，大破之，谭、尚夜遁。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":477,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":32,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o089","section":"chapter-001","block":"b-998ae89932deee6878ad","layer":"original","quote":"夏四月，进军邺。五月，还许，留贾信屯黎阳。己酉〖4〗，令曰：“《司马法》，‘将军死绥’〖5〗。﹝一﹞故赵括之母〖6〗，乞不坐括〖7〗：是古之将者，军破于外，而家受罪于内也。自命将征行，但赏功而不罚罪，非国典也。其令诸将出征，败军者抵罪，失利者免官爵。”﹝二﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":478,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":129,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-4dc80276d8d3acaff680","section":"chapter-011","block":"b-1b7d408a2eb4b1b39cfa","layer":"original","quote":"破贼文书，旧以一为十〖8〗；及渊上首级，如其实数。太祖问其故，渊曰：“夫征讨外寇，多其斩获之数者，欲以大武功〖9〗，且示民听也〖10〗。河间，在封域之内〖11〗；银等叛逆，虽克捷有功，渊窃耻之！”太祖大悦","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":135,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":72,"end":174,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-633f2b32d3418b62af7a","section":"chapter-011","block":"b-1b7d408a2eb4b1b39cfa","layer":"original","quote":"田银、苏伯反河间；银等既破，后有余党，皆应伏法。渊以为非首恶，请不行刑，太祖从之。赖渊得生者，千余人","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":135,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":21,"end":71,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
