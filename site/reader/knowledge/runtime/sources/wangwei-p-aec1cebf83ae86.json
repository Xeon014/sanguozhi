idence":["wangwei-q-42a0386b5b10e93ac92b"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["wangwei-q-42a0386b5b10e93ac92b"]},"ordering_evidence":"wangwei-q-42a0386b5b10e93ac92b","order":4176}],"persons":[{"id":"wangwei-p-aec1cebf83ae86","name":"路粹","evidence":["wangwei-q-870a1604b79469f7b4d0","wangwei-q-1fec0f1af8e521f314a4","wangwei-q-d50add701f6528514ffa","wangwei-q-1af6c844d0e91825c111","wangwei-q-d208b4844ef242710c8f","wangwei-q-96060e44debc7de818bb","wangwei-q-42a0386b5b10e93ac92b","wangwei-q-8c783817d15313a8e4a6","wangwei-q-145ca0b6903faa8852c7"],"facts":[{"id":"wangwei-f-29df2c8f7195e7307728","text":"字文蔚，陈留人。","evidence":["wangwei-q-145ca0b6903faa8852c7"]}],"mentions":[{"id":"wangwei-m-7596f27888794a1f0a6e","kind":"mention","text":"鱼豢引韦仲将言论诸文士用世与文章","evidence":["wangwei-q-8c783817d15313a8e4a6"]}],"aliases":[]}],"evidence":[{"id":"wangwei-q-145ca0b6903faa8852c7","section":"chapter-021","block":"b-d5b0a51a480ce1371298","layer":"pei","quote":"﹝六﹞《典略》曰：“粹字文蔚。少学于蔡邕。初平中，随车驾至三辅。建安初，以高才与京兆严（像）〔象〕擢拜尚书郎。（像）〔象〕以兼有文武，出为扬州刺史。粹后为军谋祭酒，与陈琳、阮瑀等典记室。及孔融有过，太祖使粹为奏；承指数致融罪，其大略言：‘融昔在北海，见王室不宁；招合徒众，欲图不轨，言“我大圣之后也，而灭于宋。有天下者何必卯金刀”？’又云：‘融为九列，不遵朝仪，秃巾微行，唐突宫掖；又与白衣祢衡言论放荡，衡与融更相赞扬。衡谓融曰：“仲尼不死也。”融答曰：“颜渊复生。”’凡说融诸如此辈辞语甚多。融诛之后，人睹粹所作，无不嘉其才而畏其笔也。至十九年，粹转为秘书令，从大军至汉中，坐违禁贱请驴，伏法。太子素与粹善，闻其死，为之叹惜。及即帝位，特用其子为长史。”","attribution":"裴注引《典略》","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":129,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cdb5776a7cfbd5fbdd22","start":0,"end":328,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-1af6c844d0e91825c111","section":"chapter-021","block":"b-d5b0a51a480ce1371298","layer":"pei","quote":"粹后为军谋祭酒，与陈琳、阮瑀等典记室","attribution":"裴注·典略","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":129,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cdb5776a7cfbd5fbdd22","start":74,"end":92,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-1fec0f1af8e521f314a4","section":"chapter-021","block":"b-d5b0a51a480ce1371298","layer":"pei","quote":"初平中，随车驾至三辅","attribution":"裴注·典略","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":129,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cdb5776a7cfbd5fbdd22","start":21,"end":31,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-42a0386b5b10e93ac92b","section":"chapter-021","block":"b-d5b0a51a480ce1371298","layer":"pei","quote":"坐违禁贱请驴，伏法","attribution":"裴注·典略","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":129,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cdb5776a7cfbd5fbdd22","start":288,"end":297,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-870a1604b79469f7b4d0","section":"chapter-021","block":"b-d5b0a51a480ce1371298","layer":"pei","quote":"少学于蔡邕","attribution":"裴注·典略","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":129,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cdb5776a7cfbd5fbdd22","start":15,"end":20,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-8c783817d15313a8e4a6","section":"chapter-021","block":"b-ae9b0ea06dd163d3a430","layer":"pei","quote":"鱼豢曰：“寻省往者，鲁连、邹阳之徒，援譬引类，以解缔结，诚彼时文辩之俊也。今览王、繁、阮、陈、路诸人前后文旨，亦何昔不若哉？其所以不论者，时世异耳。余又窃怪其不甚见用，以问大鸿胪卿韦仲将。仲将云：‘仲宣伤于肥戆，休伯都无格检，元瑜病于体弱，孔璋实自粗疏，文蔚性颇忿鸷。’如是，彼为非徒以脂烛自煎糜也；其不高蹈，盖有由矣。然君子不责备于一人，譬之朱漆，虽无桢干，其为光泽亦壮观也。”","attribution":"裴注·鱼豢论","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":130,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cdb5776a7cfbd5fbdd22","start":0,"end":190,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-96060e44debc7de818bb","section":"chapter-021","block":"b-d5b0a51a480ce1371298","layer":"pei","quote":"至十九年，粹转为秘书令，从大军至汉中","attribution":"裴注·典略","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":129,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cdb5776a7cfbd5fbdd22","start":269,"end":287,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-d208b4844ef242710c8f","section":"chapter-021","block":"b-d5b0a51a480ce1371298","layer":"pei","quote":"及孔融有过，太祖使粹为奏；承指数致融罪，其大略言：‘融昔在北海，见王室不宁；招合徒众，欲图不轨，言“我大圣之后也，而灭于宋。有天下者何必卯金刀”？’又云：‘融为九列，不遵朝仪，秃巾微行，唐突宫掖；又与白衣祢衡言论放荡，衡与融更相赞扬。衡谓融曰：“仲尼不死也。”融答曰：“颜渊复生。”’凡说融诸如此辈辞语甚多","attribution":"裴注·典略","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":129,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cdb5776a7cfbd5fbdd22","start":93,"end":246,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-d50add701f6528514ffa","section":"chapter-021","block":"b-d5b0a51a480ce1371298","layer":"pei","quote":"建安初，以高才与京兆严（像）〔象〕擢拜尚书郎","attribution":"裴注·典略","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":129,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cdb5776a7cfbd5fbdd22","start":32,"end":54,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
