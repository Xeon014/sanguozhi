{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"shaodi-e-o173d","title":"卫瓘上报成都获璧玉印藏相国府","accounts":[{"id":"shaodi-e-o173d-account","label":"《三少帝纪》正文","text":"卫瓘上报成都获璧玉印藏相国府","evidence":["shaodi-e-o173d-q"]},{"id":"shaodi-a-p058-judgment","label":"孙盛论","text":"孙盛以公孙述起成都号成为据，推测二玉之文或出其作，语为殆，未定。","evidence":["shaodi-q-p058-judgment"]},{"id":"huowang-a-044b7ac6bf5c37f8ae65","label":"裴注·襄阳记","text":"卫瓘得璧玉印","evidence":["huowang-q-0f16df90b6f05e680a83","huowang-q2-5c1d6a5cdf1f9ce6f0c6"]},{"id":"huowang-a-5b0749fd74ce90671109","label":"裴注·襄阳记","text":"向充释成信之瑞","evidence":["huowang-q-754ccf4ce6acd1a6c792","huowang-q2-5c1d6a5cdf1f9ce6f0c6"]}],"participants":[{"person":"shaodi-p0143","role":"上报","evidence":["shaodi-e-o173d-q"]},{"person":"zhuge-p0048","role":"闻得璧玉印，引谯周之言（先帝讳备其训具、后主讳禅其训授，刘已具矣当授与人；中抚军名炎而汉年极于炎兴；瑞出成都藏相国府）谓此殆天意","evidence":["huowang-q-754ccf4ce6acd1a6c792"]}],"place":null,"time":{"year":264,"label":"六月","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"shaodi-y264","dating_review":{"reviewed":true,"anchor":"shaodi-q-o171","basis":"六月"},"evidence":["shaodi-e-o173d-q","shaodi-q-o171","shaodi-q-o165","shaodi-q-b-ded6d700dc6f860d1670"]},"ordering_evidence":"shaodi-e-o173d-q","source_order":[4,815,"O173d"],"order":1291},{"id":"huowang-e-o154","title":"向充为梓潼太守","accounts":[{"id":"huowang-a-5f0aa709940f63949114","label":"裴注·襄阳记","text":"向充为梓潼太守","evidence":["huowang-q-a1a24165cad1187d6f75"]}],"participants":[{"person":"zhuge-p0048","role":"是岁（咸熙元年）拜梓潼太守","evidence":["huowang-q-a1a24165cad1187d6f75"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["huowang-q-a1a24165cad1187d6f75"]},"ordering_evidence":"huowang-q-a1a24165cad1187d6f75","source_order":[41,66,142],"order":7401},{"id":"duzhou-e2-laizhong-xiangchong-assist-jiangwei","title":"来忠与尚书向充等协赞姜维","accounts":[{"id":"duzhou-a2-8553a108df47291ea405","label":"正文","text":"来忠与尚书向充等协赞姜维","evidence":["duzhou-q2-3aa729ef284b2ba44b04"]}],"participants":[{"person":"duzhou-p0039","role":"协赞姜维","evidence":["duzhou-q2-3aa729ef284b2ba44b04"]},{"person":"zhuge-p0048","role":"以尚书协赞姜维","evidence":["duzhou-q2-3aa729ef284b2ba44b04"]},{"person":"shaodi-p0050","role":"受来忠、向充等协赞","evidence":["duzhou-q2-3aa729ef284b2ba44b04"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"第二轮逐项审定；仅保原文时序，不另行推年。","evidence":["duzhou-q2-3aa729ef284b2ba44b04"]},"ordering_evidence":"duzhou-q2-3aa729ef284b2ba44b04","order":7525}],"persons":[{"id":"zhuge-p0048","name":"向充","evidence":["zhuge-q-p048","huowang-q-754ccf4ce6acd1a6c792","huowang-q-a1a24165cad1187d6f75","huowang-q2-7c3e85ded49f37c9d297","duzhou-q-eba375a650550ec9c371","duzhou-q2-3aa729ef284b2ba44b04"],"facts":[{"id":"huowang-f2-a9f4be1fd0e1c4cd8766","text":"向充为向宠之弟，历射声校尉、尚书。","evidence":["huowang-q2-7c3e85ded49f37c9d297"]}],"aliases":[],"mentions":[{"id":"zhuge-m-p048-zhuge-p0048","kind":"mention","text":"上表者","evidence":["zhuge-q-p048"]},{"id":"duzhou-m2-role-bb197e21ab874b125e6d","kind":"mention","text":"文中提及","evidence":["duzhou-q-eba375a650550ec9c371","duzhou-q2-3aa729ef284b2ba44b04"]}]}],"evidence":[{"id":"duzhou-q-eba375a650550ec9c371","section":"chapter-042","block":"b-77725cf91416f4c179ec","layer":"original","quote":"与尚书向充等，并能协赞大将军姜维。维善之，以为参军","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":174,"anchor":null},"note_id":null,"start":23,"end":48},{"id":"duzhou-q2-3aa729ef284b2ba44b04","section":"chapter-042","block":"b-77725cf91416f4c179ec","layer":"original","quote":"年九十七，景耀中卒。子忠，亦博览经学，有敏风。与尚书向充等，并能协赞大将军姜维。维善之，以为参军。","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":174,"anchor":null},"note_id":null,"start":0,"end":49},{"id":"huowang-q-0f16df90b6f05e680a83","section":"chapter-041","block":"b-fec186c9562152cd4da0","layer":"pei","quote":"魏咸熙元年六月，镇西将军卫瓘，至于成都，得璧、玉印各一枚，文似‘成信’字。魏人宣示百官，藏于相国府","attribution":"裴注·襄阳记","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":65,"anchor":null},"note_id":"n-5078c16e094c6d2cad41","start":11,"end":60},{"id":"huowang-q-754ccf4ce6acd1a6c792","section":"chapter-041","block":"b-fec186c9562152cd4da0","layer":"pei","quote":"充闻之曰：‘吾闻谯周之言：先帝讳备，其训具也；后主讳禅，其训授也：如言刘已具矣，当授与人也。今中抚军名炎，而汉年极于炎兴；瑞出成都，而藏之于相国府：此殆天意也！","attribution":"裴注·襄阳记","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":65,"anchor":null},"note_id":"n-5078c16e094c6d2cad41","start":61,"end":141},{"id":"huowang-q-a1a24165cad1187d6f75","section":"chapter-041","block":"b-fec186c9562152cd4da0","layer":"pei","quote":"是岁，拜充为梓潼太守","attribution":"裴注·襄阳记","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":65,"anchor":null},"note_id":"n-5078c16e094c6d2cad41","start":142,"end":152},{"id":"huowang-q2-5c1d6a5cdf1f9ce6f0c6","section":"chapter-041","block":"b-fec186c9562152cd4da0","layer":"pei","quote":"﹝五﹞《襄阳记》曰：“魏咸熙元年六月，镇西将军卫瓘，至于成都，得璧、玉印各一枚，文似‘成信’字。魏人宣示百官，藏于相国府。充闻之曰：‘吾闻谯周之言：先帝讳备，其训具也；后主讳禅，其训授也：如言刘已具矣，当授与人也。今中抚军名炎，而汉年极于炎兴；瑞出成都，而藏之于相国府：此殆天意也！’是岁，拜充为梓潼太守。明年十二月而晋武帝即尊位，‘炎兴’于是乎征焉。”","attribution":"裴注（引书见原文）","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":65,"anchor":null},"note_id":"n-5078c16e094c6d2cad41","start":0,"end":177},{"id":"huowang-q2-7c3e85ded49f37c9d297","section":"chapter-041","block":"b-1f0cc1b41ad63fd2872f","layer":"original","quote":"延熙三年，征汉嘉蛮夷，遇害〖14〗。宠弟充，历射声校尉、尚书。﹝五﹞","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":44,"anchor":null},"note_id":null,"start":0,"end":34},{"id":"shaodi-e-o173d-q","section":"chapter-004","block":"b-0d498240479dc97aa25b","layer":"original","quote":"夏五月，庚申〖14〗，相国晋王奏复五等爵〖15〗。甲戌〖16〗，改年。癸未〖17〗，追命舞阳宣文侯为晋宣王〖18〗，舞阳忠武侯为晋景王〖19〗。六月，镇西将军卫瓘，上雍州兵于成都县获璧、玉印各一〖20〗；印文似“成信”字。依周成王归禾之义〖21〗，宣示百官，藏于相国府。﹝二﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":222,"anchor":null},"note_id":null,"start":0,"end":138},{"id":"shaodi-q-b-ded6d700dc6f860d1670","section":"chapter-004","block":"b-ded6d700dc6f860d1670","layer":"modern","quote":"〖1〗四年：景元四年（公元 263）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":201,"anchor":null},"note_id":"n-ef642248e44d01f3825d","start":0,"end":19},{"id":"shaodi-q-o165","section":"chapter-004","block":"b-b35fdf03685051716720","layer":"original","quote":"四年春二月〖1〗，复命大将军进位、爵赐，一如前诏。又固辞，乃止。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":194,"anchor":null},"note_id":null,"start":0,"end":32},{"id":"shaodi-q-o171","section":"chapter-004","block":"b-cef469d41ec5962b4e48","layer":"original","quote":"咸熙元年春正月，壬戌〖1〗，槛车征邓艾〖2〗。甲子〖3〗，行幸长安。壬申〖4〗，使使者以璧币祀华山〖5〗。是月，钟会反于蜀，为众所讨。邓艾亦见杀。二月，辛卯〖6〗，特赦诸在益土者。庚申〖7〗，葬明元郭后。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":220,"anchor":null},"note_id":null,"start":0,"end":102},{"id":"shaodi-q-p058-judgment","section":"chapter-004","block":"b-b0d1cfc49b8b0f1f4a77","layer":"pei","quote":"﹝二﹞孙盛曰：“昔公孙述自以起成都，号曰‘成’。二玉之文，殆述所作也。”","attribution":"孙盛论","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":247,"anchor":null},"note_id":"n-bf3273b99ef37ddb0a62","start":0,"end":36},{"id":"zhuge-q-p048","section":"chapter-035","block":"b-9a23b750b0fd1de47c7e","layer":"pei","quote":"﹝七﹞《襄阳记》曰：“亮初亡，所在各求为立庙，朝议以礼秩不听。百姓遂因时节，私祭之于道陌上。言事者或以为‘可听立庙于成都’者，后主不从。步兵校尉习隆、中书郎向充等，共上表曰：‘臣闻周人怀召伯之德，甘棠为之不伐；越王思范蠡之功，铸金以存其像。自汉兴以来，小善小德而图形立庙者多矣；况亮德范遐迩，勋盖季世？王室之不坏，实斯人是赖；而蒸尝止于私门，庙像阙而莫立；使百姓巷祭，戎夷野祀：非所以存德念功，述追在昔者也。今若尽顺民心，则渎而无典；建之京师，又逼宗庙：此圣怀所以惟疑也。臣愚以为宜因近其墓，立之于沔阳，使所亲属以时赐祭；凡其臣故吏欲奉祠者，皆限至庙。断其私祀，以崇正礼。’于是始从之。”","attribution":"《襄阳记》","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":317,"anchor":null},"note_id":"n-fd5ed0527486e7859bd9","start":0,"end":294}],"profiles":{},"directory_counts":{}}
