{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"santizhu064-e-sr-ke-family-execution","title":"峻遣刘承追斩诸葛竦、诸葛建北走被逮、张震朱恩夷三族","accounts":[{"id":"santizhu064-a-f6572737b396a3b034eb","label":"正文","text":"恪诛，中子竦少子建车载其母而走；峻遣骑督刘承追斩竦于白都；建得渡江欲北走魏，行数十里为追兵所逮；恪外甥都乡侯张震及常侍朱恩等皆夷三族","evidence":["santizhu064-q-e406c4a86bfe598e88ee"]}],"participants":[{"person":"shaodi-p0075","role":"遣刘承追斩诸葛竦等","evidence":["santizhu064-q-e406c4a86bfe598e88ee"]},{"person":"santizhu-p0020","role":"奉命追斩诸葛竦于白都","evidence":["santizhu064-q-e406c4a86bfe598e88ee"]},{"person":"santizhu-p0203","role":"车载母走、被追斩","evidence":["santizhu064-q-e406c4a86bfe598e88ee"]},{"person":"santizhu-p0204","role":"渡江欲奔魏、为追兵所逮","evidence":["santizhu064-q-e406c4a86bfe598e88ee"]},{"person":"santizhu-p0162","role":"夷三族（诸葛恪外甥）","evidence":["santizhu064-q-e406c4a86bfe598e88ee"]},{"person":"santizhu-p0179","role":"夷三族（常侍）","evidence":["santizhu064-q-e406c4a86bfe598e88ee"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"未由相邻段落推算纪年；原文时间表达保留在来源引句中。","evidence":["santizhu064-q-e406c4a86bfe598e88ee"]},"ordering_evidence":"santizhu064-q-e406c4a86bfe598e88ee","source_order":[64,293,0],"order":10977},{"id":"santizhu064-e-sr-song-remonstrance","title":"诸葛竦数谏恪、恪不从","accounts":[{"id":"santizhu064-a-356c3f9fc4f4b22ec9b7","label":"正文","text":"竦数谏恪，恪不从，常忧惧祸","evidence":["santizhu064-q-da347b1f3f90ab3f66fa"]}],"participants":[{"person":"santizhu-p0203","role":"数谏其父","evidence":["santizhu064-q-da347b1f3f90ab3f66fa"]},{"person":"shaodi-p0041","role":"不听","evidence":["santizhu064-q-da347b1f3f90ab3f66fa"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"未由相邻段落推算纪年；原文时间表达保留在来源引句中。","evidence":["santizhu064-q-da347b1f3f90ab3f66fa"]},"ordering_evidence":"santizhu064-q-da347b1f3f90ab3f66fa","source_order":[64,307,0],"order":10979}],"persons":[{"id":"santizhu-p0203","name":"诸葛竦","evidence":["santizhu064-q-e406c4a86bfe598e88ee"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[{"id":"santizhu064-q-da347b1f3f90ab3f66fa","section":"chapter-064","block":"b-c8e7af2a75a48b4a4814","layer":"original","quote":"初，竦数谏恪，恪不从，常忧惧祸。","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":306,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":16,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-e406c4a86bfe598e88ee","section":"chapter-064","block":"b-9343dd2f9ccfaf5c1d8c","layer":"original","quote":"中子竦，长水校尉〖6〗；少子建，步兵校尉〖7〗：闻恪诛，车载其母而走。峻遣骑督刘承，追斩竦于白都〖8〗。建得渡江，欲北走魏；行数十里，为追兵所逮〖9〗。恪外甥都乡侯张震及常侍朱恩等，皆夷三族〖10〗。","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":292,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":100,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
