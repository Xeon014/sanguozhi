{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"mingdi-e-o002b","title":"荀禹发县兵举火孙权退走","accounts":[{"id":"mingdi-e-o002b-account","label":"《明帝纪》正文","text":"荀禹发县兵举火孙权退走","evidence":["mingdi-e-o002b-q"]}],"participants":[{"person":"mingdi-p0003","role":"发兵","evidence":["mingdi-e-o002b-q"]},{"person":"sun-quan","role":"退兵","evidence":["mingdi-e-o002b-q"]}],"place":{"text":"江夏","evidence":["mingdi-e-o002b-q"]},"time":{"year":226,"label":"黄初七年秋八月","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"mingdi-y226","dating_review":{"reviewed":true,"anchor":"mingdi-q-o001","basis":"黄初七年秋八月"},"evidence":["mingdi-e-o002b-q","mingdi-q-o001","mingdi-q-b-b7b4e1eced04c86a11c0"]},"ordering_evidence":"mingdi-e-o002b-q","source_order":[3,18,"O002b"],"order":708}],"persons":[{"id":"mingdi-p0003","name":"荀禹","evidence":["mingdi-q-o002"],"facts":[],"aliases":[],"mentions":[{"id":"mingdi-m-o002-mingdi-p0003","kind":"mention","text":"文中提及","evidence":["mingdi-q-o002"]}]}],"evidence":[{"id":"mingdi-e-o002b-q","section":"chapter-003","block":"b-500c15b5ba207c89e625","layer":"original","quote":"〔秋〕八月，孙权攻江夏郡〖1〗。太守文聘坚守〖2〗，朝议欲发兵救之。帝曰：“权习水战，所以敢下船陆攻者，几掩不备也〖3〗。今已与聘相持；夫攻守势倍〖4〗，终不敢久也。”先时，遣治书侍御史荀禹慰劳边方〖5〗。禹到，于江夏发所经县兵及所从步骑千人乘山举火〖6〗，权退走。辛巳〖7〗，立皇子冏为清河王。吴将诸葛瑾、张霸等寇襄阳〖8〗。抚军大将军司马宣王讨破之，斩霸。征东大将军曹休又破其别将于寻阳〖9〗。论功行赏各有差。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":17,"anchor":null},"note_id":null,"start":0,"end":207},{"id":"mingdi-q-b-b7b4e1eced04c86a11c0","section":"chapter-003","block":"b-b7b4e1eced04c86a11c0","layer":"modern","quote":"〖2〗七年：黄初七年（公元226）。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":4,"anchor":null},"note_id":"n-7290e2008f81d6cad349","start":0,"end":18},{"id":"mingdi-q-o001","section":"chapter-003","block":"b-fe69417d79b76e276a24","layer":"original","quote":"明皇帝讳叡，字元仲。文帝太子也。生而太祖爱之，常令在左右。﹝一﹞年十五，封武德侯。黄初二年为齐公。三年为平原王〖1〗。以其母诛，故未建为嗣。﹝二﹞七年夏五月〖2〗，帝病笃，乃立为皇太子。丁巳〖3〗，即皇帝位。大赦；尊皇太后曰太皇太后〖4〗，皇后曰皇太后〖5〗；诸臣封爵各有差。﹝三﹞〔六月〕，癸未〖6〗，追谥母甄夫人曰文昭皇后〖7〗。壬辰〖8〗，立皇弟蕤为阳平王〖9〗。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":1,"anchor":null},"note_id":null,"start":0,"end":185},{"id":"mingdi-q-o002","section":"chapter-003","block":"b-500c15b5ba207c89e625","layer":"original","quote":"〔秋〕八月，孙权攻江夏郡〖1〗。太守文聘坚守〖2〗，朝议欲发兵救之。帝曰：“权习水战，所以敢下船陆攻者，几掩不备也〖3〗。今已与聘相持；夫攻守势倍〖4〗，终不敢久也。”先时，遣治书侍御史荀禹慰劳边方〖5〗。禹到，于江夏发所经县兵及所从步骑千人乘山举火〖6〗，权退走。辛巳〖7〗，立皇子冏为清河王。吴将诸葛瑾、张霸等寇襄阳〖8〗。抚军大将军司马宣王讨破之，斩霸。征东大将军曹休又破其别将于寻阳〖9〗。论功行赏各有差。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":17,"anchor":null},"note_id":null,"start":0,"end":207}],"profiles":{},"directory_counts":{}}
