lepage_0109.xhtml","index":192,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-35b20a58e0364598ee58","start":183,"end":243,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-06cb38c40c30257ca0a5","section":"chapter-051","block":"b-c5f54d00c6afc536d9f8","layer":"pei","quote":"妫览、戴员亲近边鸿等，数为翊所困，常欲叛逆；因吴主出征，遂其奸计","attribution":"裴注·吴历","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":192,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-35b20a58e0364598ee58","start":10,"end":42,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-38e3831bb79e583e86b5","section":"chapter-051","block":"b-b01cfcdeadd92ea5d12f","layer":"original","quote":"会翊帐下徐元、孙高、傅婴等杀览、员","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":173,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":200,"end":217,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-5cae10fb73526a68fd7f","section":"chapter-051","block":"b-c5f54d00c6afc536d9f8","layer":"pei","quote":"到晦日，设祭；徐氏哭泣尽哀毕，乃徐服，熏香沐浴；更于他室，安施帏帐，言笑欢悦，示无戚容。大小凄怆，怪其如此。览密觇视，无复疑意","attribution":"裴注·吴历","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":192,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-35b20a58e0364598ee58","start":405,"end":468,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-6c296446abde8dae28e8","section":"chapter-051","block":"b-c5f54d00c6afc536d9f8","layer":"pei","quote":"翊以妻徐氏颇晓卜，翊入语徐：‘吾明日欲为长吏作主人，卿试卜之。’徐言：‘卦不能佳！可须异日。’翊以长吏来久，宜速遣，乃大请宾客","attribution":"裴注·吴历","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":192,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-35b20a58e0364598ee58","start":54,"end":117,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-b5917c4ae17a2c4d11ea","section":"chapter-051","block":"b-c5f54d00c6afc536d9f8","layer":"pei","quote":"吴主续至，悉族诛览、员余党；擢高、婴为牙门；其余皆加赐金帛，殊其门户","attribution":"裴注·吴历","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":192,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-35b20a58e0364598ee58","start":578,"end":612,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-b7c66ed0bd6d185d3ce7","section":"chapter-051","block":"b-c5f54d00c6afc536d9f8","layer":"pei","quote":"徐氏购募追捕，中宿乃得，览、员归罪杀鸿","attribution":"裴注·吴历","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":192,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-35b20a58e0364598ee58","start":163,"end":182,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-c9387adcb31248735ccc","section":"chapter-051","block":"b-51c9737905162f0e6527","layer":"original","quote":"后卒为左右边鸿所杀，鸿亦即诛","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":146,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":20,"end":34,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-d1a125929176ccc56336","section":"chapter-051","block":"b-c5f54d00c6afc536d9f8","layer":"pei","quote":"徐呼高、婴与诸婢罗住户内，使人报览，说：‘已除凶即吉，惟府君敕命。’览盛意入，徐出户拜。览适得一拜，徐便大呼：‘二君可起！’高、婴俱出，共得杀览；余人即就外杀员","attribution":"裴注·吴历","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":192,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-35b20a58e0364598ee58","start":469,"end":549,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-d6ff96725d7ebcf306dd","section":"chapter-051","block":"b-c5f54d00c6afc536d9f8","layer":"pei","quote":"乃密呼翊时侍养者二十余人，以徐意语之；共盟誓，合谋","attribution":"裴注·吴历","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":192,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-35b20a58e0364598ee58","start":379,"end":404,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-e0f7b97e0f4b4257d2b7","section":"chapter-051","block":"b-c5f54d00c6afc536d9f8","layer":"pei","quote":"夫人乃还缞绖，奉览、员首，以祭翊墓。举军震骇，以为神异","attribution":"裴注·吴历","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":192,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-35b20a58e0364598ee58","start":550,"end":577,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-f322729b1771bdb3ae8a","section":"chapter-051","block":"b-c5f54d00c6afc536d9f8","layer":"pei","quote":"时月垂竟，览听须祭毕。徐潜使所亲信，语翊亲近旧将孙高、傅婴等，说：‘览已虏略婢妾，今又欲见逼；所以外许之者，欲安其意以免祸耳。欲立微计，愿二君哀救！’高、婴涕泣答言：‘受府君恩遇，所以不即死难者，以死无益，欲思惟事计；事计未立，未敢启夫人耳。今日之事，实夙夜所怀也","attribution":"裴注·吴历","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":192,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-35b20a58e0364598ee58","start":245,"end":377,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-feb340e6a390f4c8beb6","section":"chapter-051","block":"b-c5f54d00c6afc536d9f8","layer":"pei","quote":"翊出入常持刀，尔时有酒色，空手送客；鸿从后斫翊，郡中扰乱，无救翊者：遂为鸿所杀，迸走入山","attribution":"裴注·吴历","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":192,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-35b20a58e0364598ee58","start":118,"end":162,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
