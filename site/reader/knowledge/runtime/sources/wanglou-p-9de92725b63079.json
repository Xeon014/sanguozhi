wanglou-q-79639098720f5807d57f","section":"chapter-065","block":"b-02f8007333cf55ae4693","layer":"pei","quote":"后除吴国内史，不就","attribution":"裴注·虞预《晋书》","section_title":"王楼贺韦华传第二十","source":{"file":"OEBPS/Text/titlepage_0137.xhtml","index":183,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5c14dbd244ed972d2326","start":325,"end":334,"offset_unit":"unicode_code_point"},{"id":"wanglou-q-baf5ecbd1cfb5dd03671","section":"chapter-065","block":"b-02f8007333cf55ae4693","layer":"pei","quote":"时朝廷初建，动有疑议；宗庙制度，皆循所定；朝野咨询，为一时儒宗","attribution":"裴注·虞预《晋书》","section_title":"王楼贺韦华传第二十","source":{"file":"OEBPS/Text/titlepage_0137.xhtml","index":183,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5c14dbd244ed972d2326","start":378,"end":409,"offset_unit":"unicode_code_point"},{"id":"wanglou-q-bcbeccf0f1e10ee69bdc","section":"chapter-065","block":"b-02f8007333cf55ae4693","layer":"pei","quote":"久之，召为太子舍人","attribution":"裴注·虞预《晋书》","section_title":"王楼贺韦华传第二十","source":{"file":"OEBPS/Text/titlepage_0137.xhtml","index":183,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5c14dbd244ed972d2326","start":238,"end":247,"offset_unit":"unicode_code_point"},{"id":"wanglou-q-bf5034f627382918f94e","section":"chapter-065","block":"b-02f8007333cf55ae4693","layer":"pei","quote":"元皇帝为镇东将军，请循为军司马。","attribution":"虞预《晋书》","section_title":"王楼贺韦华传第二十","source":{"file":"OEBPS/Text/titlepage_0137.xhtml","index":183,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5c14dbd244ed972d2326","start":335,"end":351,"offset_unit":"unicode_code_point"},{"id":"wanglou-q-d77cf55c24d8ad5760e8","section":"chapter-065","block":"b-02f8007333cf55ae4693","layer":"pei","quote":"石冰破扬州，循亦合众。事平，杜门不出","attribution":"裴注·虞预《晋书》","section_title":"王楼贺韦华传第二十","source":{"file":"OEBPS/Text/titlepage_0137.xhtml","index":183,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5c14dbd244ed972d2326","start":248,"end":266,"offset_unit":"unicode_code_point"},{"id":"wanglou-q-ea5acef1d0b0603f8c58","section":"chapter-065","block":"b-02f8007333cf55ae4693","layer":"pei","quote":"循诸所著论，并传于世","attribution":"裴注所引记载（引书见原文）","section_title":"王楼贺韦华传第二十","source":{"file":"OEBPS/Text/titlepage_0137.xhtml","index":183,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5c14dbd244ed972d2326","start":429,"end":439,"offset_unit":"unicode_code_point"},{"id":"wanglou-q-ec83894fdcced3cdbe12","section":"chapter-065","block":"b-02f8007333cf55ae4693","layer":"pei","quote":"帝为晋王，以循为中书令，固让不受。","attribution":"虞预《晋书》","section_title":"王楼贺韦华传第二十","source":{"file":"OEBPS/Text/titlepage_0137.xhtml","index":183,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5c14dbd244ed972d2326","start":351,"end":368,"offset_unit":"unicode_code_point"},{"id":"wanglou-q-face2281eabedca33a10","section":"chapter-065","block":"b-02f8007333cf55ae4693","layer":"pei","quote":"虞预《晋书》曰：“循丁家祸，流放海滨。吴平，还乡里。节操高厉，童龀不群；言行举动，必以礼让。好学博闻，尤善《三礼》。举秀才，除阳羡、武康令。顾荣、陆机、陆云表荐循曰：‘伏见吴兴武康令贺循：德量邃茂，才鉴清远；服膺道素，风操凝峻。历（践三城）〔试二城〕，刑政肃穆。守职下县，编名凡悴；出自新邦，朝无知己；恪居遐外，志不自营；年时倏忽，而邈无阶绪。实州党愚智，所为怅然！臣等并以凡才，累授饰进；被服恩泽，忝豫朝末。知良士后时，而守局无言，惧有蔽贤之咎。是以不胜愚管，谨冒死表闻。’久之，召为太子舍人。石冰破扬州，循亦合众。事平，杜门不出。陈敏作乱，以循为丹杨内史；循称疾，固辞，敏不敢逼。于时江东豪右，无不受敏爵位；惟循与（同郡）〔吴郡〕朱诞，不挂贼网。后除吴国内史，不就。元皇帝为镇东将军，请循为军司马。帝为晋王，以循为中书令，固让不受。转太常，领太子太傅。时朝廷初建，动有疑议；宗庙制度，皆循所定；朝野咨询，为一时儒宗。年六十，太兴二年卒。追赠司空，谥曰穆。循诸所著论，并传于世。子隰，临海太守。”","attribution":"虞预《晋书》","section_title":"王楼贺韦华传第二十","source":{"file":"OEBPS/Text/titlepage_0137.xhtml","index":183,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5c14dbd244ed972d2326","start":0,"end":449,"offset_unit":"unicode_code_point"},{"id":"wanglou-q-fcda108d199186581f5a","section":"chapter-065","block":"b-02f8007333cf55ae4693","layer":"pei","quote":"陈敏作乱，以循为丹杨内史；循称疾，固辞，敏不敢逼","attribution":"裴注·虞预《晋书》","section_title":"王楼贺韦华传第二十","source":{"file":"OEBPS/Text/titlepage_0137.xhtml","index":183,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5c14dbd244ed972d2326","start":267,"end":291,"offset_unit":"unicode_code_point"},{"id":"wanglou-q-ff1cb401a8473e2a0852","section":"chapter-065","block":"b-02f8007333cf55ae4693","layer":"pei","quote":"转太常，领太子太傅。","attribution":"虞预《晋书》","section_title":"王楼贺韦华传第二十","source":{"file":"OEBPS/Text/titlepage_0137.xhtml","index":183,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5c14dbd244ed972d2326","start":368,"end":378,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
