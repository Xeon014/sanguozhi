{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"shaodi-e-o176a","title":"诏奖钟会乱中抗节诸人","accounts":[{"id":"shaodi-e-o176a-account","label":"《三少帝纪》正文","text":"诏奖钟会乱中抗节诸人","evidence":["shaodi-e-o176a-q"]}],"participants":[{"person":"shaodi-p0145","role":"受封","evidence":["shaodi-e-o176a-q"]},{"person":"shaodi-p0146","role":"受封","evidence":["shaodi-e-o176a-q"]},{"person":"shaodi-p0147","role":"受封","evidence":["shaodi-e-o176a-q"]},{"person":"shaodi-p0148","role":"受封","evidence":["shaodi-e-o176a-q"]},{"person":"shaodi-p0149","role":"受任","evidence":["shaodi-e-o176a-q"]}],"place":null,"time":{"year":264,"label":"八月癸巳","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"shaodi-y264","dating_review":{"reviewed":true,"anchor":"shaodi-q-o171","basis":"八月癸巳"},"evidence":["shaodi-e-o176a-q","shaodi-q-o171","shaodi-q-o165","shaodi-q-b-ded6d700dc6f860d1670"]},"ordering_evidence":"shaodi-e-o176a-q","source_order":[4,843,"O176a"],"order":1295},{"id":"shaodi-e-o176b","title":"夏侯和羊琇朱抚拒钟会贾辅使王起告军","accounts":[{"id":"shaodi-e-o176b-account","label":"《三少帝纪》正文","text":"夏侯和羊琇朱抚拒钟会贾辅使王起告军","evidence":["shaodi-e-o176b-q"]}],"participants":[{"person":"shaodi-p0145","role":"抗命","evidence":["shaodi-e-o176b-q"]},{"person":"shaodi-p0147","role":"抗命","evidence":["shaodi-e-o176b-q"]},{"person":"shaodi-p0148","role":"抗命","evidence":["shaodi-e-o176b-q"]},{"person":"shaodi-p0146","role":"造势激军","evidence":["shaodi-e-o176b-q"]},{"person":"shaodi-p0149","role":"传言","evidence":["shaodi-e-o176b-q"]}],"place":null,"time":{"year":264,"label":"钟会反时","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"shaodi-y264","dating_review":{"reviewed":true,"anchor":"shaodi-q-o171","basis":"钟会反时"},"evidence":["shaodi-e-o176b-q","shaodi-q-o171","shaodi-q-o165","shaodi-q-b-ded6d700dc6f860d1670"]},"ordering_evidence":"shaodi-e-o176b-q","source_order":[4,843,"O176b"],"order":1296},{"id":"xiahoucao-e-o020d","title":"夏侯威惠和任州郡官","accounts":[{"id":"xiahoucao-e-o020d-account","label":"《诸夏侯曹传第九》正文","text":"夏侯威惠和任州郡官","evidence":["xiahoucao-e-o020d-q"]}],"participants":[{"person":"xiahoucao-p0021","role":"任官","evidence":["xiahoucao-e-o020d-q"]},{"person":"xiahoucao-p0022","role":"任官","evidence":["xiahoucao-e-o020d-q"]},{"person":"shaodi-p0145","role":"任官","evidence":["xiahoucao-e-o020d-q"]}],"place":null,"time":{"label":"夏侯渊死后至子孙嗣封","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xiahoucao-e-o020d-q"]},"ordering_evidence":"xiahoucao-e-o020d-q","source_order":[9,86,"O020d"],"order":2158},{"id":"xiahoucao-e-p012a","title":"夏侯和以清辩历河南尹太常","accounts":[{"id":"xiahoucao-e-p012a-account","label":"《世语》","text":"夏侯和以清辩历河南尹太常","evidence":["xiahoucao-e-p012a-q"]}],"participants":[{"person":"shaodi-p0145","role":"历官","evidence":["xiahoucao-e-p012a-q"]}],"place":null,"time":{"label":"夏侯渊子弟成长及仕官时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xiahoucao-e-p012a-q"]},"ordering_evidence":"xiahoucao-e-p012a-q","source_order":[9,105,"P012a"],"order":2169}],"persons":[{"id":"shaodi-p0145","name":"夏侯和","evidence":["shaodi-q-o176","xiahoucao-q-o020","wgc-q0130"],"facts":[{"id":"xiahoucao-f0040","label":"字","text":"义权","evidence":["xiahoucao-f0040-q"]}],"aliases":[{"text":"义权","evidence":["xiahoucao-f0040-q"]}],"mentions":[{"id":"shaodi-m-o176-shaodi-p0145","kind":"mention","text":"文中提及","evidence":["shaodi-q-o176"]},{"id":"xiahoucao-m-o020-shaodi-p0145","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-o020"]},{"id":"xiahoucao-m-p012-shaodi-p0145","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-p012"]},{"id":"wgc-m-p051-shaodi-p0145","kind":"mention","text":"本段涉及夏侯和","evidence":["wgc-q0130"]}]}],"evidence":[{"id":"shaodi-e-o176a-q","section":"chapter-004","block":"b-7b19f08b5e9157aae83d","layer":"original","quote":"癸巳〖6〗，诏曰：“前逆臣钟会，构造反乱，聚集征行将士，劫以兵威；始吐奸谋，发言桀逆〖7〗；逼胁众人，皆使下议〖8〗。仓猝之际，莫不惊慑。相国左司马夏侯和、骑士曹属朱抚，时使在成都〖9〗；中领军司马贾辅、郎中羊琇，各参会军事〖10〗。和、琇、抚，皆抗节不挠，拒会凶言；临危不顾，词旨正烈。辅语散将王起〖11〗，说‘会奸逆凶暴，欲尽杀将士’，又云‘相国已率三十万众西行讨会’；欲以称张形势〖12〗，感激众心〖13〗。起出，以辅言宣语诸军，遂使将士益怀奋励。宜加显宠，以彰忠义。其进和、辅爵为乡侯；琇、抚爵关内侯；起宣传辅言，告令将士，所宜赏异〖14〗，其以起为部曲将。”","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":250,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":284,"offset_unit":"unicode_code_point"},{"id":"shaodi-e-o176b-q","section":"chapter-004","block":"b-7b19f08b5e9157aae83d","layer":"original","quote":"癸巳〖6〗，诏曰：“前逆臣钟会，构造反乱，聚集征行将士，劫以兵威；始吐奸谋，发言桀逆〖7〗；逼胁众人，皆使下议〖8〗。仓猝之际，莫不惊慑。相国左司马夏侯和、骑士曹属朱抚，时使在成都〖9〗；中领军司马贾辅、郎中羊琇，各参会军事〖10〗。和、琇、抚，皆抗节不挠，拒会凶言；临危不顾，词旨正烈。辅语散将王起〖11〗，说‘会奸逆凶暴，欲尽杀将士’，又云‘相国已率三十万众西行讨会’；欲以称张形势〖12〗，感激众心〖13〗。起出，以辅言宣语诸军，遂使将士益怀奋励。宜加显宠，以彰忠义。其进和、辅爵为乡侯；琇、抚爵关内侯；起宣传辅言，告令将士，所宜赏异〖14〗，其以起为部曲将。”","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":250,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":284,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-b-ded6d700dc6f860d1670","section":"chapter-004","block":"b-ded6d700dc6f860d1670","layer":"modern","quote":"〖1〗四年：景元四年（公元 263）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":201,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ef642248e44d01f3825d","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o165","section":"chapter-004","block":"b-b35fdf03685051716720","layer":"original","quote":"四年春二月〖1〗，复命大将军进位、爵赐，一如前诏。又固辞，乃止。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":194,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":32,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o171","section":"chapter-004","block":"b-cef469d41ec5962b4e48","layer":"original","quote":"咸熙元年春正月，壬戌〖1〗，槛车征邓艾〖2〗。甲子〖3〗，行幸长安。壬申〖4〗，使使者以璧币祀华山〖5〗。是月，钟会反于蜀，为众所讨。邓艾亦见杀。二月，辛卯〖6〗，特赦诸在益土者。庚申〖7〗，葬明元郭后。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":220,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":102,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o176","section":"chapter-004","block":"b-7b19f08b5e9157aae83d","layer":"original","quote":"癸巳〖6〗，诏曰：“前逆臣钟会，构造反乱，聚集征行将士，劫以兵威；始吐奸谋，发言桀逆〖7〗；逼胁众人，皆使下议〖8〗。仓猝之际，莫不惊慑。相国左司马夏侯和、骑士曹属朱抚，时使在成都〖9〗；中领军司马贾辅、郎中羊琇，各参会军事〖10〗。和、琇、抚，皆抗节不挠，拒会凶言；临危不顾，词旨正烈。辅语散将王起〖11〗，说‘会奸逆凶暴，欲尽杀将士’，又云‘相国已率三十万众西行讨会’；欲以称张形势〖12〗，感激众心〖13〗。起出，以辅言宣语诸军，遂使将士益怀奋励。宜加显宠，以彰忠义。其进和、辅爵为乡侯；琇、抚爵关内侯；起宣传辅言，告令将士，所宜赏异〖14〗，其以起为部曲将。”","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":250,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":284,"offset_unit":"unicode_code_point"},{"id":"wgc-q0130","section":"chapter-028","block":"b-49dfaa2bd5b40cf13e38","layer":"pei","quote":"﹝一﹞会，时遭所生母丧。其母传曰：“夫人性矜严，明于教训；会虽童稚，勤见规诲。年四岁授《孝经》，七岁诵《论语》，八岁诵《诗》，十岁诵《尚书》，十一诵《易》，十二诵《春秋左氏传》、《国语》，十三诵《周礼》、《礼记》，十四诵成侯《易记》，十五使入太学，问四方奇文异训。谓会曰：‘学猥则倦，倦则意怠；吾惧汝之意怠，故以渐训汝，今可以独学矣。’雅好书籍，涉历众书，特好《易》、《老子》。每读《易》孔子说鸣鹤在阴、劳谦君子、籍用白茅、不出户庭之义，每使会反覆读之，曰：‘《易》三百余爻，仲尼特说此者，以谦恭慎密，枢机之发，行己至要，荣身所由故也。顺斯术以往，足为君子矣。’正始八年，会为尚书郎，夫人执会手而诲之曰：‘汝弱冠见叙。人情不能不自足，则损在其中矣，勉思其戒！’是时大将军曹爽专朝政，日纵酒沉醉。会兄侍中毓，宴还，言其事。夫人曰：‘乐则乐矣，然难久也。居上不骄，制节谨度，然后乃无危溢之患。今奢僭若此，非长守富贵之道。’嘉平元年，车驾朝高平陵，会为中书郎，从行。相国宣文侯始举兵，众人恐惧，而夫人自若。中书令刘放、侍郎卫瓘、夏侯和等家，皆怪问：‘夫人一子在危难之中，可能无忧？’答曰：‘大将军奢僭无度，吾常疑其不安。太傅义不危国，必为大将军举耳。吾儿在帝侧，何忧？闻且出兵无他重器，其势必不久战。’果如其言，一时称明。会历机密十余年，颇预政谋。夫人谓曰：‘昔范氏少子，为赵简子设伐邾之计，事从民悦，可谓功矣。然其母以为乘伪作诈，末业鄙事，必不能久。其识本深远，非近人所言，吾常乐其为人。汝居心正，吾知免矣。但当修所志，以辅益时化，不忝先人耳。常言：人谁能皆体自然？但力行不倦，抑亦其次。虽接鄙贱，必以言信。取与之间，分画分明。’或问：‘此无乃小乎？’答曰：‘君子之行，皆积小以致高大。若以小善为无益而弗为，此乃小人之事耳。希通慕大者，吾所不好。’会自幼少，衣不过青绀，亲营家事，自知恭俭；然见得思义，临财必让。会前后赐钱帛，数百万计，悉送，供公家之用，一无所取。年五十有九，甘露二年二月暴疾，薨。比葬，天子有手诏：命大将军高都侯厚加赗赠；丧事无巨细，一皆供给。议者以为：侯有夫人，有世妇，有妻，有妾，所谓外命妇也；依《春秋》成风、定姒之义，宜崇典礼，不得总称妾名；于是称‘成侯命妇’。殡葬之事，有取于古制，礼也。”","attribution":"钟会母传","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":468,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-896a85c3fec9044a28d4","start":0,"end":956,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o020d-q","section":"chapter-009","block":"b-fa4c25b726867680170c","layer":"original","quote":"霸弟威，官至兖州刺史。﹝二﹞威弟惠，乐安太守。﹝三﹞惠弟和，河南尹。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":85,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":127,"end":161,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-p012a-q","section":"chapter-009","block":"b-755fda2c549076381bd7","layer":"pei","quote":"和字义权。清辩有才论。历河南尹、太常。","attribution":"《世语》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":104,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-450ee0d5fc9818943c9d","start":10,"end":29,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-f0040-q","section":"chapter-009","block":"b-755fda2c549076381bd7","layer":"pei","quote":"和字义权","attribution":"《世语》引夏侯湛序","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":104,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-450ee0d5fc9818943c9d","start":10,"end":14,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-o020","section":"chapter-009","block":"b-fa4c25b726867680170c","layer":"original","quote":"渊妻，太祖内妹〖12〗。长子衡，尚太祖弟海阳哀侯女，恩宠特隆。衡袭爵，转封安宁亭侯。黄初中，赐中子霸；太和中，赐霸四弟爵：皆关内侯。霸，正始中为讨蜀护军、右将军〖13〗，进封博昌亭侯。素为曹爽所厚，闻爽诛，自疑，亡入蜀。以渊旧勋，赦霸子，徙乐浪郡。﹝一﹞霸弟威，官至兖州刺史。﹝二﹞威弟惠，乐安太守。﹝三﹞惠弟和，河南尹。﹝四﹞衡薨，子绩嗣，为虎贲中郎将。绩薨。子褒嗣。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":85,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":185,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-p012","section":"chapter-009","block":"b-755fda2c549076381bd7","layer":"pei","quote":"﹝四﹞《世语》曰：“和字义权。清辩有才论。历河南尹、太常。渊第三子称，第五子荣；从孙湛为其序曰：‘称字叔权。自孺子而好合聚童儿，为之渠帅。戏必为军旅战阵之事，有违者，辄严以鞭捶，众莫敢逆。渊阴奇之，使读《项羽传》及兵书，不肯，曰：“能则自为耳，安能学人！”年十六，渊与之田，见奔虎，称驱马逐之。禁之不可，一箭而倒，名闻太祖。太祖把其手喜曰：“我得汝矣！”与文帝为布衣之交。每宴会，气陵一坐，辩士不能屈。世之高名者，多从之游。年十八，卒。弟荣，字幼权。幼聪慧，七岁能属文，诵书日千言，经目辄识之。文帝闻而请焉。宾客百余人，人一奏刺；悉书其乡邑、名氏，世所谓爵里刺也。客示之，一寓目，使之遍谈，不谬一人。帝深奇之。汉中之败，荣年十三，左右提之走；不肯，曰：“君亲在难，焉所逃死！”乃奋剑而战，遂没阵。’”","attribution":"《世语》引夏侯湛序等","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":104,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-450ee0d5fc9818943c9d","start":0,"end":350,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
