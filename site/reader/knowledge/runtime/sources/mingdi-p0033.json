186c99","label":"正文","text":"东兴之役综为前锋军败身死恪斩首白庙","evidence":["chenghuang-q-6a6c8553c5614eb1ca01"]},{"id":"chenghuang-a-fe57b12b518a30474084","label":"正文","text":"东兴雪中奋短兵大破魏前屯","evidence":["chenghuang-q-1da7562bc4ca7ae07bed"]},{"id":"zhulv-a-433c35e0cba0625c4782","label":"正文","text":"魏出东兴，据赴讨有功","evidence":["zhulv-q-305b4439281ed74f2920"]},{"id":"zhulv-a-9a1f642773fb323a3b31","label":"正文","text":"是岁，魏遣胡遵、诸葛诞等出东兴；异督水军攻浮梁，坏之，魏军大破","evidence":["zhulv-q-77551a11b8ee4f203b3f"]}],"participants":[{"person":"shaodi-p0041","role":"率军赴援并于东兴交战","evidence":["santizhu-q-8812753a9ed1bf501f17"]},{"person":"wuzhu-p0056","role":"被杀的魏将","evidence":["santizhu-q-8812753a9ed1bf501f17"]},{"person":"santizhu-p0006","role":"被杀的魏将","evidence":["santizhu-q-8812753a9ed1bf501f17"]},{"person":"shaodi-p0076","role":"为前部，解甲缘遏先登","evidence":["santizhu064-q-c0aaa14c0306cbe5684d"]},{"person":"wuzhu-p0088","role":"为前部","evidence":["santizhu064-q-c0aaa14c0306cbe5684d"]},{"person":"santizhu-p0017","role":"为前部，解甲缘遏先登","evidence":["santizhu064-q-c0aaa14c0306cbe5684d"]},{"person":"hequan-p0007","role":"与丁奉建议引兵先出、破魏军、封一子亭侯","evidence":["hequan-q-ae4ded7244b535b59ef0"]},{"person":"wuzhu-p0127","role":"会至，魏军遂溃","evidence":["chenghuang-q-1da7562bc4ca7ae07bed"]},{"person":"mingdi-p0033","role":"出东兴者","evidence":["zhulv-q-77551a11b8ee4f203b3f"]},{"person":"shaodi-p0044","role":"出东兴者","evidence":["zhulv-q-77551a11b8ee4f203b3f"]},{"person":"wuzhu-p0126","role":"督水军坏浮梁者","evidence":["zhulv-q-77551a11b8ee4f203b3f"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["santizhu-q-8812753a9ed1bf501f17"]},"ordering_evidence":"santizhu-q-8812753a9ed1bf501f17","source_order":[48,7,102],"order":8433},{"id":"chenghuang-e-o152","title":"东兴诸军恃敌遁走奉独恃有以胜之","accounts":[{"id":"chenghuang-a-b2cb8d0cd3f2b299f5dd","label":"正文","text":"东兴诸军恃敌遁走奉独恃有以胜之","evidence":["chenghuang-q-7a13b19de20745857408"]}],"participants":[{"person":"santizhu-p0017","role":"为冠军将军封都亭侯、独曰不然彼动其境内悉许洛兵大举而来必有成规岂虚还哉无恃敌之不至恃吾有以胜之","evidence":["chenghuang-q-7a13b19de20745857408"]},{"person":"wuzhu-p0128","role":"即位","evidence":["chenghuang-q-7a13b19de20745857408"]},{"person":"shaodi-p0044","role":"魏遣攻东兴者","evidence":["chenghuang-q-7a13b19de20745857408"]},{"person":"mingdi-p0033","role":"同攻东兴者","evidence":["chenghuang-q-7a13b19de20745857408"]},{"person":"shaodi-p0041","role":"率军拒之、太傅","evidence":["chenghuang-q-7a13b19de20745857408"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["chenghuang-q-7a13b19de20745857408"]},"ordering_evidence":"chenghuang-q-7a13b19de20745857408","source_order":[55,356,0],"order":9928},{"id":"santizhu064-e-r-wei-two-forts","title":"魏命遵诞攻两坞","accounts":[{"id":"santizhu064-a-39137037a00ec17743cd","label":"正文","text":"魏命遵诞攻两坞","evidence":["santizhu064-q-064f3457585e34cc69dd"]}],"participants":[{"person":"shaodi-p0044","role":"奉命同率军攻围两坞","evidence":["santizhu064-q-064f3457585e34cc69dd"]},{"person":"mingdi-p0033","role":"奉命率众七万攻围两坞图坏堤遏","evidence":["santizhu064-q-064f3457585e34cc69dd"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达保留在来源引句，不推算公元年。","evidence":["santizhu064-q-064f3457585e34cc69dd"]},"ordering_evidence":"santizhu064-q-064f3457585e34cc69dd","source_order":[64,164,0],"order":10952}],"persons":[{"id":"mingdi-p0033","name":"胡遵","evidence":["mingdi-q-o034","shaodi-q-o054","wgc-q0019","wgc-q0135","santizhu-q-3849530ef85a92119548","gongsuntao-q-e3fec8c86ee2b2833d01","chenghuang-q-7a13b19de20745857408","liusima-q-cd82892baa6f03578c78","zhulv-q-77551a11b8ee4f203b3f","wangwei-q-2dec248518364c080053","wangwei-q-42fae39620cbf1ba4dee"],"facts":[],"aliases":[],"mentions":[{"id":"mingdi-m-o034-mingdi-p0033","kind":"mention","text":"文中提及","evidence":["mingdi-q-o034"]},{"id":"shaodi-m-o054-mingdi-p0033","kind":"mention","text":"文中提及","evidence":["shaodi-q-o054"]},{"id":"shaodi-m-o075-mingdi-p0033","kind":"mention","text":"文中提及","evidence":["shaodi-q-o075"]},{"id":"shaodi-m-o114-mingdi-p0033","kind":"mention","text":"文中提及","evidence":["shaodi-q-o114"]},{"id":"wgc-m-o022-mingdi-p0033","kind":"mention","text":"本段涉及胡遵","evidence":["wgc-q0019"]},{"id":"wgc-m-p059-mingdi-p0033","kind":"mention","text":"本段涉及胡遵","evidence":["wgc-q0135"]}]}],"evidence":[{"id":"chenghuang-q-1da7562bc4ca7ae07bed","section":"chapter-055","block":"b-f6550e25d92fd67b6b52","layer":"original","quote":"天寒，雪，敌诸将置酒高会。奉见其前部兵少，相谓曰：“取封侯爵赏，正在今日！”乃使兵解铠著胄，持短兵〖7〗。敌人从而笑焉，不为设备。奉纵兵斫之，大破敌前屯；会据等至，魏军遂溃。迁灭寇将军〖8〗，进封都（亭）〔乡〕侯","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":356,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":106,"offset_unit":"unicode_code_point"},{"id":"chenghuang-q-6a6c8553c5614eb1ca01","section":"chapter-055","block":"b-87fe2456927ad072130b","layer":"original","quote":"东兴之役〖15〗，综为前锋，军败身死。诸葛恪斩送其首，以白权庙","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":59,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":26,"end":57,"offset_unit":"unicode_code_point"},{"id":"chenghuang-q-7a13b19de20745857408","section":"chapter-055","block":"b-876b9e224f245867d86d","layer":"original","quote":"孙亮即位，为冠军将军〖2〗，封都亭侯。魏遣诸葛诞、胡遵等攻东兴，诸葛恪率军拒之。诸将皆曰：“敌闻太傅自来，上岸必遁走。”奉独曰：“不然！彼动其境内，悉许、洛兵大举而来，必有成规：岂虚还哉！无恃敌之不至〖3〗，恃吾有以胜之","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":355,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":110,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-e3fec8c86ee2b2833d01","section":"chapter-008","block":"b-06ac13b16bffe709f1db","layer":"original","quote":"渊遣将军卑衍、杨祚等步骑数万，屯辽隧，围堑二十余里。宣王军至，令衍逆战；宣王遣将军胡遵等击破之","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":197,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":28,"end":75,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-e8b684e5536221fcbf67","section":"chapter-008","block":"b-8f153d99654b721331a4","layer":"modern","quote":"〖9〗二年：景初二年（公元 238）。","attribution":"现代注释","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":208,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-96754c72076d8b3fb368","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"hequan-q-ae4ded7244b535b59ef0","section":"chapter-060","block":"b-6c5f593279f7e62e0019","layer":"pei","quote":"东关之役，绪与丁奉，建议引兵先出；以破魏军，封一子亭侯","attribution":"裴注·《吴书》","section_title":"贺全吕周钟离传第十五","source":{"file":"OEBPS/Text/titlepage_0127.xhtml","index":159,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-745969b04e6140fa105c","start":49,"end":76,"offset_unit":"unicode_code_point"},{"id":"liusima-q-cd82892baa6f03578c78","section":"chapter-015","block":"b-f47115d2b1aa6550f308","layer":"original","quote":"其所礼辟：扶风庞延、天水杨阜、安定胡遵、酒泉庞淯，敦煌张恭、周生烈等，终皆有名位","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":182,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":13,"end":53,"offset_unit":"unicode_code_point"},{"id":"mingdi-e-o034a-q","section":"chapter-003","block":"b-95dd799f2af7548409aa","layer":"original","quote":"秋九月，安定保塞匈奴大人胡薄居姿职等，叛；司马宣王遣将军胡遵等追讨〖19〗，破降之。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":214,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":42,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-b-7a11c761ca65aeb3d195","section":"chapter-003","block":"b-7a11c761ca65aeb3d195","layer":"modern","quote":"〖1〗二年：青龙二年（公元 234）。己未：旧历初四日。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":252,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6c0753fe684a18a3a281","start":0,"end":28,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-o030","section":"chapter-003","block":"b-cb99fef1996d806deb1c","layer":"original","quote":"青龙元年春正月，甲申〖1〗，青龙现郏之摩陂井中〖2〗。二月，丁酉〖3〗，幸摩陂观龙。于是改年，改摩陂为龙陂。赐男子爵，人二级；鳏寡孤独。无出今年租赋。三月，甲子〖4〗，诏公卿举贤良、笃行之士。各一人。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":210,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":100,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-o034","section":"chapter-003","block":"b-95dd799f2af7548409aa","layer":"original","quote":"秋九月，安定保塞匈奴大人胡薄居姿职等，叛；司马宣王遣将军胡遵等追讨〖19〗，破降之。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":214,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":42,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-o037","section":"chapter-003","block":"b-ff97c2d326d0fc08a9de","layer":"original","quote":"二年春二月，（乙）〔己〕未〖1〗，太白犯荧惑。癸酉〖2〗，诏曰：“‘鞭作官刑〖3〗’，所以纠慢怠也〖4〗；而顷多以无辜死。其减鞭杖之制〖5〗，著于令。”三月，庚寅〖6〗，山阳公薨；帝素服发哀〖7〗，遣使持节，典护丧事。己酉〖8〗，大赦。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":249,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":118,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-3849530ef85a92119548","section":"chapter-048","block":"b-9b3f5181b40c2019f20c","layer":"original","quote":"魏使将军诸葛诞、胡遵等步骑七万围东兴〖9〗","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":14,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":61,"end":82,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-8812753a9ed1bf501f17","section":"chapter-048","block":"b-9b3f5181b40c2019f20c","layer":"original","quote":"甲寅〖11〗，恪以大兵赴敌。戊午〖12〗，兵及东兴，交战；大破魏军，杀将军韩综、桓嘉等","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":14,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":102,"end":145,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-064f3457585e34cc69dd","section":"chapter-064","block":"b-7386ca4b171095d46488","layer":"original","quote":"魏以吴军入其疆土，耻于受侮；命大将胡遵、诸葛诞等率众七万〖4〗，欲攻围两坞，图坏堤遏","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":163,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":42,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-c0aaa14c0306cbe5684d","section":"chapter-064","block":"b-d3196146b5b40af27868","layer":"original","quote":"恪兴军四万，晨夜赴救。遵等敕其诸军：作浮桥渡，阵于堤上〖6〗，分兵攻两城。城在高峻，不可猝拔。恪遣将军留赞、吕据、唐咨、丁奉为前部。时天寒，雪，魏诸将会饮。见赞等兵少，而解置铠甲，不持矛戟；但兜鍪刀盾〖7〗，裸身缘遏〖8〗：大笑之，不即严兵〖9〗。兵得上，便鼓噪乱斫〖10〗。魏军惊扰散走，争渡浮桥；桥坏绝，自投于水，更相蹈藉。乐安太守桓嘉等，同时并没〖11〗，死者数万。故叛将韩综为魏前军督〖12〗，亦斩之。获车乘牛、马、驴、骡各数千，资器山积，振旅而归〖13〗。","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":164,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":233,"offset_unit":"unicode_code_point"},{"id":"shaodi-e-o054a-q","section":"chapter-004","block":"b-aa16c067e880a0a5a64a","layer":"original","quote":"冬十一月，诏征南大将军王昶、征东将军胡遵、镇南将军毌丘俭等，征吴。十二月，吴大将军诸葛恪拒战〖20〗，大破众军于东关〖21〗。不利而还。﹝二﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":212,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":71,"offset_unit":"unicode_code_point"},{"id":"shaodi-e-o075a-q","section":"chapter-004","block":"b-e2428af475340334d623","layer":"original","quote":"秋七月，以征东大将军胡遵为卫将军，镇东大将军诸葛诞为征东大将军。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":335,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":32,"offset_unit":"unicode_code_point"},{"id":"shaodi-e-o114a-q","section":"chapter-004","block":"b-47547c7b85d100bcaf9f","layer":"original","quote":"秋七月，己卯〖5〗，卫将军胡遵薨。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":507,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":17,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-b-20272e7cc5379b3fe346","section":"chapter-004","block":"b-20272e7cc5379b3fe346","layer":"modern","quote":"〖17〗四年：嘉平四年（公元252）。癸卯：旧历初二日。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":230,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-db96ad991a403b6a010e","start":0,"end":28,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-b-2de9ea37d1e15a7d296f","section":"chapter-004","block":"b-2de9ea37d1e15a7d296f","layer":"modern","quote":"〖6〗二年：正元二年（公元 255）。乙丑：旧历十二日。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":346,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-96103ace1e11ae4131ba","start":0,"end":28,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-b-6209c552405e0ebbdf98","section":"chapter-004","block":"b-6209c552405e0ebbdf98","layer":"modern","quote":"〖1〗二年：甘露二年（公元 257 ）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":535,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4dd98e402a6a8de51491","start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o052","section":"chapter-004","block":"b-944c76689fd8a3e8fa86","layer":"original","quote":"四年春正月，癸卯〖17〗，以抚军大将军司马景王为大将军。二月，立皇后张氏〖18〗，大赦。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":210,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":44,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o054","section":"chapter-004","block":"b-aa16c067e880a0a5a64a","layer":"original","quote":"冬十一月，诏征南大将军王昶、征东将军胡遵、镇南将军毌丘俭等，征吴。十二月，吴大将军诸葛恪拒战〖20〗，大破众军于东关〖21〗。不利而还。﹝二﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":212,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":71,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o072","section":"chapter-004","block":"b-4b9070779d1c209c6814","layer":"original","quote":"二年春正月，乙丑〖6〗，镇东将军毌丘俭、扬州刺史文钦反。（戊戌）〔戊寅〕〖7〗，大将军司马景王征之。癸未〖8〗，车骑将军郭淮薨。闰月，己亥〖9〗，破钦于乐嘉〖10〗；钦遁走，遂奔吴。甲辰〖11〗，安风淮津都尉斩俭〖12〗，传首京都。﹝一﹞壬子〖13〗，复特赦淮南士民诸为俭、钦所诖误者〖14〗。以镇南将军诸葛诞为镇东大将军〖15〗。司马景王薨于许昌。二月，丁巳〖16〗，以卫将军司马文王为大将军〖17〗，录尚书事。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":332,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":207,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o075","section":"chapter-004","block":"b-e2428af475340334d623","layer":"original","quote":"秋七月，以征东大将军胡遵为卫将军，镇东大将军诸葛诞为征东大将军。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":335,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":32,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o080","section":"chapter-004","block":"b-5e69a7d6a960c6ff6623","layer":"original","quote":"甘露元年春正月辛丑〖1〗，青龙现轵县井中〖2〗。乙巳〖3〗，沛王林薨〖4〗。﹝一﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":386,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":41,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o114","section":"chapter-004","block":"b-47547c7b85d100bcaf9f","layer":"original","quote":"秋七月，己卯〖5〗，卫将军胡遵薨。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":507,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":17,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o117","section":"chapter-004","block":"b-d021e0b00f489a01f208","layer":"original","quote":"二年春二月〖1〗，青龙现温县井中。三月，司空卢毓薨。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":522,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":26,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-2dec248518364c080053","section":"chapter-021","block":"b-40db16cbc0a5788fa626","layer":"pei","quote":"征南大将军王昶、征东将军胡遵、镇南将军毌丘俭等表请征吴","attribution":"裴注·司马彪《战略》","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":521,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-95568ac79fb311f2266b","start":44,"end":71,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-42fae39620cbf1ba4dee","section":"chapter-021","block":"b-40db16cbc0a5788fa626","layer":"pei","quote":"其年十一月，诏昶等征吴","attribution":"裴注·司马彪《战略》","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":521,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-95568ac79fb311f2266b","start":1106,"end":1117,"offset_unit":"unicode_code_point"},{"id":"wgc-q0019","section":"chapter-028","block":"b-a7edad975718e7be6c83","layer":"original","quote":"大将军统中外军，讨之；别使诸葛诞督豫州诸军，从安风津拟寿春〖1〗，征东将军胡遵督青、徐诸军出于谯、宋之间〖2〗，绝其归路。大将军屯汝阳〖3〗，使监军王基督前锋诸军据南顿以待之〖4〗。令诸军皆坚壁勿与战。俭、钦进不得斗，退恐寿春见袭，不得归，计穷不知所为。淮南将士，家皆在北，众心沮散，降者相属，惟淮南新附农民为之用。大将军遣兖州刺史邓艾督泰山诸军万余人至乐嘉〖5〗，示弱以诱之，大将军寻自（洙）〔汝阳〕至。钦不知，果夜来欲袭艾等；会明，见大军兵马盛，乃引还。﹝一﹞","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":121,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":232,"offset_unit":"unicode_code_point"},{"id":"wgc-q0135","section":"chapter-028","block":"b-a344b1173e6856a98116","layer":"pei","quote":"﹝四﹞《晋诸公赞》曰：“胡烈儿名渊，字世元。遵之孙也。遵，安定人，以才兼文武，累居藩镇，至车骑将军。子奋，字玄威。亦历方任。女为晋武帝贵人，有宠。太康中，以奋为尚书仆射，加镇军大将军，开府。弟广，字宣祖，少府；次烈，字玄武，秦州刺史；次岐，字玄嶷，并州刺史。广子喜，凉州刺史。渊小字鹞鸱。时年十八，既杀会救父，名震远近。后赵王伦篡位，三王兴义，伦使渊与张泓，将兵御齐王，屡破齐军。会成都战克，渊乃归降，伏法。”","attribution":"晋诸公赞","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":593,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-7dfa0827333ec78b2b0e","start":0,"end":205,"offset_unit":"unicode_code_point"},{"id":"wgc-q0228","section":"chapter-028","block":"b-a7edad975718e7be6c83","layer":"original","quote":"别使诸葛诞督豫州诸军，从安风津拟寿春〖1〗，征东将军胡遵督青、徐诸军出于谯、宋之间〖2〗，绝其归路","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":121,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":11,"end":60,"offset_unit":"unicode_code_point"},{"id":"wgc-q0699","section":"chapter-028","block":"b-a344b1173e6856a98116","layer":"pei","quote":"遵，安定人，以才兼文武，累居藩镇，至车骑将军。","attribution":"晋诸公赞","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":593,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-7dfa0827333ec78b2b0e","start":27,"end":50,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-305b4439281ed74f2920","section":"chapter-056","block":"b-604767dbf5853a5d004b","layer":"original","quote":"魏出东兴，据赴讨有功","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":199,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":10,"end":20,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-77551a11b8ee4f203b3f","section":"chapter-056","block":"b-abd659c367dbc19a7af5","layer":"original","quote":"是岁，魏遣胡遵、诸葛诞等出东兴。异督水军攻浮梁〖6〗，坏之，魏军大破","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":285,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":11,"end":45,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
