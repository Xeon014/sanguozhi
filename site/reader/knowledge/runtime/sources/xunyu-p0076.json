kind":"mention","text":"文中提及","evidence":["xunyu-q-o035"]},{"id":"dongyuan-m-o010-xunyu-p0076","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o010"]},{"id":"dongyuan-m-o035-xunyu-p0076","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o035"]},{"id":"dongyuan-m-p019-xunyu-p0076","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p019"]},{"id":"dongyuan-m-p021-xunyu-p0076","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p021"]}]}],"evidence":[{"id":"dongyuan-e-o010a-q","section":"chapter-006","block":"b-ce439e218b8e8adda84d","layer":"original","quote":"初，卓信任尚书周毖、城门校尉伍琼等。用其所举韩馥、刘岱、孔伷、张（资）〔咨〕、张邈等出宰州郡〖8〗；","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":57,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":50,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-o010b-q","section":"chapter-006","block":"b-ce439e218b8e8adda84d","layer":"original","quote":"而馥等至官，皆合兵将以讨卓。卓闻之，以为毖、琼等通情卖己，皆斩之。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":57,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":50,"end":83,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-o035a-q","section":"chapter-006","block":"b-274eb213f46bac4967b9","layer":"original","quote":"绍既出，遂亡奔冀州。侍中周毖、城门校尉伍琼、议郎何颙等，皆名士也；卓信之。而阴为绍，乃说卓曰：“夫废立大事，非常人所及。绍不达大体，恐惧，故出奔，非有他志也。今购之急〖3〗，势必为变。袁氏树恩四世，门生故吏遍于天下〖4〗；若收豪杰以聚徒众，英雄因之而起，则山东非公之有也。不如赦之，拜一郡守；则绍喜于免罪，必无患矣。”卓以为然，乃拜绍勃海太守，封邟乡侯。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":220,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":177,"offset_unit":"unicode_code_point"},{"id":"dongyuan-f0015-q","section":"chapter-006","block":"b-0b6c7236206397f025fc","layer":"pei","quote":"琼字德瑜","attribution":"《英雄记》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":70,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-02d5fe58c20ace23ce6f","start":20,"end":24,"offset_unit":"unicode_code_point"},{"id":"dongyuan-f0016-q","section":"chapter-006","block":"b-0b6c7236206397f025fc","layer":"pei","quote":"汝南人","attribution":"《英雄记》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":70,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-02d5fe58c20ace23ce6f","start":25,"end":28,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o010","section":"chapter-006","block":"b-ce439e218b8e8adda84d","layer":"original","quote":"初，卓信任尚书周毖、城门校尉伍琼等。用其所举韩馥、刘岱、孔伷、张（资）〔咨〕、张邈等出宰州郡〖8〗；而馥等至官，皆合兵将以讨卓。卓闻之，以为毖、琼等通情卖己，皆斩之。﹝二﹞","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":57,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":86,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o035","section":"chapter-006","block":"b-274eb213f46bac4967b9","layer":"original","quote":"绍既出，遂亡奔冀州。侍中周毖、城门校尉伍琼、议郎何颙等，皆名士也；卓信之。而阴为绍，乃说卓曰：“夫废立大事，非常人所及。绍不达大体，恐惧，故出奔，非有他志也。今购之急〖3〗，势必为变。袁氏树恩四世，门生故吏遍于天下〖4〗；若收豪杰以聚徒众，英雄因之而起，则山东非公之有也。不如赦之，拜一郡守；则绍喜于免罪，必无患矣。”卓以为然，乃拜绍勃海太守，封邟乡侯。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":220,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":177,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p019","section":"chapter-006","block":"b-0b6c7236206397f025fc","layer":"pei","quote":"﹝二﹞《英雄记》曰：“毖字仲远，武威人。琼字德瑜，汝南人。”","attribution":"《英雄记》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":70,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-02d5fe58c20ace23ce6f","start":0,"end":30,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p021","section":"chapter-006","block":"b-b39b4f511a1546cebf6d","layer":"pei","quote":"谢承记孚字及本郡，则与琼同；而致死事乃与孚异也。不知孚为琼之别名？为别有伍孚也？盖未详之。","attribution":"裴松之按","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":72,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-02d5fe58c20ace23ce6f","start":0,"end":45,"offset_unit":"unicode_code_point"},{"id":"rensu-q-c21e8c32e233b8003b27","section":"chapter-016","block":"b-0ec29c53f32db50fc2e0","layer":"original","quote":"浑兄泰，与荀攸等谋诛董卓","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":315,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":44,"end":56,"offset_unit":"unicode_code_point"},{"id":"xunyu-e-o035b-q","section":"chapter-010","block":"b-a71a6145f32bc39dc4a6","layer":"original","quote":"董卓之乱，关东兵起，卓徙都长安。攸与议郎郑泰、何颙，侍中种辑，越骑校尉伍琼等谋曰〖3〗：“董卓无道，甚于桀、纣，天下皆怨之；虽资强兵〖4〗，实一匹夫耳！今直刺杀之，以谢百姓；然后据殽、函〖5〗，辅王命，以号令天下。此桓、文之举也。”事垂就而觉，收颙、攸系狱；颙忧惧自杀，﹝三﹞攸言语饮食自若。会卓死，得免。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":192,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":27,"end":180,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-o035","section":"chapter-010","block":"b-a71a6145f32bc39dc4a6","layer":"original","quote":"何进秉政，征海内名士攸等，二十余人；攸到，拜黄门侍郎。董卓之乱，关东兵起，卓徙都长安。攸与议郎郑泰、何颙，侍中种辑，越骑校尉伍琼等谋曰〖3〗：“董卓无道，甚于桀、纣，天下皆怨之；虽资强兵〖4〗，实一匹夫耳！今直刺杀之，以谢百姓；然后据殽、函〖5〗，辅王命，以号令天下。此桓、文之举也。”事垂就而觉，收颙、攸系狱；颙忧惧自杀，﹝三﹞攸言语饮食自若。会卓死，得免。﹝四﹞","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":192,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":183,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-p037-judgment","section":"chapter-010","block":"b-51e04de8f5d89ce7b7e7","layer":"pei","quote":"﹝四﹞《魏书》云“攸使人说卓，得免”，与此不同。","attribution":"《魏书》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":206,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-d0ad75dc84a584928116","start":0,"end":24,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
