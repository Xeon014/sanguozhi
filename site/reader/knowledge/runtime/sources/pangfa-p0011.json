:60,"anchor":null},"note_id":"n-dd047ad6e712f7bc0280","start":67,"end":88},{"id":"pangfa-q-p008","section":"chapter-037","block":"b-a7cdca521d62a556dc9f","layer":"pei","quote":"﹝二﹞《襄阳记》曰：“林妇，同郡习祯妹。祯事在杨戏《辅臣赞》。曹公之破荆州，林妇与林分隔，守养弱女十有余年。后林随黄权降魏，始复集聚。魏文帝闻而贤之，赐床帐衣服，以显其义节。”","attribution":"《襄阳记》","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":60,"anchor":null},"note_id":"n-dd047ad6e712f7bc0280","start":0,"end":88}],"profiles":{},"directory_counts":{}}
