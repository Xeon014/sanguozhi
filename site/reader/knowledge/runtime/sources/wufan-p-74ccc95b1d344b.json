itlepage_0133.xhtml","index":109,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a0bd07c10a0db1fefc47","start":0,"end":170,"offset_unit":"unicode_code_point"},{"id":"wufan-q-dc11370bb6388ab252cf","section":"chapter-063","block":"b-914eb0282e241c66943d","layer":"pei","quote":"曹不兴善画","attribution":"裴注所引记载（引书见原文）","section_title":"吴范刘惇赵达传第十八","source":{"file":"OEBPS/Text/titlepage_0133.xhtml","index":109,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a0bd07c10a0db1fefc47","start":98,"end":103,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
