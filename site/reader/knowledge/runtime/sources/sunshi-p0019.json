ering_evidence":"sunshi-e-p011a-q","source_order":[46,124,"P011a"],"order":8037},{"id":"sunshi-e-p011b","title":"曹寅畏王叡欲杀而伪温毅檄令孙坚诛王叡","accounts":[{"id":"sunshi-e-p011b-account","label":"《吴录》","text":"曹寅畏王叡欲杀而伪温毅檄令孙坚诛王叡","evidence":["sunshi-e-p011b-q"]}],"participants":[{"person":"sunshi-p0025","role":"伪檄","evidence":["sunshi-e-p011b-q"]},{"person":"sunshi-p0019","role":"扬言","evidence":["sunshi-e-p011b-q"]},{"person":"wudi-p0119","role":"奉伪檄","evidence":["sunshi-e-p011b-q"]}],"place":null,"time":{"label":"讨董卓起兵时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["sunshi-e-p011b-q"]},"ordering_evidence":"sunshi-e-p011b-q","source_order":[46,124,"P011b"],"order":8038}],"persons":[{"id":"sunshi-p0019","name":"王叡","evidence":["sunshi-q-o012","dongyuan-q-o080","liuermu-q-c9cf721c54bfb8d7dc5c"],"facts":[{"id":"sunshi-f0005","label":"字","text":"通耀","evidence":["sunshi-f0005-q"]},{"id":"sunshi-f0006","label":"亲属","text":"晋太保王祥伯父","evidence":["sunshi-f0006-q"]}],"aliases":[{"text":"通耀","evidence":["sunshi-f0005-q"]}],"mentions":[{"id":"sunshi-m-o012-sunshi-p0019","kind":"mention","text":"文中提及","evidence":["sunshi-q-o012"]},{"id":"sunshi-m-p010-sunshi-p0019","kind":"mention","text":"文中提及","evidence":["sunshi-q-p010"]},{"id":"sunshi-m-p011-sunshi-p0019","kind":"mention","text":"文中提及","evidence":["sunshi-q-p011"]},{"id":"dongyuan-m-o080-sunshi-p0019","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o080"]}]}],"evidence":[{"id":"dongyuan-e-o080a-q","section":"chapter-006","block":"b-3c9a56ae7ad5e62f153a","layer":"original","quote":"以大将军掾为北军中候〖3〗。灵帝崩，代王叡为荆州刺史〖4〗。是时山东兵起，表亦合兵军襄阳〖5〗。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":450,"anchor":null},"note_id":null,"start":0,"end":48},{"id":"dongyuan-q-o080","section":"chapter-006","block":"b-3c9a56ae7ad5e62f153a","layer":"original","quote":"以大将军掾为北军中候〖3〗。灵帝崩，代王叡为荆州刺史〖4〗。是时山东兵起，表亦合兵军襄阳〖5〗。﹝二﹞袁术之在南阳也，与孙坚合从，欲袭夺表州，使坚攻表。坚为流矢所中死，军败；术遂不能胜表。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":450,"anchor":null},"note_id":null,"start":0,"end":94},{"id":"liuermu-q-8315a133b941ab1a2d92","section":"chapter-031","block":"b-5dbcefbca77c48f941dc","layer":"pei","quote":"然后刘表为荆州","attribution":"裴注·注家按语","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":33,"anchor":null},"note_id":"n-fd307a7978039f12ea65","start":24,"end":31},{"id":"liuermu-q-c9cf721c54bfb8d7dc5c","section":"chapter-031","block":"b-5dbcefbca77c48f941dc","layer":"pei","quote":"孙坚杀荆州刺史王叡","attribution":"裴注·注家按语","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":33,"anchor":null},"note_id":"n-fd307a7978039f12ea65","start":14,"end":23},{"id":"sunshi-e-o012a-q","section":"chapter-046","block":"b-84cf62d2b7cd8fe12d65","layer":"original","quote":"灵帝崩〖1〗，卓擅朝政，横恣京城。诸州郡并兴义兵，欲以讨卓。﹝一﹞坚亦举兵。荆州刺史王叡，素遇坚无礼〖2〗；坚过，杀之。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":81,"anchor":null},"note_id":null,"start":0,"end":60},{"id":"sunshi-e-p011a-q","section":"chapter-046","block":"b-4e09d555f66d0ea609bc","layer":"pei","quote":"叡先与坚共击零、桂贼，以坚武官，言颇轻之。","attribution":"《吴录》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":123,"anchor":null},"note_id":"n-1c3a6f7b42da18d32bae","start":7,"end":28},{"id":"sunshi-e-p011b-q","section":"chapter-046","block":"b-4e09d555f66d0ea609bc","layer":"pei","quote":"及叡举兵，欲讨卓；素与武陵太守曹寅不相能，扬言当先杀寅。寅惧，诈作按行使者、光禄大夫温毅檄，移坚；说叡罪过，令收，行刑讫，以状上。","attribution":"《吴录》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":123,"anchor":null},"note_id":"n-1c3a6f7b42da18d32bae","start":28,"end":93},{"id":"sunshi-e-p011c-q","section":"chapter-046","block":"b-4e09d555f66d0ea609bc","layer":"pei","quote":"坚即承檄勒兵，袭叡。叡闻兵至，登楼望之；遣问：‘欲何为？’坚前部答曰：‘兵久战劳苦，所得赏，不足以为衣服。诣使君，更乞资直耳！’叡曰：‘刺史岂有所吝！’便开库藏，使自入视之，知有所遗不。兵进及楼下，叡见坚，惊曰：‘兵自求赏，孙府君何以在其中？’坚曰：‘被使者檄，诛君！’叡曰：‘我何罪？’坚曰：‘坐无所知！’叡穷迫，刮金饮之而死。","attribution":"《吴录》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":123,"anchor":null},"note_id":"n-1c3a6f7b42da18d32bae","start":93,"end":258},{"id":"sunshi-f0005-q","section":"chapter-046","block":"b-ed3db13017b81a546e70","layer":"pei","quote":"叡，字通耀","attribution":"裴松之按《王氏谱》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":122,"anchor":null},"note_id":"n-1c3a6f7b42da18d32bae","start":10,"end":15},{"id":"sunshi-f0006-q","section":"chapter-046","block":"b-ed3db13017b81a546e70","layer":"pei","quote":"晋太保祥伯父也","attribution":"裴松之按《王氏谱》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":122,"anchor":null},"note_id":"n-1c3a6f7b42da18d32bae","start":16,"end":23},{"id":"sunshi-q-o012","section":"chapter-046","block":"b-84cf62d2b7cd8fe12d65","layer":"original","quote":"灵帝崩〖1〗，卓擅朝政，横恣京城。诸州郡并兴义兵，欲以讨卓。﹝一﹞坚亦举兵。荆州刺史王叡，素遇坚无礼〖2〗；坚过，杀之。﹝二﹞比至南阳〖3〗，众数万人。南阳太守张咨闻军至，晏然自若。﹝三﹞坚以牛酒礼咨〖4〗。咨明日，亦答诣坚〖5〗。酒酣，长沙主簿入白坚〖6〗：“前移南阳〖7〗，而道路不治，军资不具〖8〗；请收主簿，推问意故〖9〗！”咨大惧，欲去；兵陈四周，不得出。有顷〖10〗，主簿复入白坚：“南阳太守稽停义兵，使贼不时讨；请收出，按军法从事〖11〗！”便牵咨于军门斩之〖12〗。郡中震栗，无求不获。﹝四﹞","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":81,"anchor":null},"note_id":null,"start":0,"end":254},{"id":"sunshi-q-p010","section":"chapter-046","block":"b-ed3db13017b81a546e70","layer":"pei","quote":"﹝二﹞按《王氏谱》：叡，字通耀。晋太保祥伯父也。","attribution":"裴松之按《王氏谱》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":122,"anchor":null},"note_id":"n-1c3a6f7b42da18d32bae","start":0,"end":24},{"id":"sunshi-q-p011","section":"chapter-046","block":"b-4e09d555f66d0ea609bc","layer":"pei","quote":"《吴录》曰：“叡先与坚共击零、桂贼，以坚武官，言颇轻之。及叡举兵，欲讨卓；素与武陵太守曹寅不相能，扬言当先杀寅。寅惧，诈作按行使者、光禄大夫温毅檄，移坚；说叡罪过，令收，行刑讫，以状上。坚即承檄勒兵，袭叡。叡闻兵至，登楼望之；遣问：‘欲何为？’坚前部答曰：‘兵久战劳苦，所得赏，不足以为衣服。诣使君，更乞资直耳！’叡曰：‘刺史岂有所吝！’便开库藏，使自入视之，知有所遗不。兵进及楼下，叡见坚，惊曰：‘兵自求赏，孙府君何以在其中？’坚曰：‘被使者檄，诛君！’叡曰：‘我何罪？’坚曰：‘坐无所知！’叡穷迫，刮金饮之而死。”","attribution":"《吴录》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":123,"anchor":null},"note_id":"n-1c3a6f7b42da18d32bae","start":0,"end":259}],"profiles":{},"directory_counts":{}}
