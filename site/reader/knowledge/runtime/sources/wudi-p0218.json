dence":["wudi-q-p070","dongyuan-q-o040"],"facts":[{"id":"dongyuan-f0029","label":"籍贯","text":"广平","evidence":["dongyuan-f0029-q"]}],"aliases":[],"mentions":[{"id":"wudi-m-p070-wudi-p0218","kind":"mention","text":"文中提及","evidence":["wudi-q-p070"]},{"id":"dongyuan-m-o040-wudi-p0218","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o040"]},{"id":"dongyuan-m-o044-wudi-p0218","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o044"]},{"id":"dongyuan-m-o048-wudi-p0218","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o048"]},{"id":"dongyuan-m-o049-wudi-p0218","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o049"]},{"id":"dongyuan-m-o051-wudi-p0218","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o051"]},{"id":"dongyuan-m-o052-wudi-p0218","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o052"]},{"id":"dongyuan-m-p064-wudi-p0218","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p064"]},{"id":"dongyuan-m-p070-wudi-p0218","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p070"]},{"id":"dongyuan-m-p075-wudi-p0218","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p075"]},{"id":"dongyuan-m-p077-wudi-p0218","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p077"]},{"id":"dongyuan-m-p080-wudi-p0218","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p080"]},{"id":"dongyuan-m-p081-wudi-p0218","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p081"]},{"id":"dongyuan-m-p084-wudi-p0218","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p084"]},{"id":"dongyuan-m-p086-wudi-p0218","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p086"]}]}],"evidence":[{"id":"dongyuan-e-o040a-q","section":"chapter-006","block":"b-d1dc27b2f8ddd7223f4f","layer":"original","quote":"绍遂领冀州牧。从事沮授说绍曰：“将军弱冠登朝〖1〗，则播名海内；值废立之际，则忠义奋发；单骑出奔，则董卓怀怖；济河而北，则勃海稽首〖2〗。振一郡之卒〖3〗，撮冀州之众；威震河朔〖4〗，名重天下。虽黄巾猾乱〖5〗，黑山跋扈；举军东向，则青州可定；还讨黑山，则张燕可灭；回众北首〖6〗，则公孙必丧；震胁戎狄，则匈奴必从。横大河之北〖7〗，合四州之地〖8〗；收英雄之才，拥百万之众；迎大驾于西京〖9〗，复宗庙于洛邑〖10〗；号令天下，以讨未复〖11〗。以此争锋，谁能敌之！比及数年，此功不难。”绍喜曰：“此吾心也！”即表授为监军、奋威将军〖12〗。﹝一﹞","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":249,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":274,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-o044b-q","section":"chapter-006","block":"b-9378127fbfcbf250d81d","layer":"original","quote":"出长子谭为青州，沮授谏绍：“必为祸始。”绍不听，曰：“孤欲令诸儿各据一州也。”﹝四﹞又以中子熙为幽州，甥高幹为并州，","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":278,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":20,"end":78,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-o048a-q","section":"chapter-006","block":"b-839daef927a1c0dd9463","layer":"original","quote":"绍进军黎阳，遣颜良攻刘延于白马。沮授又谏绍：“良性促狭〖1〗，虽骁勇，不可独任！”绍不听。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":306,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":45,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-o049a-q","section":"chapter-006","block":"b-672b6b442dcef88537ba","layer":"original","quote":"太祖还官渡。沮授又曰：“北兵数众而果劲不及南〖3〗，南谷虚少而货财不及北；南利在于急战，北利在于缓搏：宜徐持久，旷以日月〖4〗。”绍不从。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":307,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":69,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-o051a-q","section":"chapter-006","block":"b-c11903f59e2abda470f6","layer":"original","quote":"太祖与绍相持日久，百姓疲乏，多叛应绍，军食乏。会绍遣淳于琼等，将兵万余人，北迎运车；沮授说绍：“可遣将蒋奇，别为支军于表〖7〗，以断曹公之抄。”绍复不从。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":309,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":77,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-o052b-q","section":"chapter-006","block":"b-43c272f7e21f12a6ee2b","layer":"original","quote":"沮授不及绍渡，为人所执；诣太祖，﹝五﹞太祖厚待之。后谋还袁氏，见杀。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":310,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":48,"end":82,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p064a-q","section":"chapter-006","block":"b-872172974dbe86704555","layer":"pei","quote":"沮授，广平人。少有大志，多权略。仕州别驾，举茂才，历二县令；又为韩馥别驾，表拜骑都尉。袁绍得冀州，又辟焉。","attribution":"《献帝纪》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":271,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fbe17cf9b3bfd4706379","start":16,"end":69,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p070a-q","section":"chapter-006","block":"b-f788287ac55fa0fa37e8","layer":"pei","quote":"﹝一﹞《献帝传》曰：“沮授说绍云：‘将军累叶辅弼，世济忠义。今朝廷播越，宗庙毁坏。观诸州郡，外托义兵，内图相灭，未有存主恤民者。且今州城粗定，宜迎大驾，安宫邺都；挟天子而令诸侯，畜士马以讨不庭：谁能御之！’绍悦，将从之。郭图、淳于琼曰：‘汉室陵迟，为日久矣；今欲兴之，不亦难乎？且今英雄据有州郡，众动万计；所谓秦失其鹿，先得者王。若迎天子以自近，动辄表闻；从之则权轻，违之则拒命：非计之善者也。’授曰：‘今迎朝廷，至义也；又于时宜，大计也。若不早图，必有先人者也。夫权不失机，功在速捷，将军其图之！’绍弗能用。”","attribution":"《献帝传》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":288,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1c5f3bd8be343c161b14","start":0,"end":256,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p075a-q","section":"chapter-006","block":"b-f39003f8dec6806c0da9","layer":"pei","quote":"授谏辞曰：‘世称一兔走衢，万人逐之；一人获之，贪者悉止：分定故也。且年均以贤，德均则卜，古之制也。愿上惟先代成败之戒，下思逐兔分定之义。’绍曰：‘孤欲令四儿各据一州，以观其能。’授出曰：‘祸其始此乎？’","attribution":"《九州春秋》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":293,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-06a13297a618ccaa32fd","start":12,"end":113,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p077a-q","section":"chapter-006","block":"b-a3494accaa682ca8b6b8","layer":"pei","quote":"绍将南师，沮授、田丰谏曰：‘师出历年，百姓疲弊；仓庾无积，赋役方殷：此国之深忧也。宜先遣使献捷天子，务农逸民。若不得通，乃表曹氏隔我王路。然后进屯黎阳，渐营河南；益作舟船，缮治器械；分遣精骑，抄其边鄙；令彼不得安，我取其逸。三年之中，事可坐定也！’审配、郭图曰：‘兵书之法：十围，五攻，敌则能战。今以明公之神武，跨河朔之强众，以伐曹氏，譬若覆手；今不时取，后难图也！’授曰：‘盖救乱诛暴，谓之义兵；恃众凭强，谓之骄兵：兵义无敌，骄者先灭。曹氏迎天子安宫许都，今举兵南向，于义则违。且庙胜之策，不在强弱。曹氏法令既行，士卒精练，非公孙瓒坐受围者也。今弃万安之术，而兴无名之兵，窃为公惧之！’图等曰：‘武王伐纣，不曰不义；况兵加曹氏，而云无名！且公师武臣竭力，将士愤怒，人思自骋；而不及时早定大业，虑之失也。夫天与弗取，反受其咎；此越之所以霸，吴之所以亡也。监军之计，计在持牢，而非见时知机之变也！’绍从之。","attribution":"《献帝传》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":295,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f9b297d2a3b3d9e09127","start":8,"end":410,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p077b-q","section":"chapter-006","block":"b-a3494accaa682ca8b6b8","layer":"pei","quote":"图等因是谮授：‘监统内外，威震三军；若其浸盛，何以制之？夫臣与主不同者昌，主与臣同者亡，此《黄石》之所忌也。且御众于外，不宜知内。’绍疑焉，乃分监军为三都督，使授及郭图、淳于琼各典一军；遂合而南。","attribution":"《献帝传》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":295,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f9b297d2a3b3d9e09127","start":410,"end":508,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p080a-q","section":"chapter-006","block":"b-19448e3777e61bdfc1ed","layer":"pei","quote":"﹝一﹞《献帝传》曰：“绍临发，沮授会其宗族，散资财以与之曰：‘夫势在则威无不加，势亡则不保一身。哀哉！’其弟宗曰：‘曹公士马不敌，君何惧焉？’授曰：‘以曹兖州之明略，又挟天子以为资；我虽克公孙，众实疲弊，而将骄主忲。军之破败，在此举也。扬雄有言，“六国蚩蚩，为羸弱姬”，今之谓也！’”","attribution":"《献帝传》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":331,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4b5ee82e53d12ebab59f","start":0,"end":142,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p081a-q","section":"chapter-006","block":"b-3983be0b9153ad2fe653","layer":"pei","quote":"﹝二﹞《献帝传》曰：“绍将济河，沮授谏曰：‘胜负变化，不可不详。今宜留屯延津，分兵官渡：若其克获，还迎不晚；设其有难，众弗可还。’绍弗从。授临济叹曰：‘上盈其志，下务其功；悠悠黄河，吾其不反乎！’遂以疾辞。绍恨之，乃省其所部兵，属郭图。”","attribution":"《献帝传》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":332,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-2dd06a580c6e0907df4f","start":0,"end":119,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p084a-q","section":"chapter-006","block":"b-5083be0be119fd3b818a","layer":"pei","quote":"﹝五﹞《献帝传》云：“授大呼曰：‘授不降也，为军所执耳！’太祖与之有旧，逆谓授曰：‘分野殊异，遂用圮绝；不图今日，乃相擒也！’授对曰：‘冀州失策，以取奔北。授智力俱困，宜其见擒耳。’太祖曰：‘本初无谋，不用君计。今丧乱过纪，国家未定，当相与图之。’授曰：‘叔父、母、弟，悬命袁氏；若蒙公灵，速死为福。’太祖叹曰：‘孤早相得，天下不足虑！’”","attribution":"《献帝传》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":335,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-dfd32419f8839c61ad81","start":0,"end":170,"offset_unit":"unicode_code_point"},{"id":"dongyuan-f0029-q","section":"chapter-006","block":"b-872172974dbe86704555","layer":"pei","quote":"沮授，广平人","attribution":"《献帝纪》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":271,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fbe17cf9b3bfd4706379","start":16,"end":22,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o040","section":"chapter-006","block":"b-d1dc27b2f8ddd7223f4f","layer":"original","quote":"绍遂领冀州牧。从事沮授说绍曰：“将军弱冠登朝〖1〗，则播名海内；值废立之际，则忠义奋发；单骑出奔，则董卓怀怖；济河而北，则勃海稽首〖2〗。振一郡之卒〖3〗，撮冀州之众；威震河朔〖4〗，名重天下。虽黄巾猾乱〖5〗，黑山跋扈；举军东向，则青州可定；还讨黑山，则张燕可灭；回众北首〖6〗，则公孙必丧；震胁戎狄，则匈奴必从。横大河之北〖7〗，合四州之地〖8〗；收英雄之才，拥百万之众；迎大驾于西京〖9〗，复宗庙于洛邑〖10〗；号令天下，以讨未复〖11〗。以此争锋，谁能敌之！比及数年，此功不难。”绍喜曰：“此吾心也！”即表授为监军、奋威将军〖12〗。﹝一﹞","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":249,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":274,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o044","section":"chapter-006","block":"b-9378127fbfcbf250d81d","layer":"original","quote":"顷之，击破瓒于易京〖4〗，并其众。﹝三﹞出长子谭为青州，沮授谏绍：“必为祸始。”绍不听，曰：“孤欲令诸儿各据一州也。”﹝四﹞又以中子熙为幽州，甥高幹为并州，众数十万。以审配、逢纪统军事〖5〗；田丰、荀谌、许攸为谋主〖6〗；颜良、文丑为将率；简精卒十万〖7〗，骑万匹，将攻许。﹝五﹞","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":278,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":140,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o046","section":"chapter-006","block":"b-c25c6aad78e1f784d5f8","layer":"original","quote":"建安五年，太祖自东征备〖1〗。田丰说绍，袭太祖后〖2〗；绍辞以子疾，不许〖3〗。丰举杖击地曰：“夫遭难遇之机，而以婴儿之病失其会。惜哉！”","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":297,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":69,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o048","section":"chapter-006","block":"b-839daef927a1c0dd9463","layer":"original","quote":"绍进军黎阳，遣颜良攻刘延于白马。沮授又谏绍：“良性促狭〖1〗，虽骁勇，不可独任！”绍不听。太祖救延，与良战，破斩良。﹝一﹞绍渡河，壁延津南〖2〗；使刘备、文丑挑战。太祖击破之，斩丑。再战，擒绍大将，绍军大震。﹝二﹞","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":306,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":107,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o049","section":"chapter-006","block":"b-672b6b442dcef88537ba","layer":"original","quote":"太祖还官渡。沮授又曰：“北兵数众而果劲不及南〖3〗，南谷虚少而货财不及北；南利在于急战，北利在于缓搏：宜徐持久，旷以日月〖4〗。”绍不从。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":307,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":69,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o051","section":"chapter-006","block":"b-c11903f59e2abda470f6","layer":"original","quote":"太祖与绍相持日久，百姓疲乏，多叛应绍，军食乏。会绍遣淳于琼等，将兵万余人，北迎运车；沮授说绍：“可遣将蒋奇，别为支军于表〖7〗，以断曹公之抄。”绍复不从。琼宿乌巢〖8〗，去绍军四十里。太祖乃留曹洪守，自将步骑五千，候夜潜往攻琼。绍遣骑救之，败走。破琼等，悉斩之。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":309,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":131,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o052","section":"chapter-006","block":"b-43c272f7e21f12a6ee2b","layer":"original","quote":"太祖还，未至营；绍将高览、张郃等率其众降。绍众大溃。绍与谭，单骑退渡河。余众伪降，尽坑之。﹝四﹞沮授不及绍渡，为人所执；诣太祖，﹝五﹞太祖厚待之。后谋还袁氏，见杀。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":310,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":82,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p064","section":"chapter-006","block":"b-872172974dbe86704555","layer":"pei","quote":"沮授，广平人。少有大志，多权略。仕州别驾，举茂才，历二县令；又为韩馥别驾，表拜骑都尉。袁绍得冀州，又辟焉。","attribution":"《献帝纪》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":271,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fbe17cf9b3bfd4706379","start":16,"end":69,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p070","section":"chapter-006","block":"b-f788287ac55fa0fa37e8","layer":"pei","quote":"﹝一﹞《献帝传》曰：“沮授说绍云：‘将军累叶辅弼，世济忠义。今朝廷播越，宗庙毁坏。观诸州郡，外托义兵，内图相灭，未有存主恤民者。且今州城粗定，宜迎大驾，安宫邺都；挟天子而令诸侯，畜士马以讨不庭：谁能御之！’绍悦，将从之。郭图、淳于琼曰：‘汉室陵迟，为日久矣；今欲兴之，不亦难乎？且今英雄据有州郡，众动万计；所谓秦失其鹿，先得者王。若迎天子以自近，动辄表闻；从之则权轻，违之则拒命：非计之善者也。’授曰：‘今迎朝廷，至义也；又于时宜，大计也。若不早图，必有先人者也。夫权不失机，功在速捷，将军其图之！’绍弗能用。”","attribution":"《献帝传》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":288,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1c5f3bd8be343c161b14","start":0,"end":256,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p071-judgment","section":"chapter-006","block":"b-19646086a63e95e8273a","layer":"pei","quote":"按此书称郭图之计，则与本传违也。","attribution":"裴松之按","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":289,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1c5f3bd8be343c161b14","start":0,"end":16,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p075","section":"chapter-006","block":"b-f39003f8dec6806c0da9","layer":"pei","quote":"﹝四﹞《九州春秋》载：“授谏辞曰：‘世称一兔走衢，万人逐之；一人获之，贪者悉止：分定故也。且年均以贤，德均则卜，古之制也。愿上惟先代成败之戒，下思逐兔分定之义。’绍曰：‘孤欲令四儿各据一州，以观其能。’授出曰：‘祸其始此乎？’谭始至青州，为都督，未为刺史；后太祖拜为刺史。其土自河而西，盖不过平原而已。遂北排田楷，东攻孔融，曜兵海隅。是时百姓无主，欣戴之矣。然信用群小，好受近言；肆志奢淫，不知稼穑之艰难。华彦、孔顺，皆奸佞小人也，信以为腹心；王修等备官而已。然能接待宾客，慕名敬士。使妇弟领兵在内，至令草窃市井而外，虏掠田野。别使两将募兵下县，有赂者见免，无者见取；贫弱者多，乃至于窜伏丘野之中，放兵捕索，如猎鸟兽。邑有万户者，著籍不盈数百；收赋纳税，三分不入一。招命贤士，不就；不趋赴军期，安居族党，亦不能罪也。”","attribution":"《九州春秋》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":293,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-06a13297a618ccaa32fd","start":0,"end":359,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p077","section":"chapter-006","block":"b-a3494accaa682ca8b6b8","layer":"pei","quote":"《献帝传》曰：“绍将南师，沮授、田丰谏曰：‘师出历年，百姓疲弊；仓庾无积，赋役方殷：此国之深忧也。宜先遣使献捷天子，务农逸民。若不得通，乃表曹氏隔我王路。然后进屯黎阳，渐营河南；益作舟船，缮治器械；分遣精骑，抄其边鄙；令彼不得安，我取其逸。三年之中，事可坐定也！’审配、郭图曰：‘兵书之法：十围，五攻，敌则能战。今以明公之神武，跨河朔之强众，以伐曹氏，譬若覆手；今不时取，后难图也！’授曰：‘盖救乱诛暴，谓之义兵；恃众凭强，谓之骄兵：兵义无敌，骄者先灭。曹氏迎天子安宫许都，今举兵南向，于义则违。且庙胜之策，不在强弱。曹氏法令既行，士卒精练，非公孙瓒坐受围者也。今弃万安之术，而兴无名之兵，窃为公惧之！’图等曰：‘武王伐纣，不曰不义；况兵加曹氏，而云无名！且公师武臣竭力，将士愤怒，人思自骋；而不及时早定大业，虑之失也。夫天与弗取，反受其咎；此越之所以霸，吴之所以亡也。监军之计，计在持牢，而非见时知机之变也！’绍从之。图等因是谮授：‘监统内外，威震三军；若其浸盛，何以制之？夫臣与主不同者昌，主与臣同者亡，此《黄石》之所忌也。且御众于外，不宜知内。’绍疑焉，乃分监军为三都督，使授及郭图、淳于琼各典一军；遂合而南。”","attribution":"《献帝传》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":295,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f9b297d2a3b3d9e09127","start":0,"end":509,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p080","section":"chapter-006","block":"b-19448e3777e61bdfc1ed","layer":"pei","quote":"﹝一﹞《献帝传》曰：“绍临发，沮授会其宗族，散资财以与之曰：‘夫势在则威无不加，势亡则不保一身。哀哉！’其弟宗曰：‘曹公士马不敌，君何惧焉？’授曰：‘以曹兖州之明略，又挟天子以为资；我虽克公孙，众实疲弊，而将骄主忲。军之破败，在此举也。扬雄有言，“六国蚩蚩，为羸弱姬”，今之谓也！’”","attribution":"《献帝传》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":331,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4b5ee82e53d12ebab59f","start":0,"end":142,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p081","section":"chapter-006","block":"b-3983be0b9153ad2fe653","layer":"pei","quote":"﹝二﹞《献帝传》曰：“绍将济河，沮授谏曰：‘胜负变化，不可不详。今宜留屯延津，分兵官渡：若其克获，还迎不晚；设其有难，众弗可还。’绍弗从。授临济叹曰：‘上盈其志，下务其功；悠悠黄河，吾其不反乎！’遂以疾辞。绍恨之，乃省其所部兵，属郭图。”","attribution":"《献帝传》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":332,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-2dd06a580c6e0907df4f","start":0,"end":119,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p084","section":"chapter-006","block":"b-5083be0be119fd3b818a","layer":"pei","quote":"﹝五﹞《献帝传》云：“授大呼曰：‘授不降也，为军所执耳！’太祖与之有旧，逆谓授曰：‘分野殊异，遂用圮绝；不图今日，乃相擒也！’授对曰：‘冀州失策，以取奔北。授智力俱困，宜其见擒耳。’太祖曰：‘本初无谋，不用君计。今丧乱过纪，国家未定，当相与图之。’授曰：‘叔父、母、弟，悬命袁氏；若蒙公灵，速死为福。’太祖叹曰：‘孤早相得，天下不足虑！’”","attribution":"《献帝传》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":335,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-dfd32419f8839c61ad81","start":0,"end":170,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p086","section":"chapter-006","block":"b-43dc1ea8833c9c774b2c","layer":"pei","quote":"孙盛曰：“观田丰、沮授之谋，虽良、平何以过之！故君贵审才，臣尚量主。君用忠良，则伯王之业隆；臣奉暗后，则覆亡之祸至。存亡荣辱，常必由兹。丰知绍将败，败则己必死，甘冒虎口以尽忠规；烈士之于所事，虑不存己。夫诸侯之臣，义有去就，况丰与绍非纯臣乎？《诗》云‘逝将去汝，适彼乐土’，言去乱邦，就有道，可也。”","attribution":"孙盛论","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":337,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-247ea57f2666f37d6b34","start":0,"end":150,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-o034","section":"chapter-046","block":"b-8480cc17db549540a4f6","layer":"original","quote":"建安五年，曹公与袁绍相拒于官渡〖1〗。策阴欲袭许〖2〗，迎汉帝〖3〗；﹝一﹞密治兵，部署诸将。未发，会为故吴郡太守许贡客所杀〖4〗。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":260,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":66,"offset_unit":"unicode_code_point"},{"id":"wudi-q-p070","section":"chapter-001","block":"b-8869edfb3c9b7cf5a19f","layer":"pei","quote":"﹝一﹞沮，音菹，河朔间今犹有此姓。鹄，沮授子也。","attribution":"裴松之音释与家世说明","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":529,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-bdb119d00051944cff7f","start":0,"end":24,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o004","section":"chapter-047","block":"b-d714325f2e71e77ac236","layer":"original","quote":"五年〖2〗，策薨，以事授权；权哭，未及息，策长史张昭谓权曰：“孝廉！此宁哭时邪〖3〗？且周公立法，而伯禽不师〖4〗；非欲违父，时不得行也〖5〗。﹝一﹞况今奸宄竞逐〖6〗，豺狼满道；乃欲哀亲戚，顾礼制；是犹开门而揖盗〖7〗，未可以为仁也！”乃改易权服〖8〗，扶令上马，使出巡军。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":16,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":138,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-p009","section":"chapter-009","block":"b-94b2d845b1656ec51166","layer":"pei","quote":"﹝一﹞《魏略》曰：“霸字仲权。渊为蜀所害，故霸常切齿，欲有报蜀意。黄初中，为偏将军。子午之役，霸召为前锋；进至兴势围，安营在曲谷中。蜀人望知其是霸也，指下兵攻之。霸手战鹿角间，赖救至，然后解。后为右将军，屯陇西。其养士、和戎，并得其欢心。至正始中，代夏侯儒为征蜀护军，统属征西：时征西将军夏侯玄，于霸为从子；而玄于曹爽为外弟。及司马宣王诛曹爽，遂召玄，玄来东。霸闻曹爽被诛而玄又征，以为祸必转相及，心既内恐；又霸先与雍州刺史郭淮不和，而淮代玄为征西；霸尤不安，故遂奔蜀。南趋阴平而失道，入穷谷中。粮尽，杀马步行。足破，卧岩石上；使人求道，未知何之。蜀闻之，乃使人迎霸。初，建安五年，时霸从妹，年十三四，在本郡。出行樵采，为张飞所得。飞知其良家女，遂以为妻；产息女，为刘禅皇后。故渊之初亡，飞妻请而葬之。及霸入蜀，禅与相见，释之曰：‘卿父自遇害于行间耳，非我先人之手刃也。’指其儿子以示之曰：‘此夏侯氏之甥也。’厚加爵宠。”","attribution":"《魏略》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":101,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-25ffcef69065f027e431","start":0,"end":411,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-b-3c961618b484f81c3582","section":"chapter-010","block":"b-3c961618b484f81c3582","layer":"modern","quote":"〖3〗五年：建安五年（公元 200）。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":115,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-3bbb3ef01ba77a895b2f","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-o020","section":"chapter-010","block":"b-ae8147f907358950d8ac","layer":"original","quote":"五年〖3〗，与绍连战。太祖保官渡，绍围之；太祖军粮方尽，书与彧，议欲还许，以引绍〖4〗。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":110,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":44,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
