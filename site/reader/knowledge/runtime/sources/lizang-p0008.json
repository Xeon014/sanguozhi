age_0041.xhtml","index":50,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":199,"end":211,"offset_unit":"unicode_code_point"},{"id":"lizang-q-ca51688a7a4a03dcbd2b","section":"chapter-018","block":"b-22069ccbcac65cf41bb1","layer":"original","quote":"抚其余众，群贼乃平","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":109,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":118,"end":127,"offset_unit":"unicode_code_point"},{"id":"lizang-q-cb52498d713d9737fa3a","section":"chapter-018","block":"b-22069ccbcac65cf41bb1","layer":"original","quote":"襄（陵）〔贲〕校尉杜松部民炅母等作乱〖2〗，与昌豨通","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":109,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":38,"end":64,"offset_unit":"unicode_code_point"},{"id":"lizang-q2-a646bea50e3148058dbb","section":"chapter-018","block":"b-7f00dd453cbf141fb4cb","layer":"original","quote":"文帝即王位，加裨将军，封益寿亭侯。迁徐州刺史，加威虏将军〖11〗。请琅邪王祥为别驾，民事一以委之；世多其能任贤〖12〗。﹝一﹞讨利城叛贼，斩获有功。","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":111,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":74,"offset_unit":"unicode_code_point"},{"id":"lizang-q2-e78b41bd00f1f1d208f7","section":"chapter-018","block":"b-4dde5c044e8226170b94","layer":"original","quote":"明帝即位，徙封万年亭侯；增邑二百，并前六百户。虔薨，子翻嗣。翻薨，子桂嗣。","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":112,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":37,"offset_unit":"unicode_code_point"},{"id":"lizang-q2-f277a5429c9527fb9eba","section":"chapter-018","block":"b-e466cc235aee33d5b553","layer":"original","quote":"太祖以虔领泰山太守，郡接山海，世乱；闻，民人多藏窜。袁绍所置中郎将郭祖、公孙犊等数十辈，保山为寇：百姓苦之。虔将家兵到郡，开恩信〖4〗；祖等党属皆降服，诸山中亡匿者尽出安土业〖5〗。简其强者补战士，泰山由是遂有精兵，冠名州郡。济南黄巾徐和等，所在劫长吏〖6〗，攻城邑。虔引兵与夏侯渊会击之；前后数十战，斩首获生数千人。太祖使督青州诸郡兵，以讨东莱群贼李条等，有功。太祖令曰：“夫有其志，必成其事，盖烈士之所徇也〖7〗。卿在郡以来，擒奸讨暴，百姓获安；躬蹈矢石〖8〗，所征辄克。昔寇恂立名于汝、颍〖9〗，耿弇建策于青、兖〖10〗：古今一也。”举茂才，加骑都尉，典郡如故。虔在泰山十数年，甚有威惠。","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":110,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":297,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o012c-q","section":"chapter-009","block":"b-594aafbe9f825ff421de","layer":"original","quote":"济南、乐安黄巾徐和、司马俱等攻城〖5〗，杀长吏。渊将泰山、齐、平原郡兵击〖6〗，大破之；斩和，平诸县，收其粮谷以给军士。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":42,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":124,"end":184,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
