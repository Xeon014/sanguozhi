{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"houfei-e-p002a","title":"刘夫人卒丁氏抚养曹昂","accounts":[{"id":"houfei-e-p002a-account","label":"《魏略》","text":"刘夫人卒丁氏抚养曹昂","evidence":["houfei-e-p002a-q"]}],"participants":[{"person":"houfei-p0007","role":"卒","evidence":["houfei-e-p002a-q"]},{"person":"houfei-p0008","role":"抚子","evidence":["houfei-e-p002a-q"]}],"place":null,"time":{"label":"初","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["houfei-e-p002a-q"]},"ordering_evidence":"houfei-e-p002a-q","source_order":[5,38,"P002a"],"order":1341}],"persons":[{"id":"houfei-p0007","name":"刘夫人（曹操妾）","evidence":["houfei-q-p002"],"facts":[],"aliases":[],"mentions":[{"id":"houfei-m-p002-houfei-p0007","kind":"mention","text":"文中提及","evidence":["houfei-q-p002"]}]}],"evidence":[{"id":"houfei-e-p002a-q","section":"chapter-005","block":"b-e655a9cd53f203645964","layer":"pei","quote":"太祖始有丁夫人，又刘夫人生子修及清河长公主。刘早终，丁养子修。","attribution":"《魏略》","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":37,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8073d620865a43f9e1af","start":10,"end":41,"offset_unit":"unicode_code_point"},{"id":"houfei-q-p002","section":"chapter-005","block":"b-e655a9cd53f203645964","layer":"pei","quote":"﹝二﹞《魏略》曰：“太祖始有丁夫人，又刘夫人生子修及清河长公主。刘早终，丁养子修。子修亡于穰，丁常言：‘将我儿杀之，都不复念！’遂哭泣无节。太祖忿之，遣归家，欲其意折。后太祖就见之，夫人方织。外人传云‘公至’，夫人踞机如故。太祖到，抚其背曰：‘顾我共载归乎？’夫人不顾，又不应。太祖却行，立于户外。复云：‘得无尚可邪？’遂不应。太祖曰：‘真诀矣！’遂与绝。欲其家嫁之，其家不敢。初，丁夫人既为嫡，加有子修，丁视后母子，不足。后为继室，不念旧恶。因太祖出行，常四时使人馈遗。又私迎之，延以正坐而己下之。迎来送去，有如昔日。丁谢曰：‘废放之人，夫人何能常尔邪！’其后丁亡，后请太祖殡葬；许之，乃葬许城南。后太祖病困，自虑不起，叹曰：‘我前后行意，于心未曾有所负也。假令死而有灵，子修若问“我母所在”？我将何辞以答！’”","attribution":"《魏略》","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":37,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8073d620865a43f9e1af","start":0,"end":357,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
