90f3","xumisun-q-d04e6ec9bdf011cc27fa","xumisun-q-b8452ddec1e60dcac686","xumisun-q-bcbbed8e255b035a58e5","xumisun-q-f9e3094aca6d77f0fa20","xumisun-q-ee0e2c49741ad3848697","xumisun-q-72f1c4334245dd244ea6","xumisun-q-81aaae649c723a923865","xumisun-q-e17c53b531a73aa09619","xumisun-q-3b257828382c8bcdf210","xumisun-q-374ec32bedb0e61ed1e3","xumisun-q-34d2126e4ec9ad3a86fa","xumisun-q-487ed67c28f9bbead47a","xumisun-q-9e5f166b06f36499b6bb","xumisun-q2-f026e174b29d80d9bbc2","xumisun-q2-a3aaa6cf31e39cfaeafa","duzhou-q-f2272436b7af58e82d78"],"facts":[{"id":"xumisun-f2-17902e67b2a33516a474","text":"秦宓字子敕，广汉绵竹人。","evidence":["xumisun-q2-f026e174b29d80d9bbc2"]}],"aliases":[],"mentions":[{"id":"xumisun-m2-role-d63042e3c2e04a6c3448","kind":"mention","text":"文中提及","evidence":["xumisun-q-72f1c4334245dd244ea6","xumisun-q2-a3aaa6cf31e39cfaeafa"]}]}],"evidence":[{"id":"duzhou-q-f2272436b7af58e82d78","section":"chapter-042","block":"b-54784f7ae51ee855c557","layer":"original","quote":"建兴二年，丞相亮领益州牧，选迎皆妙简旧德〖2〗：以秦宓为别驾，五梁为功曹，微为主簿","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":2,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":41,"offset_unit":"unicode_code_point"},{"id":"huangli-q-403b0d6717c6c241dced","section":"chapter-043","block":"b-eeece5f7b734fad61b54","layer":"original","quote":"叛乱之后，忠抚育恤理，甚有威惠","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":127,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":47,"end":62,"offset_unit":"unicode_code_point"},{"id":"liuermu-q-375dab3620fe620c358d","section":"chapter-031","block":"b-623bf969181385f8ee83","layer":"pei","quote":"后，丞相诸葛亮问秦宓以扶所长，宓曰：‘董扶褒秋毫之善，贬纤芥之恶","attribution":"裴注·益部耆旧传","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":35,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6499b8e5158463761833","start":324,"end":356,"offset_unit":"unicode_code_point"},{"id":"liuermu-q2-5e52b09a7f3ccb876c5c","section":"chapter-031","block":"b-623bf969181385f8ee83","layer":"pei","quote":"﹝四﹞陈寿《益部耆旧传》曰：“董扶字茂安。少从师学，兼通数经，善欧阳《尚书》；又事聘士杨厚，究极图谶。遂至京师，游览太学。还家讲授，弟子自远而至。永康元年，日有蚀之；诏举贤良方正之士，策问得失。左冯翊赵谦等举扶，扶以病不诣；遥于长安上封事，遂称疾笃归家。前后宰府十辟，公车三征，再举贤良方正、博士、有道，皆不就；名称尤重。大将军何进表荐扶日：‘资游、夏之德，述孔氏之风，内怀焦、董消复之术。方今并、凉骚扰，西戎蠢叛，宜敕公车特召，待以异礼，咨谋奇策。’于是灵帝征扶，即拜侍中。在朝称为儒宗，甚见器重。求为蜀郡属国都尉。扶出一岁而灵帝崩，天下大乱。后去官，年八十二，卒于家。始扶发辞抗论，益部少双，故号曰‘（致）〔至〕止’：言人莫能当，所至而谈止也。后，丞相诸葛亮问秦宓以扶所长，宓曰：‘董扶褒秋毫之善，贬纤芥之恶。’”","attribution":"裴注（引书见原文）","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":35,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6499b8e5158463761833","start":0,"end":359,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-20caedd4a9cadd6c705a","section":"chapter-040","block":"b-62685cfcf25eb40f88cd","layer":"original","quote":"彭羕字永年，广汉人。身长八尺，容貌甚伟。姿性骄傲，多所轻忽；惟敬同郡秦子敕〖1〗，荐之于太守许靖曰：“昔高宗梦傅说〖2〗，周文求吕尚〖3〗；爰及汉祖，纳食其于布衣〖4〗。此乃帝王之所以倡业垂统〖5〗，缉熙厥功也〖6〗。今明府稽古皇极〖7〗，允执神灵〖8〗；体公刘之德〖9〗，行勿践之惠〖10〗；《清庙》之作于是乎始〖11〗，褒贬之义于是乎兴。然而六翮未之备也〖12〗。伏见处士绵竹秦宓：膺山甫之德〖13〗，履隽生之直〖14〗；枕石漱流，吟咏缊袍〖15〗；偃息于仁义之途〖16〗，恬淡于浩然之域；高概节行，守真不亏。虽古人潜遁，蔑以加旃〖17〗！若明府能招致此人，必有忠谠落落之誉〖18〗，丰功厚利，建迹（之）〔立〕勋；然后纪功于王府，飞声于来世。不亦美哉！”","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":80,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":329,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-0e750d2220d8cc1ee724","section":"chapter-038","block":"b-bbf8783c35fe00adf8c1","layer":"original","quote":"广汉太守夏（侯）纂请宓为师友祭酒","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":359,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":7,"end":23,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-130724f3b8b0c8cbf942","section":"chapter-038","block":"b-0049499770542ab1361a","layer":"original","quote":"宓以簿击颊〖13〗，﹝一﹞曰：“愿明府勿以仲父之言假于小草〖14〗，民请为明府陈其本纪〖15〗：蜀有汶阜之山〖16〗，江出其腹〖17〗；帝以会昌〖18〗，神以建福，故能沃野千里。﹝二﹞淮、济四渎〖19〗，江为其首。此其一也。禹生石纽〖20〗，今之汶山郡是也〖21〗。﹝三﹞昔尧遭洪水，鲧所不治；禹疏江决河，东注于海；为民除害，生民以来功莫先者。此其二也。天帝布治房、心〖22〗；决政参、伐〖23〗：参、伐则益州分野〖24〗，三皇乘祗车出谷口〖25〗，今之斜谷是也。﹝四﹞此便鄙州之阡陌〖26〗；明府以雅意论之〖27〗：何若于天下乎","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":361,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":14,"end":279,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-15f49ac4121cb47fb673","section":"chapter-038","block":"b-3382d1ff7848a525779b","layer":"original","quote":"先是，李权从宓借《战国策》","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":314,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":13,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-2664f792362f28fe1b60","section":"chapter-038","block":"b-a6c5888cb1e1aae0103e","layer":"original","quote":"宓报曰","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":315,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":3,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-335bb0b18ced7349d7c8","section":"chapter-038","block":"b-3971383630abf0d5dc2d","layer":"original","quote":"先主既称尊号，将东征吴","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":363,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":14,"end":25,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-33851a3898bc629c1d2a","section":"chapter-038","block":"b-e12f2c646e5108a59533","layer":"original","quote":"宓答书曰","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":274,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":4,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-34d2126e4ec9ad3a86fa","section":"chapter-038","block":"b-436d23f9e53aa1274864","layer":"original","quote":"又论皇帝王霸（养）〔豢〕龙之说〖9〗，甚有通理","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":406,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":39,"end":62,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-374ec32bedb0e61ed1e3","section":"chapter-038","block":"b-436d23f9e53aa1274864","layer":"original","quote":"宓见帝系之文，五帝皆同一族〖8〗；宓辨其不然之本","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":406,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":14,"end":38,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-3aac2d5a1b1245da46bf","section":"chapter-038","block":"b-cac4f12c6d2cdc2db0fe","layer":"original","quote":"宓与书曰","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":275,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":16,"end":20,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-3b257828382c8bcdf210","section":"chapter-038","block":"b-436d23f9e53aa1274864","layer":"original","quote":"四年卒","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":406,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":5,"end":8,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-487ed67c28f9bbead47a","section":"chapter-038","block":"b-436d23f9e53aa1274864","layer":"original","quote":"谯允南少时〖10〗，数往谘访，纪录其言于《春秋然否论》","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":406,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":63,"end":90,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-4abe40fdb2c8bb944dc4","section":"chapter-038","block":"b-b452621af2e02d27c88e","layer":"original","quote":"宓同郡王商为治中从事，与宓书曰：“贫贱困苦，亦何时可以终身？卞和炫玉以耀世〖1〗；宜一来，与州尊相见","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":273,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":4,"end":54,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-72f1c4334245dd244ea6","section":"chapter-038","block":"b-c85c98685debb4bb6a86","layer":"original","quote":"温曰：“彼何人也？”亮曰：“益州学士也","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":404,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":38,"end":57,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-7e203356367a5333916e","section":"chapter-038","block":"b-ab9019f678cb8014e82c","layer":"original","quote":"州、郡辟命〖1〗，辄称疾不往","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":243,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":18,"end":32,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-81aaae649c723a923865","section":"chapter-038","block":"b-07e1dd33ae62751e3422","layer":"original","quote":"及至，温问曰：“君学乎？”宓曰：“五尺童子皆学，何必小人！”温复问曰：“天有头乎？”宓曰：“有之。”温曰：“在何方也？”宓曰：“在西方。《诗》曰：‘乃眷西顾〖3〗。’以此推之，头在西方。”温曰：“天有耳乎？”宓曰：“天处高而听卑。《诗》云：‘鹤鸣于九皋，声闻于天。’若其无耳，何以听之？”温曰：“天有足乎？”宓曰：“有。《诗》云：‘天步艰难〖4〗，之子不犹〖5〗。’若其无足，何以步之？”温曰：“天有姓乎？”宓曰：“有。”温曰：“何姓？”宓曰：“姓刘。”温曰：“何以知之？”答曰：“天子姓刘，故以此知之。”温曰：“日生于东乎〖6〗？”宓曰：“虽生于东，而没于西。”答问如响，应声而出；于是温大敬服","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":405,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":298,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-8d6c7a23f67651a6ab83","section":"chapter-038","block":"b-161447eb23395e29cfc6","layer":"modern","quote":"〖7〗四年：建兴四年（公元 226）。","attribution":"现代注释","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":414,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-bf0d112c953678fdd4a1","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-9e5f166b06f36499b6bb","section":"chapter-038","block":"b-927acb42202d160eaa63","layer":"pei","quote":"后丞相亮，问秦宓以‘安所长’，宓曰：‘记人之善，忘人之过","attribution":"裴注·益部耆旧传","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":272,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ef97ef6afdee0c02cbbd","start":181,"end":209,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-b8452ddec1e60dcac686","section":"chapter-038","block":"b-3971383630abf0d5dc2d","layer":"original","quote":"坐下狱幽闭，然后贷出","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":363,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":35,"end":45,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-bcbbed8e255b035a58e5","section":"chapter-038","block":"b-f97cac21a0534a246931","layer":"original","quote":"建兴二年，丞相亮领益州牧，选宓，迎为别驾","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":403,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-d04e6ec9bdf011cc27fa","section":"chapter-038","block":"b-3971383630abf0d5dc2d","layer":"original","quote":"宓陈天时必无其利","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":363,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":26,"end":34,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-d61a704636d812412695","section":"chapter-038","block":"b-29c33cd9cfa294b9284a","layer":"original","quote":"宓答曰","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":342,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":3,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-e17c53b531a73aa09619","section":"chapter-038","block":"b-436d23f9e53aa1274864","layer":"original","quote":"迁大司农","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":406,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":4,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-ebc06d2ebc26d4b2049e","section":"chapter-038","block":"b-f11e84fd1058150ef6a0","layer":"original","quote":"宓称疾，卧在第舍〖4〗。纂将功曹古朴、主簿王普，厨膳〖5〗，即宓第宴谈；宓卧如故","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":360,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":40,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-ee0e2c49741ad3848697","section":"chapter-038","block":"b-c85c98685debb4bb6a86","layer":"original","quote":"众人皆集而宓未往，亮累遣使，促之","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":404,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":21,"end":37,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-f60574bdad26e8c2a523","section":"chapter-038","block":"b-8044dc72f679ee7394a2","layer":"original","quote":"奏记州牧刘焉〖2〗，荐儒士任定祖","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":244,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":16,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-f9e3094aca6d77f0fa20","section":"chapter-038","block":"b-f97cac21a0534a246931","layer":"original","quote":"寻拜左中郎将、长水校尉","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":403,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":21,"end":32,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-fc64a96748bd666f90f3","section":"chapter-038","block":"b-3971383630abf0d5dc2d","layer":"original","quote":"益州辟宓为从事祭酒","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":363,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":9,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-ff9de3059125f894c1e2","section":"chapter-038","block":"b-3382d1ff7848a525779b","layer":"original","quote":"宓曰：“战国从横〖2〗，用之何为？”权曰：“仲尼、严平〖3〗，会聚众书，以成《春秋》、《指归》之文〖4〗；故海以合流为大，君子以博识为弘","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":314,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":17,"end":85,"offset_unit":"unicode_code_point"},{"id":"xumisun-q2-190cc0ed9f2607f39232","section":"chapter-038","block":"b-3382d1ff7848a525779b","layer":"original","quote":"先是，李权从宓借《战国策》〖1〗。宓曰：“战国从横〖2〗，用之何为？”权曰：“仲尼、严平〖3〗，会聚众书，以成《春秋》、《指归》之文〖4〗；故海以合流为大，君子以博识为弘。”","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":314,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":87,"offset_unit":"unicode_code_point"},{"id":"xumisun-q2-26cde17979655fa85403","section":"chapter-038","block":"b-8044dc72f679ee7394a2","layer":"original","quote":"奏记州牧刘焉〖2〗，荐儒士任定祖曰：“昔百里、蹇叔以耆艾而定策〖3〗，甘罗、子奇以童冠而立功〖4〗；故《书》美黄发〖5〗，而《易》称颜渊〖6〗：固知选士用能，不拘长幼，明矣。乃者以来〖7〗，海内察举〖8〗，率多英俊而遗旧齿〖9〗；众论不齐，异同相半：此乃承平之翔步〖10〗，非乱世之急务也。夫欲救危抚乱，修己以安人；则宜卓荦超伦〖11〗，与时殊趣；震惊邻国，骇动四方。上当天心，下合人意；天人既和，内省不疚〖12〗：虽遭凶乱，何忧何惧？昔楚叶公好龙〖13〗，神龙下之；好伪彻天〖14〗，何况于真？今处士任安〖15〗，仁义直道，流名四远〖16〗；如令见察〖17〗，则一州斯服。昔汤举伊尹，不仁者远〖18〗；何武贡二龚〖19〗，双名竹帛〖20〗。故贪寻常之高而忽万仞之嵩〖21〗，乐面前之饰而忘天下之誉：斯诚往古之所重慎也。甫欲凿石索玉〖22〗，剖蚌求珠；今乃随、和炳然〖23〗，有如皎日：复何疑哉！诚知昼不操烛〖24〗，日有余光；但愚情区区〖25〗，贪陈所见。”﹝一﹞","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":244,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":433,"offset_unit":"unicode_code_point"},{"id":"xumisun-q2-72d53338911b084f3955","section":"chapter-038","block":"b-927acb42202d160eaa63","layer":"pei","quote":"﹝一﹞《益部耆旧传》曰：“安，广汉人。少事聘士杨厚，究极图籍。游览京师，还家讲授，与董扶俱以学行齐声。郡请功曹，州辟治中、别驾；终不久居。举孝廉、茂才；太尉载辟；除博士，公车征：皆称疾不就。州牧刘焉，表荐安：‘味精道度，厉节高邈；揆其器量，国之元宝；宜处弼疑之辅，以消非常之咎：玄'之礼，所宜招命。’王途隔塞，遂无聘命。年七十九，建安七年卒。门人慕仰，为立碑铭。后丞相亮，问秦宓以‘安所长’，宓曰：‘记人之善，忘人之过。’”","attribution":"裴注（引书见原文）","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":272,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ef97ef6afdee0c02cbbd","start":0,"end":212,"offset_unit":"unicode_code_point"},{"id":"xumisun-q2-a3aaa6cf31e39cfaeafa","section":"chapter-038","block":"b-c85c98685debb4bb6a86","layer":"original","quote":"吴遣使张温来聘〖1〗，百官皆往饯焉〖2〗。众人皆集而宓未往，亮累遣使，促之。温曰：“彼何人也？”亮曰：“益州学士也。”","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":404,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":59,"offset_unit":"unicode_code_point"},{"id":"xumisun-q2-c7f038cbe775c4ce6a04","section":"chapter-038","block":"b-cac4f12c6d2cdc2db0fe","layer":"original","quote":"后商为严君平、李弘立祠〖17〗。宓与书曰：“疾病伏匿〖18〗；甫知足下为严、李立祠，可谓厚党勤类者也〖19〗。观严文章，冠冒天下；由、夷逸操〖20〗，山岳不移；使扬子不叹〖21〗，固自昭明。如李仲元不遭《法言》〖22〗，令名必沦〖23〗；其无虎豹之文故也〖24〗：可谓攀龙附凤者矣〖25〗。如扬子云潜心著述，有补于世；泥蟠不滓〖26〗，行参圣师〖27〗；于今海内，谈咏厥辞〖28〗。邦有斯人，以耀四远；怪子替兹〖29〗，不立祠堂。蜀本无学士，文翁遣相如东受七经〖30〗，还教吏民；于是蜀学比于齐、鲁。故《地（里）〔理〕志》曰〖31〗：‘文翁倡其教，相如为之师。’汉家得士，盛于其世。仲舒之徒〖32〗，不达封禅〖33〗，相如制其礼；夫能制礼造乐，移风易俗，非《礼》所秩有益于世者乎〖34〗？虽有王孙之累〖35〗；犹孔子大齐桓之霸〖36〗，公羊贤叔术之让〖37〗，仆亦善长卿之化。宜立祠堂，速定其铭。”","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":275,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":399,"offset_unit":"unicode_code_point"},{"id":"xumisun-q2-cae6a1d82e7291a15359","section":"chapter-038","block":"b-f11e84fd1058150ef6a0","layer":"original","quote":"宓称疾，卧在第舍〖4〗。纂将功曹古朴、主簿王普，厨膳〖5〗，即宓第宴谈；宓卧如故。纂问朴曰：“至于贵州养生之具〖6〗，实绝余州矣〖7〗；不知士人何如余州也？”朴对曰：“乃自先汉以来，其爵位者或不如余州耳〖8〗；至于著作为世师式〖9〗，不负于余州也〖10〗。严君平见黄、老作《指归》〖11〗；扬雄见《易》作《太玄》，见《论语》作《法言》；司马相如为武帝制封禅之文：于今天下所共闻也。”","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":360,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":191,"offset_unit":"unicode_code_point"},{"id":"xumisun-q2-f026e174b29d80d9bbc2","section":"chapter-038","block":"b-ab9019f678cb8014e82c","layer":"original","quote":"秦宓字子敕，广汉绵竹人也。","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":243,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":13,"offset_unit":"unicode_code_point"}],"profiles":{"liuliao-p0008":{"fields":[],"directory":{"faction":"shu"}}},"directory_counts":{}}
