-proposal","label":"《先主传》正文·群臣上表","text":"群臣宣称依旧典封刘备汉中王、拜大司马，以汉中、巴、蜀、广汉、犍为为国。","evidence":["xianzhu-q-o054-proposal"]},{"id":"dengzhang-a-e5778b16dd46c3d298c3","label":"裴注·华阳国志","text":"李朝为汉中王上文","evidence":["dengzhang-q-717a432bbf8367bb45e1"]}],"participants":[{"person":"wudi-p0282","role":"署表","evidence":["xianzhu-e-o051a-q"]},{"person":"xianzhu-p0059","role":"署表","evidence":["xianzhu-e-o051a-q"]},{"person":"xianzhu-p0074","role":"署表","evidence":["xianzhu-e-o051a-q"]},{"person":"xianzhu-p0075","role":"署表","evidence":["xianzhu-e-o051a-q"]},{"person":"zhuge-liang","role":"署表","evidence":["xianzhu-e-o051a-q"]},{"person":"wudi-p0172","role":"署表","evidence":["xianzhu-e-o051a-q"]},{"person":"wudi-p0367","role":"署表","evidence":["xianzhu-e-o051a-q"]},{"person":"xianzhu-p0051","role":"署表","evidence":["xianzhu-e-o051a-q"]},{"person":"xianzhu-p0076","role":"署表","evidence":["xianzhu-e-o051a-q"]},{"person":"xianzhu-p0046","role":"署表","evidence":["xianzhu-e-o051a-q"]},{"person":"xianzhu-p0057","role":"署表","evidence":["xianzhu-e-o051a-q"]},{"person":"liu-bei","role":"受推","evidence":["xianzhu-e-o051a-q"]},{"person":"wudi-p0054","role":"表文受呈者","evidence":["xianzhu-e-o051a-q"]},{"person":"dengzhang-p0028","role":"群下上先主为汉中王，其文朝所造","evidence":["dengzhang-q-717a432bbf8367bb45e1"]}],"place":null,"time":{"year":219,"label":"建安二十四年秋","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xianzhu-y219","dating_review":{"reviewed":true,"anchor":"xianzhu-q-o048","basis":"建安二十四年秋"},"evidence":["xianzhu-e-o051a-q","xianzhu-q-o048","xianzhu-q-b-c3e56caa3865de7f7114"]},"source_order":[32,207,"O051a"],"order":6580},{"id":"xianzhu-e-p040b","title":"射坚射援避乱入蜀","accounts":[{"id":"xianzhu-e-p040b-account","label":"《三辅决录注》","text":"献帝初三辅饥乱，射坚与射援入蜀依刘璋，射坚任长史。","evidence":["xianzhu-e-p040b-q"]}],"participants":[{"person":"xianzhu-p0086","role":"入蜀任官","evidence":["xianzhu-e-p040b-q"]},{"person":"xianzhu-p0075","role":"入蜀","evidence":["xianzhu-e-p040b-q"]},{"person":"wudi-p0253","role":"任长史","evidence":["xianzhu-e-p040b-q"]}],"place":{"text":"益州","evidence":["xianzhu-e-p040b-q"]},"time":{"label":"献帝之初","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xianzhu-e-p040b-q"]},"source_order":[32,274,"P040b"],"order":6583},{"id":"xianzhu-e-p040d","title":"皇甫嵩以女妻射援","accounts":[{"id":"xianzhu-e-p040d-account","label":"《三辅决录注》","text":"皇甫嵩欣赏射援才行，将女儿嫁给他。","evidence":["xianzhu-e-p040d-q"]}],"participants":[{"person":"xianzhu-p0088","role":"嫁女","evidence":["xianzhu-e-p040d-q"]},{"person":"xianzhu-p0075","role":"成婚","evidence":["xianzhu-e-p040d-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xianzhu-e-p040d-q"]},"source_order":[32,274,"P040d"],"order":6585},{"id":"xianzhu-e-p040e","title":"诸葛亮任射援祭酒从事中郎","accounts":[{"id":"xianzhu-e-p040e-account","label":"《三辅决录注》","text":"丞相诸葛亮任射援为祭酒，后迁从事中郎，射援卒于任上。","evidence":["xianzhu-e-p040e-q"]}],"participants":[{"person":"zhuge-liang","role":"任官","evidence":["xianzhu-e-p040e-q"]},{"person":"xianzhu-p0075","role":"任官卒","evidence":["xianzhu-e-p040e-q"]}],"place":null,"time":{"label":"诸葛亮为丞相期间","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xianzhu-e-p040e-q"]},"source_order":[32,274,"P040e"],"order":6586}],"persons":[{"id":"xianzhu-p0075","name":"射援","evidence":["xianzhu-q-o051"],"facts":[{"id":"xianzhu-f0019","label":"字","text":"文雄","evidence":["xianzhu-f0019-q"]},{"id":"xianzhu-f0020","label":"籍贯","text":"扶风","evidence":["xianzhu-f0020-q"]}],"aliases":[{"text":"文雄","evidence":["xianzhu-f0019-q"]}],"mentions":[{"id":"xianzhu-m-o051-xianzhu-p0075","kind":"mention","text":"文中提及","evidence":["xianzhu-q-o051"]},{"id":"xianzhu-m-p040-xianzhu-p0075","kind":"mention","text":"文中提及","evidence":["xianzhu-q-p040"]}]}],"evidence":[{"id":"dengzhang-q-717a432bbf8367bb45e1","section":"chapter-045","block":"b-dcad3795f68a26f97ecf","layer":"pei","quote":"群下上先主为汉中王；其文，朝所造也","attribution":"裴注·华阳国志","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":345,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c4df925d7ccb2471fbb6","start":47,"end":64,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o051a-q","section":"chapter-032","block":"b-652c7dfc21363b200764","layer":"original","quote":"“平西将军、都亭侯臣马超，左将军领长史、镇军将军臣许靖，营司马臣庞羲，议曹从事、中郎、军议中郎将臣射援，﹝一﹞军师将军臣诸葛亮，荡寇将军、汉寿亭侯臣关羽，征虏将军、新亭侯臣张飞，征西将军臣黄忠，镇远将军臣赖恭，扬武将军臣法正，兴业将军臣李严等一百二十人上言曰〖17〗：","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":206,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":134,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-p040b-q","section":"chapter-032","block":"b-b0ea4afec2b883077489","layer":"pei","quote":"献帝之初，三辅饥乱；坚去官，与弟援南入蜀依刘璋，璋以坚为长史。","attribution":"《三辅决录注》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":273,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-43ca07374605c0a2834e","start":91,"end":122,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-p040d-q","section":"chapter-032","block":"b-b0ea4afec2b883077489","layer":"pei","quote":"援亦少有名行，太尉皇甫嵩贤其才而以女妻之。","attribution":"《三辅决录注》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":273,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-43ca07374605c0a2834e","start":138,"end":159,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-p040e-q","section":"chapter-032","block":"b-b0ea4afec2b883077489","layer":"pei","quote":"丞相诸葛亮以援为祭酒，迁从事中郎。卒官。”","attribution":"《三辅决录注》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":273,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-43ca07374605c0a2834e","start":159,"end":180,"offset_unit":"unicode_code_point"},{"id":"xianzhu-f0019-q","section":"chapter-032","block":"b-b0ea4afec2b883077489","layer":"pei","quote":"援字文雄。扶风人也。","attribution":"《三辅决录注》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":273,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-43ca07374605c0a2834e","start":13,"end":23,"offset_unit":"unicode_code_point"},{"id":"xianzhu-f0020-q","section":"chapter-032","block":"b-b0ea4afec2b883077489","layer":"pei","quote":"援字文雄。扶风人也。","attribution":"《三辅决录注》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":273,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-43ca07374605c0a2834e","start":13,"end":23,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-b-c3e56caa3865de7f7114","section":"chapter-032","block":"b-c3e56caa3865de7f7114","layer":"modern","quote":"〖11〗二十四年：建安二十四年（公元 219）。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":222,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fd85f82251e498647de7","start":0,"end":24,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o048","section":"chapter-032","block":"b-2d515ba2dae40f6a248e","layer":"original","quote":"二十四年春〖11〗，自阳平南渡沔水，缘山稍前〖12〗，于定军山（势）作营〖13〗。渊将兵来争其地，先主命黄忠乘高鼓噪攻之。大破渊军，斩渊及曹公所署益州刺史赵颙等。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":203,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":81,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o050-preface","section":"chapter-032","block":"b-a429b62b1d8ac4da31ba","layer":"original","quote":"秋，群下上《先王为汉中王表》于汉帝〖16〗，曰：","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":205,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":24,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o051","section":"chapter-032","block":"b-652c7dfc21363b200764","layer":"original","quote":"“平西将军、都亭侯臣马超，左将军领长史、镇军将军臣许靖，营司马臣庞羲，议曹从事、中郎、军议中郎将臣射援，﹝一﹞军师将军臣诸葛亮，荡寇将军、汉寿亭侯臣关羽，征虏将军、新亭侯臣张飞，征西将军臣黄忠，镇远将军臣赖恭，扬武将军臣法正，兴业将军臣李严等一百二十人上言曰〖17〗：","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":206,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":134,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o052-argument1","section":"chapter-032","block":"b-13bc0548f92b946e57ac","layer":"original","quote":"昔唐尧至圣，而四凶在朝〖18〗；周成仁贤，而四国作难〖19〗；高后称制，而诸吕窃命〖20〗；孝昭幼冲，而上官逆谋〖21〗：皆凭世宠〖22〗，藉履国权〖23〗，穷凶极乱，社稷几危。非大舜、周公、朱虚、博陆〖24〗，则不能流放擒讨，安危定倾。伏惟陛下诞姿圣德，统理万邦；而遭厄运不造之艰〖25〗。董卓首难〖26〗，荡覆京畿；曹操阶祸〖27〗，窃执天衡〖28〗；皇后太子〖29〗，鸩杀见害；剥乱天下，残毁民物〖30〗。久令陛下蒙尘忧厄，幽处虚邑〖31〗；人神无主，遏绝王命；厌昧皇极〖32〗，欲盗神器。左将军、领司隶校尉、豫、荆、益三州牧宜城亭侯备，受朝爵秩，念在输力〖33〗，以殉国难。睹其机兆〖34〗，赫然愤发；与车骑将军董承同谋诛操，将安国家，克宁旧都。会承机事不密，令操游魂得遂长恶〖35〗，残泯海内。臣等每惧王室大有阎乐之祸〖36〗，小有定安之变〖37〗；﹝二﹞夙夜惴惴，战栗累息。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":207,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":393,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o053-argument2","section":"chapter-032","block":"b-5e935a656e57fa2b467f","layer":"original","quote":"昔在《虞书》〖38〗，敦序九族〖39〗；周监二代〖40〗，封建同姓；《诗》著其义〖41〗，历载长久。汉兴之初，割裂疆土〖42〗，尊王子弟；是以卒折诸吕之难〖43〗，而成太宗之基〖44〗。臣等以备肺腑枝叶〖45〗，宗子藩翰〖46〗；心存国家，念在弥乱〖47〗；自操破于汉中，海内英雄望风蚁附；而爵号不显，九锡未加〖48〗：非所以镇卫社稷，光昭万世也。奉辞在外〖49〗，礼命断绝。昔河西太守梁统等值汉中兴〖50〗，限于山河〖51〗；位同权均，不能相率；咸推窦融以为元帅〖52〗，卒立效绩〖53〗，摧破隗嚣〖54〗。今社稷之难，急于陇、蜀〖55〗；操外吞天下，内残群僚；朝廷有萧墙之危〖56〗，而御侮未建〖57〗，可为寒心。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":208,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":309,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o054-proposal","section":"chapter-032","block":"b-48e611d2cf38e3f1ec45","layer":"original","quote":"臣等辄依旧典，封备汉中王，拜大司马，董齐六军〖58〗，纠合同盟，扫灭凶逆；以汉中、巴、蜀、广汉、犍为为国，所署置依汉初诸侯王故典。夫权宜之制，苟利社稷，专之可也；然后功成事立，臣等退伏矫罪〖59〗，虽死无恨！”","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":209,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":105,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-p040","section":"chapter-032","block":"b-b0ea4afec2b883077489","layer":"pei","quote":"﹝一﹞《三辅决录注》曰：“援字文雄。扶风人也。其先本姓谢，与北地诸谢同族。始祖谢服为将军出征；天子以‘谢服’非令名，改为‘射’，子孙氏焉。兄坚，字文固。少有美名，辟公府，为黄门侍郎。献帝之初，三辅饥乱；坚去官，与弟援南入蜀依刘璋，璋以坚为长史。刘备代璋，以坚为广汉、蜀郡太守。援亦少有名行，太尉皇甫嵩贤其才而以女妻之。丞相诸葛亮以援为祭酒，迁从事中郎。卒官。”","attribution":"《三辅决录注》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":273,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-43ca07374605c0a2834e","start":0,"end":180,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
