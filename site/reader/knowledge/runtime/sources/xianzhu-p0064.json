-f473a6f7cdb981bbf2a6","liuliao-q-4c8e1c06b65a4c4df7ca","liuliao-q-1abf03ff9d9e4599676d"],"facts":[],"aliases":[],"mentions":[{"id":"xianzhu-m-o043-xianzhu-p0064","kind":"mention","text":"文中提及","evidence":["xianzhu-q-o043"]},{"id":"liuliao-m-dc074672ab63869708f7","kind":"mention","text":"本段涉及彭羕","evidence":["liuliao-q-d9665bbb91f9df502fd4","liuliao-q-325e45e613fe050212ff","liuliao-q-786cd608654a686a0b2e"]}]}],"evidence":[{"id":"dongliu-q-e3070df472d0b9c41900","section":"chapter-039","block":"b-8e9e3c4c6d67f5fa476c","layer":"original","quote":"先主定蜀，征和为掌军中郎将","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":3,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":13,"offset_unit":"unicode_code_point"},{"id":"huangli-q-b685b1081f6c75c813e8","section":"chapter-043","block":"b-962c82ad79e50c7a0854","layer":"original","quote":"成都既定，先主领益州牧，以恢为功曹书佐、主簿","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":57,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":22,"offset_unit":"unicode_code_point"},{"id":"huowang-q-225ed2d7e9d667049592","section":"chapter-041","block":"b-20cf9e4bd23391868d15","layer":"original","quote":"成都既定，先主领益州牧，以诗为督军从事","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":169,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":34,"end":53,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-1abf03ff9d9e4599676d","section":"chapter-040","block":"b-591da4814fb6f94ad4a8","layer":"original","quote":"羕竟诛死，时年三十七","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":124,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":10,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-20caedd4a9cadd6c705a","section":"chapter-040","block":"b-62685cfcf25eb40f88cd","layer":"original","quote":"彭羕字永年，广汉人。身长八尺，容貌甚伟。姿性骄傲，多所轻忽；惟敬同郡秦子敕〖1〗，荐之于太守许靖曰：“昔高宗梦傅说〖2〗，周文求吕尚〖3〗；爰及汉祖，纳食其于布衣〖4〗。此乃帝王之所以倡业垂统〖5〗，缉熙厥功也〖6〗。今明府稽古皇极〖7〗，允执神灵〖8〗；体公刘之德〖9〗，行勿践之惠〖10〗；《清庙》之作于是乎始〖11〗，褒贬之义于是乎兴。然而六翮未之备也〖12〗。伏见处士绵竹秦宓：膺山甫之德〖13〗，履隽生之直〖14〗；枕石漱流，吟咏缊袍〖15〗；偃息于仁义之途〖16〗，恬淡于浩然之域；高概节行，守真不亏。虽古人潜遁，蔑以加旃〖17〗！若明府能招致此人，必有忠谠落落之誉〖18〗，丰功厚利，建迹（之）〔立〕勋；然后纪功于王府，飞声于来世。不亦美哉！”","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":80,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":329,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-247aa16b17cb71d0c513","section":"chapter-040","block":"b-afd3a40fc4164bc8bc03","layer":"original","quote":"先主亦以为奇，数令羕宣传军事，指授诸将；奉使称意，识遇日加。成都既定，先主领益州牧，拔羕为治中从事","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":104,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":49,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-325e45e613fe050212ff","section":"chapter-040","block":"b-a1df969040de061dbd47","layer":"pei","quote":"﹝一﹞扬雄《方言》曰：“悈、鳃、干、都、耇、革，老也。”郭璞注曰：“皆老者皮毛枯瘁之形也。”臣松之以为：皮去毛曰革。古者以革为兵，故语称“兵革”，革犹兵也。羕骂备为“老革”，犹言老兵也。","attribution":"裴注·扬雄方言、郭璞注、裴松之按","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":122,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-bece42b9ac071820333b","start":0,"end":93,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-39819a07158711985dc5","section":"chapter-040","block":"b-295f8c498eeb25f6161b","layer":"original","quote":"羕曰：“老革荒悖〖10〗，可复道邪！”﹝一﹞又谓超曰：“卿为其外，我为其内，天下不足定也","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":106,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":44,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-3b7a9e93a3b9f1ecd54a","section":"chapter-040","block":"b-0a3ab06d6c7ebf12094b","layer":"original","quote":"羕仕州，不过书佐〖19〗。后又为众人所谤毁于州牧刘璋。璋髡钳羕为徒隶","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":81,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":34,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-4c8e1c06b65a4c4df7ca","section":"chapter-040","block":"b-5546178cd0f84046f478","layer":"original","quote":"羕于狱中与诸葛亮书曰：“仆昔有事于诸侯〖1〗，以为曹操暴虐，孙权无道，振威暗弱〖2〗；其惟主公有霸王之器，可与兴业致治，故乃翻然有轻举之志。会公来西，仆因法孝直自炫鬻〖3〗，庞统斟酌其间〖4〗；遂得诣公于葭萌〖5〗，指掌而谈〖6〗，论治世之务，讲霸王之义，建取益州之策；公亦宿虑明定〖7〗，即相然赞〖8〗，遂举事焉。仆于故州不免凡庸〖9〗，忧于罪罔；得遭风云激矢之中，求君得君，志行名显，从布衣之中擢为国士，盗窃茂才〖10〗。分子之厚〖11〗，谁复过此？﹝一﹞羕一朝狂悖，自求菹醢〖12〗，为不忠不义之鬼乎？先民有言：‘左手据天下之图〖13〗，右手刎咽喉，愚夫不为也。’况仆颇别菽麦者哉〖14〗！所以有怨望意者〖15〗，不自度量，苟以为首兴事业，而有投江阳之论；不解主公之意，意猝感激〖16〗，颇以被酒〖17〗，侻失‘老’语〖18〗。此仆之下愚薄虑所致，主公实未老也。且夫立业，岂在老少？西伯九十〖19〗，宁有衰志〖20〗！负我慈父〖21〗，罪有百死！至于‘内外’之言，欲使孟起立功北州〖22〗，戮力主公〖23〗，共讨曹操耳，宁敢有他志邪？孟起说之是也，但不分别其间，痛人心耳！昔每与庞统共相誓约：庶托足下末踪〖24〗，尽心于主公之业；追名古人，载勋竹帛。统不幸而死，仆败以取祸。自我堕之，将复谁怨？足下，当世伊、吕也〖25〗；宜善与主公计事，济其大猷〖26〗。天明地察，神祇有灵。复何言哉！贵使足下明仆本心耳。行矣，努力自爱，自爱！”","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":123,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":618,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-786cd608654a686a0b2e","section":"chapter-040","block":"b-582110e6a55ae84bfbde","layer":"pei","quote":"﹝一﹞臣松之以为：“分子之厚”者，羕言刘主分儿子厚恩，施之于己；故其书后语云“负我慈父，罪有百死”也。","attribution":"裴注·裴松之按","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":153,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4f439f6efc851dc62320","start":0,"end":51,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-ca0ac8de1d6d3dd403d1","section":"chapter-040","block":"b-a60256a46596492ac845","layer":"original","quote":"会先主入蜀，溯流北行。羕欲纳说先主〖1〗，乃往见庞统。统与羕非故人，又适有宾客；羕径上统床卧，谓统曰：“须客罢当与卿善谈〖2〗。”统客既罢，往就羕坐；羕又先责统食〖3〗，然后共语。因留信宿〖4〗，至于经日。统大善之，而法正宿自知羕：遂并致之先主","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":103,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":122,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-d9665bbb91f9df502fd4","section":"chapter-040","block":"b-c6ce1a9ba0d2a56939d4","layer":"original","quote":"评曰：刘封处嫌疑之地，而思防不足以自卫；彭羕、廖立以才拔进；李严以干局达〖1〗；魏延以勇略任；杨仪以当官显；刘琰旧仕〖2〗：并咸贵重。览其举措，迹其规矩〖3〗；招祸取咎，无不自己也〖4〗。","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":355,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":94,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-f473a6f7cdb981bbf2a6","section":"chapter-040","block":"b-57cbb5eb3fa7963089de","layer":"original","quote":"超羁旅归国〖11〗，常怀危惧；闻羕言大惊，默然不答。羕退，具表羕辞。于是收羕付有司","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":107,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":41,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-f614c7ec3598ca418de3","section":"chapter-040","block":"b-5d18130461e9c937e058","layer":"original","quote":"左迁羕为江阳太守〖7〗。羕闻当远出，私情不悦；往诣马超。超问羕曰：“卿才具秀拔，主公相待至重，谓卿当与孔明、孝直诸人齐足并驱〖8〗；宁当外授小郡〖9〗，失人本望乎","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":105,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":81,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o043c-q","section":"chapter-032","block":"b-4a221026fdb893201c62","layer":"original","quote":"先主复领益州牧：诸葛亮为股肱〖2〗，法正为谋主，关羽、张飞、马超为爪牙〖3〗，许靖、麋竺、简雍为宾友〖4〗。及董和、黄权、李严等〖5〗，本璋之所授用也，吴壹、费观等〖6〗，又璋之婚亲也；彭羕〖7〗，又璋之所排摈也；刘巴者〖8〗，宿昔之所忌恨也：皆处之显任，尽其器能。有志之士，无不竞劝。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":186,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":63,"end":206,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-b-dcc10490c7b3b72c467f","section":"chapter-032","block":"b-dcc10490c7b3b72c467f","layer":"modern","quote":"〖1〗十九年：建安十九年（公元 214）。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":188,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-dc65792cc6043766510a","start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o043","section":"chapter-032","block":"b-4a221026fdb893201c62","layer":"original","quote":"十九年夏〖1〗，雒城破；﹝一﹞进围成都，数十日，璋出降。﹝二﹞蜀中殷盛丰乐，先主置酒大飨士卒；取蜀城中金银分赐将士，还其谷帛。先主复领益州牧：诸葛亮为股肱〖2〗，法正为谋主，关羽、张飞、马超为爪牙〖3〗，许靖、麋竺、简雍为宾友〖4〗。及董和、黄权、李严等〖5〗，本璋之所授用也，吴壹、费观等〖6〗，又璋之婚亲也；彭羕〖7〗，又璋之所排摈也；刘巴者〖8〗，宿昔之所忌恨也：皆处之显任，尽其器能。有志之士，无不竞劝。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":186,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":206,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-9d9c6c3cd013f113898d","section":"chapter-038","block":"b-4724e70f37115927f07b","layer":"original","quote":"先主克蜀，以靖为左将军长史","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":148,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":7,"end":20,"offset_unit":"unicode_code_point"}],"profiles":{"xianzhu-p0064":{"fields":[{"id":"xianzhu-p0064-directory-courtesy","key":"courtesy","label":"字","text":"永年","evidence":["liuliao-q-20caedd4a9cadd6c705a"]}],"directory":{"faction":"shu"}}},"directory_counts":{}}
