2","chenghuang-q-4c0f42ed54449871bc1d","chenghuang-q-6524b496de6d4fc3699e","chenghuang-q-124a30c34c99bc4f0251","chenghuang-q-bf112d116ec72279ebfd","chenghuang-q-597d85d4ed9c6ed57b11","chenghuang-q-5561b24ab3f1f8f64c96","chenghuang-q-d91306ac00ae443dd100","chenghuang-q-2af66ba2e957082b2bcd","chenghuang-q-49e9e0ed3e3a1313826c","chenghuang-q-b7b4b90f784181da94a6","chenghuang-q-d607e19a3e092119922d"],"facts":[{"id":"chenghuang-f-d5303dc5fe0b83825de5","text":"字元代，会稽余姚人。","evidence":["chenghuang-q-b7b4b90f784181da94a6"]}],"aliases":[],"mentions":[{"id":"wuzhu-m-o012-wuzhu-p0008","kind":"mention","text":"文中提及","evidence":["wuzhu-q-o012"]},{"id":"chenghuang-m-9f973d29f3cbc7d5e44f","kind":"mention","text":"谢承《后汉书》称董袭志节慷慨武毅英烈。","evidence":["chenghuang-q-d607e19a3e092119922d"]}]}],"evidence":[{"id":"chenghuang-q-124a30c34c99bc4f0251","section":"chapter-055","block":"b-51a663db3a61e627f5f9","layer":"original","quote":"迁扬武都尉〖3〗，从策攻皖，又讨刘勋于寻阳，伐黄祖于江夏","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":175,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":98,"end":126,"offset_unit":"unicode_code_point"},{"id":"chenghuang-q-2af66ba2e957082b2bcd","section":"chapter-055","block":"b-1755db04481fee6cd409","layer":"original","quote":"其夜船败，袭死。权改服临殡，供给甚厚","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":179,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":18,"offset_unit":"unicode_code_point"},{"id":"chenghuang-q-49e9e0ed3e3a1313826c","section":"chapter-055","block":"b-de3662f0e4df848abd29","layer":"original","quote":"拜威越校尉〖6〗，迁偏将军。","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":176,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":160,"end":174,"offset_unit":"unicode_code_point"},{"id":"chenghuang-q-4c0f42ed54449871bc1d","section":"chapter-055","block":"b-51a663db3a61e627f5f9","layer":"original","quote":"孙策入郡，袭迎于高迁亭。策见而伟之，到，署门下贼曹","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":175,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":24,"end":49,"offset_unit":"unicode_code_point"},{"id":"chenghuang-q-5561b24ab3f1f8f64c96","section":"chapter-055","block":"b-471444036ab013326a61","layer":"original","quote":"建安十三年，权讨黄祖。祖横两蒙冲，挟守沔口；以栟闾大绁系石为碇〖7〗。上有千人，以弩交射，飞矢雨下，军不得前。袭与凌统俱为前部，各将敢死百人；人被两铠〖8〗，乘大舸船，突入蒙冲里〖9〗。袭身以刀断两绁，蒙冲乃横流。大兵遂进，祖便开门走，兵追斩之。明日大会，权举觞属袭曰〖10〗：“今日之会，断绁之功也","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":177,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":150,"offset_unit":"unicode_code_point"},{"id":"chenghuang-q-597d85d4ed9c6ed57b11","section":"chapter-055","block":"b-de3662f0e4df848abd29","layer":"original","quote":"鄱阳贼彭虎等众数万人，袭与凌统、步骘、蒋钦各别分讨。袭所向辄破，虎等望见旌旗，便散走，旬日尽平。拜威越校尉〖6〗，迁偏将军","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":176,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":112,"end":173,"offset_unit":"unicode_code_point"},{"id":"chenghuang-q-6524b496de6d4fc3699e","section":"chapter-055","block":"b-51a663db3a61e627f5f9","layer":"original","quote":"时山阴宿贼黄龙罗、周勃聚党数千人〖2〗，策自出讨。袭身斩罗、勃首，还拜别部司马，授兵数千","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":175,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":53,"end":97,"offset_unit":"unicode_code_point"},{"id":"chenghuang-q-b7b4b90f784181da94a6","section":"chapter-055","block":"b-51a663db3a61e627f5f9","layer":"original","quote":"董袭字元代，会稽余姚人。","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":175,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":12,"offset_unit":"unicode_code_point"},{"id":"chenghuang-q-bf112d116ec72279ebfd","section":"chapter-055","block":"b-de3662f0e4df848abd29","layer":"original","quote":"策薨，权年少，初统事。太妃忧之，引见张昭及袭等，问：“江东可保安否？”袭对曰：“江东地势，有山川之固；而讨逆明府〖4〗，恩德在民。讨虏承基〖5〗，大小用命；张昭秉众事，袭等为爪牙。此地利、人和之时也！万无所忧。”众皆壮其言","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":176,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":111,"offset_unit":"unicode_code_point"},{"id":"chenghuang-q-d607e19a3e092119922d","section":"chapter-055","block":"b-e3bce6c36d34d3266bdd","layer":"pei","quote":"﹝一﹞谢承《后汉书》称袭“志节慷慨，武毅英烈”。","attribution":"谢承《后汉书》","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":194,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-99e337be6186e7d5a4e5","start":0,"end":24,"offset_unit":"unicode_code_point"},{"id":"chenghuang-q-d91306ac00ae443dd100","section":"chapter-055","block":"b-6db1564c29599b4347ba","layer":"original","quote":"曹公出濡须，袭从权赴之；使袭督五楼船；住濡须口。夜猝暴风，五楼船倾覆。左右散走舸，乞使袭出。袭怒曰：“受将军任，在此备贼，何等委去也〖11〗！敢复言此者斩！”于是莫敢干","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":178,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":84,"offset_unit":"unicode_code_point"},{"id":"wuzhu-e-o012a-q","section":"chapter-047","block":"b-3843def972d8a772cdb3","layer":"original","quote":"十三年春〖1〗，权复征黄祖。祖先遣舟兵拒军，都尉吕蒙破其前锋；而凌统、董袭等尽锐攻之〖2〗，遂屠其城。祖挺身亡走〖3〗。骑士冯则追枭其首〖4〗，虏其男女数万口。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":60,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":80,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o012","section":"chapter-047","block":"b-3843def972d8a772cdb3","layer":"original","quote":"十三年春〖1〗，权复征黄祖。祖先遣舟兵拒军，都尉吕蒙破其前锋；而凌统、董袭等尽锐攻之〖2〗，遂屠其城。祖挺身亡走〖3〗。骑士冯则追枭其首〖4〗，虏其男女数万口。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":60,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":80,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-o064","section":"chapter-010","block":"b-38f29d879d5ca24386ff","layer":"original","quote":"建安十三年，太祖破荆州，欲顺江东下。诩谏曰：“明公昔破袁氏，今收汉南；威名远著，军势既大。若乘旧楚之饶，以飨吏士；抚安百姓，使安土乐业；则可不劳众而江东稽服矣〖4〗。”太祖不从，军遂无利。﹝一﹞","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":314,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":97,"offset_unit":"unicode_code_point"},{"id":"zhouyu-q-b-63f47c62fde80b3a0132","section":"chapter-054","block":"b-63f47c62fde80b3a0132","layer":"modern","quote":"〖6〗十三年：建安十三年（公元 208）。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":43,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8f109f42647e5ee8d831","start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"zhouyu-q-o009","section":"chapter-054","block":"b-3661896c106f1817bf4b","layer":"original","quote":"十三年春〖6〗，权讨江夏，瑜为前部大督〖7〗。其年九月，曹公入荆州，刘琮举众降。曹公得其水军船，步兵数十万。将士闻之皆恐。（惧）〔权〕延见群下〖8〗，问以计策。议者咸曰：“曹公，豺虎也！然托名汉相，挟天子以征四方，动以朝廷为辞；今日拒之，事更不顺。且将军大势：可以拒操者，长江也。今操得荆州，奄有其地〖9〗；刘表治水军，蒙冲、斗舰〖10〗，乃以千数，操悉浮以沿江；兼有步兵，水陆俱下。此为长江之险，已与我共之矣。而势力众寡，又不可论。愚谓大计不如迎之。”","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":34,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":227,"offset_unit":"unicode_code_point"}],"profiles":{"wuzhu-p0008":{"fields":[{"id":"wuzhu-p0008-directory-courtesy","key":"courtesy","label":"字","text":"元代","evidence":["chenghuang-q-b7b4b90f784181da94a6"]}],"directory":{"faction":"wu"}}},"directory_counts":{}}
