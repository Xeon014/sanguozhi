{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[],"persons":[{"id":"zhonghua-p2-wangyun","name":"王恽（王肃子）","evidence":["zhonghua-q-1017c5ee175173acf2b6"],"facts":[{"id":"zhonghua-f2-23254ec3d84f7e2887ce","text":"王恽为王肃子，嗣爵，薨而无子，国绝。","evidence":["zhonghua-q-1017c5ee175173acf2b6"]}],"aliases":[],"mentions":[]}],"evidence":[{"id":"zhonghua-q-1017c5ee175173acf2b6","section":"chapter-013","block":"b-c6f3491cc135ba272948","layer":"original","quote":"子恽嗣。恽薨，无子，国绝。景元四年，封肃子恂，为兰陵侯。咸熙中，开建五等；以肃著勋前朝，改封恂为氶子〖12〗。﹝一﹞","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":483,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":58,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
