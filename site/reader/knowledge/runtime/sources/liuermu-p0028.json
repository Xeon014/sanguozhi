b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fd307a7978039f12ea65","start":95,"end":112,"offset_unit":"unicode_code_point"},{"id":"liuermu-q-359d77e4bc9302127841","section":"chapter-031","block":"b-28361ed8be9ef5b608e1","layer":"original","quote":"焉谋得施，出为监军使者〖16〗，领益州牧，封阳城侯，当收俭治罪","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":3,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":47,"end":78,"offset_unit":"unicode_code_point"},{"id":"liuermu-q-57e016789cb8016a6065","section":"chapter-031","block":"b-9937d06d1efb6f3cd914","layer":"original","quote":"便前破雒县，攻益州杀俭〖21〗，又到蜀郡、犍为〖22〗；旬月之间，破坏三郡","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":4,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":72,"end":109,"offset_unit":"unicode_code_point"},{"id":"liuermu-q-61ce836922a05cc2aad9","section":"chapter-031","block":"b-62d3ec73a6bf5de7f0ed","layer":"pei","quote":"帝引见焉，宣示方略，加以赏赐","attribution":"裴注·汉灵帝纪","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":34,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fd307a7978039f12ea65","start":9,"end":23,"offset_unit":"unicode_code_point"},{"id":"liuermu-q-63a830cbafaeabe66d38","section":"chapter-031","block":"b-62d3ec73a6bf5de7f0ed","layer":"pei","quote":"敕：‘焉为益州刺史。前刺史刘隽、郤俭，皆贪残放滥，取受狼藉；元元无聊，呼嗟充野。焉到，便收摄行法，以示万姓；勿令漏露，使痈疽决溃，为国生梗","attribution":"裴注·汉灵帝纪","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":34,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fd307a7978039f12ea65","start":24,"end":93,"offset_unit":"unicode_code_point"},{"id":"liuermu-q-c94efe99e6b19509f7f9","section":"chapter-031","block":"b-28361ed8be9ef