ence":["wufan-q-369691d7d06512e92eb6"]},{"id":"wufan-m-7f052ccdfaa1f7156310","kind":"mention","text":"本篇记载：名儒刁玄称其著书以为奇","evidence":["wufan-q-7e05e0b92b8a569a18a9"]},{"id":"wufan-m-3854d796207878c5ede4","kind":"mention","text":"本篇记载：亦宝爱其术，不以告人；故世莫得而明也","evidence":["wufan-q-c23fafbfaab2abd4d2fe"]}],"aliases":[]}],"evidence":[{"id":"wufan-q-259ce80ec691c83fea75","section":"chapter-063","block":"b-4756992061338dc7e698","layer":"original","quote":"每有水旱寇贼，皆先时处期〖4〗，无不中者","section_title":"吴范刘惇赵达传第十八","source":{"file":"OEBPS/Text/titlepage_0133.xhtml","index":54,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"wufan-q-369691d7d06512e92eb6","section":"chapter-063","block":"b-52e9049ea13a2705a189","layer":"original","quote":"惇于诸术皆善，尤明太乙〖8〗；皆能推演其事，穷尽要妙","section_title":"吴范刘惇赵达传第十八","source":{"file":"OEBPS/Text/titlepage_0133.xhtml","index":55,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":26,"offset_unit":"unicode_code_point"},{"id":"wufan-q-75ed2a21056f6cf45208","section":"chapter-063","block":"b-301da1de3d18a5b5b588","layer":"original","quote":"评曰：三子各于其术精矣，其用思妙矣；然君子（算）〔等〕役心神〖1〗，宜于大者远者。是以有识之士，舍彼而取此也。﹝一﹞","section_title":"吴范刘惇赵达传第十八","source":{"file":"OEBPS/Text/titlepage_0133.xhtml","index":111,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":58,"offset_unit":"unicode_code_point"},{"id":"wufan-q-7e05e0b92b8a569a18a9","section":"chapter-063","block":"b-52e9049ea13a2705a189","layer":"original","quote":"名儒刁玄称以为奇","section_title":"吴范刘惇赵达传第十八","source":{"file":"OEBPS/Text/titlepage_0133.xhtml","index":55,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":33,"end":41,"offset_unit":"unicode_code_point"},{"id":"wufan-q-9c9ea6326dfe4bf041b4","section":"chapter-063","block":"b-cbd06593206ca2b2b3e0","layer":"original","quote":"刘惇字子仁，平原人也","section_title":"吴范刘惇赵达传第十八","source":{"file":"OEBPS/Text/titlepage_0133.xhtml","index":53,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":10,"offset_unit":"unicode_code_point"},{"id":"wufan-q-9eb045ddcba72712179c","section":"chapter-063","block":"b-cbd06593206ca2b2b3e0","layer":"original","quote":"刘惇字子仁，平原人也〖1〗。遭乱避地，客游庐陵，事孙辅〖2〗。以明天官、达占数，显于南土〖3〗。","section_title":"吴范刘惇赵达传第十八","source":{"file":"OEBPS/Text/titlepage_0133.xhtml","index":53,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":48,"offset_unit":"unicode_code_point"},{"id":"wufan-q-9f7570e1a04a6b70f98f","section":"chapter-063","block":"b-4756992061338dc7e698","layer":"original","quote":"军中咸敬事之，号曰“神明”","section_title":"吴范刘惇赵达传第十八","source":{"file":"OEBPS/Text/titlepage_0133.xhtml","index":54,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":30,"end":43,"offset_unit":"unicode_code_point"},{"id":"wufan-q-a589ac9a55c31dc88fa4","section":"chapter-063","block":"b-4756992061338dc7e698","layer":"original","quote":"每有水旱寇贼，皆先时处期〖4〗，无不中者。辅异焉，以为军师。军中咸敬事之，号曰“神明”。建安中，孙权在豫章。时有星变〖5〗，以问惇。惇曰：“灾在丹杨。”权曰：“何如？”曰：“客胜主人。到某日，当得问〖6〗。”是时边鸿作乱〖7〗，卒如惇言。","section_title":"吴范刘惇赵达传第十八","source":{"file":"OEBPS/Text/titlepage_0133.xhtml","index":54,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":119,"offset_unit":"unicode_code_point"},{"id":"wufan-q-aaa34965a01bb9902ccd","section":"chapter-063","block":"b-cbd06593206ca2b2b3e0","layer":"original","quote":"遭乱避地，客游庐陵，事孙辅","section_title":"吴范刘惇赵达传第十八","source":{"file":"OEBPS/Text/titlepage_0133.xhtml","index":53,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":14,"end":27,"offset_unit":"unicode_code_point"},{"id":"wufan-q-c23fafbfaab2abd4d2fe","section":"chapter-063","block":"b-52e9049ea13a2705a189","layer":"original","quote":"惇亦宝爱其术，不以告人；故世莫得而明也","section_title":"吴范刘惇赵达传第十八","source":{"file":"OEBPS/Text/titlepage_0133.xhtml","index":55,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":42,"end":61,"offset_unit":"unicode_code_point"},{"id":"wufan-q-e2909d1d1072ed5f7166","section":"chapter-063","block":"b-52e9049ea13a2705a189","layer":"original","quote":"惇于诸术皆善，尤明太乙〖8〗；皆能推演其事，穷尽要妙。著书百余篇，名儒刁玄称以为奇。惇亦宝爱其术，不以告人；故世莫得而明也。","section_title":"吴范刘惇赵达传第十八","source":{"file":"OEBPS/Text/titlepage_0133.xhtml","index":55,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":62,"offset_unit":"unicode_code_point"},{"id":"wufan-q-ec06821516bf1d3551b3","section":"chapter-063","block":"b-cbd06593206ca2b2b3e0","layer":"original","quote":"以明天官、达占数，显于南土","section_title":"吴范刘惇赵达传第十八","source":{"file":"OEBPS/Text/titlepage_0133.xhtml","index":53,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":31,"end":44,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
