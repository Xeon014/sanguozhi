ei-q-586dd66a5eef84dcf691","wangwei-q-b62a666fc91e1707f359","wangwei-q-51715033eec231a57703","wangwei-q-c7adb032f07a83fa24e0","wangwei-q-930868e81c5ea64b9912","wangwei-q-6f7696c371edc675fc69","wangwei-q-19ca1e48af885a691b8a","wangwei-q-f926fd837274fc880c1e","wangwei-q-e7d5ba0aa85c65eb056f","wangwei-q-0e8b21d0a0ab876ce98d","wangwei-q-60c19279842b84430f86","wangwei-q-a05225647f434b5ce635","wangwei-q-7b11eea244a22eb3b840","wangwei-q-e4eb8fda6ae4959208f4","wangwei-q-864aafc6aa703ad138fd","wangwei-q-2a62e4433480cee2999f"],"facts":[{"id":"wangwei-f-1fa83bb8d64461da6c61","text":"字季重。","evidence":["wangwei-q-2a62e4433480cee2999f"]}],"mentions":[{"id":"shiyi-m-0204d4d377aba2ff2d63","kind":"mention","text":"本篇记载：魏都督河北、振威将军","evidence":["shiyi-q-17808203fc985e329d27"]}],"aliases":[]}],"evidence":[{"id":"hancui-q-60813447cf47bcb07154","section":"chapter-024","block":"b-d9eebab382f9031831f0","layer":"original","quote":"北中郎将吴质统河北军事〖8〗，涿郡太守王雄谓林别驾曰：“吴中郎将，上所亲重〖9〗，国之贵臣也。仗节统事〖10〗，州郡莫不奉笺致敬，而崔使君初不与相闻〖11〗。若以边塞不修斩卿，使君宁能护卿邪？”","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":44,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":16,"end":113,"offset_unit":"unicode_code_point"},{"id":"hancui-q-6d211796e3eeb0dee898","section":"chapter-024","block":"b-5084d3acfa7140382e55","layer":"original","quote":"别驾具以白林，林曰：“刺史视去此州如脱屣〖12〗，宁当相累邪〖13〗？此州与胡虏接，宜镇之以静；扰之则动其逆心，特为国家生北顾忧，以此为寄〖14〗。”在官一期〖15〗，寇窃寝息；﹝一﹞犹以不事上司〖16〗，左迁河间太守。清论多为林怨也〖17〗。﹝二﹞","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":45,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":125,"offset_unit":"unicode_code_point"},{"id":"hancui-q-acf8710510b3b772555a","section":"chapter-024","block":"b-17550ad301cf38d67635","layer":"pei","quote":"﹝二﹞《魏名臣奏》载侍中辛毗奏曰：“昔桓阶为尚书令，以崔林非尚书才，迁以为河间太守。”与此传不同。","attribution":"裴注·魏名臣奏·辛毗奏","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":76,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cbbf4911c0987174013d","start":0,"end":49,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-165e357b80a9891e44d6","section":"chapter-019","block":"b-5bf7cee45fb52872f5e1","layer":"pei","quote":"《世语》曰：“修年二十五，以名公子，有才能，为太祖所器。与丁仪兄弟，皆欲以植为嗣。太子患之，以车载废簏，纳朝歌长吴质，与谋。修以白太祖，未及推验；太子惧，告质。质曰：‘何患？明日，复以簏受绢车内以惑之，修必复重白；重白必推，而无验，则彼受罪矣。’世子从之，修果白；而无人，太祖由是疑焉。","attribution":"裴注引《世语》","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":66,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8d693fbc0efee664288c","start":0,"end":143,"offset_unit":"unicode_code_point"},{"id":"shiyi-q-17808203fc985e329d27","section":"chapter-062","block":"b-a011eff8f08ca6fbace5","layer":"original","quote":"魏都督河北、振威将军吴质","section_title":"是仪胡综传第十七","source":{"file":"OEBPS/Text/titlepage_0131.xhtml","index":107,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":36,"end":48,"offset_unit":"unicode_code_point"},{"id":"shiyi-q-f806933660b8e4adb3a1","section":"chapter-062","block":"b-dff3535ff9a7a12bc0f9","layer":"original","quote":"此文既流行，而质已入为侍中矣","section_title":"是仪胡综传第十七","source":{"file":"OEBPS/Text/titlepage_0131.xhtml","index":116,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":14,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-0e8b21d0a0ab876ce98d","section":"chapter-021","block":"b-45aa9df3db865e3b44ff","layer":"pei","quote":"质其年夏卒","attribution":"裴注·质别传","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":175,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9a9058837611f78acdc3","start":526,"end":531,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-19ca1e48af885a691b8a","section":"chapter-021","block":"b-45aa9df3db865e3b44ff","layer":"pei","quote":"及文帝崩，质思慕作诗曰：‘怆怆怀殷忧，殷忧不可居。徙倚不能坐，出入步踟蹰。念蒙圣主恩，荣爵与众殊。自谓永终身，志气甫当舒。何意中见弃，弃我归黄垆。茕茕靡所恃，泪下如连珠。随没无所益，身死名不书。慷慨自\\俛，庶几烈丈夫。’","attribution":"裴注·质别传","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":175,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9a9058837611f78acdc3","start":294,"end":404,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-2a62e4433480cee2999f","section":"chapter-021","block":"b-55bdddb7d125b86504f3","layer":"pei","quote":"﹝四﹞《魏略》曰：“质字季重。以才学通博，为五官将及诸侯所礼爱；质亦善处其兄弟之间，若前世楼君卿之游五侯矣。及河北平定，（大将军）〔五官将〕为世子，质与刘桢等并在坐席。桢坐谴之际，质出为朝歌长。后迁元城令。其后大（将）军西征，太子南在孟津小城，与质书曰：‘季重无恙：途路虽局，官守有限；愿言之怀，良不可任！足下所治僻左，书问致简，益用增劳。每念昔日南皮之游，诚不可忘。既妙思六经，逍遥百氏；弹棋闲设，终以博弈；高谈娱心，哀筝顺耳；驰骛北场，旅食南馆；浮甘瓜于清泉，沉朱李于寒水。皦日既没，继以朗月；同乘并载，以游后园；舆轮徐动，宾从无声；清风夜起，悲笳微吟；乐往哀来，凄然伤怀。余顾而言，兹乐难常；足下之徒，咸以为然。今果分别，各在一方；元瑜长逝，化为异物。每一念至，何时可言！方今蕤宾纪辰，景风扇物；天气和暖，众果具繁；时驾而游，北遵河曲；从者鸣笳以启路，文学托乘于后车；节同时异，物是人非。我劳如何！今遣骑到邺，故使枉道相过。行矣，自爱！’二十三年，太子又与质书曰：‘岁月易得，别来行复四年。三年不见，《东山》犹叹其远；况乃过之，思何可支！虽书疏往返，未足解其劳结。昔年疾疫，亲故多罹其灾；徐、陈、应、刘，一时俱逝，痛何可言邪！昔日游处，行则同舆，止则接席，何尝须臾相失？每至觞酌流行，丝竹并奏；酒酣耳热，仰而赋诗。当此之时，忽然不自知乐也。谓百年己分，长共相保；何图数年之间，零落略尽，言之伤心！顷撰其遗文，都为一集；观其姓名，已为鬼录。追思昔游，犹在心目；而此诸子化为粪壤，可复道哉！观古今文人，类不护细行，鲜能以名节自立。而伟长独怀文抱质，恬淡寡欲，有箕山之志，可谓彬彬君子矣。著《中论》二十余篇，成一家之业；辞义典雅，足传于后。此子为不朽矣。德琏常斐然有述作意，才学足以著书；美志不遂，良可痛惜！间历观诸子之文，对之抆泪；既痛逝者，行自念也。孔璋章表殊健，微为繁富。公幹有逸气，但未遒耳；至其五言诗，妙绝当时。元瑜书记翩翩，致足乐也。仲宣独自善于辞赋，惜其体弱，不足起其文；至于所善，古人无以远过也。昔伯牙绝弦于钟期，仲尼覆醢于子路；愍知音之难遇，伤门人之莫逮也。诸子但为未及古人，自一时之俊也，今之存者已不逮矣。后生可畏，来者难诬，然吾与足下不及见也。行年已长大，所怀万端；时有所虑，至乃通夕不瞑。何时复类昔日！已成老翁，但未白头耳。光武言“年已三十，在军十年，所更非一”，吾德虽不及，年与之齐。以犬羊之质，服虎豹之文；无众星之明，假日月之光；动见观瞻，何时易邪？恐永不复得为昔日游也。少壮真当努力，年一过往，何可攀援！古人思秉烛夜游，良有以也。顷何以自娱？颇复有所造述不？东望于邑，裁书叙心。’”","attribution":"裴注引《魏略》","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":171,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9a9058837611f78acdc3","start":0,"end":1106,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-4a67d147ea8d21b236d3","section":"chapter-021","block":"b-f92db40e0f8f20a2620c","layer":"pei","quote":"及魏有天下，文帝征质，与车驾会洛阳","attribution":"裴注·注家按语","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":173,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9a9058837611f78acdc3","start":95,"end":112,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-51715033eec231a57703","section":"chapter-021","block":"b-45aa9df3db865e3b44ff","layer":"pei","quote":"帝尝召质及曹休欢会，命郭后出见质等。帝曰：‘卿仰谛视之","attribution":"裴注·质别传","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":175,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9a9058837611f78acdc3","start":8,"end":35,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-586dd66a5eef84dcf691","section":"chapter-021","block":"b-f92db40e0f8f20a2620c","layer":"pei","quote":"太和中，入朝；质自以不为本郡所饶，谓司徒董昭曰：“我欲溺乡里耳！”昭曰：“君且止，我年八十，不能老为君溺攒也","attribution":"裴注·注家按语","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":173,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9a9058837611f78acdc3","start":141,"end":195,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-60c19279842b84430f86","section":"chapter-021","block":"b-45aa9df3db865e3b44ff","layer":"pei","quote":"质先以怙威肆行，谥曰丑侯","attribution":"裴注·质别传","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":175,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9a9058837611f78acdc3","start":532,"end":544,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-6f7696c371edc675fc69","section":"chapter-021","block":"b-45aa9df3db865e3b44ff","layer":"pei","quote":"质按剑曰：‘曹子丹！汝非屠几上肉，吴质吞尔不摇喉，咀尔不摇牙，何敢恃势骄邪！’铄因起曰：‘陛下使吾等来乐卿耳，乃至此邪！’质顾叱之曰：‘朱铄，敢坏坐！’诸将军皆还坐。铄性急，愈恚，还，拔剑斩地。遂便罢也","attribution":"裴注·质别传","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":175,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9a9058837611f78acdc3","start":192,"end":293,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-7b11eea244a22eb3b840","section":"chapter-021","block":"b-55bdddb7d125b86504f3","layer":"pei","quote":"其后大（将）军西征，太子南在孟津小城，与质书曰：‘季重无恙：途路虽局，官守有限；愿言之怀，良不可任！足下所治僻左，书问致简，益用增劳。每念昔日南皮之游，诚不可忘。既妙思六经，逍遥百氏；弹棋闲设，终以博弈；高谈娱心，哀筝顺耳；驰骛北场，旅食南馆；浮甘瓜于清泉，沉朱李于寒水。皦日既没，继以朗月；同乘并载，以游后园；舆轮徐动，宾从无声；清风夜起，悲笳微吟；乐往哀来，凄然伤怀。余顾而言，兹乐难常；足下之徒，咸以为然。今果分别，各在一方；元瑜长逝，化为异物。每一念至，何时可言！方今蕤宾纪辰，景风扇物；天气和暖，众果具繁；时驾而游，北遵河曲；从者鸣笳以启路，文学托乘于后车；节同时异，物是人非。我劳如何！今遣骑到邺，故使枉道相过。行矣，自爱！’","attribution":"裴注引《魏略》","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":171,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9a9058837611f78acdc3","start":103,"end":422,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-85ad5b8fc7c644054383","section":"chapter-021","block":"b-f92db40e0f8f20a2620c","layer":"pei","quote":"到，拜北中郎将，封列侯，使持节，督幽、并诸军事，治信都","attribution":"裴注·注家按语","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":173,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9a9058837611f78acdc3","start":113,"end":140,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-864aafc6aa703ad138fd","section":"chapter-021","block":"b-abff566fe5dbd3aec6f6","layer":"original","quote":"吴质，济阴人〖16〗，以文才为文帝所善。官至振威将军〖17〗，假节都督河北诸军事〖18〗，封列侯〖19〗。﹝四﹞","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":136,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":56,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-930868e81c5ea64b9912","section":"chapter-021","block":"b-45aa9df3db865e3b44ff","layer":"pei","quote":"酒酣，质欲尽欢。时上将军曹真性肥，中领军朱铄性瘦；质召优，使说肥瘦","attribution":"裴注·质别传","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":175,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9a9058837611f78acdc3","start":73,"end":106,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-a05225647f434b5ce635","section":"chapter-021","block":"b-611ee000e970477e3751","layer":"original","quote":"文帝书与元城令吴质曰〖6〗：“昔年疾疫，亲故多罹其灾；徐、陈、应、刘，一时俱逝。观古今文人，类不护细行〖7〗，鲜能以名节自立。而伟长独怀文抱质，恬淡寡欲，有箕山之志〖8〗，可谓彬彬君子矣。著《中论》二十余篇〖9〗，辞义典雅，足传于后。德琏常斐然有述作意〖10〗，其才学足以著书；美志不遂，良可痛惜！孔璋章表殊健〖11〗，微为繁富〖12〗。公幹有逸气〖13〗，但未遒耳〖14〗。元瑜书记翩翩〖15〗，致足乐也。仲宣独自善于辞赋〖16〗，惜其体弱，不〔足〕起其文；至于所善，古人无以远过也〖17〗。昔伯牙绝弦于钟期〖18〗，仲尼覆醢于子路〖19〗；痛知音之难遇，伤门人之莫逮也〖20〗。诸子但为未及古人，自一时之俊也。”﹝三﹞","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":96,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":311,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-b62a666fc91e1707f359","section":"chapter-021","block":"b-9ceb5fd2b4c40b89d592","layer":"pei","quote":"世子怅然自失，吴质耳曰：‘王当行，流涕可也。’及辞，世子泣而拜，王及左右咸歔欷；于是皆以植辞多华，而诚心不及也","attribution":"裴注·世语","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":174,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9a9058837611f78acdc3","start":47,"end":102,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-c7adb032f07a83fa24e0","section":"chapter-021","block":"b-45aa9df3db865e3b44ff","layer":"pei","quote":"质黄初五年朝京师，诏上将军及特进以下，皆会质所，太官给供具","attribution":"裴注·质别传","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":175,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9a9058837611f78acdc3","start":43,"end":72,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-e4804ab7a71f5e4be1aa","section":"chapter-021","block":"b-55bdddb7d125b86504f3","layer":"pei","quote":"后迁元城令","attribution":"裴注·魏略","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":171,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9a9058837611f78acdc3","start":97,"end":102,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-e4eb8fda6ae4959208f4","section":"chapter-021","block":"b-55bdddb7d125b86504f3","layer":"pei","quote":"二十三年，太子又与质书曰：‘岁月易得，别来行复四年。三年不见，《东山》犹叹其远；况乃过之，思何可支！虽书疏往返，未足解其劳结。昔年疾疫，亲故多罹其灾；徐、陈、应、刘，一时俱逝，痛何可言邪！昔日游处，行则同舆，止则接席，何尝须臾相失？每至觞酌流行，丝竹并奏；酒酣耳热，仰而赋诗。当此之时，忽然不自知乐也。谓百年己分，长共相保；何图数年之间，零落略尽，言之伤心！顷撰其遗文，都为一集；观其姓名，已为鬼录。追思昔游，犹在心目；而此诸子化为粪壤，可复道哉！观古今文人，类不护细行，鲜能以名节自立。而伟长独怀文抱质，恬淡寡欲，有箕山之志，可谓彬彬君子矣。著《中论》二十余篇，成一家之业；辞义典雅，足传于后。此子为不朽矣。德琏常斐然有述作意，才学足以著书；美志不遂，良可痛惜！间历观诸子之文，对之抆泪；既痛逝者，行自念也。孔璋章表殊健，微为繁富。公幹有逸气，但未遒耳；至其五言诗，妙绝当时。元瑜书记翩翩，致足乐也。仲宣独自善于辞赋，惜其体弱，不足起其文；至于所善，古人无以远过也。昔伯牙绝弦于钟期，仲尼覆醢于子路；愍知音之难遇，伤门人之莫逮也。诸子但为未及古人，自一时之俊也，今之存者已不逮矣。后生可畏，来者难诬，然吾与足下不及见也。行年已长大，所怀万端；时有所虑，至乃通夕不瞑。何时复类昔日！已成老翁，但未白头耳。光武言“年已三十，在军十年，所更非一”，吾德虽不及，年与之齐。以犬羊之质，服虎豹之文；无众星之明，假日月之光；动见观瞻，何时易邪？恐永不复得为昔日游也。少壮真当努力，年一过往，何可攀援！古人思秉烛夜游，良有以也。顷何以自娱？颇复有所造述不？东望于邑，裁书叙心。’","attribution":"裴注引《魏略》","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":171,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9a9058837611f78acdc3","start":422,"end":1105,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-e7d5ba0aa85c65eb056f","section":"chapter-021","block":"b-45aa9df3db865e3b44ff","layer":"pei","quote":"对帝盛称：‘骠骑将军司马懿，忠智至公，社稷之臣也；陈群从容之士，非国相之才，处重任而不亲事","attribution":"裴注·质别传","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":175,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9a9058837611f78acdc3","start":442,"end":487,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-ee7a8dded99635774b7e","section":"chapter-021","block":"b-55bdddb7d125b86504f3","layer":"pei","quote":"桢坐谴之际，质出为朝歌长","attribution":"裴注·魏略","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":171,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9a9058837611f78acdc3","start":84,"end":96,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-f03101090611b2181fde","section":"chapter-021","block":"b-7b9e5dc71ffaea602941","layer":"pei","quote":"臣松之以本传虽略载太子此书，美辞多被删落，今故悉取《魏略》所述，以备其文。太子即王位，又与质书曰：“南皮之游，存者三人。烈祖龙飞，或将或侯；今惟吾子，栖迟下仕。从我游处，独不及门；瓶罄罍耻，能无怀愧？路不云远，今复相闻。”","attribution":"裴注引曹丕书","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":172,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9a9058837611f78acdc3","start":0,"end":111,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-f926fd837274fc880c1e","section":"chapter-021","block":"b-45aa9df3db865e3b44ff","layer":"pei","quote":"太和四年，入为侍中","attribution":"裴注·质别传","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":175,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9a9058837611f78acdc3","start":404,"end":413,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
