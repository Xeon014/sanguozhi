nce":["zhanggu-q-7b6b8290d820884416dd","zhangyan-q-47cf115473c2c3f50f42","zhangyan-q-f6214c8256c15d979f16","zhangyan-q-33bde7d56eb159afa45b","zhangyan-q-34577d9a659bc2d97c9d"],"facts":[{"id":"zhangyan-f-a7aaad9009123306cd32","text":"字彦黄，下邳人","evidence":["zhangyan-q-34577d9a659bc2d97c9d"]},{"id":"zhangyan-f-1886593a33ae46f6ccc9","text":"亦有学行","evidence":["zhangyan-q-34577d9a659bc2d97c9d"]}],"aliases":[],"mentions":[{"id":"zhanggu-m-e139e7dcb028ea1352f4","kind":"mention","text":"本段涉及裴玄","evidence":["zhanggu-q-7b6b8290d820884416dd"]}]}],"evidence":[{"id":"zhanggu-q-7b6b8290d820884416dd","section":"chapter-052","block":"b-7abbb76c1fc797b2239e","layer":"original","quote":"骘于是条于时事业在荆州界者〖11〗，诸葛瑾、陆逊、朱然（程普）〔程秉〕、潘濬、裴玄、夏侯承、卫旌、李肃、﹝一﹞周条、石幹十一人〖12〗，甄别行状〖13〗。因上疏奖劝曰：“臣闻人君不亲小事，百官有司各任其职。故舜命九贤〖14〗，则无所用心〖15〗；弹五弦之琴，咏南风之诗〖16〗：不下堂庙，而天下治也。齐桓用管仲，被发载车〖17〗；齐国既治，又致匡合〖18〗。近汉高祖揽三杰以兴帝业〖19〗，西楚失雄俊以丧成功〖20〗。汲黯在朝〖21〗，淮南寝谋〖22〗；郅都守边〖23〗，匈奴窜迹。故贤人所在，折冲万里〖24〗；信国家之利器，崇替之所由也〖25〗。方今王化未被于汉北〖26〗，河、洛之滨尚有僭逆之丑〖27〗：诚揽英雄拔俊任贤之时也。愿明太子重以经意，则天下幸甚！”","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":386,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":332,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-33bde7d56eb159afa45b","section":"chapter-053","block":"b-24636bc7d939d25297d9","layer":"original","quote":"问子钦齐桓、晋文、夷、惠四人优劣〖11〗，钦答所见；与玄相反覆，各有文理","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":83,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":26,"end":62,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-34577d9a659bc2d97c9d","section":"chapter-053","block":"b-24636bc7d939d25297d9","layer":"original","quote":"玄字彦黄，下邳人也。亦有学行〖10〗，官至太中大夫。问子钦齐桓、晋文、夷、惠四人优劣〖11〗，钦答所见；与玄相反覆，各有文理。钦与太子登游处，登称其翰采〖12〗。","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":83,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":81,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-47cf115473c2c3f50f42","section":"chapter-053","block":"b-bc5ca8e4e139a99bc746","layer":"original","quote":"又与裴玄、张承论管仲、季路〖9〗：皆传于世","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":82,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":14,"end":35,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-f6214c8256c15d979f16","section":"chapter-053","block":"b-24636bc7d939d25297d9","layer":"original","quote":"官至太中大夫","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":83,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":19,"end":25,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
