p0034","kind":"mention","text":"文中提及","evidence":["houfei-q-o022"]},{"id":"houfei-m-o023-houfei-p0034","kind":"mention","text":"文中提及","evidence":["houfei-q-o023"]},{"id":"houfei-m-o024-houfei-p0034","kind":"mention","text":"文中提及","evidence":["houfei-q-o024"]},{"id":"houfei-m-o025-houfei-p0034","kind":"mention","text":"文中提及","evidence":["houfei-q-o025"]},{"id":"houfei-m-o029-houfei-p0034","kind":"mention","text":"文中提及","evidence":["houfei-q-o029"]}]}],"evidence":[{"id":"houfei-e-o022a-q","section":"chapter-005","block":"b-31288da490b4d6270504","layer":"original","quote":"太和元年三月，以中山魏昌之安城乡户千〖2〗，追封逸，谥曰敬侯；嫡孙像，袭爵。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":94,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":38,"offset_unit":"unicode_code_point"},{"id":"houfei-e-o023b-q","section":"chapter-005","block":"b-726e392875bbc6d22fbc","layer":"original","quote":"四月，初营宗庙，掘地得玉玺；方一寸九分〖3〗，其文曰“天子羡思慈亲”〖4〗。明帝为之改容〖5〗，以太牢告庙，又尝梦见后；于是差次舅氏亲疏高下〖6〗，叙用各有差〖7〗；赏赐累巨万；以像为虎贲中郎将〖8〗。是月，后母薨，帝制缌服临丧〖9〗，百僚陪位。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":95,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":123,"offset_unit":"unicode_code_point"},{"id":"houfei-e-o024a-q","section":"chapter-005","block":"b-d4e185ca4ec710503c89","layer":"original","quote":"四年十一月〖10〗，以后旧陵庳下〖11〗，使像兼太尉，持节，诣邺，昭告后土。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":96,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":38,"offset_unit":"unicode_code_point"},{"id":"houfei-e-o024c-q","section":"chapter-005","block":"b-d4e185ca4ec710503c89","layer":"original","quote":"像还，迁散骑常侍。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":96,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":48,"end":57,"offset_unit":"unicode_code_point"},{"id":"houfei-e-o025b-q","section":"chapter-005","block":"b-0744a279ae4c62a54e64","layer":"original","quote":"青龙二年春，追谥后兄俨曰安城乡穆侯。夏，吴贼寇扬州，以像为伏波将军〖12〗，持节，监诸将东征〖13〗。还，复为射声校尉〖14〗。三年薨〖15〗，追赠卫将军，改封魏昌县，谥曰贞侯。子畅嗣。又封畅弟温、4 、艳，皆为列侯。四年〖16〗，改逸、俨本封，皆曰魏昌侯，谥因故〖17〗。封俨世妇刘为东乡君〖18〗，又追封逸世妇张为安喜君。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":97,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":163,"offset_unit":"unicode_code_point"},{"id":"houfei-e-o025c-q","section":"chapter-005","block":"b-0744a279ae4c62a54e64","layer":"original","quote":"青龙二年春，追谥后兄俨曰安城乡穆侯。夏，吴贼寇扬州，以像为伏波将军〖12〗，持节，监诸将东征〖13〗。还，复为射声校尉〖14〗。三年薨〖15〗，追赠卫将军，改封魏昌县，谥曰贞侯。子畅嗣。又封畅弟温、4 、艳，皆为列侯。四年〖16〗，改逸、俨本封，皆曰魏昌侯，谥因故〖17〗。封俨世妇刘为东乡君〖18〗，又追封逸世妇张为安喜君。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":97,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":163,"offset_unit":"unicode_code_point"},{"id":"houfei-q-b-cbf406b91aa2796bad01","section":"chapter-005","block":"b-cbf406b91aa2796bad01","layer":"modern","quote":"〖10〗四年：太和四年（公元 230）。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":108,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-776c1db56d4d5699fd84","start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"houfei-q-b-e47ffea5cca5eab53d92","section":"chapter-005","block":"b-e47ffea5cca5eab53d92","layer":"modern","quote":"〖15〗三年：青龙三年（公元 235）。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":113,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4aa0b3373c71cedadeb9","start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"houfei-q-o012","section":"chapter-005","block":"b-743375ca04aa18c715da","layer":"original","quote":"至太和四年春，明帝乃追谥太后祖父广曰开阳恭侯〖12〗，父远曰敬侯〖13〗，祖母周封阳都君，及（恭）〔敬〕侯夫人，皆赠印绶〖14〗。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":44,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":65,"offset_unit":"unicode_code_point"},{"id":"houfei-q-o022","section":"chapter-005","block":"b-31288da490b4d6270504","layer":"original","quote":"太和元年三月，以中山魏昌之安城乡户千〖2〗，追封逸，谥曰敬侯；嫡孙像，袭爵。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":94,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":38,"offset_unit":"unicode_code_point"},{"id":"houfei-q-o023","section":"chapter-005","block":"b-726e392875bbc6d22fbc","layer":"original","quote":"四月，初营宗庙，掘地得玉玺；方一寸九分〖3〗，其文曰“天子羡思慈亲”〖4〗。明帝为之改容〖5〗，以太牢告庙，又尝梦见后；于是差次舅氏亲疏高下〖6〗，叙用各有差〖7〗；赏赐累巨万；以像为虎贲中郎将〖8〗。是月，后母薨，帝制缌服临丧〖9〗，百僚陪位。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":95,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":123,"offset_unit":"unicode_code_point"},{"id":"houfei-q-o024","section":"chapter-005","block":"b-d4e185ca4ec710503c89","layer":"original","quote":"四年十一月〖10〗，以后旧陵庳下〖11〗，使像兼太尉，持节，诣邺，昭告后土。十二月，改葬朝阳陵。像还，迁散骑常侍。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":96,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":57,"offset_unit":"unicode_code_point"},{"id":"houfei-q-o025","section":"chapter-005","block":"b-0744a279ae4c62a54e64","layer":"original","quote":"青龙二年春，追谥后兄俨曰安城乡穆侯。夏，吴贼寇扬州，以像为伏波将军〖12〗，持节，监诸将东征〖13〗。还，复为射声校尉〖14〗。三年薨〖15〗，追赠卫将军，改封魏昌县，谥曰贞侯。子畅嗣。又封畅弟温、4 、艳，皆为列侯。四年〖16〗，改逸、俨本封，皆曰魏昌侯，谥因故〖17〗。封俨世妇刘为东乡君〖18〗，又追封逸世妇张为安喜君。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":97,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":163,"offset_unit":"unicode_code_point"},{"id":"houfei-q-o029","section":"chapter-005","block":"b-3b14070b8464278ab27f","layer":"original","quote":"帝思念舅氏不已。畅尚幼，景初末，以畅为射声校尉，加散骑常侍。又特为起大第〖20〗，车驾亲自临之。又于其后园，为像母起观庙，名其里曰“渭阳里”〖21〗，以追思母氏也。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":122,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":82,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-b-76fba510250937628a99","section":"chapter-003","block":"b-76fba510250937628a99","layer":"modern","quote":"〖1〗二年：太和二年（公元 228）。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":60,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-38a74578b09178cb1fd4","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-b-7a11c761ca65aeb3d195","section":"chapter-003","block":"b-7a11c761ca65aeb3d195","layer":"modern","quote":"〖1〗二年：青龙二年（公元 234）。己未：旧历初四日。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":252,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6c0753fe684a18a3a281","start":0,"end":28,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-o004","section":"chapter-003","block":"b-3d867ec3331f738aeaf5","layer":"original","quote":"太和元年春正月，郊祀武皇帝，以配天；宗祀文皇帝于明堂，以配上帝〖1〗。分江夏南部，置江夏南部都尉。西平麹英反，杀临羌令、西都长〖2〗。遣将军郝昭、鹿磐，讨斩之。二月，辛未〖3〗，帝耕于籍田。辛巳〖4〗，立文昭皇后寝庙于邺。丁亥〖5〗，朝日于东郊。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":30,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":123,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-o008","section":"chapter-003","block":"b-bec9198de0001b0aa26c","layer":"original","quote":"二年春正月〖1〗，宣王攻破新城。斩达，传其首〖2〗。﹝一﹞分新城之上庸、武陵、巫县为上庸郡〖3〗，锡县为锡郡。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":54,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":55,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-o037","section":"chapter-003","block":"b-ff97c2d326d0fc08a9de","layer":"original","quote":"二年春二月，（乙）〔己〕未〖1〗，太白犯荧惑。癸酉〖2〗，诏曰：“‘鞭作官刑〖3〗’，所以纠慢怠也〖4〗；而顷多以无辜死。其减鞭杖之制〖5〗，著于令。”三月，庚寅〖6〗，山阳公薨；帝素服发哀〖7〗，遣使持节，典护丧事。己酉〖8〗，大赦。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":249,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":118,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
