{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[],"persons":[{"id":"xunyu-p0072","name":"荀悝","evidence":["xunyu-q-p032"],"facts":[],"aliases":[],"mentions":[{"id":"xunyu-m-p032-xunyu-p0072","kind":"mention","text":"文中提及","evidence":["xunyu-q-p032"]}]}],"evidence":[{"id":"xunyu-q-p032","section":"chapter-010","block":"b-5ab93710c1bb7fe30998","layer":"pei","quote":"臣松之按：和峤为侍中，荀顗亡没久矣。荀勖位亚台司，不与峤同班，无缘方称“侍中”。二书所云，皆为非也。考其时位，恺实当之。恺位至征西大将军。恺兄儋，少府。弟悝，护军将军，追赠车骑大将军。","attribution":"裴松之按","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":190,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1cd39ba61e7c038ca47e","start":0,"end":92,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
