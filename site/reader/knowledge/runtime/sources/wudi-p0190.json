{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p061b","title":"毕瑜受遣游说刘虞","accounts":[{"id":"wudi-e-p061b-account","label":"《献帝起居注》所载曹操上言","text":"上言中追述袁绍遣故任长毕瑜见刘虞，以命录之说劝其受帝位。","evidence":["wudi-e-p061b-q"]}],"participants":[{"person":"wudi-p0052","role":"遣使","evidence":["wudi-e-p061b-q"]},{"person":"wudi-p0190","role":"游说","evidence":["wudi-e-p061b-q"]},{"person":"wudi-p0079","role":"受劝","evidence":["wudi-e-p061b-q"]}],"place":null,"time":{"label":"袁绍韩馥谋立刘虞时","precision":"relative","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p061b-q"]},"source_order":[1,454,"P061b"],"order":198}],"persons":[{"id":"wudi-p0190","name":"毕瑜","evidence":["wudi-q-p061"],"facts":[],"aliases":[],"mentions":[{"id":"wudi-m-p061-wudi-p0190","kind":"mention","text":"文中提及","evidence":["wudi-q-p061"]}]}],"evidence":[{"id":"wudi-e-p061b-q","section":"chapter-001","block":"b-346c577b4a71c73e6226","layer":"pei","quote":"大将军邺侯袁绍，前与冀州牧韩馥立故大司马刘虞，刻作金玺；遣故任长毕瑜，诣虞，为说命录之数。","attribution":"《献帝起居注》所载曹操上言","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":453,"anchor":null},"note_id":"n-3663cf74d422f76a0a08","start":18,"end":63},{"id":"wudi-q-p061","section":"chapter-001","block":"b-346c577b4a71c73e6226","layer":"pei","quote":"﹝二﹞《献帝起居注》曰：“公上言：‘大将军邺侯袁绍，前与冀州牧韩馥立故大司马刘虞，刻作金玺；遣故任长毕瑜，诣虞，为说命录之数。又绍与臣书云：“可都鄄城，当有所立。”擅铸金银印，孝廉、计吏，皆往诣绍。从弟济阴太守叙，与绍书云：“今海内丧败，天意实在我家；神应有征，当在尊兄。南兄臣下欲使即位，南兄言：以年则北兄长，以位则北兄重；便欲送玺，会曹操断道。”绍宗族累世受国重恩，而凶逆无道，乃至于此。辄勒兵马，与战官渡；乘圣朝之威，得斩绍大将淳于琼等八人首，遂大破溃。绍与子谭轻身迸走。凡斩首七万余级，辎重财物巨亿。’”","attribution":"《献帝起居注》所载曹操上言","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":453,"anchor":null},"note_id":"n-3663cf74d422f76a0a08","start":0,"end":256}],"profiles":{},"directory_counts":{}}
