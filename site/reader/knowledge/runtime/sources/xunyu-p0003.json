{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o065a","title":"袁绍兼四州准备攻许","accounts":[{"id":"wudi-e-o065a-account","label":"正文","text":"袁绍吞并公孙瓒、据四州后拟进攻许，曹操向诸将分析袁绍军政弱点。","evidence":["wudi-e-o065a-q"]},{"id":"dongyuan-e-o044c-account","label":"《董二袁刘传第六》正文","text":"袁绍以审配逢纪统军田丰等谋主颜良文丑将率备攻许","evidence":["dongyuan-e-o044c-q"]},{"id":"dongyuan-a-p076-judgment","label":"孙盛评","text":"孙盛据冀州户籍推论袁绍南征兵数，认为十万较接近；不把推数改成确定实数。","evidence":["dongyuan-q-p076-judgment"]}],"participants":[{"person":"wudi-p0052","role":"并州拟攻","evidence":["wudi-e-o065a-q"]},{"person":"wudi-p0093","role":"被吞并","evidence":["wudi-e-o065a-q"]},{"person":"cao-cao","role":"评敌备战","evidence":["wudi-e-o065a-q"]},{"person":"wudi-p0208","role":"统军事","evidence":["dongyuan-e-o044c-q"]},{"person":"xunyu-p0033","role":"统军事","evidence":["dongyuan-e-o044c-q"]},{"person":"wudi-p0139","role":"谋主","evidence":["dongyuan-e-o044c-q"]},{"person":"xunyu-p0003","role":"谋主","evidence":["dongyuan-e-o044c-q"]},{"person":"wudi-p0038","role":"谋主","evidence":["dongyuan-e-o044c-q"]},{"person":"wudi-p0176","role":"将率","evidence":["dongyuan-e-o044c-q"]},{"person":"wudi-p0179","role":"将率","evidence":["dongyuan-e-o044c-q"]}],"place":{"text":"许","evidence":["wudi-e-o065a-q"]},"time":{"label":"建安四年","year":199,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o065a-q","wudi-q-o061","wudi-q-b-51bced16741add42ff70"],"chronology":"wudi-y199","dating_review":{"anchor":"wudi-q-o061","basis":"建安四年","reviewed":true}},"source_order":[1,363,"O065a"],"order":162},{"id":"dongyuan-e-o038a","title":"袁绍还延津遣高幹荀谌说韩馥让冀州韩馥从","accounts":[{"id":"dongyuan-e-o038a-account","label":"《董二袁刘传第六》正文","text":"袁绍还延津遣高幹荀谌说韩馥让冀州韩馥从","evidence":["dongyuan-e-o038a-q"]}],"participants":[{"person":"wudi-p0052","role":"遣说","evidence":["dongyuan-e-o038a-q"]},{"person":"wudi-p0235","role":"游说","evidence":["dongyuan-e-o038a-q"]},{"person":"xunyu-p0003","role":"游说","evidence":["dongyuan-e-o038a-q"]},{"person":"wudi-p0058","role":"从议","evidence":["dongyuan-e-o038a-q"]}],"place":null,"time":{"label":"董卓西入关后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-o038a-q"]},"ordering_evidence":"dongyuan-e-o038a-q","source_order":[6,232,"O038a"],"order":1630}],"persons":[{"id":"xunyu-p0003","name":"荀谌","evidence":["xunyu-q-o004","dongyuan-q-o038"],"facts":[{"id":"xunyu-f0011","label":"字","text":"友若","evidence":["xunyu-f0011-q"]}],"aliases":[{"text":"友若","evidence":["xunyu-f0011-q"]}],"mentions":[{"id":"xunyu-m-o004-xunyu-p0003","kind":"mention","text":"文中提及","evidence":["xunyu-q-o004"]},{"id":"xunyu-m-p019-xunyu-p0003","kind":"mention","text":"文中提及","evidence":["xunyu-q-p019"]},{"id":"dongyuan-m-o038-xunyu-p0003","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o038"]},{"id":"dongyuan-m-o044-xunyu-p0003","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o044"]}]}],"evidence":[{"id":"dongyuan-e-o038a-q","section":"chapter-006","block":"b-7d2984aa42c7b84600cb","layer":"original","quote":"会卓西入关〖2〗，绍还军延津。因馥惶遽，使陈留高幹、颍川荀谌等说馥曰：“公孙瓒乘胜来向南，而诸郡应之。袁车骑引军东向〖3〗，此其意不可知。窃为将军危之！”馥曰：“为之奈何？”谌曰：“公孙提燕、代之卒，其锋不可当。袁氏一时之杰，必不为将军下。夫冀州，天下之重资也〖4〗。若两雄并力，兵交于城下，危亡可立而待也！夫袁氏，将军之旧〖5〗，且同盟也。当今为将军计，莫若举冀州以让袁氏。袁氏得冀州，则瓒不能与之争，必厚德将军〖6〗。冀州入于亲交，是将军有让贤之名，而身安于泰山也。愿将军勿疑！”馥素恇怯〖7〗，因然其计。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":231,"anchor":null},"note_id":null,"start":0,"end":255},{"id":"dongyuan-e-o044c-q","section":"chapter-006","block":"b-9378127fbfcbf250d81d","layer":"original","quote":"众数十万。以审配、逢纪统军事〖5〗；田丰、荀谌、许攸为谋主〖6〗；颜良、文丑为将率；简精卒十万〖7〗，骑万匹，将攻许。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":278,"anchor":null},"note_id":null,"start":78,"end":137},{"id":"dongyuan-q-o038","section":"chapter-006","block":"b-7d2984aa42c7b84600cb","layer":"original","quote":"会卓西入关〖2〗，绍还军延津。因馥惶遽，使陈留高幹、颍川荀谌等说馥曰：“公孙瓒乘胜来向南，而诸郡应之。袁车骑引军东向〖3〗，此其意不可知。窃为将军危之！”馥曰：“为之奈何？”谌曰：“公孙提燕、代之卒，其锋不可当。袁氏一时之杰，必不为将军下。夫冀州，天下之重资也〖4〗。若两雄并力，兵交于城下，危亡可立而待也！夫袁氏，将军之旧〖5〗，且同盟也。当今为将军计，莫若举冀州以让袁氏。袁氏得冀州，则瓒不能与之争，必厚德将军〖6〗。冀州入于亲交，是将军有让贤之名，而身安于泰山也。愿将军勿疑！”馥素恇怯〖7〗，因然其计。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":231,"anchor":null},"note_id":null,"start":0,"end":255},{"id":"dongyuan-q-o044","section":"chapter-006","block":"b-9378127fbfcbf250d81d","layer":"original","quote":"顷之，击破瓒于易京〖4〗，并其众。﹝三﹞出长子谭为青州，沮授谏绍：“必为祸始。”绍不听，曰：“孤欲令诸儿各据一州也。”﹝四﹞又以中子熙为幽州，甥高幹为并州，众数十万。以审配、逢纪统军事〖5〗；田丰、荀谌、许攸为谋主〖6〗；颜良、文丑为将率；简精卒十万〖7〗，骑万匹，将攻许。﹝五﹞","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":278,"anchor":null},"note_id":null,"start":0,"end":140},{"id":"dongyuan-q-p076-judgment","section":"chapter-006","block":"b-db94f2025a3cc6337b58","layer":"pei","quote":"孙盛评曰：“按魏武谓崔琰曰‘昨案贵州户籍，可得三十万众’。由此推之，但冀州胜兵已如此；况兼幽、并及青州乎？绍之大举，必悉师而起：十万近之矣。","attribution":"孙盛评","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":294,"anchor":null},"note_id":"n-f9b297d2a3b3d9e09127","start":21,"end":91},{"id":"wudi-e-o065a-q","section":"chapter-001","block":"b-58c959449a0f1f33e31e","layer":"original","quote":"是时，袁绍既并公孙瓒〖13〗，兼四州之地〖14〗，众十余万，将进军攻许。诸将以为不可敌。公曰：“吾知绍之为人：志大而智小；色厉而胆薄〖15〗；忌克而少威〖16〗；兵多而分画不明〖17〗；将骄而政令不一。土地虽广，粮食虽丰，适足以为吾奉也〖18〗！”","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":362,"anchor":null},"note_id":null,"start":0,"end":124},{"id":"wudi-q-b-51bced16741add42ff70","section":"chapter-001","block":"b-51bced16741add42ff70","layer":"modern","quote":"〖1〗四年：建安四年（公元 199）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":369,"anchor":null},"note_id":"n-20628d34a709162c77f0","start":0,"end":19},{"id":"wudi-q-o061","section":"chapter-001","block":"b-502d4e8c0ed143eaa30d","layer":"original","quote":"四年春二月〖1〗，公还至昌邑〖2〗。张杨将杨丑杀杨〖3〗。眭固又杀丑，以其众属袁绍，屯射犬〖4〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":358,"anchor":null},"note_id":null,"start":0,"end":49},{"id":"xunyu-f0011-q","section":"chapter-010","block":"b-310798880b116dcdf9cc","layer":"pei","quote":"谌，字友若","attribution":"《荀氏家传》及裴注","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":154,"anchor":null},"note_id":"n-75cfb114317a4cad6048","start":28,"end":33},{"id":"xunyu-q-o004","section":"chapter-010","block":"b-976aa8aeb866c7b60ba5","layer":"original","quote":"会冀州牧同郡韩馥，遣骑迎之，莫有随者，彧独将宗族，至冀州。而袁绍已夺馥位，待彧以上宾之礼；彧弟谌及同郡辛评、郭图，皆为绍所任。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":4,"anchor":null},"note_id":null,"start":0,"end":63},{"id":"xunyu-q-p019","section":"chapter-010","block":"b-310798880b116dcdf9cc","layer":"pei","quote":"﹝一﹞《荀氏家传》曰：“衍，字休若。彧第三兄。”彧第四兄谌，字友若。事见《袁绍传》。陈群与孔融，论汝、颍人物，群曰：“荀文若、公达、休若、友若、仲豫，当今并无对。”衍子绍，位至太仆。绍子融，字伯雅；与王弼、钟会俱知名；为洛阳令，参大将军军事；与弼、会论《易》、《老》义，传于世。谌子闳，字仲茂。为太子文学掾。时有甲、乙疑论，闳与钟繇、王朗、袁涣，议各不同。文帝与繇书曰：“袁、王国士，更为唇齿；荀闳劲悍，往来锐师：真君侯之勍敌，左右之深忧也。”终黄门侍郎。闳从孙（恽）〔煇〕，字景文。太子中庶子，亦知名。与贾充共定（音）〔晋〕律，又作《易集解》。仲豫名悦，朗陵长俭之少子，彧从父兄也。","attribution":"《荀氏家传》及裴注","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":154,"anchor":null},"note_id":"n-75cfb114317a4cad6048","start":0,"end":292}],"profiles":{},"directory_counts":{}}
