["dongyuan-q-o088"]},{"id":"dongyuan-m-o089-liu-cong","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o089"]},{"id":"dongyuan-m-o090-liu-cong","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o090"]},{"id":"dongyuan-m-p118-liu-cong","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p118"]},{"id":"dongyuan-m-p119-liu-cong","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p119"]}]}],"evidence":[{"id":"cuimao-q-e4c76a262233ce6e6ef6","section":"chapter-012","block":"b-ecadc2b94d58e0bc3ac4","layer":"pei","quote":"刘表亡，曹公向荆州。表子琮降，以节迎曹公；诸将皆疑诈，曹公以问子伯。子伯曰：‘天下扰攘，各贪王命以自重；今以节来，是必至诚。’曹公曰：‘大善！’遂进兵","attribution":"裴注·《吴书》","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":103,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4d3d422b1c33b802fc46","start":257,"end":332,"offset_unit":"unicode_code_point"},{"id":"dongliu-q-31a70cac001d7aed35dc","section":"chapter-039","block":"b-25116ac3db8470a65d86","layer":"original","quote":"先主奔江南，荆楚群士从之如云","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":45,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":9,"end":23,"offset_unit":"unicode_code_point"},{"id":"dongliu-q-d732bcc72d77759440e2","section":"chapter-039","block":"b-25116ac3db8470a65d86","layer":"original","quote":"表卒","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":45,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":2,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-o088a-q","section":"chapter-006","block":"b-36c489d1f93241a324d4","layer":"original","quote":"建安十三年，太祖征表；未至，表病死。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":485,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":18,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-o088b-q","section":"chapter-006","block":"b-36c489d1f93241a324d4","layer":"original","quote":"初，表及妻爱少子琮，欲以为后，而蔡瑁、张允为之支党〖1〗；乃出长子琦为江夏太守，众遂奉琮为嗣：琦与琮遂为仇隙。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":485,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":18,"end":73,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-o088c-q","section":"chapter-006","block":"b-36c489d1f93241a324d4","layer":"original","quote":"越、嵩及东曹掾傅巽等说琮归太祖〖2〗。琮曰：“今与诸君据全楚之地〖3〗，守先君之业；以观天下，何为不可乎？”巽对曰：“逆顺有大体，强弱有定势。以人臣而拒人主，逆也；以新造之楚而御国家，其势弗当也；以刘备而敌曹公，又弗当也。三者皆短，欲以抗王兵之锋，必亡之道也！将军自料何与刘备〖4〗？”琮曰：“吾不若也。”巽曰：“诚以刘备不足御曹公乎〖5〗，则虽保楚之地，不足以自存也；诚以刘备足御曹公乎，则备不为将军下也〖6〗。愿将军勿疑！”","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":485,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":76,"end":290,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-o089a-q","section":"chapter-006","block":"b-ed6c3abce1fb6b3e0309","layer":"original","quote":"太祖军到襄阳，琮举州降；备走奔夏口。﹝三﹞","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":486,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-o090a-q","section":"chapter-006","block":"b-35b4f4f1203d0e78df18","layer":"original","quote":"太祖以琮为青州刺史，封列侯；﹝一﹞蒯越等，侯者十五人。越，为光禄勋；﹝二﹞嵩，大鸿胪〖1〗；﹝三﹞羲，侍中；﹝四﹞先，尚书令；其余多至大官。﹝五﹞","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":499,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":73,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p118a-q","section":"chapter-006","block":"b-d954c685525c5090df05","layer":"pei","quote":"王威说刘琮曰：‘曹操得将军既降，刘备已走，必解弛无备，轻行单进。若给威奇兵数千，徼之于险，操可获也。获操即威震天下，坐而虎步；中夏虽广，可传檄而定；非徒收一胜之功保守今日而已：此难遇之机，不可失也。’琮不纳。","attribution":"《汉晋春秋》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":498,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-aad7859d6d1ec44f2250","start":9,"end":113,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p119a-q","section":"chapter-006","block":"b-7894f607b9c538202d22","layer":"pei","quote":"﹝一﹞《魏武故事》载令曰：“楚有江、汉山川之险，后服先强，与秦争衡；荆州则其故地，刘镇南久用其民矣。身没之后，诸子鼎峙，虽终难全，犹可引日。青州刺史琮，心高志洁，智深虑广；轻荣重义，薄利厚德；蔑万里之业，忽三军之众；笃中正之体，敦令名之誉；上耀先君之遗尘，下图不朽之余祚。鲍永之弃并州，窦融之离五郡，未足以喻也。虽封列侯一州之位，犹恨此宠未副其人。而比有笺，求还州；监史虽尊，秩禄未优。今听所执，表琮为谏议大夫，参同军事。”","attribution":"《魏武故事》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":503,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-999e214a5f215703b579","start":0,"end":212,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o088","section":"chapter-006","block":"b-36c489d1f93241a324d4","layer":"original","quote":"建安十三年，太祖征表；未至，表病死。初，表及妻爱少子琮，欲以为后，而蔡瑁、张允为之支党〖1〗；乃出长子琦为江夏太守，众遂奉琮为嗣：琦与琮遂为仇隙。﹝二﹞越、嵩及东曹掾傅巽等说琮归太祖〖2〗。琮曰：“今与诸君据全楚之地〖3〗，守先君之业；以观天下，何为不可乎？”巽对曰：“逆顺有大体，强弱有定势。以人臣而拒人主，逆也；以新造之楚而御国家，其势弗当也；以刘备而敌曹公，又弗当也。三者皆短，欲以抗王兵之锋，必亡之道也！将军自料何与刘备〖4〗？”琮曰：“吾不若也。”巽曰：“诚以刘备不足御曹公乎〖5〗，则虽保楚之地，不足以自存也；诚以刘备足御曹公乎，则备不为将军下也〖6〗。愿将军勿疑！”","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":485,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":290,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o089","section":"chapter-006","block":"b-ed6c3abce1fb6b3e0309","layer":"original","quote":"太祖军到襄阳，琮举州降；备走奔夏口。﹝三﹞","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":486,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o090","section":"chapter-006","block":"b-35b4f4f1203d0e78df18","layer":"original","quote":"太祖以琮为青州刺史，封列侯；﹝一﹞蒯越等，侯者十五人。越，为光禄勋；﹝二﹞嵩，大鸿胪〖1〗；﹝三﹞羲，侍中；﹝四﹞先，尚书令；其余多至大官。﹝五﹞","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":499,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":73,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p118","section":"chapter-006","block":"b-d954c685525c5090df05","layer":"pei","quote":"王威说刘琮曰：‘曹操得将军既降，刘备已走，必解弛无备，轻行单进。若给威奇兵数千，徼之于险，操可获也。获操即威震天下，坐而虎步；中夏虽广，可传檄而定；非徒收一胜之功保守今日而已：此难遇之机，不可失也。’琮不纳。","attribution":"《汉晋春秋》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":498,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-aad7859d6d1ec44f2250","start":9,"end":113,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p119","section":"chapter-006","block":"b-7894f607b9c538202d22","layer":"pei","quote":"﹝一﹞《魏武故事》载令曰：“楚有江、汉山川之险，后服先强，与秦争衡；荆州则其故地，刘镇南久用其民矣。身没之后，诸子鼎峙，虽终难全，犹可引日。青州刺史琮，心高志洁，智深虑广；轻荣重义，薄利厚德；蔑万里之业，忽三军之众；笃中正之体，敦令名之誉；上耀先君之遗尘，下图不朽之余祚。鲍永之弃并州，窦融之离五郡，未足以喻也。虽封列侯一州之位，犹恨此宠未副其人。而比有笺，求还州；监史虽尊，秩禄未优。今听所执，表琮为谏议大夫，参同军事。”","attribution":"《魏武故事》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":503,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-999e214a5f215703b579","start":0,"end":212,"offset_unit":"unicode_code_point"},{"id":"fangji-q-5059eeffc24796c91d22","section":"chapter-029","block":"b-d4e5fb7a9f231ff1843d","layer":"original","quote":"后表子琮降太祖","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":153,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":7,"offset_unit":"unicode_code_point"},{"id":"lizang-q-01f3ee36ce14ac3a7b0d","section":"chapter-018","block":"b-e9d18d4f862d319c0c25","layer":"original","quote":"太祖问曰：“来何迟邪？”聘曰：“先日不能辅弼刘荆州以奉国家〖3〗。荆州虽没，常愿据守汉川，保全土境；生不负于孤弱〖4〗，死无愧于地下〖5〗。而计不得已，以至于此。实怀悲惭，无颜早见耳！”遂欷歔流涕","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":88,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":11,"end":109,"offset_unit":"unicode_code_point"},{"id":"lizang-q-10f78b37d6f58476cd70","section":"chapter-018","block":"b-2cd5dc7dbc155510ae63","layer":"original","quote":"呼聘欲与俱。聘曰：“聘不能全州〖1〗，当待罪而已","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":87,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":42,"end":66,"offset_unit":"unicode_code_point"},{"id":"lizang-q-3c2e146e8eb20fe6cfbc","section":"chapter-018","block":"b-2cd5dc7dbc155510ae63","layer":"original","quote":"太祖征荆州，琮举州降","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":87,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":31,"end":41,"offset_unit":"unicode_code_point"},{"id":"lizang-q-7ff70c3b3b38705aad63","section":"chapter-018","block":"b-e9d18d4f862d319c0c25","layer":"original","quote":"太祖为之怆然，曰：“仲业，卿真忠臣也！”厚礼待之","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":88,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":110,"end":134,"offset_unit":"unicode_code_point"},{"id":"lizang-q-afa4cb9a5a3d91fe7e91","section":"chapter-018","block":"b-2cd5dc7dbc155510ae63","layer":"original","quote":"表死，其子琮立","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":87,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":23,"end":30,"offset_unit":"unicode_code_point"},{"id":"lizang-q-ecde88ebd7e01b567839","section":"chapter-018","block":"b-e9d18d4f862d319c0c25","layer":"original","quote":"太祖济汉，聘乃诣太祖","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":88,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":10,"offset_unit":"unicode_code_point"},{"id":"surrender","section":"chapter-001","block":"b-031a374e9090ba29242f","quote":"九月，公到新野〖7〗，琮遂降。备走夏口〖8〗。","layer":"original","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":663,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":39,"end":62,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-a2178cb9bb230d9ef815","section":"chapter-021","block":"b-1c3cc22740c59dfcf356","layer":"pei","quote":"粲说琮曰：‘仆有愚计，愿进之于将军。可乎？’琮曰：‘吾所愿闻也。’粲曰：‘天下大乱，豪杰并起；在仓猝之际，强弱未分，故人各各有心耳。当此之时，家家欲为帝王，人人欲为公侯。观古今之成败，能先见事机者，则恒受其福。今将军自度，何如曹公邪？’琮不能对。粲复曰：‘如粲所闻，曹公故人杰也：雄略冠时，智谋出世；摧袁氏于官渡，驱孙权于江外；逐刘备于陇右，破乌丸于白登；其余枭夷荡定者，往往如神，不可胜计。今日之事，去就可知也。将军能听粲计，卷甲倒戈，应天顺命，以归曹公；曹公必重德将军。保己全宗，长享福祚，垂之后嗣，此万全之策也。粲遭乱流离，托命此州，蒙将军父子重顾，敢不尽言！’琮纳其言","attribution":"裴注（引书待核）","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":25,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c412837760d57aff6b5f","start":11,"end":299,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-b293a743d334c9ecaaba","section":"chapter-021","block":"b-1e582d7bb09516530cbf","layer":"original","quote":"粲劝表子琮，令归太祖","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":4,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":38,"end":48,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-d39f14336bf242f7f0b5","section":"chapter-021","block":"b-1e582d7bb09516530cbf","layer":"original","quote":"表卒","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":4,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":35,"end":37,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o121b-q","section":"chapter-001","block":"b-031a374e9090ba29242f","layer":"original","quote":"八月，表卒；其子琮代〖4〗，屯襄阳〖5〗。刘备屯樊〖6〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":663,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":10,"end":39,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o121c-q","section":"chapter-001","block":"b-031a374e9090ba29242f","layer":"original","quote":"九月，公到新野〖7〗，琮遂降。备走夏口〖8〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":663,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":39,"end":62,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-888495d8be7766faf20c","section":"chapter-001","block":"b-888495d8be7766faf20c","layer":"modern","quote":"〖1〗十三年：建安十三年（公元 208）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":666,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0bae348fdb687025113d","start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o119","section":"chapter-001","block":"b-4bcffcc4ee709a4e5ea3","layer":"original","quote":"十三年春正月〖1〗，公还邺。作玄武池以肄舟师〖2〗。﹝一﹞汉罢三公官，置丞相、御史大夫〖3〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":661,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":47,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o121","section":"chapter-001","block":"b-031a374e9090ba29242f","layer":"original","quote":"秋七月，公南征刘表。八月，表卒；其子琮代〖4〗，屯襄阳〖5〗。刘备屯樊〖6〗。九月，公到新野〖7〗，琮遂降。备走夏口〖8〗。公进军江陵〖9〗，下令荆州吏民，与之更始。乃论荆州服从之功，侯者十五人。以刘表大将文聘为江夏太守〖10〗，使统本兵；引用荆州名士韩嵩、邓义等〖11〗。﹝三﹞益州牧刘璋始受征役〖12〗，遣兵给军。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":663,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":159,"offset_unit":"unicode_code_point"},{"id":"wufan-q-e297cdefd9d420d39248","section":"chapter-063","block":"b-b84cf48ba2c7aa9dcf0c","layer":"original","quote":"会孙权起于东南，范委身服事。每有灾祥，辄推数言状；其术多效，遂以显名。初，权在吴，欲讨黄祖。范曰：“今兹少利，不如明年。明年戊子〖4〗，荆州刘表亦身死国亡。”权遂征祖，卒不能克。明年，军出。行及寻阳，范见风气，因诣船贺，催兵急行。至即破祖，祖（得）夜亡〖5〗。权恐失之，范曰：“未远，必生擒祖。”至五更中，果得之。刘表竟死，荆州分割。","section_title":"吴范刘惇赵达传第十八","source":{"file":"OEBPS/Text/titlepage_0133.xhtml","index":2,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":167,"offset_unit":"unicode_code_point"},{"id":"wuzhu-e-o014a-q","section":"chapter-047","block":"b-5e943c9b5fe8a6b84c9b","layer":"original","quote":"荆州牧刘表死；鲁肃乞奉命吊表二子〖8〗，且以观变。肃未到，而曹公已临其境。表子琮举众以降〖9〗，刘备欲南济江〖10〗。肃与相见，因传权旨〖11〗，为陈成败。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":62,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":78,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o012","section":"chapter-047","block":"b-3843def972d8a772cdb3","layer":"original","quote":"十三年春〖1〗，权复征黄祖。祖先遣舟兵拒军，都尉吕蒙破其前锋；而凌统、董袭等尽锐攻之〖2〗，遂屠其城。祖挺身亡走〖3〗。骑士冯则追枭其首〖4〗，虏其男女数万口。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":60,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":80,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o014","section":"chapter-047","block":"b-5e943c9b5fe8a6b84c9b","layer":"original","quote":"荆州牧刘表死；鲁肃乞奉命吊表二子〖8〗，且以观变。肃未到，而曹公已临其境。表子琮举众以降〖9〗，刘备欲南济江〖10〗。肃与相见，因传权旨〖11〗，为陈成败。备进住夏口〖12〗，使诸葛亮诣权〖13〗。权遣周瑜、程普等行。是时，曹公新得表众，形势甚盛；诸议者皆望风畏惧，多劝权迎之。﹝四﹞惟瑜、肃执拒之议，意与权同。瑜、普为左右督〖14〗，各领万人；与备俱进，遇于赤壁〖15〗，大破曹公军。公烧其余船，引退，士卒饥疫，死者太半。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":62,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":212,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-p008","section":"chapter-047","block":"b-21fbf4c6fce3f703c583","layer":"pei","quote":"﹝四﹞《江表传》载：“曹公与权书曰：‘近者奉辞伐罪，（旄）〔旌〕南指，刘琮束手。今治水步八十万众，方与将军会猎于吴！’权得书，以示群臣，莫不响震失色。”","attribution":"《江表传》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":101,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1e159cb59d62392057e4","start":0,"end":76,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o024a-q","section":"chapter-032","block":"b-c857386227851cc86ab3","layer":"original","quote":"（曹公南征表）〔及曹公南征〕，会表卒，﹝二﹞子琮代立〖2〗，","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":108,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":30,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o024b-q","section":"chapter-032","block":"b-c857386227851cc86ab3","layer":"original","quote":"子琮代立〖2〗，遣使请降。先主屯樊，不知曹公猝至；至宛乃闻之，遂将其众去。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":108,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":22,"end":59,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o025a-q","section":"chapter-032","block":"b-5a567c5b9888d0eedcf0","layer":"original","quote":"过襄阳，诸葛亮说先主攻琮，荆州可有。先主曰：“吾不忍也。”﹝三﹞乃驻马呼琮；琮惧，不能起；琮左右及荆州人多归先主。﹝四﹞比到当阳，众十余万，辎重数千辆，日行十余里；","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":109,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":82,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-p024a-q","section":"chapter-032","block":"b-7601fa710fb53306a879","layer":"pei","quote":"﹝三﹞孔衍《汉魏春秋》曰：“刘琮乞降，不敢告备，备亦不知。久之乃觉，遣所亲问琮；琮令宋忠，诣备宣旨。是时曹公在宛，备乃大惊骇，谓忠曰：‘卿诸人作事如此，不早相语；今祸至方告我，不亦太剧乎！’引刀向忠曰：‘今断卿头，不足以解忿，亦耻大丈夫临别复杀卿辈！’遣忠去，乃呼部曲议。或劝备劫将琮及荆州吏士，径南到江陵。备答曰：‘刘荆州临亡，托我以孤遗；背信自济，吾所不为，死何面目以见刘荆州乎！’”","attribution":"孔衍《汉魏春秋》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":130,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-88da51863c1d2ebfc205","start":0,"end":194,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o024","section":"chapter-032","block":"b-c857386227851cc86ab3","layer":"original","quote":"（曹公南征表）〔及曹公南征〕，会表卒，﹝二﹞子琮代立〖2〗，遣使请降。先主屯樊，不知曹公猝至；至宛乃闻之，遂将其众去。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":108,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":59,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o025","section":"chapter-032","block":"b-5a567c5b9888d0eedcf0","layer":"original","quote":"过襄阳，诸葛亮说先主攻琮，荆州可有。先主曰：“吾不忍也。”﹝三﹞乃驻马呼琮；琮惧，不能起；琮左右及荆州人多归先主。﹝四﹞比到当阳，众十余万，辎重数千辆，日行十余里；别遣关羽乘船数百艘，使会江陵。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":109,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":97,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-p023","section":"chapter-032","block":"b-5c06e0e91cf99117b13c","layer":"pei","quote":"臣松之以为：表夫妻素爱琮，舍嫡立庶，情计久定；无缘临终举荆州以授备。此亦不然之言。","attribution":"裴松之按语","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":129,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-46ef7bedb5c1d15794d0","start":0,"end":41,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-p024","section":"chapter-032","block":"b-7601fa710fb53306a879","layer":"pei","quote":"﹝三﹞孔衍《汉魏春秋》曰：“刘琮乞降，不敢告备，备亦不知。久之乃觉，遣所亲问琮；琮令宋忠，诣备宣旨。是时曹公在宛，备乃大惊骇，谓忠曰：‘卿诸人作事如此，不早相语；今祸至方告我，不亦太剧乎！’引刀向忠曰：‘今断卿头，不足以解忿，亦耻大丈夫临别复杀卿辈！’遣忠去，乃呼部曲议。或劝备劫将琮及荆州吏士，径南到江陵。备答曰：‘刘荆州临亡，托我以孤遗；背信自济，吾所不为，死何面目以见刘荆州乎！’”","attribution":"孔衍《汉魏春秋》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":130,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-88da51863c1d2ebfc205","start":0,"end":194,"offset_unit":"unicode_code_point"},{"id":"xunyu-e-o028b-q","section":"chapter-010","block":"b-99f47b5b20670984f53c","layer":"original","quote":"太祖将伐刘表，问彧策安出。彧曰：“今华夏已平〖6〗，南土知困矣〖7〗。可显出宛、叶，而间行轻进，以掩其不意。”太祖遂行。会表病死，太祖直趋宛、叶，如彧计。表子琮，以州逆降〖8〗。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":143,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":22,"end":111,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-o028","section":"chapter-010","block":"b-99f47b5b20670984f53c","layer":"original","quote":"十二年〖5〗，复增彧邑千户，合二千户。﹝二﹞太祖将伐刘表，问彧策安出。彧曰：“今华夏已平〖6〗，南土知困矣〖7〗。可显出宛、叶，而间行轻进，以掩其不意。”太祖遂行。会表病死，太祖直趋宛、叶，如彧计。表子琮，以州逆降〖8〗。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":143,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":111,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-o064","section":"chapter-010","block":"b-38f29d879d5ca24386ff","layer":"original","quote":"建安十三年，太祖破荆州，欲顺江东下。诩谏曰：“明公昔破袁氏，今收汉南；威名远著，军势既大。若乘旧楚之饶，以飨吏士；抚安百姓，使安土乐业；则可不劳众而江东稽服矣〖4〗。”太祖不从，军遂无利。﹝一﹞","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":314,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":97,"offset_unit":"unicode_code_point"},{"id":"year-modern","section":"chapter-001","block":"b-888495d8be7766faf20c","quote":"十三年：建安十三年（公元 208）。","layer":"modern","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":666,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0bae348fdb687025113d","start":3,"end":21,"offset_unit":"unicode_code_point"},{"id":"year-original","section":"chapter-001","block":"b-4bcffcc4ee709a4e5ea3","quote":"十三年春正月〖1〗，公还邺。","layer":"original","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":661,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":14,"offset_unit":"unicode_code_point"},{"id":"zhou-year","section":"chapter-054","block":"b-3661896c106f1817bf4b","quote":"十三年春〖6〗，权讨江夏，瑜为前部大督〖7〗。其年九月，曹公入荆州，刘琮举众降。","layer":"original","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":34,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":40,"offset_unit":"unicode_code_point"},{"id":"zhouyu-q-b-63f47c62fde80b3a0132","section":"chapter-054","block":"b-63f47c62fde80b3a0132","layer":"modern","quote":"〖6〗十三年：建安十三年（公元 208）。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":43,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8f109f42647e5ee8d831","start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"zhouyu-q-o009","section":"chapter-054","block":"b-3661896c106f1817bf4b","layer":"original","quote":"十三年春〖6〗，权讨江夏，瑜为前部大督〖7〗。其年九月，曹公入荆州，刘琮举众降。曹公得其水军船，步兵数十万。将士闻之皆恐。（惧）〔权〕延见群下〖8〗，问以计策。议者咸曰：“曹公，豺虎也！然托名汉相，挟天子以征四方，动以朝廷为辞；今日拒之，事更不顺。且将军大势：可以拒操者，长江也。今操得荆州，奄有其地〖9〗；刘表治水军，蒙冲、斗舰〖10〗，乃以千数，操悉浮以沿江；兼有步兵，水陆俱下。此为长江之险，已与我共之矣。而势力众寡，又不可论。愚谓大计不如迎之。”","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":34,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":227,"offset_unit":"unicode_code_point"},{"id":"zhouyu-q-o043","section":"chapter-054","block":"b-b94bb7df529b6cc71bf1","layer":"original","quote":"刘表死，肃进说曰：“夫荆楚与国邻接〖1〗，水流顺北；外带江、汉〖2〗，内阻山陵，有金城之固〖3〗；沃野万里，士民殷富。若据而有之，此帝王之资也。今表新亡，二子素不辑睦〖4〗；军中诸将，各有彼此〖5〗。加刘备天下枭雄，与操有隙〖6〗；寄寓于表，表恶其能而不能用也。若备与彼协心，上下齐同；则宜抚安，与结盟好。如有离违〖7〗，宜别图之，以济大事。肃请得奉命吊表二子，并慰劳其军中用事者〖8〗；及说备使抚表众，同心一意，共治曹操。备必喜而从命。如其克谐〖9〗，天下可定也。今不速往，恐为操所先！”","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":212,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":245,"offset_unit":"unicode_code_point"},{"id":"zhouyu-q-o044","section":"chapter-054","block":"b-ecd089e31afbb09dad94","layer":"original","quote":"权即遣肃行。到夏口，闻曹公已向荆州，晨夜兼道。比至南郡，而表子琮已降曹公；备惶遽奔走，欲南渡江。肃径迎之，到当阳长坂〖10〗，与备会。宣腾权旨〖11〗，及陈江东强固，劝备与权并力：备甚欢悦。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":213,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":95,"offset_unit":"unicode_code_point"},{"id":"zhouyu-q-o097","section":"chapter-054","block":"b-747011f19f5c17079326","layer":"original","quote":"孙权与陆逊论周瑜、鲁肃及蒙，曰：“公瑾雄烈，胆略兼人〖1〗；遂破孟德，开拓荆州：邈焉难继，君今继之。公瑾昔邀子敬来东，致达于孤；孤与宴语，便及大略帝王之业：此一快也〖2〗。后孟德因获刘琮之势，张言方率数十万众水步俱下〖3〗。孤普请诸将，咨问所宜，无适先对〖4〗；至子布、文表〖5〗，俱言宜遣使修檄迎之〖6〗。子敬即驳言不可，劝孤急呼公瑾，付任以众，逆而击之。此二快也。且其决计策意，出张、苏远矣〖7〗；后虽劝吾借玄德地，是其一短，不足以损其二长也。周公不求备于一人〖8〗，故孤忘其短而贵其长，常以比方邓禹也〖9〗。又子明少时，孤谓不辞剧易〖10〗，果敢有胆而已；及身长大，学问开益〖11〗，筹略奇至，可以次于公瑾，但言议英发不及之耳〖12〗。图取关羽，胜于子敬。子敬答孤书云：‘帝王之起，皆有驱除〖13〗：羽不足忌。’此子敬内不能办，外为大言耳；孤亦恕之，不苟责也〖14〗。然其作军屯营，不失令行禁止；部界无废负〖15〗，路无拾遗：其法亦美也。”","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":472,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":423,"offset_unit":"unicode_code_point"},{"id":"zhuge-e-o009a-q","section":"chapter-035","block":"b-d5f4730039ccccd7ce8c","layer":"original","quote":"俄而表卒。琮闻曹公来征，遣使请降。先主在樊闻之，率其众南行，亮与徐庶并从；为曹公所追破，获庶母。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":70,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":48,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-o008","section":"chapter-035","block":"b-5baeb7a9a85977757637","layer":"original","quote":"刘表长子琦，亦深器亮。表受后妻之言，爱少子琮，不悦于琦。琦每欲与亮谋自安之术，亮辄拒塞〖27〗，未与处画〖28〗。琦乃将亮游观后园，共上高楼；饮宴之间，令人去梯，因谓亮曰：“今日上不至天，下不至地；言出子口，入于吾耳：可以言未？”亮答曰：“君不见申生在内而危〖29〗，重耳在外而安乎？”琦意感悟，阴规出计〖30〗；会黄祖死〖31〗，得出，遂为江夏太守。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":33,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":176,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-o009","section":"chapter-035","block":"b-d5f4730039ccccd7ce8c","layer":"original","quote":"俄而表卒。琮闻曹公来征，遣使请降。先主在樊闻之，率其众南行，亮与徐庶并从；为曹公所追破，获庶母。庶辞先主而指其心曰：“本欲与将军共图王霸之业者，以此方寸之地也〖1〗。今已失老母，方寸乱矣；无益于事，请从此别。”遂诣曹公。﹝一﹞","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":70,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":113,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-o075","section":"chapter-035","block":"b-7884de70f24ab42e3178","layer":"original","quote":"亮少有逸群之才〖7〗，英霸之器〖8〗；身长八尺，容貌甚伟：时人异焉。遭汉末扰乱，随叔父玄避难荆州；躬耕于野，不求闻达。时左将军刘备以亮有殊量〖9〗，乃三顾亮于草庐之中；亮深谓备雄姿杰出，遂解带写诚〖10〗，厚相结纳。及魏武帝南征荆州，刘琮举州委质；而备失势众寡〖11〗，无立锥之地。亮时年二十七，乃建奇策；身使孙权〖12〗，求援吴、会。权既宿服仰备〖13〗，又睹亮奇雅，甚敬重之；即遣兵三万人以助备，备得用与武帝交战，大破其军；乘胜克捷，江南悉平。后备又西取益州；益州既定，以亮为军师将军。备称尊号，拜亮为丞相，录尚书事。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":346,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":261,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
