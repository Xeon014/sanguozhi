9c"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[{"id":"santizhu-q-002239fee8d5176421b7","section":"chapter-048","block":"b-db791b7bf69ac554e010","layer":"original","quote":"迫宪令自杀","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":75,"anchor":null},"note_id":null,"start":125,"end":130},{"id":"santizhu-q-1fc193479ec9fde5124f","section":"chapter-048","block":"b-db791b7bf69ac554e010","layer":"original","quote":"孙宪与将军王惇，谋杀綝","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":75,"anchor":null},"note_id":null,"start":106,"end":117},{"id":"santizhu-q-9244b462d5f81e7f4b3f","section":"chapter-048","block":"b-db791b7bf69ac554e010","layer":"original","quote":"冬十月丁未〖9〗，遣孙宪及丁奉、施宽等，以舟兵逆据于江都","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":75,"anchor":null},"note_id":null,"start":0,"end":28},{"id":"santizhu-q-c603ff0f3115a916dd10","section":"chapter-048","block":"b-827c97fc82e30ff0481c","layer":"original","quote":"綝遣使以诏书告喻钦、咨等，使取据","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":74,"anchor":null},"note_id":null,"start":138,"end":154},{"id":"santizhu064-q-08b5d05977df052fc27f","section":"chapter-064","block":"b-1ed38589f87657ef9de1","layer":"original","quote":"綝遇（虑）〔宪〕薄于峻时〖14〗。（虑）〔宪〕怒，与将军王惇谋杀綝。綝杀惇，（虑）〔宪〕服药死","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":420,"anchor":null},"note_id":null,"start":50,"end":97},{"id":"santizhu064-q-d291c494e8c9a9a2091f","section":"chapter-064","block":"b-da2900eb25692ecb6e49","layer":"original","quote":"据引兵还，使人报胤，欲共废綝。綝闻之，遣从兄（虑）〔宪〕，将兵逆据于江都〖3〗；使中使敕文钦、刘纂、唐咨等，合众击据；遣侍中、左将军华融、中书丞丁晏，告胤取据，并喻胤宜速去意〖4〗。胤自以祸及，因留融、晏，勒兵自卫","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":416,"anchor":null},"note_id":null,"start":47,"end":154},{"id":"zhulv-q-a10a3c3eee3aa2496b9c","section":"chapter-056","block":"b-321b841bc136cd345e37","layer":"original","quote":"綝闻之，使中书奉诏〖9〗，诏文钦、刘纂、唐咨等，使取据；又遣从兄（虑）〔宪〕，以都下兵逆据于江都","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":201,"anchor":null},"note_id":null,"start":42,"end":90}],"profiles":{},"directory_counts":{}}
