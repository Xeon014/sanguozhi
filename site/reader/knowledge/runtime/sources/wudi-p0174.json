bef24eb2ccd4201e078"]},{"id":"lvzang-m-review-14e84f1ee31c612d23ff","kind":"mention","text":"郭图见于相关言论或记载。","evidence":["lvzang-q-2701a536347d80e6f81a"]}]}],"evidence":[{"id":"chengguo-q-4b38bb4beccdfc00ad0c","section":"chapter-014","block":"b-546398c9e99f491661e8","layer":"original","quote":"袁绍遣将颜良攻东郡，","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":178,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":92,"end":102,"offset_unit":"unicode_code_point"},{"id":"chengguo-q-8bef24eb2ccd4201e078","section":"chapter-014","block":"b-b44889ce722aa8e51686","layer":"original","quote":"诸将欲乘胜遂攻之，嘉曰：“袁绍爱此二子，莫适立也〖1〗。有郭图、逢纪为之谋臣〖2〗，必交斗其间，还相离也。急之则相持，缓之而后争心生。不如南向荆州，若征刘表者，以待其变；变成而后击之，可一举而定也。”太祖曰：“善！”乃南征","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":118,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":23,"end":134,"offset_unit":"unicode_code_point"},{"id":"chengguo-q-d97fe513bc64a9c81476","section":"chapter-014","block":"b-d004c4e3371af3fa942a","layer":"original","quote":"又从攻谭于南皮，冀州平。","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":119,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":42,"end":54,"offset_unit":"unicode_code_point"},{"id":"chengguo-q-f1f51e54cea89314c79b","section":"chapter-014","block":"b-533a557d88be4ea477ea","layer":"original","quote":"北见袁绍。谓绍谋臣辛评、郭图曰：“夫智者审于量主〖2〗，故百举百全，而功名可立也。袁公徒欲效周公之下士，而未知用人之机；多端寡要，好谋无决。欲与共济天下大难，定霸王之业，难矣！”于是遂去之","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":99,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":21,"end":115,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-o043a-q","section":"chapter-006","block":"b-f988b3054676196fd6b6","layer":"original","quote":"初，天子之立，非绍意；及在河东，绍遣颍川郭图使焉〖1〗。图还说绍迎天子都邺〖2〗，绍不从。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":277,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":45,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-o057a-q","section":"chapter-006","block":"b-b7192caf40241d8b9cd4","layer":"original","quote":"绍爱少子尚，貌美，欲以为后而未显〖1〗。﹝一﹞审配、逢纪与辛评、郭图争权：配、纪与尚比〖2〗；评、图与谭比。众以谭长，欲立之。配等恐谭立而评等为己害，缘绍素意〖3〗，乃奉尚代绍位；谭至〖4〗，不得立，自号“车骑将军”：由是谭、尚有隙。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":338,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":117,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-o059a-q","section":"chapter-006","block":"b-ad4084dfd65b559ba1b5","layer":"original","quote":"太祖南征荆州。军至西平，谭、尚遂举兵相攻，谭败奔平原。尚攻之急，谭遣辛毗，诣太祖请救。太祖乃还救谭，十月至黎阳。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":340,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":56,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-o064c-q","section":"chapter-006","block":"b-bbda43a18f268bb91c8f","layer":"original","quote":"十年正月，攻拔之，斩谭及图等。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":371,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":96,"end":111,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p070a-q","section":"chapter-006","block":"b-f788287ac55fa0fa37e8","layer":"pei","quote":"﹝一﹞《献帝传》曰：“沮授说绍云：‘将军累叶辅弼，世济忠义。今朝廷播越，宗庙毁坏。观诸州郡，外托义兵，内图相灭，未有存主恤民者。且今州城粗定，宜迎大驾，安宫邺都；挟天子而令诸侯，畜士马以讨不庭：谁能御之！’绍悦，将从之。郭图、淳于琼曰：‘汉室陵迟，为日久矣；今欲兴之，不亦难乎？且今英雄据有州郡，众动万计；所谓秦失其鹿，先得者王。若迎天子以自近，动辄表闻；从之则权轻，违之则拒命：非计之善者也。’授曰：‘今迎朝廷，至义也；又于时宜，大计也。若不早图，必有先人者也。夫权不失机，功在速捷，将军其图之！’绍弗能用。”","attribution":"《献帝传》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":288,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1c5f3bd8be343c161b14","start":0,"end":256,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p077a-q","section":"chapter-006","block":"b-a3494accaa682ca8b6b8","layer":"pei","quote":"绍将南师，沮授、田丰谏曰：‘师出历年，百姓疲弊；仓庾无积，赋役方殷：此国之深忧也。宜先遣使献捷天子，务农逸民。若不得通，乃表曹氏隔我王路。然后进屯黎阳，渐营河南；益作舟船，缮治器械；分遣精骑，抄其边鄙；令彼不得安，我取其逸。三年之中，事可坐定也！’审配、郭图曰：‘兵书之法：十围，五攻，敌则能战。今以明公之神武，跨河朔之强众，以伐曹氏，譬若覆手；今不时取，后难图也！’授曰：‘盖救乱诛暴，谓之义兵；恃众凭强，谓之骄兵：兵义无敌，骄者先灭。曹氏迎天子安宫许都，今举兵南向，于义则违。且庙胜之策，不在强弱。曹氏法令既行，士卒精练，非公孙瓒坐受围者也。今弃万安之术，而兴无名之兵，窃为公惧之！’图等曰：‘武王伐纣，不曰不义；况兵加曹氏，而云无名！且公师武臣竭力，将士愤怒，人思自骋；而不及时早定大业，虑之失也。夫天与弗取，反受其咎；此越之所以霸，吴之所以亡也。监军之计，计在持牢，而非见时知机之变也！’绍从之。","attribution":"《献帝传》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":295,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f9b297d2a3b3d9e09127","start":8,"end":410,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p077b-q","section":"chapter-006","block":"b-a3494accaa682ca8b6b8","layer":"pei","quote":"图等因是谮授：‘监统内外，威震三军；若其浸盛，何以制之？夫臣与主不同者昌，主与臣同者亡，此《黄石》之所忌也。且御众于外，不宜知内。’绍疑焉，乃分监军为三都督，使授及郭图、淳于琼各典一军；遂合而南。","attribution":"《献帝传》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":295,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f9b297d2a3b3d9e09127","start":410,"end":508,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p081a-q","section":"chapter-006","block":"b-3983be0b9153ad2fe653","layer":"pei","quote":"﹝二﹞《献帝传》曰：“绍将济河，沮授谏曰：‘胜负变化，不可不详。今宜留屯延津，分兵官渡：若其克获，还迎不晚；设其有难，众弗可还。’绍弗从。授临济叹曰：‘上盈其志，下务其功；悠悠黄河，吾其不反乎！’遂以疾辞。绍恨之，乃省其所部兵，属郭图。”","attribution":"《献帝传》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":332,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-2dd06a580c6e0907df4f","start":0,"end":119,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p092b-q","section":"chapter-006","block":"b-d1ac25c0fe590383f25a","layer":"pei","quote":"谭得书怅然，登城而泣。既劫于郭图，亦以兵锋累交，遂战不解。","attribution":"《典略》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":366,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-d4092507457afdb1079c","start":1145,"end":1174,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o043","section":"chapter-006","block":"b-f988b3054676196fd6b6","layer":"original","quote":"初，天子之立，非绍意；及在河东，绍遣颍川郭图使焉〖1〗。图还说绍迎天子都邺〖2〗，绍不从。﹝一﹞会太祖迎天子都许，收河南地，关中皆附。绍悔，欲令太祖徙天子都鄄城，以自密近〖3〗；太祖拒之。天子以绍为太尉，转为大将军，封邺侯，﹝二﹞绍让侯不受。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":277,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":121,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o057","section":"chapter-006","block":"b-b7192caf40241d8b9cd4","layer":"original","quote":"绍爱少子尚，貌美，欲以为后而未显〖1〗。﹝一﹞审配、逢纪与辛评、郭图争权：配、纪与尚比〖2〗；评、图与谭比。众以谭长，欲立之。配等恐谭立而评等为己害，缘绍素意〖3〗，乃奉尚代绍位；谭至〖4〗，不得立，自号“车骑将军”：由是谭、尚有隙。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":338,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":117,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o064","section":"chapter-006","block":"b-bbda43a18f268bb91c8f","layer":"original","quote":"太祖之围邺也，谭略取甘陵、安平、勃海、河间，攻尚于中山。尚走故安，从熙；谭悉收其众，太祖将讨之。谭乃拔平原，并南皮，自屯龙凑〖1〗。十二月，太祖军其门，谭不出。夜遁，奔南皮，临清河而屯〖2〗。十年正月，攻拔之，斩谭及图等。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":371,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":111,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p070","section":"chapter-006","block":"b-f788287ac55fa0fa37e8","layer":"pei","quote":"﹝一﹞《献帝传》曰：“沮授说绍云：‘将军累叶辅弼，世济忠义。今朝廷播越，宗庙毁坏。观诸州郡，外托义兵，内图相灭，未有存主恤民者。且今州城粗定，宜迎大驾，安宫邺都；挟天子而令诸侯，畜士马以讨不庭：谁能御之！’绍悦，将从之。郭图、淳于琼曰：‘汉室陵迟，为日久矣；今欲兴之，不亦难乎？且今英雄据有州郡，众动万计；所谓秦失其鹿，先得者王。若迎天子以自近，动辄表闻；从之则权轻，违之则拒命：非计之善者也。’授曰：‘今迎朝廷，至义也；又于时宜，大计也。若不早图，必有先人者也。夫权不失机，功在速捷，将军其图之！’绍弗能用。”","attribution":"《献帝传》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":288,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1c5f3bd8be343c161b14","start":0,"end":256,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p071","section":"chapter-006","block":"b-19646086a63e95e8273a","layer":"pei","quote":"按此书称郭图之计，则与本传违也。","attribution":"裴松之按","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":289,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1c5f3bd8be343c161b14","start":0,"end":16,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p071-judgment","section":"chapter-006","block":"b-19646086a63e95e8273a","layer":"pei","quote":"按此书称郭图之计，则与本传违也。","attribution":"裴松之按","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":289,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1c5f3bd8be343c161b14","start":0,"end":16,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p077","section":"chapter-006","block":"b-a3494accaa682ca8b6b8","layer":"pei","quote":"《献帝传》曰：“绍将南师，沮授、田丰谏曰：‘师出历年，百姓疲弊；仓庾无积，赋役方殷：此国之深忧也。宜先遣使献捷天子，务农逸民。若不得通，乃表曹氏隔我王路。然后进屯黎阳，渐营河南；益作舟船，缮治器械；分遣精骑，抄其边鄙；令彼不得安，我取其逸。三年之中，事可坐定也！’审配、郭图曰：‘兵书之法：十围，五攻，敌则能战。今以明公之神武，跨河朔之强众，以伐曹氏，譬若覆手；今不时取，后难图也！’授曰：‘盖救乱诛暴，谓之义兵；恃众凭强，谓之骄兵：兵义无敌，骄者先灭。曹氏迎天子安宫许都，今举兵南向，于义则违。且庙胜之策，不在强弱。曹氏法令既行，士卒精练，非公孙瓒坐受围者也。今弃万安之术，而兴无名之兵，窃为公惧之！’图等曰：‘武王伐纣，不曰不义；况兵加曹氏，而云无名！且公师武臣竭力，将士愤怒，人思自骋；而不及时早定大业，虑之失也。夫天与弗取，反受其咎；此越之所以霸，吴之所以亡也。监军之计，计在持牢，而非见时知机之变也！’绍从之。图等因是谮授：‘监统内外，威震三军；若其浸盛，何以制之？夫臣与主不同者昌，主与臣同者亡，此《黄石》之所忌也。且御众于外，不宜知内。’绍疑焉，乃分监军为三都督，使授及郭图、淳于琼各典一军；遂合而南。”","attribution":"《献帝传》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":295,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f9b297d2a3b3d9e09127","start":0,"end":509,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p081","section":"chapter-006","block":"b-3983be0b9153ad2fe653","layer":"pei","quote":"﹝二﹞《献帝传》曰：“绍将济河，沮授谏曰：‘胜负变化，不可不详。今宜留屯延津，分兵官渡：若其克获，还迎不晚；设其有难，众弗可还。’绍弗从。授临济叹曰：‘上盈其志，下务其功；悠悠黄河，吾其不反乎！’遂以疾辞。绍恨之，乃省其所部兵，属郭图。”","attribution":"《献帝传》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":332,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-2dd06a580c6e0907df4f","start":0,"end":119,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p091","section":"chapter-006","block":"b-1fb2b33408bd5b09b86f","layer":"pei","quote":"又遗尚书曰：‘知变起辛、郭，祸结同生；追阏伯、实沈之踪，忘《常棣》死丧之义；亲寻干戈，僵尸流血；闻之哽咽，虽存若亡。昔轩辕有涿鹿之战，周（武）〔公〕有商、奄之师；皆所以翦除秽害而定王业，非强弱之（事）争，喜怒之忿也。故虽灭亲不为尤，诛兄不伤义。今二君初承洪业，纂继前轨；进有国家倾危之虑，退有先公遗恨之负；当唯义是务，唯国是康。何者？金木水火以刚柔相济，然后克得其和，能为民用。今青州天性峭急，迷于曲直；仁君度数弘广，绰然有余；当以大包小，以优容劣，先除曹操，以卒先公之恨。事定之后，乃议曲直之计，不亦善乎！若留神远图，克己复礼；当振旆长驱，共奖王室。若迷而不反，违而无改；则胡夷将有诮让之言，况我同盟，复能戮力为君之役哉？此韩卢、东郭自困于前而遗田父之获者也。愤踊鹤望，冀闻和同之声。若其泰也，则袁族其与汉升降乎！如其否也，则同盟永无望矣！’谭、尚尽不从。”","attribution":"《魏氏春秋》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":365,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-d4092507457afdb1079c","start":0,"end":380,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p092","section":"chapter-006","block":"b-d1ac25c0fe590383f25a","layer":"pei","quote":"《春秋》之义：国君死社稷，忠臣死王命。苟有图危宗庙，败乱国家，王纲典律，亲疏一也。是以周公垂泣而蔽管、蔡之狱，季友歔欷而行>叔之鸩。何则？义重人轻，事不得已也。昔卫灵公废蒯聩而立辄，蒯聩为不道，入戚以篡，卫师伐之。《春秋传》曰：‘以石曼姑之义，为可以拒之。’是以蒯聩终获叛逆之罪，而曼姑永享忠臣之名。父子犹然，岂况兄弟乎！昔先公废黜将军以续贤兄，立我将军以为嫡嗣；上告祖灵，下书谱牒；先公谓将军为兄子，将军谓先公为叔父；海内远近，谁不备闻？且先公即世之日，我将军斩衰居庐，而将军斋于垩室；出入之分，于斯益明。是时凶臣逢纪，妄画蛇足，曲辞谄媚，交乱懿亲。 〔我〕 将军奋赫然之怒，诛不旋时；将军亦奉命承旨，加以淫刑。自是之后，痈疽破溃，骨肉无丝发之嫌；自疑之臣，皆保生全之福。故悉遣强胡，简命名将；料整器械，选择战士；殚府库之财，竭食土之实：其所以供奉将军，何求而不备？君臣相率，共卫旌麾，战为雁行，赋为币主；虽倾仓覆库，翦剥民物，上下欣戴，莫敢告劳。何则？推恋恋忠赤之情，尽家家肝脑之计，唇齿辅车，不相为赐。谓为将军心合意同，混齐一体；必当并威偶势，御寇宁家。何图凶险谗慝之人，造饰无端，诱导奸利；至令将军幡然改图，忘孝友之仁，听豺狼之谋，诬先公废立之言，违近者在丧之位，悖纪纲之理，不顾逆顺之节。横易冀州之主，欲当先公之继；遂放兵抄拨，屠城杀吏，交尸盈原，裸民满野；或有髡剃发肤，割截支体，冤魂痛于幽冥，创痍号于草棘；又乃图获邺城，许赐秦胡财物、妇女，豫有分界。或闻告令吏士云：‘孤虽有老母，辄使身体完具而已。’闻此言者，莫不惊愕失气，悼心挥涕。使太夫人忧哀愤懑于堂室，我州君臣士友假寐悲叹，无所措其手足。念欲静师拱默以听执事之图，则惧违《春秋》死命之节，贻太夫人不测之患，陨先公高世之业；且三军愤慨，人怀私怒；我将军辞不获已，以及馆陶之役。是时外为御难，内实乞罪；既不见赦，而徒属各二三其心，临阵叛戾。我将军进退无功，首尾受敌，引军奔避，不敢告辞。亦谓将军当少垂亲亲之仁，贶以缓追之惠；而乃寻踪蹑轨，无所逃命，困兽必斗，以干严行；而将军师旅土崩瓦解，此非人力，乃天意也。是后又望将军改往修来，克己复礼，追还孔怀如初之爱；而纵情肆怒，趣破家门，企踵鹤立，连结外仇，散锋放火，播增毒螫，烽烟相望，涉血千里。遗城厄民，引领悲怨；虽欲勿救，恶得已哉！故遂引军东辕，保正疆埸；虽近郊垒，未侵境域，然望旌麾，能不永叹？配等备先公家臣，奉废立之命。而图等干国乱家，礼有常刑。故奋敝州之赋，以除将军之疾。若乃天启于心，早行其诛，则我将军匍匐悲号于将军股掌之上，配等亦袒躬布体以待斧钺之刑。若必不悛，有以国毙；图头不悬，军不旋踵。愿将军详度事宜，锡以环玦！","attribution":"《汉晋春秋》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":366,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-d4092507457afdb1079c","start":16,"end":1137,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p093","section":"chapter-006","block":"b-9dda0d062dbbcc67a030","layer":"pei","quote":"﹝四﹞《先贤行状》曰：“配字正南，魏郡人。少忠烈慷慨，有不可犯之节。袁绍领冀州，委以腹心之任，以为治中、别驾，并总幕府。初，谭之去，皆呼辛毗、郭图家得出，而辛评家独被收。乃配兄子开城门纳兵，时配在城东南角楼上；望见太祖兵入，忿辛、郭坏败冀州；乃遣人驰诣邺狱，指杀仲治家。是时，辛毗在军，闻门开，驰走诣狱，欲解其兄家，兄家已死。是日生缚配，将诣帐下，辛毗等逆以马鞭击其头，骂之曰：‘奴，汝今日真死矣！’配顾曰：‘狗辈，正由汝曹破我冀州，恨不得杀汝也！且汝今日能杀生我邪？’有顷，公引见，谓配：‘知谁开卿城门？’配曰：‘不知也。’曰：‘自卿（文）〔子〕荣耳。’配曰：‘小儿不足用乃至此！’公复谓曰：‘曩日孤之行围，何弩之多也？’配曰：‘恨其少耳！’公曰：‘卿忠于袁氏父子，亦自不得不尔也。’有意欲活之。配既无挠辞，而辛毗等号哭不已，乃杀之。初，冀州人张子谦，先降，素与配不善，笑谓配曰：‘正南，卿竟何如我？’配厉声曰：‘汝为降虏，审配为忠臣；虽死，岂若汝生邪！’临行刑，叱持兵者，令北向，曰：‘我君在北！’”","attribution":"《先贤行状》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":367,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-039596b0e60212abbbbd","start":0,"end":452,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-684adf372b31795beec5","section":"chapter-008","block":"b-c43038671a6cb4b7444f","layer":"original","quote":"从破袁谭于南皮，复增邑凡二千户。是时天下户口减耗，十才一在，诸将封未有满千户者；而绣特多","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":255,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":76,"end":120,"offset_unit":"unicode_code_point"},{"id":"liusima-q-89c21f65eff1bdd285ac","section":"chapter-015","block":"b-2fb260215c97884ad3d8","layer":"pei","quote":"太祖进攻谭，谭战死","attribution":"裴注·魏略列传","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":300,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-aaaf08e9bea919e96c3f","start":717,"end":726,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-2701a536347d80e6f81a","section":"chapter-007","block":"b-b5a8e80047e9a4963fee","layer":"pei","quote":"臣松之按《英雄记》云：“袁绍使张景明、郭公则、高元才等，说韩馥，使让冀州。”然馥之让位，景明亦有其功；其余之事未详","attribution":"裴注·注家按语","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":332,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4aeb0f163ff8b37978d7","start":3,"end":60,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o073a-q","section":"chapter-001","block":"b-bdf74b1bb7e00110c2b0","layer":"original","quote":"二月，绍遣郭图、淳于琼、颜良攻东郡太守刘延于白马〖1〗；绍引兵至黎阳，将渡河。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":410,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":39,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o090c-q","section":"chapter-001","block":"b-9569c2e9d7bc71b7bd88","layer":"original","quote":"公之去邺而南也，谭、尚争冀州。谭为尚所败，走保平原〖6〗。尚攻之急，谭遣辛毗乞降请救〖7〗。诸将皆疑，荀攸劝公许之；﹝一﹞公乃引军还。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":490,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":111,"end":178,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o100a-q","section":"chapter-001","block":"b-1ca17316b02d7b4d213c","layer":"original","quote":"十年春正月〖1〗，攻谭，破之。斩谭，诛其妻子〖2〗，冀州平。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":557,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":30,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-2e98e13ca098117a86e9","section":"chapter-001","block":"b-2e98e13ca098117a86e9","layer":"modern","quote":"〖1〗十年：建安十年（公元 205）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":560,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a9b0434ee8de64aed40f","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-9900125064e5d85f08ad","section":"chapter-001","block":"b-9900125064e5d85f08ad","layer":"modern","quote":"〖1〗五年：建安五年（公元 200）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":403,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-744e4aee7f5ff14cca85","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-fa887192716200f6f3cb","section":"chapter-001","block":"b-fa887192716200f6f3cb","layer":"modern","quote":"〖2〗八年：建安八年（公元 203）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":481,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-09a0cf6c0d76993997e0","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o071","section":"chapter-001","block":"b-c9f735ddad48a8f5c2b6","layer":"original","quote":"五年春正月〖1〗，董承等谋泄，皆伏诛。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":400,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o073","section":"chapter-001","block":"b-bdf74b1bb7e00110c2b0","layer":"original","quote":"二月，绍遣郭图、淳于琼、颜良攻东郡太守刘延于白马〖1〗；绍引兵至黎阳，将渡河。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":410,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":39,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o088","section":"chapter-001","block":"b-b55e52dce3d59a3bbee9","layer":"original","quote":"八年春三月〖2〗，攻其郭〖3〗；乃出战。击，大破之，谭、尚夜遁。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":477,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":32,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o100","section":"chapter-001","block":"b-1ca17316b02d7b4d213c","layer":"original","quote":"十年春正月〖1〗，攻谭，破之。斩谭，诛其妻子〖2〗，冀州平。﹝一﹞下令曰：“其与袁氏同恶者，与之更始〖3〗。”令民不得复私仇，禁厚葬；皆一之于法〖4〗。是月，袁熙大将焦触、张南等叛〖5〗，攻熙、尚；熙、尚奔三郡乌丸〖6〗。触等举其县降，封为列侯。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":557,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":123,"offset_unit":"unicode_code_point"},{"id":"xinyang-q-c89415e5239c8ec33838","section":"chapter-025","block":"b-0d4bc5347f62e5114dd4","layer":"pei","quote":"﹝一﹞《英雄记》曰：“谭、尚战于外门，谭军败奔北。郭图说谭曰：‘今将军国小兵少，粮匮势弱；显甫之来，久则不敌。愚以为可呼曹公来击显甫。曹公至，必先攻邺，显甫还救；将军引兵而西，自邺以北皆可虏得。若显甫军破，其兵奔亡，又可敛取以拒曹公；曹公远侨而来，粮饷不继，必自逃去。比此之际，赵国以北皆我之有，亦足与曹公为对矣。不然，不谐！’谭始不纳，后遂从之。问图：‘谁可使？’图答：‘辛佐治可。’谭遂遣毗诣太祖。”","attribution":"裴注·英雄记","section_title":"辛毗杨阜高堂隆传第二十五","source":{"file":"OEBPS/Text/titlepage_0056.xhtml","index":35,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-51ccf0b87f5dceb0f626","start":0,"end":202,"offset_unit":"unicode_code_point"},{"id":"xinyang-q-d9f6ec16d5796978889b","section":"chapter-025","block":"b-a4e72349e106ad932833","layer":"original","quote":"及袁尚攻兄谭于平原〖2〗，谭使毗诣太祖求和〖3〗。","section_title":"辛毗杨阜高堂隆传第二十五","source":{"file":"OEBPS/Text/titlepage_0056.xhtml","index":1,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":52,"end":77,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-o004","section":"chapter-010","block":"b-976aa8aeb866c7b60ba5","layer":"original","quote":"会冀州牧同郡韩馥，遣骑迎之，莫有随者，彧独将宗族，至冀州。而袁绍已夺馥位，待彧以上宾之礼；彧弟谌及同郡辛评、郭图，皆为绍所任。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":4,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":63,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-3b4ebaf56da54f7c5b11","section":"chapter-011","block":"b-d3d33978547fafd309bf","layer":"original","quote":"太祖既破冀州，谭又叛。太祖遂引军攻谭于南皮","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":279,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":180,"end":201,"offset_unit":"unicode_code_point"},{"id":"zhangle-e-o029a-q","section":"chapter-017","block":"b-a4ccf00fcd84c9fc6e1a","layer":"original","quote":"太祖与袁绍相拒于官渡。﹝一﹞绍遣将淳于琼等督运，屯乌巢，太祖自将急击之。郃说绍曰：“曹公兵精，往必破琼等；琼等破，则将军事去矣：宜急引兵救之！”郭图曰：“郃计非也！不如攻其本营，势必还；此为不救而自解也。”郃曰：“曹公营固，攻之必不拔；若琼等见擒，吾属尽为虏矣。”绍但遣轻骑救琼；而以重兵攻太祖营，不能下。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":101,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":153,"offset_unit":"unicode_code_point"},{"id":"zhangle-e-o029b-q","section":"chapter-017","block":"b-a4ccf00fcd84c9fc6e1a","layer":"original","quote":"太祖果破琼等，绍军溃。图惭，又更谮郃曰：“郃快军败〖2〗，出言不逊。”郃惧，乃归太祖。﹝二﹞太祖得郃甚喜，谓曰：“昔子胥不早悟〖3〗，自使身危；岂若微子去殷、韩信归汉邪！”","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":101,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":153,"end":239,"offset_unit":"unicode_code_point"},{"id":"zhangle-q-o029","section":"chapter-017","block":"b-a4ccf00fcd84c9fc6e1a","layer":"original","quote":"太祖与袁绍相拒于官渡。﹝一﹞绍遣将淳于琼等督运，屯乌巢，太祖自将急击之。郃说绍曰：“曹公兵精，往必破琼等；琼等破，则将军事去矣：宜急引兵救之！”郭图曰：“郃计非也！不如攻其本营，势必还；此为不救而自解也。”郃曰：“曹公营固，攻之必不拔；若琼等见擒，吾属尽为虏矣。”绍但遣轻骑救琼；而以重兵攻太祖营，不能下。太祖果破琼等，绍军溃。图惭，又更谮郃曰：“郃快军败〖2〗，出言不逊。”郃惧，乃归太祖。﹝二﹞太祖得郃甚喜，谓曰：“昔子胥不早悟〖3〗，自使身危；岂若微子去殷、韩信归汉邪！”","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":101,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":239,"offset_unit":"unicode_code_point"},{"id":"zhangle-q-p007","section":"chapter-017","block":"b-cfe26b6568d95feca7e6","layer":"pei","quote":"﹝二﹞臣松之按《武纪》及《袁绍传》，并云：袁绍使张郃、高览攻太祖营，郃等闻淳于琼破，遂来降，绍众于是大溃。是则缘郃等降，而后绍军坏也。至如此传，为绍军先溃，惧郭图之谮，然后归太祖：为参错不同矣。","attribution":"裴松之按","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":118,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-35bb4026c88951933765","start":0,"end":97,"offset_unit":"unicode_code_point"},{"id":"zhangle-q-p007-judgment","section":"chapter-017","block":"b-cfe26b6568d95feca7e6","layer":"pei","quote":"﹝二﹞臣松之按《武纪》及《袁绍传》，并云：袁绍使张郃、高览攻太祖营，郃等闻淳于琼破，遂来降，绍众于是大溃。是则缘郃等降，而后绍军坏也。至如此传，为绍军先溃，惧郭图之谮，然后归太祖：为参错不同矣。","attribution":"裴松之按","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":118,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-35bb4026c88951933765","start":0,"end":97,"offset_unit":"unicode_code_point"},{"id":"zhonghua-q-293625f9f1520d33033d","section":"chapter-013","block":"b-0804a5a1c095100b748a","layer":"pei","quote":"南阳阴修，为颍川太守，以旌贤擢俊为务。举五官掾张仲方正；察功曹钟繇、主簿荀彧、主记掾张礼、贼曹掾杜祐、孝廉荀攸、计吏郭图，为吏：以光国朝。”","attribution":"裴注·谢承后汉书","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":16,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-e1aa5c3c3a564921b116","start":13,"end":83,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
