-q-4be0c977072286ffa6c6"]}],"participants":[{"person":"wendi-p0053","role":"言管统虽在海表此人不反必来","evidence":["yuanzhang-q-4be0c977072286ffa6c6"]},{"person":"yuanzhang-p0060","role":"果弃其妻子来赴袁谭","evidence":["yuanzhang-q-4be0c977072286ffa6c6"]},{"person":"wudi-p0163","role":"更以管统为乐安太守","evidence":["yuanzhang-q-4be0c977072286ffa6c6"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["yuanzhang-q-4be0c977072286ffa6c6"]},"ordering_evidence":"yuanzhang-q-4be0c977072286ffa6c6","source_order":[11,279,153],"order":2601},{"id":"yuanzhang-e-o088","title":"谭复欲攻尚，王修谏兄弟还相攻击是败亡之道，谭不悦然知其志节","accounts":[{"id":"yuanzhang-a-e88e9c47bd60d9008d0e","label":"正文","text":"谭复欲攻尚，王修谏兄弟还相攻击是败亡之道，谭不悦然知其志节","evidence":["yuanzhang-q-5a2f3a8101756cf8d343"]},{"id":"yuanzhang-a-cb6cc5fb42fa4bed98e9","label":"正文","text":"谭问计安出，王修以兄弟左右手为喻，愿斩佞臣数人复相亲睦；谭不听，遂与尚相攻击，请救于太祖","evidence":["yuanzhang-q-b2634bbf6292b11e6a2a"]}],"participants":[{"person":"wudi-p0163","role":"复欲攻袁尚，闻谏不悦，然知王修志节；问计安出，不听王修之言，遂与袁尚相攻击，请救于太祖","evidence":["yuanzhang-q-5a2f3a8101756cf8d343","yuanzhang-q-b2634bbf6292b11e6a2a"]},{"person":"wendi-p0053","role":"谏兄弟还相攻击是败亡之道；以兄弟左右手为喻，愿其塞耳勿听谗人，斩佞臣数人复相亲睦以御四方","evidence":["yuanzhang-q-5a2f3a8101756cf8d343","yuanzhang-q-b2634bbf6292b11e6a2a"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["yuanzhang-q-5a2f3a8101756cf8d343","yuanzhang-q-b2634bbf6292b11e6a2a"]},"ordering_evidence":"yuanzhang-q-5a2f3a8101756cf8d343","source_order":[11,280,0],"order":2602},{"id":"yuanzhang-e-o090","title":"王修时运粮在乐安，闻谭急，将所领兵及诸从事数十人往赴谭；至高密闻谭死，下马号哭无君焉归","accounts":[{"id":"yuanzhang-a-9a90107cc5bb9bf6b50c","label":"正文","text":"王修时运粮在乐安，闻谭急，将所领兵及诸从事数十人往赴谭；至高密闻谭死，下马号哭无君焉归","evidence":["yuanzhang-q-0e45a3cbdaf9ce0ec072"]},{"id":"yuanzhang-a-2b7cfc8387011f5e40b4","label":"正文","text":"王修诣太祖乞收葬谭尸，太祖默然不应；修言受袁氏厚恩若得收敛谭尸然后就戮无所恨","evidence":["yuanzhang-q-92b17e6e14fd2b10574d"]},{"id":"yuanzhang-a-5a61435ab2d59eed0cc7","label":"正文","text":"太祖嘉王修之义听之，以修为督军粮还乐安","evidence":["yuanzhang-q-d7fd3d355b967e850681"]},{"id":"yuanzhang-a-c58c13edeaf2851fa96d","label":"裴注·傅子","text":"《傅子》并记王修、田畴同哭袁谭；裴松之据《田畴传》指出田畴受袁尚辟、非谭命，质疑其合述。","evidence":["yuanzhang-q-a3383909eafd8396ae7e","yuanzhang-q2-513a3c93741a277e40d9"]}],"participants":[{"person":"wendi-p0053","role":"时运粮在乐安，闻谭急将所领兵及诸从事数十人往赴，至高密闻谭死，下马号哭曰无君焉归；诣太祖乞收葬谭尸，言受袁氏厚恩，若得收敛谭尸然后就戮无所恨；为督军粮，还乐安；与田畴相谓生受辟命亡而不哭非义也，畏死亡义何以立世，遂造袁谭之首而哭之","evidence":["yuanzhang-q-0e45a3cbdaf9ce0ec072","yuanzhang-q-92b17e6e14fd2b10574d","yuanzhang-q-d7fd3d355b967e850681","yuanzhang-q-a3383909eafd8396ae7e"]},{"person":"wudi-p0163","role":"死，王修闻之号哭；尸乞收葬；被诛枭首，王修、田畴造其首哭之","evidence":["yuanzhang-q-0e45a3cbdaf9ce0ec072","yuanzhang-q-92b17e6e14fd2b10574d","yuanzhang-q-a3383909eafd8396ae7e"]},{"person":"cao-cao","role":"欲观修意，默然不应；嘉王修之义听之，以修为督军粮；诛袁谭枭其首，令敢哭之者戮及妻子，闻军正白行其戮曰义士也，赦之","evidence":["yuanzhang-q-92b17e6e14fd2b10574d","yuanzhang-q-d7fd3d355b967e850681","yuanzhang-q-a3383909eafd8396ae7e"]},{"person":"wudi-p0243","role":"与王修相谓而同哭袁谭之首","evidence":["yuanzhang-q-a3383909eafd8396ae7e"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["yuanzhang-q-0e45a3cbdaf9ce0ec072","yuanzhang-q-92b17e6e14fd2b10574d","yuanzhang-q-d7fd3d355b967e850681","yuanzhang-q-a3383909eafd8396ae7e"]},"ordering_evidence":"yuanzhang-q-0e45a3cbdaf9ce0ec072","source_order":[11,280,202],"order":2603},{"id":"yuanzhang-e-o091","title":"谭破诸城皆服，唯管统以乐安不从命；太祖命修取统首，修以统亡国之忠臣解其缚使诣太祖，太祖悦而赦之","accounts":[{"id":"yuanzhang-a-bb7198a440cc9afb4a66","label":"正文","text":"谭破诸城皆服，唯管统以乐安不从命；太祖命修取统首，修以统亡国之忠臣解其缚使诣太祖，太祖悦而赦之","evidence":["yuanzhang-q-671d473b40fa0c999f2c"]}],"participants":[{"person":"cao-cao","role":"命王修取管统首，悦而赦之","evidence":["yuanzhang-q-671d473b40fa0c999f2c"]},{"person":"wendi-p0053","role":"以管统为亡国之忠臣，因解其缚，使诣太祖","evidence":["yuanzhang-q-671d473b40fa0c999f2c"]},{"person":"yuanzhang-p0060","role":"以乐安不从命，被解缚得赦","evidence":["yuanzhang-q-671d