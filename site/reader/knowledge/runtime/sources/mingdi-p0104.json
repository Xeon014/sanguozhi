{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"mingdi-e-p058a","title":"曹叡拟以曹宇与夏侯献曹爽曹肇秦朗共辅政","accounts":[{"id":"mingdi-e-p058a-account","label":"裴注·汉晋春秋","text":"曹叡拟以曹宇与夏侯献曹爽曹肇秦朗共辅政","evidence":["mingdi-e-p058a-q"]}],"participants":[{"person":"wendi-p0005","role":"拟命辅政","evidence":["mingdi-e-p058a-q"]},{"person":"mingdi-p0055","role":"受命","evidence":["mingdi-e-p058a-q"]},{"person":"mingdi-p0104","role":"受命","evidence":["mingdi-e-p058a-q"]},{"person":"mingdi-p0056","role":"受命","evidence":["mingdi-e-p058a-q"]},{"person":"mingdi-p0105","role":"受命","evidence":["mingdi-e-p058a-q"]},{"person":"mingdi-p0031","role":"受命","evidence":["mingdi-e-p058a-q"]}],"place":null,"time":{"year":238,"label":"景初二年十二月，甲申以前","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"mingdi-y238","dating_review":{"reviewed":true,"anchor":"mingdi-q-o059","basis":"甲申为后文另起时间，不套用于初命辅政"},"evidence":["mingdi-e-p058a-q","mingdi-q-o059","mingdi-q-b-78ee587f18f11aa30bd9"]},"ordering_evidence":"mingdi-e-p058a-q","source_order":[3,490,"P058a"],"order":966},{"id":"mingdi-e-p058c","title":"曹肇谏止后刘放孙资复说强作诏免曹宇等","accounts":[{"id":"mingdi-e-p058c-account","label":"裴注·汉晋春秋","text":"曹肇谏止后刘放孙资复说强作诏免曹宇等","evidence":["mingdi-e-p058c-q"]}],"participants":[{"person":"mingdi-p0105","role":"谏止","evidence":["mingdi-e-p058c-q"]},{"person":"mingdi-p0106","role":"复说执手作诏","evidence":["mingdi-e-p058c-q"]},{"person":"mingdi-p0075","role":"复说","evidence":["mingdi-e-p058c-q"]},{"person":"wendi-p0005","role":"改议","evidence":["mingdi-e-p058c-q"]},{"person":"mingdi-p0055","role":"免官","evidence":["mingdi-e-p058c-q"]},{"person":"mingdi-p0104","role":"免官","evidence":["mingdi-e-p058c-q"]},{"person":"mingdi-p0031","role":"免官","evidence":["mingdi-e-p058c-q"]}],"place":null,"time":{"year":238,"label":"景初二年十二月甲申","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"mingdi-y238","dating_review":{"reviewed":true,"anchor":"mingdi-q-o059","basis":"景初二年十二月甲申"},"evidence":["mingdi-e-p058c-q","mingdi-q-o059","mingdi-q-b-78ee587f18f11aa30bd9"]},"ordering_evidence":"mingdi-e-p058c-q","source_order":[3,490,"P058c"],"order":968},{"id":"gongsuntao-e-o207","title":"夏侯献表荐鬷弘使辽东","accounts":[{"id":"gongsuntao-a-7e1648828087f221b9f9","label":"裴注·魏名臣奏","text":"夏侯献表荐鬷弘使辽东","evidence":["gongsuntao-q-9199d23a0fba4d679ab8"]}],"participants":[{"person":"mingdi-p0104","role":"中领军、表曰公孙渊昔年敢违王命废绝计贡实挟两端既恃阻险又怙孙权、因斯之时宜遣使示以祸福","evidence":["gongsuntao-q-9199d23a0fba4d679ab8"]},{"person":"gongsuntao-p0084","role":"奉车都尉、武皇帝时始奉使命开通道路、乞留妻子身奉使命、性果烈乃心于国博通书记辩而不俗、若当遣使以为可使弘行","evidence":["gongsuntao-q-9199d23a0fba4d679ab8"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["gongsuntao-q-9199d23a0fba4d679ab8"]},"ordering_evidence":"gongsuntao-q-9199d23a0fba4d679ab8","source_order":[8,227,20],"order":2050},{"id":"chengguo-e-o020","title":"帝欲以燕王宇等辅政宇固辞","accounts":[{"id":"chengguo-a-f40b177679d5076e0e46","label":"正文","text":"帝欲以燕王宇等辅政宇固辞","evidence":["chengguo-q-1523903c75411dafc09b"]}],"participants":[{"person":"wendi-p0005","role":"寝疾、欲以燕王宇为大将军及夏侯献曹爽曹肇秦朗共辅政","evidence":["chengguo-q-1523903c75411dafc09b"]},{"person":"mingdi-p0055","role":"燕王、性恭良陈诚固辞","evidence":["chengguo-q-1523903c75411dafc09b"]},{"person":"mingdi-p0104","role":"领军将军、被欲辅政","evidence":["chengguo-q-1523903c75411dafc09b"]},{"person":"mingdi-p0056","role":"武卫将军、被欲辅政","evidence":["chengguo-q-1523903c75411dafc09b"]},{"person":"mingdi-p0105","role":"屯骑校尉、被欲辅政","evidence":["chengguo-q-1523903c75411dafc09b"]},{"person":"mingdi-p0031","role":"骁骑将军、被欲辅政","evidence":["chengguo-q-1523903c75411dafc09b"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["chengguo-q-1523903c75411dafc09b"]},"ordering_evidence":"chengguo-q-1523903c75411dafc09b","source_order":[14,512,0],"order":3205},{"id":"chengguo-e-o023","title":"免宇献肇朗官帝崩","accounts":[{"id":"chengguo-a-cf43306d7ab18a2a9ea5","label":"正文","text":"免宇献肇朗官帝崩","evidence":["chengguo-q-da19071eaa5b283f269b"]}],"participants":[{"person":"wendi-p0005","role":"遂免宇献肇朗官、然后帝崩","evidence":["chengguo-q-da19071eaa5b283f269b"]},{"person":"mingdi-p0055","role":"被免官","evidence":["chengguo-q-da19071eaa5b283f269b"]},{"person":"mingdi-p0104","role":"被免官","evidence":["chengguo-q-da19071eaa5b283f269b"]},{"person":"mingdi-p0105","role":"被免官","evidence":["chengguo-q-da19071eaa5b283f269b"]},{"person":"mingdi-p0031","role":"被免官","evidence":["chengguo-q-da19071eaa5b283f269b"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["chengguo-q-da19071eaa5b283f269b"]},"ordering_evidence":"chengguo-q-da19071eaa5b283f269b","source_order":[14,513,171],"order":3208},{"id":"chengguo-e-p164","title":"放资惧献肇劝帝召宣王","accounts":[{"id":"chengguo-a-57f544888b2b28090709","label":"裴注·《世语》","text":"放资惧献肇劝帝召宣王","evidence":["chengguo-q-029b7356f91faf07f7f6"]}],"participants":[{"person":"mingdi-p0106","role":"久典机任、惧、乃劝帝召宣王、对曰曹爽、蹑爽足耳之曰臣以死奉社稷","evidence":["chengguo-q-029b7356f91faf07f7f6"]},{"person":"mingdi-p0075","role":"同惧、同劝","evidence":["chengguo-q-029b7356f91faf07f7f6"]},{"person":"mingdi-p0104","role":"心内不平、殿中指鸡栖树相谓","evidence":["chengguo-q-029b7356f91faf07f7f6"]},{"person":"mingdi-p0105","role":"心内不平","evidence":["chengguo-q-029b7356f91faf07f7f6"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["chengguo-q-029b7356f91faf07f7f6"]},"ordering_evidence":"chengguo-q-029b7356f91faf07f7f6","source_order":[14,534,10],"order":3219},{"id":"chengguo-e-p166","title":"放资宣诏罢燕王肇献免官","accounts":[{"id":"chengguo-a-0a339d6b32f7fc427cf2","label":"裴注·《世语》","text":"放资宣诏罢燕王肇献免官","evidence":["chengguo-q-7493277632efc144fd31"]}],"participants":[{"person":"mingdi-p0106","role":"宣诏宫门不得复纳肇等、罢燕王","evidence":["chengguo-q-7493277632efc144fd31"]},{"person":"mingdi-p0075","role":"同宣诏","evidence":["chengguo-q-7493277632efc144fd31"]},{"person":"mingdi-p0055","role":"燕王、颇失指、被罢","evidence":["chengguo-q-7493277632efc144fd31"]},{"person":"mingdi-p0105","role":"明日至门不得入、惧诣廷尉、以处事失宜免","evidence":["chengguo-q-7493277632efc144fd31"]},{"person":"xiahoucao-p0057","role":"大将军司马、见惊曰上不安云何悉共出宜还","evidence":["chengguo-q-7493277632efc144fd31"]},{"person":"mingdi-p0104","role":"帝谓献曰吾已差便出、流涕而出、亦免","evidence":["chengguo-q-7493277632efc144fd31"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["chengguo-q-7493277632efc144fd31"]},"ordering_evidence":"chengguo-q-7493277632efc144fd31","source_order":[14,534,194],"order":3221}],"persons":[{"id":"mingdi-p0104","name":"夏侯献","evidence":["mingdi-q-p058","chengguo-q-1523903c75411dafc09b","chengguo-q-da19071eaa5b283f269b","chengguo-q-029b7356f91faf07f7f6","chengguo-q-7493277632efc144fd31","gongsuntao-q-9199d23a0fba4d679ab8"],"facts":[],"aliases":[],"mentions":[{"id":"mingdi-m-p058-mingdi-p0104","kind":"mention","text":"文中提及","evidence":["mingdi-q-p058"]}]}],"evidence":[{"id":"chengguo-q-029b7356f91faf07f7f6","section":"chapter-014","block":"b-a638d9784fc427a6f989","layer":"pei","quote":"放、资久典机任，献、肇心内不平。殿中有鸡栖树，二人相谓：‘此亦久矣！其能复几？’指谓放、资。放、资惧，乃劝帝召宣王。帝作手诏，令给使辟邪，至以授宣王。宣王在汲，献等先诏，令于轵关西还长安；辟邪又至，宣王疑有变。呼辟邪具问，乃乘追锋车驰至京师。帝问放、资：‘谁可与太尉对者？’放曰：‘曹爽。’帝曰：‘堪其事不？’爽在左右，流汗不能对。放蹑其足，耳之曰：‘臣以死奉社稷！’","attribution":"正文","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":533,"anchor":null},"note_id":"n-f69dd3b4e827e95f0087","start":10,"end":194},{"id":"chengguo-q-1523903c75411dafc09b","section":"chapter-014","block":"b-a453325bbcfb30926f5f","layer":"original","quote":"其年，帝寝疾，欲以燕王宇为大将军，及领军将军夏侯献、武卫将军曹爽、屯骑校尉曹肇、骁骑将军秦朗共辅政〖1〗。宇性恭良，陈诚固辞","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":511,"anchor":null},"note_id":null,"start":0,"end":62},{"id":"chengguo-q-7493277632efc144fd31","section":"chapter-014","block":"b-a638d9784fc427a6f989","layer":"pei","quote":"曹肇弟纂为大将军司马。燕王颇失指，肇出，纂见，惊曰：‘上不安，云何悉共出？宜还！’已暮，放、资宣诏宫门：“不得复纳肇等，罢燕王。”肇明日至门，不得入；惧，诣廷尉，以处事失宜免。帝谓献曰：‘吾已差，便出。’献流涕而出，亦免","attribution":"裴注·《世语》","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":533,"anchor":null},"note_id":"n-f69dd3b4e827e95f0087","start":194,"end":304},{"id":"chengguo-q-da19071eaa5b283f269b","section":"chapter-014","block":"b-0658bbe4420b47d45ac8","layer":"original","quote":"遂免宇、献、肇、朗官。太尉亦至，登床受诏，然后帝崩","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":512,"anchor":null},"note_id":null,"start":171,"end":196},{"id":"gongsuntao-q-9199d23a0fba4d679ab8","section":"chapter-008","block":"b-214838e0d91a327bae94","layer":"pei","quote":"公孙渊，昔年敢违王命，废绝计贡者，实挟两端：既恃阻险，又怙孙权；故敢跋扈，恣睢海外。宿舒亲见贼权军众府库，知其弱少不足凭恃，是以决计斩贼之使。又高句丽、濊貊与渊为仇，并为寇抄。今外失吴援，内有胡寇；心知国家能从陆道，势不得不怀惶惧之心。因斯之时，宜遣使示以祸福。奉车都尉鬷弘，武皇帝时始奉使命，开通道路；文皇帝即位，欲通使命，遣弘将妻子还归乡里，赐其车、牛，绢百匹。弘以受恩，归死国期，无有还意；乞留妻子，身奉使命。公孙康遂称臣妾，以弘奉使称意，赐爵关内侯。弘性果烈，乃心于国，夙夜拳拳，念自竭效；冠族子孙，少好学问，博通书记，多所关涉，口论速捷，辩而不俗，附依典诰，若出胸臆；加仕本郡，常在人右，彼方士人素所敬服。若当遣使，以为可使弘行。弘乃自旧土，习其国俗；为说利害，辩足以动其意，明足以见其事，才足以行之，辞足以见信。若其计从，虽郦生之降齐王，陆贾之说尉佗，亦无以远过也。欲进远路，不宜释骐骥；将已笃疾，不宜废扁鹊。愿察愚言也","attribution":"裴注·魏名臣奏","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":226,"anchor":null},"note_id":"n-8a1400a8bbd3ac2228a7","start":20,"end":436},{"id":"mingdi-e-p058a-q","section":"chapter-003","block":"b-479566b169dbc75ea2fe","layer":"pei","quote":"帝以燕王宇为大将军，使与领军将军夏侯献、武卫将军曹爽、屯骑校尉曹肇、骁骑将军秦朗等，对辅政。","attribution":"裴注·汉晋春秋","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":489,"anchor":null},"note_id":"n-3df5334abffeb752155c","start":12,"end":58},{"id":"mingdi-e-p058c-q","section":"chapter-003","block":"b-479566b169dbc75ea2fe","layer":"pei","quote":"放、资出，曹肇入，泣涕固谏，帝使肇敕停。肇出户，放、资趋而往，复说止帝，帝又从其言。放曰：‘宜为手诏。’帝曰：‘我困笃，不能。’放即上床，执帝手强作之；遂赍出，大言曰：‘有诏免燕王宇等官，不得停省中！’于是宇、肇、献、朗，相与泣而归第。","attribution":"裴注·汉晋春秋","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":489,"anchor":null},"note_id":"n-3df5334abffeb752155c","start":401,"end":519},{"id":"mingdi-q-b-78ee587f18f11aa30bd9","section":"chapter-003","block":"b-78ee587f18f11aa30bd9","layer":"modern","quote":"〖1〗二年：景初二年（公元 238 ）。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":438,"anchor":null},"note_id":"n-917b5dc4aecce5a0dcf4","start":0,"end":20},{"id":"mingdi-q-o059","section":"chapter-003","block":"b-5790b2efe14805978c50","layer":"original","quote":"二年春正月〖1〗，诏太尉司马宣王。率众讨辽东。﹝一﹞","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":434,"anchor":null},"note_id":null,"start":0,"end":26},{"id":"mingdi-q-p058","section":"chapter-003","block":"b-479566b169dbc75ea2fe","layer":"pei","quote":"﹝二﹞《汉晋春秋》曰：“帝以燕王宇为大将军，使与领军将军夏侯献、武卫将军曹爽、屯骑校尉曹肇、骁骑将军秦朗等，对辅政。中书监刘放、令孙资，久专权宠，为朗等素所不善，惧有后害，阴图间之；而宇常在帝侧，故未得有言。甲申，帝气微，宇下殿呼曹肇有所议，未还。而帝少间，惟曹爽独在。放知之，呼资与谋。资曰：‘不可动也！’放曰：‘俱入鼎镬，何不可之有？’乃突前见帝，垂泣曰：‘陛下气微，若有不讳，将以天下付谁？’帝曰：‘卿不闻用燕王耶？’放曰：‘陛下忘先帝诏敕：藩王不得辅政。且陛下方病，而曹肇、秦朗等便与才人侍疾者言戏；燕王拥兵南面，不听臣等入：此即竖刁、赵高也。今皇太子幼弱，未能统政；外有强暴之寇，内有劳怨之民。陛下不远虑存亡，而近系恩旧；委祖宗之业，付二三凡士；寝疾数日，外内壅隔；社稷危殆，而己不知：此臣等所以痛心也。’帝得放言，大怒曰：‘谁可任者？’放、资乃举爽代宇，又白‘宜诏司马宣王使相参’，帝从之。放、资出，曹肇入，泣涕固谏，帝使肇敕停。肇出户，放、资趋而往，复说止帝，帝又从其言。放曰：‘宜为手诏。’帝曰：‘我困笃，不能。’放即上床，执帝手强作之；遂赍出，大言曰：‘有诏免燕王宇等官，不得停省中！’于是宇、肇、献、朗，相与泣而归第。”","attribution":"裴注·汉晋春秋","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":489,"anchor":null},"note_id":"n-3df5334abffeb752155c","start":0,"end":520}],"profiles":{},"directory_counts":{}}
