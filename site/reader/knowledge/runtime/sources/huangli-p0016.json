l},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":70,"end":75,"offset_unit":"unicode_code_point"},{"id":"guanzhang-e-o030a-q","section":"chapter-036","block":"b-ecc04954a448c634e964","layer":"original","quote":"鲁不足与计事，内怀於邑〖16〗；闻先主围刘璋于成都，密书请降。﹝三﹞先主遣人迎超，超将兵径到城下〖17〗。城中震怖，璋即稽首〖18〗。﹝四﹞","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":115,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":70,"offset_unit":"unicode_code_point"},{"id":"houzhu-q-O011","section":"chapter-033","block":"b-354a0a35bf9887aa11d1","layer":"original","quote":"三年春三月，丞相亮南征四郡〖2〗，四郡皆平。改益州郡为建宁郡；分建宁、永昌郡为云南郡〖3〗；又分建宁、牂牁为兴古郡〖4〗。","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":35,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":61,"offset_unit":"unicode_code_point"},{"id":"houzhu-q-O012","section":"chapter-033","block":"b-3529bcb2e8097984bcb5","layer":"original","quote":"十二月，亮还成都。","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":36,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":9,"offset_unit":"unicode_code_point"},{"id":"huangli-q-168e99bc52bdfc217d2f","section":"chapter-043","block":"b-962c82ad79e50c7a0854","layer":"original","quote":"后为亡虏所诬〖7〗，引恢谋反，有司执送；先主明其不然，更迁恢为别驾从事","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":57,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":26,"end":61,"offset_unit":"unicode_code_point"},{"id":"huangli-q-2a4a21a12a60c1bcbdd9","section":"chapter-043","block":"b-fcf72eef6831dec6891c","layer":"original","quote":"有违（犯）〔法〕之事；恢坐习免官，太守董和以习方土大姓〖3〗，寝而不许","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":56,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":33,"end":68,"offset_unit":"unicode_code_point"},{"id":"huangli-q-4639de401721810ce6f4","section":"chapter-043","block":"b-e11f9e586959d73e2f0d","layer":"original","quote":"于是恢出击，大破之；追奔逐北，南至盘江〖19〗，东接牂牁，与亮声势相连","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":59,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":170,"end":205,"offset_unit":"unicode_code_point"},{"id":"huangli-q-4f43744a6dc17c55e3a5","section":"chapter-043","block":"b-ebdc4d745668a539ee58","layer":"original","quote":"赋出叟、濮耕牛、战马、金、银、犀革〖20〗，充继军资，于时费用不乏","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":60,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":33,"end":66,"offset_unit":"unicode_code_point"},{"id":"huangli-q-5e78963a4ec38fab75cb","section":"chapter-043","block":"b-fcf72eef6831dec6891c","layer":"original","quote":"后贡恢于州，涉道未至","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":56,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":75,"end":85,"offset_unit":"unicode_code_point"},{"id":"huangli-q-6468462c5c9ba31b69b4","section":"chapter-043","block":"b-e11f9e586959d73e2f0d","layer":"original","quote":"丞相亮南征，先由越嶲","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":59,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":32,"end":42,"offset_unit":"unicode_code_point"},{"id":"huangli-q-6bde1a046c8d478e575c","section":"chapter-043","block":"b-8cc6be2ec39d53c1f31b","layer":"original","quote":"先主问恢：“谁可代者？”恢对曰：“人之才能，各有长短。故孔子曰：‘其使人也器之〖8〗。’且夫明主在上，则臣下尽情；是以先零之役〖9〗，赵充国曰‘莫若老臣〖10〗’。臣窃不自（揆）〔量〕，惟陛下察之","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":58,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":12,"end":110,"offset_unit":"unicode_code_point"},{"id":"huangli-q-719f26aa2be89e5fdfc4","section":"chapter-043","block":"b-1f594d574238f76d3965","layer":"original","quote":"及丞相亮南征讨阉，既发在道","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":93,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":18,"end":31,"offset_unit":"unicode_code_point"},{"id":"huangli-q-74117dc09f6f781ee72a","section":"chapter-043","block":"b-fcf72eef6831dec6891c","layer":"original","quote":"闻先主自葭萌还攻刘璋。恢知璋之必败，先主必成；乃托名郡使，北诣先主。遇於绵竹，先主嘉之","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":56,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":89,"end":132,"offset_unit":"unicode_code_point"},{"id":"huangli-q-79343b4cdfda25645b7f","section":"chapter-043","block":"b-f4c7db376848e1402ce1","layer":"original","quote":"建兴七年，以交州属吴，解恢刺史，更领建宁太守","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":61,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":22,"offset_unit":"unicode_code_point"},{"id":"huangli-q-8607804c6bf08d8f9001","section":"chapter-043","block":"b-1f594d574238f76d3965","layer":"original","quote":"而闿已为高定部曲所杀","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":93,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":32,"end":42,"offset_unit":"unicode_code_point"},{"id":"huangli-q-a0bdf7017b39fdc3c590","section":"chapter-043","block":"b-f4c7db376848e1402ce1","layer":"original","quote":"以还居本郡，徙居汉中","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":61,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":23,"end":33,"offset_unit":"unicode_code_point"},{"id":"huangli-q-b5114bce442112fd9e76","section":"chapter-043","block":"b-e11f9e586959d73e2f0d","layer":"original","quote":"时恢众少敌倍，又未得亮声息，绐谓南人曰〖15〗：“官军粮尽，欲规退还〖16〗；吾中间久斥乡里〖17〗，乃今得旋〖18〗，不能复北；欲还与汝等同计谋，故以诚相告。”南人信之，故围守怠缓","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":59,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":78,"end":169,"offset_unit":"unicode_code_point"},{"id":"huangli-q-b55c7f4a15abc64e2ca4","section":"chapter-043","block":"b-8cc6be2ec39d53c1f31b","layer":"original","quote":"遂以恢为降都督，使持节，领交州刺史，住平夷县","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":58,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":130,"end":152,"offset_unit":"unicode_code_point"},{"id":"huangli-q-b685b1081f6c75c813e8","section":"chapter-043","block":"b-962c82ad79e50c7a0854","layer":"original","quote":"成都既定，先主领益州牧，以恢为功曹书佐、主簿","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":57,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":22,"offset_unit":"unicode_code_point"},{"id":"huangli-q-bacac876b0ec1e838668","section":"chapter-043","block":"b-f4c7db376848e1402ce1","layer":"original","quote":"九年卒","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":61,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":38,"end":41,"offset_unit":"unicode_code_point"},{"id":"huangli-q-bada280741d1473f3246","section":"chapter-043","block":"b-ebdc4d745668a539ee58","layer":"original","quote":"徙其豪帅于成都","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":60,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":25,"end":32,"offset_unit":"unicode_code_point"},{"id":"huangli-q-be2e9d994cd7b089f2f2","section":"chapter-043","block":"b-0dc5c04328f7048c3197","layer":"original","quote":"子遗嗣","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":62,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":3,"offset_unit":"unicode_code_point"},{"id":"huangli-q-ca57cc2fddf4eb2d7867","section":"chapter-043","block":"b-ebdc4d745668a539ee58","layer":"original","quote":"后军还，南夷复叛，杀害守将。恢身往扑讨，锄尽恶类","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":60,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":24,"offset_unit":"unicode_code_point"},{"id":"huangli-q-e3ccf28eaf60b6787884","section":"chapter-043","block":"b-e11f9e586959d73e2f0d","layer":"original","quote":"而恢案道向建宁〖13〗，诸县大相纠合，围恢军于昆（明）〔泽〕","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":59,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":43,"end":73,"offset_unit":"unicode_code_point"},{"id":"huangli-q-edc28ecd0358e4aeea4f","section":"chapter-043","block":"b-fcf72eef6831dec6891c","layer":"original","quote":"从至雒城，遣恢至汉中交好马超，超遂从命","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":56,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":133,"end":152,"offset_unit":"unicode_code_point"},{"id":"huangli-q-f1644a70e407875fc7ed","section":"chapter-043","block":"b-e11f9e586959d73e2f0d","layer":"original","quote":"南土平定，恢军功居多，封汉兴亭侯，加安汉将军","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":59,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":206,"end":228,"offset_unit":"unicode_code_point"},{"id":"huangli-q2-7993a7c21702827973b6","section":"chapter-043","block":"b-fcf72eef6831dec6891c","layer":"original","quote":"李恢字德昂，建宁俞元人也〖1〗。仕郡督邮。姑夫爨习为建伶令〖2〗，有违（犯）〔法〕之事；恢坐习免官，太守董和以习方土大姓〖3〗，寝而不许〖4〗。﹝一﹞后贡恢于州，涉道未至〖5〗，闻先主自葭萌还攻刘璋。恢知璋之必败，先主必成；乃托名郡使，北诣先主。遇於绵竹，先主嘉之。从至雒城，遣恢至汉中交好马超，超遂从命。","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":56,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":153,"offset_unit":"unicode_code_point"},{"id":"huowang-q-225ed2d7e9d667049592","section":"chapter-041","block":"b-20cf9e4bd23391868d15","layer":"original","quote":"成都既定，先主领益州牧，以诗为督军从事","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":169,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":34,"end":53,"offset_unit":"unicode_code_point"},{"id":"huowang-q-8f424ee850969da203c7","section":"chapter-041","block":"b-5008b9b7cd23cd6b1641","layer":"original","quote":"丞相亮南征，朗留统后事","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":38,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":20,"end":31,"offset_unit":"unicode_code_point"},{"id":"huowang-q-9418f38e1a330c9a23fd","section":"chapter-041","block":"b-0331bba35be1e9a1beba","layer":"original","quote":"建兴三年，随诸葛亮南行，归至汉阳县","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":172,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":17,"offset_unit":"unicode_code_point"},{"id":"liuermu-q-74c22b7e2a9d68bbb6e6","section":"chapter-031","block":"b-2a7eb34fd683676ae1b4","layer":"original","quote":"丞相诸葛亮平南土","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":75,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":41,"end":49,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o043c-q","section":"chapter-032","block":"b-4a221026fdb893201c62","layer":"original","quote":"先主复领益州牧：诸葛亮为股肱〖2〗，法正为谋主，关羽、张飞、马超为爪牙〖3〗，许靖、麋竺、简雍为宾友〖4〗。及董和、黄权、李严等〖5〗，本璋之所授用也，吴壹、费观等〖6〗，又璋之婚亲也；彭羕〖7〗，又璋之所排摈也；刘巴者〖8〗，宿昔之所忌恨也：皆处之显任，尽其器能。有志之士，无不竞劝。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":186,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":63,"end":206,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-b-dcc10490c7b3b72c467f","section":"chapter-032","block":"b-dcc10490c7b3b72c467f","layer":"modern","quote":"〖1〗十九年：建安十九年（公元 214）。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":188,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-dc65792cc6043766510a","start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o043","section":"chapter-032","block":"b-4a221026fdb893201c62","layer":"original","quote":"十九年夏〖1〗，雒城破；﹝一﹞进围成都，数十日，璋出降。﹝二﹞蜀中殷盛丰乐，先主置酒大飨士卒；取蜀城中金银分赐将士，还其谷帛。先主复领益州牧：诸葛亮为股肱〖2〗，法正为谋主，关羽、张飞、马超为爪牙〖3〗，许靖、麋竺、简雍为宾友〖4〗。及董和、黄权、李严等〖5〗，本璋之所授用也，吴壹、费观等〖6〗，又璋之婚亲也；彭羕〖7〗，又璋之所排摈也；刘巴者〖8〗，宿昔之所忌恨也：皆处之显任，尽其器能。有志之士，无不竞劝。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":186,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":206,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-9d9c6c3cd013f113898d","section":"chapter-038","block":"b-4724e70f37115927f07b","layer":"original","quote":"先主克蜀，以靖为左将军长史","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":148,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":7,"end":20,"offset_unit":"unicode_code_point"},{"id":"zhuge-e-o023a-q","section":"chapter-035","block":"b-862592827af5abe9feb3","layer":"original","quote":"三年春〖10〗，亮率众南征〖11〗。﹝三﹞其秋，悉平：军资所出〖12〗，国以富饶；﹝四﹞乃治戎讲武，以俟大举。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":133,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":55,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-b-28bd067e0a3e898385bc","section":"chapter-035","block":"b-28bd067e0a3e898385bc","layer":"modern","quote":"〖10〗三年：建兴三年（公元 225）。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":144,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-d52302c7e46aff00f085","start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-o023","section":"chapter-035","block":"b-862592827af5abe9feb3","layer":"original","quote":"三年春〖10〗，亮率众南征〖11〗。﹝三﹞其秋，悉平：军资所出〖12〗，国以富饶；﹝四﹞乃治戎讲武，以俟大举。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":133,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":55,"offset_unit":"unicode_code_point"}],"profiles":{"huangli-p0016":{"fields":[],"directory":{"faction":"shu"}}},"directory_counts":{}}
