3bf9fda33e9d8800627c","start":85,"end":98,"offset_unit":"unicode_code_point"},{"id":"yululu-q-f9fcafbd9f6e61881d0d","section":"chapter-057","block":"b-d0b1b4e4cdd778cf1167","layer":"pei","quote":"﹝四﹞《会稽典录》曰：“昺，字世文。翻第八子也。少有倜傥之志。仕吴黄门郎，以捷对见异，超拜尚书，侍中。晋军来伐，遣昺持节，都督武昌以上诸军事；昺先上还节盖印绶，然后归顺。在济阴，抑强扶弱，甚著威风。”","attribution":"裴注·会稽典录","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":123,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-3bf9fda33e9d8800627c","start":0,"end":100,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
