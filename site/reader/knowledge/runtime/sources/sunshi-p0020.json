ngyuan-m-o070-sunshi-p0020","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o070"]}]}],"evidence":[{"id":"dongliu-q-efdaf98c4854f63628d7","section":"chapter-039","block":"b-79d23173cd059594a6bb","layer":"pei","quote":"时孙坚举兵讨董卓，以南阳太守张咨不给军粮，杀之","attribution":"裴注·零陵先贤传","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":56,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-2e5c4ea3c83f130fd0a8","start":36,"end":59,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-o010a-q","section":"chapter-006","block":"b-ce439e218b8e8adda84d","layer":"original","quote":"初，卓信任尚书周毖、城门校尉伍琼等。用其所举韩馥、刘岱、孔伷、张（资）〔咨〕、张邈等出宰州郡〖8〗；","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":57,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":50,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-o070a-q","section":"chapter-006","block":"b-346390ee71df08052036","layer":"original","quote":"董卓之将废帝，以术为后将军。术亦畏卓之祸，出奔南阳。会长沙太守孙坚杀南阳太守张咨，术得据其郡〖5〗。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":389,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":50,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o010","section":"chapter-006","block":"b-ce439e218b8e8adda84d","layer":"original","quote":"初，卓信任尚书周毖、城门校尉伍琼等。用其所举韩馥、刘岱、孔伷、张（资）〔咨〕、张邈等出宰州郡〖8〗；而馥等至官，皆合兵将以讨卓。卓闻之，以为毖、琼等通情卖己，皆斩之。﹝二﹞","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":57,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":86,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o070","section":"chapter-006","block":"b-346390ee71df08052036","layer":"original","quote":"董卓之将废帝，以术为后将军。术亦畏卓之祸，出奔南阳。会长沙太守孙坚杀南阳太守张咨，术得据其郡〖5〗。南阳户口数百万，而术奢淫肆欲，征敛无度，百姓苦之。既与绍有隙，又与刘表不平，而北连公孙瓒；绍与瓒不和，而南连刘表：其兄弟携贰〖6〗，舍近交远如此。﹝一﹞","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":389,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":126,"offset_unit":"unicode_code_point"},{"id":"sunshi-e-o012b-q","section":"chapter-046","block":"b-84cf62d2b7cd8fe12d65","layer":"original","quote":"比至南阳〖3〗，众数万人。南阳太守张咨闻军至，晏然自若。﹝三﹞坚以牛酒礼咨〖4〗。咨明日，亦答诣坚〖5〗。酒酣，长沙主簿入白坚〖6〗：“前移南阳〖7〗，而道路不治，军资不具〖8〗；请收主簿，推问意故〖9〗！”咨大惧，欲去；兵陈四周，不得出。有顷〖10〗，主簿复入白坚：“南阳太守稽停义兵，使贼不时讨；请收出，按军法从事〖11〗！”便牵咨于军门斩之〖12〗。郡中震栗，无求不获。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":81,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":63,"end":251,"offset_unit":"unicode_code_point"},{"id":"sunshi-e-p013b-q","section":"chapter-046","block":"b-b46f4d8e414b432348a8","layer":"pei","quote":"坚到南阳，移檄太守，请军粮。咨以问纲纪，纲纪曰：‘坚，邻郡二千石；不应调发。’咨遂不与。","attribution":"《献帝春秋》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":125,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-38b04b5d6d75f8c85b2a","start":18,"end":62,"offset_unit":"unicode_code_point"},{"id":"sunshi-e-p014a-q","section":"chapter-046","block":"b-a29c5a0fa23cc3bc9c79","layer":"pei","quote":"初，坚至南阳，咨既不给军粮，又不肯见坚。坚欲进兵，恐有后患；乃诈得急疾，举军震惶；迎呼巫医，祷祀山川。遣所亲人说咨，言病困，欲以兵付咨。咨闻之，心利其兵，即将步骑五六百人，诣营省坚。坚卧与相见，无何，猝然而起；按剑骂咨，遂执斩之。","attribution":"《吴历》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":126,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6acb6f44d7cdb2100594","start":10,"end":125,"offset_unit":"unicode_code_point"},{"id":"sunshi-f0007-q","section":"chapter-046","block":"b-f3055b51ef9debe21069","layer":"pei","quote":"咨，字子议","attribution":"《英雄记》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":124,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-38b04b5d6d75f8c85b2a","start":11,"end":16,"offset_unit":"unicode_code_point"},{"id":"sunshi-f0008-q","section":"chapter-046","block":"b-f3055b51ef9debe21069","layer":"pei","quote":"颍川人","attribution":"《英雄记》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":124,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-38b04b5d6d75f8c85b2a","start":17,"end":20,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-o012","section":"chapter-046","block":"b-84cf62d2b7cd8fe12d65","layer":"original","quote":"灵帝崩〖1〗，卓擅朝政，横恣京城。诸州郡并兴义兵，欲以讨卓。﹝一﹞坚亦举兵。荆州刺史王叡，素遇坚无礼〖2〗；坚过，杀之。﹝二﹞比至南阳〖3〗，众数万人。南阳太守张咨闻军至，晏然自若。﹝三﹞坚以牛酒礼咨〖4〗。咨明日，亦答诣坚〖5〗。酒酣，长沙主簿入白坚〖6〗：“前移南阳〖7〗，而道路不治，军资不具〖8〗；请收主簿，推问意故〖9〗！”咨大惧，欲去；兵陈四周，不得出。有顷〖10〗，主簿复入白坚：“南阳太守稽停义兵，使贼不时讨；请收出，按军法从事〖11〗！”便牵咨于军门斩之〖12〗。郡中震栗，无求不获。﹝四﹞","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":81,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":254,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-p012","section":"chapter-046","block":"b-f3055b51ef9debe21069","layer":"pei","quote":"﹝三﹞《英雄记》曰：“咨，字子议，颍川人。亦知名。”","attribution":"《英雄记》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":124,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-38b04b5d6d75f8c85b2a","start":0,"end":26,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-p013","section":"chapter-046","block":"b-b46f4d8e414b432348a8","layer":"pei","quote":"《献帝春秋》曰：“袁术表坚假中郎将。坚到南阳，移檄太守，请军粮。咨以问纲纪，纲纪曰：‘坚，邻郡二千石；不应调发。’咨遂不与。”","attribution":"《献帝春秋》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":125,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-38b04b5d6d75f8c85b2a","start":0,"end":63,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-p014","section":"chapter-046","block":"b-a29c5a0fa23cc3bc9c79","layer":"pei","quote":"﹝四﹞《吴历》曰：“初，坚至南阳，咨既不给军粮，又不肯见坚。坚欲进兵，恐有后患；乃诈得急疾，举军震惶；迎呼巫医，祷祀山川。遣所亲人说咨，言病困，欲以兵付咨。咨闻之，心利其兵，即将步骑五六百人，诣营省坚。坚卧与相见，无何，猝然而起；按剑骂咨，遂执斩之。”此语与本传不同。","attribution":"《吴历》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":126,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6acb6f44d7cdb2100594","start":0,"end":134,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-50c00fbc52e4c7ccad2a","section":"chapter-038","block":"b-c3b105ae63105e37b3ab","layer":"original","quote":"馥等到官，各举兵还向京都，欲以诛卓","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":2,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":173,"end":190,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-eef790522c664266530f","section":"chapter-038","block":"b-c3b105ae63105e37b3ab","layer":"original","quote":"拜尚书韩馥为冀州牧〖13〗，侍中刘岱为兖州刺史〖14〗，颍川张咨为南阳太守〖15〗，陈留孔伷为豫州刺史〖16〗，东郡张邈为陈留太守","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":2,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":82,"end":147,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
