{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xuhuwang-e-b4f8be32ad2eb57ee084","title":"王承任东海内史","accounts":[{"id":"xuhuwang-a-b4f8be32ad2eb57ee084","label":"裴注·晋书及晋阳秋","text":"王承任东海内史","evidence":["xuhuwang-q-f07ac9346cb84cc74749"]}],"participants":[{"person":"xuhuwang-p-fb78deb31a7df9","role":"任官","evidence":["xuhuwang-q-f07ac9346cb84cc74749"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["xuhuwang-q-f07ac9346cb84cc74749"]},"ordering_evidence":"xuhuwang-q-f07ac9346cb84cc74749","order":5370}],"persons":[{"id":"xuhuwang-p-fb78deb31a7df9","name":"王承（王湛子）","evidence":["xuhuwang-q-f07ac9346cb84cc74749","xuhuwang-q-06b5f5352197a5d4570e"],"facts":[{"id":"xuhuwang-f-35f36aaaaca4375bd889","text":"字安期，王湛之子。","evidence":["xuhuwang-q-06b5f5352197a5d4570e"]}],"mentions":[],"aliases":[]}],"evidence":[{"id":"xuhuwang-q-06b5f5352197a5d4570e","section":"chapter-027","block":"b-9efef78c08981bf4551a","layer":"pei","quote":"﹝一﹞按《晋书》：“浑自越骑入晋，累居方任。平吴有功，封一子江陵侯。位至司徒。浑子济，字武子。有隽才令望，为河南尹、太仆。早卒，追赠骠骑将军。浑弟深，冀州刺史。深弟湛，字处冲。汝南太守。”湛子承，字安期。东海内史。承子述，字怀祖。尚书令、卫将军。述子坦之，字文度。北中郎将，徐、兖二州刺史。昶诸子中，湛最有德誉，而承亦自为名士，述及坦之并显重于世，为时盛门云。自湛以下事，见《晋阳秋》也。","attribution":"裴注（引书见原文，待主审复核）","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":253,"anchor":null},"note_id":"n-125e9b12619f6916fa00","start":0,"end":194},{"id":"xuhuwang-q-f07ac9346cb84cc74749","section":"chapter-027","block":"b-9efef78c08981bf4551a","layer":"pei","quote":"湛子承，字安期。东海内史。","attribution":"裴注·晋书及晋阳秋","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":253,"anchor":null},"note_id":"n-125e9b12619f6916fa00","start":94,"end":107}],"profiles":{},"directory_counts":{}}
