6b05cb3d0ea98d","layer":"original","quote":"亮以綝专恣，与太常全尚，将军刘丞，谋诛綝","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":121,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-745b945b456c87eee365","section":"chapter-048","block":"b-db791b7bf69ac554e010","layer":"original","quote":"遣将军刘丞督步骑攻胤","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":75,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":33,"end":43,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-ff0d1a1a678defca6a64","section":"chapter-048","block":"b-fce5536b05cb3d0ea98d","layer":"original","quote":"遣弟恩攻杀丞于苍龙门外〖4〗","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":121,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":35,"end":49,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-040ef7a4797e98255c1e","section":"chapter-064","block":"b-da2900eb25692ecb6e49","layer":"original","quote":"召典军杨崇、将军孙咨〖5〗，告以綝为乱，迫融等使（有）〔作〕书难綝","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":416,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":155,"end":188,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-048c9697467d1d96015a","section":"chapter-064","block":"b-abcd4067dd800ab40ef9","layer":"original","quote":"綝不听，表言胤反；许将军刘丞以封爵，使率兵骑急攻围胤","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":417,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":26,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-5274abc71ef19e4c91a7","section":"chapter-064","block":"b-95b6f4e559a9caf04f8a","layer":"original","quote":"亮妃，綝从姊女也〖5〗，以其谋告綝。","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":455,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":91,"end":109,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-7f20cc569ae15f362b09","section":"chapter-064","block":"b-5a68ad209c9913a5a2f5","layer":"pei","quote":"纪承诏，以告尚；尚无远虑，以语纪母。母使人密语綝。綝夜发严兵废亮，比明，兵已围宫","attribution":"裴注·江表传","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":477,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-3c25a1ac71ab7fb35794","start":230,"end":270,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-bef612af4126045775d8","section":"chapter-064","block":"b-9343dd2f9ccfaf5c1d8c","layer":"original","quote":"中子竦，长水校尉〖6〗；少子建，步兵校尉〖7〗：闻恪诛，车载其母而走。峻遣骑督刘承，追斩竦于白都","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":292,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":48,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-e406c4a86bfe598e88ee","section":"chapter-064","block":"b-9343dd2f9ccfaf5c1d8c","layer":"original","quote":"中子竦，长水校尉〖6〗；少子建，步兵校尉〖7〗：闻恪诛，车载其母而走。峻遣骑督刘承，追斩竦于白都〖8〗。建得渡江，欲北走魏；行数十里，为追兵所逮〖9〗。恪外甥都乡侯张震及常侍朱恩等，皆夷三族〖10〗。","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":292,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":100,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-e5d1dd0847f190e833bb","section":"chapter-064","block":"b-95b6f4e559a9caf04f8a","layer":"original","quote":"亮遂与公主鲁班、太常全尚、将军刘（承）〔丞〕议诛綝。亮妃，綝从姊女也〖5〗，以其谋告綝","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":455,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":65,"end":108,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-efee3ca1833ae60db26c","section":"chapter-064","block":"b-95b6f4e559a9caf04f8a","layer":"original","quote":"綝率众夜袭全尚，遣弟恩杀刘（承）〔丞〕于苍龙门外，遂围宫","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":455,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":109,"end":137,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-f4cffdb0d4a70d37ea2f","section":"chapter-064","block":"b-5a68ad209c9913a5a2f5","layer":"pei","quote":"亮召全尚息黄门侍郎纪，密谋，曰：‘孙綝专势，轻小于孤。孤（见）〔前〕敕之，使速上岸，为唐咨等作援；而留湖中，不上岸一步。又委罪朱异，擅杀功臣，不先表闻。筑第桥南，不复朝见。此为自在，无复所畏，不可久忍。今规取之，卿父作中军都督，使密严整士马；孤当自出临桥，帅宿卫虎骑、左右无难，一时围之；作板诏敕綝所领皆解散，不得举手：正尔，自〔当〕得之！卿去，但当使密耳。卿宣诏语卿父，勿令卿母知之；女人既不晓大事，且綝同堂姊：邂逅泄漏，误孤非小也","attribution":"裴注·江表传","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":477,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-3c25a1ac71ab7fb35794","start":11,"end":228,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
