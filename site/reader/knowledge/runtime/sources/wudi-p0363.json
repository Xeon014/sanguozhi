iusima-a-15ad11a19a6bc3eeecc5","label":"裴注·司马彪《序传》","text":"司马防年七十一，建安二十四年终，有子八人","evidence":["liusima-q-79f9ae20fa312f4ddd57"]}],"participants":[{"person":"wudi-p0363","role":"年七十一，建安二十四年终，有子八人","evidence":["liusima-q-79f9ae20fa312f4ddd57"]},{"person":"xunyu-p0024","role":"八子之长","evidence":["liusima-q-79f9ae20fa312f4ddd57"]},{"person":"wudi-p0364","role":"次子，即晋宣皇帝","evidence":["liusima-q-79f9ae20fa312f4ddd57"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liusima-q-79f9ae20fa312f4ddd57"]},"ordering_evidence":"liusima-q-79f9ae20fa312f4ddd57","source_order":[15,55,199],"order":3250},{"id":"liusima-e-o031","title":"司马防当徙西，遣司马朗将家属还本县","accounts":[{"id":"liusima-a-46a8d33b4ac265391019","label":"正文","text":"司马防当徙西，遣司马朗将家属还本县","evidence":["liusima-q-5dd7d29616436229af83"]}],"participants":[{"person":"wudi-p0363","role":"遣者","evidence":["liusima-q-5dd7d29616436229af83"]},{"person":"xunyu-p0024","role":"将家属还乡者","evidence":["liusima-q-5dd7d29616436229af83"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liusima-q-5dd7d29616436229af83"]},"ordering_evidence":"liusima-q-5dd7d29616436229af83","source_order":[15,56,18],"order":3251}],"persons":[{"id":"wudi-p0363","name":"司马防","evidence":["wudi-q-p133","liusima-q-5dd7d29616436229af83","liusima-q-79f9ae20fa312f4ddd57","liusima-q2-83151b97681d5f70da49"],"facts":[{"id":"wudi-f-p134-wudi-p0363-c55038","label":"字","text":"建公","evidence":["wudi-q-p134"]},{"id":"liusima-f2-cf26867930820d495781","text":"《司马彪序传》记其父儁为颍川太守；防字建公，历洛阳令、京兆尹，后转骑都尉。","evidence":["liusima-q2-83151b97681d5f70da49"]}],"aliases":[{"text":"建公","evidence":["wudi-q-p134"]}],"mentions":[{"id":"wudi-m-p133-wudi-p0363","kind":"mention","text":"文中提及","evidence":["wudi-q-p133"]},{"id":"wudi-m-p134-wudi-p0363","kind":"mention","text":"文中提及","evidence":["wudi-q-p134"]}]}],"evidence":[{"id":"liusima-q-5dd7d29616436229af83","section":"chapter-015","block":"b-5778b1a53dfcfa202600","layer":"original","quote":"朗父防，为治书御史，当徙西。以四方云扰〖1〗，乃遣朗将家属还本县","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":55,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":18,"end":50,"offset_unit":"unicode_code_point"},{"id":"liusima-q-79f9ae20fa312f4ddd57","section":"chapter-015","block":"b-df5a4d7910ad8213601e","layer":"pei","quote":"年七十一，建安二十四年终。有子八人，朗最长，次即晋宣皇帝也","attribution":"裴注·司马彪《序传》","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":54,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-46984fbd12453c10cd4e","start":199,"end":228,"offset_unit":"unicode_code_point"},{"id":"liusima-q2-83151b97681d5f70da49","section":"chapter-015","block":"b-df5a4d7910ad8213601e","layer":"pei","quote":"﹝一﹞司马彪《序传》曰：“朗祖父儁，字元异。博学好古，倜傥有大度。长八尺三寸，腰带十围，仪状魁岸，与众有异。乡党宗族，咸影附焉。位至颍川太守。父防，字建公。性质直公方，虽闲居宴处，威仪不忒。雅好《汉书》名臣列传，所讽诵者数十万言。少仕州郡，历官洛阳令、京兆尹。以年老，转拜骑都尉。养志闾巷，阖门自守。诸子虽冠，成人，不命曰‘进’，不敢进；不命曰‘坐’，不敢坐；不指有所问，不敢言。父子之间，肃如也。年七十一，建安二十四年终。有子八人，朗最长，次即晋宣皇帝也。”","attribution":"裴注·司马彪《序传》","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":54,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-46984fbd12453c10cd4e","start":0,"end":230,"offset_unit":"unicode_code_point"},{"id":"wudi-e-p133a-q","section":"chapter-001","block":"b-d262ac10cfc64f91dfc1","layer":"pei","quote":"《曹瞒传》曰：“为尚书右丞司马建公所举。及公为王，召建公到邺，与欢饮。谓建公曰：‘孤今日，可复作尉否？’建公曰：‘昔举大王时，适可作尉耳。’王大笑。”","attribution":"《曹瞒传》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":375,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fdb966d8839f43c95d67","start":0,"end":75,"offset_unit":"unicode_code_point"},{"id":"wudi-q-p133","section":"chapter-001","block":"b-d262ac10cfc64f91dfc1","layer":"pei","quote":"《曹瞒传》曰：“为尚书右丞司马建公所举。及公为王，召建公到邺，与欢饮。谓建公曰：‘孤今日，可复作尉否？’建公曰：‘昔举大王时，适可作尉耳。’王大笑。”","attribution":"《曹瞒传》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":375,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fdb966d8839f43c95d67","start":0,"end":75,"offset_unit":"unicode_code_point"},{"id":"wudi-q-p134","section":"chapter-001","block":"b-7a305e138c33edda2ef9","layer":"pei","quote":"建公名防，司马宣王之父。臣松之按《司马彪序传》，建公不为右丞，疑此不然。而王隐《晋书》云：“赵王篡位，欲尊祖为帝。博士马平议称：京兆府君昔举魏武帝为北部尉，贼不犯界。”如此，则为有征。","attribution":"裴松之按语引《司马彪序传》与王隐《晋书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":376,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fdb966d8839f43c95d67","start":0,"end":92,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
