vidence":["jfj-q0175"]},{"person":"jfj-p0008","role":"守汉城","evidence":["jfj-q0175"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"逐条保留原时间；未从邻段自动继承公元年。","evidence":["jfj-q0175"]},"ordering_evidence":"jfj-q0175"}],"persons":[{"id":"houzhu-p0011","name":"胡济","evidence":["houzhu-q-O066","jfj-q0162","jfj-q0022","jfj-q0175","jfj-q0176","liuliao-q-b30598f2b6891fcd098f","dongliu-q-3e01ee948b8e39ef1dd3","dongliu-q-e6c2de9037c7304f126f","dongliu-q-b35c99bf0be2fd6cf148","dongliu-q2-47f19b08a7e00154e3c1"],"facts":[{"id":"dongliu-f2-9b6cb19a87e6eebbf2a5","text":"据本篇裴注引书，胡济曾为诸葛亮主簿，有忠荩之效。","evidence":["dongliu-q2-47f19b08a7e00154e3c1"]}],"aliases":[],"mentions":[{"id":"houzhu-m-houzhu-q-O066-houzhu-p0011","kind":"mention","text":"文中提及","evidence":["houzhu-q-O066"]},{"id":"jfj-m-o043-houzhu-p0011","kind":"mention","text":"本段记载：姜维约胡济会军而胡济失期","evidence":["jfj-q0022"]},{"id":"jfj-m-o047-houzhu-p0011","kind":"mention","text":"本段记载：胡济王含蒋斌分守汉寿乐城汉城","evidence":["jfj-q0176"]}]}],"evidence":[{"id":"dongliu-q-3e01ee948b8e39ef1dd3","section":"chapter-039","block":"b-cb86ef6274fdc0c982d8","layer":"original","quote":"而郎中襄阳董恢，诣允修敬〖19〗。恢年少官微，见允停出，逡巡求去〖20〗。允不许，曰：“本所以出者，欲与同好游谈也。今君已自屈〖21〗，方展阔积〖22〗；舍此之谈，就彼之宴，非所谓也〖23〗。”乃命解骖〖24〗，祎等罢驾不行","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":154,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":34,"end":146,"offset_unit":"unicode_code_point"},{"id":"dongliu-q-9b1b42eb9b3cad1c7740","section":"chapter-039","block":"b-aa10e5f0d2cfeb33df76","layer":"original","quote":"都护李平坐诬罔废","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":116,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":7,"end":15,"offset_unit":"unicode_code_point"},{"id":"dongliu-q-b35c99bf0be2fd6cf148","section":"chapter-039","block":"b-a960132fa057a65b87be","layer":"pei","quote":"迁中监军，前将军，督汉中；假节，领兖州刺史；至右骠骑将军","attribution":"裴注·注家训释","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":43,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-39ea3649f54e599ce9c6","start":51,"end":79,"offset_unit":"unicode_code_point"},{"id":"dongliu-q-e6c2de9037c7304f126f","section":"chapter-039","block":"b-a960132fa057a65b87be","layer":"pei","quote":"亮卒，为中典军，统诸军，封成阳亭侯","attribution":"裴注·注家训释","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":43,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-39ea3649f54e599ce9c6","start":33,"end":50,"offset_unit":"unicode_code_point"},{"id":"dongliu-q2-47f19b08a7e00154e3c1","section":"chapter-039","block":"b-a960132fa057a65b87be","layer":"pei","quote":"﹝二﹞伟度者，姓胡，名济，义阳人。为亮主簿，有忠荩之效，故见褒述。亮卒，为中典军，统诸军，封成阳亭侯。迁中监军，前将军，督汉中；假节，领兖州刺史；至右骠骑将军。济弟博，历长水校尉、尚书。","attribution":"裴注（引书见原文）","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":43,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-39ea3649f54e599ce9c6","start":0,"end":93,"offset_unit":"unicode_code_point"},{"id":"houzhu-q-O024","section":"chapter-033","block":"b-13322259e3385d3184d4","layer":"original","quote":"秋八月，都护李平废徙梓潼郡。〖11〗﹝二﹞","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":56,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"houzhu-q-O066","section":"chapter-033","block":"b-3d3fbf1a297c314335e1","layer":"original","quote":"十九年春，进姜维位为大将军，督戎马。与镇西将军胡济期会上邽〖15〗，济失誓不至。","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":124,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":40,"offset_unit":"unicode_code_point"},{"id":"jfj-q0022","section":"chapter-044","block":"b-39e4cd8abbef79354a43","layer":"original","quote":"十九年春〖5〗，就迁维为大将军。更整勒戎马，与镇西大将军胡济期会上邽；济失誓不至〖6〗，故维为魏大将邓艾所破于段谷。星散流离，死者甚众，众庶由是怨讟〖7〗；而陇以西亦骚动不宁〖8〗。维谢过引负〖9〗，求自贬削；为后将军，行大将军事。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":196,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":116,"offset_unit":"unicode_code_point"},{"id":"jfj-q0162","section":"chapter-044","block":"b-39e4cd8abbef79354a43","layer":"original","quote":"更整勒戎马，与镇西大将军胡济期会上邽；济失誓不至","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":196,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":16,"end":40,"offset_unit":"unicode_code_point"},{"id":"jfj-q0175","section":"chapter-044","block":"b-c57cc7bd9ce74b83ab3b","layer":"original","quote":"于是令督汉中胡济却住汉寿〖5〗，监军王含守乐城，护军蒋斌守汉城；","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":215,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":32,"offset_unit":"unicode_code_point"},{"id":"jfj-q0176","section":"chapter-044","block":"b-c57cc7bd9ce74b83ab3b","layer":"original","quote":"于是令督汉中胡济却住汉寿〖5〗，监军王含守乐城，护军蒋斌守汉城；又于西安、建威、武卫、石门、武城、建昌、临远〖6〗，皆立围守。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":215,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":63,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-b30598f2b6891fcd098f","section":"chapter-040","block":"b-3973f0a63d7652cc65db","layer":"pei","quote":"﹝二﹞亮公文上尚书曰：“平为大臣，受恩过量；不思忠报，横造无端；危耻不办，迷罔上下；论狱弃科，导人为奸；狭情志狂，若无天地！自度奸露，嫌心遂生；闻军临至，西向托疾还沮、（漳）〔沔〕；军临至沮，复还江阳，平参军狐忠勤谏乃止。今篡贼未灭，社稷多难；国事惟和，可以克捷；不可苞含，以危大业。辄与行中军师，车骑将军、都乡侯臣刘琰，使持节、前军师、征西大将军、领凉州刺史、南郑侯臣魏延，前将军、都亭侯臣袁綝，左将军、领荆州刺史、高阳乡侯臣吴壹，督前部、右将军、玄乡侯臣高翔，督后部、后将军、安乐亭侯臣吴班，领长史、绥军将军臣杨仪，督左部、行中监军、扬武将军臣邓芝，行前监军、征南将军臣刘巴，行中护军、偏将军臣费祎，行前护军、偏将军、汉成亭侯臣许允，行左护军、笃信中郎将臣丁咸，行右护军、偏将军臣刘敏，行护军、征（南）〔西〕将军、当阳亭侯臣姜维，行中典军、讨虏将军臣上官雍，行中参军、昭武中郎将臣胡济，行参军、建义将军臣阎晏，行参军、偏将军臣爨习，行参军、裨将军臣杜义，行参军、武略中郎将臣杜祺，行参军、绥戎都尉臣盛勃，领从事中郎、武略中郎将臣樊岐等议：辄解平任，免官禄、节传、印绶、符策，削其爵土。”","attribution":"裴注·诸葛亮公文上尚书","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":233,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-63939405533bf19c17e7","start":0,"end":495,"offset_unit":"unicode_code_point"},{"id":"liuliao-q-c6e6f60db0bf0cbc289a","section":"chapter-040","block":"b-730d9183607041ebec12","layer":"original","quote":"乃废平为民，徙梓潼郡","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":206,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":10,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
