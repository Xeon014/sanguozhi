{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"shaodi-e-o043a","title":"曹芳谒高平陵司马懿奏免曹爽兄弟","accounts":[{"id":"shaodi-e-o043a-account","label":"《三少帝纪》正文","text":"曹芳谒高平陵司马懿奏免曹爽兄弟","evidence":["shaodi-e-o043a-q"]},{"id":"xiahoucao-e-o066a-account","label":"《诸夏侯曹传第九》正文","text":"曹芳朝高平陵曹爽兄弟从行","evidence":["xiahoucao-e-o066a-q"]},{"id":"xiahoucao-e-o067a-account","label":"《诸夏侯曹传第九》正文","text":"司马懿据武库屯洛水奉太后令奏罢曹爽兄弟","evidence":["xiahoucao-e-o067a-q"]},{"id":"xiahoucao-e-o070a-account","label":"《诸夏侯曹传第九》正文","text":"许允陈泰劝曹爽归罪曹爽遣二人见司马懿罢官还第","evidence":["xiahoucao-e-o070a-q"]},{"id":"xiahoucao-e-p034b-account","label":"《世语》","text":"《世语》称许允陈泰传意，蒋济与书，尹大目以洛水誓言唯免官，曹爽信而罢兵。","evidence":["xiahoucao-e-p034b-q"]},{"id":"major-proof-a-jiangji","label":"蒋济传引《世语》","text":"《世语》记蒋济随司马宣王屯洛水浮桥，致书曹爽，传达仅免官的说法。","evidence":["major-proof-q-jiangji"]},{"id":"huanchen-a-dc9d0cc4e412bf8b99b7","label":"正文","text":"爽等见收宣王使毓行司隶校尉治其狱","evidence":["huanchen-q-19d51fe544f347ced97a"]},{"id":"chengguo-a-f3bfb4891b9aced5af21","label":"正文","text":"蒋济随司马懿屯洛水诛曹爽","evidence":["chengguo-q-c59fa9616fded7055827"]}],"participants":[{"person":"wendi-p0129","role":"谒陵","evidence":["shaodi-e-o043a-q"]},{"person":"wudi-p0364","role":"奏免","evidence":["shaodi-e-o043a-q"]},{"person":"mingdi-p0056","role":"被免","evidence":["shaodi-e-o043a-q"]},{"person":"shaodi-p0023","role":"被免","evidence":["shaodi-e-o043a-q"]},{"person":"shaodi-p0024","role":"被免","evidence":["shaodi-e-o043a-q"]},{"person":"shaodi-p0025","role":"被免","evidence":["shaodi-e-o043a-q"]},{"person":"shaodi-p0009","role":"奏请","evidence":["xiahoucao-e-o067a-q"]},{"person":"shaodi-p0036","role":"奏请","evidence":["xiahoucao-e-o067a-q"]},{"person":"mingdi-p0054","role":"令免","evidence":["xiahoucao-e-o067a-q"]},{"person":"shaodi-p0069","role":"说降","evidence":["xiahoucao-e-o070a-q"]},{"person":"shaodi-p0046","role":"说降","evidence":["xiahoucao-e-o070a-q"]},{"person":"xiahoucao-p0080","role":"誓说","evidence":["xiahoucao-e-p034b-q"]},{"person":"wendi-p0127","role":"行司隶校尉治爽狱","evidence":["huanchen-q-19d51fe544f347ced97a"]}],"place":{"text":"高平陵","evidence":["shaodi-q-o043"]},"time":{"year":249,"label":"甲午","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"shaodi-y249","dating_review":{"reviewed":true,"anchor":"shaodi-q-o043","basis":"甲午"},"evidence":["shaodi-e-o043a-q","shaodi-q-o043","shaodi-q-o046","shaodi-q-b-33155276d789f594176b","major-proof-q-gaoping-year","major-proof-q-gaoping-date"]},"ordering_evidence":"shaodi-e-o043a-q","source_order":[4,181,"O043a"],"order":1053},{"id":"wgc-e-11-e5","title":"尹大目启请单身追解文钦","order":5523,"accounts":[{"id":"wgc-a-11-e5","label":"裴注·魏末传","text":"尹大目启请单身追解文钦","evidence":["wgc-q0562","wgc-q0102"]}],"participants":[{"person":"xiahoucao-p0080","role":"知大将军一目已突出、启请追解文钦","evidence":["wgc-q0562","wgc-q0102"]},{"person":"shaodi-p0038","role":"准尹大目追解文钦","evidence":["wgc-q0562","wgc-q0102"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0562","wgc-q0102"]},"ordering_evidence":"wgc-q0562"},{"id":"wgc-e-11-e6","title":"尹大目追语文钦被骂","order":5524,"accounts":[{"id":"wgc-a-11-e6","label":"裴注·魏末传","text":"尹大目追语文钦被骂","evidence":["wgc-q0563","wgc-q0102"]}],"participants":[{"person":"xiahoucao-p0080","role":"乘大马被铠甲追文钦遥相与语、心欲曹氏安而谬言、涕泣","evidence":["wgc-q0563","wgc-q0102"]},{"person":"shaodi-p0074","role":"殊不悟、厉声骂大目、张弓傅矢欲射","evidence":["wgc-q0563","wgc-q0102"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0563","wgc-q0102"]},"ordering_evidence":"wgc-q0563"}],"persons":[{"id":"xiahoucao-p0080","name":"尹大目","evidence":["xiahoucao-q-p034","wgc-q0102"],"facts":[],"aliases":[],"mentions":[{"id":"xiahoucao-m-p034-xiahoucao-p0080","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-p034"]},{"id":"wgc-m-p018-xiahoucao-p0080","kind":"mention","text":"本段涉及尹大目","evidence":["wgc-q0102"]}]}],"evidence":[{"id":"chengguo-q-c59fa9616fded7055827","section":"chapter-014","block":"b-26e0c4210ec3844d5ae2","layer":"original","quote":"以随太傅司马宣王屯洛水浮桥，诛曹爽等，","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":453,"anchor":null},"note_id":null,"start":0,"end":19},{"id":"huanchen-q-19d51fe544f347ced97a","section":"chapter-022","block":"b-a56712cdc2166428f216","layer":"original","quote":"爽等见收〖4〗，太傅司马宣王使毓行司隶校尉〖5〗，治其狱〖6〗","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":584,"anchor":null},"note_id":null,"start":0,"end":31},{"id":"major-proof-q-gaoping-date","section":"chapter-009","block":"b-46588bc9fdcd4116f089","layer":"modern","quote":"〖1〗十年：正始十年（公元 249）。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":316,"anchor":null},"note_id":"n-5be1013409cc3f861402","start":0,"end":19},{"id":"major-proof-q-gaoping-year","section":"chapter-009","block":"b-a06b19e7658aef13c99d","layer":"original","quote":"十年正月〖1〗，车驾朝高平陵〖2〗。爽兄弟皆从。﹝一﹞","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":312,"anchor":null},"note_id":null,"start":0,"end":27},{"id":"major-proof-q-jiangji","section":"chapter-014","block":"b-de6bc6fc5630d4049bee","layer":"pei","quote":"﹝四﹞《世语》曰：“初，济随司马宣王屯洛水浮桥；济书与曹爽，言宣王旨‘惟免官而已’。","attribution":"《世语》","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":472,"anchor":null},"note_id":"n-3e463f8d129186dd38ad","start":0,"end":42},{"id":"shaodi-e-o043a-q","section":"chapter-004","block":"b-b1c990928436e9ed43da","layer":"original","quote":"嘉平元年春正月，甲午〖1〗，车驾谒高平陵。﹝一﹞太傅司马宣王奏免大将军曹爽、爽弟中领军羲、武卫将军训、散骑常侍彦官〖2〗，以侯就第。戊戌〖3〗，有司奏收黄门张当付廷尉〖4〗；考实其辞，爽与谋不轨。又尚书丁谧、邓飏、何晏，司隶校尉毕轨，荆州刺史李胜，大司农桓范，皆与爽通奸谋〖5〗，夷三族。语在《爽传》。丙午〖6〗，大赦。丁未〖7〗，以太傅司马宣王为丞相；固让，乃止。﹝二﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":180,"anchor":null},"note_id":null,"start":0,"end":186},{"id":"shaodi-q-b-33155276d789f594176b","section":"chapter-004","block":"b-33155276d789f594176b","layer":"modern","quote":"〖13〗二年：嘉平二年（公元 250）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":198,"anchor":null},"note_id":"n-235bc158a4eae2a0609a","start":0,"end":20},{"id":"shaodi-q-o043","section":"chapter-004","block":"b-b1c990928436e9ed43da","layer":"original","quote":"嘉平元年春正月，甲午〖1〗，车驾谒高平陵。﹝一﹞太傅司马宣王奏免大将军曹爽、爽弟中领军羲、武卫将军训、散骑常侍彦官〖2〗，以侯就第。戊戌〖3〗，有司奏收黄门张当付廷尉〖4〗；考实其辞，爽与谋不轨。又尚书丁谧、邓飏、何晏，司隶校尉毕轨，荆州刺史李胜，大司农桓范，皆与爽通奸谋〖5〗，夷三族。语在《爽传》。丙午〖6〗，大赦。丁未〖7〗，以太傅司马宣王为丞相；固让，乃止。﹝二﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":180,"anchor":null},"note_id":null,"start":0,"end":186},{"id":"shaodi-q-o046","section":"chapter-004","block":"b-8bc97b77985c9cc83eeb","layer":"original","quote":"二年夏五月〖13〗，以征西将军郭淮为车骑将军〖14〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":183,"anchor":null},"note_id":null,"start":0,"end":27},{"id":"wgc-q0102","section":"chapter-028","block":"b-feea5882ee9d8aa67ee2","layer":"pei","quote":"﹝一﹞《魏氏春秋》曰：“钦中子俶，小名鸯。年尚幼，勇力绝人，谓钦曰：‘及其未定，击之可破也。’于是分为二队，夜夹攻军。俶率壮士先至，大呼。大将军军中震扰。钦后期不应。会明，俶退，钦亦引还。”《魏末传》曰：“殿中人姓尹，字大目。小为曹氏家奴，常侍在帝侧。大将军将俱行。大目知大将军一目已突出，启云：‘文钦本是明公腹心，但为人所误耳，又天子乡里。大目昔为文钦所信，乞得追解语之，令还与公复好。’大将军听遣大目单身往；乘大马，被铠甲，追文钦，遥相与语。大目心实欲曹氏安，谬言：‘君侯何苦（若）不可复忍数日中也？’欲使钦解其旨。钦殊不悟，乃更厉声骂大目：‘汝先帝家人，不念报恩，而反与司马师作逆；不顾上天，天不祐汝！’乃张弓傅矢欲射大目，大目涕泣曰：‘世事败矣！善自努力也。’”","attribution":"魏氏春秋；魏末传","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":134,"anchor":null},"note_id":"n-84c7f857031c63247978","start":0,"end":335},{"id":"wgc-q0562","section":"chapter-028","block":"b-feea5882ee9d8aa67ee2","layer":"pei","quote":"大目知大将军一目已突出，启云：‘文钦本是明公腹心，但为人所误耳，又天子乡里。大目昔为文钦所信，乞得追解语之，令还与公复好","attribution":"裴注·魏末传","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":134,"anchor":null},"note_id":"n-84c7f857031c63247978","start":133,"end":193},{"id":"wgc-q0563","section":"chapter-028","block":"b-feea5882ee9d8aa67ee2","layer":"pei","quote":"大将军听遣大目单身往；乘大马，被铠甲，追文钦，遥相与语。大目心实欲曹氏安，谬言：‘君侯何苦（若）不可复忍数日中也？’欲使钦解其旨。钦殊不悟，乃更厉声骂大目：‘汝先帝家人，不念报恩，而反与司马师作逆；不顾上天，天不祐汝！’乃张弓傅矢欲射大目，大目涕泣曰：‘世事败矣！善自努力也","attribution":"裴注·魏末传","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":134,"anchor":null},"note_id":"n-84c7f857031c63247978","start":195,"end":332},{"id":"xiahoucao-e-o066a-q","section":"chapter-009","block":"b-a06b19e7658aef13c99d","layer":"original","quote":"十年正月〖1〗，车驾朝高平陵〖2〗。爽兄弟皆从。﹝一﹞","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":312,"anchor":null},"note_id":null,"start":0,"end":27},{"id":"xiahoucao-e-o067a-q","section":"chapter-009","block":"b-f84db3982bc003dbcc59","layer":"original","quote":"宣王部勒兵马，先据武库。遂出屯洛水浮桥〖3〗，奏爽曰〖4〗：“臣昔从辽东还，先帝诏陛下、秦王及臣升御床，把臣臂，深以后事为念。臣言：‘二祖亦属臣，以后事为念，此自陛下所见；无所忧苦〖5〗，万一有不如意，臣当以死奉明诏！’黄门令董箕等，才人侍疾者〖6〗，皆所闻知。今大将军爽，背弃顾命〖7〗，败乱国典；内则僭拟〖8〗，外专威权；破坏诸营〖9〗，尽据禁兵；群官要职，皆置所亲；殿中宿卫，历世旧人皆复斥出，欲置新人以树私计；根据盘互〖10〗，纵恣日甚。外既如此，又以黄门张当为都监〖11〗，专共交关〖12〗；看察至尊，候伺神器〖13〗；离间二宫〖14〗，伤害骨肉。天下汹汹〖15〗，人怀危惧；陛下但为寄坐〖16〗，岂得久安？此非先帝诏陛下及臣升御床之本意也！臣虽朽迈，敢忘往言？昔赵高极意〖17〗，秦氏以灭；吕、霍早断〖18〗，汉祚永世。此乃陛下之大鉴，臣受命之时也！太尉臣济、尚书令臣孚等〖19〗，皆以‘爽为有无君之心，兄弟不宜典兵宿卫’，奏永宁宫〖20〗。皇太后令敕臣：‘如奏施行。’臣辄敕主者及黄门令：‘罢爽、羲、训吏兵〖21〗，以侯就第；不得逗留，以稽车驾〖22〗；敢有稽留，便以军法从事！’臣辄力疾将兵，屯洛水浮桥〖23〗，伺察非常〖24〗。”﹝二﹞","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":313,"anchor":null},"note_id":null,"start":0,"end":527},{"id":"xiahoucao-e-o070a-q","section":"chapter-009","block":"b-a0a0e5805493de5e57b4","layer":"original","quote":"侍中许允、尚书陈泰说爽，使早自归罪。爽于是遣允、泰诣宣王，归罪请死；乃通宣王奏事。﹝一﹞遂免爽兄弟，以侯还第。﹝二﹞","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":346,"anchor":null},"note_id":null,"start":0,"end":58},{"id":"xiahoucao-e-p034b-q","section":"chapter-009","block":"b-09d9efa3d0503db50c7a","layer":"pei","quote":"宣王使许允、陈泰解语爽，蒋济亦与书达宣王之旨；又使爽所信殿中校尉尹大目谓爽‘唯免官而已’，以洛水为誓。爽信之，罢兵。","attribution":"《世语》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":354,"anchor":null},"note_id":"n-396397b55629f744e16c","start":63,"end":121},{"id":"xiahoucao-q-p034","section":"chapter-009","block":"b-09d9efa3d0503db50c7a","layer":"pei","quote":"﹝一﹞干宝《晋书》曰：“桓范出赴爽，宣王谓蒋济曰：‘智囊往矣！’济曰：‘范则智矣；驽马恋栈豆，爽必不能用也。’”《世语》曰：“宣王使许允、陈泰解语爽，蒋济亦与书达宣王之旨；又使爽所信殿中校尉尹大目谓爽‘唯免官而已’，以洛水为誓。爽信之，罢兵。”《魏氏春秋》曰：“爽既罢兵，曰：‘我不失作富家翁。’范哭曰：‘曹子丹，佳人；生汝兄弟，犊耳！何图今日，坐汝等族灭矣！’”","attribution":"干宝《晋书》；《世语》；《魏氏春秋》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":354,"anchor":null},"note_id":"n-396397b55629f744e16c","start":0,"end":182}],"profiles":{},"directory_counts":{}}
