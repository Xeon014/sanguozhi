a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1ce55992f19dda19b875","start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o062b-q","section":"chapter-001","block":"b-01656b554fda06a0ac10","layer":"original","quote":"公遂济河，围射犬。洪、尚率众降，封为列侯〖8〗。还军敖仓。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":359,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":75,"end":104,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-51bced16741add42ff70","section":"chapter-001","block":"b-51bced16741add42ff70","layer":"modern","quote":"〖1〗四年：建安四年（公元 199）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":369,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-20628d34a709162c77f0","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o061","section":"chapter-001","block":"b-502d4e8c0ed143eaa30d","layer":"original","quote":"四年春二月〖1〗，公还至昌邑〖2〗。张杨将杨丑杀杨〖3〗。眭固又杀丑，以其众属袁绍，屯射犬〖4〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":358,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":49,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o062","section":"chapter-001","block":"b-01656b554fda06a0ac10","layer":"original","quote":"夏四月，进军临河，使史涣、曹仁渡河击之〖5〗。固使杨故长史薛洪、河内太守缪尚留守〖6〗，自将兵北迎绍求救。与涣、仁相遇犬城〖7〗，交战；大破之，斩固。公遂济河，围射犬。洪、尚率众降，封为列侯〖8〗。还军敖仓。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":359,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":104,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
