{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wgc-e-add019","title":"杜默历任吏部郎卫尉","order":5528,"accounts":[{"id":"wgc-a-add019","label":"世语","text":"杜默历任吏部郎卫尉","evidence":["wgc-q0669","wgc-q0104"]}],"participants":[{"person":"xunyu-p0060","role":"任官","evidence":["wgc-q0669","wgc-q0104"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0669","wgc-q0104"]},"ordering_evidence":"wgc-q0669"}],"persons":[{"id":"xunyu-p0060","name":"杜默","evidence":["xunyu-q-p026","wgc-q0104"],"facts":[],"aliases":[],"mentions":[{"id":"xunyu-m-p026-xunyu-p0060","kind":"mention","text":"文中提及","evidence":["xunyu-q-p026"]},{"id":"wgc-m-p020-xunyu-p0060","kind":"mention","text":"本段涉及杜默","evidence":["wgc-q0104"]}]}],"evidence":[{"id":"wgc-q0104","section":"chapter-028","block":"b-d0d04ba82485401d6289","layer":"pei","quote":"《世语》曰：“毌丘俭之诛，党与七百余人。传侍御史杜友治狱，惟举首事十人，余皆奏散。友字季子，东郡人。仕晋冀州刺史、河南尹。子默，字世玄。历吏部郎、卫尉。”","attribution":"世语","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":136,"anchor":null},"note_id":"n-a8c1b3f399f382605fdc","start":0,"end":77},{"id":"wgc-q0669","section":"chapter-028","block":"b-d0d04ba82485401d6289","layer":"pei","quote":"子默，字世玄。历吏部郎、卫尉。","attribution":"世语","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":136,"anchor":null},"note_id":"n-a8c1b3f399f382605fdc","start":61,"end":76},{"id":"xunyu-q-p026","section":"chapter-010","block":"b-dfbaeb048700cd5bb971","layer":"pei","quote":"﹝二﹞《荀氏家传》曰：“恽字长倩，俣字叔倩，诜字曼倩；俣子寓，字景伯。”《世语》曰：“寓少与裴楷、王戎、杜默，俱有名京邑。仕晋，位至尚书，名见显著。子羽嗣，位至尚书。”","attribution":"《荀氏家传》《世语》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":184,"anchor":null},"note_id":"n-91315725914c064021bb","start":0,"end":84}],"profiles":{},"directory_counts":{}}
