u-q-p033"]},{"id":"zhouyu-m-o008-xianzhu-p0047","kind":"mention","text":"文中提及","evidence":["zhouyu-q-o008"]},{"id":"zhouyu-m-o021-xianzhu-p0047","kind":"mention","text":"文中提及","evidence":["zhouyu-q-o021"]},{"id":"wuzhu-m-o009-xianzhu-p0047","kind":"mention","text":"文中提及","evidence":["wuzhu-q-o009"]}]}],"evidence":[{"id":"wudi-e-o139a-q","section":"chapter-001","block":"b-d44820525c4645832365","layer":"original","quote":"十八年春正月〖11〗，进军濡须口〖12〗；攻破权江西营，获权都督公孙阳〖13〗，乃引军还。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":107,"anchor":null},"note_id":null,"start":0,"end":45},{"id":"wuzhu-e-o009a-q","section":"chapter-047","block":"b-2545400e76cb3abb0431","layer":"original","quote":"九年〖26〗，权弟丹杨太守翊，为左右所害；以从兄瑜〖27〗，代翊。﹝三﹞","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":21,"anchor":null},"note_id":null,"start":0,"end":36},{"id":"wuzhu-q-o009","section":"chapter-047","block":"b-2545400e76cb3abb0431","layer":"original","quote":"九年〖26〗，权弟丹杨太守翊，为左右所害；以从兄瑜〖27〗，代翊。﹝三﹞","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":21,"anchor":null},"note_id":null,"start":0,"end":36},{"id":"xianzhu-e-p033a-q","section":"chapter-032","block":"b-346853e5c087da863a72","layer":"pei","quote":"﹝三﹞《献帝春秋》曰：“孙权欲与备共取蜀，遣使报备曰：‘米贼张鲁，居王巴、汉；为曹操耳目，规图益州。刘璋不武，不能自守；若操得蜀，则荆州危矣。今欲先攻取璋，进讨张鲁；首尾相连，一统吴、楚；虽有十操，无所忧也！’备欲自图蜀，拒答不听，曰：‘益州民富强，土地险阻；刘璋虽弱，足以自守。张鲁虚伪，未必尽忠于操。今暴师于蜀、汉，转运于万里；欲使战克攻取，举不失利；此吴起不能定其规，孙武不能善其事也。曹操虽有无君之心，而有奉主之名；议者见操失利于赤壁，谓其力屈，无复远志也。今操三分天下已有其二；将欲饮马于沧海，观兵于吴会；何肯守此坐须老乎？今同盟无故自相攻伐，借枢于操；使敌承其隙，非长计也。’权不听，遣孙瑜率水军住夏口。备不听军过，谓瑜曰：‘汝欲取蜀，吾当被发入山，不失信于天下也！’使关羽屯江陵，张飞屯秭归，诸葛亮据南郡，备自住孱陵。权知备意，因召瑜还。”","attribution":"《献帝春秋》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":159,"anchor":null},"note_id":"n-94d79f3de8316bd2f7c9","start":0,"end":377},{"id":"xianzhu-q-p033","section":"chapter-032","block":"b-346853e5c087da863a72","layer":"pei","quote":"﹝三﹞《献帝春秋》曰：“孙权欲与备共取蜀，遣使报备曰：‘米贼张鲁，居王巴、汉；为曹操耳目，规图益州。刘璋不武，不能自守；若操得蜀，则荆州危矣。今欲先攻取璋，进讨张鲁；首尾相连，一统吴、楚；虽有十操，无所忧也！’备欲自图蜀，拒答不听，曰：‘益州民富强，土地险阻；刘璋虽弱，足以自守。张鲁虚伪，未必尽忠于操。今暴师于蜀、汉，转运于万里；欲使战克攻取，举不失利；此吴起不能定其规，孙武不能善其事也。曹操虽有无君之心，而有奉主之名；议者见操失利于赤壁，谓其力屈，无复远志也。今操三分天下已有其二；将欲饮马于沧海，观兵于吴会；何肯守此坐须老乎？今同盟无故自相攻伐，借枢于操；使敌承其隙，非长计也。’权不听，遣孙瑜率水军住夏口。备不听军过，谓瑜曰：‘汝欲取蜀，吾当被发入山，不失信于天下也！’使关羽屯江陵，张飞屯秭归，诸葛亮据南郡，备自住孱陵。权知备意，因召瑜还。”","attribution":"《献帝春秋》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":159,"anchor":null},"note_id":"n-94d79f3de8316bd2f7c9","start":0,"end":377},{"id":"xunyu-q-b-1274098c4e3707963c03","section":"chapter-010","block":"b-1274098c4e3707963c03","layer":"modern","quote":"〖5〗九年：建安九年（公元 204）。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":129,"anchor":null},"note_id":"n-05ec5dccb4a2549f7141","start":0,"end":19},{"id":"xunyu-q-o024","section":"chapter-010","block":"b-8f5617c1f161dca84cfc","layer":"original","quote":"九年〖5〗，太祖拔邺，领冀州牧。或说太祖：“宜复古，置九州〖6〗；则冀州所制者广大〖7〗，天下服矣。”太祖将从之。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":121,"anchor":null},"note_id":null,"start":0,"end":57},{"id":"zhouyu-e-o008a-q","section":"chapter-054","block":"b-cb2469c06cb18878c8aa","layer":"original","quote":"十一年〖2〗，督孙瑜等讨麻、保二屯〖3〗，枭其渠帅〖4〗，囚俘万余口。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":33,"anchor":null},"note_id":null,"start":0,"end":35},{"id":"zhouyu-e-o056b-q","section":"chapter-054","block":"b-b1258494f8cdc38245eb","layer":"original","quote":"备内欲自规〖2〗，乃伪报曰：“备与璋托为宗室，冀凭英灵，以匡汉朝。今璋得罪左右〖3〗，备独竦惧；非所敢闻，愿加宽贷。若不获请，备当放发归于山林〖4〗！","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":277,"anchor":null},"note_id":null,"start":32,"end":107},{"id":"zhouyu-identity-sunyu","section":"chapter-054","block":"b-1ef96aee8b8cdf77efa3","layer":"modern","quote":"〖9〗奋威：指孙权的堂兄孙瑜。当时他任奋威将军。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":104,"anchor":null},"note_id":"n-ef62540920fb4d448aa3","start":0,"end":24},{"id":"zhouyu-q-b-7a694d8a64abc7584ee6","section":"chapter-054","block":"b-7a694d8a64abc7584ee6","layer":"modern","quote":"〖2〗十一年：建安十一年（公元206）。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":39,"anchor":null},"note_id":"n-a18f1a1fe780e4c92d19","start":0,"end":20},{"id":"zhouyu-q-o008","section":"chapter-054","block":"b-cb2469c06cb18878c8aa","layer":"original","quote":"十一年〖2〗，督孙瑜等讨麻、保二屯〖3〗，枭其渠帅〖4〗，囚俘万余口。还备（官）〔宫〕亭〖5〗。江夏太守黄祖遣将邓龙，将兵数千人入柴桑；瑜追讨击，生虏龙送吴。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":33,"anchor":null},"note_id":null,"start":0,"end":79},{"id":"zhouyu-q-o021","section":"chapter-054","block":"b-c05f1040e86ac2a9c7d3","layer":"original","quote":"是时，刘璋为益州牧〖5〗，外有张鲁寇侵〖6〗。瑜乃诣京见权曰：“今曹操新折衂〖7〗，方忧在腹心，未能与将军连兵相事也〖8〗。乞与奋威俱进，取蜀〖9〗，得蜀而并张鲁；因留奋威固守其地，好与马超结援；瑜还与将军据襄阳以<操〖10〗：北方可图也。”","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":90,"anchor":null},"note_id":null,"start":0,"end":121},{"id":"zongshi-q-01153a8a624479761c1e","section":"chapter-051","block":"b-397a42aef261c61b499d","layer":"original","quote":"济阴人马普笃学好古〖10〗，瑜厚礼之；使二府将吏子弟数百人，就受业〖11〗：遂立学官，临飨讲肄","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":20,"anchor":null},"note_id":null,"start":0,"end":47},{"id":"zongshi-q-1b7461a17687522a5b4a","section":"chapter-051","block":"b-0e3b9cf3284ab311590d","layer":"original","quote":"黄盖及兄瑜卒，又并其军","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":36,"anchor":null},"note_id":null,"start":63,"end":74},{"id":"zongshi-q-332b2f630fae8969e4db","section":"chapter-051","block":"b-be9bb38f34c716c0c5f6","layer":"original","quote":"年三十九，建安二十年卒","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":21,"anchor":null},"note_id":null,"start":0,"end":11},{"id":"zongshi-q-4e48a1b80edf2349acd8","section":"chapter-051","block":"b-0581db61218fea6c79bf","layer":"original","quote":"后从权拒曹公于濡须，权欲交战。瑜说权持重，权不从：军果无功","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":19,"anchor":null},"note_id":null,"start":51,"end":80},{"id":"zongshi-q-5e28e1146cf162d2b291","section":"chapter-051","block":"b-0581db61218fea6c79bf","layer":"original","quote":"建安九年，领丹杨太守；为众所附，至万余人。加绥远将军","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":19,"anchor":null},"note_id":null,"start":0,"end":26},{"id":"zongshi-q-74e6dc50cc233cfd5153","section":"chapter-051","block":"b-0581db61218fea6c79bf","layer":"original","quote":"十一年〖4〗，与周瑜共讨麻、保二屯，破之","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":19,"anchor":null},"note_id":null,"start":30,"end":50},{"id":"zongshi-q-b7c72355a3b84a11aba6","section":"chapter-051","block":"b-82905df7feb7d2012611","layer":"original","quote":"以恭义校尉始领兵众〖1〗。是时，宾客诸将多江西人〖2〗，瑜虚心绥抚，得其欢心","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":18,"anchor":null},"note_id":null,"start":5,"end":43},{"id":"zongshi-q-d1931385ed1ef8a826cd","section":"chapter-051","block":"b-0581db61218fea6c79bf","layer":"original","quote":"瑜以永安人饶助为襄安长〖7〗，无锡人颜连为居巢长〖8〗；使招纳庐江二郡〖9〗，各得降附","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":19,"anchor":null},"note_id":null,"start":106,"end":149},{"id":"zongshi-q2-0023f1b1249c0e6d68ef","section":"chapter-051","block":"b-be9bb38f34c716c0c5f6","layer":"original","quote":"年三十九，建安二十年卒。瑜五子：弥、熙、耀、曼、纮。曼至将军，封侯。","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":21,"anchor":null},"note_id":null,"start":0,"end":34},{"id":"zongshi-q2-33880318e8ae1e822bfd","section":"chapter-051","block":"b-0581db61218fea6c79bf","layer":"original","quote":"建安九年，领丹杨太守；为众所附，至万余人。加绥远将军〖3〗。十一年〖4〗，与周瑜共讨麻、保二屯，破之。后从权拒曹公于濡须，权欲交战。瑜说权持重，权不从：军果无功。迁奋威将军〖5〗，领郡如故，自溧阳徙屯牛渚〖6〗。瑜以永安人饶助为襄安长〖7〗，无锡人颜连为居巢长〖8〗；使招纳庐江二郡〖9〗，各得降附。","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":19,"anchor":null},"note_id":null,"start":0,"end":150}],"profiles":{},"directory_counts":{}}
