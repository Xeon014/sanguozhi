{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-p033a","title":"刘备拒孙瑜军西上取蜀","accounts":[{"id":"xianzhu-e-p033a-account","label":"《献帝春秋》","text":"《献帝春秋》记刘备拒孙权共同取蜀；孙瑜军到夏口，刘备禁止经过，并分兵江陵、秭归、南郡，自屯孱陵，孙权召还孙瑜。","evidence":["xianzhu-e-p033a-q"]}],"participants":[{"person":"sun-quan","role":"遣军后召还","evidence":["xianzhu-e-p033a-q"]},{"person":"liu-bei","role":"拒绝通行","evidence":["xianzhu-e-p033a-q"]},{"person":"xianzhu-p0047","role":"率军","evidence":["xianzhu-e-p033a-q"]},{"person":"wudi-p0172","role":"屯江陵","evidence":["xianzhu-e-p033a-q"]},{"person":"wudi-p0367","role":"屯秭归","evidence":["xianzhu-e-p033a-q"]},{"person":"zhuge-liang","role":"据南郡","evidence":["xianzhu-e-p033a-q"]}],"place":{"text":"夏口、江陵、秭归、南郡、孱陵","evidence":["xianzhu-e-p033a-q"]},"time":{"label":"刘备入蜀之前","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xianzhu-e-p033a-q"]},"source_order":[32,160,"P033a"],"related_events":[{"event":"zhouyu-e-o056b","type":"related","evidence":["zhouyu-e-o056b-q","xianzhu-e-p033a-q"]}],"order":6554},{"id":"wuzhu-e-o009a","title":"孙翊为左右所害孙瑜代领丹杨","accounts":[{"id":"wuzhu-e-o009a-account","label":"《吴主传第二》正文","text":"孙翊为左右所害孙瑜代领丹杨","evidence":["wuzhu-e-o009a-q"]}],"participants":[{"person":"sunshi-p0028","role":"遇害","evidence":["wuzhu-e-o009a-q"]},{"person":"xianzhu-p0047","role":"代任","evidence":["wuzhu-e-o009a-q"]},{"person":"sun-quan","role":"任命","evidence":["wuzhu-e-o009a-q"]}],"place":null,"time":{"year":204,"label":"建安九年","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"wuzhu-y204","dating_review":{"reviewed":true,"anchor":"wuzhu-q-o009","basis":"建安九年"},"evidence":["wuzhu-e-o009a-q","wuzhu-q-o009","xunyu-q-o024","xunyu-q-b-1274098c4e3707963c03"]},"ordering_evidence":"wuzhu-e-o009a-q","source_order":[47,22,"O009a"],"order":8156},{"id":"zongshi-e-o010","title":"瑜以恭义校尉始领兵众；是时宾客诸将多江西人，瑜虚心绥抚，得其欢心","accounts":[{"id":"zongshi-a-7d9f53acb3836f37e288","label":"正文","text":"瑜以恭义校