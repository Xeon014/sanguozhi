35aa2dd3"]},{"person":"sunshi-p0006","role":"东方、为太平道","evidence":["gongsuntao-q-55da15fb198335aa2dd3"]},{"person":"gongsuntao-p0038","role":"汉中、为五斗米道","evidence":["gongsuntao-q-55da15fb198335aa2dd3"]}],"place":null,"time":{"label":"熹平中（三辅骆曜）；光和中（东方张角、汉中张脩）","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["gongsuntao-q-55da15fb198335aa2dd3"]},"ordering_evidence":"gongsuntao-q-55da15fb198335aa2dd3","source_order":[8,285,10],"order":2083},{"id":"gongsuntao-e-o224","title":"脩法略与角同加静室奸令祭酒三官手书","accounts":[{"id":"gongsuntao-a-69d2ed843b5c533ea60a","label":"裴注·典略","text":"脩法略与角同加静室奸令祭酒三官手书","evidence":["gongsuntao-q-6302e09a2eecf730bb08"]}],"participants":[{"person":"gongsuntao-p0038","role":"加施静室使病者处其中思过、又使人为奸令祭酒祭酒主以老子五千文使都习号为奸令、为鬼吏主为病者请祷请祷之法书病人姓名说服罪之意作三通其一上之天著山上其一埋之地其一沉之水谓之三官手书、使病者家出米五斗以为常故号曰五斗米师","evidence":["gongsuntao-q-6302e09a2eecf730bb08"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["gongsuntao-q-6302e09a2eecf730bb08"]},"ordering_evidence":"gongsuntao-q-6302e09a2eecf730bb08","source_order":[8,285,118],"order":2085},{"id":"gongsuntao-e-o225","title":"角被诛脩亦亡鲁在汉中增饰其业","accounts":[{"id":"gongsuntao-a-c35df8571c5d2a511488","label":"裴注·典略","text":"角被诛脩亦亡鲁在汉中增饰其业","evidence":["gongsuntao-q-85b2e759fe3bfecb2361"]}],"participants":[{"person":"sunshi-p0006","role":"后被诛","evidence":["gongsuntao-q-85b2e759fe3bfecb2361"]},{"person":"gongsuntao-p0038","role":"亦亡","evidence":["gongsuntao-q-85b2e759fe3bfecb2361"]},{"person":"wudi-p0279","role":"在汉中因其民信行脩业遂增饰之、教使作义舍以米肉置其中以止行人、又教使自隐有小过者当治道百步则罪除、又依月令春夏禁杀又禁酒、流移寄在其地者不敢不奉","evidence":["gongsuntao-q-85b2e759fe3bfecb2361"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["gongsuntao-q-85b2e759fe3bfecb2361"]},"ordering_evidence":"gongsuntao-q-85b2e759fe3bfecb2361","source_order":[8,285,278],"order":2086}],"persons":[{"id":"gongsuntao-p0038","name":"张脩","evidence":["gongsuntao-q-19a3441e21c5f63ef653","gongsuntao-q-ba487705444dbb53adc9","gongsuntao-q-55da15fb198335aa2dd3","gongsuntao-q-6302e09a2eecf730bb08","gongsuntao-q-85b2e759fe3bfecb2361","gongsuntao-q-e446f4f62001834148d3"],"facts":[],"aliases":[],"mentions":[{"id":"gongsuntao-m-review-c3e7b18b50f4dfa92f12","kind":"mention","text":"张脩见于相关言论或记载。","evidence":["gongsuntao-q-e446f4f62001834148d3"]}]}],"evidence":[{"id":"gongsuntao-q-19a3441e21c5f63ef653","section":"chapter-008","block":"b-bc1e82598f19bfd38850","layer":"original","quote":"益州牧刘焉，以鲁为督义司马〖4〗；与别部司马张脩，将兵击汉中太守苏固","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":270,"anchor":null},"note_id":null,"start":0,"end":34},{"id":"gongsuntao-q-55da15fb198335aa2dd3","section":"chapter-008","block":"b-4ac971e2af4b20f17ba7","layer":"pei","quote":"熹平中，妖贼大起，三辅有骆曜；光和中，东方有张角，汉中有张脩。骆曜教民缅匿法，角为太平道，脩为五斗米道","attribution":"裴注·典略","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":284,"anchor":null},"note_id":"n-0ac770e5b8c2b604ba38","start":10,"end":61},{"id":"gongsuntao-q-6302e09a2eecf730bb08","section":"chapter-008","block":"b-4ac971e2af4b20f17ba7","layer":"pei","quote":"脩法略与角同，加施静室，使病者处其中思过。又使人为奸令祭酒：祭酒主以《老子》五千文，使都习，号为奸令；为鬼吏，主为病者请祷。请祷之法，书病人姓名，说服罪之意。作三通，其一上之天，著山上；其一埋之地；其一沉之水：谓之“三官手书”。使病者家出米五斗，以为常，故号曰‘五斗米师","attribution":"裴注·典略","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":284,"anchor":null},"note_id":"n-0ac770e5b8c2b604ba38","start":118,"end":253},{"id":"gongsuntao-q-85b2e759fe3bfecb2361","section":"chapter-008","block":"b-4ac971e2af4b20f17ba7","layer":"pei","quote":"后角被诛，脩亦亡。及鲁在汉中，因其民信行脩业，遂增饰之：教使作义舍，以米肉置其中，以止行人；又教使自隐，有小过者，当治道百步，则罪除；又依月令，春夏禁杀；又禁酒：流移寄在其地者，不敢不奉","attribution":"裴注·典略","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":284,"anchor":null},"note_id":"n-0ac770e5b8c2b604ba38","start":278,"end":371},{"id":"gongsuntao-q-ba487705444dbb53adc9","section":"chapter-008","block":"b-bc1e82598f19bfd38850","layer":"original","quote":"鲁遂袭脩杀之，夺其众","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":270,"anchor":null},"note_id":null,"start":38,"end":48},{"id":"gongsuntao-q-e446f4f62001834148d3","section":"chapter-008","block":"b-6b5d8d4546a798a53679","layer":"pei","quote":"臣松之谓：张脩应是张衡，非《典略》之失，则传写之误","attribution":"裴注·注家按语","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":285,"anchor":null},"note_id":"n-0ac770e5b8c2b604ba38","start":0,"end":25},{"id":"liuermu-q-d2a30943807d5604d958","section":"chapter-031","block":"b-445ab818cadf909dcdcc","layer":"original","quote":"故焉遣鲁为督义司马〖4〗，住汉中","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":37,"anchor":null},"note_id":null,"start":49,"end":65}],"profiles":{},"directory_counts":{}}
