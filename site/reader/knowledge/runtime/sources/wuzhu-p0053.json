{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wuzhu-e-p044c","title":"全琮表陈炽任掾陈炽赴召道卒","accounts":[{"id":"wuzhu-e-p044c-account","label":"《吴书》","text":"全琮表陈炽任掾陈炽赴召道卒","evidence":["wuzhu-e-p044c-q"]}],"participants":[{"person":"shaodi-p0005","role":"表荐","evidence":["wuzhu-e-p044c-q"]},{"person":"wuzhu-p0053","role":"赴召而卒","evidence":["wuzhu-e-p044c-q"]}],"place":null,"time":{"label":"陈化任官至卒","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["wuzhu-e-p044c-q"]},"ordering_evidence":"wuzhu-e-p044c-q","source_order":[47,386,"P044c"],"order":8268}],"persons":[{"id":"wuzhu-p0053","name":"陈炽","evidence":["wuzhu-q-p044"],"facts":[{"id":"wuzhu-f0019","label":"字","text":"公熙","evidence":["wuzhu-f0019-q"]}],"aliases":[{"text":"公熙","evidence":["wuzhu-f0019-q"]}],"mentions":[{"id":"wuzhu-m-p044-wuzhu-p0053","kind":"mention","text":"文中提及","evidence":["wuzhu-q-p044"]}]}],"evidence":[{"id":"wuzhu-e-p044c-q","section":"chapter-047","block":"b-18ebe4b5f421a0b951d1","layer":"pei","quote":"长子炽，字公熙。少有志操，能计算。卫将军全琮表称炽任大将军〔掾〕；赴召，道卒。","attribution":"《吴书》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":385,"anchor":null},"note_id":"n-e3000e5763a1cac243ce","start":323,"end":362},{"id":"wuzhu-f0019-q","section":"chapter-047","block":"b-18ebe4b5f421a0b951d1","layer":"pei","quote":"炽，字公熙","attribution":"《吴书》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":385,"anchor":null},"note_id":"n-e3000e5763a1cac243ce","start":325,"end":330},{"id":"wuzhu-q-p044","section":"chapter-047","block":"b-18ebe4b5f421a0b951d1","layer":"pei","quote":"﹝七﹞《吴书》曰：“以尚书令陈化为太常。化字元耀。汝南人。博览众书，气干刚毅；长七尺九寸，雅有威容。为郎中令，使魏。魏文帝因酒酣，嘲问曰：‘吴、魏峙立，谁将平一海内者乎？’化对曰：‘《易》称帝出乎震；加闻先哲知命旧说，紫盖黄旗，运在东南。’帝曰：‘昔文王以西伯王天下，岂复在东乎？’化曰：‘周之初基，太伯在东；是以文王，能兴于西。’帝笑，无以难，心奇其辞。使毕当还，礼送甚厚。权以化奉命光国，拜犍为太守，置官属。顷之，迁太常，兼尚书令。正色立朝，（劝）〔敕〕子弟：废田业，绝治产；仰官廪禄，不与百姓争利。妻早亡，化以古事为鉴，乃不复娶。权闻而贵之，以其年壮，敕宗正：妻以宗室女；化固辞以疾，权不违其志。年出七十，乃上疏乞骸骨。遂爰居章安，卒于家。长子炽，字公熙。少有志操，能计算。卫将军全琮表称炽任大将军〔掾〕；赴召，道卒。”","attribution":"《吴书》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":385,"anchor":null},"note_id":"n-e3000e5763a1cac243ce","start":0,"end":363}],"profiles":{},"directory_counts":{}}
