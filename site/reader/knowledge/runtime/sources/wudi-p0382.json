":["shaodi-e-p035b-q"]},{"person":"wudi-p0390","role":"被救","evidence":["shaodi-e-p035b-q"]}],"place":null,"time":{"label":"建安二十三年","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["shaodi-e-p035b-q"]},"ordering_evidence":"shaodi-e-p035b-q","source_order":[4,618,"P035b"],"related_events":[{"event":"wudi-e-o193a","type":"related","evidence":["shaodi-e-p035b-q","wudi-e-o193a-q"]}],"order":1205},{"id":"mantian-e-o086a","title":"豫迁南阳太守郡人侯音反为群盗","accounts":[{"id":"mantian-a-3fe1e32dabe9c2f7db65","label":"正文","text":"豫迁南阳太守郡人侯音反为群盗","evidence":["mantian-q-bd30fe3919fae0930a82"]}],"participants":[{"person":"mingdi-p0025","role":"迁南阳太守","evidence":["mantian-q-bd30fe3919fae0930a82"]},{"person":"wudi-p0382","role":"反、众数千人山中为群盗","evidence":["mantian-q-bd30fe3919fae0930a82"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["mantian-q-bd30fe3919fae0930a82"]},"ordering_evidence":"mantian-q-bd30fe3919fae0930a82","source_order":[26,134,9],"order":5183}],"persons":[{"id":"wudi-p0382","name":"侯音","evidence":["wudi-q-o193","shaodi-q-p035","xiahoucao-q-o027","mantian-q-bd30fe3919fae0930a82","lizang-q-05620856109b831dafe0","lizang-q-0100a16c14f345e696d5"],"facts":[],"aliases":[],"mentions":[{"id":"wudi-m-o193-wudi-p0382","kind":"mention","text":"文中提及","evidence":["wudi-q-o193"]},{"id":"wudi-m-o194-wudi-p0382","kind":"mention","text":"文中提及","evidence":["wudi-q-o194"]},{"id":"wudi-m-p143-wudi-p0382","kind":"mention","text":"文中提及","evidence":["wudi-q-p143"]},{"id":"shaodi-m-p035-wudi-p0382","kind":"mention","text":"文中提及","evidence":["shaodi-q-p035"]},{"id":"xiahoucao-m-o027-wudi-p0382","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-o027"]}]}],"evidence":[{"id":"lizang-q-0100a16c14f345e696d5","section":"chapter-018","block":"b-600ec9e048958a94c35d","layer":"original","quote":"德将所领与曹仁共攻拔宛，斩音、开","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":202,"anchor":null},"note_id":null,"start":46,"end":62},{"id":"lizang-q-05620856109b831dafe0","section":"chapter-018","block":"b-600ec9e048958a94c35d","layer":"original","quote":"侯音、卫开等以宛叛","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":202,"anchor":null},"note_id":null,"start":36,"end":45},{"id":"mantian-q-bd30fe3919fae0930a82","section":"chapter-026","block":"b-07ee6f5c5e1138d575a3","layer":"original","quote":"迁南阳太守。先时，郡人侯音反，众数千人在山中为群盗，大为郡患","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":133,"anchor":null},"note_id":null,"start":0,"end":30},{"id":"shaodi-e-p035b-q","section":"chapter-004","block":"b-26e03b3ad17e56cbdf8f","layer":"pei","quote":"﹝一﹞《楚国先贤传》曰：“余字子正。天姿方毅，志尚仁义。建安二十三年为郡功曹。是时吴、蜀不宾，疆埸多虞。宛将侯音，扇动山民，保城以叛。余与太守东里衮，当扰攘之际，进窜得出。音即遣骑追逐，去城十里相及；贼便射衮，飞矢交流。余前以身当箭，被七创。因谓追贼曰：‘侯音狂狡，造为凶逆，大军寻至，诛夷在近。谓卿曹本是善人，素无恶心；当思反善，何为受其指挥？我以身代君，已被重创；若身死君全，陨没无恨！’因仰天号哭泣涕，血泪俱下。贼见其义烈，释衮不害。贼去之后，余亦命绝。征南将军曹仁讨平音，表余行状，并修祭醊。太祖闻之，嗟叹良久。下荆州：复表门闾，赐谷千斛。”","attribution":"《楚国先贤传》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":25,"anchor":null},"note_id":"n-7dcbf2833a9c8d0368aa","start":0,"end":275},{"id":"shaodi-q-p035","section":"chapter-004","block":"b-26e03b3ad17e56cbdf8f","layer":"pei","quote":"﹝一﹞《楚国先贤传》曰：“余字子正。天姿方毅，志尚仁义。建安二十三年为郡功曹。是时吴、蜀不宾，疆埸多虞。宛将侯音，扇动山民，保城以叛。余与太守东里衮，当扰攘之际，进窜得出。音即遣骑追逐，去城十里相及；贼便射衮，飞矢交流。余前以身当箭，被七创。因谓追贼曰：‘侯音狂狡，造为凶逆，大军寻至，诛夷在近。谓卿曹本是善人，素无恶心；当思反善，何为受其指挥？我以身代君，已被重创；若身死君全，陨没无恨！’因仰天号哭泣涕，血泪俱下。贼见其义烈，释衮不害。贼去之后，余亦命绝。征南将军曹仁讨平音，表余行状，并修祭醊。太祖闻之，嗟叹良久。下荆州：复表门闾，赐谷千斛。”","attribution":"《楚国先贤传》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":25,"anchor":null},"note_id":"n-7dcbf2833a9c8d0368aa","start":0,"end":275},{"id":"wudi-e-o193a-q","section":"chapter-001","block":"b-21f24b8f57341b1dcb4e","layer":"original","quote":"冬十月，宛守将侯音等反；执南阳太守，劫略吏民，保宛。初，曹仁讨关羽，屯樊城；是月，使仁围宛。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":401,"anchor":null},"note_id":null,"start":0,"end":46},{"id":"wudi-e-o194a-q","section":"chapter-001","block":"b-adb6682558d65fc17e1a","layer":"original","quote":"二十四年春正月〖1〗，仁屠宛，斩音。﹝一﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":422,"anchor":null},"note_id":null,"start":0,"end":21},{"id":"wudi-e-p143a-q","section":"chapter-001","block":"b-7b243201ddfe4ecaad10","layer":"pei","quote":"是时，南阳间苦徭役。音于是执太守东里（裦）〔衮〕，与吏民共反，与关羽连和。","attribution":"《曹瞒传》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":435,"anchor":null},"note_id":"n-8fe895a36710c7eeb225","start":11,"end":48},{"id":"wudi-e-p143b-q","section":"chapter-001","block":"b-7b243201ddfe4ecaad10","layer":"pei","quote":"南阳功曹宗子卿，往说音曰：‘足下顺民心，举大事，远近莫不望风；然执郡将，逆而无益；何不遣之？吾与子共戮力。比曹公军来，关羽兵亦至矣。’音从之，即释遣太守。子卿因夜逾城亡出，遂与太守收余民，围音。会曹仁军至，共灭之。","attribution":"《曹瞒传》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":435,"anchor":null},"note_id":"n-8fe895a36710c7eeb225","start":48,"end":155},{"id":"wudi-q-b-1e7ae1441471aa22d204","section":"chapter-001","block":"b-1e7ae1441471aa22d204","layer":"modern","quote":"〖1〗二十四年：建安二十四年（公元 219）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":428,"anchor":null},"note_id":"n-f2589f07b550616f1e63","start":0,"end":23},{"id":"wudi-q-b-ac93ccb47f6e7be3aea4","section":"chapter-001","block":"b-ac93ccb47f6e7be3aea4","layer":"modern","quote":"〖1〗二十三年：建安二十三年（公元 218）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":403,"anchor":null},"note_id":"n-8cae36984cdc22e48444","start":0,"end":23},{"id":"wudi-q-o188","section":"chapter-001","block":"b-1336d4803d0b76311776","layer":"original","quote":"二十三年春正月〖1〗，汉太医令吉本与少府耿纪、司直韦晃等反〖2〗。攻许，烧丞相长史王必营〖3〗。﹝一﹞必与颍川典农中郎将严匡讨斩之〖4〗。﹝二﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":396,"anchor":null},"note_id":null,"start":0,"end":72},{"id":"wudi-q-o193","section":"chapter-001","block":"b-21f24b8f57341b1dcb4e","layer":"original","quote":"冬十月，宛守将侯音等反；执南阳太守，劫略吏民，保宛。初，曹仁讨关羽，屯樊城；是月，使仁围宛。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":401,"anchor":null},"note_id":null,"start":0,"end":46},{"id":"wudi-q-o194","section":"chapter-001","block":"b-adb6682558d65fc17e1a","layer":"original","quote":"二十四年春正月〖1〗，仁屠宛，斩音。﹝一﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":422,"anchor":null},"note_id":null,"start":0,"end":21},{"id":"wudi-q-p143","section":"chapter-001","block":"b-7b243201ddfe4ecaad10","layer":"pei","quote":"﹝一﹞《曹瞒传》曰：“是时，南阳间苦徭役。音于是执太守东里（裦）〔衮〕，与吏民共反，与关羽连和。南阳功曹宗子卿，往说音曰：‘足下顺民心，举大事，远近莫不望风；然执郡将，逆而无益；何不遣之？吾与子共戮力。比曹公军来，关羽兵亦至矣。’音从之，即释遣太守。子卿因夜逾城亡出，遂与太守收余民，围音。会曹仁军至，共灭之。”","attribution":"《曹瞒传》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":435,"anchor":null},"note_id":"n-8fe895a36710c7eeb225","start":0,"end":156},{"id":"xiahoucao-e-o027a-q","section":"chapter-009","block":"b-7eef8a1f58fc0a970c7b","layer":"original","quote":"复以仁行征南将军，假节，屯樊，镇荆州。侯音以宛叛，略傍县众数千人。仁率诸军攻破音，斩其首。还屯樊，即拜征南将军。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":133,"anchor":null},"note_id":null,"start":0,"end":56},{"id":"xiahoucao-q-o027","section":"chapter-009","block":"b-7eef8a1f58fc0a970c7b","layer":"original","quote":"复以仁行征南将军，假节，屯樊，镇荆州。侯音以宛叛，略傍县众数千人。仁率诸军攻破音，斩其首。还屯樊，即拜征南将军。关羽攻樊；时汉水暴溢，于禁等七军皆没，禁降羽。仁人马数千人守城，城不没者数板〖1〗。羽乘船临城，围数重；外内断绝，粮食欲尽，救兵不至。仁激励将士，示以必死，将士感之皆无二〖2〗。徐晃救至，水亦稍减；晃从外击羽，仁得溃围出。羽退走。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":133,"anchor":null},"note_id":null,"start":0,"end":171}],"profiles":{},"directory_counts":{}}
