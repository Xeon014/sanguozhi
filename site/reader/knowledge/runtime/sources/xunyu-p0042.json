{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xunyu-e-p019c","title":"荀煇与贾充定晋律作易集解","accounts":[{"id":"xunyu-e-p019c-account","label":"《荀氏家传》及裴注","text":"荀煇为太子中庶子，与贾充定晋律，又作易集解。","evidence":["xunyu-e-p019c-q"]}],"participants":[{"person":"xunyu-p0042","role":"著述","evidence":["xunyu-e-p019c-q"]},{"person":"shaodi-p0131","role":"定律","evidence":["xunyu-e-p019c-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xunyu-e-p019c-q"]},"ordering_evidence":"xunyu-e-p019c-q","source_order":[10,155,"P019c"],"order":2441}],"persons":[{"id":"xunyu-p0042","name":"荀煇","evidence":["xunyu-q-p019"],"facts":[],"aliases":[],"mentions":[{"id":"xunyu-m-p019-xunyu-p0042","kind":"mention","text":"文中提及","evidence":["xunyu-q-p019"]}]}],"evidence":[{"id":"xunyu-e-p019c-q","section":"chapter-010","block":"b-310798880b116dcdf9cc","layer":"pei","quote":"闳从孙（恽）〔煇〕，字景文。太子中庶子，亦知名。与贾充共定（音）〔晋〕律，又作《易集解》。","attribution":"《荀氏家传》及裴注","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":154,"anchor":null},"note_id":"n-75cfb114317a4cad6048","start":228,"end":273},{"id":"xunyu-q-p019","section":"chapter-010","block":"b-310798880b116dcdf9cc","layer":"pei","quote":"﹝一﹞《荀氏家传》曰：“衍，字休若。彧第三兄。”彧第四兄谌，字友若。事见《袁绍传》。陈群与孔融，论汝、颍人物，群曰：“荀文若、公达、休若、友若、仲豫，当今并无对。”衍子绍，位至太仆。绍子融，字伯雅；与王弼、钟会俱知名；为洛阳令，参大将军军事；与弼、会论《易》、《老》义，传于世。谌子闳，字仲茂。为太子文学掾。时有甲、乙疑论，闳与钟繇、王朗、袁涣，议各不同。文帝与繇书曰：“袁、王国士，更为唇齿；荀闳劲悍，往来锐师：真君侯之勍敌，左右之深忧也。”终黄门侍郎。闳从孙（恽）〔煇〕，字景文。太子中庶子，亦知名。与贾充共定（音）〔晋〕律，又作《易集解》。仲豫名悦，朗陵长俭之少子，彧从父兄也。","attribution":"《荀氏家传》及裴注","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":154,"anchor":null},"note_id":"n-75cfb114317a4cad6048","start":0,"end":292}],"profiles":{},"directory_counts":{}}
