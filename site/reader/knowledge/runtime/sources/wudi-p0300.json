,"ordering_evidence":"yuanzhang-q-7b3e9a7b48c26df95600","source_order":[11,114,0],"order":2562},{"id":"yuanzhang-e-o036","title":"时泰山多盗贼，以凉茂为泰山太守，旬月之间襁负而至者千余家","accounts":[{"id":"yuanzhang-a-ca3009d95ddd92edae4c","label":"正文","text":"时泰山多盗贼，以凉茂为泰山太守，旬月之间襁负而至者千余家","evidence":["yuanzhang-q-0d5fd4e9cb98eaebf0bd"]}],"participants":[{"person":"wudi-p0300","role":"为泰山太守，旬月之间民襁负而至者千余家","evidence":["yuanzhang-q-0d5fd4e9cb98eaebf0bd"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["yuanzhang-q-0d5fd4e9cb98eaebf0bd"]},"ordering_evidence":"yuanzhang-q-0d5fd4e9cb98eaebf0bd","source_order":[11,114,17],"order":2563},{"id":"yuanzhang-e-o038","title":"公孙度擅留凉茂不遣之官，茂终不为屈","accounts":[{"id":"yuanzhang-a-4ffee4d327b45d57e1df","label":"正文","text":"公孙度擅留凉茂不遣之官，茂终不为屈","evidence":["yuanzhang-q-63689d14ddfd4d2a88ff"]}],"participants":[{"person":"gongsuntao-p0007","role":"在辽东擅留凉茂，不遣之官","evidence":["yuanzhang-q-63689d14ddfd4d2a88ff"]},{"person":"wudi-p0300","role":"终不为屈","evidence":["yuanzhang-q-63689d14ddfd4d2a88ff"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["yuanzhang-q-63689d14ddfd4d2a88ff"]},"ordering_evidence":"yuanzhang-q-63689d14ddfd4d2a88ff","source_order":[11,115,7],"order":2564},{"id":"yuanzhang-e-o039","title":"公孙度言欲乘曹公远征以步骑直指邺，问谁能御，诸将皆曰然","accounts":[{"id":"yuanzhang-a-3d241019279b13926da9","label":"正文","text":"本传记公孙度谋袭邺、凉茂谏止；裴松之指出公孙度卒时与太祖定邺、后远征柳城的先后不合。","evidence":["yuanzhang-q-0e6be9f28951f5563d73","yuanzhang-q2-b0e6bf00aa0831e758e5"]},{"id":"yuanzhang-a-7dd57c3e9c7df67c6c32","label":"正文","text":"公孙度顾问凉茂，茂责其安坐观成败、欲称兵西向则存亡不崇朝而决，诸将震动，度曰凉君言是也","evidence":["yuanzhang-q-3ecdd9d9a7cd4151e1e5"]}],"participants":[{"person":"gongsuntao-p0007","role":"谓茂及诸将，欲以步卒三万骑万匹直指邺，问谁能御；顾问凉茂于君意何如，良久纳其言曰凉君言是也","evidence":["yuanzhang-q-0e6be9f28951f5563d73","yuanzhang-q-3ecdd9d9a7cd4151e1e5"]},{"person":"wudi-p0300","role":"答曰将军拥十万之众安坐观成败非人臣之道，曹公忧国家之危败愍百姓之苦毒，率义兵为天下诛残贼，将军称兵西向则存亡之效不崇朝而决","evidence":["yuanzhang-q-3ecdd9d9a7cd4151e1e5"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["yuanzhang-q-0e6be9f28951f5563d73","yuanzhang-q-3ecdd9d9a7cd4151e1e5"]},"ordering_evidence":"yuanzhang-q-0e6be9f28951f5563d73","source_order":[11,115,33],"order":2565},{"id":"yuanzhang-e-o040","title":"凉茂卒官","accounts":[{"id":"yuanzhang-a-16f786f42c88629c9b1a","label":"正文","text":"凉茂卒官","evidence":["yuanzhang-q-10be07fab250e72154b6"]},{"id":"cuimao-a-abd1d8d45c1f0b64fed6","label":"正文","text":"凉茂卒，何夔代茂为太傅","evidence":["cuimao-q-331eac969f57a42a759f"]}],"participants":[{"person":"wudi-p0300","role":"卒于官","evidence":["yuanzhang-q-10be07fab250e72154b6"]},{"person":"wudi-p0323","role":"代茂者","evidence":["cuimao-q-331eac969f57a42a759f"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["yuanzhang-q-10be07fab250e72154b6"]},"ordering_evidence":"yuanzhang-q-10be07fab250e72154b6","source_order":[11,116,85],"order":2566},{"id":"yuanzhang-e-o107","title":"邴原代凉茂为五官将长史，闭门自守非公事不出","accounts":[{"id":"yuanzhang-a-514ef0db9b6622d52385","label":"正文","text":"邴原代凉茂为五官将长史，闭门自守非公事不出","evidence":["yuanzhang-q-383bf551c6e02418e23c"]},{"id":"yuanzhang-a-3714c5074661c448e3a5","label":"裴注·原别传","text":"魏太子为五官中郎将，宾客如云，而邴原独守道持常自非公事不妄举动；太祖微使人问之，原答国危不事冢宰、君老不奉世子此典制也，于是转原为五官长史","evidence":["yuanzhang-q-5fb380a9478f640285db"]}],"participants":[{"person":"yuanzhang-p0075","role":"代凉茂为五官将长史，闭门自守；独守道持常自非公事不妄举动，答吾闻国危不事冢宰君老不奉世子此典制也，转五官长史","evidence":["yuanzhang-q-383bf551c6e02418e23c","yuanzhang-q-5fb380a9478f640285db"]},{"person":"wudi-p0300","role":"被代为五官将长史","evidence":["yuanzhang-q-383bf551c6e02418e23c"]},{"person":"wudi-p0170","role":"为五官中郎将，天下向慕宾客如云","evidence":["yuanzhang-q-5fb380a9478f640285db"]},{"person":"cao-cao","role":"微使人从容问之，令曰子弱不才惧其难正，贪欲相屈以匡励之","evidence":["yuanzhang-q-5fb380a9478f640285db"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["yuanzhang-q-383bf551c6e02418e23c","yuanzhang-q-5fb380a9478f640285db"]},"ordering_evidence":"yuanzhang-q-383bf551c6e02418e23c","source_order":[11,317,104],"order":2630},{"id":"cuimao-e-o079","title":"文帝为太子，以凉茂为太傅、何夔为少傅","accounts":[{"id":"cuimao-a-11840ccba651a76778f9","label":"正文","text":"文帝为太子时，以凉茂为太傅、何夔为少傅，特命二傅与尚书东曹并选太子诸侯官属。","evidence":["cuimao-q-59a3ba72d3bf41e7908e","cuimao-q2-b707dd8f3386ddb2eef9"]},{"id":"cuimao-a-98c0e16d58a9c167721e","label":"正文","text":"特命二傅与尚书、东曹并选太子诸侯官属","evidence":["cuimao-q-cdaa5a7cbb379ce4e35d"]}],"participants":[{"person":"wudi-p0170","role":"当时为太子，受二傅辅导","evidence":["cuimao-q-59a3ba72d3bf41e7908e","cuimao-q2-b707dd8f3386ddb2eef9"]},{"person":"wudi-p0300","role":"受任太傅者；奉命与选之太傅","evidence":["cuimao-q-59a3ba72d3bf41e7908e","cuimao-q-cdaa5a7cbb379ce4e35d"]},{"person":"wudi-p0323","role":"受任少傅者；奉命与选之少傅","evidence":["cuimao-q-59a3ba72d3bf41e7908e","cuimao-q-cdaa5a7cbb379ce4e35d"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["cuimao-q-59a3ba72d3bf41e7908e","cuimao-q-cdaa5a7cbb379ce4e35d"]},"ordering_evidence":"cuimao-q-59a3ba72d3bf41e7908e","source_order":[12,229,0],"order":2795}],"persons":[{"id":"wudi-p0300","name":"凉茂","evidence":["wudi-q-p112","wendi-q-p008","yuanzhang-q-7b3e9a7b48c26df95600","yuanzhang-q-0d5fd4e9cb98eaebf0bd","yuanzhang-q-63689d14ddfd4d2a88ff","yuanzhang-q-3ecdd9d9a7cd4151e1e5","yuanzhang-q-10be07fab250e72154b6","yuanzhang-q-383bf551c6e02418e23c","yuanzhang-q2-08e17269a01deb493386","yuanzhang-q2-ab0b657a1b3df43b8b0d","cuimao-q-59a3ba72d3bf41e7908e","cuimao-q-cdaa5a7cbb379ce4e35d","cuimao-q-331eac969f57a42a759f"],"facts":[{"id":"yuanzhang-f2-a5d3f77541c854d28d13","text":"凉茂转乐浪太守；公孙度擅留辽东，不遣之官。","evidence":["yuanzhang-q2-08e17269a01deb493386"]},{"id":"yuanzhang-f2-e55fc74770cc6a365918","text":"凉茂历魏郡太守、甘陵相，文帝为五官将时选为长史，迁左军师；魏国初建迁尚书仆射，后为中尉、奉常、太子太傅，卒官。","evidence":["yuanzhang-q2-ab0b657a1b3df43b8b0d"]}],"aliases":[],"mentions":[{"id":"wudi-m-p112-wudi-p0300","kind":"mention","text":"文中提及","evidence":["wudi-q-p112"]},{"id":"wudi-m-p115-wudi-p0300","kind":"mention","text":"文中提及","evidence":["wudi-q-p115"]},{"id":"wendi-m-p008-wudi-p0300","kind":"allusion","text":"祖系或典故提及","evidence":["wendi-q-p008"]}]}],"evidence":[{"id":"cuimao-q-1ca58c8c7c2a520497a4","section":"chapter-012","block":"b-b98fdf30cfe006001885","layer":"original","quote":"魏国既建，为尚书，复典选举","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":189,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":13,"offset_unit":"unicode_code_point"},{"id":"cuimao-q-331eac969f57a42a759f","section":"chapter-012","block":"b-2818655e956292e2342d","layer":"original","quote":"茂卒，以夔代茂","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":228,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":43,"end":50,"offset_unit":"unicode_code_point"},{"id":"cuimao-q-59a3ba72d3bf41e7908e","section":"chapter-012","block":"b-2818655e956292e2342d","layer":"original","quote":"文帝为太子，以凉茂为太傅，夔为少傅","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":228,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":17,"offset_unit":"unicode_code_point"},{"id":"cuimao-q-b2a734b1eb1d9b8f59b5","section":"chapter-012","block":"b-744efc38dc3e2f2fb8f8","layer":"original","quote":"魏国初建，拜尚书","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":30,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":8,"offset_unit":"unicode_code_point"},{"id":"cuimao-q-cdaa5a7cbb379ce4e35d","section":"chapter-012","block":"b-2818655e956292e2342d","layer":"original","quote":"特命二傅与尚书、东曹，并选太子、诸侯官属","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":228,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":22,"end":42,"offset_unit":"unicode_code_point"},{"id":"cuimao-q2-b707dd8f3386ddb2eef9","section":"chapter-012","block":"b-2818655e956292e2342d","layer":"original","quote":"文帝为太子，以凉茂为太傅，夔为少傅〖14〗。特命二傅与尚书、东曹，并选太子、诸侯官属。茂卒，以夔代茂。每月朔，太傅入见太子，太子正法服而礼焉〖15〗；他日无会仪。夔迁太仆，太子欲与辞，宿戒供〖16〗；夔无往意，乃与书请之；夔以国有常制，遂不往：其履正如此。然于节俭之世，最为豪汰〖17〗。","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":228,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":144,"offset_unit":"unicode_code_point"},{"id":"wendi-q-p008","section":"chapter-002","block":"b-5476707ed7cc1389d719","layer":"pei","quote":"丁亥令曰：“故尚书仆射毛玠，奉常王修、凉茂，郎中令袁涣，少府谢奂、万潜，中尉徐奕、国渊等，皆忠直在朝，履蹈仁义；并早即世，而子孙陵迟，恻然愍之。其皆拜子男为郎中。”","attribution":"裴注·魏书续引","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":38,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-2a980d42bd6d8f9a3005","start":0,"end":82,"offset_unit":"unicode_code_point"},{"id":"wudi-e-p112a-q","section":"chapter-001","block":"b-9536581b8deb5e7104e4","layer":"pei","quote":"《魏书》载：“公令曰：‘夫受九锡，广开土宇，周公其人也。汉之异姓八王者，与高祖俱起布衣，创定王业，其功至大。吾何可比之？’前后三让。于是中军师、陵树亭侯荀攸，前军师、东武亭侯钟繇，左军师凉茂，右军师毛玠，平虏将军、华乡侯刘勋，建武将军、清苑亭侯刘若，伏波将军、高安侯夏侯惇，扬武将军、都亭侯王忠，奋威将军、乐乡侯（刘）〔邓〕展，建忠将军、昌乡亭侯鲜于辅，奋武将军、安国亭侯程昱，太中大夫、都乡侯贾诩，军师祭酒、千秋亭侯董昭，都亭侯薛洪，南乡亭侯董蒙，关内侯王粲、傅巽，祭酒王选、袁涣、王朗、张承、任藩、杜袭，中护军、国明亭侯曹洪，中领军、万岁亭侯韩浩，行骁骑将军、安平亭侯曹仁，领护军将军王图，长史万潜、谢奂、袁霸等，劝进曰：‘自古三代，胙臣以土；受命中兴，封秩辅佐。皆所以褒功赏德，为国藩卫也。往者天下崩乱，群凶豪起；颠越跋扈之险，不可忍言。明公奋身出命以徇其难，诛二袁篡盗之逆，灭黄巾贼乱之类，殄夷首逆，芟拨荒秽，沐浴霜露二十余年。书契以来，未有若此功者。昔周公承文、武之迹，受已成之业，高枕墨笔，拱揖群后，商、奄之勤，不过二年；吕望因三分有二之形，据八百诸侯之势，暂把旄钺，一时指麾：然皆大启土宇，跨州兼国。周公八子，并为侯伯：白牡骍刚，郊祀天地；典策备物，拟则王室。荣章宠盛如此之弘也。逮至汉兴，佐命之臣张耳、吴芮，其功至薄，亦连城开地，南面称孤。此皆明君达主行之于上，贤臣圣宰受之于下；三代令典，汉帝明制。今比劳则周、吕逸，计功则张、吴微，论制则齐、鲁重，言地则长沙多；然则魏国之封，九锡之荣，况于旧赏，犹怀玉而被褐也。且列侯、诸将，幸攀龙骥，得窃微劳，佩紫怀黄，盖以百数，亦将因此传之万世。而明公独辞赏于上，将使其下怀不自安。上违圣朝欢心，下失冠带至望；忘辅弼之大业，信匹夫之细行。攸等所大惧也！’于是公敕外为章，但受魏郡。攸等复曰：‘伏见魏国初封，圣朝发虑，稽谋群僚，然后策命；而明公久违上指，不即大礼。今既虔奉诏命，副顺众望；又欲辞多当少，让九受一。是犹汉朝之赏不行，而攸等之请未许也。昔齐、鲁之封，奄有东海；疆域井赋，四百万家；基隆业广，易以立功；故能成翼戴之勋，立一匡之绩。今魏国虽有十郡之名，犹减于曲阜；计其户数，不能参半：以藩卫王室，立垣树屏，犹未足也。且圣上览亡秦无辅之祸，惩曩日震荡之艰；托建忠贤，废坠是为。愿明公恭承帝命，无或拒违。’公乃受命。”","attribution":"《魏书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":262,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-97e94061646080072adf","start":0,"end":988,"offset_unit":"unicode_code_point"},{"id":"wudi-e-p115a-q","section":"chapter-001","block":"b-d31f474fc7e57ab9555e","layer":"pei","quote":"﹝二﹞《魏氏春秋》曰：“以荀攸为尚书令；凉茂为仆射；毛玠、崔琰、常林、徐奕、何夔为尚书；王粲、杜袭、卫觊、和洽为侍中。”","attribution":"《魏氏春秋》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":279,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-efecfa99851d5aa2b4e2","start":0,"end":60,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-b9d79988a2b2559f2bb5","section":"chapter-001","block":"b-b9d79988a2b2559f2bb5","layer":"modern","quote":"〖11〗十八年：建安十八年（公元 213）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":137,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-bec99dfe67d67ae54b06","start":0,"end":22,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o139","section":"chapter-001","block":"b-d44820525c4645832365","layer":"original","quote":"十八年春正月〖11〗，进军濡须口〖12〗；攻破权江西营，获权都督公孙阳〖13〗，乃引军还。诏书并十四州〖14〗，复为九州〖15〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":107,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":65,"offset_unit":"unicode_code_point"},{"id":"wudi-q-p112","section":"chapter-001","block":"b-9536581b8deb5e7104e4","layer":"pei","quote":"《魏书》载：“公令曰：‘夫受九锡，广开土宇，周公其人也。汉之异姓八王者，与高祖俱起布衣，创定王业，其功至大。吾何可比之？’前后三让。于是中军师、陵树亭侯荀攸，前军师、东武亭侯钟繇，左军师凉茂，右军师毛玠，平虏将军、华乡侯刘勋，建武将军、清苑亭侯刘若，伏波将军、高安侯夏侯惇，扬武将军、都亭侯王忠，奋威将军、乐乡侯（刘）〔邓〕展，建忠将军、昌乡亭侯鲜于辅，奋武将军、安国亭侯程昱，太中大夫、都乡侯贾诩，军师祭酒、千秋亭侯董昭，都亭侯薛洪，南乡亭侯董蒙，关内侯王粲、傅巽，祭酒王选、袁涣、王朗、张承、任藩、杜袭，中护军、国明亭侯曹洪，中领军、万岁亭侯韩浩，行骁骑将军、安平亭侯曹仁，领护军将军王图，长史万潜、谢奂、袁霸等，劝进曰：‘自古三代，胙臣以土；受命中兴，封秩辅佐。皆所以褒功赏德，为国藩卫也。往者天下崩乱，群凶豪起；颠越跋扈之险，不可忍言。明公奋身出命以徇其难，诛二袁篡盗之逆，灭黄巾贼乱之类，殄夷首逆，芟拨荒秽，沐浴霜露二十余年。书契以来，未有若此功者。昔周公承文、武之迹，受已成之业，高枕墨笔，拱揖群后，商、奄之勤，不过二年；吕望因三分有二之形，据八百诸侯之势，暂把旄钺，一时指麾：然皆大启土宇，跨州兼国。周公八子，并为侯伯：白牡骍刚，郊祀天地；典策备物，拟则王室。荣章宠盛如此之弘也。逮至汉兴，佐命之臣张耳、吴芮，其功至薄，亦连城开地，南面称孤。此皆明君达主行之于上，贤臣圣宰受之于下；三代令典，汉帝明制。今比劳则周、吕逸，计功则张、吴微，论制则齐、鲁重，言地则长沙多；然则魏国之封，九锡之荣，况于旧赏，犹怀玉而被褐也。且列侯、诸将，幸攀龙骥，得窃微劳，佩紫怀黄，盖以百数，亦将因此传之万世。而明公独辞赏于上，将使其下怀不自安。上违圣朝欢心，下失冠带至望；忘辅弼之大业，信匹夫之细行。攸等所大惧也！’于是公敕外为章，但受魏郡。攸等复曰：‘伏见魏国初封，圣朝发虑，稽谋群僚，然后策命；而明公久违上指，不即大礼。今既虔奉诏命，副顺众望；又欲辞多当少，让九受一。是犹汉朝之赏不行，而攸等之请未许也。昔齐、鲁之封，奄有东海；疆域井赋，四百万家；基隆业广，易以立功；故能成翼戴之勋，立一匡之绩。今魏国虽有十郡之名，犹减于曲阜；计其户数，不能参半：以藩卫王室，立垣树屏，犹未足也。且圣上览亡秦无辅之祸，惩曩日震荡之艰；托建忠贤，废坠是为。愿明公恭承帝命，无或拒违。’公乃受命。”","attribution":"《魏书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":262,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-97e94061646080072adf","start":0,"end":988,"offset_unit":"unicode_code_point"},{"id":"wudi-q-p115","section":"chapter-001","block":"b-d31f474fc7e57ab9555e","layer":"pei","quote":"﹝二﹞《魏氏春秋》曰：“以荀攸为尚书令；凉茂为仆射；毛玠、崔琰、常林、徐奕、何夔为尚书；王粲、杜袭、卫觊、和洽为侍中。”","attribution":"《魏氏春秋》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":279,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-efecfa99851d5aa2b4e2","start":0,"end":60,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-0d5fd4e9cb98eaebf0bd","section":"chapter-011","block":"b-bfe68650cba6dd823863","layer":"original","quote":"时泰山多盗贼，以茂为泰山太守；旬月之间，襁负而至者千余家","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":113,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":17,"end":45,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-0e6be9f28951f5563d73","section":"chapter-011","block":"b-3d3fa41457345efff9ba","layer":"original","quote":"度谓茂及诸将曰：“闻曹公远征，邺无守备；今吾欲以步卒三万，骑万匹，直指邺。谁能御之！”诸将皆曰：“然！”","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":114,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":33,"end":85,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-10be07fab250e72154b6","section":"chapter-011","block":"b-d6aa061a701fe673d612","layer":"original","quote":"甚见敬礼〖12〗。卒官","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":115,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":85,"end":96,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-383bf551c6e02418e23c","section":"chapter-011","block":"b-fd25b8b8a419e99b57fe","layer":"original","quote":"代凉茂为五官将长史〖16〗。闭门自守，非公事不出","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":316,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":104,"end":128,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-3ecdd9d9a7cd4151e1e5","section":"chapter-011","block":"b-3d3fa41457345efff9ba","layer":"original","quote":"又顾谓茂曰：“于君意何如？”茂答曰：“比者海内大乱〖4〗，社稷将倾；将军拥十万之众，安坐而观成败；夫为人臣者，固若是邪〖5〗！曹公忧国家之危败，愍百姓之苦毒；率义兵为天下诛残贼，功高而德广，可谓无二矣。以海内初定，民始安集，故未责将军之罪耳！而将军乃欲称兵西向，则存亡之效，不崇朝而决〖6〗。将军其勉之〖7〗！”诸将闻茂言，皆震动。良久，度曰：“凉君言是也","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":114,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":88,"end":266,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-5fb380a9478f640285db","section":"chapter-011","block":"b-e6db2528697a0c69ab6c","layer":"pei","quote":"魏太子为五官中郎将，天下向慕，宾客如云；而原独守道持常，自非公事不妄举动。太祖微使人从容问之，原曰：‘吾闻国危不事冢宰；君老不奉世子：此典制也。’于是乃转五官长史，令曰：‘子弱不才，惧其难正；贪欲相屈，以匡励之。虽云利贤，能不恧恧","attribution":"裴注·原别传","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":342,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-73e160afdb3d08400061","start":349,"end":464,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-63689d14ddfd4d2a88ff","section":"chapter-011","block":"b-3d3fa41457345efff9ba","layer":"original","quote":"公孙度在辽东，擅留茂；不遣之官〖3〗，然茂终不为屈","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":114,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":7,"end":32,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-7b3e9a7b48c26df95600","section":"chapter-011","block":"b-bfe68650cba6dd823863","layer":"original","quote":"太祖辟为司空掾。举高第，补侍御史","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":113,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":16,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q2-08e17269a01deb493386","section":"chapter-011","block":"b-3d3fa41457345efff9ba","layer":"original","quote":"转为乐浪太守。公孙度在辽东，擅留茂；不遣之官〖3〗，然茂终不为屈。度谓茂及诸将曰：“闻曹公远征，邺无守备；今吾欲以步卒三万，骑万匹，直指邺。谁能御之！”诸将皆曰：“然！”﹝二﹞又顾谓茂曰：“于君意何如？”茂答曰：“比者海内大乱〖4〗，社稷将倾；将军拥十万之众，安坐而观成败；夫为人臣者，固若是邪〖5〗！曹公忧国家之危败，愍百姓之苦毒；率义兵为天下诛残贼，功高而德广，可谓无二矣。以海内初定，民始安集，故未责将军之罪耳！而将军乃欲称兵西向，则存亡之效，不崇朝而决〖6〗。将军其勉之〖7〗！”诸将闻茂言，皆震动。良久，度曰：“凉君言是也！”","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":114,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":268,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q2-ab0b657a1b3df43b8b0d","section":"chapter-011","block":"b-d6aa061a701fe673d612","layer":"original","quote":"后征，迁为魏郡太守，甘陵相。所在有绩。文帝为五官将，茂以选为长史〖8〗。迁左军师〖9〗。魏国初建，迁尚书仆射。后为中尉、奉常〖10〗。文帝在东宫，茂复为太子太傅〖11〗；甚见敬礼〖12〗。卒官。﹝三﹞","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":115,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":100,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q2-b0e6bf00aa0831e758e5","section":"chapter-011","block":"b-57aaa4264f738b218818","layer":"pei","quote":"﹝二﹞臣松之按：此传云公孙度“闻曹公远征，邺无守备”，则太祖定邺后也。按《度传》，度以建安九年卒，太祖亦以此年定邺；自后远征，唯有北征柳城耳：征柳城之年，度已不复在矣。","attribution":"裴注（引书见原文）","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":131,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-65b3ccecac42d3b40763","start":0,"end":84,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
