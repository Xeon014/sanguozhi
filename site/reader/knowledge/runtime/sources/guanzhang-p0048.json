3bc0a14a28","note_id":null,"start":42,"end":65,"offset_unit":"unicode_code_point"},{"id":"dongliu-q-c94f732dc1d885c5ca38","section":"chapter-039","block":"b-d1c4b34bb5398cc83d22","layer":"original","quote":"陈祗代允为侍中，与黄皓互相表里〖1〗；皓始预政事","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":188,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":24,"offset_unit":"unicode_code_point"},{"id":"dongliu-q-e3d89b1a3c22e0045d9b","section":"chapter-039","block":"b-68451c2ed7a8a7585594","layer":"original","quote":"自祗之有宠，后主追怨允日深，谓为自轻〖14〗；由祗媚兹一人，皓构间浸润故耳","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":192,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":37,"offset_unit":"unicode_code_point"},{"id":"dongliu-q-ec6bdbab316a43aef342","section":"chapter-039","block":"b-baa5ec505b75c1e60a7c","layer":"original","quote":"赐子粲爵关内侯，拔次子裕为黄门侍郎","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":191,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":95,"end":112,"offset_unit":"unicode_code_point"},{"id":"dongliu-q-fa3efe11475bb4d9a84c","section":"chapter-039","block":"b-7f1aac330b2100a1cbd4","layer":"original","quote":"费祎甚异之，故超继允内侍","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":189,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":60,"end":72,"offset_unit":"unicode_code_point"},{"id":"dongliu-q2-292cafb013edd628114d","section":"chapter-039","block":"b-7f1aac330b2100a1cbd4","layer":"original","quote":"祗字奉宗，汝南人。许靖兄之外孙也。少孤，长于靖家。弱冠知名。稍迁至选曹郎〖4〗。矜厉有威容〖5〗，多技艺，挟数术〖6〗。费祎甚异之，故超继允内侍〖7〗。","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":189,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":76,"offset_unit":"unicode_code_point"},{"id":"dongliu-q2-6711e725af18611bac6a","section":"chapter-039","block":"b-baa5ec505b75c1e60a7c","layer":"original","quote":"景耀元年卒，后主痛惜，发言流涕。乃下诏曰：“祗统职一纪〖9〗，柔嘉惟则〖10〗，干肃有章〖11〗；和义利物，庶绩允明〖12〗。命不融远〖13〗，朕用悼焉！夫存有令问，则亡加美谥。谥曰忠侯。”赐子粲爵关内侯，拔次子裕为黄门侍郎。","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":191,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":113,"offset_unit":"unicode_code_point"},{"id":"dongliu-q2-91d6834e3d9cbb52362a","section":"chapter-039","block":"b-741dab246b7a02177d3e","layer":"original","quote":"吕乂卒，祗又以侍中守尚书令，加镇军将军。大将军姜维虽班在祗上，常率众在外，希亲朝政。祗上承主指〖8〗，下接阉竖；深见信爱，权重于维。","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":190,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":66,"offset_unit":"unicode_code_point"},{"id":"dongliu-q2-f5a5fb1b5a0007c46c35","section":"chapter-039","block":"b-d1c4b34bb5398cc83d22","layer":"original","quote":"陈祗代允为侍中，与黄皓互相表里〖1〗；皓始预政事。祗死后，皓从黄门令，为中常侍、奉车都尉〖2〗，操弄威柄，终至覆国。蜀人无不追思允。及邓艾至蜀，闻皓奸险，收闭〖3〗，将杀之；而皓厚赂艾左右，得免。","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":188,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":98,"offset_unit":"unicode_code_point"},{"id":"duzhou-q-ba8b8edc1730c7ebcdd1","section":"chapter-042","block":"b-bfe974b8d1e8f5ca0142","layer":"original","quote":"于时军旅数出，百姓凋瘁〖1〗。周与尚书令陈祗，论其利害，退而书之，谓之《仇国论》","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":273,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":12,"end":52,"offset_unit":"unicode_code_point"},{"id":"duzhou-q-ea99482283b9e1dcbb11","section":"chapter-042","block":"b-f41c42546e6cedbdacc8","layer":"original","quote":"其辞曰：“因余之国小〖2〗，而肇建之国大；并争于世，而为仇敌。因余之国有高贤卿者，问于伏愚子曰：‘今国事未定，上下劳心。往古之事，能以弱胜强者，其术何如？’伏愚子曰：‘吾闻之：处大无患者恒多慢〖3〗，处小有忧者恒思善；多慢则生乱，思善则生治：理之常也。故周文养民〖4〗，以少取多；勾践恤众〖5〗，以弱毙强〖6〗：此其术也。’贤卿曰：‘曩者项强汉弱，相与战争，无日宁息；然项羽与汉约分鸿沟为界〖7〗，各欲归息民。张良以为民志既定，则难动也；寻帅追羽〖8〗，终弊项氏。岂必由文王之事乎？肇建之国方有疾疢〖9〗，我因其隙，陷其边陲：觊增其疾而毙之也〖10〗。’伏愚子曰：‘当殷、周之际，王侯世尊；君臣久固，民习所专。深根者难拔，据固者难迁。当此之时，虽汉祖安能仗剑鞭马而取天下乎？当秦罢侯置守之后〖11〗，民疲秦役，天下土崩；或岁改主，或月易公；鸟惊兽骇，莫知所从。于是豪强并争，虎裂狼分；疾搏者获多〖12〗，迟后者见吞。今我与肇建皆传国易世矣〖13〗；既非秦末鼎沸之时，实有六国并据之势〖14〗；故可为文王，难为汉祖。夫民疲劳则骚扰之兆生，上慢下暴则瓦解之形起。谚曰：“射幸数跌〖15〗，不如审发〖16〗。”是故智者不为小利移目，不为意似改步〖17〗；时可而后动，数合而后举。故汤、武之师不再战而克，诚重民劳而度时审也。如遂极武黩征〖18〗，土崩势生；不幸遇难，虽有智者，将不能谋之矣。若乃奇变纵横，出入无间〖19〗；冲波截辙，超谷越山；不由舟楫，而济盟津者〖20〗：我愚子也，实所不及！’”","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":274,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":644,"offset_unit":"unicode_code_point"},{"id":"guanzhang-q-o046","section":"chapter-036","block":"b-9f348b83292228dfc790","layer":"original","quote":"七年卒〖3〗，追谥顺平侯。初，先主时，惟法正见谥。后主时，诸葛亮功德盖世，蒋琬、费祎荷国之重〖4〗，亦见谥。陈祗宠待〖5〗，特加殊奖；夏侯霸，远来归国〖6〗：故复得谥。于是关羽、张飞、马超、庞统、黄忠及云乃追谥，时论以为荣﹝二﹞。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":201,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":115,"offset_unit":"unicode_code_point"},{"id":"pangfa-e-o009a-q","section":"chapter-037","block":"b-ff5bce2e7f33d92dc39f","layer":"original","quote":"统子宏，字巨师。刚简有臧否〖13〗，轻傲尚书令陈祗；为祗所抑，卒于涪陵太守〖14〗。","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":39,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":42,"offset_unit":"unicode_code_point"},{"id":"pangfa-q-o009","section":"chapter-037","block":"b-ff5bce2e7f33d92dc39f","layer":"original","quote":"统子宏，字巨师。刚简有臧否〖13〗，轻傲尚书令陈祗；为祗所抑，卒于涪陵太守〖14〗。统弟林，以荆州治中从事，参镇北将军黄权〖15〗，征吴；值军败〖16〗，随权入魏。魏封列侯，至钜鹿太守。﹝二﹞","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":39,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":96,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-o088","section":"chapter-035","block":"b-352840fe8fe246488eae","layer":"original","quote":"董厥者，丞相亮时为府令史〖1〗，亮称之曰：“董令史，良士也。吾每与之言，思慎宜适〖2〗。”徙为主簿。亮卒后，稍迁至尚书仆射。代陈祗为尚书令〖3〗。迁〔辅国〕大将军，平台事〖4〗。而义阳樊建代焉。﹝一﹞延熙（二）十四年，以校尉使吴；值孙权病笃〖5〗，不自见建。权问诸葛恪曰：“樊建何如宗预也〖6〗？”恪对曰：“才识不及预，而雅性过之。”后为侍中，守尚书令〖7〗。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":437,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":180,"offset_unit":"unicode_code_point"}],"profiles":{"guanzhang-p0048":{"fields":[],"directory":{"faction":"shu"}}},"directory_counts":{}}
