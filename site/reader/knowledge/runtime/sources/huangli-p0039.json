{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhuge-e-o023a","title":"诸葛亮南征秋平南中备军资治戎","accounts":[{"id":"zhuge-e-o023a-account","label":"《诸葛亮传第五》正文","text":"诸葛亮南征秋平南中备军资治戎","evidence":["zhuge-e-o023a-q"]},{"id":"houzhu-a-cd09cc27d7c3","label":"《后主传》正文","text":"三年春三月，丞相亮南征四郡〖2〗，四郡皆平。改益州郡为建宁郡；分建宁、永昌郡为云南郡〖3〗；又分建宁、牂牁为兴古郡〖4〗。","evidence":["houzhu-q-O011"]},{"id":"houzhu-a-4be5073bc57a","label":"《后主传》正文","text":"十二月，亮还成都。","evidence":["houzhu-q-O012"]},{"id":"liuermu-a-4afa64d994032532ec41","label":"正文","text":"诸葛亮平南土","evidence":["liuermu-q-74c22b7e2a9d68bbb6e6"]},{"id":"dongliu-a-46c6b794eff2c6b27fe7","label":"裴注·襄阳记","text":"诸葛亮建兴三年征南中","evidence":["dongliu-q-e2c33f6fff716105c8c6"]},{"id":"dongliu-a-02cc262a250d7ab1640e","label":"裴注·襄阳记","text":"诸葛亮纳策赦孟获服南方","evidence":["dongliu-q-eb0b210fd16e9b4d714b"]},{"id":"huangli-a-702963f01a4ed94939d9","label":"正文","text":"诸葛亮南征先由越嶲","evidence":["huangli-q-6468462c5c9ba31b69b4"]},{"id":"huangli-a-5f4e1fdf9e62c6a816f5","label":"正文","text":"李恢向建宁被围昆泽","evidence":["huangli-q-e3ccf28eaf60b6787884"]},{"id":"huangli-a-9a24d5475d2059342dba","label":"正文","text":"李恢绐南人缓围守","evidence":["huangli-q-b5114bce442112fd9e76"]},{"id":"huangli-a-2c5e60e64ed818ef9a9f","label":"正文","text":"李恢出击大破南人","evidence":["huangli-q-4639de401721810ce6f4"]},{"id":"huangli-a-bab60bf8428c500b5743","label":"正文","text":"诸葛亮南征","evidence":["huangli-q-719f26aa2be89e5fdfc4"]},{"id":"huangli-a-50aacb7fbbc358afda51","label":"正文","text":"雍闿为高定部曲所杀","evidence":["huangli-q-8607804c6bf08d8f9001"]},{"id":"huowang-a-67657a9f3df20234f4e9","label":"正文","text":"向朗留统后事","evidence":["huowang-q-8f424ee850969da203c7"]},{"id":"huowang-a-490314c99ac4e6f8e34b","label":"正文","text":"费诗随亮南行","evidence":["huowang-q-9418f38e1a330c9a23fd"]},{"id":"dengzhang-a-cb17314a87967fd237ca","label":"正文","text":"亮南征留李邵为治中","evidence":["dengzhang-q-d5dbd61162ffdc44a5c9"]},{"id":"dengzhang-a-b5d5860a45d4a1b4cacc","label":"正文","text":"龚禄南征遇害","evidence":["dengzhang-q-b6ceaebbb6880816a85d"]},{"id":"dengzhang-a-dc5c9d9bf11fae034aa4","label":"正文","text":"王士南行遇害","evidence":["dengzhang-q-473b0c9081b5da467bd8"]}],"participants":[{"person":"zhuge-liang","role":"征讨","evidence":["zhuge-e-o023a-q"]},{"person":"zhuge-p0026","role":"被赦以服南方者","evidence":["dongliu-q-eb0b210fd16e9b4d714b"]},{"person":"huangli-p0016","role":"案道向建宁，诸县纠合围其军于昆（明）〔泽〕；众少敌倍，绐谓南人官军粮尽欲规退还，欲同计谋；出击大破之，追奔逐北，南至盘江，东接牂牁，与亮声势相连","evidence":["huangli-q-e3ccf28eaf60b6787884","huangli-q-b5114bce442112fd9e76","huangli-q-4639de401721810ce6f4"]},{"person":"mingdi-p0069","role":"其部曲杀雍闿","evidence":["huangli-q-8607804c6bf08d8f9001"]},{"person":"houzhu-p0022","role":"为高定部曲所杀","evidence":["huangli-q-8607804c6bf08d8f9001"]},{"person":"liuliao-p0019","role":"留统后事","evidence":["huowang-q-8f424ee850969da203c7"]},{"person":"huowang-p0030","role":"随诸葛亮南行，归至汉阳县","evidence":["huowang-q-9418f38e1a330c9a23fd"]},{"person":"shu8-p-lishao-yongnan","role":"受留为治中从事","evidence":["dengzhang-q-d5dbd61162ffdc44a5c9"]},{"person":"huangli-p0039","role":"随丞相亮南征，为蛮夷所害，时年三十一","evidence":["dengzhang-q-b6ceaebbb6880816a85d"]},{"person":"dengzhang-p0043","role":"会丞相亮南征转为益州太守，将南行，为蛮夷所害","evidence":["dengzhang-q-473b0c9081b5da467bd8"]}],"place":null,"time":{"year":225,"label":"建兴三年春至秋","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"zhuge-y225","dating_review":{"reviewed":true,"anchor":"zhuge-q-o023","basis":"建兴三年春至秋"},"evidence":["zhuge-e-o023a-q","zhuge-q-o023","zhuge-q-b-28bd067e0a3e898385bc"]},"ordering_evidence":"zhuge-e-o023a-q","source_order":[35,134,"O023a"],"order":6782},{"id":"huangli-e-o146","title":"叟夷反杀龚禄焦璜","accounts":[{"id":"huangli-a-e90e849abe1c35739ec7","label":"正文","text":"叟夷反杀龚禄焦璜","evidence":["huangli-q-4aa9858ac36de319395f","huangli-q2-6914ffe659a9ed87ba0b"]}],"participants":[{"person":"huangli-p0039","role":"太守，被叟夷所杀","evidence":["huangli-q-4aa9858ac36de319395f"]},{"person":"huangli-p0022","role":"太守，被叟夷所杀","evidence":["huangli-q-4aa9858a