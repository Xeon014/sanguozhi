8b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b2f83c142b53ed7a6593","start":11,"end":20,"offset_unit":"unicode_code_point"},{"id":"dongliu-q-eb0b210fd16e9b4d714b","section":"chapter-039","block":"b-4f59a98859b4f475164b","layer":"pei","quote":"亮纳其策，赦孟获以服南方","attribution":"裴注·襄阳记","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":110,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b2f83c142b53ed7a6593","start":163,"end":175,"offset_unit":"unicode_code_point"},{"id":"houzhu-q-O011","section":"chapter-033","block":"b-354a0a35bf9887aa11d1","layer":"original","quote":"三年春三月，丞相亮南征四郡〖2〗，四郡皆平。改益州郡为建宁郡；分建宁、永昌郡为云南郡〖3〗；又分建宁、牂牁为兴古郡〖4〗。","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":35,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":61,"offset_unit":"unicode_code_point"},{"id":"houzhu-q-O012","section":"chapter-033","block":"b-3529bcb2e8097984bcb5","layer":"original","quote":"十二月，亮还成都。","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":36,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":9,"offset_unit":"unicode_code_point"},{"id":"huangli-q-4639de401721810ce6f4","section":"chapter-043","block":"b-e11f9e586959d73e2f0d","layer":"original","quote":"于是恢出击，大破之；追奔逐北，南至盘江〖19〗，东接牂牁，与亮声势相连","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":59,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":170,"end":205,"offset_unit":"unicode_code_point"},{"id":"huangli-q-4aa9858ac36de319395f","section":"chapter-043","block":"b-74ba52c6bd47eaeb5dd6","layer":"original","quote":"初，越嶲郡自丞相亮讨高定之后，叟夷数反，杀太守龚禄、焦璜","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":218,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":28,"offset_unit":"unicode_code_point"},{"id":"huangli-q-6468462c5c9ba31b69b4","section":"chapter-043","block":"b-e11f9e586959d73e2f0d","layer":"original","quote":"丞相亮南征，先由越嶲","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":59,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":32,"end":42,"offset_unit":"unicode_code_point"},{"id":"huangli-q-719f26aa2be89e5fdfc4","section":"chapter-043","block":"b-1f594d574238f76d3965","layer":"original","quote":"及丞相亮南征讨阉，既发在道","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":93,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":18,"end":31,"offset_unit":"unicode_code_point"},{"id":"huangli-q-8607804c6bf08d8f9001","section":"chapter-043","block":"b-1f594d574238f76d3965","layer":"original","quote":"而闿已为高定部曲所杀","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":93,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":32,"end":42,"offset_unit":"unicode_code_point"},{"id":"huangli-q-b5114bce442112fd9e76","section":"chapter-043","block":"b-e11f9e586959d73e2f0d","layer":"original","quote":"时恢众少敌倍，又未得亮声息，绐谓南人曰〖15〗：“官军粮尽，欲规退还〖16〗；吾中间久斥乡里〖17〗，乃今得旋〖18〗，不能复北；欲还与汝等同计谋，故以诚相告。”南人信之，故围守怠缓","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":59,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":78,"end":169,"offset_unit":"unicode_code_point"},{"id":"huangli-q-e3ccf28eaf60b6787884","section":"chapter-043","block":"b-e11f9e586959d73e2f0d","layer":"original","quote":"而恢案道向建宁〖13〗，诸县大相纠合，围恢军于昆（明）〔泽〕","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":59,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":43,"end":73,"offset_unit":"unicode_code_point"},{"id":"huangli-q-faeecbea0e29d618941a","section":"chapter-043","block":"b-50c976d911cb3286a22c","layer":"original","quote":"又（斯都）〔邛都〕耆帅李求承〖8〗，昔手杀龚禄；嶷求募捕得，数其宿恶而诛之","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":219,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":108,"end":145,"offset_unit":"unicode_code_point"},{"id":"huangli-q2-6914ffe659a9ed87ba0b","section":"chapter-043","block":"b-74ba52c6bd47eaeb5dd6","layer":"original","quote":"初，越嶲郡自丞相亮讨高定之后，叟夷数反，杀太守龚禄、焦璜。是后太守不敢之郡，只住安（定）〔上〕县〖1〗；去郡八百余里〖2〗，其郡徒有名而已。时论欲复旧郡，除嶷为越嶲太守。嶷将所领往之郡，诱以恩信，蛮夷皆服，颇来降附。北徼捉马最骁劲〖3〗，不承节度；嶷乃往讨，生缚其帅魏狼；又解纵告喻〖4〗，使招怀余类。表拜狼为邑侯，种落三千余户皆安土供职；诸种闻之〖5〗，多渐降服，嶷以功赐爵关内侯。","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":218,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":192,"offset_unit":"unicode_code_point"},{"id":"huangli-q2-a057f1c163ad78d1eeac","section":"chapter-043","block":"b-50c976d911cb3286a22c","layer":"original","quote":"苏祁邑君冬逢、逢弟隗渠等〖6〗，已降复反。嶷诛逢。逢妻，旄牛王女〖7〗，嶷以计原之。而渠逃入西徼，渠刚猛捷悍，为诸种深所畏惮；遣所亲二人诈降嶷，实取消息。嶷觉之，许以重赏，使为反间；二人遂合谋，杀渠。渠死，诸种皆安。又（斯都）〔邛都〕耆帅李求承〖8〗，昔手杀龚禄；嶷求募捕得，数其宿恶而诛之。始，嶷以郡郛宇颓坏〖9〗，更筑小坞。在官三年，徙还故郡〖10〗；缮治城郭，夷种男女莫不致力。","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":219,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":192,"offset_unit":"unicode_code_point"},{"id":"huangli-q2-ff98f81028902f029e75","section":"chapter-043","block":"b-50c976d911cb3286a22c","layer":"original","quote":"又（斯都）〔邛都〕耆帅李求承〖8〗，昔手杀龚禄；嶷求募捕得，数其宿恶而诛之。","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":219,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":108,"end":146,"offset_unit":"unicode_code_point"},{"id":"huowang-q-8f424ee850969da203c7","section":"chapter-041","block":"b-5008b9b7cd23cd6b1641","layer":"original","quote":"丞相亮南征，朗留统后事","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":38,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":20,"end":31,"offset_unit":"unicode_code_point"},{"id":"huowang-q-9418f38e1a330c9a23fd","section":"chapter-041","block":"b-0331bba35be1e9a1beba","layer":"original","quote":"建兴三年，随诸葛亮南行，归至汉阳县","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":172,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":17,"offset_unit":"unicode_code_point"},{"id":"liuermu-q-74c22b7e2a9d68bbb6e6","section":"chapter-031","block":"b-2a7eb34fd683676ae1b4","layer":"original","quote":"丞相诸葛亮平南土","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":75,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":41,"end":49,"offset_unit":"unicode_code_point"},{"id":"zhuge-e-o023a-q","section":"chapter-035","block":"b-862592827af5abe9feb3","layer":"original","quote":"三年春〖10〗，亮率众南征〖11〗。﹝三﹞其秋，悉平：军资所出〖12〗，国以富饶；﹝四﹞乃治戎讲武，以俟大举。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":133,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":55,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-b-28bd067e0a3e898385bc","section":"chapter-035","block":"b-28bd067e0a3e898385bc","layer":"modern","quote":"〖10〗三年：建兴三年（公元 225）。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":144,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-d52302c7e46aff00f085","start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-o023","section":"chapter-035","block":"b-862592827af5abe9feb3","layer":"original","quote":"三年春〖10〗，亮率众南征〖11〗。﹝三﹞其秋，悉平：军资所出〖12〗，国以富饶；﹝四﹞乃治戎讲武，以俟大举。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":133,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":55,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
