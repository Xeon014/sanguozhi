3b31c7ed1578"],"chronology":"wudi-y198","dating_review":{"anchor":"wudi-q-o054","basis":"建安三年（围攻月余后）","reviewed":true}},"source_order":[1,339,"O058b"],"order":150},{"id":"lvzang-e-o110","title":"客驱侯成马欲归备成自将骑逐悉得马还","accounts":[{"id":"lvzang-a-8701387c76dc04ae7b6f","label":"裴注·九州春秋","text":"客驱侯成马欲归备成自将骑逐悉得马还","evidence":["lvzang-q-c4e2367a1196becc5206"]}],"participants":[{"person":"lvzang-p0001","role":"布骑将、遣客牧马十五匹、自将骑逐之悉得马还","evidence":["lvzang-q-c4e2367a1196becc5206"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["lvzang-q-c4e2367a1196becc5206"]},"ordering_evidence":"lvzang-q-c4e2367a1196becc5206","source_order":[7,123,12],"order":1849},{"id":"lvzang-e-o111","title":"成酿酒猎猪诣布贺布怒斥成惧弃酒自疑","accounts":[{"id":"lvzang-a-111af0b8692b24f4d116","label":"裴注·九州春秋","text":"成酿酒猎猪诣布贺布怒斥成惧弃酒自疑","evidence":["lvzang-q-50532563824de770f3c0"]}],"participants":[{"person":"lvzang-p0001","role":"酿五六斛酒猎得十余头猪、未饮食先持半猪五斗酒自入诣布前跪言间蒙将军恩逐得所失马诸将来相贺自酿少酒猎得猪未敢饮食先奉上微意、大惧而去弃所酿酒还诸将礼、由是自疑","evidence":["lvzang-q-50532563824de770f3c0"]},{"person":"wudi-p0088","role":"大怒曰布禁酒卿酿酒诸将共饮食作兄弟共谋杀布邪","evidence":["lvzang-q-50532563824de770f3c0"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["lvzang-q-50532563824de770f3c0"]},"ordering_evidence":"lvzang-q-50532563824de770f3c0","source_order":[7,123,54],"order":1850}],"persons":[{"id":"lvzang-p0001","name":"侯成","evidence":["lvzang-q-c2847a531d2132afe2d2","lvzang-q-c4e2367a1196becc5206","lvzang-q-50532563824de770f3c0","lvzang-q-041ab5ab00c4a4c06c3e"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[{"id":"lvzang-q-041ab5ab00c4a4c06c3e","section":"chapter-007","block":"b-3641f77987147c318cae","layer":"pei","quote":"会太祖围下邳，成遂领众降","attribution":"裴注·九州春秋","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":122,"anchor":null},"note_id":"n-8e2c5f07165c04d36c9a","start":187,"end":199},{"id":"lvzang-q-1d5c9a6c11cb5bec3896","section":"chapter-007","block":"b-66d8ed1a8c5b129739ae","layer":"original","quote":"刘备进曰：“明公不见布之事丁建阳及董太师乎〖8〗！”太祖颔之〖9〗。布因指备曰：“是儿最叵信者〖10〗！”﹝五﹞于是缢杀布〖11〗。布与宫、顺等皆枭首送许，然后葬之","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":99,"anchor":null},"note_id":null,"start":0,"end":82},{"id":"lvzang-q-50532563824de770f3c0","section":"chapter-007","block":"b-3641f77987147c318cae","layer":"pei","quote":"诸将合礼贺成，成酿五六斛酒，猎得十余头猪；未饮食，先持半猪、五斗酒自入诣布前，跪言：‘间蒙将军恩，逐得所失马，诸将来相贺；自酿少酒，猎得猪，未敢饮食，先奉上微意。’布大怒曰：‘布禁酒，卿酿酒；诸将共饮食作兄弟，共谋杀布邪！’成大惧而去，弃所酿酒，还诸将礼。由是自疑","attribution":"裴注·九州春秋","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":122,"anchor":null},"note_id":"n-8e2c5f07165c04d36c9a","start":54,"end":186},{"id":"lvzang-q-75cbe570c70c5329d02f","section":"chapter-007","block":"b-89207ecfdd74ae282a34","layer":"original","quote":"布与其麾下登白门楼〖4〗，兵围急，乃下降，遂生缚布","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":98,"anchor":null},"note_id":null,"start":39,"end":64},{"id":"lvzang-q-c2847a531d2132afe2d2","section":"chapter-007","block":"b-89207ecfdd74ae282a34","layer":"original","quote":"太祖堑围之三月〖3〗，上下离心。其将侯成、宋宪、魏续，缚陈宫，将其众降","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":98,"anchor":null},"note_id":null,"start":0,"end":35},{"id":"lvzang-q-c4e2367a1196becc5206","section":"chapter-007","block":"b-3641f77987147c318cae","layer":"pei","quote":"初，布骑将侯成遣客牧马十五匹；客悉驱马去，向沛城，欲归刘备。成自将骑逐之，悉得马还","attribution":"裴注·九州春秋","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":122,"anchor":null},"note_id":"n-8e2c5f07165c04d36c9a","start":12,"end":53},{"id":"wudi-e-o058b-q","section":"chapter-001","block":"b-1e667d99069ce89fe4e0","layer":"original","quote":"攻之不下。时公连战，士卒疲，欲还；用荀攸、郭嘉计〖5〗，遂决泗、沂水以灌城〖6〗。月余，布将宋宪、魏续等执陈宫，举城降。生擒布、宫，皆杀之。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":338,"anchor":null},"note_id":null,"start":83,"end":153},{"id":"wudi-q-b-4269a9733b31c7ed1578","section":"chapter-001","block":"b-4269a9733b31c7ed1578","layer":"modern","quote":"〖1〗三年：建安三年（公元 198）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":327,"anchor":null},"note_id":"n-1273453201e8129c485c","start":0,"end":19},{"id":"wudi-q-o054","section":"chapter-001","block":"b-ec1ae0750950ac5532fb","layer":"original","quote":"三年春正月〖1〗，公还许。初置军师祭酒〖2〗。三月，公围张绣于穰。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":323,"anchor":null},"note_id":null,"start":0,"end":33},{"id":"yuanzhang-q-6bf1b1254f8ab107a819","section":"chapter-011","block":"b-e051f0c32d3c8e964731","layer":"original","quote":"布诛，涣得归太祖","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":21,"anchor":null},"note_id":null,"start":0,"end":8}],"profiles":{},"directory_counts":{}}
