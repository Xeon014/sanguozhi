6.xhtml","index":142,"anchor":null},"note_id":null,"start":0,"end":144},{"id":"wuhuan-q-6cba70ccf9b6f50f2a9f","section":"chapter-030","block":"b-e6e49a573d831a14d039","layer":"original","quote":"麻余死，其子依虑年六岁，立以为王","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":143,"anchor":null},"note_id":null,"start":110,"end":126},{"id":"wuhuan-q-9703c61acd1b63775777","section":"chapter-030","block":"b-913e4b4dc1858efb4f54","layer":"original","quote":"位居死，诸加共立麻余","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":142,"anchor":null},"note_id":null,"start":101,"end":111}],"profiles":{},"directory_counts":{}}
