{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o176b","title":"曹军夜袭破阳平","accounts":[{"id":"wudi-e-o176b-account","label":"正文","text":"守军因曹军退却而解备，曹操遣军夜袭，大破敌军斩杨任，张卫夜遁，张鲁奔巴中。","evidence":["wudi-e-o176b-q"]},{"id":"xianzhu-e-o045a-account","label":"《先主传》正文","text":"刘备闻曹操平汉中、张鲁走巴西。","evidence":["xianzhu-e-o045a-q"]},{"id":"gongsuntao-a-57f65101b824182cc18b","label":"正文","text":"鲁欲降弟卫不肯率众拒关坚守太祖攻破之","evidence":["gongsuntao-q-6bab1ba78435eeef70cc"]},{"id":"gongsuntao-a-8534c138c46cb90670ab","label":"正文","text":"鲁闻阳平陷圃劝依杜濩朴胡奔南山入巴中","evidence":["gongsuntao-q-bb09dcc2706efd4bbfa0"]},{"id":"gongsuntao-a-eb4b99ce42320de9875e","label":"裴注·魏名臣奏","text":"董昭表言武帝征鲁阳平之险幸而克","evidence":["gongsuntao-q-b3d5c19d61f972ae0ce9"]},{"id":"gongsuntao-a-f4ff8b89230da169b39e","label":"裴注·魏名臣奏","text":"杨暨表言征鲁对兵三日欲还鲁守自坏","evidence":["gongsuntao-q-7fc2c40720129e9ed48e"]},{"id":"gongsuntao-a-7b78046bf6dc265d243a","label":"裴注·世语","text":"野麋突坏卫营高祚等夜会众卫惧遂降","evidence":["gongsuntao-q-2aea4a3865cb2c2daf3c"]}],"participants":[{"person":"cao-cao","role":"遣兵夜袭","evidence":["wudi-e-o176b-q"]},{"person":"wudi-p0346","role":"夜袭","evidence":["wudi-e-o176b-q"]},{"person":"wudi-p0347","role":"被斩","evidence":["wudi-e-o176b-q"]},{"person":"wudi-p0344","role":"逃走","evidence":["wudi-e-o176b-q"]},{"person":"wudi-p0279","role":"出奔","evidence":["wudi-e-o176b-q"]},{"person":"guanzhang-p0036","role":"又曰今以迫往功必轻不如依杜濩赴朴胡相拒然后委质功必多","evidence":["gongsuntao-q-bb09dcc2706efd4bbfa0"]},{"person":"wudi-p0349","role":"被劝所依者","evidence":["gongsuntao-q-bb09dcc2706efd4bbfa0"]},{"person":"wudi-p0348","role":"被劝所赴者","evidence":["gongsuntao-q-bb09dcc2706efd4bbfa0"]},{"person":"wudi-p0122","role":"表曰武皇帝承凉州从事及武都降人之辞说张鲁易攻信以为然、及往临履不如所闻乃叹曰他人商度少如人意","evidence":["gongsuntao-q-b3d5c19d61f972ae0ce9"]},{"person":"wudi-p0027","role":"故大将军、受遣呼山上兵还、前自见乃还白武皇帝","evidence":["gongsuntao-q-b3d5c19d61f972ae0ce9"]},{"person":"shaodi-p0015","role":"将军、同受遣呼山上兵还","evidence":["gongsuntao-q-b3d5c19d61f972ae0ce9"]},{"person":"wudi-p0203","role":"侍中、在兵后语惇褚言官兵已据得贼要屯贼已散走","evidence":["gongsuntao-q-b3d5c19d61f972ae0ce9"]},{"person":"wendi-p0071","role":"侍中、同语惇褚","evidence":["gongsuntao-q-b3d5c19d61f972ae0ce9"]},{"person":"xiahoucao-p0055","role":"表曰武皇帝始征张鲁以十万之众身亲临履指授方略因就民麦以为军粮","evidence":["gongsuntao-q-7fc2c40720129e9ed48e"]}],"place":{"text":"阳平、巴中","evidence":["wudi-e-o176b-q"]},"time":{"label":"建安二十年秋七月","year":215,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o176b-q","wudi-q-o173","wudi-q-b-e0a96bdd9353a663e5ab"],"chronology":"wudi-y215","dating_review":{"anchor":"wudi-q-o173","basis":"建安二十年秋七月","reviewed":true}},"source_order":[1,998,"O176b"],"order":374},{"id":"wudi-e-o179a","title":"张鲁降曹受封","accounts":[{"id":"wudi-e-o179a-account","label":"正文","text":"张鲁从巴中率余众投降，自己和五子均封列侯。","evidence":["wudi-e-o179a-q"]},{"id":"gongsuntao-a-baae1eb09c83c6f9d7f3","label":"正文","text":"太祖入南郑遣人慰喻鲁尽将家出","evidence":["gongsuntao-q-a748d5ed3fc4c8e08232"]},{"id":"gongsuntao-a-f20c591259c37f9ccb4d","label":"正文","text":"太祖拜鲁镇南将军封阆中侯封五子阎圃列侯","evidence":["gongsuntao-q-d8e8c0d69a567878752b"]},{"id":"huangli-a-cb21a269f696a632ae6a","label":"正文","text":"张鲁还南郑降曹操","evidence":["huangli-q-aab5b971d3fd02621c88"]},{"id":"duzhou-a-9641bacfa398aacd8ef2","label":"裴注·续汉书","text":"曹操攻汉中张鲁降","evidence":["duzhou-q-ba03857b807d3fd5f419"]}],"participants":[{"person":"wudi-p0279","role":"归降受封","evidence":["wudi-e-o179a-q"]},{"person":"cao-cao","role":"受降封赏","evidence":["wudi-e-o179a-q"]},{"person":"guanzhang-p0036","role":"封列侯","evidence":["gongsuntao-q-d8e8c0d69a567878752b"]},{"person":"mingdi-p0055","role":"太祖子、取鲁女","evidence":["gongsuntao-q-d8e8c0d69a567878752b"]}],"place":{"text":"巴中","evidence":["wudi-e-o179a-q"]},"time":{"label":"建安二十年十一月","year":215,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o179a-q","wudi-q-o173","wudi-q-b-e0a96bdd9353a663e5ab"],"chronology":"wudi-y215","dating_review":{"anchor":"wudi-q-o173","basis":"建安二十年十一月","reviewed":true}},"source_order":[1,1001,"O179a"],"related_events":[{"event":"lizang-e2-wei018-074","type":"related","evidence":["lizang-q-5a93e70efcc761a6aa0a","wudi-e-o179a-q"]}],"order":380},{"id":"gongsuntao-e-o135","title":"群下欲尊鲁为汉宁王阎圃谏鲁从之","accounts":[{"id":"gongsuntao-a-b6b75a4db100c0cf64ee","label":"正文","text":"群下欲尊鲁为汉宁王阎圃谏鲁从之","evidence":["gongsuntao-q-1811d7f59b640d90a267"]}],"participants":[{"person":"guanzhang-p0036","role":"鲁功曹巴西人、谏鲁曰汉川之民户出十万财富土沃四面险固上匡天子则为桓文次及窦融不失富贵今承制署置势足斩断不烦于王愿且不称勿为祸先","evidence":["gongsuntao-q-1811d7f59b640d90a267"]},{"person":"wudi-p0279","role":"从之","evidence":["gongsuntao-q-1811d7f59b640d90a267"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["gongsuntao-q-1811d7f59b640d90a267"]},"ordering_evidence":"gongsuntao-q-1811d7f59b640d90a267","source_order":[8,287,37],"order":2089},{"id":"gongsuntao-e-o234","title":"黄初中增阎圃爵邑后十余岁病死","accounts":[{"id":"gongsuntao-a-a8b0b631d8f987d2d035","label":"裴注·魏略","text":"黄初中增阎圃爵邑后十余岁病死","evidence":["gongsuntao-q-9eead545fa4485bc7379"]}],"participants":[{"person":"guanzhang-p0036","role":"增爵邑、在礼请中、后十余岁病死","evidence":["gongsuntao-q-9eead545fa4485bc7379"]}],"place":null,"time":{"label":"黄初中增爵邑；后十余岁病死（原文相对时间）","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["gongsuntao-q-9eead545fa4485bc7379"]},"ordering_evidence":"gongsuntao-q-9eead545fa4485bc7379","source_order":[8,313,7],"order":2096},{"id":"guanzhang-e-p022a","title":"曹操得马超妻董氏赐阎圃马秋付张鲁后被杀","accounts":[{"id":"guanzhang-e-p022a-account","label":"《典略》","text":"曹操得马超妻董氏赐阎圃马秋付张鲁后被杀","evidence":["guanzhang-e-p022a-q"]}],"participants":[{"person":"cao-cao","role":"处置","evidence":["guanzhang-e-p022a-q"]},{"person":"guanzhang-p0035","role":"被赐","evidence":["guanzhang-e-p022a-q"]},{"person":"guanzhang-p0036","role":"受赐","evidence":["guanzhang-e-p022a-q"]},{"person":"guanzhang-p0037","role":"被杀","evidence":["guanzhang-e-p022a-q"]},{"person":"wudi-p0279","role":"杀人","evidence":["guanzhang-e-p022a-q"]}],"place":null,"time":{"label":"张鲁败后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["guanzhang-e-p022a-q"]},"ordering_evidence":"guanzhang-e-p022a-q","source_order":[36,167,"P022a"],"order":6917}],"persons":[{"id":"guanzhang-p0036","name":"阎圃","evidence":["guanzhang-q-p022","gongsuntao-q-1811d7f59b640d90a267","gongsuntao-q-bb09dcc2706efd4bbfa0","gongsuntao-q-d8e8c0d69a567878752b","gongsuntao-q-58a8019eefc4b9367800","gongsuntao-q-9eead545fa4485bc7379"],"facts":[],"aliases":[],"mentions":[{"id":"guanzhang-m-p022-guanzhang-p0036","kind":"mention","text":"文中提及","evidence":["guanzhang-q-p022"]},{"id":"gongsuntao-m-review-19f327b7dd0f22db4845","kind":"mention","text":"阎圃见于相关言论或记载。","evidence":["gongsuntao-q-58a8019eefc4b9367800"]}]}],"evidence":[{"id":"duzhou-q-ba03857b807d3fd5f419","section":"chapter-042","block":"b-36a191e5867b8439da0f","layer":"pei","quote":"二十年秋，曹公攻汉中，张鲁降","attribution":"裴注·续汉书","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":61,"anchor":null},"note_id":"n-5414957d5a2b7c78d997","start":200,"end":214},{"id":"gongsuntao-q-1811d7f59b640d90a267","section":"chapter-008","block":"b-aa2dbfd6fdb698fdd70b","layer":"original","quote":"民有地中得玉印者，群下欲尊鲁为汉宁王。鲁功曹巴西阎圃谏鲁曰：“汉川之民，户出十万〖3〗；财富土沃，四面险固；上匡天子，则为桓、文〖4〗；次及窦融，不失富贵。今承制署置〖5〗，势足斩断〖6〗，不烦于王。愿且不称〖7〗，勿为祸先！”鲁从之","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":286,"anchor":null},"note_id":null,"start":37,"end":154},{"id":"gongsuntao-q-2aea4a3865cb2c2daf3c","section":"chapter-008","block":"b-4d77a48001960371679e","layer":"pei","quote":"夜有野麋数千突坏卫营，军大惊。夜，高祚等误与卫众遇，祚等多鸣鼓角会众。卫惧，以为大军见掩，遂降","attribution":"裴注·世语","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":309,"anchor":null},"note_id":"n-0c873df6029964ad38a0","start":99,"end":146},{"id":"gongsuntao-q-58a8019eefc4b9367800","section":"chapter-008","block":"b-c9c994588a40222c87ac","layer":"pei","quote":"习凿齿曰：“鲁欲称王，而阎圃谏止之，今封圃为列侯。夫赏罚者，所以惩恶劝善也；苟其可以明轨训于物，无远近幽深矣。今阎圃谏鲁勿王，而太祖追封之，将来之人，孰不思顺？塞其本源而末流自止，其此之谓与！若乃不明于此而重焦烂之功，丰爵厚赏止于死战之士；则民利于有乱，俗竞于杀伐，阻兵仗力，干戈不戢矣。太祖之此封，可谓知赏罚之本；虽汤武居之，无以加也","attribution":"裴注·习凿齿","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":311,"anchor":null},"note_id":"n-806df2bc8ac18c089fbe","start":0,"end":168},{"id":"gongsuntao-q-6bab1ba78435eeef70cc","section":"chapter-008","block":"b-6a1c95ed57c00b446116","layer":"original","quote":"鲁欲举汉中降；其弟卫不肯，率众数万人拒关坚守","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":287,"anchor":null},"note_id":null,"start":27,"end":49},{"id":"gongsuntao-q-7fc2c40720129e9ed48e","section":"chapter-008","block":"b-1954f1577f0c58b22fca","layer":"pei","quote":"又杨暨表曰：“武皇帝始征张鲁，以十万之众，身亲临履，指授方略，因就民麦以为军粮。张卫之守，盖不足言，地险守易；虽有精兵虎将，势不能施。对兵三日，欲抽军还，言：‘作军三十年，一朝持与人，如何？’此计已定，天祚大魏，鲁守自坏，因以定之","attribution":"裴注·魏名臣奏","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":308,"anchor":null},"note_id":"n-0c873df6029964ad38a0","start":0,"end":115},{"id":"gongsuntao-q-9eead545fa4485bc7379","section":"chapter-008","block":"b-96742efe5ec1a8e24d9d","layer":"pei","quote":"黄初中，增圃爵邑；在礼请中。后十余岁，病死","attribution":"裴注·魏略","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":312,"anchor":null},"note_id":"n-806df2bc8ac18c089fbe","start":7,"end":28},{"id":"gongsuntao-q-a748d5ed3fc4c8e08232","section":"chapter-008","block":"b-4831d32026f556a8070c","layer":"original","quote":"太祖入南郑，甚嘉之；又以鲁本有善意，遣人慰喻。鲁尽将家出","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":288,"anchor":null},"note_id":null,"start":0,"end":28},{"id":"gongsuntao-q-b3d5c19d61f972ae0ce9","section":"chapter-008","block":"b-9ba8257c047e00b51042","layer":"pei","quote":"武皇帝，承凉州从事及武都降人之辞，说‘张鲁易攻，阳平城下南北山相远，不可守也’，信以为然。及往临履，不如所闻，乃叹曰：‘他人商度，少如人意！’攻阳平山上诸屯，既不时拔，士卒伤夷者多。武皇帝意沮，便欲拔军，截山而还。遣故大将军夏侯惇、将军许褚，呼山上兵还。会前军未还，夜迷惑；误入贼营，贼便退散。侍中辛毗、刘晔等在兵后，语惇、褚，言：‘官兵已据得贼要屯，贼已散走。’犹不信之，惇前自见，乃还白武皇帝。进兵定之，幸而克获。此近事，吏士所知","attribution":"裴注·魏名臣奏","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":307,"anchor":null},"note_id":"n-0c873df6029964ad38a0","start":16,"end":233},{"id":"gongsuntao-q-bb09dcc2706efd4bbfa0","section":"chapter-008","block":"b-6a1c95ed57c00b446116","layer":"original","quote":"鲁闻阳平已陷，将稽颡〖10〗。圃又曰：“今以迫往〖11〗，功必轻；不如依杜（灌）〔濩〕赴朴胡相拒，然后委质〖12〗，功必多。”于是乃奔南山入巴中","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":287,"anchor":null},"note_id":null,"start":63,"end":135},{"id":"gongsuntao-q-d8e8c0d69a567878752b","section":"chapter-008","block":"b-4831d32026f556a8070c","layer":"original","quote":"太祖逆拜鲁镇南将军〖14〗，待以客礼，封阆中侯，邑万户。封鲁五子及阎圃等，皆为列侯","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":288,"anchor":null},"note_id":null,"start":29,"end":70},{"id":"guanzhang-e-p022a-q","section":"chapter-036","block":"b-3686474f1797efd1bec6","layer":"pei","quote":"﹝二﹞《典略》曰：“初，超之入蜀，其庶妻董及子秋，留依张鲁。鲁败，曹公得之，以董赐阎圃，以秋付鲁；鲁自手杀之。”","attribution":"《典略》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":166,"anchor":null},"note_id":"n-743e6f43ad2189fb0639","start":0,"end":56},{"id":"guanzhang-q-p022","section":"chapter-036","block":"b-3686474f1797efd1bec6","layer":"pei","quote":"﹝二﹞《典略》曰：“初，超之入蜀，其庶妻董及子秋，留依张鲁。鲁败，曹公得之，以董赐阎圃，以秋付鲁；鲁自手杀之。”","attribution":"《典略》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":166,"anchor":null},"note_id":"n-743e6f43ad2189fb0639","start":0,"end":56},{"id":"huangli-q-aab5b971d3fd02621c88","section":"chapter-043","block":"b-b937b741ffd9fc15238b","layer":"original","quote":"鲁已还南郑，北降曹公","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":10,"anchor":null},"note_id":null,"start":69,"end":79},{"id":"lizang-q-5a93e70efcc761a6aa0a","section":"chapter-018","block":"b-600ec9e048958a94c35d","layer":"original","quote":"太祖定汉中，德随众降","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":202,"anchor":null},"note_id":null,"start":0,"end":10},{"id":"wudi-e-o176b-q","section":"chapter-001","block":"b-889ba56c5491dd0a8600","layer":"original","quote":"贼见大军退，其守备解散。公乃密遣解(、高祚等乘险夜袭。大破之，斩其将杨任。进攻卫，卫等夜遁；鲁溃，奔巴中〖11〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":322,"anchor":null},"note_id":null,"start":47,"end":104},{"id":"wudi-e-o179a-q","section":"chapter-001","block":"b-5b628cceb1d057936ae4","layer":"original","quote":"十一月，鲁自巴中将其余众降。封鲁及五子皆为列侯。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":325,"anchor":null},"note_id":null,"start":0,"end":24},{"id":"wudi-q-b-e0a96bdd9353a663e5ab","section":"chapter-001","block":"b-e0a96bdd9353a663e5ab","layer":"modern","quote":"〖1〗二十年：建安二十年（公元 215 ）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":328,"anchor":null},"note_id":"n-3bb2f11071aab1690790","start":0,"end":22},{"id":"wudi-q-o173","section":"chapter-001","block":"b-fc2c779b81f1c3c13b40","layer":"original","quote":"二十年春正月〖1〗，天子立公中女为皇后〖2〗。省云中、定襄、五原、朔方郡〖3〗，郡置一县领其民；合以为新兴郡〖4〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":319,"anchor":null},"note_id":null,"start":0,"end":58},{"id":"xianzhu-e-o045a-q","section":"chapter-032","block":"b-1f07331b166b6f2880a1","layer":"original","quote":"是岁，曹公定汉中，张鲁遁走巴西。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":200,"anchor":null},"note_id":null,"start":0,"end":16}],"profiles":{},"directory_counts":{}}
