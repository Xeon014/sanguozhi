["santizhu-q-87d9b98109f974bb2a40"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["santizhu-q-87d9b98109f974bb2a40"]},"ordering_evidence":"santizhu-q-87d9b98109f974bb2a40","source_order":[48,36,97],"order":8785},{"id":"santizhu-e-p036e","title":"毛炅被缚受诘后遭剖腹割心并被斩","accounts":[{"id":"santizhu-a-5ab92626cb4f8b26e83a","label":"裴注·华阳国志","text":"毛炅被缚受诘后遭剖腹割心并被斩","evidence":["santizhu-q-a1b40436dd013fe2c56c"]}],"participants":[{"person":"santizhu-p0083","role":"参与诘问毛炅；原文未逐名说明施刑者","evidence":["santizhu-q-a1b40436dd013fe2c56c"]},{"person":"santizhu-p0078","role":"受诘并持续斥骂；最终被斩","evidence":["santizhu-q-a1b40436dd013fe2c56c"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["santizhu-q-a1b40436dd013fe2c56c"]},"ordering_evidence":"santizhu-q-a1b40436dd013fe2c56c","source_order":[48,36,127],"order":8786},{"id":"santizhu-e-p035a","title":"晋武帝诏毛炅长子袭爵封其余三子","accounts":[{"id":"santizhu-a-471d05e25d713713a148","label":"裴注·华阳国志","text":"晋武帝诏毛炅长子袭爵封其余三子","evidence":["santizhu-q-75e519404c14dabe197f"]}],"participants":[{"person":"shaodi-p0136","role":"下诏令毛炅长子袭爵并封其余三子为关内侯","evidence":["santizhu-q-75e519404c14dabe197f"]},{"person":"santizhu-p0078","role":"被追恤；其子受封","evidence":["santizhu-q-75e519404c14dabe197f"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["santizhu-q-75e519404c14dabe197f"]},"ordering_evidence":"santizhu-q-75e519404c14dabe197f","source_order":[48,35,214],"order":8787}],"persons":[{"id":"santizhu-p0078","name":"毛炅","evidence":["santizhu-q-25480cd6aba35fce6776","santizhu-q-75e519404c14dabe197f","santizhu-q-63c44b5a12faf50acf8c","santizhu-q-d97ff62de6478c2215ca","santizhu-q-87d9b98109f974bb2a40","santizhu-q-a1b40436dd013fe2c56c","santizhu-q-76075b0a412a66a03ab9","santizhu-q-1020cd18ac28f932ea8c"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[{"id":"santizhu-q-1020cd18ac28f932ea8c","section":"chapter-048","block":"b-d7f8233ea732bc33e866","layer":"pei","quote":"稷等日未满而粮尽，乞降于璜；璜不许，而给粮使守。吴人并谏，璜曰：‘霍弋已死，无能来者；可须其粮尽，然后乃受；使彼来无罪，而我取有义。内训吾民，外怀邻国，不亦可乎！’稷、炅粮尽，救不至，乃纳之","attribution":"裴注·汉晋春秋","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":422,"anchor":null},"note_id":"n-f2b1c35672a6ca8714ea","start":63,"end":158},{"id":"santizhu-q-25480cd6aba35fce6776","section":"chapter-048","block":"b-6cccafc4638fb6a53864","layer":"original","quote":"为晋将毛炅等所破，皆死","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":381,"anchor":null},"note_id":null,"start":23,"end":34},{"id":"santizhu-q-63c44b5a12faf50acf8c","section":"chapter-048","block":"b-9a7cf4443f939e02dfaa","layer":"pei","quote":"稷等城中食尽，死亡者半。将军王约反，降，吴人得入城；获稷、炅，皆囚之","attribution":"裴注·华阳国志","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":423,"anchor":null},"note_id":"n-f2b1c35672a6ca8714ea","start":21,"end":55},{"id":"santizhu-q-75e519404c14dabe197f","section":"chapter-048","block":"b-9a7cf4443f939e02dfaa","layer":"pei","quote":"晋武帝闻而哀矜，即诏使炅长子袭爵，余三子皆关内侯","attribution":"裴注·华阳国志","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":423,"anchor":null},"note_id":"n-f2b1c35672a6ca8714ea","start":214,"end":238},{"id":"santizhu-q-76075b0a412a66a03ab9","section":"chapter-048","block":"b-d7f8233ea732bc33e866","layer":"pei","quote":"初，霍弋遣杨稷、毛炅等戍，与之誓曰：‘若贼围城，未百日而降者，家属诛；若过百日而城没者，刺史受其罪","attribution":"裴注·汉晋春秋","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":422,"anchor":null},"note_id":"n-f2b1c35672a6ca8714ea","start":12,"end":61},{"id":"santizhu-q-87d9b98109f974bb2a40","section":"chapter-048","block":"b-9a7cf4443f939e02dfaa","layer":"pei","quote":"陶璜等以炅壮勇，欲赦之。而则子允，固求杀炅；炅亦不为璜等屈。","attribution":"裴注·华阳国志","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":423,"anchor":null},"note_id":"n-f2b1c35672a6ca8714ea","start":97,"end":127},{"id":"santizhu-q-a1b40436dd013fe2c56c","section":"chapter-048","block":"b-9a7cf4443f939e02dfaa","layer":"pei","quote":"璜等怒，面缚炅，诘之，曰：‘晋（兵）贼！’炅厉声曰：‘吴狗！何等为贼？’吴人生剖其腹，允割其心肝，骂曰：‘庸复作贼？’炅犹骂不止，曰：‘尚欲斩汝孙皓，汝父何死狗也！’乃斩之","attribution":"裴注·华阳国志","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":423,"anchor":null},"note_id":"n-f2b1c35672a6ca8714ea","start":127,"end":213},{"id":"santizhu-q-d97ff62de6478c2215ca","section":"chapter-048","block":"b-9a7cf4443f939e02dfaa","layer":"pei","quote":"初，毛炅与吴军战，杀前部督修则。","attribution":"裴注·华阳国志","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":423,"anchor":null},"note_id":"n-f2b1c35672a6ca8714ea","start":81,"end":97}],"profiles":{},"directory_counts":{}}
