aliases":[],"facts":[],"mentions":[{"id":"wgc-m-o033-wgc-p0020","kind":"mention","text":"本段涉及吴纲","evidence":["wgc-q0026"]},{"id":"wgc-m-p031-wgc-p0020","kind":"mention","text":"本段涉及吴纲","evidence":["wgc-q0112"]}]}],"evidence":[{"id":"santizhu-q-419ecd2292ce4d287052","section":"chapter-048","block":"b-c67c55e25345c5fcaa53","layer":"original","quote":"又遣子靓、长史吴纲、诸牙门子弟，为质","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":94,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":129,"end":147,"offset_unit":"unicode_code_point"},{"id":"wgc-q0026","section":"chapter-028","block":"b-a7bfa7539b76de4cb092","layer":"original","quote":"二年五月〖5〗，征为司空。诞被诏书，愈恐，遂反。召会诸将，自出攻扬州刺史乐綝〖6〗，杀之。﹝一﹞敛淮南及淮北郡县、屯田口十余万官兵，扬州新附胜兵者四五万人〖7〗，聚谷足一年食，闭城自守。遣长史吴纲将小子靓，至吴请救。﹝二﹞","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":173,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":111,"offset_unit":"unicode_code_point"},{"id":"wgc-q0112","section":"chapter-028","block":"b-a91f937bee4efb666a6d","layer":"pei","quote":"﹝二﹞《世语》曰：“黄初末，吴人发长沙王吴芮冢，以其砖，于临湘为孙坚立庙。芮容貌如生，衣服不朽。后预发者见吴纲曰：‘君何类长沙王吴芮？但微短耳。’纲瞿然曰：‘是先祖也！君何由见之？’见者言所由，纲曰：‘更葬否？’答曰：‘即更葬矣。’自芮之卒年至冢发，四百余年；纲，芮之十六世孙矣。”","attribution":"世语","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":193,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b7a94f70c07c06cf3c16","start":0,"end":141,"offset_unit":"unicode_code_point"},{"id":"wgc-q0271","section":"chapter-028","block":"b-070f7f878b699e9dd8f2","layer":"modern","quote":"〖5〗二年：甘露二年（公元 257）。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":181,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-41029aa679c68595f342",