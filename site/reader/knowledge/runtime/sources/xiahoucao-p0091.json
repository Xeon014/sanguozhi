{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[],"persons":[{"id":"xiahoucao-p0091","name":"阎显","evidence":["xiahoucao-q-p043"],"facts":[],"aliases":[],"mentions":[{"id":"xiahoucao-m-p043-xiahoucao-p0091","kind":"allusion","text":"祖系或典故提及","evidence":["xiahoucao-q-p043"]}]}],"evidence":[{"id":"xiahoucao-q-p043","section":"chapter-009","block":"b-3d56ad29514a24dd284c","layer":"pei","quote":"《汉晋春秋》曰：“安定皇甫谧，以九年冬梦至洛阳，自庙出，见车骑甚众，以物呈庙云：‘诛大将军曹爽。’寤而以告其邑人，邑人曰：‘君欲作曹人之梦乎？朝无公孙强，如何？且爽兄弟典重兵，又权尚书事，谁敢谋之！’谧曰：‘爽无叔振铎之请，苟失天机，则离矣，何恃于强？昔汉之阎显，倚母后之尊，权国威命，可谓至重矣；阉人十九人，一旦尸之，况爽兄弟乎？’”","attribution":"《汉晋春秋》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":376,"anchor":null},"note_id":"n-45775d68baddd17aab59","start":0,"end":168}],"profiles":{},"directory_counts":{}}
