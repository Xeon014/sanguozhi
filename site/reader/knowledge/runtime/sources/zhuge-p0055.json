54-zhuge-p0055","kind":"mention","text":"文中提及","evidence":["zhuge-q-p054"]},{"id":"jfj-m-o050-zhuge-p0055","kind":"mention","text":"本段记载：廖化赴沓中张翼董厥赴阳安关口","evidence":["jfj-q0183"]},{"id":"jfj-m-o051-zhuge-p0055","kind":"mention","text":"本段记载：姜维廖化张翼董厥会合守剑阁","evidence":["jfj-q0186"]},{"id":"wgc-m-o103-zhuge-p0055","kind":"mention","text":"本段涉及董厥","evidence":["wgc-q0078"]}]}],"evidence":[{"id":"jfj-q0028","section":"chapter-044","block":"b-6e2f890762325a17fefa","layer":"original","quote":"六年〖1〗，维表后主：“闻钟会治兵关中，欲规进取；宜并遣张翼、廖化督诸军，分护阳安关口、阴平桥头，以防未然〖2〗。”皓征信鬼巫〖3〗，谓敌终不自致；启后主寝其事〖4〗，而群臣不知。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":228,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":90,"offset_unit":"unicode_code_point"},{"id":"jfj-q0029","section":"chapter-044","block":"b-244c42d136c1fc518809","layer":"modern","quote":"〖1〗六年：景耀六年（公元 263）。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":236,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-07b5919ab8c7edcb2376","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"jfj-q0182","section":"chapter-044","block":"b-8ae28042edaf54c8a788","layer":"original","quote":"及钟会将向骆谷，邓艾将入沓中；然后乃遣右车骑廖化诣沓中为维援〖5〗，左车骑张翼、辅国大将军董厥等诣阳安关口以为诸围外助","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":229,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":59,"offset_unit":"unicode_code_point"},{"id":"jfj-q0183","section":"chapter-044","block":"b-8ae28042edaf54c8a788","layer":"original","quote":"及钟会将向骆谷，邓艾将入沓中；然后乃遣右车骑廖化诣沓中为维援〖5〗，左车骑张翼、辅国大将军董厥等诣阳安关口以为诸围外助〖6〗。比至阴平，闻魏将诸葛绪向建威，故住待之。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":229,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":83,"offset_unit":"unicode_code_point"},{"id":"jfj-q0186","section":"chapter-044","block":"b-d4a8e1aeaa400cdee772","layer":"original","quote":"月余，维为邓艾所摧，还住阴平。钟会攻围汉、乐二城，遣别将进攻关口；蒋舒开城出降，傅佥格斗而死。﹝一﹞会攻乐城，不能克；闻关口已下〖7〗，长驱而前。翼、厥甫至汉寿，维、化亦舍阴平而退，适与翼、厥合：皆退保剑阁以拒会。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":230,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":107,"offset_unit":"unicode_code_point"},{"id":"jfj-q0191","section":"chapter-044","block":"b-d4a8e1aeaa400cdee772","layer":"original","quote":"翼、厥甫至汉寿，维、化亦舍阴平而退，适与翼、厥合：皆退保剑阁以拒会。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":230,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":73,"end":107,"offset_unit":"unicode_code_point"},{"id":"wgc-q0046","section":"chapter-028","block":"b-23e8850b8ee57e7e439c","layer":"original","quote":"四年秋，诏诸军征蜀，大将军司马文王皆指授节度。使艾与维相缀连〖2〗，雍州刺史诸葛绪邀维〖3〗：令不得归。艾遣天水太守王颀等直攻维营，陇西太守牵弘等邀其前，金城太守杨欣等诣甘松〖4〗。维闻钟会诸军已入汉中，引退还。欣等追蹑于强川口〖5〗，大战。维败走。闻雍州已塞道〖6〗，屯桥头〖7〗；从孔函谷入北道〖8〗，欲出雍州后。诸葛绪闻之，却还三十里〖9〗。维入北道三十余里，闻绪军却，寻还，从桥头过；绪趋截维，较一日不及〖10〗。维遂东引，还守剑阁〖11〗。钟会攻维未能克。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":322,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":233,"offset_unit":"unicode_code_point"},{"id":"wgc-q0072","section":"chapter-028","block":"b-78045a2622266a435eeb","layer":"original","quote":"蜀监军王含守乐城，护军蒋斌守汉城，兵各五千。会使护军荀恺、前将军李辅各统万人：恺围汉城，辅围乐城。会径过，西出阳安口〖7〗，遣人祭诸葛亮之墓〖8〗。使护军胡烈等行前，攻破关城〖9〗，得库藏积谷。姜维自沓中还，至阴平，合集士众，欲赴关城。未到，闻其已破，退趋白水，与蜀将张翼、廖化等合守剑阁拒会〖10〗。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":473,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":151,"offset_unit":"unicode_code_point"},{"id":"wgc-q0078","section":"chapter-028","block":"b-6a383cd03d18c26da31d","layer":"original","quote":"会上言曰：“贼姜维、张翼、廖化、董厥等〖7〗，逃死遁走，欲趋成都。臣辄遣司马夏侯咸、护军胡烈等，经从剑阁，出新都、大渡截其前〖8〗；参军爰g 、将军句安等蹑其后；参军皇甫闿、将军王买等从涪南出冲其腹；臣据涪县为东西势援。维等所统步骑四五万人，擐甲厉兵〖9〗，塞川填谷，数百里中首尾相继；凭恃其众，方轨而西。臣敕咸、闿等，令分兵据势，广张罗网；南杜走吴之道，西塞成都之路，北绝越逸之径；四面云集，首尾并进，蹊路断绝，走伏无地。臣又手书申喻，开示生路；群寇困逼，知命穷数尽；解甲投戈，面缚委质；印绶万数，资器山积。昔舜舞干戚，有苗自服；牧野之师〖10〗，商旅倒戈〖11〗。有征无战，帝王之盛业。‘全国为上，破国次之；全军为上，破军次之’：用兵之令典〖12〗。陛下圣德，侔踪前代；翼辅忠明〖13〗，齐轨公旦〖14〗；‘仁育群生，义征不h〖15〗’；殊俗向化，无思不服；师不逾时，兵不血刃；万里同风，九州共贯。臣辄奉宣诏命，导扬恩化；复其社稷，安其闾伍；舍其赋调，弛其征役；训之德礼以移其风，示之轨仪以易其俗。百姓欣欣，人怀逸豫〖16〗；后来其苏〖17〗，义无以过。”","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":532,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":480,"offset_unit":"unicode_code_point"},{"id":"wgc-q0377","section":"chapter-028","block":"b-23e8850b8ee57e7e439c","layer":"original","quote":"维遂东引，还守剑阁〖11〗。钟会攻维未能克","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":322,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":211,"end":232,"offset_unit":"unicode_code_point"},{"id":"wgc-q0460","section":"chapter-028","block":"b-78045a2622266a435eeb","layer":"original","quote":"未到，闻其已破，退趋白水，与蜀将张翼、廖化等合守剑阁拒会","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":473,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":118,"end":146,"offset_unit":"unicode_code_point"},{"id":"zhuge-e-o085a-q","section":"chapter-035","block":"b-e5ed1b1c3d244f688cfe","layer":"original","quote":"景耀四年，为行都护、卫将军〖16〗，与辅国大将军、南乡侯董厥，并平尚书事〖17〗。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":408,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":41,"offset_unit":"unicode_code_point"},{"id":"zhuge-e-o088a-q","section":"chapter-035","block":"b-352840fe8fe246488eae","layer":"original","quote":"董厥者，丞相亮时为府令史〖1〗，亮称之曰：“董令史，良士也。吾每与之言，思慎宜适〖2〗。”徙为主簿。亮卒后，稍迁至尚书仆射。代陈祗为尚书令〖3〗。迁〔辅国〕大将军，平台事〖4〗。而义阳樊建代焉。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":437,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":97,"offset_unit":"unicode_code_point"},{"id":"zhuge-e-o090a-q","section":"chapter-035","block":"b-1d0877cbf2a1516f2355","layer":"original","quote":"蜀破之明年春，厥、建俱诣京都，同为相国参军〖9〗；其秋并兼散骑常侍，使蜀慰劳〖10〗。﹝三﹞","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":439,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":46,"offset_unit":"unicode_code_point"},{"id":"zhuge-e-p054a-q","section":"chapter-035","block":"b-c757579021f8983017ea","layer":"pei","quote":"瞻、厥等以维好战无功，国内疲弊；宜表后主，召还为益州刺史，夺其兵权。蜀长老犹有瞻表‘以阎宇代维’故事。","attribution":"孙盛《异同记》","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":453,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-728adfc2b17d8d199f48","start":13,"end":64,"offset_unit":"unicode_code_point"},{"id":"zhuge-f0013-q","section":"chapter-035","block":"b-3406c6235d4ec9ae7056","layer":"pei","quote":"董厥字龚袭","attribution":"《晋百官表》","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":452,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-d2a6b00b60221b3a977c","start":12,"end":17,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-o085","section":"chapter-035","block":"b-e5ed1b1c3d244f688cfe","layer":"original","quote":"景耀四年，为行都护、卫将军〖16〗，与辅国大将军、南乡侯董厥，并平尚书事〖17〗。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":408,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":41,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-o088","section":"chapter-035","block":"b-352840fe8fe246488eae","layer":"original","quote":"董厥者，丞相亮时为府令史〖1〗，亮称之曰：“董令史，良士也。吾每与之言，思慎宜适〖2〗。”徙为主簿。亮卒后，稍迁至尚书仆射。代陈祗为尚书令〖3〗。迁〔辅国〕大将军，平台事〖4〗。而义阳樊建代焉。﹝一﹞延熙（二）十四年，以校尉使吴；值孙权病笃〖5〗，不自见建。权问诸葛恪曰：“樊建何如宗预也〖6〗？”恪对曰：“才识不及预，而雅性过之。”后为侍中，守尚书令〖7〗。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":437,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":180,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-o089","section":"chapter-035","block":"b-8ad10299db2621d1c503","layer":"original","quote":"自瞻、厥、建统事，姜维常征伐在外，宦人黄皓窃弄机柄；咸共将护〖8〗，无能匡矫，﹝二﹞然建特不与皓和好往来。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":438,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":53,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-o090","section":"chapter-035","block":"b-1d0877cbf2a1516f2355","layer":"original","quote":"蜀破之明年春，厥、建俱诣京都，同为相国参军〖9〗；其秋并兼散骑常侍，使蜀慰劳〖10〗。﹝三﹞","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":439,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":46,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-p053","section":"chapter-035","block":"b-3406c6235d4ec9ae7056","layer":"pei","quote":"﹝一﹞按《晋百官表》：“董厥字龚袭，亦义阳人。建字长元。”","attribution":"《晋百官表》","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":452,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-d2a6b00b60221b3a977c","start":0,"end":29,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-p054","section":"chapter-035","block":"b-c757579021f8983017ea","layer":"pei","quote":"﹝二﹞孙盛《异同记》曰：“瞻、厥等以维好战无功，国内疲弊；宜表后主，召还为益州刺史，夺其兵权。蜀长老犹有瞻表‘以阎宇代维’故事。晋永和三年，蜀史常璩说蜀长老云：‘陈寿尝为瞻吏，为瞻所辱；故因此事归恶黄皓，而云瞻不能匡矫也。’”","attribution":"孙盛《异同记》","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":453,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-728adfc2b17d8d199f48","start":0,"end":113,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
