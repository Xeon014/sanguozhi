{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o006a","title":"边章韩遂叛乱","accounts":[{"id":"wudi-e-o006a-account","label":"正文","text":"边章、韩遂杀刺史、郡守起兵，聚众十余万。","evidence":["wudi-e-o006a-q"]}],"participants":[{"person":"wudi-p0047","role":"起兵","evidence":["wudi-e-o006a-q"]},{"person":"wudi-p0048","role":"起兵","evidence":["wudi-e-o006a-q"]}],"place":{"text":"金城","evidence":["wudi-e-o006a-q"]},"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-o006a-q"]},"source_order":[1,60,"O006a"],"order":36},{"id":"wudi-e-p120b","title":"宋扬北宫玉推边章韩遂为首","accounts":[{"id":"wudi-e-p120b-account","label":"《典略》","text":"凉州宋扬、北宫玉等起兵，推边章、韩遂为首；边章随后病卒，韩遂被劫而起兵，三十二年至死。","evidence":["wudi-e-p120b-q"]}],"participants":[{"person":"wudi-p0350","role":"起兵","evidence":["wudi-e-p120b-q"]},{"person":"wudi-p0351","role":"起兵","evidence":["wudi-e-p120b-q"]},{"person":"wudi-p0047","role":"被推病卒","evidence":["wudi-e-p120b-q"]},{"person":"wudi-p0048","role":"被推起兵","evidence":["wudi-e-p120b-q"]}],"place":{"text":"凉州","evidence":["wudi-e-p120b-q"]},"time":{"label":"起兵至死三十二年，不反推精确起年","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p120b-q"]},"source_order":[1,1026,"P120b"],"order":384},{"id":"gongsuntao-e-o179","title":"张温请谦参军事谦众辱温温怒徙谦于边","accounts":[{"id":"gongsuntao-a-762ef2ad91fdf124304e","label":"裴注·吴书","text":"张温请谦参军事谦众辱温温怒徙谦于边","evidence":["gongsuntao-q-e5540c60415f75971242"]}],"participants":[{"person":"wudi-p0021","role":"司空、衔命征讨、又请谦为参军事接遇甚厚、军罢还百僚高会属谦行酒、怒、徙谦于边","evidence":["gongsuntao-q-e5540c60415f75971242"]},{"person":"wudi-p0095","role":"轻其行事心怀不服、众辱温","evidence":["gongsuntao-q-e5540c60415f75971242"]},{"person":"wudi-p0047","role":"为乱","evidence":["gongsuntao-q-e5540c60415f75971242"]},{"person":"wudi-p0048","role":"为乱","evidence":["gongsuntao-q-e5540c60415f75971242"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年