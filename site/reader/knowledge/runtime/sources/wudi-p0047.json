"],"order":8053}],"persons":[{"id":"wudi-p0047","name":"边章","evidence":["wudi-q-o006","guanzhang-q-o025","sunshi-q-o007","dongyuan-q-p022","gongsuntao-q-a462aba956768d45653a","gongsuntao-q-e5540c60415f75971242"],"facts":[{"id":"wudi-f-p121-wudi-p0047-10f82b","label":"一名","text":"允","evidence":["wudi-q-p121"]},{"id":"wudi-f-p121-wudi-p0047-b93a72","label":"全名异称","text":"边允","evidence":["wudi-q-p121"]}],"aliases":[{"text":"允","evidence":["wudi-q-p121"]},{"text":"边允","evidence":["wudi-q-p121"]}],"mentions":[{"id":"wudi-m-o006-wudi-p0047","kind":"mention","text":"文中提及","evidence":["wudi-q-o006"]},{"id":"wudi-m-p120-wudi-p0047","kind":"mention","text":"文中提及","evidence":["wudi-q-p120"]},{"id":"wudi-m-p121-wudi-p0047","kind":"mention","text":"文中提及","evidence":["wudi-q-p121"]},{"id":"guanzhang-m-o025-wudi-p0047","kind":"mention","text":"文中提及","evidence":["guanzhang-q-o025"]},{"id":"sunshi-m-o007-wudi-p0047","kind":"mention","text":"文中提及","evidence":["sunshi-q-o007"]},{"id":"sunshi-m-o008-wudi-p0047","kind":"mention","text":"文中提及","evidence":["sunshi-q-o008"]},{"id":"sunshi-m-o009-wudi-p0047","kind":"mention","text":"议论中提及","evidence":["sunshi-q-o009"]},{"id":"sunshi-m-o010-wudi-p0047","kind":"mention","text":"文中提及","evidence":["sunshi-q-o010"]},{"id":"sunshi-m-p018-wudi-p0047","kind":"mention","text":"文中提及","evidence":["sunshi-q-p018"]},{"id":"dongyuan-m-p022-wudi-p0047","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p022"]},{"id":"gongsuntao-m-review-6c35c38e324d54d16dc9","kind":"mention","text":"边章见于相关言论或记载。","evidence":["gongsuntao-q-a462aba956768d45653a"]}]}],"evidence":[{"id":"dongyuan-q-p022","section":"chapter-006","block":"b-5096c4e9f3a8e198bf26","layer":"pei","quote":"﹝一﹞华峤《汉书》曰：“卓欲迁都长安，召公卿以下大议。司徒杨彪曰：‘昔盘庚五迁，殷民胥怨；故作三篇，以晓天下之民。今海内安稳，无故移都；恐百姓惊动，麋沸蚁聚为乱。’卓曰：‘关中肥饶，故秦得并吞六国。今徙西京，设令关东豪强敢有动者；以我强兵蹙之，可使诣沧海。’彪曰：‘海内动之甚易，安之甚难。又长安宫室坏败，不可猝复。’卓曰：‘武帝时居杜陵南山下，有成瓦窑数千处；引凉州材木东下，以作宫室，为功不难。’卓意不得，便作色曰：‘公欲沮我计邪？边章、韩约有书来，欲令朝廷必徙都！若大兵来下，我不能复相救！公便可与袁氏西行。’彪曰：‘西方，自彪道径也！顾未知天下何如耳！’议罢。卓敕司隶校尉宣璠，以灾异劾奏，因策免彪。”","attribution":"华峤《汉书》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":107,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fac3d6f4ee3a1da797ef","start":0,"end":305,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-a462aba956768d45653a","section":"chapter-008","block":"b-4da524b4a394c54022fb","layer":"original","quote":"边章、韩遂为乱凉州，金城麹胜袭杀祖厉长刘隽；绣为县吏，间伺杀胜","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":252,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":21,"end":52,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-e5540c60415f75971242","section":"chapter-008","block":"b-c4198bc46fa6feff3103","layer":"pei","quote":"后边章、韩遂为乱，司空张温衔命征讨，又请谦为参军事，接遇甚厚。而谦轻其行事，心怀不服。及军罢还，百僚高会。温属谦行酒，谦众辱温。温怒，徙谦于边","attribution":"裴注·吴书","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":138,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c1f621558943f04cf069","start":47,"end":118,"offset_unit":"unicode_code_point"},{"id":"guanzhang-e-o025a-q","section":"chapter-036","block":"b-4dd567b2c50b27f120fd","layer":"original","quote":"父腾，灵帝末与边章、韩遂等俱起事于西州〖2〗。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":110,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":17,"end":40,"offset_unit":"unicode_code_point"},{"id":"guanzhang-q-o025","section":"chapter-036","block":"b-4dd567b2c50b27f120fd","layer":"original","quote":"马超字孟起，右扶风茂陵人也〖1〗。父腾，灵帝末与边章、韩遂等俱起事于西州〖2〗。初平三年，遂、腾率众诣长安。汉朝以遂为镇西将军，遣还金城〖3〗；腾为征西将军，遣屯郿。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":110,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":83,"offset_unit":"unicode_code_point"},{"id":"sunshi-e-o007a-q","section":"chapter-046","block":"b-0175a80bd7fcb45ccf63","layer":"original","quote":"边章、韩遂作乱凉州〖31〗。中郎将董卓拒讨，无功〖32〗。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":7,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":29,"offset_unit":"unicode_code_point"},{"id":"sunshi-e-o010a-q","section":"chapter-046","block":"b-ea81b4812cdde6c51161","layer":"original","quote":"坚因起出。章、遂闻大兵向至，党众离散，皆乞降。军还，议者以军未临敌，不断功赏〖20〗；","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":50,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":43,"offset_unit":"unicode_code_point"},{"id":"sunshi-e-p018b-q","section":"chapter-046","block":"b-c8fd920a32479644dd63","layer":"pei","quote":"孤昔与周慎西征，慎围边、韩于金城。孤语张温，求引所将兵，为慎作后驻，温不听。孤时上言其形势，知慎必不克：台今有本末。事未报，温又使孤讨先零叛羌，以为西方可一时荡定。孤皆知其不然，而不得止，遂行；留别部司马刘靖，将步骑四千屯安定，以为声势。叛羌便还，欲截归道；孤小击，辄开，畏安定有兵故也。虏谓安定当数万人，不知但靖也。时又上章言状。","attribution":"《山阳公载记》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":162,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-400db0528d9f41d40f3f","start":59,"end":225,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-o007","section":"chapter-046","block":"b-0175a80bd7fcb45ccf63","layer":"original","quote":"边章、韩遂作乱凉州〖31〗。中郎将董卓拒讨，无功〖32〗。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":7,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":29,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-o008","section":"chapter-046","block":"b-c93601f43ea6cb901359","layer":"original","quote":"（中平）（三）〔二〕年，遣司空张温行车骑将军〖1〗，西讨章等。温表请坚与参军事，屯长安〖2〗。温以诏书召卓，卓良久乃诣温〖3〗。温责让卓〖4〗，卓应对不顺。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":48,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":78,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-o009","section":"chapter-046","block":"b-a3dbe4d60adabd8aad15","layer":"original","quote":"坚时在坐，前，耳语谓温曰：“卓不怖罪而鸱张大语〖5〗；宜以召不时至〖6〗，陈军法斩之。”温曰：“卓素著威名于陇蜀之间，今日杀之，西行无依。”坚曰：“明公亲率王兵〖7〗，威震天下，何赖于卓！观卓所言，不假明公〖8〗，轻上无礼〖9〗。一罪也。章、遂跋扈经年〖10〗，当以时进讨；而卓云未可，沮军疑众〖11〗。二罪也。卓受任无功，应召稽留〖12〗，而轩昂自高〖13〗。三罪也。古之名将，仗钺临众〖14〗，未有不断斩以示威者也；是以穰苴斩庄贾〖15〗，魏绛戮扬干〖16〗。今明公垂意于卓〖17〗，不即加诛；亏损威刑，于是在矣！”温不忍发举〖18〗，乃曰：“君且还，卓将疑人〖19〗。”","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":49,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":288,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-o010","section":"chapter-046","block":"b-ea81b4812cdde6c51161","layer":"original","quote":"坚因起出。章、遂闻大兵向至，党众离散，皆乞降。军还，议者以军未临敌，不断功赏〖20〗；然闻坚数卓三罪，劝温斩之，无不叹息。拜坚议郎〖21〗。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":50,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":70,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-p018","section":"chapter-046","block":"b-c8fd920a32479644dd63","layer":"pei","quote":"﹝三﹞《山阳公载记》曰：“卓谓长史刘艾曰：‘关东军败数矣，皆畏孤，无能为也。惟孙坚小戆，颇能用人；当语诸将，使知忌之。孤昔与周慎西征，慎围边、韩于金城。孤语张温，求引所将兵，为慎作后驻，温不听。孤时上言其形势，知慎必不克：台今有本末。事未报，温又使孤讨先零叛羌，以为西方可一时荡定。孤皆知其不然，而不得止，遂行；留别部司马刘靖，将步骑四千屯安定，以为声势。叛羌便还，欲截归道；孤小击，辄开，畏安定有兵故也。虏谓安定当数万人，不知但靖也。时又上章言状。而孙坚随周慎行，谓慎：求将万兵造金城，使慎以二万作后驻；边、韩城中，无宿谷，当于外运；畏慎大兵，不敢轻与坚战，而坚兵足以断其运道。儿曹用〔其言〕，必还羌谷中，凉州或能定也。温既不能用孤；慎又不用坚，自攻金城，坏其外垣。驰使语温，自以克在旦夕；温时亦自以计中也。而渡辽儿果断（蔡园）〔葵园峡〕，慎弃辎重走，果如孤策。台以此封孤都乡侯。坚以佐军司马，所见与人同，自为可耳；〔但无故从诸袁儿，终亦殆尔！〕’艾曰：‘坚虽时见计，故自不如李傕、郭汜。闻在美阳亭北，将千骑步与虏合；殆死，亡失印绶：此不为能也。’卓曰：‘坚时乌合义从，兵不如虏精；且战有利钝。但当论山东大势，终无所至耳！’艾曰：‘山东儿驱略百姓，以作寇逆，其锋不如人；坚甲、利兵、强弩之用，又不如人：亦安得久？’卓曰：‘然！但杀二袁、刘表、孙坚，天下自服从孤耳！’”","attribution":"《山阳公载记》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":162,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-400db0528d9f41d40f3f","start":0,"end":585,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o006a-q","section":"chapter-001","block":"b-9ad2c91333a45ef47c43","layer":"original","quote":"金城边章、韩遂杀刺史、郡守以叛〖1〗，众十余万，天下骚动。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":59,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":29,"offset_unit":"unicode_code_point"},{"id":"wudi-e-p120b-q","section":"chapter-001","block":"b-8c855643c67a12b18504","layer":"pei","quote":"会凉州宋扬、北宫玉等反，举章、遂为主。章寻病卒；遂为扬等所劫，不得已，遂阻兵为乱。积三十二年，至是乃死，年七十余矣。","attribution":"《典略》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":350,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a5c0b079f6539aa1943e","start":72,"end":130,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o006","section":"chapter-001","block":"b-9ad2c91333a45ef47c43","layer":"original","quote":"金城边章、韩遂杀刺史、郡守以叛〖1〗，众十余万，天下骚动。征太祖为典军校尉〖2〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":59,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":41,"offset_unit":"unicode_code_point"},{"id":"wudi-q-p120","section":"chapter-001","block":"b-8c855643c67a12b18504","layer":"pei","quote":"﹝一﹞《典略》曰：“遂字文约。始与同郡边章俱著名西州。章为督军从事。遂奉计，诣京师。何进宿闻其名，特与相见。遂说进，使诛诸阉人，进不从；乃求归。会凉州宋扬、北宫玉等反，举章、遂为主。章寻病卒；遂为扬等所劫，不得已，遂阻兵为乱。积三十二年，至是乃死，年七十余矣。”","attribution":"《典略》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":350,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a5c0b079f6539aa1943e","start":0,"end":131,"offset_unit":"unicode_code_point"},{"id":"wudi-q-p121","section":"chapter-001","block":"b-6c2f0cebccb3516ba1b2","layer":"pei","quote":"刘艾《灵帝纪》曰：“章，一名（元）〔允〕。”","attribution":"刘艾《灵帝纪》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":351,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a5c0b079f6539aa1943e","start":0,"end":22,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
