titlepage_0035.xhtml","index":121,"anchor":null},"note_id":"n-8f3fa47404936b4d9fd2","start":206,"end":251},{"id":"liusima-q-cc6cb9918f19a0e75be8","section":"chapter-015","block":"b-b0201fcf74e9a553c67d","layer":"pei","quote":"昔有爱妻，住在晋阳。昔既思之，又恐遂不得归，乃以其部五百骑，叛还并州；留其余骑置山谷间，而单骑独入晋阳，盗取其妻。已出城，州郡乃觉。吏民又畏昔善射，不敢追。习乃令从事张景募鲜卑，使逐昔。昔马负其妻，重骑行迟；未及与其众合，而为鲜卑所射死","attribution":"裴注·魏略","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":121,"anchor":null},"note_id":"n-8f3fa47404936b4d9fd2","start":252,"end":370}],"profiles":{},"directory_counts":{}}
