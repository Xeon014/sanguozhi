{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[],"persons":[{"id":"jfj-p0005","name":"庞延","evidence":["jfj-q0042"],"facts":[],"aliases":[],"mentions":[{"id":"jfj-m-o005-jfj-p0005","kind":"mention","text":"本段人物记载：庞延","evidence":["jfj-q0042"]}]}],"evidence":[{"id":"jfj-q0042","section":"chapter-044","block":"b-cdd5bc4f6ea240d4f01e","layer":"original","quote":"建兴元年，丞相亮开府，辟琬为东曹掾。举茂才〖1〗，琬固让刘邕、阴化、庞延、廖淳。亮教答曰：“思惟背亲舍德〖2〗，以腆百姓〖3〗；众人既不隐于心〖4〗，实又使远近不解其义；是以君宜显其功举〖5〗，以明此选之清重也〖6〗。”迁为参军。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":14,"anchor":null},"note_id":null,"start":0,"end":115}],"profiles":{},"directory_counts":{}}
