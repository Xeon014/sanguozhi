5decf439d8f2","label":"正文","text":"诸葛恪赴援东兴戊午交战大破魏军","evidence":["santizhu-q-8812753a9ed1bf501f17"]},{"id":"santizhu064-a-3ec507660e3f43424f78","label":"正文","text":"恪兴军四万晨夜赴救东兴，遣留赞、吕据、唐咨、丁奉为前部；雪中解甲缘遏鼓噪，魏军争渡浮桥，桥坏自溺死者数万，桓嘉并没，斩故叛将韩综，获资器山积而还","evidence":["santizhu064-q-c0aaa14c0306cbe5684d"]},{"id":"hequan-a-d5028d0d76fb7c0b2aa5","label":"裴注·《吴书》","text":"东关之役全绪与丁奉建议引兵先出破魏军","evidence":["hequan-q-ae4ded7244b535b59ef0"]},{"id":"chenghuang-a-f5817e61cfb8c3186c99","label":"正文","text":"东兴之役综为前锋军败身死恪斩首白庙","evidence":["chenghuang-q-6a6c8553c5614eb1ca01"]},{"id":"chenghuang-a-fe57b12b518a30474084","label":"正文","text":"东兴雪中奋短兵大破魏前屯","evidence":["chenghuang-q-1da7562bc4ca7ae07bed"]},{"id":"zhulv-a-433c35e0cba0625c4782","label":"正文","text":"魏出东兴，据赴讨有功","evidence":["zhulv-q-305b4439281ed74f2920"]},{"id":"zhulv-a-9a1f642773fb323a3b31","label":"正文","text":"是岁，魏遣胡遵、诸葛诞等出东兴；异督水军攻浮梁，坏之，魏军大破","evidence":["zhulv-q-77551a11b8ee4f203b3f"]}],"participants":[{"person":"shaodi-p0041","role":"率军赴援并于东兴交战","evidence":["santizhu-q-8812753a9ed1bf501f17"]},{"person":"wuzhu-p0056","role":"被杀的魏将","evidence":["santizhu-q-8812753a9ed1bf501f17"]},{"person":"santizhu-p0006","role":"被杀的魏将","evidence":["santizhu-q-8812753a9ed1bf501f17"]},{"person":"shaodi-p0076","role":"为前部，解甲缘遏先登","evidence":["santizhu064-q-c0aaa14c0306cbe5684d"]},{"person":"wuzhu-p0088","role":"为前部","evidence":["santizhu064-q-c0aaa14c0306cbe5684d"]},{"person":"santizhu-p0017","role":"为前部，解甲缘遏先登","evidence":["santizhu064-q-c0aaa14c0306cbe5684d"]},{"person":"hequan-p0007","role":"与丁奉建议引兵先出、破魏军、封一子亭侯","evidence":["hequan-q-ae4ded7244b535b59ef0"]},{"person":"wuzhu-p0127","role":"会至，魏军遂溃","evidence":["chenghuang-q-1da7562bc4ca7ae07bed"]},{"person":"mingdi-p0033","role":"出东兴者","evidence":["zhulv-q-77551a11b8ee4f203b3f"]},{"person":"shaodi-p0044","role":"出东兴者","evidence":["zhulv-q-77551a11b8ee4f203b3f"]},{"person":"wuzhu-p0126","role":"督水军坏浮梁者","evidence":["zhulv-q-77551a11b8ee4f203b3f"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["santizhu-q-8812753a9ed1bf501f17"]},"ordering_evidence":"santizhu-q-8812753a9ed1bf501f17","source_order":[48,7,102],"order":8433},{"id":"chenghuang-e-o037","title":"韩综袭侯领兵权征石阳使守武昌","accounts":[{"id":"chenghuang-a-ba3f5a1f90922fead946","label":"正文","text":"韩综袭侯领兵权征石阳使守武昌","evidence":["chenghuang-q-939d1dc1cc981aadc44b"]}],"participants":[{"person":"wuzhu-p0056","role":"袭侯领兵、有忧、守武昌","evidence":["chenghuang-q-939d1dc1cc981aadc44b"]},{"person":"sun-quan","role":"征石阳、以综有忧使守武昌","evidence":["chenghuang-q-939d1dc1cc981aadc44b"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["chenghuang-q-939d1dc1cc981aadc44b"]},"ordering_evidence":"chenghuang-q-939d1dc1cc981aadc44b","source_order":[55,59,0],"order":9798},{"id":"chenghuang-e-o039","title":"魏以综为将军封广阳侯数犯边境","accounts":[{"id":"chenghuang-a-bdc9e69724a755208b74","label":"正文","text":"魏以综为将军封广阳侯数犯边境","evidence":["chenghuang-q-fd4800544fbb2701b89b"]}],"participants":[{"person":"wuzhu-p0056","role":"魏以为将军封广阳侯、数犯边境杀害人民","evidence":["chenghuang-q-fd4800544fbb2701b89b"]},{"person":"sun-quan","role":"常切齿","evidence":["chenghuang-q-fd4800544fbb2701b89b"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["chenghuang-q-fd4800544fbb2701b89b"]},"ordering_evidence":"chenghuang-q-fd4800544fbb2701b89b","source_order":[55,60,0],"order":9799}],"persons":[{"id":"wuzhu-p0056","name":"韩综","evidence":["wuzhu-q-o079","xiahoucao-q-o044","santizhu-q-8812753a9ed1bf501f17","chenghuang-q-939d1dc1cc981aadc44b","chenghuang-q-da822f3582a45cc5c9cc","chenghuang-q-fd4800544fbb2701b89b","chenghuang-q-6a6c8553c5614eb1ca01","chenghuang-q-a2f25c4cf62013627d62","chenghuang-q-28c036dc4967985b0bf6"],"facts":[],"aliases":[],"mentions":[{"id":"wuzhu-m-o079-wuzhu-p0056","kind":"mention","text":"文中提及","evidence":["wuzhu-q-o079"]},{"id":"xiahoucao-m-o044-wuzhu-p0056","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-o044"]}]}],"evidence":[{"id":"chenghuang-q-1da7562bc4ca7ae07bed","section":"chapter-055","block":"b-f6550e25d92fd67b6b52","layer":"original","quote":"天寒，雪，敌诸将置酒高会。奉见其前部兵少，相谓曰：“取封侯爵赏，正在今日！”乃使兵解铠著胄，持短兵〖7〗。敌人从而笑焉，不为设备。奉纵兵斫之，大破敌前屯；会据等至，魏军遂溃。迁灭寇将军〖8〗，进封都（亭）〔乡〕侯","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":356,"anchor":null},"note_id":null,"start":0,"end":106},{"id":"chenghuang-q-28c036dc4967985b0bf6","section":"chapter-055","block":"b-85f7b36b836c8ea182b4","layer":"pei","quote":"﹝三﹞《吴书》曰：“综欲叛，恐左右不从，因讽使劫略，示欲饶之；转相仿效，为行旅大患。后因诈言‘被诏，以部曲为寇盗见诘让’，云‘将吏以下，当并收治’，又言‘恐罪自及’。左右因曰：‘惟当去耳！’遂共图计。以当葬父，尽呼亲戚姑姊，悉以嫁将吏；所幸婢妾，皆赐与亲近；杀牛饮酒歃血，与共盟誓。”","attribution":"《吴书》","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":80,"anchor":null},"note_id":"n-731439beb1600871224c","start":0,"end":142},{"id":"chenghuang-q-6a6c8553c5614eb1ca01","section":"chapter-055","block":"b-87fe2456927ad072130b","layer":"original","quote":"东兴之役〖15〗，综为前锋，军败身死。诸葛恪斩送其首，以白权庙","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":59,"anchor":null},"note_id":null,"start":26,"end":57},{"id":"chenghuang-q-939d1dc1cc981aadc44b","section":"chapter-055","block":"b-5aaefcd2352b2f4c77e3","layer":"original","quote":"子综，袭侯领兵。其年，权征石阳。以综有忧〖14〗，使守武昌","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":58,"anchor":null},"note_id":null,"start":0,"end":29},{"id":"chenghuang-q-a2f25c4cf62013627d62","section":"chapter-055","block":"b-85f7b36b836c8ea182b4","layer":"pei","quote":"综欲叛，恐左右不从，因讽使劫略，示欲饶之；转相仿效，为行旅大患。后因诈言‘被诏，以部曲为寇盗见诘让’，云‘将吏以下，当并收治’，又言‘恐罪自及’。左右因曰：‘惟当去耳！’遂共图计。以当葬父，尽呼亲戚姑姊，悉以嫁将吏；所幸婢妾，皆赐与亲近；杀牛饮酒歃血，与共盟誓","attribution":"裴注·吴书","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":80,"anchor":null},"note_id":"n-731439beb1600871224c","start":10,"end":140},{"id":"chenghuang-q-da822f3582a45cc5c9cc","section":"chapter-055","block":"b-5aaefcd2352b2f4c77e3","layer":"original","quote":"而综淫乱不轨。权虽以父故，不问；综内怀惧，﹝三﹞载父丧，将母、家属、部曲男女数千人奔魏","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":58,"anchor":null},"note_id":null,"start":30,"end":73},{"id":"chenghuang-q-fd4800544fbb2701b89b","section":"chapter-055","block":"b-87fe2456927ad072130b","layer":"original","quote":"魏以为将军，封广阳侯。数犯边境，杀害人民，权常切齿","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":59,"anchor":null},"note_id":null,"start":0,"end":25},{"id":"hequan-q-ae4ded7244b535b59ef0","section":"chapter-060","block":"b-6c5f593279f7e62e0019","layer":"pei","quote":"东关之役，绪与丁奉，建议引兵先出；以破魏军，封一子亭侯","attribution":"裴注·《吴书》","section_title":"贺全吕周钟离传第十五","source":{"file":"OEBPS/Text/titlepage_0127.xhtml","index":159,"anchor":null},"note_id":"n-745969b04e6140fa105c","start":49,"end":76},{"id":"santizhu-q-8812753a9ed1bf501f17","section":"chapter-048","block":"b-9b3f5181b40c2019f20c","layer":"original","quote":"甲寅〖11〗，恪以大兵赴敌。戊午〖12〗，兵及东兴，交战；大破魏军，杀将军韩综、桓嘉等","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":14,"anchor":null},"note_id":null,"start":102,"end":145},{"id":"santizhu064-q-c0aaa14c0306cbe5684d","section":"chapter-064","block":"b-d3196146b5b40af27868","layer":"original","quote":"恪兴军四万，晨夜赴救。遵等敕其诸军：作浮桥渡，阵于堤上〖6〗，分兵攻两城。城在高峻，不可猝拔。恪遣将军留赞、吕据、唐咨、丁奉为前部。时天寒，雪，魏诸将会饮。见赞等兵少，而解置铠甲，不持矛戟；但兜鍪刀盾〖7〗，裸身缘遏〖8〗：大笑之，不即严兵〖9〗。兵得上，便鼓噪乱斫〖10〗。魏军惊扰散走，争渡浮桥；桥坏绝，自投于水，更相蹈藉。乐安太守桓嘉等，同时并没〖11〗，死者数万。故叛将韩综为魏前军督〖12〗，亦斩之。获车乘牛、马、驴、骡各数千，资器山积，振旅而归〖13〗。","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":164,"anchor":null},"note_id":null,"start":0,"end":233},{"id":"wuzhu-e-o079a-q","section":"chapter-047","block":"b-12764ef2bd529fe1d531","layer":"original","quote":"闰月〖32〗，韩当子综，以其众降魏。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":394,"anchor":null},"note_id":null,"start":0,"end":18},{"id":"wuzhu-q-o078","section":"chapter-047","block":"b-8b3cb03897e489e17eb4","layer":"original","quote":"六年春正月〖31〗，诸将获彭绮。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":393,"anchor":null},"note_id":null,"start":0,"end":16},{"id":"wuzhu-q-o079","section":"chapter-047","block":"b-12764ef2bd529fe1d531","layer":"original","quote":"闰月〖32〗，韩当子综，以其众降魏。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":394,"anchor":null},"note_id":null,"start":0,"end":18},{"id":"xiahoucao-e-o044a-q","section":"chapter-009","block":"b-e22a9406449766625410","layer":"original","quote":"明帝即位，进封长平侯。吴将审德屯皖，休击破之，斩德首；吴将韩综、翟丹等，前后率众诣休降。增邑四百，并前二千五百户；迁大司马〖11〗，都督扬州如故。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":191,"anchor":null},"note_id":null,"start":0,"end":73},{"id":"xiahoucao-q-o044","section":"chapter-009","block":"b-e22a9406449766625410","layer":"original","quote":"明帝即位，进封长平侯。吴将审德屯皖，休击破之，斩德首；吴将韩综、翟丹等，前后率众诣休降。增邑四百，并前二千五百户；迁大司马〖11〗，都督扬州如故。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":191,"anchor":null},"note_id":null,"start":0,"end":73},{"id":"zhuge-q-b-bac68d65cbee34059b3b","section":"chapter-035","block":"b-bac68d65cbee34059b3b","layer":"modern","quote":"〖1〗五年：建兴五年（公元 227）。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":160,"anchor":null},"note_id":"n-7b55cee111ab139cccf8","start":0,"end":19},{"id":"zhuge-q-o024","section":"chapter-035","block":"b-1cb2342652e8f8d4d768","layer":"original","quote":"五年〖1〗，率诸军北驻汉中。临发，上疏曰〖2〗：","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":152,"anchor":null},"note_id":null,"start":0,"end":24},{"id":"zhulv-q-305b4439281ed74f2920","section":"chapter-056","block":"b-604767dbf5853a5d004b","layer":"original","quote":"魏出东兴，据赴讨有功","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":199,"anchor":null},"note_id":null,"start":10,"end":20},{"id":"zhulv-q-77551a11b8ee4f203b3f","section":"chapter-056","block":"b-abd659c367dbc19a7af5","layer":"original","quote":"是岁，魏遣胡遵、诸葛诞等出东兴。异督水军攻浮梁〖6〗，坏之，魏军大破","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":285,"anchor":null},"note_id":null,"start":11,"end":45}],"profiles":{},"directory_counts":{}}
