d2aff7d16a2f220f5f","label":"裴注·魏略","text":"祝公道夜盗引贾逵出窖，折械遣去，不语姓名","evidence":["liusima-q-c156a9ae16ecec81a51a"]}],"participants":[{"person":"guanzhang-p0014","role":"攻河东，所经城邑皆下，攻绛不拔；召单于，并军急攻，城将溃；闻逵名欲使为将，以兵劫之，怒将斩之；捕得逵，怒曰促斩之，诸将覆护后乃囚于壶关，闭著土窖中，以车轮盖上，使人固守，方将杀之","evidence":["liusima-q-cae6bd33b89086aae2ea","liusima-q-377abab9d9a6ba100450","liusima-q-e64008b32c6e76d161a8","liusima-q-ca4f3e20ef829e694a4d"]},{"person":"identity-six-20261024-p-jia-kui-liangdao","role":"坚守绛邑；父老约请不害之；不为兵劫所动，叱安有国家长吏为贼叩头；被左右义请，遂得免于死；不肯拜，谓援曰王府君临郡积年，不知足下曷为者也；从窖中谓守者曰此间无健儿邪，而当使义士死此中乎","evidence":["liusima-q-cae6bd33b89086aae2ea","liusima-q-377abab9d9a6ba100450","liusima-q-e64008b32c6e76d161a8","liusima-q-f362b3b19673ce408b56","liusima-q-ca4f3e20ef829e694a4d","liusima-q-c156a9ae16ecec81a51a"]},{"person":"liusima-p0051","role":"与逵非故人，适闻其言，怜其守正危厄，乃夜盗往引出，折械遣去，不语其姓名","evidence":["liusima-q-c156a9ae16ecec81a51a"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liusima-q-cae6bd33b89086aae2ea","liusima-q-377abab9d9a6ba100450","liusima-q-e64008b32c6e76d161a8","liusima-q-f362b3b19673ce408b56","liusima-q-ca4f3e20ef829e694a4d","liusima-q-c156a9ae16ecec81a51a"]},"ordering_evidence":"liusima-q-cae6bd33b89086aae2ea","source_order":[15,229,13],"order":3342},{"id":"liusima-e-o138","title":"贾逵围急中使人送印绶归郡，嘱急据皮氏","accounts":[{"id":"liusima-a-7961d5a2afaf32272345","label":"正文","text":"贾逵围急中使人送印绶归郡，嘱急据皮氏","evidence":["liusima-q-e71361e6d1ca86beb479"]},{"id":"liusima-a-a1991a1fa5c6e1987018","label":"正文","text":"贾逵以他计疑郭援谋人祝奥，援留七日，郡从逵言得无败","evidence":["liusima-q-dc7736b2fa87942c3e2d"]}],"participants":[{"person":"identity-six-20261024-p-jia-kui-liangdao","role":"尝过皮氏言争地先据者胜；及围急知不免，乃使人间行送印绶归郡，且曰急据皮氏；恐援先得皮氏，以他计疑援谋人祝奥，郡从其言故得无败","evidence":["liusima-q-e71361e6d1ca86beb479","liusima-q-dc7736b2fa87942c3e2d"]},{"person":"liusima-p0052","role":"郭援谋人，遭疑","evidence":["liusima-q-dc7736b2fa87942c3e2d"]},{"person":"guanzhang-p0014","role":"并绛众后将进兵，由是留七日","evidence":["liusima-q-dc7736b2fa87942c3e2d"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liusima-q-e71361e6d1ca86beb479","liusima-q-dc7736b2fa87942c3e2d"]},"ordering_evidence":"liusima-q-e71361e6d1ca86beb479","source_order":[15,229,178],"order":3343},{"id":"guanzhang-e-o026b","title":"马超随钟繇讨郭援庞德斩援","accounts":[{"id":"guanzhang-e-o026b-account","label":"《关张马黄赵传第六》正文","text":"马超随钟繇讨郭援庞德斩援","evidence":["guanzhang-e-o026b-q"]}],"participants":[{"person":"guanzhang-p0013","role":"遣军","evidence":["guanzhang-e-o026b-q"]},{"person":"wudi-p0282","role":"从征","evidence":["guanzhang-e-o026b-q"]},{"person":"wudi-p0181","role":"统军","evidence":["guanzhang-e-o026b-q"]},{"person":"shaodi-p0011","role":"斩将","evidence":["guanzhang-e-o026b-q"]},{"person":"guanzhang-p0014","role":"被斩","evidence":["guanzhang-e-o026b-q"]}],"place":null,"time":{"label":"马腾袭长安后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["guanzhang-e-o026b-q"]},"ordering_evidence":"guanzhang-e-o026b-q","source_order":[36,112,"O026b"],"order":6885},{"id":"guanzhang-e-p016g","title":"马超讨郭援带伤战授徐州刺史谏议大夫","accounts":[{"id":"guanzhang-e-p016g-account","label":"《典略》","text":"马超讨郭援带伤战授徐州刺史谏议大夫","evidence":["guanzhang-e-p016g-q"]}],"participants":[{"person":"wudi-p0282","role":"征讨受任","evidence":["guanzhang-e-p016g-q"]},{"person":"guanzhang-p0014","role":"被斩","evidence":["guanzhang-e-p016g-q"]}],"place":null,"time":{"label":"马腾早年至入朝","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["guanzhang-e-p016g-q"]},"ordering_evidence":"guanzhang-e-p016g-q","source_order":[36,137,"P016g"],"order":6900}],"persons":[{"id":"guanzhang-p0014","name":"郭援","evidence":["guanzhang-q-o026","xunyu-q-o023","zhonghua-q-04a7d3de46fac2ba1c59","zhonghua-q-2e8887a3c16d01c3eeb0","zhonghua-q-f7bba20e9f2113d463ac","zhonghua-q-21fd55277324a512ed9e","liusima-q-af31a676aa3b231c22c0","liusima-q-f2479d99d841b7989d13","liusima-q-cae6bd33b89086aae2ea","liusima-q-377abab9d9a6ba100450","liusima-q-e64008b32c6e76d161a8","liusima-q-dc7736b2fa87942c3e2d","liusima-q-ca4f3e20ef829e694a4d","lizang-q-5b99cf8e7236f639d2b5","lizang-q-ee0fcf8d9d95a8a89aea","lizang-q-d9c6a20001d63fc4e6c2","lizang-q-4924e47843d48d5bf19e"],"facts":[],"aliases":[],"mentions":[{"id":"guanzhang-m-o026-guanzhang-p0014","kind":"mention","text":"文中提及","evidence":["guanzhang-q-o026"]},{"id":"guanzhang-m-p016-guanzhang-p0014","kind":"mention","text":"文中提及","evidence":["guanzhang-q-p016"]},{"id":"xunyu-m-o023-guanzhang-p0014","kind":"mention","text":"文中提及","evidence":["xunyu-q-o023"]}]}],"evidence":[{"id":"guanzhang-e-o026b-q","section":"chapter-036","block":"b-ebcd92d1abd43d6e866a","layer":"original","quote":"腾遣超随繇讨郭援、高幹于平阳，超将庞德亲斩援首。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":111,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":38,"end":62,"offset_unit":"unicode_code_point"},{"id":"guanzhang-e-p016g-q","section":"chapter-036","block":"b-a3cf7a7b0878bc734aef","layer":"pei","quote":"超后为司隶校尉督军从事，讨郭援，为飞矢所中；乃以囊囊其足而战，破斩援首，诏拜徐州刺史，后拜谏议大夫。","attribution":"《典略》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":136,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-d687f38a83f90e952a5b","start":479,"end":529,"offset_unit":"unicode_code_point"},{"id":"guanzhang-q-o026","section":"chapter-036","block":"b-ebcd92d1abd43d6e866a","layer":"original","quote":"后腾袭长安；败走，退还凉州。司隶校尉钟繇镇关中，移书遂、腾〖4〗，为陈祸福。腾遣超随繇讨郭援、高幹于平阳，超将庞德亲斩援首。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":111,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":62,"offset_unit":"unicode_code_point"},{"id":"guanzhang-q-p016","section":"chapter-036","block":"b-a3cf7a7b0878bc734aef","layer":"pei","quote":"﹝一﹞《典略》曰：“腾字寿成。马援后也。桓帝时，其父，字子硕，尝为天水兰干尉。后失官，因留陇西，与羌错居。家贫无妻，遂娶羌女，生腾。腾少贫无产业，常从彰山中斫材木，负贩诣城市，以自供给。腾为人，长八尺余，身体洪大，面鼻雄异；而性贤厚，人多敬之。灵帝末，凉州刺史耿鄙，任信奸吏，民王国等及氐、羌反叛。州郡募发民中有勇力者，欲讨之。腾在募中，州郡异之，署为军从事，典领部众。讨贼有功，拜军司马。后以功迁偏将军，又迁征西将军，常屯汧、陇之间。初平中，拜征东将军。是时，西州少谷，腾自表军人多乏，求就谷于池阳，遂移屯长平岸头。而将王承等恐腾为己害，乃攻腾营。时腾近出无备，遂破走，西上。会三辅乱，不复来东，而与镇西将军韩遂结为异姓兄弟；始甚相亲，后转以部曲相侵入，更为仇敌。腾攻遂，遂走；合众还攻腾，杀腾妻子，连兵不解。建安之初，国家纲纪殆弛，乃使司隶校尉钟繇、凉州牧韦端，和解之。征腾，还屯槐里，转拜为前将军，假节，封槐里侯。北备胡寇，东备白骑；待士进贤，矜救民命：三辅甚安爱之。十（五）〔三〕年，征为卫尉；腾自见年老，遂入宿卫。初，曹公为丞相，辟腾长子超，不就。超后为司隶校尉督军从事，讨郭援，为飞矢所中；乃以囊囊其足而战，破斩援首，诏拜徐州刺史，后拜谏议大夫。及腾之入，因诏拜为偏将军，使领腾营；又拜超弟休奉车都尉，休弟铁骑都尉；徙其家属皆诣邺，惟超独留。”","attribution":"《典略》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":136,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-d687f38a83f90e952a5b","start":0,"end":578,"offset_unit":"unicode_code_point"},{"id":"liusima-q-377abab9d9a6ba100450","section":"chapter-015","block":"b-19ed90bb5c7ff94e51f3","layer":"original","quote":"乃召单于，并军急攻之，城将溃。绛父老与援要〖3〗，不害逵","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":228,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":38,"end":66,"offset_unit":"unicode_code_point"},{"id":"liusima-q-5228f5d8a72814c227f1","section":"chapter-015","block":"b-d158b35e0c99bd1badc0","layer":"original","quote":"司隶校尉钟繇遣既，说将军马腾等。既为言利害，腾等从之","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":137,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":50,"end":76,"offset_unit":"unicode_code_point"},{"id":"liusima-q-af31a676aa3b231c22c0","section":"chapter-015","block":"b-d158b35e0c99bd1badc0","layer":"original","quote":"袁尚拒太祖于黎阳，遣所置河东太守郭援，并州刺史高幹及匈奴单于，取平阳；发使，西与关中诸将合从","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":137,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":46,"offset_unit":"unicode_code_point"},{"id":"liusima-q-c156a9ae16ecec81a51a","section":"chapter-015","block":"b-eb46f175ce294d7925e8","layer":"pei","quote":"逵从窖中谓守者曰：‘此间无健儿邪？而当使义士死此中乎！’时有祝公道者，与逵非故人，而适闻其言；怜其守正危厄，乃夜盗往引出，折械遣去，不语其姓名","attribution":"裴注·魏略","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":242,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-3f3fe78d2db2e117f4ac","start":86,"end":157,"offset_unit":"unicode_code_point"},{"id":"liusima-q-ca4f3e20ef829e694a4d","section":"chapter-015","block":"b-eb46f175ce294d7925e8","layer":"pei","quote":"援捕得逵。逵不肯拜，谓援曰：‘王府君临郡积年，不知足下曷为者也？’援怒曰：‘促斩之！’诸将覆护，乃囚于壶关；闭著土窖中，以车轮盖上，使人固守，方将杀之","attribution":"裴注·魏略","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":242,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-3f3fe78d2db2e117f4ac","start":10,"end":85,"offset_unit":"unicode_code_point"},{"id":"liusima-q-cae6bd33b89086aae2ea","section":"chapter-015","block":"b-19ed90bb5c7ff94e51f3","layer":"original","quote":"郭援之攻河东，所经城邑皆下，逵坚守。援攻之，不拔","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":228,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":13,"end":37,"offset_unit":"unicode_code_point"},{"id":"liusima-q-dc7736b2fa87942c3e2d","section":"chapter-015","block":"b-19ed90bb5c7ff94e51f3","layer":"original","quote":"援既并绛众，将进兵。逵恐其先得皮氏，乃以他计，疑援谋人祝奥，援由是留七日。郡从逵言，故得无败","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":228,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":228,"end":274,"offset_unit":"unicode_code_point"},{"id":"liusima-q-e64008b32c6e76d161a8","section":"chapter-015","block":"b-19ed90bb5c7ff94e51f3","layer":"original","quote":"绛人既溃，援闻逵名，欲使为将；以兵劫之〖4〗，逵不动。左右引逵，使叩头，逵叱之曰：“安有国家长吏为贼叩头〖5〗！”援怒，将斩之","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":228,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":67,"end":130,"offset_unit":"unicode_code_point"},{"id":"liusima-q-e71361e6d1ca86beb479","section":"chapter-015","block":"b-19ed90bb5c7ff94e51f3","layer":"original","quote":"初，逵过皮氏，曰：“争地先据者胜〖7〗。”及围急，知不免；乃使人间行，送印绶归郡，且曰“急据皮氏","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":228,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":178,"end":226,"offset_unit":"unicode_code_point"},{"id":"liusima-q-f2479d99d841b7989d13","section":"chapter-015","block":"b-d158b35e0c99bd1badc0","layer":"original","quote":"腾遣子超将兵万余人，与繇会击幹、援；大破之，斩援首，幹及单于皆降","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":137,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":77,"end":109,"offset_unit":"unicode_code_point"},{"id":"liusima-q-f362b3b19673ce408b56","section":"chapter-015","block":"b-19ed90bb5c7ff94e51f3","layer":"original","quote":"绛吏民闻将杀逵，皆乘城呼曰：“负要杀我贤君〖6〗，宁俱死耳！”左右义逵，多为请，遂得免","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":228,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":131,"end":174,"offset_unit":"unicode_code_point"},{"id":"lizang-q-4924e47843d48d5bf19e","section":"chapter-018","block":"b-bfe551423d3150bed6a9","layer":"pei","quote":"繇见之而哭。德谢繇，繇曰：‘援虽我甥，乃国贼也！卿何谢之","attribution":"裴注·魏略","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":220,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6cf0ffc369313cfa3fa7","start":55,"end":83,"offset_unit":"unicode_code_point"},{"id":"lizang-q-4e9d00399c0ce2056d13","section":"chapter-018","block":"b-77cf8e238c8aa2ff298d","layer":"original","quote":"太祖使钟繇率关中诸将讨之","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":201,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":80,"end":92,"offset_unit":"unicode_code_point"},{"id":"lizang-q-5b99cf8e7236f639d2b5","section":"chapter-018","block":"b-77cf8e238c8aa2ff298d","layer":"original","quote":"谭遣郭援、高幹等略取河东","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":201,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":67,"end":79,"offset_unit":"unicode_code_point"},{"id":"lizang-q-d9c6a20001d63fc4e6c2","section":"chapter-018","block":"b-bfe551423d3150bed6a9","layer":"pei","quote":"德手斩一级，不知是援。战罢之后，众人皆言援死而不得其首。援，钟繇之甥。德晚后于鞬中出一头","attribution":"裴注·魏略","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":220,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6cf0ffc369313cfa3fa7","start":10,"end":54,"offset_unit":"unicode_code_point"},{"id":"lizang-q-ee0fcf8d9d95a8a89aea","section":"chapter-018","block":"b-77cf8e238c8aa2ff298d","layer":"original","quote":"德随腾子超，拒援、幹于平阳。德为军锋，进攻援、幹，大破之，亲斩援首","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":201,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":93,"end":126,"offset_unit":"unicode_code_point"},{"id":"xunyu-e-o023b-q","section":"chapter-010","block":"b-64b6e45c68fb16b80ee9","layer":"original","quote":"而高幹、郭援侵略河东，关右震动。钟繇帅马腾等，击破之，语在《繇传》。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":120,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":24,"end":58,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-o023","section":"chapter-010","block":"b-64b6e45c68fb16b80ee9","layer":"original","quote":"太祖复次于河上，绍病死。太祖渡河，击绍子谭、尚。而高幹、郭援侵略河东，关右震动。钟繇帅马腾等，击破之，语在《繇传》。八年〖4〗，太祖录彧前后功，表封彧为万岁亭侯。﹝一﹞","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":120,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":84,"offset_unit":"unicode_code_point"},{"id":"zhonghua-q-04a7d3de46fac2ba1c59","section":"chapter-013","block":"b-6ee93dddf14ade60e6ec","layer":"original","quote":"袁尚所置河东太守郭援到河东，众甚盛，诸将议欲释之去。","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":21,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":23,"end":49,"offset_unit":"unicode_code_point"},{"id":"zhonghua-q-19fd1c45e7c404c4e12f","section":"chapter-013","block":"b-02d2da358aaec0e17eb7","layer":"pei","quote":"幹曰：‘智者转祸为福。今曹公与袁氏相持，而高幹、郭援独制河东；曹公虽有万全之计，不能禁河东之不危也。将军诚能引兵讨援，内外击之，其势必举。是将军一举，断袁氏之臂，解一方之急：曹公必重德将军。将军功名，竹帛不能尽载也。唯将军审所择！’","attribution":"裴注·司马彪战略","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":45,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-3d2327301bdfe436b774","start":205,"end":321,"offset_unit":"unicode_code_point"},{"id":"zhonghua-q-21fd55277324a512ed9e","section":"chapter-013","block":"b-02d2da358aaec0e17eb7","layer":"pei","quote":"腾曰：‘敬从教！’于是遣子超，将精兵万余人，并将遂等兵，与繇会击援等，大破之。”","attribution":"裴注·司马彪战略","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":45,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-3d2327301bdfe436b774","start":321,"end":361,"offset_unit":"unicode_code_point"},{"id":"zhonghua-q-2a97759cb8565524e9b2","section":"chapter-013","block":"b-02d2da358aaec0e17eb7","layer":"pei","quote":"傅幹说腾曰：‘古人有言：“顺道者昌，逆德者亡。”曹公奉天子诛暴乱；法明国治，上下用命；有义必赏，无义必罚：可谓顺道矣。袁氏背王命；驱胡虏以陵中国，宽而多忌，仁而无断；兵虽强，实失天下心：可谓逆德矣。今将军既事有道，不尽其力，阴怀两端，欲以坐观成败；吾恐成败既定，奉辞责罪，将军先为诛首矣。’于是腾惧。","attribution":"裴注·司马彪战略","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":45,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-3d2327301bdfe436b774","start":55,"end":205,"offset_unit":"unicode_code_point"},{"id":"zhonghua-q-2e8887a3c16d01c3eeb0","section":"chapter-013","block":"b-6ee93dddf14ade60e6ec","layer":"original","quote":"援至，果轻渡汾〖6〗；众止之，不从。济水未半，击，大破之。﹝一﹞斩援，降单于","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":21,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":179,"end":217,"offset_unit":"unicode_code_point"},{"id":"zhonghua-q-7cba893c0ffd0bddf47d","section":"chapter-013","block":"b-6ee93dddf14ade60e6ec","layer":"original","quote":"张既说马腾会击援〖5〗，腾遣子超，将精兵逆之。","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":21,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":156,"end":179,"offset_unit":"unicode_code_point"},{"id":"zhonghua-q-9fdc2a4faf98bee96821","section":"chapter-013","block":"b-6ee93dddf14ade60e6ec","layer":"original","quote":"繇曰：“袁氏方强，援之来，关中阴与之通；所以未悉叛者，顾吾威名故耳。若弃而去，示之以弱；所在之民，谁非寇仇？纵吾欲归，其得至乎？此为未战先自败也！且援刚愎好胜，必易吾军〖4〗；若渡汾为营，及其未济击之，可大克也。","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":21,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":49,"end":155,"offset_unit":"unicode_code_point"},{"id":"zhonghua-q-f6295e9b48de7d7415cc","section":"chapter-013","block":"b-6ee93dddf14ade60e6ec","layer":"original","quote":"其后，匈奴单于作乱平阳，繇帅诸军围之，未拔。","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":21,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":22,"offset_unit":"unicode_code_point"},{"id":"zhonghua-q-f7bba20e9f2113d463ac","section":"chapter-013","block":"b-02d2da358aaec0e17eb7","layer":"pei","quote":"袁尚遣高幹、郭援，将兵数万人，与匈奴单于寇河东。遣使与马腾、韩遂等连和，腾等阴许之。","attribution":"裴注·司马彪战略","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":45,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-3d2327301bdfe436b774","start":13,"end":55,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
