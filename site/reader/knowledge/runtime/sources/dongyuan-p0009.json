ion_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":178,"anchor":null},"note_id":"n-e9356f73a1c3748952e5","start":63,"end":130},{"id":"dongyuan-f0023-q","section":"chapter-006","block":"b-1abc43feb57659c26d5f","layer":"pei","quote":"瑞字君荣","attribution":"《三辅决录注》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":178,"anchor":null},"note_id":"n-e9356f73a1c3748952e5","start":36,"end":40},{"id":"dongyuan-f0024-q","section":"chapter-006","block":"b-1abc43feb57659c26d5f","layer":"pei","quote":"扶风人","attribution":"《三辅决录注》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":178,"anchor":null},"note_id":"n-e9356f73a1c3748952e5","start":41,"end":44},{"id":"dongyuan-q-o014","section":"chapter-006","block":"b-5984b2e3802609b7e084","layer":"original","quote":"三年四月〖1〗，司徒王允、尚书仆射士孙瑞、卓将吕布共谋诛卓〖2〗。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":117,"anchor":null},"note_id":null,"start":0,"end":33},{"id":"dongyuan-q-p048","section":"chapter-006","block":"b-1abc43feb57659c26d5f","layer":"pei","quote":"时尚书令士孙瑞，为乱兵所害。","attribution":"《献帝纪》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":178,"anchor":null},"note_id":"n-e9356f73a1c3748952e5","start":11,"end":25},{"id":"lvzang-q-98105c6988efbaec09a2","section":"chapter-007","block":"b-23d7db2b70a6e88a8b78","layer":"original","quote":"后布诣允，陈卓几见杀状。时允与仆射士孙瑞密谋诛卓〖2〗，是以告布使为内应。布曰：“奈如父子何〖3〗？”允曰：“君自姓吕，本非骨肉；今忧死不暇〖4〗，何谓父子","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":23,"anchor":null},"note_id":null,"start":22,"end":100},{"id":"rensu-q-2049d089b15d540e33a3","section":"chapter-016","block":"b-c172c36c6f19e1d68402","layer":"pei","quote":"后又与王允谋共诛卓","attribution":"裴注·张璠《汉纪》","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":338,"anchor":null},"note_id":"n-011440cf6742ee5cb197","start":1138,"end":1147},{"id":"wudi-q-b-3863a19b555811d1f415","section":"chapter-001","block":"b-3863a19b555811d1f415","layer":"modern","quote":"〖1〗三年：初平三年（公元 192）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":152,"anchor":null},"note_id":"n-2063caf2b642ce9ff2bc","start":0,"end":19},{"id":"wudi-q-o019","section":"chapter-001","block":"b-43620706e925cc9a268c","layer":"original","quote":"三年春〖1〗，太祖军顿丘，毒等攻东武阳。太祖乃引兵西入山，攻毒等本屯〖2〗。﹝一﹞毒闻之，弃武阳还〖3〗。太祖要击眭固〖4〗，又击匈奴于夫罗于内黄〖5〗，皆大破之。﹝二﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":150,"anchor":null},"note_id":null,"start":0,"end":85}],"profiles":{},"directory_counts":{}}
