hu-e-o015b-q"]},{"person":"xianzhu-p0029","role":"据《献帝起居注》同谋","evidence":["xianzhu-q-p015-qiju"]}],"place":null,"time":{"year":199,"label":"刘备受遣出许前","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xianzhu-y199","dating_review":{"reviewed":true,"anchor":"xianzhu-q-o014","basis":"刘备受遣出许前"},"evidence":["xianzhu-e-o015b-q","xianzhu-q-o014","wudi-q-o061","wudi-q-b-51bced16741add42ff70"]},"source_order":[32,71,"O015b"],"order":6520}],"persons":[{"id":"wudi-p0113","name":"董承","evidence":["wudi-q-o040","xianzhu-q-o015","zhangle-q-o039","guanzhang-q-p006","xunyu-q-p023","sunshi-q-p046","dongyuan-q-o024","chengguo-q-a8500e619a687d1c8e48","gongsuntao-q-bec3188cfa2c7b265ac9"],"facts":[{"id":"xianzhu-f0010","label":"亲属记载","text":"汉灵帝母董太后之侄，献帝丈人","evidence":["xianzhu-q-p013"]}],"aliases":[],"mentions":[{"id":"wudi-m-o040-wudi-p0113","kind":"mention","text":"文中提及","evidence":["wudi-q-o040"]},{"id":"wudi-m-o069-wudi-p0113","kind":"mention","text":"文中提及","evidence":["wudi-q-o069"]},{"id":"wudi-m-o071-wudi-p0113","kind":"mention","text":"文中提及","evidence":["wudi-q-o071"]},{"id":"wudi-m-o169-wudi-p0113","kind":"mention","text":"文中提及","evidence":["wudi-q-o169"]},{"id":"xianzhu-m-o015-wudi-p0113","kind":"mention","text":"文中提及","evidence":["xianzhu-q-o015"]},{"id":"xianzhu-m-o016-wudi-p0113","kind":"mention","text":"文中提及","evidence":["xianzhu-q-o016"]},{"id":"xianzhu-m-p013-wudi-p0113","kind":"mention","text":"文中提及","evidence":["xianzhu-q-p013"]},{"id":"xianzhu-m-p015-wudi-p0113","kind":"mention","text":"文中提及","evidence":["xianzhu-q-p015"]},{"id":"xianzhu-m-o052-wudi-p0113","kind":"allusion","text":"祖系或典故提及","evidence":["xianzhu-q-o052"]},{"id":"xianzhu-m-o057-wudi-p0113","kind":"allusion","text":"祖系或典故提及","evidence":["xianzhu-q-o057"]},{"id":"zhangle-m-o039-wudi-p0113","kind":"mention","text":"文中提及","evidence":["zhangle-q-o039"]},{"id":"guanzhang-m-p006-wudi-p0113","kind":"mention","text":"文中提及","evidence":["guanzhang-q-p006"]},{"id":"xunyu-m-p023-wudi-p0113","kind":"mention","text":"文中提及","evidence":["xunyu-q-p023"]},{"id":"sunshi-m-p046-wudi-p0113","kind":"mention","text":"文中提及","evidence":["sunshi-q-p046"]},{"id":"dongyuan-m-o024-wudi-p0113","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o024"]},{"id":"dongyuan-m-o026-wudi-p0113","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o026"]},{"id":"dongyuan-m-p046-wudi-p0113","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p046"]},{"id":"dongyuan-m-p049-wudi-p0113","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p049"]}]}],"evidence":[{"id":"chengguo-q-57bb02c8bc8efe183f2e","section":"chapter-014","block":"b-e9401b31a90b17c74409","layer":"original","quote":"备至徐州，遂杀车胄，举兵背太祖","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":33,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":97,"end":112,"offset_unit":"unicode_code_point"},{"id":"chengguo-q-791bacb1947a88965eb8","section":"chapter-014","block":"b-546398c9e99f491661e8","layer":"original","quote":"备到下邳，杀徐州刺史车胄，反。","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":178,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":64,"end":79,"offset_unit":"unicode_code_point"},{"id":"chengguo-q-a8500e619a687d1c8e48","section":"chapter-014","block":"b-d63745ed601e2334eece","layer":"original","quote":"遣使诣河东，会天子还洛阳，韩暹、杨奉、董承及杨，各违戾不和","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":154,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":13,"end":42,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-o024a-q","section":"chapter-006","block":"b-4952f69b7a7ab8eb99b0","layer":"original","quote":"郭汜复欲胁天子，还都郿。天子奔奉营，奉击汜，破之。汜走南山〖2〗。奉及将军董承，以天子还洛阳。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":163,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":47,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-o024c-q","section":"chapter-006","block":"b-4952f69b7a7ab8eb99b0","layer":"original","quote":"天子走陕，北渡河。失辎重，步行；唯皇后、贵人从。至大阳〖4〗，止人家屋中〖5〗﹝三﹞。奉、暹等遂以天子都安邑，御乘牛车；太尉杨彪、太仆韩融近臣从者十余人〖6〗。以暹为征东，才为征西，乐征北将军，并与奉、承持政。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":163,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":125,"end":230,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-o024f-q","section":"chapter-006","block":"b-4952f69b7a7ab8eb99b0","layer":"original","quote":"诸将不能相率〖7〗，上下乱，粮食尽。奉、暹、承乃以天子还洛阳；出箕关〖8〗，下轵道〖9〗。张杨以食迎道路，拜大司马。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":163,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":283,"end":341,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-o026b-q","section":"chapter-006","block":"b-575c8f171eb8425f4603","layer":"original","quote":"董承从太祖〔三〕岁余，诛。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":181,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":37,"end":50,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p049b-q","section":"chapter-006","block":"b-35cfbd89b795007423e6","layer":"pei","quote":"及当北渡，使李乐具船。天子步行趋河岸，岸高不得下。董承等谋欲以马羁相续，以系帝腰。时中宫仆伏德，扶中宫，一手持十匹绢；乃取德绢，连续为辇。行军校尉尚弘多力，令弘居前负帝，乃得下登船。其余不得渡者甚众，复遣船收诸不得渡者。皆争攀船，船上人以刃栎断其指；舟中之指可掬。","attribution":"《献帝纪》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":179,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6ae51262f7f7704d518a","start":94,"end":226,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o024","section":"chapter-006","block":"b-4952f69b7a7ab8eb99b0","layer":"original","quote":"郭汜复欲胁天子，还都郿。天子奔奉营，奉击汜，破之。汜走南山〖2〗。奉及将军董承，以天子还洛阳。傕、汜悔遣天子，复相与和，追及天子于弘农之曹阳。奉急招河东故白波帅韩暹、胡才、李乐等合〖3〗，与傕、汜大战。奉兵败，傕等纵兵杀公卿百官，略宫人入弘农。﹝二﹞天子走陕，北渡河。失辎重，步行；唯皇后、贵人从。至大阳〖4〗，止人家屋中〖5〗﹝三﹞。奉、暹等遂以天子都安邑，御乘牛车；太尉杨彪、太仆韩融近臣从者十余人〖6〗。以暹为征东，才为征西，乐征北将军，并与奉、承持政。遣融至弘农，与傕、汜等连和；还所略宫人、公卿百官，及乘舆车马数乘。是时蝗虫起，岁旱无谷；从官食枣菜。﹝四﹞诸将不能相率〖7〗，上下乱，粮食尽。奉、暹、承乃以天子还洛阳；出箕关〖8〗，下轵道〖9〗。张杨以食迎道路，拜大司马。语在《杨传》。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":163,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":348,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o026","section":"chapter-006","block":"b-575c8f171eb8425f4603","layer":"original","quote":"太祖乃迎天子都许。暹、奉不能奉王法，各出奔，寇徐、扬间，为刘备所杀。﹝一﹞董承从太祖〔三〕岁余，诛。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":181,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":50,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p046","section":"chapter-006","block":"b-01aaf749bfd0fc201fac","layer":"pei","quote":"﹝六﹞《献帝起居注》曰：“傕性喜鬼怪左道之术，常有道人及女巫歌讴击鼓，下神；祠祭六丁，符劾厌胜之具，无所不为。又于朝廷省门外，为董卓作神坐，数以牛羊祠之。讫，过省< ，问起居，求入见。傕带三刀，手复与鞭合持一刃。侍中、侍郎见傕带仗，皆惶恐；亦带剑持刀，先入在帝侧。傕对帝，或言‘明陛下’，或言‘明帝’；为帝说郭汜无状，帝亦随其意答应之。傕喜，出言：‘明陛下，真贤圣主！’意遂自信，自谓良得天子欢心也。虽然，犹不欲令近臣带剑在帝边，谓人言：‘此曹子，将欲图我邪？而皆持刀也？’侍中李祯，傕州里，素与傕通；语傕：‘所以持刀者，军中不可不尔。此国家故事。’傕意乃解。天子以谒者仆射皇甫郦凉州旧姓，有专对之才，遣令和傕、汜。郦先诣汜，汜受诏命。诣傕，傕不肯，曰：‘我有吕布之功，辅政四年，三辅清静，天下所知也。郭多，盗马虏耳，何敢乃欲与吾等邪？必欲诛之！君为凉州人，观吾方略士众，足办多不？多又劫质公卿，所为如是；而君苟欲利郭多，李傕有胆自知之。’郦答曰：‘昔有穷后羿恃其善射，不思患难，以至于毙。近董公之强，明将军目所见：内有王公以为内主；外有董旻、承、璜以为鲠毒。吕布受恩而反图之，斯须之间，头悬竿端：此有勇而无谋也。今将军身为上将，把钺仗节；子孙握权，宗族荷宠，国家好爵而皆据之。今郭多劫质公卿，将军胁至尊，谁为轻重邪？张济与郭多、杨定有谋，又为冠带所附。杨奉，白波帅耳，犹知将军所为非是；将军虽拜宠之，犹不肯尽力也。’傕不纳郦言，而呵之令出。郦出，诣省门，白傕‘不肯从诏，辞语不顺’。侍中胡邈为傕所幸，呼传诏者，令饰其辞。又谓郦曰：‘李将军于卿不薄；又皇甫公为太尉，李将军力也。’郦答曰：‘胡敬才！卿为国家常伯，辅弼之臣也。语言如此，宁可用邪？’邈曰：‘念卿失李将军意，恐不易耳！我与卿何事者？’郦言：‘我累世受恩，身又常在帏幄；君辱臣死，当坐国家为李傕所杀，则天命也！’天子闻郦答语切，恐傕闻之，便敕遣郦。郦才出营门，傕遣虎贲王昌呼之。昌知郦忠直，纵令去；还答傕，言追之不及。天子使左中郎将李固，持节拜傕为大司马，在三公之右。傕自以为得鬼神之力，乃厚赐诸巫。”","attribution":"《献帝起居注》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":161,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-33c32b6c80ba50b749a6","start":0,"end":881,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p049","section":"chapter-006","block":"b-35cfbd89b795007423e6","layer":"pei","quote":"﹝三﹞《献帝纪》曰：“初，议者欲令天子浮河东下，太尉杨彪曰：‘臣弘农人，从此以东，有三十六滩；非万乘所当从也！’刘艾曰：‘臣前为陕令，知其危险；有师犹有倾覆，况今无师？太尉谋是也。’乃止。及当北渡，使李乐具船。天子步行趋河岸，岸高不得下。董承等谋欲以马羁相续，以系帝腰。时中宫仆伏德，扶中宫，一手持十匹绢；乃取德绢，连续为辇。行军校尉尚弘多力，令弘居前负帝，乃得下登船。其余不得渡者甚众，复遣船收诸不得渡者。皆争攀船，船上人以刃栎断其指；舟中之指可掬。”","attribution":"《献帝纪》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":179,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6ae51262f7f7704d518a","start":0,"end":227,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-8b2d447c179f5fa02f2e","section":"chapter-008","block":"b-6625e15615544094ec8f","layer":"original","quote":"粮乏，杨以粮迎道路，遂至洛阳。谓诸将曰：“天子，当与天下共之。幸有公卿大臣；杨当捍外难〖8〗，何事京都〖9〗？”遂还野王。即拜为大司马","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":146,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":20,"end":87,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-bec3188cfa2c7b265ac9","section":"chapter-008","block":"b-6625e15615544094ec8f","layer":"original","quote":"建安元年，杨奉、董承、韩暹挟天子还旧京","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":146,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"guanzhang-q-p006","section":"chapter-036","block":"b-6e874b1fd0bdb9bb227a","layer":"pei","quote":"臣松之以为：备后与董承等结谋，但事泄不克谐耳；若为国家惜曹公，其如此言何！羽若果有此劝而备不肯从者，将以曹公腹心亲戚，实繁有徒，事不宿构，非造次所行；曹虽可杀，身必不免：故以计而止，何惜之有乎！既往之事，故托为雅言耳。","attribution":"裴松之论","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":34,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6f26254c4fa6d4284f43","start":0,"end":109,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-p046","section":"chapter-046","block":"b-0df888008b92c8896d19","layer":"pei","quote":"﹝八﹞《江表传》曰：“策被诏敕，与司空曹公、卫将军董承、益州牧刘璋等，并力讨袁术、刘表。军严当进，会术死。术从弟胤、女婿黄猗等，畏惧曹公，不敢守寿春；乃共舁术棺柩，扶其妻子及部曲男女，就刘勋于皖城。勋粮食少，无以相赈；乃遣从弟偕，告籴于豫章太守华歆。歆郡素少谷，遣吏将偕，就海昏、上缭，使诸宗帅共出三万斛米以与偕。偕往历月，才得数千斛。偕乃报勋，具说形状，使勋来袭取之。勋得偕书，使潜军到海昏邑下。宗帅知之，空壁逃匿，勋了无所得。时策西讨黄祖，行及石城。闻勋轻身诣海昏，便分遣从兄贲、辅，率八千人，于彭泽待勋；自与周瑜率二万人，步袭皖城，即克之，得术百工及鼓吹部曲三万余人，并术、勋妻子。表用汝南李术为庐江太守，给兵三千人以守皖；皆徙所得人，东诣吴。贲、辅又于彭泽破勋。勋走入楚江，从寻阳步上到置马亭；闻策等已克皖，乃投西塞。至沂，筑垒自守；告急于刘表，求救于黄祖。祖遣太子射、船军五千人，助勋。策复就攻，大破勋。勋与偕，北归曹公，射亦遁走。策收得勋兵二千余人，船千艘；遂前进夏口，攻黄祖。时刘表遣从子虎、南阳韩晞，将长矛五千，来为黄祖前锋。策与战，大破之。”","attribution":"《江表传》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":257,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-344fcece1d1f127d763a","start":0,"end":480,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o040b-q","section":"chapter-001","block":"b-c71d10ef121af30ac6b7","layer":"original","quote":"太祖将迎天子，诸将或疑；荀彧、程昱劝之。乃遣曹洪将兵西迎。卫将军董承与袁术将苌奴拒险〖3〗，洪不得进。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":258,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":32,"end":83,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o069a-q","section":"chapter-001","block":"b-b951d04332712c30fc16","layer":"original","quote":"备之未东也，阴与董承等谋反。至下邳，遂杀徐州刺史车胄，举兵屯沛〖26〗。遣刘岱、王忠击之，不克。﹝一﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":366,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":51,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o071a-q","section":"chapter-001","block":"b-c9f735ddad48a8f5c2b6","layer":"original","quote":"五年春正月〖1〗，董承等谋泄，皆伏诛。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":400,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-16a5462151b1cfe5142d","section":"chapter-001","block":"b-16a5462151b1cfe5142d","layer":"modern","quote":"〖1〗建安元年：公元 196 年。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":264,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-df2756e12f4ac1fef3c4","start":0,"end":17,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-51bced16741add42ff70","section":"chapter-001","block":"b-51bced16741add42ff70","layer":"modern","quote":"〖1〗四年：建安四年（公元 199）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":369,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-20628d34a709162c77f0","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-9900125064e5d85f08ad","section":"chapter-001","block":"b-9900125064e5d85f08ad","layer":"modern","quote":"〖1〗五年：建安五年（公元 200）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":403,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-744e4aee7f5ff14cca85","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o040","section":"chapter-001","block":"b-c71d10ef121af30ac6b7","layer":"original","quote":"建安元年春正月〖1〗，太祖军临武平〖2〗。袁术所置陈相袁嗣，降。太祖将迎天子，诸将或疑；荀彧、程昱劝之。乃遣曹洪将兵西迎。卫将军董承与袁术将苌奴拒险〖3〗，洪不得进。汝南、颍川黄巾何仪、刘辟、黄邵、何曼等〖4〗，众各数万。初应袁术，又附孙坚〖5〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":258,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":124,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o061","section":"chapter-001","block":"b-502d4e8c0ed143eaa30d","layer":"original","quote":"四年春二月〖1〗，公还至昌邑〖2〗。张杨将杨丑杀杨〖3〗。眭固又杀丑，以其众属袁绍，屯射犬〖4〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":358,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":49,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o069","section":"chapter-001","block":"b-b951d04332712c30fc16","layer":"original","quote":"备之未东也，阴与董承等谋反。至下邳，遂杀徐州刺史车胄，举兵屯沛〖26〗。遣刘岱、王忠击之，不克。﹝一﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":366,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":51,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o071","section":"chapter-001","block":"b-c9f735ddad48a8f5c2b6","layer":"original","quote":"五年春正月〖1〗，董承等谋泄，皆伏诛。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":400,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o169","section":"chapter-001","block":"b-89f12ebaccdb3d3de5ca","layer":"original","quote":"十一月，汉皇后伏氏坐昔与父故屯骑校尉完书〖11〗，云帝以董承被诛怨恨公，辞甚丑恶；发闻〖12〗，后废黜死，兄弟皆伏法。﹝四﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":288,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":62,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o015b-q","section":"chapter-032","block":"b-98e30108a13f2ee6046a","layer":"original","quote":"先主未出时，献帝舅车骑将军董承，﹝一﹞辞受帝衣带中密诏〖1〗，当诛曹公。先主未发。是时，曹公从容谓先主曰〖2〗：“今天下英雄，唯使君与操耳！本初之徒〖3〗，不足数也〖4〗。”先主方食，失匕箸〖5〗。﹝二﹞遂与承及长水校尉种辑、将军吴子兰、王子服等同谋。会见使〖6〗，未发。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":70,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":136,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o016a-q","section":"chapter-032","block":"b-b2ba16ddd29a37182478","layer":"original","quote":"事觉，承等皆伏诛；","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":71,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":9,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o016b-q","section":"chapter-032","block":"b-b2ba16ddd29a37182478","layer":"original","quote":"先主据下邳，灵等还。先主乃杀徐州刺史车胄，留关羽守下邳，而身还小沛。﹝四﹞","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":71,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":12,"end":49,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o014","section":"chapter-032","block":"b-9236c229b2cd9315f1e3","layer":"original","quote":"袁术欲经徐州北就袁绍，曹公遣先主督朱灵、路招要击术〖4〗。未至，术病死。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":60,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":36,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o015","section":"chapter-032","block":"b-98e30108a13f2ee6046a","layer":"original","quote":"先主未出时，献帝舅车骑将军董承，﹝一﹞辞受帝衣带中密诏〖1〗，当诛曹公。先主未发。是时，曹公从容谓先主曰〖2〗：“今天下英雄，唯使君与操耳！本初之徒〖3〗，不足数也〖4〗。”先主方食，失匕箸〖5〗。﹝二﹞遂与承及长水校尉种辑、将军吴子兰、王子服等同谋。会见使〖6〗，未发。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":70,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":136,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o016","section":"chapter-032","block":"b-b2ba16ddd29a37182478","layer":"original","quote":"事觉，承等皆伏诛；﹝三﹞先主据下邳，灵等还。先主乃杀徐州刺史车胄，留关羽守下邳，而身还小沛。﹝四﹞","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":71,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":49,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o052","section":"chapter-032","block":"b-13bc0548f92b946e57ac","layer":"original","quote":"昔唐尧至圣，而四凶在朝〖18〗；周成仁贤，而四国作难〖19〗；高后称制，而诸吕窃命〖20〗；孝昭幼冲，而上官逆谋〖21〗：皆凭世宠〖22〗，藉履国权〖23〗，穷凶极乱，社稷几危。非大舜、周公、朱虚、博陆〖24〗，则不能流放擒讨，安危定倾。伏惟陛下诞姿圣德，统理万邦；而遭厄运不造之艰〖25〗。董卓首难〖26〗，荡覆京畿；曹操阶祸〖27〗，窃执天衡〖28〗；皇后太子〖29〗，鸩杀见害；剥乱天下，残毁民物〖30〗。久令陛下蒙尘忧厄，幽处虚邑〖31〗；人神无主，遏绝王命；厌昧皇极〖32〗，欲盗神器。左将军、领司隶校尉、豫、荆、益三州牧宜城亭侯备，受朝爵秩，念在输力〖33〗，以殉国难。睹其机兆〖34〗，赫然愤发；与车骑将军董承同谋诛操，将安国家，克宁旧都。会承机事不密，令操游魂得遂长恶〖35〗，残泯海内。臣等每惧王室大有阎乐之祸〖36〗，小有定安之变〖37〗；﹝二﹞夙夜惴惴，战栗累息。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":207,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":393,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o057","section":"chapter-032","block":"b-238d2ad5a45d1607b403","layer":"original","quote":"“臣以具臣之才〖1〗，荷上将之任〖2〗，董督三军〖3〗，奉辞于外；不能扫除寇难，靖匡王室；久使陛下圣教陵迟，六合之内，否而未泰；惟忧反侧，疢如疾首〖4〗。曩者董卓，造为乱阶〖5〗；自是之后，群凶纵横，残剥海内。赖陛下圣德威灵，人神同应；或忠义奋讨，或上天降罚；暴逆并殪〖6〗，以渐冰消。唯独曹操，久未枭除；侵擅国权，恣心极乱。臣昔与车骑将军董承，图谋讨操；机事不密，承见陷害；臣播越失据〖7〗，忠义不果；遂得使操穷凶极逆，主后戮杀，皇子鸩害。虽纠合同盟，念在奋力；懦弱不武〖8〗，历年未效。常恐殒没，孤负国恩〖9〗；寤寐咏叹〖10〗，夕惕若厉〖11〗。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":276,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":276,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-p013","section":"chapter-032","block":"b-4a52194b7e591242c0bd","layer":"pei","quote":"﹝一﹞臣松之按：董承，汉灵帝母董太后之侄，于献帝为丈人；盖古无丈人之名，故谓之“舅”也。","attribution":"裴松之按语","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":85,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0f86313f310eba82dfc8","start":0,"end":44,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-p015","section":"chapter-032","block":"b-0d8e9f21bdf4f1bf3c89","layer":"pei","quote":"﹝三﹞《献帝起居注》曰：“承等与备谋，未发，而备出。承谓服曰：‘郭多有数百兵，坏李傕数万人；但足下与我同不耳？昔吕不韦之门，须子楚而后高；今吾与子由是也。’服曰：‘惶惧，不敢当；且兵又少。’承曰：‘举事讫，得曹公成兵，顾不足邪？’服曰：‘今京师岂有所任乎？’承曰：‘长水校尉种辑、议郎吴硕，是我腹心办事者。’遂定计。”","attribution":"《献帝起居注》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":87,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-76002ddfdc53c4d46244","start":0,"end":159,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-p015-qiju","section":"chapter-032","block":"b-0d8e9f21bdf4f1bf3c89","layer":"pei","quote":"﹝三﹞《献帝起居注》曰：“承等与备谋，未发，而备出。承谓服曰：‘郭多有数百兵，坏李傕数万人；但足下与我同不耳？昔吕不韦之门，须子楚而后高；今吾与子由是也。’服曰：‘惶惧，不敢当；且兵又少。’承曰：‘举事讫，得曹公成兵，顾不足邪？’服曰：‘今京师岂有所任乎？’承曰：‘长水校尉种辑、议郎吴硕，是我腹心办事者。’遂定计。”","attribution":"《献帝起居注》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":87,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-76002ddfdc53c4d46244","start":0,"end":159,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-p023","section":"chapter-010","block":"b-fc4215d18c32c8779800","layer":"pei","quote":"《献帝春秋》曰：“董承之诛，伏后与父完书，言‘司空杀董承，帝方为报怨’。完得书以示彧，彧恶之，久隐而不言。完以示妻弟樊普，普封以呈太祖；太祖阴为之备。彧后恐事觉，欲自发之；因求使至邺，劝太祖以女配帝。太祖曰：‘今朝廷有伏后，吾女何得以配上；吾以微功见录，位为宰相，岂复赖女宠乎！’彧曰：‘伏后无子，性又凶邪；往常与父书，言辞丑恶：可因此废也。’太祖曰：‘卿昔何不道之？’彧佯惊曰：‘昔已尝为公言也！’太祖曰：‘此岂小事，而吾忘之！’彧又惊曰：‘诚未语公邪？昔公在官渡与袁绍相持，恐增内顾之念，故不言尔。’太祖曰：‘官渡事后何以不言？’彧无对，谢缺而已。太祖以此恨彧，而外含容之，故世莫得知。至董昭建立魏公之议，彧意不同，欲言之于太祖。及赍玺书犒军，饮飨礼毕；彧留，请闲。太祖知彧欲言封事，揖而遣之，彧遂不得言。彧卒于寿春。寿春亡者告孙权，言太祖‘使彧杀伏后，彧不从，故自杀’。权以露布于蜀，刘备闻之，曰：‘老贼不死，祸乱未已！’”","attribution":"《献帝春秋》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":169,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-e9f2abc222316e1535f8","start":0,"end":415,"offset_unit":"unicode_code_point"},{"id":"zhangle-q-o039","section":"chapter-017","block":"b-326b70d27f4056f70d0f","layer":"original","quote":"徐晃字公明，河东杨人也。为郡吏。从车骑将军杨奉讨贼，有功，拜骑都尉。李傕、郭汜之乱长安也，晃说奉，令与天子还洛阳；奉从其计，天子渡河至安邑，封晃都亭侯。及到洛阳，韩暹、董承日争斗，晃说奉令归太祖。奉欲从之，后悔；太祖讨奉于梁，晃遂归太祖。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":144,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":119,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
