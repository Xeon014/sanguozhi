{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhanggu-e-o083","title":"骘旌修刺奉瓜献焦征羌","accounts":[{"id":"zhanggu-a-31d0088cb2854829d3e4","label":"正文","text":"骘旌修刺奉瓜献焦征羌","evidence":["zhanggu-q-0043d928ea8e4b906288"]}],"participants":[{"person":"shaodi-p0007","role":"与旌求食其地惧为所侵、乃共修刺奉瓜以献征羌","evidence":["zhanggu-q-0043d928ea8e4b906288"]},{"person":"panlu-p0007","role":"同献者","evidence":["zhanggu-q-0043d928ea8e4b906288"]},{"person":"zhanggu-p0021","role":"会稽人、郡之豪族、人客放纵","evidence":["zhanggu-q-0043d928ea8e4b906288"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["zhanggu-q-0043d928ea8e4b906288"]},"ordering_evidence":"zhanggu-q-0043d928ea8e4b906288","source_order":[52,339,35],"order":9363},{"id":"zhanggu-e-o084","title":"征羌牖外见骘旌小盘饭待之","accounts":[{"id":"zhanggu-a-7ec043fed1061cdde7e5","label":"正文","text":"征羌牖外见骘旌小盘饭待之","evidence":["zhanggu-q-735fa26e4d9021f67ed9"]}],"participants":[{"person":"zhanggu-p0021","role":"方在内卧驻之移时、良久开牖见之身隐几坐帐中设席致地坐骘旌于牖外、作食身享大案肴膳重沓以小盘饭与骘旌惟菜茹而已","evidence":["zhanggu-q-735fa26e4d9021f67ed9"]},{"person":"shaodi-p0007","role":"辞色自若、极饭致饱乃辞出","evidence":["zhanggu-q-735fa26e4d9021f67ed9"]},{"person":"panlu-p0007","role":"愈耻之、不能食","evidence":["zhanggu-q-735fa26e4d9021f67ed9"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["zhanggu-q-735fa26e4d9021f67ed9"]},"ordering_evidence":"zhanggu-q-735fa26e4d9021f67ed9","source_order":[52,340,0],"order":9364}],"persons":[{"id":"zhanggu-p0021","name":"焦征羌","evidence":["zhanggu-q-0043d928ea8e4b906288","zhanggu-q-735fa26e4d9021f67ed9","zhanggu-q-7d8203214f4238d9f015"],"facts":[{"id":"zhanggu-f-cb9aca3a822639858efb","text":"名矫，尝为征羌令。","evidence":["zhanggu-q-7d8203214f4238d9f015"]}],"aliases":[],"mentions":[]}],"evidence":[{"id":"zhanggu-q-0043d928ea8e4b906288","section":"chapter-052","block":"b-00588e77221aff009756","layer":"original","quote":"会稽焦征羌〖2〗，郡之豪族，﹝三﹞人客放纵。骘与旌求食其地，惧为所侵；乃共修刺奉瓜〖3〗，以献征羌","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":338,"anchor":null},"note_id":null,"start":35,"end":84},{"id":"zhanggu-q-735fa26e4d9021f67ed9","section":"chapter-052","block":"b-3ed014dddc21c2a5ff6b","layer":"original","quote":"征羌方在内卧，驻之移时。旌欲委去，骘止之曰：“本所以来，畏其强也；而今舍去，欲以为高，只结怨耳！”良久，征羌开牖见之〖4〗。身隐几，坐帐中〖5〗；设席致地，坐骘、旌于牖外。旌愈耻之，骘辞色自若。征羌作食，身享大案，肴膳重沓〖6〗；以小盘饭与骘、旌，惟菜茹而已〖7〗。旌不能食，骘极饭致饱，乃辞出","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":339,"anchor":null},"note_id":null,"start":0,"end":147},{"id":"zhanggu-q-7d8203214f4238d9f015","section":"chapter-052","block":"b-2a7379750898ac3adcc2","layer":"pei","quote":"﹝三﹞《吴录》曰：“征羌名矫。尝为征羌令。”","attribution":"裴注·吴录","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":353,"anchor":null},"note_id":"n-9f74b3c56b0bc560dab5","start":0,"end":22}],"profiles":{},"directory_counts":{}}
