udi-q-p043","section":"chapter-001","block":"b-f0e2cb19925f21116fbb","layer":"pei","quote":"﹝一﹞《献帝春秋》曰：“天子初至洛阳，幸城西故中常侍赵忠宅。使张杨缮治宫室，名殿曰‘杨安殿’。八月，帝乃迁居。”","attribution":"《献帝春秋》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":279,"anchor":null},"note_id":"n-066505794915ec82cc60","start":0,"end":56}],"profiles":{},"directory_counts":{}}
