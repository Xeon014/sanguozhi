g-q-13dc8ea2fc86f34a5ffb"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[{"id":"lvzang-q-13dc8ea2fc86f34a5ffb","section":"chapter-007","block":"b-630d90f48255ffda7b80","layer":"pei","quote":"备中郎将丹杨许耽，夜遣司马章诳来诣布，言：‘张益德与下邳相曹豹共争，益德杀豹；城中大乱，不相信。丹杨兵有千人屯西白门城内，闻将军来东，大小踊跃，如复更生。将军兵向城西门，丹杨军便开门纳将军矣","attribution":"裴注·英雄记","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":76,"anchor":null},"note_id":"n-c3c03b97c67239fef561","start":23,"end":118},{"id":"lvzang-q-4363f895496c8c4093a4","section":"chapter-007","block":"b-630d90f48255ffda7b80","layer":"pei","quote":"布遂夜进，晨到城下。天明，丹杨兵悉开门，纳布兵。布于门上坐，步骑放火，大破益德兵，获备妻子军资及部曲将吏士家口","attribution":"裴注·英雄记","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":76,"anchor":null},"note_id":"n-c3c03b97c67239fef561","start":120,"end":175},{"id":"lvzang-q-5101f049546298ab705f","section":"chapter-007","block":"b-630d90f48255ffda7b80","layer":"pei","quote":"张益德与下邳相曹豹共争，益德杀豹；城中大乱，不相信","attribution":"裴注·英雄记","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":76,"anchor":null},"note_id":"n-c3c03b97c67239fef561","start":45,"end":70},{"id":"lvzang-q-c2736f75092f4f47b6db","section":"chapter-007","block":"b-f03f33c3a4feb9149046","layer":"original","quote":"备东击术，布袭取下邳。备还归布","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":63,"anchor":null},"note_id":null,"start":0,"end":15},{"id":"xumisun-q-7cf2833d6b8800fdba3b","section":"chapter-038","block":"b-9dceb360e52be8061153","layer":"original","quote":"建安元年，吕布乘先主之出拒袁术，袭下邳，虏先主妻子","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":174,"anchor":null},"note_id":null,"start":0,"end":25}],"profiles":{},"directory_counts":{}}
