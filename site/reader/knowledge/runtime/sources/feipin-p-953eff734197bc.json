f2c2c2","feipin-q-e20369a6905afcf4fd5b","feipin-q-43037a97703d903e06a6","feipin-q-a554b346d22036da044b"],"facts":[{"id":"feipin-f-8dae861a86ecb44c1fce","text":"籍贯：南阳","evidence":["feipin-q-a554b346d22036da044b"]}],"mentions":[],"aliases":[]}],"evidence":[{"id":"feipin-q-43037a97703d903e06a6","section":"chapter-050","block":"b-37158020989df60a8811","layer":"original","quote":"及和为太子，和母贵重；诸姬有宠者，皆出居外：夫人出公安〖1〗，卒，因葬焉。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":92,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":27,"end":64,"offset_unit":"unicode_code_point"},{"id":"feipin-q-a554b346d22036da044b","section":"chapter-050","block":"b-37158020989df60a8811","layer":"original","quote":"吴主权王夫人，南阳人也。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":92,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":12,"offset_unit":"unicode_code_point"},{"id":"feipin-q-e20369a6905afcf4fd5b","section":"chapter-050","block":"b-37158020989df60a8811","layer":"original","quote":"吴主权王夫人，南阳人也。以选入宫，嘉禾中得幸，生孙休。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":92,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":27,"offset_unit":"unicode_code_point"},{"id":"feipin-q-f98ca3c9bb006ff2c2c2","section":"chapter-050","block":"b-d327d3bb5fc6ae13bf32","layer":"original","quote":"休即位，遣使追尊曰敬怀皇后，改葬敬陵。王氏无后，封同母弟文雍，为亭侯。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":93,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":35,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
