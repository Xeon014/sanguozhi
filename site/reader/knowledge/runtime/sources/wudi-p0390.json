{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p143a","title":"侯音因徭役起事与关羽连和","accounts":[{"id":"wudi-e-p143a-account","label":"《曹瞒传》","text":"《曹瞒传》记南阳苦徭役，侯音执东里衮，与吏民起事，联络关羽。","evidence":["wudi-e-p143a-q"]}],"participants":[{"person":"wudi-p0382","role":"起事","evidence":["wudi-e-p143a-q"]},{"person":"wudi-p0390","role":"被执","evidence":["wudi-e-p143a-q"]},{"person":"wudi-p0172","role":"被联络","evidence":["wudi-e-p143a-q"]}],"place":{"text":"南阳","evidence":["wudi-e-p143a-q"]},"time":{"label":"建安二十三年侯音起事时","year":218,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-p143a-q","wudi-q-o188","wudi-q-b-ac93ccb47f6e7be3aea4"],"chronology":"wudi-y218","dating_review":{"anchor":"wudi-q-o188","basis":"建安二十三年侯音起事时","reviewed":true}},"source_order":[1,1111,"P143a"],"order":432},{"id":"wudi-e-p143b","title":"宗子卿说释太守后围侯音","accounts":[{"id":"wudi-e-p143b-account","label":"《曹瞒传》","text":"宗子卿劝侯音释放东里衮，后夜逃与太守收民围侯音，曹仁军到后共同灭之。","evidence":["wudi-e-p143b-q"]}],"participants":[{"person":"wudi-p0391","role":"说释放后围攻","evidence":["wudi-e-p143b-q"]},{"person":"wudi-p0382","role":"释人后败亡","evidence":["wudi-e-p143b-q"]},{"person":"wudi-p0390","role":"获释围攻","evidence":["wudi-e-p143b-q"]},{"person":"cao-ren","role":"合击","evidence":["wudi-e-p143b-q"]}],"place":{"text":"宛","evidence":["wudi-e-p143b-q"]},"time":{"label":"侯音起事至曹仁到宛","precision":"relative","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p143b-q"],"after":"wudi-e-o193a"},"source_order":[1,1111,"P143b"],"order":433},{"id":"shaodi-e-o131b","title":"应余救东里衮而死","accounts":[{"id":"shaodi-e-o131b-account","label":"《三少帝纪》正文","text":"应余救东里衮而死","evidence":["shaodi-e-o131b-q"]}],"participants":[{"person":"shaodi-p0122","role":"救主","evidence":["shaodi-e-o131b-q"]},{"person":"wudi-p0390","role":"被救","evidence":["shaodi-e-o131b-q"]}],"place":null,"time":{"label":"昔南阳郡山贼扰攘","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["shaodi-e-o131b-q"]},"ordering_evidence":"shaodi-e-o131b-q","source_order":[4,578,"O131b"],"order":1199},{"id":"shaodi-e-p035b","title":"侯音反应余冒矢救东里衮身死","accounts":[{"id":"shaodi-e-p035b-account","label":"《楚国先贤传》","text":"侯音反应余冒矢救东里衮身死","evidence":["shaodi-e-p035b-q"]}],"participants":[{"person":"wudi-p0382","role":"起兵","evidence":["shaodi-e-p035b-q"]},{"person":"shaodi-p0122","role":"救主","evidence":["shaodi-e-p035b-q"]},{"person":"wudi-p0390","role":"被救","evidence":["shaodi-e-p035b-q"]}],"place":null,"time":{"label":"建安二十三年","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["shaodi-e-p035b-q"]},"ordering_evidence":"shaodi-e-p035b-q","source_order":[4,618,"P035b"],"related_events":[{"event":"wudi-e-o193a","type":"related","evidence":["shaodi-e-p035b-q","wudi-e-o193a-q"]}],"order":1205},{"id":"shaodi-e-p036a","title":"东里衮后为于禁司马","accounts":[{"id":"shaodi-e-p036a-account","label":"裴注引《魏略·游说传》","text":"东里衮后为于禁司马","evidence":["shaodi-e-p036a-q"]}],"participants":[{"person":"wudi-p0390","role":"任司马","evidence":["shaodi-e-p036a-q"]}],"place":null,"time":{"label":"衮后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["shaodi-e-p036a-q"]},"ordering_evidence":"shaodi-e-p036a-q","source_order":[4,619,"P036a"],"order":1207},{"id":"wuzhu-e-p028b","title":"孙权遣浩周东里衮致笺曹丕解释归俘未果","accounts":[{"id":"wuzhu-e-p028b-account","label":"《魏略》","text":"孙权遣浩周东里衮致笺曹丕解释归俘未果","evidence":["wuzhu-e-p028b-q"]}],"participants":[{"person":"sun-quan","role":"遣使","evidence":["wuzhu-e-p028b-q"]},{"person":"wudi-p0170","role":"受笺","evidence":["wuzhu-e-p028b-q"]},{"person":"wuzhu-p0029","role":"奉使","evidence":["wuzhu-e-p028b-q"]},{"person":"wudi-p0390","role":"奉使","evidence":["wuzhu-e-p028b-q"]}],"place":null,"time":{"label":"浩周建安仕宦至曹丕为魏王时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["wuzhu-e-p028b-q"]},"ordering_evidence":"wuzhu-e-p028b-q","source_order":[47,346,"P028b"],"order":8231},{"id":"wuzhu-e-p031a","title":"曹丕问浩周东里衮孙权臣服两人异议","accounts":[{"id":"wuzhu-e-p031a-account","label":"《魏略》","text":"曹丕问浩周东里衮孙权臣服两人异议","evidence":["wuzhu-e-p031a-q"]}],"participants":[{"person":"wudi-p0170","role":"询问","evidence":["wuzhu-e-p031a-q"]},{"person":"wuzhu-p0029","role":"陈说","evidence":["wuzhu-e-p031a-q"]},{"person":"wudi-p0390","role":"陈说","evidence":["wuzhu-e-p031a-q"]}],"place":null,"time":{"label":"浩周东里衮还魏至孙权不遣子时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["wuzhu-e-p031a-q"]},"ordering_evidence":"wuzhu-e-p031a-q","source_order":[47,349,"P031a"],"order":8235}],"persons":[{"id":"wudi-p0390","name":"东里衮","evidence":["wudi-q-p143","shaodi-q-o131","wuzhu-q-p028"],"facts":[],"aliases":[],"mentions":[{"id":"wudi-m-p143-wudi-p0390","kind":"mention","text":"文中提及","evidence":["wudi-q-p143"]},{"id":"shaodi-m-o131-wudi-p0390","kind":"mention","text":"文中提及","evidence":["shaodi-q-o131"]},{"id":"shaodi-m-p035-wudi-p0390","kind":"mention","text":"文中提及","evidence":["shaodi-q-p035"]},{"id":"shaodi-m-p036-wudi-p0390","kind":"mention","text":"文中提及","evidence":["shaodi-q-p036"]},{"id":"wuzhu-m-p028-wudi-p0390","kind":"mention","text":"文中提及","evidence":["wuzhu-q-p028"]},{"id":"wuzhu-m-p031-wudi-p0390","kind":"mention","text":"文中提及","evidence":["wuzhu-q-p031"]}]}],"evidence":[{"id":"shaodi-e-o131b-q","section":"chapter-004","block":"b-b757e5d43e0e9b9da4e8","layer":"original","quote":"六月，丙子〖14〗，诏曰：“昔南阳郡山贼扰攘〖15〗，欲劫质故太守东里衮〖16〗。功曹应余独身捍衮〖17〗，遂免于难。余颠沛殒毙，杀身济君〖18〗。其下司徒〖19〗：署余孙伦吏〖20〗，使蒙伏节之报〖21〗”﹝一﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":577,"anchor":null},"note_id":null,"start":0,"end":107},{"id":"shaodi-e-p035b-q","section":"chapter-004","block":"b-26e03b3ad17e56cbdf8f","layer":"pei","quote":"﹝一﹞《楚国先贤传》曰：“余字子正。天姿方毅，志尚仁义。建安二十三年为郡功曹。是时吴、蜀不宾，疆埸多虞。宛将侯音，扇动山民，保城以叛。余与太守东里衮，当扰攘之际，进窜得出。音即遣骑追逐，去城十里相及；贼便射衮，飞矢交流。余前以身当箭，被七创。因谓追贼曰：‘侯音狂狡，造为凶逆，大军寻至，诛夷在近。谓卿曹本是善人，素无恶心；当思反善，何为受其指挥？我以身代君，已被重创；若身死君全，陨没无恨！’因仰天号哭泣涕，血泪俱下。贼见其义烈，释衮不害。贼去之后，余亦命绝。征南将军曹仁讨平音，表余行状，并修祭醊。太祖闻之，嗟叹良久。下荆州：复表门闾，赐谷千斛。”","attribution":"《楚国先贤传》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":25,"anchor":null},"note_id":"n-7dcbf2833a9c8d0368aa","start":0,"end":275},{"id":"shaodi-e-p036a-q","section":"chapter-004","block":"b-42ff2fc582106d220403","layer":"pei","quote":"衮后为于禁司马，见《魏略•游说传》。","attribution":"裴注引《魏略·游说传》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":26,"anchor":null},"note_id":"n-7dcbf2833a9c8d0368aa","start":0,"end":18},{"id":"shaodi-q-o131","section":"chapter-004","block":"b-b757e5d43e0e9b9da4e8","layer":"original","quote":"六月，丙子〖14〗，诏曰：“昔南阳郡山贼扰攘〖15〗，欲劫质故太守东里衮〖16〗。功曹应余独身捍衮〖17〗，遂免于难。余颠沛殒毙，杀身济君〖18〗。其下司徒〖19〗：署余孙伦吏〖20〗，使蒙伏节之报〖21〗”﹝一﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":577,"anchor":null},"note_id":null,"start":0,"end":107},{"id":"shaodi-q-p035","section":"chapter-004","block":"b-26e03b3ad17e56cbdf8f","layer":"pei","quote":"﹝一﹞《楚国先贤传》曰：“余字子正。天姿方毅，志尚仁义。建安二十三年为郡功曹。是时吴、蜀不宾，疆埸多虞。宛将侯音，扇动山民，保城以叛。余与太守东里衮，当扰攘之际，进窜得出。音即遣骑追逐，去城十里相及；贼便射衮，飞矢交流。余前以身当箭，被七创。因谓追贼曰：‘侯音狂狡，造为凶逆，大军寻至，诛夷在近。谓卿曹本是善人，素无恶心；当思反善，何为受其指挥？我以身代君，已被重创；若身死君全，陨没无恨！’因仰天号哭泣涕，血泪俱下。贼见其义烈，释衮不害。贼去之后，余亦命绝。征南将军曹仁讨平音，表余行状，并修祭醊。太祖闻之，嗟叹良久。下荆州：复表门闾，赐谷千斛。”","attribution":"《楚国先贤传》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":25,"anchor":null},"note_id":"n-7dcbf2833a9c8d0368aa","start":0,"end":275},{"id":"shaodi-q-p036","section":"chapter-004","block":"b-42ff2fc582106d220403","layer":"pei","quote":"衮后为于禁司马，见《魏略•游说传》。","attribution":"裴注引《魏略·游说传》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":26,"anchor":null},"note_id":"n-7dcbf2833a9c8d0368aa","start":0,"end":18},{"id":"wudi-e-o193a-q","section":"chapter-001","block":"b-21f24b8f57341b1dcb4e","layer":"original","quote":"冬十月，宛守将侯音等反；执南阳太守，劫略吏民，保宛。初，曹仁讨关羽，屯樊城；是月，使仁围宛。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":401,"anchor":null},"note_id":null,"start":0,"end":46},{"id":"wudi-e-p143a-q","section":"chapter-001","block":"b-7b243201ddfe4ecaad10","layer":"pei","quote":"是时，南阳间苦徭役。音于是执太守东里（裦）〔衮〕，与吏民共反，与关羽连和。","attribution":"《曹瞒传》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":435,"anchor":null},"note_id":"n-8fe895a36710c7eeb225","start":11,"end":48},{"id":"wudi-e-p143b-q","section":"chapter-001","block":"b-7b243201ddfe4ecaad10","layer":"pei","quote":"南阳功曹宗子卿，往说音曰：‘足下顺民心，举大事，远近莫不望风；然执郡将，逆而无益；何不遣之？吾与子共戮力。比曹公军来，关羽兵亦至矣。’音从之，即释遣太守。子卿因夜逾城亡出，遂与太守收余民，围音。会曹仁军至，共灭之。","attribution":"《曹瞒传》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":435,"anchor":null},"note_id":"n-8fe895a36710c7eeb225","start":48,"end":155},{"id":"wudi-q-b-ac93ccb47f6e7be3aea4","section":"chapter-001","block":"b-ac93ccb47f6e7be3aea4","layer":"modern","quote":"〖1〗二十三年：建安二十三年（公元 218）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":403,"anchor":null},"note_id":"n-8cae36984cdc22e48444","start":0,"end":23},{"id":"wudi-q-o188","section":"chapter-001","block":"b-1336d4803d0b76311776","layer":"original","quote":"二十三年春正月〖1〗，汉太医令吉本与少府耿纪、司直韦晃等反〖2〗。攻许，烧丞相长史王必营〖3〗。﹝一﹞必与颍川典农中郎将严匡讨斩之〖4〗。﹝二﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":396,"anchor":null},"note_id":null,"start":0,"end":72},{"id":"wudi-q-p143","section":"chapter-001","block":"b-7b243201ddfe4ecaad10","layer":"pei","quote":"﹝一﹞《曹瞒传》曰：“是时，南阳间苦徭役。音于是执太守东里（裦）〔衮〕，与吏民共反，与关羽连和。南阳功曹宗子卿，往说音曰：‘足下顺民心，举大事，远近莫不望风；然执郡将，逆而无益；何不遣之？吾与子共戮力。比曹公军来，关羽兵亦至矣。’音从之，即释遣太守。子卿因夜逾城亡出，遂与太守收余民，围音。会曹仁军至，共灭之。”","attribution":"《曹瞒传》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":435,"anchor":null},"note_id":"n-8fe895a36710c7eeb225","start":0,"end":156},{"id":"wuzhu-e-p028b-q","section":"chapter-047","block":"b-05f967c12e50f5c473f5","layer":"pei","quote":"及文帝即王位，权乃遣周，为笺魏王曰：‘昔讨关羽，获于将军；即白先王，当发遣之。此乃奉款之心，不言而发。先王未深留意，而谓权中间复有异图。愚情\"\"，用未果决；遂值先王委离国祚，殿下承统，下情始通。公私契阔，未获备举；是令本誓，未即昭显。梁寓传命，委曲周至，深知殿下以为意望。权之赤心，不敢有他；愿垂明恕，保权所执。谨遣浩周、东里衮；至情至实，皆周等所具。’","attribution":"《魏略》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":345,"anchor":null},"note_id":"n-43467797fb37569f4074","start":54,"end":231},{"id":"wuzhu-e-p031a-q","section":"chapter-047","block":"b-7ff8d5c8e34643cb99dd","layer":"pei","quote":"初东里衮为于禁军司马，前与周俱没，又俱还到，有诏皆见之。帝问周等，周以为权必臣服；而东里衮，谓其不可必服。帝悦周言，以为有以知之。","attribution":"《魏略》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":348,"anchor":null},"note_id":"n-43467797fb37569f4074","start":0,"end":65},{"id":"wuzhu-q-p028","section":"chapter-047","block":"b-05f967c12e50f5c473f5","layer":"pei","quote":"“浩周字孔异，上党人。建安中，仕为萧令，至徐州刺史。后领护于禁军；军没，为关羽所得。权袭羽，并得周，甚礼之。及文帝即王位，权乃遣周，为笺魏王曰：‘昔讨关羽，获于将军；即白先王，当发遣之。此乃奉款之心，不言而发。先王未深留意，而谓权中间复有异图。愚情\"\"，用未果决；遂值先王委离国祚，殿下承统，下情始通。公私契阔，未获备举；是令本誓，未即昭显。梁寓传命，委曲周至，深知殿下以为意望。权之赤心，不敢有他；愿垂明恕，保权所执。谨遣浩周、东里衮；至情至实，皆周等所具。’","attribution":"《魏略》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":345,"anchor":null},"note_id":"n-43467797fb37569f4074","start":0,"end":231},{"id":"wuzhu-q-p031","section":"chapter-047","block":"b-7ff8d5c8e34643cb99dd","layer":"pei","quote":"初东里衮为于禁军司马，前与周俱没，又俱还到，有诏皆见之。帝问周等，周以为权必臣服；而东里衮，谓其不可必服。帝悦周言，以为有以知之。是岁冬，魏王受汉禅，遣使以权为吴王，诏使周与使者俱往。周既致诏命，时与权私宴，谓权曰：‘陛下未信王遣子入侍也，周以阖门百口明之！’权因字谓周曰：‘浩孔异！卿乃以举家百口保我，我当何言邪？’遂流涕沾襟。及与周别，又指天为誓。周还之后，权不遣子而设辞，帝乃久留其使。","attribution":"《魏略》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":348,"anchor":null},"note_id":"n-43467797fb37569f4074","start":0,"end":196}],"profiles":{},"directory_counts":{}}
