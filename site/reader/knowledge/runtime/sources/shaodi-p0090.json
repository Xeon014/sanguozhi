ull},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-62da5d107b0f07f7e09d","start":28,"end":44,"offset_unit":"unicode_code_point"},{"id":"cuimao-q-f2eee0121f17f3467844","section":"chapter-012","block":"b-4a44c3e5e62675d3ce24","layer":"pei","quote":"既免，辞诣廷尉，乞为官婢以赎女命","attribution":"裴注·干宝《晋纪》","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":256,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-62da5d107b0f07f7e09d","start":61,"end":77,"offset_unit":"unicode_code_point"},{"id":"huanchen-q-2c53e4e79f6ddf09fe15","section":"chapter-022","block":"b-901797ddbd952af29d74","layer":"pei","quote":"太常陈泰不至。使其舅荀顗召之，顗至，告以可否。泰曰：‘世之论者，以泰方于舅；今舅不如泰也。’子弟内外咸共逼之，垂涕而入。王待之曲室，谓曰：‘玄伯，卿何以处我？’对曰：‘诛贾充以谢天下。’文王曰：‘为我更思其次。’泰曰：‘泰言惟有进于此，不知其次","attribution":"裴注·干宝《晋纪》","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":307,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0bbc954a34e821268698","start":31,"end":153,"offset_unit":"unicode_code_point"},{"id":"huanchen-q-bee838a77f8dc425f309","section":"chapter-022","block":"b-4018998f7c6d83340671","layer":"original","quote":"司马文王语荀顗曰〖6〗：“玄伯沉勇能断〖7〗，荷方伯之重〖8〗，救将陷之城，而不求益兵；又希简上事，必能办贼故也。都督大将，不当尔邪","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":282,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":38,"end":104,"offset_unit":"unicode_code_point"},{"id":"lizang-q-4b7a0ca51616ea711dea","section":"chapter-018","block":"b-f3c9370bada62331f7ff","layer":"pei","quote":"司马文王初为晋王，司空荀顗要祥尽敬，祥不从","attribution":"裴注·注家按语","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":128,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-bac345b63c40d7fb8707","start":49,"end":70,"offset_unit":"unicode_code_point"},{"id":"shaodi-e-o172a-q","section":"chapter-004","block":"b-7741168fd487e5577b62","layer":"original","quote":"三月，丁丑〖8〗，以司空王祥为太尉，征北将军何曾为司徒，尚书左仆射荀顗为司空〖9〗。己卯〖10〗，进晋公爵为王〖11〗； 〔增〕 封十郡，并前二十。﹝一﹞丁亥〖12〗，封刘禅为安乐公〖13〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":221,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":96,"offset_unit":"unicode_code_point"},{"id":"shaodi-e-p029a-q","section":"chapter-004","block":"b-998852b68dd0c9e7af4d","layer":"pei","quote":"“二月，丙辰，帝宴群臣于太极东堂。与侍中荀顗 ，尚书崔赞、袁亮、钟毓，给事中、中书令虞松等，并讲述礼典。遂言帝王优劣之差，帝慕夏少康，因问顗等曰：‘有夏既衰，后相殆灭；少康收集夏众，复禹之绩。高祖拔起陇亩，驱帅豪俊；芟夷秦、项，包举宇内。斯二主可谓殊才异略，命世大贤者也。考其功德，谁宜为先？’顗等对曰：‘夫天下重器，王者天授；圣德应期，然后能受命创业。至于阶缘前绪，兴复旧绩；造之与因，难易不同。少康功德虽美，犹为中兴之君，与世祖同流可也。至如高祖，臣等以为优。’帝曰：‘自古帝王，功德言行，互有高下，未必创业者皆优，绍继者咸劣也。汤、武、高祖，虽俱受命；贤圣之分，所觉悬殊。少康、殷宗，中兴之美；夏启、周成，守文之盛。论德较实，方诸汉祖；吾见其优，未闻其劣；顾所遇之时殊，故所名之功异耳。少康生于灭亡之后，降为诸侯之隶；崎岖逃难，仅以身免。能布其德而兆其谋，卒灭过、戈，克复禹绩，祀夏配天，不失旧物；非至德弘仁，岂济斯勋？汉祖因土崩之势，仗一时之权，专任智力，以成功业；行事动静，多违圣检。为人子，则数危其亲；为人君，则囚系贤相；为人父，则不能卫子：身没之后，社稷几倾。若与少康易时而处，或未能复大禹之绩也。推此言之，宜高夏康而下汉祖矣。诸卿具论详之。’","attribution":"《魏氏春秋》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":396,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-be32dc82db4f0e2cc984","start":0,"end":529,"offset_unit":"unicode_code_point"},{"id":"shaodi-e-p057a-q","section":"chapter-004","block":"b-a9aba59d5fa2ff03e048","layer":"pei","quote":"﹝一﹞《汉晋春秋》曰：“晋公既进爵为王，太尉王祥、司从何曾、司空荀顗并诣王。顗曰：‘相王尊重，何侯与一朝之臣皆已尽敬。今日便当相率而拜，无所疑也。’祥曰：‘相国位势，诚为尊贵，然要是魏之宰相；吾等，魏之三公。公、王相去，一阶而已，班列大同。安有天子三公，可辄拜人者！损魏朝之望，亏晋王之德；君子爱人以礼，吾不为也！’及入，顗遂拜，而祥独长揖。王谓祥曰：‘今日然后知君见顾之重！’”","attribution":"《汉晋春秋》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":246,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-493794a4280db39895d4","start":0,"end":190,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-b-6209c552405e0ebbdf98","section":"chapter-004","block":"b-6209c552405e0ebbdf98","layer":"modern","quote":"〖1〗二年：甘露二年（公元 257 ）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":535,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4dd98e402a6a8de51491","start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-b-ded6d700dc6f860d1670","section":"chapter-004","block":"b-ded6d700dc6f860d1670","layer":"modern","quote":"〖1〗四年：景元四年（公元 263）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":201,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ef642248e44d01f3825d","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o080","section":"chapter-004","block":"b-5e69a7d6a960c6ff6623","layer":"original","quote":"甘露元年春正月辛丑〖1〗，青龙现轵县井中〖2〗。乙巳〖3〗，沛王林薨〖4〗。﹝一﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":386,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":41,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o117","section":"chapter-004","block":"b-d021e0b00f489a01f208","layer":"original","quote":"二年春二月〖1〗，青龙现温县井中。三月，司空卢毓薨。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":522,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":26,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o165","section":"chapter-004","block":"b-b35fdf03685051716720","layer":"original","quote":"四年春二月〖1〗，复命大将军进位、爵赐，一如前诏。又固辞，乃止。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":194,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":32,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o171","section":"chapter-004","block":"b-cef469d41ec5962b4e48","layer":"original","quote":"咸熙元年春正月，壬戌〖1〗，槛车征邓艾〖2〗。甲子〖3〗，行幸长安。壬申〖4〗，使使者以璧币祀华山〖5〗。是月，钟会反于蜀，为众所讨。邓艾亦见杀。二月，辛卯〖6〗，特赦诸在益土者。庚申〖7〗，葬明元郭后。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":220,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":102,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o172","section":"chapter-004","block":"b-7741168fd487e5577b62","layer":"original","quote":"三月，丁丑〖8〗，以司空王祥为太尉，征北将军何曾为司徒，尚书左仆射荀顗为司空〖9〗。己卯〖10〗，进晋公爵为王〖11〗； 〔增〕 封十郡，并前二十。﹝一﹞丁亥〖12〗，封刘禅为安乐公〖13〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":221,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":96,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-p029","section":"chapter-004","block":"b-998852b68dd0c9e7af4d","layer":"pei","quote":"“二月，丙辰，帝宴群臣于太极东堂。与侍中荀顗 ，尚书崔赞、袁亮、钟毓，给事中、中书令虞松等，并讲述礼典。遂言帝王优劣之差，帝慕夏少康，因问顗等曰：‘有夏既衰，后相殆灭；少康收集夏众，复禹之绩。高祖拔起陇亩，驱帅豪俊；芟夷秦、项，包举宇内。斯二主可谓殊才异略，命世大贤者也。考其功德，谁宜为先？’顗等对曰：‘夫天下重器，王者天授；圣德应期，然后能受命创业。至于阶缘前绪，兴复旧绩；造之与因，难易不同。少康功德虽美，犹为中兴之君，与世祖同流可也。至如高祖，臣等以为优。’帝曰：‘自古帝王，功德言行，互有高下，未必创业者皆优，绍继者咸劣也。汤、武、高祖，虽俱受命；贤圣之分，所觉悬殊。少康、殷宗，中兴之美；夏启、周成，守文之盛。论德较实，方诸汉祖；吾见其优，未闻其劣；顾所遇之时殊，故所名之功异耳。少康生于灭亡之后，降为诸侯之隶；崎岖逃难，仅以身免。能布其德而兆其谋，卒灭过、戈，克复禹绩，祀夏配天，不失旧物；非至德弘仁，岂济斯勋？汉祖因土崩之势，仗一时之权，专任智力，以成功业；行事动静，多违圣检。为人子，则数危其亲；为人君，则囚系贤相；为人父，则不能卫子：身没之后，社稷几倾。若与少康易时而处，或未能复大禹之绩也。推此言之，宜高夏康而下汉祖矣。诸卿具论详之。’","attribution":"《魏氏春秋》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":396,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-be32dc82db4f0e2cc984","start":0,"end":529,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-p030","section":"chapter-004","block":"b-8086012386da3c7e2bd6","layer":"pei","quote":"翌日丁巳，讲业既毕，顗、亮等议曰：‘三代建国，列土而治；当其衰弊，无土崩之势；可怀以德，难屈以力。逮至战国，强弱相兼；去道德而任智力，故秦之弊可以力争。少康布德，仁者之英也；高祖任力，智者之俊也。仁智不同，二帝殊矣！《诗》、《书》述殷中宗、高宗，皆列大雅；少康功美，过于二宗，其为大雅明矣！少康为优，宜如诏旨。’赞、毓、松等议曰：‘少康虽积德累仁，然上承大禹遗泽余庆；内有虞、仍之援，外有靡、艾之助。寒浞谗慝，不德于民；浇、豷无亲，外内弃之：以此有国，盖有所因。至于汉祖，起自布衣，率乌合之士，以成帝者之业。论德则少康优，课功则高祖多；语资则少康易，校时则高祖难。’帝曰：‘诸卿论少康因资，高祖创造，诚有之矣。然未知三代之世，任德济勋如彼之难；秦、项之际，任力成功如此之易。且太上立德，其次立功。汉祖功高，未若少康盛德之茂也。且夫仁者必有勇，诛暴必用武；少康武烈之威，岂必降于高祖哉？但夏书沦亡，旧文残缺，故勋美阙而罔载。唯有伍员粗述大略，其言复禹之绩，不失旧物；祖述圣业，旧章不愆：自非大雅兼才，孰能与于此？向令坟、典具存，行事详备，亦岂有异同之论哉？’于是群臣咸悦服。","attribution":"《魏氏春秋》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":397,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-be32dc82db4f0e2cc984","start":0,"end":486,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-p030-judgment","section":"chapter-004","block":"b-8086012386da3c7e2bd6","layer":"pei","quote":"翌日丁巳，讲业既毕，顗、亮等议曰：‘三代建国，列土而治；当其衰弊，无土崩之势；可怀以德，难屈以力。逮至战国，强弱相兼；去道德而任智力，故秦之弊可以力争。少康布德，仁者之英也；高祖任力，智者之俊也。仁智不同，二帝殊矣！《诗》、《书》述殷中宗、高宗，皆列大雅；少康功美，过于二宗，其为大雅明矣！少康为优，宜如诏旨。’赞、毓、松等议曰：‘少康虽积德累仁，然上承大禹遗泽余庆；内有虞、仍之援，外有靡、艾之助。寒浞谗慝，不德于民；浇、豷无亲，外内弃之：以此有国，盖有所因。至于汉祖，起自布衣，率乌合之士，以成帝者之业。论德则少康优，课功则高祖多；语资则少康易，校时则高祖难。’帝曰：‘诸卿论少康因资，高祖创造，诚有之矣。然未知三代之世，任德济勋如彼之难；秦、项之际，任力成功如此之易。且太上立德，其次立功。汉祖功高，未若少康盛德之茂也。且夫仁者必有勇，诛暴必用武；少康武烈之威，岂必降于高祖哉？但夏书沦亡，旧文残缺，故勋美阙而罔载。唯有伍员粗述大略，其言复禹之绩，不失旧物；祖述圣业，旧章不愆：自非大雅兼才，孰能与于此？向令坟、典具存，行事详备，亦岂有异同之论哉？’于是群臣咸悦服。","attribution":"《魏氏春秋》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":397,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-be32dc82db4f0e2cc984","start":0,"end":486,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-p057","section":"chapter-004","block":"b-a9aba59d5fa2ff03e048","layer":"pei","quote":"﹝一﹞《汉晋春秋》曰：“晋公既进爵为王，太尉王祥、司从何曾、司空荀顗并诣王。顗曰：‘相王尊重，何侯与一朝之臣皆已尽敬。今日便当相率而拜，无所疑也。’祥曰：‘相国位势，诚为尊贵，然要是魏之宰相；吾等，魏之三公。公、王相去，一阶而已，班列大同。安有天子三公，可辄拜人者！损魏朝之望，亏晋王之德；君子爱人以礼，吾不为也！’及入，顗遂拜，而祥独长揖。王谓祥曰：‘今日然后知君见顾之重！’”","attribution":"《汉晋春秋》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":246,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-493794a4280db39895d4","start":0,"end":190,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-8ca99046e769f6a4d16e","section":"chapter-021","block":"b-0000c2d0cca1b750f0c4","layer":"pei","quote":"与太尉荀顗撰定《新礼》；事未施行","attribution":"裴注·文章叙录","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":158,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-57f197b8737f0115a918","start":199,"end":215,"offset_unit":"unicode_code_point"},{"id":"xunyu-e-o032b-q","section":"chapter-010","block":"b-d8deea5750fd311b5afa","layer":"original","quote":"恽弟俣，御史中丞〖4〗；俣弟诜，大将军从事中郎：皆知名，早卒。﹝二﹞诜弟顗，咸熙中为司空〖5〗。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":172,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":20,"end":68,"offset_unit":"unicode_code_point"},{"id":"xunyu-e-p027a-q","section":"chapter-010","block":"b-1a042211a19edb530e3b","layer":"pei","quote":"幼为姊夫陈群所异，博学洽闻，意思慎密。司马宣王见顗，奇之，曰：‘荀令君之子也。近见袁侃，亦曜卿之子也。’擢拜散骑侍郎。顗佐命晋室，位至太尉，封临淮康公。","attribution":"《晋阳秋》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":185,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5921d94ec8d8ad2b9baa","start":17,"end":93,"offset_unit":"unicode_code_point"},{"id":"xunyu-e-p027b-q","section":"chapter-010","block":"b-1a042211a19edb530e3b","layer":"pei","quote":"尝难钟会‘《易》无互体’，见称于世。","attribution":"《晋阳秋》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":185,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5921d94ec8d8ad2b9baa","start":93,"end":111,"offset_unit":"unicode_code_point"},{"id":"xunyu-e-p031a-q","section":"chapter-010","block":"b-643aa55563b5613e764f","layer":"pei","quote":"武帝使侍中荀顗、和峤，俱至东宫，观察太子。顗还，称太子‘德识进茂’，而峤云‘圣质如初’。","attribution":"干宝《晋纪》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":189,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1cd39ba61e7c038ca47e","start":9,"end":53,"offset_unit":"unicode_code_point"},{"id":"xunyu-f0015-q","section":"chapter-010","block":"b-1a042211a19edb530e3b","layer":"pei","quote":"顗，字景倩","attribution":"《晋阳秋》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":185,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5921d94ec8d8ad2b9baa","start":11,"end":16,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-o032","section":"chapter-010","block":"b-d8deea5750fd311b5afa","layer":"original","quote":"恽早卒。子甝、霬，﹝一﹞以外甥故犹宠待。恽弟俣，御史中丞〖4〗；俣弟诜，大将军从事中郎：皆知名，早卒。﹝二﹞诜弟顗，咸熙中为司空〖5〗。﹝三﹞","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":172,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":71,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-p027","section":"chapter-010","block":"b-1a042211a19edb530e3b","layer":"pei","quote":"﹝三﹞《晋阳秋》曰：“顗，字景倩。幼为姊夫陈群所异，博学洽闻，意思慎密。司马宣王见顗，奇之，曰：‘荀令君之子也。近见袁侃，亦曜卿之子也。’擢拜散骑侍郎。顗佐命晋室，位至太尉，封临淮康公。尝难钟会‘《易》无互体’，见称于世。顗弟粲，字奉倩。”","attribution":"《晋阳秋》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":185,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5921d94ec8d8ad2b9baa","start":0,"end":120,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-p031","section":"chapter-010","block":"b-643aa55563b5613e764f","layer":"pei","quote":"干宝《晋纪》曰：“武帝使侍中荀顗、和峤，俱至东宫，观察太子。顗还，称太子‘德识进茂’，而峤云‘圣质如初’。”孙盛曰“遣荀勖”，其余语则同。","attribution":"干宝《晋纪》及孙盛异说","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":189,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1cd39ba61e7c038ca47e","start":0,"end":69,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-p031-sunsheng","section":"chapter-010","block":"b-643aa55563b5613e764f","layer":"pei","quote":"孙盛曰“遣荀勖”，其余语则同。","attribution":"孙盛异说","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":189,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1cd39ba61e7c038ca47e","start":54,"end":69,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-p032","section":"chapter-010","block":"b-5ab93710c1bb7fe30998","layer":"pei","quote":"臣松之按：和峤为侍中，荀顗亡没久矣。荀勖位亚台司，不与峤同班，无缘方称“侍中”。二书所云，皆为非也。考其时位，恺实当之。恺位至征西大将军。恺兄儋，少府。弟悝，护军将军，追赠车骑大将军。","attribution":"裴松之按","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":190,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1cd39ba61e7c038ca47e","start":0,"end":92,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-p032-judgment","section":"chapter-010","block":"b-5ab93710c1bb7fe30998","layer":"pei","quote":"臣松之按：和峤为侍中，荀顗亡没久矣。荀勖位亚台司，不与峤同班，无缘方称“侍中”。二书所云，皆为非也。考其时位，恺实当之。恺位至征西大将军。恺兄儋，少府。弟悝，护军将军，追赠车骑大将军。","attribution":"裴松之按","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":190,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1cd39ba61e7c038ca47e","start":0,"end":92,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-8b0653ba3f4b1cf8038f","section":"chapter-011","block":"b-c1aab782ad511127ae5e","layer":"original","quote":"正始中，骠骑将军赵俨，尚书黄休、郭彝，散骑常侍荀顗、钟毓〖14〗，太仆庾嶷，﹝三﹞弘农太守何桢等，﹝四﹞递荐昭曰：“天真高洁〖15〗，老而弥笃；玄虚静素，有夷、皓之节〖16〗。宜蒙征命，以励风俗","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":552,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":97,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-fdbe082cd69364159d90","section":"chapter-011","block":"b-8ebb547c19a7076bf761","layer":"pei","quote":"朝廷以戎车未息，征命之事，且须后之；昭以故不即征。后顗、休复与庾嶷荐昭，有诏访于本州评议。侍中韦诞驳曰：‘礼贤征士，王政之所重也。古者考行于乡；今顗等位皆常伯、纳言，嶷为卿佐，足以取信。附下罔上，忠臣之所不行也。昭宿德耆艾，遗逸山林，诚宜嘉异。’乃从诞议也","attribution":"裴注·高士传","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":581,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5296f4b832dc6d5f00f8","start":11,"end":139,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
