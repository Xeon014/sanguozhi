idence":[{"id":"huanchen-q-ec00d526cbc1ee2d8466","section":"chapter-022","block":"b-54b50034ba4196132eac","layer":"original","quote":"会嘉平中，以乐安太守与吴战于东关〖25〗；军败，没〖26〗","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":25,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":32,"end":61,"offset_unit":"unicode_code_point"},{"id":"shaodi-e-o054b-q","section":"chapter-004","block":"b-aa16c067e880a0a5a64a","layer":"original","quote":"冬十一月，诏征南大将军王昶、征东将军胡遵、镇南将军毌丘俭等，征吴。十二月，吴大将军诸葛恪拒战〖20〗，大破众军于东关〖21〗。不利而还。﹝二﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":212,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":71,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-b-20272e7cc5379b3fe346","section":"chapter-004","block":"b-20272e7cc5379b3fe346","layer":"modern","quote":"〖17〗四年：嘉平四年（公元252）。癸卯：旧历初二日。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":230,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-db96ad991a403b6a010e","start":0,"end":28,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o052","section":"chapter-004","block":"b-944c76689fd8a3e8fa86","layer":"original","quote":"四年春正月，癸卯〖17〗，以抚军大将军司马景王为大将军。二月，立皇后张氏〖18〗，大赦。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":210,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":44,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o054","section":"chapter-004","block":"b-aa16c067e880a0a5a64a","layer":"original","quote":"冬十一月，诏征南大将军王昶、征东将军胡遵、镇南将军毌丘俭等，征吴。十二月，吴大将军诸葛恪拒战〖20〗，大破众军于东关〖21〗。不利而还。﹝二﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":212,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":71,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-eb7155e684829da3d57d","section":"chapter-021","block":"b-40db16cbc0a5788fa626","layer":"pei","quote":"五年正月，诸葛恪拒战，大破众军于东关","attribution":"裴注·司马彪《战略》","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":521,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-95568ac79fb311f2266b","start":1118,"end":1136,"offset_unit":"unicode_code_point"},{"id":"wgc-q0016","section":"chapter-028","block":"b-7bd943dc7147c2f75ba7","layer":"original","quote":"转为镇南将军。诸葛诞战于东关，不利；乃令诞、俭对换。诞为镇南，都督豫州。俭为镇东，都督扬州。吴太傅诸葛恪围合肥新城，俭与文钦御之；太尉司马孚督中军东，解围，恪退还。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":85,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":82,"offset_unit":"unicode_code_point"},{"id":"wgc-q0023","section":"chapter-028","block":"b-60f24ec82e3162ca0f99","layer":"original","quote":"出为扬州刺史，加昭武将军〖5〗。王凌之阴谋也〖6〗，太傅司马宣王潜军东伐〖7〗；以诞为镇东将军、假节，都督扬州诸军事，封山阳亭侯。诸葛恪兴东关〖8〗，遣诞督诸军讨之；与战，不利。还，徙为镇南将军。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":151,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":98,"offset_unit":"unicode_code_point"},{"id":"wgc-q0219","section":"chapter-028","block":"b-7bd943dc7147c2f75ba7","layer":"original","quote":"诸葛诞战于东关，不利","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":85,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":7,"end":17,"offset_unit":"unicode_code_point"},{"id":"wgc-q0255","section":"chapter-028","block":"b-60f24ec82e3162ca0f99","layer":"original","quote":"诸葛恪兴东关〖8〗，遣诞督诸军讨之；与战，不利","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":151,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":65,"end":88,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-075d09466ebaf4ebd6c6","section":"chapter-011","block":"b-d755c8e0c6dbb83b5748","layer":"pei","quote":"修一子，名仪，字朱表。高亮雅直。司马文王为安东，仪为司马。东关之败，文王曰：‘近日之事，谁任其咎？’仪曰：‘责在军帅。’文王怒曰：‘司马欲委罪于孤邪？’遂杀之","attribution":"裴注·晋书","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":308,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5b92ebcb47664c80df05","start":12,"end":91,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
