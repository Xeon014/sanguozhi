d7754be290","yululu-q-0f968c34757e37c620d8"],"facts":[],"mentions":[{"id":"yululu-m-b6083f34e72fecbafef2","kind":"mention","text":"本篇原文记及袁迪，具体行动与称谓见引文。","evidence":["yululu-q-9923c61a92d7754be290"]},{"id":"yululu-m-93e5974d00b84ca6c46d","kind":"mention","text":"本篇原文记及袁迪，具体行动与称谓见引文。","evidence":["yululu-q-0f968c34757e37c620d8"]}],"aliases":[]}],"evidence":[{"id":"yululu-q-0f968c34757e37c620d8","section":"chapter-057","block":"b-0bcb7f2e8b98f7ce8619","layer":"pei","quote":"﹝一﹞迪孙晔，字思光。作《献帝春秋》，云：“迪与张纮等俱过江，迪父绥为太傅掾。张超之讨董卓，以绥领广陵事。”","attribution":"裴注·献帝春秋","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":394,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-022b7906326645d342ed","start":0,"end":54,"offset_unit":"unicode_code_point"},{"id":"yululu-q-9923c61a92d7754be290","section":"chapter-057","block":"b-872a9bd72cf9cdbe3b15","layer":"original","quote":"陆瑁字子璋。丞相逊弟也〖1〗。少好学笃义。陈国陈融、陈留濮阳逸、沛郡蒋纂、广陵袁迪等，皆单贫有志〖2〗，就瑁游处；﹝一﹞瑁割少分甘，与同丰约〖3〗。及同郡徐原，爰居会稽〖4〗，素不相识；临死遗书，托以孤弱。瑁为起立坟墓，收导其子。又瑁从父绩早亡，二男一女，皆数岁以还〖5〗；瑁迎摄养〖6〗，至长乃别。","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":373,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":150,"offset_unit":"unicode_code_point"},{"id":"yululu-q-c4ffa0c3479383d42449","section":"chapter-057","block":"b-0bcb7f2e8b98f7ce8619","layer":"pei","quote":"迪与张纮等俱过江，迪父绥为太傅掾。张超之讨董卓，以绥领广陵事","attribution":"裴注·《献帝春秋》","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":394,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-022b7906326645d342ed","start":22,"end":52,"offset_unit":"unicode_code_point"},{"id":"yululu-q-f7343fd2f5fc0a7741ca","section":"chapter-057","block":"b-872a9bd72cf9cdbe3b15","layer":"original","quote":"陈国陈融、陈留濮阳逸、沛郡蒋纂、广陵袁迪等，皆单贫有志〖2〗，就瑁游处；﹝一﹞瑁割少分甘，与同丰约","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":373,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":21,"end":70,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
