763a2f0c"]}],"participants":[{"person":"wangwei-p-7fec6932ce6c55","role":"卒者","evidence":["wangwei-q-8243a07df208763a2f0c"]},{"person":"wudi-p0214","role":"卒者","evidence":["wangwei-q-8243a07df208763a2f0c"]},{"person":"wangwei-p-e78ba1eb25bb7f","role":"卒者","evidence":["wangwei-q-8243a07df208763a2f0c"]},{"person":"cuimao-p0016","role":"卒者","evidence":["wangwei-q-8243a07df208763a2f0c"]}],"place":null,"time":{"label":"建安二十二年","precision":"undated","basis":"保留原纪年及粒度；本账户未独立归一公元年，不继承相邻事件年份。","evidence":["wangwei-q-8243a07df208763a2f0c"]},"ordering_evidence":"wangwei-q-8243a07df208763a2f0c","order":4148}],"persons":[{"id":"wangwei-p-e78ba1eb25bb7f","name":"应玚","evidence":["wangwei-q-3dd16689d0a3f6e023d8","wangwei-q-c3ff92a66d3f77661cdb","wangwei-q-c4656166704ca05344e8","wangwei-q-8243a07df208763a2f0c","wangwei-q-6044d35fbb52e45944ca","wangwei-q-b043a0fb4cd2090d01bc"],"facts":[{"id":"wangwei-f-544f32e0dd2b7cb6a075","text":"汝南人，字德琏。","evidence":["wangwei-q-b043a0fb4cd2090d01bc"]}],"mentions":[{"id":"wangwei-m-12bd12af25c79174d75b","kind":"mention","text":"曹丕《典论》评当世七子文章","evidence":["wangwei-q-6044d35fbb52e45944ca"]}],"aliases":[]}],"evidence":[{"id":"wangwei-q-3dd16689d0a3f6e023d8","section":"chapter-021","block":"b-a5a01fb9c0491d5f8c3b","layer":"original","quote":"玚、桢各被太祖辟为丞相掾、属","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":93,"anchor":null},"note_id":null,"start":0,"end":14},{"id":"wangwei-q-6044d35fbb52e45944ca","section":"chapter-021","block":"b-7f69f5f015b818e1e7d7","layer":"pei","quote":"﹝三﹞《典论》曰：“今之文人：鲁国孔融，广陵陈琳，山阳王粲，北海徐幹，陈留阮瑀，汝南应玚，东平刘桢。斯七子者，于学无所遗，于辞无所假；咸自以骋骐骥于千里，仰齐足而并驰。粲长于辞赋。幹时有逸气，然非粲匹也。如粲之《初征》、《登楼》、《槐赋》、《征思》，幹之《玄猨》、《漏卮》、《圆扇》、《橘赋》，虽张、蔡不过也；然于他文未能称是。琳、瑀之章表书记，今之俊也。应玚和而不壮，刘桢壮而不密。孔融体气高妙，有过人者；然不能持论，理不胜辞，至于杂以嘲戏；及其所善，扬、班之俦也。”","attribution":"裴注引《典论》","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":126,"anchor":null},"note_id":"n-e44ff8b8254edc395f28","start":0,"end":235},{"id":"wangwei-q-8243a07df208763a2f0c","section":"chapter-021","block":"b-00796707525917e80bff","layer":"original","quote":"幹、琳、玚、桢二十二年卒","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":95,"anchor":null},"note_id":null,"start":10,"end":22},{"id":"wangwei-q-b043a0fb4cd2090d01bc","section":"chapter-021","block":"b-2e025778458cccd8f2ba","layer":"original","quote":"始，文帝为五官将〖1〗，及平原侯植〖2〗，皆好文学。粲与北海徐幹字伟长、广陵陈琳字孔璋、陈留阮瑀字元瑜、汝南应玚字德琏、东平刘桢字公幹〖3〗，并见友善。﹝一﹞","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":61,"anchor":null},"note_id":null,"start":0,"end":79},{"id":"wangwei-q-c3ff92a66d3f77661cdb","section":"chapter-021","block":"b-23006338f8aa40ebc2ca","layer":"original","quote":"玚转为平原侯庶子","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":94,"anchor":null},"note_id":null,"start":0,"end":8},{"id":"wangwei-q-c4656166704ca05344e8","section":"chapter-021","block":"b-23006338f8aa40ebc2ca","layer":"original","quote":"后为五官将文学","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":94,"anchor":null},"note_id":null,"start":12,"end":19}],"profiles":{},"directory_counts":{}}
