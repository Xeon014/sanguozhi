"liusima-q-5030dfc650541494d0d8","liusima-q-4cc719a73b6052c502c6","liusima-q-9c9a4271d00063411b93","liusima-q-653a8ad5be31a9f6e84c","liusima-q-2e5ae9ec60b69636bdbf","liusima-q-a61892f4d1f501d2e222","liusima-q-e745a06497960fbb9330","liusima-q2-f6ba281881b29532bb5c","liusima-q2-f0ca165414a1baab6b39","liusima-q2-e7cf624b3f46a3ff10b9","liusima-q2-d751aa4fe8bf6bb73061"],"facts":[{"id":"liusima-f2-f5c268ee5a3920a17dcf","text":"黄初中迁庐江太守，诏书称其父昔为此州，命靖复任。","evidence":["liusima-q-e745a06497960fbb9330"]},{"id":"liusima-f2-15a078860aab6a1fea1c","text":"转河内太守，迁尚书，赐爵关内侯，出为河南尹。","evidence":["liusima-q2-f6ba281881b29532bb5c"]},{"id":"liusima-f2-1defb0ba506825f14dd9","text":"以母忧去官，后为大司农、卫尉，进封广陆亭侯。","evidence":["liusima-q2-f0ca165414a1baab6b39"]},{"id":"liusima-f2-bd29c8b6640a7e61d4c6","text":"迁镇北将军，假节，都督河北诸军事。","evidence":["liusima-q2-e7cf624b3f46a3ff10b9"]},{"id":"liusima-f2-0178fd5145a797f160fd","text":"嘉平六年薨；子熙嗣。","evidence":["liusima-q2-d751aa4fe8bf6bb73061"]}],"aliases":[],"mentions":[]}],"evidence":[{"id":"liusima-q-2e5ae9ec60b69636bdbf","section":"chapter-015","block":"b-b5410df0d15d832c8b5e","layer":"original","quote":"嘉平六年，薨","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":9,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":6,"offset_unit":"unicode_code_point"},{"id":"liusima-q-4cc719a73b6052c502c6","section":"chapter-015","block":"b-f05382d3dc8f0c382206","layer":"original","quote":"上疏陈儒训之本曰：“夫学者，治乱之轨仪〖17〗，圣人之大教也。自黄初以来，崇立太学二十余年，而寡有成者；盖由博士选轻〖18〗，诸生避役〖19〗，高门子弟，耻非其伦，故无学者。虽有其名而无其（人）〔实〕，虽设其教而无其功。宜高选博士：取行为人表，经任人师者〖20〗，掌教国子〖21〗。依遵古法，使二千石以上子孙，年从十五，皆入太学。明制黜陟荣辱之路〖22〗：其经明行修者，则进之以崇德〖23〗；荒教废业者，则退之以惩恶。举善而教不能，则劝〖24〗。浮华交游，不禁自息矣。阐弘大化，以绥未宾〖25〗；六合承风〖26〗，远人来格〖27〗：此圣人之教，致治之本也","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":7,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":26,"end":303,"offset_unit":"unicode_code_point"},{"id":"liusima-q-5030dfc650541494d0d8","section":"chapter-015","block":"b-88ded8218a019af909a9","layer":"original","quote":"散骑常侍应璩书与靖曰","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":6,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":21,"end":31,"offset_unit":"unicode_code_point"},{"id":"liusima-q-653a8ad5be31a9f6e84c","section":"chapter-015","block":"b-ac369e98d016edc8d22b","layer":"original","quote":"又修广戾（渠陵）〔陵渠〕大堨〖28〗，水溉灌蓟南北，三更种稻〖29〗，边民利之","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":8,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":53,"end":92,"offset_unit":"unicode_code_point"},{"id":"liusima-q-9c9a4271d00063411b93","section":"chapter-015","block":"b-ac369e98d016edc8d22b","layer":"original","quote":"遂开拓边守，屯据险要","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":8,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":42,"end":52,"offset_unit":"unicode_code_point"},{"id":"liusima-q-a61892f4d1f501d2e222","section":"chapter-015","block":"b-b5410df0d15d832c8b5e","layer":"original","quote":"追赠征北将军；进封建成乡侯，谥曰景侯","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":9,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":7,"end":25,"offset_unit":"unicode_code_point"},{"id":"liusima-q-e745a06497960fbb9330","section":"chapter-015","block":"b-276db396454f73fec002","layer":"original","quote":"馥子靖。黄初中，从黄门侍郎迁庐江太守，诏曰：“卿父昔为彼州；今卿复据此郡，可谓克负荷者也〖5〗。”","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":5,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":49,"offset_unit":"unicode_code_point"},{"id":"liusima-q2-d751aa4fe8bf6bb73061","section":"chapter-015","block":"b-b5410df0d15d832c8b5e","layer":"original","quote":"嘉平六年，薨。追赠征北将军；进封建成乡侯，谥曰景侯。子熙嗣。﹝一﹞","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":9,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":33,"offset_unit":"unicode_code_point"},{"id":"liusima-q2-e7cf624b3f46a3ff10b9","section":"chapter-015","block":"b-ac369e98d016edc8d22b","layer":"original","quote":"后迁镇北将军，假节，都督河北诸军事。靖以为：“经常之大法，莫善于守防，使民夷有别。”遂开拓边守，屯据险要。又修广戾（渠陵）〔陵渠〕大堨〖28〗，水溉灌蓟南北，三更种稻〖29〗，边民利之。","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":8,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":93,"offset_unit":"unicode_code_point"},{"id":"liusima-q2-f0ca165414a1baab6b39","section":"chapter-015","block":"b-f05382d3dc8f0c382206","layer":"original","quote":"母丧去官。后为大司农、卫尉；进封广陆亭侯，邑三百户。上疏陈儒训之本曰：“夫学者，治乱之轨仪〖17〗，圣人之大教也。自黄初以来，崇立太学二十余年，而寡有成者；盖由博士选轻〖18〗，诸生避役〖19〗，高门子弟，耻非其伦，故无学者。虽有其名而无其（人）〔实〕，虽设其教而无其功。宜高选博士：取行为人表，经任人师者〖20〗，掌教国子〖21〗。依遵古法，使二千石以上子孙，年从十五，皆入太学。明制黜陟荣辱之路〖22〗：其经明行修者，则进之以崇德〖23〗；荒教废业者，则退之以惩恶。举善而教不能，则劝〖24〗。浮华交游，不禁自息矣。阐弘大化，以绥未宾〖25〗；六合承风〖26〗，远人来格〖27〗：此圣人之教，致治之本也。”","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":7,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":305,"offset_unit":"unicode_code_point"},{"id":"liusima-q2-f6ba281881b29532bb5c","section":"chapter-015","block":"b-88ded8218a019af909a9","layer":"original","quote":"转在河内。迁尚书，赐爵关内侯。出为河南尹。散骑常侍应璩书与靖曰〖6〗：“入作纳言〖7〗，出临京任〖8〗。富民之术，日引月长：藩落高峻〖9〗，绝穿窬之心；五种别出〖10〗，远水火之灾；农器必具，无失时之阙〖11〗；蚕麦有苫备之用，无雨湿之虞；封符指期〖12〗，无流连之吏；鳏寡孤独，蒙廪赈之实。加之以明擿幽微，重之以秉宪不挠〖13〗；有司供承王命，百里垂拱仰办〖14〗：虽昔赵、张、三王之治〖15〗，未足以方也！”靖为政类如此。初虽如碎密〖16〗，终于百姓便之，有馥遗风。","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":6,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":235,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
