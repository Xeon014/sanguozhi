{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[],"persons":[{"id":"xiahoucao-p0001","name":"夏侯廉","evidence":["xiahoucao-q-o009"],"facts":[],"aliases":[],"mentions":[{"id":"xiahoucao-m-o009-xiahoucao-p0001","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-o009"]}]}],"evidence":[{"id":"xiahoucao-q-o009","section":"chapter-009","block":"b-af4cb66c5dbf74f34a25","layer":"original","quote":"子充嗣。帝追思惇功，欲使子孙毕侯；分惇邑千户，赐惇七子二孙爵，皆关内侯。惇弟廉及子楙，素自封列侯。初，太祖以女妻楙，即清河公主也。楙历位侍中、尚书，安西、镇东将军，假节。﹝三﹞充薨，子廙嗣。廙薨，子劭嗣。﹝四﹞","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":20,"anchor":null},"note_id":null,"start":0,"end":105}],"profiles":{},"directory_counts":{}}
