64","liusima-q-1044bbd2c5b448daf2ce","liusima-q-67f17a01695c1f34d245"]},"ordering_evidence":"liusima-q-1c84f108fba1f8eb0177","source_order":[15,206,133],"order":3338},{"id":"liusima-e-o132","title":"温恢赴凉州道病卒，时年四十五","accounts":[{"id":"liusima-a-b455e24446b2ef3bf77a","label":"正文","text":"温恢赴凉州道病卒，时年四十五","evidence":["liusima-q-f886ceb57697a5567d32"]},{"id":"liusima-a-2c956183f43472ca5ed6","label":"正文","text":"帝诏褒温恢柱石之质，赐子温生爵关内侯","evidence":["liusima-q-60d272e09d7cb8900f05"]}],"participants":[{"person":"chengguo-p0023","role":"道病卒，时年四十五；卒后被追愍褒奖","evidence":["liusima-q-f886ceb57697a5567d32","liusima-q-60d272e09d7cb8900f05"]},{"person":"wudi-p0170","role":"诏褒恢有柱石之质，服事先帝功勤明著，及为朕执事忠于王室，授万里之任，如何不遂吾甚愍之，赐恢子生爵关内侯","evidence":["liusima-q-60d272e09d7cb8900f05"]},{"person":"liusima-p0044","role":"温恢子，受赐爵关内侯","evidence":["liusima-q-60d272e09d7cb8900f05"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liusima-q-f886ceb57697a5567d32","liusima-q-60d272e09d7cb8900f05"]},"ordering_evidence":"liusima-q-f886ceb57697a5567d32","source_order":[15,208,18],"order":3339},{"id":"hancui-e-1685dd5682f2c2c083c9","title":"孙礼私纵犯法马台自首温恢白曹操两人减死","accounts":[{"id":"hancui-a-1685dd5682f2c2c083c9","label":"正文","text":"孙礼私纵犯法马台自首温恢白曹操两人减死","evidence":["hancui-q-1a2b429226964923222e"]}],"participants":[{"person":"shaodi-p0031","role":"纵囚自首","evidence":["hancui-q-1a2b429226964923222e"]},{"person":"hancui-p-0486205b9fd135","role":"获纵减死","evidence":["hancui-q-1a2b429226964923222e"]},{"person":"chengguo-p0023","role":"白事","evidence":["hancui-q-1a2b429226964923222e"]},{"person":"cao-cao","role":"减死","evidence":["hancui-q-1a2b429226964923222e"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["hancui-q-1a2b429226964923222e"]},"ordering_evidence":"hancui-q-1a2b429226964923222e","order":4981}],"persons":[{"id":"chengguo-p0023","name":"温恢","evidence":["chengguo-q-ee3917cc7f22f638be28","liusima-q-6a9eb3b6c03d531dcd9b","liusima-q-22fa782cfbf504c9dfba","liusima-q-350bc172c319b34af315","liusima-q-1c84f108fba1f8eb0177","liusima-q-1044bbd2c5b448daf2ce","liusima-q-f886ceb57697a5567d32","liusima-q-60d272e09d7cb8900f05","liusima-q2-d67f064fec46425a2d58","liusima-q-13bbdbe79d3f464e0013","liusima-q-d4d9c0a5938afbdb08f3","liusima-q2-cf8d0bbf9e73861bdddd","hancui-q-1a2b429226964923222e"],"facts":[{"id":"liusima-f2-89452e991248726a6129","text":"字曼基，太原祁人。父恕为涿郡太守；恢十五岁丧父，送丧归乡里。","evidence":["liusima-q2-d67f064fec46425a2d58"]},{"id":"liusima-f2-d4fba1d45969ba67cd05","text":"举孝廉，为廪丘长，迁鄢陵、广川令，彭城、鲁相，入为丞相主簿。","evidence":["liusima-q-13bbdbe79d3f464e0013"]},{"id":"liusima-f2-52461eed0c8f8d560294","text":"文帝践阼，为侍中，出为魏郡太守。","evidence":["liusima-q-d4d9c0a5938afbdb08f3"]},{"id":"liusima-f2-fbcdf61276e6b017216a","text":"迁凉州刺史，持节，领护羌校尉；道病卒，时年四十五。","evidence":["liusima-q2-cf8d0bbf9e73861bdddd"]}],"aliases":[],"mentions":[]}],"evidence":[{"id":"chengguo-q-ee3917cc7f22f638be28","section":"chapter-014","block":"b-148e69680df79ab37634","layer":"original","quote":"以温恢为扬州刺史〖8〗；济为别驾，令曰：“季子为臣〖9〗，吴宜有君。今君还州，吾无忧矣","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":368,"anchor":null},"note_id":null,"start":6,"end":49},{"id":"hancui-q-1a2b429226964923222e","section":"chapter-024","block":"b-54fa554e45f355510129","layer":"original","quote":"台后坐法当死，礼私导令逾狱〖3〗，自首〖4〗。既而曰：“臣无逃亡之义。”径诣刺奸〖5〗。主簿温恢嘉之，具白太祖，各减死一等〖6〗。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":334,"anchor":null},"note_id":null,"start":62,"end":127},{"id":"liusima-q-1044bbd2c5b448daf2ce","section":"chapter-015","block":"b-bbb8a7d1595758446f03","layer":"original","quote":"恢密语潜曰：“此必襄阳之急欲赴之也。所以不为急会者〖11〗，不欲惊动远众；一二日，必有密书促卿进道。张辽等又将被召，辽等素知王意。后召前至，卿受其责矣","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":205,"anchor":null},"note_id":null,"start":231,"end":306},{"id":"liusima-q-13bbdbe79d3f464e0013","section":"chapter-015","block":"b-f0b4580c7cf0263f0326","layer":"original","quote":"举孝廉，为廪丘长〖3〗。鄢陵、广川令〖4〗，彭城、鲁相：所在见称。入为丞相主簿。","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":204,"anchor":null},"note_id":null,"start":0,"end":40},{"id":"liusima-q-1c84f108fba1f8eb0177","section":"chapter-015","block":"b-bbb8a7d1595758446f03","layer":"original","quote":"恢谓兖州刺史裴潜曰〖7〗：“此间虽有贼，不足忧；而畏征南方有变〖8〗。今水生而子孝悬军〖9〗，无有远备；关羽骁锐，乘利而进，必将为患。”于是有樊城之事","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":205,"anchor":null},"note_id":null,"start":133,"end":208},{"id":"liusima-q-22fa782cfbf504c9dfba","section":"chapter-015","block":"b-bbb8a7d1595758446f03","layer":"original","quote":"出为扬州刺史。太祖曰：“甚欲使卿在亲近；顾以为，不如此州事大。故《书》云：‘股肱良哉！庶事康哉〖5〗！’得无当得蒋济为治中邪？”时济现为丹杨太守，乃遣济还州","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":205,"anchor":null},"note_id":null,"start":0,"end":78},{"id":"liusima-q-350bc172c319b34af315","section":"chapter-015","block":"b-bbb8a7d1595758446f03","layer":"original","quote":"又语张辽、乐进等曰：“扬州刺史，晓达军事；动静与共咨议","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":205,"anchor":null},"note_id":null,"start":82,"end":109},{"id":"liusima-q-60d272e09d7cb8900f05","section":"chapter-015","block":"b-34909ab60a7a17dfcbf7","layer":"original","quote":"诏曰：“恢有柱石之质，服事先帝，功勤明著。及为朕执事〖13〗，忠于王室；故授之以万里之任〖14〗，任之以一方之事。如何不遂，吾甚愍之！赐恢子生爵，关内侯","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":208,"anchor":null},"note_id":null,"start":0,"end":76},{"id":"liusima-q-67f17a01695c1f34d245","section":"chapter-015","block":"b-bbb8a7d1595758446f03","layer":"original","quote":"潜受其言，置辎重，更为轻装速发，果被促令〖12〗。辽等寻各见召，如恢所策","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":205,"anchor":null},"note_id":null,"start":308,"end":344},{"id":"liusima-q-6a9eb3b6c03d531dcd9b","section":"chapter-015","block":"b-b4f8a2e9c6e515cdc1cd","layer":"original","quote":"内足于财，恢曰：“世方乱，安以富为？”一朝尽散，赈施宗族；州里高之，比之郇越","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":203,"anchor":null},"note_id":null,"start":38,"end":76},{"id":"liusima-q-bd00b9264e01dddc4564","section":"chapter-015","block":"b-bbb8a7d1595758446f03","layer":"original","quote":"诏书召潜及豫州刺史吕贡等。潜等缓之","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":205,"anchor":null},"note_id":null,"start":213,"end":230},{"id":"liusima-q-d4d9c0a5938afbdb08f3","section":"chapter-015","block":"b-2b222a8ab24f8dc39390","layer":"original","quote":"文帝践阼，以恢为侍中。出为魏郡太守。","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":206,"anchor":null},"note_id":null,"start":0,"end":18},{"id":"liusima-q-f886ceb57697a5567d32","section":"chapter-015","block":"b-5559b2a8210f5c499a7c","layer":"original","quote":"道病卒。时年四十五","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":207,"anchor":null},"note_id":null,"start":18,"end":27},{"id":"liusima-q2-cf8d0bbf9e73861bdddd","section":"chapter-015","block":"b-5559b2a8210f5c499a7c","layer":"original","quote":"数年，迁凉州刺史，持节，领护羌校尉，道病卒。时年四十五。","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":207,"anchor":null},"note_id":null,"start":0,"end":28},{"id":"liusima-q2-d67f064fec46425a2d58","section":"chapter-015","block":"b-b4f8a2e9c6e515cdc1cd","layer":"original","quote":"温恢字曼基，太原祁人也〖1〗。父恕，为涿郡太守，卒。恢年十五，送丧还归乡里。内足于财，恢曰：“世方乱，安以富为？”一朝尽散，赈施宗族；州里高之，比之郇越〖2〗。","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":203,"anchor":null},"note_id":null,"start":0,"end":80}],"profiles":{},"directory_counts":{}}
