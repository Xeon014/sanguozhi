a"]}],"aliases":[]}],"evidence":[{"id":"zhangyan-q-2057cb3d31e8c57ba752","section":"chapter-053","block":"b-d9f09bacf49b0e7bc56b","layer":"original","quote":"后积他事下狱，皆追以此为诘","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":40,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":124,"end":137,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-2d98cf61fa0501ae8067","section":"chapter-053","block":"b-454d1de3861897b495c8","layer":"pei","quote":"﹝四﹞《江表传》（曰）称尚“有俊才”。","attribution":"裴注·江表传","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":75,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-44b8accf43655d7f70dc","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-358a5fc8dd3a51347a96","section":"chapter-053","block":"b-cdd59404806942aaa18e","layer":"pei","quote":"皓尝问：‘《诗》云“泛彼柏舟”，惟柏中舟乎？’尚对曰：‘《诗》言“桧楫松舟”，则松亦中舟也。’又问：‘鸟之大者惟鹤，小者惟雀乎？’尚对曰：‘大者有秃鹙，小者有鹪鹩。’皓，性忌胜己；而尚谈论，每出其表：积以致恨","attribution":"裴注·吴纪","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":76,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-23a9e4a66ab0d488d4bc","start":12,"end":116,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-49821444442c6ae3a63a","section":"chapter-053","block":"b-d9f09bacf49b0e7bc56b","layer":"original","quote":"玄子尚，﹝四﹞孙皓时为侍郎〖22〗。以言语辩捷见知〖23〗，擢为侍中，中书令。皓使尚鼓琴，尚对曰：“素不能。”敕使学之。后宴，言次说琴之精妙〖24〗，尚因道：“晋平公使师旷作清角〖25〗，旷言吾君德薄，不足以听之。”皓意谓尚以斯喻己〖26〗，不悦；后积他事下狱，皆追以此为诘。﹝五﹞送建安作船〖27〗。久之，又就加诛。","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":40,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":159,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-59affbc6d498861c1138","section":"chapter-053","block":"b-d9f09bacf49b0e7bc56b","layer":"original","quote":"送建安作船〖27〗。久之，又就加诛","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":40,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":141,"end":158,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-852106b4eeabd9f1cee4","section":"chapter-053","block":"b-cdd59404806942aaa18e","layer":"pei","quote":"后问：‘孤饮酒以方谁？’尚对曰：‘陛下有百觚之量。’皓云：‘尚知孔丘之不王，而以孤方之！’因此发怒收尚","attribution":"裴注·吴纪","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":76,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-23a9e4a66ab0d488d4bc","start":117,"end":168,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-aaec5cb7db5ba8b336fd","section":"chapter-053","block":"b-d9f09bacf49b0e7bc56b","layer":"original","quote":"玄子尚，﹝四﹞孙皓时为侍郎〖22〗。以言语辩捷见知〖23〗，擢为侍中，中书令","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":40,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":38,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-c701f000e8507f364b68","section":"chapter-053","block":"b-d9f09bacf49b0e7bc56b","layer":"original","quote":"后宴，言次说琴之精妙〖24〗，尚因道：“晋平公使师旷作清角〖25〗，旷言吾君德薄，不足以听之。”皓意谓尚以斯喻己〖26〗，不悦","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":40,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":60,"end":123,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-d7d570ffbe37475b5833","section":"chapter-053","block":"b-cdd59404806942aaa18e","layer":"pei","quote":"尚书岑昏，率公卿以下百余人，诣宫叩头请：尚罪得减死","attribution":"裴注·吴纪","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":76,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-23a9e4a66ab0d488d4bc","start":169,"end":194,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-f05b24ff26262c17f3ba","section":"chapter-053","block":"b-cdd59404806942aaa18e","layer":"pei","quote":"﹝五﹞环氏《吴纪》曰：“皓尝问：‘《诗》云“泛彼柏舟”，惟柏中舟乎？’尚对曰：‘《诗》言“桧楫松舟”，则松亦中舟也。’又问：‘鸟之大者惟鹤，小者惟雀乎？’尚对曰：‘大者有秃鹙，小者有鹪鹩。’皓，性忌胜己；而尚谈论，每出其表：积以致恨。后问：‘孤饮酒以方谁？’尚对曰：‘陛下有百觚之量。’皓云：‘尚知孔丘之不王，而以孤方之！’因此发怒收尚。尚书岑昏，率公卿以下百余人，诣宫叩头请：尚罪得减死。”","attribution":"裴注·环氏吴纪","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":76,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-23a9e4a66ab0d488d4bc","start":0,"end":196,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-f2bbe1560338cf93c7c8","section":"chapter-053","block":"b-d9f09bacf49b0e7bc56b","layer":"original","quote":"皓使尚鼓琴，尚对曰：“素不能。”敕使学之","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":40,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":39,"end":59,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
