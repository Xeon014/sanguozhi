{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"mantian-e-sr-wei-si-weiwei","title":"满伟嗣爵官至卫尉","accounts":[{"id":"mantian-a-2ca1ad44e94fe2854509","label":"正文","text":"满宠卒，子伟嗣爵，以格度知名，官至卫尉。","evidence":["mantian-q-d10aa7f11f7e440f6333"]}],"participants":[{"person":"mantian-p0020","role":"子伟嗣、以格度知名、官至卫尉","evidence":["mantian-q-d10aa7f11f7e440f6333"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"二轮逐段复核登记；原文时间表达保留于引句，不由相邻段落推算。","evidence":["mantian-q-d10aa7f11f7e440f6333"]},"ordering_evidence":"mantian-q-d10aa7f11f7e440f6333","source_order":[26,90,0],"order":5169},{"id":"mantian-e-p153","title":"长武考死杖下伟免为庶人","accounts":[{"id":"mantian-a-4435682432934713755a","label":"裴注·《世语》","text":"司马昭因断门之恨，寿春之役后收满长武考死杖下，满伟免为庶人，时人冤之","evidence":["mantian-q-46e70f5dd434c71302e2"]}],"participants":[{"person":"shaodi-p0045","role":"寿春之役伟从至许、内见恨、收长武","evidence":["mantian-q-46e70f5dd434c71302e2"]},{"person":"mantian-p0022","role":"求还省疾事定乃从归、被收考死杖下","evidence":["mantian-q-46e70f5dd434c71302e2"]},{"person":"mantian-p0020","role":"以疾不进、免为庶人","evidence":["mantian-q-46e70f5dd434c71302e2"]},{"person":"xiahoucao-p0112","role":"因王左右启王满掾断门不纳人宜推劾","evidence":["mantian-q-46e70f5dd434c71302e2"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["mantian-q-46e70f5dd434c71302e2"]},"ordering_evidence":"mantian-q-46e70f5dd434c71302e2","source_order":[26,116,118],"order":5171}],"persons":[{"id":"mantian-p0020","name":"满伟","evidence":["mantian-q-46e70f5dd434c71302e2"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[{"id":"mantian-q-46e70f5dd434c71302e2","section":"chapter-026","block":"b-219b3a1015cdaaa81810","layer":"pei","quote":"寿春之役，伟从文王至许，以疾不进。子从，求还省疾，事定乃从归。由此，内见恨。收长武考死杖下，伟免为庶人。时人冤之","attribution":"正文","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":115,"anchor":null},"source_sha256":"b0f2c19b