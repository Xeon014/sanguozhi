"zongshi-q-160ae820e0625112fc65"]}],"participants":[{"person":"zhouyu-p0054","role":"卒者","evidence":["zongshi-q-160ae820e0625112fc65"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["zongshi-q-160ae820e0625112fc65"]},"ordering_evidence":"zongshi-q-160ae820e0625112fc65","source_order":[51,42,0],"order":9134},{"id":"zhouyu-e-o084a","title":"吕蒙留孙皎后赴益阳","accounts":[{"id":"zhouyu-e-o084a-account","label":"《周瑜鲁肃吕蒙传》正文","text":"吕蒙留孙皎后赴益阳","evidence":["zhouyu-e-o084a-q"]}],"participants":[{"person":"lu-meng","role":"赴援","evidence":["zhouyu-e-o084a-q"]},{"person":"zhouyu-p0054","role":"留守","evidence":["zhouyu-e-o084a-q"]}],"place":null,"time":{"label":"郝普降后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["zhouyu-e-o084a-q"]},"ordering_evidence":"zhouyu-e-o084a-q","source_order":[54,384,"O084a"],"order":9716}],"persons":[{"id":"zhouyu-p0054","name":"孙皎","evidence":["zhouyu-q-o084","zhouyu-identity-sunjiao","wuzhu-q-o028","zongshi-q-48ea513e36d209018c25","zongshi-q-1b7461a17687522a5b4a","zongshi-q-37c47fe8d3b61b356a0e","zongshi-q-bc981c242bda34c8493c","zongshi-q-457cce9db9b16c428ffb","zongshi-q-4fb53f9691f394c3dbd4","zongshi-q-e46dce1fca6feb48c5cb","zongshi-q-82bdc632d937118fbace","zongshi-q-70b26d078f8749f5fc15","zongshi-q-4813402efef061b74473","zongshi-q-41188b8bb2da2dd5154d","zongshi-q-f6b13ee683b4374a9172","zongshi-q-160ae820e0625112fc65","zongshi-q2-89f31d9ff024df29e24a","zongshi-q2-fa70fc771b9c9ecbe891"],"facts":[{"id":"zongshi-f2-ea082f331e72de78f1c9","text":"始拜护军校尉，领众二千余人；迁都护、征虏将军，代程普督夏口。","evidence":["zongshi-q2-89f31d9ff024df29e24a"]},{"id":"zongshi-f2-7dab096f2eb7bb7c7dc0","text":"建安二十四年卒。子胤封丹杨侯，无子卒；弟晞嗣，后自杀国除；咨、弥、仪皆为将军，封侯；咨为滕胤所杀，仪为孙峻所杀。","evidence":["zongshi-q2-fa70fc771b9c9ecbe891"]}],"aliases":[],"mentions":[{"id":"zhouyu-m-o084-zhouyu-p0054","kind":"mention","text":"文中提及","evidence":["zhouyu-q-o084"]},{"id":"zhouyu-m-o087-zhouyu-p0054","kind":"mention","text":"文中提及","evidence":["zhouyu-q-o087"]},{"id":"wuzhu-m-o028-zhouyu-p0054","kind":"mention","text":"文中提及","evidence":["wuzhu-q-o028"]}]}],"evidence":[{"id":"dengzhang-q-76c80cf8703e0b5cbe0c","section":"chapter-045","block":"b-bc84cd193f7c658fd4af","layer":"original","quote":"为吴将吕蒙所谲〖17〗，开城诣蒙","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":361,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":26,"end":42,"offset_unit":"unicode_code_point"},{"id":"wuzhu-e-o028b-q","section":"chapter-047","block":"b-aed5aacc47d73bf1a3f2","layer":"original","quote":"蒙使人诱普，普降，尽得三郡将守〖10〗；因引军还，与孙皎、潘璋并鲁肃兵并进〖11〗，拒羽于益阳。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":126,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":52,"end":100,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-b-6c673130b822b151c942","section":"chapter-047","block":"b-6c673130b822b151c942","layer":"modern","quote":"〖1〗益州：州名。治所在今四川成都市。此段所述史事发生在建安二十年（公元 215），参见本书卷三十二《先主传》。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":130,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1574d392980d4ec4daef","start":0,"end":56,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o026","section":"chapter-047","block":"b-80743944340fd37ea837","layer":"original","quote":"权以备已得益州〖1〗，令诸葛瑾从求荆州诸郡。备不许，曰：“吾方图凉州；凉州定，乃尽以荆州与吴耳。”权曰：“此假而不返〖2〗，而欲以虚辞引岁〖3〗！”遂置南三郡长吏〖4〗。关羽尽逐之〖5〗。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":124,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":94,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o028","section":"chapter-047","block":"b-aed5aacc47d73bf1a3f2","layer":"original","quote":"蒙到，二郡皆服，惟零陵太守郝普未下〖8〗。会备到公安〖9〗，使关羽将三万兵至益阳；权乃召蒙等，使还助肃。蒙使人诱普，普降，尽得三郡将守〖10〗；因引军还，与孙皎、潘璋并鲁肃兵并进〖11〗，拒羽于益阳。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":126,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":100,"offset_unit":"unicode_code_point"},{"id":"zhouyu-e-o084a-q","section":"chapter-054","block":"b-dd7fdce0fda1f24e697c","layer":"original","quote":"蒙留孙（河）〔皎〕委以后事，即日引军赴益阳。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":383,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":22,"offset_unit":"unicode_code_point"},{"id":"zhouyu-identity-sunjiao","section":"chapter-054","block":"b-16c5222a2a5cc434ac54","layer":"modern","quote":"〖4〗征虏：指任征虏将军的孙皎。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":419,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-468dd2afe02bcd7081c0","start":0,"end":16,"offset_unit":"unicode_code_point"},{"id":"zhouyu-q-o084","section":"chapter-054","block":"b-dd7fdce0fda1f24e697c","layer":"original","quote":"蒙留孙（河）〔皎〕委以后事，即日引军赴益阳。刘备请盟，权乃归普等〖21〗；割湘水，以零陵还之。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":383,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":47,"offset_unit":"unicode_code_point"},{"id":"zhouyu-q-o087","section":"chapter-054","block":"b-99f1410e6ac0cd0d23ea","layer":"original","quote":"初，鲁肃等以为：“曹公尚存，祸难始构，宜相辅协〖1〗，与之同仇〖2〗，不可失也〖3〗。”蒙乃密陈计策曰：“今征虏守南郡〖4〗；潘璋住白帝〖5〗；蒋钦将游兵万人〖6〗，循江上下，应敌所在；蒙为国家前据襄阳。如此，何忧于操？何赖于羽？且羽君臣，矜其诈力；所在反覆〖7〗，不可以腹心待也。今羽所以未便东向者，以至尊圣明，蒙等尚存也。今不于强壮时图之，一旦僵仆〖8〗，欲复陈力〖9〗，其可得邪？”权深纳其策。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":409,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":200,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-160ae820e0625112fc65","section":"chapter-051","block":"b-6f3d4f4597b61c4b220e","layer":"original","quote":"建安二十四年卒","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":41,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":7,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-1b7461a17687522a5b4a","section":"chapter-051","block":"b-0e3b9cf3284ab311590d","layer":"original","quote":"黄盖及兄瑜卒，又并其军","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":36,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":63,"end":74,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-37c47fe8d3b61b356a0e","section":"chapter-051","block":"b-0e3b9cf3284ab311590d","layer":"original","quote":"赐沙羡、云杜、南新市、竟陵为奉邑〖3〗；自置长吏","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":36,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":75,"end":99,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-41188b8bb2da2dd5154d","section":"chapter-051","block":"b-bff10f0ab11890b1b8e7","layer":"original","quote":"后吕蒙当袭南郡，权欲令皎与蒙为左、右部大督〖21〗。蒙说权曰：“若至尊以征虏能〖22〗，宜用之；以蒙能，宜用蒙。昔周瑜、程普，为左、右部督，共攻江陵；虽事决于瑜，普自恃久将，且俱是督，遂共不睦，几败国事：此目前之戒也","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":40,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":15,"end":123,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-457cce9db9b16c428ffb","section":"chapter-051","block":"b-227fec668c0a0c793450","layer":"original","quote":"皎尝遣兵候〖6〗，获魏边将吏美女，以进皎","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":37,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":64,"end":84,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-4813402efef061b74473","section":"chapter-051","block":"b-bff10f0ab11890b1b8e7","layer":"original","quote":"皎得书，上疏陈谢，遂与宁结厚","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":40,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":14,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-48ea513e36d209018c25","section":"chapter-051","block":"b-0e3b9cf3284ab311590d","layer":"original","quote":"是时曹公数出濡须，皎每赴拒，号为精锐","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":36,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":25,"end":43,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-4fb53f9691f394c3dbd4","section":"chapter-051","block":"b-227fec668c0a0c793450","layer":"original","quote":"皎更其衣服，送还之，下令曰：“今所诛者曹氏，其百姓何罪？自今以往，不得击其老弱！”由是江淮间多归附者","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":37,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":85,"end":135,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-70b26d078f8749f5fc15","section":"chapter-051","block":"b-0358de1fa72c0ebbce9f","layer":"original","quote":"权闻之，以书让皎曰〖11〗：“自吾与北方为敌，中间十年〖12〗；初时相持，年小，今者且三十矣！孔子言‘三十而立’，非但谓五经也。授卿以精兵，委卿以大任，都护诸将于千里之外；欲使如楚任昭奚恤〖13〗，扬威于北境：非徒相使逞私志而已。近闻卿与甘兴霸饮〖14〗，因酒发作，侵陵其人；其人求属吕蒙督中。此人虽粗豪〖15〗，有不如人意时；然其较略大丈夫也〖16〗：吾亲之者，非私之也。我亲爱之，卿疏憎之；卿所为每与吾违，其可久乎？夫居敬而行简，可以临民；爱人多容〖17〗，可以得众。二者尚不能知，安可董督在远，御寇济难乎？卿行长大，特受重任；上有远方瞻望之视，下有部曲朝夕从事：何可恣意有盛怒邪？人谁无过？贵其能改；宜追前愆〖18〗，深自咎责！今故烦诸葛子瑜重宣吾意〖19〗。临书摧怆〖20〗，心悲泪下","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":39,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":346,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-82bdc632d937118fbace","section":"chapter-051","block":"b-b7aba15cfa849b0e74e4","layer":"original","quote":"宁曰：“臣、子一例〖8〗：征虏虽公子〖9〗，何可专行侮人邪！吾值明主，但当输效力命〖10〗，以报所天；诚不能随俗屈曲矣","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":38,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":18,"end":77,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-bc981c242bda34c8493c","section":"chapter-051","block":"b-227fec668c0a0c793450","layer":"original","quote":"委庐江刘靖以得失，江夏李允以众事，广陵吴硕、河南张梁以军旅〖4〗：而倾心亲待，莫不自尽","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":37,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":17,"end":60,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-e46dce1fca6feb48c5cb","section":"chapter-051","block":"b-b7aba15cfa849b0e74e4","layer":"original","quote":"尝以小故与甘宁忿争〖7〗，或以谏宁","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":38,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":17,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-f6b13ee683b4374a9172","section":"chapter-051","block":"b-bff10f0ab11890b1b8e7","layer":"original","quote":"权悟，谢蒙曰：“以卿为大督，命皎为后继。”擒关羽，定荆州，皎有力焉","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":40,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":125,"end":158,"offset_unit":"unicode_code_point"},{"id":"zongshi-q2-89f31d9ff024df29e24a","section":"chapter-051","block":"b-0e3b9cf3284ab311590d","layer":"original","quote":"瑜弟皎，字叔朗。始拜护军校尉〖1〗，领众二千余人。是时曹公数出濡须，皎每赴拒，号为精锐。迁都护〖2〗，征虏将军，代程普督夏口。黄盖及兄瑜卒，又并其军。赐沙羡、云杜、南新市、竟陵为奉邑〖3〗；自置长吏。","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":36,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":100,"offset_unit":"unicode_code_point"},{"id":"zongshi-q2-fa70fc771b9c9ecbe891","section":"chapter-051","block":"b-6f3d4f4597b61c4b220e","layer":"original","quote":"建安二十四年卒。权追录其功，封子胤为丹杨侯。胤卒，无子。弟晞嗣，领兵；有罪自杀，国除〖23〗。弟咨、弥、仪，皆将军，封侯。咨，羽林督〖24〗；仪，无难督〖25〗。咨为滕胤所杀，仪为孙峻所害。","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":41,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":95,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
