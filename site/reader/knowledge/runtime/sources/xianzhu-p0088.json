{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dongyuan-e-p004a","title":"征董卓少府令兵属皇甫嵩董卓辞继续前将军事","accounts":[{"id":"dongyuan-e-p004a-account","label":"《灵帝纪》","text":"征董卓少府令兵属皇甫嵩董卓辞继续前将军事","evidence":["dongyuan-e-p004a-q"]}],"participants":[{"person":"wudi-p0053","role":"拒交兵","evidence":["dongyuan-e-p004a-q"]},{"person":"xianzhu-p0088","role":"被命接军","evidence":["dongyuan-e-p004a-q"]}],"place":null,"time":{"label":"中平五年及六年","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-p004a-q"]},"ordering_evidence":"dongyuan-e-p004a-q","source_order":[6,26,"P004a"],"order":1480},{"id":"dongyuan-e-p004b","title":"董卓任并州牧再拒交兵后奉何进召","accounts":[{"id":"dongyuan-e-p004b-account","label":"《灵帝纪》","text":"董卓任并州牧再拒交兵后奉何进召","evidence":["dongyuan-e-p004b-q"]}],"participants":[{"person":"wudi-p0053","role":"拒命奉召","evidence":["dongyuan-e-p004b-q"]},{"person":"wudi-p0051","role":"召入","evidence":["dongyuan-e-p004b-q"]},{"person":"xianzhu-p0088","role":"被命接军","evidence":["dongyuan-e-p004b-q"]}],"place":null,"time":{"label":"中平五年及六年","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-p004b-q"]},"ordering_evidence":"dongyuan-e-p004b-q","source_order":[6,26,"P004b"],"order":1481},{"id":"dongyuan-e-p027a","title":"董卓皇甫嵩同征韩遂不相下董卓因交兵属嵩怒","accounts":[{"id":"dongyuan-e-p027a-account","label":"《山阳公载记》","text":"董卓皇甫嵩同征韩遂不相下董卓因交兵属嵩怒","evidence":["dongyuan-e-p027a-q"]}],"participants":[{"person":"wudi-p0053","role":"争军","evidence":["dongyuan-e-p027a-q"]},{"person":"xianzhu-p0088","role":"同征","evidence":["dongyuan-e-p027a-q"]}],"place":null,"time":{"label":"董卓皇甫嵩征韩遂及为太师后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-p027a-q"]},"ordering_evidence":"dongyuan-e-p027a-q","source_order":[6,113,"P027a"],"order":1531},{"id":"dongyuan-e-p027b","title":"皇甫嵩车下拜董卓与之相讥","accounts":[{"id":"dongyuan-e-p027b-account","label":"《山阳公载记》","text":"皇甫嵩车下拜董卓与之相讥","evidence":["dongyuan-e-p027b-q"]}],"participants":[{"person":"wudi-p0053","role":"问话","evidence":["dongyuan-e-p027b-q"]},{"person":"xianzhu-p0088","role":"应对","evidence":["dongyuan-e-p027b-q"]}],"place":null,"time":{"label":"董卓皇甫嵩征韩遂及为太师后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-p027b-q"]},"ordering_evidence":"dongyuan-e-p027b-q","source_order":[6,113,"P027b"],"order":1532},{"id":"dongyuan-e-p027c","title":"董卓问皇甫嵩惧否皇甫嵩以淫刑为戒而和解","accounts":[{"id":"dongyuan-e-p027c-account","label":"张璠《汉纪》","text":"董卓执手问怖，皇甫嵩答以德辅朝廷和淫刑之别，二人和解。","evidence":["dongyuan-e-p027c-q"]}],"participants":[{"person":"wudi-p0053","role":"问话和解","evidence":["dongyuan-e-p027c-q"]},{"person":"xianzhu-p0088","role":"答问","evidence":["dongyuan-e-p027c-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-p027c-q"]},"ordering_evidence":"dongyuan-e-p027c-q","source_order":[6,113,"P027c"],"order":1533},{"id":"dongyuan-e-p048b","title":"士孙瑞历显官为大司农三老诸公辞让","accounts":[{"id":"dongyuan-e-p048b-account","label":"《三辅决录注》","text":"董卓诛后士孙瑞任大司农、国三老，诸公辞让于瑞。","evidence":["dongyuan-e-p048b-q"]}],"participants":[{"person":"dongyuan-p0009","role":"任官","evidence":["dongyuan-e-p048b-q"]},{"person":"zhouyu-p0002","role":"辞让","evidence":["dongyuan-e-p048b-q"]},{"person":"xianzhu-p0088","role":"辞让","evidence":["dongyuan-e-p048b-q"]},{"person":"dongyuan-p0099","role":"辞让","evidence":["dongyuan-e-p048b-q"]},{"person":"wendi-p0040","role":"辞让","evidence":["dongyuan-e-p048b-q"]},{"person":"wudi-p0153","role":"辞让","evidence":["dongyuan-e-p048b-q"]},{"person":"dongyuan-p0100","role":"辞让","evidence":["dongyuan-e-p048b-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-p048b-q"]},"ordering_evidence":"dongyuan-e-p048b-q","source_order":[6,179,"P048b"],"order":1591},{"id":"gongsuntao-e-o178","title":"皇甫嵩表请武将召拜谦扬武都尉征羌大破","accounts":[{"id":"gongsuntao-a-e693345985fbcad1afb5","l