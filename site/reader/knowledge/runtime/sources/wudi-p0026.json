idence":["dongyuan-e-p030a-q"]},"ordering_evidence":"dongyuan-e-p030a-q","source_order":[6,116,"P030a"],"order":1534},{"id":"dongyuan-e-p038b","title":"李傕郭汜杀鲁旭周奂崔烈王颀乱兵杀吏民","accounts":[{"id":"dongyuan-e-p038b-account","label":"张璠《汉纪》","text":"李傕郭汜杀鲁旭周奂崔烈王颀乱兵杀吏民","evidence":["dongyuan-e-p038b-q"]}],"participants":[{"person":"wudi-p0089","role":"入城杀官","evidence":["dongyuan-e-p038b-q"]},{"person":"wudi-p0090","role":"入城杀官","evidence":["dongyuan-e-p038b-q"]},{"person":"dongyuan-p0081","role":"被杀","evidence":["dongyuan-e-p038b-q"]},{"person":"dongyuan-p0082","role":"被杀","evidence":["dongyuan-e-p038b-q"]},{"person":"wudi-p0026","role":"被杀","evidence":["dongyuan-e-p038b-q"]},{"person":"dongyuan-p0083","role":"被杀","evidence":["dongyuan-e-p038b-q"]}],"place":null,"time":{"label":"长安陷时及王允早仕","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-p038b-q"]},"ordering_evidence":"dongyuan-e-p038b-q","source_order":[6,141,"P038b"],"order":1557}],"persons":[{"id":"wudi-p0026","name":"崔烈","evidence":["wudi-q-p004","zhuge-q-p003","dongyuan-q-p011"],"facts":[],"aliases":[],"mentions":[{"id":"wudi-m-p004-wudi-p0026","kind":"mention","text":"文中提及","evidence":["wudi-q-p004"]},{"id":"zhuge-m-p003-wudi-p0026","kind":"mention","text":"文中提及","evidence":["zhuge-q-p003"]},{"id":"dongyuan-m-p011-wudi-p0026","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p011"]},{"id":"dongyuan-m-p030-wudi-p0026","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p030"]},{"id":"dongyuan-m-p038-wudi-p0026","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p038"]}]}],"evidence":[{"id":"dongyuan-e-p011b-q","section":"chapter-006","block":"b-cdac6233c17ed1dee3c9","layer":"pei","quote":"公卿百官奉迎于北芒坂下，故太尉崔烈在前导。卓将步骑数千来迎，烈呵使避。卓骂烈曰：‘昼夜三百里来，何云避！我不能断卿头邪？’前见帝曰：‘陛下令常侍、小黄门作乱乃尔，以取祸败。为负不小邪！’又趋陈留王，曰：‘我董卓也，从我抱来！’乃于贡抱中取王。","attribution":"《英雄记》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":50,"anchor":null},"note_id":"n-cbc1d2a2f124a8616d88","start":51,"end":172},{"id":"dongyuan-e-p030a-q","section":"chapter-006","block":"b-be130afba4e9d8f6ed6f","layer":"pei","quote":"灵帝时榜门卖官，于是太尉段颎、司徒崔烈、太尉樊陵、司空张温之徒，皆入钱，上千万，下五百万，以买三公。","attribution":"《傅子》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":115,"anchor":null},"note_id":"n-2584e332007810716e08","start":10,"end":60},{"id":"dongyuan-e-p038b-q","section":"chapter-006","block":"b-8af5e76b0ed888dab0d3","layer":"pei","quote":"傕、汜入长安城，屯南宫掖门，杀太仆鲁（馗）〔旭〕、大鸿胪周奂、城门校尉崔烈、越骑校尉王颀。吏民死者不可胜数。","attribution":"张璠《汉纪》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":140,"anchor":null},"note_id":"n-3cfb2aeb829267780c42","start":94,"end":148},{"id":"dongyuan-q-p011","section":"chapter-006","block":"b-cdac6233c17ed1dee3c9","layer":"pei","quote":"《英雄记》曰：“河南中部掾闵贡，扶帝及陈留王，上至雒舍止。帝独乘一马，陈留王与贡共乘一马，从雒舍南行。公卿百官奉迎于北芒坂下，故太尉崔烈在前导。卓将步骑数千来迎，烈呵使避。卓骂烈曰：‘昼夜三百里来，何云避！我不能断卿头邪？’前见帝曰：‘陛下令常侍、小黄门作乱乃尔，以取祸败。为负不小邪！’又趋陈留王，曰：‘我董卓也，从我抱来！’乃于贡抱中取王。”","attribution":"《英雄记》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":50,"anchor":null},"note_id":"n-cbc1d2a2f124a8616d88","start":0,"end":173},{"id":"dongyuan-q-p030","section":"chapter-006","block":"b-be130afba4e9d8f6ed6f","layer":"pei","quote":"灵帝时榜门卖官，于是太尉段颎、司徒崔烈、太尉樊陵、司空张温之徒，皆入钱，上千万，下五百万，以买三公。颎数征伐有大功，烈有北州重名，温有杰才，陵能偶时；皆一时显士，犹以货取位；而况于刘嚣、唐珍、张颢之党乎！","attribution":"《傅子》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":115,"anchor":null},"note_id":"n-2584e332007810716e08","start":10,"end":112},{"id":"dongyuan-q-p038","section":"chapter-006","block":"b-8af5e76b0ed888dab0d3","layer":"pei","quote":"﹝三﹞张璠《汉纪》曰：“布兵败，驻马青琐门外。谓允曰：‘公可以去！’允曰：‘安国家，吾之上愿也；若不获，则奉身以死！朝廷幼主，恃我而已；临难苟免，吾不为也。努力！谢关东诸公，以国家为念。’傕、汜入长安城，屯南宫掖门，杀太仆鲁（馗）〔旭〕、大鸿胪周奂、城门校尉崔烈、越骑校尉王颀。吏民死者不可胜数。司徒王允挟天子，上宣平城门避兵。傕等于城门下拜，伏地叩头。帝谓傕等曰：‘卿无作威福！而乃放兵纵横，欲何为乎？’傕等曰：‘董卓忠于陛下，而无故为吕布所杀。臣等为卓报仇，弗敢为逆也！请事竟，诣廷尉，受罪。’允穷逼，出见傕；傕诛允及妻子宗族十余人。长安城中男女大小莫不流涕。允字子师，太原祁人也。少有大节，郭泰见而奇之，曰：‘王生一日千里，王佐之才也！’泰虽先达，遂与定交。三公并辟。历豫州刺史，辟荀爽、孔融为从事。迁河南尹，尚书令。及为司徒，其所以扶持王室，甚得大臣之节。自天子以下，皆倚赖焉。卓亦推信之，委以朝廷。”","attribution":"张璠《汉纪》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":140,"anchor":null},"note_id":"n-3cfb2aeb829267780c42","start":0,"end":405},{"id":"wudi-e-p004a-q","section":"chapter-001","block":"b-e90db5467d9d5623caa7","layer":"pei","quote":"为司隶校尉。灵帝擢拜大司农、大鸿胪，代崔烈为太尉。","attribution":"《续汉书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":15,"anchor":null},"note_id":"n-32f37ed50b79cc722888","start":26,"end":51},{"id":"wudi-q-p004","section":"chapter-001","block":"b-e90db5467d9d5623caa7","layer":"pei","quote":"﹝三﹞《续汉书》曰：“嵩字巨高。质性敦慎，所在忠孝。为司隶校尉。灵帝擢拜大司农、大鸿胪，代崔烈为太尉。黄初元年，追尊嵩曰太皇帝。”","attribution":"《续汉书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":15,"anchor":null},"note_id":"n-32f37ed50b79cc722888","start":0,"end":65},{"id":"zhuge-q-p003","section":"chapter-035","block":"b-5b0387b2cca0f13524e2","layer":"pei","quote":"﹝三﹞按《崔氏谱》：州平，太尉烈子，均之弟也。","attribution":"《崔氏谱》","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":25,"anchor":null},"note_id":"n-e40ccd03a9bef78547a3","start":0,"end":23}],"profiles":{},"directory_counts":{}}
