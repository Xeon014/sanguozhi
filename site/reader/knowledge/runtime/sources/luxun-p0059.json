-e-o075a-q"]},{"person":"luxun-p0056","role":"等遁退","evidence":["zhanggu-q-12a904f491b9d053a45f"]},{"person":"luxun-p0059","role":"同遁退","evidence":["zhanggu-q-12a904f491b9d053a45f"]},{"person":"zhanggu-p0018","role":"惟璿绍祀","evidence":["zhanggu-q-12a904f491b9d053a45f"]},{"person":"shaodi-p0162","role":"使陆抗西行者","evidence":["zhanggu-q-12a904f491b9d053a45f"]}],"place":null,"time":{"label":"西陵战后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["luxun-e-o075a-q"]},"ordering_evidence":"luxun-e-o075a-q","source_order":[58,353,"O075a"],"order":10395}],"persons":[{"id":"luxun-p0059","name":"杨肇","evidence":["luxun-q-o073","zhanggu-q-4e6bf5ff89170aad6e55","zhanggu-q-12a904f491b9d053a45f"],"facts":[],"aliases":[],"mentions":[{"id":"luxun-m-o073-luxun-p0059","kind":"mention","text":"文中提及","evidence":["luxun-q-o073"]},{"id":"luxun-m-o074-luxun-p0059","kind":"mention","text":"文中提及","evidence":["luxun-q-o074"]}]}],"evidence":[{"id":"luxun-e-o073a-q","section":"chapter-058","block":"b-00c7d3403d867b106f10","layer":"original","quote":"晋巴东监军徐胤率水军诣建平〖12〗，荆州刺史杨肇至西陵。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":350,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":28,"offset_unit":"unicode_code_point"},{"id":"luxun-e-o073c-q","section":"chapter-058","block":"b-00c7d3403d867b106f10","layer":"original","quote":"将军朱乔、营都督俞赞，亡诣肇〖14〗。抗曰：“赞军中旧吏，知吾虚实者。吾常虑夷兵素不简练〖15〗，若敌攻围，必先此处！”即夜易夷（民）〔兵〕，皆以旧将充之。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":350,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":77,"end":155,"offset_unit":"unicode_code_point"},{"id":"luxun-e-o074a-q","section":"chapter-058","block":"b-076b63a347bfe52cc440","layer":"original","quote":"明日，肇果攻故夷兵处，抗命旋军击之；矢石雨下，肇众伤死者相属。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":351,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":31,"offset_unit":"unicode_code_point"},{"id":"luxun-e-o074b-q","section":"chapter-058","block":"b-076b63a347bfe52cc440","layer":"original","quote":"肇至经月，计屈夜遁。抗欲追之，而虑阐蓄力项领〖16〗，伺视间隙，兵不足分；于是但鸣鼓戒众〖17〗，若将追者。肇众汹惧〖18〗，悉解甲挺走〖19〗。抗使轻兵蹑之〖20〗，肇大破败。祜等皆引军还。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":351,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":31,"end":127,"offset_unit":"unicode_code_point"},{"id":"luxun-e-o075a-q","section":"chapter-058","block":"b-4a26ea8a0f80eb1773d2","layer":"original","quote":"抗遂陷西陵城；诛夷阐族及其大将吏，自此以下，所请赦者数万口。修治城围，东还乐乡；貌无矜色，谦冲如常，故得将士欢心。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":352,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":57,"offset_unit":"unicode_code_point"},{"id":"luxun-q-o073","section":"chapter-058","block":"b-00c7d3403d867b106f10","layer":"original","quote":"晋巴东监军徐胤率水军诣建平〖12〗，荆州刺史杨肇至西陵。抗令张咸固守其城；公安督孙遵巡南岸御祜〖13〗；水军督留虑、镇西将军朱琬拒胤；身率三军，凭围对肇。将军朱乔、营都督俞赞，亡诣肇〖14〗。抗曰：“赞军中旧吏，知吾虚实者。吾常虑夷兵素不简练〖15〗，若敌攻围，必先此处！”即夜易夷（民）〔兵〕，皆以旧将充之。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":350,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":155,"offset_unit":"unicode_code_point"},{"id":"luxun-q-o074","section":"chapter-058","block":"b-076b63a347bfe52cc440","layer":"original","quote":"明日，肇果攻故夷兵处，抗命旋军击之；矢石雨下，肇众伤死者相属。肇至经月，计屈夜遁。抗欲追之，而虑阐蓄力项领〖16〗，伺视间隙，兵不足分；于是但鸣鼓戒众〖17〗，若将追者。肇众汹惧〖18〗，悉解甲挺走〖19〗。抗使轻兵蹑之〖20〗，肇大破败。祜等皆引军还。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":351,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":127,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-72dd776e7f89a6336198","section":"chapter-048","block":"b-fa0fe4a3ed8ad4520955","layer":"original","quote":"阐不应，据城降晋","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":425,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":18,"end":26,"offset_unit":"unicode_code_point"},{"id":"zhanggu-q-12a904f491b9d053a45f","section":"chapter-052","block":"b-abb819d300d36cb02c9f","layer":"original","quote":"孙皓使陆抗西行，祜等遁退。抗陷城，斩阐等。步氏泯灭，惟璿绍祀","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":456,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":30,"offset_unit":"unicode_code_point"},{"id":"zhanggu-q-4e6bf5ff89170aad6e55","section":"chapter-052","block":"b-924121af7bdd349c256c","layer":"original","quote":"凤凰元年，召为绕帐督。阐累世在西陵，猝被征命，自以失职，又惧有谗祸；于是据城降晋，遣玑弟璿诣洛阳为任〖5〗。晋以阐为都督西陵诸军事，卫将军，仪同三司，加侍中，假节，领交州牧，封宜都公〖6〗；玑监江陵诸军事，左将军，加散骑常侍，领（庐陵）〔庐江〕太守，改封江陵侯；璿给事中，宣威将军〖7〗，封都乡侯。命车骑将军羊祜、荆州刺史杨肇，往赴救阐","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":455,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":168,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
