PS/Text/titlepage_0084.xhtml","index":149,"anchor":null},"note_id":null,"start":16,"end":28},{"id":"dongliu-q-290c0e0dd99d2d2600d3","section":"chapter-039","block":"b-56bd53348c75c5b9fee8","layer":"original","quote":"丞相亮将北征，住汉中；虑后主富于春秋〖3〗，朱紫难别〖4〗；以允秉心公亮〖5〗，欲任以宫省之事","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":150,"anchor":null},"note_id":null,"start":11,"end":58},{"id":"dongliu-q-32d4abdd75007dfc8ac8","section":"chapter-039","block":"b-646f63e7c593b8e7011e","layer":"modern","quote":"〖25〗七年：延熙七年（公元 244）。","attribution":"现代注释","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":182,"anchor":null},"note_id":"n-3de6b583d628599061de","start":0,"end":20},{"id":"dongliu-q-3c3ab3adb9523da5140e","section":"chapter-039","block":"b-b1b7ac204dd9a5a8c921","layer":"original","quote":"延熙六年，加辅国将军","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":155,"anchor":null},"note_id":null,"start":0,"end":10},{"id":"dongliu-q-3e01ee948b8e39ef1dd3","section":"chapter-039","block":"b-cb86ef6274fdc0c982d8","layer":"original","quote":"而郎中襄阳董恢，诣允修敬〖19〗。恢年少官微，见允停出，逡巡求去〖20〗。允不许，曰：“本所以出者，欲与同好游谈也。今君已自屈〖21〗，方展阔积〖22〗；舍此之谈，就彼之宴，非所谓也〖23〗。”乃命解骖〖24〗，祎等罢驾不行","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":154,"anchor":null},"note_id":null,"start":34,"end":146},{"id":"dongliu-q-52345a2180859151c47d","section":"chapter-039","block":"b-56bd53348c75c5b9fee8","layer":"original","quote":"后主袭位，迁黄门侍郎","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":150,"anchor":null},"note_id":null,"start":0,"end":10},{"id":"dongliu-q-5adb1bc3a37e7c3ed3ea","section":"chapter-039","block":"b-3fecc4c6954cfd608ab2","layer":"original","quote":"后入为尚书。代董允为尚书令","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":216,"anchor":null},"note_id":null,"start":0,"end":13},{"id":"dongliu-q-6fabf95b59e11db33ff6","section":"chapter-039","block":"b-41e87ca4801badabc2ea","layer":"original","quote":"允常上则正色匡主〖15〗，下则数责于皓；皓畏允，不敢为非","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":153,"anchor":null},"note_id":null,"start":31,"end":59},{"id":"dongliu-q-91af810846f5ae3f00a1","section":"chapter-039","block":"b-56bd53348c75c5b9fee8","layer":"original","quote":"上疏曰：“侍中郭攸之、费祎、侍郎董允等，先帝简拔以遗陛下","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":150,"anchor":null},"note_id":null,"start":62,"end":90},{"id":"dongliu-q-b8d0fe3fa4f819c24040","section":"chapter-039","block":"b-d5144ca9316a63f57474","layer":"modern","quote":"〖26〗九年：延熙九年（公元 246）。","attribution":"现代注释","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":183,"anchor":null},"note_id":"n-8625da91fa25bd3b8fc2","start":0,"end":20},{"id":"dongliu-q-c94f732dc1d885c5ca38","section":"chapter-039","block":"b-d1c4b34bb5398cc83d22","layer":"original","quote":"陈祗代允为侍中，与黄皓互相表里〖1〗；皓始预政事","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":188,"anchor":null},"note_id":null,"start":0,"end":24},{"id":"dongliu-q-cd27e4cca7a9a20fc237","section":"chapter-039","block":"b-56bd53348c75c5b9fee8","layer":"original","quote":"亮寻请祎为参军","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":150,"anchor":null},"note_id":null,"start":161,"end":168},{"id":"dongliu-q-ce8754eaafdaabaf639a","section":"chapter-039","block":"b-6c9ff832a0cd47c98965","layer":"original","quote":"尚书令蒋琬领益州刺史，上疏以让费祎及允","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":152,"anchor":null},"note_id":null,"start":0,"end":19},{"id":"dongliu-q-d9892220b99a032f970f","section":"chapter-039","block":"b-b1b7ac204dd9a5a8c921","layer":"original","quote":"七年〖25〗，以侍中守尚书令，为大将军费祎副贰","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":155,"anchor":null},"note_id":null,"start":11,"end":34},{"id":"dongliu-q-e3d89b1a3c22e0045d9b","section":"chapter-039","block":"b-68451c2ed7a8a7585594","layer":"original","quote":"自祗之有宠，后主追怨允日深，谓为自轻〖14〗；由祗媚兹一人，皓构间浸润故耳","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":192,"anchor":null},"note_id":null,"start":0,"end":37},{"id":"dongliu-q-fa3efe11475bb4d9a84c","section":"chapter-039","block":"b-7f1aac330b2100a1cbd4","layer":"original","quote":"费祎甚异之，故超继允内侍","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":189,"anchor":null},"note_id":null,"start":60,"end":72},{"id":"dongliu-q-fd2fc3f880af72e7ab71","section":"chapter-039","block":"b-a7571ed9495912585b9e","layer":"original","quote":"后主常欲采择以充后宫〖9〗，允以为“古者天子后妃之数不过十二；今嫔嫱已具〖10〗，不宜增益”，终执不听","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":151,"anchor":null},"note_id":null,"start":14,"end":65},{"id":"dongliu-q2-292cafb013edd628114d","section":"chapter-039","block":"b-7f1aac330b2100a1cbd4","layer":"original","quote":"祗字奉宗，汝南人。许靖兄之外孙也。少孤，长于靖家。弱冠知名。稍迁至选曹郎〖4〗。矜厉有威容〖5〗，多技艺，挟数术〖6〗。费祎甚异之，故超继允内侍〖7〗。","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":189,"anchor":null},"note_id":null,"start":0,"end":76},{"id":"dongliu-q2-b8b42f556d17329a85d6","section":"chapter-039","block":"b-3fecc4c6954cfd608ab2","layer":"original","quote":"后入为尚书。代董允为尚书令，众事无留〖11〗，门无停宾〖12〗。乂历职内外，治身俭约，谦靖少言；为政简而不烦，号为清能。然持法刻深〖13〗，好用文俗吏〖14〗；故居大官，名声损于郡县〖15〗。延熙十四年卒。","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":216,"anchor":null},"note_id":null,"start":0,"end":103},{"id":"dongliu-q2-f5a5fb1b5a0007c46c35","section":"chapter-039","block":"b-d1c4b34bb5398cc83d22","layer":"original","quote":"陈祗代允为侍中，与黄皓互相表里〖1〗；皓始预政事。祗死后，皓从黄门令，为中常侍、奉车都尉〖2〗，操弄威柄，终至覆国。蜀人无不追思允。及邓艾至蜀，闻皓奸险，收闭〖3〗，将杀之；而皓厚赂艾左右，得免。","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":188,"anchor":null},"note_id":null,"start":0,"end":98},{"id":"dongliu-q2-f6fe054185dcfe86a77d","section":"chapter-039","block":"b-aa10e5f0d2cfeb33df76","layer":"original","quote":"九年〖25〗，都护李平坐诬罔废〖26〗。诸葛亮与长史蒋琬、侍中董允书曰：“孝起前临至吴，为吾说‘正方腹中有鳞甲〖27〗，乡党以为不可近’。吾以为‘鳞甲者’，但不当犯之耳；不图复有苏、张之事出于不意〖28〗。可使孝起知之。”","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":116,"anchor":null},"note_id":null,"start":0,"end":111},{"id":"houzhu-q-O014","section":"chapter-033","block":"b-6af7fe784f1e0008c0e9","layer":"original","quote":"五年春，丞相亮出屯汉中，营沔北阳平、石马〖6〗。﹝二﹞","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":38,"anchor":null},"note_id":null,"start":0,"end":27},{"id":"huangli-q-35d0854ebbacd22277ac","section":"chapter-043","block":"b-d2ec35871a73902cd80f","layer":"original","quote":"建兴五年，丞相亮北住汉中","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":193,"anchor":null},"note_id":null,"start":0,"end":12},{"id":"huowang-q-7deeebf0e8889001c1fc","section":"chapter-041","block":"b-06fb1f2ea118ceeed874","layer":"original","quote":"五年〖1〗，随亮汉中","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":39,"anchor":null},"note_id":null,"start":0,"end":10},{"id":"huowang-q-cf555a5e236ef873ec39","section":"chapter-041","block":"b-e6998c80678c2b5e8a5a","layer":"original","quote":"丞相诸葛亮北驻汉中，请为记室〖5〗，使与子乔共周旋游处","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":5,"anchor":null},"note_id":null,"start":27,"end":54},{"id":"huowang-q-d6bd9abf610f84d31df3","section":"chapter-041","block":"b-ddba202528f8d05c7b7b","layer":"original","quote":"诸葛亮当北行，表与后主曰","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":43,"anchor":null},"note_id":null,"start":0,"end":12},{"id":"jfj-q0087","section":"chapter-044","block":"b-39673f1f78c36c0a87b8","layer":"original","quote":"会先主定蜀，祎遂留益土。与汝南许叔龙、南郡董允齐名；时许靖丧子，允与祎欲共会其葬所。允白父和请车〖2〗，和遣开后鹿车给之〖3〗。允有难载之色〖4〗，祎便从前先上。及至丧所，诸葛亮及诸贵人悉集，车乘甚鲜〖5〗；允犹神色未泰〖6〗，而祎晏然自若。持车人还，和问之；知其如此，乃谓允曰：“吾常疑汝于文伟优劣未别也；而今而后，吾意了矣〖7〗。”先主立太子，祎与允俱为舍人。迁庶子。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":107,"anchor":null},"note_id":null,"start":0,"end":186},{"id":"jfj-q0088","section":"chapter-044","block":"b-39673f1f78c36c0a87b8","layer":"original","quote":"时许靖丧子，允与祎欲共会其葬所。允白父和请车〖2〗，和遣开后鹿车给之〖3〗。允有难载之色〖4〗，祎便从前先上。及至丧所，诸葛亮及诸贵人悉集，车乘甚鲜〖5〗；允犹神色未泰〖6〗，而祎晏然自若。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":107,"anchor":null},"note_id":null,"start":26,"end":121},{"id":"jfj-q0089","section":"chapter-044","block":"b-39673f1f78c36c0a87b8","layer":"original","quote":"持车人还，和问之；知其如此，乃谓允曰：“吾常疑汝于文伟优劣未别也；而今而后，吾意了矣","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":107,"anchor":null},"note_id":null,"start":121,"end":163},{"id":"jfj-q0090","section":"chapter-044","block":"b-39673f1f78c36c0a87b8","layer":"original","quote":"先主立太子，祎与允俱为舍人。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":107,"anchor":null},"note_id":null,"start":168,"end":182},{"id":"jfj-q0213","section":"chapter-044","block":"b-0c46703a18bc8810c0ef","layer":"pei","quote":"董允代祎为尚书令","attribution":"《祎别传》","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":153,"anchor":null},"note_id":"n-f7f9356c7b9b5e330d15","start":94,"end":102},{"id":"jfj-q0214","section":"chapter-044","block":"b-0c46703a18bc8810c0ef","layer":"pei","quote":"﹝四﹞《祎别传》曰：“于时军国多事，公务繁猥；祎识悟过人，每省读书记，举目暂视，已究其意旨；其速，数倍于人，终亦不忘。常以朝晡听事，其间接纳宾客，饮食嬉戏，加之博弈；每尽人之欢，事亦不废。董允代祎为尚书令，欲学祎之所行；旬日之中，事多愆滞。允乃叹曰：‘人才力相悬，若此甚远，此非吾之所及也！听事终日，犹有不暇尔。’”","attribution":"《祎别传》","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":153,"anchor":null},"note_id":"n-f7f9356c7b9b5e330d15","start":0,"end":158},{"id":"jfj-q0215","section":"chapter-044","block":"b-0c46703a18bc8810c0ef","layer":"pei","quote":"欲学祎之所行；旬日之中，事多愆滞。允乃叹曰：‘人才力相悬，若此甚远，此非吾之所及也！听事终日，犹有不暇尔。","attribution":"《祎别传》","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":153,"anchor":null},"note_id":"n-f7f9356c7b9b5e330d15","start":103,"end":156},{"id":"jfj-q0234","section":"chapter-044","block":"b-c0266db4bcde577eb422","layer":"pei","quote":"﹝一﹞《华阳国志》曰：“维恶黄皓恣擅，启后主欲杀之。后主曰：‘皓趋走小臣耳！往董允切齿，吾常恨之，君何足介意！’维见皓枝附叶连，惧于失言，逊辞而出。后主敕皓诣维陈谢；维说皓求沓中种麦，以避内逼耳。”","attribution":"《华阳国志》","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":227,"anchor":null},"note_id":"n-22ccaba798fe6d967677","start":0,"end":99},{"id":"liuliao-q-2ce94aa555b48d9d49d5","section":"chapter-040","block":"b-3432b319a4ef9b1daa34","layer":"original","quote":"五年〖1〗，诸葛亮驻汉中；更以延为督前部〖2〗，领丞相司马〖3〗，凉州刺史。","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":271,"anchor":null},"note_id":null,"start":10,"end":48},{"id":"liuliao-q-8e51c44a0be9c4974f53","section":"chapter-040","block":"b-a2d578375714e8a92044","layer":"original","quote":"延大怒，（才）〔搀〕仪未发〖8〗，率所领径先南归；所过烧绝阁道〖9〗。延、仪各相表叛逆〖10〗，一日之中，羽檄交至〖11〗。后主以问侍中董允、留府长史蒋琬，琬、允咸保仪疑延","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":292,"anchor":null},"note_id":null,"start":0,"end":86},{"id":"zhuge-e-o024a-q","section":"chapter-035","block":"b-1cb2342652e8f8d4d768","layer":"original","quote":"五年〖1〗，率诸军北驻汉中。临发，上疏曰〖2〗：","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":152,"anchor":null},"note_id":null,"start":0,"end":24},{"id":"zhuge-q-b-bac68d65cbee34059b3b","section":"chapter-035","block":"b-bac68d65cbee34059b3b","layer":"modern","quote":"〖1〗五年：建兴五年（公元 227）。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":160,"anchor":null},"note_id":"n-7b55cee111ab139cccf8","start":0,"end":19},{"id":"zhuge-q-o024","section":"chapter-035","block":"b-1cb2342652e8f8d4d768","layer":"original","quote":"五年〖1〗，率诸军北驻汉中。临发，上疏曰〖2〗：","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":152,"anchor":null},"note_id":null,"start":0,"end":24},{"id":"zhuge-q-o025-judgment","section":"chapter-035","block":"b-f349f47d12e0cbd06380","layer":"original","quote":"先帝创业未半而中道崩殂〖3〗，今天下三分，益州疲弊〖4〗：此诚危急存亡之秋也〖5〗。然待卫之臣不懈于内〖6〗，忠志之士忘身于外者〖7〗，盖追先帝之殊遇〖8〗，欲报之于陛下也。诚宜开张圣听〖9〗，以光先帝遗德，恢弘志士之气；不宜妄自菲薄〖10〗，引喻失义〖11〗，以塞忠谏之路也。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":153,"anchor":null},"note_id":null,"start":0,"end":139},{"id":"zhuge-q-o026-judgment","section":"chapter-035","block":"b-b541f3054e32715de401","layer":"original","quote":"宫中、府中俱为一体；陟罚臧否〖12〗，不宜异同〖13〗。若有作奸犯科及为忠善者〖14〗，宜付有司论其刑赏〖15〗，以昭陛下平明之理〖16〗；不宜偏私，使内外异法也。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":154,"anchor":null},"note_id":null,"start":0,"end":82},{"id":"zhuge-q-o027","section":"chapter-035","block":"b-f53c08ba28ed4fadd5f0","layer":"original","quote":"侍中、侍郎郭攸之、费祎、董允等〖17〗，此皆良实，志虑忠纯，是以先帝简拔以遗陛下〖18〗。愚以为宫中之事〖19〗，事无大小，悉以咨之，然后施行；必能裨补阙漏〖20〗，有所广益。将军向宠〖21〗，性行淑均〖22〗，晓畅军事；试用于昔日，先帝称之曰能，是以众议举宠为督〖23〗。愚以为营中之事〖24〗，悉以咨之；必能使行阵和睦〖25〗，优劣得所。亲贤臣，远小人，此先汉所以兴隆也〖26〗；亲小人，远贤臣，此后汉所以倾颓也。先帝在时，每与臣论此事，未尝不叹息痛恨于桓、灵也〖27〗。侍中、尚书、长史、参军〖28〗，此悉贞良死节之臣〖29〗，愿陛下亲之信之，则汉室之隆，可计日而待也。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":155,"anchor":null},"note_id":null,"start":0,"end":288},{"id":"zhuge-q-o027-judgment","section":"chapter-035","block":"b-f53c08ba28ed4fadd5f0","layer":"original","quote":"侍中、侍郎郭攸之、费祎、董允等〖17〗，此皆良实，志虑忠纯，是以先帝简拔以遗陛下〖18〗。愚以为宫中之事〖19〗，事无大小，悉以咨之，然后施行；必能裨补阙漏〖20〗，有所广益。将军向宠〖21〗，性行淑均〖22〗，晓畅军事；试用于昔日，先帝称之曰能，是以众议举宠为督〖23〗。愚以为营中之事〖24〗，悉以咨之；必能使行阵和睦〖25〗，优劣得所。亲贤臣，远小人，此先汉所以兴隆也〖26〗；亲小人，远贤臣，此后汉所以倾颓也。先帝在时，每与臣论此事，未尝不叹息痛恨于桓、灵也〖27〗。侍中、尚书、长史、参军〖28〗，此悉贞良死节之臣〖29〗，愿陛下亲之信之，则汉室之隆，可计日而待也。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":155,"anchor":null},"note_id":null,"start":0,"end":288},{"id":"zhuge-q-o028","section":"chapter-035","block":"b-334ba1b152f8848f7ced","layer":"original","quote":"臣本布衣〖30〗，躬耕于南阳〖31〗；苟全性命于乱世〖32〗，不求闻达于诸侯〖33〗。先帝不以臣卑鄙〖34〗，猥自枉屈〖35〗，三顾臣于草庐之中，咨臣以当世之事；由是感激〖36〗，遂许先帝以驱驰〖37〗；后值倾覆〖38〗，受任于败军之际；奉命于危难之间：尔来二十有一年矣〖39〗。﹝一﹞先帝知臣谨慎，故临崩寄臣以大事也。受命以来，夙夜忧叹，恐托付不效〖40〗，以伤先帝之明；故五月渡泸〖41〗，深入不毛〖42〗。﹝二﹞今南方已定，兵甲已足；当奖率三军〖43〗，北定中原；庶竭驽钝〖44〗，攘除奸凶〖45〗；兴复汉室，还于旧都。此臣所以报先帝，而忠陛下之职分也。至于斟酌损益，进尽忠言，则攸之、袆、允之任也。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":156,"anchor":null},"note_id":null,"start":0,"end":303},{"id":"zhuge-q-o028-judgment","section":"chapter-035","block":"b-334ba1b152f8848f7ced","layer":"original","quote":"臣本布衣〖30〗，躬耕于南阳〖31〗；苟全性命于乱世〖32〗，不求闻达于诸侯〖33〗。先帝不以臣卑鄙〖34〗，猥自枉屈〖35〗，三顾臣于草庐之中，咨臣以当世之事；由是感激〖36〗，遂许先帝以驱驰〖37〗；后值倾覆〖38〗，受任于败军之际；奉命于危难之间：尔来二十有一年矣〖39〗。﹝一﹞先帝知臣谨慎，故临崩寄臣以大事也。受命以来，夙夜忧叹，恐托付不效〖40〗，以伤先帝之明；故五月渡泸〖41〗，深入不毛〖42〗。﹝二﹞今南方已定，兵甲已足；当奖率三军〖43〗，北定中原；庶竭驽钝〖44〗，攘除奸凶〖45〗；兴复汉室，还于旧都。此臣所以报先帝，而忠陛下之职分也。至于斟酌损益，进尽忠言，则攸之、袆、允之任也。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":156,"anchor":null},"note_id":null,"start":0,"end":303},{"id":"zhuge-q-o029","section":"chapter-035","block":"b-b687c1ebece526d57fd5","layer":"original","quote":"愿陛下托臣以讨贼兴复之效；不效，则治臣之罪，以告先帝之灵。〔若无兴德之言，则〕责攸之、祎、允等之慢〖46〗，以彰其咎。陛下亦宜自谋〖47〗，以咨诹善道〖48〗，察纳雅言〖49〗，深追先帝遗诏。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":157,"anchor":null},"note_id":null,"start":0,"end":96},{"id":"zhuge-q-o029-judgment","section":"chapter-035","block":"b-b687c1ebece526d57fd5","layer":"original","quote":"愿陛下托臣以讨贼兴复之效；不效，则治臣之罪，以告先帝之灵。〔若无兴德之言，则〕责攸之、祎、允等之慢〖46〗，以彰其咎。陛下亦宜自谋〖47〗，以咨诹善道〖48〗，察纳雅言〖49〗，深追先帝遗诏。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":157,"anchor":null},"note_id":null,"start":0,"end":96},{"id":"zhuge-q-o030-judgment","section":"chapter-035","block":"b-5b1e2aef1cc53d06cf76","layer":"original","quote":"臣不胜受恩感激；今当远离，临表涕零，不知所言！","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":158,"anchor":null},"note_id":null,"start":0,"end":23}],"profiles":{"zhuge-p0028":{"fields":[],"directory":{"faction":"shu"}}},"directory_counts":{}}
