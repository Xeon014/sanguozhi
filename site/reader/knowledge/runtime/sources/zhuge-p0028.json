1a1a12d","chapter-013":"24c6e486e7f78fc4d59ff01277b36cb77ffb69c68a6a9030889fe00efe4b3d27","chapter-016":"6cfac20452f269a832b087d2e808cc4b3017944d17dca1d5b1e068ebb98d8327","chapter-018":"7a62f43c1f5dc64661b088ef0fdd48392063ef5c49001fa980aa65e766380b23","chapter-019":"a43f6648e6c9d8389d561bee9d00824665f8f06542ab2a65aac06ed8a7601c5b","chapter-020":"2ef7e28be018140e07d27d7636a9df480a5cb7ef1cb3572c314a70e0d1acd07c","chapter-050":"71faaaddb69f25a5bdd7f315f15562e867eed9e897c9bd439a99a09c435bfe91","chapter-023":"908d4e64a01e171bdb09c0a7ee5484b8743be26b7cc75f49bd8b41b7ff391ff2","chapter-024":"39be893c0040dbb3148f9447402c47fc24dcb4356360f8558243258cb85b089a","chapter-025":"f37fc365e7d07f96b5fd289119e1846fe7f0030d8b46a7195fab316badf817b7","chapter-027":"dd48b2052380e1f6b6f6ffcb4835dd99cfe70efe4a9096fa51448dbdfaa14f00","chapter-062":"7031fb8ebde1ea3c95cdedcf93218fb46f69a71a29a1d9e82361f7108436a86a","chapter-063":"3ae8edfbae98c3e86a518f7022c664ed35a0d68d5ac36b331ceb560e76b1848f","chapter-065":"13c50dd7dc9a229aef1cfb43dd231955a0b1a6359dab04c54708df93fa114e12","chapter-057":"39e3922e223fe25b811b77f14049327071298549de6ed788ba7da697f067f2e3","chapter-021":"18c02b71e8f81644cf71ffea582a8e019509de0b5e9bc11451de595fa03e2cf3","chapter-029":"6ffb35bac29d20aa512b5a734e72f98ec5729b176f1bc5d6837e673bcc00880d","chapter-030":"3e0682212c3e242d0f221308bc203bd8309851b8498b94db16383bdde5234ce1"},"events":[{"id":"zhuge-e-o024a","title":"诸葛亮率诸军北驻汉中临行上疏","accounts":[{"id":"zhuge-e-o024a-account","label":"《诸葛亮传第五》正文","text":"诸葛亮率诸军北驻汉中临行上疏","evidence":["zhuge-e-o024a-q"]},{"id":"zhuge-a-o025-judgment","label":null,"text":"先帝创业未半而中道崩殂〖3〗，今天下三分，益州疲弊〖4〗：此诚危急存亡之秋也〖5〗。然待卫之臣不懈于内〖6〗，忠志之士忘身于外者〖7〗，盖追先帝之殊遇〖8〗，欲报之于陛下也。诚宜开张圣听〖9〗，以光先帝遗德，恢弘志士之气；不宜妄自菲薄〖10〗，引喻失义〖11〗，以塞忠谏之路也。","evidence":["zhuge-q-o025-judgment"]},{"id":"zhuge-a-o026-judgment","label":null,"text":"宫中、府中俱为一体；陟罚臧否〖12〗，不宜异同〖13〗。若有作奸犯科及为忠善者〖14〗，宜付有司论其刑赏〖15〗，以昭陛下平明之理〖16〗；不宜偏私，使内外异法也。","evidence":["zhuge-q-o026-judgment"]},{"id":"zhuge-a-o027-judgment","label":null,"text":"侍中、侍郎郭攸之、费祎、董允等〖17〗，此皆良实，志虑忠纯，是以先帝简拔以遗陛下〖18〗。愚以为宫中之事〖19〗，事无大小，悉以咨之，然后施行；必能裨补阙漏〖20〗，有所广益。将军向宠〖21〗，性行淑均〖22〗，晓畅军事；试用于昔日，先帝称之曰能，是以众议举宠为督〖23〗。愚以为营中之事〖24〗，悉以咨之；必能使行阵和睦〖25〗，优劣得所。亲贤臣，远小人，此先汉所以兴隆也〖26〗；亲小人，远贤臣，此后汉所以倾颓也。先帝在时，每与臣论此事，未尝不叹息痛恨于桓、灵也〖27〗。侍中、尚书、长史、参军〖28〗，此悉贞良死节之臣〖29〗，愿陛下亲之信之，则汉室之隆，可计日而待也。","evidence":["zhuge-q-o027-judgment"]},{"id":"zhuge-a-o028-judgment","label":null,"text":"臣本布衣〖30〗，躬耕于南阳〖31〗；苟全性命于乱世〖32〗，不求闻达于诸侯〖33〗。先帝不以臣卑鄙〖34〗，猥自枉屈〖35〗，三顾臣于草庐之中，咨臣以当世之事；由是感激〖36〗，遂许先帝以驱驰〖37〗；后值倾覆〖38〗，受任于败军之际；奉命于危难之间：尔来二十有一年矣〖39〗。﹝一﹞先帝知臣谨慎，故临崩寄臣以大事也。受命以来，夙夜忧叹，恐托付不效〖40〗，以伤先帝之明；故五月渡泸〖41〗，深入不毛〖42〗。﹝二﹞今南方已定，兵甲已足；当奖率三军〖43〗，北定中原；庶竭驽钝〖44〗，攘除奸凶〖45〗；兴复汉室，还于旧都。此臣所以报先帝，而忠陛下之职分也。至于斟酌损益，进尽忠言，则攸之、袆、允之任也。","evidence":["zhuge-q-o028-judgment"]},{"id":"zhuge-a-o029-judgment","label":null,"text":"愿陛下托臣以讨贼兴复之效；不效，则治臣之罪，以告先帝之灵。〔若无兴德之言，则〕责攸之、祎、允等之慢〖46〗，以彰其咎。陛下亦宜自谋〖47〗，以咨诹善道〖48〗，察纳雅言〖49〗，深追先帝遗诏。","evidence":["zhuge-q-o029-judgment"]},{"id":"zhuge-a-o030-judgment","label":null,"text":"臣不胜受恩感激；今当远离，临表涕零，不知所言！","evidence":["zhuge-q-o030-judgment"]},{"id":"houzhu-a-30a442ec906d","label":"《后主传》正文","text":"五年春，丞相亮出屯汉中，营沔北阳平、石马〖6〗。﹝二﹞","evidence":["houzhu-q-O014"]},{"id":"liuliao-a-2f8d5567ff51fb275394","label":"正文","text":"建兴五年亮驻汉中以延为督前部","evidence":["liuliao-q-2ce94aa555b48d9d49d5"]},{"id":"dongliu-a-f9998db57e8a2096580d","label":"正文","text":"诸葛亮上疏举郭攸之费祎董允","evidence":["dongliu-q-91af810846f5ae3f00a1"]},{"id":"dongliu-a-992eaf34a813a22e44d9","label":"正文","text":"诸葛亮请费祎为参军","evidence":["dongliu-q-cd27e4cca7a9a20fc237"]},{"id":"huangli-a-9c216d1f5aeb6add018a","label":"正文","text":"诸葛亮北住汉中","evidence":["huangli-q-35d0854ebbacd22277ac"]},{"id":"huowang-a-9b13da752a0d24f8c4d8","label":"正文","text":"诸葛亮请霍弋为记室","evidence":["huowang-q-cf555a5e236ef873ec39"]},{"id":"huowang-a-b4e2cb1d65c7fc17f669","label":"正文","text":"向朗随亮至汉中","evidence":["huowang-q-7deeebf0e8889001c1fc"]},{"id":"huowang-a-6aa9bbdca089f821b21e","label":"正文","text":"诸葛亮表荐向宠","evidence":["huowang-q-d6bd9abf610f84d31df3"]},{"id":"dengzhang