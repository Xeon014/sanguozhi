{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"yaoci-e-o071","title":"刺史丁宫征还京都，壹侍送勤恪，宫感之许他日相辟；后宫为司徒辟壹，比至宫已免","accounts":[{"id":"yaoci-a-1090ffbf93016ae7fd76","label":"正文","text":"刺史丁宫征还京都，壹侍送勤恪，宫感之许他日相辟；后宫为司徒辟壹，比至宫已免","evidence":["yaoci-q-d135f7e6537de7362c0a"]},{"id":"yaoci-a-112a979702bd5d2ec169","label":"正文","text":"黄琬代丁宫为司徒，甚礼遇士壹；董卓作乱，壹亡归乡里","evidence":["yaoci-q-e0768a41282ddeb089b2"]},{"id":"yaoci-a-b0a19ce801df75e7002e","label":"裴注·吴书","text":"琬与卓相害，壹尽心于琬甚有声称；卓恶之，署教曰司徒掾士壹不得除用，故历年不迁；会卓入关，壹乃亡归","evidence":["yaoci-q-373ff8d65a36238281b4"]}],"participants":[{"person":"dongyuan-p0063","role":"征还而感壹者","evidence":["yaoci-q-d135f7e6537de7362c0a"]},{"person":"yaoci-p0014","role":"侍送受辟者；被礼遇而亡归者；尽心于琬而被抑亡归者","evidence":["yaoci-q-d135f7e6537de7362c0a","yaoci-q-e0768a41282ddeb089b2","yaoci-q-373ff8d65a36238281b4"]},{"person":"xiahoucao-p0071","role":"礼遇者；相害之一方","evidence":["yaoci-q-e0768a41282ddeb089b2","yaoci-q-373ff8d65a36238281b4"]},{"person":"wudi-p0053","role":"作乱者（背景）；恶壹而抑之者","evidence":["yaoci-q-e0768a41282ddeb089b2","yaoci-q-373ff8d65a36238281b4"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["yaoci-q-d135f7e6537de7362c0a","yaoci-q-e0768a41282ddeb089b2","yaoci-q-373ff8d65a36238281b4"]},"ordering_evidence":"yaoci-q-d135f7e6537de7362c0a","source_order":[49,177,18],"order":8986},{"id":"yaoci-e-o072","title":"交州刺史朱符为夷贼所杀，州郡扰乱；燮乃表壹领合浦太守，次弟徐闻令领九真太守，弟武领南海太守","accounts":[{"id":"yaoci-a-218cf5ef5b4cdef8c3fa","label":"正文","text":"交州刺史朱符为夷贼所杀，州郡扰乱；燮乃表壹领合浦太守，次弟徐闻令领九真太守，弟武领南海太守","evidence":["yaoci-q-65645e78792244c7c78d"]}],"participants":[{"person":"wudi-p0414","role":"表弟分领诸郡者","evidence":["yaoci-q-65645e78792244c7c78d"]},{"person":"yaoci-p0014","role":"领合浦太守者","evidence":["yaoci-q-65645e78792244c7c78d"]},{"person":"yaoci-p0017","role":"领九真太守者","evidence":["yaoci-q-65645e78792244c7c78d"]},{"person":"yaoci-p0016","role":"领南海太守者","evidence":["yaoci-q-656