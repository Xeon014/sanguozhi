{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[],"persons":[{"id":"dongliu-p2-hubo","name":"胡博（胡济弟）","evidence":["dongliu-q2-47f19b08a7e00154e3c1"],"facts":[{"id":"dongliu-f2-1beb025fe95d02074564","text":"胡博为胡济之弟，历长水校尉、尚书。","evidence":["dongliu-q2-47f19b08a7e00154e3c1"]}],"aliases":[],"mentions":[]}],"evidence":[{"id":"dongliu-q2-47f19b08a7e00154e3c1","section":"chapter-039","block":"b-a960132fa057a65b87be","layer":"pei","quote":"﹝二﹞伟度者，姓胡，名济，义阳人。为亮主簿，有忠荩之效，故见褒述。亮卒，为中典军，统诸军，封成阳亭侯。迁中监军，前将军，督汉中；假节，领兖州刺史；至右骠骑将军。济弟博，历长水校尉、尚书。","attribution":"裴注（引书见原文）","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":43,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-39ea3649f54e599ce9c6","start":0,"end":93,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
