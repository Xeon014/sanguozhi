di-q-o008","basis":"中平六年","reviewed":true}},"source_order":[1,61,"O007a"],"order":38},{"id":"wudi-e-o007b","title":"何进召董卓并遇害","accounts":[{"id":"wudi-e-o007b-account","label":"正文","text":"何进、袁绍谋诛宦官，太后不从；何进召董卓欲胁太后，董卓未至何进已被杀。","evidence":["wudi-e-o007b-q"]},{"id":"dongyuan-e-o004a-account","label":"《董二袁刘传第六》正文","text":"何进袁绍谋诛宦官不获何后允乃召董卓上书胁后","evidence":["dongyuan-e-o004a-q"]},{"id":"rensu-a-a2a10996fc035139d6d9","label":"裴注·张璠《汉纪》","text":"何进将诛黄门欲召董卓为助，郑泰谏以董卓强忍寡义、诚不待卓以为资援，又陈时之要务，进不能用","evidence":["rensu-q-ec413709301b2ab7a3a6"]},{"id":"rensu-a-98f4c4bd5fe9ba35d51a","label":"裴注·张璠《汉纪》","text":"何进寻见害","evidence":["rensu-q-fb2143a5a0d18b851ec9"]}],"participants":[{"person":"wudi-p0051","role":"谋诛宦官并遇害","evidence":["wudi-e-o007b-q"]},{"person":"wudi-p0052","role":"参与谋议","evidence":["wudi-e-o007b-q"]},{"person":"wudi-p0050","role":"不允","evidence":["wudi-e-o007b-q"]},{"person":"wudi-p0053","role":"被召","evidence":["wudi-e-o007b-q"]},{"person":"wudi-p0067","role":"进谏者","evidence":["rensu-q-ec413709301b2ab7a3a6"]}],"place":null,"time":{"label":"中平六年","year":189,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o007b-q","wudi-q-o008","wudi-q-b-c8312ddce42041c69855"],"chronology":"wudi-y189","dating_review":{"anchor":"wudi-q-o008","basis":"中平六年","reviewed":true}},"source_order":[1,61,"O007b"],"order":39},{"id":"wudi-e-o008c","title":"董卓杀何太后","accounts":[{"id":"wudi-e-o008c-account","label":"正文","text":"正文合叙董卓杀太后及弘农王；现代注释辨明太后被杀在中平六年。","evidence":["wudi-e-o008c-q","wudi-q-b-c8312ddce42041c69855"]},{"id":"dongyuan-e-o007d-account","label":"《董二袁刘传第六》正文","text":"董卓杀何太后。","evidence":["dongyuan-e-o007d-q"]}],"participants":[{"person":"wudi-p0053","role":"杀害","evidence":["wudi-e-o008c-q","wudi-q-b-c8312ddce42041c69855"]},{"person":"wudi-p0050","role":"被害","evidence":["wudi-e-o008c-q","wudi-q-b-c8312ddce42041c69855"]}],"place":null,"time":{"label":"中平六年","year":189,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o008c-q","wudi-q-b-c