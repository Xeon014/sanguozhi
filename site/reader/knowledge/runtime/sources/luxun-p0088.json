{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zongshi-e2-luji-companions-killed","title":"陆机、陆云、陆耽被杀，孙丞与陆机俱被害","accounts":[{"id":"zongshi-a2-edb11e2c1daa0e870a2b","label":"裴注（引书见原文）","text":"陆机、陆云、陆耽被杀，孙丞与陆机俱被害","evidence":["zongshi-q2-68bf95195e074706b982","zongshi-q2-3aa9aa78b3086e01b0d4"]}],"participants":[{"person":"luxun-p0076","role":"被杀者","evidence":["zongshi-q2-68bf95195e074706b982","zongshi-q2-3aa9aa78b3086e01b0d4"]},{"person":"wuzhu-p0110","role":"被杀者","evidence":["zongshi-q2-68bf95195e074706b982","zongshi-q2-3aa9aa78b3086e01b0d4"]},{"person":"luxun-p0088","role":"被杀者","evidence":["zongshi-q2-68bf95195e074706b982","zongshi-q2-3aa9aa78b3086e01b0d4"]},{"person":"zongshi-p0006","role":"《文士传》所记俱被害者","evidence":["zongshi-q2-68bf95195e074706b982","zongshi-q2-3aa9aa78b3086e01b0d4"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["zongshi-q2-68bf95195e074706b982","zongshi-q2-3aa9aa78b3086e01b0d4"]},"ordering_evidence":"zongshi-q2-68bf95195e074706b982","related_events":[{"event":"zongshi-e-o126","type":"related","evidence":["zongshi-q2-68bf95195e074706b982","zongshi-q2-3aa9aa78b3086e01b0d4","zongshi-q-803d3a3a8ea5c1982bde"]},{"event":"zongshi-e-o126-s2-1","type":"related","evidence":["zongshi-q2-68bf95195e074706b982","zongshi-q2-3aa9aa78b3086e01b0d4","zongshi-q-83223e6b8c7ffc0dfb7c"]}],"order":9177},{"id":"luxun-e-p018h","title":"牵秀孟玖谮陆机司马颖收杀陆氏兄弟","accounts":[{"id":"luxun-e-p018h-account","label":"《机云别传》","text":"牵秀等与孟玖谮陆机，司马颖信之，收陆机陆云陆耽，皆伏法。","evidence":["luxun-e-p018h-q"]},{"id":"luxun-a-p018-comment","label":"《机云别传》","text":"别传称陆氏兄弟无罪被夷，并引人以陆抗诛及婴孩说报应；这些是该书评述，非客观因果。","evidence":["luxun-q-p018-comment"]},{"id":"luxun-a-p018-letter","label":"孙惠致朱诞书（《机云别传》所载）","text":"孙惠致朱诞书以马援择君为比，叹三陆相携暴朝杀身伤名。","evidence":["luxun-q-p018-letter"]}],"participants":[{"person":"luxun-p0085","role":"谮毁","evidence":["luxun-e-p018h-q"]},{"person":"luxun-p0086","role":"谮毁","evidence":["luxun-e-p018h-q"]},{"person":"luxun-p0082","role":"令收","evidence":["luxun-e-p018h-q"]},{"person":"luxun-p0076","role":"被杀","evidence":["luxun-e-p018h-q"]},{"person":"wuzhu-p0110","role":"被杀","evidence":["luxun-e-p018h-q"]},{"person":"luxun-p0088","role":"被杀","evidence":["luxun-e-p018h-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["luxun-e-p018h-q"]},"ordering_evidence":"luxun-e-p018h-q","source_order":[58,455,"P018h"],"order":10420}],"persons":[{"id":"luxun-p0088","name":"陆耽","evidence":["luxun-q-p018","zongshi-q-803d3a3a8ea5c1982bde","zongshi-q2-68bf95195e074706b982","zongshi-q2-3aa9aa78b3086e01b0d4"],"facts":[],"aliases":[],"mentions":[{"id":"luxun-m-p018-luxun-p0088","kind":"mention","text":"文中提及","evidence":["luxun-q-p018"]}]}],"evidence":[{"id":"luxun-e-p018h-q","section":"chapter-058","block":"b-20b860773c1dd9d264dc","layer":"pei","quote":"及牵秀等谮机于颖，以为持两端；玖又构之于内：颖信之。遣收机，并收云及弟耽，并伏法。","attribution":"《机云别传》","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":454,"anchor":null},"note_id":"n-d3a7d3771e82327ad7c0","start":365,"end":406},{"id":"luxun-q-p018","section":"chapter-058","block":"b-20b860773c1dd9d264dc","layer":"pei","quote":"﹝二﹞景弟机，字士衡；云，字士龙。《机云别传》曰：“晋太康末，俱入洛，造司空张华。华一见而奇之，曰：‘伐吴之役，利在获二俊。’遂为之延誉，荐之诸公。太傅杨骏辟机为祭酒。转太子洗马，尚书著作郎。云为吴王郎中令。出宰浚仪，甚有惠政，吏民怀之，生为立祠。后并历显位。机天才绮练，文藻之美，独冠于时。云亦善属文，清新不及机，而口辩持论，过之。于时朝廷多故，机、云并自结于成都王颖。颖用机为平原相，云清河内史。寻转云右司马，甚见委仗。无几而与长沙王构隙，遂举兵攻洛。以机行后将军，督王粹、牵秀等诸军二十万；士龙著《南征赋》以美其事。机，吴人，羇旅单宦；顿居群士之右，多不厌服。机屡战失利，死散过半。初，宦人孟玖，颖所嬖幸，乘宠预权。云数言其短，颖不能纳；玖又从而毁之。是役也，玖弟超，亦领众配机，不奉军令。机绳之以法，超宣言曰‘陆机将反’。及牵秀等谮机于颖，以为持两端；玖又构之于内：颖信之。遣收机，并收云及弟耽，并伏法。机兄弟既江南之秀，亦著名诸夏；并以无罪夷灭，天下痛惜之。机文章为世所重，云所著亦传于世。初，抗之克步阐也，诛及婴孩。识道者尤之曰：‘后世必受其殃！’及机之诛，三族无遗。孙惠与朱诞书曰：‘马援择君，凡人所闻。不意三陆，相携暴朝；杀身伤名，可为悼叹！’”事亦并在《晋书》。","attribution":"《机云别传》及裴注","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":454,"anchor":null},"note_id":"n-d3a7d3771e82327ad7c0","start":0,"end":540},{"id":"luxun-q-p018-comment","section":"chapter-058","block":"b-20b860773c1dd9d264dc","layer":"pei","quote":"机兄弟既江南之秀，亦著名诸夏；并以无罪夷灭，天下痛惜之。机文章为世所重，云所著亦传于世。初，抗之克步阐也，诛及婴孩。识道者尤之曰：‘后世必受其殃！’及机之诛，三族无遗。","attribution":"《机云别传》","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":454,"anchor":null},"note_id":"n-d3a7d3771e82327ad7c0","start":406,"end":490},{"id":"luxun-q-p018-letter","section":"chapter-058","block":"b-20b860773c1dd9d264dc","layer":"pei","quote":"孙惠与朱诞书曰：‘马援择君，凡人所闻。不意三陆，相携暴朝；杀身伤名，可为悼叹！’","attribution":"孙惠致朱诞书（《机云别传》所载）","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":454,"anchor":null},"note_id":"n-d3a7d3771e82327ad7c0","start":490,"end":530},{"id":"zongshi-q-803d3a3a8ea5c1982bde","section":"chapter-051","block":"b-838933eb0906948787bc","layer":"pei","quote":"成都王颖，召为大将军参军。是时颖将有事于长沙，以陆机为前锋都督。惠与机，乡里亲厚，忧其致祸。谓之曰：‘子盍让都督于王粹乎？’机曰：‘将谓吾避贼首鼠，更速其害！’机寻被戮；二弟云、耽，亦见杀。惠甚伤恨之","attribution":"裴注·惠别传","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":134,"anchor":null},"note_id":"n-1c9591ac978a693556d2","start":164,"end":264},{"id":"zongshi-q-83223e6b8c7ffc0dfb7c","section":"chapter-051","block":"b-d784627aa3d293accfb1","layer":"pei","quote":"永安中，陆机为成都王大都督，请丞为司马：与机俱被害","attribution":"裴注·文士传","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":233,"anchor":null},"note_id":"n-75f5bb207dd97fe936cc","start":120,"end":145},{"id":"zongshi-q2-3aa9aa78b3086e01b0d4","section":"chapter-051","block":"b-d784627aa3d293accfb1","layer":"pei","quote":"与机俱被害。","attribution":"裴注·文士传","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":233,"anchor":null},"note_id":"n-75f5bb207dd97fe936cc","start":140,"end":146},{"id":"zongshi-q2-68bf95195e074706b982","section":"chapter-051","block":"b-838933eb0906948787bc","layer":"pei","quote":"机寻被戮；二弟云、耽，亦见杀。","attribution":"裴注（引书见原文）","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":134,"anchor":null},"note_id":"n-1c9591ac978a693556d2","start":244,"end":259}],"profiles":{},"directory_counts":{}}
