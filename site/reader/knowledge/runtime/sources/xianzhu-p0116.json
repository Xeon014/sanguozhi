text":"文中提及","evidence":["xianzhu-q-o070"]},{"id":"pangfa-m-o017-xianzhu-p0116","kind":"mention","text":"文中提及","evidence":["pangfa-q-o017"]},{"id":"luxun-m-o014-xianzhu-p0116","kind":"mention","text":"文中提及","evidence":["luxun-q-o014"]},{"id":"liuermu-m2-role-0493b4045e5d49a08781","kind":"mention","text":"文中提及","evidence":["liuermu-q-dde36aaadb127cf1c44d","liuermu-q2-5b650d5ea983b66bb39d"]}]}],"evidence":[{"id":"liuermu-q-2a0c1cb6c4e5f46ba5f6","section":"chapter-031","block":"b-68829a859074ff697ede","layer":"pei","quote":"进攻韪于江州","attribution":"裴注·英雄记","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":114,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a064e7f7d913bb80211c","start":170,"end":176,"offset_unit":"unicode_code_point"},{"id":"liuermu-q-c30a2dc62a4805271612","section":"chapter-031","block":"b-68829a859074ff697ede","layer":"pei","quote":"韪将庞乐、李异反杀韪军，斩韪","attribution":"裴注·英雄记","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":114,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a064e7f7d913bb80211c","start":177,"end":191,"offset_unit":"unicode_code_point"},{"id":"liuermu-q-dde36aaadb127cf1c44d","section":"chapter-031","block":"b-bb8534db9135eea0c435","layer":"original","quote":"后松复说璋曰：“今州中诸将庞羲、李异等，皆恃功骄豪，欲有外意〖15〗；不得豫州〖16〗，则敌攻其外，民攻其内：必败之道也","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":70,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":60,"offset_unit":"unicode_code_point"},{"id":"liuermu-q2-5b650d5ea983b66bb39d","section":"chapter-031","block":"b-bb8534db9135eea0c435","layer":"original","quote":"后松复说璋曰：“今州中诸将庞羲、李异等，皆恃功骄豪，欲有外意〖15〗；不得豫州〖16〗，则敌攻其外，民攻其内：必败之道也。”璋又从之，遣法正请先主。璋主簿黄权陈其利害〖17〗，从事广汉王累自倒悬于州门以谏〖18〗；璋一无所纳，敕在所：供奉先主〖19〗；先主入境如归〖20〗。","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":70,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":137,"offset_unit":"unicode_code_point"},{"id":"luxun-e-o014a-q","section":"chapter-058","block":"b-14229cda9534092a0f4f","layer":"original","quote":"逊遣将军李异、谢旌等，将三千人，攻蜀将詹晏、陈凤。异将水军，旌将步兵，断绝险要；即破晏等，生降得凤〖35〗。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":41,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":54,"offset_unit":"unicode_code_point"},{"id":"luxun-q-o014","section":"chapter-058","block":"b-14229cda9534092a0f4f","layer":"original","quote":"逊遣将军李异、谢旌等，将三千人，攻蜀将詹晏、陈凤。异将水军，旌将步兵，断绝险要；即破晏等，生降得凤〖35〗。又攻房陵太守邓辅、南乡太守郭睦，大破之。秭归大姓文布、邓凯等，合夷兵数千人，首尾西方〖36〗。逊复部旌，讨破布、凯〖37〗。布、凯脱走，蜀以为将。逊令人诱之，布帅众还降。前后斩获招纳，凡数万计。权以逊为右护军、镇西将军〖38〗，进封娄侯〖39〗。﹝一﹞","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":41,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":180,"offset_unit":"unicode_code_point"},{"id":"pangfa-q-o017","section":"chapter-037","block":"b-a4c4094bb2ac49487cff","layer":"original","quote":"本为明将军计者，必谓此军悬远无粮，馈运不及，兵少无继。今荆州道通，众数十倍；加孙车骑遣弟及李异、甘宁等为其后继〖35〗。若争客主之势〖36〗，以土地相胜者；今此全有巴东，广汉、犍为，过半已定；巴西一郡，复非明将军之有也。计益州所仰惟蜀〖37〗，蜀亦破坏，三分亡二；吏民疲困，思为乱者十户而八。若敌远则百姓不能堪役〖38〗，敌近则一旦易主矣〖39〗；广汉诸县，是明比也〖40〗。又鱼复与关头，实为益州福祸之门〖41〗。今二门悉开，坚城皆下，诸军并破，兵将俱尽；而敌家数道并进〖42〗，已入心腹。坐守都、雒〖43〗，存亡之势，昭然可见。斯乃大略〖44〗，其外较耳〖45〗；其余屈曲〖46〗，难以辞极也〖47〗。以正下愚，犹知此事不可复成；况明将军左右明智用谋之士，岂当不见此数哉？旦夕偷幸〖48〗，求容取媚，不虑远图，莫肯尽心献良计耳！若事穷势迫，将各索生〖49〗，求济门户〖50〗；展转反覆〖51〗，与今计异，不为明将军尽死难也；而尊门犹当受其忧〖52〗。","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":83,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":427,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o067b-q","section":"chapter-032","block":"b-f54e9d2c0e7f626f5702","layer":"original","quote":"吴将陆议、李异、刘阿等屯巫、秭归；将军吴班、冯习自巫攻破异等〖5〗；军次秭归，武陵五溪蛮夷遣使请兵〖6〗。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":400,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":41,"end":94,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o070a-q","section":"chapter-032","block":"b-b545db4aad347d176890","layer":"original","quote":"吴遣将军李异、刘阿等踵蹑先主军〖14〗，屯驻南山〖15〗。秋八月，收兵还巫。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":403,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":38,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-b-7396ee3085c96d5be06c","section":"chapter-032","block":"b-7396ee3085c96d5be06c","layer":"modern","quote":"〖22〗建安二十六年：公元 221 年。建安年号到二十四年为止。刘备不承认曹魏的年号，所以继续以建安年号记年。丙午：阴历初六日。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":380,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-dce0e27ac9260548c4b5","start":0,"end":64,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-b-e2b85eacbc16310809ee","section":"chapter-032","block":"b-e2b85eacbc16310809ee","layer":"modern","quote":"〖7〗二年：章武二年（公元 222）。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":413,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-18295fa1c5ff11c612db","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o065","section":"chapter-032","block":"b-3ec28bd830861da89fc0","layer":"original","quote":"即皇帝位于成都武担之南〖21〗，﹝一﹞为文曰：“惟建安二十六年四月丙午〖22〗，皇帝〔臣〕备，敢用玄牡〖23〗，昭告皇天上帝、后土神祇：汉有天下，历数无疆。曩者王莽篡盗〖24〗，光武皇帝震怒致诛，社稷复存。今曹操阻兵安忍〖25〗，戮杀主后；滔天泯夏〖26〗，罔顾天显〖27〗。操子丕，载其凶逆〖28〗，窃居神器。群臣将士以为社稷坠废，备宜修之；嗣武二祖〖29〗，龚行天罚。备惟否德〖30〗，惧忝帝位〖31〗；询于庶民，外及蛮夷君长，佥曰：‘天命不可以不答，祖业不可以久替，四海不可以无主；率土式望〖32〗，在备一人。’备畏天明命，又惧汉阼将湮于地；谨择元日〖33〗，与百僚登坛，受皇帝玺绶；修燔瘗〖34〗，告类于大神〖35〗。惟神〔尚〕飨〖36〗！祚于汉家，永绥四海〖37〗！”﹝二﹞","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":357,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":342,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o067","section":"chapter-032","block":"b-f54e9d2c0e7f626f5702","layer":"original","quote":"初，先主忿孙权之袭关羽，将东征。秋七月，遂帅诸军伐吴。孙权遣书请和，先主盛怒不许。吴将陆议、李异、刘阿等屯巫、秭归；将军吴班、冯习自巫攻破异等〖5〗；军次秭归，武陵五溪蛮夷遣使请兵〖6〗。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":400,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":94,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o068","section":"chapter-032","block":"b-8136daaf302c35b9c188","layer":"original","quote":"二年春正月〖7〗，先主军还秭归；将军吴班、陈式水军屯夷陵，夹江东西岸〖8〗。二月，先主自秭归率诸将进军，缘山截岭，于夷道猇亭﹝二﹞驻营〖9〗。自佷山﹝三﹞通武陵〖10〗，遣侍中马良安慰五溪蛮夷〖11〗，咸相率响应。镇北将军黄权督江北诸军，与吴军相拒于夷陵道。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":401,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":129,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o070","section":"chapter-032","block":"b-b545db4aad347d176890","layer":"original","quote":"吴遣将军李异、刘阿等踵蹑先主军〖14〗，屯驻南山〖15〗。秋八月，收兵还巫。司徒许靖卒。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":403,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":44,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
