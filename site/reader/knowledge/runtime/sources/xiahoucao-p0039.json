a535848ec30479","order":6173}],"persons":[{"id":"xiahoucao-p0039","name":"田银","evidence":["xiahoucao-q-o026","chengguo-q-e9ef9fa4cd8124a6b902","yuanzhang-q-633f2b32d3418b62af7a","hechang-q-a891aaa31d9e09fb4491","wuhuan-q-d35e0d35ee4f33b25299","wuhuan-q-676780a535848ec30479"],"facts":[],"aliases":[],"mentions":[{"id":"xiahoucao-m-o026-xiahoucao-p0039","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-o026"]}]}],"evidence":[{"id":"chengguo-q-e9ef9fa4cd8124a6b902","section":"chapter-014","block":"b-685583fef1cb76e4430b","layer":"pei","quote":"田银、苏伯等反河间，遣将军贾信讨之","attribution":"裴注·《魏书》","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":51,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-2bef09437466bf4731b4","start":27,"end":44,"offset_unit":"unicode_code_point"},{"id":"hechang-q-a891aaa31d9e09fb4491","section":"chapter-023","block":"b-b7ecd4aa2e05dfe91ba6","layer":"original","quote":"文帝为五官将，林为功曹〖4〗。太祖西征，田银、苏伯反，幽、冀扇动。文帝欲亲自讨之，林曰：“昔忝博陵，又在幽州；贼之形势，可料度也。北方吏民，乐安厌乱，服化已久，守善者多。银、伯犬羊相聚，智小谋大，不能为害。方今大军在远，外有强敌。将军为天下之镇也，轻动远举，虽克不武〖5〗。”文帝从之，遣将往伐，应时克灭。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":115,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":153,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-676780a535848ec30479","section":"chapter-030","block":"b-a1b338a00ad6850092a4","layer":"original","quote":"比能将三千余骑随柔击破银","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":68,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":24,"end":36,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-d35e0d35ee4f33b25299","section":"chapter-030","block":"b-a1b338a00ad6850092a4","layer":"original","quote":"田银反河间","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":68,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":18,"end":23,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o026b-q","section":"chapter-009","block":"b-12cd99d3c942a00fdf2f","layer":"original","quote":"苏伯、田银反，以仁行骁骑将军，都督七军，讨银等，破之。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":121,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":26,"end":53,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-o026","section":"chapter-009","block":"b-12cd99d3c942a00fdf2f","layer":"original","quote":"太祖讨马超，以仁行安西将军，督诸将拒潼关，破超渭南。苏伯、田银反，以仁行骁骑将军，都督七军，讨银等，破之。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":121,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":53,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-4dc80276d8d3acaff680","section":"chapter-011","block":"b-1b7d408a2eb4b1b39cfa","layer":"original","quote":"破贼文书，旧以一为十〖8〗；及渊上首级，如其实数。太祖问其故，渊曰：“夫征讨外寇，多其斩获之数者，欲以大武功〖9〗，且示民听也〖10〗。河间，在封域之内〖11〗；银等叛逆，虽克捷有功，渊窃耻之！”太祖大悦","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":135,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":72,"end":174,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-633f2b32d3418b62af7a","section":"chapter-011","block":"b-1b7d408a2eb4b1b39cfa","layer":"original","quote":"田银、苏伯反河间；银等既破，后有余党，皆应伏法。渊以为非首恶，请不行刑，太祖从之。赖渊得生者，千余人","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":135,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":21,"end":71,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
