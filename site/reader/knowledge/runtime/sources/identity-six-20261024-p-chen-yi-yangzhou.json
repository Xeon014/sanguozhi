vidence":["xumisun-q-2b1fd93f397d51ec82d9"]},"ordering_evidence":"xumisun-q-2b1fd93f397d51ec82d9","source_order":[38,4,31],"order":7016},{"id":"xumisun-e2-chenyi-death","title":"陈祎卒","accounts":[{"id":"xumisun-a2-a7f4c3c6150c886b3d42","label":"正文","text":"陈祎卒","evidence":["xumisun-q2-9635ce3445c6fe6385f0"]}],"participants":[{"person":"identity-six-20261024-p-chen-yi-yangzhou","role":"卒","evidence":["xumisun-q2-9635ce3445c6fe6385f0"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"第二轮逐项审定；仅保原文时序，不另行推年。","evidence":["xumisun-q2-9635ce3445c6fe6385f0"]},"ordering_evidence":"xumisun-q2-9635ce3445c6fe6385f0","order":7018}],"persons":[{"id":"identity-six-20261024-p-chen-yi-yangzhou","name":"陈祎（扬州刺史）","evidence":["identity-six-20261024-q-9c3cec214e20f006e64e","xumisun-q-2b1fd93f397d51ec82d9","xumisun-q2-9635ce3445c6fe6385f0","zhulv-q-4630ec617ea6042f8d68"],"facts":[],"mentions":[],"aliases":[]}],"evidence":[{"id":"dongyuan-e-p101c-q","section":"chapter-006","block":"b-dd2315fa487eddcf425c","layer":"pei","quote":"袁术更用陈瑀为扬州。瑀字公玮，下邳人。瑀既领州，而术败于封丘，南向寿春；瑀拒术不纳，术退保阴陵。更合军攻瑀，瑀惧走归下邳。","attribution":"裴松之按《英雄记》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":400,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cfd59ac468ffd86d6e36","start":55,"end":116,"offset_unit":"unicode_code_point"},{"id":"identity-six-20261024-q-9c3cec214e20f006e64e","section":"chapter-056","block":"b-0c6eb4c6b2f3d8fe89f1","layer":"pei","quote":"﹝二﹞《九州春秋》曰：“初平三年，扬州刺史陈祎死，袁术使瑀领扬州牧。后术为曹公所败于封丘，南人叛瑀，瑀拒之。术走阴陵，好辞以下瑀；瑀不知权，而又怯，不即攻术。术于淮北集兵，向寿春。瑀惧，使其弟公琰请和于术。术执之而进，瑀走归下邳。”","attribution":"裴注（引书见原文）","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":170,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cb5869d5039b350a109e","start":0,"end":116,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-2b1fd93f397d51ec82d9","section":"chapter-038","block":"b-a16f26994622830805a3","layer":"original","quote":"伷卒，依扬州刺史陈祎","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":3,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":31,"end":41,"offset_unit":"unicode_code_point"},{"id":"xumisun-q2-9635ce3445c6fe6385f0","section":"chapter-038","block":"b-3048dcb770e0662f6cb2","layer":"original","quote":"祎死，吴郡（都尉）〔太守〕许贡、会稽太守王朗素与靖有旧〖22〗，故往保焉〖23〗。靖收恤亲里〖24〗，经纪赈赡〖25〗，出于仁厚。","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":4,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":65,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-4630ec617ea6042f8d68","section":"chapter-056","block":"b-0c6eb4c6b2f3d8fe89f1","layer":"pei","quote":"初平三年，扬州刺史陈祎死，袁术使瑀领扬州牧","attribution":"裴注·九州春秋","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":170,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cb5869d5039b350a109e","start":12,"end":33,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-94bffb52918b1d9d4422","section":"chapter-056","block":"b-0c6eb4c6b2f3d8fe89f1","layer":"pei","quote":"术走阴陵，好辞以下瑀；瑀不知权，而又怯，不即攻术。术于淮北集兵，向寿春","attribution":"裴注·九州春秋","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":170,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cb5869d5039b350a109e","start":54,"end":89,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-9fa58c8f15bfcfd0fb17","section":"chapter-056","block":"b-0c6eb4c6b2f3d8fe89f1","layer":"pei","quote":"后术为曹公所败于封丘，南人叛瑀，瑀拒之","attribution":"裴注·九州春秋","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":170,"anchor":null},"source_s