":["rensu-q-4f0e743daf9464536218"]}],"participants":[{"person":"rensu-p0062","role":"到官课农者；课民者；兴学者","evidence":["rensu-q-79b49139f1687c9010a0","rensu-q-1545ecc0b09a7a63e6a1","rensu-q-2f670191faa3a3e81cd9","rensu-q-4f0e743daf9464536218"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["rensu-q-79b49139f1687c9010a0","rensu-q-1545ecc0b09a7a63e6a1","rensu-q-2f670191faa3a3e81cd9","rensu-q-4f0e743daf9464536218"]},"ordering_evidence":"rensu-q-79b49139f1687c9010a0","source_order":[16,375,44],"order":3465},{"id":"rensu-e-o216","title":"青龙中司马宣王（司马懿）在长安立军市，军中吏士多侵侮县民","accounts":[{"id":"rensu-a-d1ff7bbe99b38c0a1df8","label":"裴注·魏略","text":"青龙中司马宣王（司马懿）在长安立军市，军中吏士多侵侮县民","evidence":["rensu-q-28362eab4f01f507d91b"]},{"id":"rensu-a-078ec53e4266ff7d4f93","label":"裴注·魏略","text":"颜斐以白司马宣王，宣王发怒召军市候，便于斐前杖一百","evidence":["rensu-q-770f830952d36484b7bc"]},{"id":"rensu-a-027cab99abff9bd5beed","label":"裴注·魏略","text":"长安典农私推筑颜斐欲令谢，斐不肯谢，谓宣王受分陕之任欲一齐众庶，假令斐谢更为不得明公意","evidence":["rensu-q-8f4a878b7f0b5e035ab1"]},{"id":"rensu-a-64792902e5ce63c93fe7","label":"裴注·魏略","text":"司马宣王遂严持吏士，自是军营郡县各得其分","evidence":["rensu-q-504f4762df2a59a338c1"]}],"participants":[{"person":"wudi-p0364","role":"立军市者；杖军市候者；严持吏士者","evidence":["rensu-q-28362eab4f01f507d91b","rensu-q-770f830952d36484b7bc","rensu-q-504f4762df2a59a338c1"]},{"person":"rensu-p0062","role":"进白者；不肯谢者","evidence":["rensu-q-770f830952d36484b7bc","rensu-q-8f4a878b7f0b5e035ab1"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["rensu-q-28362eab4f01f507d91b","rensu-q-770f830952d36484b7bc","rensu-q-8f4a878b7f0b5e035ab1","rensu-q-504f4762df2a59a338c1"]},"ordering_evidence":"rensu-q-28362eab4f01f507d91b","source_order":[16,375,319],"order":3466},{"id":"rensu-e-o218","title":"吏民啼泣遮道，车不得前，步步稽留，十余日乃出界","accounts":[{"id":"rensu-a-4b19cb34c1454357abda","label":"裴注·魏略","text":"吏民啼泣遮道，车不得前，步步稽留，十余日乃出界","evidence":["rensu-q-fcfae6686f5adf632854"]},{"id":"rensu-a-b2924fe500d336fe2c7f","label":"裴注·魏略","text":"颜斐东行至崤而疾困，临卒言我心不愿平原、何不言京兆，遂卒，还平原","evidence":["rensu-q-1bc7730f373718fdd782"]},{"id":"rensu-a-d1283a14099ba8fa3870","label":"裴注·魏略","text":"京兆闻颜斐卒皆流涕，为立碑，于今称颂之","evidence":["rensu-q-bc7c378afce31bea6bab"]}],"participants":[{"person":"rensu-p0062","role":"离任者；疾困而卒者；受立碑称颂者","evidence":["rensu-q-fcfae6686f5adf632854","rensu-q-1bc7730f373718fdd782","rensu-q-bc7c378afce31bea6bab"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["rensu-q-fcfae6686f5adf632854","rensu-q-1bc7730f373718fdd782","rensu-q-bc7c378afce31bea6bab"]},"ordering_evidence":"rensu-q-fcfae6686f5adf632854","source_order":[16,375,494],"order":3467}],"persons":[{"id":"rensu-p0062","name":"颜斐","evidence":["rensu-q-79b49139f1687c9010a0","rensu-q-1545ecc0b09a7a63e6a1","rensu-q-2f670191faa3a3e81cd9","rensu-q-4f0e743daf9464536218","rensu-q-770f830952d36484b7bc","rensu-q-8f4a878b7f0b5e035ab1","rensu-q-fcfae6686f5adf632854","rensu-q-1bc7730f373718fdd782","rensu-q-bc7c378afce31bea6bab","rensu-q2-3a89d1c1613f4560adc3"],"facts":[{"id":"rensu-f2-b4b3517a1e3c9b15425d","text":"《魏略》记字文林，为太子洗马、黄门侍郎，出为京兆、平原太守。","evidence":["rensu-q2-3a89d1c1613f4560adc3"]}],"aliases":[],"mentions":[]}],"evidence":[{"id":"rensu-q-1545ecc0b09a7a63e6a1","section":"chapter-016","block":"b-6577b6fcf8117e2e08d7","layer":"pei","quote":"是时民多无车牛，斐又课民以闲月取车材，使转相教匠作车。又课民无牛者，令蓄猪狗，卖以买牛。始者，民以为烦；一二年间，家家有丁车、大牛","attribution":"裴注·魏略","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":374,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5a7a9e505ad84ef4841b","start":101,"end":166,"offset_unit":"unicode_code_point"},{"id":"rensu-q-1bc7730f373718fdd782","section":"chapter-016","block":"b-6577b6fcf8117e2e08d7","layer":"pei","quote":"东行，至崤而疾困。斐素心恋京兆，其家人从者，见斐病甚，劝之，言：‘平原，当自勉励作健。’斐曰：‘我心不愿平原！汝曹等呼我，何不言京兆邪？’遂卒，还平原","attribution":"裴注·魏略","section_title":"任苏杜郑仓