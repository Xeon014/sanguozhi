59,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":24,"end":31,"offset_unit":"unicode_code_point"},{"id":"huangli-q-e1483ff918bac0db8db5","section":"chapter-043","block":"b-8de1f97850df61e22fd0","layer":"original","quote":"时雍闿等闻先主薨于永安，骄黠滋甚","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":90,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":16,"offset_unit":"unicode_code_point"},{"id":"liuermu-q-a9f48e45367138fd4bf2","section":"chapter-031","block":"b-2a7eb34fd683676ae1b4","layer":"original","quote":"南中豪率雍闿据益郡反〖31〗，附于吴","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":75,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":3,"end":21,"offset_unit":"unicode_code_point"},{"id":"wendi-q-b-94d58550e3abb558ad13","section":"chapter-002","block":"b-94d58550e3abb558ad13","layer":"modern","quote":"〖1〗四年：黄初四年（公元 223）。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":394,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-2950ca88709b8c25fb44","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wendi-q-o038","section":"chapter-002","block":"b-62c39b4b73d5f8874468","layer":"original","quote":"四年春正月〖1〗，诏曰：“丧乱以来，兵革未戢〖2〗。天下之人，互相残杀。今海内初定，敢有私复仇者，皆族之〖3〗！”筑南巡台于宛。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":391,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":64,"offset_unit":"unicode_code_point"},{"id":"zhuge-e-o022b-q","section":"chapter-035","block":"b-cdc51ff4fdbd6022c499","layer":"original","quote":"南中诸郡，并皆叛乱。亮以新遭大丧，故未便加兵；且遣使聘吴，因结和亲〖8〗，遂为与国〖9〗。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":132,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":42,"end":87,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-o021","section":"chapter-035","block":"b-6f9ad1f5d575a9d3f55f","layer":"original","quote":"章武三年春，先主于永安病笃〖1〗；召亮于成都，属以后事。谓亮曰：“君才十倍曹丕，必能安国，终定大事。若嗣子可辅，辅之；如其不才〖2〗，君可自取〖3〗。”亮涕泣曰：“臣敢竭股肱之力〖4〗，效忠贞之节，继之以死！”先主又为诏敕后主曰：“汝与丞相从事〖5〗，事之如父。”﹝一﹞","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":131,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":135,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
