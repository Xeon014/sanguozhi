a67da","yuanzhang-q-ae596e3b733b71751961","yuanzhang-q-cac1af524d8814554c60","yuanzhang-q-fdbe082cd69364159d90","yuanzhang-q2-9e17a0168d7fdc3da8e2"],"facts":[{"id":"yuanzhang-f2-161b9b51c0fe7ca685f3","text":"《高士传》记太尉蒋济辟胡昭，胡昭不就。","evidence":["yuanzhang-q2-9e17a0168d7fdc3da8e2"]}],"aliases":[],"mentions":[]}],"evidence":[{"id":"yuanzhang-q-5bab6e6671947377466b","section":"chapter-011","block":"b-219b484e8215cd4f157d","layer":"original","quote":"太祖为司空、丞相，频加礼辟，昭往应命；既至，自陈一介野生，无军国之用，归诚求去〖1〗。太祖曰：“人各有志，出处异趣；勉卒雅尚〖2〗，义不相屈。”昭乃转居陆浑山中〖3〗。躬耕乐道，以经籍自娱。闾里敬而爱之","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":550,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":21,"end":122,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-7243071d3dca828aa56c","section":"chapter-011","block":"b-2126cefb1cf0507d214f","layer":"original","quote":"固率将十余吏卒，依昭住止；招集遗民，安复社稷","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":551,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":71,"end":93,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-77f0e696b94191e50dd7","section":"chapter-011","block":"b-2126cefb1cf0507d214f","layer":"original","quote":"狼等遂南附关羽，羽授印给兵，还为寇贼；到陆浑南长乐亭，自相约誓，言：“胡居士，贤者也〖9〗。一不得犯其部落〖10〗！”一川赖昭，咸无怵惕","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":551,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":97,"end":165,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-8b0653ba3f4b1cf8038f","section":"chapter-011","block":"b-c1aab782ad511127ae5e","layer":"original","quote":"正始中，骠骑将军赵俨，尚书黄休、郭彝，散骑常侍荀顗、钟毓〖14〗，太仆庾嶷，﹝三﹞弘农太守何桢等，﹝四﹞递荐昭曰：“天真高洁〖15〗，老而弥笃；玄虚静素，有夷、皓之节〖16〗。宜蒙征命，以励风俗","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":552,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":97,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-8ca1425ce995a945cf25","section":"chapter-011","block":"b-1949e3199bc22c50e552","layer":"original","quote":"至嘉平二年，公车特征〖17〗；会卒，年八十九。拜子纂郎中","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":553,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":28,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-9e6a88e504fcae782fa0","section":"chapter-011","block":"b-219b484e8215cd4f157d","layer":"original","quote":"胡昭，始避地冀州，亦辞袁绍之命，遁还乡里","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":550,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-ae596e3b733b71751961","section":"chapter-011","block":"b-f52adda04d4dcebae578","layer":"pei","quote":"昭虽有阴德于帝，口终不言，人莫知之。信行著于乡党","attribution":"裴注·高士传","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":577,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a4138397b368dfc7c4ab","start":85,"end":109,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-cac1af524d8814554c60","section":"chapter-011","block":"b-f52adda04d4dcebae578","layer":"pei","quote":"建安十六年，百姓闻马超叛，避兵入山者千余家；饥乏，渐相劫略。昭常逊辞以解之，是以寇难消息，众咸宗焉。故其所居部落中，三百里无相侵暴者","attribution":"裴注·高士传","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":577,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a4138397b368dfc7c4ab","start":110,"end":176,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-cecf23ef31c1ff3a67da","section":"chapter-011","block":"b-f52adda04d4dcebae578","layer":"pei","quote":"初，晋宣帝为布衣时，与昭有旧。同郡周生等，谋害帝。昭闻而步陟险，邀生于崤、渑之间；止生，生不肯。昭泣与结诚，生感其义，乃止。昭因与斫枣树，共盟而别","attribution":"裴注·高士传","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":577,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a4138397b368dfc7c4ab","start":11,"end":84,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-fdbe082cd69364159d90","section":"chapter-011","block":"b-8ebb547c19a7076bf761","layer":"pei","quote":"朝廷以戎车未息，征命之事，且须后之；昭以故不即征。后顗、休复与庾嶷荐昭，有诏访于本州评议。侍中韦诞驳曰：‘礼贤征士，王政之所重也。古者考行于乡；今顗等位皆常伯、纳言，嶷为卿佐，足以取信。附下罔上，忠臣之所不行也。昭宿德耆艾，遗逸山林，诚宜嘉异。’乃从诞议也","attribution":"裴注·高士传","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":581,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5296f4b832dc6d5f00f8","start":11,"end":139,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q2-9e17a0168d7fdc3da8e2","section":"chapter-011","block":"b-d66f7a2fd4d1dc48f9fa","layer":"pei","quote":"﹝二﹞《高士传》曰：“幽州刺史杜恕，尝过昭所居草庐之中，言事论理，辞意谦敬，恕甚重焉。太尉蒋济辟，不就。”","attribution":"裴注（引书见原文）","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":578,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5ccd0c638d033b78543d","start":0,"end":53,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
