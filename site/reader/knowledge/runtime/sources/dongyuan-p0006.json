umisun-q-07e94ca7aa814c875ecf","xumisun-q-c9e3ec9e6c1b9166eaa1"],"facts":[{"id":"dongyuan-f0013","label":"字","text":"仲远","evidence":["dongyuan-f0013-q"]},{"id":"dongyuan-f0014","label":"籍贯","text":"武威","evidence":["dongyuan-f0014-q"]}],"aliases":[{"text":"仲远","evidence":["dongyuan-f0013-q"]}],"mentions":[{"id":"dongyuan-m-o010-dongyuan-p0006","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o010"]},{"id":"dongyuan-m-o035-dongyuan-p0006","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o035"]},{"id":"dongyuan-m-p019-dongyuan-p0006","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p019"]}]}],"evidence":[{"id":"dongyuan-e-o010a-q","section":"chapter-006","block":"b-ce439e218b8e8adda84d","layer":"original","quote":"初，卓信任尚书周毖、城门校尉伍琼等。用其所举韩馥、刘岱、孔伷、张（资）〔咨〕、张邈等出宰州郡〖8〗；","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":57,"anchor":null},"note_id":null,"start":0,"end":50},{"id":"dongyuan-e-o010b-q","section":"chapter-006","block":"b-ce439e218b8e8adda84d","layer":"original","quote":"而馥等至官，皆合兵将以讨卓。卓闻之，以为毖、琼等通情卖己，皆斩之。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":57,"anchor":null},"note_id":null,"start":50,"end":83},{"id":"dongyuan-e-o035a-q","section":"chapter-006","block":"b-274eb213f46bac4967b9","layer":"original","quote":"绍既出，遂亡奔冀州。侍中周毖、城门校尉伍琼、议郎何颙等，皆名士也；卓信之。而阴为绍，乃说卓曰：“夫废立大事，非常人所及。绍不达大体，恐惧，故出奔，非有他志也。今购之急〖3〗，势必为变。袁氏树恩四世，门生故吏遍于天下〖4〗；若收豪杰以聚徒众，英雄因之而起，则山东非公之有也。不如赦之，拜一郡守；则绍喜于免罪，必无患矣。”卓以为然，乃拜绍勃海太守，封邟乡侯。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":220,"anchor":null},"note_id":null,"start":0,"end":177},{"id":"dongyuan-f0013-q","section":"chapter-006","block":"b-0b6c7236206397f025fc","layer":"pei","quote":"毖字仲远","attribution":"《英雄记》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":70,"anchor":null},"note_id":"n-02d5fe58c20ace23ce6f","start":11,"end":15},{"id":"dongyuan-f0014-q","section":"chapter-006","block":"b-0b6c7236206397f025fc","layer":"pei","quote":"武威人","attribution":"《英雄记》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":70,"anchor":null},"note_id":"n-02d5fe58c20ace23ce6f","start":16,"end":19},{"id":"dongyuan-q-o010","section":"chapter-006","block":"b-ce439e218b8e8adda84d","layer":"original","quote":"初，卓信任尚书周毖、城门校尉伍琼等。用其所举韩馥、刘岱、孔伷、张（资）〔咨〕、张邈等出宰州郡〖8〗；而馥等至官，皆合兵将以讨卓。卓闻之，以为毖、琼等通情卖己，皆斩之。﹝二﹞","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":57,"anchor":null},"note_id":null,"start":0,"end":86},{"id":"dongyuan-q-o035","section":"chapter-006","block":"b-274eb213f46bac4967b9","layer":"original","quote":"绍既出，遂亡奔冀州。侍中周毖、城门校尉伍琼、议郎何颙等，皆名士也；卓信之。而阴为绍，乃说卓曰：“夫废立大事，非常人所及。绍不达大体，恐惧，故出奔，非有他志也。今购之急〖3〗，势必为变。袁氏树恩四世，门生故吏遍于天下〖4〗；若收豪杰以聚徒众，英雄因之而起，则山东非公之有也。不如赦之，拜一郡守；则绍喜于免罪，必无患矣。”卓以为然，乃拜绍勃海太守，封邟乡侯。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":220,"anchor":null},"note_id":null,"start":0,"end":177},{"id":"dongyuan-q-p019","section":"chapter-006","block":"b-0b6c7236206397f025fc","layer":"pei","quote":"﹝二﹞《英雄记》曰：“毖字仲远，武威人。琼字德瑜，汝南人。”","attribution":"《英雄记》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":70,"anchor":null},"note_id":"n-02d5fe58c20ace23ce6f","start":0,"end":30},{"id":"xumisun-q-07e94ca7aa814c875ecf","section":"chapter-038","block":"b-c3b105ae63105e37b3ab","layer":"original","quote":"董卓秉政，以汉阳周毖为吏部尚书〖8〗，与靖共谋议，进退天下之士〖9〗；沙汰秽浊〖10〗，显拔幽滞","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":2,"anchor":null},"note_id":null,"start":4,"end":52},{"id":"xumisun-q-c9e3ec9e6c1b9166eaa1","section":"chapter-038","block":"b-c3b105ae63105e37b3ab","layer":"original","quote":"卓怒毖曰：“诸君言当拔用善士；卓从君计，不欲违天下人心。而诸君所用人，至官之日，还来相图。卓何用相负〖19〗！”叱毖令出，于外斩之","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":2,"anchor":null},"note_id":null,"start":191,"end":256}],"profiles":{},"directory_counts":{}}
