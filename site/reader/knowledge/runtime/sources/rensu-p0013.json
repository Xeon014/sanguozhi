wangwei-m-92deb9d69a9db480d271","kind":"mention","text":"裴松之对读景元、正元记载，辨嵇康吕安被杀纪年","evidence":["wangwei-q-793285ab9c8bb838429d"]}]}],"evidence":[{"id":"rensu-q-2a8bfc9a002f879bcfcc","section":"chapter-016","block":"b-d958888dfd83fdfad7c0","layer":"pei","quote":"次子安，字仲悌。与嵇康善，与康俱被诛","attribution":"裴注·世语","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":173,"anchor":null},"note_id":"n-716878c8fee9e17bf106","start":40,"end":58},{"id":"rensu-q2-42beee7a826e50b97bfe","section":"chapter-016","block":"b-d958888dfd83fdfad7c0","layer":"pei","quote":"﹝一﹞《世语》曰：“昭字子展，东平人。长子巽，字长悌。为相国掾，有宠于司马文王。次子安，字仲悌。与嵇康善，与康俱被诛。次子粹，字季悌。河南尹。粹子预，字景虞。御史中丞。”","attribution":"裴注·世语","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":173,"anchor":null},"note_id":"n-716878c8fee9e17bf106","start":0,"end":85},{"id":"wangwei-q-5214d243f3d5a5838a1f","section":"chapter-021","block":"b-f8ff70bf10d41f3e849e","layer":"pei","quote":"安引康为证，康义不负心，保明其事","attribution":"裴注·魏氏春秋","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":163,"anchor":null},"note_id":"n-70ad920837cbb5d19ddf","start":291,"end":307},{"id":"wangwei-q-793285ab9c8bb838429d","section":"chapter-021","block":"b-3e0b70931b4785a29df4","layer":"pei","quote":"臣松之按：《本传》云“康以景元中坐事诛”，而干宝、孙盛、习凿齿诸书，皆云：正元二年，司马文王返自乐嘉，杀嵇康、吕安。盖缘《世语》云康欲举兵应毌丘俭，故谓破俭便应杀康也。其实不然。山涛为选官，欲举康自代，康书告绝，事之明审者也。按《涛行状》，涛始以景元二年除吏部郎耳。景元与正元相较七八年，以《涛行状》检之，如《本传》为审。又《钟会传》亦云会作司隶校尉时诛康；会作司隶，景元中也。干宝云：吕安兄巽，善于钟会，巽为相国掾，俱有宠于司马文王，故遂抵安罪。寻文王以景元四年钟、邓平蜀后，始授相国位；若巽为相国掾时陷安，焉得以破毌丘俭年杀嵇、吕？此又干宝之疏谬，自相违伐也。","attribution":"裴松之按","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":168,"anchor":null},"note_id":"n-70ad920837cbb5d19ddf","start":0,"end":282},{"id":"wangwei-q-c93d56f80459b881a0aa","section":"chapter-021","block":"b-f8ff70bf10d41f3e849e","layer":"pei","quote":"钟会劝大将军因此除之，遂杀安及康","attribution":"裴注·魏氏春秋","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":163,"anchor":null},"note_id":"n-70ad920837cbb5d19ddf","start":319,"end":335},{"id":"wgc-q0068","section":"chapter-028","block":"b-d79396012c5280381c75","layer":"original","quote":"迁司隶校尉。虽在外司〖7〗，时政损益，当世与夺〖8〗，无不综典。嵇康等见诛，皆会谋也。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":457,"anchor":null},"note_id":null,"start":0,"end":43},{"id":"wgc-q0444","section":"chapter-028","block":"b-d79396012c5280381c75","layer":"original","quote":"嵇康等见诛，皆会谋也","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":457,"anchor":null},"note_id":null,"start":32,"end":42}],"profiles":{},"directory_counts":{}}
