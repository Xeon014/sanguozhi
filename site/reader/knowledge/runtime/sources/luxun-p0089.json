e":["zongshi-q-803d3a3a8ea5c1982bde"]},"ordering_evidence":"zongshi-q-803d3a3a8ea5c1982bde","source_order":[51,135,164],"related_events":[{"event":"zongshi-e-o126-s2-1","type":"related","evidence":["zongshi-q-83223e6b8c7ffc0dfb7c","zongshi-q-803d3a3a8ea5c1982bde"]},{"event":"zongshi-e2-luji-companions-killed","type":"related","evidence":["zongshi-q2-68bf95195e074706b982","zongshi-q2-3aa9aa78b3086e01b0d4","zongshi-q-803d3a3a8ea5c1982bde"]}],"order":9176},{"id":"zongshi-e-o127","title":"永兴元年，乘舆幸邺；司空东海王越治兵下邳；惠以书干越，诡其姓名自称南岳逸民秦秘之，勉以勤王匡世之略，辞义甚美","accounts":[{"id":"zongshi-a-7185f39ce5eac792afeb","label":"裴注·惠别传","text":"永兴元年，乘舆幸邺；司空东海王越治兵下邳；惠以书干越，诡其姓名自称南岳逸民秦秘之，勉以勤王匡世之略，辞义甚美","evidence":["zongshi-q-48a76cc6c6bdadf18584"]}],"participants":[{"person":"luxun-p0089","role":"诡名上书者","evidence":["zongshi-q-48a76cc6c6bdadf18584"]},{"person":"liusima-p0013","role":"治兵受书者","evidence":["zongshi-q-48a76cc6c6bdadf18584"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["zongshi-q-48a76cc6c6bdadf18584"]},"ordering_evidence":"zongshi-q-48a76cc6c6bdadf18584","source_order":[51,135,265],"order":9178},{"id":"zongshi-e-o128","title":"越省其书，榜题道衢，招求其人；惠乃出见，越即以为记室参军，专掌文疏、豫参谋议；每造书檄，越或驿马催之，应命立成，皆有辞旨","accounts":[{"id":"zongshi-a-4d68f560c7dc89ad3751","label":"裴注·惠别传","text":"越省其书，榜题道衢，招求其人；惠乃出见，越即以为记室参军，专掌文疏、豫参谋议；每造书檄，越或驿马催之，应命立成，皆有辞旨","evidence":["zongshi-q-8a714423074d837119ca"]}],"participants":[{"person":"liusima-p0013","role":"招而署任者","evidence":["zongshi-q-8a714423074d837119ca"]},{"person":"luxun-p0089","role":"出见受任者","evidence":["zongshi-q-8a714423074d837119ca"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["zongshi-q-8a714423074d837119ca"]},"ordering_evidence":"zongshi-q-8a714423074d837119ca","source_order":[51,135,324],"order":9179},{"id":"zongshi-e-o129","title":"惠累迁显职，后为广武将军、安丰内史；年四十七卒","accounts":[{"id":"zongshi-a-d5ddeaa79278ee61fa13","label":"裴注·惠别传","text":"惠累迁显职，后为广武将军、安丰内史；年四十七卒","evidence":["zongshi-q-af55a181b1dfb5fd4da9"]}],"participants":[{"person":"luxun-p0089","role":"历官而卒者","evidence":["zongshi-q-af55a181b1dfb5fd4da9"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["zongshi-q-af55a181b1dfb5fd4da9"]},"ordering_evidence":"zongshi-q-af55a181b1dfb5fd4da9","source_order":[51,135,385],"order":9180}],"persons":[{"id":"luxun-p0089","name":"孙惠","evidence":["luxun-q-p018","zongshi-q-7a1c189d9a9d8ab30e7c","zongshi-q-e028e737538d763fb420","zongshi-q-803d3a3a8ea5c1982bde","zongshi-q-48a76cc6c6bdadf18584","zongshi-q-8a714423074d837119ca","zongshi-q-af55a181b1dfb5fd4da9"],"facts":[],"aliases":[],"mentions":[{"id":"luxun-m-p018-luxun-p0089","kind":"mention","text":"文中提及","evidence":["luxun-q-p018"]}]}],"evidence":[{"id":"luxun-q-p018","section":"chapter-058","block":"b-20b860773c1dd9d264dc","layer":"pei","quote":"﹝二﹞景弟机，字士衡；云，字士龙。《机云别传》曰：“晋太康末，俱入洛，造司空张华。华一见而奇之，曰：‘伐吴之役，利在获二俊。’遂为之延誉，荐之诸公。太傅杨骏辟机为祭酒。转太子洗马，尚书著作郎。云为吴王郎中令。出宰浚仪，甚有惠政，吏民怀之，生为立祠。后并历显位。机天才绮练，文藻之美，独冠于时。云亦善属文，清新不及机，而口辩持论，过之。于时朝廷多故，机、云并自结于成都王颖。颖用机为平原相，云清河内史。寻转云右司马，甚见委仗。无几而与长沙王构隙，遂举兵攻洛。以机行后将军，督王粹、牵秀等诸军二十万；士龙著《南征赋》以美其事。机，吴人，羇旅单宦；顿居群士之右，多不厌服。机屡战失利，死散过半。初，宦人孟玖，颖所嬖幸，乘宠预权。云数言其短，颖不能纳；玖又从而毁之。是役也，玖弟超，亦领众配机，不奉军令。机绳之以法，超宣言曰‘陆机将反’。及牵秀等谮机于颖，以为持两端；玖又构之于内：颖信之。遣收机，并收云及弟耽，并伏法。机兄弟既江南之秀，亦著名诸夏；并以无罪夷灭，天下痛惜之。机文章为世所重，云所著亦传于世。初，抗之克步阐也，诛及婴孩。识道者尤之曰：‘后世必受其殃！’及机之诛，三族无遗。孙惠与朱诞书曰：‘马援择君，凡人所闻。不意三陆，相携暴朝；杀身伤名，可为悼叹！’”事亦并在《晋书》。","attribution":"《机云别传》及裴注","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":454,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-d3a7d3771e82327ad7c0","start":0,"end":540,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-48a76cc6c6bdadf18584","section":"chapter-051","block":"b-838933eb0906948787bc","layer":"pei","quote":"永兴元年，乘舆幸邺。司空东海王越，治兵下邳。惠以书干越，诡其姓名，自称‘南岳逸民秦秘之’：勉以勤王匡世之略，辞义甚美","attribution":"裴注·惠别传","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":134,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1c9591ac978a693556d2","start":265,"end":323,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-7a1c189d9a9d8ab30e7c","section":"chapter-051","block":"b-838933eb0906948787bc","layer":"pei","quote":"晋永宁元年，赴齐王冏义，以功封晋兴侯。辟大司马贼曹属","attribution":"裴注·惠别传","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":134,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1c9591ac978a693556d2","start":84,"end":110,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-803d3a3a8ea5c1982bde","section":"chapter-051","block":"b-838933eb0906948787bc","layer":"pei","quote":"成都王颖，召为大将军参军。是时颖将有事于长沙，以陆机为前锋都督。惠与机，乡里亲厚，忧其致祸。谓之曰：‘子盍让都督于王粹乎？’机曰：‘将谓吾避贼首鼠，更速其害！’机寻被戮；二弟云、耽，亦见杀。惠甚伤恨之","attribution":"裴注·惠别传","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":134,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1c9591ac978a693556d2","start":164,"end":264,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-83223e6b8c7ffc0dfb7c","section":"chapter-051","block":"b-d784627aa3d293accfb1","layer":"pei","quote":"永安中，陆机为成都王大都督，请丞为司马：与机俱被害","attribution":"裴注·文士传","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":233,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-75f5bb207dd97fe936cc","start":120,"end":145,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-8a714423074d837119ca","section":"chapter-051","block":"b-838933eb0906948787bc","layer":"pei","quote":"越省其书，榜题道衢，招求其人。惠乃出见，越即以为记室参军；专掌文疏，豫参谋议。每造书檄，越或驿马催之；应命立成，皆有辞旨","attribution":"裴注·惠别传","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":134,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1c9591ac978a693556d2","start":324,"end":384,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-af55a181b1dfb5fd4da9","section":"chapter-051","block":"b-838933eb0906948787bc","layer":"pei","quote":"累迁显职，后为广武将军，安丰内史。年四十七，卒","attribution":"裴注·惠别传","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":134,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1c9591ac978a693556d2","start":385,"end":408,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-e028e737538d763fb420","section":"chapter-051","block":"b-838933eb0906948787bc","layer":"pei","quote":"冏骄矜僭侈，天下失望；惠献言于冏，讽以五难、四不可；劝令委让万机，归藩青岱。辞甚深切，冏不能纳，顷之果败","attribution":"裴注·惠别传","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":134,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1c9591ac978a693556d2","start":111,"end":163,"offset_unit":"unicode_code_point"},{"id":"zongshi-q2-3aa9aa78b3086e01b0d4","section":"chapter-051","block":"b-d784627aa3d293accfb1","layer":"pei","quote":"与机俱被害。","attribution":"裴注·文士传","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":233,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-75f5bb207dd97fe936cc","start":140,"end":146,"offset_unit":"unicode_code_point"},{"id":"zongshi-q2-68bf95195e074706b982","section":"chapter-051","block":"b-838933eb0906948787bc","layer":"pei","quote":"机寻被戮；二弟云、耽，亦见杀。","attribution":"裴注（引书见原文）","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":134,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1c9591ac978a693556d2","start":244,"end":259,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
