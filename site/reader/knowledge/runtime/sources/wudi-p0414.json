84fc","zhangyan-q-d7503dd43194a49833bd","zhangyan-q-06d738593cb3d8e910a4","zhangyan-q-9afbb18a3047e9e17ead"],"facts":[{"id":"yaoci-f2-922d59a2a1b487820ebc","text":"少游学京师，事颍川刘子奇，治《左氏春秋》；察孝廉，补尚书郎，公事免官；父赐丧阕后，举茂才，除巫令。","evidence":["yaoci-q-63dd9016198d22a70c98"]},{"id":"yaoci-f2-e30ff68887e1809949a1","text":"迁交阯太守。","evidence":["yaoci-q2-29527d0b5d59d60a62ce"]},{"id":"yaoci-f2-521ae8b7ee8fa8a8d94a","text":"孙权加为左将军。","evidence":["yaoci-q2-fb6dc137f2a4d8a833c4"]},{"id":"yaoci-f2-0cd207d6d241e1a9270b","text":"在南的燮、壹诸子皆拜中郎将；燮迁卫将军，封龙编侯；弟壹偏将军、都乡侯。","evidence":["yaoci-q2-4bc7a953a395fdbe059d"]},{"id":"yaoci-f2-c77ec0ac6892e0bbefbe","text":"先人汶阳人，王莽乱时避地交州；父赐，为日南太守。","evidence":["yaoci-q-1dc68dc1c6b46bb5311c"]},{"id":"yaoci-f2-8567ebc8f95dd6c65162","text":"为《春秋左氏传》作注解，士人避难者多往依之。","evidence":["yaoci-q-f3e557c8acdfe781e898"]}],"aliases":[],"mentions":[{"id":"wudi-m-p157-wudi-p0414","kind":"mention","text":"文中提及","evidence":["wudi-q-p157"]},{"id":"yaoci-m2-f76ed2fb5aff6e0f937a","kind":"mention","text":"文中提及","evidence":["yaoci-q-95d2a368c0634921fd6e"]},{"id":"zhangyan-m-00ff47ecb62d12b502ad","kind":"mention","text":"本篇原文记及士燮，具体行动与称谓见引文。","evidence":["zhangyan-q-d7503dd43194a49833bd"]},{"id":"zhangyan-m-d2fe7b92d82e9c3a5b2d","kind":"mention","text":"本篇原文记及士燮，具体行动与称谓见引文。","evidence":["zhangyan-q-06d738593cb3d8e910a4"]},{"id":"zhangyan-m-6e9906a97f8bf3c31147","kind":"mention","text":"本篇原文记及士燮，具体行动与称谓见引文。","evidence":["zhangyan-q-9afbb18a3047e9e17ead"]}]}],"evidence":[{"id":"dongliu-q-879f3ee6532ffdf94f76","section":"chapter-039","block":"b-90b4ce31e6f6553fcc05","layer":"pei","quote":"与交阯大守士爕计议不合，乃由牂牁道去","attribution":"裴注·零陵先贤传","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":59,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5774ec08b3b85b011b8c","start":23,"end":41,"offset_unit":"unicode_code_point"},{"id":"hequan-q-305bac29971d3d1390c3","section":"chapter-060","block":"b-ce53f1af4895502f39c4","layer":"original","quote":"交阯太守士燮卒","section_title":"贺全吕周钟离传第十五","source":{"file":"OEBPS/Text/titlepage_0127.xhtml","index":183,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":7,"offset_unit":"unicode_code_point"},{"id":"huangli-q-11650be20d7994ceabf5","section":"chapter-043","block":"b-073f8aa6e597cbc1398c","layer":"original","quote":"初，（建宁）〔益州〕郡杀太守正昂，缚太守张裔於吴","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":129,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":24,"offset_unit":"unicode_code_point"},{"id":"huangli-q-41212503d95639eed507","section":"chapter-043","block":"b-8de1f97850df61e22fd0","layer":"original","quote":"闿又降於吴，吴遥署闿为永昌太守","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":90,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":86,"end":101,"offset_unit":"unicode_code_point"},{"id":"huowang-q-3b408563cd6173927bbe","section":"chapter-041","block":"b-e549715bb9d87cafdb54","layer":"original","quote":"耆率雍闿恩信著于南土〖12〗，使命周旋〖13〗，远通孙权","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":69,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":12,"end":40,"offset_unit":"unicode_code_point"},{"id":"huowang-q-cbe63f868ee6f440b5c7","section":"chapter-041","block":"b-e549715bb9d87cafdb54","layer":"original","quote":"益州郡杀太守正昂","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":69,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":3,"end":11,"offset_unit":"unicode_code_point"},{"id":"huowang-q-f2aa0de3bebd591eb69b","section":"chapter-041","block":"b-e549715bb9d87cafdb54","layer":"original","quote":"闿遂趦趄不宾〖14〗，假鬼教曰〖15〗：“张府君如瓠壶〖16〗，外虽泽而内实粗〖17〗；不足杀〖18〗，令缚与吴。”于是遂送裔于权","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":69,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":55,"end":120,"offset_unit":"unicode_code_point"},{"id":"wudi-e-p157a-q","section":"chapter-001","block":"b-b02c08a63c1f0172f907","layer":"pei","quote":"初，袁忠为沛相，尝欲以法治太祖。沛国桓邵，亦轻之。及在兖州，陈留边让，言议颇侵太祖。太祖杀让，族其家。忠、邵俱避难交州，太祖遣使就太守士燮，尽族之。桓邵得出首，拜谢于庭中。太祖谓曰：‘跪可解死邪！’遂杀之。","attribution":"《曹瞒传》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":461,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6c928ccff5d542bc3225","start":159,"end":262,"offset_unit":"unicode_code_point"},{"id":"wudi-q-p157","section":"chapter-001","block":"b-b02c08a63c1f0172f907","layer":"pei","quote":"《曹瞒传》曰：“太祖为人佻易，无威重。好音乐，倡优在侧，常以日达夕。被服轻绡，身自佩小鞶囊，以盛手巾细物；时或冠帢帽以见宾客。每与人谈论，戏弄言诵，尽无所隐。及欢悦大笑，至以头没杯案中，肴膳皆沾污巾帻，其轻易如此。然持法峻刻，诸将有计画胜出己者，随以法诛之。及故人旧怨，亦皆无余。其所刑杀，辄对之垂涕嗟痛之，终无所活。初，袁忠为沛相，尝欲以法治太祖。沛国桓邵，亦轻之。及在兖州，陈留边让，言议颇侵太祖。太祖杀让，族其家。忠、邵俱避难交州，太祖遣使就太守士燮，尽族之。桓邵得出首，拜谢于庭中。太祖谓曰：‘跪可解死邪！’遂杀之。尝出军，行经麦中，令士卒：‘无败麦，犯者死！’骑士皆下马，付麦以相持。于是太祖马腾入麦中，敕主簿议罪。主簿对以《春秋》之义，罚不加于尊。太祖曰：‘制法而自犯之，何以帅下？然孤为军帅，不可自杀，请自刑。’因援剑割发以置地。又有幸姬常从昼寝，枕之卧。告之曰：‘须臾觉我。’姬见太祖卧安，未即寤。及自觉，棒杀之。尝讨贼，廪谷不足。私谓主者曰：‘如何？’主者曰：‘可以小斛以足之。’太祖曰：‘善！’后军中言太祖欺众，太祖谓主者曰：‘特当借君死以厌众，不然，事不解。’乃斩之，取首题徇曰：‘行小斛，盗官谷。’斩之军门。其酷虐变诈，皆此类也。”","attribution":"《曹瞒传》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":461,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6c928ccff5d542bc3225","start":0,"end":528,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-e7440c05e33476f976a2","section":"chapter-038","block":"b-7276d270a642d9aa5804","layer":"original","quote":"既至交阯〖3〗，交阯太守士燮厚加敬待","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":34,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":18,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-0dc764dca5b4e9080616","section":"chapter-049","block":"b-2f2b1ec7f53023b4058e","layer":"original","quote":"骘到，燮率兄弟奉承节度","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":214,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":17,"end":28,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-1dc68dc1c6b46bb5311c","section":"chapter-049","block":"b-07badf8f69cf2bedfc68","layer":"original","quote":"士燮字威彦，苍梧广信人也〖1〗。其先本鲁国汶阳人〖2〗，至王莽之乱〖3〗，避地交州。六世至燮父赐，桓帝时为日南太守〖4〗。","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":174,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":61,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-28d4740d5f6e9b420ab6","section":"chapter-049","block":"b-43c68260303aa97203c7","layer":"original","quote":"汉闻张津死，赐燮玺书曰〖1〗：“交州绝域〖2〗，南带江海；上恩不宣，下义壅隔。知逆贼刘表，又遣赖恭，窥看南土。今以燮为绥南中郎将〖3〗，董督七郡〖4〗；领交阯太守如故","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":213,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":83,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-299ae53797c254d54061","section":"chapter-049","block":"b-60231c49dc295dae8cde","layer":"original","quote":"权辄为书，厚加宠赐，以答慰之","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":216,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":80,"end":94,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-42be332dc0fda5d5e98f","section":"chapter-049","block":"b-bf1005b55c03c54ff480","layer":"original","quote":"建安末年，燮遣子入质〖8〗，权以为武昌太守","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":215,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-4e4e1ec91272b2596a24","section":"chapter-049","block":"b-43c68260303aa97203c7","layer":"original","quote":"是时天下丧乱，道路断绝；而燮不废贡职，特复下诏拜安远将军〖5〗，封龙度亭侯","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":213,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":98,"end":135,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-4ffb0440cddc892a4427","section":"chapter-049","block":"b-bf1005b55c03c54ff480","layer":"original","quote":"燮又诱导益州豪姓雍闿等〖9〗，率郡人民使遥东附，权益嘉之","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":215,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":37,"end":65,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-5fa61d1aa48f459a9159","section":"chapter-049","block":"b-60231c49dc295dae8cde","layer":"original","quote":"燮每遣使诣权，致杂香、细葛〖11〗，辄以千数；明珠、大贝、流离、翡翠、玳瑁、犀、象之珍〖12〗；奇物异果，蕉、邪、龙眼之属〖13〗：无岁不至。壹时贡马凡数百匹","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":216,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":79,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-63dd9016198d22a70c98","section":"chapter-049","block":"b-5062c8ac0461f326057d","layer":"original","quote":"燮少游学京师，事颍川刘子奇，治《左氏春秋》〖5〗。察孝廉，补尚书郎〖6〗，公事免官。父赐丧阕后〖7〗，举茂才，除巫令。","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":175,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":59,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-65645e78792244c7c78d","section":"chapter-049","block":"b-4c3e132b7835e845694f","layer":"original","quote":"交州刺史朱符为夷贼所杀，州郡扰乱。燮乃表壹领合浦太守，次弟徐闻令8 领九真太守〖13〗，﹝二﹞8弟武领南海太守","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":176,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":114,"end":169,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-89aa3a8f661a7e54ad01","section":"chapter-049","block":"b-b6ca958f7851d5a29b44","layer":"original","quote":"燮在郡四十余岁，黄武五年，年九十卒","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":217,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":17,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-8f786199bc5bf35842c0","section":"chapter-049","block":"b-43c68260303aa97203c7","layer":"original","quote":"后燮遣吏张旻，奉贡诣京都","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":213,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":85,"end":97,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-95d2a368c0634921fd6e","section":"chapter-049","block":"b-449c4a0935ed3c963f18","layer":"original","quote":"陈国袁徽与尚书令荀彧书曰〖16〗：“交阯士府君，既学问优博，又达于从政；处大乱之中，保全一郡。二十余年疆埸无事〖17〗，民不失业；羇旅之徒，皆蒙其庆：虽窦融保河西，曷以加之","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":178,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":86,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-a7ed53a5ce984bf59163","section":"chapter-049","block":"b-1a49a01f5fc915f7545e","layer":"pei","quote":"燮尝病死，已三日。仙人董奉，以一丸药与服，以水含之，捧其头摇捎之。食顷，即开目动手，颜色渐复；半日能起坐；四日复能语：遂复常","attribution":"裴注·葛洪神仙传","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":212,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-7424d66445429eb514d3","start":13,"end":75,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-b38479d873cc0816d735","section":"chapter-049","block":"b-32a6488e833ebc5f0050","layer":"original","quote":"燮兄弟并为列郡，雄长一州；偏在万里，威尊无上。出入鸣钟、磬〖23〗，备具威仪，笳箫鼓吹，车骑满道。胡人夹毂焚烧香者，常有数十〖24〗。妻妾乘辎〖25〗，子弟从兵骑；当时贵重，震服百蛮","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":179,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":91,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-f3e557c8acdfe781e898","section":"chapter-049","block":"b-3326aae10ccdc8113fce","layer":"original","quote":"燮体器宽厚〖14〗，谦虚下士，中国士人往依避难者以百数〖15〗。耽玩《春秋》，为之注解。","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":177,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":44,"offset_unit":"unicode_code_point"},{"id":"yaoci-q2-29527d0b5d59d60a62ce","section":"chapter-049","block":"b-4c3e132b7835e845694f","layer":"original","quote":"迁交阯太守。弟壹，初为郡督邮〖8〗。刺史丁宫征还京都，壹侍送勤恪〖9〗。宫感之，临别谓曰：“刺史若待罪三事〖10〗，当相辟也。”后宫为司徒，辟壹。比至，宫已免；黄琬代为司徒〖11〗，甚礼遇壹。董卓作乱，壹亡归乡里〖12〗。﹝一﹞交州刺史朱符为夷贼所杀，州郡扰乱。燮乃表壹领合浦太守，次弟徐闻令8 领九真太守〖13〗，﹝二﹞8弟武领南海太守。","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":176,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":170,"offset_unit":"unicode_code_point"},{"id":"yaoci-q2-4bc7a953a395fdbe059d","section":"chapter-049","block":"b-bf1005b55c03c54ff480","layer":"original","quote":"建安末年，燮遣子入质〖8〗，权以为武昌太守。燮、壹诸子在南者，皆拜中郎将。燮又诱导益州豪姓雍闿等〖9〗，率郡人民使遥东附，权益嘉之。迁卫将军，封龙编侯；弟壹偏将军，都乡侯〖10〗。","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":215,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":90,"offset_unit":"unicode_code_point"},{"id":"yaoci-q2-fb6dc137f2a4d8a833c4","section":"chapter-049","block":"b-2f2b1ec7f53023b4058e","layer":"original","quote":"建安十五年，孙权遣步骘为交州刺史。骘到，燮率兄弟奉承节度〖7〗。而吴巨怀异心，骘斩之。权加燮为左将军。","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":214,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":51,"offset_unit":"unicode_code_point"},{"id":"zhanggu-q-632ff69043dc63898d23","section":"chapter-052","block":"b-8dbbc065164c490cb6e9","layer":"original","quote":"士燮兄弟〖7〗，相率供命〖8〗。南土之宾〖9〗，自此始也","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":357,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":66,"end":94,"offset_unit":"unicode_code_point"},{"id":"zhanggu-q-67c2af61b00b696d13a9","section":"chapter-052","block":"b-329ec2ae8393bab5504c","layer":"original","quote":"益州大姓雍闿等，杀蜀所署太守正昂〖10〗；与燮相闻，求欲内附，骘因承制遣使宣恩抚纳〖11〗。由是加拜平戎将军〖12〗，封广信侯","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":358,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":63,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-06d738593cb3d8e910a4","section":"chapter-053","block":"b-2fffc7b23749864d70a6","layer":"original","quote":"薛综字敬文，沛郡竹邑人也〖1〗。﹝一﹞少依族人避地交州，从刘熙学。士燮既附孙权，召综为五官中郎〔将〕。除合浦、交阯太守。时交土始开，刺史吕岱率师讨伐，综与俱行。越海南征，及到九真。事毕还都，守谒者仆射〖2〗。","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":151,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":104,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-9afbb18a3047e9e17ead","section":"chapter-053","block":"b-a48f4ed57afb51356ec6","layer":"original","quote":"然在九甸之外〖27〗，长吏之选，类不精核〖28〗。汉时法宽，多自放恣，故数反，违法。珠崖之废〖29〗，起于长吏睹其好发，髡取为髲〖30〗。及臣所见，南海黄盖为日南太守〖31〗；下车以供设不丰〖32〗，挝杀主簿〖33〗：仍见驱逐〖34〗。九真太守儋萌，为妻父周京作主人〖35〗，并请大吏；酒酣作乐，功曹番歆，起舞属京〖36〗，京不肯起；歆犹迫强，萌忿，杖歆，亡于郡内〖37〗。歆弟苗，帅众攻府；毒矢射萌，萌至物故〖38〗。交阯太守士燮，遣兵致讨，卒不能克。又故刺史会稽朱符，多以乡人虞褒、刘彦之徒，分作长吏；侵虐百姓，强赋于民〖39〗。黄鱼一枚，收稻一斛；百姓怨叛，山贼并出，攻州突郡。符走入海，流离丧亡。次得南阳张津，与荆州牧刘表为隙〖40〗；兵弱敌强，岁岁兴军。诸将厌患，去留自在；津小检摄〖41〗，威武不足；为所陵侮，遂至杀没。后得零陵赖恭〖42〗，先辈仁谨〖43〗，不晓时事。表又遣长沙吴巨，为苍梧太守。巨，武夫轻悍，不为恭服；（所取）〔辄〕相怨恨，逐出恭，求步骘。是时津故将夷廖、钱博之徒尚多，骘以次锄治；纲纪适定〖44〗，会仍召出。吕岱既至，有士氏之变〖45〗。越军南征，平讨之日，改置长吏，彰明王纲〖46〗；威加万里，大小承风。由此言之，绥边抚裔〖47〗，实有其人。","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":169,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":539,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-adcc97cbcc63dd7484fc","section":"chapter-053","block":"b-3cb1d4864b2f127e69a3","layer":"original","quote":"士燮命为长史","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":100,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":47,"end":53,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-d7503dd43194a49833bd","section":"chapter-053","block":"b-3cb1d4864b2f127e69a3","layer":"original","quote":"程秉字德枢，汝南南顿人也〖1〗。逮事郑玄〖2〗。后避乱交州，与刘熙考论大义〖3〗：遂博通五经。士燮命为长史。","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":100,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":54,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
