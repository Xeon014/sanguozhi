{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xiahoucao-e-o101a","title":"司马师召李丰即杀收夏侯玄张缉等钟毓奏论法","accounts":[{"id":"xiahoucao-e-o101a-account","label":"《诸夏侯曹传第九》正文","text":"司马师召李丰即杀收夏侯玄张缉等钟毓奏论法","evidence":["xiahoucao-e-o101a-q"]},{"id":"xiahoucao-e-p055a-account","label":"《世语》","text":"王羡向司马师请召李丰并设拒召预案乃迎丰","evidence":["xiahoucao-e-p055a-q"]},{"id":"xiahoucao-e-p055b-account","label":"《魏氏春秋》","text":"《魏氏春秋》称司马师责李丰，李丰斥其父子怀奸，司马师怒令勇士以刀环筑腰杀之。","evidence":["xiahoucao-e-p055b-q"]},{"id":"xiahoucao-e-p056i-account","label":"《魏略》","text":"《魏略》称景王知李丰议己，召丰，丰不实告而被杀，事秘。","evidence":["xiahoucao-e-p056i-q"]}],"participants":[{"person":"shaodi-p0038","role":"杀人治狱","evidence":["xiahoucao-e-o101a-q"]},{"person":"shaodi-p0062","role":"被杀","evidence":["xiahoucao-e-o101a-q"]},{"person":"shaodi-p0064","role":"被收","evidence":["xiahoucao-e-o101a-q"]},{"person":"shaodi-p0063","role":"被收","evidence":["xiahoucao-e-o101a-q"]},{"person":"xiahoucao-p0104","role":"被收","evidence":["xiahoucao-e-o101a-q"]},{"person":"xiahoucao-p0105","role":"被收","evidence":["xiahoucao-e-o101a-q"]},{"person":"xiahoucao-p0106","role":"被收","evidence":["xiahoucao-e-o101a-q"]},{"person":"shaodi-p0093","role":"奏法","evidence":["xiahoucao-e-o101a-q"]},{"person":"xiahoucao-p0112","role":"请召迎人","evidence":["xiahoucao-e-p055a-q"]}],"place":null,"time":{"year":254,"label":"嘉平六年二月","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xiahoucao-y254","dating_review":{"reviewed":true,"anchor":"xiahoucao-q-o100","basis":"嘉平六年二月"},"evidence":["xiahoucao-e-o101a-q","xiahoucao-q-o100","shaodi-q-o059","shaodi-q-b-91c7db3288e80e5b9e4b"]},"ordering_evidence":"xiahoucao-e-o101a-q","source_order":[9,584,"O101a"],"order":2341},{"id":"mantian-e-p152b","title":"王羡启推劾满掾断门","accounts":[{"id":"mantian-a-5728217fd219116c47e4","label":"裴注·《世语》","text":"王羡启推劾满掾断门","evidence":["mantian-q-1cd3befcb1c0fd05b6c1"]}],"participants":[{"person":"shaodi-p0045","role":"问幹入何迟","evidence":["mantian-q-1cd3befcb1c0fd05b6c1"]},{"person":"mantian-p0006","role":"言其故","evidence":["mantian-q-1cd3befcb1c0fd05b6c1"]},{"person":"xiahoucao-p0112","role":"不得入恨之、因左右启宜推劾","evidence":["mantian-q-1cd3befcb1c0fd05b6c1"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["mantian-q-1cd3befcb1c0fd05b6c1"]},"ordering_evidence":"mantian-q-1cd3befcb1c0fd05b6c1","source_order":[26,116,102],"order":5170},{"id":"mantian-e-p153","title":"长武考死杖下伟免为庶人","accounts":[{"id":"mantian-a-4435682432934713755a","label":"裴注·《世语》","text":"司马昭因断门之恨，寿春之役后收满长武考死杖下，满伟免为庶人，时人冤之","evidence":["mantian-q-46e70f5dd434c71302e2"]}],"participants":[{"person":"shaodi-p0045","role":"寿春之役伟从至许、内见恨、收长武","evidence":["mantian-q-46e70f5dd434c71302e2"]},{"person":"mantian-p0022","role":"求还省疾事定乃从归、被收考死杖下","evidence":["mantian-q-46e70f5dd434c71302e2"]},{"person":"mantian-p0020","role":"以疾不进、免为庶人","evidence":["mantian-q-46e70f5dd434c71302e2"]},{"person":"xiahoucao-p0112","role":"因王左右启王满掾断门不纳人宜推劾","evidence":["mantian-q-46e70f5dd434c71302e2"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["mantian-q-46e70f5dd434c71302e2"]},"ordering_evidence":"mantian-q-46e70f5dd434c71302e2","source_order":[26,116,118],"order":5171}],"persons":[{"id":"xiahoucao-p0112","name":"王羡","evidence":["xiahoucao-q-p055","mantian-q-1cd3befcb1c0fd05b6c1","mantian-q-46e70f5dd434c71302e2"],"facts":[],"aliases":[],"mentions":[{"id":"xiahoucao-m-p055-xiahoucao-p0112","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-p055"]}]}],"evidence":[{"id":"mantian-q-1cd3befcb1c0fd05b6c1","section":"chapter-026","block":"b-219b3a1015cdaaa81810","layer":"pei","quote":"文王问幹：‘入何迟？’幹言其故。参军王羡亦不得入，恨之。既而羡因王左右启王：‘满掾断门，不纳人，宜推劾。’","attribution":"裴注·《世语》","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":115,"anchor":null},"note_id":"n-4cb32f48fe00ab0d6310","start":102,"end":155},{"id":"mantian-q-46e70f5dd434c71302e2","section":"chapter-026","block":"b-219b3a1015cdaaa81810","layer":"pei","quote":"寿春之役，伟从文王至许，以疾不进。子从，求还省疾，事定乃从归。由此，内见恨。收长武考死杖下，伟免为庶人。时人冤之","attribution":"正文","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":115,"anchor":null},"note_id":"n-4cb32f48fe00ab0d6310","start":155,"end":211},{"id":"shaodi-q-b-91c7db3288e80e5b9e4b","section":"chapter-004","block":"b-91c7db3288e80e5b9e4b","layer":"modern","quote":"〖1〗六年：嘉平六年（公元 254）。己丑：旧历初一日。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":275,"anchor":null},"note_id":"n-386affd091adab4ef2df","start":0,"end":28},{"id":"shaodi-q-o059","section":"chapter-004","block":"b-83849af55ebd17291970","layer":"original","quote":"六年春二月，己丑〖1〗，镇东将军毌丘俭上言：“昔诸葛恪围合肥新城，城中遣士刘整出围〖2〗，传消息，为贼所得。考问所传，语整曰：‘诸葛公欲活汝，汝可具服〖3〗。’整骂曰：‘死狗，此何言也！我当必死为魏国鬼！不苟求活逐汝去也。欲杀我者，便速杀之！’终无他辞。又遣士郑像出城传消息。或以语恪，恪遣马骑寻围迹索，得像还。四五人的头面缚〖4〗，将绕城表。敕语像〖5〗，使大呼，言：‘大军已还洛，不如早降！’像不从其言，更大呼城中曰：‘大军近在围外，壮士努力！’贼以刀筑其口，使不得言。像遂大呼，令城中闻知。整、像为兵，能守义执节，子弟宜有差异〖6〗。”","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":266,"anchor":null},"note_id":null,"start":0,"end":271},{"id":"xiahoucao-e-o101a-q","section":"chapter-009","block":"b-820cad0cf3fc52c5c84b","layer":"original","quote":"大将军微闻其谋〖10〗，请丰相见；丰不知而往，即杀之。﹝三﹞事下有司，收玄、缉、铄、敦、贤等送廷尉。﹝四﹞廷尉钟毓奏：“丰等谋迫胁至尊，擅诛冢宰〖11〗，大逆无道。请论如法〖12〗。”","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":583,"anchor":null},"note_id":null,"start":0,"end":92},{"id":"xiahoucao-e-p055a-q","section":"chapter-009","block":"b-162374bb52fb1597ca0e","layer":"pei","quote":"大将军闻丰谋，舍人王（羕）〔羡〕请以命请丰：‘丰若无备，情屈势迫，必来；若不来，（羕）〔羡〕一人足以制之。若知谋泄，以众挟轮，长戟自卫，径入云龙门；挟天子登凌云台，台上有三千人仗，鸣鼓会众。如此，（羕）〔羡〕所不及也。’大将军乃遣（羕）〔羡〕以车迎之。丰见劫迫，随（羕）〔羡〕而至。","attribution":"《世语》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":614,"anchor":null},"note_id":"n-bf13de5cd1b966f56f0e","start":10,"end":151},{"id":"xiahoucao-e-p055b-q","section":"chapter-009","block":"b-162374bb52fb1597ca0e","layer":"pei","quote":"大将军责丰；丰知祸及，遂正色曰：‘卿父子怀奸，将倾社稷。惜吾力劣，不能相擒灭耳！’大将军怒，使勇士以刀环筑丰腰，杀之。","attribution":"《魏氏春秋》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":614,"anchor":null},"note_id":"n-bf13de5cd1b966f56f0e","start":161,"end":220},{"id":"xiahoucao-e-p056i-q","section":"chapter-009","block":"b-876aff4f7f73869ce262","layer":"pei","quote":"景王知其议己，请丰；丰不以实告，乃杀之。其事秘。","attribution":"《魏略》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":615,"anchor":null},"note_id":"n-bf13de5cd1b966f56f0e","start":568,"end":592},{"id":"xiahoucao-q-o100","section":"chapter-009","block":"b-23e2c5b4fe1020c88bf5","layer":"original","quote":"嘉平六年二月，当拜贵人〖5〗。丰等欲因御临轩〖6〗，诸门有陛兵〖7〗，诛大将军；以玄代之，以缉为骠骑将军。丰密语黄门监苏铄、永宁署令乐敦、冗从仆射刘贤等曰〖8〗：“卿诸人居内，多有不法；大将军严毅，累以为言。张当可以为诫〖9〗！”铄等皆许以从命。﹝二﹞","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":582,"anchor":null},"note_id":null,"start":0,"end":126},{"id":"xiahoucao-q-p055","section":"chapter-009","block":"b-162374bb52fb1597ca0e","layer":"pei","quote":"﹝三﹞《世语》曰：“大将军闻丰谋，舍人王（羕）〔羡〕请以命请丰：‘丰若无备，情屈势迫，必来；若不来，（羕）〔羡〕一人足以制之。若知谋泄，以众挟轮，长戟自卫，径入云龙门；挟天子登凌云台，台上有三千人仗，鸣鼓会众。如此，（羕）〔羡〕所不及也。’大将军乃遣（羕）〔羡〕以车迎之。丰见劫迫，随（羕）〔羡〕而至。”《魏氏春秋》曰：“大将军责丰；丰知祸及，遂正色曰：‘卿父子怀奸，将倾社稷。惜吾力劣，不能相擒灭耳！’大将军怒，使勇士以刀环筑丰腰，杀之。”","attribution":"《世语》；《魏氏春秋》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":614,"anchor":null},"note_id":"n-bf13de5cd1b966f56f0e","start":0,"end":221}],"profiles":{},"directory_counts":{}}
