{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o002a","title":"桥玄与何颙赏识曹操","accounts":[{"id":"wudi-e-o002a-account","label":"正文","text":"曹操少年时多不被世人看重，桥玄、何颙却认为他不凡；桥玄认为他有济乱之才。","evidence":["wudi-e-o002a-q"]}],"participants":[{"person":"cao-cao","role":"受赏识","evidence":["wudi-e-o002a-q"]},{"person":"wudi-p0028","role":"评价","evidence":["wudi-e-o002a-q"]},{"person":"wudi-p0029","role":"赏识","evidence":["wudi-e-o002a-q"]}],"place":null,"time":{"label":"曹操少年时","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-o002a-q"]},"source_order":[1,18,"O002a"],"order":11},{"id":"dongyuan-e-o035a","title":"袁绍出奔周毖伍琼何颙劝董卓赦之拜勃海太守","accounts":[{"id":"dongyuan-e-o035a-account","label":"《董二袁刘传第六》正文","text":"袁绍出奔周毖伍琼何颙劝董卓赦之拜勃海太守","evidence":["dongyuan-e-o035a-q"]}],"participants":[{"person":"wudi-p0052","role":"出奔受任","evidence":["dongyuan-e-o035a-q"]},{"person":"dongyuan-p0006","role":"劝赦","evidence":["dongyuan-e-o035a-q"]},{"person":"xunyu-p0076","role":"劝赦","evidence":["dongyuan-e-o035a-q"]},{"person":"wudi-p0029","role":"劝赦","evidence":["dongyuan-e-o035a-q"]},{"person":"wudi-p0053","role":"赦任","evidence":["dongyuan-e-o035a-q"]}],"place":null,"time":{"label":"袁绍奔冀州后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-o035a-q"]},"ordering_evidence":"dongyuan-e-o035a-q","source_order":[6,221,"O035a"],"order":1626},{"id":"xunyu-e-o002a","title":"何颙称荀彧王佐才","accounts":[{"id":"xunyu-e-o002a-account","label":"《荀彧荀攸贾诩传第十》正文","text":"何颙称荀彧王佐才","evidence":["xunyu-e-o002a-q"]}],"participants":[{"person":"wudi-p0029","role":"评论","evidence":["xunyu-e-o002a-q"]},{"person":"wudi-p0100","role":"被论","evidence":["xunyu-e-o002a-q"]}],"place":null,"time":{"label":"少时至永汉元年","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xunyu-e-o002a-q"]},"ordering_evidence":"xunyu-e-o002a-q","source_order":[10,3,"O002a"],"order":2385},{"id":"xunyu-e-o035b","title":"荀攸郑泰何颙种辑伍琼谋刺董卓事泄何颙自杀荀攸后免","accounts":[{"id":"xunyu-e-o035b-account","label":"《荀彧荀攸贾诩传第十》正文","text":"荀攸郑泰何颙种辑伍琼谋刺董卓事泄何颙自杀荀攸后免","evidence":["xunyu-e-o035b-q"]},{"id":"xunyu-a-p037-judgment","label":"《魏书》","text":"《魏书》称荀攸遣人说董卓而免，与正文董卓死后得免不同。","evidence":["xunyu-q-p037-judgment"]},{"id":"rensu-a-09e58f4af1ae89c2efe3","label":"正文","text":"郑泰与荀攸等谋诛董卓","evidence":["rensu-q-c21e8c32e233b8003b27"]}],"participants":[{"person":"wudi-p0143","role":"谋刺入狱获免","evidence":["xunyu-e-o035b-q"]},{"person":"wudi-p0067","role":"谋刺","evidence":["xunyu-e-o035b-q"]},{"person":"wudi-p0029","role":"谋刺而死","evidence":["xunyu-e-o035b-q"]},{"person":"xianzhu-p0024","role":"谋刺","evidence":["xunyu-e-o035b-q"]},{"person":"xunyu-p0076","role":"谋刺","evidence":["xunyu-e-o035b-q"]},{"person":"wudi-p0053","role":"谋诛对象","evidence":["rensu-q-c21e8c32e233b8003b27"]}],"place":null,"time":{"label":"何进征名士至董卓死","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xunyu-e-o035b-q"]},"ordering_evidence":"xunyu-e-o035b-q","source_order":[10,193,"O035b"],"order":2474},{"id":"xunyu-e-p036a","title":"何颙游学洛阳结交陈蕃李膺党难变名隐汝南","accounts":[{"id":"xunyu-e-p036a-account","label":"张璠《汉纪》","text":"何颙游学洛阳结交陈蕃李膺党难变名隐汝南","evidence":["xunyu-e-p036a-q"]}],"participants":[{"person":"wudi-p0029","role":"游学避难","evidence":["xunyu-e-p036a-q"]},{"person":"wudi-p0036","role":"交游","evidence":["xunyu-e-p036a-q"]},{"person":"zhouyu-p0011","role":"交游","evidence":["xunyu-e-p036a-q"]}],"place":null,"time":{"label":"何颙生平","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xunyu-e-p036a-q"]},"ordering_evidence":"xunyu-e-p036a-q","source_order":[10,206,"P036a"],"order":2478},{"id":"xunyu-e-p036b","title":"何颙袁绍交游救党人袁术疾之","accounts":[{"id":"xunyu-e-p036b-account","label":"张璠《汉纪》","text":"何颙袁绍交游救党人袁术疾之","evidence":["xunyu-e-p036b-q"]}],"participants":[{"person":"wudi-p0029","role":"救助","evidence":["xunyu-e-p036b-q"]},{"person":"wudi-p0052","role":"交游","evidence":["xunyu-e-p036b-q"]},{"person":"wudi-p0057","role":"怨恨","evidence":["xunyu-e-p036b-q"]}],"place":null,"time":{"label":"何颙生平","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xunyu-e-p036b-q"]},"ordering_evidence":"xunyu-e-p036b-q","source_order":[10,206,"P036b"],"order":2479},{"id":"xunyu-e-p036e","title":"何颙辟司空府迁北军中候董卓任长史","accounts":[{"id":"xunyu-e-p036e-account","label":"《汉末名士录》","text":"何颙辟司空府迁北军中候董卓任长史","evidence":["xunyu-e-p036e-q"]}],"participants":[{"person":"wudi-p0029","role":"任官","evidence":["xunyu-e-p036e-q"]},{"person":"wudi-p0053","role":"任用","evidence":["xunyu-e-p036e-q"]}],"place":null,"time":{"label":"何颙生平","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xunyu-e-p036e-q"]},"ordering_evidence":"xunyu-e-p036e-q","source_order":[10,206,"P036e"],"order":2482}],"persons":[{"id":"wudi-p0029","name":"何颙","evidence":["wudi-q-o002","xunyu-q-o002","dongyuan-q-o035"],"facts":[{"id":"wudi-f-b-12282ebe58931d60df68-wudi-p0029-c55038","label":"字","text":"伯求","evidence":["wudi-q-b-12282ebe58931d60df68"]},{"id":"xunyu-f0022","label":"字","text":"伯求","evidence":["xunyu-f0022-q"]}],"aliases":[{"text":"伯求","evidence":["wudi-q-b-12282ebe58931d60df68"]},{"text":"伯求","evidence":["xunyu-f0022-q"]}],"mentions":[{"id":"wudi-m-o002-wudi-p0029","kind":"mention","text":"文中提及","evidence":["wudi-q-o002"]},{"id":"xunyu-m-o002-wudi-p0029","kind":"mention","text":"文中提及","evidence":["xunyu-q-o002"]},{"id":"xunyu-m-o035-wudi-p0029","kind":"mention","text":"文中提及","evidence":["xunyu-q-o035"]},{"id":"xunyu-m-p036-wudi-p0029","kind":"mention","text":"文中提及","evidence":["xunyu-q-p036"]},{"id":"dongyuan-m-o035-wudi-p0029","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o035"]},{"id":"dongyuan-m-p056-wudi-p0029","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p056"]}]}],"evidence":[{"id":"dongyuan-e-o035a-q","section":"chapter-006","block":"b-274eb213f46bac4967b9","layer":"original","quote":"绍既出，遂亡奔冀州。侍中周毖、城门校尉伍琼、议郎何颙等，皆名士也；卓信之。而阴为绍，乃说卓曰：“夫废立大事，非常人所及。绍不达大体，恐惧，故出奔，非有他志也。今购之急〖3〗，势必为变。袁氏树恩四世，门生故吏遍于天下〖4〗；若收豪杰以聚徒众，英雄因之而起，则山东非公之有也。不如赦之，拜一郡守；则绍喜于免罪，必无患矣。”卓以为然，乃拜绍勃海太守，封邟乡侯。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":220,"anchor":null},"note_id":null,"start":0,"end":177},{"id":"dongyuan-q-o035","section":"chapter-006","block":"b-274eb213f46bac4967b9","layer":"original","quote":"绍既出，遂亡奔冀州。侍中周毖、城门校尉伍琼、议郎何颙等，皆名士也；卓信之。而阴为绍，乃说卓曰：“夫废立大事，非常人所及。绍不达大体，恐惧，故出奔，非有他志也。今购之急〖3〗，势必为变。袁氏树恩四世，门生故吏遍于天下〖4〗；若收豪杰以聚徒众，英雄因之而起，则山东非公之有也。不如赦之，拜一郡守；则绍喜于免罪，必无患矣。”卓以为然，乃拜绍勃海太守，封邟乡侯。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":220,"anchor":null},"note_id":null,"start":0,"end":177},{"id":"dongyuan-q-p056","section":"chapter-006","block":"b-820911e33630e6596e34","layer":"pei","quote":"﹝二﹞《英雄记》曰：“绍生而父死，二公爱之。幼使为郎，弱冠除濮阳长，有清名。遭母丧；服竟，又追行父服：凡在冢庐六年。礼毕，隐居洛阳，不妄通宾客；非海内知名，不得相见。又好游侠，与张孟卓、何伯求、吴子卿、许子远、伍德瑜等，皆为奔走之友。不应辟命。中常侍赵忠谓诸黄门曰：‘袁本初坐作声价，不应呼召而养死士；不知此儿欲何所为乎！’绍叔父隗闻之，责数绍曰：‘汝且破我家！’绍于是乃起，应大将军之命。”","attribution":"《英雄记》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":215,"anchor":null},"note_id":"n-bf0d3b8b250635b85059","start":0,"end":196},{"id":"rensu-q-c21e8c32e233b8003b27","section":"chapter-016","block":"b-0ec29c53f32db50fc2e0","layer":"original","quote":"浑兄泰，与荀攸等谋诛董卓","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":315,"anchor":null},"note_id":null,"start":44,"end":56},{"id":"wudi-e-o002a-q","section":"chapter-001","block":"b-be6ee1955b4d2400e13d","layer":"original","quote":"嵩生太祖。太祖少机警，有权数〖1〗。而任侠放荡〖2〗，不治行业〖3〗，故世人未之奇也〖4〗。﹝一﹞惟梁国桥玄、南阳何颙异焉〖5〗。玄谓太祖曰：“天下将乱，非命世之才不能济也〖6〗。能安之者，其在君乎！”﹝二﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":17,"anchor":null},"note_id":null,"start":0,"end":104},{"id":"wudi-q-b-12282ebe58931d60df68","section":"chapter-001","block":"b-12282ebe58931d60df68","layer":"modern","quote":"〖5〗桥玄（公元109—183）：字公祖，梁国睢阳（今河南商丘市）人。东汉灵帝时历任三公。传见《后汉书》卷五十一。何颙（yóng）：字伯求，南阳郡襄乡（今湖北枣阳市东北）人。东汉党锢名士集团的重要人物。曾密谋杀董卓，未成功。传见《后汉书》卷六十七。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":24,"anchor":null},"note_id":"n-f59c792c9b82141f40c1","start":0,"end":124},{"id":"wudi-q-o002","section":"chapter-001","block":"b-be6ee1955b4d2400e13d","layer":"original","quote":"嵩生太祖。太祖少机警，有权数〖1〗。而任侠放荡〖2〗，不治行业〖3〗，故世人未之奇也〖4〗。﹝一﹞惟梁国桥玄、南阳何颙异焉〖5〗。玄谓太祖曰：“天下将乱，非命世之才不能济也〖6〗。能安之者，其在君乎！”﹝二﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":17,"anchor":null},"note_id":null,"start":0,"end":104},{"id":"xunyu-e-o002a-q","section":"chapter-010","block":"b-4c7f697215c0f48dbec8","layer":"original","quote":"彧年少时，南阳何颙异之，曰：“王佐才也！”","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":2,"anchor":null},"note_id":null,"start":0,"end":21},{"id":"xunyu-e-o035b-q","section":"chapter-010","block":"b-a71a6145f32bc39dc4a6","layer":"original","quote":"董卓之乱，关东兵起，卓徙都长安。攸与议郎郑泰、何颙，侍中种辑，越骑校尉伍琼等谋曰〖3〗：“董卓无道，甚于桀、纣，天下皆怨之；虽资强兵〖4〗，实一匹夫耳！今直刺杀之，以谢百姓；然后据殽、函〖5〗，辅王命，以号令天下。此桓、文之举也。”事垂就而觉，收颙、攸系狱；颙忧惧自杀，﹝三﹞攸言语饮食自若。会卓死，得免。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":192,"anchor":null},"note_id":null,"start":27,"end":180},{"id":"xunyu-e-p036a-q","section":"chapter-010","block":"b-31f1502dacdc020e14c0","layer":"pei","quote":"颙，字伯求。少与郭泰、贾彪等游学洛阳，泰等与同风好。颙显名太学，于是中朝名臣太傅陈蕃、司隶李膺等，皆深接之。及党事起，颙亦名在其中；乃变名姓亡匿汝南间，所至皆交结其豪杰。","attribution":"张璠《汉纪》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":205,"anchor":null},"note_id":"n-7f630716ca49b94707fb","start":12,"end":97},{"id":"xunyu-e-p036b-q","section":"chapter-010","block":"b-31f1502dacdc020e14c0","layer":"pei","quote":"颙既奇太祖而知荀彧；袁绍慕之，与为奔走之友。是时，天下士大夫多遇党难。颙常岁再三私入洛阳，从绍计议，为诸穷窘之士解释患祸。而袁术亦豪侠，与绍争名。颙未常造术，术深恨之。","attribution":"张璠《汉纪》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":205,"anchor":null},"note_id":"n-7f630716ca49b94707fb","start":97,"end":181},{"id":"xunyu-e-p036e-q","section":"chapter-010","block":"b-31f1502dacdc020e14c0","layer":"pei","quote":"后党禁除解，辟司空府。每三府掾属会议，颙策谋有余，议者皆自以为不及。迁北军中候。董卓以为长史。","attribution":"《汉末名士录》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":205,"anchor":null},"note_id":"n-7f630716ca49b94707fb","start":467,"end":514},{"id":"xunyu-f0022-q","section":"chapter-010","block":"b-31f1502dacdc020e14c0","layer":"pei","quote":"颙，字伯求","attribution":"张璠《汉纪》《汉末名士录》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":205,"anchor":null},"note_id":"n-7f630716ca49b94707fb","start":12,"end":17},{"id":"xunyu-q-o002","section":"chapter-010","block":"b-4c7f697215c0f48dbec8","layer":"original","quote":"彧年少时，南阳何颙异之，曰：“王佐才也！”〖4〗﹝二﹞永汉元年，举孝廉。拜守宫令〖5〗。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":2,"anchor":null},"note_id":null,"start":0,"end":44},{"id":"xunyu-q-o035","section":"chapter-010","block":"b-a71a6145f32bc39dc4a6","layer":"original","quote":"何进秉政，征海内名士攸等，二十余人；攸到，拜黄门侍郎。董卓之乱，关东兵起，卓徙都长安。攸与议郎郑泰、何颙，侍中种辑，越骑校尉伍琼等谋曰〖3〗：“董卓无道，甚于桀、纣，天下皆怨之；虽资强兵〖4〗，实一匹夫耳！今直刺杀之，以谢百姓；然后据殽、函〖5〗，辅王命，以号令天下。此桓、文之举也。”事垂就而觉，收颙、攸系狱；颙忧惧自杀，﹝三﹞攸言语饮食自若。会卓死，得免。﹝四﹞","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":192,"anchor":null},"note_id":null,"start":0,"end":183},{"id":"xunyu-q-p036","section":"chapter-010","block":"b-31f1502dacdc020e14c0","layer":"pei","quote":"﹝三﹞张璠《汉纪》曰：“颙，字伯求。少与郭泰、贾彪等游学洛阳，泰等与同风好。颙显名太学，于是中朝名臣太傅陈蕃、司隶李膺等，皆深接之。及党事起，颙亦名在其中；乃变名姓亡匿汝南间，所至皆交结其豪杰。颙既奇太祖而知荀彧；袁绍慕之，与为奔走之友。是时，天下士大夫多遇党难。颙常岁再三私入洛阳，从绍计议，为诸穷窘之士解释患祸。而袁术亦豪侠，与绍争名。颙未常造术，术深恨之。”《汉末名士录》曰：“术常于众坐数颙三罪，曰：‘王德弥，先觉俊老，名德高亮，而伯求疏之。是一罪也。许子远，凶淫之人，性行不纯，而伯求亲之。是二罪也。郭、贾寒窭，无他资业，而伯求肥马轻裘，光耀道路。是三罪也。’陶丘洪曰：‘王德弥，大贤而短于济时；许子远，虽不纯而赴难不惮濡足。伯求举善则以德弥为首，济难则以子远为宗。且伯求尝为虞伟高手刃复仇，义名奋发。其怨家积财巨万，文马百驷；而欲使伯求羸牛疲马，顿伏道路。此为披其胸而假仇敌之刃也。’术意犹不平。后与南阳宗承，会于阙下，术发怒曰：‘何伯求，凶德也。吾当杀之！’承曰：‘何生，英俊之士。足下善遇之，使延令名于天下。’术乃止。后党禁除解，辟司空府。每三府掾属会议，颙策谋有余，议者皆自以为不及。迁北军中候。董卓以为长史。后荀彧为尚书令，遣人迎叔父司空爽丧；使并置颙尸，而葬之于爽冢傍。”","attribution":"张璠《汉纪》《汉末名士录》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":205,"anchor":null},"note_id":"n-7f630716ca49b94707fb","start":0,"end":547},{"id":"xunyu-q-p037-judgment","section":"chapter-010","block":"b-51e04de8f5d89ce7b7e7","layer":"pei","quote":"﹝四﹞《魏书》云“攸使人说卓，得免”，与此不同。","attribution":"《魏书》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":206,"anchor":null},"note_id":"n-d0ad75dc84a584928116","start":0,"end":24}],"profiles":{},"directory_counts":{}}
