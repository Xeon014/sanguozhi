{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o169a","title":"伏皇后因旧书信被废死","accounts":[{"id":"wudi-e-o169a-account","label":"正文","text":"伏皇后昔与父伏完的书信事发，因言天子怨曹操而被废死，其兄弟皆伏法。","evidence":["wudi-e-o169a-q"]}],"participants":[{"person":"wudi-p0331","role":"被废死","evidence":["wudi-e-o169a-q"]},{"person":"wudi-p0332","role":"旧书信收受者","evidence":["wudi-e-o169a-q"]}],"place":null,"time":{"label":"建安十九年十一月","year":214,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o169a-q","wudi-q-o161","wudi-q-b-c4192d9fada3bef44302"],"chronology":"wudi-y214","dating_review":{"anchor":"wudi-q-o161","basis":"建安十九年十一月","reviewed":true}},"source_order":[1,964,"O169a"],"order":360},{"id":"wudi-e-p119a","title":"华歆入宫捕伏后","accounts":[{"id":"wudi-e-p119a-account","label":"《曹瞒传》","text":"《曹瞒传》记曹操遣华歆入宫，破壁捕伏后；伏后向献帝求救未果，随后被杀，兄弟宗族死数百人。","evidence":["wudi-e-p119a-q"]}],"participants":[{"person":"cao-cao","role":"遣使","evidence":["wudi-e-p119a-q"]},{"person":"wudi-p0340","role":"捕后","evidence":["wudi-e-p119a-q"]},{"person":"wudi-p0331","role":"被捕杀","evidence":["wudi-e-p119a-q"]},{"person":"wudi-p0054","role":"受求救","evidence":["wudi-e-p119a-q"]},{"person":"wudi-p0290","role":"在场","evidence":["wudi-e-p119a-q"]}],"place":null,"time":{"label":"建安十九年十一月","year":214,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-p119a-q","wudi-q-o161","wudi-q-b-c4192d9fada3bef44302"],"chronology":"wudi-y214","dating_review":{"anchor":"wudi-q-o161","basis":"建安十九年十一月","reviewed":true}},"source_order":[1,994,"P119a"],"order":367},{"id":"dongyuan-e-p044a","title":"李暹围宫迎帝杨彪谏不从伏氏贾诩左灵同车出","accounts":[{"id":"dongyuan-e-p044a-account","label":"《献帝起居注》","text":"李暹围宫迎帝杨彪谏不从伏氏贾诩左灵同车出","evidence":["dongyuan-e-p044a-q"]}],"participants":[{"person":"dongyuan-p0086","role":"围宫迎帝","evidence":["dongyuan-e-p044a-q"]},{"person":"wudi-p0153","role":"谏诤","evidence":["dongyuan-e-p044a-q"]},{"person":"wudi-p0054","rol