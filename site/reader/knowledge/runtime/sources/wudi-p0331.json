,"evidence":["dongyuan-e-p049b-q"]},{"person":"wudi-p0113","role":"谋渡","evidence":["dongyuan-e-p049b-q"]},{"person":"dongyuan-p0102","role":"供绢","evidence":["dongyuan-e-p049b-q"]},{"person":"dongyuan-p0103","role":"负帝","evidence":["dongyuan-e-p049b-q"]},{"person":"wudi-p0054","role":"渡河","evidence":["dongyuan-e-p049b-q"]},{"person":"wudi-p0331","role":"被扶渡","evidence":["dongyuan-e-p049b-q"]}],"place":null,"time":{"label":"献帝渡河时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-p049b-q"]},"ordering_evidence":"dongyuan-e-p049b-q","source_order":[6,180,"P049b"],"order":1594},{"id":"xunyu-e-p023a","title":"献帝春秋记伏后书伏完流转樊普呈曹操","accounts":[{"id":"xunyu-e-p023a-account","label":"《献帝春秋》","text":"献帝春秋记伏后书伏完流转樊普呈曹操","evidence":["xunyu-e-p023a-q"]}],"participants":[{"person":"wudi-p0331","role":"致书","evidence":["xunyu-e-p023a-q"]},{"person":"wudi-p0332","role":"传书","evidence":["xunyu-e-p023a-q"]},{"person":"xunyu-p0049","role":"呈书","evidence":["xunyu-e-p023a-q"]},{"person":"cao-cao","role":"阅书","evidence":["xunyu-e-p023a-q"]},{"person":"wudi-p0100","role":"被记隐书","evidence":["xunyu-e-p023a-q"]}],"place":null,"time":{"label":"献帝春秋所述伏后事至荀彧卒后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xunyu-e-p023a-q"]},"ordering_evidence":"xunyu-e-p023a-q","source_order":[10,170,"P023a"],"order":2451}],"persons":[{"id":"wudi-p0331","name":"伏皇后","evidence":["wudi-q-o169","xianzhu-q-o052","xunyu-q-p023","dongyuan-q-p044"],"facts":[{"id":"wudi-f-b-ccb381ac51ee4f293b5a-wudi-p0331-50b5b1","label":"姓名","text":"伏寿","evidence":["wudi-q-b-ccb381ac51ee4f293b5a"]}],"aliases":[{"text":"伏寿","evidence":["wudi-q-b-ccb381ac51ee4f293b5a"]}],"mentions":[{"id":"wudi-m-o169-wudi-p0331","kind":"mention","text":"文中提及","evidence":["wudi-q-o169"]},{"id":"wudi-m-p119-wudi-p0331","kind":"mention","text":"文中提及","evidence":["wudi-q-p119"]},{"id":"xianzhu-m-o052-wudi-p0331","kind":"allusion","text":"祖系或典故提及","evidence":["xianzhu-q-o052"]},{"id":"xianzhu-m-o057-wudi-p0331","kind":"allusion","text":"祖系或典故提及","evidence":["xianzhu-q-o057"]},{"id":"xunyu-m-p023-wudi-p0331","kind":"mention","text":"文中提及","evidence":["xunyu-q-p023"]},{"id":"dongyuan-m-p044-wudi-p0331","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p044"]},{"id":"dongyuan-m-p049-wudi-p0331","kind":"mention","text":"文中提及","evidence":["dongyuan-q-p049"]}]}],"evidence":[{"id":"dongyuan-e-p044a-q","section":"chapter-006","block":"b-b4b3790f4f883e68840d","layer":"pei","quote":"初，汜谋迎天子幸其营。夜有亡告傕者，傕使兄子暹，将数千兵围宫，以车三乘迎天子。杨彪曰：‘自古帝王，无在人臣家者。举事当合天下心；诸君作此，非是也。’暹曰：‘将军计定矣。’于是天子一乘，贵人伏氏一乘，贾诩、左灵一乘，其余皆步从。","attribution":"《献帝起居注》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":159,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-7f8915c0e475c5efba56","start":13,"end":126,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p049b-q","section":"chapter-006","block":"b-35cfbd89b795007423e6","layer":"pei","quote":"及当北渡，使李乐具船。天子步行趋河岸，岸高不得下。董承等谋欲以马羁相续，以系帝腰。时中宫仆伏德，扶中宫，一手持十匹绢；乃取德绢，连续为辇。行军校尉尚弘多力，令弘居前负帝，乃得下登船。其余不得渡者甚众，复遣船收诸不得渡者。皆争攀船，船上人以刃栎断其指；舟中之指可掬。","attribution":"《献帝纪》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":179,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6ae51262f7f7704d518a","start":94,"end":226,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p044","section":"chapter-006","block":"b-b4b3790f4f883e68840d","layer":"pei","quote":"﹝四﹞《献帝起居注》曰：“初，汜谋迎天子幸其营。夜有亡告傕者，傕使兄子暹，将数千兵围宫，以车三乘迎天子。杨彪曰：‘自古帝王，无在人臣家者。举事当合天下心；诸君作此，非是也。’暹曰：‘将军计定矣。’于是天子一乘，贵人伏氏一乘，贾诩、左灵一乘，其余皆步从。是日，傕复移乘舆幸北坞，使校尉监坞门，内外隔绝。诸侍臣皆有饥色，时盛暑热，人尽寒心。帝求米五斛、牛骨五具以赐左右。傕曰：‘朝;上饭，何用米为？’乃与腐牛骨，皆臭不可食。帝大怒，欲诘责之。侍中杨琦上封事曰：‘傕，边鄙之人，习于夷风。今又自知所犯悖逆，常有怏怏之色；欲辅车驾，幸黄白城以纾其愤。臣愿陛下忍之，未可显其罪也。’帝纳之。初，傕屯黄白城，故谋欲徙之。傕以司徒赵温不与己同，乃内温坞中。温闻傕欲移乘舆，与傕书曰：‘公前托为董公报仇，然实屠陷王城，杀戮大臣；天下不可家见而户释也。今争睚眦之隙，以成千钧之仇。民在涂炭，各不聊生；曾不改悟，遂成祸乱。朝廷仍下明诏，欲令和解；诏命不行，恩泽日损：而复欲辅乘舆于黄白城，此诚老夫所不解也。于《易》：一过为过，再为涉；三而弗改，灭其顶，凶。不如早共和解，引兵还屯。上安万乘，下全生民，岂不幸甚！’傕大怒，欲遣人害温。其从弟应，温故掾也，谏之数日乃止。帝闻温与傕书，问侍中常洽曰：‘傕弗知臧否；温言太切，可为寒心！’对曰：‘李应已解之矣。’帝乃悦。”","attribution":"《献帝起居注》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":159,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-7f8915c0e475c5efba56","start":0,"end":572,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p049","section":"chapter-006","block":"b-35cfbd89b795007423e6","layer":"pei","quote":"﹝三﹞《献帝纪》曰：“初，议者欲令天子浮河东下，太尉杨彪曰：‘臣弘农人，从此以东，有三十六滩；非万乘所当从也！’刘艾曰：‘臣前为陕令，知其危险；有师犹有倾覆，况今无师？太尉谋是也。’乃止。及当北渡，使李乐具船。天子步行趋河岸，岸高不得下。董承等谋欲以马羁相续，以系帝腰。时中宫仆伏德，扶中宫，一手持十匹绢；乃取德绢，连续为辇。行军校尉尚弘多力，令弘居前负帝，乃得下登船。其余不得渡者甚众，复遣船收诸不得渡者。皆争攀船，船上人以刃栎断其指；舟中之指可掬。”","attribution":"《献帝纪》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":179,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6ae51262f7f7704d518a","start":0,"end":227,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o169a-q","section":"chapter-001","block":"b-89f12ebaccdb3d3de5ca","layer":"original","quote":"十一月，汉皇后伏氏坐昔与父故屯骑校尉完书〖11〗，云帝以董承被诛怨恨公，辞甚丑恶；发闻〖12〗，后废黜死，兄弟皆伏法。﹝四﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":288,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":62,"offset_unit":"unicode_code_point"},{"id":"wudi-e-p119a-q","section":"chapter-001","block":"b-3457fee0b1be5bedfce1","layer":"pei","quote":"﹝四﹞《曹瞒传》曰：“公遣华歆勒兵入宫，收后；后闭户，匿壁中。歆坏户发壁，牵后出。帝时与御史大夫郗虑坐；后被发徒跣过，执帝手曰：‘不能复相活邪？’帝曰：‘我亦不自知命在何时也！’帝谓虑曰：‘郗公，天下宁有是邪！’遂将后杀之，（完）〔兄弟〕及宗族死者数百人。”","attribution":"《曹瞒传》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":318,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-e5d0e6f22cd38a8404dc","start":0,"end":129,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-c4192d9fada3bef44302","section":"chapter-001","block":"b-c4192d9fada3bef44302","layer":"modern","quote":"〖1〗十九年：建安十九年（公元 214）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":293,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-e80ed93e01a75d2ad2bd","start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-ccb381ac51ee4f293b5a","section":"chapter-001","block":"b-ccb381ac51ee4f293b5a","layer":"modern","quote":"〖11〗伏氏（？—公元 214）：名寿，汉献帝的皇后。传见《后汉书》卷十下。伏皇后死后的墓园，相传在今河南许昌市南蒋李集镇的冢刘村，现今尚有墓冢等遗迹留存。墓冢残高约 10 米，周长约 125 米。完：即伏完（？—公元 209）：伏皇后的父亲。事附《后汉书》卷十下《伏皇后纪》。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":303,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4f5e1157aba58c01a8c8","start":0,"end":139,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o161","section":"chapter-001","block":"b-ba55911420464ee82a49","layer":"original","quote":"十九年春正月〖1〗，始耕籍田〖2〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":280,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":18,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o169","section":"chapter-001","block":"b-89f12ebaccdb3d3de5ca","layer":"original","quote":"十一月，汉皇后伏氏坐昔与父故屯骑校尉完书〖11〗，云帝以董承被诛怨恨公，辞甚丑恶；发闻〖12〗，后废黜死，兄弟皆伏法。﹝四﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":288,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":62,"offset_unit":"unicode_code_point"},{"id":"wudi-q-p119","section":"chapter-001","block":"b-3457fee0b1be5bedfce1","layer":"pei","quote":"﹝四﹞《曹瞒传》曰：“公遣华歆勒兵入宫，收后；后闭户，匿壁中。歆坏户发壁，牵后出。帝时与御史大夫郗虑坐；后被发徒跣过，执帝手曰：‘不能复相活邪？’帝曰：‘我亦不自知命在何时也！’帝谓虑曰：‘郗公，天下宁有是邪！’遂将后杀之，（完）〔兄弟〕及宗族死者数百人。”","attribution":"《曹瞒传》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":318,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-e5d0e6f22cd38a8404dc","start":0,"end":129,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o052","section":"chapter-032","block":"b-13bc0548f92b946e57ac","layer":"original","quote":"昔唐尧至圣，而四凶在朝〖18〗；周成仁贤，而四国作难〖19〗；高后称制，而诸吕窃命〖20〗；孝昭幼冲，而上官逆谋〖21〗：皆凭世宠〖22〗，藉履国权〖23〗，穷凶极乱，社稷几危。非大舜、周公、朱虚、博陆〖24〗，则不能流放擒讨，安危定倾。伏惟陛下诞姿圣德，统理万邦；而遭厄运不造之艰〖25〗。董卓首难〖26〗，荡覆京畿；曹操阶祸〖27〗，窃执天衡〖28〗；皇后太子〖29〗，鸩杀见害；剥乱天下，残毁民物〖30〗。久令陛下蒙尘忧厄，幽处虚邑〖31〗；人神无主，遏绝王命；厌昧皇极〖32〗，欲盗神器。左将军、领司隶校尉、豫、荆、益三州牧宜城亭侯备，受朝爵秩，念在输力〖33〗，以殉国难。睹其机兆〖34〗，赫然愤发；与车骑将军董承同谋诛操，将安国家，克宁旧都。会承机事不密，令操游魂得遂长恶〖35〗，残泯海内。臣等每惧王室大有阎乐之祸〖36〗，小有定安之变〖37〗；﹝二﹞夙夜惴惴，战栗累息。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":207,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":393,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o057","section":"chapter-032","block":"b-238d2ad5a45d1607b403","layer":"original","quote":"“臣以具臣之才〖1〗，荷上将之任〖2〗，董督三军〖3〗，奉辞于外；不能扫除寇难，靖匡王室；久使陛下圣教陵迟，六合之内，否而未泰；惟忧反侧，疢如疾首〖4〗。曩者董卓，造为乱阶〖5〗；自是之后，群凶纵横，残剥海内。赖陛下圣德威灵，人神同应；或忠义奋讨，或上天降罚；暴逆并殪〖6〗，以渐冰消。唯独曹操，久未枭除；侵擅国权，恣心极乱。臣昔与车骑将军董承，图谋讨操；机事不密，承见陷害；臣播越失据〖7〗，忠义不果；遂得使操穷凶极逆，主后戮杀，皇子鸩害。虽纠合同盟，念在奋力；懦弱不武〖8〗，历年未效。常恐殒没，孤负国恩〖9〗；寤寐咏叹〖10〗，夕惕若厉〖11〗。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":276,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":276,"offset_unit":"unicode_code_point"},{"id":"xunyu-e-p023a-q","section":"chapter-010","block":"b-fc4215d18c32c8779800","layer":"pei","quote":"董承之诛，伏后与父完书，言‘司空杀董承，帝方为报怨’。完得书以示彧，彧恶之，久隐而不言。完以示妻弟樊普，普封以呈太祖；太祖阴为之备。","attribution":"《献帝春秋》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":169,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-e9f2abc222316e1535f8","start":9,"end":75,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-p023","section":"chapter-010","block":"b-fc4215d18c32c8779800","layer":"pei","quote":"《献帝春秋》曰：“董承之诛，伏后与父完书，言‘司空杀董承，帝方为报怨’。完得书以示彧，彧恶之，久隐而不言。完以示妻弟樊普，普封以呈太祖；太祖阴为之备。彧后恐事觉，欲自发之；因求使至邺，劝太祖以女配帝。太祖曰：‘今朝廷有伏后，吾女何得以配上；吾以微功见录，位为宰相，岂复赖女宠乎！’彧曰：‘伏后无子，性又凶邪；往常与父书，言辞丑恶：可因此废也。’太祖曰：‘卿昔何不道之？’彧佯惊曰：‘昔已尝为公言也！’太祖曰：‘此岂小事，而吾忘之！’彧又惊曰：‘诚未语公邪？昔公在官渡与袁绍相持，恐增内顾之念，故不言尔。’太祖曰：‘官渡事后何以不言？’彧无对，谢缺而已。太祖以此恨彧，而外含容之，故世莫得知。至董昭建立魏公之议，彧意不同，欲言之于太祖。及赍玺书犒军，饮飨礼毕；彧留，请闲。太祖知彧欲言封事，揖而遣之，彧遂不得言。彧卒于寿春。寿春亡者告孙权，言太祖‘使彧杀伏后，彧不从，故自杀’。权以露布于蜀，刘备闻之，曰：‘老贼不死，祸乱未已！’”","attribution":"《献帝春秋》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":169,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-e9f2abc222316e1535f8","start":0,"end":415,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
