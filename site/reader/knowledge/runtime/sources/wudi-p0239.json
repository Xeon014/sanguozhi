o-q-d613c7e6b71079cdcc55","cuimao-q-b79c4106d12a1087fa41","cuimao-q-79d365db442bb2319cca"]},"ordering_evidence":"cuimao-q-d613c7e6b71079cdcc55","source_order":[12,216,63],"order":2787},{"id":"zhangle-e-o016c","title":"乐进李典击管承平海滨","accounts":[{"id":"zhangle-e-o016c-account","label":"《张乐于张徐传第十七》正文","text":"乐进李典击管承平海滨","evidence":["zhangle-e-o016c-q"]},{"id":"lizang-a-0b74ea78b5d63663b409","label":"正文","text":"李典击管承于长广，皆破之","evidence":["lizang-q-de887e0c5d882f89d3cb"]}],"participants":[{"person":"wudi-p0236","role":"征讨","evidence":["zhangle-e-o016c-q"]},{"person":"wudi-p0237","role":"征讨","evidence":["zhangle-e-o016c-q"]},{"person":"wudi-p0239","role":"败走","evidence":["zhangle-e-o016c-q"]}],"place":null,"time":{"label":"建安十一年及其后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["zhangle-e-o016c-q"]},"ordering_evidence":"zhangle-e-o016c-q","source_order":[17,58,"O016c"],"order":3512},{"id":"zhangle-e-o030d","title":"张郃征管承从破陈兰梅成","accounts":[{"id":"zhangle-e-o030d-account","label":"《张乐于张徐传第十七》正文","text":"张郃征管承从破陈兰梅成","evidence":["zhangle-e-o030d-q"]}],"participants":[{"person":"wudi-p0183","role":"征讨","evidence":["zhangle-e-o030d-q"]},{"person":"wudi-p0239","role":"被讨","evidence":["zhangle-e-o030d-q"]}],"place":null,"time":{"label":"张郃归曹操后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["zhangle-e-o030d-q"]},"ordering_evidence":"zhangle-e-o030d-q","source_order":[17,103,"O030d"],"order":3546}],"persons":[{"id":"wudi-p0239","name":"管承","evidence":["wudi-q-o108","zhangle-q-o016","cuimao-q-d613c7e6b71079cdcc55","cuimao-q-b79c4106d12a1087fa41","cuimao-q-79d365db442bb2319cca","lizang-q-de887e0c5d882f89d3cb"],"facts":[],"aliases":[],"mentions":[{"id":"wudi-m-o108-wudi-p0239","kind":"mention","text":"文中提及","evidence":["wudi-q-o108"]},{"id":"zhangle-m-o016-wudi-p0239","kind":"mention","text":"文中提及","evidence":["zhangle-q-o016"]},{"id":"zhangle-m-o030-wudi-p0239","kind":"mention","text":"文中提及","evidence":["zhangle-q-o030"]}]}],"evidence":[{"id":"cuimao-q-79d365db442bb2319cca","section":"chapter-012","block":"b-8e9331a27b1a582299ff","layer":"original","quote":"夔遣吏成弘领校尉、长广县丞等郊迎〖5〗，奉牛酒，诣郡","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":215,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":180,"end":206,"offset_unit":"unicode_code_point"},{"id":"cuimao-q-b79c4106d12a1087fa41","section":"chapter-012","block":"b-8e9331a27b1a582299ff","layer":"original","quote":"乃遣郡丞黄珍往，为陈成败；承等皆请服","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":215,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":161,"end":179,"offset_unit":"unicode_code_point"},{"id":"cuimao-q-d613c7e6b71079cdcc55","section":"chapter-012","block":"b-8e9331a27b1a582299ff","layer":"original","quote":"议者欲举兵攻之。夔曰：“承等非生而乐乱也：习于乱，不能自还〖3〗；未被德教，故不知反善〖4〗。今兵迫之急，彼恐夷灭，必并力战；攻之既未易拔，虽胜必伤吏民。不如徐喻以恩德，使容自悔，可不烦兵而定","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":215,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":63,"end":159,"offset_unit":"unicode_code_point"},{"id":"lizang-q-de887e0c5d882f89d3cb","section":"chapter-018","block":"b-2d2b7f4d5bd4d51b6feb","layer":"original","quote":"击管承于长广〖7〗；皆破之","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":3,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":127,"end":140,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o108a-q","section":"chapter-001","block":"b-17f12483626d4c1388bb","layer":"original","quote":"秋八月，公东征海贼管承。至淳于〖4〗，遣乐进、李典击破之；承走入海岛。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":599,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":35,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-6509a80488ce395ecab9","section":"chapter-001","block":"b-6509a80488ce395ecab9","layer":"modern","quote":"〖1〗十一年：建安十一年（公元 206）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":603,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-60fd0962dbcc47eb5807","start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o107","section":"chapter-001","block":"b-25deb42237a5de280ce3","layer":"original","quote":"十一年春正月〖1〗，公征幹。幹闻之，乃留其别将守城，走入匈奴，求救于单于〖2〗。单于不受。公围壶关三月，拔之。幹遂走荆州〖3〗，上洛都尉王琰捕斩之。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":598,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":74,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o108","section":"chapter-001","block":"b-17f12483626d4c1388bb","layer":"original","quote":"秋八月，公东征海贼管承。至淳于〖4〗，遣乐进、李典击破之；承走入海岛。割东海之襄贲、郯、戚以益琅邪〖5〗，省昌虑郡。﹝一﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":599,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":61,"offset_unit":"unicode_code_point"},{"id":"zhangle-e-o016c-q","section":"chapter-017","block":"b-c438bb7ac7d486136f18","layer":"original","quote":"太祖征管承，军淳于。遣进〔与〕李典击之。承破走，逃入海岛，海滨平。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":57,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":194,"end":227,"offset_unit":"unicode_code_point"},{"id":"zhangle-e-o030d-q","section":"chapter-017","block":"b-3855d855bdd81918b067","layer":"original","quote":"别征东莱，讨管承；又与张辽讨陈兰、梅成等，破之。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":102,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":66,"end":90,"offset_unit":"unicode_code_point"},{"id":"zhangle-q-o016","section":"chapter-017","block":"b-c438bb7ac7d486136f18","layer":"original","quote":"建安十一年，太祖表汉帝，称进及于禁、张辽曰：“武力既弘，计略周备；质忠性一，守执节义；每临战攻，常为督率；奋强突固，无坚不陷；自援枹鼓〖6〗，手不知倦。又遣别征，统御师旅；抚众则和，奉令无犯；当敌制决，靡有遗失：论功纪用，宜各显宠。”于是禁，为虎威〖7〗；进，折冲〖8〗；辽，荡寇将军。进别征高幹，从北道入上党，回出其后〖9〗。幹等还守壶关，连战，斩首。幹坚守，未下；会太祖自征之，乃拔。太祖征管承，军淳于。遣进〔与〕李典击之。承破走，逃入海岛，海滨平。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":57,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":227,"offset_unit":"unicode_code_point"},{"id":"zhangle-q-o030","section":"chapter-017","block":"b-3855d855bdd81918b067","layer":"original","quote":"拜郃偏将军，封都亭侯，授以众。从攻邺，拔之。又从击袁谭于勃海，别将军围雍奴，大破之。从讨柳城，与张辽俱为军锋，以功迁平狄将军〖4〗。别征东莱，讨管承；又与张辽讨陈兰、梅成等，破之。从破马超、韩遂于渭南。围安定，降杨秋。与夏侯渊讨鄜贼梁兴及武都氐。又破马超，平宋建。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":102,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":132,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
