{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[],"persons":[{"id":"wuzhu-p0137","name":"刘声叔","evidence":["wuzhu-q-p043-judgment"],"facts":[{"id":"wuzhu-f0025","label":"身份记载","text":"《志林》称博物君子","evidence":["wuzhu-f0025-q"]}],"aliases":[],"mentions":[{"id":"wuzhu-m-p043-wuzhu-p0137","kind":"mention","text":"文中提及","evidence":["wuzhu-q-p043-judgment"]}]}],"evidence":[{"id":"wuzhu-f0025-q","section":"chapter-047","block":"b-6b2bb5d40ee64209cfad","layer":"pei","quote":"声叔，博物君子也","attribution":"《志林》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":384,"anchor":null},"note_id":"n-ca3da22a7824a5fd1e57","start":160,"end":168},{"id":"wuzhu-q-p043-judgment","section":"chapter-047","block":"b-6b2bb5d40ee64209cfad","layer":"pei","quote":"《志林》曰：“吴之创基，邵为首相；史无其传，窃常怪之。尝问刘声叔。声叔，博物君子也，云：‘推其名位，自应立传。项竣、（吴）〔丁〕孚时，已有注记此，云“与张惠恕不能”。后韦氏作史，盖惠恕之党，故不见书。’","attribution":"《志林》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":384,"anchor":null},"note_id":"n-ca3da22a7824a5fd1e57","start":127,"end":228}],"profiles":{},"directory_counts":{}}
