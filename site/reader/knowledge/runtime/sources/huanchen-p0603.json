{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"huanchen-e-p121","title":"文公用咎犯言败楚赏雍季","accounts":[{"id":"huanchen-a-847ce81fb512c2ccf320","label":"裴注·《吕氏春秋》","text":"文公用咎犯言败楚赏雍季","evidence":["huanchen-q-ac1998859841cd151799"]}],"participants":[{"person":"wudi-p0264","role":"将与楚人战于城濮、用咎犯之言而败楚人于城濮、反而为赏雍季在上、曰雍季之言百代之利也咎犯之言一时之务也","evidence":["huanchen-q-ac1998859841cd151799"]},{"person":"dongyuan-p0175","role":"曰竭泽而渔岂不得鱼而明年无鱼、诈伪之道虽今偷可后将无复非长术也","evidence":["huanchen-q-ac1998859841cd151799"]},{"person":"huanchen-p0603","role":"对曰君亦诈之而已；文公用其言","evidence":["huanchen-q-ac1998859841cd151799"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["huanchen-q-ac1998859841cd151799"]},"ordering_evidence":"huanchen-q-ac1998859841cd151799","source_order":[22,427,12],"order":4594}],"persons":[{"id":"huanchen-p0603","name":"咎犯","evidence":["huanchen-q-a9d0c344b3dcbf396a78"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[{"id":"huanchen-q-a9d0c344b3dcbf396a78","section":"chapter-022","block":"b-9f4f41419abd2de5839a","layer":"pei","quote":"咎犯对曰：‘臣闻繁礼之君，不足于文；繁战之君，不足于诈。君亦诈之而已。’","attribution":"正文","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":426,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-907a878c4f876e4b2fae","start":44,"end":80,"offset_unit":"unicode_code_point"},{"id":"huanchen-q-ac1998859841cd151799","section":"chapter-022","block":"b-9f4f41419abd2de5839a","layer":"pei","quote":"昔晋文公将与楚人战于城濮，召咎犯而问曰：‘楚众我寡，奈何而可？’咎犯对曰：‘臣闻繁礼之君，不足于文；繁战之君，不足于诈。君亦诈之而已。’文公以咎犯言告雍季，雍季曰：‘竭泽而渔，岂不得鱼？而明年无鱼。焚薮而田，岂不得兽？而明年无兽。诈伪之道，虽今偷可，后将无复。非长术也。’文公用咎犯之言，而败楚人于城濮。反而为赏，雍季在上。左右谏曰：‘城濮之功，咎犯之谋也。君用其言而后其身，或者不可乎？’文公曰：‘雍季之言，百代之利也；咎犯之言，一时之务也。焉有以一时之务，先百代之利乎","attribution":"裴注·《吕氏春秋》","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":426,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-907a878c4f876e4b2fae","start":12,"end":248,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
