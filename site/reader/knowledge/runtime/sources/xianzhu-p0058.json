["xianzhu-q-p038"]}]}],"evidence":[{"id":"liuermu-q-bfea3ae623f777b5c776","section":"chapter-031","block":"b-2a7eb34fd683676ae1b4","layer":"original","quote":"璋时从羲启留循〖34〗，先主以为奉车中郎将","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":75,"anchor":null},"note_id":null,"start":97,"end":118},{"id":"liuermu-q2-722f02439b8785811dd2","section":"chapter-031","block":"b-2a7eb34fd683676ae1b4","layer":"original","quote":"璋卒，南中豪率雍闿据益郡反〖31〗，附于吴。权复以璋子阐为益州刺史，处交、益界首。丞相诸葛亮平南土〖32〗，阐还吴，为御史中丞。﹝八﹞初，璋长子循妻，庞羲女也。先主定蜀，羲为左将军司马〖33〗；璋时从羲启留循〖34〗，先主以为奉车中郎将〖35〗。是以璋二子之后，分在吴、蜀。","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":75,"anchor":null},"note_id":null,"start":0,"end":137},{"id":"xianzhu-e-o042a-q","section":"chapter-032","block":"b-2a4cecab4b423e6c519d","layer":"original","quote":"先主进军围雒；时璋子循守城，被攻且一年。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":185,"anchor":null},"note_id":null,"start":0,"end":20},{"id":"xianzhu-f0036-q","section":"chapter-032","block":"b-2a4cecab4b423e6c519d","layer":"original","quote":"时璋子循守城，被攻且一年。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":185,"anchor":null},"note_id":null,"start":7,"end":20},{"id":"xianzhu-q-o042","section":"chapter-032","block":"b-2a4cecab4b423e6c519d","layer":"original","quote":"先主进军围雒；时璋子循守城，被攻且一年。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":185,"anchor":null},"note_id":null,"start":0,"end":20},{"id":"xianzhu-q-p038","section":"chapter-032","block":"b-8aa718c2e93c0cc7db20","layer":"pei","quote":"﹝一﹞《益部耆旧杂记》曰：“刘璋遣张任、刘璝，率精兵拒捍先主于涪；为先主所破，退与璋子循守雒城。任勒兵出于雁桥，战复败；擒任。先主闻任之忠勇，令军降之。任厉声曰：‘老臣终不复事二主矣！’乃杀之。先主叹惜焉。”","attribution":"《益部耆旧杂记》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":197,"anchor":null},"note_id":"n-9652930478437e755980","start":0,"end":104}],"profiles":{},"directory_counts":{}}
