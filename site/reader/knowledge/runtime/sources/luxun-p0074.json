":25,"end":43,"offset_unit":"unicode_code_point"},{"id":"luxun-e-p017b-q","section":"chapter-058","block":"b-4e40f1a3781efd738a0d","layer":"pei","quote":"及祖母亡，景为之心丧三年。","attribution":"《文士传》","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":453,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f7ed6bf14a8d2f3c8874","start":43,"end":56,"offset_unit":"unicode_code_point"},{"id":"luxun-f0012-q","section":"chapter-058","block":"b-ef5b34254d0aade8edb3","layer":"original","quote":"景字士仁","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":423,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":4,"offset_unit":"unicode_code_point"},{"id":"luxun-f0013-q","section":"chapter-058","block":"b-ef5b34254d0aade8edb3","layer":"original","quote":"时年三十一","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":423,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":86,"end":91,"offset_unit":"unicode_code_point"},{"id":"luxun-q-o081","section":"chapter-058","block":"b-849f1c91ed982d624bf9","layer":"original","quote":"晏及弟景、玄、机、云〖20〗，分领抗兵。晏为裨将军，夷道监〖21〗。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":421,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":34,"offset_unit":"unicode_code_point"},{"id":"luxun-q-o083","section":"chapter-058","block":"b-ef5b34254d0aade8edb3","layer":"original","quote":"景字士仁。以尚公主拜骑都尉，封毗陵侯。既领抗兵，拜偏将军，中夏督〖23〗。澡身好学〖24〗，著书数十篇也。﹝一﹞二月壬戌〖25〗，晏为王濬别军所杀；癸亥〖26〗，景亦遇害，时年三十一。景妻，孙皓嫡妹，与景俱张承外孙也〖27〗。﹝二﹞","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":423,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":116,"offset_unit":"unicode_code_point"},{"id":"luxun-q-p017","section":"chapter-058","block":"b-4e40f1a3781efd738a0d","layer":"pei","quote":"﹝一﹞《文士传》曰：“陆景母，张承女，诸葛恪外甥。恪诛，景母坐见黜；景少为祖母所育养。及祖母亡，景为之心丧三年。”","attribution":"《文士传》","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":453,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f7ed6bf14a8d2f3c8874","start":0,"end":57,"offset_unit":"unicode_code_point"},{"id":"yululu-q-5b529c1f1557bf409928","section":"chapter-057","block":"b-83dec35c399f832d797d","layer":"pei","quote":"晋征吴，忠与夷道监陆晏、晏弟中夏督景，坚守不下，城溃被害","attribution":"裴注·《会稽典录》","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":120,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-122f7f0974a37fbc5812","start":91,"end":119,"offset_unit":"unicode_code_point"},{"id":"yululu-q-e7ebdc907f127d86d269","section":"chapter-057","block":"b-83dec35c399f832d797d","layer":"pei","quote":"﹝二﹞《会稽典录》曰：“忠，字世方。翻第五子。贞固干事，好识人物；造吴郡陆机于童龀之年，称上虞魏迁于无名之初：终皆远致，为著闻之士。交同县王岐于孤宦之族，仕进先至宜都太守；忠乃代之。晋征吴，忠与夷道监陆晏、晏弟中夏督景，坚守不下，城溃被害。忠子谭，字思奥。”","attribution":"裴注·会稽典录","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":120,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-122f7f0974a37fbc5812","start":0,"end":129,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
