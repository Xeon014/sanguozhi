{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xuhuwang-e-84e878795a1f46c3a3cf","title":"王坦之任北中郎将徐兖刺史","accounts":[{"id":"xuhuwang-a-84e878795a1f46c3a3cf","label":"裴注·晋书及晋阳秋","text":"王坦之任北中郎将徐兖刺史","evidence":["xuhuwang-q-49255296ab0bc9344c5c"]}],"participants":[{"person":"xuhuwang-p-c36ed9c5ebd242","role":"任官","evidence":["xuhuwang-q-49255296ab0bc9344c5c"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["xuhuwang-q-49255296ab0bc9344c5c"]},"ordering_evidence":"xuhuwang-q-49255296ab0bc9344c5c","order":5372}],"persons":[{"id":"xuhuwang-p-c36ed9c5ebd242","name":"王坦之","evidence":["xuhuwang-q-49255296ab0bc9344c5c","xuhuwang-q-06b5f5352197a5d4570e"],"facts":[{"id":"xuhuwang-f-f21ef402448055291c20","text":"字文度，王述之子。","evidence":["xuhuwang-q-06b5f5352197a5d4570e"]}],"mentions":[],"aliases":[]}],"evidence":[{"id":"xuhuwang-q-06b5f5352197a5d4570e","section":"chapter-027","block":"b-9efef78c08981bf4551a","layer":"pei","quote":"﹝一﹞按《晋书》：“浑自越骑入晋，累居方任。平吴有功，封一子江陵侯。位至司徒。浑子济，字武子。有隽才令望，为河南尹、太仆。早卒，追赠骠骑将军。浑弟深，冀州刺史。深弟湛，字处冲。汝南太守。”湛子承，字安期。东海内史。承子述，字怀祖。尚书令、卫将军。述子坦之，字文度。北中郎将，徐、兖二州刺史。昶诸子中，湛最有德誉，而承亦自为名士，述及坦之并显重于世，为时盛门云。自湛以下事，见《晋阳秋》也。","attribution":"裴注（引书见原文，待主审复核）","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":253,"anchor":null},"note_id":"n-125e9b12619f6916fa00","start":0,"end":194},{"id":"xuhuwang-q-49255296ab0bc9344c5c","section":"chapter-027","block":"b-9efef78c08981bf4551a","layer":"pei","quote":"述子坦之，字文度。北中郎将，徐、兖二州刺史。","attribution":"裴注·晋书及晋阳秋","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":253,"anchor":null},"note_id":"n-125e9b12619f6916fa00","start":123,"end":145}],"profiles":{},"directory_counts":{}}
