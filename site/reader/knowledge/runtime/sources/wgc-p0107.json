{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wgc-e-add060","title":"胡岐任并州刺史","order":5817,"accounts":[{"id":"wgc-a-add060","label":"晋诸公赞","text":"胡岐任并州刺史","evidence":["wgc-q0703","wgc-q0135"]}],"participants":[{"person":"wgc-p0107","role":"任官","evidence":["wgc-q0703","wgc-q0135"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0703","wgc-q0135"]},"ordering_evidence":"wgc-q0703"}],"persons":[{"id":"wgc-p0107","name":"胡岐","evidence":["wgc-q0135"],"aliases":[],"facts":[],"mentions":[{"id":"wgc-m-p059-wgc-p0107","kind":"mention","text":"本段涉及胡岐","evidence":["wgc-q0135"]}]}],"evidence":[{"id":"wgc-q0135","section":"chapter-028","block":"b-a344b1173e6856a98116","layer":"pei","quote":"﹝四﹞《晋诸公赞》曰：“胡烈儿名渊，字世元。遵之孙也。遵，安定人，以才兼文武，累居藩镇，至车骑将军。子奋，字玄威。亦历方任。女为晋武帝贵人，有宠。太康中，以奋为尚书仆射，加镇军大将军，开府。弟广，字宣祖，少府；次烈，字玄武，秦州刺史；次岐，字玄嶷，并州刺史。广子喜，凉州刺史。渊小字鹞鸱。时年十八，既杀会救父，名震远近。后赵王伦篡位，三王兴义，伦使渊与张泓，将兵御齐王，屡破齐军。会成都战克，渊乃归降，伏法。”","attribution":"晋诸公赞","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":593,"anchor":null},"note_id":"n-7dfa0827333ec78b2b0e","start":0,"end":205},{"id":"wgc-q0703","section":"chapter-028","block":"b-a344b1173e6856a98116","layer":"pei","quote":"次岐，字玄嶷，并州刺史。","attribution":"晋诸公赞","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":593,"anchor":null},"note_id":"n-7dfa0827333ec78b2b0e","start":117,"end":129}],"profiles":{},"directory_counts":{}}
