{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o195a","title":"夏侯渊战死阳平","accounts":[{"id":"wudi-e-o195a-account","label":"正文","text":"夏侯渊与刘备战于阳平，被刘备军杀死。","evidence":["wudi-e-o195a-q"]},{"id":"xianzhu-e-o048a-account","label":"《先主传》正文","text":"《先主传》记刘备渡沔据定军山，命黄忠乘高进攻，斩夏侯渊、赵颙。","evidence":["xianzhu-e-o048a-q"]},{"id":"guanzhang-e-o038a-account","label":"《关张马黄赵传第六》正文","text":"黄忠定军山斩夏侯渊迁征西将军","evidence":["guanzhang-e-o038a-q"]},{"id":"pangfa-e-o024a-account","label":"《庞统法正传第七》正文","text":"建安二十四年，刘备至定军山营，法正请击，刘备命黄忠进攻，大破夏侯渊军并斩渊。","evidence":["pangfa-e-o024a-q"]},{"id":"xiahoucao-e-o019a-account","label":"《诸夏侯曹传第九》正文","text":"刘备夜烧鹿角攻张郃夏侯渊分兵为刘备袭而战死","evidence":["xiahoucao-e-o019a-q"]},{"id":"xiahoucao-a-o019-warning","label":"正文追记曹操戒语","text":"正文又追述曹操屡戒夏侯渊不可专恃勇力，应行之以智计。","evidence":["xiahoucao-q-o019-warning"]},{"id":"mantian-a-1500280f537b2fd07b47","label":"正文","text":"太祖还留夏侯渊拒备渊遇害军中扰扰","evidence":["mantian-q-e3c821d7eeb6b48aabca"]},{"id":"mantian-a-2325fe1f8de7da9c1e57","label":"正文","text":"太祖还，留征西将军夏侯渊拒刘备，以淮为渊司马","evidence":["mantian-q-60ee42f505cc336d697b"]}],"participants":[{"person":"wudi-p0278","role":"战死","evidence":["wudi-e-o195a-q"]},{"person":"liu-bei","role":"交战","evidence":["wudi-e-o195a-q"]},{"person":"xianzhu-p0051","role":"进攻","evidence":["xianzhu-e-o048a-q"]},{"person":"xianzhu-p0069","role":"战死","evidence":["xianzhu-e-o048a-q"]},{"person":"xianzhu-p0046","role":"请击","evidence":["pangfa-e-o024a-q"]},{"person":"wudi-p0183","role":"拒战不利","evidence":["xiahoucao-e-o019a-q"]},{"person":"cao-cao","role":"还邺，留夏侯渊拒刘备","evidence":["mantian-q-60ee42f505cc336d697b"]},{"person":"mingdi-p0100","role":"被留为渊司马","evidence":["mantian-q-60ee42f505cc336d697b"]}],"place":{"text":"阳平","evidence":["wudi-e-o195a-q"]},"time":{"label":"建安二十四年","year":219,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o195a-q","wudi-q-o194","wudi-q-b-1e7ae1441471aa22d204"],"chronology":"wudi-y219","dating_review":{"anchor":"wudi-q-o194","basis":"建安二十四年","reviewed":true}},"source_order":[1,1099,"O195a"],"related_events":[{"event":"huangli-e2-defeat-duhu-puhu","type":"related","evidence":["huangli-q2-8ec763646120744b2ac2","wudi-e-o195a-q"]},{"event":"huangli-e2-occupy-hanzhong","type":"related","evidence":["huangli-q2-8ec763646120744b2ac2","wudi-e-o195a-q"]}],"order":424}],"persons":[{"id":"xianzhu-p0069","name":"赵颙","evidence":["xianzhu-q-o048"],"facts":[],"aliases":[],"mentions":[{"id":"xianzhu-m-o048-xianzhu-p0069","kind":"mention","text":"文中提及","evidence":["xianzhu-q-o048"]}]}],"evidence":[{"id":"guanzhang-e-o038a-q","section":"chapter-036","block":"b-05b027684ab7ab886724","layer":"original","quote":"建安二十四年，于汉中定军山击夏侯渊，渊众甚精。忠推锋必进，劝率士卒；金鼓振天，欢声动谷〖5〗；一战斩渊，渊军大败。迁征西将军。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":169,"anchor":null},"note_id":null,"start":0,"end":63},{"id":"huangli-q2-8ec763646120744b2ac2","section":"chapter-043","block":"b-b937b741ffd9fc15238b","layer":"original","quote":"先主假权偏将军。﹝一﹞及曹公破张鲁，鲁走入巴中。权进曰：“若失汉中，则三巴不振〖1〗，此为割蜀之股臂也！”于是先主以权为护军，率诸将迎鲁；鲁已还南郑，北降曹公。然卒破杜濩、朴胡〖2〗，杀夏侯渊，据汉中：皆权本谋也。","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":10,"anchor":null},"note_id":null,"start":0,"end":107},{"id":"mantian-q-60ee42f505cc336d697b","section":"chapter-026","block":"b-d160820c791d32df9d68","layer":"original","quote":"太祖还，留征西将军夏侯渊拒刘备，以淮为渊司马","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":282,"anchor":null},"note_id":null,"start":0,"end":22},{"id":"mantian-q-e3c821d7eeb6b48aabca","section":"chapter-026","block":"b-d160820c791d32df9d68","layer":"original","quote":"太祖还，留征西将军夏侯渊拒刘备，以淮为渊司马。渊与备战，淮时有疾不出。渊遇害，军中扰扰","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":282,"anchor":null},"note_id":null,"start":0,"end":43},{"id":"pangfa-e-o024a-q","section":"chapter-037","block":"b-b3d109bb3fe355546163","layer":"original","quote":"二十四年〖27〗，先主自阳平南渡沔水，缘山稍前〖28〗，于定军（兴势）〔山〕作营。渊将兵来争其地。正曰：“可击矣！”先主命黄忠乘高鼓噪攻之，大破渊军，渊等授首〖29〗。","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":149,"anchor":null},"note_id":null,"start":0,"end":84},{"id":"wudi-e-o195a-q","section":"chapter-001","block":"b-a6c4894727ead1cc5e5d","layer":"original","quote":"夏侯渊与刘备战于阳平，为备所杀。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":423,"anchor":null},"note_id":null,"start":0,"end":16},{"id":"wudi-q-b-1e7ae1441471aa22d204","section":"chapter-001","block":"b-1e7ae1441471aa22d204","layer":"modern","quote":"〖1〗二十四年：建安二十四年（公元 219）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":428,"anchor":null},"note_id":"n-f2589f07b550616f1e63","start":0,"end":23},{"id":"wudi-q-o194","section":"chapter-001","block":"b-adb6682558d65fc17e1a","layer":"original","quote":"二十四年春正月〖1〗，仁屠宛，斩音。﹝一﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":422,"anchor":null},"note_id":null,"start":0,"end":21},{"id":"xiahoucao-e-o019a-q","section":"chapter-009","block":"b-4cfaf68cad6f0d5e3e1c","layer":"original","quote":"二十四年正月〖9〗，备夜烧围鹿角〖10〗；渊使张郃护东围，自将轻兵护南围。备挑郃战，郃军不利。渊分所将兵半，助郃；为备所袭，渊遂战死。谥曰愍侯。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":84,"anchor":null},"note_id":null,"start":0,"end":72},{"id":"xiahoucao-q-o019-warning","section":"chapter-009","block":"b-4cfaf68cad6f0d5e3e1c","layer":"original","quote":"初，渊虽数战胜，太祖常戒曰：“为将当有怯弱时，不可但恃勇也〖11〗！将当以勇为本，行之以智计。但知任勇，一匹夫敌耳。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":84,"anchor":null},"note_id":null,"start":72,"end":130},{"id":"xianzhu-e-o048a-q","section":"chapter-032","block":"b-2d515ba2dae40f6a248e","layer":"original","quote":"二十四年春〖11〗，自阳平南渡沔水，缘山稍前〖12〗，于定军山（势）作营〖13〗。渊将兵来争其地，先主命黄忠乘高鼓噪攻之。大破渊军，斩渊及曹公所署益州刺史赵颙等。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":203,"anchor":null},"note_id":null,"start":0,"end":81},{"id":"xianzhu-q-o048","section":"chapter-032","block":"b-2d515ba2dae40f6a248e","layer":"original","quote":"二十四年春〖11〗，自阳平南渡沔水，缘山稍前〖12〗，于定军山（势）作营〖13〗。渊将兵来争其地，先主命黄忠乘高鼓噪攻之。大破渊军，斩渊及曹公所署益州刺史赵颙等。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":203,"anchor":null},"note_id":null,"start":0,"end":81}],"profiles":{},"directory_counts":{}}
