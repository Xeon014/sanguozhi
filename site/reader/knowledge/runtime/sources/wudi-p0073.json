df2c458"]},{"id":"cuimao-f2-a7683315d0bfe9d094c8","text":"鲍勋以驸马都尉兼侍中。","evidence":["cuimao-q2-ace955d2b20eb6a2a0b1"]}],"aliases":[],"mentions":[{"id":"wudi-m-p030-wudi-p0073","kind":"mention","text":"文中提及","evidence":["wudi-q-p030"]},{"id":"wendi-m-p032-wudi-p0073","kind":"mention","text":"文中提及","evidence":["wendi-q-p032"]}]}],"evidence":[{"id":"cuimao-q-29d567bf3cb4206f80fe","section":"chapter-012","block":"b-df0878ba5b198601b537","layer":"original","quote":"帝手毁其表而竟行猎","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":300,"anchor":null},"note_id":null,"start":96,"end":105},{"id":"cuimao-q-415d1419c6a2a158f0a2","section":"chapter-012","block":"b-55c24cb840d03886971a","layer":"original","quote":"后二旬，文帝亦崩，莫不为勋叹恨","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":305,"anchor":null},"note_id":null,"start":20,"end":35},{"id":"cuimao-q-6725bb6fa997633cdc2b","section":"chapter-012","block":"b-df0878ba5b198601b537","layer":"original","quote":"文帝将出游猎，勋停车上疏曰：“臣闻五帝三王，靡不明本立教，以孝治天下。陛下仁圣恻隐，有同古烈〖1〗。臣冀当继踪前代，令万世可则也。如何在谅*之中〖2〗，修驰骋之事乎？臣冒死以闻，唯陛下察焉","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":300,"anchor":null},"note_id":null,"start":0,"end":94},{"id":"cuimao-q-689792f4eeff7beadb90","section":"chapter-012","block":"b-717170dd7c6269de9532","layer":"original","quote":"而曜密表勋私解邕事，诏曰：“勋指鹿作马，收付廷尉","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":303,"anchor":null},"note_id":null,"start":87,"end":111},{"id":"cuimao-q-68ef6be2129bf831b264","section":"chapter-012","block":"b-2edea839c54738e633ff","layer":"original","quote":"太子郭夫人弟，为曲周县吏，断盗官布，法应弃市","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":286,"anchor":null},"note_id":null,"start":74,"end":96},{"id":"cuimao-q-6f4b0e27931b7d876593","section":"chapter-012","block":"b-717170dd7c6269de9532","layer":"original","quote":"大军还洛阳，曜有罪，勋奏黜遣","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":303,"anchor":null},"note_id":null,"start":72,"end":86},{"id":"cuimao-q-7a3cffa956653aa11de0","section":"chapter-012","block":"b-15725c07c00dbde011b6","layer":"original","quote":"廷尉法议〖19〗：“正刑五岁〖20〗。”三官驳〖21〗：“依律，罚金二斤","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":304,"anchor":null},"note_id":null,"start":0,"end":36},{"id":"cuimao-q-7ccd788791a4593a44ba","section":"chapter-012","block":"b-df0878ba5b198601b537","layer":"original","quote":"帝怒作色。罢还，即出勋为右中郎将","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":300,"anchor":null},"note_id":null,"start":319,"end":335},{"id":"cuimao-q-8016df5cf3fc89448ae1","section":"chapter-012","block":"b-df0878ba5b198601b537","layer":"original","quote":"勋抗辞曰：“夫乐，上通神明，下和人理，隆治致化，万邦咸乂〖9〗。故移风易俗，莫善于乐；况猎暴华盖于原野〖10〗，伤生育之至理，栉风沐雨不以时隙哉！昔鲁隐观渔于棠，《春秋》讥之。虽陛下以为务，愚臣所不愿也。”因奏：“刘晔佞谀不忠，阿顺陛下过戏之言〖11〗。昔梁丘据取媚于遄台〖12〗，晔之谓也。请有司议罪，以清皇朝","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":300,"anchor":null},"note_id":null,"start":161,"end":317},{"id":"cuimao-q-90adbc59417022dc1060","section":"chapter-012","block":"b-717170dd7c6269de9532","layer":"original","quote":"太守孙邕见，出过勋。时营垒未成，但立标埒〖17〗。邕邪行，不从正道，军营令史刘曜欲推之〖18〗；勋以堑垒未成，解止不举","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":303,"anchor":null},"note_id":null,"start":12,"end":71},{"id":"cuimao-q-99dc418111faa5df3f94","section":"chapter-012","block":"b-15725c07c00dbde011b6","layer":"original","quote":"帝不许，遂诛勋","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":304,"anchor":null},"note_id":null,"start":138,"end":145},{"id":"cuimao-q-9f6b420f523dc73a3d0e","section":"chapter-012","block":"b-df0878ba5b198601b537","layer":"original","quote":"中道顿息〖4〗，问侍臣曰：“猎之为乐〖5〗，何如八音也〖6〗？”侍中刘晔对曰〖7〗：“猎胜于乐","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":300,"anchor":null},"note_id":null,"start":109,"end":156},{"id":"cuimao-q-b13bda6111823226839f","section":"chapter-012","block":"b-2edea839c54738e633ff","layer":"original","quote":"勋前在东宫，守正不挠，太子固不能悦；及重此事，恚望滋甚。会郡界休兵有失期者〖7〗，密敕中尉奏免勋官","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":286,"anchor":null},"note_id":null,"start":132,"end":181},{"id":"cuimao-q-b941b87fdf57863099ef","section":"chapter-012","block":"b-6c7fb7b8213da071aaf6","layer":"original","quote":"勋面谏曰：“王师屡征而未有所克者，盖以吴、蜀唇齿相依，凭阻山水，有难拔之势故也。往年龙舟飘荡〖14〗，隔在南岸；圣躬蹈危，臣下破胆。此时宗庙几至倾覆，为百世之戒。今又劳兵袭远，日费千金；中国虚耗，令黠虏玩威〖15〗。臣窃以为不可。”帝益忿之，左迁勋为治书执法","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":302,"anchor":null},"note_id":null,"start":18,"end":147},{"id":"cuimao-q-b9f82747473de29a9254","section":"chapter-012","block":"b-c42d7f51ccb7382c40ff","layer":"original","quote":"黄初四年，尚书令陈群、仆射司马宣王，并举勋为宫正；宫正即御史中丞也。帝不得已而用之，百僚严惮，罔不肃然","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":301,"anchor":null},"note_id":null,"start":0,"end":51},{"id":"cuimao-q-baccc6deb761b4fdd7cc","section":"chapter-012","block":"b-de953617adca4d22f61a","layer":"original","quote":"勋每陈“今之所急，唯在军、农，宽惠百姓。台榭苑囿，宜以为后","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":299,"anchor":null},"note_id":null,"start":30,"end":59},{"id":"cuimao-q-c2e26de37930d2990a0c","section":"chapter-012","block":"b-6c7fb7b8213da071aaf6","layer":"original","quote":"六年秋〖13〗，帝欲征吴，群臣大议","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":302,"anchor":null},"note_id":null,"start":0,"end":17},{"id":"cuimao-q-e09ed049836f4bbd64d1","section":"chapter-012","block":"b-2edea839c54738e633ff","layer":"original","quote":"二十二年〖3〗，立太子，以勋为中庶子","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":286,"anchor":null},"note_id":null,"start":37,"end":55},{"id":"cuimao-q-e22917c9d226c4dc1f26","section":"chapter-012","block":"b-15725c07c00dbde011b6","layer":"original","quote":"帝大怒曰：“勋无活分，而汝等敢纵之！收三官以下付刺奸〖22〗，当令十鼠同穴","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":304,"anchor":null},"note_id":null,"start":38,"end":75},{"id":"cuimao-q-f9b34731544f1f3d79d4","section":"chapter-012","block":"b-15725c07c00dbde011b6","layer":"original","quote":"太尉钟繇、司徒华歆、镇军大将军陈群、侍中辛毗、尚书卫臻、守廷尉高柔等〖24〗，并表“勋父信有功于太祖”，求请勋罪","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":304,"anchor":null},"note_id":null,"start":81,"end":137},{"id":"cuimao-q-fb45f079c7dbd5d9441b","section":"chapter-012","block":"b-2edea839c54738e633ff","layer":"original","quote":"太祖时在谯；太子留邺，数手书为之请罪。勋不敢擅纵，具列上","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":286,"anchor":null},"note_id":null,"start":100,"end":128},{"id":"cuimao-q2-2bacce779ef3bdf2c458","section":"chapter-012","block":"b-2edea839c54738e633ff","layer":"original","quote":"建安十七年，太祖追录信功，表封勋兄邵，新都亭侯；﹝二﹞辟勋，丞相掾。﹝三﹞二十二年〖3〗，立太子，以勋为中庶子〖4〗。徙黄门侍郎。出为魏郡西部都尉。太子郭夫人弟，为曲周县吏，断盗官布，法应弃市〖5〗。太祖时在谯；太子留邺，数手书为之请罪。勋不敢擅纵，具列上〖6〗。勋前在东宫，守正不挠，太子固不能悦；及重此事，恚望滋甚。会郡界休兵有失期者〖7〗，密敕中尉奏免勋官。久之，拜侍御史。","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":286,"anchor":null},"note_id":null,"start":0,"end":190},{"id":"cuimao-q2-ace955d2b20eb6a2a0b1","section":"chapter-012","block":"b-de953617adca4d22f61a","layer":"original","quote":"延康元年，太祖崩；太子即王位，勋以驸马都尉兼侍中。文帝受禅，勋每陈“今之所急，唯在军、农，宽惠百姓。台榭苑囿，宜以为后”。","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":299,"anchor":null},"note_id":null,"start":0,"end":61},{"id":"hancui-q-0624606c7ac4be29ef30","section":"chapter-024","block":"b-a586d42ada5b00dd75fa","layer":"original","quote":"帝以宿嫌，欲枉法诛治书执法鲍勋〖19〗，而柔固执不从诏命。帝怒甚，遂召柔诣台〖20〗。遣使者承指，至廷尉考竟勋；勋死乃遣柔还寺〖21〗。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":192,"anchor":null},"note_id":null,"start":5,"end":73},{"id":"wendi-e-o053a-q","section":"chapter-002","block":"b-1d30ef656dda0ab13df8","layer":"original","quote":"冬十月，行幸广陵故城〖15〗，临江观兵〖16〗。戎卒十余万，旌旗数百里。﹝二﹞是岁，大寒，水道冰，舟不得入江；乃引还。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":465,"anchor":null},"note_id":null,"start":0,"end":59},{"id":"wendi-e-p032a-q","section":"chapter-002","block":"b-672630f578f395129508","layer":"pei","quote":"癸丑，宣告群僚。督军御史中丞司马懿，侍御史郑浑、羊祕、鲍勋、武周等言：“令如左。伏读太史丞许芝上符命事。臣等闻有唐世衰，天命在虞；虞氏世衰，天命在夏。然则天地之灵，历数之运，去就之符，惟德所在。故孔子曰：‘凤鸟不至，河不出《图》，吾已矣夫！’今汉室衰，自安、和、冲、质以来，国统屡绝；桓、灵荒淫，禄去公室。此乃天命去就，非一朝一夕，其所由来久矣。殿下践阼，至德广被，格于上下；天人感应，符瑞并臻。考之旧史，未有若今日之盛。夫大人者，先天而天弗违；后天而奉天时。天时已至而犹谦让者，舜、禹所不为也；故生民蒙救济之惠，群类受育长之施。今八方颙颙，大小注望；皇天乃眷，神人同谋；十分而九以委质，义过周文，所谓过恭也。臣妾上下，伏所不安。”","attribution":"裴注·献帝传","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":144,"anchor":null},"note_id":"n-fc6f9c6942b5c231c294","start":0,"end":316},{"id":"wendi-q-b-e28c5cd47fe98ad60171","section":"chapter-002","block":"b-e28c5cd47fe98ad60171","layer":"modern","quote":"〖1〗六年：黄初六年（公元 225）。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":467,"anchor":null},"note_id":"n-61512c4ade75d71d6a76","start":0,"end":19},{"id":"wendi-q-b-ec88012a7f6c352d0e04","section":"chapter-002","block":"b-ec88012a7f6c352d0e04","layer":"modern","quote":"〖1〗二年：黄初二年（公元 221）。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":210,"anchor":null},"note_id":"n-8fff547b113ffa36bbc1","start":0,"end":19},{"id":"wendi-q-o002","section":"chapter-002","block":"b-1c3ea4f0ea338bf2ec5a","layer":"original","quote":"太祖崩，嗣位为丞相，魏王。﹝三﹞尊王后曰王太后〖5〗。改建安二十五年为延康元年。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":2,"anchor":null},"note_id":null,"start":0,"end":40},{"id":"wendi-q-o019","section":"chapter-002","block":"b-8820e5c7f9006d364c44","layer":"original","quote":"二年春正月〖1〗，郊祀天地、明堂〖2〗。甲戌〖3〗，校猎至原陵〖4〗。遣使者，以太牢祠汉世祖〖5〗。乙亥〖6〗，朝日于东郊〖7〗。﹝一﹞初令郡国口满十万者〖8〗，岁察孝廉一人；其有秀异〖9〗，无拘户口。辛巳〖10〗，分三公户邑，封子弟各一人为列侯。壬午〖11〗，复颍川郡一年田租〖12〗。﹝二﹞改许县为许昌县。以魏郡东部为阳平郡〖13〗，西部为广平郡〖14〗。﹝三﹞","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":208,"anchor":null},"note_id":null,"start":0,"end":183},{"id":"wendi-q-o049","section":"chapter-002","block":"b-d5847039c2d504d36e8e","layer":"original","quote":"六年春二月〖1〗，遣使者循行许昌以东，尽沛郡〖2〗。问民所疾苦，贫者赈贷之。﹝一﹞三月，行幸召陵〖3〗，通讨虏渠〖4〗。乙巳〖5〗，还许昌宫。并州刺史梁习讨鲜卑轲比能〖6〗，大破之。辛未〖7〗，帝为舟师，东征。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":461,"anchor":null},"note_id":null,"start":0,"end":105},{"id":"wendi-q-p032","section":"chapter-002","block":"b-672630f578f395129508","layer":"pei","quote":"癸丑，宣告群僚。督军御史中丞司马懿，侍御史郑浑、羊祕、鲍勋、武周等言：“令如左。伏读太史丞许芝上符命事。臣等闻有唐世衰，天命在虞；虞氏世衰，天命在夏。然则天地之灵，历数之运，去就之符，惟德所在。故孔子曰：‘凤鸟不至，河不出《图》，吾已矣夫！’今汉室衰，自安、和、冲、质以来，国统屡绝；桓、灵荒淫，禄去公室。此乃天命去就，非一朝一夕，其所由来久矣。殿下践阼，至德广被，格于上下；天人感应，符瑞并臻。考之旧史，未有若今日之盛。夫大人者，先天而天弗违；后天而奉天时。天时已至而犹谦让者，舜、禹所不为也；故生民蒙救济之惠，群类受育长之施。今八方颙颙，大小注望；皇天乃眷，神人同谋；十分而九以委质，义过周文，所谓过恭也。臣妾上下，伏所不安。”","attribution":"裴注·献帝传","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":144,"anchor":null},"note_id":"n-fc6f9c6942b5c231c294","start":0,"end":316},{"id":"wudi-q-p030","section":"chapter-001","block":"b-fab2b2926d4cb6fded1b","layer":"pei","quote":"﹝七﹞信事，见子《勋传》。","attribution":"裴松之互见提示","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":98,"anchor":null},"note_id":"n-d70b60fc73db4363dbf6","start":0,"end":13}],"profiles":{},"directory_counts":{}}
