{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-o051a","title":"群臣上表推刘备为汉中王","accounts":[{"id":"xianzhu-e-o051a-account","label":"《先主传》正文","text":"马超、许靖、诸葛亮等一百二十人署名上表汉帝，推刘备为汉中王、大司马。","evidence":["xianzhu-e-o051a-q"]},{"id":"xianzhu-a-o050-preface","label":"《先主传》正文","text":"正文交代群臣秋日上表汉帝。","evidence":["xianzhu-q-o050-preface"]},{"id":"xianzhu-a-o052-argument1","label":"《先主传》正文·群臣上表","text":"上表以古代宗室辅政为典，叙董卓、曹操之乱与刘备、董承谋讨曹操；此为表文所陈立王理由。","evidence":["xianzhu-q-o052-argument1"]},{"id":"xianzhu-a-o053-argument2","label":"《先主传》正文·群臣上表","text":"表文援宗亲藩屏及窦融旧例，提出刘备爵号未显不足以镇卫社稷。","evidence":["xianzhu-q-o053-argument2"]},{"id":"xianzhu-a-o054-proposal","label":"《先主传》正文·群臣上表","text":"群臣宣称依旧典封刘备汉中王、拜大司马，以汉中、巴、蜀、广汉、犍为为国。","evidence":["xianzhu-q-o054-proposal"]},{"id":"dengzhang-a-e5778b16dd46c3d298c3","label":"裴注·华阳国志","text":"李朝为汉中王上文","evidence":["dengzhang-q-717a432bbf8367bb45e1"]}],"participants":[{"person":"wudi-p0282","role":"署表","evidence":["xianzhu-e-o051a-q"]},{"person":"xianzhu-p0059","role":"署表","evidence":["xianzhu-e-o051a-q"]},{"person":"xianzhu-p0074","role":"署表","evidence":["xianzhu-e-o051a-q"]},{"person":"xianzhu-p0075","role":"署表","evidence":["xianzhu-e-o051a-q"]},{"person":"zhuge-liang","role":"署表","evidence":["xianzhu-e-o051a-q"]},{"person":"wudi-p0172","role":"署表","evidence":["xianzhu-e-o051a-q"]},{"person":"wudi-p0367","role":"署表","evidence":["xianzhu-e-o051a-q"]},{"person":"xianzhu-p0051","role":"署表","evidence":["xianzhu-e-o051a-q"]},{"person":"xianzhu-p0076","role":"署表","evidence":["xianzhu-e-o051a-q"]},{"person":"xianzhu-p0046","role":"署表","evidence":["xianzhu-e-o051a-q"]},{"person":"xianzhu-p0057","role":"署表","evidence":["xianzhu-e-o051a-q"]},{"person":"liu-bei","role":"受推","evidence":["xianzhu-e-o051a-q"]},{"person":"wudi-p0054","role":"表文受呈者","evidence":["xianzhu-e-o051a-q"]},{"person":"dengzhang-p0028","role":"群下上先主为汉中王，其文朝所造","evidence":["dengzhang-q-717a432bbf8367bb45e1"]}],"place":null,"time":{"year":219,"label":"建安二十四年秋","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xianzhu-y219","dating_review":{"reviewed":true,"anchor":"xianzhu-q-o048","basis":"建安二十四年秋"},"evidence":["xianzhu-e-o051a-q","xianzhu-q-o048","xianzhu-q-b-c3e56caa3865de7f7114"]},"source_order":[32,207,"O051a"],"order":6580},{"id":"xianzhu-e-o064a","title":"许靖诸葛亮等劝进并筹备礼仪","accounts":[{"id":"xianzhu-e-o064a-account","label":"《先主传》正文","text":"许靖、麋竺、诸葛亮等上言劝进，称与许慈、孟光建立礼仪、择日上尊号。","evidence":["xianzhu-e-o064a-q"]}],"participants":[{"person":"xianzhu-p0059","role":"上言","evidence":["xianzhu-e-o064a-q"]},{"person":"xianzhu-p0021","role":"上言","evidence":["xianzhu-e-o064a-q"]},{"person":"zhuge-liang","role":"上言","evidence":["xianzhu-e-o064a-q"]},{"person":"xianzhu-p0076","role":"上言","evidence":["xianzhu-e-o064a-q"]},{"person":"xianzhu-p0104","role":"上言","evidence":["xianzhu-e-o064a-q"]},{"person":"xianzhu-p0105","role":"上言","evidence":["xianzhu-e-o064a-q"]},{"person":"xianzhu-p0108","role":"议礼","evidence":["xianzhu-e-o064a-q"]},{"person":"xianzhu-p0109","role":"议礼","evidence":["xianzhu-e-o064a-q"]},{"person":"liu-bei","role":"被劝进","evidence":["xianzhu-e-o064a-q"]}],"place":null,"time":{"label":"刘备即位前","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xianzhu-e-o064a-q"]},"source_order":[32,357,"O064a"],"order":6597},{"id":"dengzhang-e2-three-ministers","title":"汉中王背景下赖恭为太常、黄柱为光禄勋、王谋为少府","accounts":[{"id":"dengzhang-a-6d30ef8670b0e65d35a0","label":"正文","text":"刘备拜赖恭黄柱王谋为卿","evidence":["dengzhang-q-e2717e677ec9a520b8cc","dengzhang-q2-0eabec327d7f8184a731"]}],"participants":[{"person":"xianzhu-p0076","role":"任太常","evidence":["dengzhang-q2-0eabec327d7f8184a731"]},{"person":"xianzhu-p0104","role":"任光禄勋","evidence":["dengzhang-q2-0eabec327d7f8184a731"]},{"person":"xianzhu-p0105","role":"任少府","evidence":["dengzhang-q2-0eabec327d7f8184a731"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"第二轮逐项审定；仅保原文时序，不另行推年。","evidence":["dengzhang-q2-0eabec327d7f8184a731"]},"ordering_evidence":"dengzhang-q2-0eabec327d7f8184a731","related_events":[{"event":"xianzhu-e-o055a","type":"related","evidence":["dengzhang-q2-0eabec327d7f8184a731","xianzhu-e-o055a-q"]}],"order":7938},{"id":"yaoci-e-o076","title":"朱符死后，汉遣张津为交州刺史","accounts":[{"id":"yaoci-a-7c3f9df1ad74ff8de049","label":"正文","text":"朱符死后，汉遣张津为交州刺史","evidence":["yaoci-q-3927497c8714c85dd090"]},{"id":"yaoci-a-d901886011a87d65157a","label":"正文","text":"张津后为其将区景所杀；荆州牧刘表遣零陵赖恭代津","evidence":["yaoci-q-f21137f7256ac6be4a7a"]}],"participants":[{"person":"sunshi-p0082","role":"受遣为交州刺史者；被杀者","evidence":["yaoci-q-3927497c8714c85dd090","yaoci-q-f21137f7256ac6be4a7a"]},{"person":"yaoci-p0011","role":"杀张津者","evidence":["yaoci-q-f21137f7256ac6be4a7a"]},{"person":"liu-biao","role":"遣代者","evidence":["yaoci-q-f21137f7256ac6be4a7a"]},{"person":"xianzhu-p0076","role":"受遣代津者","evidence":["yaoci-q-f21137f7256ac6be4a7a"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["yaoci-q-3927497c8714c85dd090","yaoci-q-f21137f7256ac6be4a7a"]},"ordering_evidence":"yaoci-q-3927497c8714c85dd090","source_order":[49,182,0],"order":8991},{"id":"yaoci-e-o080","title":"后吴巨与赖恭相失，举兵逐恭，恭走还零陵","accounts":[{"id":"yaoci-a-69ca58826514d03f13ad","label":"正文","text":"后吴巨与赖恭相失，举兵逐恭，恭走还零陵","evidence":["yaoci-q-ddf529aaee653f8ae4d3"]}],"participants":[{"person":"xianzhu-p0037","role":"举兵逐恭者","evidence":["yaoci-q-ddf529aaee653f8ae4d3"]},{"person":"xianzhu-p0076","role":"被逐走还零陵者","evidence":["yaoci-q-ddf529aaee653f8ae4d3"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["yaoci-q-ddf529aaee653f8ae4d3"]},"ordering_evidence":"yaoci-q-ddf529aaee653f8ae4d3","source_order":[49,214,136],"order":8996}],"persons":[{"id":"xianzhu-p0076","name":"赖恭","evidence":["xianzhu-q-o051","dengzhang-q-e2717e677ec9a520b8cc","dengzhang-q2-0eabec327d7f8184a731","yaoci-q-f21137f7256ac6be4a7a","yaoci-q-28d4740d5f6e9b420ab6","yaoci-q-ddf529aaee653f8ae4d3","zhangyan-q-9afbb18a3047e9e17ead"],"facts":[],"aliases":[],"mentions":[{"id":"xianzhu-m-o051-xianzhu-p0076","kind":"mention","text":"文中提及","evidence":["xianzhu-q-o051"]},{"id":"xianzhu-m-o064-xianzhu-p0076","kind":"mention","text":"文中提及","evidence":["xianzhu-q-o064"]},{"id":"yaoci-m2-ee2a38d094aa9a2fb179","kind":"mention","text":"文中提及","evidence":["yaoci-q-28d4740d5f6e9b420ab6"]},{"id":"zhangyan-m-34329c8165452f1412d5","kind":"mention","text":"本篇原文记及赖恭，具体行动与称谓见引文。","evidence":["zhangyan-q-9afbb18a3047e9e17ead"]}]}],"evidence":[{"id":"dengzhang-q-717a432bbf8367bb45e1","section":"chapter-045","block":"b-dcad3795f68a26f97ecf","layer":"pei","quote":"群下上先主为汉中王；其文，朝所造也","attribution":"裴注·华阳国志","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":345,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c4df925d7ccb2471fbb6","start":47,"end":64,"offset_unit":"unicode_code_point"},{"id":"dengzhang-q-e2717e677ec9a520b8cc","section":"chapter-045","block":"b-96d3f55961b19f0ab838","layer":"original","quote":"先主为汉中王，用荆楚宿士零陵赖恭为太常〖67〗，南阳黄柱为光禄勋，谋为少府","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":179,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":53,"end":90,"offset_unit":"unicode_code_point"},{"id":"dengzhang-q2-0eabec327d7f8184a731","section":"chapter-045","block":"b-96d3f55961b19f0ab838","layer":"original","quote":"王元泰名谋，汉嘉人也。有容止操行〖66〗。刘璋时，为巴郡太守。还为州治中从事。先主定益州，领牧，以为别驾。先主为汉中王，用荆楚宿士零陵赖恭为太常〖67〗，南阳黄柱为光禄勋，谋为少府。建兴初，赐爵关内侯。后代赖恭为太常。恭、柱、谋皆失其行事，故不为传。恭子厷，为丞相西曹令史〖68〗。随诸葛亮于汉中，早夭。亮甚惜之，与留府长史、参军张裔、蒋琬书曰：“令史失赖厷，掾属丧杨颙，为朝中损益多矣〖69〗！”颙亦荆州人也。后大将军蒋琬问张休曰：“汉嘉前辈有王元泰，今谁继者？”休对曰：“至于元泰，州里无继〖70〗；况鄙郡乎？”其见重如此。﹝一﹞","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":179,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":267,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o051a-q","section":"chapter-032","block":"b-652c7dfc21363b200764","layer":"original","quote":"“平西将军、都亭侯臣马超，左将军领长史、镇军将军臣许靖，营司马臣庞羲，议曹从事、中郎、军议中郎将臣射援，﹝一﹞军师将军臣诸葛亮，荡寇将军、汉寿亭侯臣关羽，征虏将军、新亭侯臣张飞，征西将军臣黄忠，镇远将军臣赖恭，扬武将军臣法正，兴业将军臣李严等一百二十人上言曰〖17〗：","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":206,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":134,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o055a-q","section":"chapter-032","block":"b-430cf056e3d7a4efdfc3","layer":"original","quote":"遂于沔阳设坛场〖60〗，陈兵列众，群臣陪位；读奏讫，御王冠于先主。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":210,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":33,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o064a-q","section":"chapter-032","block":"b-7a224291a097891a1ad5","layer":"original","quote":"太傅许靖，安汉将军麋竺，军师将军诸葛亮，太常赖恭，光禄勋黄（权）〔柱〕，少府王谋等上言〖1〗：“曹丕篡弑，湮灭汉室，窃据神器；劫迫忠良，酷烈无道；人鬼忿毒〖2〗，咸思刘氏。今上无天子，海内惶惶，靡所式仰〖3〗。群下前后上书者八百余人，咸称述符瑞、图谶明征〖4〗。间黄龙现武阳赤水〖5〗，九日乃去。《孝经援神契》曰‘德至渊泉，则黄龙现’；龙者，君之象也。《易•乾》九五‘飞龙在天’〖6〗，大王当龙升，登帝位也。又前关羽围樊、襄阳，襄阳男子张嘉、王休献玉玺，玺潜汉水，伏于渊泉；晖景烛耀〖7〗，灵光彻天。夫‘汉’者，高祖本所起定天下之国号也；大王袭先帝轨迹，亦兴于汉中也。今天子玉玺神光先现，玺出襄阳，汉水之末〖8〗；明大王承其下流，授与大王以天子之位：瑞命符应，非人力所致。昔周有乌鱼之瑞〖9〗，咸曰休哉；二祖受命〖10〗，《图》、《书》先著〖11〗，以为征验。今上天告祥〖12〗，群儒英俊并进《河》、《洛》、孔子谶记〖13〗，咸悉俱至〖14〗。伏惟大王出自孝景皇帝中山靖王之胄，本枝百世〖15〗，乾祗降祚〖16〗；圣姿硕茂〖17〗，神武在躬；仁覆积德，爱人好士：是以四方归心焉。考省灵《图》，启发谶纬〖18〗；神明之表，名讳昭著；宜即帝位，以纂二祖；绍嗣昭穆〖19〗，天下幸甚！臣等谨与博士许慈、议郎孟光〖20〗，建立礼仪，择令辰，上尊号。”","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":356,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":571,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-b-c3e56caa3865de7f7114","section":"chapter-032","block":"b-c3e56caa3865de7f7114","layer":"modern","quote":"〖11〗二十四年：建安二十四年（公元 219）。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":222,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fd85f82251e498647de7","start":0,"end":24,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o048","section":"chapter-032","block":"b-2d515ba2dae40f6a248e","layer":"original","quote":"二十四年春〖11〗，自阳平南渡沔水，缘山稍前〖12〗，于定军山（势）作营〖13〗。渊将兵来争其地，先主命黄忠乘高鼓噪攻之。大破渊军，斩渊及曹公所署益州刺史赵颙等。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":203,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":81,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o050-preface","section":"chapter-032","block":"b-a429b62b1d8ac4da31ba","layer":"original","quote":"秋，群下上《先王为汉中王表》于汉帝〖16〗，曰：","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":205,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":24,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o051","section":"chapter-032","block":"b-652c7dfc21363b200764","layer":"original","quote":"“平西将军、都亭侯臣马超，左将军领长史、镇军将军臣许靖，营司马臣庞羲，议曹从事、中郎、军议中郎将臣射援，﹝一﹞军师将军臣诸葛亮，荡寇将军、汉寿亭侯臣关羽，征虏将军、新亭侯臣张飞，征西将军臣黄忠，镇远将军臣赖恭，扬武将军臣法正，兴业将军臣李严等一百二十人上言曰〖17〗：","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":206,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":134,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o052-argument1","section":"chapter-032","block":"b-13bc0548f92b946e57ac","layer":"original","quote":"昔唐尧至圣，而四凶在朝〖18〗；周成仁贤，而四国作难〖19〗；高后称制，而诸吕窃命〖20〗；孝昭幼冲，而上官逆谋〖21〗：皆凭世宠〖22〗，藉履国权〖23〗，穷凶极乱，社稷几危。非大舜、周公、朱虚、博陆〖24〗，则不能流放擒讨，安危定倾。伏惟陛下诞姿圣德，统理万邦；而遭厄运不造之艰〖25〗。董卓首难〖26〗，荡覆京畿；曹操阶祸〖27〗，窃执天衡〖28〗；皇后太子〖29〗，鸩杀见害；剥乱天下，残毁民物〖30〗。久令陛下蒙尘忧厄，幽处虚邑〖31〗；人神无主，遏绝王命；厌昧皇极〖32〗，欲盗神器。左将军、领司隶校尉、豫、荆、益三州牧宜城亭侯备，受朝爵秩，念在输力〖33〗，以殉国难。睹其机兆〖34〗，赫然愤发；与车骑将军董承同谋诛操，将安国家，克宁旧都。会承机事不密，令操游魂得遂长恶〖35〗，残泯海内。臣等每惧王室大有阎乐之祸〖36〗，小有定安之变〖37〗；﹝二﹞夙夜惴惴，战栗累息。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":207,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":393,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o053-argument2","section":"chapter-032","block":"b-5e935a656e57fa2b467f","layer":"original","quote":"昔在《虞书》〖38〗，敦序九族〖39〗；周监二代〖40〗，封建同姓；《诗》著其义〖41〗，历载长久。汉兴之初，割裂疆土〖42〗，尊王子弟；是以卒折诸吕之难〖43〗，而成太宗之基〖44〗。臣等以备肺腑枝叶〖45〗，宗子藩翰〖46〗；心存国家，念在弥乱〖47〗；自操破于汉中，海内英雄望风蚁附；而爵号不显，九锡未加〖48〗：非所以镇卫社稷，光昭万世也。奉辞在外〖49〗，礼命断绝。昔河西太守梁统等值汉中兴〖50〗，限于山河〖51〗；位同权均，不能相率；咸推窦融以为元帅〖52〗，卒立效绩〖53〗，摧破隗嚣〖54〗。今社稷之难，急于陇、蜀〖55〗；操外吞天下，内残群僚；朝廷有萧墙之危〖56〗，而御侮未建〖57〗，可为寒心。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":208,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":309,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o054-proposal","section":"chapter-032","block":"b-48e611d2cf38e3f1ec45","layer":"original","quote":"臣等辄依旧典，封备汉中王，拜大司马，董齐六军〖58〗，纠合同盟，扫灭凶逆；以汉中、巴、蜀、广汉、犍为为国，所署置依汉初诸侯王故典。夫权宜之制，苟利社稷，专之可也；然后功成事立，臣等退伏矫罪〖59〗，虽死无恨！”","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":209,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":105,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o064","section":"chapter-032","block":"b-7a224291a097891a1ad5","layer":"original","quote":"太傅许靖，安汉将军麋竺，军师将军诸葛亮，太常赖恭，光禄勋黄（权）〔柱〕，少府王谋等上言〖1〗：“曹丕篡弑，湮灭汉室，窃据神器；劫迫忠良，酷烈无道；人鬼忿毒〖2〗，咸思刘氏。今上无天子，海内惶惶，靡所式仰〖3〗。群下前后上书者八百余人，咸称述符瑞、图谶明征〖4〗。间黄龙现武阳赤水〖5〗，九日乃去。《孝经援神契》曰‘德至渊泉，则黄龙现’；龙者，君之象也。《易•乾》九五‘飞龙在天’〖6〗，大王当龙升，登帝位也。又前关羽围樊、襄阳，襄阳男子张嘉、王休献玉玺，玺潜汉水，伏于渊泉；晖景烛耀〖7〗，灵光彻天。夫‘汉’者，高祖本所起定天下之国号也；大王袭先帝轨迹，亦兴于汉中也。今天子玉玺神光先现，玺出襄阳，汉水之末〖8〗；明大王承其下流，授与大王以天子之位：瑞命符应，非人力所致。昔周有乌鱼之瑞〖9〗，咸曰休哉；二祖受命〖10〗，《图》、《书》先著〖11〗，以为征验。今上天告祥〖12〗，群儒英俊并进《河》、《洛》、孔子谶记〖13〗，咸悉俱至〖14〗。伏惟大王出自孝景皇帝中山靖王之胄，本枝百世〖15〗，乾祗降祚〖16〗；圣姿硕茂〖17〗，神武在躬；仁覆积德，爱人好士：是以四方归心焉。考省灵《图》，启发谶纬〖18〗；神明之表，名讳昭著；宜即帝位，以纂二祖；绍嗣昭穆〖19〗，天下幸甚！臣等谨与博士许慈、议郎孟光〖20〗，建立礼仪，择令辰，上尊号。”","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":356,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":571,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-28d4740d5f6e9b420ab6","section":"chapter-049","block":"b-43c68260303aa97203c7","layer":"original","quote":"汉闻张津死，赐燮玺书曰〖1〗：“交州绝域〖2〗，南带江海；上恩不宣，下义壅隔。知逆贼刘表，又遣赖恭，窥看南土。今以燮为绥南中郎将〖3〗，董督七郡〖4〗；领交阯太守如故","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":213,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":83,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-3927497c8714c85dd090","section":"chapter-049","block":"b-f75d5158c998b543fe4a","layer":"original","quote":"朱符死后，汉遣张津为交州刺史","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":181,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":14,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-ddf529aaee653f8ae4d3","section":"chapter-049","block":"b-43c68260303aa97203c7","layer":"original","quote":"后巨与恭相失〖6〗，举兵逐恭，恭走还零陵","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":213,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":136,"end":156,"offset_unit":"unicode_code_point"},{"id":"yaoci-q-f21137f7256ac6be4a7a","section":"chapter-049","block":"b-f75d5158c998b543fe4a","layer":"original","quote":"津，后又为其将区景所杀；而荆州牧刘表，遣零陵赖恭代津","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":181,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":15,"end":41,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-9afbb18a3047e9e17ead","section":"chapter-053","block":"b-a48f4ed57afb51356ec6","layer":"original","quote":"然在九甸之外〖27〗，长吏之选，类不精核〖28〗。汉时法宽，多自放恣，故数反，违法。珠崖之废〖29〗，起于长吏睹其好发，髡取为髲〖30〗。及臣所见，南海黄盖为日南太守〖31〗；下车以供设不丰〖32〗，挝杀主簿〖33〗：仍见驱逐〖34〗。九真太守儋萌，为妻父周京作主人〖35〗，并请大吏；酒酣作乐，功曹番歆，起舞属京〖36〗，京不肯起；歆犹迫强，萌忿，杖歆，亡于郡内〖37〗。歆弟苗，帅众攻府；毒矢射萌，萌至物故〖38〗。交阯太守士燮，遣兵致讨，卒不能克。又故刺史会稽朱符，多以乡人虞褒、刘彦之徒，分作长吏；侵虐百姓，强赋于民〖39〗。黄鱼一枚，收稻一斛；百姓怨叛，山贼并出，攻州突郡。符走入海，流离丧亡。次得南阳张津，与荆州牧刘表为隙〖40〗；兵弱敌强，岁岁兴军。诸将厌患，去留自在；津小检摄〖41〗，威武不足；为所陵侮，遂至杀没。后得零陵赖恭〖42〗，先辈仁谨〖43〗，不晓时事。表又遣长沙吴巨，为苍梧太守。巨，武夫轻悍，不为恭服；（所取）〔辄〕相怨恨，逐出恭，求步骘。是时津故将夷廖、钱博之徒尚多，骘以次锄治；纲纪适定〖44〗，会仍召出。吕岱既至，有士氏之变〖45〗。越军南征，平讨之日，改置长吏，彰明王纲〖46〗；威加万里，大小承风。由此言之，绥边抚裔〖47〗，实有其人。","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":169,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":539,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
