f"]}],"participants":[{"person":"wuzhu-p0134","role":"被徙吴城禁锢并禁止子女通婚","evidence":["santizhu059-q-28edd96ac806ac75771f"]}],"place":null,"time":{"label":"原文纪年表达保留，不换算公元年","precision":"undated","basis":"本条不据前后叙事推算公元纪年。","evidence":["santizhu059-q-28edd96ac806ac75771f"]},"ordering_evidence":"santizhu059-q-28edd96ac806ac75771f","source_order":[59,1,26],"order":10499},{"id":"santizhu059-e-sr-fen-confinement","title":"孙奋见疑徙吴城禁锢、不得通婚","accounts":[{"id":"santizhu059-a-c07f444b3db9401f7571","label":"裴注·江表传","text":"《江表传》称奋以张俊事见疑，本在章安，徙还吴城禁锢；使男女不得通婚，或年三十、四十不得嫁娶","evidence":["santizhu059-q-60580ad079f85e2a724f"]}],"participants":[{"person":"wuzhu-p0134","role":"见疑被徙吴城禁锢，子弟不得嫁娶","evidence":["santizhu059-q-60580ad079f85e2a724f"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"未由相邻段落推算纪年；原文时间表达保留在来源引句中。","evidence":["santizhu059-q-60580ad079f85e2a724f"]},"ordering_evidence":"santizhu059-q-60580ad079f85e2a724f","source_order":[59,291,0],"order":10500},{"id":"santizhu059-e-sr-fen-memorial","title":"孙奋上表乞使男女自相配偶","accounts":[{"id":"santizhu059-a-5f3c0d7dc8d0684ccac9","label":"裴注·江表传","text":"奋上表乞自比禽兽，使男女自相配偶","evidence":["santizhu059-q-f4f6e35ca8a49010f750"]}],"participants":[{"person":"wuzhu-p0134","role":"上表乞使男女自相配偶","evidence":["santizhu059-q-f4f6e35ca8a49010f750"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"未由相邻段落推算纪年；原文时间表达保留在来源引句中。","evidence":["santizhu059-q-f4f6e35ca8a49010f750"]},"ordering_evidence":"santizhu059-q-f4f6e35ca8a49010f750","source_order":[59,291,0],"order":10501}],"persons":[{"id":"wuzhu-p0134","name":"孙奋","evidence":["wuzhu-q-o166","dongyuan-q-o078","santizhu-q-85a20b249925141122f2","santizhu-q-631a26905c0b1d46907f","santizhu059-q-98bd156df30ce777afe4","santizhu059-q-bfe3f894c640701c34c9","santizhu059-q-4e5d57fdd0eddad947ca"],"facts":[],"aliases":[],"mentions":[{"id":"wuzhu-m-o166-wuzhu-p0134","kind":"mention","text":"文中提及","evidence":["wuzhu-q-o166"]},{"id":"dongyuan-m-o078-wuzhu-p0134","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o078"]}]}],"evidence":[{"id":"dongyuan-e-o078b-q","section":"chapter-006","block":"b-ee550b31094c2ed0da95","layer":"original","quote":"术女入孙权宫，子燿拜郎中；燿女又配于权子奋。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":427,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":27,"end":49,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-o078","section":"chapter-006","block":"b-ee550b31094c2ed0da95","layer":"original","quote":"妻子依术故吏庐江太守刘勋。孙策破勋，复见收视〖15〗。术女入孙权宫，子燿拜郎中；燿女又配于权子奋。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":427,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":49,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-631a26905c0b1d46907f","section":"chapter-048","block":"b-bda2dc175512d4e3eb3c","layer":"original","quote":"三年〖10〗，会稽妖言：章安侯奋当为天子","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":430,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-85a20b249925141122f2","section":"chapter-048","block":"b-84df1c57eb3bf56b8fc7","layer":"original","quote":"秋七月，封故齐王奋，为章安侯","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":120,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":14,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-1cf1e8dad79270bb9baa","section":"chapter-059","block":"b-8c4de76903d185d8467c","layer":"pei","quote":"奋不受药，叩头千下，曰：‘老臣自将儿子，治生求活，无豫国事：乞丐余年！’皓不听，父子皆饮药死。”","attribution":"裴注·江表传","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":290,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ee9efd39c32bb0fb3022","start":97,"end":145,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-220a3c63ac5b79eea994","section":"chapter-059","block":"b-2f6e2a841e045d0bd02f","layer":"original","quote":"里语曰：“明镜所以照形，古事所以知今。”大王宜深以鲁王为戒，改易其行；战战兢兢，尽敬朝廷：如此则无求不得。若弃忘先帝法教，怀轻慢之心；臣下宁负大王，不敢负先帝遗诏；宁为大王所怨疾，岂敢忘尊主之威，而令诏敕不行于藩臣邪？此古今正义，大王所照知也。夫福来有由，祸来有渐〖16〗；渐生不忧，将不可悔。向使鲁王早纳忠直之言，怀惊惧之虑，享祚无穷，岂有灭亡之祸哉！","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":257,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":177,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-28edd96ac806ac75771f","section":"chapter-059","block":"b-8c4de76903d185d8467c","layer":"pei","quote":"奋以此见疑，本在章安，徙还吴城禁锢；使男女不得通婚，或年三十、四十，不得嫁娶","attribution":"裴注·江表传","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":290,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ee9efd39c32bb0fb3022","start":26,"end":64,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-3c88f50a81701123b662","section":"chapter-059","block":"b-0875ee9c9832eef6032b","layer":"original","quote":"太平三年，封为章安侯。﹝二﹞","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":280,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":14,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-416b6dd7186e12c8da31","section":"chapter-059","block":"b-8c4de76903d185d8467c","layer":"pei","quote":"皓大怒，遣察战赍药，赐奋。","attribution":"裴注·江表传","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":290,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ee9efd39c32bb0fb3022","start":84,"end":97,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-4e5d57fdd0eddad947ca","section":"chapter-059","block":"b-c1e5e083f9f03de57791","layer":"original","quote":"权薨，太傅诸葛恪不欲诸王处江滨兵马之地，徙奋于豫章。奋怒，不从命，又数越法度","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":252,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":29,"end":67,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-60580ad079f85e2a724f","section":"chapter-059","block":"b-8c4de76903d185d8467c","layer":"pei","quote":"奋以此见疑，本在章安，徙还吴城禁锢；使男女不得通婚，或年三十、四十，不得嫁娶。","attribution":"裴注·江表传","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":290,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ee9efd39c32bb0fb3022","start":26,"end":65,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-672a1b552ae04079155e","section":"chapter-059","block":"b-d6255bf0b0f140a1b6ba","layer":"original","quote":"夫良药苦口，惟疾者能甘之〖17〗。忠言逆耳，惟达者能受之。今者恪等\"\"欲为大王除危殆于萌芽，广福庆之基原，是以不自知言至〖18〗：愿蒙三思。","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":258,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":70,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-6a5e67ab0467d55f3351","section":"chapter-059","block":"b-25681587cf11a428fc7c","layer":"original","quote":"昔汉初兴，多王子弟〖5〗；至于太强，辄为不轨。上则几危社稷，下则骨肉相残；其后惩戒，以为大讳。自光武以来，诸王有制：惟得自娱于宫内，不得临民〖6〗，干与政事；其与交通，皆有重禁。遂以全安，各保福祚。此则前世得失之验也。近袁绍、刘表，各有国土〖7〗；土地非狭，人众非弱；以嫡庶不分，遂灭其宗祀。此乃天下愚智所共嗟痛。","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":254,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":157,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-7df838d2ca518af33e56","section":"chapter-059","block":"b-489a65cc34b05f675f6f","layer":"original","quote":"帝王之尊，与天同位；是以家天下〖1〗，臣父兄〖2〗，四海之内，皆为臣妾。仇雠有善〖3〗，不得不举；亲戚有恶，不得不诛。所以承天理物〖4〗，先国后身；盖圣人立制，百代不易之道也。","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":253,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":88,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-845d41d29e50550e56f1","section":"chapter-059","block":"b-e50e19ba472fbfe8c772","layer":"pei","quote":"亮诏曰：‘齐王奋，前坐杀吏，废为庶人。连有赦令，独不见原；纵未宜复王，何以不侯？又诸孙兄弟作将，列在江渚；孤有兄独尔，云何？’有司奏，可。就拜为侯","attribution":"裴注·江表传","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":289,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-166945b20d44db06c139","start":11,"end":84,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-867d190087d6abec3c89","section":"chapter-059","block":"b-cadf9f8a9b27c9a5ef31","layer":"original","quote":"大行皇帝览古戒今〖8〗，防芽遏萌，虑于千载。是以寝疾之日，分遣诸王，各早就国；诏策殷勤，科禁严峻；其所诫敕，无所不至。诚欲上安宗庙，下全诸王；使百世相承，无凶国害家之悔也。大王宜上惟太伯顺父之志〖9〗；中念河间献王、东海王强恭敬之节〖10〗；下当裁抑骄恣荒乱，以为警戒。","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":255,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":135,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-8779bef056e6a1a5687f","section":"chapter-059","block":"b-2aeafece3b7e9e386286","layer":"original","quote":"奋得笺惧，遂移南昌。游猎弥甚，官属不堪命。","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":278,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-9551a485fc0affd313aa","section":"chapter-059","block":"b-e50e19ba472fbfe8c772","layer":"pei","quote":"《江表传》载：“亮诏曰：‘齐王奋，前坐杀吏，废为庶人。连有赦令，独不见原；纵未宜复王，何以不侯？又诸孙兄弟作将，列在江渚；孤有兄独尔，云何？’有司奏，可。就拜为侯。”","attribution":"裴注·江表传","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":289,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-166945b20d44db06c139","start":3,"end":86,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-98bd156df30ce777afe4","section":"chapter-059","block":"b-6a1b4573f911ae578bc1","layer":"original","quote":"诛奋及其五子。国除","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":281,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":109,"end":118,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-9cfa2ed3f1d816d1f783","section":"chapter-059","block":"b-6ad77114817944d32b2d","layer":"original","quote":"及恪诛，奋下住芜湖，欲至建业观变","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":279,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":16,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-bfe3f894c640701c34c9","section":"chapter-059","block":"b-6ad77114817944d32b2d","layer":"original","quote":"及恪诛，奋下住芜湖，欲至建业观变。傅、相谢慈等谏奋，奋杀之。﹝一﹞坐废为庶人，徙章安县。","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":279,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":44,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-c49b54b0ff23adf6e835","section":"chapter-059","block":"b-15a7e7099d9453b9a358","layer":"original","quote":"而闻顷至武昌以来，多违诏敕；不拘制度，擅发诸将兵治护宫室〖11〗。又左右常从有罪过者〖12〗，当以表闻，公付有司；而擅私杀，事不明白。大司马吕岱，亲受先帝诏敕，辅导大王；既不承用其言，令怀忧怖。华锜，先帝近臣，忠良正直，其所陈道〖13〗，当纳用之；而闻怒锜，有“收缚”之语。又中书杨融〖14〗，亲受诏敕，所当恭肃；云：“正自不听禁〖15〗，当如我何？”闻此之日，大小惊怪，莫不寒心。","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":256,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":191,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-cd65b69275ca795f66a8","section":"chapter-059","block":"b-c1e5e083f9f03de57791","layer":"original","quote":"孙奋字子扬，霸弟也。母曰仲姬。太元二年，立为齐王，居武昌。","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":252,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":29,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-f4f6e35ca8a49010f750","section":"chapter-059","block":"b-8c4de76903d185d8467c","layer":"pei","quote":"奋上表‘乞自比禽兽，使男女自相配偶’。","attribution":"裴注·江表传","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":290,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ee9efd39c32bb0fb3022","start":65,"end":84,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-b-20272e7cc5379b3fe346","section":"chapter-004","block":"b-20272e7cc5379b3fe346","layer":"modern","quote":"〖17〗四年：嘉平四年（公元252）。癸卯：旧历初二日。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":230,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-db96ad991a403b6a010e","start":0,"end":28,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o052","section":"chapter-004","block":"b-944c76689fd8a3e8fa86","layer":"original","quote":"四年春正月，癸卯〖17〗，以抚军大将军司马景王为大将军。二月，立皇后张氏〖18〗，大赦。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":210,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":44,"offset_unit":"unicode_code_point"},{"id":"wuzhu-e-o166a-q","section":"chapter-047","block":"b-b62c4eca93eda253f3b0","layer":"original","quote":"二年春正月〖12〗，立故太子和为南阳王，居长沙〖13〗；子奋为齐王，居武昌；子休为琅邪王〖14〗，居虎林〖15〗。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":302,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":57,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o166","section":"chapter-047","block":"b-b62c4eca93eda253f3b0","layer":"original","quote":"二年春正月〖12〗，立故太子和为南阳王，居长沙〖13〗；子奋为齐王，居武昌；子休为琅邪王〖14〗，居虎林〖15〗。二月，大赦，改元为神凤。皇后潘氏薨。诸将吏数诣王表请福，表亡去。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":302,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":89,"offset_unit":"unicode_code_point"}],"profiles":{"wuzhu-p0134":{"fields":[],"directory":{"faction":"wu"}}},"directory_counts":{}}
