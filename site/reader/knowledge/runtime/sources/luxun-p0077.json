95},{"id":"atlas-close-e-wu-surrender","title":"孙皓降晋","order":8903,"accounts":[{"id":"atlas-close-a-wu-surrender","label":"三嗣主传","text":"王濬先到，接受孙皓投降，解缚焚榇，延请相见。","evidence":["atlas-close-q-wu-surrender"]},{"id":"atlas-close-a-wu-letter","label":"三嗣主传","text":"孙皓分遣使者，向王濬、司马伷和王浑奉书请降。","evidence":["atlas-close-q-wu-letter"]},{"id":"major-proof-a-wu-letter","label":"薛莹传","text":"孙皓向司马伷、王浑、王濬奉书请降，文书由薛莹撰写。","evidence":["major-proof-q-wu-letter"]},{"id":"santizhu-a-7952939940cd90c76094","label":"正文","text":"孙皓降晋","evidence":["santizhu-q-e4e74308393a35a22bc8"]},{"id":"santizhu-a-b0fc15dc3f07ec88349d","label":"正文","text":"王濬受孙皓降并延请相见","evidence":["santizhu-q-5e1ac8597c6e78a9cfc7"]},{"id":"zhangyan-a-30658308f87af9745c7e","label":"正文","text":"孙皓奉书于司马伷、王浑、王濬请降，其文薛莹所造","evidence":["zhangyan-q-b86fc7f04034d2681027"]}],"participants":[{"person":"shaodi-p0162","role":"投降","evidence":["atlas-close-q-wu-surrender"]},{"person":"luxun-p0077","role":"接受投降","evidence":["atlas-close-q-wu-surrender"]},{"person":"luxun-p0072","role":"撰写请降书","evidence":["major-proof-q-wu-letter"]},{"person":"santizhu-p0125","role":"提出并被采纳的计策","evidence":["santizhu-q-e4e74308393a35a22bc8"]},{"person":"shaodi-p0130","role":"奉书请命的对象，临近吴境","evidence":["santizhu-q-e4e74308393a35a22bc8"]},{"person":"santizhu-p0119","role":"奉书请命的对象，临近吴境","evidence":["santizhu-q-e4e74308393a35a22bc8"]},{"person":"santizhu-p0124","role":"奉使交付印绶请命","evidence":["santizhu-q-e4e74308393a35a22bc8"]}],"place":null,"time":{"year":280,"precision":"year","label":"天纪四年三月（正文校记作三月壬寅）","chronology":"atlas-close-y280","evidence":["atlas-close-q-wu-year","atlas-close-q-wu-date","atlas-close-q-wu-surrender"],"dating_review":{"reviewed":true,"anchor":"atlas-close-q-wu-year","basis":"四年春以下至降晋为同一年连续叙事，现代注释明示天纪四年为公元280。原文日期校记保留，不推算公历日。"}}},{"id":"santizhu-e-p052a","title":"王濬收取吴国图籍及户口簿籍","accounts":[{"id":"santizhu-a-bd34aaa6c432ea42ae43","label":"裴注·晋阳秋","text":"王濬收取吴国图籍及户口簿籍","evidence":["santizhu-q-aae73f587441ee2df0f1"]}],"participants":[{"person":"luxun-p0077","role":"收取吴国图籍及户口簿籍","evidence":["santizhu-q-aae73f587441ee2df0f1"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["santizhu-q-aae73f587441ee2df0f1"]},"ordering_evidence":"santizhu-q-aae73f587441ee2df0f1","source_order":[48,52,11],"order":8921},{"id":"luxun-e-o082a","title":"王濬晋军顺流伐吴所至克","accounts":[{"id":"luxun-e-o082a-account","label":"《陆逊传第十三》正文","text":"王濬晋军顺流伐吴所至克","evidence":["luxun-e-o082a-q"]}],"participants":[{"person":"luxun-p0077","role":"攻吴","evidence":["luxun-e-o082a-q"]}],"place":null,"time":{"label":"天纪四年","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["luxun-e-o082a-q"]},"ordering_evidence":"luxun-e-o082a-q","source_order":[58,423,"O082a"],"order":10407}],"persons":[{"id":"luxun-p0077","name":"王濬","evidence":["luxun-q-o082","atlas-close-q-wu-surrender","santizhu-q-aae73f587441ee2df0f1","santizhu-q-799b648f266474b6c257","santizhu-q-ccd826574e9281800b55","santizhu-q-e4e74308393a35a22bc8","santizhu-q-5e1ac8597c6e78a9cfc7","zhangyan-q-b86fc7f04034d2681027","zhangyan-q-082f2bc2bca1364edb2a"],"facts":[],"aliases":[],"mentions":[{"id":"luxun-m-o082-luxun-p0077","kind":"mention","text":"文中提及","evidence":["luxun-q-o082"]},{"id":"luxun-m-o083-luxun-p0077","kind":"mention","text":"文中提及","evidence":["luxun-q-o083"]},{"id":"zhangyan-m-1705716ca100cb838f9f","kind":"mention","text":"本篇原文记及王濬，具体行动与称谓见引文。","evidence":["zhangyan-q-082f2bc2bca1364edb2a"]}]}],"evidence":[{"id":"atlas-close-q-wu-date","section":"chapter-048","block":"b-7e623d5c0070fc0c04d7","layer":"modern","quote":"〖1〗四年：天纪四年（公元 280）。","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":529,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ce3554cdfa6d4a10d8dc","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"atlas-close-q-wu-letter","section":"chapter-048","block":"b-494ea68636e86f3566e3","layer":"original","quote":"而王濬顺流将至，司马伷、王浑皆临近境。皓用光禄勋薛莹、中书令胡冲等计〖7〗，分遣使，奉书于濬、伷、浑曰：“昔汉室失统，九州分裂；先人因时，略有江南；遂分阻山川，与魏乖隔。今大晋龙兴，德覆四海；暗劣偷安，未喻天命。至于今者，猥烦六军；衡盖路次〖8〗，远临江渚。举国震惶，假息漏刻〖9〗；敢缘天朝，含弘光大。谨遣私署太常张夔等〖10〗，奉所佩印绶，委质请命。惟垂信纳，以济元元〖11〗。”﹝三﹞","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":523,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":195,"offset_unit":"unicode_code_point"},{"id":"atlas-close-q-wu-surrender","section":"chapter-048","block":"b-c76b27d961ba7e5c15ed","layer":"original","quote":"（壬申）〔三月壬寅〕〖12〗，王濬最先到；于是受皓之降，解缚焚榇〖13〗，延请相见。﹝四﹞","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":524,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":45,"offset_unit":"unicode_code_point"},{"id":"atlas-close-q-wu-year","section":"chapter-048","block":"b-6d9d569aba82d35ae0c8","layer":"original","quote":"四年春〖1〗，立中山、代等十一王〖2〗。大赦。","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":520,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":23,"offset_unit":"unicode_code_point"},{"id":"luxun-e-o082a-q","section":"chapter-058","block":"b-f13f1d1b9942ffae03c9","layer":"original","quote":"天纪四年，晋军伐吴，龙骧将军王濬顺流东下〖22〗；所至辄克，终如抗虑。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":422,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":35,"offset_unit":"unicode_code_point"},{"id":"luxun-q-o082","section":"chapter-058","block":"b-f13f1d1b9942ffae03c9","layer":"original","quote":"天纪四年，晋军伐吴，龙骧将军王濬顺流东下〖22〗；所至辄克，终如抗虑。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":422,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":35,"offset_unit":"unicode_code_point"},{"id":"luxun-q-o083","section":"chapter-058","block":"b-ef5b34254d0aade8edb3","layer":"original","quote":"景字士仁。以尚公主拜骑都尉，封毗陵侯。既领抗兵，拜偏将军，中夏督〖23〗。澡身好学〖24〗，著书数十篇也。﹝一﹞二月壬戌〖25〗，晏为王濬别军所杀；癸亥〖26〗，景亦遇害，时年三十一。景妻，孙皓嫡妹，与景俱张承外孙也〖27〗。﹝二﹞","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":423,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":116,"offset_unit":"unicode_code_point"},{"id":"major-proof-q-wu-letter","section":"chapter-053","block":"b-2039c8cd73aadf4de2e9","layer":"original","quote":"天纪四年，晋军征皓；皓奉书于司马伷、王浑、王濬请降：其文，莹所造也。","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":334,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":44,"end":78,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-5e1ac8597c6e78a9cfc7","section":"chapter-048","block":"b-c76b27d961ba7e5c15ed","layer":"original","quote":"（壬申）〔三月壬寅〕〖12〗，王濬最先到；于是受皓之降，解缚焚榇〖13〗，延请相见","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":524,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":41,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-799b648f266474b6c257","section":"chapter-048","block":"b-bd2df9b2ac026100f1ff","layer":"original","quote":"冬，晋命镇东大将军司马伷向涂中〖23〗；安东将军王浑、扬州刺史周浚向牛渚〖24〗；建威将军王戎向武昌〖25〗；平南将军胡奋向夏口〖26〗；镇南〔大〕将军杜预向江陵〖27〗；龙骧将军王濬、广武将军唐彬浮江东下〖28〗；太尉贾充为大都督〖29〗，量宜处要，尽军势之中〖30〗","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":477,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":135,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-aae73f587441ee2df0f1","section":"chapter-048","block":"b-b94f9ea1ddef3dc423bf","layer":"pei","quote":"濬收其图籍：领州四，郡四十三，县三百一十三；户五十二万三千，吏三万二千，兵二十三万，男女口二百三十万；米谷二百八十万斛；舟船五千余艘；后宫五千余人","attribution":"裴注·晋阳秋","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":554,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-16d7845cfeaa30634ea5","start":11,"end":84,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-ccd826574e9281800b55","section":"chapter-048","block":"b-45c0aa4ad8cd7d95dfdc","layer":"original","quote":"濬、彬所至，则土崩瓦解，靡有御者","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":521,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":16,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-e4e74308393a35a22bc8","section":"chapter-048","block":"b-494ea68636e86f3566e3","layer":"original","quote":"而王濬顺流将至，司马伷、王浑皆临近境。皓用光禄勋薛莹、中书令胡冲等计〖7〗，分遣使，奉书于濬、伷、浑曰：“昔汉室失统，九州分裂；先人因时，略有江南；遂分阻山川，与魏乖隔。今大晋龙兴，德覆四海；暗劣偷安，未喻天命。至于今者，猥烦六军；衡盖路次〖8〗，远临江渚。举国震惶，假息漏刻〖9〗；敢缘天朝，含弘光大。谨遣私署太常张夔等〖10〗，奉所佩印绶，委质请命","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":523,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":176,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-082f2bc2bca1364edb2a","section":"chapter-053","block":"b-2039c8cd73aadf4de2e9","layer":"original","quote":"是时法政多谬，举措烦苛；莹每上便宜〖20〗，陈缓刑简役，以济育百姓：事或施行。迁光禄勋。天纪四年，晋军征皓；皓奉书于司马伷、王浑、王濬请降：其文，莹所造也。","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":334,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":78,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-b86fc7f04034d2681027","section":"chapter-053","block":"b-2039c8cd73aadf4de2e9","layer":"original","quote":"皓奉书于司马伷、王浑、王濬请降：其文，莹所造也","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":334,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":54,"end":77,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
