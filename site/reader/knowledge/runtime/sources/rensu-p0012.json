"hechang-q-7ddfc3222e75f72d017b"]}],"participants":[{"person":"rensu-p0012","role":"不哭应举","evidence":["hechang-q-7ddfc3222e75f72d017b"]},{"person":"wudi-p0181","role":"举荐","evidence":["hechang-q-7ddfc3222e75f72d017b"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["hechang-q-7ddfc3222e75f72d017b"]},"ordering_evidence":"hechang-q-7ddfc3222e75f72d017b","order":4717}],"persons":[{"id":"rensu-p0012","name":"吉茂","evidence":["rensu-q-d4b09d9c2fc83d0acf97","rensu-q-46c5f85998356161ccc0","rensu-q2-fc181b19963b274be4e5","hechang-q-1cfeacccbda87a7ad874","hechang-q-779a6dfb14b33d0ab3a4","hechang-q-8600696f7c2ce39c389e","hechang-q-8fa1183ada5283e79c65","hechang-q-7ddfc3222e75f72d017b","hechang-q-5bf73294b6afabee4367","hechang-q-63c0a2f82973f62fb296","hechang-q-e103b4fc20e3e0552c94","hechang-q-26458dcd3722d8ac77f4"],"facts":[{"id":"rensu-f2-63687364cb8c2c2ee06c","text":"《魏略》记曾为县令，转为冗散官。","evidence":["rensu-q2-fc181b19963b274be4e5"]},{"id":"hechang-f-1877236a56d0058301d8","text":"字叔畅，冯翊池阳人。","evidence":["hechang-q-26458dcd3722d8ac77f4"]}],"aliases":[],"mentions":[]}],"evidence":[{"id":"hechang-q-1cfeacccbda87a7ad874","section":"chapter-023","block":"b-54d09d04dcf5541f28c7","layer":"pei","quote":"建安初，关中始平，茂与扶风苏则，共入武功南山，隐处精思。","attribution":"裴注·魏略","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":141,"anchor":null},"note_id":"n-49639b91fe1a19fa430b","start":37,"end":65},{"id":"hechang-q-26458dcd3722d8ac77f4","section":"chapter-023","block":"b-54d09d04dcf5541f28c7","layer":"pei","quote":"“吉茂字叔畅，冯翊池阳人也。世为著姓。好书，不耻恶衣恶食，而耻一物之不知。建安初，关中始平，茂与扶风苏则，共入武功南山，隐处精思。数岁，州举茂才，除临汾令。居官清静，吏民不忍欺。转为武德侯庶子。二十二年，坐其宗人吉本等起事，被收。先是，科禁内学及兵书，而茂皆有，匿不送官。及其被收，不知当坐本等，顾谓其左右曰：‘我坐书也。’会钟相国证茂，本服第已绝，故得不坐。后以茂为武陵太守，不之官。转酂相；以国省，拜议郎。景初中病亡。自茂修行，从少至长；冬则被裘，夏则裋褐；行则步涉，食则茨藿；臣役妻子，室如悬磬；其或馈遗，一不肯受。虽不以此高人，亦心疾不义而贵且富者。先时国家始制九品，各使诸郡选置中正；差叙自公卿以下，至于郎吏，功德才行所任。茂同郡护羌校尉王琰，前数为郡守，不名为清白。而琰子嘉仕历诸县，亦复为通人。嘉时还为散骑郎，冯翊郡移嘉为中正。嘉叙茂虽在上第，而状甚下，云：‘德优能少。’茂愠曰：‘痛乎，我效汝父子冠帻劫人邪！’初，茂同产兄黄，以十二年中，从公府掾为长陵令。是时，科禁长吏擅去官，而黄闻司徒赵温薨；自以为故吏，违科奔丧；为司隶钟繇所收，遂伏法。茂时为白衣，始有清名于三辅；以为兄坐追义而死，怨怒不肯哭。至岁终，繇举茂，议者以为茂必不就；及举既到，而茂就之。故时人或以茂为畏繇，或以茂为髦士也。”","attribution":"裴注（引书见原文，待主审复核）","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":141,"anchor":null},"note_id":"n-49639b91fe1a19fa430b","start":0,"end":554},{"id":"hechang-q-5bf73294b6afabee4367","section":"chapter-023","block":"b-54d09d04dcf5541f28c7","layer":"pei","quote":"后以茂为武陵太守，不之官。","attribution":"裴注·魏略","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":141,"anchor":null},"note_id":"n-49639b91fe1a19fa430b","start":180,"end":193},{"id":"hechang-q-63c0a2f82973f62fb296","section":"chapter-023","block":"b-54d09d04dcf5541f28c7","layer":"pei","quote":"转酂相；以国省，拜议郎。","attribution":"裴注·魏略","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":141,"anchor":null},"note_id":"n-49639b91fe1a19fa430b","start":193,"end":205},{"id":"hechang-q-779a6dfb14b33d0ab3a4","section":"chapter-023","block":"b-54d09d04dcf5541f28c7","layer":"pei","quote":"数岁，州举茂才，除临汾令。居官清静，吏民不忍欺。转为武德侯庶子。","attribution":"裴注·魏略","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":141,"anchor":null},"note_id":"n-49639b91fe1a19fa430b","start":65,"end":97},{"id":"hechang-q-7ddfc3222e75f72d017b","section":"chapter-023","block":"b-54d09d04dcf5541f28c7","layer":"pei","quote":"茂时为白衣，始有清名于三辅；以为兄坐追义而死，怨怒不肯哭。至岁终，繇举茂，议者以为茂必不就；及举既到，而茂就之。故时人或以茂为畏繇，或以茂为髦士也。","attribution":"裴注·魏略","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":141,"anchor":null},"note_id":"n-49639b91fe1a19fa430b","start":479,"end":553},{"id":"hechang-q-8600696f7c2ce39c389e","section":"chapter-023","block":"b-54d09d04dcf5541f28c7","layer":"pei","quote":"二十二年，坐其宗人吉本等起事，被收。先是，科禁内学及兵书，而茂皆有，匿不送官。及其被收，不知当坐本等，顾谓其左右曰：‘我坐书也。’会钟相国证茂，本服第已绝，故得不坐。","attribution":"裴注·魏略","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":141,"anchor":null},"note_id":"n-49639b91fe1a19fa430b","start":97,"end":180},{"id":"hechang-q-8fa1183ada5283e79c65","section":"chapter-023","block":"b-54d09d04dcf5541f28c7","layer":"pei","quote":"先时国家始制九品，各使诸郡选置中正；差叙自公卿以下，至于郎吏，功德才行所任。茂同郡护羌校尉王琰，前数为郡守，不名为清白。而琰子嘉仕历诸县，亦复为通人。嘉时还为散骑郎，冯翊郡移嘉为中正。嘉叙茂虽在上第，而状甚下，云：‘德优能少。’茂愠曰：‘痛乎，我效汝父子冠帻劫人邪！","attribution":"裴注·魏略","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":141,"anchor":null},"note_id":"n-49639b91fe1a19fa430b","start":279,"end":412},{"id":"hechang-q-e103b4fc20e3e0552c94","section":"chapter-023","block":"b-54d09d04dcf5541f28c7","layer":"pei","quote":"景初中病亡。","attribution":"裴注·魏略","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":141,"anchor":null},"note_id":"n-49639b91fe1a19fa430b","start":205,"end":211},{"id":"rensu-q-210e9e7ca02278136a53","section":"chapter-016","block":"b-cd1041adcf23a3bcd4a8","layer":"pei","quote":"依富室师亮，亮待遇不足。则慨然叹曰：‘天下会安，当不久尔；必还为此郡守，折庸辈士也","attribution":"裴注·魏略","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":28,"anchor":null},"note_id":"n-fc1c6feb90f952a33627","start":34,"end":75},{"id":"rensu-q-45220e2bb3ce4cdf4def","section":"chapter-016","block":"b-cd1041adcf23a3bcd4a8","layer":"pei","quote":"兴平中，三辅乱，饥穷，避难北地，客安定","attribution":"裴注·魏略","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":28,"anchor":null},"note_id":"n-fc1c6feb90f952a33627","start":14,"end":33},{"id":"rensu-q-46c5f85998356161ccc0","section":"chapter-016","block":"b-23eae612c68e3680cbc2","layer":"pei","quote":"茂见则，嘲之曰：‘仕进不止执虎子。’则笑曰：‘我诚不能效汝蹇蹇驱鹿车驰也","attribution":"裴注·魏略","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":63,"anchor":null},"note_id":"n-b3d9fc43ce74807195cf","start":53,"end":89},{"id":"rensu-q-953bb7cdbb4364f331ef","section":"chapter-016","block":"b-cd1041adcf23a3bcd4a8","layer":"pei","quote":"及为安定太守，而师亮等皆欲逃走。则闻之，预使人解语，以礼报之","attribution":"裴注·魏略","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":28,"anchor":null},"note_id":"n-fc1c6feb90f952a33627","start":100,"end":130},{"id":"rensu-q-d4b09d9c2fc83d0acf97","section":"chapter-016","block":"b-cd1041adcf23a3bcd4a8","layer":"pei","quote":"后与冯翊吉茂等，隐于郡南太白山中，以书籍自娱","attribution":"裴注·魏略","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":28,"anchor":null},"note_id":"n-fc1c6feb90f952a33627","start":77,"end":99},{"id":"rensu-q2-fc181b19963b274be4e5","section":"chapter-016","block":"b-23eae612c68e3680cbc2","layer":"pei","quote":"﹝三﹞《魏略》曰：“旧仪：侍中，亲省起居；故俗谓之‘执虎子’。始，则同郡吉茂者，是时仕甫历县令，迁为冗散。茂见则，嘲之曰：‘仕进不止执虎子。’则笑曰：‘我诚不能效汝蹇蹇驱鹿车驰也！’初，则在金城，闻汉帝禅位，以为崩也，乃发丧。后闻其在，自以不审，意颇默然。临淄侯植自伤失先帝意，亦怨激而哭。其后文帝出游，追恨临淄，顾谓左右曰：‘人心不同；当我登大位之时，天下有哭者。’时从臣知帝此言，有为而发也；而则以为为己，欲下马谢。侍中傅巽目之，乃悟。”","attribution":"裴注·魏略","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":63,"anchor":null},"note_id":"n-b3d9fc43ce74807195cf","start":0,"end":221}],"profiles":{},"directory_counts":{}}
