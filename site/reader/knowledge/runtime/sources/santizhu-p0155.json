e0a2194ed2268ca75","feipin-q-16995cb82d7e7b8aafcf","feipin-q-1cdae0d5c4836b184bbf","feipin-q-b3c72006c6b36047c850"],"facts":[{"id":"feipin-f-c625349dbd8fb682931e","text":"字：小虎","evidence":["feipin-q-b3c72006c6b36047c850"]}],"aliases":[],"mentions":[]}],"evidence":[{"id":"feipin-q-16995cb82d7e7b8aafcf","section":"chapter-050","block":"b-8fc6f7166b988660dd9a","layer":"pei","quote":"﹝二﹞《搜神记》曰：“孙峻杀朱主，埋于石子冈。归命即位，将欲改葬之；冢墓相亚，不可识别。而宫人颇识主亡时所著衣服，乃使两巫各住一处以伺其灵；使（察鉴）〔察战监之〕，不得相近。久时，二人俱白：见一女人，年可三十余，上著青锦束头，紫白袷裳，丹绨丝履；从石子冈上，半冈而以手抑膝，长太息；小住须臾，进一冢上便住；徘徊良久，奄然不见。二人之言，不谋而同；于是开冢，衣服如之。”","attribution":"裴注·搜神记","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":136,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-07a4632007338c4f1431","start":0,"end":184,"offset_unit":"unicode_code_point"},{"id":"feipin-q-1cdae0d5c4836b184bbf","section":"chapter-050","block":"b-d2dc14d313c8506f172c","layer":"original","quote":"少曰鲁育，字小虎；前配朱据〖3〗，后配刘纂。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":63,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":89,"end":111,"offset_unit":"unicode_code_point"},{"id":"feipin-q-52e38e9eebfd05889d5c","section":"chapter-050","block":"b-8b87611dfa211c2910fe","layer":"original","quote":"初，孙和为太子时，全主谮害王夫人，欲废太子，立鲁王；朱主不听，由是有隙。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":123,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":36,"offset_unit":"unicode_code_point"},{"id":"feipin-q-5f7e0a2194ed2268ca75","section":"chapter-050","block":"b-9eb668cd4ac82ec1fb10","layer":"pei","quote":"﹝一﹞《吴历》曰：纂先尚权中女，早卒，故又以小虎为继室。","attribution":"裴注·吴历","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":84,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fbd0b36c72c396f00e6c","start":0,"end":28,"offset_unit":"unicode_code_point"},{"id":"feipin-q-a09d9b3ab1d0a2333bf1","section":"chapter-050","block":"b-8b87611dfa211c2910fe","layer":"original","quote":"五凤中，孙仪谋杀峻，事觉被诛。全主因言朱主与仪同谋，峻枉杀朱主。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":123,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":36,"end":68,"offset_unit":"unicode_code_point"},{"id":"feipin-q-b3c72006c6b36047c850","section":"chapter-050","block":"b-d2dc14d313c8506f172c","layer":"original","quote":"少曰鲁育，字小虎","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":63,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":89,"end":97,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-f61f5c951ead6ecb01d4","section":"chapter-048","block":"b-08113f5ec29645bebbf2","layer":"original","quote":"秋七月，将军孙仪、张怡、林恂等，谋杀峻","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":54,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-e34662ebfb107f69038c","section":"chapter-064","block":"b-7db1c56fe27fe66e5fed","layer":"original","quote":"是岁，蜀使来聘，将军孙仪、（孙邵綝恂）〔张怡、林恂〕等欲因会杀峻。事泄，仪等自杀，死者数十人，并及公主鲁育","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":391,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":53,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
