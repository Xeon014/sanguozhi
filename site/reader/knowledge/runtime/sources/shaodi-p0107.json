ence":"santizhu-q-56c460bc3b472dcdd307","source_order":[48,63,46],"order":8652}],"persons":[{"id":"shaodi-p0107","name":"陈骞","evidence":["shaodi-q-o119","wgc-q0028","huanchen-q-085e4594049ec7baaebb","huanchen-q-a2bbfc82c7d1e23f74a3","huowang-q-33b9ffeac78904365a48","huowang-q-2cd802a9b0c851c8cdb5"],"facts":[],"aliases":[],"mentions":[{"id":"shaodi-m-o119-shaodi-p0107","kind":"mention","text":"文中提及","evidence":["shaodi-q-o119"]},{"id":"shaodi-m-o191-shaodi-p0107","kind":"mention","text":"文中提及","evidence":["shaodi-q-o191"]},{"id":"wgc-m-o035-shaodi-p0107","kind":"mention","text":"本段涉及陈骞","evidence":["wgc-q0028"]}]}],"evidence":[{"id":"huanchen-q-085e4594049ec7baaebb","section":"chapter-022","block":"b-36911014e2aba4efaef8","layer":"original","quote":"薨，子粲嗣。本弟骞〖6〗，咸熙中为车骑将军〖7〗。","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":365,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":25,"offset_unit":"unicode_code_point"},{"id":"huanchen-q-a2bbfc82c7d1e23f74a3","section":"chapter-022","block":"b-b81bfbf76058f3460286","layer":"pei","quote":"刘晔以先进见幸，因谮矫专权。矫惧，以问长子本，本不知所出。次子骞曰：‘主上明圣，大人大臣；今若不合，不过不作公耳。’后数日，帝见矫；矫又问二子。骞曰：‘陛下意解，故见大人也。’既入，尽日。帝曰：‘刘晔构君，朕有以迹君；朕心故已了。’以金五1 授之，矫辞。帝曰：‘岂以为小惠？君已知朕心，顾君妻子未知故也","attribution":"裴注·《世语》","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":362,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6ec4238f909f9a25cd48","start":10,"end":161,"offset_unit":"unicode_code_point"},{"id":"huanchen-q-a43d399dccbc32a4b144","section":"chapter-022","block":"b-cc10d81a0825ac1ea7dc","layer":"original","quote":"诸葛诞作乱寿春〖13〗，司马文王率六军军丘头〖14〗","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":283,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":65,"end":91,"offset_unit":"unicode_code_point"},{"id":"huowang-q-2cd802a9b0c851c8cdb5","section":"chapter-041","block":"b-4dcb6200f55cc020b124","layer":"pei","quote":"陈骞言于晋王，遣荆州刺史胡烈救宪，抗等引退","attribution":"裴注·襄阳记","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":25,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c480ade0f0913bd6d1da","start":481,"end":502,"offset_unit":"unicode_code_point"},{"id":"huowang-q-33b9ffeac78904365a48","section":"chapter-041","block":"b-4dcb6200f55cc020b124","layer":"pei","quote":"宪临江拒射，不能御；遣参军杨宗，突围北出，告急安东将军陈骞；又送文武印绶、任子，诣晋王","attribution":"裴注·襄阳记","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":25,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c480ade0f0913bd6d1da","start":339,"end":382,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-56c460bc3b472dcdd307","section":"chapter-048","block":"b-25a289c0c24062b2e434","layer":"original","quote":"魏使将军胡烈，步骑二万侵西陵〖7〗，以救罗宪","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":284,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":46,"end":68,"offset_unit":"unicode_code_point"},{"id":"shaodi-e-o119a-q","section":"chapter-004","block":"b-664faf315e1d49a284ae","layer":"original","quote":"五月，辛未〖7〗，帝幸辟雍。会，命群臣赋诗。侍中和逌、尚书陈骞等作诗稽留〖8〗，有司奏免官。诏曰：“吾以暗昧，爱好文雅。广延诗赋，以知得失。而乃尔纷纭〖9〗，良用反仄〖10〗。其原逌等，主者宣敕：自今以后，群臣皆当玩习古义，修明经典。称朕意焉。”","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":524,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":123,"offset_unit":"unicode_code_point"},{"id":"shaodi-e-o191c-q","section":"chapter-004","block":"b-a7b192a40422b556c612","layer":"original","quote":"九月，乙未〖23〗，大赦。戊午〖24〗，司徒何曾为晋丞相。癸亥〖25〗，以骠骑将军司马望为司徒，征东大将军石苞为骠骑将军〖26〗，征南大将军陈骞为车骑将军。乙亥〖27〗，葬晋文王。闰月，庚辰〖28〗，康居、大宛献名马〖29〗；归于相国府，以显怀万国致远之勋。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":341,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":129,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-b-6209c552405e0ebbdf98","section":"chapter-004","block":"b-6209c552405e0ebbdf98","layer":"modern","quote":"〖1〗二年：甘露二年（公元 257 ）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":535,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4dd98e402a6a8de51491","start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-b-ded6d700dc6f860d1670","section":"chapter-004","block":"b-ded6d700dc6f860d1670","layer":"modern","quote":"〖1〗四年：景元四年（公元 263）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":201,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ef642248e44d01f3825d","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o117","section":"chapter-004","block":"b-d021e0b00f489a01f208","layer":"original","quote":"二年春二月〖1〗，青龙现温县井中。三月，司空卢毓薨。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":522,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":26,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o119","section":"chapter-004","block":"b-664faf315e1d49a284ae","layer":"original","quote":"五月，辛未〖7〗，帝幸辟雍。会，命群臣赋诗。侍中和逌、尚书陈骞等作诗稽留〖8〗，有司奏免官。诏曰：“吾以暗昧，爱好文雅。广延诗赋，以知得失。而乃尔纷纭〖9〗，良用反仄〖10〗。其原逌等，主者宣敕：自今以后，群臣皆当玩习古义，修明经典。称朕意焉。”","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":524,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":123,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o165","section":"chapter-004","block":"b-b35fdf03685051716720","layer":"original","quote":"四年春二月〖1〗，复命大将军进位、爵赐，一如前诏。又固辞，乃止。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":194,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":32,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o171","section":"chapter-004","block":"b-cef469d41ec5962b4e48","layer":"original","quote":"咸熙元年春正月，壬戌〖1〗，槛车征邓艾〖2〗。甲子〖3〗，行幸长安。壬申〖4〗，使使者以璧币祀华山〖5〗。是月，钟会反于蜀，为众所讨。邓艾亦见杀。二月，辛卯〖6〗，特赦诸在益土者。庚申〖7〗，葬明元郭后。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":220,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":102,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o184","section":"chapter-004","block":"b-1096c71775017a1a0d00","layer":"original","quote":"二年春二月，甲辰〖1〗，朐顗县获灵龟以献〖2〗，归之于相国府。庚戌〖3〗，以虎贲张修，昔于成都驰马至诸营，言钟会反逆，以至没身；赐修弟倚，爵关内侯。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":334,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":74,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o191","section":"chapter-004","block":"b-a7b192a40422b556c612","layer":"original","quote":"九月，乙未〖23〗，大赦。戊午〖24〗，司徒何曾为晋丞相。癸亥〖25〗，以骠骑将军司马望为司徒，征东大将军石苞为骠骑将军〖26〗，征南大将军陈骞为车骑将军。乙亥〖27〗，葬晋文王。闰月，庚辰〖28〗，康居、大宛献名马〖29〗；归于相国府，以显怀万国致远之勋。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":341,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":129,"offset_unit":"unicode_code_point"},{"id":"wgc-q0028","section":"chapter-028","block":"b-c135ec113c597ad4f2da","layer":"original","quote":"六月，车驾东征，至项。大将军司马文王督中外诸军二十六万众，临淮讨之。大将军屯丘头，使基及安东将军陈骞等四面合围，表里再重〖9〗，堑垒甚峻。又使监军石苞、兖州刺史州泰等〖10〗，简锐卒为游军〖11〗，备外寇。钦等数出犯围〖12〗，逆击走之。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":175,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":119,"offset_unit":"unicode_code_point"},{"id":"wgc-q0281","section":"chapter-028","block":"b-c135ec113c597ad4f2da","layer":"original","quote":"大将军屯丘头，使基及安东将军陈骞等四面合围，表里再重〖9〗，堑垒甚峻","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":175,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":34,"end":68,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-0a36f993281a315758d8","section":"chapter-027","block":"b-71ebf1201b1cb1b1419e","layer":"original","quote":"时大军在项，以贼兵精，诏基敛军坚垒。基累启求进讨。会吴遣朱异来救诞〖1〗，军于安城〖2〗。基又被诏引诸军转据北山〖3〗。基谓诸将曰：“今围垒转固，兵马向集，但当精修守备以待越逸；而更移兵守险，使得放纵：虽有智者不能善〔其〕后矣。”遂守便宜上疏曰〖4〗：“今与贼家对敌，当不动如山。若迁移依险，人心摇荡，于势大损。诸军并据深沟高垒，众心皆定，不可倾动。此御兵之要也。”书奏，报听。大将军司马文王进屯丘头，分部围守，各有所统；基督城东、城南二十六军。文王敕军吏：“入镇南部界〖5〗，一不得有所遣〖6〗。”城中食尽，昼夜攻垒；基辄拒击，破之。","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":336,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":24,"end":292,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-6ba1d4f27600ec5d9bfd","section":"chapter-027","block":"b-4abb07ca0728157daafa","layer":"original","quote":"寿春既拔，文王与基书曰：“初议者云云，求移者甚众；时未临履〖7〗，亦谓宜然。将军深算利害，独秉固志；上违诏命，下拒众议，终至制敌擒贼：虽古人所述，不是过也。”","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":337,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":79,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
