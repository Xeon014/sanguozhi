:null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":68,"end":90,"offset_unit":"unicode_code_point"},{"id":"duzhou-q-b3635625c00eec8477d1","section":"chapter-042","block":"b-2e8751fed14f027b2f19","layer":"original","quote":"亮卒后，还成都，为大长秋，又免","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":172,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":38,"end":53,"offset_unit":"unicode_code_point"},{"id":"duzhou-q-bc13e910354d0f9d1db6","section":"chapter-042","block":"b-2e8751fed14f027b2f19","layer":"original","quote":"丞相亮住汉中，请为军祭酒、辅军将军；坐事去职","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":172,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":12,"end":34,"offset_unit":"unicode_code_point"},{"id":"duzhou-q-c3325eb2328c1b2cc18b","section":"chapter-042","block":"b-d82de0179c655607e71c","layer":"original","quote":"好公羊《春秋》而讥呵左氏〖3〗；每与来敏争此二义〖4〗，光常譊譊讙咋","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":129,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":26,"end":60,"offset_unit":"unicode_code_point"},{"id":"duzhou-q-c3a4dd8df56d857c2f4c","section":"chapter-042","block":"b-688b4ed9b53d4342710d","layer":"original","quote":"先主定益州，署敏典学校尉","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":171,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":12,"offset_unit":"unicode_code_point"},{"id":"duzhou-q-e01eb75c730afecbb496","section":"chapter-042","block":"b-c50e18738e0ca7813a82","layer":"original","quote":"故璋遣迎琬妻；敏遂俱与姊入蜀，常为璋宾客","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":170,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":62,"end":82,"offset_unit":"unicode_code_point"},{"id":"duzhou-q-fe374a6f80b15ac662b6","section":"chapter-042","block":"b-77725cf91416f4c179ec","layer":"original","quote":"年九十七，景耀中卒","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":174,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":9,"offset_unit":"unicode_code_point"},{"id":"duzhou-q2-6cb9d477bf685354ef05","section":"chapter-042","block":"b-c50e18738e0ca7813a82","layer":"original","quote":"来敏字敬达，义阳新野人。来歙之后也〖1〗。父艳〖2〗，为汉司空。﹝一﹞汉末大乱，敏随姊（夫）奔荆州。姊夫黄琬是刘璋祖母之侄，故璋遣迎琬妻；敏遂俱与姊入蜀，常为璋宾客。涉猎书籍，善左氏《春秋》〖3〗，尤精于《仓》、《雅》训诂〖4〗，好是正文字〖5〗。","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":170,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":124,"offset_unit":"unicode_code_point"},{"id":"jfj-q0111","section":"chapter-044","block":"b-4d3778d5046d857a6113","layer":"original","quote":"延熙七年，魏军次于兴势〖19〗；假祎节，率众往御之。光禄大夫来敏至祎许别〖20〗，求共围棋。于时羽檄交驰，人马擐甲〖21〗，严驾已讫〖22〗；祎与敏留意对戏，色无厌倦。敏曰：“向聊观试君耳〖23〗！君信可人〖24〗，必能办贼者也〖25〗。”祎至，敌遂退，封成乡侯。﹝五﹞琬固让州职，祎复领益州刺史。祎当国功名，略与琬比。﹝六﹞","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":112,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":163,"offset_unit":"unicode_code_point"},{"id":"jfj-q0112","section":"chapter-044","block":"b-4d3778d5046d857a6113","layer":"original","quote":"光禄大夫来敏至祎许别〖20〗，求共围棋。于时羽檄交驰，人马擐甲〖21〗，严驾已讫〖22〗；祎与敏留意对戏，色无厌倦。敏曰：“向聊观试君耳〖23〗！君信可人〖24〗，必能办贼者也","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":112,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":26,"end":114,"offset_unit":"unicode_code_point"}],"profiles":{"jfj-p0012":{"fields":[],"directory":{"faction":"shu"}}},"directory_counts":{}}
