37.xhtml","index":17,"anchor":null},"note_id":"n-60f466d9d92c616eb2c9","start":111,"end":147},{"id":"rensu-q-8cce79dcc70862fa26e7","section":"chapter-016","block":"b-f7bf4f39640b854492a0","layer":"pei","quote":"孤不知所从，使与荀令君议之","attribution":"裴注·魏武故事","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":17,"anchor":null},"note_id":"n-60f466d9d92c616eb2c9","start":207,"end":220},{"id":"rensu-q-a023a92ed4ca3239e318","section":"chapter-016","block":"b-f7bf4f39640b854492a0","layer":"pei","quote":"祗犹自信，据计画还白，执分田之术","attribution":"裴注·魏武故事","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":17,"anchor":null},"note_id":"n-60f466d9d92c616eb2c9","start":266,"end":282},{"id":"rensu-q-c7c7db2c71c7099618b5","section":"chapter-016","block":"b-f7bf4f39640b854492a0","layer":"pei","quote":"孤乃然之，使为屯田都尉，施设田业。其时，岁则大收，后遂因此大田，丰足军用","attribution":"裴注·魏武故事","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":17,"anchor":null},"note_id":"n-60f466d9d92c616eb2c9","start":283,"end":319},{"id":"rensu-q-dc1d182c299189b9db4f","section":"chapter-016","block":"b-f7bf4f39640b854492a0","layer":"pei","quote":"施行后，祗白以为：‘僦牛输谷，大收不增谷，有水旱灾除，大不便。’反覆来说，孤犹以为当如故，大收，不可复改易","attribution":"裴注·魏武故事","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":17,"anchor":null},"note_id":"n-60f466d9d92c616eb2c9","start":148,"end":201},{"id":"rensu-q-eb157a835335512305f2","section":"chapter-016","block":"b-e04a88325a01db0dc84a","layer":"original","quote":"是时岁饥旱，军食不足；羽林监颍川枣祗，建置屯田","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":3,"anchor":null},"note_id":null,"start":0,"end":23},{"id":"wudi-e-o047a-q","section":"chapter-001","block":"b-bbb49ee5ce4b090e1111","layer":"original","quote":"是岁，用枣祗、韩浩等议〖5〗，始兴屯田〖6〗。﹝一﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":284,"anchor":null},"note_id":null,"start":0,"end":26},{"id":"wudi-e-p112a-q","section":"chapter-001","block":"b-9536581b8deb5e7104e4","layer":"pei","quote":"《魏书》载：“公令曰：‘夫受九锡，广开土宇，周公其人也。汉之异姓八王者，与高祖俱起布衣，创定王业，其功至大。吾何可比之？’前后三让。于是中军师、陵树亭侯荀攸，前军师、东武亭侯钟繇，左军师凉茂，右军师毛玠，平虏将军、华乡侯刘勋，建武将军、清苑亭侯刘若，伏波将军、高安侯夏侯惇，扬武将军、都亭侯王忠，奋威将军、乐乡侯（刘）〔邓〕展，建忠将军、昌乡亭侯鲜于辅，奋武将军、安国亭侯程昱，太中大夫、都乡侯贾诩，军师祭酒、千秋亭侯董昭，都亭侯薛洪，南乡亭侯董蒙，关内侯王粲、傅巽，祭酒王选、袁涣、王朗、张承、任藩、杜袭，中护军、国明亭侯曹洪，中领军、万岁亭侯韩浩，行骁骑将军、安平亭侯曹仁，领护军将军王图，长史万潜、谢奂、袁霸等，劝进曰：‘自古三代，胙臣以土；受命中兴，封秩辅佐。皆所以褒功赏德，为国藩卫也。往者天下崩乱，群凶豪起；颠越跋扈之险，不可忍言。明公奋身出命以徇其难，诛二袁篡盗之逆，灭黄巾贼乱之类，殄夷首逆，芟拨荒秽，沐浴霜露二十余年。书契以来，未有若此功者。昔周公承文、武之迹，受已成之业，高枕墨笔，拱揖群后，商、奄之勤，不过二年；吕望因三分有二之形，据八百诸侯之势，暂把旄钺，一时指麾：然皆大启土宇，跨州兼国。周公八子，并为侯伯：白牡骍刚，郊祀天地；典策备物，拟则王室。荣章宠盛如此之弘也。逮至汉兴，佐命之臣张耳、吴芮，其功至薄，亦连城开地，南面称孤。此皆明君达主行之于上，贤臣圣宰受之于下；三代令典，汉帝明制。今比劳则周、吕逸，计功则张、吴微，论制则齐、鲁重，言地则长沙多；然则魏国之封，九锡之荣，况于旧赏，犹怀玉而被褐也。且列侯、诸将，幸攀龙骥，得窃微劳，佩紫怀黄，盖以百数，亦将因此传之万世。而明公独辞赏于上，将使其下怀不自安。上违圣朝欢心，下失冠带至望；忘辅弼之大业，信匹夫之细行。攸等所大惧也！’于是公敕外为章，但受魏郡。攸等复曰：‘伏见魏国初封，圣朝发虑，稽谋群僚，然后策命；而明公久违上指，不即大礼。今既虔奉诏命，副顺众望；又欲辞多当少，让九受一。是犹汉朝之赏不行，而攸等之请未许也。昔齐、鲁之封，奄有东海；疆域井赋，四百万家；基隆业广，易以立功；故能成翼戴之勋，立一匡之绩。今魏国虽有十郡之名，犹减于曲阜；计其户数，不能参半：以藩卫王室，立垣树屏，犹未足也。且圣上览亡秦无辅之祸，惩曩日震荡之艰；托建忠贤，废坠是为。愿明公恭承帝命，无或拒违。’公乃受命。”","attribution":"《魏书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":262,"anchor":null},"note_id":"n-97e94061646080072adf","start":0,"end":988},{"id":"wudi-q-b-16a5462151b1cfe5142d","section":"chapter-001","block":"b-16a5462151b1cfe5142d","layer":"modern","quote":"〖1〗建安元年：公元 196 年。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":264,"anchor":null},"note_id":"n-df2756e12f4ac1fef3c4","start":0,"end":17},{"id":"wudi-q-b-b9d79988a2b2559f2bb5","section":"chapter-001","block":"b-b9d79988a2b2559f2bb5","layer":"modern","quote":"〖11〗十八年：建安十八年（公元 213）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":137,"anchor":null},"note_id":"n-bec99dfe67d67ae54b06","start":0,"end":22},{"id":"wudi-q-o040","section":"chapter-001","block":"b-c71d10ef121af30ac6b7","layer":"original","quote":"建安元年春正月〖1〗，太祖军临武平〖2〗。袁术所置陈相袁嗣，降。太祖将迎天子，诸将或疑；荀彧、程昱劝之。乃遣曹洪将兵西迎。卫将军董承与袁术将苌奴拒险〖3〗，洪不得进。汝南、颍川黄巾何仪、刘辟、黄邵、何曼等〖4〗，众各数万。初应袁术，又附孙坚〖5〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":258,"anchor":null},"note_id":null,"start":0,"end":124},{"id":"wudi-q-o047","section":"chapter-001","block":"b-bbb49ee5ce4b090e1111","layer":"original","quote":"是岁，用枣祗、韩浩等议〖5〗，始兴屯田〖6〗。﹝一﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":284,"anchor":null},"note_id":null,"start":0,"end":26},{"id":"wudi-q-o139","section":"chapter-001","block":"b-d44820525c4645832365","layer":"original","quote":"十八年春正月〖11〗，进军濡须口〖12〗；攻破权江西营，获权都督公孙阳〖13〗，乃引军还。诏书并十四州〖14〗，复为九州〖15〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":107,"anchor":null},"note_id":null,"start":0,"end":65},{"id":"wudi-q-p112","section":"chapter-001","block":"b-9536581b8deb5e7104e4","layer":"pei","quote":"《魏书》载：“公令曰：‘夫受九锡，广开土宇，周公其人也。汉之异姓八王者，与高祖俱起布衣，创定王业，其功至大。吾何可比之？’前后三让。于是中军师、陵树亭侯荀攸，前军师、东武亭侯钟繇，左军师凉茂，右军师毛玠，平虏将军、华乡侯刘勋，建武将军、清苑亭侯刘若，伏波将军、高安侯夏侯惇，扬武将军、都亭侯王忠，奋威将军、乐乡侯（刘）〔邓〕展，建忠将军、昌乡亭侯鲜于辅，奋武将军、安国亭侯程昱，太中大夫、都乡侯贾诩，军师祭酒、千秋亭侯董昭，都亭侯薛洪，南乡亭侯董蒙，关内侯王粲、傅巽，祭酒王选、袁涣、王朗、张承、任藩、杜袭，中护军、国明亭侯曹洪，中领军、万岁亭侯韩浩，行骁骑将军、安平亭侯曹仁，领护军将军王图，长史万潜、谢奂、袁霸等，劝进曰：‘自古三代，胙臣以土；受命中兴，封秩辅佐。皆所以褒功赏德，为国藩卫也。往者天下崩乱，群凶豪起；颠越跋扈之险，不可忍言。明公奋身出命以徇其难，诛二袁篡盗之逆，灭黄巾贼乱之类，殄夷首逆，芟拨荒秽，沐浴霜露二十余年。书契以来，未有若此功者。昔周公承文、武之迹，受已成之业，高枕墨笔，拱揖群后，商、奄之勤，不过二年；吕望因三分有二之形，据八百诸侯之势，暂把旄钺，一时指麾：然皆大启土宇，跨州兼国。周公八子，并为侯伯：白牡骍刚，郊祀天地；典策备物，拟则王室。荣章宠盛如此之弘也。逮至汉兴，佐命之臣张耳、吴芮，其功至薄，亦连城开地，南面称孤。此皆明君达主行之于上，贤臣圣宰受之于下；三代令典，汉帝明制。今比劳则周、吕逸，计功则张、吴微，论制则齐、鲁重，言地则长沙多；然则魏国之封，九锡之荣，况于旧赏，犹怀玉而被褐也。且列侯、诸将，幸攀龙骥，得窃微劳，佩紫怀黄，盖以百数，亦将因此传之万世。而明公独辞赏于上，将使其下怀不自安。上违圣朝欢心，下失冠带至望；忘辅弼之大业，信匹夫之细行。攸等所大惧也！’于是公敕外为章，但受魏郡。攸等复曰：‘伏见魏国初封，圣朝发虑，稽谋群僚，然后策命；而明公久违上指，不即大礼。今既虔奉诏命，副顺众望；又欲辞多当少，让九受一。是犹汉朝之赏不行，而攸等之请未许也。昔齐、鲁之封，奄有东海；疆域井赋，四百万家；基隆业广，易以立功；故能成翼戴之勋，立一匡之绩。今魏国虽有十郡之名，犹减于曲阜；计其户数，不能参半：以藩卫王室，立垣树屏，犹未足也。且圣上览亡秦无辅之祸，惩曩日震荡之艰；托建忠贤，废坠是为。愿明公恭承帝命，无或拒违。’公乃受命。”","attribution":"《魏书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":262,"anchor":null},"note_id":"n-97e94061646080072adf","start":0,"end":988},{"id":"xiahoucao-e-o003b-q","section":"chapter-009","block":"b-7216c9410c1e7f3c13c6","layer":"original","quote":"惇将韩浩，乃勒兵屯惇营门，召军吏诸将：皆案甲当部不得动〖4〗。诸营乃定。遂诣惇所，叱持质者曰：“汝等凶逆，乃敢执劫大将（军）！复欲望生邪？且吾受命讨贼，宁能以一将军之故〖5〗，而纵汝乎！”因涕泣谓惇曰：“当奈国法何〖6〗！”促召兵击持质者。持质者惶遽叩头，言：“我但欲乞资用去耳〖7〗！”浩数责〖8〗，皆斩之。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":3,"anchor":null},"note_id":null,"start":40,"end":195},{"id":"xiahoucao-e-o004a-q","section":"chapter-009","block":"b-38433fda9083939142ed","layer":"original","quote":"惇既免，太祖闻之，谓浩曰：“卿此，可为万世法。”乃著令：“自今以后，有持质者；皆当并击，勿顾质。”由是劫质者遂绝。﹝一﹞","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":4,"anchor":null},"note_id":null,"start":0,"end":60},{"id":"xiahoucao-e-o010a-q","section":"chapter-009","block":"b-a09645c517481b52d6a5","layer":"original","quote":"韩浩者，河内人。及沛国史涣，与浩俱以忠勇显〖12〗。浩至中护军，涣至中领军；皆掌禁兵，封列侯。﹝五﹞","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":21,"anchor":null},"note_id":null,"start":0,"end":50},{"id":"xiahoucao-e-p006a-q","section":"chapter-009","block":"b-9fbce7d96866baadec11","layer":"pei","quote":"韩浩字元嗣。汉末起兵，县近山薮，多寇；浩聚徒众，为县藩卫。太守王匡以为从事，将兵拒董卓于盟津。","attribution":"《魏书》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":40,"anchor":null},"note_id":"n-d74b1295041866c5f00c","start":10,"end":57},{"id":"xiahoucao-e-p006b-q","section":"chapter-009","block":"b-9fbce7d96866baadec11","layer":"pei","quote":"时浩舅杜阳，为河阴令，卓执之；使招浩，浩不从。袁术闻而壮之，以为骑都尉。","attribution":"《魏书》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":40,"anchor":null},"note_id":"n-d74b1295041866c5f00c","start":57,"end":93},{"id":"xiahoucao-e-p006c-q","section":"chapter-009","block":"b-9fbce7d96866baadec11","layer":"pei","quote":"夏侯惇闻其名，请与相见；大奇之，使领兵从征伐。时大议损益，浩以为当急田。太祖善之，迁护军。","attribution":"《魏书》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":40,"anchor":null},"note_id":"n-d74b1295041866c5f00c","start":93,"end":138},{"id":"xiahoucao-e-p006d-q","section":"chapter-009","block":"b-9fbce7d96866baadec11","layer":"pei","quote":"太祖欲讨柳城，领军史涣以为道远深入，非完计也，欲与浩共谏。浩曰：‘今兵势强盛，威加四海，战胜攻取，无不如志；不以此时，遂除天下之患，将为后忧。且公神武，举无遗策；吾与君，为中军主，不宜沮众！’遂从破柳城。改其官为中护军，置长史、司马。","attribution":"《魏书》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":40,"anchor":null},"note_id":"n-d74b1295041866c5f00c","start":138,"end":255},{"id":"xiahoucao-e-p006e-q","section":"chapter-009","block":"b-9fbce7d96866baadec11","layer":"pei","quote":"从讨张鲁，鲁降。议者以浩智略足以绥边，欲留使都督诸军，镇汉中。太祖曰：‘吾安可以无护军！’乃与俱还。其见亲任如此。","attribution":"《魏书》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":40,"anchor":null},"note_id":"n-d74b1295041866c5f00c","start":255,"end":312},{"id":"xiahoucao-e-p006f-q","section":"chapter-009","block":"b-9fbce7d96866baadec11","layer":"pei","quote":"及薨，太祖愍惜之。无子，以养子荣嗣。","attribution":"《魏书》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":40,"anchor":null},"note_id":"n-d74b1295041866c5f00c","start":312,"end":330},{"id":"xiahoucao-f0029-q","section":"chapter-009","block":"b-9fbce7d96866baadec11","layer":"pei","quote":"韩浩字元嗣","attribution":"《魏书》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":40,"anchor":null},"note_id":"n-d74b1295041866c5f00c","start":10,"end":15},{"id":"xiahoucao-f0030-q","section":"chapter-009","block":"b-a09645c517481b52d6a5","layer":"original","quote":"韩浩者，河内人","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":21,"anchor":null},"note_id":null,"start":0,"end":7},{"id":"xiahoucao-q-o003","section":"chapter-009","block":"b-7216c9410c1e7f3c13c6","layer":"original","quote":"布退还，遂入濮阳，袭得惇军辎重。遣将伪降，共执持惇〖3〗；责以宝货，惇军中震恐。惇将韩浩，乃勒兵屯惇营门，召军吏诸将：皆案甲当部不得动〖4〗。诸营乃定。遂诣惇所，叱持质者曰：“汝等凶逆，乃敢执劫大将（军）！复欲望生邪？且吾受命讨贼，宁能以一将军之故〖5〗，而纵汝乎！”因涕泣谓惇曰：“当奈国法何〖6〗！”促召兵击持质者。持质者惶遽叩头，言：“我但欲乞资用去耳〖7〗！”浩数责〖8〗，皆斩之。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":3,"anchor":null},"note_id":null,"start":0,"end":195},{"id":"xiahoucao-q-o004","section":"chapter-009","block":"b-38433fda9083939142ed","layer":"original","quote":"惇既免，太祖闻之，谓浩曰：“卿此，可为万世法。”乃著令：“自今以后，有持质者；皆当并击，勿顾质。”由是劫质者遂绝。﹝一﹞","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":4,"anchor":null},"note_id":null,"start":0,"end":60},{"id":"xiahoucao-q-o010","section":"chapter-009","block":"b-a09645c517481b52d6a5","layer":"original","quote":"韩浩者，河内人。及沛国史涣，与浩俱以忠勇显〖12〗。浩至中护军，涣至中领军；皆掌禁兵，封列侯。﹝五﹞","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":21,"anchor":null},"note_id":null,"start":0,"end":50},{"id":"xiahoucao-q-p006","section":"chapter-009","block":"b-9fbce7d96866baadec11","layer":"pei","quote":"﹝五﹞《魏书》曰：“韩浩字元嗣。汉末起兵，县近山薮，多寇；浩聚徒众，为县藩卫。太守王匡以为从事，将兵拒董卓于盟津。时浩舅杜阳，为河阴令，卓执之；使招浩，浩不从。袁术闻而壮之，以为骑都尉。夏侯惇闻其名，请与相见；大奇之，使领兵从征伐。时大议损益，浩以为当急田。太祖善之，迁护军。太祖欲讨柳城，领军史涣以为道远深入，非完计也，欲与浩共谏。浩曰：‘今兵势强盛，威加四海，战胜攻取，无不如志；不以此时，遂除天下之患，将为后忧。且公神武，举无遗策；吾与君，为中军主，不宜沮众！’遂从破柳城。改其官为中护军，置长史、司马。从讨张鲁，鲁降。议者以浩智略足以绥边，欲留使都督诸军，镇汉中。太祖曰：‘吾安可以无护军！’乃与俱还。其见亲任如此。及薨，太祖愍惜之。无子，以养子荣嗣。史涣字公刘。少任侠，有雄气。太祖初起，以客从，行中军校尉。从征伐，常监诸将；见亲信，转拜中领军。十四年薨。子静嗣。”","attribution":"《魏书》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":40,"anchor":null},"note_id":"n-d74b1295041866c5f00c","start":0,"end":388},{"id":"yuanzhang-q-5f59791b711af6d8f180","section":"chapter-011","block":"b-65d1896f1f9ded3e140d","layer":"original","quote":"太祖欲广置屯田，使渊典其事。渊屡陈损益，相土处民〖5〗，计民置吏；明功课之法〖6〗。五年中，仓廪丰实，百姓竞劝乐业","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":134,"anchor":null},"note_id":null,"start":0,"end":57},{"id":"yuanzhang-q-eb7264c567ccb419c713","section":"chapter-011","block":"b-12e51a7896aa63a3c457","layer":"original","quote":"涣白太祖曰：“夫民安土重迁，不可卒变；易以顺行，难以逆动；宜顺其意，乐之者乃取，不欲者勿强。”太祖从之，百姓大悦","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":22,"anchor":null},"note_id":null,"start":35,"end":91}],"profiles":{},"directory_counts":{}}
