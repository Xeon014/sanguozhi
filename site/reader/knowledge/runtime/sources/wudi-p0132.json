{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o050a","title":"张绣降而复反与曹操宛败","accounts":[{"id":"wudi-e-o050a-account","label":"正文","text":"曹操到宛，张绣先降后反，曹操战败受伤，曹昂和曹安民遇害。","evidence":["wudi-e-o050a-q"]},{"id":"wendi-e-p106b-account","label":"裴注·典论自叙","text":"建安之初，时年十一岁，曹丕于张绣反叛时乘马逃脱。","evidence":["wendi-e-p106b-q"]},{"id":"gongsuntao-a-adc839b7d1edc356b77b","label":"正文","text":"太祖南征军淯水绣举众降","evidence":["gongsuntao-q-66d7130f3b50aa50a625"]},{"id":"gongsuntao-a-f3243179641f1928fe90","label":"正文","text":"计漏绣掩袭太祖军败二子没还保穰","evidence":["gongsuntao-q-ff71cd5fd221e28b5c5b"]},{"id":"gongsuntao-a-1512c32cb2a8cc60a519","label":"裴注·吴书","text":"绣用贾诩计乞徙军掩太祖太祖不备故败","evidence":["gongsuntao-q-16c794bc2c6a7efcabdf"]},{"id":"lizang-a-409cc34f89f6e4628887","label":"正文","text":"太祖征荆州至宛，张绣迎降","evidence":["lizang-q-1c5444ff52132f9bc957"]},{"id":"lizang-a-c950118931b6c1d6b252","label":"正文","text":"太祖延绣置酒高会，韦持大斧立后，所至辄举斧目之，竟酒绣莫敢仰视","evidence":["lizang-q-ea34e7392968597c78eb"]},{"id":"lizang-a-6e9347868b92fa2cbfc8","label":"正文","text":"后十余日绣反袭太祖营，太祖出战不利轻骑引去","evidence":["lizang-q-1cbf0e590bade9fba0e3"]},{"id":"lizang-a-01c8df5dae2bd90dfe4b","label":"正文","text":"韦战于门中殊死拒贼，以长戟左右击，被数十创，瞋目大骂而死，贼取其头传观","evidence":["lizang-q-7f3900fa715968a7461e"]}],"participants":[{"person":"cao-cao","role":"战败受伤","evidence":["wudi-e-o050a-q"]},{"person":"wudi-p0131","role":"降而复反","evidence":["wudi-e-o050a-q"]},{"person":"wudi-p0132","role":"遇害","evidence":["wudi-e-o050a-q"]},{"person":"wudi-p0133","role":"遇害","evidence":["wudi-e-o050a-q"]},{"person":"wudi-p0170","role":"逃脱","evidence":["wendi-e-p106b-q"]},{"person":"wudi-p0182","role":"计所出","evidence":["gongsuntao-q-16c794bc2c6a7efcabdf"]},{"person":"shaodi-p0012","role":"持大斧侍卫；拒战而死","evidence":["lizang-q-ea34e7392968597c78eb","lizang-q-7f3900fa715968a7461e"]}],"place":{"text":"宛","evidence":["wudi-e-o050a-q"]},"time":{"label":"建安二年春正月","year":197,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o050a-q","wudi-q-o050","wudi-q-b-40d8b7057f4a29d6fe0d"],"chronology":"wudi-y197","dating_review":{"anchor":"wudi-q-o050","basis":"建安二年春正月","reviewed":true}},"source_order":[1,299,"O050a"],"order":134},{"id":"wudi-e-p047a","title":"宛败中绝影受伤与曹昂献马","accounts":[{"id":"wudi-e-p047a-account","label":"《魏书》、《世语》","text":"《魏书》记曹操与坐骑绝影中箭；《世语》称曹昂献马使曹操得免，自己遇害。","evidence":["wudi-e-p047a-q"]}],"participants":[{"person":"cao-cao","role":"受伤脱身","evidence":["wudi-e-p047a-q"]},{"person":"wudi-p0132","role":"《世语》记献马遇害","evidence":["wudi-e-p047a-q"]}],"place":null,"time":{"label":"建安二年宛败时","year":197,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-p047a-q","wudi-q-o050","wudi-q-b-40d8b7057f4a29d6fe0d"],"chronology":"wudi-y197","dating_review":{"anchor":"wudi-q-o050","basis":"建安二年宛败时","reviewed":true}},"source_order":[1,321,"P047a"],"order":140},{"id":"wuwen-e-6a354e264e28aa32ff44","title":"曹昂弱冠举孝廉","accounts":[{"id":"wuwen-a-6a354e264e28aa32ff44","label":"正文","text":"曹昂弱冠举孝廉","evidence":["wuwen-q-ee36ca3b91703ff42cad"]}],"participants":[{"person":"wudi-p0132","role":"被举者","evidence":["wuwen-q-ee36ca3b91703ff42cad"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["wuwen-q-ee36ca3b91703ff42cad"]},"ordering_evidence":"wuwen-q-ee36ca3b91703ff42cad","order":3832},{"id":"wuwen-e-c85b947d7eace8e92fc8","title":"曹昂随曹操南征为张绣所害","accounts":[{"id":"wuwen-a-c85b947d7eace8e92fc8","label":"正文","text":"曹昂随曹操南征为张绣所害","evidence":["wuwen-q-2bc96d082b0fcfc8c6f8"]}],"participants":[{"person":"wudi-p0132","role":"遇害者","evidence":["wuwen-q-2bc96d082b0fcfc8c6f8"]},{"person":"wudi-p0131","role":"攻杀者","evidence":["wuwen-q-2bc96d082b0fcfc8c6f8"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["wuwen-q-2bc96d082b0fcfc8c6f8"]},"ordering_evidence":"wuwen-q-2bc96d082b0fcfc8c6f8","order":3833},{"id":"wuwen-e-6e2996591f4d5a9f7ef6","title":"曹昂追封谥丰悼公","accounts":[{"id":"wuwen-a-6e2996591f4d5a9f7ef6","label":"正文","text":"曹昂追封谥丰悼公","evidence":["wuwen-q-ab9a5e0d8d4665bbe157"]}],"participants":[{"person":"wudi-p0132","role":"被追封谥者","evidence":["wuwen-q-ab9a5e0d8d4665bbe157"]}],"place":null,"time":{"label":"黄初二年","precision":"undated","basis":"保留本条明文纪年；未审定对应公元年。","evidence":["wuwen-q-ab9a5e0d8d4665bbe157"]},"ordering_evidence":"wuwen-q-ab9a5e0d8d4665bbe157","order":3834},{"id":"wuwen-e-381ddb54d028214658d3","title":"曹昂：五年，追加昂号曰丰悼王。","accounts":[{"id":"wuwen-a-381ddb54d028214658d3","label":"正文","text":"曹昂：五年，追加昂号曰丰悼王。","evidence":["wuwen-q-3a38f10ba050d5742343"]}],"participants":[{"person":"wudi-p0132","role":"受追封谥者","evidence":["wuwen-q-3a38f10ba050d5742343"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原句纪年见引文，未审定公元年。","evidence":["wuwen-q-3a38f10ba050d5742343"]},"ordering_evidence":"wuwen-q-3a38f10ba050d5742343","order":3837},{"id":"wuwen-e-7c586165cc53bd63a36b","title":"曹昂：太和三年，改昂谥曰愍王。","accounts":[{"id":"wuwen-a-7c586165cc53bd63a36b","label":"正文","text":"曹昂：太和三年，改昂谥曰愍王。","evidence":["wuwen-q-e1d4721ede35f0fb4e9a"]}],"participants":[{"person":"wudi-p0132","role":"受追封谥者","evidence":["wuwen-q-e1d4721ede35f0fb4e9a"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原句纪年见引文，未审定公元年。","evidence":["wuwen-q-e1d4721ede35f0fb4e9a"]},"ordering_evidence":"wuwen-q-e1d4721ede35f0fb4e9a","order":3838}],"persons":[{"id":"wudi-p0132","name":"曹昂","evidence":["wudi-q-o050","wendi-q-p106","houfei-q-p002","wuwen-q-3a38f10ba050d5742343","wuwen-q-e1d4721ede35f0fb4e9a","wuwen-q-ee36ca3b91703ff42cad","wuwen-q-2bc96d082b0fcfc8c6f8","wuwen-q-ab9a5e0d8d4665bbe157","wuwen-q-5f474235c80222336a3c","wuwen-q-c2f55f326342aebf012b"],"facts":[{"id":"houfei-f0015","label":"字","text":"子修","evidence":["houfei-f0015-q"]},{"id":"wuwen-f-3c4daaea81388bbdca03","text":"字：子修","evidence":["wuwen-q-5f474235c80222336a3c"]},{"id":"wuwen-f-90dd9b502d7790f8a278","text":"父为曹操；本传记母为刘夫人。","evidence":["wuwen-q-c2f55f326342aebf012b"]}],"aliases":[{"text":"子修","evidence":["houfei-f0015-q"]}],"mentions":[{"id":"wudi-m-o050-wudi-p0132","kind":"mention","text":"文中提及","evidence":["wudi-q-o050"]},{"id":"wudi-m-p047-wudi-p0132","kind":"mention","text":"文中提及","evidence":["wudi-q-p047"]},{"id":"wendi-m-p106-wudi-p0132","kind":"mention","text":"文中提及","evidence":["wendi-q-p106"]},{"id":"houfei-m-p002-wudi-p0132","kind":"mention","text":"文中提及","evidence":["houfei-q-p002"]}]}],"evidence":[{"id":"gongsuntao-q-16c794bc2c6a7efcabdf","section":"chapter-008","block":"b-3f9f88db75a27c71879a","layer":"pei","quote":"绣降，（凌统）用贾诩计，乞徙军就高道；道由太祖屯中。绣又曰：‘车少而重，乞得使兵各被甲。’太祖信绣，皆听之。绣乃严兵，入屯，掩太祖。太祖不备，故败","attribution":"裴注·吴书","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":267,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9e423635425d66361a22","start":60,"end":133,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-66d7130f3b50aa50a625","section":"chapter-008","block":"b-cf84eafed97482cd953c","layer":"original","quote":"太祖南征，军淯水〖4〗。绣等举众降","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":254,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":13,"end":30,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-ff71cd5fd221e28b5c5b","section":"chapter-008","block":"b-cf84eafed97482cd953c","layer":"original","quote":"计漏，绣掩袭太祖；太祖军败，二子没〖5〗。绣还保穰，﹝一﹞太祖比年攻之，不克","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":254,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":55,"end":93,"offset_unit":"unicode_code_point"},{"id":"houfei-f0015-q","section":"chapter-005","block":"b-e655a9cd53f203645964","layer":"pei","quote":"子修亡于穰","attribution":"《魏略》","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":37,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8073d620865a43f9e1af","start":41,"end":46,"offset_unit":"unicode_code_point"},{"id":"houfei-q-p002","section":"chapter-005","block":"b-e655a9cd53f203645964","layer":"pei","quote":"﹝二﹞《魏略》曰：“太祖始有丁夫人，又刘夫人生子修及清河长公主。刘早终，丁养子修。子修亡于穰，丁常言：‘将我儿杀之，都不复念！’遂哭泣无节。太祖忿之，遣归家，欲其意折。后太祖就见之，夫人方织。外人传云‘公至’，夫人踞机如故。太祖到，抚其背曰：‘顾我共载归乎？’夫人不顾，又不应。太祖却行，立于户外。复云：‘得无尚可邪？’遂不应。太祖曰：‘真诀矣！’遂与绝。欲其家嫁之，其家不敢。初，丁夫人既为嫡，加有子修，丁视后母子，不足。后为继室，不念旧恶。因太祖出行，常四时使人馈遗。又私迎之，延以正坐而己下之。迎来送去，有如昔日。丁谢曰：‘废放之人，夫人何能常尔邪！’其后丁亡，后请太祖殡葬；许之，乃葬许城南。后太祖病困，自虑不起，叹曰：‘我前后行意，于心未曾有所负也。假令死而有灵，子修若问“我母所在”？我将何辞以答！’”","attribution":"《魏略》","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":37,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8073d620865a43f9e1af","start":0,"end":357,"offset_unit":"unicode_code_point"},{"id":"lizang-q-1c5444ff52132f9bc957","section":"chapter-018","block":"b-645291c3846bd2e4fd4f","layer":"original","quote":"太祖征荆州，至宛，张绣迎降","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":172,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":13,"offset_unit":"unicode_code_point"},{"id":"lizang-q-1cbf0e590bade9fba0e3","section":"chapter-018","block":"b-1f91b0944f647a7e25ae","layer":"original","quote":"后十余日，绣反，袭太祖营。太祖出战，不利，轻骑引去","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":173,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":25,"offset_unit":"unicode_code_point"},{"id":"lizang-q-7f3900fa715968a7461e","section":"chapter-018","block":"b-1f91b0944f647a7e25ae","layer":"original","quote":"韦战于门中，贼不得入；兵遂散从他门并入。时韦校尚有十余人〖21〗，皆殊死战，无不一当十。贼前后至，稍多，韦以长戟左右击之；一叉入，辄十余矛摧。左右死伤者略尽，韦被数十创。短兵接战，贼前搏之；韦双挟两贼击杀之，余贼不敢前。韦复前突贼，杀数人；创重发，瞋目大骂而死。贼乃敢前，取其头，传观之；覆军就视其躯","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":173,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":26,"end":176,"offset_unit":"unicode_code_point"},{"id":"lizang-q-ea34e7392968597c78eb","section":"chapter-018","block":"b-645291c3846bd2e4fd4f","layer":"original","quote":"太祖甚悦，延绣及其将帅，置酒高会。太祖行酒〖19〗，韦持大斧立后；刃径尺，太祖所至之前，韦辄举斧目之。竟酒〖20〗，绣及其将帅莫敢仰视","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":172,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":14,"end":81,"offset_unit":"unicode_code_point"},{"id":"wendi-e-p106b-q","section":"chapter-002","block":"b-6eb68753e8e520d9914c","layer":"pei","quote":"建安初，上南征荆州，至宛，张绣降，旬日而反；亡兄孝廉子修、从兄安民遇害。时余年十一岁，乘马得脱。","attribution":"裴注·典论自叙","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":521,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-2aa5d4559ce229d0d61c","start":289,"end":337,"offset_unit":"unicode_code_point"},{"id":"wendi-q-p106","section":"chapter-002","block":"b-6eb68753e8e520d9914c","layer":"pei","quote":"﹝一﹞《典论》帝《自叙》曰：“初平之元，董卓杀主鸩后，荡覆王室。是时四海既困中平之政，兼恶卓之凶逆；家家思乱，人人自危。山东牧守，咸以《春秋》之义，‘卫人讨州吁于濮’，言人人皆得讨贼。于是大兴义兵，名豪大侠，富室强族；飘扬云会，万里相赴。兖、豫之师战于荥阳，河内之甲军于孟津。卓遂迁大驾，西都长安。而山东大者连郡国，中者婴城邑，小者聚阡陌，以还相吞灭。会黄巾盛于海岱，山寇暴于并、冀；乘胜转攻，席卷而南，乡邑望烟而奔，城郭睹尘而溃；百姓死亡，暴骨如莽。余时年五岁，上以世方扰乱，教余学射，六岁而知射，又教余骑马；八岁而能骑射矣。以时之多（故）〔难〕，每征〔伐〕，余〔乘马〕常从。建安初，上南征荆州，至宛，张绣降，旬日而反；亡兄孝廉子修、从兄安民遇害。时余年十一岁，乘马得脱。夫文武之道，各随时而用；生于中平之季，长于戎旅之间；是以少好弓马，于今不衰；逐禽辄十里，驰射常百步；日多体健，心每不厌。建安十年，始定冀州；濊、貊贡良弓，燕、代献名马。时岁之暮春，勾芒司节，和风扇物；弓燥手柔，草浅兽肥。与族兄子丹，猎于邺西，终日手获獐鹿九，雉兔三十。后军南征次曲蠡，尚书令荀彧奉使犒军。见余，谈论之末，彧言：‘闻君善左右射，此实难能。’余言：‘执事未睹夫项发口纵，俯马蹄而仰月支也。’彧喜笑曰：‘乃尔！’余曰：‘埒有常径，的有常所；虽每发辄中，非至妙也！若驰平原，赴丰草，要狡兽，截轻禽；使弓不虚弯，所中必洞，斯则妙矣！’时军祭酒张京在坐，顾彧拊手曰：“善！”余又学击剑，阅师多矣；四方之法各异，唯京师为善。桓、灵之间，有虎贲王越，善斯术，称于京师。河南史阿，言昔与越游，具得其法；余从阿学之精熟。尝与平虏将军刘勋、奋威将军邓展等共饮。宿闻展善有手臂，晓五兵，又称其能空手入白刃。余与论剑良久，谓言：‘将军法非也！余顾尝好之，又得善术。’因求与余对。时酒酣耳热，方食甘蔗，便以为杖；下殿数交，三中其臂，左右大笑。展意不平，求更为之。余言：‘吾法急属，难相中面，故齐臂耳！’展言‘愿复一交’。余知其欲突以取交中也，因伪深进；展果寻前，余却脚鄛，正截其颡，坐中惊视。余还坐，笑曰：‘昔阳庆使淳于意去其故方，更授以秘术。今余亦愿邓将军捐弃故伎，更受要道也！’一坐尽欢。夫事不可自谓己长。余少晓持复，自谓无对；俗名双戟为‘坐铁室’，镶盾为‘蔽木户’。后从陈国袁敏学，以单攻复，每为若神，对家不知所出。先日若逢敏于狭路，直决耳！余于他戏弄之事少所喜，唯弹棋略尽其巧，少为之赋。昔京师先工有马合乡侯、东方安世、张公子，常恨不得与彼数子者对。上雅好诗书文籍，虽在军旅，手不释卷。每每定省从容，常言：‘人少好学则思专，长则善忘；长大而能勤学者，唯吾与袁伯业耳！’余是以少诵诗、论，及长而备历五经、四部，《史》、《汉》、诸子百家之言，靡不毕览。”","attribution":"裴注·典论自叙","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":521,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-2aa5d4559ce229d0d61c","start":0,"end":1160,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o050a-q","section":"chapter-001","block":"b-c2d0fc350fb933237a70","layer":"original","quote":"二年春正月〖3〗，公到宛〖4〗。张绣降，既而悔之，复反。公与战，军败，为流矢所中。长子昂、弟子安民遇害〖5〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":298,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":55,"offset_unit":"unicode_code_point"},{"id":"wudi-e-p047a-q","section":"chapter-001","block":"b-17f32357ab34a24c55c1","layer":"pei","quote":"﹝一﹞《魏书》曰：“所乘马名‘绝影’。为流矢所中，伤颊及足；并中公右臂。”《世语》曰：“昂不能骑，进马于公。公故免，而昂遇害。”","attribution":"《魏书》、《世语》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":320,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9bc7ed14fc92cd4fed2a","start":0,"end":64,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-40d8b7057f4a29d6fe0d","section":"chapter-001","block":"b-40d8b7057f4a29d6fe0d","layer":"modern","quote":"〖3〗二年：建安二年（公元 197）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":305,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-de6807349faf5c41a470","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o050","section":"chapter-001","block":"b-c2d0fc350fb933237a70","layer":"original","quote":"二年春正月〖3〗，公到宛〖4〗。张绣降，既而悔之，复反。公与战，军败，为流矢所中。长子昂、弟子安民遇害〖5〗。﹝一﹞公乃引兵还舞阴〖6〗，绣将骑来抄〖7〗。公击破之，绣奔穰〖8〗，与刘表合。公谓诸将曰：“吾降张绣等，失不便取其质〖9〗，以至于此。吾知所以败。诸卿观之：自今以后，不复败矣！”遂还许。﹝二﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":298,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":152,"offset_unit":"unicode_code_point"},{"id":"wudi-q-p047","section":"chapter-001","block":"b-17f32357ab34a24c55c1","layer":"pei","quote":"﹝一﹞《魏书》曰：“所乘马名‘绝影’。为流矢所中，伤颊及足；并中公右臂。”《世语》曰：“昂不能骑，进马于公。公故免，而昂遇害。”","attribution":"《魏书》、《世语》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":320,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9bc7ed14fc92cd4fed2a","start":0,"end":64,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-2bc96d082b0fcfc8c6f8","section":"chapter-020","block":"b-f468cbbf95c705c26d34","layer":"original","quote":"随太祖南征，为张绣所害。无子。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":2,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":15,"end":30,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-3a38f10ba050d5742343","section":"chapter-020","block":"b-de029fec2f4e2d0135dc","layer":"original","quote":"五年〖3〗，追加昂号曰丰悼王。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":3,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":32,"end":47,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-5f474235c80222336a3c","section":"chapter-020","block":"b-f468cbbf95c705c26d34","layer":"original","quote":"丰愍王昂，字子修。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":2,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":9,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-ab9a5e0d8d4665bbe157","section":"chapter-020","block":"b-f468cbbf95c705c26d34","layer":"original","quote":"黄初二年追封谥曰丰悼公〖1〗。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":2,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":30,"end":45,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-c2f55f326342aebf012b","section":"chapter-020","block":"b-87027621c423a4f13bd6","layer":"original","quote":"武皇帝二十五男：卞皇后生文皇帝、任城威王彰、陈思王植、萧怀王熊；刘夫人生丰愍王昂、相殇王铄；环夫人生邓哀王冲、彭城王据、燕王宇；杜夫人生沛穆王林、中山恭王衮；秦夫人生济阳怀王玹、陈留恭王峻；尹夫人生范阳闵王矩；王昭仪生赵王幹；孙姬生临邑殇公子上、楚王彪、刚殇公子勤；李姬生谷城殇公子乘、郿戴公子整、灵殇公子京；周姬生樊安公均；刘姬生广宗殇公子棘；宋姬生东平灵王徽；赵姬生乐陵王茂。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":1,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":190,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-e1d4721ede35f0fb4e9a","section":"chapter-020","block":"b-de029fec2f4e2d0135dc","layer":"original","quote":"太和三年，改昂谥曰愍王。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":3,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":47,"end":59,"offset_unit":"unicode_code_point"},{"id":"wuwen-q-ee36ca3b91703ff42cad","section":"chapter-020","block":"b-f468cbbf95c705c26d34","layer":"original","quote":"丰愍王昂，字子修。弱冠举孝廉。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":2,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":15,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
