{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p045a","title":"王立以星象影响献帝东行","accounts":[{"id":"wudi-e-p045a-account","label":"张璠《汉纪》","text":"献帝败于曹阳后欲沿河东下，王立以星象进言，天子改取轵关方向。","evidence":["wudi-e-p045a-q"]}],"participants":[{"person":"wudi-p0054","role":"拟定路线","evidence":["wudi-e-p045a-q"]},{"person":"wudi-p0125","role":"以星象进言","evidence":["wudi-e-p045a-q"]}],"place":{"text":"曹阳、轵关","evidence":["wudi-e-p045a-q"]},"time":{"label":"天子败于曹阳之后","precision":"relative","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p045a-q"]},"source_order":[1,282,"P045a"],"order":125},{"id":"wudi-e-p045b","title":"王立言代汉之兆而曹操止之","accounts":[{"id":"wudi-e-p045b-account","label":"张璠《汉纪》","text":"王立向刘艾及天子谈代汉之兆，曹操遣人劝其少言；记其言论，不把星占当作历史因果事实。","evidence":["wudi-e-p045b-q"]}],"participants":[{"person":"wudi-p0125","role":"谈论星占","evidence":["wudi-e-p045b-q"]},{"person":"wudi-p0126","role":"受谈","evidence":["wudi-e-p045b-q"]},{"person":"wudi-p0054","role":"受言","evidence":["wudi-e-p045b-q"]},{"person":"cao-cao","role":"遣人劝止","evidence":["wudi-e-p045b-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p045b-q"]},"source_order":[1,282,"P045b"],"order":126}],"persons":[{"id":"wudi-p0125","name":"王立","evidence":["wudi-q-p045"],"facts":[],"aliases":[],"mentions":[{"id":"wudi-m-p045-wudi-p0125","kind":"mention","text":"文中提及","evidence":["wudi-q-p045"]}]}],"evidence":[{"id":"wudi-e-p045a-q","section":"chapter-001","block":"b-7e754e1cd24b49bbf6c0","layer":"pei","quote":"初，天子败于曹阳，欲浮河东下。侍中、太史令王立曰：‘自去春太白犯镇星于牛、斗，过天津；荧惑又逆行守北河，不可犯也。’由是天子遂不北渡河，将自轵关东出。","attribution":"张璠《汉纪》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":281,"anchor":null},"note_id":"n-b40125eafc462ce97170","start":12,"end":87},{"id":"wudi-e-p045b-q","section":"chapter-001","block":"b-7e754e1cd24b49bbf6c0","layer":"pei","quote":"立又谓宗正刘艾曰：‘前太白守天关，与荧惑会；金火交会，革命之象也。汉祚终矣！晋、魏必有兴者。’立后数言于帝曰：‘天命有去就，五行不常盛。代火者土也，承汉者魏也。能安天下者，曹姓也！唯委任曹氏而已。’公闻之，使人语立曰：‘知公忠于朝廷，然天道深远，幸勿多言！’","attribution":"张璠《汉纪》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":281,"anchor":null},"note_id":"n-b40125eafc462ce97170","start":87,"end":216},{"id":"wudi-q-p045","section":"chapter-001","block":"b-7e754e1cd24b49bbf6c0","layer":"pei","quote":"﹝三﹞张璠《汉纪》曰：“初，天子败于曹阳，欲浮河东下。侍中、太史令王立曰：‘自去春太白犯镇星于牛、斗，过天津；荧惑又逆行守北河，不可犯也。’由是天子遂不北渡河，将自轵关东出。立又谓宗正刘艾曰：‘前太白守天关，与荧惑会；金火交会，革命之象也。汉祚终矣！晋、魏必有兴者。’立后数言于帝曰：‘天命有去就，五行不常盛。代火者土也，承汉者魏也。能安天下者，曹姓也！唯委任曹氏而已。’公闻之，使人语立曰：‘知公忠于朝廷，然天道深远，幸勿多言！’”","attribution":"张璠《汉纪》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":281,"anchor":null},"note_id":"n-b40125eafc462ce97170","start":0,"end":217}],"profiles":{},"directory_counts":{}}
