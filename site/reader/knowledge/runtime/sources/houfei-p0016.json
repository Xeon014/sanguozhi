{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[],"persons":[{"id":"houfei-p0016","name":"吾丘寿王","evidence":["houfei-q-p007"],"facts":[],"aliases":[],"mentions":[{"id":"houfei-m-p007-houfei-p0016","kind":"allusion","text":"祖系或典故提及","evidence":["houfei-q-p007"]}]}],"evidence":[{"id":"houfei-q-p007","section":"chapter-005","block":"b-e91f9ee858198a44c049","layer":"pei","quote":"﹝三﹞《魏略》曰：“兰献赋，赞述太子德美。太子报曰：‘赋者，言事类之所附也；颂者，美盛德之形容也。故作者不虚其辞，受者必当其实。兰此赋，岂吾实哉？昔吾丘寿王一陈宝鼎，何武等徒以歌颂，犹受金帛之赐；兰事虽不谅，义足嘉也。今赐牛一头。’由是遂见亲敬。”","attribution":"《魏略》","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":71,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-146bec963ade04637411","start":0,"end":124,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
