{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p013a","title":"曹操因宋奇事免官又被征用","accounts":[{"id":"wudi-e-p013a-account","label":"《魏书》","text":"《魏书》记宋奇被诛后曹操受牵连免官，后来因明古学再拜议郎。","evidence":["wudi-e-p013a-q"]}],"participants":[{"person":"wudi-p0034","role":"被诛","evidence":["wudi-e-p013a-q"]},{"person":"cao-cao","role":"免官再征","evidence":["wudi-e-p013a-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p013a-q"]},"source_order":[1,39,"P013a"],"order":23}],"persons":[{"id":"wudi-p0034","name":"宋奇","evidence":["wudi-q-p013"],"facts":[],"aliases":[],"mentions":[{"id":"wudi-m-p013-wudi-p0034","kind":"mention","text":"文中提及","evidence":["wudi-q-p013"]}]}],"evidence":[{"id":"wudi-e-p013a-q","section":"chapter-001","block":"b-c8ebb5719c067c6530d1","layer":"pei","quote":"太祖从妹夫!强侯宋奇被诛，从坐，免官。后以能明古学，复征拜议郎。","attribution":"《魏书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":38,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-93b8bf4cd95e2ce6a347","start":10,"end":42,"offset_unit":"unicode_code_point"},{"id":"wudi-q-p013","section":"chapter-001","block":"b-c8ebb5719c067c6530d1","layer":"pei","quote":"﹝四﹞《魏书》曰：“太祖从妹夫!强侯宋奇被诛，从坐，免官。后以能明古学，复征拜议郎。先是，大将军窦武、太傅陈蕃谋诛阉官，反为所害。太祖上书陈武等正直而见陷害，奸邪盈朝，善人壅塞，其言甚切。灵帝不能用。是后诏书敕三府：举奏州县政理无效，民为作谣言者，免罢之。三公倾邪，皆希世见用，货赂并行。强者为怨，不见举奏；弱者守道，多被陷毁。太祖疾之。是岁，以灾异博问得失，因此复上书切谏，说三公所举奏专回避贵戚之意。奏上，天子感悟，以示三府，责让之；诸以谣言征者，皆拜议郎。是后政教日乱，豪猾益炽，多所摧毁。太祖知不可匡正，遂不复献言。”","attribution":"《魏书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":38,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-93b8bf4cd95e2ce6a347","start":0,"end":263,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
