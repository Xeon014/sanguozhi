{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p139a","title":"金祎等谋攻魏求援刘备","accounts":[{"id":"wudi-e-p139a-account","label":"《三辅决录注》","text":"《三辅决录注》记金祎等结谋，计划杀王必、挟天子攻魏、南援刘备，尚属其谋划。","evidence":["wudi-e-p139a-q"]}],"participants":[{"person":"wudi-p0383","role":"结谋","evidence":["wudi-e-p139a-q"]},{"person":"wudi-p0373","role":"结谋","evidence":["wudi-e-p139a-q"]},{"person":"wudi-p0374","role":"结谋","evidence":["wudi-e-p139a-q"]},{"person":"wudi-p0372","role":"结谋","evidence":["wudi-e-p139a-q"]},{"person":"wudi-p0384","role":"结谋","evidence":["wudi-e-p139a-q"]},{"person":"wudi-p0385","role":"结谋","evidence":["wudi-e-p139a-q"]},{"person":"wudi-p0375","role":"谋杀对象","evidence":["wudi-e-p139a-q"]}],"place":{"text":"许","evidence":["wudi-e-p139a-q"]},"time":{"label":"许中兵变前","year":218,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-p139a-q","wudi-q-o188","wudi-q-b-ac93ccb47f6e7be3aea4"],"chronology":"wudi-y218","dating_review":{"anchor":"wudi-q-o188","basis":"许中兵变前","reviewed":true}},"source_order":[1,1094,"P139a"],"order":416},{"id":"wudi-e-p139b","title":"吉邈等夜袭王必失败","accounts":[{"id":"wudi-e-p139b-account","label":"《三辅决录注》","text":"吉邈等率杂人家僮千余夜袭，金祎派内应；王必中箭逃出，天明叛众散败。原书另载帐下督扶王必逃南城之说。","evidence":["wudi-e-p139b-q"]}],"participants":[{"person":"wudi-p0384","role":"夜袭","evidence":["wudi-e-p139b-q"]},{"person":"wudi-p0385","role":"参与","evidence":["wudi-e-p139b-q"]},{"person":"wudi-p0383","role":"内应","evidence":["wudi-e-p139b-q"]},{"person":"wudi-p0375","role":"负伤逃出","evidence":["wudi-e-p139b-q"]}],"place":{"text":"许","evidence":["wudi-e-p139b-q"]},"time":{"label":"建安二十三年春正月","year":218,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-p139b-q","wudi-q-o188","wudi-q-b-ac93ccb47f6e7be3aea4"],"chronology":"wudi-y218","dating_review":{"anchor":"wudi-q-o188","basis":"建安二十三年春正月","reviewed":true}},"source_order":[1,1094,"P139b"],"order":417}],"persons":[{"id":"wudi-p0383","name":"金祎","evidence":["wudi-q-p139","xianzhu-q-p030"],"facts":[{"id":"wudi-f-p139-wudi-p0383-c55038","label":"字","text":"德祎","evidence":["wudi-q-p139"]},{"id":"wudi-f-p139-wudi-p0383-3d9187","label":"籍贯","text":"京兆","evidence":["wudi-q-p139"]},{"id":"xianzhu-f0014","label":"父亲","text":"金旋","evidence":["xianzhu-q-p030"]}],"aliases":[{"text":"德祎","evidence":["wudi-q-p139"]}],"mentions":[{"id":"wudi-m-p139-wudi-p0383","kind":"mention","text":"文中提及","evidence":["wudi-q-p139"]},{"id":"xianzhu-m-p030-wudi-p0383","kind":"mention","text":"文中提及","evidence":["xianzhu-q-p030"]}]}],"evidence":[{"id":"wudi-e-p139a-q","section":"chapter-001","block":"b-66e857f79a5f5bdfcda8","layer":"pei","quote":"时有京兆金祎，字德祎。自以世为汉臣，自日䃅讨莽何罗，忠诚显著，名节累叶。睹汉祚将移，谓可季兴；乃喟然发愤，遂与耿纪、韦晃、吉本、本子邈、邈弟穆等结谋。纪字季行。少有美名，为丞相掾，王甚敬异之。迁侍中，守少府。邈字文然，穆字思然；以祎慷慨有日!之风，又与王必善，因以间之。若杀必，欲挟天子以攻魏，南援刘备。","attribution":"《三辅决录注》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":418,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5fb0839b137ecdb9b177","start":13,"end":165,"offset_unit":"unicode_code_point"},{"id":"wudi-e-p139b-q","section":"chapter-001","block":"b-66e857f79a5f5bdfcda8","layer":"pei","quote":"时关羽强盛，而王在邺，留必典兵，督许中事。文然等率杂人及家僮千余人，夜烧门攻必。祎遣人为内应，射必中肩。必不知攻者为谁，以素与祎善，走投祎，夜唤‘德祎’。祎家不知是必，谓为文然等，错应曰：‘王长史已死乎？卿曹事立矣！’必乃更他路奔。一曰：必欲投祎，其帐下督谓必曰：‘今日事，竟知谁门而投入乎？’扶必奔南城。会天明，必犹在；文然等众散，故败。","attribution":"《三辅决录注》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":418,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5fb0839b137ecdb9b177","start":165,"end":335,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-ac93ccb47f6e7be3aea4","section":"chapter-001","block":"b-ac93ccb47f6e7be3aea4","layer":"modern","quote":"〖1〗二十三年：建安二十三年（公元 218）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":403,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8cae36984cdc22e48444","start":0,"end":23,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o188","section":"chapter-001","block":"b-1336d4803d0b76311776","layer":"original","quote":"二十三年春正月〖1〗，汉太医令吉本与少府耿纪、司直韦晃等反〖2〗。攻许，烧丞相长史王必营〖3〗。﹝一﹞必与颍川典农中郎将严匡讨斩之〖4〗。﹝二﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":396,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":72,"offset_unit":"unicode_code_point"},{"id":"wudi-q-p139","section":"chapter-001","block":"b-66e857f79a5f5bdfcda8","layer":"pei","quote":"﹝二﹞《三辅决录注》曰：“时有京兆金祎，字德祎。自以世为汉臣，自日䃅讨莽何罗，忠诚显著，名节累叶。睹汉祚将移，谓可季兴；乃喟然发愤，遂与耿纪、韦晃、吉本、本子邈、邈弟穆等结谋。纪字季行。少有美名，为丞相掾，王甚敬异之。迁侍中，守少府。邈字文然，穆字思然；以祎慷慨有日!之风，又与王必善，因以间之。若杀必，欲挟天子以攻魏，南援刘备。时关羽强盛，而王在邺，留必典兵，督许中事。文然等率杂人及家僮千余人，夜烧门攻必。祎遣人为内应，射必中肩。必不知攻者为谁，以素与祎善，走投祎，夜唤‘德祎’。祎家不知是必，谓为文然等，错应曰：‘王长史已死乎？卿曹事立矣！’必乃更他路奔。一曰：必欲投祎，其帐下督谓必曰：‘今日事，竟知谁门而投入乎？’扶必奔南城。会天明，必犹在；文然等众散，故败。后十余日，必竟以创死。”","attribution":"《三辅决录注》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":418,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5fb0839b137ecdb9b177","start":0,"end":347,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-p030","section":"chapter-032","block":"b-27b35ca21b7ccf80c266","layer":"pei","quote":"﹝一﹞《三辅决录注》曰：“金旋字元机。京兆人。历位黄门郎，汉阳太守，征拜议郎，迁中郎将，领武陵太守；为备所攻劫，死。”子祎，事见《魏武本纪》。","attribution":"《三辅决录注》；裴注互见","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":156,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-2f79d10a3c631a893cc7","start":0,"end":71,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
