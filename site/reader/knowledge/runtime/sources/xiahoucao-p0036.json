{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xiahoucao-e-o023a","title":"曹仁鸡洛山击破韩荀","accounts":[{"id":"xiahoucao-e-o023a-account","label":"《诸夏侯曹传第九》正文","text":"曹仁鸡洛山击破韩荀","evidence":["xiahoucao-e-o023a-q"]}],"participants":[{"person":"cao-ren","role":"击破","evidence":["xiahoucao-e-o023a-q"]},{"person":"xiahoucao-p0036","role":"抄道被破","evidence":["xiahoucao-e-o023a-q"]}],"place":null,"time":{"label":"官渡至围壶关","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xiahoucao-e-o023a-q"]},"ordering_evidence":"xiahoucao-e-o023a-q","source_order":[9,119,"O023a"],"order":2180}],"persons":[{"id":"xiahoucao-p0036","name":"韩荀","evidence":["xiahoucao-q-o023"],"facts":[],"aliases":[],"mentions":[{"id":"xiahoucao-m-o023-xiahoucao-p0036","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-o023"]}]}],"evidence":[{"id":"xiahoucao-e-o023a-q","section":"chapter-009","block":"b-be6530e8cc3f581d07e6","layer":"original","quote":"绍遣别将韩荀，抄断西道；仁击荀于鸡洛山〖2〗，大破之。由是绍不敢复分兵出。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":118,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":37,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-o023","section":"chapter-009","block":"b-be6530e8cc3f581d07e6","layer":"original","quote":"绍遣别将韩荀，抄断西道；仁击荀于鸡洛山〖2〗，大破之。由是绍不敢复分兵出。复与史涣等抄绍运军，烧其粮谷。河北既定，从围壶关。太祖令曰：“城拔，皆坑之〖3〗！”连月不下。仁言于太祖曰：“围城，必示之活门〖4〗，所以开其生路也。今公告之必死，将人自为守；且城固而粮多，攻之则士卒伤，守之则引日久。今顿兵坚城之下，以攻必死之虏：非良计也！”太祖从之，城降；于是录仁前后功，封都亭侯。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":118,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":188,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
