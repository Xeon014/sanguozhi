angji-e-335b8c4532ba07ede2eb","title":"高堂隆、秦朗以白明帝，诏马钧作之，而指南车成，从是天下服其巧","accounts":[{"id":"fangji-a-335b8c4532ba07ede2eb","label":"裴注·傅玄序","text":"高堂隆、秦朗以白明帝，诏马钧作之，而指南车成，从是天下服其巧","evidence":["fangji-q-0064bca6105b7f173a09"]}],"participants":[{"person":"mingdi-p0041","role":"上白者","evidence":["fangji-q-0064bca6105b7f173a09"]},{"person":"mingdi-p0031","role":"上白者","evidence":["fangji-q-0064bca6105b7f173a09"]},{"person":"wendi-p0005","role":"诏作者","evidence":["fangji-q-0064bca6105b7f173a09"]},{"person":"fangji-p-55ecedfbf24014","role":"制车者","evidence":["fangji-q-0064bca6105b7f173a09"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["fangji-q-0064bca6105b7f173a09"]},"ordering_evidence":"fangji-q-0064bca6105b7f173a09","order":5944}],"persons":[{"id":"mingdi-p0031","name":"秦朗","evidence":["mingdi-q-o033","xiahoucao-q-p046","chengguo-q-1523903c75411dafc09b","chengguo-q-da19071eaa5b283f269b","fangji-q-df810d393c9734f4d1a3","fangji-q-0064bca6105b7f173a09","wuhuan-q-cfb1d29c968d96de0767"],"facts":[{"id":"mingdi-f0009","label":"字","text":"元明","evidence":["mingdi-q-p020"]},{"id":"mingdi-f0010","label":"籍贯","text":"新兴","evidence":["mingdi-q-p020"]},{"id":"mingdi-f0011","label":"父亲","text":"秦宜禄","evidence":["mingdi-q-p021"]},{"id":"mingdi-f0012","label":"母亲","text":"杜氏","evidence":["mingdi-q-p021"]},{"id":"mingdi-f0013","label":"小字","text":"阿稣","evidence":["mingdi-f0013-q"]}],"aliases":[{"text":"元明","evidence":["mingdi-q-p020"]},{"text":"阿稣","evidence":["mingdi-f0013-q"]}],"mentions":[{"id":"mingdi-m-o033-mingdi-p0031","kind":"mention","text":"文中提及","evidence":["mingdi-q-o033"]},{"id":"mingdi-m-o035-mingdi-p0031","kind":"mention","text":"文中提及","evidence":["mingdi-q-o035"]},{"id":"mingdi-m-p020-mingdi-p0031","kind":"mention","text":"文中提及","evidence":["mingdi-q-p020"]},{"id":"mingdi-m-p021-mingdi-p0031","kind":"mention","text":"文中提及","evidence":["mingdi-q-p021"]},{"id":"mingdi-m-p022-mingdi-p0031","kind":"mention","text":"文中提及","evidence":["mingdi-q-p022"]},{"id":"mingdi-m-p058-mingdi-p0031","kind":"mention","text":"文中提及","evidence":["mingdi-q-p058"]},{"id":"xiahoucao-m-p046-mingdi-p0031","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-p046"]}]}],"evidence":[{"id":"chengguo-q-1523903c75411dafc09b","section":"chapter-014","block":"b-a453325bbcfb30926f5f","layer":"original","quote":"其年，帝寝疾，欲以燕王宇为大将军，及领军将军夏侯献、武卫将军曹爽、屯骑校尉曹肇、骁骑将军秦朗共辅政〖1〗。宇性恭良，陈诚固辞","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":511,"anchor":null},"note_id":null,"start":0,"end":62},{"id":"chengguo-q-da19071eaa5b283f269b","section":"chapter-014","block":"b-0658bbe4420b47d45ac8","layer":"original","quote":"遂免宇、献、肇、朗官。太尉亦至，登床受诏，然后帝崩","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":512,"anchor":null},"note_id":null,"start":171,"end":196},{"id":"fangji-q-0064bca6105b7f173a09","section":"chapter-029","block":"b-40bea688ffe6c5badfbc","layer":"pei","quote":"二子遂以白明帝，诏先生作之，而指南车成。此一异也；又不可以言者也，从是天下服其巧矣","attribution":"裴注·傅玄序","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":181,"anchor":null},"note_id":"n-4a01e585e104c2660e3b","start":280,"end":321},{"id":"fangji-q-df810d393c9734f4d1a3","section":"chapter-029","block":"b-40bea688ffe6c5badfbc","layer":"pei","quote":"先生为给事中，与常侍高堂隆、骁骑将军秦朗，争论于朝。言及指南车，二子谓古无指南车，记言之虚也。先生曰：‘古有之！未之思耳，夫何远之有？’二子哂之曰：‘先生名钧字德衡：钧者器之模，而衡者所以定物之轻重；轻重无准而莫不模哉！’先生曰：‘虚争空言，不如试之易效也","attribution":"裴注·傅玄序","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":181,"anchor":null},"note_id":"n-4a01e585e104c2660e3b","start":148,"end":276},{"id":"mingdi-e-o033b-q","section":"chapter-003","block":"b-09dfeca953080b644d0d","layer":"original","quote":"比诏书到〖15〗，轨已进军屯阴馆〖16〗。遣将军苏尚、董弼追鲜卑。比能遣子将千余骑，迎步度根部落。与尚、弼相遇，战于楼烦〖17〗；二将没。步度根部落皆叛出塞，与比能合，寇边。遣骁骑将军秦朗将中军讨之〖18〗。虏乃走漠北。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":213,"anchor":null},"note_id":null,"start":0,"end":110},{"id":"mingdi-e-o035a-q","section":"chapter-003","block":"b-6d90bf5a6b24809ceff4","layer":"original","quote":"冬十月，步度根部落大人戴胡阿狼泥等，诣并州降。朗引军还。﹝二﹞","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":215,"anchor":null},"note_id":null,"start":0,"end":31},{"id":"mingdi-e-p021e-q","section":"chapter-003","block":"b-0b51273f0eff3bb164c4","layer":"pei","quote":"朗随母氏，蓄于公宫，太祖甚爱之。每坐席，谓宾客曰：‘世有人爱假子如孤者乎？","attribution":"裴注·献帝传","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":241,"anchor":null},"note_id":"n-9ebeadb65240878258aa","start":150,"end":187},{"id":"mingdi-e-p022a-q","section":"chapter-003","block":"b-75e72fb739f1c4a56dea","layer":"pei","quote":"朗游邀诸侯间，历武、文之世而无尤也。","attribution":"裴注·魏略","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":242,"anchor":null},"note_id":"n-9ebeadb65240878258aa","start":7,"end":25},{"id":"mingdi-e-p022b-q","section":"chapter-003","block":"b-75e72fb739f1c4a56dea","layer":"pei","quote":"及明帝即位，授以内官，为骁骑将军，给事中。每车驾出入，朗常随从。","attribution":"裴注·魏略","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":242,"anchor":null},"note_id":"n-9ebeadb65240878258aa","start":25,"end":57},{"id":"mingdi-e-p022c-q","section":"chapter-003","block":"b-75e72fb739f1c4a56dea","layer":"pei","quote":"帝亦以是亲爱，每顾问之，多呼其小字‘阿稣’；数加赏赐，为起大第于京城中。四方虽知朗无能为益，犹以附近至尊，多赂遗之，富均公侯。","attribution":"裴注·魏略","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":242,"anchor":null},"note_id":"n-9ebeadb65240878258aa","start":92,"end":155},{"id":"mingdi-e-p058a-q","section":"chapter-003","block":"b-479566b169dbc75ea2fe","layer":"pei","quote":"帝以燕王宇为大将军，使与领军将军夏侯献、武卫将军曹爽、屯骑校尉曹肇、骁骑将军秦朗等，对辅政。","attribution":"裴注·汉晋春秋","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":489,"anchor":null},"note_id":"n-3df5334abffeb752155c","start":12,"end":58},{"id":"mingdi-e-p058c-q","section":"chapter-003","block":"b-479566b169dbc75ea2fe","layer":"pei","quote":"放、资出，曹肇入，泣涕固谏，帝使肇敕停。肇出户，放、资趋而往，复说止帝，帝又从其言。放曰：‘宜为手诏。’帝曰：‘我困笃，不能。’放即上床，执帝手强作之；遂赍出，大言曰：‘有诏免燕王宇等官，不得停省中！’于是宇、肇、献、朗，相与泣而归第。","attribution":"裴注·汉晋春秋","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":489,"anchor":null},"note_id":"n-3df5334abffeb752155c","start":401,"end":519},{"id":"mingdi-f0013-q","section":"chapter-003","block":"b-75e72fb739f1c4a56dea","layer":"pei","quote":"阿稣","attribution":"裴注·魏略","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":242,"anchor":null},"note_id":"n-9ebeadb65240878258aa","start":110,"end":112},{"id":"mingdi-q-b-78ee587f18f11aa30bd9","section":"chapter-003","block":"b-78ee587f18f11aa30bd9","layer":"modern","quote":"〖1〗二年：景初二年（公元 238 ）。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":438,"anchor":null},"note_id":"n-917b5dc4aecce5a0dcf4","start":0,"end":20},{"id":"mingdi-q-b-7a11c761ca65aeb3d195","section":"chapter-003","block":"b-7a11c761ca65aeb3d195","layer":"modern","quote":"〖1〗二年：青龙二年（公元 234）。己未：旧历初四日。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":252,"anchor":null},"note_id":"n-6c0753fe684a18a3a281","start":0,"end":28},{"id":"mingdi-q-o030","section":"chapter-003","block":"b-cb99fef1996d806deb1c","layer":"original","quote":"青龙元年春正月，甲申〖1〗，青龙现郏之摩陂井中〖2〗。二月，丁酉〖3〗，幸摩陂观龙。于是改年，改摩陂为龙陂。赐男子爵，人二级；鳏寡孤独。无出今年租赋。三月，甲子〖4〗，诏公卿举贤良、笃行之士。各一人。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":210,"anchor":null},"note_id":null,"start":0,"end":100},{"id":"mingdi-q-o033","section":"chapter-003","block":"b-09dfeca953080b644d0d","layer":"original","quote":"比诏书到〖15〗，轨已进军屯阴馆〖16〗。遣将军苏尚、董弼追鲜卑。比能遣子将千余骑，迎步度根部落。与尚、弼相遇，战于楼烦〖17〗；二将没。步度根部落皆叛出塞，与比能合，寇边。遣骁骑将军秦朗将中军讨之〖18〗。虏乃走漠北。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":213,"anchor":null},"note_id":null,"start":0,"end":110},{"id":"mingdi-q-o035","section":"chapter-003","block":"b-6d90bf5a6b24809ceff4","layer":"original","quote":"冬十月，步度根部落大人戴胡阿狼泥等，诣并州降。朗引军还。﹝二﹞","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":215,"anchor":null},"note_id":null,"start":0,"end":31},{"id":"mingdi-q-o037","section":"chapter-003","block":"b-ff97c2d326d0fc08a9de","layer":"original","quote":"二年春二月，（乙）〔己〕未〖1〗，太白犯荧惑。癸酉〖2〗，诏曰：“‘鞭作官刑〖3〗’，所以纠慢怠也〖4〗；而顷多以无辜死。其减鞭杖之制〖5〗，著于令。”三月，庚寅〖6〗，山阳公薨；帝素服发哀〖7〗，遣使持节，典护丧事。己酉〖8〗，大赦。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":249,"anchor":null},"note_id":null,"start":0,"end":118},{"id":"mingdi-q-o059","section":"chapter-003","block":"b-5790b2efe14805978c50","layer":"original","quote":"二年春正月〖1〗，诏太尉司马宣王。率众讨辽东。﹝一﹞","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":434,"anchor":null},"note_id":null,"start":0,"end":26},{"id":"mingdi-q-p020","section":"chapter-003","block":"b-139978f322823255396b","layer":"pei","quote":"﹝二﹞《魏氏春秋》曰：“朗字元明。新兴人。”","attribution":"裴注·魏氏春秋","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":240,"anchor":null},"note_id":"n-9ebeadb65240878258aa","start":0,"end":22},{"id":"mingdi-q-p021","section":"chapter-003","block":"b-0b51273f0eff3bb164c4","layer":"pei","quote":"《献帝传》曰：“朗父，名宜禄。为吕布使诣袁术，术妻以汉宗室女。其前妻杜氏，留下邳。布之被围，关羽屡请于太祖，求以杜氏为妻。太祖疑其有色。及城陷，太祖见之，乃自纳之。宜禄归降，以为铚长。及刘备走小沛，张飞随之，过谓宜禄曰：‘人取汝妻，而为之长；乃蚩蚩若是邪！随我去乎？’宜禄从之数里，悔，欲还；飞杀之。朗随母氏，蓄于公宫，太祖甚爱之。每坐席，谓宾客曰：‘世有人爱假子如孤者乎？’”","attribution":"裴注·献帝传","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":241,"anchor":null},"note_id":"n-9ebeadb65240878258aa","start":0,"end":189},{"id":"mingdi-q-p022","section":"chapter-003","block":"b-75e72fb739f1c4a56dea","layer":"pei","quote":"《魏略》曰：“朗游邀诸侯间，历武、文之世而无尤也。及明帝即位，授以内官，为骁骑将军，给事中。每车驾出入，朗常随从。时明帝喜发举，数有以轻微而致大辟者；朗终不能有所谏止，又未尝进一善人。帝亦以是亲爱，每顾问之，多呼其小字‘阿稣’；数加赏赐，为起大第于京城中。四方虽知朗无能为益，犹以附近至尊，多赂遗之，富均公侯。”","attribution":"裴注·魏略","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":242,"anchor":null},"note_id":"n-9ebeadb65240878258aa","start":0,"end":156},{"id":"mingdi-q-p025-disputes","section":"chapter-003","block":"b-37447dd432015f9ac917","layer":"pei","quote":"鱼豢曰：“为上者不虚授，处下者不虚受。然后外无‘伐檀’之叹，内无尸素之刺；雍熙之美著，太平之律显矣。而佞幸之徒，但姑息人主；至乃无德而荣，无功而禄。如是焉得不使中正日朘，倾邪滋多乎！以武皇帝之慎赏，明皇帝之持法，而犹有若此等人，而况下斯者乎？”","attribution":"裴注·鱼豢曰","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":245,"anchor":null},"note_id":"n-9ebeadb65240878258aa","start":0,"end":122},{"id":"mingdi-q-p058","section":"chapter-003","block":"b-479566b169dbc75ea2fe","layer":"pei","quote":"﹝二﹞《汉晋春秋》曰：“帝以燕王宇为大将军，使与领军将军夏侯献、武卫将军曹爽、屯骑校尉曹肇、骁骑将军秦朗等，对辅政。中书监刘放、令孙资，久专权宠，为朗等素所不善，惧有后害，阴图间之；而宇常在帝侧，故未得有言。甲申，帝气微，宇下殿呼曹肇有所议，未还。而帝少间，惟曹爽独在。放知之，呼资与谋。资曰：‘不可动也！’放曰：‘俱入鼎镬，何不可之有？’乃突前见帝，垂泣曰：‘陛下气微，若有不讳，将以天下付谁？’帝曰：‘卿不闻用燕王耶？’放曰：‘陛下忘先帝诏敕：藩王不得辅政。且陛下方病，而曹肇、秦朗等便与才人侍疾者言戏；燕王拥兵南面，不听臣等入：此即竖刁、赵高也。今皇太子幼弱，未能统政；外有强暴之寇，内有劳怨之民。陛下不远虑存亡，而近系恩旧；委祖宗之业，付二三凡士；寝疾数日，外内壅隔；社稷危殆，而己不知：此臣等所以痛心也。’帝得放言，大怒曰：‘谁可任者？’放、资乃举爽代宇，又白‘宜诏司马宣王使相参’，帝从之。放、资出，曹肇入，泣涕固谏，帝使肇敕停。肇出户，放、资趋而往，复说止帝，帝又从其言。放曰：‘宜为手诏。’帝曰：‘我困笃，不能。’放即上床，执帝手强作之；遂赍出，大言曰：‘有诏免燕王宇等官，不得停省中！’于是宇、肇、献、朗，相与泣而归第。”","attribution":"裴注·汉晋春秋","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":489,"anchor":null},"note_id":"n-3df5334abffeb752155c","start":0,"end":520},{"id":"wuhuan-q-0364b595e9ceeba2c64c","section":"chapter-030","block":"b-4c5e8382612afb0fefda","layer":"original","quote":"比能遣子将骑与尚等会战于楼烦〖27〗，临阵害尚、弼","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":73,"anchor":null},"note_id":null,"start":54,"end":79},{"id":"wuhuan-q-604235d65ce57b8377c3","section":"chapter-030","block":"b-6c30f7f2ead157650caf","layer":"original","quote":"毕轨有陉北之败","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":4,"anchor":null},"note_id":null,"start":76,"end":83},{"id":"wuhuan-q-cfb1d29c968d96de0767","section":"chapter-030","block":"b-faa0eac8be27a9cd175d","layer":"original","quote":"帝遣骁骑将军秦朗征之","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":66,"anchor":null},"note_id":null,"start":71,"end":81},{"id":"xiahoucao-e-p046a-q","section":"chapter-009","block":"b-fe111e3fae52b8d8ff83","layer":"pei","quote":"太祖为司空时，纳晏母，并收养晏；其时秦宜禄儿阿苏，亦随母在公家，并见宠如公子；","attribution":"《魏略》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":385,"anchor":null},"note_id":"n-46a3d2d6a327171eb9f7","start":15,"end":54},{"id":"xiahoucao-q-p046","section":"chapter-009","block":"b-fe111e3fae52b8d8ff83","layer":"pei","quote":"﹝一﹞晏字平叔。《魏略》曰：“太祖为司空时，纳晏母，并收养晏；其时秦宜禄儿阿苏，亦随母在公家，并见宠如公子；苏即朗也。苏性谨慎。而晏无所顾惮，服饰拟于太子；故文帝特憎之，每不呼其姓字，常谓之为‘假子’。晏尚主，又好色，故黄初时无所事任。及明帝立，颇为冗官。至正始初，曲合于曹爽，亦以才能，故爽用为散骑侍郎，迁侍中、尚书。晏前以尚主，得赐爵为列侯。又其母在内，晏性自喜，动静粉白不去手，行步顾影。晏为尚书，主选举；其宿与之有旧者，多被拔擢。”","attribution":"《魏略》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":385,"anchor":null},"note_id":"n-46a3d2d6a327171eb9f7","start":0,"end":220}],"profiles":{},"directory_counts":{}}
