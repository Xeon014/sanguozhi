d":"yululu-q-3c8b2663c340a5f1d18a","section":"chapter-057","block":"b-7fa3bfa2381c889297d8","layer":"pei","quote":"﹝一﹞谢承《后汉书》曰：“康，字季宁。少敦孝悌，勤修操行。太守李肃察孝廉。肃后坐事伏法，康敛尸，送丧还颍川；行服，礼终。举茂才，历三郡太守，所在称治。后拜庐江太守。”","attribution":"裴注·谢承后汉书","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":154,"anchor":null},"note_id":"n-72a1f387a8ca12ae03b9","start":0,"end":83},{"id":"yululu-q-8672222a052e62289a5f","section":"chapter-057","block":"b-7fa3bfa2381c889297d8","layer":"pei","quote":"太守李肃察孝廉","attribution":"裴注·谢承《后汉书》","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":154,"anchor":null},"note_id":"n-72a1f387a8ca12ae03b9","start":29,"end":36}],"profiles":{},"directory_counts":{}}
