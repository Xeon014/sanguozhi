{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"hancui-e-f79f261790873569393f","title":"韩寿历清职惠帝时常侍河南尹病卒赠骠骑","accounts":[{"id":"hancui-a-f79f261790873569393f","label":"裴注·晋诸公赞","text":"韩寿历清职惠帝时常侍河南尹病卒赠骠骑","evidence":["hancui-q-3c3af35b6151677078ed"]}],"participants":[{"person":"hancui-p-f265949368f2ed","role":"任官去世","evidence":["hancui-q-3c3af35b6151677078ed"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["hancui-q-3c3af35b6151677078ed"]},"ordering_evidence":"hancui-q-3c3af35b6151677078ed","order":4902}],"persons":[{"id":"hancui-p-f265949368f2ed","name":"韩寿","evidence":["hancui-q-3c3af35b6151677078ed","hancui-q-2ad10c861310cb5f4555","hancui-q-ff21eabe1e0959b16bcc"],"facts":[{"id":"hancui-f-7a4ac8b353f34383e7ec","text":"字德贞，韩洪之子。","evidence":["hancui-q-2ad10c861310cb5f4555"]},{"id":"hancui-f-1be9031dec49eaeb7c5f","text":"妻为贾充之女。","evidence":["hancui-q-ff21eabe1e0959b16bcc"]}],"mentions":[],"aliases":[]}],"evidence":[{"id":"hancui-q-2ad10c861310cb5f4555","section":"chapter-024","block":"b-9d18cfaa5bd1a3916712","layer":"pei","quote":"﹝三﹞《楚国先贤传》曰：“邦字长林。少有才学。晋武帝时为野王令，有称绩。为新城太守，坐举野王故吏为新城计吏，武帝大怒，遂杀邦。暨次子繇，高阳太守。繇子洪，侍御史。洪子寿，字德贞。”","attribution":"裴注（引书见原文，待主审复核）","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":40,"anchor":null},"note_id":"n-d880aa7224b10e5780cc","start":0,"end":90},{"id":"hancui-q-3c3af35b6151677078ed","section":"chapter-024","block":"b-06df52ef50d0f265d90d","layer":"pei","quote":"寿能敦尚家风，性尤忠厚。早历清职，惠帝践阼，为散骑常侍，迁守河南尹。病卒，赠骠骑将军。","attribution":"裴注·晋诸公赞","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":41,"anchor":null},"note_id":"n-d880aa7224b10e5780cc","start":19,"end":62},{"id":"hancui-q-ff21eabe1e0959b16bcc","section":"chapter-024","block":"b-06df52ef50d0f265d90d","layer":"pei","quote":"《晋诸公赞》曰：“自暨以下，世治素业；寿能敦尚家风，性尤忠厚。早历清职，惠帝践阼，为散骑常侍，迁守河南尹。病卒，赠骠骑将军。寿妻贾充女。充无后，以寿子谧为嗣。弱冠为秘书监、侍中，性骄佚而才出（众）〔寿〕。少子蔚，亦有器望，并为赵王伦所诛。韩氏遂灭。”","attribution":"裴注（引书见原文，待主审复核）","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":41,"anchor":null},"note_id":"n-d880aa7224b10e5780cc","start":0,"end":125}],"profiles":{},"directory_counts":{}}
