372,25],"order":2666},{"id":"yuanzhang-e2-guanning-huangchu-refusal","title":"管宁在黄初间辞太中大夫书","accounts":[{"id":"yuanzhang-a-d2a63d987350734a171e","label":"裴注·《傅子》","text":"管宁上书天子且以疾辞，自陈器朽非其人，唯陛下听野人山薮之愿使一老者得尽微命；书奏，帝亲览焉","evidence":["yuanzhang-q-97fee36b4d2f35942a64","yuanzhang-q2-b4e2a87018f3a437a49a"]}],"participants":[{"person":"huanchen-p0600","role":"上书以疾辞太中大夫","evidence":["yuanzhang-q2-b4e2a87018f3a437a49a"]},{"person":"wudi-p0170","role":"亲览管宁辞书","evidence":["yuanzhang-q2-b4e2a87018f3a437a49a"]}],"place":null,"time":{"label":"黄初间","precision":"undated","basis":"第二轮逐项审定；仅保原文时序，不另行推年。","evidence":["yuanzhang-q2-b4e2a87018f3a437a49a"]},"ordering_evidence":"yuanzhang-q2-b4e2a87018f3a437a49a","order":2668},{"id":"yuanzhang-e-o196","title":"司空陈群又荐管宁，谓其行为世表学任人师，昔司空荀爽家拜光禄、先儒郑玄即授司农，若加备礼庶必可致","accounts":[{"id":"yuanzhang-a-b56d755c10c98c991922","label":"裴注·傅子","text":"司空陈群又荐管宁，谓其行为世表学任人师，昔司空荀爽家拜光禄、先儒郑玄即授司农，若加备礼庶必可致","evidence":["yuanzhang-q-3e218899e0f67f7e7c5e"]}],"participants":[{"person":"wudi-p0394","role":"司空，又荐管宁曰王者显善以消恶，管宁行为世表学任人师，清俭足以激浊贞正足以矫时，若加备礼庶必可致，至延西序坐而论道，必能昭明古今有益大化","evidence":["yuanzhang-q-3e218899e0f67f7e7c5e"]},{"person":"huanchen-p0600","role":"被荐","evidence":["yuanzhang-q-3e218899e0f67f7e7c5e"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["yuanzhang-q-3e218899e0f67f7e7c5e"]},"ordering_evidence":"yuanzhang-q-3e218899e0f67f7e7c5e","source_order":[11,452,10],"order":2669},{"id":"yuanzhang-e-o124","title":"正始二年太仆陶丘一、永宁卫尉孟观、侍中孙邕、中书侍郎王基荐管宁","accounts":[{"id":"yuanzhang-a-4db7a53057525e2c8ecb","label":"正文","text":"正始二年太仆陶丘一、永宁卫尉孟观、侍中孙邕、中书侍郎王基荐管宁","evidence":["yuanzhang-q-9fc46c59b6aa1a06e627","yuanzhang-q2-7cf5f97120342f47c0bd","yuanzhang-q-ccf34ec361ad9c34c6a4","yuanzhang-q-7ac388ceff886135beaa","yuanzhang-q-9ccfc913e7b2f88022ec","yuanzhang-q-116769d2cec0f534e518"]},{"id":"yuanzhang-a-b2f15ee41bbff19d29ac","label":"正文","text":"朝廷特具安车蒲轮束帛加璧聘管宁，会宁卒，时年八十四","evidence":["yuanzhang-q-76de27cc3a