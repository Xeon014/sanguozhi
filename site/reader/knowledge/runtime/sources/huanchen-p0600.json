40","yuanzhang-q-f3e693cb8a541deb2815","yuanzhang-q-e256e7a7fee189971f22","yuanzhang-q-9b16e2e766c9994eee03","yuanzhang-q-870cd6af7bf3c206c73f","yuanzhang-q-d001cc765ba4361532f4","yuanzhang-q-ea624a9e4f8c6e81ea55","yuanzhang-q-4e962d844b6061aa3815","yuanzhang-q-26c9976a1e90e01b3c72","yuanzhang-q-0b3c5d94d0fe50f70fa1","yuanzhang-q-caf00b93a919d6058a01","yuanzhang-q-be22d0ef68d4175b3ea7","yuanzhang-q-9277ae83f0980206a079","yuanzhang-q-ab1a7eb2b5deac834bf8","yuanzhang-q-9fc46c59b6aa1a06e627","yuanzhang-q-76de27cc3a9657f336e7","yuanzhang-q-94f6027c43150af08126","yuanzhang-q-7e7d7673b4f816bff292","yuanzhang-q-3ba3654f9591bb797dac","yuanzhang-q-ab6efe2feb64b59741c3","yuanzhang-q-095630647e5512d28391","yuanzhang-q-87d4f9c5b0e3f715babb","yuanzhang-q-093b09c6157e1c3a725a","yuanzhang-q-97fee36b4d2f35942a64","yuanzhang-q-3e218899e0f67f7e7c5e","yuanzhang-q2-db124d37ba72335b623b","yuanzhang-q2-534949b6cf0b2ca24b09","yuanzhang-q2-b4e2a87018f3a437a49a","yuanzhang-q2-3b1407de0400f0eb9842","yuanzhang-q2-7c54efa4d4bce24f293b","yuanzhang-q-1729f3a64a93ba40463d","yuanzhang-q2-83dce85c759b9f584e13","zhonghua-q-56166747e6635aa4db2c","zhonghua-q-0fb88afa76c0ce8eb2c8","zhonghua-q-8d5ceded576c523be7f2"],"facts":[{"id":"yuanzhang-f2-9aab896c530b9988d127","text":"管宁十六岁丧父，辞谢中表赠赗，称财以送终。","evidence":["yuanzhang-q2-db124d37ba72335b623b"]},{"id":"yuanzhang-f2-9cbdecc8bf5ca175fa81","text":"自黄初至青龙，管宁征命相仍，常以八月赐牛酒。","evidence":["yuanzhang-q2-7c54efa4d4bce24f293b"]},{"id":"yuanzhang-f2-e37b30ee292cee33a717","text":"管宁妻先卒，知故劝其更娶，管宁拒绝。","evidence":["yuanzhang-q-1729f3a64a93ba40463d"]},{"id":"yuanzhang-f2-17efffcb21579e0451d1","text":"《傅子》记管宁著《氏姓论》，以原本世系。","evidence":["yuanzhang-q2-83dce85c759b9f584e13"]}],"aliases":[],"mentions":[]}],"evidence":[{"id":"huanchen-q-0eead8a94bea2511cebc","section":"chapter-022","block":"b-34d411f478d6319156f9","layer":"original","quote":"会司徒缺，毓举处士管宁〖28〗；帝不能用，更问其次。毓对曰：“敦笃至行〖29〗，则太中大夫韩暨〖30〗；亮直清方，则司隶校尉崔林〖31〗；贞固纯粹，则太常常林〖32〗。”帝乃用暨","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":545,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":89,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-00d48f5c3d0b7a24b6ea","section":"chapter-011","block":"b-616f1086bdb6d3f6ca69","layer":"original","quote":"原在辽东，一年中往归原居者数百家。游学之士，教授之声，不绝。后得归","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":314,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":248,"end":281,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-093b09c6157e1c3a725a","section":"chapter-011","block":"b-1157405894aaf96d21ad","layer":"pei","quote":"宁之归也，海中遇暴风；船皆没，唯宁乘船自若。时夜风晦冥，船人尽惑，莫知所泊。望见有火光，辄趋之，得岛。岛无居人，又无火烬；行人咸异焉，以为神光之祐也。皇甫谧曰：‘积善之应也","attribution":"裴注·傅子","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":449,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4555308644cb020df99a","start":134,"end":220,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-095630647e5512d28391","section":"chapter-011","block":"b-bbcb362d43169663aed0","layer":"pei","quote":"邻有牛暴宁田者，宁为牵牛着凉处；自为饮食，过于牛主。牛主得牛，大惭，若犯严刑。是以左右无斗讼之声，礼让移于海表","attribution":"裴注·高士传","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":364,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4958052ff2433e6ba0c5","start":81,"end":136,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-0b3c5d94d0fe50f70fa1","section":"chapter-011","block":"b-7ec1147e78995618cd18","layer":"original","quote":"遂下诏曰：“太中大夫管宁，耽怀道德，服膺六艺〖8〗；清虚足以侔古，廉白可以当世〖9〗。曩遭王道衰缺，浮海遁居；大魏受命，则襁负而至。斯盖应龙潜升之道〖10〗，圣贤用舍之义〖11〗。而黄初以来，征命屡下；每辄辞疾，拒违不至。岂朝廷之政与生殊趣〖12〗？将安乐山林往而不能反乎？夫以姬公之圣〖13〗，而耇德不降〖14〗，则鸣鸟弗闻〖15〗；﹝四﹞以秦穆之贤〖16〗，犹思询乎黄发〖17〗；况朕寡德，曷能不愿闻道于子大夫哉〖18〗？今以宁为光禄勋。礼有大伦，君臣之道，不可废也。望必速至，称朕意焉","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":368,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":17,"end":262,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-0d22c803e6c58ab1b140","section":"chapter-011","block":"b-abe7b500f4f4124ac69f","layer":"original","quote":"俱游学于异国〖3〗，并敬善陈仲弓","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":349,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":72,"end":88,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-116769d2cec0f534e518","section":"chapter-011","block":"b-6d1785356eb094c9ba08","layer":"original","quote":"陛下践阼，纂承洪绪；圣敬日跻〖28〗，超越周成。每发德音〖29〗，动咨师傅〖30〗。若继二祖招贤故典，宾礼俊迈〖31〗，以广缉熙〖32〗；济济之化，侔于前代。宁清高恬泊，拟迹前轨；德行卓绝，海内无偶。历观前世玉帛所命〖33〗，申公、枚乘、周党、樊英之俦〖34〗，测其渊源，览其清浊，未有厉俗独行若宁者也！诚宜束帛加壁，备礼征聘；仍授几杖〖35〗，延登东序〖36〗；敷陈坟素〖37〗，坐而论道；上正璇玑〖38〗，协和皇极〖39〗；下阜群生〖40〗，彝伦攸叙〖41〗：必有可观，光益大化。若宁固执匪石〖42〗，守志箕山〖43〗；追迹洪崖〖44〗，参踪巢、许〖45〗：斯亦圣朝同符唐、虞，“优贤扬历”，垂声千载。﹝一﹞虽出处殊途〖46〗，俯仰异体〖47〗，至于兴治美俗，其揆一也〖48〗。","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":458,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":341,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-1729f3a64a93ba40463d","section":"chapter-011","block":"b-3a46835dd7aae03d0e13","layer":"original","quote":"初，宁妻先卒，知故劝更娶。宁曰：“每省曾子、王骏之言〖2〗，意常嘉之。岂自遭之而违本心哉！”﹝一﹞","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":511,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":49,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-2645ac79f46eac1dd463","section":"chapter-011","block":"b-7b0114ba34710b1e2f4e","layer":"modern","quote":"〖34〗积祀：一年又一年相加。纪：十二年。从黄初四年（公元223）初受魏文帝征召，到管宁上疏的青龙三年（公元 235），历时十二年。","attribution":"现代注释","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":407,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-92f25d2835b168ed1f96","start":0,"end":66,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-26c9976a1e90e01b3c72","section":"chapter-011","block":"b-7ec1147e78995618cd18","layer":"original","quote":"明帝即位，太尉华歆逊位让宁","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":368,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":13,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-3ba3654f9591bb797dac","section":"chapter-011","block":"b-1e77d6c23c1dd6d6ec82","layer":"pei","quote":"度庶子康，代居郡，外以将军、太守为号，而内实有王心；卑己崇礼，欲官宁以自镇辅；而终莫敢发言，其敬惮如此","attribution":"裴注·傅子","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":363,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4958052ff2433e6ba0c5","start":153,"end":204,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-3e218899e0f67f7e7c5e","section":"chapter-011","block":"b-79af5a0b86af92b125fb","layer":"pei","quote":"司空陈群又荐宁曰：‘臣闻王者显善以消恶，故汤举伊尹，不仁者远。伏见征士北海管宁，行为世表，学任人师；清俭足以激浊，贞正足以矫时。前虽征命，礼未优备。昔司空荀爽，家拜光禄；先儒郑玄，即授司农。若加备礼，庶必可致。至延西序，坐而论道；必能昭明古今，有益大化","attribution":"裴注·傅子","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":451,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-d33d0f6d67abfe0a1dd2","start":10,"end":136,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-4e962d844b6061aa3815","section":"chapter-011","block":"b-ce968cc1eb7efd4702c2","layer":"original","quote":"诏以宁为太中大夫，固辞不受","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":367,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":101,"end":114,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-76de27cc3a9657f336e7","section":"chapter-011","block":"b-7c7ba6e367b1d9ebee88","layer":"original","quote":"于是特具安车蒲轮〖1〗，束帛加璧，聘焉。会宁卒，时年八十四","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":510,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":29,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-7ac388ceff886135beaa","section":"chapter-011","block":"b-faa3745399a3922ed71b","layer":"original","quote":"黄初四年，高祖文皇帝畴咨群公〖14〗，思求俊乂；故司徒华歆，举宁应选。公车特征，振翼遐裔〖15〗，翻然来翔〖16〗。行遇屯厄〖17〗，遭罹疾病，即拜太中大夫。烈祖明皇帝嘉美其德，登为光禄勋。宁疾弥留，未能进道。","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":456,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":105,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-7e7d7673b4f816bff292","section":"chapter-011","block":"b-1e77d6c23c1dd6d6ec82","layer":"pei","quote":"邴原性刚直，清议以格物；度以下，心不安之。宁谓原曰：‘潜龙以不现成德；言非其时，皆招祸之道也。’密遣令西还","attribution":"裴注·傅子","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":363,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4958052ff2433e6ba0c5","start":99,"end":152,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-870cd6af7bf3c206c73f","section":"chapter-011","block":"b-ce968cc1eb7efd4702c2","layer":"original","quote":"黄初四年，诏公卿举独行君子〖4〗。司徒华歆荐宁，文帝即（位）征宁","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":367,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":32,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-87d4f9c5b0e3f715babb","section":"chapter-011","block":"b-1157405894aaf96d21ad","layer":"pei","quote":"是时，康又已死，嫡子不立而立弟恭；恭懦弱，而康孽子渊有俊才。宁曰：‘废嫡立庶，下有异心，乱之所由起也。’乃将家属乘海即受征。宁在辽东，积三十七年乃归","attribution":"裴注·傅子","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":449,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4555308644cb020df99a","start":10,"end":84,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-9277ae83f0980206a079","section":"chapter-011","block":"b-d1f46b7b0bdcfde12b96","layer":"original","quote":"诏书问青州刺史程喜：“宁为守节高乎？审老疾尪顿邪","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":371,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":25,"end":49,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-94f6027c43150af08126","section":"chapter-011","block":"b-1e77d6c23c1dd6d6ec82","layer":"pei","quote":"宁往见度，语惟经典，不及世事。还，乃因山为庐，凿坏为室。越海避难者，皆来就之而居，旬月而成邑。遂讲《诗》、《书》，陈俎豆，饰威仪，明礼让；非学者，无见也。由是度安其贤，民化其德","attribution":"裴注·傅子","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":363,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4958052ff2433e6ba0c5","start":10,"end":98,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-97fee36b4d2f35942a64","section":"chapter-011","block":"b-4dba43c0647ed8875d56","layer":"pei","quote":"宁上书天子，且以疾辞，曰：‘臣闻傅说发梦，以感殷宗；吕尚启兆，以动周文。以通神之才悟于圣主，用能匡佐帝业，克成大勋。臣之器朽，实非其人。虽贪清时，释体蝉蜕；内省顽病，日薄西山。唯陛下听野人山薮之愿，使一老者得尽微命。’书奏，帝亲览焉","attribution":"裴注·傅子","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":450,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6d5ea36118d8e505b78e","start":10,"end":126,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-9b16e2e766c9994eee03","section":"chapter-011","block":"b-c95cfb5d17dd1992e875","layer":"original","quote":"太祖为司空，辟宁；度子康绝命〖6〗，不宣","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":350,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":77,"end":97,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-9ccfc913e7b2f88022ec","section":"chapter-011","block":"b-8959b7718d31ce0345c9","layer":"original","quote":"今宁旧疾已瘳，行年八十，志无衰倦。环堵筚门〖18〗，偃息穷巷；饭粥糊口，并日而食〖19〗；吟咏《诗》、《书》，不改其乐。困而能通，遭难必济；经危蹈险，不易其节；金声玉色，久而弥彰。揆其终始〖20〗，殆天所祚〖21〗；当赞大魏，辅亮雍熙〖22〗。衮职有阙〖23〗，群下属望。昔高宗刻像〖24〗，营求贤哲；周文启龟〖25〗，以卜良佐。况宁前朝所表〖26〗，名德已著？而久栖迟，未时引致〖27〗；非所以奉遵明训，继成前志也。","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":457,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":209,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-9fc46c59b6aa1a06e627","section":"chapter-011","block":"b-21547c603887cde78a80","layer":"original","quote":"正始二年，太仆陶丘一、永宁卫尉孟观、侍中孙邕、中书侍郎王基荐宁曰","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":454,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":32,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-ab1a7eb2b5deac834bf8","section":"chapter-011","block":"b-d6e7c7a8724164a02321","layer":"original","quote":"喜上言：“宁有族人管贡，为州吏，与宁邻比；臣常使经营消息〖66〗。贡说：‘宁常著皂帽、布襦袴、布裙〖67〗，随时单复；出入闺庭〖68〗，能自任杖〖69〗，不须扶持。四时祠祭，辄自力强〖70〗；改加衣服，著絮巾、故在辽东所有白布单衣；亲荐馔馈〖71〗，跪拜成礼。宁少而丧母，不识形象；常特加觞〖72〗，泫然流涕。又居宅离水七八十步，夏时诣水中澡洒手足，窥于园圃。’臣揆宁前后辞让之意，独自以生长潜逸，耆艾智衰〖73〗；是以栖迟〖74〗，每执谦退。此宁志行所欲必全，不为守高","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":372,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":235,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-ab6efe2feb64b59741c3","section":"chapter-011","block":"b-bbcb362d43169663aed0","layer":"pei","quote":"宁所居屯落，会井汲者，或男女杂错，或争井斗阋。宁患之，乃多买器，分置井傍；汲以待之，又不使知。来者得而怪之，问知宁所为；乃各相责，不复斗讼","attribution":"裴注·高士传","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":364,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4958052ff2433e6ba0c5","start":11,"end":80,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-be22d0ef68d4175b3ea7","section":"chapter-011","block":"b-0a6811d4a5c8ea4095a1","layer":"original","quote":"宁称草莽臣上疏曰〖30〗：“臣海滨孤微，疲农无伍〖31〗，禄运幸厚；横蒙陛下纂承洪绪〖32〗，德侔三皇，化溢有唐〖33〗。久荷渥泽，积祀一纪〖34〗，不能仰答陛下恩养之福；沈委笃疴〖35〗，寝疾弥留〖36〗，逋违臣隶颠倒之节〖37〗：夙宵战怖，无地自厝〖38〗！臣元年十一月被公车司马令所下州郡〖39〗，八月甲申诏书征臣〖40〗，更赐安车、衣被、茵蓐，以礼发遣；光宠并臻，优命屡至；怔营竦息〖41〗，悼心失图〖42〗。思自陈闻，申展愚情；而明诏抑割〖43〗，不令稍修章表〖44〗；是以郁滞〖45〗，讫于今日。诚谓乾覆〖46〗，恩有纪极〖47〗；不意灵润〖48〗，弥以隆赫。奉今年二月被州郡所下三年十二月辛酉诏书〖49〗，重赐安车、衣服，别驾从事与郡功曹以礼发遣；又特被玺书，以臣为光禄勋；躬秉劳谦〖50〗，引喻周、秦〖51〗，损上益下。受诏之日，精魄飞散，靡所投死〖52〗！臣重自省揆〖53〗：德非园、绮而蒙安车之荣〖54〗；功无窦融而蒙玺封之宠。楶棁驽下〖55〗，荷栋梁之任；垂没之命，获九棘之位〖56〗：惧有朱博鼓妖之眚〖57〗。又年疾日侵〖58〗，有加无损〖59〗，不任扶舆进路以塞元责〖60〗。望慕阊阖〖61〗，徘徊阙庭；谨拜章陈情，乞蒙哀省：抑恩听放〖62〗，无令骸骨填于衢路","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":370,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":543,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-caf00b93a919d6058a01","section":"chapter-011","block":"b-93f2fcb4713537343689","layer":"original","quote":"又诏青州刺史曰：“宁抱道怀贞，潜翳海隅〖19〗；比下征书，违命不至；盘桓利居〖20〗，高尚其事〖21〗。虽有素履幽人之贞〖22〗，而失考父兹恭之义〖23〗；使朕虚心引领历年〖24〗，其何谓邪！徒欲怀安，必肆其志〖25〗；不惟古人亦有翻然改节，以隆斯民乎？日逝月除，时方已过；澡身浴德〖26〗，将以曷为？仲尼有言：‘吾非斯人之徒与而谁与哉〖27〗！’其命别驾从事、郡丞掾：奉诏，以礼发遣宁诣行在所〖28〗；给安车、吏从、茵蓐、道上厨食〖29〗。上道，先奏","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":369,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":226,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-cb8ab5567cb4f67d84bf","section":"chapter-011","block":"b-1ad789bdace89caad2f6","layer":"original","quote":"后与邴原、管宁等避乱辽东","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":133,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":23,"end":35,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-ccf34ec361ad9c34c6a4","section":"chapter-011","block":"b-8e42aa43e7ee448b3af5","layer":"original","quote":"臣闻龙凤隐耀〖2〗，应德而臻；明哲潜遁，俟时而动。是以鸑鷟鸣岐〖3〗，周道隆兴；四皓为佐，汉帝用康〖4〗。伏见太中大夫管宁，应二仪之中和〖5〗，总九德之纯懿〖6〗；含章素质〖7〗，冰洁渊清；玄虚澹泊，与道逍遥；娱心黄、老〖8〗，游志六艺；升堂入室，究其阃奥〖9〗；韬古今于胸怀，包道德之机要。中平之际，黄巾陆梁；华夏倾荡，王纲弛顿。遂避时难，乘桴越海；羁旅辽东，三十余年。在乾之姤〖10〗，匿景藏光；嘉遁养浩〖11〗，韬韫儒墨〖12〗；潜化傍流，畅于殊俗〖13〗。","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":455,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":232,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-d001cc765ba4361532f4","section":"chapter-011","block":"b-ce968cc1eb7efd4702c2","layer":"original","quote":"遂将家属，浮海还郡〖5〗；公孙恭送之南郊〖6〗，加赠服物","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":367,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":33,"end":61,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-e256e7a7fee189971f22","section":"chapter-011","block":"b-c95cfb5d17dd1992e875","layer":"original","quote":"既往见度，乃庐于山谷。时避难者，多居郡南；而宁居北，示无迁志〖5〗，后渐来从之","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":350,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":37,"end":76,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-ea624a9e4f8c6e81ea55","section":"chapter-011","block":"b-ce968cc1eb7efd4702c2","layer":"original","quote":"自宁之东也，度、康、恭前后所资遗，皆受而藏诸；既已西渡，尽封还之","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":367,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":65,"end":97,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-f1b5e6b1fe5404f0e36f","section":"chapter-011","block":"b-f117f39bbee4400e1c45","layer":"pei","quote":"积十余年，后乃遁还。南行已数日，而度甫觉。度知原之不可复追也，因曰：‘邴君所谓云中白鹤，非鹑鷃之网所能罗矣！又吾自遣之，勿复求也。’遂免危难","attribution":"裴注·原别传","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":341,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-73e160afdb3d08400061","start":369,"end":439,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-f3e693cb8a541deb2815","section":"chapter-011","block":"b-c95cfb5d17dd1992e875","layer":"original","quote":"天下大乱，闻公孙度令行于海外，遂与原及平原王烈等，至于辽东。度虚馆以候之","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":350,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":36,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q2-3b1407de0400f0eb9842","section":"chapter-011","block":"b-0a6811d4a5c8ea4095a1","layer":"original","quote":"宁称草莽臣上疏曰〖30〗：“臣海滨孤微，疲农无伍〖31〗，禄运幸厚；横蒙陛下纂承洪绪〖32〗，德侔三皇，化溢有唐〖33〗。久荷渥泽，积祀一纪〖34〗，不能仰答陛下恩养之福；沈委笃疴〖35〗，寝疾弥留〖36〗，逋违臣隶颠倒之节〖37〗：夙宵战怖，无地自厝〖38〗！臣元年十一月被公车司马令所下州郡〖39〗，八月甲申诏书征臣〖40〗，更赐安车、衣被、茵蓐，以礼发遣；光宠并臻，优命屡至；怔营竦息〖41〗，悼心失图〖42〗。思自陈闻，申展愚情；而明诏抑割〖43〗，不令稍修章表〖44〗；是以郁滞〖45〗，讫于今日。诚谓乾覆〖46〗，恩有纪极〖47〗；不意灵润〖48〗，弥以隆赫。奉今年二月被州郡所下三年十二月辛酉诏书〖49〗，重赐安车、衣服，别驾从事与郡功曹以礼发遣；又特被玺书，以臣为光禄勋；躬秉劳谦〖50〗，引喻周、秦〖51〗，损上益下。受诏之日，精魄飞散，靡所投死〖52〗！臣重自省揆〖53〗：德非园、绮而蒙安车之荣〖54〗；功无窦融而蒙玺封之宠。楶棁驽下〖55〗，荷栋梁之任；垂没之命，获九棘之位〖56〗：惧有朱博鼓妖之眚〖57〗。又年疾日侵〖58〗，有加无损〖59〗，不任扶舆进路以塞元责〖60〗。望慕阊阖〖61〗，徘徊阙庭；谨拜章陈情，乞蒙哀省：抑恩听放〖62〗，无令骸骨填于衢路〖63〗。”","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":370,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":549,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q2-534949b6cf0b2ca24b09","section":"chapter-011","block":"b-93f2fcb4713537343689","layer":"original","quote":"又诏青州刺史曰：“宁抱道怀贞，潜翳海隅〖19〗；比下征书，违命不至；盘桓利居〖20〗，高尚其事〖21〗。虽有素履幽人之贞〖22〗，而失考父兹恭之义〖23〗；使朕虚心引领历年〖24〗，其何谓邪！徒欲怀安，必肆其志〖25〗；不惟古人亦有翻然改节，以隆斯民乎？日逝月除，时方已过；澡身浴德〖26〗，将以曷为？仲尼有言：‘吾非斯人之徒与而谁与哉〖27〗！’其命别驾从事、郡丞掾：奉诏，以礼发遣宁诣行在所〖28〗；给安车、吏从、茵蓐、道上厨食〖29〗。上道，先奏。”","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":369,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":228,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q2-5c55926811b00d1b1965","section":"chapter-011","block":"b-ce968cc1eb7efd4702c2","layer":"original","quote":"黄初四年，诏公卿举独行君子〖4〗。司徒华歆荐宁，文帝即（位）征宁。遂将家属，浮海还郡〖5〗；公孙恭送之南郊〖6〗，加赠服物〖7〗。自宁之东也，度、康、恭前后所资遗，皆受而藏诸；既已西渡，尽封还之。﹝一﹞诏以宁为太中大夫，固辞不受。﹝二﹞","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":367,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":118,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q2-7c54efa4d4bce24f293b","section":"chapter-011","block":"b-d1f46b7b0bdcfde12b96","layer":"original","quote":"自黄初至于青龙，征命相仍〖64〗；常以八月赐牛酒。诏书问青州刺史程喜：“宁为守节高乎？审老疾尪顿邪〖65〗？”","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":371,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":55,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q2-7cf5f97120342f47c0bd","section":"chapter-011","block":"b-21547c603887cde78a80","layer":"original","quote":"正始二年，太仆陶丘一、永宁卫尉孟观、侍中孙邕、中书侍郎王基荐宁曰〖1〗：","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":454,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":36,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q2-83dce85c759b9f584e13","section":"chapter-011","block":"b-e7be6e811f1b6aeebee9","layer":"pei","quote":"﹝一﹞《傅子》曰：“宁以衰乱之时，世多妄变氏族者；违圣人之制，非礼命姓之意；故著《氏姓论》以原本世系。文多不载。每所居姻亲、知旧、邻里，有困穷者，家储虽不盈担石，必分以赡救之。与人子言，教以孝；与人弟言，训以悌；言及人臣，诲以忠：貌甚恭，言甚顺。观其行，邈然若不可及；即之熙熙然，甚柔而温，因其事而导之于善。是以渐之者，无不化焉。宁之亡，天下知与不知，闻之无不嗟叹。醇德之所感若此，不亦至乎！”","attribution":"裴注（引书见原文）","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":517,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6a395eb64a1c5d04fe1a","start":0,"end":197,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q2-b4e2a87018f3a437a49a","section":"chapter-011","block":"b-4dba43c0647ed8875d56","layer":"pei","quote":"﹝二﹞《傅子》曰：“宁上书天子，且以疾辞，曰：‘臣闻傅说发梦，以感殷宗；吕尚启兆，以动周文。以通神之才悟于圣主，用能匡佐帝业，克成大勋。臣之器朽，实非其人。虽贪清时，释体蝉蜕；内省顽病，日薄西山。唯陛下听野人山薮之愿，使一老者得尽微命。’书奏，帝亲览焉。”","attribution":"裴注（引书见原文）","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":450,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6d5ea36118d8e505b78e","start":0,"end":128,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q2-db124d37ba72335b623b","section":"chapter-011","block":"b-abe7b500f4f4124ac69f","layer":"original","quote":"管宁字幼安，北海朱虚人也。﹝一﹞年十六丧父，中表愍其孤贫，咸共赠赗〖1〗；悉辞不受，称财以送终〖2〗。长八尺，美须眉。与平原华歆、同县邴原相友；俱游学于异国〖3〗，并敬善陈仲弓〖4〗。","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":349,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":92,"offset_unit":"unicode_code_point"},{"id":"zhonghua-q-0fb88afa76c0ce8eb2c8","section":"chapter-013","block":"b-48f8b0c1357b75285720","layer":"original","quote":"歆称病乞退，让位于宁。帝不许。","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":193,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":32,"end":47,"offset_unit":"unicode_code_point"},{"id":"zhonghua-q-56166747e6635aa4db2c","section":"chapter-013","block":"b-a9855a57d7396cfcab6d","layer":"original","quote":"黄初中，诏公卿举独行君子；歆举管宁，帝以安东征之。","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":178,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":25,"offset_unit":"unicode_code_point"},{"id":"zhonghua-q-8d5ceded576c523be7f2","section":"chapter-013","block":"b-8dc73a900dbd0ce1cb7a","layer":"pei","quote":"歆与北海邴原、管宁，俱游学。三人相善，时人号三人为‘一龙’：歆为龙头，原为龙腹，宁为龙尾。”","attribution":"裴注·魏略","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":170,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5cff6c48e8e36da8ac0b","start":10,"end":56,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
