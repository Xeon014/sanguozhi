023"]},{"id":"guanzhang-m-p024-xianzhu-p0034","kind":"mention","text":"文中提及","evidence":["guanzhang-q-p024"]},{"id":"guanzhang-m-p025-xianzhu-p0034","kind":"mention","text":"文中提及","evidence":["guanzhang-q-p025"]},{"id":"guanzhang-m-o044-xianzhu-p0034","kind":"mention","text":"文中提及","evidence":["guanzhang-q-o044"]},{"id":"guanzhang-m-o045-xianzhu-p0034","kind":"mention","text":"文中提及","evidence":["guanzhang-q-o045"]},{"id":"guanzhang-m-o046-xianzhu-p0034","kind":"mention","text":"文中提及","evidence":["guanzhang-q-o046"]},{"id":"guanzhang-m-p026-xianzhu-p0034","kind":"mention","text":"文中提及","evidence":["guanzhang-q-p026"]},{"id":"guanzhang-m-o048-xianzhu-p0034","kind":"mention","text":"文中提及","evidence":["guanzhang-q-o048"]},{"id":"guanzhang-m-o047-xianzhu-p0034","kind":"mention","text":"文中提及","evidence":["guanzhang-q-o047"]},{"id":"zhuge-m-o017-xianzhu-p0034","kind":"mention","text":"文中提及","evidence":["zhuge-q-o017"]},{"id":"zhuge-m-o032-xianzhu-p0034","kind":"mention","text":"文中提及","evidence":["zhuge-q-o032"]},{"id":"zhuge-m-p031-xianzhu-p0034","kind":"mention","text":"文中提及","evidence":["zhuge-q-p031"]},{"id":"houzhu-m-houzhu-q-O073-xianzhu-p0034","kind":"mention","text":"文中提及","evidence":["houzhu-q-O073"]}]}],"evidence":[{"id":"dongliu-q-a0fbb80dfe7048e5b57f","section":"chapter-039","block":"b-c007b99c30e3df8ac9f4","layer":"original","quote":"建兴六年，亮出军向祁山","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":104,"anchor":null},"note_id":null,"start":0,"end":11},{"id":"erfei-q-09b8863c4a284ce3516a","section":"chapter-034","block":"b-c3b960c67d5476e63405","layer":"original","quote":"于时困逼，弃后及后主","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":1,"anchor":null},"note_id":null,"start":75,"end":85},{"id":"erfei-q-55f13d627e71f0fc3898","section":"chapter-034","block":"b-c3b960c67d5476e63405","layer":"original","quote":"赖赵云保护，得免于难","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":1,"anchor":null},"note_id":null,"start":86,"end":96},{"id":"erfei-q-c0d19cbadfd9375bf1b7","section":"chapter-034","block":"b-46243ff94b4566a8a9e1","layer":"pei","quote":"诸葛亮使赵云勒兵断江，留太子，乃得止","attribution":"裴注·汉晋春秋","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":46,"anchor":null},"note_id":"n-e26d52ed69bc9da71903","start":34,"end":52},{"id":"erfei-q-d4f3267ea1755b493f9d","section":"chapter-034","block":"b-c3b960c67d5476e63405","layer":"original","quote":"值曹公军至，追及先主于当阳长坂","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":1,"anchor":null},"note_id":null,"start":59,"end":74},{"id":"guanzhang-e-o041a-q","section":"chapter-036","block":"b-0115adad8a91126b45f3","layer":"original","quote":"本属公孙瓒；瓒遣先主为田楷拒袁绍〖2〗，云遂随从，为先主主骑〖3〗。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":185,"anchor":null},"note_id":null,"start":16,"end":50},{"id":"guanzhang-e-o041b-q","section":"chapter-036","block":"b-0115adad8a91126b45f3","layer":"original","quote":"及先主为曹公所追于当阳长坂，弃妻子南走。云身抱弱子，即后主也；保护甘夫人，即后主母也：皆得免难。迁为牙门将军〖4〗。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":185,"anchor":null},"note_id":null,"start":53,"end":111},{"id":"guanzhang-e-o042a-q","section":"chapter-036","block":"b-bcc06cadbae06cfae1a8","layer":"original","quote":"先主入蜀，云留荆州。﹝二﹞先主自葭萌还攻刘璋，召诸葛亮。亮率云与张飞等俱溯江西上，平定郡县。至江州，分遣云从外水上江阳〖5〗，与亮会于成都。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":186,"anchor":null},"note_id":null,"start":0,"end":70},{"id":"guanzhang-e-o043a-q","section":"chapter-036","block":"b-bf3550d642add411f481","layer":"original","quote":"成都既定，以云为翊军将军〖6〗。﹝三﹞","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":187,"anchor":null},"note_id":null,"start":0,"end":19},{"id":"guanzhang-e-o044a-q","section":"chapter-036","block":"b-44b9dee247d5bd2fe10d","layer":"original","quote":"建光元年，为中护军、征南将军〖1〗，封永昌亭侯。迁镇东将军。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":199,"anchor":null},"note_id":null,"start":0,"end":30},{"id":"guanzhang-e-o045a-q","section":"chapter-036","block":"b-5976bd16bbcfc023988d","layer":"original","quote":"五年〖2〗。随诸葛亮驻汉中。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":200,"anchor":null},"note_id":null,"start":0,"end":14},{"id":"guanzhang-e-o045b-q","section":"chapter-036","block":"b-5976bd16bbcfc023988d","layer":"original","quote":"明年，亮出军，扬声由斜谷道，曹真遣大众当之。亮令云与邓芝往拒，而身攻祁山。云、芝兵弱，敌强，失利于箕谷；然敛众固守，不至大败。军退，贬为镇军将军。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":200,"anchor":null},"note_id":null,"start":14,"end":87},{"id":"guanzhang-e-o046a-q","section":"chapter-036","block":"b-9f348b83292228dfc790","layer":"original","quote":"七年卒〖3〗，","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":201,"anchor":null},"note_id":null,"start":0,"end":7},{"id":"guanzhang-e-p023a-q","section":"chapter-036","block":"b-c2b6b009e66c45b50336","layer":"pei","quote":"云身长八尺，姿颜雄伟。为本郡所举，将义从吏兵，诣公孙瓒。时袁绍称冀州牧。瓒深忧州人之从绍也，善云来附，嘲云曰：‘闻贵州人皆愿袁氏，君何独回心，迷而能反乎？’云答曰：‘天下讻讻，未知孰是，民有倒悬之厄；鄙州论议，从仁政所在，不为忽袁公私明将军也。’遂与瓒征讨。","attribution":"《云别传》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":196,"anchor":null},"note_id":"n-f33a7a7b6e9f1851325c","start":11,"end":140},{"id":"guanzhang-e-p023b-q","section":"chapter-036","block":"b-c2b6b009e66c45b50336","layer":"pei","quote":"时先主亦依托瓒，每接纳云，云得深自结托。云以兄丧，辞瓒暂归，先主知其不返，捉手而别。云辞曰：‘终不背德也！","attribution":"《云别传》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":196,"anchor":null},"note_id":"n-f33a7a7b6e9f1851325c","start":140,"end":193},{"id":"guanzhang-e-p023c-q","section":"chapter-036","block":"b-c2b6b009e66c45b50336","layer":"pei","quote":"先主就袁绍，云见于邺。先主与云同床眠卧，密遣云合募，得数百人，皆称‘刘左将军部曲’，绍不能知。遂随先主至荆州。","attribution":"《云别传》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":196,"anchor":null},"note_id":"n-f33a7a7b6e9f1851325c","start":194,"end":249},{"id":"guanzhang-e-p024a-q","section":"chapter-036","block":"b-41949c93fbffbb7cc1da","layer":"pei","quote":"初，先主之败，有人言‘云已北去’者，先主以手戟擿之曰：‘子龙不弃我走也！’顷之，云至。","attribution":"《云别传》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":197,"anchor":null},"note_id":"n-26a4b4aa30fcb9c70f24","start":11,"end":54},{"id":"guanzhang-e-p024b-q","section":"chapter-036","block":"b-41949c93fbffbb7cc1da","layer":"pei","quote":"从平江南，以为偏将军，领桂阳太守，代赵范。范寡嫂曰樊氏，有国色，范欲以配云。云辞曰：‘相与同姓，卿兄犹我兄！’固辞不许。时有人劝云纳之，云曰：‘范迫降耳，心未可测；天下女不少！’遂不取。范果逃走，云无纤介。","attribution":"《云别传》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":197,"anchor":null},"note_id":"n-26a4b4aa30fcb9c70f24","start":54,"end":157},{"id":"guanzhang-e-p024c-q","section":"chapter-036","block":"b-41949c93fbffbb7cc1da","layer":"pei","quote":"先是，与夏侯惇战于博望，生获夏侯兰。兰是云乡里人，少小相知；云白先主，活之，荐兰明于法律，以为军正，云不用自近。其慎虑类如此。","attribution":"《云别传》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":197,"anchor":null},"note_id":"n-26a4b4aa30fcb9c70f24","start":157,"end":220},{"id":"guanzhang-e-p024d-q","section":"chapter-036","block":"b-41949c93fbffbb7cc1da","layer":"pei","quote":"先主入益州，云领留营司马。此时先主孙夫人，以权妹骄豪，多将吴吏兵，纵横不法。先主以云严重，必能整齐，特任掌内事。","attribution":"《云别传》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":197,"anchor":null},"note_id":"n-26a4b4aa30fcb9c70f24","start":220,"end":276},{"id":"guanzhang-e-p024e-q","section":"chapter-036","block":"b-41949c93fbffbb7cc1da","layer":"pei","quote":"权闻备西征，大遣舟船，迎妹；而夫人内欲将后主还吴，云与张飞勒兵截江，乃得后主还。","attribution":"《云别传》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":197,"anchor":null},"note_id":"n-26a4b4aa30fcb9c70f24","start":276,"end":316},{"id":"guanzhang-e-p025a-q","section":"chapter-036","block":"b-bfbd05c62f55b5319eef","layer":"pei","quote":"益州既定，时议欲以成都中屋舍及城外园地、桑田，分赐诸将。云驳之曰：‘霍去病以匈奴未灭，无用家为；今国贼非但匈奴，未可求安也。须天下都定，各反桑梓，归耕本土，乃其宜耳。益州人民，初罹兵革，田宅皆可归还；令安居复业，然后可役调，得其欢心。’先主即从之。","attribution":"《云别传》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":198,"anchor":null},"note_id":"n-a08234bc0170e60d90c5","start":11,"end":135},{"id":"guanzhang-e-p025b-q","section":"chapter-036","block":"b-bfbd05c62f55b5319eef","layer":"pei","quote":"夏侯渊败，曹公争汉中地，运米北山下，数千万囊。黄忠以为可取，云兵随忠取米。忠过期不还，云将数十骑轻行出围，迎视忠等。值曹公扬兵大出，云为公前锋所击，方战，其大众至；势逼，遂前突其阵，且斗且却。公军败，已复合；云陷敌，还趋围。将张著被创，云复驰马还营，迎著。","attribution":"《云别传》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":198,"anchor":null},"note_id":"n-a08234bc0170e60d90c5","start":135,"end":263},{"id":"guanzhang-e-p025c-q","section":"chapter-036","block":"b-bfbd05c62f55b5319eef","layer":"pei","quote":"公军追至围，此时沔阳长张翼，在云围内，翼欲闭门拒守；而云入营，更大开门，偃旗息鼓。公军疑云有伏兵，引去。云擂鼓震天，惟以戎弩于后射公军；公军惊骇，自相蹂践，坠汉水中死者甚多。","attribution":"《云别传》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":198,"anchor":null},"note_id":"n-a08234bc0170e60d90c5","start":263,"end":350},{"id":"guanzhang-e-p025d-q","section":"chapter-036","block":"b-bfbd05c62f55b5319eef","layer":"pei","quote":"先主明旦自来，至云营围，视昨战处，曰：‘子龙一身都是胆也！’作乐饮宴，至瞑，军中号云为‘虎威将军’。","attribution":"《云别传》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":198,"anchor":null},"note_id":"n-a08234bc0170e60d90c5","start":350,"end":400},{"id":"guanzhang-e-p025e-q","section":"chapter-036","block":"b-bfbd05c62f55b5319eef","layer":"pei","quote":"孙权袭荆州，先主大怒，欲讨权。云谏曰：‘国贼是曹操，非孙权也；且先灭魏，则吴自服。操身虽毙，子丕篡盗；当因众心，早图关中；居河、渭上流，以讨凶逆，关东义士必裹粮策马以迎王师。不应置魏，先与吴战；兵势一交，不得猝解也！’先主不听，遂东征，留云督江州。","attribution":"《云别传》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":198,"anchor":null},"note_id":"n-a08234bc0170e60d90c5","start":400,"end":524},{"id":"guanzhang-e-p025f-q","section":"chapter-036","block":"b-bfbd05c62f55b5319eef","layer":"pei","quote":"先主失利于秭归，云进兵至永安，吴军已退。","attribution":"《云别传》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":198,"anchor":null},"note_id":"n-a08234bc0170e60d90c5","start":524,"end":544},{"id":"guanzhang-e-p026a-q","section":"chapter-036","block":"b-7b0683b2e21b2ed4274a","layer":"pei","quote":"﹝一﹞《云别传》曰：“亮曰：‘街亭军退，兵将不复相录；箕谷军退，兵将初不相失。何故？’芝答曰：‘云身自断后，军资什物，略无所弃，兵将无缘相失。’云有军资余绢，亮使分赐将士；云曰：‘军事无利，何为有赐？其物请悉入赤岸府库，须十月，为冬赐。’亮大善之。”","attribution":"《云别传》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":213,"anchor":null},"note_id":"n-e0f07b8f49dbc02f8642","start":0,"end":125},{"id":"guanzhang-f0015-q","section":"chapter-036","block":"b-0115adad8a91126b45f3","layer":"original","quote":"赵云字子龙","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":185,"anchor":null},"note_id":null,"start":0,"end":5},{"id":"guanzhang-f0016-q","section":"chapter-036","block":"b-0115adad8a91126b45f3","layer":"original","quote":"常山真定人也","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":185,"anchor":null},"note_id":null,"start":6,"end":12},{"id":"guanzhang-f0017-q","section":"chapter-036","block":"b-9f348b83292228dfc790","layer":"original","quote":"追谥顺平侯","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":201,"anchor":null},"note_id":null,"start":7,"end":12},{"id":"guanzhang-q-b-53e2ee7117c7b0d340fe","section":"chapter-036","block":"b-53e2ee7117c7b0d340fe","layer":"modern","quote":"〖2〗五年：建兴五年（公元227）。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":205,"anchor":null},"note_id":"n-dc750b7841b3838453d0","start":0,"end":18},{"id":"guanzhang-q-b-d248bb04fd56288748b0","section":"chapter-036","block":"b-d248bb04fd56288748b0","layer":"modern","quote":"〖3〗七年：建兴七年（公元 229）。赵云的祠墓，相传在今四川大邑县城东银屏山麓，现今尚有清雅肃穆的墓园留存。是蜀地三国名胜古迹之一。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":206,"anchor":null},"note_id":"n-27ea1c0a8e2fa47a77c0","start":0,"end":67},{"id":"guanzhang-q-o041","section":"chapter-036","block":"b-0115adad8a91126b45f3","layer":"original","quote":"赵云字子龙，常山真定人也〖1〗。本属公孙瓒；瓒遣先主为田楷拒袁绍〖2〗，云遂随从，为先主主骑〖3〗。﹝一﹞及先主为曹公所追于当阳长坂，弃妻子南走。云身抱弱子，即后主也；保护甘夫人，即后主母也：皆得免难。迁为牙门将军〖4〗。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":185,"anchor":null},"note_id":null,"start":0,"end":111},{"id":"guanzhang-q-o042","section":"chapter-036","block":"b-bcc06cadbae06cfae1a8","layer":"original","quote":"先主入蜀，云留荆州。﹝二﹞先主自葭萌还攻刘璋，召诸葛亮。亮率云与张飞等俱溯江西上，平定郡县。至江州，分遣云从外水上江阳〖5〗，与亮会于成都。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":186,"anchor":null},"note_id":null,"start":0,"end":70},{"id":"guanzhang-q-o043","section":"chapter-036","block":"b-bf3550d642add411f481","layer":"original","quote":"成都既定，以云为翊军将军〖6〗。﹝三﹞","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":187,"anchor":null},"note_id":null,"start":0,"end":19},{"id":"guanzhang-q-o044","section":"chapter-036","block":"b-44b9dee247d5bd2fe10d","layer":"original","quote":"建光元年，为中护军、征南将军〖1〗，封永昌亭侯。迁镇东将军。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":199,"anchor":null},"note_id":null,"start":0,"end":30},{"id":"guanzhang-q-o045","section":"chapter-036","block":"b-5976bd16bbcfc023988d","layer":"original","quote":"五年〖2〗。随诸葛亮驻汉中。明年，亮出军，扬声由斜谷道，曹真遣大众当之。亮令云与邓芝往拒，而身攻祁山。云、芝兵弱，敌强，失利于箕谷；然敛众固守，不至大败。军退，贬为镇军将军。﹝一﹞","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":200,"anchor":null},"note_id":null,"start":0,"end":90},{"id":"guanzhang-q-o046","section":"chapter-036","block":"b-9f348b83292228dfc790","layer":"original","quote":"七年卒〖3〗，追谥顺平侯。初，先主时，惟法正见谥。后主时，诸葛亮功德盖世，蒋琬、费祎荷国之重〖4〗，亦见谥。陈祗宠待〖5〗，特加殊奖；夏侯霸，远来归国〖6〗：故复得谥。于是关羽、张飞、马超、庞统、黄忠及云乃追谥，时论以为荣﹝二﹞。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":201,"anchor":null},"note_id":null,"start":0,"end":115},{"id":"guanzhang-q-o047","section":"chapter-036","block":"b-1260bfaca9a465ee83ca","layer":"original","quote":"云子统嗣，官至虎贲中郎督、行领军〖7〗。次子广，牙门将。随姜维沓中〖8〗，临阵战死。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":202,"anchor":null},"note_id":null,"start":0,"end":42},{"id":"guanzhang-q-o048","section":"chapter-036","block":"b-ed718ddcba8b8e3b3282","layer":"original","quote":"评曰：关羽、张飞，皆称“万人之敌”，为世虎臣。羽报效曹公，飞义释严颜：并有国士之风。然羽刚而自矜，飞暴而无恩；以短取败，理数之常也。马超阻戎负勇〖1〗，以覆其族。惜哉！能因穷致泰〖2〗，不犹愈乎〖3〗！黄忠、赵云，强鸷壮猛〖4〗，并作爪牙：其灌、滕之徒欤〖5〗？","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":215,"anchor":null},"note_id":null,"start":0,"end":131},{"id":"guanzhang-q-p023","section":"chapter-036","block":"b-c2b6b009e66c45b50336","layer":"pei","quote":"﹝一﹞《云别传》曰：“云身长八尺，姿颜雄伟。为本郡所举，将义从吏兵，诣公孙瓒。时袁绍称冀州牧。瓒深忧州人之从绍也，善云来附，嘲云曰：‘闻贵州人皆愿袁氏，君何独回心，迷而能反乎？’云答曰：‘天下讻讻，未知孰是，民有倒悬之厄；鄙州论议，从仁政所在，不为忽袁公私明将军也。’遂与瓒征讨。时先主亦依托瓒，每接纳云，云得深自结托。云以兄丧，辞瓒暂归，先主知其不返，捉手而别。云辞曰：‘终不背德也！’先主就袁绍，云见于邺。先主与云同床眠卧，密遣云合募，得数百人，皆称‘刘左将军部曲’，绍不能知。遂随先主至荆州。”","attribution":"《云别传》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":196,"anchor":null},"note_id":"n-f33a7a7b6e9f1851325c","start":0,"end":250},{"id":"guanzhang-q-p024","section":"chapter-036","block":"b-41949c93fbffbb7cc1da","layer":"pei","quote":"﹝二﹞《云别传》曰：“初，先主之败，有人言‘云已北去’者，先主以手戟擿之曰：‘子龙不弃我走也！’顷之，云至。从平江南，以为偏将军，领桂阳太守，代赵范。范寡嫂曰樊氏，有国色，范欲以配云。云辞曰：‘相与同姓，卿兄犹我兄！’固辞不许。时有人劝云纳之，云曰：‘范迫降耳，心未可测；天下女不少！’遂不取。范果逃走，云无纤介。先是，与夏侯惇战于博望，生获夏侯兰。兰是云乡里人，少小相知；云白先主，活之，荐兰明于法律，以为军正，云不用自近。其慎虑类如此。先主入益州，云领留营司马。此时先主孙夫人，以权妹骄豪，多将吴吏兵，纵横不法。先主以云严重，必能整齐，特任掌内事。权闻备西征，大遣舟船，迎妹；而夫人内欲将后主还吴，云与张飞勒兵截江，乃得后主还。”","attribution":"《云别传》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":197,"anchor":null},"note_id":"n-26a4b4aa30fcb9c70f24","start":0,"end":317},{"id":"guanzhang-q-p025","section":"chapter-036","block":"b-bfbd05c62f55b5319eef","layer":"pei","quote":"﹝三﹞《云别传》曰：“益州既定，时议欲以成都中屋舍及城外园地、桑田，分赐诸将。云驳之曰：‘霍去病以匈奴未灭，无用家为；今国贼非但匈奴，未可求安也。须天下都定，各反桑梓，归耕本土，乃其宜耳。益州人民，初罹兵革，田宅皆可归还；令安居复业，然后可役调，得其欢心。’先主即从之。夏侯渊败，曹公争汉中地，运米北山下，数千万囊。黄忠以为可取，云兵随忠取米。忠过期不还，云将数十骑轻行出围，迎视忠等。值曹公扬兵大出，云为公前锋所击，方战，其大众至；势逼，遂前突其阵，且斗且却。公军败，已复合；云陷敌，还趋围。将张著被创，云复驰马还营，迎著。公军追至围，此时沔阳长张翼，在云围内，翼欲闭门拒守；而云入营，更大开门，偃旗息鼓。公军疑云有伏兵，引去。云擂鼓震天，惟以戎弩于后射公军；公军惊骇，自相蹂践，坠汉水中死者甚多。先主明旦自来，至云营围，视昨战处，曰：‘子龙一身都是胆也！’作乐饮宴，至瞑，军中号云为‘虎威将军’。孙权袭荆州，先主大怒，欲讨权。云谏曰：‘国贼是曹操，非孙权也；且先灭魏，则吴自服。操身虽毙，子丕篡盗；当因众心，早图关中；居河、渭上流，以讨凶逆，关东义士必裹粮策马以迎王师。不应置魏，先与吴战；兵势一交，不得猝解也！’先主不听，遂东征，留云督江州。先主失利于秭归，云进兵至永安，吴军已退。”","attribution":"《云别传》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":198,"anchor":null},"note_id":"n-a08234bc0170e60d90c5","start":0,"end":545},{"id":"guanzhang-q-p026","section":"chapter-036","block":"b-7b0683b2e21b2ed4274a","layer":"pei","quote":"﹝一﹞《云别传》曰：“亮曰：‘街亭军退，兵将不复相录；箕谷军退，兵将初不相失。何故？’芝答曰：‘云身自断后，军资什物，略无所弃，兵将无缘相失。’云有军资余绢，亮使分赐将士；云曰：‘军事无利，何为有赐？其物请悉入赤岸府库，须十月，为冬赐。’亮大善之。”","attribution":"《云别传》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":213,"anchor":null},"note_id":"n-e0f07b8f49dbc02f8642","start":0,"end":125},{"id":"houzhu-q-O017","section":"chapter-033","block":"b-17d075399123d2f8faa1","layer":"original","quote":"六年春〖1〗，亮出攻祁山，不克。","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":49,"anchor":null},"note_id":null,"start":0,"end":16},{"id":"houzhu-q-O073","section":"chapter-033","block":"b-3017f0e86969f4fbb153","layer":"original","quote":"四年春三月，追谥故将军赵云。","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":149,"anchor":null},"note_id":null,"start":0,"end":14},{"id":"liusima-q-aade96a477857df8dd45","section":"chapter-015","block":"b-38f834fc4a27e9b4a9c9","layer":"pei","quote":"太和中，诸葛亮出陇右，吏民骚动。天水、南安太守各弃郡东下","attribution":"裴注·魏略","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":159,"anchor":null},"note_id":"n-4feaf9d5c7378b57140d","start":33,"end":61},{"id":"lizang-q-191e369b2d3f4e75595b","section":"chapter-018","block":"b-e9d18d4f862d319c0c25","layer":"original","quote":"授聘兵，使与曹纯追讨刘备于长坂","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":88,"anchor":null},"note_id":null,"start":135,"end":150},{"id":"wudi-q-b-888495d8be7766faf20c","section":"chapter-001","block":"b-888495d8be7766faf20c","layer":"modern","quote":"〖1〗十三年：建安十三年（公元 208）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":666,"anchor":null},"note_id":"n-0bae348fdb687025113d","start":0,"end":21},{"id":"wudi-q-o119","section":"chapter-001","block":"b-4bcffcc4ee709a4e5ea3","layer":"original","quote":"十三年春正月〖1〗，公还邺。作玄武池以肄舟师〖2〗。﹝一﹞汉罢三公官，置丞相、御史大夫〖3〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":661,"anchor":null},"note_id":null,"start":0,"end":47},{"id":"xianzhu-e-o027a-q","section":"chapter-032","block":"b-50bee17966dbf776f03c","layer":"original","quote":"曹公以江陵有军实〖4〗，恐先主据之；乃释辎重，轻军到襄阳。闻先主已过，曹公将精骑五千急追之；一日一夜行三百余里，及于当阳之长坂〖5〗。先主弃妻子，与诸葛亮、张飞、赵云等数十骑走〖6〗。曹公大获其人众辎重。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":111,"anchor":null},"note_id":null,"start":0,"end":102},{"id":"xianzhu-e-o041c-q","section":"chapter-032","block":"b-c205af65c5b891e6a027","layer":"original","quote":"诸葛亮、张飞、赵云等将兵溯流定白帝、江州、江阳〖13〗，唯关羽留镇荆州。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":166,"anchor":null},"note_id":null,"start":151,"end":187},{"id":"xianzhu-q-o024","section":"chapter-032","block":"b-c857386227851cc86ab3","layer":"original","quote":"（曹公南征表）〔及曹公南征〕，会表卒，﹝二﹞子琮代立〖2〗，遣使请降。先主屯樊，不知曹公猝至；至宛乃闻之，遂将其众去。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":108,"anchor":null},"note_id":null,"start":0,"end":59},{"id":"xianzhu-q-o027","section":"chapter-032","block":"b-50bee17966dbf776f03c","layer":"original","quote":"曹公以江陵有军实〖4〗，恐先主据之；乃释辎重，轻军到襄阳。闻先主已过，曹公将精骑五千急追之；一日一夜行三百余里，及于当阳之长坂〖5〗。先主弃妻子，与诸葛亮、张飞、赵云等数十骑走〖6〗。曹公大获其人众辎重。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":111,"anchor":null},"note_id":null,"start":0,"end":102},{"id":"xianzhu-q-o041","section":"chapter-032","block":"b-c205af65c5b891e6a027","layer":"original","quote":"先主大怒，召璋白水军督杨怀，责以无礼，斩之。乃使黄忠、卓膺勒兵向璋〖9〗。先主径至关中〖10〗，质诸将并士卒妻子〖11〗；引兵与忠、膺等进到涪，据其城。璋遣刘z 、冷苞、张任、邓贤〔、吴懿〕等拒先主于涪；﹝三﹞皆破败，退保绵竹。璋复遣李严督绵竹诸军〖12〗，严率众降先主。先主军益强，分遣诸将平下属县。诸葛亮、张飞、赵云等将兵溯流定白帝、江州、江阳〖13〗，唯关羽留镇荆州。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":166,"anchor":null},"note_id":null,"start":0,"end":187},{"id":"zhuge-e-o017a-q","section":"chapter-035","block":"b-edd9d869b75a583f73b0","layer":"original","quote":"先主自葭萌还攻璋；亮与张飞、赵云等率众溯江，分定郡县；与先主共围成都。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":100,"anchor":null},"note_id":null,"start":0,"end":35},{"id":"zhuge-e-o032a-q","section":"chapter-035","block":"b-f4828bab0392be0b0bf7","layer":"original","quote":"六年春〖1〗，扬声由斜谷道取郿〖2〗，使赵云、邓芝为疑军〖3〗，据箕谷〖4〗；魏大将军曹真举众拒之。亮身率诸军攻祁山〖5〗，戎阵整齐，赏罚肃而号令明；南安、天水、安定三郡叛魏应亮，关中响震〖6〗。﹝二﹞","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":213,"anchor":null},"note_id":null,"start":0,"end":101},{"id":"zhuge-q-b-0d2dada465388f4c2e39","section":"chapter-035","block":"b-0d2dada465388f4c2e39","layer":"modern","quote":"〖1〗六年：建兴六年（公元 228）。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":220,"anchor":null},"note_id":"n-c990758acc37a646578b","start":0,"end":19},{"id":"zhuge-q-o017","section":"chapter-035","block":"b-edd9d869b75a583f73b0","layer":"original","quote":"先主自葭萌还攻璋；亮与张飞、赵云等率众溯江，分定郡县；与先主共围成都。成都平，以亮为军师将军，署左将军府事〖1〗。先主外出，亮常镇守成都，足食足兵。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":100,"anchor":null},"note_id":null,"start":0,"end":74},{"id":"zhuge-q-o032","section":"chapter-035","block":"b-f4828bab0392be0b0bf7","layer":"original","quote":"六年春〖1〗，扬声由斜谷道取郿〖2〗，使赵云、邓芝为疑军〖3〗，据箕谷〖4〗；魏大将军曹真举众拒之。亮身率诸军攻祁山〖5〗，戎阵整齐，赏罚肃而号令明；南安、天水、安定三郡叛魏应亮，关中响震〖6〗。﹝二﹞","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":213,"anchor":null},"note_id":null,"start":0,"end":101},{"id":"zhuge-q-p031","section":"chapter-035","block":"b-ac414bdcabe103b97151","layer":"pei","quote":"﹝四﹞《汉晋春秋》曰：“或劝亮更发兵者，亮曰：‘大军在祁山、箕谷，皆多于贼：而不能破贼、为贼所破者，则此病不在兵少也。在一人耳。今欲减兵省将，明罚思过，校变通之道于将来；若不能然者，虽兵多何益？自今以后，诸有忠虑于国，但勤攻吾之阙，则事可定，贼可死，功可v足而待矣！’于是考微劳，甄烈壮，引咎责躬，布所失于天下；厉兵讲武，以为后图，戎士简练，民忘其败矣。亮闻孙权破曹休，魏兵东下，关中虚弱。十一月，上言曰：‘先帝虑汉，贼不两立，王业不偏安，故托臣以讨贼也。以先帝之明，量臣之才，故知臣伐贼才弱敌强也。然不伐贼，王业亦亡；惟坐待亡，孰与伐之？是故托臣而弗疑也。臣受命之日，寝不安席，食不甘味；思惟北征，宜先入南，故五月渡泸，深入不毛，并日而食。臣非不自惜也，顾王业不得偏全于蜀都，故冒危难以奉先帝之遗意也；而议者谓为非计。今贼适疲于西，又务於东；兵法乘劳，此进趋之时也。谨陈其事如左：高帝明并日月，谋臣渊深，然涉险被创，危然后安。今陛下未及高帝，谋臣不如良、平；而欲以长计取胜，坐定天下。此臣之未解一也；刘繇、王朗，各据州郡；论安言计，动引圣人；群疑满腹，众难塞胸；今岁不战，明年不征；使孙策坐大，遂并江东。此臣之未解二也；曹操智计殊绝于人；其用兵也，仿佛孙、吴；然困于南阳，险于鸟巢，危于祁连，逼于黎阳，几败北山，殆死潼关；然后，伪定一时耳。况臣才弱，而欲以不危而定之。此臣之未解三也；曹操五攻昌霸不下，四越巢湖不成，任用李服而李服图之，委夏侯而夏侯败亡；先帝每称操为能，犹有此失；况臣驽下，何能必胜？此臣之未解四也；自臣到汉中，中间期年耳。然丧赵云、阳群、马玉、阎芝、丁立、白寿、刘郃、邓铜等及曲长、屯将七十余人，突将、无前、)叟、青羌散骑、武骑一千余人。此皆数十年之内所纠合四方之精锐，非一州之所有。若复数年，则损三分之二也；当何以图敌？此臣之未解五也；今民穷兵疲，而事不可息；事不可息，则住与行劳费正等；而不及今图之，欲以一州之地与贼持久。此臣之未解六也。夫难平者，事也。昔先帝败军于楚，当此时，曹操拊手谓：天下以定。然后先帝东连吴、越，西取巴、蜀，举兵北征，夏侯授首。此操之失计而汉事将成也。然后吴更违盟，关羽毁败，秭归蹉跌，曹丕称帝。凡事如是，难可逆见。臣鞠躬尽力，死而后已；至于成败利钝，非臣之明所能逆睹也。’于是有散关之役。”","attribution":"《汉晋春秋》","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":254,"anchor":null},"note_id":"n-c1e8412107818b874310","start":0,"end":970}],"profiles":{"xianzhu-p0034":{"fields":[{"id":"guanzhang-f0015","key":"courtesy","label":"字","text":"子龙","evidence":["guanzhang-f0015-q"]},{"id":"guanzhang-f0016","key":"home","label":"籍贯","text":"常山真定","evidence":["guanzhang-f0016-q"]},{"id":"featured-review-xianzhu-p0034-identity","key":"identity","label":"主要身份","text":"镇东将军","evidence":["guanzhang-e-o044a-q"]},{"id":"guanzhang-f0017","key":"posthumous","label":"谥号","text":"顺平侯","evidence":["guanzhang-f0017-q"]}],"directory":{"faction":"shu"}}},"directory_counts":{}}
