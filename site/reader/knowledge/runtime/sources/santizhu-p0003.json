_id":null,"start":0,"end":70,"offset_unit":"unicode_code_point"},{"id":"feipin-q-7c7b2d8b0d47d1a87e4e","section":"chapter-050","block":"b-9c4d68d08be949040d03","layer":"pei","quote":"﹝一﹞《吴录》曰：“亮妻，慧解有容色，居候官。吴平乃归，永宁中，卒。”","attribution":"裴注·吴录","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":121,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9a3322b481de217bc205","start":0,"end":35,"offset_unit":"unicode_code_point"},{"id":"feipin-q-80d2ec9a3ccea1cd61cf","section":"chapter-050","block":"b-ab7c7df5debf9edb03d8","layer":"original","quote":"孙亮全夫人，全尚女也。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":111,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":11,"offset_unit":"unicode_code_point"},{"id":"feipin-q-b6d0fdf5af7fabba0112","section":"chapter-050","block":"b-b672ef494a44c9d38d7b","layer":"original","quote":"夫人立为皇后，","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":112,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":7,"offset_unit":"unicode_code_point"},{"id":"feipin-q-e5866a75db7d35b13191","section":"chapter-050","block":"b-133fdadf2671af7b34a3","layer":"original","quote":"后又黜为候官侯；夫人随之国，居候官〖4〗。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":113,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":58,"end":79,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-134171d2c7afd0a384dd","section":"chapter-048","block":"b-adb7a4c042b8d74eade7","layer":"original","quote":"因倚权意，欲豫自结，数称述全尚女〖3〗，劝为亮纳","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":1,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":49,"end":73,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-4ea4628abd86d3d6823f","section":"chapter-048","block":"b-fce5536b05cb3d0ea98d","layer":"original","quote":"亮以綝专恣，与太常全尚，将军刘丞，谋诛綝","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":121,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-5a5b4af3e1e3fee32741","section":"chapter-048","block":"b-9db6a2d71929e76ee464","layer":"original","quote":"二年春正月丙寅〖1〗，立皇后全氏","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":33,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":16,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-f45d78c0c095c2fd3196","section":"chapter-048","block":"b-20c24857a3676af327fb","layer":"original","quote":"有司以闻，黜为候官侯，遣之国","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":199,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":58,"end":72,"offset_unit":"unicode_code_point"},{"id":"santizhu-q-ff39d2d5ee7ca4e97920","section":"chapter-048","block":"b-de65601432127adbfc19","layer":"original","quote":"赤乌十三年，和废；权遂立亮为太子，以全氏为妃","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":2,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":22,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-5274abc71ef19e4c91a7","section":"chapter-064","block":"b-95b6f4e559a9caf04f8a","layer":"original","quote":"亮妃，綝从姊女也〖5〗，以其谋告綝。","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":455,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":91,"end":109,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-7f20cc569ae15f362b09","section":"chapter-064","block":"b-5a68ad209c9913a5a2f5","layer":"pei","quote":"纪承诏，以告尚；尚无远虑，以语纪母。母使人密语綝。綝夜发严兵废亮，比明，兵已围宫","attribution":"裴注·江表传","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":477,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-3c25a1ac71ab7fb35794","start":230,"end":270,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-e5d1dd0847f190e833bb","section":"chapter-064","block":"b-95b6f4e559a9caf04f8a","layer":"original","quote":"亮遂与公主鲁班、太常全尚、将军刘（承）〔丞〕议诛綝。亮妃，綝从姊女也〖5〗，以其谋告綝","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":455,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":65,"end":108,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-f4cffdb0d4a70d37ea2f","section":"chapter-064","block":"b-5a68ad209c9913a5a2f5","layer":"pei","quote":"亮召全尚息黄门侍郎纪，密谋，曰：‘孙綝专势，轻小于孤。孤（见）〔前〕敕之，使速上岸，为唐咨等作援；而留湖中，不上岸一步。又委罪朱异，擅杀功臣，不先表闻。筑第桥南，不复朝见。此为自在，无复所畏，不可久忍。今规取之，卿父作中军都督，使密严整士马；孤当自出临桥，帅宿卫虎骑、左右无难，一时围之；作板诏敕綝所领皆解散，不得举手：正尔，自〔当〕得之！卿去，但当使密耳。卿宣诏语卿父，勿令卿母知之；女人既不晓大事，且綝同堂姊：邂逅泄漏，误孤非小也","attribution":"裴注·江表传","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":477,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-3c25a1ac71ab7fb35794","start":11,"end":228,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
