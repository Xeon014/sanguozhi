,"evidence":[{"id":"chengguo-q-57bb02c8bc8efe183f2e","section":"chapter-014","block":"b-e9401b31a90b17c74409","layer":"original","quote":"备至徐州，遂杀车胄，举兵背太祖","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":33,"anchor":null},"note_id":null,"start":97,"end":112},{"id":"chengguo-q-791bacb1947a88965eb8","section":"chapter-014","block":"b-546398c9e99f491661e8","layer":"original","quote":"备到下邳，杀徐州刺史车胄，反。","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":178,"anchor":null},"note_id":null,"start":64,"end":79},{"id":"dongyuan-e-o045b-q","section":"chapter-006","block":"b-f1a07cf0a3b22cc78947","layer":"original","quote":"太祖遣刘岱、王忠击之，不克。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":296,"anchor":null},"note_id":null,"start":37,"end":51},{"id":"dongyuan-q-o045","section":"chapter-006","block":"b-f1a07cf0a3b22cc78947","layer":"original","quote":"先是，太祖遣刘备诣徐州，拒袁术。术死，备杀刺史车胄，引军屯沛。绍遣骑佐之。太祖遣刘岱、王忠击之，不克。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":296,"anchor":null},"note_id":null,"start":0,"end":51},{"id":"wudi-e-o069a-q","section":"chapter-001","block":"b-b951d04332712c30fc16","layer":"original","quote":"备之未东也，阴与董承等谋反。至下邳，遂杀徐州刺史车胄，举兵屯沛〖26〗。遣刘岱、王忠击之，不克。﹝一﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":366,"anchor":null},"note_id":null,"start":0,"end":51},{"id":"wudi-e-p053a-q","section":"chapter-001","block":"b-e721fe143c23f4ab5b1c","layer":"pei","quote":"﹝一﹞《献帝春秋》曰：“备谓岱等曰：‘使汝百人来，其无如我何。曹公自来，未可知耳！’”","attribution":"《献帝春秋》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":397,"anchor":null},"note_id":"n-f142c35558b278dd215d","start":0,"end":43},{"id":"wudi-q-b-51bced16741add42ff70","section":"chapter-001","block":"b-51bced16741add42ff70","layer":"modern","quote":"〖1〗四年：建安四年（公元 199）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":369,"anchor":null},"note_id":"n-20628d34a709162c77f0","start":0,"end":19},{"id":"wudi-q-o061","section":"chapter-001","block":"b-502d4e8c0ed143eaa30d","layer":"original","quote":"四年春二月〖1〗，公还至昌邑〖2〗。张杨将杨丑杀杨〖3〗。眭固又杀丑，以其众属袁绍，屯射犬〖4〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":358,"anchor":null},"note_id":null,"start":0,"end":49},{"id":"wudi-q-o069","section":"chapter-001","block":"b-b951d04332712c30fc16","layer":"original","quote":"备之未东也，阴与董承等谋反。至下邳，遂杀徐州刺史车胄，举兵屯沛〖26〗。遣刘岱、王忠击之，不克。﹝一﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":366,"anchor":null},"note_id":null,"start":0,"end":51},{"id":"wudi-q-p053","section":"chapter-001","block":"b-e721fe143c23f4ab5b1c","layer":"pei","quote":"﹝一﹞《献帝春秋》曰：“备谓岱等曰：‘使汝百人来，其无如我何。曹公自来，未可知耳！’”","attribution":"《献帝春秋》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":397,"anchor":null},"note_id":"n-f142c35558b278dd215d","start":0,"end":43},{"id":"wudi-q-p054","section":"chapter-001","block":"b-9a2913b884070c6fc4df","layer":"pei","quote":"《魏武故事》曰：“岱字公山，沛国人。以司空长史从征伐，有功，封列侯。”","attribution":"《魏武故事》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":398,"anchor":null},"note_id":"n-f142c35558b278dd215d","start":0,"end":35},{"id":"xianzhu-e-o016b-q","section":"chapter-032","block":"b-b2ba16ddd29a37182478","layer":"original","quote":"先主据下邳，灵等还。先主乃杀徐州刺史车胄，留关羽守下邳，而身还小沛。﹝四﹞","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":71,"anchor":null},"note_id":null,"start":12,"end":49},{"id":"xianzhu-e-o017b-q","section":"chapter-032","block":"b-7cba73e5d6ee78cda30a","layer":"original","quote":"曹公遣刘岱、王忠击之，不克。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":72,"anchor":null},"note_id":null,"start":36,"end":50},{"id":"xianzhu-q-o017","section":"chapter-032","block":"b-7cba73e5d6ee78cda30a","layer":"original","quote":"东海昌霸反，郡县多叛曹公为先主〖7〗。众数万人，遣孙乾与袁绍连和〖8〗。曹公遣刘岱、王忠击之，不克。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":72,"anchor":null},"note_id":null,"start":0,"end":50}],"profiles":{},"directory_counts":{}}
