ence":["xumisun-q-81aaae649c723a923865"]},"ordering_evidence":"xumisun-q-81aaae649c723a923865","source_order":[38,406,0],"order":7110}],"persons":[{"id":"xumisun-p0009","name":"张温（吴）","evidence":["xumisun-q-f9b135891233f198e303","xumisun-q-72f1c4334245dd244ea6","xumisun-q-81aaae649c723a923865","dengzhang-q-8545b26a6bd626abbe19"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[{"id":"dengzhang-q-8545b26a6bd626abbe19","section":"chapter-045","block":"b-254d0c4ecb2e34bf9806","layer":"original","quote":"权默然良久曰：“君言是也！”遂自绝魏，与蜀连和，遣张温报聘于蜀","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":4,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":236,"end":267,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-72f1c4334245dd244ea6","section":"chapter-038","block":"b-c85c98685debb4bb6a86","layer":"original","quote":"温曰：“彼何人也？”亮曰：“益州学士也","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":404,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":38,"end":57,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-81aaae649c723a923865","section":"chapter-038","block":"b-07e1dd33ae62751e3422","layer":"original","quote":"及至，温问曰：“君学乎？”宓曰：“五尺童子皆学，何必小人！”温复问曰：“天有头乎？”宓曰：“有之。”温曰：“在何方也？”宓曰：“在西方。《诗》曰：‘乃眷西顾〖3〗。’以此推之，头在西方。”温曰：“天有耳乎？”宓曰：“天处高而听卑。《诗》云：‘鹤鸣于九皋，声闻于天。’若其无耳，何以听之？”温曰：“天有足乎？”宓曰：“有。《诗》云：‘天步艰难〖4〗，之子不犹〖5〗。’若其无足，何以步之？”温曰：“天有姓乎？”宓曰：“有。”温曰：“何姓？”宓曰：“姓刘。”温曰：“何以知之？”答曰：“天子姓刘，故以此知之。”温曰：“日生于东乎〖6〗？”宓曰：“虽生于东，而没于西。”答问如响，应声而出；于是温大敬服","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":405,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":298,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-f9b135891233f198e303","section":"chapter-038","block":"b-c85c98685debb4bb6a86","layer":"original","quote":"吴遣使张温来聘〖1〗，百官皆往饯焉","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":404,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":17,"offset_unit":"unicode_code_point"},{"id":"xumisun-q2-a3aaa6cf31e39cfaeafa","section":"chapter-038","block":"b-c85c98685debb4bb6a86","layer":"original","quote":"吴遣使张温来聘〖1〗，百官皆往饯焉〖2〗。众人皆集而宓未往，亮累遣使，促之。温曰：“彼何人也？”亮曰：“益州学士也。”","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":404,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":59,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
