tion_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":43,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":44,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-b-37d1816580d2541ad353","section":"chapter-009","block":"b-37d1816580d2541ad353","layer":"modern","quote":"〖7〗十四年：建安十四年（公元 209）。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":51,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5497913c514df18982ee","start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-o013","section":"chapter-009","block":"b-5a05419cd84365039812","layer":"original","quote":"十四年〖7〗，以渊为行领军〖8〗。太祖征孙权还，使渊督诸将，击庐江叛者雷绪〖9〗。绪破，又行征西护军〖10〗，督徐晃击太原贼；攻下二十余屯，斩贼帅商曜，屠其城。从征韩遂等，战于渭南。又督朱灵平隃糜、汧氐〖11〗。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":43,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":106,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o030c-q","section":"chapter-032","block":"b-eb597d5d4ba0ca04fe0c","layer":"original","quote":"庐江雷绪率部曲数万口稽颡〖3〗。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":136,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":56,"end":72,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o030","section":"chapter-032","block":"b-eb597d5d4ba0ca04fe0c","layer":"original","quote":"先主表琦为荆州刺史；又南征四郡〖1〗：武陵太守金旋、长沙太守韩玄、桂阳太守赵范、零陵太守刘度〖2〗，皆降。﹝一﹞庐江雷绪率部曲数万口稽颡〖3〗。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":136,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":72,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_