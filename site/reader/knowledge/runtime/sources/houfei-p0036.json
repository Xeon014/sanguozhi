{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"houfei-e-o025d","title":"封甄温甄艳等列侯","accounts":[{"id":"houfei-e-o025d-account","label":"《后妃传》正文","text":"封甄温甄艳等列侯","evidence":["houfei-e-o025d-q"]}],"participants":[{"person":"houfei-p0036","role":"受封","evidence":["houfei-e-o025d-q"]},{"person":"houfei-p0037","role":"受封","evidence":["houfei-e-o025d-q"]}],"place":null,"time":{"label":"又封畅弟","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["houfei-e-o025d-q"]},"ordering_evidence":"houfei-e-o025d-q","source_order":[5,98,"O025d"],"order":1400},{"id":"houfei-e-p017b","title":"郭建甄德封县公甄温进辅国大将军","accounts":[{"id":"houfei-e-p017b-account","label":"《晋诸公赞》","text":"郭建甄德封县公甄温进辅国大将军","evidence":["houfei-e-p017b-q"]}],"participants":[{"person":"houfei-p0046","role":"受封","evidence":["houfei-e-p017b-q"]},{"person":"houfei-p0042","role":"受封","evidence":["houfei-e-p017b-q"]},{"person":"houfei-p0036","role":"迁官","evidence":["houfei-e-p017b-q"]}],"place":null,"time":{"year":264,"label":"咸熙初","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"houfei-y264","dating_review":{"reviewed":true,"anchor":"houfei-q-o052","basis":"咸熙初"},"evidence":["houfei-e-p017b-q","houfei-q-o052","houfei-q-b-234ff55f537cf4e871c2"]},"ordering_evidence":"houfei-e-p017b-q","source_order":[5,154,"P017b"],"order":1415},{"id":"houfei-e-p017c","title":"晋受禅加郭建甄德甄温特进","accounts":[{"id":"houfei-e-p017c-account","label":"《晋诸公赞》","text":"晋受禅加郭建甄德甄温特进","evidence":["houfei-e-p017c-q"]}],"participants":[{"person":"houfei-p0046","role":"受任","evidence":["houfei-e-p017c-q"]},{"person":"houfei-p0042","role":"受任","evidence":["houfei-e-p017c-q"]},{"person":"houfei-p0036","role":"受任","evidence":["houfei-e-p017c-q"]}],"place":null,"time":{"label":"泰始元年晋受禅","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["houfei-e-p017c-q"]},"ordering_evidence":"houfei-e-p017c-q","source_order":[5,154,"P017c"],"order":1416}],"persons":[{"id":"houfei-p0036","name":"甄温","evidence":["houfei-q-o025"],"facts":[{"id":"houfei-f0004","label":"字","text":"仲舒","evidence":["houfei-f0004-q"]}],"aliases":[{"text":"仲舒","evidence":["houfei-f0004-q"]}],"mentions":[{"id":"houfei-m-o025-houfei-p0036","kind":"mention","text":"文中提及","evidence":["houfei-q-o025"]},{"id":"houfei-m-p017-houfei-p0036","kind":"mention","text":"文中提及","evidence":["houfei-q-p017"]}]}],"evidence":[{"id":"houfei-e-o025d-q","section":"chapter-005","block":"b-0744a279ae4c62a54e64","layer":"original","quote":"青龙二年春，追谥后兄俨曰安城乡穆侯。夏，吴贼寇扬州，以像为伏波将军〖12〗，持节，监诸将东征〖13〗。还，复为射声校尉〖14〗。三年薨〖15〗，追赠卫将军，改封魏昌县，谥曰贞侯。子畅嗣。又封畅弟温、4 、艳，皆为列侯。四年〖16〗，改逸、俨本封，皆曰魏昌侯，谥因故〖17〗。封俨世妇刘为东乡君〖18〗，又追封逸世妇张为安喜君。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":97,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":163,"offset_unit":"unicode_code_point"},{"id":"houfei-e-p017b-q","section":"chapter-005","block":"b-0e7b28b95dcd91d94026","layer":"pei","quote":"《晋诸公赞》曰：“德字彦孙。司马景王辅政，以女妻德；妻早亡，文王复以女继室，即京兆长公主：景、文二王欲自结于郭后，是以频繁为婚。德虽无才学，而恭谨谦顺。甄温字仲舒。与郭建及德等皆后族，以事宜见宠。咸熙初，封郭建为临渭县公，德广安县公，邑皆千八百户。温本国侯，进为辅国大将军，加侍中，领射声校尉；德镇军大将军。泰始元年，晋受禅，加建、德、温三人位特进。德为人贞素，加以世祖姊夫，是以遂贵当世。德暮年官更转为宗正，迁侍中。太康中，大司马齐王攸，当之藩；德与左卫将军王济共谏请，时人嘉之。世祖以此望德；由此出德为大鸿胪，加侍中、光禄大夫。寻疾薨，赠中军大将军，开府、侍中如故，谥恭公。子喜嗣。喜精粹有器美，历中书郎、右卫将军、侍中，位至辅国大将军，加散骑常侍。喜与国姻亲，而经赵王伦、齐王冏事故，能不豫际会；良由其才短，然亦以退静免之。”","attribution":"《晋诸公赞》","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":153,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9de40166c48022ac7ce3","start":0,"end":366,"offset_unit":"unicode_code_point"},{"id":"houfei-e-p017c-q","section":"chapter-005","block":"b-0e7b28b95dcd91d94026","layer":"pei","quote":"《晋诸公赞》曰：“德字彦孙。司马景王辅政，以女妻德；妻早亡，文王复以女继室，即京兆长公主：景、文二王欲自结于郭后，是以频繁为婚。德虽无才学，而恭谨谦顺。甄温字仲舒。与郭建及德等皆后族，以事宜见宠。咸熙初，封郭建为临渭县公，德广安县公，邑皆千八百户。温本国侯，进为辅国大将军，加侍中，领射声校尉；德镇军大将军。泰始元年，晋受禅，加建、德、温三人位特进。德为人贞素，加以世祖姊夫，是以遂贵当世。德暮年官更转为宗正，迁侍中。太康中，大司马齐王攸，当之藩；德与左卫将军王济共谏请，时人嘉之。世祖以此望德；由此出德为大鸿胪，加侍中、光禄大夫。寻疾薨，赠中军大将军，开府、侍中如故，谥恭公。子喜嗣。喜精粹有器美，历中书郎、右卫将军、侍中，位至辅国大将军，加散骑常侍。喜与国姻亲，而经赵王伦、齐王冏事故，能不豫际会；良由其才短，然亦以退静免之。”","attribution":"《晋诸公赞》","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":153,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9de40166c48022ac7ce3","start":0,"end":366,"offset_unit":"unicode_code_point"},{"id":"houfei-f0004-q","section":"chapter-005","block":"b-0e7b28b95dcd91d94026","layer":"pei","quote":"甄温字仲舒","attribution":"《晋诸公赞》","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":153,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9de40166c48022ac7ce3","start":76,"end":81,"offset_unit":"unicode_code_point"},{"id":"houfei-q-b-234ff55f537cf4e871c2","section":"chapter-005","block":"b-234ff55f537cf4e871c2","layer":"modern","quote":"〖6〗五年：景元五年（公元 264）。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":245,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b27d4f7345ba1ef8f50e","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"houfei-q-o025","section":"chapter-005","block":"b-0744a279ae4c62a54e64","layer":"original","quote":"青龙二年春，追谥后兄俨曰安城乡穆侯。夏，吴贼寇扬州，以像为伏波将军〖12〗，持节，监诸将东征〖13〗。还，复为射声校尉〖14〗。三年薨〖15〗，追赠卫将军，改封魏昌县，谥曰贞侯。子畅嗣。又封畅弟温、4 、艳，皆为列侯。四年〖16〗，改逸、俨本封，皆曰魏昌侯，谥因故〖17〗。封俨世妇刘为东乡君〖18〗，又追封逸世妇张为安喜君。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":97,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":163,"offset_unit":"unicode_code_point"},{"id":"houfei-q-o052","section":"chapter-005","block":"b-397e525876b311da43d2","layer":"original","quote":"景元四年十二月，崩。五年二月〖6〗，葬高平陵西。﹝二﹞","section_titl