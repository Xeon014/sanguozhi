er":[1,104,"O014a"],"order":64},{"id":"lvzang-e-o059","title":"酸枣设坛诸州郡共推臧洪升坛歃血为盟","accounts":[{"id":"lvzang-a-498614cece8a2bda52b3","label":"正文","text":"酸枣设坛诸州郡共推臧洪升坛歃血为盟","evidence":["lvzang-q-0c0e990ee4b0bea7826f"]}],"participants":[{"person":"lvzang-p0017","role":"被咸共推、升坛操盘歃血而盟曰汉室不幸皇纲失统贼臣董卓乘衅纵害祸加至尊虐流百姓大惧沦丧社稷翦覆四海、辞气慷慨涕泣横下","evidence":["lvzang-q-0c0e990ee4b0bea7826f"]},{"person":"wudi-p0060","role":"兖州刺史、纠合义兵并赴国难","evidence":["lvzang-q-0c0e990ee4b0bea7826f"]},{"person":"wudi-p0059","role":"豫州刺史、纠合义兵并赴国难","evidence":["lvzang-q-0c0e990ee4b0bea7826f"]},{"person":"wudi-p0062","role":"陈留太守、纠合义兵并赴国难","evidence":["lvzang-q-0c0e990ee4b0bea7826f"]},{"person":"wudi-p0063","role":"东郡太守、纠合义兵并赴国难","evidence":["lvzang-q-0c0e990ee4b0bea7826f"]},{"person":"zhangle-p0013","role":"广陵太守、纠合义兵并赴国难","evidence":["lvzang-q-0c0e990ee4b0bea7826f"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["lvzang-q-0c0e990ee4b0bea7826f"]},"ordering_evidence":"lvzang-q-0c0e990ee4b0bea7826f","source_order":[7,167,0],"order":1883}],"persons":[{"id":"wudi-p0063","name":"桥瑁","evidence":["wudi-q-o009","lvzang-q-0c0e990ee4b0bea7826f"],"facts":[{"id":"wudi-f-p026-wudi-p0063-c55038","label":"字","text":"元伟","evidence":["wudi-q-p026"]},{"id":"wudi-f-p026-wudi-p0063-1c9d9e","label":"亲属记载","text":"桥玄族子","evidence":["wudi-q-p026"]},{"id":"wudi-f-p026-wudi-p0063-6167ce","label":"任官记载","text":"曾任兖州刺史","evidence":["wudi-q-p026"]}],"aliases":[{"text":"元伟","evidence":["wudi-q-p026"]}],"mentions":[{"id":"wudi-m-o009-wudi-p0063","kind":"mention","text":"文中提及","evidence":["wudi-q-o009"]},{"id":"wudi-m-p022-wudi-p0063","kind":"mention","text":"文中提及","evidence":["wudi-q-p022"]},{"id":"wudi-m-p026-wudi-p0063","kind":"mention","text":"文中提及","evidence":["wudi-q-p026"]},{"id":"wudi-m-o010-wudi-p0063","kind":"mention","text":"文中提及","evidence":["wudi-q-o010"]},{"id":"wudi-m-o014-wudi-p0063","kind":"mention","text":"文中提及","evidence":["wudi-q-o014"]}]}],"evidence":[{"id":"dongyuan-e-o036a-q","section":"chapter-006","block":"b-5c715668eee2a0a99811","layer":"original","quote":"绍遂以勃海起兵，将以诛卓。语在《武纪》。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":221,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"liusima-q-1dea94bc4c56b3bfe0b5","section":"chapter-015","block":"b-511f012c14f14dff5c5b","layer":"original","quote":"后数月，关东诸州郡起兵，众数十万，皆集荥阳及河内。诸将不能相一〖10〗，纵兵抄掠，民人死者且半","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":58,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":25,"end":72,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-0c0e990ee4b0bea7826f","section":"chapter-007","block":"b-e38569d56e09470a97bd","layer":"original","quote":"乃设坛场，方共盟誓；诸州郡更相让，莫敢当〖9〗，咸共推洪。洪乃升坛，操盘歃血而盟曰〖10〗：“汉室不幸，皇纲失统；贼臣董卓乘衅纵害，祸加至尊〖11〗，虐流百姓；大惧沦丧社稷，翦覆四海〖12〗。兖州刺史岱、豫州刺史伷、陈留太守邈、东郡太守瑁、广陵太守超等，纠合义兵，并赴国难。凡我同盟，齐心戮力，以致臣节；殒首丧元〖13〗，必无二志！有渝此盟，俾坠其命〖14〗，无克遗育〖15〗！皇天后土，祖宗明灵：实皆鉴之〖16〗！”洪辞气慷慨，涕泣横下。闻其言者，虽卒伍厮养〖17〗，莫不激扬，人思致节","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":166,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":244,"offset_unit":"unicode_code_point"},{"id":"rensu-q-f64cf1a8c7978e162aed","section":"chapter-016","block":"b-c172c36c6f19e1d68402","layer":"pei","quote":"关东义兵起，卓会议大发兵；群僚咸惮卓，莫敢忤旨","attribution":"裴注·张璠《汉纪》","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":338,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-011440cf6742ee5cb197","start":246,"end":269,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o009a-q","section":"chapter-001","block":"b-20c7e941eb42ee97df8c","layer":"original","quote":"初平元年春正月〖1〗，后将军袁术、冀州牧韩馥、﹝一﹞豫州刺史孔伷、﹝二﹞兖州刺史刘岱、﹝三﹞河内太守王匡、﹝四﹞勃海太守袁绍、陈留太守张邈、东郡太守桥瑁、﹝五﹞山阳太守袁遗、﹝六﹞济北相鲍信，﹝七﹞同时俱起兵〖2〗。众各数万，推绍为盟主。太祖行奋武将军〖3〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":84,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":130,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o010b-q","section":"chapter-001","block":"b-c3c5890f31591fa3c33e","layer":"original","quote":"是时。绍屯河内〖2〗，邈、岱、瑁、遗屯酸枣〖3〗，术屯南阳〖4〗，伷屯颍川，馥在邺〖5〗。卓兵强，绍等莫敢先进。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":99,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":30,"end":86,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o014a-q","section":"chapter-001","block":"b-dc4cb1aed0af168c4564","layer":"original","quote":"刘岱与桥瑁相恶〖25〗，岱杀瑁，以王肱领东郡太守〖26〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":103,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":29,"offset_unit":"unicode_code_point"},{"id":"wudi-e-p022b-q","section":"chapter-001","block":"b-8628e740812ad3fcff78","layer":"pei","quote":"东郡太守桥瑁，诈作京师三公移书，与州郡，陈卓罪恶，云‘见逼迫，无以自救；企望义兵，解国患难’。","attribution":"《英雄记》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":90,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6e459510c0c0ec488b06","start":74,"end":121,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-4a17eb75600ced2abdde","section":"chapter-001","block":"b-4a17eb75600ced2abdde","layer":"modern","quote":"〖1〗初平元年：公元 190 年。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":86,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-93d66253e23c705b336d","start":0,"end":17,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o009","section":"chapter-001","block":"b-20c7e941eb42ee97df8c","layer":"original","quote":"初平元年春正月〖1〗，后将军袁术、冀州牧韩馥、﹝一﹞豫州刺史孔伷、﹝二﹞兖州刺史刘岱、﹝三﹞河内太守王匡、﹝四﹞勃海太守袁绍、陈留太守张邈、东郡太守桥瑁、﹝五﹞山阳太守袁遗、﹝六﹞济北相鲍信，﹝七﹞同时俱起兵〖2〗。众各数万，推绍为盟主。太祖行奋武将军〖3〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":84,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":130,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o010","section":"chapter-001","block":"b-c3c5890f31591fa3c33e","layer":"original","quote":"二月，卓闻兵起，乃徙天子都长安〖1〗。卓留屯洛阳，遂焚宫室。是时。绍屯河内〖2〗，邈、岱、瑁、遗屯酸枣〖3〗，术屯南阳〖4〗，伷屯颍川，馥在邺〖5〗。卓兵强，绍等莫敢先进。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":99,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":86,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o014","section":"chapter-001","block":"b-dc4cb1aed0af168c4564","layer":"original","quote":"刘岱与桥瑁相恶〖25〗，岱杀瑁，以王肱领东郡太守〖26〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":103,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":29,"offset_unit":"unicode_code_point"},{"id":"wudi-q-p022","section":"chapter-001","block":"b-8628e740812ad3fcff78","layer":"pei","quote":"﹝一﹞《英雄记》曰：“馥字文节，颍川人。为御史中丞。董卓举为冀州牧。于时冀州民人殷盛，兵粮优足。袁绍之在勃海，馥恐其兴兵，遣数部从事守之，不得动摇。东郡太守桥瑁，诈作京师三公移书，与州郡，陈卓罪恶，云‘见逼迫，无以自救；企望义兵，解国患难’。馥得移，请诸从事问曰：‘今当助袁氏邪，助董卓邪？’治中从事刘子惠曰：‘今兴兵为国，何谓袁、董！’馥自知言短，而有惭色。子惠复言：‘兵者凶事，不可为首。今宜往视他州，有发动者，然后和之。冀州于他州不为弱也，他人功未有在冀州之右者也。’馥然之。馥乃作书与绍，道卓之恶，听其举兵。”","attribution":"《英雄记》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":90,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6e459510c0c0ec488b06","start":0,"end":259,"offset_unit":"unicode_code_point"},{"id":"wudi-q-p026","section":"chapter-001","block":"b-4deebbcde1ac1f9ea901","layer":"pei","quote":"﹝五﹞《英雄记》曰：“瑁字元伟。玄族子。先为兖州刺史，甚有威惠。”","attribution":"《英雄记》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":94,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-e0e778cc8691b030ffc3","start":0,"end":33,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
