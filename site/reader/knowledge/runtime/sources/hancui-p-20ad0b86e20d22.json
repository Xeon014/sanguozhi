{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"hancui-e-6f50713fb1de8ddaacc6","title":"高慎抚五孤何英嫁女","accounts":[{"id":"hancui-a-6f50713fb1de8ddaacc6","label":"裴注·陈留耆旧传","text":"高慎抚五孤何英嫁女","evidence":["hancui-q-fcdcff357e6c404029f1"]}],"participants":[{"person":"hancui-p-20ad0b86e20d22","role":"抚孤婚配","evidence":["hancui-q-fcdcff357e6c404029f1"]},{"person":"hancui-p-36829db2167c6d","role":"嫁女","evidence":["hancui-q-fcdcff357e6c404029f1"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["hancui-q-fcdcff357e6c404029f1"]},"ordering_evidence":"hancui-q-fcdcff357e6c404029f1","order":4936},{"id":"hancui-e-2fd80d6fcaf113fd076f","title":"高慎历二县令东莱太守老病归家答妻不积财","accounts":[{"id":"hancui-a-2fd80d6fcaf113fd076f","label":"裴注·陈留耆旧传","text":"高慎历二县令东莱太守老病归家答妻不积财","evidence":["hancui-q-61bfe5d571c78d4ac20e"]}],"participants":[{"person":"hancui-p-20ad0b86e20d22","role":"任官退居","evidence":["hancui-q-61bfe5d571c78d4ac20e"]},{"person":"hancui-p-621b7fc0e52798","role":"问积财","evidence":["hancui-q-61bfe5d571c78d4ac20e"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["hancui-q-61bfe5d571c78d4ac20e"]},"ordering_evidence":"hancui-q-61bfe5d571c78d4ac20e","order":4937}],"persons":[{"id":"hancui-p-20ad0b86e20d22","name":"高慎","evidence":["hancui-q-fcdcff357e6c404029f1","hancui-q-61bfe5d571c78d4ac20e","hancui-q-520558038dc7d9d2677d"],"facts":[{"id":"hancui-f-39046ecf456c3303a21e","text":"字孝甫，高固之子。","evidence":["hancui-q-520558038dc7d9d2677d"]}],"mentions":[],"aliases":[]}],"evidence":[{"id":"hancui-q-520558038dc7d9d2677d","section":"chapter-024","block":"b-636538eb5af9c7c34526","layer":"pei","quote":"﹝一﹞《陈留耆旧传》曰：“靖高祖父固，不仕王莽世。为淮阳太守所害，以烈节垂名。固子慎，字孝甫。敦厚少华，有沉深之量。抚育孤兄子五人，恩义甚笃。琅邪相何英嘉其行履，以女妻焉。英即车骑将军熙之父也。慎历二县令、东莱太守。老病归家，草屋蓬户，瓮缶无储。其妻谓之曰：‘君累经宰守，积有年岁，何能不少为储蓄以遗子孙乎？’慎曰：‘我以勤身清名为之基，以二千石遗之，不亦可乎！’子式，至孝，常尽力供养。永初中，螟蝗为害，独不食式麦；圉令周强以表州郡。太守杨舜举式孝子；让，不行。后以孝廉为郎。次子昌，昌弟赐；并为刺史、郡守。式子弘，孝廉。弘生靖。”","attribution":"裴注（引书见原文，待主审复核）","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":147,"anchor":null},"note_id":"n-1cdde7f49e866c28648d","start":0,"end":267},{"id":"hancui-q-61bfe5d571c78d4ac20e","section":"chapter-024","block":"b-636538eb5af9c7c34526","layer":"pei","quote":"慎历二县令、东莱太守。老病归家，草屋蓬户，瓮缶无储。其妻谓之曰：‘君累经宰守，积有年岁，何能不少为储蓄以遗子孙乎？’慎曰：‘我以勤身清名为之基，以二千石遗之，不亦可乎！","attribution":"裴注·陈留耆旧传","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":147,"anchor":null},"note_id":"n-1cdde7f49e866c28648d","start":97,"end":181},{"id":"hancui-q-fcdcff357e6c404029f1","section":"chapter-024","block":"b-636538eb5af9c7c34526","layer":"pei","quote":"固子慎，字孝甫。敦厚少华，有沉深之量。抚育孤兄子五人，恩义甚笃。琅邪相何英嘉其行履，以女妻焉。","attribution":"裴注·陈留耆旧传","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":147,"anchor":null},"note_id":"n-1cdde7f49e866c28648d","start":39,"end":86}],"profiles":{},"directory_counts":{}}
