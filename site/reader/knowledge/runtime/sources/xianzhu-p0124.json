{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-o072a","title":"黄元举兵拒守汉嘉","accounts":[{"id":"xianzhu-e-o072a-account","label":"《先主传》正文","text":"汉嘉太守黄元闻刘备病重，举兵拒守。","evidence":["xianzhu-e-o072a-q"]}],"participants":[{"person":"xianzhu-p0124","role":"举兵","evidence":["xianzhu-e-o072a-q"]}],"place":{"text":"汉嘉","evidence":["xianzhu-e-o072a-q"]},"time":{"year":222,"label":"章武二年十二月","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xianzhu-y222","dating_review":{"reviewed":true,"anchor":"xianzhu-q-o068","basis":"章武二年十二月"},"evidence":["xianzhu-e-o072a-q","xianzhu-q-o068","xianzhu-q-b-e2b85eacbc16310809ee"]},"source_order":[32,406,"O072a"],"order":6618},{"id":"xianzhu-e-o073b","title":"陈曶讨黄元黄元败后被斩","accounts":[{"id":"xianzhu-e-o073b-account","label":"《先主传》正文","text":"黄元攻临邛，陈曶奉命讨伐；黄元败走，被亲兵绑送成都处斩。","evidence":["xianzhu-e-o073b-q"]},{"id":"huowang-a-e20f2e61aa8bbd800d59","label":"正文","text":"黄元举郡反烧临邛","evidence":["huowang-q-8e4249faeeb7833f6099"]},{"id":"huowang-a-c77c7ccab39371014de9","label":"正文","text":"杨洪遣将讨黄元","evidence":["huowang-q-e1ed3a761d357320e233"]},{"id":"huowang-a-ac20016d06ccac68e511","label":"正文","text":"陈曶郑绰生获黄元","evidence":["huowang-q-124c4d30886aab13c8c5"]}],"participants":[{"person":"xianzhu-p0124","role":"进兵败死","evidence":["xianzhu-e-o073b-q"]},{"person":"xianzhu-p0125","role":"讨伐","evidence":["xianzhu-e-o073b-q"]},{"person":"zhuge-liang","role":"素不善黄元，时东行省刘备疾，成都单虚","evidence":["huowang-q-8e4249faeeb7833f6099"]},{"person":"xianzhu-p0097","role":"即启太子，遣其亲兵，使将军陈曶、郑绰讨黄元；敕陈曶、郑绰但于南安峡口遮","evidence":["huowang-q-e1ed3a761d357320e233","huowang-q-124c4d30886aab13c8c5"]},{"person":"xianzhu-p0112","role":"太子，受杨洪启","evidence":["huowang-q-e1ed3a761d357320e233"]},{"person":"huowang-p0031","role":"将军，奉命讨黄元；承杨洪言于南安峡口遮截，生获黄元","evidence":["huowang-q-e1ed3a761d357320e233","huowang-q-124c4d30886aab13c8c5"]}],"place":{"text":"临邛、成都","evidence":["xianzhu-e-o073b-q"]},"time":{"year":223,"label":"章武三年三月","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xianzhu-y223","dating_review":{"reviewed":true,"anchor":"xianzhu-q-o073","basis":"章武三年三月"},"evidence":["xianzhu-e-o073b-q","xianzhu-q-o073","xianzhu-q-b-c3a154cca1b5578eba4b"]},"source_order":[32,430,"O073b"],"order":6620}],"persons":[{"id":"xianzhu-p0124","name":"黄元","evidence":["xianzhu-q-o072","huowang-q-8e4249faeeb7833f6099","huowang-q-e1ed3a761d357320e233","huowang-q-124c4d30886aab13c8c5"],"facts":[],"aliases":[],"mentions":[{"id":"xianzhu-m-o072-xianzhu-p0124","kind":"mention","text":"文中提及","evidence":["xianzhu-q-o072"]},{"id":"xianzhu-m-o073-xianzhu-p0124","kind":"mention","text":"文中提及","evidence":["xianzhu-q-o073"]}]}],"evidence":[{"id":"huowang-q-124c4d30886aab13c8c5","section":"chapter-041","block":"b-84496185788f03e98dc9","layer":"original","quote":"敕曶、绰：“但于南安峡口遮，便得矣〖9〗。”曶、绰承洪言，果生获元","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":122,"anchor":null},"note_id":null,"start":79,"end":112},{"id":"huowang-q-8e4249faeeb7833f6099","section":"chapter-041","block":"b-f5d2aa43bc3afae2aab6","layer":"original","quote":"汉嘉太守黄元素为诸葛亮所不善，闻先主疾病，惧有后患；举郡反，烧临邛城。时亮东行省疾〖6〗，成都单虚，是以元益无所惮","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":121,"anchor":null},"note_id":null,"start":29,"end":86},{"id":"huowang-q-e1ed3a761d357320e233","section":"chapter-041","block":"b-f5d2aa43bc3afae2aab6","layer":"original","quote":"洪即启太子，遣其亲兵，使将军陈曶、郑绰讨元","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":121,"anchor":null},"note_id":null,"start":87,"end":108},{"id":"xianzhu-e-o072a-q","section":"chapter-032","block":"b-989854da8c38316f30b5","layer":"original","quote":"十二月，汉嘉太守黄元闻先主疾不豫〖18〗，举兵拒守。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":405,"anchor":null},"note_id":null,"start":0,"end":26},{"id":"xianzhu-e-o073b-q","section":"chapter-032","block":"b-4232898cf1bcba6ab843","layer":"original","quote":"三月，黄元进兵攻临邛县〖2〗。遣将军陈曶﹝一﹞讨元。元军败，顺流下江；为其亲兵所缚，生致成都，斩之。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":429,"anchor":null},"note_id":null,"start":19,"end":69},{"id":"xianzhu-q-b-c3a154cca1b5578eba4b","section":"chapter-032","block":"b-c3a154cca1b5578eba4b","layer":"modern","quote":"〖1〗三年：章武三年（公元 223）。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":435,"anchor":null},"note_id":"n-51b38d25bb3f712211d0","start":0,"end":19},{"id":"xianzhu-q-b-e2b85eacbc16310809ee","section":"chapter-032","block":"b-e2b85eacbc16310809ee","layer":"modern","quote":"〖7〗二年：章武二年（公元 222）。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":413,"anchor":null},"note_id":"n-18295fa1c5ff11c612db","start":0,"end":19},{"id":"xianzhu-q-o068","section":"chapter-032","block":"b-8136daaf302c35b9c188","layer":"original","quote":"二年春正月〖7〗，先主军还秭归；将军吴班、陈式水军屯夷陵，夹江东西岸〖8〗。二月，先主自秭归率诸将进军，缘山截岭，于夷道猇亭﹝二﹞驻营〖9〗。自佷山﹝三﹞通武陵〖10〗，遣侍中马良安慰五溪蛮夷〖11〗，咸相率响应。镇北将军黄权督江北诸军，与吴军相拒于夷陵道。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":401,"anchor":null},"note_id":null,"start":0,"end":129},{"id":"xianzhu-q-o072","section":"chapter-032","block":"b-989854da8c38316f30b5","layer":"original","quote":"十二月，汉嘉太守黄元闻先主疾不豫〖18〗，举兵拒守。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":405,"anchor":null},"note_id":null,"start":0,"end":26},{"id":"xianzhu-q-o073","section":"chapter-032","block":"b-4232898cf1bcba6ab843","layer":"original","quote":"三年春二月〖1〗，丞相亮自成都到永安。三月，黄元进兵攻临邛县〖2〗。遣将军陈曶﹝一﹞讨元。元军败，顺流下江；为其亲兵所缚，生致成都，斩之。先主病笃，托孤于丞相亮〖3〗；尚书令李严为副。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":429,"anchor":null},"note_id":null,"start":0,"end":92}],"profiles":{},"directory_counts":{}}
