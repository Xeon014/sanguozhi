46,"end":104,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-04c1e38d918e22af9740","section":"chapter-030","block":"b-4dd367fecb7f6c7610ef","layer":"original","quote":"文帝立素利、弥加为归义王","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":75,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":98,"end":110,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-291613c697594c93d058","section":"chapter-030","block":"b-4dd367fecb7f6c7610ef","layer":"original","quote":"建安中，因阎柔上贡献，通市","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":75,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":48,"end":61,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-9b791aed7db4668ccc96","section":"chapter-030","block":"b-4dd367fecb7f6c7610ef","layer":"original","quote":"素利、弥加、厥机皆为大人，在辽西、右北平、渔阳塞外；道远，初不为边患〖29〗，然其种众多于比能。建安中，因阎柔上贡献，通市；太祖皆表宠以为王。厥机死，又立其子沙末汗为亲汉王。延康初，又各遣使献马。文帝立素利、弥加为归义王。素利与比能更相攻击。太和二年，素利死，子小。以弟成律归为王，代摄其众。","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":75,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":146,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-b29cf38e1e172abf2c5a","section":"chapter-030","block":"b-4dd367fecb7f6c7610ef","layer":"original","quote":"太祖皆表宠以为王","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":75,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":62,"end":70,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-cf91bcfa117b367f7b5a","section":"chapter-030","block":"b-4dd367fecb7f6c7610ef","layer":"original","quote":"延康初，又各遣使献马","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":75,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":87,"end":97,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
