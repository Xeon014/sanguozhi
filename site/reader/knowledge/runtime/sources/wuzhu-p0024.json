label":"字","text":"仲山","evidence":["wuzhu-f0007-q"]},{"id":"wuzhu-f0008","label":"籍贯","text":"吴郡","evidence":["wuzhu-f0008-q"]}],"aliases":[{"text":"仲山","evidence":["wuzhu-f0007-q"]}],"mentions":[{"id":"wuzhu-m-o053-wuzhu-p0024","kind":"mention","text":"文中提及","evidence":["wuzhu-q-o053"]},{"id":"wuzhu-m-p020-wuzhu-p0024","kind":"mention","text":"文中提及","evidence":["wuzhu-q-p020"]}]}],"evidence":[{"id":"wuzhu-e-o053a-q","section":"chapter-047","block":"b-41cfa65d37ef76389424","layer":"original","quote":"帝欲封权子登〖82〗；权以登年幼，上书辞封，重遣西曹掾沈珩陈谢〖83〗，并献方物〖84〗。﹝六﹞立登为王太子。﹝七﹞","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":199,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":58,"offset_unit":"unicode_code_point"},{"id":"wuzhu-e-p020a-q","section":"chapter-047","block":"b-58bfcd55c420bbec612a","layer":"pei","quote":"权以珩有智谋，能专对，乃使至魏。魏文帝问曰：‘吴嫌魏东向乎？’珩曰：‘不嫌。’曰：‘何以？’曰：‘信恃旧盟，言归于好，是以不嫌。若魏渝盟，自有预备。’又问：‘闻太子当来，宁然乎？’珩曰：‘臣在东朝，朝不坐，宴不与；若此之议，无所闻也。’文帝善之，乃引珩自近，谈语终日。珩随事响应，无所屈服。","attribution":"《吴书》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":291,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f72a6a6ffb7e6ec50a34","start":41,"end":186,"offset_unit":"unicode_code_point"},{"id":"wuzhu-e-p020b-q","section":"chapter-047","block":"b-58bfcd55c420bbec612a","layer":"pei","quote":"珩还，言曰：‘臣密参侍中刘晔，数为贼设奸计，终不久悫。臣闻兵家旧论：不恃敌之不我犯，恃我之不可犯。今为朝廷虑之，且当省息他役，惟务农桑以广军资；修缮舟车，增作战具，令皆兼盈；抚养兵民，使各得其所；揽延英俊，奖励将士：则天下可图矣！’以奉使有称，封永安乡侯，官至少府。","attribution":"《吴书》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":291,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f72a6a6ffb7e6ec50a34","start":186,"end":319,"offset_unit":"unicode_code_point"},{"id":"wuzhu-f0007-q","section":"chapter-047","block":"b-58bfcd55c420bbec612a","layer":"pei","quote":"珩，字仲山","attribution":"《吴书》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":291,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f72a6a6ffb7e6ec50a34","start":10,"end":15,"offset_unit":"unicode_code_point"},{"id":"wuzhu-f0008-q","section":"chapter-047","block":"b-58bfcd55c420bbec612a","layer":"pei","quote":"吴郡人","attribution":"《吴书》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":291,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f72a6a6ffb7e6ec50a34","start":16,"end":19,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o053","section":"chapter-047","block":"b-41cfa65d37ef76389424","layer":"original","quote":"帝欲封权子登〖82〗；权以登年幼，上书辞封，重遣西曹掾沈珩陈谢〖83〗，并献方物〖84〗。﹝六﹞立登为王太子。﹝七﹞","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":199,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":58,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-p020","section":"chapter-047","block":"b-58bfcd55c420bbec612a","layer":"pei","quote":"﹝六﹞《吴书》曰：“珩，字仲山，吴郡人。少（总）〔综〕经艺，尤善《春秋》内、外传。权以珩有智谋，能专对，乃使至魏。魏文帝问曰：‘吴嫌魏东向乎？’珩曰：‘不嫌。’曰：‘何以？’曰：‘信恃旧盟，言归于好，是以不嫌。若魏渝盟，自有预备。’又问：‘闻太子当来，宁然乎？’珩曰：‘臣在东朝，朝不坐，宴不与；若此之议，无所闻也。’文帝善之，乃引珩自近，谈语终日。珩随事响应，无所屈服。珩还，言曰：‘臣密参侍中刘晔，数为贼设奸计，终不久悫。臣闻兵家旧论：不恃敌之不我犯，恃我之不可犯。今为朝廷虑之，且当省息他役，惟务农桑以广军资；修缮舟车，增作战具，令皆兼盈；抚养兵民，使各得其所；揽延英俊，奖励将士：则天下可图矣！’以奉使有称，封永安乡侯，官至少府。”","attribution":"《吴书》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":291,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f72a6a6ffb7e6ec50a34","start":0,"end":320,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
