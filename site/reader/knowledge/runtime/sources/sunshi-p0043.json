{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"sunshi-e-o026a","title":"袁术许九江给孙策却用陈纪","accounts":[{"id":"sunshi-e-o026a-account","label":"《孙破虏讨逆传第一》正文","text":"袁术许九江给孙策却用陈纪","evidence":["sunshi-e-o026a-q"]}],"participants":[{"person":"wudi-p0057","role":"失约授官","evidence":["sunshi-e-o026a-q"]},{"person":"wudi-p0099","role":"失望","evidence":["sunshi-e-o026a-q"]},{"person":"sunshi-p0043","role":"受任","evidence":["sunshi-e-o026a-q"]}],"place":null,"time":{"label":"孙策从袁术时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["sunshi-e-o026a-q"]},"ordering_evidence":"sunshi-e-o026a-q","source_order":[46,179,"O026a"],"order":8072}],"persons":[{"id":"sunshi-p0043","name":"陈纪（丹杨）","evidence":["sunshi-q-o026"],"facts":[],"aliases":[],"mentions":[{"id":"sunshi-m-o026-sunshi-p0043","kind":"mention","text":"文中提及","evidence":["sunshi-q-o026"]}]}],"evidence":[{"id":"sunshi-e-o026a-q","section":"chapter-046","block":"b-b7d697cd1a21ff6c147e","layer":"original","quote":"术初许策为九江太守〖15〗，已而更用丹杨陈纪〖16〗。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":178,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":27,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-o026","section":"chapter-046","block":"b-b7d697cd1a21ff6c147e","layer":"original","quote":"术初许策为九江太守〖15〗，已而更用丹杨陈纪〖16〗。后术欲攻徐州，从庐江太守陆康求米三万斛〖17〗；康不与，术大怒。策昔曾诣康，康不见；使主簿接之，策尝衔恨。术遣策攻康，谓曰：“前错用陈纪，每恨本意不遂。今若得康，庐江，真卿有也〖18〗！”策攻康，拔之；术复用其故吏刘勋为太守〖19〗，策益失望。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":178,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":149,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
