{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o069a","title":"刘备杀车胄起兵","accounts":[{"id":"wudi-e-o069a-account","label":"正文","text":"刘备东行前曾暗与董承等合谋；到下邳后杀车胄，举兵屯沛，曹操遣刘岱、王忠进攻未胜。","evidence":["wudi-e-o069a-q"]},{"id":"xianzhu-e-o016b-account","label":"《先主传》正文","text":"刘备据下邳，朱灵等返回；刘备杀车胄，留关羽守下邳，自己回小沛。","evidence":["xianzhu-e-o016b-q"]},{"id":"chengguo-a-ce7efe2e02d7877e36ca","label":"正文","text":"刘备杀车胄举兵背曹操","evidence":["chengguo-q-57bb02c8bc8efe183f2e"]},{"id":"chengguo-a-730be3f405180eb5540f","label":"正文","text":"刘备杀车胄反","evidence":["chengguo-q-791bacb1947a88965eb8"]}],"participants":[{"person":"liu-bei","role":"合谋起兵","evidence":["wudi-e-o069a-q"]},{"person":"wudi-p0113","role":"合谋","evidence":["wudi-e-o069a-q"]},{"person":"wudi-p0165","role":"被杀","evidence":["wudi-e-o069a-q"]},{"person":"cao-cao","role":"遣将","evidence":["wudi-e-o069a-q"]},{"person":"wudi-p0166","role":"进攻未克","evidence":["wudi-e-o069a-q"]},{"person":"wudi-p0167","role":"进攻未克","evidence":["wudi-e-o069a-q"]},{"person":"wudi-p0172","role":"守下邳","evidence":["xianzhu-e-o016b-q"]},{"person":"wudi-p0164","role":"返回","evidence":["xianzhu-e-o016b-q"]}],"place":{"text":"下邳、沛","evidence":["wudi-e-o069a-q"]},"time":{"label":"建安四年","year":199,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o069a-q","wudi-q-o061","wudi-q-b-51bced16741add42ff70"],"chronology":"wudi-y199","dating_review":{"anchor":"wudi-q-o061","basis":"建安四年","reviewed":true}},"source_order":[1,367,"O069a"],"order":169},{"id":"wudi-e-p053a","title":"刘备对刘岱军称不足惧","accounts":[{"id":"wudi-e-p053a-account","label":"《献帝春秋》","text":"《献帝春秋》记刘备对刘岱等说，唯曹操亲来才未可知。","evidence":["wudi-e-p053a-q"]},{"id":"xianzhu-e-o017b-account","label":"《先主传》正文","text":"曹操遣刘岱、王忠攻刘备，没有攻克。","evidence":["xianzhu-e-o017b-q"]}],"participants":[{"person":"liu-bei","role":"对敌放言","evidence":["wudi-e-p053a-q"]},{"person":"wudi-p0166","role":"受言","evidence":["wudi-e-p053a-q"]},{"person":"cao-cao","role":"遣将","evidence":["xianzhu-e-o017b-q"]},{"person":"wudi-p0167","role":"进攻","evidence":["xianzhu-e-o017b-q"]}],"place":null,"time":{"label":"刘岱王忠攻刘备时","year":199,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-p053a-q","wudi-q-o061","wudi-q-b-51bced16741add42ff70"],"chronology":"wudi-y199","dating_review":{"anchor":"wudi-q-o061","basis":"刘岱王忠攻刘备时","reviewed":true}},"source_order":[1,398,"P053a"],"order":171},{"id":"wudi-e-p055a","title":"王忠夺娄子伯兵归曹操","accounts":[{"id":"wudi-e-p055a-account","label":"《魏略》","text":"《魏略》记王忠逢三辅乱南行，不愿随娄子伯去荆州，率众夺其兵，后以千余众归曹操，拜中郎将。","evidence":["wudi-e-p055a-q"]}],"participants":[{"person":"wudi-p0167","role":"夺兵归附","evidence":["wudi-e-p055a-q"]},{"person":"wudi-p0169","role":"被夺兵","evidence":["wudi-e-p055a-q"]},{"person":"cao-cao","role":"受降授官","evidence":["wudi-e-p055a-q"]}],"place":{"text":"三辅、武关","evidence":["wudi-e-p055a-q"]},"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p055a-q"]},"source_order":[1,400,"P055a"],"order":172},{"id":"wudi-e-p055b","title":"五官将戏辱王忠","accounts":[{"id":"wudi-e-p055b-account","label":"《魏略》","text":"《魏略》记五官将知王忠曾食人，出行时让俳优以骷髅系其马鞍取笑。","evidence":["wudi-e-p055b-q"]}],"participants":[{"person":"wudi-p0170","role":"命人取笑","evidence":["wudi-e-p055b-q"]},{"person":"wudi-p0167","role":"被戏辱","evidence":["wudi-e-p055b-q"]}],"place":null,"time":{"label":"曹丕任五官将时","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p055b-q"]},"source_order":[1,400,"P055b"],"order":173},{"id":"wudi-e-p112a","title":"曹操辞封，荀攸等劝进","accounts":[{"id":"wudi-e-p112a-account","label":"《魏书》","text":"《魏书》记曹操三让，荀攸等群臣劝进；曹操拟只受魏郡，群臣再次劝其全受，曹操遂受命。","evidence":["wudi-e-p112a-q"]}],"participants":[{"person":"cao-cao","role":"辞后受命","evidence":["wudi-e-p112a-q"]},{"person":"wudi-p0143","role":"劝进","evidence":["wudi-e-p112a-q"]},{"person":"wudi-p0181","role":"劝进","evidence":["wudi-e-p112a-q"]},{"person":"wudi-p0300","role":"劝进","evidence":["