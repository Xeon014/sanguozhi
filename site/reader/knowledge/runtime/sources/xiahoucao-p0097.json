{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xiahoucao-e-p047b","title":"金乡公主藏幼子乞免司马懿特原","accounts":[{"id":"xiahoucao-e-p047b-account","label":"《魏末传》","text":"金乡公主藏幼子乞免司马懿特原","evidence":["xiahoucao-e-p047b-q"]}],"participants":[{"person":"xiahoucao-p0096","role":"藏子求免","evidence":["xiahoucao-e-p047b-q"]},{"person":"xiahoucao-p0097","role":"获免","evidence":["xiahoucao-e-p047b-q"]},{"person":"wudi-p0364","role":"原免","evidence":["xiahoucao-e-p047b-q"]}],"place":null,"time":{"label":"何晏为恶至被诛","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xiahoucao-e-p047b-q"]},"ordering_evidence":"xiahoucao-e-p047b-q","source_order":[9,387,"P047b"],"order":2310}],"persons":[{"id":"xiahoucao-p0097","name":"何晏子（未具名）","evidence":["xiahoucao-q-p047"],"facts":[],"aliases":[],"mentions":[{"id":"xiahoucao-m-p047-xiahoucao-p0097","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-p047"]}]}],"evidence":[{"id":"xiahoucao-e-p047b-q","section":"chapter-009","block":"b-8f654c67b72ea809e6a5","layer":"pei","quote":"俄而晏死。有一男，年五六岁，宣王遣人录之。晏（母）〔妇〕归藏其子王宫中，向使者搏颊，乞白活之。使者具以白宣王。宣王亦闻晏妇有先见之言，心常嘉之；且为沛王故，特原不杀。","attribution":"《魏末传》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":386,"anchor":null},"note_id":"n-46a3d2d6a327171eb9f7","start":60,"end":143},{"id":"xiahoucao-q-p047","section":"chapter-009","block":"b-8f654c67b72ea809e6a5","layer":"pei","quote":"《魏末传》曰：“晏妇金乡公主，即晏同母妹。公主贤，谓其母沛王太妃曰：‘晏为恶日甚，将何保身？’母笑曰：‘汝得无妒晏邪？’俄而晏死。有一男，年五六岁，宣王遣人录之。晏（母）〔妇〕归藏其子王宫中，向使者搏颊，乞白活之。使者具以白宣王。宣王亦闻晏妇有先见之言，心常嘉之；且为沛王故，特原不杀。”臣松之按：《魏末传》云晏取其同母妹为妻，此搢绅所不忍言；虽楚王之妻（嫂）〔媦〕，不是甚也已。设令此言出于旧史，犹将莫之或信，况底下之书乎？按《诸王公传》，沛王出自杜夫人所生。晏母姓尹，公主若与沛王同生，焉得言与晏同母？","attribution":"《魏末传》；裴松之按语","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":386,"anchor":null},"note_id":"n-46a3d2d6a327171eb9f7","start":0,"end":253}],"profiles":{},"directory_counts":{}}
