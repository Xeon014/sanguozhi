/Text/titlepage_0099.xhtml","index":256,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-724f2dcc828652965c88","start":0,"end":47,"offset_unit":"unicode_code_point"},{"id":"wudi-e-p117a-q","section":"chapter-001","block":"b-1292419a27cec410507e","layer":"pei","quote":"﹝二﹞《献帝起居注》曰：“使左中郎将杨宣、亭侯裴茂，持节、印授之。”","attribution":"《献帝起居注》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":316,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-788cfe6ac7196db1dda5","start":0,"end":34,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-c4192d9fada3bef44302","section":"chapter-001","block":"b-c4192d9fada3bef44302","layer":"modern","quote":"〖1〗十九年：建安十九年（公元 214）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":293,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-e80ed93e01a75d2ad2bd","start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o161","section":"chapter-001","block":"b-ba55911420464ee82a49","layer":"original","quote":"十九年春正月〖1〗，始耕籍田〖2〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":280,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":18,"offset_unit":"unicode_code_point"},{"id":"wudi-q-p117","section":"chapter-001","block":"b-1292419a27cec410507e","layer":"pei","quote":"﹝二﹞《献帝起居注》曰：“使左中郎将杨宣、亭侯裴茂，持节、印授之。”","attribution":"《献帝起居注》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":316,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-788cfe6ac7196db1dda5","start":0,"end":34,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-b-55069b3150fc7a092ecf","section":"chapter-010","block":"b-55069b3150fc7a092ecf","layer":"modern","quote":"〖1〗三年：建安三年（公元 198）。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":113,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-2bf03ce242d0f1f296ae","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-o018","section":"chapter-010","block":"b-c84a0f39812ff83ca230","layer":"original","quote":"三年〖1〗，太祖既破张绣，东擒吕布，定徐州；遂与袁绍相拒。孔融谓彧曰：“绍，地广兵强；田丰、许攸，智计之士也，为之谋；审配、逢纪，尽忠之臣也，任其事；颜良、文丑，勇冠三军，统其兵：殆难克乎？”","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":108,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":96,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
