dence":"zongshi-q-e028e737538d763fb420","source_order":[51,135,111],"order":9175}],"persons":[{"id":"houfei-p0044","name":"司马冏","evidence":["houfei-q-p017","xiahoucao-q-p023","wgc-q0135","zongshi-q-7a1c189d9a9d8ab30e7c","zongshi-q-e028e737538d763fb420"],"facts":[],"aliases":[],"mentions":[{"id":"houfei-m-p017-houfei-p0044","kind":"mention","text":"文中提及","evidence":["houfei-q-p017"]},{"id":"xiahoucao-m-p023-houfei-p0044","kind":"mention","text":"文中提及","evidence":["xiahoucao-q-p023"]},{"id":"wgc-m-p059-houfei-p0044","kind":"mention","text":"本段涉及司马冏","evidence":["wgc-q0135"]}]}],"evidence":[{"id":"houfei-q-p017","section":"chapter-005","block":"b-0e7b28b95dcd91d94026","layer":"pei","quote":"《晋诸公赞》曰：“德字彦孙。司马景王辅政，以女妻德；妻早亡，文王复以女继室，即京兆长公主：景、文二王欲自结于郭后，是以频繁为婚。德虽无才学，而恭谨谦顺。甄温字仲舒。与郭建及德等皆后族，以事宜见宠。咸熙初，封郭建为临渭县公，德广安县公，邑皆千八百户。温本国侯，进为辅国大将军，加侍中，领射声校尉；德镇军大将军。泰始元年，晋受禅，加建、德、温三人位特进。德为人贞素，加以世祖姊夫，是以遂贵当世。德暮年官更转为宗正，迁侍中。太康中，大司马齐王攸，当之藩；德与左卫将军王济共谏请，时人嘉之。世祖以此望德；由此出德为大鸿胪，加侍中、光禄大夫。寻疾薨，赠中军大将军，开府、侍中如故，谥恭公。子喜嗣。喜精粹有器美，历中书郎、右卫将军、侍中，位至辅国大将军，加散骑常侍。喜与国姻亲，而经赵王伦、齐王冏事故，能不豫际会；良由其才短，然亦以退静免之。”","attribution":"《晋诸公赞》","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":153,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9de40166c48022ac7ce3","start":0,"end":366,"offset_unit":"unicode_code_point"},{"id":"wgc-q0135","section":"chapter-028","block":"b-a344b1173e6856a98116","layer":"pei","quote":"﹝四﹞《晋诸公赞》曰：“胡烈儿名渊，字世元。遵之孙也。遵，安定人，以才兼文武，累居藩镇，至车骑将军。子奋，字玄威。亦历方任。女为晋武帝贵人，有宠。太康中，以奋为尚书仆射，加镇军大将军，开府。弟广，字宣祖，少府；次烈，字玄武，秦州刺史；次岐，字玄嶷，并州刺史。广子喜，凉州刺史。渊小字鹞鸱。时年十八，既杀会救父，名震远近。后赵王伦篡位，三王兴义，伦使渊与张泓，将兵御齐王，屡破齐军。会成都战克，渊乃归降，伏法。”","attribution":"晋诸公赞","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":593,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-7dfa0827333ec78b2b0e","start":0,"end":205,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-p023a-q","section":"chapter-009","block":"b-4433d07ab640ee5cba7d","layer":"pei","quote":"肇孙摅，字颜远。少厉志操，博学有才藻。仕晋，辟公府；历洛阳令，有能名。大司马齐王冏辅政，摅与齐人左思，俱为记室督。","attribution":"张隐《文士传》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":216,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5eddfa5360f1ff7fa6e2","start":13,"end":70,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-p023","section":"chapter-009","block":"b-4433d07ab640ee5cba7d","layer":"pei","quote":"﹝四﹞张隐《文士传》曰：“肇孙摅，字颜远。少厉志操，博学有才藻。仕晋，辟公府；历洛阳令，有能名。大司马齐王冏辅政，摅与齐人左思，俱为记室督。从中郎出为襄阳太守，征南司马。值天下乱，摅讨贼向吴，战败，死。”","attribution":"张隐《文士传》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":216,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5eddfa5360f1ff7fa6e2","start":0,"end":102,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-7a1c189d9a9d8ab30e7c","section":"chapter-051","block":"b-838933eb0906948787bc","layer":"pei","quote":"晋永宁元年，赴齐王冏义，以功封晋兴侯。辟大司马贼曹属","attribution":"裴注·惠别传","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":134,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1c9591ac978a693556d2","start":84,"end":110,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-e028e737538d763fb420","section":"chapter-051","block":"b-838933eb0906948787bc","layer":"pei","quote":"冏骄矜僭侈，天下失望；惠献言于冏，讽以五难、四不可；劝令委让万机，归藩青岱。辞甚深切，冏不能纳，顷之果败","attribution":"裴注·惠别传","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":134,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1c9591ac978a693556d2","start":111,"end":163,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
