{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xunyu-e-p036a","title":"何颙游学洛阳结交陈蕃李膺党难变名隐汝南","accounts":[{"id":"xunyu-e-p036a-account","label":"张璠《汉纪》","text":"何颙游学洛阳结交陈蕃李膺党难变名隐汝南","evidence":["xunyu-e-p036a-q"]}],"participants":[{"person":"wudi-p0029","role":"游学避难","evidence":["xunyu-e-p036a-q"]},{"person":"wudi-p0036","role":"交游","evidence":["xunyu-e-p036a-q"]},{"person":"zhouyu-p0011","role":"交游","evidence":["xunyu-e-p036a-q"]}],"place":null,"time":{"label":"何颙生平","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xunyu-e-p036a-q"]},"ordering_evidence":"xunyu-e-p036a-q","source_order":[10,206,"P036a"],"order":2478},{"id":"cuimao-e-o162","title":"河南尹李膺敕门下非当世英贤及通家子孙弗见","accounts":[{"id":"cuimao-a-ca5631e7b1ddb3b9a8c6","label":"裴注·《续汉书》","text":"河南尹李膺敕门下非当世英贤及通家子孙弗见","evidence":["cuimao-q-199eed40fa0a6f4fa899"]},{"id":"cuimao-a-83a90caa8ed2d7d1a650","label":"裴注·《续汉书》","text":"孔融年十余岁造李膺门自称通家子孙，众坐奇之，膺称其必为伟器","evidence":["cuimao-q-e39144e8034e81bd2c68"]},{"id":"cuimao-a-a92d631c0f7281e9b73a","label":"裴注·《续汉书》","text":"太中大夫陈炜言小时了了大未必奇，融即如所言君之幼时岂实慧反驳","evidence":["cuimao-q-c0db9dd3e9ad6d34fb81"]}],"participants":[{"person":"zhouyu-p0011","role":"敕门下之河南尹；见而称伟器者","evidence":["cuimao-q-199eed40fa0a6f4fa899","cuimao-q-e39144e8034e81bd2c68"]},{"person":"wudi-p0155","role":"造门应对之童子；反驳者","evidence":["cuimao-q-e39144e8034e81bd2c68","cuimao-q-c0db9dd3e9ad6d34fb81"]},{"person":"cuimao-p0066","role":"质疑者","evidence":["cuimao-q-c0db9dd3e9ad6d34fb81"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["cuimao-q-199eed40fa0a6f4fa899","cuimao-q-e39144e8034e81bd2c68","cuimao-q-c0db9dd3e9ad6d34fb81"]},"ordering_evidence":"cuimao-q-199eed40fa0a6f4fa899","source_order":[12,96,50],"order":2725},{"id":"zhonghua-e-o113","title":"复以李膺妹妻钟觐","accounts":[{"id":"zhonghua-a-310c222efd4f2d3916bf","label":"裴注·先贤行状","text":"复以李膺妹妻钟觐","evidence":["zhon