nce":["luxun-q-o032","luxun-q-b-bec244eebd3282fab965"]},{"id":"zhangyan-m-be63d3002e205f5871f3","kind":"mention","text":"本篇原文记及孙虑，具体行动与称谓见引文。","evidence":["zhangyan-q-cf0d0728b93afb00231c"]}]}],"evidence":[{"id":"houfei-q-o031","section":"chapter-005","block":"b-6812c920b6ae5772de59","layer":"original","quote":"太和六年，明帝爱女淑薨，追封谥淑为平原懿公主，为之立庙。取后亡从孙黄与合葬〖22〗，追封黄列侯。以夫人郭氏从弟德，为之后〖23〗，承甄氏姓；封德为平原侯，袭公主爵。﹝一﹞","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":124,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":85,"offset_unit":"unicode_code_point"},{"id":"luxun-e-o032a-q","section":"chapter-058","block":"b-2b16c4202f47d28a86f1","layer":"original","quote":"时建昌侯虑于堂前作斗鸭栏〖4〗，颇施小巧。逊正色曰：“君侯宜勤览经典以自新益〖5〗，用此何为？”虑即时毁撤之。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":150,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":55,"offset_unit":"unicode_code_point"},{"id":"luxun-q-b-bec244eebd3282fab965","section":"chapter-058","block":"b-bec244eebd3282fab965","layer":"modern","quote":"〖4〗虑：即孙虑（公元 213—232）。传见本书卷五十九。斗鸭：当时盛行的一种娱乐，用鸭相斗以决胜负。这种斗鸭产于江南，魏文帝曹丕曾遣使到孙吴求斗鸭，见本书卷四十七《吴主传》裴注引《江表传》。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":162,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-168a87f9a55ec2777c15","start":0,"end":97,"offset_unit":"unicode_code_point"},{"id":"luxun-q-o032","section":"chapter-058","block":"b-2b16c4202f47d28a86f1","layer":"original","quote":"时建昌侯虑于堂前作斗鸭栏〖4〗，颇施小巧。逊正色曰：“君侯宜勤览经典以自新益〖5〗，用此何为？”虑即时毁撤之。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":150,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":55,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-b-412fc25655f53a4b4d33","section":"chapter-003","block":"b-412fc25655f53a4b4d33","layer":"modern","quote":"〖1〗六年：太和六年（公元 232）。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":191,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-d1427f90b1f8dd585e5a","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-o026","section":"chapter-003","block":"b-42d0ed5edde34d9ea9f5","layer":"original","quote":"六年春二月〖1〗，诏曰：“古之帝王，封建诸侯，所以藩屏王室也〖2〗。《诗》不云乎，‘怀德维宁，宗子维城’〖3〗。秦、汉继周，或强或弱〖4〗，俱失厥中〖5〗。大魏创业，诸王开国；随时之宜，未有定制：非所以永为后法也。其改封诸侯王，皆以郡为国〖6〗。”三月，癸酉〖7〗，行东巡；所过存问高年鳏寡孤独〖8〗，赐谷帛。乙亥〖9〗，月犯轩辕大星。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":186,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":168,"offset_unit":"unicode_code_point"},{"id":"panlu-q-d6ee1fcab093f3936359","section":"chapter-061","block":"b-48e6e804f4bc5d8ffe98","layer":"original","quote":"濬女，配建昌侯孙虑","section_title":"潘濬陆凯传第十六","source":{"file":"OEBPS/Text/titlepage_0129.xhtml","index":29,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":12,"end":21,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-2e4ed9efeb08272a34a9","section":"chapter-059","block":"b-b8819de8bc7a8de64e04","layer":"original","quote":"年二十，嘉禾元年卒。无子，国除。","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":113,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":16,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-3c7b5828472a89e5db80","section":"chapter-059","block":"b-d99ee165eeacf1891b28","layer":"original","quote":"久之，尚书仆射存上疏曰〖2〗：“帝王之兴，莫不褒崇至亲，以光群后〖3〗。故鲁、卫于周〖4〗，宠冠诸侯；高帝五王〖5〗，封列于汉：所以藩屏本朝，为国镇卫。建昌侯虑，禀性聪敏，才兼文武；于古典制，宜正名号。陛下谦光〖6〗，未肯如旧；群僚大小，咸用於邑〖7〗。方今奸寇恣睢〖8〗，金鼓未弭〖9〗；腹心爪牙，惟亲与贤。辄与丞相雍等议，咸以虑‘宜为镇军大将军，授任偏方〖10〗，以光大业’。”","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":110,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":191,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-a1fa5647d96ead32057c","section":"chapter-059","block":"b-b6530861463177b98c91","layer":"original","quote":"孙虑字子智，登弟也。少敏惠有才艺，权器爱之。","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":108,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":22,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-b4d34ce41b7af9a6d05d","section":"chapter-059","block":"b-9af3f67cdec4b0998dcb","layer":"original","quote":"后二年，丞相雍等奏虑“性聪体达，所尚日新〖1〗；比方近汉，宜进爵称王”。权未许。","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":109,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":10,"end":50,"offset_unit":"unicode_code_point"},{"id":"santizhu059-q-bec6affbe03caf318893","section":"chapter-059","block":"b-9af3f67cdec4b0998dcb","layer":"original","quote":"黄武七年，封建昌侯。","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":109,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":10,"offset_unit":"unicode_code_point"},{"id":"wuzhu-e-o080a-q","section":"chapter-047","block":"b-125198d654f90db2adc1","layer":"original","quote":"七年春三月〖33〗，封子虑为建昌侯〖34〗。罢东安郡。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":395,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":27,"offset_unit":"unicode_code_point"},{"id":"wuzhu-e-o100a-q","section":"chapter-047","block":"b-2e3c046df01ea81f7bf6","layer":"original","quote":"嘉禾元年春正月，建昌侯虑卒。三月，遣将军周贺、校尉裴潜，乘海之辽东。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":10,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":34,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o080","section":"chapter-047","block":"b-125198d654f90db2adc1","layer":"original","quote":"七年春三月〖33〗，封子虑为建昌侯〖34〗。罢东安郡。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":395,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":27,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o100","section":"chapter-047","block":"b-2e3c046df01ea81f7bf6","layer":"original","quote":"嘉禾元年春正月，建昌侯虑卒。三月，遣将军周贺、校尉裴潜，乘海之辽东。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":10,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":34,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-58351377765dd2f7b0c5","section":"chapter-053","block":"b-86d605a7d0403049bf76","layer":"original","quote":"黄龙三年，建昌侯虑为镇军大将军〖1〗，屯半州","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":230,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":22,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-cf0d0728b93afb00231c","section":"chapter-053","block":"b-86d605a7d0403049bf76","layer":"original","quote":"黄龙三年，建昌侯虑为镇军大将军〖1〗，屯半州。以综为长史，外掌众事，内授书籍。","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":230,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":39,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-fe6fa7dc5ba1d3ed2948","section":"chapter-053","block":"b-fd80d0d5572a39836a08","layer":"original","quote":"虑卒","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":231,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":2,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-b-0d2dada465388f4c2e39","section":"chapter-035","block":"b-0d2dada465388f4c2e39","layer":"modern","quote":"〖1〗六年：建兴六年（公元 228）。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":220,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c990758acc37a646578b","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-o032","section":"chapter-035","block":"b-f4828bab0392be0b0bf7","layer":"original","quote":"六年春〖1〗，扬声由斜谷道取郿〖2〗，使赵云、邓芝为疑军〖3〗，据箕谷〖4〗；魏大将军曹真举众拒之。亮身率诸军攻祁山〖5〗，戎阵整齐，赏罚肃而号令明；南安、天水、安定三郡叛魏应亮，关中响震〖6〗。﹝二﹞","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":213,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":101,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
