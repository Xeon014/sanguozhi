{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xunyu-e-p004a","title":"典略记唐衡女嫁荀彧及荀绲慕势说","accounts":[{"id":"xunyu-e-p004a-account","label":"《典略》","text":"典略记唐衡女嫁荀彧及荀绲慕势说","evidence":["xunyu-e-p004a-q"]},{"id":"xunyu-a-p005-judgment","label":"裴松之按","text":"裴松之据唐衡去世时荀彧尚幼，认为婚时唐衡已死，慕势说不然。","evidence":["xunyu-q-p005-judgment"]},{"id":"xunyu-a-p006-judgment","label":"裴松之论","text":"裴松之又以宦官威权推论荀绲或受逼迫，反对以婚事伤其清操。","evidence":["xunyu-q-p006-judgment"]}],"participants":[{"person":"xunyu-p0017","role":"议婚","evidence":["xunyu-e-p004a-q"]},{"person":"zhouyu-p0012","role":"结婚","evidence":["xunyu-e-p004a-q"]},{"person":"wudi-p0100","role":"成婚","evidence":["xunyu-e-p004a-q"]}],"place":null,"time":{"label":"荀彧成婚时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xunyu-e-p004a-q"]},"ordering_evidence":"xunyu-e-p004a-q","source_order":[10,20,"P004a"],"order":2393},{"id":"zhouyu-e-p001b","title":"周景任豫州刺史辟陈蕃等名士","accounts":[{"id":"zhouyu-e-p001b-account","label":"谢承《后汉书》","text":"周景任豫州刺史辟陈蕃等名士","evidence":["zhouyu-e-p001b-q"]}],"participants":[{"person":"zhouyu-p0001","role":"辟士","evidence":["zhouyu-e-p001b-q"]},{"person":"wudi-p0036","role":"任别驾","evidence":["zhouyu-e-p001b-q"]},{"person":"zhouyu-p0011","role":"任从事","evidence":["zhouyu-e-p001b-q"]},{"person":"zhouyu-p0012","role":"任从事","evidence":["zhouyu-e-p001b-q"]},{"person":"zhouyu-p0013","role":"任从事","evidence":["zhouyu-e-p001b-q"]},{"person":"zhouyu-p0014","role":"任从事","evidence":["zhouyu-e-p001b-q"]}],"place":null,"time":{"label":"周景仕汉时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["zhouyu-e-p001b-q"]},"ordering_evidence":"zhouyu-e-p001b-q","source_order":[54,28,"P001b"],"order":9578}],"persons":[{"id":"zhouyu-p0012","name":"荀绲","evidence":["zhouyu-q-p001","xunyu-q-o001"],"facts":[],"aliases":[],"mentions":[{"id":"zhouyu-m-p001-zhouyu-p0012","kind":"mention","text":"文中提及","evidence":["zhouyu-q-p001"]},{"id":"xunyu-m-o001-zhouyu-p0012","kind":"mention","text":"文中提及","evidence":["xunyu-q-o001"]},{"id":"xunyu-m-p002-zhouyu-p0012","kind":"mention","text":"文中提及","evidence":["xunyu-q-p002"]},{"id":"xunyu-m-p004-zhouyu-p0012","kind":"mention","text":"文中提及","evidence":["xunyu-q-p004"]},{"id":"xunyu-m-p005-zhouyu-p0012","kind":"mention","text":"文中提及","evidence":["xunyu-q-p005"]},{"id":"xunyu-m-p006-zhouyu-p0012","kind":"mention","text":"文中提及","evidence":["xunyu-q-p006"]}]}],"evidence":[{"id":"xunyu-e-p004a-q","section":"chapter-010","block":"b-52c69f6bca4740f3744f","layer":"pei","quote":"﹝二﹞《典略》曰：“中常侍唐衡，欲以女妻汝南傅公明；公明不娶，转以与彧。父绲慕衡势，为彧娶之。彧为论者所讥。”","attribution":"《典略》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":19,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a2a81df5b8cc852cc823","start":0,"end":55,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-o001","section":"chapter-010","block":"b-5430515d00c8a91a0cac","layer":"original","quote":"荀彧字文若，颍川颍阴人也〖1〗。祖父淑，字季和，朗陵令〖2〗；当汉顺、桓之间〖3〗，知名当世。有子八人，号曰“八龙”。彧父绲，济南相；叔父爽，司空。﹝一﹞","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":1,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":77,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-p002","section":"chapter-010","block":"b-9e7f1bade3933fa1462b","layer":"pei","quote":"张璠《汉纪》曰：“淑，博学有高行，与李固、李膺同志友善；拔李昭于小吏，友黄叔度于幼童。以贤良方正，征。对策讥切梁氏，出补朗陵侯相。卒官。八子：俭、绲、靖、焘、（诜）〔汪〕、爽、肃、旉。音敷。爽字慈明。幼好学，年十二，通《春秋》、《论语》。耽思经典，不应征命，积十数年。董卓秉政，复征爽；爽欲遁去，吏持之急。诏下郡，即拜平原相；行至苑陵，又追拜光禄勋；视事三日，策拜司空。爽起自布衣，九十五日而至三公。淑旧居西豪里，县令苑康曰‘昔高阳氏有才子八人’，署其里为‘高阳里’。靖字叔慈。亦有至德，名几亚爽，隐居终身。”","attribution":"张璠《汉纪》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":17,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c347ca05b53d613cd76d","start":0,"end":255,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-p004","section":"chapter-010","block":"b-52c69f6bca4740f3744f","layer":"pei","quote":"﹝二﹞《典略》曰：“中常侍唐衡，欲以女妻汝南傅公明；公明不娶，转以与彧。父绲慕衡势，为彧娶之。彧为论者所讥。”","attribution":"《典略》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":19,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a2a81df5b8cc852cc823","start":0,"end":55,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-p005","section":"chapter-010","block":"b-804a2fb917c5799b1678","layer":"pei","quote":"臣松之按：《汉纪》云“唐衡以桓帝延熹七年死”，计彧于时年始二岁；则彧婚之日，衡之没久矣。慕势之言为不然也。","attribution":"裴松之按","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":20,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a2a81df5b8cc852cc823","start":0,"end":53,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-p005-judgment","section":"chapter-010","block":"b-804a2fb917c5799b1678","layer":"pei","quote":"臣松之按：《汉纪》云“唐衡以桓帝延熹七年死”，计彧于时年始二岁；则彧婚之日，衡之没久矣。慕势之言为不然也。","attribution":"裴松之按","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":20,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a2a81df5b8cc852cc823","start":0,"end":53,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-p006","section":"chapter-010","block":"b-daab014fd82307701cd6","layer":"pei","quote":"臣松之又以为：绲，“八龙”之一，必非苟得者也；将有逼而然，何云慕势哉？昔郑忽以违齐致讥，隽生以拒霍见美；致讥在于失援，见美嘉其虑远；并无交至之害，故得各全其志耳。至于阉竖用事，四海屏气；左悺、唐衡，杀生在口。故于时谚云“左回天，唐独坐”，言威权莫二也。顺之则六亲以安，忤违则大祸立至；斯诚以存易亡，蒙耻期全之日。昔蒋诩姻于王氏，无损清高之操；绲之此婚，庸何伤乎？","attribution":"裴松之论","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":21,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a2a81df5b8cc852cc823","start":0,"end":181,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-p006-judgment","section":"chapter-010","block":"b-daab014fd82307701cd6","layer":"pei","quote":"臣松之又以为：绲，“八龙”之一，必非苟得者也；将有逼而然，何云慕势哉？昔郑忽以违齐致讥，隽生以拒霍见美；致讥在于失援，见美嘉其虑远；并无交至之害，故得各全其志耳。至于阉竖用事，四海屏气；左悺、唐衡，杀生在口。故于时谚云“左回天，唐独坐”，言威权莫二也。顺之则六亲以安，忤违则大祸立至；斯诚以存易亡，蒙耻期全之日。昔蒋诩姻于王氏，无损清高之操；绲之此婚，庸何伤乎？","attribution":"裴松之论","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":21,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a2a81df5b8cc852cc823","start":0,"end":181,"offset_unit":"unicode_code_point"},{"id":"zhouyu-e-p001b-q","section":"chapter-054","block":"b-c0e659dc356b6d97b476","layer":"pei","quote":"后为豫州刺史，辟汝南陈蕃为别驾，颍川李膺、荀绲、杜密、沛国朱寓为从事：皆天下英俊之士也。","attribution":"谢承《后汉书》","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":27,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-2c3e73d9e07dc5ae3b20","start":36,"end":80,"offset_unit":"unicode_code_point"},{"id":"zhouyu-q-p001","section":"chapter-054","block":"b-c0e659dc356b6d97b476","layer":"pei","quote":"﹝一﹞谢承《后汉书》曰：“景字仲嚮。少以廉能见称。以明学察孝廉，辟公府。后为豫州刺史，辟汝南陈蕃为别驾，颍川李膺、荀绲、杜密、沛国朱寓为从事：皆天下英俊之士也。稍迁至尚书令，遂登太尉。”","attribution":"谢承《后汉书》","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":27,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-2c3e73d9e07dc5ae3b20","start":0,"end":93,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
