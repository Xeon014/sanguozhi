{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wuwen-e-54893970806249722bdb","title":"曹铄早薨","accounts":[{"id":"wuwen-a-54893970806249722bdb","label":"正文","text":"曹铄早薨","evidence":["wuwen-q-2211e2459c3dbc758313"]}],"participants":[{"person":"wuwen-p-e0a6aedd77eb84","role":"去世者","evidence":["wuwen-q-2211e2459c3dbc758313"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["wuwen-q-2211e2459c3dbc758313"]},"ordering_evidence":"wuwen-q-2211e2459c3dbc758313","order":3843},{"id":"wuwen-e-b0fd7c70acb8515fcb37","title":"曹铄追封谥相殇王","accounts":[{"id":"wuwen-a-b0fd7c70acb8515fcb37","label":"正文","text":"曹铄追封谥相殇王","evidence":["wuwen-q-f277aecfd13a12edec78"]}],"participants":[{"person":"wuwen-p-e0a6aedd77eb84","role":"被追封谥者","evidence":["wuwen-q-f277aecfd13a12edec78"]}],"place":null,"time":{"label":"太和三年","precision":"undated","basis":"保留本条明文纪年；未审定对应公元年。","evidence":["wuwen-q-f277aecfd13a12edec78"]},"ordering_evidence":"wuwen-q-f277aecfd13a12edec78","order":3844}],"persons":[{"id":"wuwen-p-e0a6aedd77eb84","name":"曹铄","evidence":["wuwen-q-2211e2459c3dbc758313","wuwen-q-f277aecfd13a12edec78","wuwen-q-c2f55f326342aebf012b"],"facts":[{"id":"wuwen-f-84fb7b208f64fe9787f8","text":"父为曹操；本传记母为刘夫人。","evidence":["wuwen-q-c2f55f326342aebf012b"]}],"mentions":[],"aliases":[]}],"evidence":[{"id":"wuwen-q-2211e2459c3dbc758313","section":"chapter-020","block":"b-12f7e0051ccc538e1849","layer":"original","quote":"相殇王铄，早薨。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":4,"anchor":null},"note_id":null,"start":0,"end":8},{"id":"wuwen-q-c2f55f326342aebf012b","section":"chapter-020","block":"b-87027621c423a4f13bd6","layer":"original","quote":"武皇帝二十五男：卞皇后生文皇帝、任城威王彰、陈思王植、萧怀王熊；刘夫人生丰愍王昂、相殇王铄；环夫人生邓哀王冲、彭城王据、燕王宇；杜夫人生沛穆王林、中山恭王衮；秦夫人生济阳怀王玹、陈留恭王峻；尹夫人生范阳闵王矩；王昭仪生赵王幹；孙姬生临邑殇公子上、楚王彪、刚殇公子勤；李姬生谷城殇公子乘、郿戴公子整、灵殇公子京；周姬生樊安公均；刘姬生广宗殇公子棘；宋姬生东平灵王徽；赵姬生乐陵王茂。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":1,"anchor":null},"note_id":null,"start":0,"end":190},{"id":"wuwen-q-f277aecfd13a12edec78","section":"chapter-020","block":"b-12f7e0051ccc538e1849","layer":"original","quote":"太和三年，追封谥。","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":4,"anchor":null},"note_id":null,"start":8,"end":17}],"profiles":{},"directory_counts":{}}
