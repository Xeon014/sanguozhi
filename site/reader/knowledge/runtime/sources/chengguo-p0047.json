{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"chengguo-e-p159","title":"孙资荐阎志说轲比能释田豫","accounts":[{"id":"chengguo-a-d7042bac0d4adad90eff","label":"裴注·《魏氏春秋》","text":"孙资荐阎志说轲比能释田豫","evidence":["chengguo-q-81b07f1679e45005df6f"]},{"id":"wuhuan-a-f7f8e682b2e605040ec1","label":"正文","text":"阎志往解喻，比能即解围去","evidence":["wuhuan-q-976d3b013cf9c13148b3"]}],"participants":[{"person":"mingdi-p0075","role":"荐阎志","evidence":["chengguo-q-81b07f1679e45005df6f"]},{"person":"wendi-p0005","role":"问监令","evidence":["chengguo-q-81b07f1679e45005df6f"]},{"person":"chengguo-p0047","role":"奉诏说比能","evidence":["chengguo-q-81b07f1679e45005df6f"]},{"person":"wendi-p0032","role":"释豫","evidence":["chengguo-q-81b07f1679e45005df6f"]},{"person":"mingdi-p0025","role":"被释","evidence":["chengguo-q-81b07f1679e45005df6f"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["chengguo-q-81b07f1679e45005df6f"]},"ordering_evidence":"chengguo-q-81b07f1679e45005df6f","source_order":[14,510,61],"order":3200}],"persons":[{"id":"chengguo-p0047","name":"阎志","evidence":["chengguo-q-81b07f1679e45005df6f","wuhuan-q-976d3b013cf9c13148b3","wuhuan-q-ea2cb7aabd8acb508135"],"facts":[{"id":"wuhuan-f-3268364fc56c73e448f5","text":"上谷太守，阎柔弟。","evidence":["wuhuan-q-ea2cb7aabd8acb508135"]}],"aliases":[],"mentions":[]}],"evidence":[{"id":"chengguo-q-81b07f1679e45005df6f","section":"chapter-014","block":"b-c94e798e279014ab8847","layer":"pei","quote":"帝闻之，计未有所出，如中书省以问监、令。令孙资对曰：‘上谷太守阎志，柔弟也。为比能素所归信，令驰诏使说比能，可不劳师而自解矣。’帝从之，比能果释豫而还","attribution":"裴注·《魏氏春秋》","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":509,"anchor":null},"note_id":"n-bc1b1b250e29312e200a","start":61,"end":136},{"id":"wuhuan-q-976d3b013cf9c13148b3","section":"chapter-030","block":"b-c129e6d9e032aa46097d","layer":"original","quote":"志往解喻，即解围去","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":72,"anchor":null},"note_id":null,"start":94,"end":103},{"id":"wuhuan-q-ea2cb7aabd8acb508135","section":"chapter-030","block":"b-c129e6d9e032aa46097d","layer":"original","quote":"太和二年，豫遣译夏舍诣比能女婿郁筑鞬部〖25〗；舍为鞬所杀。其秋，豫将西部鲜卑蒲头、泄归泥，出塞讨郁筑鞬，大破之。还至马城，比能自将三万骑，围豫七日。上谷太守阎志，柔之弟也，素为鲜卑所信；志往解喻，即解围去。后幽州刺史王雄并领校尉〖26〗，抚以恩信。比能数款塞，诣州奉贡献。","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":72,"anchor":null},"note_id":null,"start":0,"end":137}],"profiles":{},"directory_counts":{}}
