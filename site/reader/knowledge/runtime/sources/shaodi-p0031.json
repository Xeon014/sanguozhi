odi-p0004","role":"交战","evidence":["wuzhu-e-o133b-q"]},{"person":"wuzhu-p0106","role":"战死","evidence":["wuzhu-e-o133b-q"]},{"person":"mingdi-p0046","role":"围城","evidence":["wuzhu-e-o133b-q"]},{"person":"mingdi-p0002","role":"出军","evidence":["wuzhu-e-o133b-q"]},{"person":"wgc-p0072","role":"与顾承奋击驻魏师，获将军","evidence":["zhanggu-q-2113b80d6f9f8a3da0c7"]},{"person":"luxun-p0044","role":"与张休奋击驻魏师，获将军","evidence":["zhanggu-q-2113b80d6f9f8a3da0c7"]},{"person":"hequan-p0007","role":"敌驻后进击","evidence":["zhanggu-q-2113b80d6f9f8a3da0c7"]},{"person":"shaodi-p0042","role":"敌驻后进击","evidence":["zhanggu-q-2113b80d6f9f8a3da0c7"]},{"person":"shaodi-p0031","role":"率兵抵御","evidence":["hancui-q-2554659cfd2fbba6bd23"]}],"place":null,"time":{"year":241,"label":"夏四月至闰月","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"wuzhu-y241","dating_review":{"reviewed":true,"anchor":"wuzhu-q-o132","basis":"夏四月至闰月"},"evidence":["wuzhu-e-o133b-q","wuzhu-q-o132","shaodi-q-o012","shaodi-q-b-f56b355cff79244bd89c"]},"ordering_evidence":"wuzhu-e-o133b-q","source_order":[47,680,"O133b"],"related_events":[{"event":"shaodi-e-o013a","type":"related","evidence":["wuzhu-e-o133b-q","shaodi-e-o013a-q"]}],"order":8352}],"persons":[{"id":"shaodi-p0031","name":"孙礼","evidence":["shaodi-q-o045","cuimao-q-dbf237b2707e6cbde9d3","hancui-q-64de1ce01f6cebc9e4fa","hancui-q-0e0f1345d930bfe9432c","hancui-q-50d7fea420bb5f7538f1","hancui-q-b8a72020a73da66fb64f","hancui-q-1b567f363d1f0edf8324","hancui-q-cb0cfca49d89642946ef","hancui-q-48bc9ea86489e9c80e14","hancui-q-1a2b429226964923222e","hancui-q-d8e693afb94d612ed314","hancui-q-cbe88f955d840016bfd9","hancui-q-b6b4fc2e84975406dd44","hancui-q-e0d41a4a093f1a9b82e4","hancui-q-165be2d8b6bd02c1334b","hancui-q-c2ef72acc85b19363f32","hancui-q-05a31b3c714c610adf1b","hancui-q-2554659cfd2fbba6bd23","hancui-q-e0cac8f195d4c58f17b6","hancui-q-cbe99e611e2ea1f5040a","hancui-q-d2ed8e6f3536cbe422a5","hancui-q-bf3c78abf76b83e59fa7","hancui-q-8a8b6d4b403f853064ce","hancui-q-8d9aefdb6a1f5f3453c2","hancui-q-6ae18d77d24e88be769b","hancui-q-c56b1227ff5ef96968a3","hancui-q-f55d4d28649f0d4712aa","hancui-q-91f2e8fac83452c327d0"],"facts":[{"id":"hancui-f-f135bc24ac394ebf373c","text":"字德达，涿郡容城人。","evidence":["hancui-q-91f2e8fac83452c327d0"]}],"aliases":[],"mentions":[{"id":"shaodi-m-o045-shaodi-p0031","kind":"mention","text":"文中提及","evidence":["shaodi-q-o045"]},{"id":"shaodi-m-o047-shaodi-p0031","kind":"mention","text":"文中提及","evidence":["shaodi-q-o047"]}]}],"evidence":[{"id":"cuimao-q-dbf237b2707e6cbde9d3","section":"chapter-012","block":"b-510c6e1e3f077d574c36","layer":"original","quote":"涿郡孙礼、卢毓始入军府〖14〗，琰又名之曰：“孙，疏亮亢烈，刚简能断；卢，清警明理，百炼不消〖15〗：皆公才也","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":69,"anchor":null},"note_id":null,"start":117,"end":172},{"id":"hancui-q-05a31b3c714c610adf1b","section":"chapter-024","block":"b-f3afcdb8c325c1801064","layer":"original","quote":"礼亮直不挠〖18〗，爽弗便也；以为扬州刺史〖19〗，加伏波将军〖20〗，赐爵关内侯。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":338,"anchor":null},"note_id":null,"start":0,"end":42},{"id":"hancui-q-0e0f1345d930bfe9432c","section":"chapter-024","block":"b-7f1fa17a731e54ce8d9b","layer":"original","quote":"太傅司马宣王谓礼曰：“今清河、平原争界八年，更二刺史〖26〗，靡能决之；虞、芮待文王而了〖27〗，宜善令分明。”","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":339,"anchor":null},"note_id":null,"start":17,"end":73},{"id":"hancui-q-165be2d8b6bd02c1334b","section":"chapter-024","block":"b-ef2b7e8a02562eca060b","layer":"original","quote":"入为尚书。明帝方修宫室；而节气不和，天下少谷。礼固争罢役〖13〗，诏曰：“敬纳谠言〖14〗，促遣民作〖15〗。”时李惠监作，复奏留一月，有所成讫。礼径至作所，不复重奏，称诏罢民。帝奇其意而不责也。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":336,"anchor":null},"note_id":null,"start":0,"end":98},{"id":"hancui-q-1a2b429226964923222e","section":"chapter-024","block":"b-54fa554e45f355510129","layer":"original","quote":"台后坐法当死，礼私导令逾狱〖3〗，自首〖4〗。既而曰：“臣无逃亡之义。”径诣刺奸〖5〗。主簿温恢嘉之，具白太祖，各减死一等〖6〗。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":334,"anchor":null},"note_id":null,"start":62,"end":127},{"id":"hancui-q-1b567f363d1f0edf8324","section":"chapter-024","block":"b-3b720418adc4bfb92b71","layer":"original","quote":"爽见礼奏，大怒。劾礼怨望，结刑五岁〖58〗。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":342,"anchor":null},"note_id":null,"start":0,"end":22},{"id":"hancui-q-2554659cfd2fbba6bd23","section":"chapter-024","block":"b-f3afcdb8c325c1801064","layer":"original","quote":"吴大将全琮帅数万众来侵寇〖21〗；时州兵休使〖22〗，在者无几。礼躬勒卫兵御之，战于芍陂〖23〗；自旦及暮，将士死伤过半。礼犯蹈白刃，马被数创，手秉枹鼓〖24〗，奋不顾身；贼众乃退。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":338,"anchor":null},"note_id":null,"start":42,"end":133},{"id":"hancui-q-48bc9ea86489e9c80e14","section":"chapter-024","block":"b-54fa554e45f355510129","layer":"original","quote":"初丧乱时，礼与母相失；同郡马台求得礼母，礼推家财尽以与台。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":334,"anchor":null},"note_id":null,"start":33,"end":62},{"id":"hancui-q-50d7fea420bb5f7538f1","section":"chapter-024","block":"b-7d084a7792e15436737d","layer":"original","quote":"礼曰：“讼者据墟墓为验〖28〗，听者以先老为正〖29〗；而老者不可加以槚楚〖30〗，又墟墓或迁就高敞，或徙避仇雠。如今所闻，虽皋陶犹将为难。若欲使‘必也无讼’〖31〗，当以烈祖初封平原时图决之〖32〗。何必推古问故〖33〗，以益辞讼？昔成王以桐叶戏叔虞〖34〗，周公便以封之。今图藏在天府〖35〗，便可于坐上断也，岂待到州乎？”宣王曰：“是也。当别下图。”","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":340,"anchor":null},"note_id":null,"start":0,"end":178},{"id":"hancui-q-64de1ce01f6cebc9e4fa","section":"chapter-024","block":"b-e01ea57a0e335f7ab9ba","layer":"original","quote":"明帝临崩之时，以曹爽为大将军宜得良佐，于床下受遗诏，拜礼大将军长史，加散骑常侍。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":337,"anchor":null},"note_id":null,"start":0,"end":40},{"id":"hancui-q-6ae18d77d24e88be769b","section":"chapter-024","block":"b-7f1fa17a731e54ce8d9b","layer":"original","quote":"征拜少府。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":339,"anchor":null},"note_id":null,"start":0,"end":5},{"id":"hancui-q-8a8b6d4b403f853064ce","section":"chapter-024","block":"b-80064053a8c534e4a01a","layer":"original","quote":"迁司空，封大利亭侯，邑一百户。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":344,"anchor":null},"note_id":null,"start":23,"end":38},{"id":"hancui-q-8d9aefdb6a1f5f3453c2","section":"chapter-024","block":"b-9bc6682de197b375795f","layer":"original","quote":"嘉平二年，薨，谥曰景侯。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":346,"anchor":null},"note_id":null,"start":0,"end":12},{"id":"hancui-q-91f2e8fac83452c327d0","section":"chapter-024","block":"b-54fa554e45f355510129","layer":"original","quote":"孙礼字德达，涿郡容城人也〖1〗。太祖平幽州，召为司空军谋掾〖2〗。初丧乱时，礼与母相失；同郡马台求得礼母，礼推家财尽以与台。台后坐法当死，礼私导令逾狱〖3〗，自首〖4〗。既而曰：“臣无逃亡之义。”径诣刺奸〖5〗。主簿温恢嘉之，具白太祖，各减死一等〖6〗。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":334,"anchor":null},"note_id":null,"start":0,"end":127},{"id":"hancui-q-b6b4fc2e84975406dd44","section":"chapter-024","block":"b-7f1c0281a7dcbf5a91c7","layer":"original","quote":"历山阳、平原、平昌、琅邪太守〖10〗。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":335,"anchor":null},"note_id":null,"start":78,"end":97},{"id":"hancui-q-b8a72020a73da66fb64f","section":"chapter-024","block":"b-a22befd9e565b65497ad","layer":"original","quote":"礼到，案图宜属平原。而曹爽信清河言，下书云：“图不可用，当参异同〖36〗。”礼上疏曰：“管仲霸者之佐〖37〗，其器又小〖38〗，犹能夺伯氏骈邑〖39〗，使没齿无怨言〖40〗。臣受牧伯之任，奉圣朝明图，验地著之界〖41〗，界实以王翁河为限〖42〗。而鄃以马丹候为验〖43〗，诈以鸣犊河为界〖44〗；假虚讼诉，疑误台阁。窃闻众口铄金〖45〗，浮石沉木〖46〗，三人成市虎〖47〗，慈母投其杼〖48〗。今二郡争界八年，一朝决之者〖49〗，缘有解书图画〖50〗，可得寻案擿校也〖51〗。平原在两河向东上〖52〗，其间有爵堤〖53〗；爵堤在高唐西南〖54〗，所争地在高唐西北，相去二十余里。可谓长叹息流涕者也。案解与图奏，而鄃不受诏，此臣软弱不胜其任；臣亦何颜尸禄素餐〖55〗？辄束带著履〖56〗，驾车待放〖57〗。”","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":341,"anchor":null},"note_id":null,"start":0,"end":354},{"id":"hancui-q-bf3c78abf76b83e59fa7","section":"chapter-024","block":"b-80064053a8c534e4a01a","layer":"original","quote":"爽诛后，入为司隶校尉。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":344,"anchor":null},"note_id":null,"start":0,"end":11},{"id":"hancui-q-c2ef72acc85b19363f32","section":"chapter-024","block":"b-ef2b7e8a02562eca060b","layer":"original","quote":"帝猎于大石山〖16〗，虎趋乘舆〖17〗。礼便投鞭下马，欲奋剑斫虎，诏令礼上马。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":336,"anchor":null},"note_id":null,"start":98,"end":137},{"id":"hancui-q-c56b1227ff5ef96968a3","section":"chapter-024","block":"b-7f1fa17a731e54ce8d9b","layer":"original","quote":"出为荆州刺史。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":339,"anchor":null},"note_id":null,"start":5,"end":12},{"id":"hancui-q-cb0cfca49d89642946ef","section":"chapter-024","block":"b-54fa554e45f355510129","layer":"original","quote":"太祖平幽州，召为司空军谋掾〖2〗。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":334,"anchor":null},"note_id":null,"start":16,"end":33},{"id":"hancui-q-cbe88f955d840016bfd9","section":"chapter-024","block":"b-7f1c0281a7dcbf5a91c7","layer":"original","quote":"鲁山中贼数百人，保固险阻，为民作害。乃徙礼为鲁相；礼至官，出俸谷，发吏民，募首级〖8〗，招纳降附使还为间〖9〗，应时平泰。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":335,"anchor":null},"note_id":null,"start":17,"end":78},{"id":"hancui-q-cbe99e611e2ea1f5040a","section":"chapter-024","block":"b-e1b7db8ec9f3a26d6bbe","layer":"original","quote":"在家期年〖59〗，众人多以为言，除城门校尉。时匈奴王刘靖部众强盛〖60〗，而鲜卑数寇边〖61〗。乃以礼为并州刺史，加振武将军〖62〗，使持节，护匈奴中郎将。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":343,"anchor":null},"note_id":null,"start":0,"end":78},{"id":"hancui-q-d2ed8e6f3536cbe422a5","section":"chapter-024","block":"b-e1b7db8ec9f3a26d6bbe","layer":"original","quote":"往见太傅司马宣王，有忿色而无言。宣王曰：“卿得并州，少邪？恚理分界失分乎〖63〗？今当远别，何不欢也？”礼曰：“何明公言之乖细也〖64〗！礼虽不德，岂以官位、往事为意邪？本谓明公齐踪伊、吕，匡辅魏室；上报明帝之托，下建万世之勋。今社稷将危，天下汹汹〖65〗，此礼之所以不悦也。”因涕泣横流。宣王曰：“且止，忍不可忍〖66〗。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":343,"anchor":null},"note_id":null,"start":78,"end":240},{"id":"hancui-q-d8e693afb94d612ed314","section":"chapter-024","block":"b-7f1c0281a7dcbf5a91c7","layer":"original","quote":"后除河间郡丞〖7〗。稍迁荥阳都尉。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":335,"anchor":null},"note_id":null,"start":0,"end":17},{"id":"hancui-q-e0cac8f195d4c58f17b6","section":"chapter-024","block":"b-f3afcdb8c325c1801064","layer":"original","quote":"诏书慰劳，赐绢七百匹。礼为死事者设祀哭临，哀号发心〖25〗；皆以绢付亡者家，无以入身。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":338,"anchor":null},"note_id":null,"start":133,"end":176},{"id":"hancui-q-e0d41a4a093f1a9b82e4","section":"chapter-024","block":"b-7f1c0281a7dcbf5a91c7","layer":"original","quote":"从大司马曹休征吴于夹石〖11〗，礼谏以为“不可深入”，不从而败。迁阳平太守〖12〗。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":335,"anchor":null},"note_id":null,"start":97,"end":139},{"id":"hancui-q-f55d4d28649f0d4712aa","section":"chapter-024","block":"b-7f1fa17a731e54ce8d9b","layer":"original","quote":"迁冀州牧。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":339,"anchor":null},"note_id":null,"start":12,"end":17},{"id":"shaodi-e-o013a-q","section":"chapter-004","block":"b-0cd1e6082bde64409582","layer":"original","quote":"夏五月，吴将朱然等围襄阳之樊城，太傅司马宣王率众拒之。﹝一﹞六月，辛丑〖5〗，退。己卯〖6〗，以征东将军王凌为车骑将军〖7〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":59,"anchor":null},"note_id":null,"start":0,"end":63},{"id":"shaodi-e-o045b-q","section":"chapter-004","block":"b-34c3571f78f38e0864ec","layer":"original","quote":"冬十二月，辛卯〖10〗，以司空王凌为太尉。庚子〖11〗，以司隶校尉孙礼为司空〖12〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":182,"anchor":null},"note_id":null,"start":0,"end":43},{"id":"shaodi-e-o047b-q","section":"chapter-004","block":"b-3b3163edc9e235a7bd49","layer":"original","quote":"冬十月，以特进孙资为骠骑将军。十一月，司空孙礼薨。十二月，甲辰〖15〗，东海王霖薨。乙未〖16〗，征南将军王昶渡江〖17〗，掩攻吴，破之。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":184,"anchor":null},"note_id":null,"start":0,"end":69},{"id":"shaodi-q-b-33155276d789f594176b","section":"chapter-004","block":"b-33155276d789f594176b","layer":"modern","quote":"〖13〗二年：嘉平二年（公元 250）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":198,"anchor":null},"note_id":"n-235bc158a4eae2a0609a","start":0,"end":20},{"id":"shaodi-q-b-f56b355cff79244bd89c","section":"chapter-004","block":"b-f56b355cff79244bd89c","layer":"modern","quote":"〖1〗二年：正始二年（公元 241）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":62,"anchor":null},"note_id":"n-bf9ccbeb544f540e6afb","start":0,"end":19},{"id":"shaodi-q-o012","section":"chapter-004","block":"b-33e60ac0c003858f0640","layer":"original","quote":"二年春二月〖1〗，帝初通《论语》〖2〗。使太常以太牢祭孔子于辟雍〖3〗，以颜渊配〖4〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":58,"anchor":null},"note_id":null,"start":0,"end":44},{"id":"shaodi-q-o043","section":"chapter-004","block":"b-b1c990928436e9ed43da","layer":"original","quote":"嘉平元年春正月，甲午〖1〗，车驾谒高平陵。﹝一﹞太傅司马宣王奏免大将军曹爽、爽弟中领军羲、武卫将军训、散骑常侍彦官〖2〗，以侯就第。戊戌〖3〗，有司奏收黄门张当付廷尉〖4〗；考实其辞，爽与谋不轨。又尚书丁谧、邓飏、何晏，司隶校尉毕轨，荆州刺史李胜，大司农桓范，皆与爽通奸谋〖5〗，夷三族。语在《爽传》。丙午〖6〗，大赦。丁未〖7〗，以太傅司马宣王为丞相；固让，乃止。﹝二﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":180,"anchor":null},"note_id":null,"start":0,"end":186},{"id":"shaodi-q-o045","section":"chapter-004","block":"b-34c3571f78f38e0864ec","layer":"original","quote":"冬十二月，辛卯〖10〗，以司空王凌为太尉。庚子〖11〗，以司隶校尉孙礼为司空〖12〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":182,"anchor":null},"note_id":null,"start":0,"end":43},{"id":"shaodi-q-o046","section":"chapter-004","block":"b-8bc97b77985c9cc83eeb","layer":"original","quote":"二年夏五月〖13〗，以征西将军郭淮为车骑将军〖14〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":183,"anchor":null},"note_id":null,"start":0,"end":27},{"id":"shaodi-q-o047","section":"chapter-004","block":"b-3b3163edc9e235a7bd49","layer":"original","quote":"冬十月，以特进孙资为骠骑将军。十一月，司空孙礼薨。十二月，甲辰〖15〗，东海王霖薨。乙未〖16〗，征南将军王昶渡江〖17〗，掩攻吴，破之。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":184,"anchor":null},"note_id":null,"start":0,"end":69},{"id":"wgc-q0005","section":"chapter-028","block":"b-280a1e8d1f852b5e78af","layer":"original","quote":"二年〖1〗，吴大将全琮数万众寇芍陂〖2〗。凌率诸军逆讨，与贼争塘，力战连日，贼退走。进封南乡侯，邑千三百五十户；迁车骑将军，仪同三司。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":21,"anchor":null},"note_id":null,"start":0,"end":67},{"id":"wgc-q0159","section":"chapter-028","block":"b-280a1e8d1f852b5e78af","layer":"original","quote":"吴大将全琮数万众寇芍陂〖2〗。凌率诸军逆讨，与贼争塘，力战连日，贼退走","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":21,"anchor":null},"note_id":null,"start":6,"end":41},{"id":"wuzhu-e-o133b-q","section":"chapter-047","block":"b-8af6f7908a818f7cd9b1","layer":"original","quote":"琮与魏将王凌，战于芍陂；中郎将秦晃等十余人，战死。车骑将军朱然围樊，大将军诸葛瑾取柤中〖15〗。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":168,"anchor":null},"note_id":null,"start":56,"end":104},{"id":"wuzhu-q-o132","section":"chapter-047","block":"b-339340f557e9065aedfa","layer":"original","quote":"四年春正月〖10〗，大雪，平地深三尺，鸟兽死者太半。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":167,"anchor":null},"note_id":null,"start":0,"end":26},{"id":"zhanggu-q-2113b80d6f9f8a3da0c7","section":"chapter-052","block":"b-027aa53bd5dbba95ebf6","layer":"original","quote":"时长公主婿卫将军全琮子寄，为霸宾客〖19〗；寄素倾邪〖20〗，谭所不纳。先是，谭弟承与张休俱北征寿春，全琮时为大都督；与魏将王凌战于芍陂，军不利，魏兵乘胜陷没五营将秦（儿）〔晃〕军；休、承奋击之，遂驻魏师〖21〗。时琮群子绪、端，亦并为将，因敌既驻，乃进击之：凌军用退","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":197,"anchor":null},"note_id":null,"start":0,"end":134}],"profiles":{},"directory_counts":{}}
