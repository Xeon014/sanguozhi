{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"houfei-e-o037c","title":"郭后止孟武纳妾并敕诸家","accounts":[{"id":"houfei-e-o037c-account","label":"《后妃传》正文","text":"郭后止孟武纳妾并敕诸家","evidence":["houfei-e-o037c-q"]}],"participants":[{"person":"wendi-p0021","role":"止妾","evidence":["houfei-e-o037c-q"]},{"person":"houfei-p0063","role":"欲纳妾","evidence":["houfei-e-o037c-q"]}],"place":null,"time":{"label":"郭后时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["houfei-e-o037c-q"]},"ordering_evidence":"houfei-e-o037c-q","source_order":[5,183,"O037c"],"order":1433},{"id":"houfei-e-p020a","title":"郭后戒郭表孟武谨慎勿骄奢","accounts":[{"id":"houfei-e-p020a-account","label":"《魏书》","text":"郭后戒郭表孟武谨慎勿骄奢","evidence":["houfei-e-p020a-q"]}],"participants":[{"person":"wendi-p0021","role":"戒亲","evidence":["houfei-e-p020a-q"]},{"person":"houfei-p0061","role":"受戒","evidence":["houfei-e-p020a-q"]},{"person":"houfei-p0063","role":"受戒","evidence":["houfei-e-p020a-q"]}],"place":null,"time":{"label":"郭后时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["houfei-e-p020a-q"]},"ordering_evidence":"houfei-e-p020a-q","source_order":[5,200,"P020a"],"order":1436},{"id":"houfei-e-o041c","title":"郭后止孟武厚葬母立祠堂","accounts":[{"id":"houfei-e-o041c-account","label":"《后妃传》正文","text":"郭后止孟武厚葬母立祠堂","evidence":["houfei-e-o041c-q"]}],"participants":[{"person":"wendi-p0021","role":"止厚葬","evidence":["houfei-e-o041c-q"]},{"person":"houfei-p0063","role":"欲厚葬","evidence":["houfei-e-o041c-q"]}],"place":null,"time":{"year":230,"label":"太和四年","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"houfei-y230","dating_review":{"reviewed":true,"anchor":"houfei-q-o012","basis":"太和四年"},"evidence":["houfei-e-o041c-q","houfei-q-o012","houfei-q-b-cbf406b91aa2796bad01"]},"ordering_evidence":"houfei-e-o041c-q","source_order":[5,202,"O041c"],"order":1440}],"persons":[{"id":"houfei-p0063","name":"孟武","evidence":["houfei-q-o037"],"facts":[],"aliases":[],"mentions":[{"id":"houfei-m-o037-houfei-p0063","kind":"mention","text":"文中提及","evidence":["houfei-q-o037"]},{"id":"houfei-m-p020-houfei-p0063","kind":"mention","text":"文中提及","evidence":["houfei-q-p020"]},{"id":"houfei-m-o041-houfei-p0063","kind":"mention","text":"文中提及","evidence":["houfei-q-o041"]}]}],"evidence":[{"id":"houfei-e-o037c-q","section":"chapter-005","block":"b-d0a6e29e31a39640944e","layer":"original","quote":"后早丧兄弟，以从兄表，继永后，拜奉车都尉。后外亲刘斐与他国为婚〖1〗。后闻之，敕曰：“诸亲戚嫁娶，自当与乡里门户匹敌者，不得因势，强与他方人婚也。”后姊子孟武，还乡里，求小妻。后止之，遂敕诸家曰：“今世妇女少，当配将士。不得因缘取以为妾也〖2〗。宜各自慎，无为罚首〖3〗！”﹝一﹞","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":182,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":140,"offset_unit":"unicode_code_point"},{"id":"houfei-e-o041c-q","section":"chapter-005","block":"b-ea6bed6da1ea24121baf","layer":"original","quote":"太和四年，诏封表安阳亭侯。又进爵乡侯，增邑并前五百户，迁中垒将军。以表子详为骑都尉。其年，帝追谥太后父永，为安阳乡敬侯；母董，为都乡君。迁表昭德将军〖1〗，加金紫〖2〗，位特进；表第二子训，为骑都尉。及孟武母卒，欲厚葬，起祠堂。太后止之曰：“自丧乱以来，坟墓无不发掘。皆由厚葬也，首阳陵可以为法。”","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":201,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":149,"offset_unit":"unicode_code_point"},{"id":"houfei-e-p020a-q","section":"chapter-005","block":"b-bb41e1cc70faf54a005e","layer":"pei","quote":"﹝一﹞《魏书》曰：“后常敕戒表、武等曰：‘汉氏椒房之家，少能自全者。皆由骄奢，可不慎乎！’”","attribution":"《魏书》","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":199,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-23eeb6f160ab289149df","start":0,"end":46,"offset_unit":"unicode_code_point"},{"id":"houfei-q-b-cbf406b91aa2796bad01","section":"chapter-005","block":"b-cbf406b91aa2796bad01","layer":"modern","quote":"〖10〗四年：太和四年（公元 230）。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":108,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-776c1db56d4d5699fd84","start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"houfei-q-o012","section":"chapter-005","block":"b-743375ca04aa18c715da","layer":"original","quote":"至太和四年春，明帝乃追谥太后祖父广曰开阳恭侯〖12〗，父远曰敬侯〖13〗，祖母周封阳都君，及（恭）〔敬〕侯夫人，皆赠印绶〖14〗。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":44,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":65,"offset_unit":"unicode_code_point"},{"id":"houfei-q-o037","section":"chapter-005","block":"b-d0a6e29e31a39640944e","layer":"original","quote":"后早丧兄弟，以从兄表，继永后，拜奉车都尉。后外亲刘斐与他国为婚〖1〗。后闻之，敕曰：“诸亲戚嫁娶，自当与乡里门户匹敌者，不得因势，强与他方人婚也。”后姊子孟武，还乡里，求小妻。后止之，遂敕诸家曰：“今世妇女少，当配将士。不得因缘取以为妾也〖2〗。宜各自慎，无为罚首〖3〗！”﹝一﹞","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":182,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":140,"offset_unit":"unicode_code_point"},{"id":"houfei-q-o041","section":"chapter-005","block":"b-ea6bed6da1ea24121baf","layer":"original","quote":"太和四年，诏封表安阳亭侯。又进爵乡侯，增邑并前五百户，迁中垒将军。以表子详为骑都尉。其年，帝追谥太后父永，为安阳乡敬侯；母董，为都乡君。迁表昭德将军〖1〗，加金紫〖2〗，位特进；表第二子训，为骑都尉。及孟武母卒，欲厚葬，起祠堂。太后止之曰：“自丧乱以来，坟墓无不发掘。皆由厚葬也，首阳陵可以为法。”","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":201,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":149,"offset_unit":"unicode_code_point"},{"id":"houfei-q-p020","section":"chapter-005","block":"b-bb41e1cc70faf54a005e","layer":"pei","quote":"﹝一﹞《魏书》曰：“后常敕戒表、武等曰：‘汉氏椒房之家，少能自全者。皆由骄奢，可不慎乎！’”","attribution":"《魏书》","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":199,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a635