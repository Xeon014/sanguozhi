{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xunyu-e-p031a","title":"晋纪记荀顗和峤察太子孙盛记为荀勖","accounts":[{"id":"xunyu-e-p031a-account","label":"干宝《晋纪》","text":"干宝《晋纪》记晋武帝遣荀顗、和峤观察太子，二人回报不同。","evidence":["xunyu-e-p031a-q"]},{"id":"xunyu-a-p032-judgment","label":"裴松之按","text":"裴松之认为荀顗已卒、荀勖位次不合，应是荀恺，另述恺及兄弟官职。","evidence":["xunyu-q-p032-judgment"]},{"id":"xunyu-a-p031-sunsheng","label":"孙盛异说","text":"孙盛另记遣荀勖，其余语相同。","evidence":["xunyu-q-p031-sunsheng"]}],"participants":[{"person":"shaodi-p0136","role":"遣察","evidence":["xunyu-e-p031a-q"]},{"person":"shaodi-p0090","role":"被记察太子","evidence":["xunyu-e-p031a-q"]},{"person":"xunyu-p0070","role":"察太子","evidence":["xunyu-e-p031a-q"]}],"place":null,"time":{"label":"晋武帝察太子时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xunyu-e-p031a-q"]},"ordering_evidence":"xunyu-e-p031a-q","source_order":[10,190,"P031a"],"order":2471},{"id":"hechang-e-7e0184c5a4fc813fa7c4","title":"和峤黄门郎迁中书令转尚书","accounts":[{"id":"hechang-a-7e0184c5a4fc813fa7c4","label":"裴注·晋诸公赞","text":"和峤黄门郎迁中书令转尚书","evidence":["hechang-q-91c12bf7ddf266c1ddc8"]}],"participants":[{"person":"xunyu-p0070","role":"任官","evidence":["hechang-q-91c12bf7ddf266c1ddc8"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["hechang-q-91c12bf7ddf266c1ddc8"]},"ordering_evidence":"hechang-q-91c12bf7ddf266c1ddc8","order":4676},{"id":"hechang-e-3d5f093a2167be42762b","title":"愍怀太子初立和峤少保加散骑常侍","accounts":[{"id":"hechang-a-3d5f093a2167be42762b","label":"裴注·晋诸公赞","text":"愍怀太子初立和峤少保加散骑常侍","evidence":["hechang-q-33a2be9ba381d5f21fe1"]}],"participants":[{"person":"xunyu-p0070","role":"任官","evidence":["hechang-q-33a2be9ba381d5f21fe1"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["hechang-q-33a2be9ba381d5f21fe1"]},"ordering_evidence":"hechang-q-33a2be9ba381d5f21fe1","order":4677},{"id":"hechang-e-4719d1379d81df301f68","title":"和峤卒官赠光禄大夫","accounts":[{"id":"hechang-a-4719d1379d81df301f68","label":"裴注·晋诸公赞","text":"和峤卒官赠光禄大夫","evidence":["hechang-q-0da7adeb8092cbf61213"]}],"participants":[{"person":"xunyu-p0070","role":"去世追赠","evidence":["hechang-q-0da7adeb8092cbf61213"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["hechang-q-0da7adeb8092cbf61213"]},"ordering_evidence":"hechang-q-0da7adeb8092cbf61213","order":4678},{"id":"zhuge-e-o074a","title":"荀勖和峤奏使陈寿整理诸葛亮故事为二十四篇","accounts":[{"id":"zhuge-e-o074a-account","label":"《诸葛亮传第五》正文","text":"荀勖和峤奏使陈寿整理诸葛亮故事为二十四篇","evidence":["zhuge-e-o074a-q"]}],"participants":[{"person":"xunyu-p0069","role":"奏请","evidence":["zhuge-e-o074a-q"]},{"person":"xunyu-p0070","role":"奏请","evidence":["zhuge-e-o074a-q"]},{"person":"zhuge-p0051","role":"编集","evidence":["zhuge-e-o074a-q"]}],"place":null,"time":{"label":"陈寿编诸葛亮集时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["zhuge-e-o074a-q"]},"ordering_evidence":"zhuge-e-o074a-q","source_order":[35,346,"O074a"],"order":6819}],"persons":[{"id":"xunyu-p0070","name":"和峤","evidence":["xunyu-q-p031","zhuge-q-o074","hechang-q-91c12bf7ddf266c1ddc8","hechang-q-33a2be9ba381d5f21fe1","hechang-q-0da7adeb8092cbf61213","hechang-q-813d2d3dc83a3321b9b3"],"facts":[{"id":"hechang-f-8fb9f9c2ee5fef0b4441","text":"字长舆，和逌之子；和郁为其同母弟，夏侯玄为其舅。","evidence":["hechang-q-813d2d3dc83a3321b9b3"]}],"aliases":[],"mentions":[{"id":"xunyu-m-p031-xunyu-p0070","kind":"mention","text":"文中提及","evidence":["xunyu-q-p031"]},{"id":"xunyu-m-p032-xunyu-p0070","kind":"mention","text":"文中提及","evidence":["xunyu-q-p032"]},{"id":"zhuge-m-o074-xunyu-p0070","kind":"mention","text":"文中提及","evidence":["zhuge-q-o074"]}]}],"evidence":[{"id":"hechang-q-0da7adeb8092cbf61213","section":"chapter-023","block":"b-8abf4bcb5c4f88e7fc2e","layer":"pei","quote":"卒于官，赠光禄大夫。","attribution":"裴注·晋诸公赞","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":84,"anchor":null},"note_id":"n-ad8e752c9344e34f5fd9","start":126,"end":136},{"id":"hechang-q-33a2be9ba381d5f21fe1","section":"chapter-023","block":"b-8abf4bcb5c4f88e7fc2e","layer":"pei","quote":"愍怀太子初立，以峤为少保，加散骑常侍。","attribution":"裴注·晋诸公赞","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":84,"anchor":null},"note_id":"n-ad8e752c9344e34f5fd9","start":71,"end":90},{"id":"hechang-q-813d2d3dc83a3321b9b3","section":"chapter-023","block":"b-8abf4bcb5c4f88e7fc2e","layer":"pei","quote":"﹝二﹞《晋诸公赞》曰：“和峤字长舆。（适）〔逌〕之子也。少知名，以雅重称。常慕其舅夏侯玄之为人；厚自封植，嶷然不群。于黄门郎迁中书令，转尚书。愍怀太子初立，以峤为少保，加散骑常侍。家产丰富，拟于王公，而性至俭吝。峤同母弟郁，素无名；峤轻侮之，以此为损。卒于官，赠光禄大夫。郁以公强当世，致位尚书令。”","attribution":"裴注（引书见原文，待主审复核）","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":84,"anchor":null},"note_id":"n-ad8e752c9344e34f5fd9","start":0,"end":150},{"id":"hechang-q-91c12bf7ddf266c1ddc8","section":"chapter-023","block":"b-8abf4bcb5c4f88e7fc2e","layer":"pei","quote":"于黄门郎迁中书令，转尚书。","attribution":"裴注·晋诸公赞","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":84,"anchor":null},"note_id":"n-ad8e752c9344e34f5fd9","start":58,"end":71},{"id":"xunyu-e-p031a-q","section":"chapter-010","block":"b-643aa55563b5613e764f","layer":"pei","quote":"武帝使侍中荀顗、和峤，俱至东宫，观察太子。顗还，称太子‘德识进茂’，而峤云‘圣质如初’。","attribution":"干宝《晋纪》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":189,"anchor":null},"note_id":"n-1cd39ba61e7c038ca47e","start":9,"end":53},{"id":"xunyu-q-p031","section":"chapter-010","block":"b-643aa55563b5613e764f","layer":"pei","quote":"干宝《晋纪》曰：“武帝使侍中荀顗、和峤，俱至东宫，观察太子。顗还，称太子‘德识进茂’，而峤云‘圣质如初’。”孙盛曰“遣荀勖”，其余语则同。","attribution":"干宝《晋纪》及孙盛异说","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":189,"anchor":null},"note_id":"n-1cd39ba61e7c038ca47e","start":0,"end":69},{"id":"xunyu-q-p031-sunsheng","section":"chapter-010","block":"b-643aa55563b5613e764f","layer":"pei","quote":"孙盛曰“遣荀勖”，其余语则同。","attribution":"孙盛异说","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":189,"anchor":null},"note_id":"n-1cd39ba61e7c038ca47e","start":54,"end":69},{"id":"xunyu-q-p032","section":"chapter-010","block":"b-5ab93710c1bb7fe30998","layer":"pei","quote":"臣松之按：和峤为侍中，荀顗亡没久矣。荀勖位亚台司，不与峤同班，无缘方称“侍中”。二书所云，皆为非也。考其时位，恺实当之。恺位至征西大将军。恺兄儋，少府。弟悝，护军将军，追赠车骑大将军。","attribution":"裴松之按","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":190,"anchor":null},"note_id":"n-1cd39ba61e7c038ca47e","start":0,"end":92},{"id":"xunyu-q-p032-judgment","section":"chapter-010","block":"b-5ab93710c1bb7fe30998","layer":"pei","quote":"臣松之按：和峤为侍中，荀顗亡没久矣。荀勖位亚台司，不与峤同班，无缘方称“侍中”。二书所云，皆为非也。考其时位，恺实当之。恺位至征西大将军。恺兄儋，少府。弟悝，护军将军，追赠车骑大将军。","attribution":"裴松之按","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":190,"anchor":null},"note_id":"n-1cd39ba61e7c038ca47e","start":0,"end":92},{"id":"zhuge-e-o074a-q","section":"chapter-035","block":"b-96d90e7e8282428156de","layer":"original","quote":"臣寿等言：臣前在著作郎〖1〗，侍中、领中书监、济北侯臣荀勖，中书令、关内侯臣和峤奏〖2〗，使臣定故蜀丞相诸葛亮故事〖3〗。亮毗佐危国〖4〗，负阻不宾；然犹存录其言，耻善有遗〖5〗：诚是大晋光明至德，泽被无疆。自古以来，未之有伦也〖6〗。辄删除复重，随类相从，凡为二十四篇，篇名如右。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":345,"anchor":null},"note_id":null,"start":0,"end":141},{"id":"zhuge-q-o074","section":"chapter-035","block":"b-96d90e7e8282428156de","layer":"original","quote":"臣寿等言：臣前在著作郎〖1〗，侍中、领中书监、济北侯臣荀勖，中书令、关内侯臣和峤奏〖2〗，使臣定故蜀丞相诸葛亮故事〖3〗。亮毗佐危国〖4〗，负阻不宾；然犹存录其言，耻善有遗〖5〗：诚是大晋光明至德，泽被无疆。自古以来，未之有伦也〖6〗。辄删除复重，随类相从，凡为二十四篇，篇名如右。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":345,"anchor":null},"note_id":null,"start":0,"end":141}],"profiles":{},"directory_counts":{}}
