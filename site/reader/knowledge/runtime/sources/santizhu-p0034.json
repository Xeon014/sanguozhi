6b86d0524e6"]},{"person":"santizhu-p0034","role":"受右将军并封县侯","evidence":["santizhu064-q-904d090576b86d0524e6"]},{"person":"santizhu-p0033","role":"受拜杂号将军、封亭侯","evidence":["santizhu064-q-8cc8349758b19c0e3cd6"]},{"person":"santizhu-p0166","role":"受封亭侯","evidence":["santizhu064-q-8cc8349758b19c0e3cd6"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"未由相邻段落推算纪年；原文时间表达保留在来源引句中。","evidence":["santizhu064-q-904d090576b86d0524e6"]},"ordering_evidence":"santizhu064-q-904d090576b86d0524e6","source_order":[64,100,0],"order":11037}],"persons":[{"id":"santizhu-p0034","name":"孙据","evidence":["santizhu-q-5ae60a02b3158490414f","santizhu064-q-d291c494e8c9a9a2091f","santizhu064-q-904d090576b86d0524e6"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[{"id":"santizhu-q-5ae60a02b3158490414f","section":"chapter-048","block":"b-fb14779f09fa774f9ff4","layer":"original","quote":"永安元年冬十月，壬午〖1〗，诏曰：“夫褒德赏功，古今通义：其以大将军綝为丞相，荆州牧，增食五县；武卫将军恩为御史大夫，卫将军，中军督〖2〗，封县侯；威远将军（授）〔据〕为右将军，县侯〖3〗；偏将军幹杂号将军，亭侯；长水校尉张布辅导勤劳〖4〗，以布为辅义将军〖5〗，封永康侯；董朝亲迎，封为乡侯","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":149,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":146,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-75fa122396157be5217b","section":"chapter-064","block":"b-e9625f9b47fb4c167a95","layer":"original","quote":"綝以孙亮始亲政事，多所难问，甚惧。还建业，称疾不朝。筑室于朱雀桥南〖1〗，使弟威远将军据，入苍龙宿卫〖2〗；弟武卫将军恩、偏将军幹、长水校尉闿，分屯诸营：欲以专朝自固。","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":454,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":84,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-8cc8349758b19c0e3cd6","section":"chapter-064","block":"b-1ed48f2a0752e4fd8d7e","layer":"original","quote":"幹，杂号将军〖19〗，亭侯。闿，亦封亭侯。”","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":483,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":157,"end":179,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-904d090576b86d0524e6","section":"chapter-064","block":"b-1ed48f2a0752e4fd8d7e","layer":"original","quote":"休引见慰喻。又下诏曰：“朕以不德〖14〗，守藩于外。值兹际会，群公卿士，暨于朕躬，以奉宗庙。朕用怃然〖15〗，若涉渊冰〖16〗。大将军忠计内发，扶危定倾；安康社稷，功勋赫然。昔汉孝宣践阼〖17〗，霍光尊显；褒德赏功，古今之通义也。其以大将军为丞相，荆州牧，食五县〖18〗。恩为御史大夫，卫将军；据，右将军：皆县侯。幹，杂号将军〖19〗，亭侯。闿，亦封亭侯","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":483,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":177,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-d291c494e8c9a9a2091f","section":"chapter-064","block":"b-da2900eb25692ecb6e49","layer":"original","quote":"据引兵还，使人报胤，欲共废綝。綝闻之，遣从兄（虑）〔宪〕，将兵逆据于江都〖3〗；使中使敕文钦、刘纂、唐咨等，合众击据；遣侍中、左将军华融、中书丞丁晏，告胤取据，并喻胤宜速去意〖4〗。胤自以祸及，因留融、晏，勒兵自卫","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":416,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":47,"end":154,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
