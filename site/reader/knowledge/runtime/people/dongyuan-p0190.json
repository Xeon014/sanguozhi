{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[],"persons":[{"id":"dongyuan-p0190","name":"蒋奇","evidence":["dongyuan-q-o051"],"facts":[],"aliases":[],"mentions":[{"id":"dongyuan-m-o051-dongyuan-p0190","kind":"mention","text":"文中提及","evidence":["dongyuan-q-o051"]}]}],"evidence":[{"id":"dongyuan-q-o051","section":"chapter-006","block":"b-c11903f59e2abda470f6","layer":"original","quote":"太祖与绍相持日久，百姓疲乏，多叛应绍，军食乏。会绍遣淳于琼等，将兵万余人，北迎运车；沮授说绍：“可遣将蒋奇，别为支军于表〖7〗，以断曹公之抄。”绍复不从。琼宿乌巢〖8〗，去绍军四十里。太祖乃留曹洪守，自将步骑五千，候夜潜往攻琼。绍遣骑救之，败走。破琼等，悉斩之。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":309,"anchor":null},"note_id":null,"start":0,"end":131}],"profiles":{},"directory_counts":{}}
