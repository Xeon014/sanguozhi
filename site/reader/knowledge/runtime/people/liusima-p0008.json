{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"liusima-e-o195","title":"刘类苛虐属吏，捽头乱杖，牵出复入","time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liusima-q-5ab5c9492ce41730c2ae","liusima-q-0a2f6437849f19ad4570","liusima-q-24445d3251ce60bd4484","liusima-q-8338e3746c18405a3ccc","liusima-q-ce35cf08c792cc6301ad","liusima-q-503ae1ce4cf8cad7008a","liusima-q-ec2f0ee026b774b187a1"]},"order":3284,"participants":[{"person":"liusima-p0008","role":"吏二百余人不与休假，专使为不急；过无轻重辄捽其头，又乱杖挝之，牵出复入如是数四；使人掘地求钱，所在市里皆有孔穴；每出行阳敕督邮不得使官属曲修礼敬，而阴识不来者辄发怒中伤之；每遣大吏出辄使小吏随覆察之，白日常自于墙壁间窥闪，夜使干廉察诸曹，复以干不足信又遣铃下及奴婢转相检验；案行宿止民家，民家二狗逐猪、猪惊走头插栅间号呼良久，类以为外之吏擅共饮食，不复征察，便使伍百曳五官掾孙弼入顿头责之；弼以实对，类自愧不详，因托问以他事；望见呵其儿曰用是死人使来见我，其视人无礼皆此类；虽闻之犹不能自改；被告，乃召入为五官中郎将","evidence":["liusima-q-5ab5c9492ce41730c2ae","liusima-q-0a2f6437849f19ad4570","liusima-q-24445d3251ce60bd4484","liusima-q-8338e3746c18405a3ccc","liusima-q-ce35cf08c792cc6301ad","liusima-q-503ae1ce4cf8cad7008a","liusima-q-ec2f0ee026b774b187a1"]},{"person":"liusima-p0020","role":"五官掾，被曳入顿头责之，以实对","evidence":["liusima-q-8338e3746c18405a3ccc"]},{"person":"liusima-p0021","role":"民，年垂百岁，闻类出行谓其儿扶我迎府君我欲陈恩，儿扶昌在道左","evidence":["liusima-q-ce35cf08c792cc6301ad"]},{"person":"shaodi-p0045","role":"安东将军（司马文王），西征路经弘农","evidence":["liusima-q-ec2f0ee026b774b187a1"]}],"accounts":[]}],"persons":[{"id":"liusima-p0008","name":"刘类","evidence":["liusima-q-5ab5c9492ce41730c2ae","liusima-q-0a2f6437849f19ad4570","liusima-q-24445d3251ce60bd4484","liusima-q-8338e3746c18405a3ccc","liusima-q-ce35cf08c792cc6301ad","liusima-q-503ae1ce4cf8cad7008a","liusima-q-ec2f0ee026b774b187a1"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[],"profiles":{},"directory_counts":{}}
