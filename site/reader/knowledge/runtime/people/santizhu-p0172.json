ence":["zhangyan-q-46349215efb2f27db00d"]}],"aliases":[],"mentions":[{"id":"wufan-m-463bd2a2b3575c027678","kind":"mention","text":"本篇记载：名儒善士，曾亲屈节就学于赵达","evidence":["wufan-q-d8e5edfa10a15e4625d5"]},{"id":"zhangyan-m-a4011acc495b04404fd6","kind":"mention","text":"陈寿评曰：严、程、阚生，一时儒林也","evidence":["zhangyan-q-118dd7b542a20ec2838a"]},{"id":"yululu-m-0ffcb2ef245647ca7d68","kind":"mention","text":"本篇原文记及阚泽，具体行动与称谓见引文。","evidence":["yululu-q-a7c835f82230b992cee9"]},{"id":"yululu-m-c798eda3f827cc7d84ba","kind":"mention","text":"育举太子少傅山阴阚泽，渊懿纯德、作帝师儒","evidence":["yululu-q-a10cdb7af3f03e686cf1"]}]}],"evidence":[],"profiles":{},"directory_counts":{}}
