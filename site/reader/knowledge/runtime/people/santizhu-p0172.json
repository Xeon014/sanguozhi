-a7c835f82230b992cee9","yululu-q-a10cdb7af3f03e686cf1"],"facts":[{"id":"zhangyan-f-d591ce7d61407aa5968e","text":"字德润，会稽山阴人","evidence":["zhangyan-q-c6a5ed3f9abeb669c9a2"]},{"id":"zhangyan-f-21ae72cea6932c40aadf","text":"家世农夫，至泽好学","evidence":["zhangyan-q-c6a5ed3f9abeb669c9a2"]},{"id":"zhangyan-f-867292fadeb03233277b","text":"居贫无资，常为人佣书以供纸笔；所写既毕，诵读亦遍","evidence":["zhangyan-q-c6a5ed3f9abeb669c9a2"]},{"id":"zhangyan-f-d7a6d17d4a1ce574b3ca","text":"追师论讲，究览群籍，兼通历数","evidence":["zhangyan-q-c6a5ed3f9abeb669c9a2"]},{"id":"zhangyan-f-0e3d2fb0e339fe5f7849","text":"由是显名","evidence":["zhangyan-q-c6a5ed3f9abeb669c9a2"]},{"id":"zhangyan-f-c544d79b74052668bac8","text":"每朝廷大议、经典所疑，孙权辄咨访之","evidence":["zhangyan-q-f876b4149df635694189"]},{"id":"zhangyan-f-3f75d257c5eb5212e7fc","text":"性谦恭笃慎，（官）〔宫〕府小吏呼召对问，皆为抗礼","evidence":["zhangyan-q-8896330432490af7a28a"]},{"id":"zhangyan-f-3a33cb4e059e2cae3aaa","text":"人有非短，口未尝及","evidence":["zhangyan-q-8896330432490af7a28a"]},{"id":"zhangyan-f-0850bf7a73579b8ab41f","text":"容貌似不足者，然所闻少穷","evidence":["zhangyan-q-8896330432490af7a28a"]},{"id":"zhangyan-f-7ae4afd4deda7443aba2","text":"诸官司欲增重科防以检御臣下，泽每曰宜依礼、律，其和而有正","evidence":["zhangyan-q-5e9bed0855ae724b8f71"]},{"id":"zhangyan-f-d50a33b0b792aafccfe2","text":"《吴录》称虞翻誉之曰阚生矫杰，盖蜀之扬雄；阚子儒术德行，亦今之仲舒也","evidence":["zhangyan-q-46349215efb2f27db00d"]}],"aliases":[],"mentions":[{"id":"wufan-m-463bd2a2b3575c027678","kind":"mention","text":"本篇记载：名儒善士，曾亲屈节就学于赵达","evidence":["wufan-q-d8e5edfa10a15e4625d5"]},{"id":"zhangyan-m-a4011acc495b04404fd6","kind":"mention","text":"陈寿评曰：严、程、阚生，一时儒林也","evidence":["zhangyan-q-118dd7b542a20ec2838a"]},{"id":"yululu-m-0ffcb2ef245647ca7d68","kind":"mention","text":"本篇原文记及阚泽，具体行动与称谓见引文。","evidence":["yululu-q-a7c835f82230b992cee9"]},{"id":"yululu-m-c798eda3f827cc7d84ba","kind":"mention","text":"育举太子少傅山阴阚泽，渊懿纯德、作帝师儒","evidence":["yululu-q-a10cdb7af3f03e686cf1"]}]}],"evidence":[],"profiles":{},"directory_counts":{}}
