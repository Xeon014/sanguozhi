dated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["lvzang-q-dbfdaeb2ed7f928bc45e"]},"order":1855,"participants":[{"person":"wudi-p0140","role":"每谏布言凡破家亡国非无忠臣明智者也但患不见用耳将军举动不肯详思辄喜言误误不可数也、当攻战仍将续所领兵、终无恨意","evidence":["lvzang-q-dbfdaeb2ed7f928bc45e"]},{"person":"wudi-p0088","role":"知其忠然不能用、从郝萌反后更疏顺、以魏续有外内之亲悉夺顺所将兵以与续","evidence":["lvzang-q-dbfdaeb2ed7f928bc45e"]},{"person":"wudi-p0146","role":"有外内之亲、受顺所将兵","evidence":["lvzang-q-dbfdaeb2ed7f928bc45e"]}],"accounts":[]}],"persons":[{"id":"wudi-p0140","name":"高顺","evidence":["wudi-q-o057","xianzhu-q-o013","lvzang-q-4fe6a800149fd9eee435","lvzang-q-292cdc633bfd71d74aca","lvzang-q-1d5c9a6c11cb5bec3896","lvzang-q-f8915f4f016e3fbb0ee0","lvzang-q-77fcb395a910b6776708","lvzang-q-7b9e6230d9c398eff09a","lvzang-q-cd24258052e243fc9830","lvzang-q-dbfdaeb2ed7f928bc45e","lvzang-q-ec51daeef30a723ebf93"],"facts":[{"id":"lvzang-f-review-e9129c5f984437f2bae6","text":"英雄记记：为人清白有威严，不饮酒，不受馈遗；所将七百余兵号为千人，铠甲斗具皆精练齐整，名为陷阵营","evidence":["lvzang-q-ec51daeef30a723ebf93"]}],"aliases":[],"mentions":[{"id":"wudi-m-o057-wudi-p0140","kind":"mention","text":"文中提及","evidence":["wudi-q-o057"]},{"id":"xianzhu-m-o013-wudi-p0140","kind":"mention","text":"文中提及","evidence":["xianzhu-q-o013"]},{"id":"xianzhu-m-p012-wudi-p0140","kind":"mention","text":"文中提及","evidence":["xianzhu-q-p012"]}]}],"evidence":[],"profiles":{},"directory_counts":{}}
