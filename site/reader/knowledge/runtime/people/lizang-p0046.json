552a8c566031fea","lizang-q-ea670eb725fa0fbf6b1a","lizang-q-4d923b309de56257680c","lizang-q-164e2eb6b65ffce20079","lizang-q-f348e3ca2f89bb4c7039","lizang-q-14fd0cb1bd3a413943d6","lizang-q-c06ed232fd03532edceb","lizang-q-740af62875fe0a79e3c8","lizang-q-79da118ef3971c0e60dc","lizang-q-bf43503418a0712b9d44","lizang-q-43043e11a142eeeca69c","lizang-q-f146ca82d7362393e675","lizang-q-7914db0fce460fd17b99","lizang-q-1e7338cf081eb86862ba","lizang-q-646f323945352b3e7892","lizang-q-8c53ac782c63fa867df3","lizang-q-5e8d44a5bfaa368a70b8","lizang-q-7756d8e2cab891f72992","lizang-q2-ee5dc67ea1f8ec75e7b4","lizang-q2-25c9fa099963b041ca86","lizang-q2-7bd0cf688e06d6e553e5","lizang-q-4e5524c11c2513491a74","lizang-q-1d23e5b3c20c0aa328d5","lizang-q-ec49df8dde77f0d32123","hechang-q-1740026fae8f7e4ba612","hechang-q-0a14ba0ef123d65594a2"],"facts":[{"id":"lizang-f2-7b3575b3ae988036a1c5","text":"拜振威中郎将，屯汝南西界；以破张绣功，拜裨将军，封建功侯；分汝南二县，以通为阳安都尉。","evidence":["lizang-q2-ee5dc67ea1f8ec75e7b4"]},{"id":"lizang-f2-957b116ee562a9375ee3","text":"改封都亭侯，拜汝南太守；有征南之授而未就。","evidence":["lizang-q2-25c9fa099963b041ca86"]},{"id":"lizang-f2-b3fb7645c68eb38bd1ba","text":"子基袭爵；文帝时诏称基兄绪前屯樊城有功，以基为奉义中郎将、绪为平虏中郎将。","evidence":["lizang-q2-7bd0cf688e06d6e553e5"]},{"id":"lizang-f2-63cb02104f2600bd38c1","text":"《魏略》记小字万亿。","evidence":["lizang-q-4e5524c11c2513491a74"]},{"id":"lizang-f2-15f6a8038ebb44cf44f7","text":"王隐《晋书》记绪子秉，字玄胄，为秦州刺史；答司马昭清、慎、勤之问，后作家诫。","evidence":["lizang-q-1d23e5b3c20c0aa328d5"]},{"id":"lizang-f2-5a0995c1f754172ed493","text":"《晋诸公赞》记秉子重拒赵王伦征为右司马，不自治病，被扶曳就职而卒，赠散骑常侍；重弟尚、矩并典郡，矩至江州刺史，重子式为侍中。","evidence":["lizang-q-ec49df8dde77f0d32123"]}],"aliases":[],"mentions":[]}],"evidence":[],"profiles":{},"directory_counts":{}}
