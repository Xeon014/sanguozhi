{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[],"persons":[{"id":"wuzhu-p0006","name":"子夏","evidence":["wuzhu-q-p002"],"facts":[],"aliases":[],"mentions":[{"id":"wuzhu-m-p002-wuzhu-p0006","kind":"allusion","text":"祖系或典故提及","evidence":["wuzhu-q-p002"]}]}],"evidence":[{"id":"wuzhu-q-p002","section":"chapter-047","block":"b-34d49faca046a8e03214","layer":"pei","quote":"﹝一﹞臣松之按《礼记•曾子问》：“子夏曰：‘三年之丧，金革之事无避也者，礼与？初有司与？’孔子曰：‘吾闻诸老聃曰：昔者鲁公伯禽，有为为之也。’”郑玄注曰：“周人卒哭而致事。时有徐戎作难，伯禽卒哭而征之：急王事也。”昭所云“伯禽不师”，盖谓此也。","attribution":"裴松之按《礼记·曾子问》及郑玄注","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":57,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-313ba23914d7f6c8b8c7","start":0,"end":122,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
