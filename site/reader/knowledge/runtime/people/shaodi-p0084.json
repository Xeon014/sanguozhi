{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[],"persons":[{"id":"shaodi-p0084","name":"郭颁","evidence":["shaodi-q-p027"],"facts":[],"aliases":[],"mentions":[{"id":"shaodi-m-p027-shaodi-p0084","kind":"mention","text":"文中提及","evidence":["shaodi-q-p027"]}]}],"evidence":[{"id":"shaodi-q-p027","section":"chapter-004","block":"b-5076258468868ff85935","layer":"pei","quote":"臣松之检诸书，都无此事；至诸葛诞反，司马文王始挟太后及帝与俱行耳。故发诏引汉二祖及明帝亲征以为前比，知明帝以后始有此行也。按张璠、虞溥、郭颁，皆晋之令史；璠、颁出为官长；溥，鄱阳内史。璠撰《后汉纪》，虽似未成，辞藻可观。溥著《江表传》，亦粗有条贯。惟颁撰《魏晋世语》，蹇乏全无宫商，最为鄙劣；以时有异事，故颇行于世。干宝、孙盛等，多采其言以为《晋书》；其中虚错如此者，往往而有之。","attribution":"裴松之按","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":385,"anchor":null},"note_id":"n-ac1886f2664b39196cd9","start":0,"end":190}],"profiles":{},"directory_counts":{}}
