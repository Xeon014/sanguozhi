{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[],"persons":[{"id":"zhangle-p0001","name":"聂壹","evidence":["zhangle-q-o001"],"facts":[],"aliases":[],"mentions":[{"id":"zhangle-m-o001-zhangle-p0001","kind":"mention","text":"文中提及","evidence":["zhangle-q-o001"]}]}],"evidence":[{"id":"zhangle-q-o001","section":"chapter-017","block":"b-dce09ba3edeac4fce824","layer":"original","quote":"张辽字文远，雁门马邑人也〖1〗。本聂壹之后〖2〗，以避怨变姓。少为郡吏。汉末，并州刺史丁原，以辽武力过人，召为从事。使将兵诣京都。何进遣诣河北募兵，得千余人。还，进败，以兵属董卓。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":1,"anchor":null},"note_id":null,"start":0,"end":90}],"profiles":{},"directory_counts":{}}
