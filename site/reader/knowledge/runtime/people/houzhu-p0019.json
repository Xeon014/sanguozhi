{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"shaodi-e-o169a","title":"刘禅向邓艾降巴蜀平","time":{"year":263,"label":"十一月","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"shaodi-y263","dating_review":{"reviewed":true,"anchor":"shaodi-q-o165","basis":"十一月"},"evidence":["shaodi-e-o169a-q","shaodi-q-o165","shaodi-q-b-ded6d700dc6f860d1670"]},"order":1273,"participants":[{"person":"xianzhu-p0112","role":"归降","evidence":["shaodi-e-o169a-q"]},{"person":"shaodi-p0080","role":"受降","evidence":["shaodi-e-o169a-q"]},{"person":"shaodi-p0073","role":"参与伐蜀","evidence":["shaodi-e-o169a-q"]},{"person":"shaodi-p0154","role":"蜀并于魏之岁保全一方，举以内附，因仍前任；得后主东迁之问，始率六郡将守上表，称国败主附、守死无所，是以委质不敢有贰","evidence":["huowang-q-c96785b0920fd4930364"]},{"person":"santizhu-p0056","role":"巴东领军，与霍弋各保全一方举以内附","evidence":["huowang-q-c96785b0920fd4930364"]},{"person":"xianzhu-p0102","role":"以为自古以来无寄他国为天子，入吴固当臣服，魏能并吴吴不能并魏，再辱之耻何与一辱；欲奔南则当早计，今大敌已近群小之心无一可保，其变不测，何至南之有；答群臣之难以方今东吴未宾，事势不得不受降、受之后不得不礼；若陛下降魏而魏不裂土以封陛下，请身诣京都以古义争之；上疏以为适南之计不安；其策见用，刘氏无虞，一邦蒙赖；其降魏之计为后主所从","evidence":["duzhou-q-4e827542b8e82940ce6f","duzhou-q-304ce4773010397a5961","duzhou-q-4866ceaa6aacd666bb63","duzhou-q-41c437ed6248c17bf075","duzhou-q-178507ad62e769e5846b"]},{"person":"houzhu-p0019","role":"后主请降之书为其所造","evidence":["duzhou-q-3e79261917b90578efcf"]}],"accounts":[]},{"id":"houzhu-e-o085a","title":"刘禅及蜀臣受封列侯","time":{"label":"年代未详","precision":"undated","basis":"保留本条原纪年表达；没有直接绑定的公元年证据，未补公元年。","evidence":["houzhu-q-O085"]},"order":6700,"participants":[{"person":"xianzhu-p0112","role":"受封者","evidence":["houzhu-q-O085"]},{"person":"zhuge-p0062","role":"受封者","evidence":["houzhu-q-O085"]},{"person":"guanzhang-p0010","role":"受封者","evidence":["houzhu-q-O085"]},{"person":"xianzhu-p0102","role":"受封者","evidence":["houzhu-q-O085"]},{"person":"houzhu-p0019","role":"受封者","evidence":["houzhu-q-O085"]},{"person":"houzhu-p0020","role":"受封者","evidence":["houzhu-q-O085"]}],"accounts":[]}