{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[],"persons":[{"id":"huowang-p2-xiangtiao","name":"向条（向朗子）","evidence":["huowang-q2-ab409da7b7040eec685c","huowang-q2-5e139f649c88f65e389f"],"facts":[{"id":"huowang-f2-7f22f8aca379f79a40a8","text":"向条为向朗之子，嗣爵，景耀中为御史中丞。","evidence":["huowang-q2-ab409da7b7040eec685c"]},{"id":"huowang-f2-d761a744b44dfba02a8f","text":"据《襄阳记》，向条字文豹，入晋为江阳太守、南中军司马。","evidence":["huowang-q2-5e139f649c88f65e389f"]}],"aliases":[],"mentions":[]}],"evidence":[{"id":"huowang-q2-5e139f649c88f65e389f","section":"chapter-041","block":"b-f653ac0b84912c9f23c7","layer":"pei","quote":"﹝四﹞《襄阳记》曰：“条字文豹。亦博学多识，入晋，为江阳太守、南中军司马。”","attribution":"裴注（引书见原文）","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":64,"anchor":null},"note_id":"n-94921296f76301798028","start":0,"end":38},{"id":"huowang-q2-ab409da7b7040eec685c","section":"chapter-041","block":"b-18d6bb3f10515ce754c4","layer":"original","quote":"延熙十年卒。﹝三﹞子条嗣，景耀中，为御史中丞。﹝四﹞","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":41,"anchor":null},"note_id":null,"start":0,"end":26}],"profiles":{},"directory_counts":{}}
