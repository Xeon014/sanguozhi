{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[],"persons":[{"id":"yuanzhang-p2-yudun","name":"庾遁（庾嶷弟）","evidence":["yuanzhang-q2-566e74e14851898349c5"],"facts":[{"id":"yuanzhang-f2-cd89f3d248a90f2c9230","text":"庾遁为庾嶷弟，字德先，任太中大夫。","evidence":["yuanzhang-q2-566e74e14851898349c5"]}],"aliases":[],"mentions":[]}],"evidence":[{"id":"yuanzhang-q2-566e74e14851898349c5","section":"chapter-011","block":"b-fd548ae25a0f76341755","layer":"pei","quote":"﹝三﹞按《庾氏谱》：“嶷，字劭然，颍川人。子䨹，字玄默，晋尚书，阳翟子。嶷弟遁，字德先，太中大夫。遁胤嗣克昌，为世盛门。侍中峻、河南尹纯，皆遁之子。豫州牧长史（顗）〔敳〕，遁之孙。太尉、文康公亮，司空冰，皆遁之曾孙；贵达至今。”","attribution":"裴注（引书见原文）","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":579,"anchor":null},"note_id":"n-5d4403d6dae5bfdeb202","start":0,"end":114}],"profiles":{},"directory_counts":{}}
