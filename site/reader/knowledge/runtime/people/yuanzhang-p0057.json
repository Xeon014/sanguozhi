{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"yuanzhang-e-o165","title":"至十七年韩约失众从羌中还依宪，众人多欲取约徼功，宪皆责怒之，遂拥护厚遇之","time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["yuanzhang-q-3dc4240fb4d7d3a71ce0","yuanzhang-q-59647f299dec7c08b296","yuanzhang-q-bb24fbb1d150d4225c77"]},"order":2620,"participants":[{"person":"yuanzhang-p0077","role":"责怒欲取韩约徼功之众人，言人穷来归我云何欲危之，遂拥护厚遇韩约；不肯在名中，言我尚不忍生图之岂忍取死人以要功乎；被表列赐爵关内侯，名震陇右","evidence":["yuanzhang-q-3dc4240fb4d7d3a71ce0","yuanzhang-q-59647f299dec7c08b296","yuanzhang-q-bb24fbb1d150d4225c77"]},{"person":"wudi-p0048","role":"失众，从羌中还，依郭宪；病死，头被田乐等就斩","evidence":["yuanzhang-q-3dc4240fb4d7d3a71ce0","yuanzhang-q-59647f299dec7c08b296"]},{"person":"yuanzhang-p0057","role":"与阳逵等就斩韩约头当送之；送韩约首到","evidence":["yuanzhang-q-59647f299dec7c08b296","yuanzhang-q-bb24fbb1d150d4225c77"]},{"person":"yuanzhang-p0079","role":"与田乐等斩韩约头，欲条疏郭宪之名而止；送韩约首到，具以情对","evidence":["yuanzhang-q-59647f299dec7c08b296","yuanzhang-q-bb24fbb1d150d4225c77"]},{"person":"cao-cao","role":"方攻汉中在武都，宿闻宪名，及视条疏怪不在中，以问逵等，叹其志义，乃并表列与逵等，并赐爵关内侯","evidence":["yuanzhang-q-bb24fbb1d150d4225c77"]}],"accounts":[]}],"persons":[{"id":"yuanzhang-p0057","name":"田乐","evidence":["yuanzhang-q-59647f299dec7c08b296","yuanzhang-q-bb24fbb1d150d4225c77"],"facts":[],"aliases":[],"mentions":[]}],"evidence":[],"profiles":{},"directory_counts":{}}
