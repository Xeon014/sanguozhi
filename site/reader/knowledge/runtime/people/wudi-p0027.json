ng-q-952c37629d1c98147f72","yuanzhang-q-274d4eba12d683767416"]},"order":2586,"participants":[{"person":"cao-cao","role":"封田畴亭侯邑五百户，知其至心，许而不夺；追念畴功殊美，恨前听畴之让，曰是成一人之志而亏王法大制，复以前爵封畴；不听，欲引拜之，至于数四；重其事，依违者久之，乃下世子及大臣博议；犹欲侯田畴，语夏侯惇且往以情喻之，自从君所言，无告吾意；喟然知不可屈，拜田畴为议郎；表论田畴之功，称其文雅优备忠武又著，诚应宠赏以旌其美；下令昔伯成弃国夏后不夺，将欲使高尚之士优贤之主不止于一世，其听田畴所执；下令称蓨令田畴至节高尚，引身深山命召不屈，陈建攻胡蹊路开塞导送，斩蹋顿于白狼遂长驱柳城；畴恳恻前后辞赏，出入三载历年未赐，成一人之高甚违王典，宜从表封无久留吾过","evidence":["yuanzhang-q-ec6796ec42e2a9fcb9ca","yuanzhang-q-c2281ab23c16bef3e355","yuanzhang-q-fb5babf9fab2a2dc340b","yuanzhang-q-d1937f349beb241cef91","yuanzhang-q-0a8c77e13a53762c1177","yuanzhang-q-124d25ea8c111dd570b4","yuanzhang-q-ab94b740980f3d576e56","yuanzhang-q-6eebab8389812fa280c9","yuanzhang-q-066dade5e4916e1bd65f"]},{"person":"wudi-p0243","role":"自以始为君难率众遁逃志义不立，反以为利非本意，固让；从征荆州还；上疏陈诚，以死自誓，终不受；被劾狷介违道苟立小节，宜免官加刑；议其封爵宜勿夺；揣知其指，不复发言；答称负义逃窜之人蒙恩全活，岂可卖卢龙之塞以易赏禄，若必不得已请愿效死刎首于前，言未卒涕泣横流；被拜为议郎；被表论其率宗人避难于无终山、北拒卢龙、前后召而不陷挠、长驱自到陈讨胡之势、启导山谷灭乌丸之功；辞让之志被听许；被令宜从表封；所守被教评议","evidence":["yuanzhang-q-ec6796ec42e2a9fcb9ca","yuanzhang-q-c2281ab23c16bef3e355","yuanzhang-q-fb5babf9fab2a2dc340b","yuanzhang-q-d1937f349beb241cef91","yuanzhang-q-4e1eb31472fcdbebfbd9","yuanzhang-q-baae8d65d6a6a35918ca","yuanzhang-q-dbab9c0526cd06602022","yuanzhang-q-124d25ea8c111dd570b4","yuanzhang-q-ab94b740980f3d576e56","yuanzhang-q-6eebab8389812fa280c9","yuanzhang-q-066dade5e4916e1bd65f","yuanzhang-q-50130c5b3331eed81fa9"]},{"person":"wudi-p0170","role":"以田畴同于子文辞禄、申胥逃赏，宜勿夺以优其节；议薳敖逃禄传载其美，激浊世励贪夫，贤于尸禄素餐之人，故可得而小不可得而毁，至于田畴方斯近矣，免官加刑于法为重","evidence":["yuanzhang-q-4e1eb31472fcdbebfbd9","yuanzhang-q-7d634095be50cbc49ebc"]},{"person":"wudi-p0100","role":"亦以为可听；议以为君子之道或出或处期于为善而已，故匹夫守志，圣人各因而成之","evidence":["yuanzhang-q-4e1eb31472fcdbebfbd9","yuanzhang-q-952c37629d1c98147f72"]},{"person":"wudi-p0181","role":"亦以为可听；以为原思辞粟仲尼不与，子路拒牛谓之止善，虽可激清励浊犹不足多，畴虽不合大义有益推让之风，宜如世子议","evidence":["yuanzhang-q-4e1eb31472fcdbebfbd9","yuanzhang-q-274d4eba12d683767416"]},{"person":"wudi-p0027","role":"受命往喻田畴；如太祖所戒就田畴宿，临去拊其背问之；具答太祖","evidence":["yuanzhang-q