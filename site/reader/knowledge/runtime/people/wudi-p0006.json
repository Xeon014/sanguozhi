{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[],"persons":[{"id":"wudi-p0006","name":"高阳","evidence":["wudi-q-p002"],"facts":[],"aliases":[],"mentions":[{"id":"wudi-m-p002-wudi-p0006","kind":"allusion","text":"祖系或典故提及","evidence":["wudi-q-p002"]}]}],"evidence":[{"id":"wudi-q-p002","section":"chapter-001","block":"b-43620357ba73f1cfc4aa","layer":"pei","quote":"王沈《魏书》曰：“其先出于黄帝。当高阳世，陆终之子曰安，是为曹姓。周武王克殷，存先世之后，封曹侠于邾。春秋之世，与于盟会；逮至战国，为楚所灭。子孙分流，或家于沛。汉高祖之起，曹参以功封平阳侯，世袭爵土。绝而复绍，至今嫡嗣国于容城。”","attribution":"《魏书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":13,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-565d43f43b4b816d5e23","start":0,"end":116,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
