{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[],"persons":[{"id":"shaodi-p0114","name":"韩谊","evidence":["shaodi-q-o126"],"facts":[],"aliases":[],"mentions":[{"id":"shaodi-m-o126-shaodi-p0114","kind":"allusion","text":"祖系或典故提及","evidence":["shaodi-q-o126"]}]}],"evidence":[{"id":"shaodi-q-o126","section":"chapter-004","block":"b-e6a31135d2fc9ce3c4fd","layer":"original","quote":"秋八月，诏曰：“昔燕剌王谋反〖33〗，韩谊等谏而死〖34〗，汉朝显登其子。诸葛诞创造凶乱〖35〗，主簿宣隆、部曲督秦洁秉节守义〖36〗，临事固争，为诞所杀；所谓无比干之亲而受其戮者〖37〗。其以隆、洁子为骑都尉，加以赠赐；光示远近，以殊忠义。”","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":531,"anchor":null},"note_id":null,"start":0,"end":122}],"profiles":{},"directory_counts":{}}
