{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"fangji-e-01553f1a82e9c765bbf7","title":"傅玄谓裴秀：子所长者言也、所短者巧也，马氏所长者巧也、所短者言也；以子所长击彼所短则不得不屈；巧天下之微事，有所不解而难之不已其相击刺必已远矣；心乖于内口屈于外，此马氏所以不对也","time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["fangji-q-38b11a1baf2154886def"]},"order":5950,"participants":[{"person":"wudi-p0338","role":"向裴秀论说者","evidence":["fangji-q-38b11a1baf2154886def"]},{"person":"shaodi-p0104","role":"受论说者","evidence":["fangji-q-38b11a1baf2154886def"]}],"accounts":[]},{"id":"fangji-e-207ceca7cff7771b9e0d","title":"傅玄见安乡侯（曹羲）言及裴子之论，安乡侯又与裴子同；傅玄论圣人取人以神、以言、以事（颜渊、宰我子贡、冉有季路、游夏之例），虽圣人之明尽物必有所试；今马氏所欲作者国之精器、军之要用，费十寻之木、劳二人之力、不经时而是非定；难试易验之事而轻以言抑人异能，此所以多废也；君子必以考试为衡石，废衡石而不用，此美玉所以见诬为石、荆和所以抱璞而哭之","time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["fangji-q-cf27903443fc54312b03"]},"order":5951,"participants":[{"person":"wudi-p0338","role":"进言论考试者","evidence":["fangji-q-cf27903443fc54312b03"]},{"person":"shaodi-p0023","role":"听言者","evidence":["fangji-q-cf27903443fc54312b03"]}],"accounts":[]}],"persons":[{"id":"wudi-p0338","name":"傅玄","evidence":["wudi-q-p118","fangji-q-38b11a1baf2154886def","fangji-q-cf27903443fc54312b03"],"facts":[{"id":"wudi-f-p118-wudi-p0338-069af8","label":"父亲","text":"傅幹","evidence":["wudi-f-p118-wudi-p0338-069af8-q"]}],"aliases":[],"mentions":[{"id":"wudi-m-p118-wudi-p0338","kind":"mention","text":"文中提及","evidence":["wudi-q-p118"]}]}],"evidence":[],"profiles":{},"directory_counts":{}}
