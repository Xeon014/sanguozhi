{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[],"persons":[{"id":"shaodi-p0058","name":"燕太子丹","evidence":["shaodi-q-p019"],"facts":[],"aliases":[],"mentions":[{"id":"shaodi-m-p019-shaodi-p0058","kind":"allusion","text":"祖系或典故提及","evidence":["shaodi-q-p019"]}]}],"evidence":[{"id":"shaodi-q-p019","section":"chapter-004","block":"b-df60847a0d457632ff57","layer":"pei","quote":"臣松之以为：古之舍生取义者，必有理存焉。或感恩怀德，投命无悔；或利害有机，奋发以应会：诏所称聂政、介子是也。事非斯类，则陷乎妄作矣。魏之与蜀，虽为敌国；非有赵襄灭智之仇，燕丹危亡之急。且刘禅凡下之主，费祎中才之相；二人存亡，固无关于兴丧。郭修在魏，西州之男子耳。始获于蜀，既不能抗节不辱；于魏又无食禄之责，不为时主所使。而无故规规然糜身于非所，义无所加，功无所立，可谓“折柳樊圃”；其狂也且，此之谓也。","attribution":"裴松之论","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":265,"anchor":null},"note_id":"n-8cc9180077c660fd8f82","start":0,"end":201}],"profiles":{},"directory_counts":{}}
