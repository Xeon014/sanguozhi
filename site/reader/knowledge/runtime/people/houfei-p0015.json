3"]},"order":5971,"participants":[{"person":"wudi-p0170","role":"问占并追使不及者","evidence":["fangji-q-c2dffc2d33a7ff250c03"]},{"person":"houfei-p0015","role":"占梦者","evidence":["fangji-q-c2dffc2d33a7ff250c03"]},{"person":"wendi-p0016","role":"受赐玺书者","evidence":["fangji-q-c2dffc2d33a7ff250c03"]}],"accounts":[]},{"id":"fangji-e-71661979955ce0e4169f","title":"帝复问梦磨钱文欲令灭而更愈明；周宣怅然不对，重问之，对曰此自陛下家事，虽意欲尔而太后不听，是以文欲灭而明；时帝欲治弟植之罪，逼于太后，但加贬爵","time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["fangji-q-f64ccf800889bfda8e88"]},"order":5972,"participants":[{"person":"wudi-p0170","role":"问占且贬爵者","evidence":["fangji-q-f64ccf800889bfda8e88"]},{"person":"houfei-p0015","role":"占梦者","evidence":["fangji-q-f64ccf800889bfda8e88"]},{"person":"wudi-p0280","role":"受贬者","evidence":["fangji-q-f64ccf800889bfda8e88"]},{"person":"fangji-p-2f4dd5839c3612","role":"使免重罪者","evidence":["fangji-q-f64ccf800889bfda8e88"]}],"accounts":[]},{"id":"fangji-e-5c0702200da570bab376","title":"以周宣为中郎，属太史","time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["fangji-q-e8ede82ab67dd97873dd"]},"order":5973,"participants":[{"person":"houfei-p0015","role":"受任者","evidence":["fangji-q-e8ede82ab67dd97873dd"]}],"accounts":[]},{"id":"fangji-e-94817874792388e7907f","title":"尝有问周宣梦见刍狗，宣答君欲得美食耳；有顷出行果遇丰膳","time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["fangji-q-68230cbf736662afe90c"]},"order":5974,"participants":[{"person":"houfei-p0015","role":"占者","evidence":["fangji-q-68230cbf736662afe90c"]}],"accounts":[]},{"id":"fangji-e-dc04d8b930b68432f57d","title":"后又问周宣复梦见刍狗，宣曰君欲堕车折脚宜戒慎之，顷之果如宣言","time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["fangji-q-b22e44d7e929ba4ef1a4"]},"order":5975,"participants":[{"person":"houfei-p0015","role":"占者","evidence":["fangji-q-b22e44d7e929ba4ef1a4"]}],"accounts":[]},{"id":"fangji-e-ad5c4688c701778869d7","title":"后又问周宣复梦见刍狗，宣曰君家失火当善护之，俄遂火起","time":{"label":"年代未详","precision":