{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[],"persons":[{"id":"fangji-p-fbf2c8f2dd07e1","name":"阎缵（续伯）","evidence":["fangji-q-5a5a24e88c5a71b54855"],"facts":[{"id":"fangji-f-4a88ac504c67fded46dd","text":"称阎续伯，名缵。","evidence":["fangji-q-5a5a24e88c5a71b54855"]}],"mentions":[],"aliases":[]}],"evidence":[{"id":"fangji-q-5a5a24e88c5a71b54855","section":"chapter-029","block":"b-cb11c7030eacae97b983","layer":"pei","quote":"近有阎续伯者，名缵。该微通物，有良史风。为天下补缀遗脱，敢以所闻列于篇左；皆从受之于大人先哲，足以取信者，冀免虚诬之讥云尔。","attribution":"裴注","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":457,"anchor":null},"note_id":"n-66647f1ecb147317b0c6","start":0,"end":62}],"profiles":{},"directory_counts":{}}
