{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[],"persons":[{"id":"wangwei-p-446bb8cab23e49","name":"杨准（嵇绍友）","evidence":["wangwei-q-af6c07fa06cd60cca28a"],"facts":[{"id":"wangwei-f-a0594d62e214f5fb7fd5","text":"弘农人，与嵇绍同好友善。","evidence":["wangwei-q-af6c07fa06cd60cca28a"]}],"mentions":[],"aliases":[]}],"evidence":[{"id":"wangwei-q-af6c07fa06cd60cca28a","section":"chapter-021","block":"b-7ed011c9e0a470eca60c","layer":"pei","quote":"《晋诸公赞》曰：“绍与山涛子简、弘农杨准，同好友善，而绍最有忠正之情。以侍中从惠帝北伐成都王。王师败绩，百官皆走；惟绍独以身捍卫，遂死于帝侧。故累见褒崇，追赠大尉，谥曰忠穆公。”","attribution":"裴注引《晋诸公赞》","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":170,"anchor":null},"note_id":"n-70ad920837cbb5d19ddf","start":0,"end":89}],"profiles":{},"directory_counts":{}}
