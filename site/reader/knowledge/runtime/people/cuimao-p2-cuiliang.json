{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[],"persons":[{"id":"cuimao-p2-cuiliang","name":"崔谅（字士文）","evidence":["cuimao-q2-aa9a7686d798fd10f410"],"facts":[{"id":"cuimao-f2-18618439cc4066ab79d0","text":"《世语》记崔谅字士文，仕晋为尚书、大鸿胪；称其为崔琰兄孙，《冀州记》则称琰孙。","evidence":["cuimao-q2-aa9a7686d798fd10f410"]}],"aliases":[],"mentions":[]}],"evidence":[{"id":"cuimao-q2-aa9a7686d798fd10f410","section":"chapter-012","block":"b-39e216284c2e146d78d4","layer":"pei","quote":"﹝八﹞《世语》曰：“琰兄孙谅，字士文。以简素称。仕晋，为尚书、大鸿胪。”荀绰《冀州记》云“谅，即琰之孙也”。","attribution":"裴注（引书见原文）","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":105,"anchor":null},"note_id":"n-a542e19dda8e34c66d04","start":0,"end":54}],"profiles":{},"directory_counts":{}}
