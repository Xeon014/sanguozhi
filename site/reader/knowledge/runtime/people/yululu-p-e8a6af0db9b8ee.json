{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[],"persons":[{"id":"yululu-p-e8a6af0db9b8ee","name":"丁氏（拟娶张温妹者）","evidence":["yululu-q-47559182311533bc5244"],"facts":[],"mentions":[{"id":"yululu-m-0d20b0c83920bd3bd8f0","kind":"mention","text":"本篇原文记及丁氏，具体行动与称谓见引文。","evidence":["yululu-q-47559182311533bc5244"]}],"aliases":[]}],"evidence":[{"id":"yululu-q-47559182311533bc5244","section":"chapter-057","block":"b-355aed84b0ccde737459","layer":"pei","quote":"《文士传》曰：“温姊妹三人，皆有节行，为温事，已嫁者皆见录夺。其中妹先适顾承，官以许嫁丁氏。成婚有日，遂饮药而死。吴朝嘉叹，乡人图画，为之赞颂云。”","attribution":"裴注·文士传","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":304,"anchor":null},"note_id":"n-38557237fd615b1b7733","start":0,"end":74}],"profiles":{},"directory_counts":{}}
