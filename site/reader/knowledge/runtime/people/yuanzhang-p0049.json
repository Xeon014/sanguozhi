nsu-q-1ca51b0d140e75864657","rensu-q-15052c38849e1408b454","rensu-q-ea16574da6532a06aff6","rensu-q-e7f8993785013243afd6","rensu-q-be7f2fc01e7bda47b50b","rensu-q-81269195e2e1bd4e9758","rensu-q-15abe4ed9d7945c76658","rensu-q-373d48af88d61f692b37","rensu-q-9d9fafbf0bddcdcc996f","rensu-q-9073c53fa337016aa380","rensu-q-33fe4281c4d4b62dfac6","rensu-q-9638355f888a8fa9b466","rensu-q-ae567296f6d1f6d2f0b7","rensu-q-a797a72463f3ae8568a3","rensu-q-8503dd14c7a4829061bb","rensu-q-bc9c0d1213fc2086e4ca","rensu-q-69ceda0d5e42e8713c2a","rensu-q2-4fc8618d785b3745ae1d","rensu-q-af4bf5f30b8becdc2770","rensu-q-3c523bc72dce055de3aa","rensu-q-9fa21698c4e43829f7e8","rensu-q-f198eeb141df9e57fa9f","xuhuwang-q-f1b964889b5bb944699c"],"facts":[{"id":"rensu-f2-8e5e12d8d167d85efc92","text":"太和中为散骑黄门侍郎。","evidence":["rensu-q-bc9c0d1213fc2086e4ca"]},{"id":"rensu-f2-20c25ef5d79bebb2fe47","text":"《杜氏新书》记与李丰总角相善，后不善；明帝擢恕为散骑侍郎，转黄门侍郎。","evidence":["rensu-q-69ceda0d5e42e8713c2a"]},{"id":"rensu-f2-a4afa83378c40cbf53d4","text":"上疏论州郡典兵时，吕昭为镇北将军、领冀州牧。","evidence":["rensu-q2-4fc8618d785b3745ae1d"]},{"id":"rensu-f2-eddf5edc5498bf86ccdf","text":"《杜氏新书》记其与常侍李丰、吏部郎袁侃、东郡太守荀俣等友善。","evidence":["rensu-q-af4bf5f30b8becdc2770"]},{"id":"rensu-f2-c7272edad77660755c71","text":"裴松之按语引《晋书》记司马通为司隶从事，疑为恕疏所言狂悖者；通子顺封龙阳亭侯，晋初因守节不移削爵土、徙武威。","evidence":["rensu-q-3c523bc72dce055de3aa"]},{"id":"rensu-f2-99ec55e9721245d362f9","text":"出为弘农太守，转赵相，以疾去官；起家河东太守，迁淮北都督护军，复以疾去，后拜御史中丞；出为幽州刺史，加建威将军，使持节，领护乌丸校尉。","evidence":["rensu-q-9fa21698c4e43829f7e8"]},{"id":"rensu-f2-d2286aaca3a86712d678","text":"《杜氏新书》记恕弟理字务仲，二十一岁卒；弟宽字务叔，举孝廉、除郎中，四十二岁卒，删集《礼记》及《春秋左氏传》解；预字元凯，为司马宣王女婿。","evidence":["rensu-q-f198eeb141df9e57fa9f"]}],"aliases":[],"mentions":[]}],"evidence":[],"profiles":{},"directory_counts":{}}
