1a1a12d","chapter-013":"24c6e486e7f78fc4d59ff01277b36cb77ffb69c68a6a9030889fe00efe4b3d27","chapter-016":"6cfac20452f269a832b087d2e808cc4b3017944d17dca1d5b1e068ebb98d8327","chapter-018":"7a62f43c1f5dc64661b088ef0fdd48392063ef5c49001fa980aa65e766380b23","chapter-019":"a43f6648e6c9d8389d561bee9d00824665f8f06542ab2a65aac06ed8a7601c5b","chapter-020":"2ef7e28be018140e07d27d7636a9df480a5cb7ef1cb3572c314a70e0d1acd07c","chapter-050":"71faaaddb69f25a5bdd7f315f15562e867eed9e897c9bd439a99a09c435bfe91","chapter-023":"908d4e64a01e171bdb09c0a7ee5484b8743be26b7cc75f49bd8b41b7ff391ff2","chapter-024":"39be893c0040dbb3148f9447402c47fc24dcb4356360f8558243258cb85b089a","chapter-025":"f37fc365e7d07f96b5fd289119e1846fe7f0030d8b46a7195fab316badf817b7","chapter-027":"dd48b2052380e1f6b6f6ffcb4835dd99cfe70efe4a9096fa51448dbdfaa14f00","chapter-062":"7031fb8ebde1ea3c95cdedcf93218fb46f69a71a29a1d9e82361f7108436a86a","chapter-063":"3ae8edfbae98c3e86a518f7022c664ed35a0d68d5ac36b331ceb560e76b1848f","chapter-065":"13c50dd7dc9a229aef1cfb43dd231955a0b1a6359dab04c54708df93fa114e12","chapter-057":"39e3922e223fe25b811b77f14049327071298549de6ed788ba7da697f067f2e3","chapter-021":"18c02b71e8f81644cf71ffea582a8e019509de0b5e9bc11451de595fa03e2cf3","chapter-029":"6ffb35bac29d20aa512b5a734e72f98ec5729b176f1bc5d6837e673bcc00880d","chapter-030":"3e0682212c3e242d0f221308bc203bd8309851b8498b94db16383bdde5234ce1"},"events":[],"persons":[{"id":"xunyu-p0088","name":"张良","evidence":["xunyu-q-p040","xunyu-q-b-4a20b29b97b779424551","wuzhu-q-p025","xiahoucao-q-p063","dongyuan-q-p086","wgc-q0067"],"facts":[],"aliases":[],"mentions":[{"id":"xunyu-m-p040-xunyu-p0088","kind":"allusion","text":"祖系或典故提及","evidence":["xunyu-q-p040","xunyu-q-b-4a20b29b97b779424551"]},{"id":"xunyu-m-o054-xunyu-p0088","kind":"allusion","text":"祖系或典故提及","evidence":["xunyu-q-o054"]},{"id":"xunyu-m-o071-xunyu-p0088","kind":"allusion","text":"祖系或典故提及","evidence":["xunyu-q-o071"]},{"id":"xunyu-m-p058-xunyu-p0088","kind":"allusion","text":"祖系或典故提及","evidence":["xunyu-q-p058"]},{"id":"wuzhu-m-p025-xunyu-p0088","kind":"allusion","text":"祖系或典故提及","evidence":["wuzhu-q-p025"]},{"id":"xiahoucao-m-p063-xunyu-p0088","kind":"allusion","text":"祖系或典故提及","evidence":["xiahoucao-q-p063"]},{"id":"dongyuan-m-p086-xunyu-p0088","kind":"allusion","text":"祖系或典故提及","evidence":["dongyuan-q-p086"]},{"id":"wgc-m-o086-xunyu-p0088","kind":"mention","text":"本段涉及张良","evidence":["wgc-q0067"]}]}],"evidence":[{"id":"dongyuan-q-p086","section":"chapter-006","block":"b-43dc1ea8833c9c774b2c","layer":"pei","quote":"孙盛曰：“观田丰、沮授之谋，虽良、平何以过之！故君贵审才，臣尚量主。君用忠良，则伯王之业隆；臣奉暗后，则覆亡之祸至。存亡荣辱，常必由兹。丰知绍将败，败则己必死，甘冒虎口以尽忠规；烈士之于所事，虑不存己。夫诸侯之臣，义有去就，况丰与绍非纯臣乎？《诗》云‘逝将去汝，适彼乐土’，言去乱邦，就有道，可也。”","attribution":"孙盛论","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":337,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-247ea57f2666f37d6b34","start":0,"end":150,"offset_unit":"unicode_code_point"},{"id":"wgc-q0067","section":"chapter-028","block":"b-19a57525c37bf4f5767a","layer":"original","quote":"甘露二年，征诸葛诞为司空。时，会丧宁在家〖1〗，策诞必不从命，驰白文王。文王以事已施行，不复追改。﹝一﹞及诞反，车驾住项；文王至寿春，会复从行。初，吴大将全琮，孙权之婚亲重臣也〖2〗；琮子怿、孙静、从子端、翩、缉等，皆将兵来救诞。怿兄子辉、仪留建业，与其家内争讼；携其母，将部曲数十家渡江，自归文王。会建策，密为辉、仪作书，使辉、仪所亲信，赍入城告怿等，说“吴中怒怿等不能拔寿春，欲尽诛诸将家，故逃来归命”。怿等恐惧，遂将所领，开东城门出降，皆蒙封宠，城中由是乖离。寿春之破，会谋居多。亲待日隆，时人谓之子房〖3〗。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":455,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":258,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-p025","section":"chapter-047","block":"b-d87b1efc21304c189e6a","layer":"pei","quote":"﹝三﹞《魏略》载魏三公奏曰：“臣闻枝大者披心，尾大者不掉：有国有家之所慎也。昔汉承秦弊，天下新定；大国之王，臣节未尽。以萧、张之谋，不备录之，致使六王，前后反叛。已而伐之，戎车不辍。又文、景守成，忘战戢役；骄纵吴、楚，养虺成蛇，既为社稷大忧。盖前事之不忘，后事之师也。吴王孙权，幼竖小子，无尺寸之功；遭遇兵乱，因父兄之绪；少蒙翼卵煦伏之恩，长含鸱枭反逆之性；背弃天（地）〔施〕，罪恶积大。复与关羽，更相觇伺；逐利见便，挟为卑辞。先帝知权奸以求用，时以于禁败于水灾，等当讨羽，因以委权。先帝委裘下席，权不尽心诚在恻怛，欲因大丧，寡弱王室。希托董桃，传先帝令，乘未得报许，擅取襄阳；及见驱逐，乃更折节：邪辟之态，巧言如流。虽重驿累使，发遣禁等；内包隗嚣顾望之奸，外欲缓诛，支仰蜀贼。圣朝含弘，既加不忍，优而赦之，与之更始；猥乃割地王之，使南面称孤，兼官累位，礼备九命，名马百驷，以成其势：光宠显赫，古今无二。权为犬羊之姿，横被虎豹之文；不思靖力致死之节，以报无量不世之恩。臣每见所下权前后章表，又以愚意采察权旨：自以阻带江湖，负固不服；狃累世，诈伪成功。上有尉佗、英布之计，下诵伍被屈强之辞：终非不侵不叛之臣。 〔臣〕 以为晁错不发削弱五侯之谋，则七国同衡，祸久而大；蒯通不决袭历下之策，则田横自虑，罪深变重。臣谨考之《周礼》九伐之法，平权凶恶：逆节萌生，见罪十五。……昔九黎乱德，黄帝加诛；项羽罪十，汉祖不舍。权所犯罪衅明白，非仁恩所养，宇宙所容。臣请免权官，鸿胪削爵土，捕治罪。敢有不从，移兵进讨；以明国典好恶之常，以静三州元元之苦。”","attribution":"《魏略》载魏三公奏","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":342,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b4b120999ca5671458e5","start":0,"end":668,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-p063","section":"chapter-009","block":"b-a28301d33c65814e2e54","layer":"pei","quote":"《魏氏春秋》曰：“初，夏侯霸将奔蜀，呼玄欲与之俱。玄曰：‘吾岂苟存自客于寇虏乎？’遂还京师。太傅薨，许允谓玄曰：‘无复忧矣！’玄叹曰：‘士宗！卿何不见事乎？此人犹能以通家年少遇我；子元、子上，不吾容也！’玄尝著《乐毅》、《张良》及《本无肉刑论》，辞旨通远，咸传于世。玄之执也，（卫将军）〔安东将军〕司马文王流涕请之。大将军曰：‘卿忘会赵司空葬乎？’先是，司空赵俨薨，大将军兄弟会葬，宾客以百数；玄时后至，众宾客咸越席而迎，大将军由是恶之。”","attribution":"《魏氏春秋》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":622,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-31bf80f2d3548114eff9","start":0,"end":220,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-b-4a20b29b97b779424551","section":"chapter-010","block":"b-4a20b29b97b779424551","layer":"modern","quote":"〖1〗子房：即张良（？—前 186）。字子房，相传为城父（今河南郏县东）人。先世是韩国的相。秦灭韩，他结交刺客，在博浪沙（今河南原阳县东南）刺杀秦始皇，未成功。秦末随刘邦起兵，成为刘邦手下最重要的谋臣。西汉建立，以功封留侯。常称病不掌握实权，所以得到善终。传见《史记》卷五十五、《汉书》卷四十。曹操得到荀彧大为喜悦的原因，除了荀彧本人的超凡才智之外，还因为荀彧出身于当时第一流的名门大族，社会影响大，人际关系广，对曹操创业大有帮助。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":28,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-dc7a26d2e500f5d7dfe7","start":0,"end":216,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-o054","section":"chapter-010","block":"b-2e914d86b2dfa6225475","layer":"original","quote":"贾诩字文和，武威姑臧人也〖1〗。少时，人莫知；唯汉阳阎忠异之，谓诩有良、平之奇〖2〗。﹝一﹞","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":265,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":46,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-o071","section":"chapter-010","block":"b-e84405d832ca2c02884c","layer":"original","quote":"评曰：荀彧清秀通雅〖1〗，有王佐之风；然机鉴先识〖2〗，未能充其志也〖3〗。﹝一﹞荀攸、贾诩，庶乎算无遗策〖4〗，经达权变：其良、平之亚欤！﹝二﹞","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":359,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":73,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-p040","section":"chapter-010","block":"b-14f5e9220c7eca8c81ef","layer":"pei","quote":"﹝一﹞《魏书》曰：“太祖自柳城还，过攸舍，称述攸前后谋谟劳勋，曰：‘今天下事，略已定矣；孤愿与贤士大夫，共飨其劳。昔高祖使张子房自择邑三万户，今孤亦欲君自择所封焉。’”","attribution":"《魏书》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":240,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-95e4d99da29f8d2f985b","start":0,"end":84,"offset_unit":"unicode_code_point"},{"id":"xunyu-q-p058","section":"chapter-010","block":"b-5a8ba24f70527adb425a","layer":"pei","quote":"﹝二﹞臣松之以为：列传之体，以事类相从。张子房，青云之士，诚非陈平之伦；然汉之谋臣，良、平而已，若不共列，则余无所附：故前史合之，盖其宜也。魏氏如诩之俦，其比幸多。诩不编程、郭之篇，而与二荀并列，失其类矣。且攸、诩之为人，其犹夜光之与蒸烛乎！其照虽均，质则异焉。今荀、贾之评，共同一称，尤失区别之宜也。","attribution":"裴松之论","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":367,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-af566febefc07108492a","start":0,"end":151,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
