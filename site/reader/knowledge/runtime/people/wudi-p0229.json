{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[],"persons":[{"id":"wudi-p0229","name":"第五伯鱼","evidence":["wudi-q-o104"],"facts":[{"id":"wudi-f-b-47c345de40f09bd473d1-wudi-p0229-50b5b1","label":"姓名","text":"第五伦","evidence":["wudi-q-b-47c345de40f09bd473d1"]}],"aliases":[{"text":"第五伦","evidence":["wudi-q-b-47c345de40f09bd473d1"]}],"mentions":[{"id":"wudi-m-o104-wudi-p0229","kind":"allusion","text":"祖系或典故提及","evidence":["wudi-q-o104"]}]}],"evidence":[{"id":"wudi-q-b-47c345de40f09bd473d1","section":"chapter-001","block":"b-47c345de40f09bd473d1","layer":"modern","quote":"〖8〗第五伯鱼：即第五伦，东汉京兆长陵（今陕西泾阳县东南）人。传见《后汉书》卷四十一。第五是复姓。孤女：死了父亲的女子。挝（zhuā）妇翁：殴打岳父。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":587,"anchor":null},"note_id":"n-2e7a968ccc3231315e65","start":0,"end":75},{"id":"wudi-q-o104","section":"chapter-001","block":"b-8efba5dafb5dd32d0163","layer":"original","quote":"九月，令曰：“阿党比周〖4〗，先圣所疾也〖5〗。闻冀州俗：父子异部更相毁誉〖6〗。昔直不疑无兄，世人谓之盗嫂〖7〗；第五伯鱼三娶孤女，谓之挝妇翁〖8〗；王凤擅权，谷永比之申伯〖9〗；王商忠议，张匡谓之左道〖10〗。此皆以白为黑，欺天罔君者也〖11〗。吾欲整齐风俗；四者不除〖12〗，吾以为羞！”","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":576,"anchor":null},"note_id":null,"start":0,"end":147}],"profiles":{},"directory_counts":{}}
