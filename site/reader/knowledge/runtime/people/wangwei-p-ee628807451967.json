{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[],"persons":[{"id":"wangwei-p-ee628807451967","name":"傅宣","evidence":["wangwei-q-00cc864df4e436bbcabd"],"facts":[{"id":"wangwei-f-28813a6e6ee41886b62a","text":"傅祗子，字世弘，御史中丞。","evidence":["wangwei-q-00cc864df4e436bbcabd"]}],"mentions":[],"aliases":[]}],"evidence":[{"id":"wangwei-q-00cc864df4e436bbcabd","section":"chapter-021","block":"b-c3e6e22801969bbf9ec1","layer":"pei","quote":"﹝六﹞《晋诸公赞》曰：“祗字子庄，嘏少子也。晋永嘉中至司空。”祗子宣，字世弘。《世语》称：“宣以公正知名，位至御史中丞。”宣弟畅，字世道，秘书丞，没在胡中；著《晋诸公赞》及《晋公卿礼秩故事》。","attribution":"裴注引《世语》","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":557,"anchor":null},"note_id":"n-fee4c36794b2bddadb04","start":0,"end":96}],"profiles":{},"directory_counts":{}}
