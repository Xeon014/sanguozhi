0e434a265a50a","chengguo-q-f0c499a590b00f986d21","chengguo-q-996836b020be0baf88a9"]},{"id":"liuliao-m-34128e1344a030f8f925","kind":"mention","text":"本段涉及张飞","evidence":["liuliao-q-0810a1f01fa6cf08a5bf"]}]}],"evidence":[{"id":"guanzhang-e-o020a-q","section":"chapter-036","block":"b-64292fbe949346e2e2f1","layer":"original","quote":"章武元年，迁车骑将军，领司隶校尉，进封西乡侯，策曰：“朕承天序，嗣奉洪业；除残靖乱〖1〗，未烛厥理〖2〗。今寇虏作害，民被荼毒〖3〗；思汉之士，延颈鹤望。朕用怛然〖4〗，坐不安席，食不甘味；整军诰誓〖5〗，将行天罚。以君忠毅，侔踪召虎〖6〗，名宣遐迩；故特显命：高墉进爵〖7〗，兼司于京〖8〗。其诞将天威〖9〗，柔服以德〖10〗，伐叛以刑，称朕意焉。《诗》不云乎：‘匪疚匪棘〖11〗，王国来极〖12〗’；‘肇敏戎功〖13〗，用锡尔祉〖14〗’。可不勉欤！”","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":81,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":228,"offset_unit":"unicode_code_point"},{"id":"guanzhang-f0007-q","section":"chapter-036","block":"b-166bab78afcfc53d8168","layer":"original","quote":"张飞字益德","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":62,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":5,"offset_unit":"unicode_code_point"},{"id":"guanzhang-f0008-q","section":"chapter-036","block":"b-166bab78afcfc53d8168","layer":"original","quote":"涿郡人也","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":62,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":6,"end":10,"offset_unit":"unicode_code_point"},{"id":"guanzhang-q-o023","section":"chapter-036","block":"b-94888e5733cb04bbba04","layer":"original","quote":"追谥飞曰桓侯。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":84,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":7,"offset_unit":"unicode_code_point"}],"profiles":{"wudi-p0367":{"fields":[{"id":"guanzhang-f00