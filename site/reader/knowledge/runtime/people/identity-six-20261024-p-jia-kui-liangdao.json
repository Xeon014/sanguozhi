{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o200a","title":"曹操卒于洛阳","time":{"label":"建安二十五年正月庚子","year":220,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o200a-q","wudi-q-o199","wudi-q-b-14b02b05b047b9111bbf"],"chronology":"wudi-y220","dating_review":{"anchor":"wudi-q-o199","basis":"建安二十五年正月庚子","reviewed":true}},"order":444,"participants":[{"person":"cao-cao","role":"去世","evidence":["wudi-e-o200a-q"]},{"person":"identity-six-20261024-p-jia-kui-liangdao","role":"太祖崩于洛阳，典丧事；建议为不可秘，乃发哀，令内外皆入临，临讫各安叙不得动；以为方大丧在殡嗣王未立宜因而抚之，乃为作长檄，告所在，给其廪食","evidence":["liusima-q-d177a3fd8037444d8b42","liusima-q-7cd6ab34f901dab204a7","liusima-q-217ffc0766c87b5d7518"]},{"person":"wudi-p0147","role":"所部鸣鼓擅去","evidence":["lizang-q-5c248549841055834243"]},{"person":"shaodi-p0015","role":"号泣呕血","evidence":["lizang-q-54b6a464847594168c95"]}],"accounts":[]},{"id":"mingdi-e-o011a","title":"曹休石亭战陆议败绩","time":{"year":228,"label":"太和二年秋九月","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"mingdi-y228","dating_review":{"reviewed":true,"anchor":"mingdi-q-o008","basis":"太和二年秋九月"},"evidence":["mingdi-e-o011a-q","mingdi-q-o008","mingdi-q-b-76fba510250937628a99"]},"order":745,"participants":[{"person":"wendi-p0039","role":"战败","evidence":["mingdi-e-o011a-q"]},{"person":"xianzhu-p0115","role":"击败","evidence":["mingdi-e-o011a-q"]},{"person":"wuzhu-p0028","role":"左翼","evidence":["luxun-e-o028a-q"]},{"person":"shaodi-p0005","role":"右翼","evidence":["luxun-e-o028a-q"]},{"person":"shaodi-p0004","role":"力战决围救曹休","evidence":["wgc-q0154","wgc-q0003"]},{"person":"sun-quan","role":"到皖、使琮与辅国将军陆逊击曹休","evidence":["hequan-q-2afeb15e4179e2c6965f"]},{"person":"wuzhu-p0058","role":"合众随陆逊横截休","evidence":["hequan-q-9c04392ea2c13e9d3f34"]},{"person":"wendi-p0005","role":"使逵督前将军满宠、东莞太守胡质等四军，从西阳直向东关","evidence":["liusima-q-370dbbad6a87363b1da8"]},{"person":"identity-six-20261024-p-jia-kui-liangdao","role":"督满宠、胡质等四军，从西阳直向东关；至五将山，东行与休合进；度贼无东关之备，必并军于皖，休深入与贼战必败，乃部署诸将，水陆并进；行二百里，得生贼；称休兵败于外、路绝于内，安危之机不及终日；今疾进出其不意，先人以夺其心，贼见吾兵必走，若待后军贼已断险兵虽多何益；乃兼道进军，多设旗鼓为疑兵；据夹石，以兵粮给休，贼见逵军遂退，休军乃振","evidence":["liusima-q-370dbbad6a87363b1da8","liusima-q-61347dbba77a5b3a2780","liusima-q-514a28cf96f2848649c5","liusima-q-34ebc4333e41238cb1f8","liusima-q-94f46ae12716d005b862","liusima-q-60815b50b05409c75607"]},{"person":"mingdi-p0038","role":"前将军，受逵督","evidence":["liusima-q-370dbbad6a87363b1da8"]},{"person":"mingdi-p0047","role":"东莞太守，受逵督","evidence":["liusima-q-370dbbad6a87363b1da8"]},{"person":"wudi-p0364","role":"时为司马宣王，从江陵；受诏驻军","evidence":["liusima-q-370dbbad6a87363b1da8","liusima-q-61347dbba77a5b3a2780"]}],"accounts":[]},{"id":"xiahoucao-e-o043c","title":"曹丕征吴曹休督张辽等破吕范洞浦拜扬州牧","time":{"label":"曹丕即王位后至征吴","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xiahoucao-e-o043c-q"]},"order":2221,"participants":[{"person":"wudi-p0170","role":"征讨授官","evidence":["xiahoucao-e-o043c-q"]},{"person":"wendi-p0039","role":"督军","evidence":["xiahoucao-e-o043c-q"]},{"person":"wudi-p0178","role":"从征","evidence":["xiahoucao-e-o043c-q"]},{"person":"wendi-p0157","role":"被破","evidence":["xiahoucao-e-o043c-q"]},{"person":"identity-six-20261024-p-jia-kui-liangdao","role":"黄初中与诸将并征吴，破吕范于洞浦","evidence":["liusima-q-cbf91a571da81284cd5c"]},{"person":"wudi-p0147","role":"破吕范","evidence":["lizang-q-8b172e0e983dcb0c6544"]}],"accounts":[]},{"id":"chengguo-e-p107","title":"贾逵劝孙资应命署功曹","time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["chengguo-q-a2bf24c7d657ef922488"]},"order":3195,"participants":[{"person":"identity-six-20261024-p-jia-kui-liangdao","role":"劝资应命","evidence":["chengguo-q-a2bf24c7d657ef922488"]},{"person":"mingdi-p0075","role":"往署功曹","evidence":["chengguo-q-a2bf24c7d657ef922488"]}],"accounts":[]},{"id":"liusima-e-o135","title":"贾习异之，口授贾逵兵法数万言","time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liusima-q-a6d3a9c435e6287584ee"]},"order":3341,"participants":[{"person":"liusima-p0057","role":"贾逵祖父，异之，曰汝大必为将率，口授兵法数万言","evidence":["liusima-q-a6d3a9c435e6287584ee"]},{"person":"identity-six-20261024-p-jia-kui-liangdao","role":"受祖父口授兵法","evidence":["liusima-q-a6d3a9c435e6287584ee"]}],"accounts":[]},{"id":"liusima-e-o137","title":"郭援攻河东，贾逵坚守绛邑不拔","time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liusima-q-cae6bd33b89086aae2ea","liusima-q-377abab9d9a6ba100450","liusima-q-e64008b32c6e76d161a8","liusima-q-f362b3b19673ce408b56","liusima-q-ca4f3e20ef829e694a4d","liusima-q-c156a9ae16ecec81a51a"]},"order":3342,"participants":[{"person":"guanzhang-p0014","role":"攻河东，所经城邑皆下，攻绛不拔；召单于，并军急攻，城将溃；闻逵名欲使为将，以兵劫之，怒将斩之；捕得逵，怒曰促斩之，诸将覆护后乃囚于壶关，闭著土窖中，以车轮盖上，使人固守，方将杀之","evidence":["liusima-q-cae6bd33b89086aae2ea","liusima-q-377abab9d9a6ba100450","liusima-q-e64008b32c6e76d161a8","liusima-q-ca4f3e20ef829e694a4d"]},{"person":"identity-six-20261024-p-jia-kui-liangdao","role":"坚守绛邑；父老约请不害之；不为兵劫所动，叱安有国家长吏为贼叩头；被左右义请，遂得免于死；不肯拜，谓援曰王府君临郡积年，不知足下曷为者也；从窖中谓守者曰此间无健儿邪，而当使义士死此中乎","evidence":["liusima-q-cae6bd33b89086aae2ea","liusima-q-377abab9d9a6ba100450","liusima-q-e64008b32c6e76d161a8","liusima-q-f362b3b19673ce408b56","liusima-q-ca4f3e20ef829e694a4d","liusima-q-c156a9ae16ecec81a51a"]},{"person":"liusima-p0051","role":"与逵非故人，适闻其言，怜其守正危厄，乃夜盗往引出，折械遣去，不语其姓名","evidence":["liusima-q-c156a9ae16ecec81a51a"]}],"accounts":[]},{"id":"liusima-e-o138","title":"贾逵围急中使人送印绶归郡，嘱急据皮氏","time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liusima-q-e71361e6d1ca86beb479","liusima-q-dc7736b2fa87942c3e2d"]},"order":3343,"participants":[{"person":"identity-six-20261024-p-jia-kui-liangdao","role":"尝过皮氏言争地先据者胜；及围急知不免，乃使人间行送印绶归郡，且曰急据皮氏；恐援先得皮氏，以他计疑援谋人祝奥，郡从其言故得无败","evidence":["liusima-q-e71361e6d1ca86beb479","liusima-q-dc7736b2fa87942c3e2d"]},{"person":"liusima-p0052","role":"郭援谋人，遭疑","evidence":["liusima-q-dc7736b2fa87942c3e2d"]},{"person":"guanzhang-p0014","role":"并绛众后将进兵，由是留七日","evidence":["liusima-q-dc7736b2fa87942c3e2d"]}],"accounts":[]},{"id":"liusima-e-o140","title":"高幹反时张琰将举兵应之，贾逵佯与同谋以自全","time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liusima-q-b9c4047b1c9d65250923","liusima-q-4ba9cc5c0bbb5820a686"]},"order":3344,"participants":[{"person":"zhonghua-p0041","role":"将举兵应高幹之反，信逵之画计","evidence":["liusima-q-b9c4047b1c9d65250923"]},{"person":"identity-six-20261024-p-jia-kui-liangdao","role":"不知其谋往见琰，闻变起欲还恐见执，乃为琰画计，如与同谋者；县寄治蠡城、城堑不固，从琰求兵修城；诸欲为乱者皆不隐其谋，故得尽诛之，遂修城拒琰","evidence":["liusima-q-b9c4047b1c9d65250923","liusima-q-4ba9cc5c0bbb5820a686"]},{"person":"wudi-p0235","role":"反","evidence":["liusima-q-b9c4047b1c9d65250923"]}],"accounts":[]},{"id":"liusima-e-o236","title":"孙资举河东计吏到许，荐贾逵于相府","time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liusima-q-117b8173f3ad115d8e42"]},"order":3345,"participants":[{"person":"mingdi-p0075","role":"举河东计吏，到许，荐于相府称逵在绛邑帅厉吏民，与贼郭援交战，力尽而败，为贼所俘；挺然直志，颜辞不屈，忠言闻于大众，烈节显于当时，虽古之直发据鼎罔以加也，其才兼文武，诚时之利用","evidence":["liusima-q-117b8173f3ad115d8e42"]},{"person":"identity-six-20261024-p-jia-kui-liangdao","role":"被荐","evidence":["liusima-q-117b8173f3ad115d8e42"]}],"accounts":[]},{"id":"liusima-e-o237","title":"祝公道坐他事当伏法，贾逵救之不能解，为之改服","time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liusima-q-108ce8dfd48235530aa7"]},"order":3346,"participants":[{"person":"identity-six-20261024-p-jia-kui-liangdao","role":"郭援破后乃知前出己者为祝公道；公道坐他事当伏法，救之力不能解，为之改服","evidence":["liusima-q-108ce8dfd48235530aa7"]},{"person":"liusima-p0051","role":"坐他事当伏法","evidence":["liusima-q-108ce8dfd48235530aa7"]}],"accounts":[]},{"id":"liusima-e-o143","title":"太祖征马超至弘农，以贾逵领弘农太守","time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liusima-q-772fc55ac24959c8e559"]},"order":3347,"participants":[{"person":"cao-cao","role":"征马超至弘农，称此西道之要，以逵领弘农太守，召见计事大悦之，谓左右使天下二千石悉如贾逵，吾何忧","evidence":["liusima-q-772fc55ac24959c8e559"]},{"person":"identity-six-20261024-p-jia-kui-liangdao","role":"领弘农太守","evidence":["liusima-q-772fc55ac24959c8e559"]},{"person":"wudi-p0282","role":"被征","evidence":["liusima-q-772fc55ac24959c8e559"]}],"accounts":[]},{"id":"liusima-e-o144","title":"贾逵收屯田都尉挝折其脚，坐免","time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liusima-q-6a5786ce575dfdf94eb8"]},"order":3348,"participants":[{"person":"identity-six-20261024-p-jia-kui-liangdao","role":"疑屯田都尉藏亡民，都尉自以不属郡言语不顺，逵怒收之，数以罪，挝折脚，坐免","evidence":["liusima-q-6a5786ce575dfdf94eb8"]}],"accounts":[]},{"id":"liusima-e-o146","title":"太祖征刘备，先遣贾逵至斜谷观形势","time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liusima-q-53c05d503255ce8ca427","liusima-q-f5f11911bbd019e50d22","liusima-q-42addb5248dcc8d4a6d7"]},"order":3349,"participants":[{"person":"cao-cao","role":"征刘备，先遣逵至斜谷观形势；善之，拜逵谏议大夫","evidence":["liusima-q-53c05d503255ce8ca427","liusima-q-42addb5248dcc8d4a6d7"]},{"person":"identity-six-20261024-p-jia-kui-liangdao","role":"奉遣观形势；道逢水衡载囚人数十车，以军事急，辄竟重者一人，皆放其余；拜谏议大夫，与夏侯尚并掌军计","evidence":["liusima-q-53c05d503255ce8ca427","liusima-q-f5f11911bbd019e50d22","liusima-q-42addb5248dcc8d4a6d7"]},{"person":"liu-bei","role":"被征","evidence":["liusima-q-53c05d503255ce8ca427"]},{"person":"mingdi-p0063","role":"与逵并掌军计","evidence":["liusima-q-42addb5248dcc8d4a6d7"]}],"accounts":[]},{"id":"liusima-e-o148","title":"鄢陵侯曹彰问先王玺绶所在，贾逵正色拒之","time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liusima-q-0804408fc2f2a2c04cce","liusima-q-b7e69e3585eae9352e51"]},"order":3350,"participants":[{"person":"wudi-p0380","role":"鄢陵侯，行越骑将军，从长安来赴，问逵先王玺绶所在","evidence":["liusima-q-0804408fc2f2a2c04cce"]},{"person":"identity-six-20261024-p-jia-kui-liangdao","role":"正色曰太子在邺，国有储副，先王玺绶非君侯所宜问也；奉梓宫还邺","evidence":["liusima-q-0804408fc2f2a2c04cce","liusima-q-b7e69e3585eae9352e51"]}],"accounts":[]},{"id":"liusima-e-o238","title":"太祖教有谏者死，贾逵建谏草与三主簿署名入白","time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liusima-q-600ace6f2a26186a1001","liusima-q-b4781ea5ee1b29f2fdd3","liusima-q-3221b78ef2c716299918"]},"order":3351,"participants":[{"person":"cao-cao","role":"欲征吴而大霖雨，三军多不愿行，恐外有谏者，教曰今孤戒严未知所之，有谏者死；怒，收逵等，当送狱取造意者；果遣家中人就狱视逵，既而教曰逵无恶意，原复其职","evidence":["liusima-q-600ace6f2a26186a1001","liusima-q-b4781ea5ee1b29f2fdd3","liusima-q-3221b78ef2c716299918"]},{"person":"identity-six-20261024-p-jia-kui-liangdao","role":"受教，谓同僚三主簿今实不可出而教如此，不可不谏，乃建谏草以示三人；即言我造意，遂走诣狱；谓狱吏曰促械我，尊者且疑我在近职求缓于卿，今将遣人来察我；著械适讫","evidence":["liusima-q-600ace6f2a26186a1001","liusima-q-b4781ea5ee1b29f2fdd3","liusima-q-3221b78ef2c716299918"]}],"accounts":[]},{"id":"liusima-e-o239","title":"贾逵请医割瘿，曹操恐其不活；逵犹行其意，而瘿愈大","time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liusima-q-3098976728e386fdaba4"]},"order":3352,"participants":[{"person":"identity-six-20261024-p-jia-kui-liangdao","role":"与典农校尉争公事不得理，乃发愤生瘿，后所病稍大，自启愿欲令医割之；犹行其意，而瘿愈大","evidence":["liusima-q-3098976728e386fdaba4"]},{"person":"cao-cao","role":"惜逵忠，恐其不活，教谢主簿吾闻十人割瘿九人死","evidence":["liusima-q-3098976728e386fdaba4"]}],"accounts":[]},{"id":"liusima-e-o152","title":"贾逵坐人为罪，王引叔向十世宥之之典宥之","time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liusima-q-568cc210ed108ab67691"]},"order":3353,"participants":[{"person":"wudi-p0170","role":"称叔向犹十世宥之，况逵功德亲在其身乎","evidence":["liusima-q-568cc210ed108ab67691"]},{"person":"identity-six-20261024-p-jia-kui-liangdao","role":"尝坐人为罪，得王宥","evidence":["liusima-q-568cc210ed108ab67691"]}],"accounts":[]},{"id":"liusima-e-o153","title":"贾逵从至黎阳，斩乱行之津渡者，津渡乃整","time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liusima-q-699794044af83ac79bf9"]},"order":3354,"participants":[{"person":"identity-six-20261024-p-jia-kui-liangdao","role":"从王至黎阳，津渡者乱行，斩之，乃整","evidence":["liusima-q-699794044af83ac79bf9"]}],"accounts":[]},{"id":"liusima-e-o154","title":"至谯，以贾逵为豫州刺史","time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liusima-q-3394f3367f6947bb46e5"]},"order":3355,"participants":[{"person":"wudi-p0170","role":"至谯，以逵为豫州刺史","evidence":["liusima-q-3394f3367f6947bb46e5"]},{"person":"identity-six-20261024-p-jia-kui-liangdao","role":"为豫州刺史","evidence":["liusima-q-3394f3367f6947bb46e5"]}],"accounts":[]},{"id":"liusima-e-o155","title":"贾逵论州职当督察，今长吏慢法州不能不纠","time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liusima-q-5ecfcbab4e6dbb1bd5ff","liusima-q-1d1b5f62a5353c009a6a","liusima-q-54caacbcd2021f7c71af","liusima-q-70b710d7e47b5684e217"]},"order":3356,"participants":[{"person":"identity-six-20261024-p-jia-kui-liangdao","role":"以为州本以御史出监诸郡，以六条诏书察长吏、二千石以下，故其状皆言严能鹰扬有督察之才，不言安静宽仁有恺悌之德；今长吏慢法，盗贼公行，州知而不纠，天下复何取正乎；到官数月乃还其假，考竟之；举奏免阿纵不如法之二千石以下；受褒，赐爵关内侯","evidence":["liusima-q-5ecfcbab4e6dbb1bd5ff","liusima-q-1d1b5f62a5353c009a6a","liusima-q-54caacbcd2021f7c71af","liusima-q-70b710d7e47b5684e217"]},{"person":"wudi-p0170","role":"称逵真刺史矣，布告天下，当以豫州为法，赐爵关内侯","evidence":["liusima-q-70b710d7e47b5684e217"]}],"accounts":[]},{"id":"liusima-e-o156","title":"贾逵明斥候缮甲兵为守战之备，贼不敢犯","time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liusima-q-6d9fbfb141f8afe5574f"]},"order":3357,"participants":[{"person":"identity-six-20261024-p-jia-kui-liangdao","role":"州南与吴接，明斥候，缮甲兵，为守战之备，贼不敢犯；外修军旅，内治民事","evidence":["liusima-q-6d9fbfb141f8afe5574f"]}],"accounts":[]},{"id":"liusima-e-o157","title":"贾逵遏鄢、汝造新陂","time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liusima-q-fa889dbaba286461b81d","liusima-q-cb128bbf07c28d4c3f40","liusima-q-3e5393be892a573d83da"]},"order":3358,"participants":[{"person":"identity-six-20261024-p-jia-kui-liangdao","role":"遏鄢、汝，造新陂；断山溜长溪水，造小弋阳陂；又通运渠二百余里，所谓贾侯渠者也","evidence":["liusima-q-fa889dbaba286461b81d","liusima-q-cb128bbf07c28d4c3f40","liusima-q-3e5393be892a573d83da"]}],"accounts":[]},{"id":"liusima-e-o242","title":"魏郡官属当门谒贾逵于车下，逵抵掌令诣治所","time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liusima-q-9f9817b5063c5f8bdda4"]},"order":3359,"participants":[{"person":"identity-six-20261024-p-jia-kui-liangdao","role":"抵掌曰诣治所，何宜如是","evidence":["liusima-q-9f9817b5063c5f8bdda4"]}],"accounts":[]},{"id":"liusima-e-o243","title":"贾逵进言臣守天门出入六年，唯殿下为兆民计","time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liusima-q-7b7c1ddf4275a598dab4"]},"order":3360,"participants":[{"person":"identity-six-20261024-p-jia-kui-liangdao","role":"进曰臣守天门，出入六年；天门始开，而臣在外；唯殿下为兆民计，无违天人之望","evidence":["liusima-q-7b7c1ddf4275a598dab4"]}],"accounts":[]},{"id":"liusima-e-o162","title":"贾逵建言开直道临江，移屯潦口陈攻取之计，帝善之","time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liusima-q-bdb3be8306a5a2d15c22"]},"order":3361,"participants":[{"person":"identity-six-20261024-p-jia-kui-liangdao","role":"以为宜开直道临江，若权自守则二方无救，二方无救则东关可取；乃移屯潦口，陈攻取之计","evidence":["liusima-q-bdb3be8306a5a2d15c22"]},{"person":"wendi-p0005","role":"善之","evidence":["liusima-q-bdb3be8306a5a2d15c22"]}],"accounts":[]},{"id":"liusima-e-o170","title":"黄初中文帝欲假逵节，休言逵性刚不可为督，帝乃止","time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liusima-q-5c30dae85799689e8910"]},"order":3363,"participants":[{"person":"wendi-p0039","role":"与逵不善，称逵性刚，素侮易诸将，不可为督","evidence":["liusima-q-5c30dae85799689e8910"]},{"person":"wudi-p0170","role":"欲假逵节，闻休言乃止","evidence":["liusima-q-5c30dae85799689e8910"]},{"person":"identity-six-20261024-p-jia-kui-liangdao","role":"欲受假节而止","evidence":["liusima-q-5c30dae85799689e8910"]}],"accounts":[]},{"id":"liusima-e-o171","title":"贾逵病笃遗言薄丧，薨，谥曰肃侯","time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liusima-q-56a12ba290cc5160a587"]},"order":3364,"participants":[{"person":"identity-six-20261024-p-jia-kui-liangdao","role":"病笃，谓左右受国厚恩，恨不斩孙权以下见先帝，丧事一不得有所修作；薨，谥曰肃侯","evidence":["liusima-q-56a12ba290cc5160a587"]}],"accounts":[]},{"id":"liusima-e-o173","title":"豫州吏民追思贾逵，为刻石立祠","time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liusima-q-f3338bea7f753a8b9e76"]},"order":3365,"participants":[{"person":"identity-six-20261024-p-jia-kui-liangdao","role":"身后被追思立祠","evidence":["liusima-q-f3338bea7f753a8b9e76"]}],"accounts":[]},{"id":"liusima-e-o174","title":"青龙中帝东征，乘辇入贾逵祠，诏褒其死而不朽","time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liusima-q-8190229621ded6d81206"]},"order":3366,"participants":[{"person":"wendi-p0005","role":"东征，乘辇入逵祠，诏曰昨过项见贾逵碑像念之怆然，古人患名之不立不患年之不长，逵存有忠勋没而见思，可谓死而不朽者矣，布告天下以劝将来","evidence":["liusima-q-8190229621ded6d81206"]},{"person":"identity-six-20261024-p-jia-kui-liangdao","role":"被诏褒死而不朽","evidence":["liusima-q-8190229621ded6d81206"]}],"accounts":[]},{"id":"liusima-e-o244","title":"曹休怨逵进迟，敕豫州刺史往拾弃杖，逵拒之","time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liusima-q-eaa106a760e59083ccab","liusima-q-c995fdc35aab04bfd8a1","liusima-q-2d8149e59602d5d5eced"]},"order":3367,"participants":[{"person":"wendi-p0039","role":"怨逵进迟，乃呵责逵，遂使主者敕豫州刺史往拾弃杖；与逵更相表奏；犹挟前意，欲以后期罪逵","evidence":["liusima-q-eaa106a760e59083ccab","liusima-q-c995fdc35aab04bfd8a1","liusima-q-2d8149e59602d5d5eced"]},{"person":"identity-six-20261024-p-jia-kui-liangdao","role":"恃心直，谓休曰本为国家做豫州刺史，不来相为拾弃杖也；引军还，遂与休更相表奏；终无言，时人益以此多之","evidence":["liusima-q-eaa106a760e59083ccab","liusima-q-c995fdc35aab04bfd8a1","liusima-q-2d8149e59602d5d5eced"]}],"accounts":[]},{"id":"liusima-e-o245","title":"甘露二年车驾东征屯项，复入贾逵祠下，诏修祠堂","time":{"label":"甘露二年","precision":"undated","basis":"原文明示纪年。","evidence":["liusima-q2-160606d09928bf1a4d60"]},"order":3368,"participants":[{"person":"shaodi-p0068","role":"甘露二年车驾东征屯项，复入逵祠下，诏曰逵没有遗爱，历世见祠，追闻风烈朕甚嘉之；昔先帝东征亦幸于此，亲发德音褒扬逵美；其扫除祠堂，有穿漏者补治之","evidence":["liusima-q-50d03c1241902567c3a3"]},{"