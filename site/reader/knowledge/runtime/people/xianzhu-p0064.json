8de1d6d3dd403d1","liuliao-q-247aa16b17cb71d0c513","liuliao-q-f614c7ec3598ca418de3","liuliao-q-39819a07158711985dc5","liuliao-q-f473a6f7cdb981bbf2a6","liuliao-q-4c8e1c06b65a4c4df7ca","liuliao-q-1abf03ff9d9e4599676d"],"facts":[],"aliases":[],"mentions":[{"id":"xianzhu-m-o043-xianzhu-p0064","kind":"mention","text":"文中提及","evidence":["xianzhu-q-o043"]},{"id":"liuliao-m-dc074672ab63869708f7","kind":"mention","text":"本段涉及彭羕","evidence":["liuliao-q-d9665bbb91f9df502fd4","liuliao-q-325e45e613fe050212ff","liuliao-q-786cd608654a686a0b2e"]}]}],"evidence":[{"id":"liuliao-q-20caedd4a9cadd6c705a","section":"chapter-040","block":"b-62685cfcf25eb40f88cd","layer":"original","quote":"彭羕字永年，广汉人。身长八尺，容貌甚伟。姿性骄傲，多所轻忽；惟敬同郡秦子敕〖1〗，荐之于太守许靖曰：“昔高宗梦傅说〖2〗，周文求吕尚〖3〗；爰及汉祖，纳食其于布衣〖4〗。此乃帝王之所以倡业垂统〖5〗，缉熙厥功也〖6〗。今明府稽古皇极〖7〗，允执神灵〖8〗；体公刘之德〖9〗，行勿践之惠〖10〗；《清庙》之作于是乎始〖11〗，褒贬之义于是乎兴。然而六翮未之备也〖12〗。伏见处士绵竹秦宓：膺山甫之德〖13〗，履隽生之直〖14〗；枕石漱流，吟咏缊袍〖15〗；偃息于仁义之途〖16〗，恬淡于浩然之域；高概节行，守真不亏。虽古人潜遁，蔑以加旃〖17〗！若明府能招致此人，必有忠谠落落之誉〖18〗，丰功厚利，建迹（之）〔立〕勋；然后纪功于王府，飞声于来世。不亦美哉！”","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":80,"anchor":null},"note_id":null,"start":0,"end":329}],"profiles":{"xianzhu-p0064":{"fields":[{"id":"xianzhu-p0064-directory-courtesy","key":"courtesy","label":"字","text":"永年","evidence":["liuliao-q-20caedd4a9cadd6c705a"]}],"directory":{"faction":"shu"}}},"directory_counts":{}}
