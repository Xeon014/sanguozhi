{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[],"persons":[{"id":"fangji-p-42506cb823160b","name":"陈承祐","evidence":["fangji-q-147d255d572e6de6a5ac"],"facts":[{"id":"fangji-f-e8bddb9b600f090975c5","text":"前长广太守，口受华长骏语；底本本段作前长广太守。","evidence":["fangji-q-147d255d572e6de6a5ac"]}],"mentions":[],"aliases":[]}],"evidence":[{"id":"fangji-q-147d255d572e6de6a5ac","section":"chapter-029","block":"b-243e12866cecb18a945d","layer":"pei","quote":"前长广太守陈承祐，口受城门校尉华长骏语云：“昔其父为清河太守时，召辂作吏；骏与少小，后以乡里，遂加恩意。常与同载周旋，具知其事。云诸要验，三倍于传。辰既短才，又年悬小，又多在田舍，故益不详。辰仕宦至州主簿、部从事，太康之初，物故。”","attribution":"裴注","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":460,"anchor":null},"note_id":"n-66647f1ecb147317b0c6","start":0,"end":116}],"profiles":{},"directory_counts":{}}
