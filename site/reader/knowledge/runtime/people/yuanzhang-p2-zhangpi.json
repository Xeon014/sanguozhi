{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[],"persons":[{"id":"yuanzhang-p2-zhangpi","name":"张貔（字邵虎）","evidence":["yuanzhang-q2-199dfd17d85855abcfb6"],"facts":[{"id":"yuanzhang-f2-f43f7c483d175d165d45","text":"《冀州记》记张貔字邵虎，钜鹿人；祖父张泰字伯阳，父张邈字叔辽、辽东太守。","evidence":["yuanzhang-q2-199dfd17d85855abcfb6"]}],"aliases":[],"mentions":[]}],"evidence":[{"id":"yuanzhang-q2-199dfd17d85855abcfb6","section":"chapter-011","block":"b-9e68f6cea8eb98a29337","layer":"pei","quote":"﹝一﹞荀绰《冀州记》曰：“钜鹿张貔，字邵虎。祖父泰，宇伯阳，有名于魏。父邈，字叔辽，辽东太守。著《自然好学论》，在《嵇康集》。为人弘深，有远识，恢恢然，使求之者莫之能测也。宦历二（官）〔宫〕，元康初为城阳太守，未行而卒。”","attribution":"裴注（引书见原文）","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":347,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f6f54ac68e70c441ea66","start":0,"end":111,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
