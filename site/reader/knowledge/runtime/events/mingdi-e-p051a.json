{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"mingdi-e-p051a","title":"司马懿向曹叡判断公孙渊计谋与行军期程","accounts":[{"id":"mingdi-e-p051a-account","label":"裴注·干宝晋纪","text":"司马懿向曹叡判断公孙渊计谋与行军期程","evidence":["mingdi-e-p051a-q"]}],"participants":[{"person":"wudi-p0364","role":"谋议","evidence":["mingdi-e-p051a-q"]},{"person":"wendi-p0005","role":"询策","evidence":["mingdi-e-p051a-q"]}],"place":null,"time":{"year":238,"label":"景初二年出征辽东前","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"mingdi-y238","dating_review":{"reviewed":true,"anchor":"mingdi-q-o059","basis":"景初二年出征辽东前"},"evidence":["mingdi-e-p051a-q","mingdi-q-o059","mingdi-q-b-78ee587f18f11aa30bd9"]},"ordering_evidence":"mingdi-e-p051a-q","source_order":[3,453,"P051a"],"order":947}],"persons":[{"id":"wendi-p0005","name":"曹叡","facts":[],"aliases":[]},{"id":"wudi-p0364","name":"司马懿","facts":[],"aliases":[]}],"evidence":[{"id":"mingdi-e-p051a-q","section":"chapter-003","block":"b-472ebd0dc2349e9b44bb","layer":"pei","quote":"﹝一﹞干宝《晋纪》曰：“帝问宣王：‘公孙渊将何计以待君？’宣王对曰：‘渊弃城预走，上计也；据辽水拒大军，其次也；坐守襄平，此为成擒耳。’帝曰：‘然则三者何出？’对曰：‘唯明智审量彼我，乃预有所割弃；此既非渊所及，又谓今往悬远，不能持久；必先拒辽水，后守也。’帝曰：‘往还几日？’对曰：‘往百日，攻百日，还百日，以六十日为休息；如此，一年足矣。’”","attribution":"裴注·干宝晋纪","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":452,"anchor":null},"note_id":"n-ae808f022b9e739ca93c","start":0,"end":173},{"id":"mingdi-q-b-78ee587f18f11aa30bd9","section":"chapter-003","block":"b-78ee587f18f11aa30bd9","layer":"modern","quote":"〖1〗二年：景初二年（公元 238 ）。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":438,"anchor":null},"note_id":"n-917b5dc4aecce5a0dcf4","start":0,"end":20},{"id":"mingdi-q-o059","section":"chapter-003","block":"b-5790b2efe14805978c50","layer":"original","quote":"二年春正月〖1〗，诏太尉司马宣王。率众讨辽东。﹝一﹞","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":434,"anchor":null},"note_id":null,"start":0,"end":26}],"profil