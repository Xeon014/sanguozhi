{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"pangfa-e-p009b","title":"法真省父论胡广有公卿量","accounts":[{"id":"pangfa-e-p009b-account","label":"《三辅决录注》","text":"《三辅决录注》记法真弱冠省父，在正旦朝会后论胡广有公卿之量。","evidence":["pangfa-e-p009b-q"]}],"participants":[{"person":"pangfa-p0013","role":"省父品评","evidence":["pangfa-e-p009b-q"]}],"place":null,"time":{"label":"弱冠省父时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["pangfa-e-p009b-q"]},"ordering_evidence":"pangfa-e-p009b-q","source_order":[37,79,"P009b"],"order":6985}],"persons":[{"id":"pangfa-p0013","name":"法真","facts":[],"aliases":[]}],"evidence":[{"id":"pangfa-e-p009b-q","section":"chapter-037","block":"b-d65b94ad659c2320b1d7","layer":"pei","quote":"初，真年来弱冠，父在南郡；步往候父，已，欲去；父留之待正旦，使观朝吏会。会者数百人，真于窗中窥其与父语。毕，问真：‘孰贤？’真曰：‘曹掾胡广，有公卿之量。’其后广果历九卿、三公之位，世以服真之知人。","attribution":"《三辅决录注》","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":78,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ab97bd1f282ddc439643","start":131,"end":230,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
