{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"mingdi-e-p048a","title":"徙长安钟虡等承露盘折铜人留霸城","accounts":[{"id":"mingdi-e-p048a-account","label":"裴注·魏略","text":"徙长安钟虡等承露盘折铜人留霸城","evidence":["mingdi-e-p048a-q"]},{"id":"mingdi-a-p049-alternative","label":"裴注·汉晋春秋","text":"《汉晋春秋》另称盘折声闻数十里、金狄泣而留霸城。","evidence":["mingdi-q-p049-alternative"]}],"participants":[],"place":null,"time":{"year":237,"label":"是岁","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"mingdi-y237","dating_review":{"reviewed":true,"anchor":"mingdi-q-o052","basis":"是岁"},"evidence":["mingdi-e-p048a-q","mingdi-q-o052","mingdi-q-o059","mingdi-q-b-78ee587f18f11aa30bd9"]},"ordering_evidence":"mingdi-e-p048a-q","source_order":[3,432,"P048a"],"order":934}],"persons":[],"evidence":[{"id":"mingdi-e-p048a-q","section":"chapter-003","block":"b-c8ead06e3f56aa40c7ea","layer":"pei","quote":"是岁，徙长安诸钟虡、骆驼、铜人、承露盘。盘折；铜人重不可致，留于霸城。","attribution":"裴注·魏略","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":431,"anchor":null},"note_id":"n-5284662e7e6a68b26074","start":10,"end":45},{"id":"mingdi-q-b-78ee587f18f11aa30bd9","section":"chapter-003","block":"b-78ee587f18f11aa30bd9","layer":"modern","quote":"〖1〗二年：景初二年（公元 238 ）。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":438,"anchor":null},"note_id":"n-917b5dc4aecce5a0dcf4","start":0,"end":20},{"id":"mingdi-q-o052","section":"chapter-003","block":"b-26b7ecd6c3ecce777040","layer":"original","quote":"景初元年春（正）〔二〕月，壬辰〖1〗，山茌县言黄龙现〖2〗。﹝一﹞于是有司奏，以为魏得地统〖3〗，宜以建丑之月为正〖4〗。三月，定历改年为孟夏四月；﹝二﹞服色尚黄〖5〗；牺牲用白〖6〗；戎事乘黑首白马〖7〗，建大赤之旂〖8〗；朝会，建大白之旗。﹝三﹞改太和历曰景初历〖9〗：其春夏秋冬孟仲季月，虽与正岁不同〖10〗，至于郊祀、迎气、礿祠、蒸尝、巡狩、蒐田、分至启闭、班宣时令、中气早晚、敬授民事〖11〗，皆以正岁斗建为历数之序〖12〗。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":363,"anchor":null},"note_id":null,"start":0,"end":218},{"id":"mingdi-q-o059","section":"chapter-003","block":"b-5790b2efe14805978c50","layer":"original","quote":"二年春正月〖1〗，诏太尉司马宣王。率众讨辽东。﹝一﹞","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":434,"anchor":null},"note_id":null,"start":0,"end":26},{"id":"mingdi-q-p049-alternative","section":"chapter-003","block":"b-ed2474ff8b85a39d2e0b","layer":"pei","quote":"《汉晋春秋》曰：“帝徙盘，盘折，声闻数十里；金狄或泣，因留霸城。”","attribution":"裴注·汉晋春秋","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":432,"anchor":null},"note_id":"n-5284662e7e6a68b26074","start":0,"end":33}],"profiles":{},"directory_counts":{}}
