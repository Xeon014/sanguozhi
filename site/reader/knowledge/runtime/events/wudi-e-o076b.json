{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o076b","title":"关羽离曹归刘备","accounts":[{"id":"wudi-e-o076b-account","label":"正文","text":"关羽离开曹军，回到刘备身边。","evidence":["wudi-e-o076b-q"]},{"id":"xianzhu-e-o020b-account","label":"《先主传》正文","text":"正文简记关羽离曹归刘备。","evidence":["xianzhu-e-o020b-q"]},{"id":"guanzhang-e-o004b-account","label":"《关张马黄赵传第六》正文","text":"关羽封赐告辞奔刘备曹操止追","evidence":["guanzhang-e-o004b-q"]},{"id":"guanzhang-a-p004-judgment","label":"裴松之论","text":"裴松之称曹操不追以成关羽之义，具有王霸之度。","evidence":["guanzhang-q-p004-judgment"]}],"participants":[{"person":"wudi-p0172","role":"离曹归刘","evidence":["wudi-e-o076b-q"]},{"person":"liu-bei","role":"被投归","evidence":["wudi-e-o076b-q"]},{"person":"cao-cao","role":"止追","evidence":["guanzhang-e-o004b-q"]}],"place":null,"time":{"label":"建安五年","year":200,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o076b-q","wudi-q-o071","wudi-q-b-9900125064e5d85f08ad"],"chronology":"wudi-y200","dating_review":{"anchor":"wudi-q-o071","basis":"建安五年","reviewed":true}},"source_order":[1,414,"O076b"],"order":181}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"wudi-p0172","name":"关羽","facts":[],"aliases":[]}],"evidence":[{"id":"guanzhang-e-o004b-q","section":"chapter-036","block":"b-059db639660483f35247","layer":"original","quote":"及羽杀颜良，曹公知其必去，重加赏赐。羽尽封其所赐〖4〗，拜书告辞；而奔先主于袁军〖5〗。左右欲追之，曹公曰：“彼各为其主，勿追也。”","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":10,"anchor":null},"note_id":null,"start":113,"end":179},{"id":"guanzhang-q-p004-judgment","section":"chapter-036","block":"b-708a7eecb16f8458148b","layer":"pei","quote":"﹝三﹞臣松之以为：曹公知羽不留而心嘉其志，去不遣追以成其义；自非有王霸之度，孰能至于此乎？斯实曹公之休美。","attribution":"裴松之论","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":20,"anchor":null},"note_id":"n-6e73f5847b36d206348b","start":0,"end"