{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xunyu-e-p009a","title":"荀彧拒为才行薄族人求议郎","accounts":[{"id":"xunyu-e-p009a-account","label":"《典略》","text":"有人请荀彧为群从求议郎，荀彧称官以表才而拒。","evidence":["xunyu-e-p009a-q"]}],"participants":[{"person":"wudi-p0100","role":"拒私请","evidence":["xunyu-e-p009a-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xunyu-e-p009a-q"]},"ordering_evidence":"xunyu-e-p009a-q","source_order":[10,78,"P009a"],"order":2410}],"persons":[{"id":"wudi-p0100","name":"荀彧","facts":[],"aliases":[]}],"evidence":[{"id":"xunyu-e-p009a-q","section":"chapter-010","block":"b-39d116e8d783a932d88c","layer":"pei","quote":"﹝一﹞《典略》曰：“彧，折节下士，坐不累席。其在台阁，不以私欲挠意。彧有群从一人，才行实薄。或谓彧：‘以君当事，不可不以某为议郎邪？’彧笑曰：‘官者，所以表才也。若如来言，众人其谓我何邪？’其持心平正，皆类此。”","attribution":"《典略》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":77,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a2cf53c156ccbdfd2e4b","start":0,"end":106,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
