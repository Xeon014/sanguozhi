{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-p019a","title":"刘备在荆州感叹髀肉复生","accounts":[{"id":"xianzhu-e-p019a-account","label":"《九州春秋》","text":"《九州春秋》记刘备在刘表席间见髀肉复生，因年老而功业未建流泪。","evidence":["xianzhu-e-p019a-q"]}],"participants":[{"person":"liu-bei","role":"感叹","evidence":["xianzhu-e-p019a-q"]},{"person":"liu-biao","role":"询问","evidence":["xianzhu-e-p019a-q"]}],"place":{"text":"荆州","evidence":["xianzhu-e-p019a-q"]},"time":{"label":"住荆州数年后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xianzhu-e-p019a-q"]},"source_order":[32,107,"P019a"],"order":6528}],"persons":[{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"liu-biao","name":"刘表","facts":[],"aliases":[]}],"evidence":[{"id":"xianzhu-e-p019a-q","section":"chapter-032","block":"b-9712ba6ad60f4913b802","layer":"pei","quote":"《九州春秋》曰：“备住荆州数年。尝于表坐，起至厕；见髀里肉生，慨然流涕。还坐，表怪问备。备曰：‘（吾）〔平〕常身不离鞍，髀肉皆消；今不复骑，髀里肉生。日月若驰，老将至矣！而功业不建，是以悲耳！’”","attribution":"《九州春秋》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":106,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-e77161c4472b3e98758e","start":3,"end":101,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
