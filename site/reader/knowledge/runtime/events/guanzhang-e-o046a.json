{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"guanzhang-e-o046a","title":"赵云卒","accounts":[{"id":"guanzhang-e-o046a-account","label":"《关张马黄赵传第六》正文","text":"赵云卒","evidence":["guanzhang-e-o046a-q"]}],"participants":[{"person":"xianzhu-p0034","role":"卒","evidence":["guanzhang-e-o046a-q"]}],"place":null,"time":{"year":229,"label":"建兴七年","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"guanzhang-y229","dating_review":{"reviewed":true,"anchor":"guanzhang-q-o046","basis":"建兴七年"},"evidence":["guanzhang-e-o046a-q","guanzhang-q-o046","guanzhang-q-b-d248bb04fd56288748b0"]},"ordering_evidence":"guanzhang-e-o046a-q","source_order":[36,202,"O046a"],"order":6944}],"persons":[{"id":"xianzhu-p0034","name":"赵云","facts":[],"aliases":[]}],"evidence":[{"id":"guanzhang-e-o046a-q","section":"chapter-036","block":"b-9f348b83292228dfc790","layer":"original","quote":"七年卒〖3〗，","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":201,"anchor":null},"note_id":null,"start":0,"end":7},{"id":"guanzhang-q-b-d248bb04fd56288748b0","section":"chapter-036","block":"b-d248bb04fd56288748b0","layer":"modern","quote":"〖3〗七年：建兴七年（公元 229）。赵云的祠墓，相传在今四川大邑县城东银屏山麓，现今尚有清雅肃穆的墓园留存。是蜀地三国名胜古迹之一。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":206,"anchor":null},"note_id":"n-27ea1c0a8e2fa47a77c0","start":0,"end":67},{"id":"guanzhang-q-o046","section":"chapter-036","block":"b-9f348b83292228dfc790","layer":"original","quote":"七年卒〖3〗，追谥顺平侯。初，先主时，惟法正见谥。后主时，诸葛亮功德盖世，蒋琬、费祎荷国之重〖4〗，亦见谥。陈祗宠待〖5〗，特加殊奖；夏侯霸，远来归国〖6〗：故复得谥。于是关羽、张飞、马超、庞统、黄忠及云乃追谥，时论以为荣﹝二﹞。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":201,"anchor":null},"note_id":null,"start":0,"end":115}],"profiles":{},"directory_counts":{}}
