{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wuzhu-e-p012b","title":"谷利助孙权跃津桥受封","accounts":[{"id":"wuzhu-e-p012b-account","label":"《江表传》","text":"谷利助孙权跃津桥，孙权拜谷利都亭侯。","evidence":["wuzhu-e-p012b-q"]}],"participants":[{"person":"wuzhu-p0013","role":"助跃受封","evidence":["wuzhu-e-p012b-q"]},{"person":"sun-quan","role":"脱险封赏","evidence":["wuzhu-e-p012b-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["wuzhu-e-p012b-q"]},"ordering_evidence":"wuzhu-e-p012b-q","source_order":[47,148,"P012b"],"order":8189}],"persons":[{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"wuzhu-p0013","name":"谷利","facts":[],"aliases":[]}],"evidence":[{"id":"wuzhu-e-p012b-q","section":"chapter-047","block":"b-0ed62790e44c308cb9eb","layer":"pei","quote":"权乘骏马，上津桥；桥南已见撤，丈余无板。谷利在马后，使权持鞍缓控；利于后著鞭，以助马势：遂得超度。权既得免，即拜利都亭侯。谷利者，本左右给使也。以谨直为亲近监。性忠果亮烈，言不苟且，权爱信之。","attribution":"《江表传》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":147,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-7262f3df3027b60a9d97","start":88,"end":184,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
