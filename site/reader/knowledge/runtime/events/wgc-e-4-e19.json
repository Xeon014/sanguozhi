{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wgc-e-4-e19","title":"钟会胡烈师纂白艾悖逆","order":5684,"accounts":[{"id":"wgc-a-4-e19","label":"正文","text":"钟会胡烈师纂白艾悖逆","evidence":["wgc-q0397","wgc-q0056"]},{"id":"wgc-a-7-e8","label":"正文","text":"钟会密白邓艾有反状","evidence":["wgc-q0484","wgc-q0079"]}],"participants":[{"person":"shaodi-p0073","role":"白艾所作悖逆","evidence":["wgc-q0397","wgc-q0056"]},{"person":"jfj-p0029","role":"同白","evidence":["wgc-q0397","wgc-q0056"]},{"person":"wgc-p0033","role":"同白","evidence":["wgc-q0397","wgc-q0056"]},{"person":"shaodi-p0080","role":"被密白有反状者","evidence":["wgc-q0484","wgc-q0079"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0397","wgc-q0056"]},"ordering_evidence":"wgc-q0397"}],"persons":[{"id":"jfj-p0029","name":"胡烈","facts":[],"aliases":[]},{"id":"shaodi-p0073","name":"钟会","facts":[],"aliases":[]},{"id":"shaodi-p0080","name":"邓艾","facts":[],"aliases":[]},{"id":"wgc-p0033","name":"师纂","facts":[],"aliases":[]}],"evidence":[{"id":"wgc-q0056","section":"chapter-028","block":"b-2887f1d1c1602f289c32","layer":"original","quote":"钟会、胡烈、师纂等皆白艾所作悖逆，变衅已结〖28〗。诏书槛车征艾〖29〗。﹝二﹞","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":354,"anchor":null},"note_id":null,"start":0,"end":40},{"id":"wgc-q0079","section":"chapter-028","block":"b-513967ffa2e8c3abfabc","layer":"original","quote":"会内有异志〖1〗，因邓艾承制专事，密白“艾有反状”；﹝一﹞于是诏书槛车征艾。司马文王惧艾或不从命，敕会并进军成都。监军卫瓘在会前行，以文王手笔令宣喻艾军；艾军皆释仗，遂收艾入槛车。会所惮惟艾，艾既擒而会寻至，独统大众，威震西土。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":558,"anchor":null},"note_id":null,"start":0,"end":114},{"id":"wgc-q0397","section":"chapter-028","block":"b-2887f1d1c1602f289c32","layer":"original","quote":"钟会、胡烈、师纂等皆白艾所作悖逆，变衅已结","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":354,"anchor":null},"note_id":null,"start"