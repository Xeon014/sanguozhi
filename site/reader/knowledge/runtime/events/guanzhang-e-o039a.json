{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"guanzhang-e-o039a","title":"诸葛亮议黄忠位列关马刘备仍授后将军","accounts":[{"id":"guanzhang-e-o039a-account","label":"《关张马黄赵传第六》正文","text":"诸葛亮议黄忠位列关马刘备仍授后将军","evidence":["guanzhang-e-o039a-q"]}],"participants":[{"person":"zhuge-liang","role":"议职","evidence":["guanzhang-e-o039a-q"]},{"person":"liu-bei","role":"决策","evidence":["guanzhang-e-o039a-q"]},{"person":"xianzhu-p0051","role":"受任","evidence":["guanzhang-e-o039a-q"]}],"place":null,"time":{"year":219,"label":"刘备为汉中王","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"guanzhang-y219","dating_review":{"reviewed":true,"anchor":"guanzhang-q-o008","basis":"刘备为汉中王"},"evidence":["guanzhang-e-o039a-q","guanzhang-q-o008","guanzhang-q-b-edafc9276d2732d2c2af"]},"ordering_evidence":"guanzhang-e-o039a-q","source_order":[36,171,"O039a"],"order":6921}],"persons":[{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"xianzhu-p0051","name":"黄忠","facts":[],"aliases":[]},{"id":"zhuge-liang","name":"诸葛亮","facts":[],"aliases":[]}],"evidence":[{"id":"guanzhang-e-o039a-q","section":"chapter-036","block":"b-38bd93b2d0b8b7c999fb","layer":"original","quote":"是岁，先主为汉中王，欲用忠为后将军；诸葛亮说先主曰：“忠之名望，素非关、马之伦也〖6〗；而今便令同列〖7〗：马、张在近〖8〗，亲见其功，尚可喻指〖9〗；关遥闻之，恐必不悦，得无不可乎〖10〗？”先主曰：“吾自当解之〖11〗。”遂与羽等齐位，赐爵关内侯。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":170,"anchor":null},"note_id":null,"start":0,"end":126},{"id":"guanzhang-q-b-edafc9276d2732d2c2af","section":"chapter-036","block":"b-edafc9276d2732d2c2af","layer":"modern","quote":"〖1〗二十四年：建安二十四年（公元 219）。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":42,"anchor":null},"note_id":"n-16dc4b02f597093385c1","start":0,"end":23},{"id":"guanzhang-q-o008","section":"chapter-036","block":"b-b96955cde6bd0ef2541b","layer":"original","quote":"二十四年〖1〗，先主为汉中王；拜羽为前将军，假节、钺。是岁，羽率众攻曹仁于樊。曹公遣于禁助仁。秋，大霖雨，汉水泛溢，禁所督七军皆没；禁降羽，羽又斩将军庞德〖2〗；梁、郏、陆浑群盗或遥受羽印号〖3〗，为之支党。羽威震华夏〖4〗，曹公议徙许都，以避其锐。司马宣王、蒋济以为：“关羽得志，孙权必不愿也。可遣人劝权蹑其后〖5〗，许割江南以封权，则樊围自解。”曹公从之。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":35,"anchor":null},"note_id":null,"start":0,"end":180}],"profiles":{},"directory_counts":{}}
