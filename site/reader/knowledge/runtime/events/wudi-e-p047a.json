{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p047a","title":"宛败中绝影受伤与曹昂献马","accounts":[{"id":"wudi-e-p047a-account","label":"《魏书》、《世语》","text":"《魏书》记曹操与坐骑绝影中箭；《世语》称曹昂献马使曹操得免，自己遇害。","evidence":["wudi-e-p047a-q"]}],"participants":[{"person":"cao-cao","role":"受伤脱身","evidence":["wudi-e-p047a-q"]},{"person":"wudi-p0132","role":"《世语》记献马遇害","evidence":["wudi-e-p047a-q"]}],"place":null,"time":{"label":"建安二年宛败时","year":197,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-p047a-q","wudi-q-o050","wudi-q-b-40d8b7057f4a29d6fe0d"],"chronology":"wudi-y197","dating_review":{"anchor":"wudi-q-o050","basis":"建安二年宛败时","reviewed":true}},"source_order":[1,321,"P047a"],"order":140}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0132","name":"曹昂","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-p047a-q","section":"chapter-001","block":"b-17f32357ab34a24c55c1","layer":"pei","quote":"﹝一﹞《魏书》曰：“所乘马名‘绝影’。为流矢所中，伤颊及足；并中公右臂。”《世语》曰：“昂不能骑，进马于公。公故免，而昂遇害。”","attribution":"《魏书》、《世语》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":320,"anchor":null},"note_id":"n-9bc7ed14fc92cd4fed2a","start":0,"end":64},{"id":"wudi-q-b-40d8b7057f4a29d6fe0d","section":"chapter-001","block":"b-40d8b7057f4a29d6fe0d","layer":"modern","quote":"〖3〗二年：建安二年（公元 197）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":305,"anchor":null},"note_id":"n-de6807349faf5c41a470","start":0,"end":19},{"id":"wudi-q-o050","section":"chapter-001","block":"b-c2d0fc350fb933237a70","layer":"original","quote":"二年春正月〖3〗，公到宛〖4〗。张绣降，既而悔之，复反。公与战，军败，为流矢所中。长子昂、弟子安民遇害〖5〗。﹝一﹞公乃引兵还舞阴〖6〗，绣将骑来抄〖7〗。公击破之，绣奔穰〖8〗，与刘表合。公谓诸将曰：“吾降张绣等，失不便取其质〖9〗，以至于此。吾知所以败。诸卿观之：自今以后，不复败矣！”遂还许。﹝二﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":298,"anchor":null},"note_id":null,"start":0,"end":152}],"profiles