{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhouyu-e-p006b","title":"周瑜劝不遣质吴夫人赞同孙权从之","accounts":[{"id":"zhouyu-e-p006b-account","label":"《江表传》","text":"周瑜劝不遣质吴夫人赞同孙权从之","evidence":["zhouyu-e-p006b-q"]}],"participants":[{"person":"zhou-yu","role":"劝拒质","evidence":["zhouyu-e-p006b-q"]},{"person":"zhouyu-p0018","role":"赞议","evidence":["zhouyu-e-p006b-q"]},{"person":"sun-quan","role":"不遣质","evidence":["zhouyu-e-p006b-q"]}],"place":null,"time":{"year":202,"label":"建安七年","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"zhouyu-y202","dating_review":{"reviewed":true,"anchor":"zhouyu-q-p006","basis":"建安七年"},"evidence":["zhouyu-e-p006b-q","zhouyu-q-p006","wudi-q-o085","wudi-q-b-6de9e09a3ba1d95f3972"]},"ordering_evidence":"zhouyu-e-p006b-q","source_order":[54,61,"P006b"],"order":9594}],"persons":[{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"zhou-yu","name":"周瑜","facts":[],"aliases":[]},{"id":"zhouyu-p0018","name":"孙权母（本篇未具名）","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-q-b-6de9e09a3ba1d95f3972","section":"chapter-001","block":"b-6de9e09a3ba1d95f3972","layer":"modern","quote":"〖5〗七年：建安七年（公元 202）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":464,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-225e544b9b47ac46c22e","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o085","section":"chapter-001","block":"b-a8b85fd0a011c49dc335","layer":"original","quote":"七年春正月〖5〗，公军谯。令曰：“吾起义兵，为天下除暴乱。旧土人民〖6〗，死丧略尽〖7〗。国中终日行，不见所识〖8〗，使吾凄怆伤怀！其举义兵以来〖9〗，将士绝无后者，求其亲戚以后之〖10〗；授土田，官给耕牛；置学师以教之。为存者立庙，使祀其先人。魂而有灵，吾百年之后何恨哉！”遂至浚仪〖11〗，治睢阳渠〖12〗；遣使以太牢祀桥玄〖13〗。﹝一﹞进军官渡。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":458,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":177,"offset_unit":"unicode_code_point"},{"id":"zhouyu-e-p006b-q","section":"chapter-054","block":"b-4ad4c240c77b6f448541","layer":"pei","quote":"﹝一﹞《江表传》曰：“曹公新破袁绍，兵威日盛。建安七年，下书责权质任子。权召群臣会议，张昭、秦松等，犹豫不能决。权意不欲遣质，乃独将瑜，诣母前定议，瑜曰：‘昔楚国初封于荆山之侧，不满百里之地；继嗣贤能，广土开境，立基于郢；遂据荆扬，至于南海；传业延祚，九百余年。今将军承父兄余资，兼六郡之众；兵精粮多，将士用命；铸山为铜，煮海为盐；境内富饶，人不思乱；泛舟举帆，朝发夕到；士风劲勇，所向无敌。有何逼迫，而欲送质？质一入，不得不与曹氏相首尾；与相首尾，则命召不得不往，便见制于人也。极不过一侯印，仆从十余人，车数乘，马数匹：岂与南面称孤同哉？不如勿遣，徐观其变。若曹氏能率义以正天下，将军事之未晚；若图为暴乱，兵犹火也，不戢将自焚。将军韬勇抗威，以待天命：何送质之有！’权母曰：‘公瑾议是也！公瑾与伯符同年，小一月耳；我视之如子也，汝其兄事之。’遂不送质。”","attribution":"《江表传》","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":60,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-49c50e9391cb7fe61c49","start":0,"end":378,"offset_unit":"unicode_code_point"},{"id":"zhouyu-q-p006","section":"chapter-054","block":"b-4ad4c240c77b6f448541","layer":"pei","quote":"﹝一﹞《江表传》曰：“曹公新破袁绍，兵威日盛。建安七年，下书责权质任子。权召群臣会议，张昭、秦松等，犹豫不能决。权意不欲遣质，乃独将瑜，诣母前定议，瑜曰：‘昔楚国初封于荆山之侧，不满百里之地；继嗣贤能，广土开境，立基于郢；遂据荆扬，至于南海；传业延祚，九百余年。今将军承父兄余资，兼六郡之众；兵精粮多，将士用命；铸山为铜，煮海为盐；境内富饶，人不思乱；泛舟举帆，朝发夕到；士风劲勇，所向无敌。有何逼迫，而欲送质？质一入，不得不与曹氏相首尾；与相首尾，则命召不得不往，便见制于人也。极不过一侯印，仆从十余人，车数乘，马数匹：岂与南面称孤同哉？不如勿遣，徐观其变。若曹氏能率义以正天下，将军事之未晚；若图为暴乱，兵犹火也，不戢将自焚。将军韬勇抗威，以待天命：何送质之有！’权母曰：‘公瑾议是也！公瑾与伯符同年，小一月耳；我视之如子也，汝其兄事之。’遂不送质。”","attribution":"《江表传》","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":60,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-49c50e9391cb7fe61c49","start":0,"end":378,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
