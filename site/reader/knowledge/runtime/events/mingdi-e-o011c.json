{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"mingdi-e-o011c","title":"曹休去世","accounts":[{"id":"mingdi-e-o011c-account","label":"《明帝纪》正文","text":"曹休去世","evidence":["mingdi-e-o011c-q"]},{"id":"luxun-e-o028b-account","label":"《陆逊传第十三》正文","text":"曹休还后背疽发卒","evidence":["luxun-e-o028b-q"]},{"id":"xiahoucao-e-o045c-account","label":"《诸夏侯曹传第九》正文","text":"曹休因石亭败后痈发背而卒，谥壮侯。","evidence":["xiahoucao-e-o045c-q"]},{"id":"mantian-a-8bebe9059152139aab39","label":"正文","text":"是岁休薨","evidence":["mantian-q-dfda4fdbeba498d06bf6"]}],"participants":[{"person":"wendi-p0039","role":"卒","evidence":["mingdi-e-o011c-q"]}],"place":null,"time":{"year":228,"label":"九月庚子","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"mingdi-y228","dating_review":{"reviewed":true,"anchor":"mingdi-q-o008","basis":"九月庚子"},"evidence":["mingdi-e-o011c-q","mingdi-q-o008","mingdi-q-b-76fba510250937628a99"]},"ordering_evidence":"mingdi-e-o011c-q","source_order":[3,58,"O011c"],"order":747}],"persons":[{"id":"wendi-p0039","name":"曹休","facts":[],"aliases":[]}],"evidence":[{"id":"luxun-e-o028b-q","section":"chapter-058","block":"b-25441637d6731269f663","layer":"original","quote":"休还，疽发背死。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":136,"anchor":null},"note_id":null,"start":68,"end":76},{"id":"mantian-q-dfda4fdbeba498d06bf6","section":"chapter-026","block":"b-430f562b6ec8ca268782","layer":"original","quote":"是岁，休薨","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":48,"anchor":null},"note_id":null,"start":0,"end":5},{"id":"mingdi-e-o011c-q","section":"chapter-003","block":"b-0f7011a011e59527fd63","layer":"original","quote":"秋九月，曹休率诸军至皖〖16〗，与吴将陆议战于石亭〖17〗，败绩〖18〗。乙酉〖19〗，立皇子穆为繁阳王。庚子〖20〗，大司马曹休薨。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":57,"anchor":null},"note_id":null,"start":0,"end":67},{"id":"mingdi-q-b-76fba510250937628a99","section":"chapter-003","block":"b-76fba510250937628a99","layer":"modern","quote":"〖1〗二年：太和二年（公元 228）。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":60,"anchor":null},"note_id":"n-38a74578b09178cb1fd4","start":0,"end":19},{"id":"mingdi-q-o008","section":"chapter-003","block":"b-bec9198de0001b0aa26c","layer":"original","quote":"二年春正月〖1〗，宣王攻破新城。斩达，传其首〖2〗。﹝一﹞分新城之上庸、武陵、巫县为上庸郡〖3〗，锡县为锡郡。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":54,"anchor":null},"note_id":null,"start":0,"end":55},{"id":"xiahoucao-e-o045c-q","section":"chapter-009","block":"b-772f3a3de27ca1a3e015","layer":"original","quote":"休因此痈发背薨〖13〗。谥曰壮侯。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":192,"anchor":null},"note_id":null,"start":98,"end":115}],"profiles":{},"directory_counts":{}}
