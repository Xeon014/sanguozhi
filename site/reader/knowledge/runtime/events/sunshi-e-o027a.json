{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"sunshi-e-o027a","title":"刘繇治曲阿逐吴景孙贲","accounts":[{"id":"sunshi-e-o027a-account","label":"《孙破虏讨逆传第一》正文","text":"刘繇治曲阿逐吴景孙贲","evidence":["sunshi-e-o027a-q"]},{"id":"yaoci-a-f840a5c815e3762c7815","label":"正文","text":"刘繇以吴景、孙贲为袁术所授用，追逐使去","evidence":["yaoci-q-2267e6f37e239cbc497f"]},{"id":"zongshi-a-826e4d01b4c8f4c5e1c3","label":"正文","text":"贲为扬州刺史刘繇所追逐，因将士众还住历阳","evidence":["zongshi-q-9329a65951d71876d558"]},{"id":"zhulv-a-3f769388a871918b3a5d","label":"正文","text":"是时吴景已在丹杨，而策为术攻庐江；刘繇恐为袁、孙所并，遂构嫌隙","evidence":["zhulv-q-0d6cbe47171a321ccdf7"]}],"participants":[{"person":"wudi-p0068","role":"据州逐人","evidence":["sunshi-e-o027a-q"]},{"person":"sunshi-p0039","role":"退军","evidence":["sunshi-e-o027a-q"]},{"person":"sunshi-p0027","role":"退军","evidence":["sunshi-e-o027a-q"]},{"person":"wudi-p0057","role":"据寿春","evidence":["sunshi-e-o027a-q"]},{"person":"wudi-p0099","role":"为术攻庐江者","evidence":["zhulv-q-0d6cbe47171a321ccdf7"]}],"place":null,"time":{"label":"刘繇渡江据曲阿时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["sunshi-e-o027a-q"]},"ordering_evidence":"sunshi-e-o027a-q","source_order":[46,180,"O027a"],"order":8075}],"persons":[{"id":"sunshi-p0027","name":"孙贲","facts":[],"aliases":[]},{"id":"sunshi-p0039","name":"吴景","facts":[],"aliases":[]},{"id":"wudi-p0057","name":"袁术","facts":[],"aliases":[]},{"id":"wudi-p0068","name":"刘繇","facts":[],"aliases":[]},{"id":"wudi-p0099","name":"孙策","facts":[],"aliases":[]}],"evidence":[{"id":"sunshi-e-o027a-q","section":"chapter-046","block":"b-1538e7ae2754e5a06f87","layer":"original","quote":"先是，刘繇为扬州刺史〖20〗，州旧治寿春。寿春，术已据之；繇乃渡江，治曲阿。时吴景尚在丹杨，策从兄贲又为丹杨都尉〖21〗；繇至，皆迫逐之。景、贲退舍历阳〖22〗。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":179,"anchor":null},"note_id":null,"start":0,"end":81},{"id":"yaoci-q-2267e6f37e239cbc497f","section":"chapter-049","block":"b-9c3ec449339241f9608c","layer":"original","quote":"以景、贲，术所授用，乃追逐使去","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":3,"anchor":null},"note_id":null,"start":88,"end":103},{"id":"zhulv-q-0d6cbe47171a321ccdf7","section":"chapter-056","block":"b-53b95a44617c09adb1fa","layer":"original","quote":"是时吴景已在丹杨〖6〗，而策为术攻庐江；于是刘繇恐为袁、孙所并〖7〗，遂构嫌隙","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":4,"anchor":null},"note_id":null,"start":24,"end":63},{"id":"zongshi-q-9329a65951d71876d558","section":"chapter-051","block":"b-e5ea2fea4c6316384cb1","layer":"original","quote":"为扬州刺史刘繇所追逐，因将士众还住历阳","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":94,"anchor":null},"note_id":null,"start":76,"end":95}],"profiles":{},"directory_counts":{}}
