{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"sunshi-e-p006c","title":"朱儁劝止迁都拒受太仆与有司辩论","accounts":[{"id":"sunshi-e-p006c-account","label":"《续汉书》","text":"朱儁劝止迁都拒受太仆与有司辩论","evidence":["sunshi-e-p006c-q"]}],"participants":[{"person":"wudi-p0072","role":"拒拜进谏","evidence":["sunshi-e-p006c-q"]},{"person":"wudi-p0053","role":"议迁表官","evidence":["sunshi-e-p006c-q"]}],"place":null,"time":{"label":"朱儁仕汉至董卓秉政时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["sunshi-e-p006c-q"]},"ordering_evidence":"sunshi-e-p006c-q","source_order":[46,48,"P006c"],"order":8019}],"persons":[{"id":"wudi-p0053","name":"董卓","facts":[],"aliases":[]},{"id":"wudi-p0072","name":"朱儁","facts":[],"aliases":[]}],"evidence":[{"id":"sunshi-e-p006c-q","section":"chapter-046","block":"b-d4f658601a73e445f18e","layer":"pei","quote":"董卓见儁，外甚亲纳，而心忌之；儁亦阴备焉。关东兵起，卓议移都；儁辄止卓。卓虽惮儁，然贪其名重，乃表拜太仆以自副。儁被召，不肯受拜，因进曰：‘国不宜迁！必孤天下望，成山东之结，臣不见其可也。’有司诘曰：‘召君受拜，而君拒之；不问徙事，而君陈之：何也？’儁曰：‘副相国，非臣所堪也；迁都非计，臣之所急也。辞所不堪，进臣所急，臣之所宜也。’有司曰：‘迁都之事，初无此计也；就有，未露，何所受闻？’儁曰：‘相国董卓，为臣说之，臣闻之于相国。’有司不能屈，朝廷称服焉。","attribution":"《续汉书》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":47,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fcb66581725781dace53","start":57,"end":286,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
