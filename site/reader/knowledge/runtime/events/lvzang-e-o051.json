{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"lvzang-e-o051","title":"许汜与刘备在刘表坐共论陈登","accounts":[{"id":"lvzang-a-3a6077f80535885d6dc7","label":"正文","text":"许汜与刘备在刘表坐共论陈登","evidence":["lvzang-q-f97622f501073c0c1a8f"]},{"id":"lvzang-a-f8e709814397131167d5","label":"正文","text":"汜言元龙自上大床卧备责其求田问舍","evidence":["lvzang-q-4257aa29391d93dce682"]},{"id":"lvzang-a-2c49d0ebeb154720eae2","label":"正文","text":"备因言元龙文武胆志当求之于古","evidence":["lvzang-q-10a5f253783ea9fd167c"]}],"participants":[{"person":"lvzang-p0020","role":"与刘备并在荆州牧刘表坐、曰陈元龙淮海之士豪气不除；曰昔遭乱过下邳见元龙、元龙无客主之意久不相与语自上大床卧使客卧下床","evidence":["lvzang-q-f97622f501073c0c1a8f","lvzang-q-4257aa29391d93dce682"]},{"person":"liu-bei","role":"与汜并在表坐、谓表曰许君论是非；问汜君言豪宁有事邪、曰君有国士之名今天下大乱帝主失所望君忧国忘家有救世之意而君求田问舍言无可采是元龙所讳也何缘当与君语如小人欲卧百尺楼上卧君于地何但上下床之间邪；因言曰若元龙文武胆志当求之于古耳造次难得比也","evidence":["lvzang-q-f97622f501073c0c1a8f","lvzang-q-4257aa29391d93dce682","lvzang-q-10a5f253783ea9fd167c"]},{"person":"liu-biao","role":"荆州牧、与备共论天下人、答欲言非此君为善士不宜虚言欲言是元龙名重天下；大笑","evidence":["lvzang-q-f97622f501073c0c1a8f","lvzang-q-4257aa29391d93dce682"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["lvzang-q-f97622f501073c0c1a8f","lvzang-q-4257aa29391d93dce682","lvzang-q-10a5f253783ea9fd167c"]},"ordering_evidence":"lvzang-q-f97622f501073c0c1a8f","source_order":[7,129,0],"order":1858}],"persons":[{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"liu-biao","name":"刘表","facts":[],"aliases":[]},{"id":"lvzang-p0020","name":"许汜","facts":[],"aliases":[]}],"evidence":[{"id":"lvzang-q-10a5f253783ea9fd167c","section":"chapter-007","block":"b-85fca35ed52fc59a591c","layer":"original","quote":"备因言曰：“若元龙文武胆志，当求之于古耳〖16〗！造次难得比也","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":130,"anchor":null},"note_id":null,"start":0,"end":31},{"id":"lvzang-q-4257aa29391d93dce682","section":"chapter-007","block":"b-149b73d54415f482d91e","layer":"original","quote":"备问汜：“君言豪，宁有事邪〖7〗？”汜曰：“昔遭乱过下邳，见元龙。元龙无客主之意〖8〗，久不相与语；自上大床卧〖9〗，使客卧下床〖10〗。”备曰：“君有国士之名〖11〗，今天下大乱，帝主失所〖12〗，望君忧国忘家，有救世之意；而君求田问舍〖13〗，言无可采，是元龙所讳也。何缘当与君语〖14〗？如小人〖15〗，欲卧百尺楼上，卧君于地；何但上下床之间邪！”表大笑","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":129,"anchor":null},"note_id":null,"start":0,"end":180},{"id":"lvzang-q-f97622f501073c0c1a8f","section":"chapter-007","block":"b-b6a315a7be9ecf135407","layer":"original","quote":"后许汜与刘备，并在荆州牧刘表坐，表与备共论天下人〖2〗。汜曰：“陈元龙，（湖）〔淮〕海之士〖3〗，豪气不除〖4〗。”备谓表曰：“许君论是非〖5〗？”表曰：“欲言非，此君为善士〖6〗，不宜虚言；欲言是，元龙名重天下","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":128,"anchor":null},"note_id":null,"start":0,"end":106}],"profiles":{},"directory_counts":{}}
