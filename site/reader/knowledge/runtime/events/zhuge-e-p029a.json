{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhuge-e-p029a","title":"郭冲记诸葛亮拔冀城虏姜维归蜀愧百姓受困","accounts":[{"id":"zhuge-e-p029a-account","label":"《蜀记》郭冲四事","text":"郭冲记诸葛亮拔冀城虏姜维归蜀愧百姓受困","evidence":["zhuge-e-p029a-q"]},{"id":"zhuge-a-p030-judgment","label":"裴松之难","text":"裴松之认为师出无成、拔西县不足补街亭之失，不应据此称蜀人相贺。","evidence":["zhuge-q-p030-judgment"]}],"participants":[{"person":"zhuge-liang","role":"被记略民","evidence":["zhuge-e-p029a-q"]}],"place":null,"time":{"label":"郭冲所述祁山之役","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["zhuge-e-p029a-q"]},"ordering_evidence":"zhuge-e-p029a-q","source_order":[35,253,"P029a"],"order":6796}],"persons":[{"id":"zhuge-liang","name":"诸葛亮","facts":[],"aliases":[]}],"evidence":[{"id":"zhuge-e-p029a-q","section":"chapter-035","block":"b-6c4977c727a9b0b513cc","layer":"pei","quote":"﹝三﹞郭冲四事曰：“亮出祁山，陇西、南安二郡应时降；围天水，拔冀城，虏姜维，驱略士女数千人还蜀。人皆贺亮，亮颜色愀然有戚容，谢曰：‘普天之下，莫非汉民；国家威力未举，使百姓困于豺狼之吻。一夫有死，皆亮之罪；以此相贺，能不为愧！’于是蜀人咸知亮有吞魏之志，非惟拓境而已。”","attribution":"《蜀记》郭冲四事","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":252,"anchor":null},"note_id":"n-426ad96d435ea34f64ed","start":0,"end":135},{"id":"zhuge-q-p030-judgment","section":"chapter-035","block":"b-d09390fb8b5519b68a02","layer":"pei","quote":"难曰：亮有吞魏之志久矣，不始于此众人方知也。且于时师出无成，伤缺而返者众，三君归降而不能有。姜维，天水之匹夫耳，获之则于魏何损？拔西县千家，不补街亭所丧，以何为功，而蜀人相贺乎？","attribution":"裴松之难","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":253,"anchor":null},"note_id":"n-426ad96d435ea34f64ed","start":0,"end":89}],"profiles":{},"directory_counts":{}}
