{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"shaodi-e-o148a","title":"司马昭上言收治成济及家属","accounts":[{"id":"shaodi-e-o148a-account","label":"《三少帝纪》正文","text":"司马昭上言收治成济及家属","evidence":["shaodi-e-o148a-q"]}],"participants":[{"person":"shaodi-p0045","role":"上言","evidence":["shaodi-e-o148a-q"]},{"person":"shaodi-p0132","role":"被收治","evidence":["shaodi-e-o148a-q"]}],"place":null,"time":{"year":260,"label":"五月戊申","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"shaodi-y260","dating_review":{"reviewed":true,"anchor":"shaodi-q-o139","basis":"五月戊申"},"evidence":["shaodi-e-o148a-q","shaodi-q-o139","shaodi-q-b-77066dd061eb6a338ffa"]},"ordering_evidence":"shaodi-e-o148a-q","source_order":[4,687,"O148a"],"order":1243}],"persons":[{"id":"shaodi-p0045","name":"司马昭","facts":[],"aliases":[]},{"id":"shaodi-p0132","name":"成济","facts":[],"aliases":[]}],"evidence":[{"id":"shaodi-e-o148a-q","section":"chapter-004","block":"b-cb26d28fa297c41a7e7d","layer":"original","quote":"戊申〖7〗，大将军文王上言：“高贵乡公率将从驾人兵〖8〗，拔刃鸣金鼓，向臣所止。惧兵刃相接，即敕将士：‘不得有所伤害，违令以军法从事！’骑督成倅弟太子舍人济〖9〗，横入兵阵伤公，遂至陨命。辄收济行军法。臣闻人臣之节，有死无二；事上之义，不敢逃难〖10〗。前者变故猝至，祸同发机〖11〗；诚欲委身守死，唯命所裁。然惟本谋乃欲上危皇太后〖12〗，倾覆宗庙；臣忝当大任，义在安国〖13〗；惧虽身死，罪责弥重；欲遵伊、周之权〖14〗，以安社稷之难。即骆驿申敕〖15〗：‘不得迫近辇舆！’而济遽入阵间，以致大变〖16〗。哀怛痛恨，五内摧裂〖17〗，不知何地可以陨坠！科律：‘大逆无道，父母、妻子、同产皆斩〖18〗。’济凶戾悖逆，干国乱纪，罪不容诛！辄敕侍御史：收济家属，付廷尉，结正其罪〖19〗。”﹝一﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":94,"anchor":null},"note_id":null,"start":0,"end":347},{"id":"shaodi-q-b-77066dd061eb6a338ffa","section":"chapter-004","block":"b-77066dd061eb6a338ffa","layer":"modern","quote":"〖1〗五年：甘露五年（公元 260 ）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":50,"anchor":null},"note_id":"n-21e90e29c9fd438bba21","start":0,"end":20},{"id":"shaodi-q-o139","section":"chapter-004","block":"b-c33fc441ae4a3de17fb6","layer":"original","quote":"五年春正月朔〖1〗，日有食之。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":45,"anchor":null},"note_id":null,"start":0,"end":15}],"profiles":{},"directory_counts":{}}
