ock":"b-58d734185bb62383e211","layer":"original","quote":"十年春正月〖12〗，右大司马全琮卒。﹝三﹞二月，权适南宫〖13〗。三月，改作太初宫〖14〗，诸将及州郡皆义作〖15〗。﹝四﹞","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":236,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":62,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
