{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o109a","title":"袁绍结好乌丸诸酋","accounts":[{"id":"wudi-e-o109a-account","label":"正文","text":"三郡乌丸乘乱侵掠幽州，袁绍立其酋豪为单于，以家人之女冒己女嫁之，尤厚蹋顿。","evidence":["wudi-e-o109a-q"]}],"participants":[{"person":"wudi-p0052","role":"结好","evidence":["wudi-e-o109a-q"]},{"person":"wudi-p0240","role":"受厚待","evidence":["wudi-e-o109a-q"]}],"place":{"text":"幽州、辽西","evidence":["wudi-e-o109a-q"]},"time":{"label":"天下乱时，袁绍在世时","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-o109a-q"]},"source_order":[1,601,"O109a"],"order":245}],"persons":[{"id":"wudi-p0052","name":"袁绍","facts":[],"aliases":[]},{"id":"wudi-p0240","name":"蹋顿","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-o109a-q","section":"chapter-001","block":"b-941e466279df6c3bb760","layer":"original","quote":"三郡乌丸承天下乱〖6〗，破幽州〖7〗，略有汉民合十余万户。袁绍皆立其酋豪为单于；以家人子为己女〖8〗，妻焉。辽西单于蹋顿尤强〖9〗，为绍所厚〖10〗。故尚兄弟归之，数入塞为害。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":600,"anchor":null},"note_id":null,"start":0,"end":88}],"profiles":{},"directory_counts":{}}
