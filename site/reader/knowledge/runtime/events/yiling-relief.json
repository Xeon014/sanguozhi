{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"yiling-relief","title":"战后救援夷陵","order":8171,"accounts":[{"id":"yiling-relief-account-1","label":"记载","text":"《周瑜传》记甘宁据夷陵后被曹仁分兵围攻，周瑜采纳吕蒙建议，留凌统守后，亲自与吕蒙救援。","evidence":["yiling-zhou"]},{"id":"yiling-relief-account-2","label":"记载","text":"《吕蒙传》保存吕蒙提出留凌公绩守后、自己与周瑜等救援的言辞。","evidence":["yiling-meng"]},{"id":"wuzhu-e-o015b-account","label":"《吴主传第二》正文","text":"甘宁被围周瑜用吕蒙计留凌统拒曹仁分兵救甘宁","evidence":["wuzhu-e-o015b-q"]}],"participants":[{"person":"gan-ning","role":"据夷陵、告急","evidence":["yiling-zhou"]},{"person":"cao-ren","role":"分兵围攻","evidence":["yiling-zhou"]},{"person":"zhou-yu","role":"救援","evidence":["yiling-zhou"]},{"person":"lu-meng","role":"献策、同行救援","evidence":["yiling-zhou"]},{"person":"ling-tong","role":"留守后方","evidence":["yiling-zhou"]}],"place":{"text":"夷陵","evidence":["yiling-zhou"]},"time":{"label":"曹军北归后的南郡战事","precision":"relative","basis":"依《周瑜传》北归、进南郡、救夷陵的叙述先后；原段未明示年月，不沿用赤壁年份。","after":"cao-retreat","evidence":["retreat","yiling-zhou"]}},{"id":"cao-retreat","title":"曹军退却，刘备与周瑜追击","order":274,"accounts":[{"id":"cao-retreat-account-1","label":"记载","text":"《周瑜传》记曹军退保南郡，刘备与周瑜等追击；曹操留曹仁等守江陵，自己北归。","evidence":["retreat"]},{"id":"cao-retreat-account-2","label":"记载","text":"《先主传》记刘备与吴军追到南郡，并提到疾疫及曹操引归。","evidence":["battle-shu"]},{"id":"cao-retreat-account-3","label":"记载","text":"裴注引《山阳公载记》称曹操从华容道步行撤军。","evidence":["retreat-shanyang"]},{"id":"wudi-e-o122c-account","label":"正文","text":"正文记赤壁战后大疫，曹军死亡多，曹操退军，刘备遂有荆州江南诸郡。","evidence":["wudi-e-o122c-q"]},{"id":"wudi-e-p088a-account","label":"《山阳公载记》","text":"《山阳公载记》记曹操舰船被刘备焚烧，从华容道步行撤退，令羸兵负草填泥，死者甚众；刘备随后放火未及曹军。","evidence":["wudi-e-p088a-q"]}],"participants":[{"person":"cao-cao","role":"退军北归","evidence":["retreat"]},{"person":"liu-bei","role":"追击","evidence":["retreat"]},{"person":"zhou-yu","role":"追击","evidence":["retreat"]},{"person":"cao-ren","role":"留守江陵","evidence":["retreat"]}],"place":{"text":"南郡、江陵；华容道见裴注","evidence":["retreat","retreat-shanyang"]},"time":{"label":"建安十三年（208）","year":208,"precision":"year","basis":"年次承接本篇建安十三年记事，现代注释释为公元 208 年；此条未记具体月日。","evidence":["year-original","year-modern","zhou-year","zhou-year-modern","allied-zhou","retreat"]}}],"persons":[{"id":"cao-ren","name":"曹仁","facts":[],"aliases":[]},{"id":"gan-ning","name":"甘宁","facts":[],"aliases":[]},{"id":"ling-tong","name":"凌统","facts":[],"aliases":[]},{"id":"lu-meng","name":"吕蒙","facts":[],"aliases":[]},{"id":"zhou-yu","name":"周瑜","facts":[],"aliases":[]}],"evidence":[{"id":"retreat","section":"chapter-054","block":"b-9cefd55fcd0518a1c94f","quote":"军遂败退，还保南郡。﹝二﹞备与瑜等复共追。曹公留曹仁等守江陵城，径自北归。","layer":"original","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":65,"anchor":null},"note_id":null,"start":0,"end":37},{"id":"wuzhu-e-o015b-q","section":"chapter-047","block":"b-1ed3a6bf3da9347dc7d8","layer":"original","quote":"时甘宁在（江陵）〔夷陵〕〖19〗，为仁党所围；用吕蒙计，留凌统以拒仁，以其半救宁，军以胜返。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":63,"anchor":null},"note_id":null,"start":45,"end":91},{"id":"yiling-meng","section":"chapter-054","block":"b-b3cb94f577df75ecc6eb","quote":"瑜使甘宁前据夷陵。曹仁分众攻宁；宁困急，使使请救。诸将以兵少不足分，蒙谓瑜、普曰：“留凌公绩〖20〗，蒙与君行；解围释急，势亦不久。蒙保公绩能十日守也。”","layer":"original","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":318,"anchor":null},"note_id":null,"start":0,"end":77},{"id":"yiling-zhou","section":"chapter-054","block":"b-e959844e829722ef4767","quote":"瑜与程普又进南郡，与仁相对，各隔大江。兵未交锋，﹝三﹞瑜即遣甘宁前据夷陵。仁分兵骑，别攻围宁，宁告急于瑜。瑜用吕蒙计，留凌统以守其后〖7〗；身与蒙上〖8〗，救宁。","layer":"original","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":66,"anchor":null},"note_id":null,"start":0,"end":81}],"profiles":{},"directory_counts":{}}
