{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dongyuan-e-o027a","title":"裴茂率关西诸将诛李傕夷族","accounts":[{"id":"dongyuan-e-o027a-account","label":"《董二袁刘传第六》正文","text":"裴茂率关西诸将诛李傕夷族","evidence":["dongyuan-e-o027a-q"]}],"participants":[{"person":"wudi-p0336","role":"奉命诛讨","evidence":["dongyuan-e-o027a-q"]},{"person":"wudi-p0089","role":"被杀","evidence":["dongyuan-e-o027a-q"]}],"place":null,"time":{"year":198,"label":"建安三年","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"dongyuan-y198","dating_review":{"reviewed":true,"anchor":"dongyuan-q-o027","basis":"建安三年"},"evidence":["dongyuan-e-o027a-q","dongyuan-q-o027","sunshi-q-p045","xunyu-q-o018","xunyu-q-b-55069b3150fc7a092ecf"]},"ordering_evidence":"dongyuan-e-o027a-q","source_order":[6,183,"O027a"],"order":1598}],"persons":[{"id":"wudi-p0089","name":"李傕","facts":[],"aliases":[]},{"id":"wudi-p0336","name":"裴茂","facts":[],"aliases":[]}],"evidence":[{"id":"dongyuan-e-o027a-q","section":"chapter-006","block":"b-f53cbee8aa1c002e8508","layer":"original","quote":"建安（二）〔三〕年，遣谒者仆射裴茂率关西诸将诛傕〖1〗，夷三族。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":182,"anchor":null},"note_id":null,"start":0,"end":32},{"id":"dongyuan-q-o027","section":"chapter-006","block":"b-f53cbee8aa1c002e8508","layer":"original","quote":"建安（二）〔三〕年，遣谒者仆射裴茂率关西诸将诛傕〖1〗，夷三族。﹝二﹞汜为其将五习所袭，死于郿。济饥饿，至南阳寇略；为穰人所杀，从子绣，摄其众。才、乐留河东：才为怨家所杀，乐病死。遂、腾自还凉州，更相寇〖2〗。后腾入为卫尉，子超领其部曲。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":182,"anchor":null},"note_id":null,"start":0,"end":119},{"id":"sunshi-q-p045","section":"chapter-046","block":"b-214fb3f640bf8f883274","layer":"pei","quote":"《江表传》曰：“建安三年，策又遣使，贡方物：倍于元年所献。其年，制书转拜讨逆将军，改封吴侯。”","attribution":"《江表传》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":256,"anchor":null},"note_id":"n-724f2dcc828652965c88","start":0,"end":47},{"id":"xunyu-q-b-55069b3150fc7a092ecf","section":"chapter-010","block":"b-55069b3150fc7a092ecf","layer":"modern","quote":"〖1〗三年：建安三年（公元 198）。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":113,"anchor":null},"note_id":"n-2bf03ce242d0f1f296ae","start":0,"end":19},{"id":"xunyu-q-o018","section":"chapter-010","block":"b-c84a0f39812ff83ca230","layer":"original","quote":"三年〖1〗，太祖既破张绣，东擒吕布，定徐州；遂与袁绍相拒。孔融谓彧曰：“绍，地广兵强；田丰、许攸，智计之士也，为之谋；审配、逢纪，尽忠之臣也，任其事；颜良、文丑，勇冠三军，统其兵：殆难克乎？”","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":108,"anchor":null},"note_id":null,"start":0,"end":96}],"profiles":{},"directory_counts":{}}
