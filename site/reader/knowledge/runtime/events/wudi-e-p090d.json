{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p090d","title":"曹操自述征都尉迁典军校尉","accounts":[{"id":"wudi-e-p090d-account","label":"《魏武故事》所载令文","text":"令文回叙征都尉、迁典军校尉，希望讨贼立功封侯。","evidence":["wudi-e-p090d-q"]}],"participants":[{"person":"cao-cao","role":"自述","evidence":["wudi-e-p090d-q"]}],"place":null,"time":{"label":"退居后","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p090d-q"]},"source_order":[1,724,"P090d"],"order":300}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-p090d-q","section":"chapter-001","block":"b-2caf3e4f7e42b9fcda41","layer":"pei","quote":"然不能得如意，后征为都尉，迁典军校尉。意遂更欲为国家讨贼立功，欲望封侯作征西将军，然后题墓道言‘汉故征西将军曹侯之墓’，此其志也！","attribution":"《魏武故事》所载令文","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":48,"anchor":null},"note_id":"n-e46e3191255096f1e405","start":201,"end":266}],"profiles":{},"directory_counts":{}}
