{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"guanzhang-e-p005a","title":"关羽劝刘备猎中杀曹操刘备不从后在夏口追论","accounts":[{"id":"guanzhang-e-p005a-account","label":"《蜀记》","text":"关羽劝刘备猎中杀曹操刘备不从后在夏口追论","evidence":["guanzhang-e-p005a-q"]},{"id":"guanzhang-a-p006-judgment","label":"裴松之论","text":"裴松之以刘备曾与董承结谋等质疑为国家惜曹的解释，认为或因仓促不可行而止。","evidence":["guanzhang-q-p006-judgment"]}],"participants":[{"person":"wudi-p0172","role":"献策追论","evidence":["guanzhang-e-p005a-q"]},{"person":"liu-bei","role":"不纳追论","evidence":["guanzhang-e-p005a-q"]}],"place":null,"time":{"label":"许田共猎与夏口时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["guanzhang-e-p005a-q"]},"ordering_evidence":"guanzhang-e-p005a-q","source_order":[36,34,"P005a"],"order":6852}],"persons":[{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"wudi-p0172","name":"关羽","facts":[],"aliases":[]}],"evidence":[{"id":"guanzhang-e-p005a-q","section":"chapter-036","block":"b-688db24b1c0d42f2ba87","layer":"pei","quote":"﹝一﹞《蜀记》曰：“初，刘备在许，与曹公共猎。猎中，众散，羽劝备杀公；备不从。及在夏口，飘摇江渚。羽怒曰：‘往日猎中，若从羽言，可无今日之困！’备曰：‘是时亦为国家惜之耳；若天道辅正，安知此不为福邪！’”","attribution":"《蜀记》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":33,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6f26254c4fa6d4284f43","start":0,"end":102,"offset_unit":"unicode_code_point"},{"id":"guanzhang-q-p006-judgment","section":"chapter-036","block":"b-6e874b1fd0bdb9bb227a","layer":"pei","quote":"臣松之以为：备后与董承等结谋，但事泄不克谐耳；若为国家惜曹公，其如此言何！羽若果有此劝而备不肯从者，将以曹公腹心亲戚，实繁有徒，事不宿构，非造次所行；曹虽可杀，身必不免：故以计而止，何惜之有乎！既往之事，故托为雅言耳。","attribution":"裴松之论","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":34,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6f26254c4fa6d4284f43","start":0,"end":109,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
