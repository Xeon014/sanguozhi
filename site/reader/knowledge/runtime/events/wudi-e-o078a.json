{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o078a","title":"孙策谋袭许未发遇刺","accounts":[{"id":"wudi-e-o078a-account","label":"正文","text":"孙策闻曹袁相持而谋袭许，未出发即被刺客杀死。","evidence":["wudi-e-o078a-q"]},{"id":"sunshi-e-o034a-account","label":"《孙破虏讨逆传第一》正文","text":"孙策闻曹操袁绍官渡相拒密谋袭许未发遇害","evidence":["sunshi-e-o034a-q"]},{"id":"sunshi-a-p056-judgment","label":"孙盛《异同评》","text":"孙盛质疑孙策在当时形势下袭许迎帝说，支持伐陈登；并指出曹操征柳城在建安十二年，与孙策建安五年卒相矛盾。","evidence":["sunshi-q-p056-judgment"]},{"id":"sunshi-a-p057-judgment","label":"裴松之按语","text":"裴松之同驳柳城误年，但不同意孙盛否定袭许谋划；认为当先图陈登而志不止登，并以魏武纪官渡驻军驳时间疑问。","evidence":["sunshi-q-p057-judgment"]},{"id":"sunshi-e-o035c-account","label":"《孙破虏讨逆传第一》正文","text":"孙策其夜卒年二十六","evidence":["sunshi-e-o035c-q"]},{"id":"sunshi-e-p058a-account","label":"《吴历》","text":"吴历记孙策照镜捶几创裂当夜卒","evidence":["sunshi-e-p058a-q"]},{"id":"sunshi-e-p058b-account","label":"《搜神记》","text":"《搜神记》称孙策杀于吉后常见其幻象，照镜见于吉，扑镜创裂而死。","evidence":["sunshi-e-p058b-q"]},{"id":"chengguo-a-c01d14b4e8f3eb839892","label":"正文","text":"策临江未济果为许贡客所杀","evidence":["chengguo-q-cdb15e5b46ef7ecd2519"]}],"participants":[{"person":"wudi-p0099","role":"拟袭许而遇刺","evidence":["wudi-e-o078a-q"]},{"person":"cao-cao","role":"相拒","evidence":["sunshi-e-o034a-q"]},{"person":"wudi-p0052","role":"相拒","evidence":["sunshi-e-o034a-q"]}],"place":{"text":"许","evidence":["wudi-e-o078a-q"]},"time":{"label":"建安五年","year":200,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o078a-q","wudi-q-o071","wudi-q-b-9900125064e5d85f08ad"],"chronology":"wudi-y200","dating_review":{"anchor":"wudi-q-o071","basis":"建安五年","reviewed":true}},"source_order":[1,435,"O078a"],"related_events":[{"event":"sunshi-e-p055a","type":"alternative","evidence":["sunshi-e-p055a-q","wudi-e-o078a-q"]}],"order":186},{"id":"sunshi-e-p055a","title":"九州春秋称孙策闻曹操北征自号大司马欲袭许而遇难","accounts":[{"id":"sunshi-e-p055a-account","label":"《九州春秋》","text":"九州春秋称孙策闻曹操北征自号大司马欲袭许而遇难","evidence":["sunshi-e-p055a-q"]}],"participants":[{"person":"wudi-p0099","role":"谋袭遇害","evidence":["sunshi-e-p055a-q"]}],"place":null,"time":{"label":"《九州春秋》所称曹操北征柳城时（与孙策卒年不合）","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["sunshi-e-p055a-q"]},"ordering_evidence":"sunshi-e-p055a-q","source_order":[46,284,"P055a"],"related_events":[{"event":"wudi-e-o078a","type":"alternative","evidence":["sunshi-e-p055a-q","wudi-e-o078a-q"]}],"order":8143}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0052","name":"袁绍","facts":[],"aliases":[]},{"id":"wudi-p0099","name":"孙策","facts":[],"aliases":[]}],"evidence":[{"id":"chengguo-q-cdb15e5b46ef7ecd2519","section":"chapter-014","block":"b-b9a83efbddfd4d240dd3","layer":"original","quote":"策临江，未济，果为许贡客所杀","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":110,"anchor":null},"note_id":null,"start":118,"end":132},{"id":"sunshi-e-o034a-q","section":"chapter-046","block":"b-8480cc17db549540a4f6","layer":"original","quote":"建安五年，曹公与袁绍相拒于官渡〖1〗。策阴欲袭许〖2〗，迎汉帝〖3〗；﹝一﹞密治兵，部署诸将。未发，会为故吴郡太守许贡客所杀〖4〗。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":260,"anchor":null},"note_id":null,"start":0,"end":66},{"id":"sunshi-e-o035c-q","section":"chapter-046","block":"b-18e349ce1607f40f98f6","layer":"original","quote":"至夜卒，时年二十六。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":261,"anchor":null},"note_id":null,"start":156,"end":166},{"id":"sunshi-e-p055a-q","section":"chapter-046","block":"b-247a36af3557ce653040","layer":"pei","quote":"《九州春秋》曰：“策闻曹公北征柳城，悉起江南之众，自号‘大司马’，将北袭许；恃其勇，行不设备，故及于难。”","attribution":"《九州春秋》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":283,"anchor":null},"note_id":"n-26c0935904b6bc636b31","start":0,"end":53},{"id":"sunshi-e-p058a-q","section":"chapter-046","block":"b-a4492bbeb38f8764800c","layer":"pei","quote":"策既被创，医言可治；当好自将护，百日勿动。策引镜自照，谓左右曰：‘面如此，尚可复建功立事乎！’（推）〔捶〕几大奋，创皆分裂，（须臾）〔其夜〕卒。","attribution":"《吴历》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":286,"anchor":null},"note_id":"n-c505787bb2c6dafdcb0c","start":10,"end":82},{"id":"sunshi-e-p058b-q","section":"chapter-046","block":"b-a4492bbeb38f8764800c","layer":"pei","quote":"策既杀于吉，每独坐，仿佛见吉在左右；意深恶之，颇有失常。后治创方差，而引镜自照。见吉在镜中，顾而弗见，如是再三；因扑镜大叫，创皆崩裂，须臾而死。","attribution":"《搜神记》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":286,"anchor":null},"note_id":"n-c505787bb2c6dafdcb0c","start":91,"end":163},{"id":"sunshi-q-p056-judgment","section":"chapter-046","block":"b-966d90f694cd8ad2a5c6","layer":"pei","quote":"孙盛《异同评》曰：“凡此数书，各有所失。孙策虽威行江外，略有六郡；然黄祖乘其上流，陈登间其心腹；且深险强宗，未尽归复；曹、袁虎争，势倾山海：策岂暇远师汝、颍，而迁帝于吴、越哉！斯盖庸人之所鉴见，况策达于事势者乎？又按袁绍以建安五年至黎阳，而策以四月遇害；而《志》云策闻曹公与绍相拒于官渡，谬矣！伐登之言，为有证也。又《江表传》说策悉识韩当军士，疑此为诈，便射杀一人。夫三军将士，或有新附；策为大将，何能悉识？以所不识，便射杀之，非其论也。又策见杀在五年，柳城之役在十二年，《九州春秋》乖错尤甚矣！”","attribution":"孙盛《异同评》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":284,"anchor":null},"note_id":"n-26c0935904b6bc636b31","start":0,"end":249},{"id":"sunshi-q-p057-judgment","section":"chapter-046","block":"b-0bd05c5ba15e2fa499c7","layer":"pei","quote":"臣松之按：《傅子》亦云曹公征柳城，将袭许。记述若斯，何其疏哉！然孙盛所讥，未为悉是。黄祖始被策破，魂气未反；但刘表君臣，本无兼并之志，虽在上流，何办规拟吴、会？策之此举，理应先图陈登；但举兵所在，不止登而已。于时强宗骁帅，祖郎、严虎之徒，擒灭已尽；所余山越，盖何足虑？然则策之所规，未可谓之不暇也。若使策志获从，大权在手；淮、泗之间，所在皆可都；何必毕志江外，其当迁帝于扬、越哉！按《魏武纪》，武帝以建安四年已出屯官渡，乃策未死之前，久与袁绍交兵，则《国志》所云不为谬也。许贡客，无闻之小人；而能感识恩遇，临义忘生，猝然奋发，有侔古烈矣。《诗》云：“君子有徽猷，小人与属。”贡客其有焉。","attribution":"裴松之按语","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":285,"anchor":null},"note_id":"n-26c0935904b6bc636b31","start":0,"end":293},{"id":"wudi-e-o078a-q","section":"chapter-001","block":"b-1a4793df0505fd3101f2","layer":"original","quote":"孙策闻公与绍相持，乃谋袭许；未发，为刺客所杀。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":434,"anchor":null},"note_id":null,"start":0,"end":23},{"id":"wudi-q-b-9900125064e5d85f08ad","section":"chapter-001","block":"b-9900125064e5d85f08ad","layer":"modern","quote":"〖1〗五年：建安五年（公元 200）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":403,"anchor":null},"note_id":"n-744e4aee7f5ff14cca85","start":0,"end":19},{"id":"wudi-q-o071","section":"chapter-001","block":"b-c9f735ddad48a8f5c2b6","layer":"original","quote":"五年春正月〖1〗，董承等谋泄，皆伏诛。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":400,"anchor":null},"note_id":null,"start":0,"end":19}],"profiles":{},"directory_counts":{}}
