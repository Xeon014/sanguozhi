{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o102a","title":"张燕率十余万众降曹","accounts":[{"id":"wudi-e-o102a-account","label":"正文","text":"张燕率十余万部众投降，被封列侯。","evidence":["wudi-e-o102a-q"]},{"id":"gongsuntao-a-8b749e5bef1366a51e9b","label":"正文","text":"燕遣使求佐王师拜平北将军封安国亭侯","evidence":["gongsuntao-q-9a87ca7765a535739c8d"]}],"participants":[{"person":"wudi-p0224","role":"投降","evidence":["wudi-e-o102a-q"]},{"person":"cao-cao","role":"受降","evidence":["wudi-e-o102a-q"]}],"place":null,"time":{"label":"建安十年夏四月","year":205,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o102a-q","wudi-q-o100","wudi-q-b-2e98e13ca098117a86e9"],"chronology":"wudi-y205","dating_review":{"anchor":"wudi-q-o100","basis":"建安十年夏四月","reviewed":true}},"source_order":[1,575,"O102a"],"order":236}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0224","name":"张燕","facts":[],"aliases":[]}],"evidence":[{"id":"gongsuntao-q-9a87ca7765a535739c8d","section":"chapter-008","block":"b-b624e6a80e58d2bc431a","layer":"original","quote":"太祖将定冀州，燕遣使求佐王师，拜平北将军〖5〗。率众诣邺，封安国亭侯，邑五百户","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":239,"anchor":null},"note_id":null,"start":63,"end":102},{"id":"wudi-e-o102a-q","section":"chapter-001","block":"b-dd716ed320738744aced","layer":"original","quote":"夏四月，黑山贼张燕率其众十余万降〖1〗，封为列侯。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":574,"anchor":null},"note_id":null,"start":0,"end":25},{"id":"wudi-q-b-2e98e13ca098117a86e9","section":"chapter-001","block":"b-2e98e13ca098117a86e9","layer":"modern","quote":"〖1〗十年：建安十年（公元 205）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":560,"anchor":null},"note_id":"n-a9b0434ee8de64aed40f","start":0,"end":19},{"id":"wudi-q-o100","section":"chapter-001","block":"b-1ca17316b02d7b4d213c","layer":"original","quote":"十年春正月〖1〗，攻谭，破之。斩谭，诛其妻子〖2〗，冀州平。﹝一﹞下令曰：“其与袁氏同恶者，与之更始〖3〗。”令民不得复私仇，禁厚葬；皆一之于法〖4〗。是月，袁熙大将焦触、张南等叛〖5〗，攻熙、尚；熙、尚奔三郡乌丸〖6〗。触等举其县降，封为列侯。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":557,"anchor":null},"note_id":null,"start":0,"end":123}],"profiles":{},"directory_counts":{}}
