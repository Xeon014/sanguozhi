{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zongshi-e-o115","title":"权在武昌欲还都建业，虑水道溯流二千里一旦有警不相赴及；及至夏口，于坞中大会百官议之，诏曰：诸将吏勿拘位任，其有计者为国言之","accounts":[{"id":"zongshi-a-b199a2474583910793d1","label":"裴注·江表传","text":"权在武昌欲还都建业，虑水道溯流二千里一旦有警不相赴及；及至夏口，于坞中大会百官议之，诏曰：诸将吏勿拘位任，其有计者为国言之","evidence":["zongshi-q-3562e22a53d3c2631e0a"]},{"id":"zongshi-a-c8a4ab4d7425d423a98b","label":"裴注·江表传","text":"诸将或陈宜立栅栅夏口，或言宜重设铁锁，权皆以为非计","evidence":["zongshi-q-6f86ebcf02f88125f07c"]},{"id":"zongshi-a-55f0ae4ebd76297b70b9","label":"裴注·江表传","text":"时梁为小将未有知名，乃越席而进献策：宜明树赏罚之信，遣将入沔与敌争利；使武昌有精兵万人付智略者任将，作甘水城、轻舰数千，开门延敌，敌自不来","evidence":["zongshi-q-59bdf278dafeec71ea61"]},{"id":"zongshi-a-787d2b68ec8135800413","label":"裴注·江表传","text":"权以梁计为最得，即超增梁位；后稍以功进，至沔中督","evidence":["zongshi-q-f499704d9e24afec9b7d"]}],"participants":[{"person":"sun-quan","role":"大会议都者；以为非计者；听计者（背景）；超增其位者","evidence":["zongshi-q-3562e22a53d3c2631e0a","zongshi-q-6f86ebcf02f88125f07c","zongshi-q-59bdf278dafeec71ea61","zongshi-q-f499704d9e24afec9b7d"]},{"person":"zongshi-p0039","role":"越席献策者；受超进至沔中督者","evidence":["zongshi-q-59bdf278dafeec71ea61","zongshi-q-f499704d9e24afec9b7d"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["zongshi-q-3562e22a53d3c2631e0a","zongshi-q-6f86ebcf02f88125f07c","zongshi-q-59bdf278dafeec71ea61","zongshi-q-f499704d9e24afec9b7d"]},"ordering_evidence":"zongshi-q-3562e22a53d3c2631e0a","source_order":[51,93,11],"order":9150}],"persons":[{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"zongshi-p0039","name":"张梁（河南）","facts":[],"aliases":[]}],"evidence":[{"id":"zongshi-q-3562e22a53d3c2631e0a","section":"chapter-051","block":"b-49397200f0ee394cf60d","layer":"pei","quote":"初，权在武昌，欲还都建业；而虑水道溯流二千里，一旦有警，不相赴及：以此怀疑。及至夏口，于坞中大会百官，议之，诏曰：‘诸将吏勿拘位任，其有计者，为国言之","attribution":"裴注·江表传","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":92,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ff47dc95c4bca175dc07","start":11,"end":86,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-59bdf278dafeec71ea61","section":"chapter-051","block":"b-49397200f0ee394cf60d","layer":"pei","quote":"时梁为小将，未有知名；乃越席而进曰：‘臣闻香饵引泉鱼，重币购勇士。今宜明树赏罚之信，遣将入沔，与敌争利；形势既成，彼不敢干也。使武昌有精兵万人，付智略者任将，常使严整；一旦有警，应声相赴。作甘水城，轻舰数千，诸所宜用，皆使备具。如此，开门延敌，敌自不来矣","attribution":"裴注·江表传","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":92,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ff47dc95c4bca175dc07","start":120,"end":247,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-6f86ebcf02f88125f07c","section":"chapter-051","block":"b-49397200f0ee394cf60d","layer":"pei","quote":"诸将或陈‘宜立栅，栅夏口’，或言‘宜重设铁锁’者：权皆以为非计","attribution":"裴注·江表传","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":92,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ff47dc95c4bca175dc07","start":88,"end":119,"offset_unit":"unicode_code_point"},{"id":"zongshi-q-f499704d9e24afec9b7d","section":"chapter-051","block":"b-49397200f0ee394cf60d","layer":"pei","quote":"权以梁计为最得，即超增梁位。后稍以功进，至沔中督","attribution":"裴注·江表传","section_title":"宗室传第六","source":{"file":"OEBPS/Text/titlepage_0109.xhtml","index":92,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ff47dc95c4bca175dc07","start":249,"end":273,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
