{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"mingdi-e-o018b","title":"卞太皇太后去世","accounts":[{"id":"mingdi-e-o018b-account","label":"《明帝纪》正文","text":"卞太皇太后去世","evidence":["mingdi-e-o018b-q"]},{"id":"houfei-e-o013a-account","label":"《后妃传》正文","text":"〔六〕月：卞太后去世","evidence":["houfei-e-o013a-q"]}],"participants":[{"person":"wudi-p0388","role":"崩","evidence":["mingdi-e-o018b-q"]}],"place":null,"time":{"year":230,"label":"六月戊子","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"mingdi-y230","dating_review":{"reviewed":true,"anchor":"mingdi-q-o017","basis":"六月戊子"},"evidence":["mingdi-e-o018b-q","mingdi-q-o017","mingdi-q-b-bb76480af553d2282673"]},"ordering_evidence":"mingdi-e-o018b-q","source_order":[3,127,"O018b"],"order":774}],"persons":[{"id":"wudi-p0388","name":"卞夫人","facts":[],"aliases":[]}],"evidence":[{"id":"houfei-e-o013a-q","section":"chapter-005","block":"b-4a6bb117707eb5858fd7","layer":"original","quote":"其年（五）〔六〕月，后崩。七月，合葬高陵。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":45,"anchor":null},"note_id":null,"start":0,"end":21},{"id":"mingdi-e-o018b-q","section":"chapter-003","block":"b-ab109b103f22d564b262","layer":"original","quote":"夏四月，太傅钟繇薨。六月，戊子〖14〗，太皇太后崩。丙申〖15〗，省上庸郡。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":126,"anchor":null},"note_id":null,"start":0,"end":38},{"id":"mingdi-q-b-bb76480af553d2282673","section":"chapter-003","block":"b-bb76480af553d2282673","layer":"modern","quote":"〖1〗四年：太和四年（公元 230）。壬午：旧历初四日。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":130,"anchor":null},"note_id":"n-49a340791b1e7816a21a","start":0,"end":28},{"id":"mingdi-q-o017","section":"chapter-003","block":"b-cbdedf2111b567dd6b4d","layer":"original","quote":"四年春二月，壬午〖1〗，诏曰：“世之质文〖2〗，随教而变。兵乱以来，经学废绝；后生进趣，不由典谟〖3〗。岂〔朕〕训导未洽〖4〗，将进用者不以德显乎〖5〗？其郎吏学通一经〖6〗，才任牧民；博士课试，擢其高第者〖7〗：亟用〖8〗。其浮华不务道本者〖9〗，皆罢退之。”戊子〖10〗，诏太傅、三公：“以文帝《典论》刻石〖11〗，立于庙门之外。”癸巳〖12〗，以大将军曹真为大司马，骠骑将军司马宣王为大将军，辽东太守公孙渊为车骑将军〖13〗。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":125,"anchor":null},"note_id":null,"start":0,"end":216}],"profiles":{},"directory_counts":{}}
