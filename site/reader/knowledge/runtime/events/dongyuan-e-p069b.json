{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dongyuan-e-p069b","title":"袁绍麹义界桥战破公孙瓒斩严纲追拔营","accounts":[{"id":"dongyuan-e-p069b-account","label":"《英雄记》","text":"袁绍麹义界桥战破公孙瓒斩严纲追拔营","evidence":["dongyuan-e-p069b-q"]},{"id":"gongsuntao-a-cf01c5f598e6412e845c","label":"正文","text":"绍军广宗令麹义先登与瓒战生擒严纲","evidence":["gongsuntao-q-a3300d797c003993c578"]}],"participants":[{"person":"wudi-p0052","role":"统军","evidence":["dongyuan-e-p069b-q"]},{"person":"dongyuan-p0116","role":"破军","evidence":["dongyuan-e-p069b-q"]},{"person":"wudi-p0093","role":"战败","evidence":["dongyuan-e-p069b-q"]},{"person":"dongyuan-p0117","role":"被斩","evidence":["dongyuan-e-p069b-q"]},{"person":"wuzhu-p0104","role":"被生擒","evidence":["gongsuntao-q-a3300d797c003993c578"]}],"place":null,"time":{"label":"界桥及冀州诸战时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-p069b-q"]},"ordering_evidence":"dongyuan-e-p069b-q","source_order":[6,277,"P069b"],"order":1644}],"persons":[{"id":"dongyuan-p0116","name":"麹义","facts":[],"aliases":[]},{"id":"dongyuan-p0117","name":"严纲（公孙瓒所置冀州刺史）","facts":[],"aliases":[]},{"id":"wudi-p0052","name":"袁绍","facts":[],"aliases":[]},{"id":"wudi-p0093","name":"公孙瓒","facts":[],"aliases":[]},{"id":"wuzhu-p0104","name":"严纲","facts":[],"aliases":[]}],"evidence":[{"id":"dongyuan-e-p069b-q","section":"chapter-006","block":"b-e78509101d005195918b","layer":"pei","quote":"绍自往征瓒，合战于界桥南二十里。瓒步兵三万余人，为方阵；骑为两翼，左右各五千余匹；白马义从为中坚，亦分作两校；左射右，右射左；旌旗铠甲，光照天地。绍令麹义以八百兵为先登；强弩千张夹承之；绍自以步兵数万，结阵于后。义久在凉州，晓习羌斗，兵皆骁锐。瓒见其兵少，便放骑欲陵蹈之。义兵皆伏盾下不动，未至数十步，乃同时俱起；扬尘大叫，直前冲突；强弩雷发，所中必倒。临阵斩瓒所署冀州刺史严纲，甲首千余级。瓒军败绩，步骑奔走，不复还营。义追至界桥，瓒殿兵还战桥上，义复破之。遂到瓒营，拔其牙门；营中余众，皆复散走。","attribution":"《英雄记》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":276,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-14470fffeafe6a651893","start":52,"end":302,"offset_unit":"unicode_code_point"},{"id":"gongsuntao-q-a3300d797c003993c578","section":"chapter-008","block":"b-b2ad847988834f852565","layer":"original","quote":"绍军广（川）〔宗〕〖12〗，令将麹义先登与瓒战〖13〗，生擒纲","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":50,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":164,"end":195,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
