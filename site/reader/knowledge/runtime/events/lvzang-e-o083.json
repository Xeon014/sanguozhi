0"]},{"id":"lvzang-a-2decd37ef4dd022ed879","label":"正文","text":"邈诣袁术请救未至自为其兵所杀","evidence":["lvzang-q-eafaf45beebfde593b67"]}],"participants":[{"person":"cao-cao","role":"平州东略","evidence":["wudi-e-o038b-q"]},{"person":"wudi-p0111","role":"自杀","evidence":["wudi-e-o038b-q"]},{"person":"wudi-p0062","role":"求救被杀","evidence":["wudi-e-o038b-q"]},{"person":"wudi-p0057","role":"求救对象","evidence":["wudi-e-o038b-q"]},{"person":"zhangle-p0013","role":"留将家属屯雍丘、及其家被斩","evidence":["lvzang-q-952b88d657488aeea7e0"]}],"place":{"text":"雍丘、兖州、陈地","evidence":["wudi-e-o038b-q"]},"time":{"label":"兴平二年十二月","year":195,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o038b-q","wudi-q-o035","wudi-q-b-927979d68d5dacfd36fe"],"chronology":"wudi-y195","dating_review":{"anchor":"wudi-q-o035","basis":"兴平二年十二月","reviewed":true}},"source_order":[1,244,"O038b"],"order":113}],"persons":[{"id":"shaodi-p0003","name":"裴松之","facts":[],"aliases":[]}],"evidence":[{"id":"lvzang-q-588f0035c09bfb112949","section":"chapter-007","block":"b-62f7f5dcfd162116529d","layer":"pei","quote":"袁术议称尊号，邈谓术曰：‘汉据火德，绝而复扬；德泽丰流，诞生明公。公居轴处中，入则享于上席，出则为众目之所属；华、霍不能增其高，渊泉不能同其量；可谓巍巍荡荡，无与为贰。何为舍此而欲称制？恐福不盈眦，祸将溢世。庄周之称郊祭牺牛，养饲经年，衣以文绣；宰执鸾刀，以入庙门，当此之时，求为孤犊不可得也","attribution":"裴注·献帝春秋","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":62,"anchor":null},"note_id":"n-48cd8d29043f5cbaa6c1","start":12,"end":158},{"id":"lvzang-q-6b4c6091c05f96923297","section":"chapter-007","block":"b-62f7f5dcfd162116529d","layer":"pei","quote":"按《本传》“邈诣术，未至而死”。而此云谏称尊号，未详孰是","attribution":"裴注·注家按语","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":62,"anchor":null},"note_id":"n-48cd8d29043f5cbaa6c1","start":161,"end":189},{"id":"lvzang-q-952b88d657488aeea7e0","section":"chapter-007","block":"b-8e996afd8217efe1b488","layer":"original","quote":"邈从布，留超将家属屯雍丘。太祖攻围数月，屠之，斩超及其家","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":46,"anchor":null},"note_id":null,"start":0,"end":28}],"profiles":{},"directory_counts":{}}
