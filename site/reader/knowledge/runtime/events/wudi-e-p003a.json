{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p003a","title":"曹节让豕与邻人","accounts":[{"id":"wudi-e-p003a-account","label":"《续汉书》","text":"邻人误认曹节家的猪，曹节不争；失猪归来后，邻人将误认之猪送还并道歉。","evidence":["wudi-e-p003a-q"]}],"participants":[{"person":"wudi-p0012","role":"让豕受谢","evidence":["wudi-e-p003a-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p003a-q"]},"source_order":[1,15,"P003a"],"order":3}],"persons":[{"id":"wudi-p0012","name":"曹节（曹腾父）","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-p003a-q","section":"chapter-001","block":"b-5e6a7e419a7747bd1cda","layer":"pei","quote":"腾父节，字元伟。素以仁厚称。邻人有亡豕者，与节豕相类，诣门认之，节不与争。后所亡豕自还其家，豕主人大惭。送所认豕，并辞谢节，节笑而受之。由是乡党贵叹焉。","attribution":"《续汉书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":14,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-2c3453013ec854037801","start":14,"end":90,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
