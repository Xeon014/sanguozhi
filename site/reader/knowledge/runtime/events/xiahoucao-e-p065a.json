{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xiahoucao-e-p065a","title":"许允与崔赞有名召军曹叡时与袁侃共罪侃受重允复仕","accounts":[{"id":"xiahoucao-e-p065a-account","label":"《魏略》","text":"许允与崔赞有名召军曹叡时与袁侃共罪侃受重允复仕","evidence":["xiahoucao-e-p065a-q"]}],"participants":[{"person":"shaodi-p0069","role":"仕进受刑复官","evidence":["xiahoucao-e-p065a-q"]},{"person":"shaodi-p0091","role":"有名","evidence":["xiahoucao-e-p065a-q"]},{"person":"xunyu-p0061","role":"代受重","evidence":["xiahoucao-e-p065a-q"]}],"place":null,"time":{"label":"许允少至嘉平六年冬","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xiahoucao-e-p065a-q"]},"ordering_evidence":"xiahoucao-e-p065a-q","source_order":[9,637,"P065a"],"order":2368}],"persons":[{"id":"shaodi-p0069","name":"许允","facts":[],"aliases":[]},{"id":"shaodi-p0091","name":"崔赞","facts":[],"aliases":[]},{"id":"xunyu-p0061","name":"袁侃","facts":[],"aliases":[]}],"evidence":[{"id":"xiahoucao-e-p065a-q","section":"chapter-009","block":"b-f1ab0fb4442e4014299b","layer":"pei","quote":"允字士宗。世冠族。父据，仕历典农校尉、郡守。允少与同郡崔赞，俱发名于冀州，召入军。明帝时，为尚书选曹郎，与陈国袁侃对；同坐职事，皆收送狱。诏旨严切，当有死者；正直者为重。允谓侃曰：‘卿，功臣之子，法应八议，不忧死也。’侃知其指，乃为受重。允刑竟，复吏，出为郡守。稍迁为侍中，尚书，中领军。","attribution":"《魏略》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":636,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0f3b23485549690803dc","start":10,"end":154,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
