{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p094a","title":"曹操答议者不惧关西长矛","accounts":[{"id":"wudi-e-p094a-account","label":"《魏书》","text":"《魏书》记议者忧关西长矛兵，曹操表示可使其无法施展。","evidence":["wudi-e-p094a-q"]}],"participants":[{"person":"cao-cao","role":"战前议论","evidence":["wudi-e-p094a-q"]}],"place":null,"time":{"label":"关西战前","year":211,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-p094a-q","wudi-q-o128","wudi-q-b-2dc1a34b174874acae8b"],"chronology":"wudi-y211","dating_review":{"anchor":"wudi-q-o128","basis":"关西战前","reviewed":true}},"source_order":[1,774,"P094a"],"order":320}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-p094a-q","section":"chapter-001","block":"b-5998c2f419a30223ca8b","layer":"pei","quote":"﹝一﹞《魏书》曰：“议者多言‘关西兵强，习长矛，非精选前锋，则不可以当也’。公谓诸将曰：‘战在我，非在贼也。贼虽习长予，将使不得以刺。诸君但观之耳。’”","attribution":"《魏书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":98,"anchor":null},"note_id":"n-b2f8e79e6489909161d2","start":0,"end":76},{"id":"wudi-q-b-2dc1a34b174874acae8b","section":"chapter-001","block":"b-2dc1a34b174874acae8b","layer":"modern","quote":"〖1〗十六年：建安十六年（公元 211）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":54,"anchor":null},"note_id":"n-889c5acff5776ef2f54b","start":0,"end":21},{"id":"wudi-q-o128","section":"chapter-001","block":"b-37e542ccc37d1632e170","layer":"original","quote":"十六年春正月〖1〗，﹝一﹞天子命公世子丕为五官中郎将〖2〗，置官属〖3〗；为丞相副。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":51,"anchor":null},"note_id":null,"start":0,"end":42}],"profiles":{},"directory_counts":{}}
