{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"shaodi-e-o143a","title":"司马孚司马昭高柔郑冲请王礼葬曹髦","accounts":[{"id":"shaodi-e-o143a-account","label":"《三少帝纪》正文","text":"司马孚司马昭高柔郑冲请王礼葬曹髦","evidence":["shaodi-e-o143a-q"]}],"participants":[{"person":"shaodi-p0036","role":"上奏","evidence":["shaodi-e-o143a-q"]},{"person":"shaodi-p0045","role":"上奏","evidence":["shaodi-e-o143a-q"]},{"person":"shaodi-p0017","role":"上奏","evidence":["shaodi-e-o143a-q"]},{"person":"shaodi-p0039","role":"上奏","evidence":["shaodi-e-o143a-q"]}],"place":null,"time":{"year":260,"label":"五月庚寅","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"shaodi-y260","dating_review":{"reviewed":true,"anchor":"shaodi-q-o139","basis":"五月庚寅"},"evidence":["shaodi-e-o143a-q","shaodi-q-o139","shaodi-q-b-77066dd061eb6a338ffa"]},"ordering_evidence":"shaodi-e-o143a-q","source_order":[4,673,"O143a"],"order":1237}],"persons":[{"id":"shaodi-p0017","name":"高柔","facts":[],"aliases":[]},{"id":"shaodi-p0036","name":"司马孚","facts":[],"aliases":[]},{"id":"shaodi-p0039","name":"郑冲","facts":[],"aliases":[]},{"id":"shaodi-p0045","name":"司马昭","facts":[],"aliases":[]}],"evidence":[{"id":"shaodi-e-o143a-q","section":"chapter-004","block":"b-ca5609dad1999299bf77","layer":"original","quote":"庚寅〖1〗，太傅孚、大将军文王、太尉柔、司徒冲稽首言：“伏见中令〖2〗：故高贵乡公悖逆不道，自陷大祸；依汉昌邑王罪废故事，以民礼葬。臣等备位〖3〗，不能匡救祸乱，式遏奸逆；奉令震悚，肝心悼栗。《春秋》之义，‘王者无外’〖4〗，而书襄王‘出居于郑’〖5〗；不能事母，故绝之于位也。今高贵乡公肆行不轨，几危社稷；自取倾覆，人神所绝：葬以民礼，诚当旧典。然臣等伏惟殿下仁慈过隆，虽存大义，犹垂哀矜；臣等之心，实有不忍，以为可加恩，以王礼葬之。”","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":80,"anchor":null},"note_id":null,"start":0,"end":219},{"id":"shaodi-q-b-77066dd061eb6a338ffa","section":"chapter-004","block":"b-77066dd061eb6a338ffa","layer":"modern","quote":"〖1〗五年：甘露五年（公元 260 ）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":50,"anchor":null},"note_id":"n-21e90e29c9fd438bba21","start":0,"end":20},{"id":"shaodi-q-o139","section":"chapter-004","block":"b-c33fc441ae4a3de17fb6","layer":"original","quote":"五年春正月朔〖1〗，日有食之。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":45,"anchor":null},"note_id":null,"start":0,"end":15}],"profiles":{},"directory_counts":{}}
