{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wuzhu-e-o062a","title":"孙权遣郑泉聘刘备复通及改夷陵西陵","accounts":[{"id":"wuzhu-e-o062a-account","label":"《吴主传第二》正文","text":"孙权遣郑泉聘刘备复通及改夷陵西陵","evidence":["wuzhu-e-o062a-q"]}],"participants":[{"person":"sun-quan","role":"遣使","evidence":["wuzhu-e-o062a-q"]},{"person":"wuzhu-p0032","role":"奉使","evidence":["wuzhu-e-o062a-q"]},{"person":"liu-bei","role":"受聘","evidence":["wuzhu-e-o062a-q"]}],"place":null,"time":{"year":222,"label":"十二月","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"wuzhu-y222","dating_review":{"reviewed":true,"anchor":"wuzhu-q-o054","basis":"十二月"},"evidence":["wuzhu-e-o062a-q","wuzhu-q-o054","guanzhang-q-o034","guanzhang-q-b-be58a15ce144f67b67a5"]},"ordering_evidence":"wuzhu-e-o062a-q","source_order":[47,302,"O062a"],"order":8226}],"persons":[{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"wuzhu-p0032","name":"郑泉","facts":[],"aliases":[]}],"evidence":[{"id":"guanzhang-q-b-be58a15ce144f67b67a5","section":"chapter-036","block":"b-be58a15ce144f67b67a5","layer":"modern","quote":"〖13〗二年：章武二年（公元 222）。马超的祠墓遗址，相传在今四川成都市新都区城南的马超小学内，曾有墓碑出土。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":158,"anchor":null},"note_id":"n-1fcace810489e51a4218","start":0,"end":56},{"id":"guanzhang-q-o034","section":"chapter-036","block":"b-7ddd1fa08ce5c9feb1d4","layer":"original","quote":"二年卒〖13〗，时年四十七。临没上疏曰：“臣门宗二百余口〖14〗，为孟德所诛略尽〖15〗；惟有从弟岱，当为微宗血食之继〖16〗，深托陛下。余无复言。”","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":143,"anchor":null},"note_id":null,"start":0,"end":75},{"id":"wuzhu-e-o062a-q","section":"chapter-047","block":"b-5f35a3c3bd9914998e9c","layer":"original","quote":"十二月，权使太中大夫郑泉，聘刘备于白帝〖35〗，始复通也。﹝五﹞然犹与魏文帝相往来，至后年乃绝。是岁，改夷陵为西陵。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":301,"anchor":null},"note_id":null,"start":0,"end":58},{"id":"wuzhu-q-o054","section":"chapter-047","block":"b-7e0fdf82962252602cbd","layer":"original","quote":"黄武元年春正月〖1〗，陆逊部将军宋谦等〖2〗，攻蜀五屯；皆破之，斩其将。三月，鄱阳言黄龙现〖3〗。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":293,"anchor":null},"note_id":null,"start":0,"end":49}],"profiles":{},"directory_counts":{}}
