{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-o022b","title":"刘备设伏破夏侯惇于博望","accounts":[{"id":"xianzhu-e-o022b-account","label":"《先主传》正文","text":"刘表使刘备拒夏侯惇、于禁，刘备自烧屯营佯退，以伏兵击破追兵。","evidence":["xianzhu-e-o022b-q"]},{"id":"lizang-a-6839a82e16ba1e9583f2","label":"正文","text":"刘表使刘备北侵至叶","evidence":["lizang-q-17b2f0612b8101024305"]},{"id":"lizang-a-138d35fb4521b7c9e99d","label":"正文","text":"曹操遣李典从夏侯惇拒刘备","evidence":["lizang-q-4c3e570e4be4dfd85595"]},{"id":"lizang-a-efc1768b457ef7965dbe","label":"正文","text":"刘备烧屯退去，夏侯惇率诸军追击","evidence":["lizang-q-b8a5015613a52dd116ad"]},{"id":"lizang-a-c298de2793f7c5e72de9","label":"正文","text":"李典谏贼无故退疑有伏不可追","evidence":["lizang-q-7ae262b22a7161249912"]},{"id":"lizang-a-a39a92eaa0320677aaf3","label":"正文","text":"夏侯惇不听谏与于禁追击，李典留守","evidence":["lizang-q-e1a8a0a6d09177572073"]},{"id":"lizang-a-100fda868d53be3af827","label":"正文","text":"夏侯惇等果入刘备伏中战不利","evidence":["lizang-q-b9c9e29f61c832fbf657"]},{"id":"lizang-a-d6a182544242d0043c35","label":"正文","text":"李典往救，刘备望见救至散退","evidence":["lizang-q-c66b737933256aa560f4"]}],"participants":[{"person":"liu-biao","role":"使拒曹军","evidence":["xianzhu-e-o022b-q"]},{"person":"liu-bei","role":"设伏","evidence":["xianzhu-e-o022b-q"]},{"person":"wudi-p0027","role":"追击败退","evidence":["xianzhu-e-o022b-q"]},{"person":"wudi-p0162","role":"来攻","evidence":["xianzhu-e-o022b-q"]},{"person":"cao-cao","role":"遣典","evidence":["lizang-q-4c3e570e4be4dfd85595"]},{"person":"wudi-p0237","role":"从夏侯惇拒备；谏疑有伏不可追；留守；往救惇等","evidence":["lizang-q-4c3e570e4be4dfd85595","lizang-q-7ae262b22a7161249912","lizang-q-e1a8a0a6d09177572073","lizang-q-c66b737933256aa560f4"]}],"place":{"text":"博望","evidence":["xianzhu-e-o022b-q"]},"time":{"label":"屯新野期间","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xianzhu-e-o022b-q"]},"source_order":[32,94,"O022b"],"order":3614}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"liu-biao","name":"刘表","facts":[],"aliases":[]},{"id":"wudi-p0027","name":"夏侯惇","facts":[],"aliases":[]},{"id":"wudi-p0162","name":"于禁","facts":[],"aliases":[]},{"id":"wudi-p0237","name":"李典","facts":[],"aliases":[]}],"evidence":[{"id":"lizang-q-17b2f0612b8101024305","section":"chapter-018","block":"b-2d2b7f4d5bd4d51b6feb","layer":"original","quote":"刘表使刘备北侵，至叶","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":3,"anchor":null},"note_id":null,"start":0,"end":10},{"id":"lizang-q-4c3e570e4be4dfd85595","section":"chapter-018","block":"b-2d2b7f4d5bd4d51b6feb","layer":"original","quote":"太祖遣典从夏侯惇，拒之","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":3,"anchor":null},"note_id":null,"start":11,"end":22},{"id":"lizang-q-7ae262b22a7161249912","section":"chapter-018","block":"b-2d2b7f4d5bd4d51b6feb","layer":"original","quote":"典曰：“贼无故退，疑必有伏；南道狭窄，草木深：不可追也","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":3,"anchor":null},"note_id":null,"start":41,"end":68},{"id":"lizang-q-b8a5015613a52dd116ad","section":"chapter-018","block":"b-2d2b7f4d5bd4d51b6feb","layer":"original","quote":"备一旦烧屯去〖6〗，惇率诸军追击之","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":3,"anchor":null},"note_id":null,"start":23,"end":40},{"id":"lizang-q-b9c9e29f61c832fbf657","section":"chapter-018","block":"b-2d2b7f4d5bd4d51b6feb","layer":"original","quote":"惇等果入贼伏里，战不利","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":3,"anchor":null},"note_id":null,"start":84,"end":95},{"id":"lizang-q-c66b737933256aa560f4","section":"chapter-018","block":"b-2d2b7f4d5bd4d51b6feb","layer":"original","quote":"典往救，备望见救至，乃散退","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":3,"anchor":null},"note_id":null,"start":96,"end":109},{"id":"lizang-q-e1a8a0a6d09177572073","section":"chapter-018","block":"b-2d2b7f4d5bd4d51b6feb","layer":"original","quote":"惇不听，与于禁追之，典留守","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":3,"anchor":null},"note_id":null,"start":70,"end":83},{"id":"xianzhu-e-o022b-q","section":"chapter-032","block":"b-2d6f229edbd08467d35a","layer":"original","quote":"荆州豪杰归先主者日益多，表疑其心；阴御之，﹝二﹞使拒夏侯惇、于禁等于博望〖8〗。久之，先主设伏兵，一旦自烧屯伪遁〖9〗；惇等追之，为伏兵所破。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":93,"anchor":null},"note_id":null,"start":42,"end":113}],"profiles":{},"directory_counts":{}}
