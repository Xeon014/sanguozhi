{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-o069c","title":"刘备退鱼复改县永安","accounts":[{"id":"xianzhu-e-o069c-account","label":"《先主传》正文","text":"刘备退至秭归收集散兵，弃舟步行回鱼复，改鱼复为永安。","evidence":["xianzhu-e-o069c-q"]},{"id":"huowang-a-cee1116e02ee2c5d4c2e","label":"正文","text":"刘备征吴还永安","evidence":["huowang-q-5af618fce254116f2b87"]}],"participants":[{"person":"liu-bei","role":"退军改县名","evidence":["xianzhu-e-o069c-q"]}],"place":{"text":"秭归、鱼复（永安）","evidence":["xianzhu-e-o069c-q"]},"time":{"year":222,"label":"猇亭败后","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xianzhu-y222","dating_review":{"reviewed":true,"anchor":"xianzhu-q-o068","basis":"猇亭败后"},"evidence":["xianzhu-e-o069c-q","xianzhu-q-o068","xianzhu-q-b-e2b85eacbc16310809ee"]},"source_order":[32,403,"O069c"],"order":6613}],"persons":[{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]}],"evidence":[{"id":"huowang-q-5af618fce254116f2b87","section":"chapter-041","block":"b-f5d2aa43bc3afae2aab6","layer":"original","quote":"先主既称尊号，征吴不克，还住永安","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":121,"anchor":null},"note_id":null,"start":12,"end":28},{"id":"xianzhu-e-o069c-q","section":"chapter-032","block":"b-5398e8ba8cc35262f80d","layer":"original","quote":"先主自猇亭还秭归，收合离散兵；遂弃船舫，由步道还鱼复〖13〗。改鱼复县曰“永安”。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":402,"anchor":null},"note_id":null,"start":51,"end":92},{"id":"xianzhu-q-b-e2b85eacbc16310809ee","section":"chapter-032","block":"b-e2b85eacbc16310809ee","layer":"modern","quote":"〖7〗二年：章武二年（公元 222）。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":413,"anchor":null},"note_id":"n-18295fa1c5ff11c612db","start":0,"end":19},{"id":"xianzhu-q-o068","section":"chapter-032","block":"b-8136daaf302c35b9c188","layer":"original","quote":"二年春正月〖7〗，先主军还秭归；将军吴班、陈式水军屯夷陵，夹江东西岸〖8〗。二月，先主自秭归率诸将进军，缘山截岭，于夷道猇亭﹝二﹞驻营〖9〗。自佷山﹝三﹞通武陵〖10〗，遣侍中马良安慰五溪蛮夷〖11〗，咸相率响应。镇北将军黄权督江北诸军，与吴军相拒于夷陵道。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":401,"anchor":null},"note_id":null,"start":0,"end":129}],"profiles":{},"directory_counts":{}}
