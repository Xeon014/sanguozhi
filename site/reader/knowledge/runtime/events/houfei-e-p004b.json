{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"houfei-e-p004b","title":"魏书称卞太后不为曹植犯法求情","accounts":[{"id":"houfei-e-p004b-account","label":"《魏书》","text":"魏书称卞太后不为曹植犯法求情","evidence":["houfei-e-p004b-q"]},{"id":"houfei-a-p004-dispute","label":"裴松之按","text":"裴松之以周宣解曹丕梦的另一说，质疑魏书所述太后不干预曹植案。","evidence":["houfei-q-p004-dispute"]}],"participants":[{"person":"wudi-p0388","role":"答议","evidence":["houfei-e-p004b-q"]},{"person":"houfei-p0010","role":"奉议","evidence":["houfei-e-p004b-q"]},{"person":"wudi-p0170","role":"遣兰","evidence":["houfei-e-p004b-q"]}],"place":null,"time":{"label":"文帝时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["houfei-e-p004b-q"]},"ordering_evidence":"houfei-e-p004b-q","source_order":[5,69,"P004b"],"order":1362}],"persons":[{"id":"houfei-p0010","name":"卞兰","facts":[],"aliases":[]},{"id":"wudi-p0170","name":"曹丕","facts":[],"aliases":[]},{"id":"wudi-p0388","name":"卞夫人","facts":[],"aliases":[]}],"evidence":[{"id":"houfei-e-p004b-q","section":"chapter-005","block":"b-6cb6203d4a60347d4a19","layer":"pei","quote":"东阿王植，太后少子，最爱之。后植犯法，为有司所奏；文帝令太后弟子奉车都尉兰，持公卿议白太后。太后曰：‘不意此儿所作如是！汝还语帝：不可以我故坏国法。’及自见帝，不以为言。","attribution":"《魏书》","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":68,"anchor":null},"note_id":"n-c4c87d739b54c91c93b0","start":31,"end":116},{"id":"houfei-q-p004-dispute","section":"chapter-005","block":"b-6cb6203d4a60347d4a19","layer":"pei","quote":"臣松之按：文帝梦磨钱，欲使文灭而更愈明，以问周宣。宣答曰：“此陛下家事，虽意欲尔，而太后不听。”则太后用意，不得如此书所言也。","attribution":"裴松之按","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":68,"anchor":null},"note_id":"n-c4c87d739b54c91c93b0","start":117,"end":180}],"profiles":{},"directory_counts":{}}
