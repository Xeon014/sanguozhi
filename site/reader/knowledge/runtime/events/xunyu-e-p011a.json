{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xunyu-e-p011a","title":"祢衡北游许孔融上书荐其才","accounts":[{"id":"xunyu-e-p011a-account","label":"《平原祢衡传》","text":"祢衡北游许孔融上书荐其才","evidence":["xunyu-e-p011a-q"]}],"participants":[{"person":"xunyu-p0026","role":"游许","evidence":["xunyu-e-p011a-q"]},{"person":"wudi-p0155","role":"推荐","evidence":["xunyu-e-p011a-q"]}],"place":null,"time":{"label":"建安初以后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xunyu-e-p011a-q"]},"ordering_evidence":"xunyu-e-p011a-q","source_order":[10,80,"P011a"],"order":2411}],"persons":[{"id":"wudi-p0155","name":"孔融","facts":[],"aliases":[]},{"id":"xunyu-p0026","name":"祢衡","facts":[],"aliases":[]}],"evidence":[{"id":"xunyu-e-p011a-q","section":"chapter-010","block":"b-21873455cc9461d16e3e","layer":"pei","quote":"衡字正平。建安初，自荆州北游许都。恃才傲逸，臧否过差；见不如己者，不与语，人皆以是憎之。唯少府孔融，高贵其才，上书荐之曰：‘淑质贞亮，英才卓荦。初涉艺文，升堂睹奥。目所一见，辄诵于口；耳所暂闻，不忘于心。性与道合，思若有神。弘羊心计，安世默识；以衡准之，诚不足怪。’衡，时年二十四。","attribution":"《平原祢衡传》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":79,"anchor":null},"note_id":"n-c5cdbaf6b01ad416ab88","start":11,"end":152}],"profiles":{},"directory_counts":{}}
