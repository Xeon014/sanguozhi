{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wuzhu-e-o156a","title":"鄱阳报仁虎孙权诏百官勉职勿以瑞自休","accounts":[{"id":"wuzhu-e-o156a-account","label":"《吴主传第二》正文","text":"鄱阳报仁虎孙权诏百官勉职勿以瑞自休","evidence":["wuzhu-e-o156a-q"]}],"participants":[{"person":"sun-quan","role":"下诏","evidence":["wuzhu-e-o156a-q"]}],"place":null,"time":{"year":248,"label":"五月","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"wuzhu-y248","dating_review":{"reviewed":true,"anchor":"wuzhu-q-o154","basis":"五月"},"evidence":["wuzhu-e-o156a-q","wuzhu-q-o154","shaodi-q-o039","shaodi-q-b-60775abea476f875fc24"]},"ordering_evidence":"wuzhu-e-o156a-q","source_order":[47,775,"O156a"],"order":8395}],"persons":[{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]}],"evidence":[{"id":"shaodi-q-b-60775abea476f875fc24","section":"chapter-004","block":"b-60775abea476f875fc24","layer":"modern","quote":"〖21〗九年：正始九年（公元 248）。参照下文，在“二月”之后应当有记日的干支。此处史文疑有脱落。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":174,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8324fe8afd82c8552b28","start":0,"end":50,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o039","section":"chapter-004","block":"b-e10813740402816008fd","layer":"original","quote":"九年春二月〖21〗，卫将军、中书令孙资；癸巳〖22〗，骠骑将军、中书监刘放；三月甲午〖23〗，司徒卫臻：各逊位，以侯就第〖24〗，位特进〖25〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":149,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":73,"offset_unit":"unicode_code_point"},{"id":"wuzhu-e-o156a-q","section":"chapter-047","block":"b-cd6ed400c91595ef56f9","layer":"original","quote":"五月，鄱阳言白虎仁〖4〗。﹝二﹞诏曰：“古者圣王积行累善，修身行道，以有天下；故符瑞应之〖5〗，所以表德也。朕以不明，何以臻兹〖6〗？《书》云‘虽休勿休〖7〗’，公卿百司，其勉修所职，以匡不逮。”","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":263,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":98,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o154","section":"chapter-047","block":"b-37fb7879e8203f2167ba","layer":"original","quote":"十一年春正月〖1〗，朱然城江陵。二月，地仍震〖2〗。﹝一﹞三月，宫成〖3〗。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":261,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":38,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
