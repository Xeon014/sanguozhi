{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dongyuan-e-p044c","title":"李傕禁赵温赵温书谏李傕欲害李应谏止常洽告帝","accounts":[{"id":"dongyuan-e-p044c-account","label":"《献帝起居注》","text":"李傕禁赵温赵温书谏李傕欲害李应谏止常洽告帝","evidence":["dongyuan-e-p044c-q"]}],"participants":[{"person":"wudi-p0089","role":"禁臣欲杀","evidence":["dongyuan-e-p044c-q"]},{"person":"wendi-p0040","role":"书谏","evidence":["dongyuan-e-p044c-q"]},{"person":"dongyuan-p0089","role":"劝止","evidence":["dongyuan-e-p044c-q"]},{"person":"dongyuan-p0090","role":"答帝","evidence":["dongyuan-e-p044c-q"]},{"person":"wudi-p0054","role":"询问","evidence":["dongyuan-e-p044c-q"]}],"place":null,"time":{"label":"李傕质帝时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-p044c-q"]},"ordering_evidence":"dongyuan-e-p044c-q","source_order":[6,160,"P044c"],"order":1573}],"persons":[{"id":"dongyuan-p0089","name":"李应","facts":[],"aliases":[]},{"id":"dongyuan-p0090","name":"常洽","facts":[],"aliases":[]},{"id":"wendi-p0040","name":"赵温","facts":[],"aliases":[]},{"id":"wudi-p0054","name":"汉献帝","facts":[],"aliases":[]},{"id":"wudi-p0089","name":"李傕","facts":[],"aliases":[]}],"evidence":[{"id":"dongyuan-e-p044c-q","section":"chapter-006","block":"b-b4b3790f4f883e68840d","layer":"pei","quote":"傕以司徒赵温不与己同，乃内温坞中。温闻傕欲移乘舆，与傕书曰：‘公前托为董公报仇，然实屠陷王城，杀戮大臣；天下不可家见而户释也。今争睚眦之隙，以成千钧之仇。民在涂炭，各不聊生；曾不改悟，遂成祸乱。朝廷仍下明诏，欲令和解；诏命不行，恩泽日损：而复欲辅乘舆于黄白城，此诚老夫所不解也。于《易》：一过为过，再为涉；三而弗改，灭其顶，凶。不如早共和解，引兵还屯。上安万乘，下全生民，岂不幸甚！’傕大怒，欲遣人害温。其从弟应，温故掾也，谏之数日乃止。帝闻温与傕书，问侍中常洽曰：‘傕弗知臧否；温言太切，可为寒心！’对曰：‘李应已解之矣。’帝乃悦。","attribution":"《献帝起居注》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":159,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-7f8915c0e475c5efba56","start":304,"end":571,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
