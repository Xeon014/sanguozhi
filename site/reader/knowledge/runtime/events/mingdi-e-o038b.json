1a1a12d","chapter-013":"24c6e486e7f78fc4d59ff01277b36cb77ffb69c68a6a9030889fe00efe4b3d27","chapter-016":"6cfac20452f269a832b087d2e808cc4b3017944d17dca1d5b1e068ebb98d8327","chapter-018":"7a62f43c1f5dc64661b088ef0fdd48392063ef5c49001fa980aa65e766380b23","chapter-019":"a43f6648e6c9d8389d561bee9d00824665f8f06542ab2a65aac06ed8a7601c5b","chapter-020":"2ef7e28be018140e07d27d7636a9df480a5cb7ef1cb3572c314a70e0d1acd07c","chapter-050":"71faaaddb69f25a5bdd7f315f15562e867eed9e897c9bd439a99a09c435bfe91","chapter-023":"908d4e64a01e171bdb09c0a7ee5484b8743be26b7cc75f49bd8b41b7ff391ff2","chapter-024":"39be893c0040dbb3148f9447402c47fc24dcb4356360f8558243258cb85b089a","chapter-025":"f37fc365e7d07f96b5fd289119e1846fe7f0030d8b46a7195fab316badf817b7","chapter-027":"dd48b2052380e1f6b6f6ffcb4835dd99cfe70efe4a9096fa51448dbdfaa14f00","chapter-062":"7031fb8ebde1ea3c95cdedcf93218fb46f69a71a29a1d9e82361f7108436a86a","chapter-063":"3ae8edfbae98c3e86a518f7022c664ed35a0d68d5ac36b331ceb560e76b1848f","chapter-065":"13c50dd7dc9a229aef1cfb43dd231955a0b1a6359dab04c54708df93fa114e12","chapter-057":"39e3922e223fe25b811b77f14049327071298549de6ed788ba7da697f067f2e3","chapter-021":"18c02b71e8f81644cf71ffea582a8e019509de0b5e9bc11451de595fa03e2cf3","chapter-029":"6ffb35bac29d20aa512b5a734e72f98ec5729b176f1bc5d6837e673bcc00880d","chapter-030":"3e0682212c3e242d0f221308bc203bd8309851b8498b94db16383bdde5234ce1"},"events":[{"id":"mingdi-e-o038b","title":"追谥汉献帝诏葬以汉礼","accounts":[{"id":"mingdi-e-o038b-account","label":"《明帝纪》正文","text":"追谥汉献帝诏葬以汉礼","evidence":["mingdi-e-o038b-q"]},{"id":"mingdi-a-p031-decree","label":"裴注·献帝传","text":"《献帝传》载告文帝庙辞，定汉礼丧葬、经费及立后嗣为山阳公。","evidence":["mingdi-q-p031-decree"]},{"id":"mingdi-a-p032-argument","label":"裴注·献帝传","text":"赠册追叙汉魏禅代，属丧礼文书论据，不把册中回顾重复建为新战役。","evidence":["mingdi-q-p032-argument"]},{"id":"zhonghua-a-b86519af5ec23d79fa37","label":"正文","text":"王肃上疏议山阳公丧仪谥号，请使称皇以配其谥","evidence":["zhonghua-q-4da8a3d7a75cb9a9e62a"]},{"id":"zhonghua-a-8e165bc4e30861fc8a56","label":"正文","text":"明帝不从称皇之议，追谥山阳公曰汉孝献皇帝","evidence":["zhonghua-q-dccc38b9d7b8947e284b"]}],"participants":[{"person":"shaodi-p0033","role":"上疏议谥者","evidence":["zhonghua-q-4da8a3d7a75cb9a9e62a"]},{"person":"wudi-p0054","role":"议谥之对象；被追谥汉孝献皇帝者","evidence":["zhonghua-q-4da8a3d7a75cb9a9e62a","zhonghua-q-dccc38b9d7b8947e284b"]},{"person":"wendi-p0005","role":"追谥者","evidence":["zhonghua-q-dccc38b9d7b8947e284b"]}],"place":null,"time":{"year":234,"label":"四月丙寅","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"mingdi-y234","dating_review":{"reviewed":true,"anchor":"mingdi-q-o037","basis":"四月丙寅"},"evidence":["mingdi-e-o038b-q","mingdi-q-o037","mingdi-q-b-7a11c761ca65aeb3d195"]},"ordering_evidence":"mingdi-e-o038b-q","source_order":[3,251,"O038b"],"order":851}],"persons":[{"id":"shaodi-p0033","name":"王肃","facts":[],"aliases":[]},{"id":"wendi-p0005","name":"曹叡","facts":[],"aliases":[]},{"id":"wudi-p0054","name":"汉献帝","facts":[],"aliases":[]}],"evidence":[{"id":"mingdi-e-o038b-q","section":"chapter-003","block":"b-eaefc3069853442c7a7a","layer":"original","quote":"夏四月，大疫。崇华殿灾。丙寅〖9〗，诏有司以太牢告祠文帝庙。追谥山阳公为汉孝献皇帝，葬以汉礼。﹝一﹞是月，诸葛亮出斜谷，屯渭南；司马宣王率诸军拒之。诏宣王：“但坚壁拒守，以挫其锋；彼进不得志，退无与战；久停则粮尽，虏略无所获：则必走矣。走而追之，以逸待劳：全胜之道也。”﹝二﹞","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":250,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":138,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-b-7a11c761ca65aeb3d195","section":"chapter-003","block":"b-7a11c761ca65aeb3d195","layer":"modern","quote":"〖1〗二年：青龙二年（公元 234）。己未：旧历初四日。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":252,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6c0753fe684a18a3a281","start":0,"end":28,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-o037","section":"chapter-003","block":"b-ff97c2d326d0fc08a9de","layer":"original","quote":"二年春二月，（乙）〔己〕未〖1〗，太白犯荧惑。癸酉〖2〗，诏曰：“‘鞭作官刑〖3〗’，所以纠慢怠也〖4〗；而顷多以无辜死。其减鞭杖之制〖5〗，著于令。”三月，庚寅〖6〗，山阳公薨；帝素服发哀〖7〗，遣使持节，典护丧事。己酉〖8〗，大赦。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":249,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":118,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-p031-decree","section":"chapter-003","block":"b-0e978917c460a33d7634","layer":"pei","quote":"使太尉具以一太牢，告祠文帝庙，曰：‘叡闻夫礼也者，反本修古，不忘厥初；是以先代之君，尊尊亲亲，咸有尚焉。今山阳公寝疾弃国，有司建言：丧纪之礼视诸侯王。叡惟山阳公昔知天命永终于己，深观历数允在圣躬，传祚禅位，尊我民主；斯乃陶唐懿德之事也。黄初受终，命公于国行汉正朔，郊天祀祖、礼乐制度率乃汉旧；斯亦舜、禹明堂之义也。上考遂初，皇极攸建；允熙克让，莫朗于兹。盖子以继志嗣训为孝，臣以配命钦述为忠。故《诗》称“匪棘其犹，聿追来孝”，《书》曰“前人受命，兹不忘大功”。叡敢不奉承徽典，以昭皇考之神灵。今追谥山阳公曰“孝献皇帝”，册赠玺绶。命司徒、司空，持节吊祭护丧；光禄、大鸿胪，为副；将作大匠、复土将军，营成陵墓；及置百官群吏，车旗服章丧葬礼仪，一如汉氏故事。丧葬所供群官之费，皆仰大司农。立其后嗣为山阳公，以通三统，永为魏宾。’","attribution":"裴注·献帝传","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":264,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-577bfabc3a4642d33616","start":0,"end":362,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-p032-argument","section":"chapter-003","block":"b-26bf0d24a5991cbbec11","layer":"pei","quote":"于是赠册曰：‘呜呼！昔皇天降戾于汉，俾逆臣董卓，播厥凶虐，焚灭京都，劫迁大驾；于时六合云扰，奸雄熛起。帝自西京，徂唯求定，臻兹洛邑。畴咨圣贤，聿改乘辕；又迁许昌，武皇帝是依。岁在玄枵，皇师肇征；迄于鹑尾，十有八载；群寇歼殄，九域咸乂。惟帝念功，祚兹魏国，大启土宇。爰及文皇帝，齐圣广渊，仁声旁流；柔远能迩，殊俗向义；乾精承祚，坤灵吐曜；稽极玉衡，允膺历数；度于轨仪，克厌帝心。乃仰钦七政，俯察五典；弗采四岳之谋，不俟师锡之举；幽赞神明，承天禅位。祚建朕躬，统承洪业。盖闻昔帝尧，元、恺既举，凶族未流，登舜百揆；然后百揆时序，内平外成，授位明堂，退终天禄。故能冠德百王，表功嵩岳。自往迄今，弥历七代，岁暨三千；而大运来复，庸命底绩；纂我民主，作建皇极。念重光，绍咸池，继韶夏。超群后之遐踪，邈商、周之惭德；可谓高朗令终，昭明洪烈之懿盛者矣！非夫汉、魏与天地合德，与四时合信，动和民神，格于上下，其孰能至于此乎？朕惟孝献享年不永，钦若顾命；考之典谟，恭述皇考先灵遗意；阐崇弘谥，奉成圣美；以彰希世同符之隆，以传亿载不朽之荣。魂而有灵，嘉兹弘休。呜呼哀哉！’","attribution":"裴注·献帝传","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":265,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-577bfabc3a4642d33616","start":0,"end":476,"offset_unit":"unicode_code_point"},{"id":"zhonghua-q-4da8a3d7a75cb9a9e62a","section":"chapter-013","block":"b-e60da5d6d831a95918c1","layer":"original","quote":"肃上疏曰：“昔唐禅虞，虞禅夏；皆终三年之丧，然后践天子之尊。是以帝号无亏，君礼犹存。今山阳公承顺天命，允答民望；进禅大魏，退处宾位。公之奉魏，不敢不尽节；魏之待公，优崇而不臣〖2〗。既至其薨，榇敛之制〖3〗，舆徒之饰〖4〗，皆同之于王者；是故远近归仁，以为盛美。且汉总帝皇之号，号曰‘皇帝’。有别称‘帝’〖5〗，无别称‘皇’，则‘皇’是其差轻者也〖6〗。故当高祖之时，土无二王〖7〗；其父见在而使称‘皇’〖8〗，明非二王之嫌也。况今以赠终，可使称‘皇’，以配其谥。”","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":406,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":16,"end":249,"offset_unit":"unicode_code_point"},{"id":"zhonghua-q-dccc38b9d7b8947e284b","section":"chapter-013","block":"b-6941dea30e6b0ce8974f","layer":"original","quote":"明帝不从使称“皇”，乃追谥曰“汉孝献皇帝”。","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":407,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":22,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
