{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"santizhu064-e-r-sun-jun-plot","title":"峻构恪与亮谋置酒请恪","accounts":[{"id":"santizhu064-a-c8593146358cf2899f0d","label":"正文","text":"峻构恪与亮谋置酒请恪","evidence":["santizhu064-q-f38ecf16a8b16528b13b"]},{"id":"santizhu064-a-05d81f3caf7588419858","label":"正文","text":"峻伏兵自出尝恪","evidence":["santizhu064-q-10c730b011e3a167ae06"]},{"id":"santizhu064-a-1b658d410fac1a07f693","label":"正文","text":"张约朱恩密书胤劝恪进","evidence":["santizhu064-q-2107c04577f0389f859b"]},{"id":"santizhu064-a-b09bcdd42165859c0376","label":"正文","text":"设酒恪别饮所赍酒","evidence":["santizhu064-q-37e296af79b83e52916f"]},{"id":"santizhu064-a-96e0c65b3ec9cba5e29b","label":"正文","text":"峻斩恪于殿堂","evidence":["santizhu064-q-9bdb9b5156fcb2101d50"]},{"id":"santizhu064-a-4b91c9a07e83e2e758ef","label":"裴注·吴历","text":"《吴历》：张约朱恩密疏告恪，恪以示滕胤，胤劝恪还；恪曰峻小子何能为但恐因酒食中人耳，乃以药酒入","evidence":["santizhu064-q-bd55f33c530e82cf3ba2"]},{"id":"santizhu064-a-c421477ba71bcfa0f268","label":"裴注·吴录","text":"《吴录》：峻提刀称诏收恪；亮起立曰非我所为非我所为，乳母引亮还内","evidence":["santizhu064-q-b7e170871a90dbdffcd8"]}],"participants":[{"person":"shaodi-p0075","role":"因众怨构陷诸葛恪欲变，并与孙亮谋置酒请恪；设伏、出见诸葛恪试探其是否知情；以药酒试探诸葛恪；称有诏收恪并亲手斩杀","evidence":["santizhu064-q-f38ecf16a8b16528b13b","santizhu064-q-10c730b011e3a167ae06","santizhu064-q-37e296af79b83e52916f","santizhu064-q-9bdb9b5156fcb2101d50"]},{"person":"wuzhu-p0128","role":"与孙峻谋置酒请诸葛恪","evidence":["santizhu064-q-f38ecf16a8b16528b13b"]},{"person":"shaodi-p0041","role":"到宫门后与孙峻对答；查看密书后离去，遇滕胤后返回赴宴；疑而未饮孙峻所劝药酒，另饮自携之酒；被孙峻杀害","evidence":["santizhu064-q-10c730b011e3a167ae06","santizhu064-q-2107c04577f0389f859b","santizhu064-q-37e296af79b83e52916f","santizhu064-q-9bdb9b5156fcb2101d50"]},{"person":"santizhu-p0005","role":"不知孙峻阴谋，劝诸葛恪进见","evidence":["santizhu064-q-2107c04577f0389f859b"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达保留在来源引句，不推算公元年。","evidence":["santizhu064-q-f38ecf16a8b16528b13b","santizhu064-q-10c730b011e3a167ae06","santizhu064-q-2107c04577f0389f859b","santizhu064-q-37e296af79b83e52916f","santizhu064-q-9bdb9b5156fcb2101d50"]},"ordering_evidence":"santizhu064-q-f38ecf16a8b16528b13b","source_order":[64,259,0],"order":10969}],"persons":[{"id":"santizhu-p0005","name":"滕胤","facts":[],"aliases":[]},{"id":"shaodi-p0041","name":"诸葛恪","facts":[],"aliases":[]},{"id":"shaodi-p0075","name":"孙峻","facts":[],"aliases":[]},{"id":"wuzhu-p0128","name":"孙亮","facts":[],"aliases":[]}],"evidence":[{"id":"santizhu064-q-10c730b011e3a167ae06","section":"chapter-064","block":"b-c73d5f4083db490a9140","layer":"original","quote":"及将见，驻车宫门。峻已伏兵于帷中，恐恪不时入〖7〗，事泄；自出见恪曰：“使君若尊体不安〖8〗，自可须后〖9〗；峻当具白主上。”欲以尝知恪〖10〗。恪答曰：“当自力入","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":260,"anchor":null},"note_id":null,"start":0,"end":82},{"id":"santizhu064-q-2107c04577f0389f859b","section":"chapter-064","block":"b-c73d5f4083db490a9140","layer":"original","quote":"散骑常侍张约、朱恩等，密书与恪曰〖12〗：“今日张设非常，疑有他故！”恪省书而去。未出路门，逢太常滕胤。恪曰：“猝腹痛，不任入。”胤不知峻阴计，谓恪曰：“君自行旋，未见〖13〗；今上置酒请君〖14〗，君已至门，宜当力进。”恪踌躇而还，剑履上殿","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":260,"anchor":null},"note_id":null,"start":88,"end":209},{"id":"santizhu064-q-37e296af79b83e52916f","section":"chapter-064","block":"b-c73d5f4083db490a9140","layer":"original","quote":"谢亮，还坐。设酒，恪疑未饮。峻因曰：“使君病未善平〖16〗，当有常服药酒，自可取之。”恪意乃安，别饮所赍酒","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":260,"anchor":null},"note_id":null,"start":214,"end":267},{"id":"santizhu064-q-9bdb9b5156fcb2101d50","section":"chapter-064","block":"b-05e29553087bd05cfd74","layer":"original","quote":"酒数行，亮还内。峻起如厕〖17〗，解长衣，著短服。出曰：“有诏收诸葛恪！”﹝二﹞恪惊起，拔剑未得，而峻刀交下。张约从旁斫峻，才伤左手；峻应手斫约，断右臂。武卫之士皆趋上殿，峻云：“所取者恪也！今已死。”悉令复刃〖18〗，乃除地更饮","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":261,"anchor":null},"note_id":null,"start":0,"end":115},{"id":"santizhu064-q-b7e170871a90dbdffcd8","section":"chapter-064","block":"b-7a6fdbefc069d4df4919","layer":"pei","quote":"《吴录》曰：“峻提刀，称‘诏收恪’！亮起立曰：‘非我所为！非我所为！’乳母引亮还内。”","attribution":"裴注·吴录","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":285,"anchor":null},"note_id":"n-0f5229ba8104cfb1a21c","start":3,"end":46},{"id":"santizhu064-q-bd55f33c530e82cf3ba2","section":"chapter-064","block":"b-6408d8b8d20bb8a849ce","layer":"pei","quote":"《吴历》曰：“张约、朱恩密疏告恪，恪以示滕胤，胤劝恪还。恪曰：‘峻小子，何能为邪！但恐因酒食中人耳。’乃以药酒入。”","attribution":"裴注·吴历","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":283,"anchor":null},"note_id":"n-099bccdc1e55b4fc6066","start":3,"end":61},{"id":"santizhu064-q-f38ecf16a8b16528b13b","section":"chapter-064","block":"b-7e045f8a73049ce1817c","layer":"original","quote":"孙峻因民之多怨，众之所嫌，构恪欲为变〖1〗。与亮谋，置酒请恪","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":258,"anchor":null},"note_id":null,"start":0,"end":30}],"profiles":{},"directory_counts":{}}
