父，尽呼亲戚姑姊，悉以嫁将吏；所幸婢妾，皆赐与亲近；杀牛饮酒歃血，与共盟誓","attribution":"裴注·吴书","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":80,"anchor":null},"note_id":"n-731439beb1600871224c","start":10,"end":140},{"id":"chenghuang-q-da822f3582a45cc5c9cc","section":"chapter-055","block":"b-5aaefcd2352b2f4c77e3","layer":"original","quote":"而综淫乱不轨。权虽以父故，不问；综内怀惧，﹝三﹞载父丧，将母、家属、部曲男女数千人奔魏","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":58,"anchor":null},"note_id":null,"start":30,"end":73},{"id":"wuzhu-e-o079a-q","section":"chapter-047","block":"b-12764ef2bd529fe1d531","layer":"original","quote":"闰月〖32〗，韩当子综，以其众降魏。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":394,"anchor":null},"note_id":null,"start":0,"end":18},{"id":"wuzhu-q-o078","section":"chapter-047","block":"b-8b3cb03897e489e17eb4","layer":"original","quote":"六年春正月〖31〗，诸将获彭绮。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":393,"anchor":null},"note_id":null,"start":0,"end":16},{"id":"zhuge-q-b-bac68d65cbee34059b3b","section":"chapter-035","block":"b-bac68d65cbee34059b3b","layer":"modern","quote":"〖1〗五年：建兴五年（公元 227）。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":160,"anchor":null},"note_id":"n-7b55cee111ab139cccf8","start":0,"end":19},{"id":"zhuge-q-o024","section":"chapter-035","block":"b-1cb2342652e8f8d4d768","layer":"original","quote":"五年〖1〗，率诸军北驻汉中。临发，上疏曰〖2〗：","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":152,"anchor":null},"note_id":null,"start":0,"end":24}],"profiles":{},"directory_counts":{}}
