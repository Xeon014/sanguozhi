1a1a12d","chapter-013":"24c6e486e7f78fc4d59ff01277b36cb77ffb69c68a6a9030889fe00efe4b3d27","chapter-016":"6cfac20452f269a832b087d2e808cc4b3017944d17dca1d5b1e068ebb98d8327","chapter-018":"7a62f43c1f5dc64661b088ef0fdd48392063ef5c49001fa980aa65e766380b23","chapter-019":"a43f6648e6c9d8389d561bee9d00824665f8f06542ab2a65aac06ed8a7601c5b","chapter-020":"2ef7e28be018140e07d27d7636a9df480a5cb7ef1cb3572c314a70e0d1acd07c","chapter-050":"71faaaddb69f25a5bdd7f315f15562e867eed9e897c9bd439a99a09c435bfe91","chapter-023":"908d4e64a01e171bdb09c0a7ee5484b8743be26b7cc75f49bd8b41b7ff391ff2","chapter-024":"39be893c0040dbb3148f9447402c47fc24dcb4356360f8558243258cb85b089a","chapter-025":"f37fc365e7d07f96b5fd289119e1846fe7f0030d8b46a7195fab316badf817b7","chapter-027":"dd48b2052380e1f6b6f6ffcb4835dd99cfe70efe4a9096fa51448dbdfaa14f00","chapter-062":"7031fb8ebde1ea3c95cdedcf93218fb46f69a71a29a1d9e82361f7108436a86a","chapter-063":"3ae8edfbae98c3e86a518f7022c664ed35a0d68d5ac36b331ceb560e76b1848f","chapter-065":"13c50dd7dc9a229aef1cfb43dd231955a0b1a6359dab04c54708df93fa114e12","chapter-057":"39e3922e223fe25b811b77f14049327071298549de6ed788ba7da697f067f2e3","chapter-021":"18c02b71e8f81644cf71ffea582a8e019509de0b5e9bc11451de595fa03e2cf3","chapter-029":"6ffb35bac29d20aa512b5a734e72f98ec5729b176f1bc5d6837e673bcc00880d","chapter-030":"3e0682212c3e242d0f221308bc203bd8309851b8498b94db16383bdde5234ce1"},"events":[{"id":"wendi-e-p100a","title":"曹植为曹丕作诔","accounts":[{"id":"wendi-e-p100a-account","label":"裴注·曹植诔","text":"曹植为曹丕作诔","evidence":["wendi-e-p100a-q"]},{"id":"wendi-a-p101-preface","label":"裴注·曹植诔","text":"曹植诔序写文帝崩逝及哀思，纪日保留“五月〔十〕七日”的校勘形式。","evidence":["wendi-q-p101-preface"]},{"id":"wendi-a-p102-poem","label":"裴注·曹植诔","text":"诔辞铺陈文帝功德及哀思，不据颂赞另造未经确认的行动。","evidence":["wendi-q-p102-poem"]},{"id":"wendi-a-p103-ending","label":"裴注·曹植诔","text":"乱辞写哀慕及关防拘束之情，保留作品完整续段。","evidence":["wendi-q-p103-ending"]}],"participants":[{"person":"wudi-p0280","role":"作诔","evidence":["wendi-e-p100a-q"]}],"place":null,"time":{"year":226,"label":"黄初七年文帝崩后","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"wendi-y226","dating_review":{"reviewed":true,"anchor":"wendi-q-o054","basis":"黄初七年文帝崩后"},"evidence":["wendi-e-p100a-q","wendi-q-o054","wendi-q-o049","wendi-q-b-e28c5cd47fe98ad60171"]},"ordering_evidence":"wendi-e-p100a-q","source_order":[2,504,"P100a"],"order":682}],"persons":[{"id":"wudi-p0280","name":"曹植","facts":[],"aliases":[]}],"evidence":[{"id":"wendi-e-p100a-q","section":"chapter-002","block":"b-c9560074e6ca2cb4a1a0","layer":"pei","quote":"鄄城侯植为诔曰：","attribution":"裴注·曹植诔","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":503,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b4f84d71221f74ec4b16","start":0,"end":8,"offset_unit":"unicode_code_point"},{"id":"wendi-q-b-e28c5cd47fe98ad60171","section":"chapter-002","block":"b-e28c5cd47fe98ad60171","layer":"modern","quote":"〖1〗六年：黄初六年（公元 225）。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":467,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-61512c4ade75d71d6a76","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wendi-q-o049","section":"chapter-002","block":"b-d5847039c2d504d36e8e","layer":"original","quote":"六年春二月〖1〗，遣使者循行许昌以东，尽沛郡〖2〗。问民所疾苦，贫者赈贷之。﹝一﹞三月，行幸召陵〖3〗，通讨虏渠〖4〗。乙巳〖5〗，还许昌宫。并州刺史梁习讨鲜卑轲比能〖6〗，大破之。辛未〖7〗，帝为舟师，东征。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":461,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":105,"offset_unit":"unicode_code_point"},{"id":"wendi-q-o054","section":"chapter-002","block":"b-19250f15bc304637f90e","layer":"original","quote":"七年春正月，将幸许昌。许昌城南门，无故自崩；帝心恶之，遂不入。壬子〖1〗，行还洛阳宫。三月，筑九华台〖2〗。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":487,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":54,"offset_unit":"unicode_code_point"},{"id":"wendi-q-p101-preface","section":"chapter-002","block":"b-af63a534e0e8f665d385","layer":"pei","quote":"“惟黄初七年五月〔十〕七日，大行皇帝崩，呜呼哀哉！于时天震地骇，崩山陨霜；阳精薄景，五纬错行；百姓呼嗟，万国悲伤；若丧考妣，（恩过慕）〔思慕过〕唐；擗踊郊野，仰想穹苍；佥曰何辜，早世殒丧。呜呼哀哉！悲夫大行，忽焉光灭；永弃万国，云往雨绝。承问荒忽，惛懵哽咽；袖锋抽刃，叹自僵毙；追慕三良，甘心同穴。感惟南风，惟以郁滞；终于偕没，指景自誓。考诸先记，寻之哲言；生若浮寄，唯德可论；朝闻夕逝，孔志所存。皇虽一没，天禄永延；何以述德？表之素旃。何以咏功？宣之管弦。乃作诔曰：","attribution":"裴注·曹植诔","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":504,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b4f84d71221f74ec4b16","start":0,"end":234,"offset_unit":"unicode_code_point"},{"id":"wendi-q-p102-poem","section":"chapter-002","block":"b-66368ae1b52d1b6aeaaa","layer":"pei","quote":"皓皓太素，两仪始分；中和产物，肇有人伦。爰暨三皇，实秉道真；降逮五帝，继以懿纯；三代制作，踵武立勋。季嗣不维，网漏于秦；崩乐灭学，儒坑礼焚；二世而歼，汉氏乃因；弗求古训，嬴政是遵；王纲帝典，阒尔无闻。末光幽昧，道究运迁；乾坤回历，简圣授贤；乃眷大行，属以黎元；龙飞启祚，合契上玄；五行定纪，改号革年；明明赫赫，受命于天；仁风偃物，德以礼宣。详惟圣质，嶷在幼妍；庶几六典，学不过庭；潜心无罔，抗志青冥；才秀藻朗，如玉之莹；听察无响，瞻睹未形；其刚如金，其贞如琼；如冰之洁，如砥之平。爵公无私，戮违无轻；心镜万机，揽照下情。思良股肱，嘉昔伊、吕；搜扬侧陋，举汤代禹；拔才岩穴，取士蓬户；唯德是萦，弗拘祢祖。宅土之表，道义是图；弗营厥险，六合是虞。齐契共遵，下以纯民；恢拓规矩，克绍前人；科条品制，褒贬以因。乘殷之辂，行夏之辰；金根黄屋，翠葆龙鳞；绋冕崇丽，衡-维新；尊肃礼容，瞩之若神。方牧妙举，钦于恤民；虎将荷节，镇彼四邻；朱旗所剿，九壤被震；畴克不若？孰敢不臣？悬旌海表，万里无尘。虏备凶彻，鸟殪江岷；权若涸鱼，乾腊矫鳞；肃慎纳贡，越裳效珍；条支绝域，侍子内宾。德侪先皇，功侔太古；上灵降瑞，黄初叔祜；河龙洛龟，凌波游下；平钧应绳，神鸾翔舞；数荚阶除，系风扇暑；皓兽素禽，飞走郊野；神钟宝鼎，形自旧土；云英甘露，瀸涂被宇；灵芝冒沼，朱华荫渚；回回凯风，祁祁甘雨；稼穑丰登，我稷我黍：家佩惠君，户蒙慈父。图致太和，洽德全义；将登介山，先皇作俪；镌石纪勋，兼录众瑞；方隆封禅，归功天地；宾礼百灵，勋命视规；望祭四岳，燎封奉柴；肃于南郊，宗祀上帝；三牲既供，夏禘秋尝；元侯佐祭，献璧奉璋；鸾舆幽蔼，龙旂大常。爰迄太庙，钟鼓锽锽；颂德咏功，八佾锵锵；皇祖既飨，烈考来享；神具醉止，降兹福祥。天地震荡，大行康之；三辰暗昧，大行光之；皇纮绝维，大行纲之；神器莫统，大行当之；礼乐废弛，大行张之；仁义陆沉，大行扬之；潜龙隐凤，大行翔之；疏狄遐康，大行匡之。在位七载，〔元〕〔九〕功仍举；将永太和，绝迹三五；宜作物师，长为神主；寿终金石，等算东父；如何奄忽，摧身后土？俾我茕茕，靡瞻靡顾！嗟嗟皇穹，胡宁忍（务）〔予〕？呜呼哀哉！明监吉凶，体远存亡；深垂典制，申之嗣皇。圣上虔奉，是顺是将；乃创玄宇，基为首阳；拟迹穀林，追尧慕唐；合山同陵，不树不疆，涂车刍灵，珠玉靡藏。百神警侍，来宾幽堂；耕禽田兽，望魂之翔。","attribution":"裴注·曹植诔","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":505,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b4f84d71221f74ec4b16","start":0,"end":996,"offset_unit":"unicode_code_point"},{"id":"wendi-q-p103-ending","section":"chapter-002","block":"b-47aa20b7c6600f054dfb","layer":"pei","quote":"于是，俟大隧之致功兮，练元辰之淑祯，潜华体于梓宫兮，凭正殿以居灵；顾望嗣之号咷兮，存临者之悲声；悼晏驾之既修兮，感容车之速征；浮飞魂于轻霄兮，就黄墟以灭形；背三光之昭晰兮，归玄宅之冥冥；嗟一往之不返兮，痛.闼之长扃！咨远臣之眇眇兮，感凶讳以怛惊；心孤绝而靡告兮，纷流涕而交颈；思恩荣以横奔兮，阂阙塞之晓峥；顾衰绖以轻举兮，迫关防之我婴；欲高飞而遥憩兮，惮天网之远经；遥投骨于山足兮，报恩养于下庭；慨拊心而自悼兮，惧施重而命轻；嗟微躯之是效兮，甘九死而忘生；几司命之役籍兮，先黄发而陨零；天盖高而察卑兮，冀神明之我听；独郁伊而莫诉兮，追顾景而怜形；奏斯文以写思兮，结翰墨以敷诚。呜呼哀哉！”","attribution":"裴注·曹植诔","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":506,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b4f84d71221f74ec4b16","start":0,"end":294,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
