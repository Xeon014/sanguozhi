{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xunyu-e-o040a","title":"曹操围吕布下邳不拔士疲欲还","accounts":[{"id":"xunyu-e-o040a-account","label":"《荀彧荀攸贾诩传第十》正文","text":"曹操围吕布下邳不拔士疲欲还","evidence":["xunyu-e-o040a-q"]}],"participants":[{"person":"cao-cao","role":"围攻","evidence":["xunyu-e-o040a-q"]},{"person":"wudi-p0088","role":"固守","evidence":["xunyu-e-o040a-q"]}],"place":null,"time":{"year":198,"label":"建安三年","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xunyu-y198","dating_review":{"reviewed":true,"anchor":"xunyu-q-o018","basis":"建安三年"},"evidence":["xunyu-e-o040a-q","xunyu-q-o018","xunyu-q-b-55069b3150fc7a092ecf"]},"ordering_evidence":"xunyu-e-o040a-q","source_order":[10,211,"O040a"],"order":2487}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0088","name":"吕布","facts":[],"aliases":[]}],"evidence":[{"id":"xunyu-e-o040a-q","section":"chapter-010","block":"b-d10b27762077bcd00bb5","layer":"original","quote":"是岁，太祖自宛征吕布，﹝一﹞至下邳。布败退，固守，攻之不拔。连战，士卒疲，太祖欲还。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":210,"anchor":null},"note_id":null,"start":0,"end":42},{"id":"xunyu-q-b-55069b3150fc7a092ecf","section":"chapter-010","block":"b-55069b3150fc7a092ecf","layer":"modern","quote":"〖1〗三年：建安三年（公元 198）。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":113,"anchor":null},"note_id":"n-2bf03ce242d0f1f296ae","start":0,"end":19},{"id":"xunyu-q-o018","section":"chapter-010","block":"b-c84a0f39812ff83ca230","layer":"original","quote":"三年〖1〗，太祖既破张绣，东擒吕布，定徐州；遂与袁绍相拒。孔融谓彧曰：“绍，地广兵强；田丰、许攸，智计之士也，为之谋；审配、逢纪，尽忠之臣也，任其事；颜良、文丑，勇冠三军，统其兵：殆难克乎？”","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":108,"anchor":null},"note_id":null,"start":0,"end":96}],"profiles":{},"directory_counts":{}}
