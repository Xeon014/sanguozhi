{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xinyang-e-f9747805976aa83c6609","title":"杨阜杨岳守冀正月至八月阎温求援被杀韦康等终降","accounts":[{"id":"xinyang-a-f9747805976aa83c6609","label":"正文","text":"杨阜杨岳守冀正月至八月阎温求援被杀韦康等终降","evidence":["xinyang-q-e8cb2490ce111c7c32b4"]}],"participants":[{"person":"mingdi-p0040","role":"率守劝勿降","evidence":["xinyang-q-e8cb2490ce111c7c32b4"]},{"person":"xinyang-p-a89cdacfb63c19","role":"筑营拒战","evidence":["xinyang-q-e8cb2490ce111c7c32b4"]},{"person":"lizang-p0075","role":"求援被杀","evidence":["xinyang-q-e8cb2490ce111c7c32b4"]},{"person":"wudi-p0282","role":"攻城杀使","evidence":["xinyang-q-e8cb2490ce111c7c32b4"]},{"person":"wudi-p0345","role":"率援马超军","evidence":["xinyang-q-e8cb2490ce111c7c32b4"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["xinyang-q-e8cb2490ce111c7c32b4"]},"ordering_evidence":"xinyang-q-e8cb2490ce111c7c32b4","order":5051}],"persons":[{"id":"lizang-p0075","name":"阎温","facts":[],"aliases":[]},{"id":"mingdi-p0040","name":"杨阜","facts":[],"aliases":[]},{"id":"wudi-p0282","name":"马超","facts":[],"aliases":[]},{"id":"wudi-p0345","name":"杨昂","facts":[],"aliases":[]},{"id":"xinyang-p-a89cdacfb63c19","name":"杨岳","facts":[],"aliases":[]}],"evidence":[{"id":"xinyang-q-e8cb2490ce111c7c32b4","section":"chapter-025","block":"b-6677f0d0806a149bfd99","layer":"original","quote":"超尽兼陇右之众，而张鲁又遣大将杨昂以助之，凡万余人，攻城。阜率国士大夫及宗族子弟胜兵者千余人〖15〗，使从弟岳于城上作偃月营〖16〗，与超接战，自正月至八月拒守，而救兵不至。州遣别驾阎温循水潜出求救〖17〗，为超所杀，于是刺史、太守失色，始有降超之计。阜流涕谏曰：“阜等率父兄子弟以义相励，有死无二；田单之守〖18〗，不固于此也。弃垂成之功，陷不义之名，阜以死守之。”遂号哭。刺史、太守卒遣人请和，开城门迎超。","section_title":"辛毗杨阜高堂隆传第二十五","source":{"file":"OEBPS/Text/titlepage_0056.xhtml","index":124,"anchor":null},"note_id":null,"start":0,"end":205}],"profiles":{},"directory_counts":{}}
