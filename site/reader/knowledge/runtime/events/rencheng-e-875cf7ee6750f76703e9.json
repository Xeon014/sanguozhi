{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"rencheng-e-875cf7ee6750f76703e9","title":"杨准遣杨峤杨髦见裴頠乐广，二人品评不同","accounts":[{"id":"rencheng-a-875cf7ee6750f76703e9","label":"裴注引荀绰《冀州记》","text":"杨准遣杨峤杨髦见裴頠乐广，二人品评不同","evidence":["rencheng-q-5dc8acf93de2660623f5"]}],"participants":[{"person":"rencheng-p-446bb8cab23e49","role":"遣子及评论者","evidence":["rencheng-q-5dc8acf93de2660623f5"]},{"person":"rencheng-p-0203d979cc997d","role":"被品评者","evidence":["rencheng-q-5dc8acf93de2660623f5"]},{"person":"rencheng-p-2127778da1b2f2","role":"被品评者","evidence":["rencheng-q-5dc8acf93de2660623f5"]},{"person":"rencheng-p-706d5cc77806c2","role":"品评者","evidence":["rencheng-q-5dc8acf93de2660623f5"]},{"person":"rencheng-p-be9a88f6efb025","role":"品评者","evidence":["rencheng-q-5dc8acf93de2660623f5"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["rencheng-q-5dc8acf93de2660623f5"]},"ordering_evidence":"rencheng-q-5dc8acf93de2660623f5","order":3777}],"persons":[{"id":"rencheng-p-0203d979cc997d","name":"杨峤","facts":[],"aliases":[]},{"id":"rencheng-p-2127778da1b2f2","name":"杨髦","facts":[],"aliases":[]},{"id":"rencheng-p-446bb8cab23e49","name":"杨准","facts":[],"aliases":[]},{"id":"rencheng-p-706d5cc77806c2","name":"裴頠","facts":[],"aliases":[]},{"id":"rencheng-p-be9a88f6efb025","name":"乐广","facts":[],"aliases":[]}],"evidence":[{"id":"rencheng-q-5dc8acf93de2660623f5","section":"chapter-019","block":"b-0279652fcb2d8e53cffc","layer":"pei","quote":"准子峤，字国彦；髦，字士彦：并为后出之俊。准与裴頠 、乐广善，遣往见之。頠性弘方，爱峤之有高韵。谓准曰：‘峤当及卿，然髦小减也。’广性清淳，爱髦之有神检。谓准曰：‘峤自及卿，然髦尤精出。’准叹曰：‘我二儿之优劣，乃裴、乐之优劣也！’评者以为，峤虽有高韵，而神检不逮，广言为得。","attribution":"裴注引荀绰《冀州记》","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":67,"anchor":null},"note_id":"n-8d693fbc0efee664288c","start":98,"end":236}],"profiles":{},"directory_counts":{}}
