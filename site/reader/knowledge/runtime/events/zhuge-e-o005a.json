{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhuge-e-o005a","title":"刘备三往草庐见诸葛亮问策","accounts":[{"id":"zhuge-e-o005a-account","label":"《诸葛亮传第五》正文","text":"刘备三往草庐见诸葛亮问策","evidence":["zhuge-e-o005a-q"]},{"id":"zhuge-a-p024-judgment","label":"裴松之按","text":"裴松之按三顾在刘备败军前一年，并辨出师表二十一年的起算。","evidence":["zhuge-q-p024-judgment"]}],"participants":[{"person":"liu-bei","role":"访贤","evidence":["zhuge-e-o005a-q"]},{"person":"zhuge-liang","role":"受访","evidence":["zhuge-e-o005a-q"]}],"place":null,"time":{"year":207,"label":"刘备三顾时","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"zhuge-y207","dating_review":{"reviewed":true,"anchor":"zhuge-q-o005","basis":"刘备三顾时"},"evidence":["zhuge-e-o005a-q","zhuge-q-o005","zhuge-q-b-40accddaa1b32119c6cb"]},"ordering_evidence":"zhuge-e-o005a-q","source_order":[35,31,"O005a"],"order":6756}],"persons":[{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"zhuge-liang","name":"诸葛亮","facts":[],"aliases":[]}],"evidence":[{"id":"zhuge-e-o005a-q","section":"chapter-035","block":"b-e33c66499df69116b2fc","layer":"original","quote":"由是先主遂诣亮；凡三往，乃见。因屏人曰〖1〗：“汉室倾颓，奸臣窃命〖2〗，主上蒙尘〖3〗。孤不度德量力〖4〗，欲信大义于天下〖5〗；而智术短浅，遂用猖獗〖6〗。至于今日，然志犹未已，君谓计将安出？”","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":30,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":99,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-b-40accddaa1b32119c6cb","section":"chapter-035","block":"b-40accddaa1b32119c6cb","layer":"modern","quote":"〖39〗尔来：从那以来。这一句总括上文，所以是从刘备三顾时的建安十二年（公元 207）算起。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":198,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1692331886f906f52ea2","start":0,"end":46,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-o005","section":"chapter-035","block":"b-e33c66499df69116b2fc","layer":"original","quote":"由是先主遂诣亮；凡三往，乃见。因屏人曰〖1〗：“汉室倾颓，奸臣窃命〖2〗，主上蒙尘〖3〗。孤不度德量力〖4〗，欲信大义于天下〖5〗；而智术短浅，遂用猖獗〖6〗。至于今日，然志犹未已，君谓计将安出？”","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":30,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":99,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-p024-judgment","section":"chapter-035","block":"b-80cdf8b436586cc1dcd1","layer":"pei","quote":"﹝一﹞臣松之按：刘备以建安十三年败，遗亮使吴；亮以建兴五年抗表北伐，自倾覆至此，整二十年。然则备始与亮相遇，在败军之前一年时也。","attribution":"裴松之按","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":210,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-e17d0680d781a9a6c883","start":0,"end":64,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
