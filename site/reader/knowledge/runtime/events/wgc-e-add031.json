{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wgc-e-add031","title":"世语记师纂与邓艾俱死","order":5693,"accounts":[{"id":"wgc-a-add031","label":"汉晋春秋；世语","text":"世语记师纂与邓艾俱死","evidence":["wgc-q0678","wgc-q0123"]}],"participants":[{"person":"wgc-p0033","role":"遇害","evidence":["wgc-q0678","wgc-q0123"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0678","wgc-q0123"]},"ordering_evidence":"wgc-q0678"}],"persons":[{"id":"wgc-p0033","name":"师纂","facts":[],"aliases":[]}],"evidence":[{"id":"wgc-q0123","section":"chapter-028","block":"b-46cb05252baea122f899","layer":"pei","quote":"﹝一﹞《汉晋春秋》曰：“初，艾之下江由也，以续不进，欲斩，既而舍之。及瓘遣续，谓曰：‘可以报江由之辱矣！’杜预言于众曰：‘伯玉其不免乎！身为名士，位望已高。既无德音，又不御下以正；是小人而乘君子之器，将何以堪其责乎？’瓘闻之，不俟驾而谢。”《世语》曰：“师纂亦与艾俱死。纂，性急少恩，死之日体无完皮。”","attribution":"汉晋春秋；世语","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":400,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-708919d257dd4281bec0","start":0,"end":151,"offset_unit":"unicode_code_point"},{"id":"wgc-q0678","section":"chapter-028","block":"b-46cb05252baea122f899","layer":"pei","quote":"师纂亦与艾俱死。","attribution":"汉晋春秋；世语","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":400,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-708919d257dd4281bec0","start":127,"end":135,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
