{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p060a","title":"许攸向曹操详陈乌巢可袭","accounts":[{"id":"wudi-e-p060a-account","label":"《曹瞒传》","text":"《曹瞒传》记许攸追问曹操粮情，说明故市、乌巢粮储防备松懈，劝以轻兵袭烧。","evidence":["wudi-e-p060a-q"]}],"participants":[{"person":"wudi-p0038","role":"献策","evidence":["wudi-e-p060a-q"]},{"person":"cao-cao","role":"问计纳策","evidence":["wudi-e-p060a-q"]}],"place":{"text":"故市、乌巢","evidence":["wudi-e-p060a-q"]},"time":{"label":"建安五年冬十月","year":200,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-p060a-q","wudi-q-o071","wudi-q-b-9900125064e5d85f08ad"],"chronology":"wudi-y200","dating_review":{"anchor":"wudi-q-o071","basis":"建安五年冬十月","reviewed":true}},"source_order":[1,453,"P060a"],"order":195}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0038","name":"许攸","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-p060a-q","section":"chapter-001","block":"b-abd4b2bac1fa03787470","layer":"pei","quote":"公闻攸来，跣出迎之，抚掌笑曰：‘子卿远来，吾事济矣！’既入坐，谓公曰：‘袁氏军盛，何以待之？今有几粮乎？’公曰：‘尚可支一岁。’攸自：‘无是，更言之！’又曰：‘可支半岁。’攸曰：‘足下不欲破袁氏邪？何言之不实也！’公曰：‘向言戏之耳！其实可一月，为之奈何？’攸曰：‘公孤军独守，外无救援而粮谷已尽，此危急之日也。今袁氏辎重有万余乘，在故市、乌巢，屯军无严备。今以轻兵袭之，不意而至，燔其积聚。不过三日，袁氏自败也。’","attribution":"《曹瞒传》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":452,"anchor":null},"note_id":"n-28c22dc25bf80c877b3b","start":11,"end":219},{"id":"wudi-q-b-9900125064e5d85f08ad","section":"chapter-001","block":"b-9900125064e5d85f08ad","layer":"modern","quote":"〖1〗五年：建安五年（公元 200）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":403,"anchor":null},"note_id":"n-744e4aee7f5ff14cca85","start":0,"end":19},{"id":"wudi-q-o071","section":"chapter-001","block":"b-c9f735ddad48a8f5c2b6","layer":"original","quote":"五年春正月〖1〗，董承等谋泄，皆伏诛。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":400,"anchor":null},"note_