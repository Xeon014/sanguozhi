{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p016b","title":"灵帝停巡并征王芬","accounts":[{"id":"wudi-e-p016b-account","label":"《九州春秋》","text":"王芬计划乘灵帝北巡起事；灵帝因天象停止北行，命其罢兵并征召，王芬恐惧自杀。","evidence":["wudi-e-p016b-q"]}],"participants":[{"person":"wudi-p0025","role":"停巡征召","evidence":["wudi-e-p016b-q"]},{"person":"wudi-p0037","role":"谋划后自杀","evidence":["wudi-e-p016b-q"]}],"place":null,"time":{"label":"王芬结谋之后","precision":"relative","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p016b-q"]},"source_order":[1,58,"P016b"],"order":34}],"persons":[{"id":"wudi-p0025","name":"汉灵帝","facts":[],"aliases":[]},{"id":"wudi-p0037","name":"王芬","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-p016b-q","section":"chapter-001","block":"b-27342ea0cc40a8b4e589","layer":"pei","quote":"灵帝欲北巡河间旧宅，芬等谋因此作难，上书言黑山贼攻劫郡县，求得起兵。会北方有赤气，东西竟天。太史上言‘当有阴谋，不宜北行’，帝乃止。敕芬罢兵，俄而征之；芬惧，自杀。","attribution":"《九州春秋》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":57,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4ada009fc136a7fb3275","start":86,"end":168,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
