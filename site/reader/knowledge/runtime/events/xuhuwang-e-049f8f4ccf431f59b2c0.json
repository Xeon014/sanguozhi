{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xuhuwang-e-049f8f4ccf431f59b2c0","title":"胡威单驴省胡质受父俸绢后拒都督私助胡质杖黜都督","accounts":[{"id":"xuhuwang-a-049f8f4ccf431f59b2c0","label":"裴注·晋阳秋","text":"胡威单驴省胡质受父俸绢后拒都督私助胡质杖黜都督","evidence":["xuhuwang-q-ce71e33e8b7d9de2d65d"]}],"participants":[{"person":"xuhuwang-p-7f4c2f69fa2f59","role":"省父拒助","evidence":["xuhuwang-q-ce71e33e8b7d9de2d65d"]},{"person":"mingdi-p0047","role":"赐俸绢杖黜吏","evidence":["xuhuwang-q-ce71e33e8b7d9de2d65d"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["xuhuwang-q-ce71e33e8b7d9de2d65d"]},"ordering_evidence":"xuhuwang-q-ce71e33e8b7d9de2d65d","order":5329}],"persons":[{"id":"mingdi-p0047","name":"胡质","facts":[],"aliases":[]},{"id":"xuhuwang-p-7f4c2f69fa2f59","name":"胡威","facts":[],"aliases":[]}],"evidence":[{"id":"xuhuwang-q-ce71e33e8b7d9de2d65d","section":"chapter-027","block":"b-2ca66686fb59291c3c67","layer":"pei","quote":"《晋阳秋》曰：“威字伯虎。少有志尚，厉操清白。质之为荆州也，威自京都省之。家贫，无车马童仆；威自驱驴单行，拜见父。停厩中十余日，告归。临辞，质赐绢一疋，为道路粮。威跪曰：‘大人清白，不审于何得此绢？’质曰：‘是吾俸禄之余，故以为汝粮耳。’威受之，辞归。每至客舍，自放驴，取樵炊爨；食毕，复随旅进道，往还如是。质帐下都督，素不相识；先其将归，请假还家，阴资装百余里，要之；因与为伴，每事佐助经营之，又少进饮食。行数百里，威疑之，密诱问，乃知其都督也，因取向所赐绢答谢而遣之。后因他信，具以白质。质杖其都督一百，除吏名。其父子清慎如此。","attribution":"裴注·晋阳秋","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":105,"anchor":null},"note_id":"n-9beb8bc557f58ac63c4b","start":3,"end":269}],"profiles":{},"directory_counts":{}}
