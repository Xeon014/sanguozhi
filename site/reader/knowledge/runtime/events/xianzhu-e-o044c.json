{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-o044c","title":"刘备下公安关羽入益阳","accounts":[{"id":"xianzhu-e-o044c-account","label":"《先主传》正文","text":"刘备引五万兵下公安，命关羽入益阳。","evidence":["xianzhu-e-o044c-q"]},{"id":"zhouyu-e-o058b-account","label":"《周瑜鲁肃吕蒙传》正文","text":"刘备得益州后：刘备还公安遣关羽争郡鲁肃益阳拒","evidence":["zhouyu-e-o058b-q"]},{"id":"zhouyu-e-o081b-account","label":"《周瑜鲁肃吕蒙传》正文","text":"取三郡时：刘备至公安遣关羽争郡孙权使鲁肃益阳拒羽","evidence":["zhouyu-e-o081b-q"]}],"participants":[{"person":"liu-bei","role":"率军","evidence":["xianzhu-e-o044c-q"]},{"person":"wudi-p0172","role":"进军","evidence":["xianzhu-e-o044c-q"]},{"person":"lu-su","role":"拒守","evidence":["zhouyu-e-o058b-q"]},{"person":"sun-quan","role":"遣军","evidence":["zhouyu-e-o081b-q"]}],"place":{"text":"公安、益阳","evidence":["xianzhu-e-o044c-q"]},"time":{"year":215,"label":"建安二十年","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xianzhu-y215","dating_review":{"reviewed":true,"anchor":"xianzhu-q-o044","basis":"建安二十年"},"evidence":["xianzhu-e-o044c-q","xianzhu-q-o044","xianzhu-q-b-e74ba7effc86126dc3fe"]},"source_order":[32,200,"O044c"],"order":6576}],"persons":[{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"lu-su","name":"鲁肃","facts":[],"aliases":[]},{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"wudi-p0172","name":"关羽","facts":[],"aliases":[]}],"evidence":[{"id":"xianzhu-e-o044c-q","section":"chapter-032","block":"b-fcd99756379fb59ed6f5","layer":"original","quote":"先主引兵五万下公安，令关羽入益阳〖4〗。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":199,"anchor":null},"note_id":null,"start":72,"end":92},{"id":"xianzhu-q-b-e74ba7effc86126dc3fe","section":"chapter-032","block":"b-e74ba7effc86126dc3fe","layer":"modern","quote":"〖1〗二十年：建安二十年（公元 215）。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":212,"anchor":null},"note_id":"n-5302047b97c4e4d2cb00","start":0,"end":21},{"id":"xianzhu-q-o044","section":"chapter-032","block":"b-fcd99756379fb59ed6f5","layer":"original","quote":"二十年〖1〗，孙权以先主已得益州，使使报“欲得荆州〖2〗”。先主言：“须得凉州，当以荆州相与。”权忿之，乃遣吕蒙袭夺长沙、零陵、桂阳三郡〖3〗。先主引兵五万下公安，令关羽入益阳〖4〗。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":199,"anchor":null},"note_id":null,"start":0,"end":92},{"id":"zhouyu-e-o058b-q","section":"chapter-054","block":"b-20eaf3786f782c63ee9e","layer":"original","quote":"备闻，自还公安，遣羽争三郡。肃住益阳，与羽相拒。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":279,"anchor":null},"note_id":null,"start":32,"end":56},{"id":"zhouyu-e-o081b-q","section":"chapter-054","block":"b-82ba5f92bc12b49d8842","layer":"original","quote":"而备自蜀亲至公安，遣羽争三郡。权时住陆口，使鲁肃将万人屯益阳拒羽；","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":380,"anchor":null},"note_id":null,"start":56,"end":89}],"profiles":{},"directory_counts":{}}
