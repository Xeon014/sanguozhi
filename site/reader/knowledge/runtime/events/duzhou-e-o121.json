{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"duzhou-e-o121","title":"来敏显言怨谤","accounts":[{"id":"duzhou-a-7122a67ad0e89d2305d6","label":"裴注·亮集","text":"来敏显言怨谤","evidence":["duzhou-q-8a626e172dcd7af34578"]},{"id":"duzhou-a-06e273f761b49a995d88","label":"裴注·亮集","text":"亮教责来敏表退职","evidence":["duzhou-q-90b3c4ccfea35e68e1b1"]}],"participants":[{"person":"jfj-p0012","role":"对上官显言新人有何功德而夺我荣资与之、诸人共憎我；被教斥，退职","evidence":["duzhou-q-8a626e172dcd7af34578","duzhou-q-90b3c4ccfea35e68e1b1"]},{"person":"zhuge-liang","role":"教称来敏年老狂悖生此怨言，昔成都初定议者以为乱群而先帝含容无所礼用，后主上即位复擢为将军祭酒，自责暗于知人，表退职使闭门思愆","evidence":["duzhou-q-90b3c4ccfea35e68e1b1"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["duzhou-q-8a626e172dcd7af34578","duzhou-q-90b3c4ccfea35e68e1b1"]},"ordering_evidence":"duzhou-q-8a626e172dcd7af34578","source_order":[42,192,12],"order":7527}],"persons":[{"id":"jfj-p0012","name":"来敏","facts":[],"aliases":[]},{"id":"zhuge-liang","name":"诸葛亮","facts":[],"aliases":[]}],"evidence":[{"id":"duzhou-q-8a626e172dcd7af34578","section":"chapter-042","block":"b-cbf609212e86d9576f0c","layer":"pei","quote":"将军来敏，对上官显言：‘新人有何功德，而夺我荣资与之邪？诸人共憎我，何故如是","attribution":"裴注·亮集","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":191,"anchor":null},"note_id":"n-aa7854e2fc6c1c28d3ab","start":12,"end":50},{"id":"duzhou-q-90b3c4ccfea35e68e1b1","section":"chapter-042","block":"b-cbf609212e86d9576f0c","layer":"pei","quote":"敏年老狂悖，生此怨言。昔成都初定，议者以为来敏乱群；先帝以新定之际，故遂含容，无所礼用。后刘子初选以为太子家令，先帝不悦而不忍拒也。后，主〔上〕即位，吾暗于知人，遂复擢为将军、祭酒；违议者之审见，背先帝所疏外；自谓能以敦厉薄俗，帅之以义。今既不能，表退职使，闭门思愆","attribution":"裴注·亮集","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":191,"anchor":null},"note_id":"n-aa7854e2fc6c1c28d3ab","start":52,"end":185}],"profiles":{},"directory_counts":{}}
