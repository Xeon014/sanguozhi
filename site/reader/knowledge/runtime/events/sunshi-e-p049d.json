{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"sunshi-e-p049d","title":"高岱见许贡说释母预令张允沈3备船脱追","accounts":[{"id":"sunshi-e-p049d-account","label":"《吴录》","text":"高岱见许贡说释母预令张允沈3备船脱追","evidence":["sunshi-e-p049d-q"]}],"participants":[{"person":"sunshi-p0077","role":"救母脱逃","evidence":["sunshi-e-p049d-q"]},{"person":"sunshi-p0036","role":"释母追杀","evidence":["sunshi-e-p049d-q"]},{"person":"sunshi-p0080","role":"备船","evidence":["sunshi-e-p049d-q"]},{"person":"sunshi-p0081","role":"备船","evidence":["sunshi-e-p049d-q"]}],"place":null,"time":{"label":"高岱受孙策召前后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["sunshi-e-p049d-q"]},"ordering_evidence":"sunshi-e-p049d-q","source_order":[46,278,"P049d"],"order":8133}],"persons":[{"id":"sunshi-p0036","name":"许贡","facts":[],"aliases":[]},{"id":"sunshi-p0077","name":"高岱","facts":[],"aliases":[]},{"id":"sunshi-p0080","name":"张允","facts":[],"aliases":[]},{"id":"sunshi-p0081","name":"沈3","facts":[],"aliases":[]}],"evidence":[{"id":"sunshi-e-p049d-q","section":"chapter-046","block":"b-96d4b25d5c0244aea4a1","layer":"pei","quote":"岱得谦书以还，而贡已囚其母。吴人大小，皆为危竦；以贡宿忿，往必见害。岱言：‘在君则为君；且母在牢狱，期于当往；若得入见，事自当解。’遂通书自白，贡即与相见。才辞敏捷，好自陈谢，贡登时出其母。岱将见贡，语友人张允、沈3 ，令预具船。以贡必悔，当追逐之；出便将母乘船，易道而逃。贡须臾遣人追之，令追者：‘若及于船，江上便杀之！已过则止。’使与岱错道，遂免。","attribution":"《吴录》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":277,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9299c159b0512c392271","start":326,"end":502,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
