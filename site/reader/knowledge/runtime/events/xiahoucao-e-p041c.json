{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xiahoucao-e-p041c","title":"桓范正始拜大司农持世要论求蒋济观书被拒而怒","accounts":[{"id":"xiahoucao-e-p041c-account","label":"《魏略》","text":"桓范正始拜大司农持世要论求蒋济观书被拒而怒","evidence":["xiahoucao-e-p041c-q"]}],"participants":[{"person":"shaodi-p0030","role":"任官著书","evidence":["xiahoucao-e-p041c-q"]},{"person":"shaodi-p0009","role":"拒看","evidence":["xiahoucao-e-p041c-q"]}],"place":null,"time":{"label":"桓范仕魏至高平陵事","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xiahoucao-e-p041c-q"]},"ordering_evidence":"xiahoucao-e-p041c-q","source_order":[9,375,"P041c"],"order":2297}],"persons":[{"id":"shaodi-p0009","name":"蒋济","facts":[],"aliases":[]},{"id":"shaodi-p0030","name":"桓范","facts":[],"aliases":[]}],"evidence":[{"id":"xiahoucao-e-p041c-q","section":"chapter-009","block":"b-e208aef32668918e941e","layer":"pei","quote":"正始中拜大司农。范前在台阁，号为晓事；及为司农，又以清省称。范尝抄撮《汉书》中诸杂事，自以意斟酌之，名曰《世要论》。蒋济为太尉，尝与范会社下，群卿列坐有数人；范怀其所撰，欲以示济；谓济当虚心观之。范出其书以示左右，左右传之示济；济不肯视，范心恨之。因论他事，乃发怒谓济曰：‘我祖薄德，公辈何似邪！’济性虽强毅，亦知范刚毅，睨而不应；各罢。","attribution":"《魏略》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":374,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-45775d68baddd17aab59","start":278,"end":447,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
