{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"gongsuntao-e-o181","title":"谦谢朝廷不为温温置酒待之如初","accounts":[{"id":"gongsuntao-a-de798258add2f92004db","label":"裴注·吴书","text":"谦谢朝廷不为温温置酒待之如初","evidence":["gongsuntao-q-c7ca626093c5f9742adc"]}],"participants":[{"person":"wudi-p0095","role":"至、仰曰谦自谢朝廷岂为公邪","evidence":["gongsuntao-q-c7ca626093c5f9742adc"]},{"person":"wudi-p0021","role":"于宫门见谦、曰恭祖痴病尚未除邪、遂为之置酒待之如初","evidence":["gongsuntao-q-c7ca626093c5f9742adc"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["gongsuntao-q-c7ca626093c5f9742adc"]},"ordering_evidence":"gongsuntao-q-c7ca626093c5f9742adc","source_order":[8,139,199],"order":1991}],"persons":[{"id":"wudi-p0021","name":"张温","facts":[],"aliases":[]},{"id":"wudi-p0095","name":"陶谦","facts":[],"aliases":[]}],"evidence":[{"id":"gongsuntao-q-c7ca626093c5f9742adc","section":"chapter-008","block":"b-c4198bc46fa6feff3103","layer":"pei","quote":"谦至，或又谓谦曰：‘足下轻辱三公，罪自己作；今蒙释宥，德莫厚矣！宜降志卑辞以谢之。’谦曰：‘诺！’又谓温曰：‘陶恭祖今深自罪责，思在变革。谢天子礼毕，必诣公门。公宜见之，以慰其意。’时温于宫门见谦，谦仰曰：‘谦自谢朝廷，岂为公邪？’温曰：‘恭祖，痴病尚未除邪？’遂为之置酒，待之如初","attribution":"裴注·吴书","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":138,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c1f621558943f04cf069","start":199,"end":340,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
