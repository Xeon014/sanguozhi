{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o134a","title":"曹操解释喜见诸部会集","accounts":[{"id":"wudi-e-o134a-account","label":"正文","text":"曹操战后说明联军虽多却不相统属，会集后比各据险阻更易一战击破。","evidence":["wudi-e-o134a-q"]}],"participants":[{"person":"cao-cao","role":"解释判断","evidence":["wudi-e-o134a-q"]}],"place":{"text":"关中","evidence":["wudi-e-o134a-q"]},"time":{"label":"关中战后","year":211,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o134a-q","wudi-q-o128","wudi-q-b-2dc1a34b174874acae8b"],"chronology":"wudi-y211","dating_review":{"anchor":"wudi-q-o128","basis":"关中战后","reviewed":true}},"source_order":[1,744,"O134a"],"order":317}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-o134a-q","section":"chapter-001","block":"b-7fd2aa91dc67263126a2","layer":"original","quote":"始，贼每一部到，公辄有喜色。贼破之后，诸将问其故。公答曰：“关中长远，若贼各依险阻；征之，不一二年不可定也。今皆来集，其众虽多，莫相归服，军无嫡主〖24〗。一举可灭，为功差易〖25〗，吾是以喜。”","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":68,"anchor":null},"note_id":null,"start":0,"end":98},{"id":"wudi-q-b-2dc1a34b174874acae8b","section":"chapter-001","block":"b-2dc1a34b174874acae8b","layer":"modern","quote":"〖1〗十六年：建安十六年（公元 211）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":54,"anchor":null},"note_id":"n-889c5acff5776ef2f54b","start":0,"end":21},{"id":"wudi-q-o128","section":"chapter-001","block":"b-37e542ccc37d1632e170","layer":"original","quote":"十六年春正月〖1〗，﹝一﹞天子命公世子丕为五官中郎将〖2〗，置官属〖3〗；为丞相副。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":51,"anchor":null},"note_id":null,"start":0,"end":42}],"profiles":{},"directory_counts":{}}
