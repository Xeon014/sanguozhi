{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o124b","title":"曹操令赡恤死难将士家属","accounts":[{"id":"wudi-e-o124b-account","label":"正文","text":"曹操令对死亡将士中无产业、自存困难的家庭不断供粮，并命地方长官存恤。","evidence":["wudi-e-o124b-q"]}],"participants":[{"person":"cao-cao","role":"颁恤令","evidence":["wudi-e-o124b-q"]}],"place":null,"time":{"label":"建安十四年七月辛未","year":209,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o124b-q","wudi-q-o123","wudi-q-b-adc09608ceebbfa5d20b"],"chronology":"wudi-y209","dating_review":{"anchor":"wudi-q-o123","basis":"建安十四年七月辛未","reviewed":true}},"source_order":[1,692,"O124b"],"order":292}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-o124b-q","section":"chapter-001","block":"b-6668d55c18f139909c63","layer":"original","quote":"辛未〖4〗，令曰：“自顷以来〖5〗，军数征行，或遇疫气〖6〗。吏士死亡不归，家室怨旷〖7〗，百姓流离。而仁者岂乐之哉〖8〗？不得已也！其令死者家无基业不能自存者，县官勿绝廪〖9〗。长吏存恤抚循〖10〗，以称吾意。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":16,"anchor":null},"note_id":null,"start":23,"end":129},{"id":"wudi-q-b-adc09608ceebbfa5d20b","section":"chapter-001","block":"b-adc09608ceebbfa5d20b","layer":"modern","quote":"〖1〗十四年：建安十四年（公元 209）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":21,"anchor":null},"note_id":"n-d10efd0ae163541dd9f1","start":0,"end":21},{"id":"wudi-q-o123","section":"chapter-001","block":"b-e79589d3a37d29329144","layer":"original","quote":"十四年春三月〖1〗，军至谯。作轻舟，治水军。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":15,"anchor":null},"note_id":null,"start":0,"end":22}],"profiles":{},"directory_counts":{}}
