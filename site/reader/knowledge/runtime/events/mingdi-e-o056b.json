{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"mingdi-e-o056b","title":"毌丘俭屯辽东征渊公孙渊反连雨引还","accounts":[{"id":"mingdi-e-o056b-account","label":"《明帝纪》正文","text":"毌丘俭屯辽东征渊公孙渊反连雨引还","evidence":["mingdi-e-o056b-q"]},{"id":"wgc-a-0-e53","label":"正文","text":"毌丘俭率幽州诸军至襄平屯辽隧","evidence":["wgc-q0198","wgc-q0013"]},{"id":"wgc-a-0-e56","label":"正文","text":"毌丘俭与公孙渊交战不利退还","evidence":["wgc-q0201","wgc-q0013"]},{"id":"gongsuntao-a-b71ca95b99f34038643f","label":"正文","text":"景初元年遣毌丘俭赍玺书征渊","evidence":["gongsuntao-q-378aef565c1a8df68e1c"]},{"id":"gongsuntao-a-3e61dcad0d7a95fb25c0","label":"正文","text":"渊发兵逆辽隧与俭战俭等不利而还","evidence":["gongsuntao-q-3ab7ca992ff00a750eca"]},{"id":"wuhuan-a-d596d19a0030ca1bba97","label":"裴注·《魏略》","text":"景初元年秋遣幽州刺史毌丘俭率众军讨辽东","evidence":["wuhuan-q-3a6632b7be28873d348d"]},{"id":"wuhuan-a-fada43b5939721e3b7f1","label":"裴注·《魏略》","text":"寇娄敦、护留等闻毌丘俭军至，率众五千余人降","evidence":["wuhuan-q-0198688bf29fa32fa3b7"]}],"participants":[{"person":"mingdi-p0048","role":"讨而还","evidence":["mingdi-e-o056b-q"]},{"person":"mingdi-p0013","role":"反叛","evidence":["mingdi-e-o056b-q"]},{"person":"wendi-p0005","role":"遣幽州刺史毌丘俭等赍玺书征渊","evidence":["gongsuntao-q-378aef565c1a8df68e1c"]},{"person":"mingdi-p0049","role":"闻毌丘俭军至率众五千余人降者","evidence":["wuhuan-q-0198688bf29fa32fa3b7"]},{"person":"mingdi-p0050","role":"闻毌丘俭军至率众五千余人降者","evidence":["wuhuan-q-0198688bf29fa32fa3b7"]}],"place":null,"time":{"year":237,"label":"景初元年","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"mingdi-y237","dating_review":{"reviewed":true,"anchor":"mingdi-q-o052","basis":"景初元年"},"evidence":["mingdi-e-o056b-q","mingdi-q-o052","mingdi-q-o059","mingdi-q-b-78ee587f18f11aa30bd9"]},"ordering_evidence":"mingdi-e-o056b-q","source_order":[3,399,"O056b"],"order":919}],"persons":[{"id":"mingdi-p0013","name":"公孙渊","facts":[],"aliases":[]},{"id":"mingdi-p0048","name":"毌丘俭","facts":[],"aliases":[]},{"id":"mingdi-p0049","name":"寇娄敦","facts":[],"aliases":[]},{"id":"mingdi-p0050","name":"护留","facts":[],"aliases":[]},{"id":"wendi-p0005","name":"曹叡","facts":[],"aliases":[]}],"evidence":[{"id":"gongsuntao-q-378aef565c1a8df68e1c","section":"chapter-008","block":"b-ec45344a994b0f5449fa","layer":"original","quote":"景初元年，乃遣幽州刺史毌丘俭等赍玺书征渊","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":196,"anchor":null},"note_id":null,"start":0,"end":20},{"id":"gongsuntao-q-3ab7ca992ff00a750eca","section":"chapter-008","block":"b-ec45344a994b0f5449fa","layer":"original","quote":"渊遂发兵，逆于辽隧〖8〗，与俭等战；俭等不利而还","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":196,"anchor":null},"note_id":null,"start":24,"end":48},{"id":"mingdi-e-o056b-q","section":"chapter-003","block":"b-1bfbb4d6b2f22da8f429","layer":"original","quote":"初，权遣使浮海与高句丽通，欲袭辽东。遣幽州刺史毌丘俭率诸军及鲜卑、乌丸，〖4〗屯辽东南界；玺书征公孙渊〖5〗。渊发兵反，俭进军讨之；会连雨十日，辽水大涨〖6〗，诏俭引军还。右北平乌丸单于寇娄敦、辽西乌丸都督王护留等居辽东〖7〗，率部众随俭内附。己卯〖8〗，诏辽东将吏士民为渊所胁略不得降者，一切赦之〖9〗。辛卯〖10〗，太白昼现。渊自俭还，遂自立为燕王，置百官，称绍汉元年。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":398,"anchor":null},"note_id":null,"start":0,"end":187},{"id":"mingdi-q-b-78ee587f18f11aa30bd9","section":"chapter-003","block":"b-78ee587f18f11aa30bd9","layer":"modern","quote":"〖1〗二年：景初二年（公元 238 ）。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":438,"anchor":null},"note_id":"n-917b5dc4aecce5a0dcf4","start":0,"end":20},{"id":"mingdi-q-o052","section":"chapter-003","block":"b-26b7ecd6c3ecce777040","layer":"original","quote":"景初元年春（正）〔二〕月，壬辰〖1〗，山茌县言黄龙现〖2〗。﹝一﹞于是有司奏，以为魏得地统〖3〗，宜以建丑之月为正〖4〗。三月，定历改年为孟夏四月；﹝二﹞服色尚黄〖5〗；牺牲用白〖6〗；戎事乘黑首白马〖7〗，建大赤之旂〖8〗；朝会，建大白之旗。﹝三﹞改太和历曰景初历〖9〗：其春夏秋冬孟仲季月，虽与正岁不同〖10〗，至于郊祀、迎气、礿祠、蒸尝、巡狩、蒐田、分至启闭、班宣时令、中气早晚、敬授民事〖11〗，皆以正岁斗建为历数之序〖12〗。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":363,"anchor":null},"note_id":null,"start":0,"end":218},{"id":"mingdi-q-o059","section":"chapter-003","block":"b-5790b2efe14805978c50","layer":"original","quote":"二年春正月〖1〗，诏太尉司马宣王。率众讨辽东。﹝一﹞","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":434,"anchor":null},"note_id":null,"start":0,"end":26},{"id":"wgc-q0013","section":"chapter-028","block":"b-4fe83269ebe4037473f5","layer":"original","quote":"迁荆州刺史。青龙中，帝图讨辽东〖7〗，以俭有干策〖8〗，徙为幽州刺史；加度辽将军，使持节，护乌丸校尉。率幽州诸军至襄平〖9〗，屯辽隧〖10〗。右北平乌丸单于寇娄敦、辽西乌丸都督率众王护留等〖11〗，昔随袁尚奔辽东者，率众五千余人降。寇娄敦遣弟阿罗槃等诣阙朝贡〖12〗；封其渠率二十余人为侯、王〖13〗，赐舆马缯采各有差〖14〗。公孙渊逆与俭战，不利〖15〗，引还。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":63,"anchor":null},"note_id":null,"start":0,"end":182},{"id":"wgc-q0198","section":"chapter-028","block":"b-4fe83269ebe4037473f5","layer":"original","quote":"率幽州诸军至襄平〖9〗，屯辽隧","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":63,"anchor":null},"note_id":null,"start":51,"end":66},{"id":"wgc-q0201","section":"chapter-028","block":"b-4fe83269ebe4037473f5","layer":"original","quote":"公孙渊逆与俭战，不利〖15〗，引还","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":63,"anchor":null},"note_id":null,"start":164,"end":181},{"id":"wuhuan-q-0198688bf29fa32fa3b7","section":"chapter-030","block":"b-e365f1ce2f463ad54d0f","layer":"pei","quote":"闻俭军至，率众五千余人降","attribution":"裴注·《魏略》","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":62,"anchor":null},"note_id":"n-83c6bd9592c872635a83","start":73,"end":85},{"id":"wuhuan-q-3a6632b7be28873d348d","section":"chapter-030","block":"b-e365f1ce2f463ad54d0f","layer":"pei","quote":"景初元年秋，遣幽州刺史毌丘俭率众军讨辽东","attribution":"裴注·《魏略》","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":62,"anchor":null},"note_id":"n-83c6bd9592c872635a83","start":10,"end":30}],"profiles":{},"directory_counts":{}}
