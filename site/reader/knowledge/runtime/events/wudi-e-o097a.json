unit":"unicode_code_point"},{"id":"wudi-q-b-6787e3ddd3e334b677d4","section":"chapter-001","block":"b-6787e3ddd3e334b677d4","layer":"modern","quote":"〖1〗九年：建安九年（公元 204）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":510,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c8fff97bafc82c655f3f","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o092","section":"chapter-001","block":"b-3e549c423b15df48398a","layer":"original","quote":"九年春正月〖1〗，济河，遏淇水入白沟以通粮道〖2〗。二月，尚复攻谭，留苏由、审配守邺〖3〗。公进军到洹水〖4〗，由降；既至，攻邺，为土山、地道。武安长尹楷屯毛城〖5〗，通上党粮道〖6〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":506,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":93,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
