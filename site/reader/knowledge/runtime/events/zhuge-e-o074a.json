{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhuge-e-o074a","title":"荀勖和峤奏使陈寿整理诸葛亮故事为二十四篇","accounts":[{"id":"zhuge-e-o074a-account","label":"《诸葛亮传第五》正文","text":"荀勖和峤奏使陈寿整理诸葛亮故事为二十四篇","evidence":["zhuge-e-o074a-q"]}],"participants":[{"person":"xunyu-p0069","role":"奏请","evidence":["zhuge-e-o074a-q"]},{"person":"xunyu-p0070","role":"奏请","evidence":["zhuge-e-o074a-q"]},{"person":"zhuge-p0051","role":"编集","evidence":["zhuge-e-o074a-q"]}],"place":null,"time":{"label":"陈寿编诸葛亮集时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["zhuge-e-o074a-q"]},"ordering_evidence":"zhuge-e-o074a-q","source_order":[35,346,"O074a"],"order":6819}],"persons":[{"id":"xunyu-p0069","name":"荀勖","facts":[],"aliases":[]},{"id":"xunyu-p0070","name":"和峤","facts":[],"aliases":[]},{"id":"zhuge-p0051","name":"陈寿","facts":[],"aliases":[]}],"evidence":[{"id":"zhuge-e-o074a-q","section":"chapter-035","block":"b-96d90e7e8282428156de","layer":"original","quote":"臣寿等言：臣前在著作郎〖1〗，侍中、领中书监、济北侯臣荀勖，中书令、关内侯臣和峤奏〖2〗，使臣定故蜀丞相诸葛亮故事〖3〗。亮毗佐危国〖4〗，负阻不宾；然犹存录其言，耻善有遗〖5〗：诚是大晋光明至德，泽被无疆。自古以来，未之有伦也〖6〗。辄删除复重，随类相从，凡为二十四篇，篇名如右。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":345,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":141,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
