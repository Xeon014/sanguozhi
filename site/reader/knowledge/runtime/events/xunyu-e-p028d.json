{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xunyu-e-p028d","title":"荀粲娶曹洪女妻卒后哀悼岁余亦亡","accounts":[{"id":"xunyu-e-p028d-account","label":"何劭《粲传》","text":"荀粲娶曹洪女妻卒后哀悼岁余亦亡","evidence":["xunyu-e-p028d-q"]}],"participants":[{"person":"xunyu-p0062","role":"成婚悼妻而卒","evidence":["xunyu-e-p028d-q"]},{"person":"xunyu-p0065","role":"成婚而卒","evidence":["xunyu-e-p028d-q"]},{"person":"xunyu-p0063","role":"慰问","evidence":["xunyu-e-p028d-q"]}],"place":null,"time":{"label":"荀粲生平","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xunyu-e-p028d-q"]},"ordering_evidence":"xunyu-e-p028d-q","source_order":[10,187,"P028d"],"order":2466}],"persons":[{"id":"xunyu-p0062","name":"荀粲","facts":[],"aliases":[]},{"id":"xunyu-p0063","name":"傅嘏","facts":[],"aliases":[]},{"id":"xunyu-p0065","name":"曹洪女（荀粲妻）","facts":[],"aliases":[]}],"evidence":[{"id":"xunyu-e-p028d-q","section":"chapter-010","block":"b-13b02a969d44d8988667","layer":"pei","quote":"粲常以妇人者，才智不足论，自宜以色为主。骠骑将军曹洪女，有美色，粲于是聘焉。容服帷帐甚丽，专房欢宴。历年后，妇病亡，未殡；傅嘏往喭粲，粲不哭而神伤。嘏问曰：‘妇人才色并茂为难。子之娶也，遗才而好色，此自易遇。今何哀之甚？’粲曰：‘佳人难再得！顾逝者不能有倾国之色，然未可谓之易遇。’痛悼不能已，岁余亦亡。时年二十九。","attribution":"何劭《粲传》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":186,"anchor":null},"note_id":"n-5921d94ec8d8ad2b9baa","start":426,"end":584}],"profiles":{},"directory_counts":{}}
