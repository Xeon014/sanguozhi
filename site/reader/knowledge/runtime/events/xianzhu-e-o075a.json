{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-o075a","title":"诸葛亮请奉行刘备丧礼遗诏","accounts":[{"id":"xianzhu-e-o075a-account","label":"《先主传》正文","text":"诸葛亮向后主上言，请依刘备遗诏实行百官三日除服、葬期复礼等丧制。","evidence":["xianzhu-e-o075a-q"]}],"participants":[{"person":"zhuge-liang","role":"上言请行","evidence":["xianzhu-e-o075a-q"]},{"person":"xianzhu-p0112","role":"受表","evidence":["xianzhu-e-o075a-q"]},{"person":"liu-bei","role":"遗诏者","evidence":["xianzhu-e-o075a-q"]}],"place":null,"time":{"year":223,"label":"章武三年四月刘备卒后","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xianzhu-y223","dating_review":{"reviewed":true,"anchor":"xianzhu-q-o073","basis":"章武三年四月刘备卒后"},"evidence":["xianzhu-e-o075a-q","xianzhu-q-o073","xianzhu-q-b-c3a154cca1b5578eba4b"]},"source_order":[32,432,"O075a"],"order":6623}],"persons":[{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"xianzhu-p0112","name":"刘禅","facts":[],"aliases":[]},{"id":"zhuge-liang","name":"诸葛亮","facts":[],"aliases":[]}],"evidence":[{"id":"xianzhu-e-o075a-q","section":"chapter-032","block":"b-69d27cbd5d5432add76b","layer":"original","quote":"亮上言于后主曰：“伏惟大行皇帝迈仁树德〖6〗，覆焘无疆〖7〗；昊天不吊〖8〗，寝疾弥留，今月二十四日奄忽升遐〖9〗。臣妾号啕〖10〗，若丧考妣〖11〗。乃顾遗诏，事惟（大）〔太〕宗〖12〗，动容损益〖13〗：‘百僚发哀〖14〗，满三日除服〖15〗，到葬期复如礼〖16〗；其郡国太守、相、都尉，县令、长，三日便除服。’臣亮亲受敕戒，震畏神灵，不敢有违。臣请宣下奉行〖17〗。”","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":431,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":187,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-b-c3a154cca1b5578eba4b","section":"chapter-032","block":"b-c3a154cca1b5578eba4b","layer":"modern","quote":"〖1〗三年：章武三年（公元 223）。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":435,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-51b38d25bb3f712211d0","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o073","section":"chapter-032","block":"b-4232898cf1bcba6ab843","layer":"original","quote":"三年春二月〖1〗，丞相亮自成都到永安。三月，黄元进兵攻临邛县〖2〗。遣将军陈曶﹝一﹞讨元。元军败，顺流下江；为其亲兵所缚，生致成都，斩之。先主病笃，托孤于丞相亮〖3〗；尚书令李严为副。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":429,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":92,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
