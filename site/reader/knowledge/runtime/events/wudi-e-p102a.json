{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p102a","title":"郗虑孔融廷争，曹操调解","accounts":[{"id":"wudi-e-p102a-account","label":"虞溥《江表传》","text":"献帝召见郗虑、孔融，二人互论长短不睦，曹操致书调解。","evidence":["wudi-e-p102a-q"]}],"participants":[{"person":"wudi-p0054","role":"召见","evidence":["wudi-e-p102a-q"]},{"person":"wudi-p0290","role":"争论","evidence":["wudi-e-p102a-q"]},{"person":"wudi-p0155","role":"争论","evidence":["wudi-e-p102a-q"]},{"person":"cao-cao","role":"调解","evidence":["wudi-e-p102a-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p102a-q"]},"source_order":[1,928,"P102a"],"order":337}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0054","name":"汉献帝","facts":[],"aliases":[]},{"id":"wudi-p0155","name":"孔融","facts":[],"aliases":[]},{"id":"wudi-p0290","name":"郗虑","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-p102a-q","section":"chapter-001","block":"b-bb3caf72d73253a7a4a1","layer":"pei","quote":"献帝尝特见虑及少府孔融，问融曰：‘鸿豫何所优长？’融曰：‘可与适道，未可与权。’虑举笏曰：‘融昔宰北海，政散民流；其权安在也！’遂与融互相长短，以至不睦。公以书和解之。","attribution":"虞溥《江表传》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":252,"anchor":null},"note_id":"n-3bf786bbee2fe2b8e5ac","start":10,"end":94}],"profiles":{},"directory_counts":{}}
