{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"sunshi-e-p054c","title":"孙策逐鹿遇许贡客射伤后骑至刺杀三客","accounts":[{"id":"sunshi-e-p054c-account","label":"《江表传》","text":"孙策逐鹿遇许贡客射伤后骑至刺杀三客","evidence":["sunshi-e-p054c-q"]},{"id":"sunshi-e-o035d-account","label":"《孙破虏讨逆传第一》正文","text":"许贡子及客亡匿江边，孙策单骑出遇客而被击伤。","evidence":["sunshi-e-o035d-q"]}],"participants":[{"person":"wudi-p0099","role":"遇刺","evidence":["sunshi-e-p054c-q"]}],"place":null,"time":{"label":"孙策西征及归军时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["sunshi-e-p054c-q"]},"ordering_evidence":"sunshi-e-p054c-q","source_order":[46,283,"P054c"],"order":8142}],"persons":[{"id":"wudi-p0099","name":"孙策","facts":[],"aliases":[]}],"evidence":[{"id":"sunshi-e-o035d-q","section":"chapter-046","block":"b-18e349ce1607f40f98f6","layer":"original","quote":"贡小子与客，亡匿江边。策单骑出，猝与客遇。客击伤策，﹝二﹞创甚〖5〗。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":261,"anchor":null},"note_id":null,"start":7,"end":42},{"id":"sunshi-e-p054c-q","section":"chapter-046","block":"b-430edbfbd26777ab1c88","layer":"pei","quote":"贡奴客潜民间，欲为贡报仇。猎日，猝有三人，即贡客也。策问：‘尔等何人？’答云：‘是韩当兵，在此射鹿耳。’策曰：‘当兵，吾皆识之，未尝见汝等！’因射一人，应弦而倒。余二人怖急，便举弓射策，中颊。后骑寻至，皆刺杀之。","attribution":"《江表传》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":282,"anchor":null},"note_id":"n-26c0935904b6bc636b31","start":208,"end":314}],"profiles":{},"directory_counts":{}}
