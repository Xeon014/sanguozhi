{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wgc-e-3-e12","title":"诸葛恪归果见诛","order":5648,"accounts":[{"id":"wgc-a-3-e12","label":"正文","text":"诸葛恪归果见诛","evidence":["wgc-q0342","wgc-q0041"]},{"id":"santizhu-a-bab611868963a29c9a0f","label":"正文","text":"孙峻伏兵杀诸葛恪","evidence":["santizhu-q-9af715b085fbf5b25cfd"]},{"id":"huangli-a-1ca43c4287968cb5f69a","label":"正文","text":"诸葛恪夷族","evidence":["huangli-q-aff908926256c6f265ff"]}],"participants":[{"person":"shaodi-p0041","role":"归、果见诛","evidence":["wgc-q0342","wgc-q0041"]},{"person":"shaodi-p0075","role":"设伏杀害诸葛恪","evidence":["santizhu-q-9af715b085fbf5b25cfd"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0342","wgc-q0041"]},"ordering_evidence":"wgc-q0342"}],"persons":[{"id":"shaodi-p0041","name":"诸葛恪","facts":[],"aliases":[]},{"id":"shaodi-p0075","name":"孙峻","facts":[],"aliases":[]}],"evidence":[{"id":"huangli-q-aff908926256c6f265ff","section":"chapter-043","block":"b-ffc116c405cea888a171","layer":"original","quote":"恪竟以此夷族","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":246,"anchor":null},"note_id":null,"start":303,"end":309},{"id":"santizhu-q-9af715b085fbf5b25cfd","section":"chapter-048","block":"b-9d8567e5ae6b51a08aeb","layer":"original","quote":"冬十月，大飨〖4〗。武卫将军孙峻，伏兵杀恪于殿堂","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":36,"anchor":null},"note_id":null,"start":0,"end":24},{"id":"wgc-q0041","section":"chapter-028","block":"b-0c032a6da7eae7e225ce","layer":"original","quote":"诸葛恪围合肥新城，不克，退归。艾言景王曰：“孙权已没，大臣未附；吴名宗大族，皆有部曲〖20〗；阻兵仗势，足以（建）〔违〕命。恪新秉国政，而内无其主；不念抚恤上下以立根基，竞于外事〖21〗，虐用其民；悉国之众，顿于坚城，死者万数，载祸而归。此恪获罪之日也。昔子胥、吴起、商鞅、乐毅皆见任时君〖22〗，主没而败。况恪才非四贤，而不虑不患，其亡可待也。”恪归，果见诛。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":267,"anchor":null},"note_id":null,"start":0,"end":181},{"id":"wgc-q0342","section":"chapter-028","block":"b-0c032a6da7eae7e225ce","layer":"original","quote":"恪归，果见诛","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":267,"anchor":null},"note_id":null,"start":174,"end":180}],"profiles":{},"directory_counts":{}}
