{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xiahoucao-e-p041f","title":"桓范随驾见司马懿复位后司蕃自首桓范被收","accounts":[{"id":"xiahoucao-e-p041f-account","label":"《魏略》","text":"桓范随驾见司马懿复位后司蕃自首桓范被收","evidence":["xiahoucao-e-p041f-q"]}],"participants":[{"person":"shaodi-p0030","role":"被收","evidence":["xiahoucao-e-p041f-q"]},{"person":"wudi-p0364","role":"收人","evidence":["xiahoucao-e-p041f-q"]},{"person":"xiahoucao-p0087","role":"自首","evidence":["xiahoucao-e-p041f-q"]}],"place":null,"time":{"label":"桓范仕魏至高平陵事","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xiahoucao-e-p041f-q"]},"ordering_evidence":"xiahoucao-e-p041f-q","source_order":[9,375,"P041f"],"order":2298}],"persons":[{"id":"shaodi-p0030","name":"桓范","facts":[],"aliases":[]},{"id":"wudi-p0364","name":"司马懿","facts":[],"aliases":[]},{"id":"xiahoucao-p0087","name":"司蕃","facts":[],"aliases":[]}],"evidence":[{"id":"xiahoucao-e-p041f-q","section":"chapter-009","block":"b-e208aef32668918e941e","layer":"pei","quote":"范知爽首免而己必坐倡义也，范乃曰：‘老子今兹坐卿兄弟族矣！’爽等既免，帝还宫，遂令范随从。到洛水浮桥北，望见宣王，下车叩头而无言。宣王呼范姓曰：‘桓大夫，何为尔邪？’车驾入宫，有诏范还复位。范诣阙拜章谢，待报。会司蕃诣鸿胪自首，具说范前临出所道。宣王乃忿然曰：‘诬人以反，于法何应？’主者曰：‘科律：反受其罪。’乃收范于阙下。时人持范甚急，范谓部官曰：‘徐之，我亦义士耳。’遂送廷尉。","attribution":"《魏略》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":374,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-45775d68baddd17aab59","start":896,"end":1088,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
