{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"mingdi-e-p016a","title":"曹叡遣臧霸祭受禅坛","accounts":[{"id":"mingdi-e-p016a-account","label":"裴注·魏书","text":"曹叡遣臧霸祭受禅坛","evidence":["mingdi-e-p016a-q"]},{"id":"mingdi-a-p017-disputes","label":"裴注·裴松之按引汉纪","text":"裴松之认为坛非神，无事上帝而祭空坛于义未详。","evidence":["mingdi-q-p017-disputes"]}],"participants":[{"person":"wendi-p0005","role":"遣祠","evidence":["mingdi-e-p016a-q"]},{"person":"wudi-p0147","role":"行祀","evidence":["mingdi-e-p016a-q"]}],"place":{"text":"繁昌","evidence":["mingdi-e-p016a-q"]},"time":{"year":230,"label":"太和四年东巡过繁昌时","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"mingdi-y230","dating_review":{"reviewed":true,"anchor":"mingdi-q-o017","basis":"太和四年东巡过繁昌时"},"evidence":["mingdi-e-p016a-q","mingdi-q-o017","mingdi-q-b-bb76480af553d2282673"]},"ordering_evidence":"mingdi-e-p016a-q","source_order":[3,160,"P016a"],"order":786}],"persons":[{"id":"wendi-p0005","name":"曹叡","facts":[],"aliases":[]},{"id":"wudi-p0147","name":"臧霸","facts":[],"aliases":[]}],"evidence":[{"id":"mingdi-e-p016a-q","section":"chapter-003","block":"b-2c92288e1673a9fe3680","layer":"pei","quote":"﹝一﹞《魏书》曰：“行过繁昌，使执金吾臧霸行太尉事，以特牛祠受禅坛。”","attribution":"裴注·魏书","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":159,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-def77ddd875f95c3d06b","start":0,"end":35,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-b-bb76480af553d2282673","section":"chapter-003","block":"b-bb76480af553d2282673","layer":"modern","quote":"〖1〗四年：太和四年（公元 230）。壬午：旧历初四日。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":130,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-49a340791b1e7816a21a","start":0,"end":28,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-o017","section":"chapter-003","block":"b-cbdedf2111b567dd6b4d","layer":"original","quote":"四年春二月，壬午〖1〗，诏曰：“世之质文〖2〗，随教而变。兵乱以来，经学废绝；后生进趣，不由典谟〖3〗。岂〔朕〕训导未洽〖4〗，将进用者不以德显乎〖5〗？其郎吏学通一经〖6〗，才任牧民；博士课试，擢其高第者〖7〗：亟用〖8〗。其浮华不务道本者〖9〗，皆罢退之。”戊子〖10〗，诏太傅、三公：“以文帝《典论》刻石〖11〗，立于庙门之外。”癸巳〖12〗，以大将军曹真为大司马，骠骑将军司马宣王为大将军，辽东太守公孙渊为车骑将军〖13〗。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":125,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":216,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-p017-disputes","section":"chapter-003","block":"b-47d36f2de2bb650088b9","layer":"pei","quote":"臣松之按：《汉纪》章帝元和三年，“诏高邑县祠即位坛、五成陌，比腊祠门户”。此虽前代已行故事，然为坛以祀天，而坛非神也；今无事于上帝，而致祀于虚坛，求之义典，未详所据。","attribution":"裴注·裴松之按引汉纪","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":160,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-def77ddd875f95c3d06b","start":0,"end":83,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
