{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-o043a","title":"刘备破雒围成都与刘璋出降","accounts":[{"id":"xianzhu-e-o043a-account","label":"《先主传》正文","text":"雒城被攻破后，刘备进围成都数十日，刘璋出降。","evidence":["xianzhu-e-o043a-q"]},{"id":"liuermu-a-d2a587b462db225d62a5","label":"正文","text":"刘备进围成都","evidence":["liuermu-q-372a74443d96afd1eaf3"]},{"id":"liuermu-a-e6ca3e072ecbc124c698","label":"正文","text":"刘璋开城出降","evidence":["liuermu-q-eb74687edaf64229be78"]},{"id":"xumisun-a-6fb201dbf0441307576e","label":"正文","text":"刘备克蜀","evidence":["xumisun-q-a901905117fa8772825c"]},{"id":"xumisun-a-da39c9faf35c99e6361a","label":"正文","text":"刘备遣简雍说刘璋","evidence":["xumisun-q-141f0648710d70617fc4"]},{"id":"xumisun-a-902420e7f74ad302d1b4","label":"正文","text":"刘璋同舆出城归命","evidence":["xumisun-q-6fcf041a4f51e020f3bd"]},{"id":"dongliu-a-fc795096986310bcb5fb","label":"裴注·零陵先贤传","text":"刘备攻成都令军中勿害刘巴","evidence":["dongliu-q-197c86ca1b50d20fc773"]},{"id":"dongliu-a-7b51b3cb2ac7a1ab7174","label":"裴注·零陵先贤传","text":"拔成都士众竞取宝物军用不足","evidence":["dongliu-q-1cf04741bc427cd1c8bf"]},{"id":"duzhou-a-6f07a3df6945a9cad6fd","label":"裴注·续汉书","text":"刘璋失益州","evidence":["duzhou-q-0c7a5225a2522370a91d"]},{"id":"wufan-a-223f1250329b8f070902","label":"正文","text":"刘备卒得益州","evidence":["wufan-q-4b20dfeeaf042ad9fdcc"]}],"participants":[{"person":"liu-bei","role":"攻城受降","evidence":["xianzhu-e-o043a-q"]},{"person":"wudi-p0253","role":"出降","evidence":["xianzhu-e-o043a-q"]},{"person":"xianzhu-p0060","role":"奉遣往说刘璋；与刘璋同舆出城，受其归命","evidence":["xumisun-q-141f0648710d70617fc4","xumisun-q-6fcf041a4f51e020f3bd"]},{"person":"xianzhu-p0065","role":"军令所护、刘备所得甚喜者","evidence":["dongliu-q-197c86ca1b50d20fc773"]}],"place":{"text":"雒城、成都","evidence":["xianzhu-e-o043a-q"]},"time":{"year":214,"label":"建安十九年夏","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xianzhu-y214","dating_review":{"reviewed":true,"anchor":"xianzhu-q-o043","basis":"建安十九年夏"},"evidence":["xianzhu-e-o043a-q","xianzhu-q-o043","xianzhu-q-b-dcc10490c7b3b72c467f"]},"source_order":[32,187,"O043a"],"order":6476}],"persons":[{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"wudi-p0253","name":"刘璋","facts":[],"aliases":[]},{"id":"xianzhu-p0060","name":"简雍","facts":[],"aliases":[]},{"id":"xianzhu-p0065","name":"刘巴","facts":[],"aliases":[]}],"evidence":[{"id":"dongliu-q-197c86ca1b50d20fc773","section":"chapter-039","block":"b-2c4767765d1067e9bda7","layer":"pei","quote":"备攻成都，令军中曰：‘其有害巴者，诛及三族！’及得巴，甚喜","attribution":"裴注·零陵先贤传","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":60,"anchor":null},"note_id":"n-2d8dc5ebd78dc53a5581","start":78,"end":107},{"id":"dongliu-q-1cf04741bc427cd1c8bf","section":"chapter-039","block":"b-7c186dca366e2ac1d61d","layer":"pei","quote":"及拔成都，士众皆舍干戈，赴诸藏竞取宝物；军用不足，备甚忧之","attribution":"裴注·零陵先贤传","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":61,"anchor":null},"note_id":"n-7e683fea2384dd8e3d93","start":248,"end":277},{"id":"duzhou-q-0c7a5225a2522370a91d","section":"chapter-042","block":"b-36a191e5867b8439da0f","layer":"pei","quote":"其年秋，璋失益州","attribution":"裴注·续汉书","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":61,"anchor":null},"note_id":"n-5414957d5a2b7c78d997","start":191,"end":199},{"id":"liuermu-q-372a74443d96afd1eaf3","section":"chapter-031","block":"b-ee803f4f107e02baa0f7","layer":"original","quote":"十九年〖26〗，进围成都数十日。城中尚有精兵三万人，谷帛支一年。吏民咸欲死战","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":73,"anchor":null},"note_id":null,"start":0,"end":38},{"id":"liuermu-q-eb74687edaf64229be78","section":"chapter-031","block":"b-ee803f4f107e02baa0f7","layer":"original","quote":"璋言：“父子在州二十余年，无恩德以加百姓。百姓攻战三年，肌膏草野者〖27〗，以璋故也。何心能安！”遂开城出降，群下莫不流涕","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":73,"anchor":null},"note_id":null,"start":39,"end":100},{"id":"wufan-q-4b20dfeeaf042ad9fdcc","section":"chapter-063","block":"b-43a13b931b91f0a0aaf9","layer":"original","quote":"及壬辰岁〖6〗，范又白言：“岁在甲午〖7〗，刘备当得益州。”后吕岱从蜀还，遇之白帝；说备部众离落〖8〗，死亡且半〖9〗，事必不克。权以难范〖10〗，范曰：“臣所言者，天道也；而岱所见者，人事耳。”备卒得蜀。","section_title":"吴范刘惇赵达传第十八","source":{"file":"OEBPS/Text/titlepage_0133.xhtml","index":3,"anchor":null},"note_id":null,"start":0,"end":103},{"id":"xianzhu-e-o043a-q","section":"chapter-032","block":"b-4a221026fdb893201c62","layer":"original","quote":"十九年夏〖1〗，雒城破；﹝一﹞进围成都，数十日，璋出降。﹝二﹞","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":186,"anchor":null},"note_id":null,"start":0,"end":31},{"id":"xianzhu-q-b-dcc10490c7b3b72c467f","section":"chapter-032","block":"b-dcc10490c7b3b72c467f","layer":"modern","quote":"〖1〗十九年：建安十九年（公元 214）。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":188,"anchor":null},"note_id":"n-dc65792cc6043766510a","start":0,"end":21},{"id":"xianzhu-q-o043","section":"chapter-032","block":"b-4a221026fdb893201c62","layer":"original","quote":"十九年夏〖1〗，雒城破；﹝一﹞进围成都，数十日，璋出降。﹝二﹞蜀中殷盛丰乐，先主置酒大飨士卒；取蜀城中金银分赐将士，还其谷帛。先主复领益州牧：诸葛亮为股肱〖2〗，法正为谋主，关羽、张飞、马超为爪牙〖3〗，许靖、麋竺、简雍为宾友〖4〗。及董和、黄权、李严等〖5〗，本璋之所授用也，吴壹、费观等〖6〗，又璋之婚亲也；彭羕〖7〗，又璋之所排摈也；刘巴者〖8〗，宿昔之所忌恨也：皆处之显任，尽其器能。有志之士，无不竞劝。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":186,"anchor":null},"note_id":null,"start":0,"end":206},{"id":"xumisun-q-141f0648710d70617fc4","section":"chapter-038","block":"b-beecb5429f9f7caa1936","layer":"original","quote":"后先主围成都，遣雍往说璋","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":211,"anchor":null},"note_id":null,"start":15,"end":27},{"id":"xumisun-q-6fcf041a4f51e020f3bd","section":"chapter-038","block":"b-beecb5429f9f7caa1936","layer":"original","quote":"璋遂与雍同舆而载，出城归命","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":211,"anchor":null},"note_id":null,"start":28,"end":41},{"id":"xumisun-q-a901905117fa8772825c","section":"chapter-038","block":"b-4724e70f37115927f07b","layer":"original","quote":"十九年〖1〗，先主克蜀","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":148,"anchor":null},"note_id":null,"start":0,"end":11}],"profiles":{},"directory_counts":{}}
