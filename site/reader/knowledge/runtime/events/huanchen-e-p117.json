{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"huanchen-e-p117","title":"刘晔谮矫专权帝后意解","accounts":[{"id":"huanchen-a-b58f93c2718bdf4ec141","label":"裴注·《世语》","text":"刘晔谮矫专权帝后意解","evidence":["huanchen-q-a2bbfc82c7d1e23f74a3"]}],"participants":[{"person":"wendi-p0071","role":"以先进见幸、因谮矫专权","evidence":["huanchen-q-a2bbfc82c7d1e23f74a3"]},{"person":"wendi-p0072","role":"惧、以问长子本、后数日帝见矫又问二子","evidence":["huanchen-q-a2bbfc82c7d1e23f74a3"]},{"person":"huanchen-p0051","role":"长子、不知所出","evidence":["huanchen-q-a2bbfc82c7d1e23f74a3"]},{"person":"shaodi-p0107","role":"曰主上明圣大人大臣今若不合不过不作公耳、曰陛下意解故见大人也","evidence":["huanchen-q-a2bbfc82c7d1e23f74a3"]},{"person":"wendi-p0005","role":"见矫、曰刘晔构君朕有以迹君朕心故已了、以金五1授之、岂以为小惠君已知朕心顾君妻子未知故也","evidence":["huanchen-q-a2bbfc82c7d1e23f74a3"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["huanchen-q-a2bbfc82c7d1e23f74a3"]},"ordering_evidence":"huanchen-q-a2bbfc82c7d1e23f74a3","source_order":[22,363,10],"order":4575}],"persons":[{"id":"huanchen-p0051","name":"陈本","facts":[],"aliases":[]},{"id":"shaodi-p0107","name":"陈骞","facts":[],"aliases":[]},{"id":"wendi-p0005","name":"曹叡","facts":[],"aliases":[]},{"id":"wendi-p0071","name":"刘晔","facts":[],"aliases":[]},{"id":"wendi-p0072","name":"陈矫","facts":[],"aliases":[]}],"evidence":[{"id":"huanchen-q-a2bbfc82c7d1e23f74a3","section":"chapter-022","block":"b-b81bfbf76058f3460286","layer":"pei","quote":"刘晔以先进见幸，因谮矫专权。矫惧，以问长子本，本不知所出。次子骞曰：‘主上明圣，大人大臣；今若不合，不过不作公耳。’后数日，帝见矫；矫又问二子。骞曰：‘陛下意解，故见大人也。’既入，尽日。帝曰：‘刘晔构君，朕有以迹君；朕心故已了。’以金五1 授之，矫辞。帝曰：‘岂以为小惠？君已知朕心，顾君妻子未知故也","attribution":"裴注·《世语》","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":362,"anchor":null},"note_id":"n-6ec4238f909f9a25cd48","start":10,"end":161}],"profiles":{},"directory_counts":{}}
