{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhuge-e-p004a","title":"诸葛亮石韬徐庶孟建游学论仕进及劝孟建勿拘故乡","accounts":[{"id":"zhuge-e-p004a-account","label":"《魏略》","text":"诸葛亮石韬徐庶孟建游学论仕进及劝孟建勿拘故乡","evidence":["zhuge-e-p004a-q"]}],"participants":[{"person":"zhuge-liang","role":"游学论才","evidence":["zhuge-e-p004a-q"]},{"person":"zhuge-p0010","role":"游学","evidence":["zhuge-e-p004a-q"]},{"person":"zhuge-p0007","role":"游学","evidence":["zhuge-e-p004a-q"]},{"person":"zhuge-p0011","role":"游学","evidence":["zhuge-e-p004a-q"]}],"place":null,"time":{"label":"建安初在荆州","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["zhuge-e-p004a-q"]},"ordering_evidence":"zhuge-e-p004a-q","source_order":[35,27,"P004a"],"order":6754}],"persons":[{"id":"zhuge-liang","name":"诸葛亮","facts":[],"aliases":[]},{"id":"zhuge-p0007","name":"徐庶","facts":[],"aliases":[]},{"id":"zhuge-p0010","name":"石韬","facts":[],"aliases":[]},{"id":"zhuge-p0011","name":"孟建","facts":[],"aliases":[]}],"evidence":[{"id":"zhuge-e-p004a-q","section":"chapter-035","block":"b-2799031265eb93da80f4","layer":"pei","quote":"《魏略》曰：“亮在荆州，以建安初，与颍川石广元，徐元直、汝南孟公威等俱游学。三人务于精熟，而亮独观其大略。每晨夜从容，常抱膝长啸，而谓三人曰：‘卿三人仕进，可至刺史、郡守也。’三人问其‘所至’，亮但笑而不言。后公威思乡里，欲北归；亮谓之曰：‘中国饶士大夫，邀游何必故乡邪！’”","attribution":"《魏略》","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":26,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-e40ccd03a9bef78547a3","start":0,"end":138,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
