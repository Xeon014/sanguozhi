{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"houfei-e-o047a","title":"追封毛后母夏氏野王君","accounts":[{"id":"houfei-e-o047a-account","label":"《后妃传》正文","text":"追封毛后母夏氏野王君","evidence":["houfei-e-o047a-q"]}],"participants":[],"place":null,"time":{"year":236,"label":"青龙四年","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"houfei-y236","dating_review":{"reviewed":true,"anchor":"houfei-q-o025","basis":"青龙四年"},"evidence":["houfei-e-o047a-q","houfei-q-o025","houfei-q-b-64a27e8dc3dd5339d73a"]},"ordering_evidence":"houfei-e-o047a-q","source_order":[5,217,"O047a"],"order":1457}],"persons":[],"evidence":[{"id":"houfei-e-o047a-q","section":"chapter-005","block":"b-6e1d61d2d158c82bd603","layer":"original","quote":"四年〖9〗，追封后母夏，为野王君。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":216,"anchor":null},"note_id":null,"start":0,"end":17},{"id":"houfei-q-b-64a27e8dc3dd5339d73a","section":"chapter-005","block":"b-64a27e8dc3dd5339d73a","layer":"modern","quote":"〖16〗四年：青龙四年（公元 236）。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":114,"anchor":null},"note_id":"n-bd98b8bd7ce8c71de9ac","start":0,"end":20},{"id":"houfei-q-o025","section":"chapter-005","block":"b-0744a279ae4c62a54e64","layer":"original","quote":"青龙二年春，追谥后兄俨曰安城乡穆侯。夏，吴贼寇扬州，以像为伏波将军〖12〗，持节，监诸将东征〖13〗。还，复为射声校尉〖14〗。三年薨〖15〗，追赠卫将军，改封魏昌县，谥曰贞侯。子畅嗣。又封畅弟温、4 、艳，皆为列侯。四年〖16〗，改逸、俨本封，皆曰魏昌侯，谥因故〖17〗。封俨世妇刘为东乡君〖18〗，又追封逸世妇张为安喜君。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":97,"anchor":null},"note_id":null,"start":0,"end":163}],"profiles":{},"directory_counts":{}}
