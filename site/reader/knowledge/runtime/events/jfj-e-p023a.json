{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"jfj-e-p023a","title":"裴松之辨郤正所称仪表仅指好学俭素","order":7852,"accounts":[{"id":"jfj-a-p023a","label":"裴松之按","text":"裴松之辨郤正所称仪表仅指好学俭素","evidence":["jfj-q0252"]}],"participants":[],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"逐条保留原时间；未从邻段自动继承公元年。","evidence":["jfj-q0252"]},"ordering_evidence":"jfj-q0252","related_events":[{"event":"jfj-e-p022a","type":"disputes","evidence":["jfj-q0252","jfj-q0251"]},{"event":"jfj-e-o056a","type":"related","evidence":["jfj-q0252","jfj-q0208"]}]},{"id":"jfj-e-o056a","title":"郤正论姜维好学俭素反对以成败贬人","order":7849,"accounts":[{"id":"jfj-a-o056a","label":"正文","text":"郤正论姜维好学俭素反对以成败贬人","evidence":["jfj-q0208"]}],"participants":[],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"逐条保留原时间；未从邻段自动继承公元年。","evidence":["jfj-q0208"]},"ordering_evidence":"jfj-q0208","related_events":[{"event":"jfj-e-p022a","type":"disputes","evidence":["jfj-q0251","jfj-q0208"]},{"event":"jfj-e-p023a","type":"related","evidence":["jfj-q0252","jfj-q0208"]}]},{"id":"jfj-e-p022a","title":"孙盛反驳郤正论姜维","order":7851,"accounts":[{"id":"jfj-a-p022a","label":"孙盛论","text":"孙盛反驳郤正论姜维","evidence":["jfj-q0251"]}],"participants":[],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"逐条保留原时间；未从邻段自动继承公元年。","evidence":["jfj-q0251"]},"ordering_evidence":"jfj-q0251","related_events":[{"event":"jfj-e-o056a","type":"disputes","evidence":["jfj-q0251","jfj-q0208"]},{"event":"jfj-e-p023a","type":"disputes","evidence":["jfj-q0252","jfj-q0251"]}]}],"persons":[],"evidence":[{"id":"jfj-q0208","section":"chapter-044","block":"b-a9fabec7a7e9f30d546c","layer":"original","quote":"郤正著论论维曰：“姜伯约据上将之重，处群臣之右；宅舍弊薄〖1〗，资财无余；侧室无妾媵之亵〖2〗，后庭无声乐之娱；衣服取供〖3〗，舆马取备；饮食节制，不奢不约〖4〗；官给费用，随手消尽。察其所以然者，非以激贪厉浊〖5〗，抑情自割也〖6〗；直谓如是为足〖7〗，不在多求。凡人之谈，常誉成毁败，扶高抑下；咸以姜维投厝无所〖8〗，身死宗灭，以是贬削〖9〗，不复料擿〖10〗：异乎《春秋》褒贬之义矣。如姜维之乐学不倦，清素节约，自一时之仪表也！”﹝一﹞","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":264,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":221,"offset_unit":"unicode_code_point"},{"id":"jfj-q0251","section":"chapter-044","block":"b-3c1c2f166f89cdf6271d","layer":"pei","quote":"﹝一﹞孙盛曰：“异哉郤氏之论也！夫士虽百行，操业万殊；至于忠孝义节，百行之冠冕也。姜维策名魏室，而外奔蜀朝，违君徇利，不可谓忠；捐亲苟免，不可谓孝；害加旧邦，不可谓义；败不死难，不可谓节；且德政未敷而疲民以逞，居御侮之任而致敌丧守，于夫智勇，莫可云也：凡斯六者，维无一焉。实有魏之逋臣，亡国之乱相；而云人之‘仪表’，斯亦惑矣。纵维好书而微自藻洁，岂异夫盗者分财之义，而程郑降阶之善也！”","attribution":"孙盛论","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":279,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4fd2b1107827b198b4fd","start":0,"end":193,"offset_unit":"unicode_code_point"},{"id":"jfj-q0252","section":"chapter-044","block":"b-ef7d470cc3553be43789","layer":"pei","quote":"臣松之以为：郤正此论，取其可称；不谓维始终行事，皆可准则也。所云“一时仪表”，止在好学与俭素耳。本传及《魏略》皆云，维本无叛心，以急逼归蜀。盛相讥贬，惟可责其背母；余既过苦，又非所以难郤正也。","attribution":"裴松之按","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":280,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4fd2b1107827b198b4fd","start":0,"end":96,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
