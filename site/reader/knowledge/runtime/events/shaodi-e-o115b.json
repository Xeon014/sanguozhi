{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"shaodi-e-o115b","title":"司马昭加大都督黄钺","accounts":[{"id":"shaodi-e-o115b-account","label":"《三少帝纪》正文","text":"司马昭加大都督黄钺","evidence":["shaodi-e-o115b-q"]}],"participants":[{"person":"shaodi-p0045","role":"受任","evidence":["shaodi-e-o115b-q"]}],"place":null,"time":{"year":256,"label":"八月庚午","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"shaodi-y256","dating_review":{"reviewed":true,"anchor":"shaodi-q-o080","basis":"八月庚午"},"evidence":["shaodi-e-o115b-q","shaodi-q-o080","shaodi-q-o117","shaodi-q-b-6209c552405e0ebbdf98"]},"ordering_evidence":"shaodi-e-o115b-q","source_order":[4,509,"O115b"],"order":1176}],"persons":[{"id":"shaodi-p0045","name":"司马昭","facts":[],"aliases":[]}],"evidence":[{"id":"shaodi-e-o115b-q","section":"chapter-004","block":"b-5e29f5fd2ed894b02a53","layer":"original","quote":"癸未〖6〗，安西将军邓艾，大破蜀大将姜维于上邽〖7〗。诏曰：“兵未极武〖8〗，丑虏摧破。斩首获生，动以万计。自顷战克，无如此者。今遣使者犒赐将士，大会临飨，饮宴终日。称朕意焉。”八月，庚午〖9〗，命大将军司马文王加号大都督，奏事不名，假黄钺。癸酉〖10〗，以太尉司马孚为太傅。九月，以司徒高柔为太尉。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":508,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":150,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-b-6209c552405e0ebbdf98","section":"chapter-004","block":"b-6209c552405e0ebbdf98","layer":"modern","quote":"〖1〗二年：甘露二年（公元 257 ）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":535,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4dd98e402a6a8de51491","start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o080","section":"chapter-004","block":"b-5e69a7d6a960c6ff6623","layer":"original","quote":"甘露元年春正月辛丑〖1〗，青龙现轵县井中〖2〗。乙巳〖3〗，沛王林薨〖4〗。﹝一﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":386,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":41,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o117","section":"chapter-004","block":"b-d021e0b00f489a01f208","layer":"original","quote":"二年春二月〖1〗，青龙现温县井中。三月，司空卢毓薨。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":522,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":26,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
