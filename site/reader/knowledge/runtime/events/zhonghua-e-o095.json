{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhonghua-e-o095","title":"明帝尝问汉桓帝时白马令李云上书言帝欲不谛当何得不死","accounts":[{"id":"zhonghua-a-cbada8fd6c13cd686dda","label":"正文","text":"明帝尝问汉桓帝时白马令李云上书言帝欲不谛当何得不死","evidence":["zhonghua-q-d8e325be25dfdd22c77f"]},{"id":"zhonghua-a-be29be09457b2765e79a","label":"正文","text":"王肃对帝问，以为李云本意欲尽心念存补国，杀之未必为是","evidence":["zhonghua-q-e723b3d78fed1d9349d3"]}],"participants":[{"person":"wendi-p0005","role":"发问者","evidence":["zhonghua-q-d8e325be25dfdd22c77f"]},{"person":"wendi-p0151","role":"所问上书之白马令；所论之上书者","evidence":["zhonghua-q-e723b3d78fed1d9349d3"]},{"person":"shaodi-p0033","role":"对答进言者","evidence":["zhonghua-q-e723b3d78fed1d9349d3"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["zhonghua-q-d8e325be25dfdd22c77f","zhonghua-q-e723b3d78fed1d9349d3"]},"ordering_evidence":"zhonghua-q-d8e325be25dfdd22c77f","source_order":[13,460,0],"order":2924}],"persons":[{"id":"shaodi-p0033","name":"王肃","facts":[],"aliases":[]},{"id":"wendi-p0005","name":"曹叡","facts":[],"aliases":[]},{"id":"wendi-p0151","name":"李云","facts":[],"aliases":[]}],"evidence":[{"id":"zhonghua-q-d8e325be25dfdd22c77f","section":"chapter-013","block":"b-6992062517a788e9089d","layer":"original","quote":"帝尝问曰：“汉桓帝时，白马令李云〖1〗，上书言：‘帝者，谛也〖2〗……是帝欲不谛。’当何得不死〖3〗？”","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":459,"anchor":null},"note_id":null,"start":0,"end":52},{"id":"zhonghua-q-e723b3d78fed1d9349d3","section":"chapter-013","block":"b-16130727294ed5e03d1e","layer":"original","quote":"肃对曰：“但为言失逆顺之节；原其本意，皆欲尽心，念存补国。且帝者之威，过于雷霆；杀一匹夫，无异蝼蚁。宽而宥之，可以示容受切言〖4〗，广德宇于天下。故臣以为杀之未必为是也。”","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":460,"anchor":null},"note_id":null,"start":0,"end":86}],"profiles":{},"directory_counts":{}}
