{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-o043b","title":"刘备大飨军士分赐金银","accounts":[{"id":"xianzhu-e-o043b-account","label":"《先主传》正文","text":"刘备置酒犒劳士卒，分赐城中金银，归还谷帛。","evidence":["xianzhu-e-o043b-q"]}],"participants":[{"person":"liu-bei","role":"犒赏","evidence":["xianzhu-e-o043b-q"]}],"place":{"text":"成都","evidence":["xianzhu-e-o043b-q"]},"time":{"year":214,"label":"成都降后","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xianzhu-y214","dating_review":{"reviewed":true,"anchor":"xianzhu-q-o043","basis":"成都降后"},"evidence":["xianzhu-e-o043b-q","xianzhu-q-o043","xianzhu-q-b-dcc10490c7b3b72c467f"]},"source_order":[32,187,"O043b"],"order":6566}],"persons":[{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]}],"evidence":[{"id":"xianzhu-e-o043b-q","section":"chapter-032","block":"b-4a221026fdb893201c62","layer":"original","quote":"蜀中殷盛丰乐，先主置酒大飨士卒；取蜀城中金银分赐将士，还其谷帛。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":186,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":31,"end":63,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-b-dcc10490c7b3b72c467f","section":"chapter-032","block":"b-dcc10490c7b3b72c467f","layer":"modern","quote":"〖1〗十九年：建安十九年（公元 214）。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":188,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-dc65792cc6043766510a","start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o043","section":"chapter-032","block":"b-4a221026fdb893201c62","layer":"original","quote":"十九年夏〖1〗，雒城破；﹝一﹞进围成都，数十日，璋出降。﹝二﹞蜀中殷盛丰乐，先主置酒大飨士卒；取蜀城中金银分赐将士，还其谷帛。先主复领益州牧：诸葛亮为股肱〖2〗，法正为谋主，关羽、张飞、马超为爪牙〖3〗，许靖、麋竺、简雍为宾友〖4〗。及董和、黄权、李严等〖5〗，本璋之所授用也，吴壹、费观等〖6〗，又璋之婚亲也；彭羕〖7〗，又璋之所排摈也；刘巴者〖8〗，宿昔之所忌恨也：皆处之显任，尽其器能。有志之士，无不竞劝。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":186,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":206,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
