704231c7e2739","start":0,"end":19},{"id":"luxun-q-o027","section":"chapter-058","block":"b-1dfb331a9884eb630d46","layer":"original","quote":"七年〖1〗，权使鄱阳太守（孙）〔周〕鲂，谲魏大司马曹休：休果举众入皖〖2〗。乃召逊，假黄钺〖3〗，为大都督，逆休。﹝一﹞休既觉知，耻见欺诱；自恃兵马精多，遂交战。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":135,"anchor":null},"note_id":null,"start":0,"end":81},{"id":"luxun-q-p006-judgment","section":"chapter-058","block":"b-4681854228eee804b6af","layer":"pei","quote":"﹝一﹞陆机为逊铭曰：“魏大司马曹休侵我北鄙。乃假公黄钺，统御六师及中军禁卫而摄行王事；主上执鞭，百司屈膝。”","attribution":"陆机《陆逊铭》","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":146,"anchor":null},"note_id":"n-c79d508b05f0d2a1050a","start":0,"end":54},{"id":"luxun-q-p007-judgment","section":"chapter-058","block":"b-f53c190b7084aaad0d90","layer":"pei","quote":"《吴录》曰：“假逊黄钺，吴王亲执鞭以见之。”","attribution":"《吴录》","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":147,"anchor":null},"note_id":"n-c79d508b05f0d2a1050a","start":0,"end":22}],"profiles":{},"directory_counts":{}}
