{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p156a","title":"曹操制帢以应财乏","accounts":[{"id":"wudi-e-p156a-account","label":"《傅子》","text":"《傅子》记汉末袁绍、崔钧等用缣巾，曹操因天下凶荒财乏，拟皮弁裁帛为帢，以颜色别贵贱。","evidence":["wudi-e-p156a-q"]}],"participants":[{"person":"cao-cao","role":"制帢","evidence":["wudi-e-p156a-q"]},{"person":"wudi-p0052","role":"服缣巾","evidence":["wudi-e-p156a-q"]},{"person":"wudi-p0410","role":"服缣巾","evidence":["wudi-e-p156a-q"]}],"place":null,"time":{"label":"汉末","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p156a-q"]},"source_order":[1,1136,"P156a"],"order":455}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0052","name":"袁绍","facts":[],"aliases":[]},{"id":"wudi-p0410","name":"崔钧","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-p156a-q","section":"chapter-001","block":"b-fd99440f229573f8bf66","layer":"pei","quote":"《傅子》曰：“汉末王公，多委王服，以幅巾为雅。是以袁绍、崔（豹）〔钧〕之徒，虽为将帅，皆著缣巾。魏太祖以天下凶荒，资财乏匮；拟古皮弁，裁缣帛以为帢；合于简易随时之义，以色别其贵贱。于今施行，可谓军容，非国容也。”","attribution":"《傅子》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":460,"anchor":null},"note_id":"n-6c928ccff5d542bc3225","start":0,"end":106}],"profiles":{},"directory_counts":{}}
