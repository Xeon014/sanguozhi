{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhuge-e-o042a","title":"刘禅遣杜琼赠诸葛亮印绶谥忠武侯","accounts":[{"id":"zhuge-e-o042a-account","label":"《诸葛亮传第五》正文","text":"刘禅遣杜琼赠诸葛亮印绶谥忠武侯","evidence":["zhuge-e-o042a-q"]}],"participants":[{"person":"xianzhu-p0112","role":"追赠","evidence":["zhuge-e-o042a-q"]},{"person":"xianzhu-p0099","role":"奉使","evidence":["zhuge-e-o042a-q"]}],"place":null,"time":{"label":"诸葛亮卒后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["zhuge-e-o042a-q"]},"ordering_evidence":"zhuge-e-o042a-q","source_order":[35,262,"O042a"],"order":6803}],"persons":[{"id":"xianzhu-p0099","name":"杜琼","facts":[],"aliases":[]},{"id":"xianzhu-p0112","name":"刘禅","facts":[],"aliases":[]}],"evidence":[{"id":"zhuge-e-o042a-q","section":"chapter-035","block":"b-c2534b7cdaf2fcaa77ca","layer":"original","quote":"诏策曰：“惟君体资文武〖13〗，明睿笃诚；受遗托孤，匡辅朕躬；继绝兴微，志存靖乱。爰整六师，无岁不征；神武赫然，威镇八荒〖14〗；将建殊功于季汉〖15〗，参伊、周之巨勋〖16〗。如何不吊，事临垂克〖17〗，遘疾陨丧〖18〗？朕用伤悼，肝心若裂！夫崇德序功〖19〗，纪行命谥〖20〗；所以光昭将来〖21〗，刊载不朽。今使使持节、左中郎将杜琼〖22〗，赠君丞相、武乡侯印绶，谥君为忠武侯。魂而有灵，嘉兹宠荣〖23〗。呜呼哀哉！呜呼哀哉！”","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":261,"anchor":null},"note_id":null,"start":0,"end":217}],"profiles":{},"directory_counts":{}}
