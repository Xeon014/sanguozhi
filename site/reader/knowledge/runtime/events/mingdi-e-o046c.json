{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"mingdi-e-o046c","title":"曹叡幸许昌","accounts":[{"id":"mingdi-e-o046c-account","label":"《明帝纪》正文","text":"曹叡幸许昌","evidence":["mingdi-e-o046c-q"]}],"participants":[{"person":"wendi-p0005","role":"巡幸","evidence":["mingdi-e-o046c-q"]}],"place":null,"time":{"year":235,"label":"十一月丁酉","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"mingdi-y235","dating_review":{"reviewed":true,"anchor":"mingdi-q-o043","basis":"十一月丁酉"},"evidence":["mingdi-e-o046c-q","mingdi-q-o043","mingdi-q-b-e98ed256e58910694910"]},"ordering_evidence":"mingdi-e-o046c-q","source_order":[3,296,"O046c"],"order":884}],"persons":[{"id":"wendi-p0005","name":"曹叡","facts":[],"aliases":[]}],"evidence":[{"id":"mingdi-e-o046c-q","section":"chapter-003","block":"b-3ff5cbdc8f2c5963da4d","layer":"original","quote":"冬十月，己酉〖15〗，中山王衮薨〖16〗。壬申〖17〗，太白昼现。十一月，丁酉〖18〗，行幸许昌宫。﹝三﹞","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":295,"anchor":null},"note_id":null,"start":0,"end":53},{"id":"mingdi-q-b-e98ed256e58910694910","section":"chapter-003","block":"b-e98ed256e58910694910","layer":"modern","quote":"〖1〗三年：青龙三年（公元 235）。明帝将司马懿提升为太尉，使他让出大将军一职，出自深层次政治考量。太尉作为三公之首，品级地位虽然略高于大将军，但是在控制军事实权和亲近皇帝的程度上，却比不上后者。明帝是要为曹氏亲族的年轻将领腾出这一重要位置，与异姓元勋重臣进行力量平衡，从而保证皇权安定稳固。戊子：旧历初八日。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":297,"anchor":null},"note_id":"n-ddf87e6819a0a2dfe019","start":0,"end":156},{"id":"mingdi-q-o043","section":"chapter-003","block":"b-9b32a12fd737552ea52d","layer":"original","quote":"三年春正月，戊子〖1〗，以大将军司马宣王为太尉。己亥〖2〗。复置朔方郡。京都大疫。丁巳〖3〗，皇太后崩。乙亥〖4〗，陨石于寿光县〖5〗。三月，庚寅〖6〗，葬文德郭后。营陵于首阳陵涧西〖7〗，如终制。﹝一﹞","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":292,"anchor":null},"note_id":null,"start":0,"end":102}],"profiles":{},"directory_counts":{}}
