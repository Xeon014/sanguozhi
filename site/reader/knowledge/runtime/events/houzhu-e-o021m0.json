{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"houzhu-e-o021m0","title":"魏延击破郭淮","accounts":[{"id":"houzhu-a-fa1ebffa72e0","label":"《后主传》正文","text":"魏延击破郭淮","evidence":["houzhu-q-O021"]},{"id":"liuliao-a-23315847c559008edddd","label":"正文","text":"八年延西入羌中大破郭淮于阳溪","evidence":["liuliao-q-2557618cfec704e2a5fb"]},{"id":"dengzhang-a-b221b3f3d04cb914f32e","label":"正文","text":"吴壹魏延破费瑶","evidence":["dengzhang-q-ea66242fd0f929119476"]}],"participants":[{"person":"xianzhu-p0091","role":"击破郭淮者","evidence":["houzhu-q-O021"]},{"person":"mingdi-p0100","role":"被击者","evidence":["houzhu-q-O021"]},{"person":"liuliao-p0011","role":"魏后将军、与延战于阳溪","evidence":["liuliao-q-2557618cfec704e2a5fb"]},{"person":"xianzhu-p0056","role":"建兴八年与魏延入南安界，破魏将费瑶","evidence":["dengzhang-q-ea66242fd0f929119476"]}],"place":null,"time":{"label":"建兴九年","precision":"undated","basis":"保留本段原始时间表达；没有直接绑定的公元年证据，未补公元年。","evidence":["houzhu-q-O021"]},"ordering_evidence":"houzhu-q-O021","source_order":[33,21,"O021m0"],"order":6637}],"persons":[{"id":"liuliao-p0011","name":"费瑶","facts":[],"aliases":[]},{"id":"mingdi-p0100","name":"郭淮","facts":[],"aliases":[]},{"id":"xianzhu-p0056","name":"吴壹","facts":[],"aliases":[]},{"id":"xianzhu-p0091","name":"魏延","facts":[],"aliases":[]}],"evidence":[{"id":"dengzhang-q-ea66242fd0f929119476","section":"chapter-045","block":"b-69ddd63985a2340030f4","layer":"original","quote":"建兴八年，与魏延入南安界，破魏将费瑶","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":259,"anchor":null},"note_id":null,"start":77,"end":95},{"id":"houzhu-q-O021","section":"chapter-033","block":"b-5ba39d4009c0b73e0bbd","layer":"original","quote":"八年秋，魏使司马懿由西城，张郃由子午，曹真由斜谷：﹝一﹞欲攻汉中。丞相亮待之于城固赤坂〖5〗。大雨道绝，真等皆还。是岁，魏延破魏雍州刺史郭淮于阳溪〖6〗。徙鲁王永为甘陵王，梁王理为安平王；皆以鲁、梁在吴分界故也〖7〗。","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":53,"anchor":null},"note_id":null,"start":0,"end":109},{"id":"liuliao-q-2557618cfec704e2a5fb","section":"chapter-040","block":"b-5d6e67bf3c5324f2fdd3","layer":"original","quote":"八年〖4〗，使延西入羌中〖5〗。魏后将军费瑶、雍州刺史郭淮，与延战于阳溪〖6〗。延大破淮等，迁为前军师，征西大将军，假节，进封南郑侯","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":272,"anchor":null},"note_id":null,"start":0,"end":66}],"profiles":{},"directory_counts":{}}
