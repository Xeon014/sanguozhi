{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o013b","title":"曹操赴扬州募兵并遇兵变","accounts":[{"id":"wudi-e-o013b-account","label":"正文","text":"曹操与夏侯惇赴扬州募兵，陈温、周昕资兵四千余；返至龙亢多有叛卒，后再募千余人屯河内。","evidence":["wudi-e-o013b-q"]}],"participants":[{"person":"cao-cao","role":"募兵","evidence":["wudi-e-o013b-q"]},{"person":"wudi-p0027","role":"同行","evidence":["wudi-e-o013b-q"]},{"person":"wudi-p0076","role":"资兵","evidence":["wudi-e-o013b-q"]},{"person":"wudi-p0077","role":"资兵","evidence":["wudi-e-o013b-q"]}],"place":{"text":"扬州、龙亢、铚、建平、河内","evidence":["wudi-e-o013b-q"]},"time":{"label":"初平元年","year":190,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o013b-q","wudi-q-o009","wudi-q-b-4a17eb75600ced2abdde"],"chronology":"wudi-y190","dating_review":{"anchor":"wudi-q-o009","basis":"初平元年","reviewed":true}},"source_order":[1,103,"O013b"],"order":63}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0027","name":"夏侯惇","facts":[],"aliases":[]},{"id":"wudi-p0076","name":"陈温","facts":[],"aliases":[]},{"id":"wudi-p0077","name":"周昕","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-o013b-q","section":"chapter-001","block":"b-6d90d341ed08685dd83b","layer":"original","quote":"太祖兵少，乃与夏侯惇等诣扬州募兵〖21〗。刺史陈温、丹杨太守周昕与兵四千余人〖22〗；还到龙亢〖23〗，士卒多叛。﹝一﹞至铚、建平〖24〗，复收兵得千余人。进屯河内。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":102,"anchor":null},"note_id":null,"start":196,"end":279},{"id":"wudi-q-b-4a17eb75600ced2abdde","section":"chapter-001","block":"b-4a17eb75600ced2abdde","layer":"modern","quote":"〖1〗初平元年：公元 190 年。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":86,"anchor":null},"note_id":"n-93d66253e23c705b336d","start":0,"end":17},{"id":"wudi-q-o009","section":"chapter-001","block":"b-20c7e941eb42ee97df8c","layer":"original","quote":"初平元年春正月〖1〗，后将军袁术、冀州牧韩馥、﹝一﹞豫州刺史孔伷、﹝二﹞兖州刺史刘岱、﹝三﹞河内太守王匡、﹝四﹞勃海太守袁绍、陈留太守张邈、东郡太守桥瑁、﹝五﹞山阳太守袁遗、﹝六﹞济北相鲍信，﹝七﹞同时俱起兵〖2〗。众各数万，推绍为盟主。太祖行奋武将军〖3〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":84,"anchor":null},"note_id":null,"start":0,"end":130}],"profiles":{},"directory_counts":{}}
