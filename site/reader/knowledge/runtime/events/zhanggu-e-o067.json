{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhanggu-e-o067","title":"瑾为书论物理遥忖朱治权意解","accounts":[{"id":"zhanggu-a-6310bab3d0faefea8d87","label":"正文","text":"瑾为书论物理遥忖朱治权意解","evidence":["zhanggu-q-5f0e007b5ff964af5dc6"]}],"participants":[{"person":"mingdi-p0002","role":"于孙权前为书、呈权以解其意","evidence":["zhanggu-q-5f0e007b5ff964af5dc6"]},{"person":"sun-quan","role":"对朱治有所怨望，见书而意解","evidence":["zhanggu-q-5f0e007b5ff964af5dc6"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["zhanggu-q-5f0e007b5ff964af5dc6"]},"ordering_evidence":"zhanggu-q-5f0e007b5ff964af5dc6","source_order":[52,241,0],"order":9340}],"persons":[{"id":"mingdi-p0002","name":"诸葛瑾","facts":[],"aliases":[]},{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]}],"evidence":[{"id":"zhanggu-q-5f0e007b5ff964af5dc6","section":"chapter-052","block":"b-4fa9395bb38fd3eb68c6","layer":"original","quote":"吴郡太守朱治，权举将也〖7〗，权曾有以望之〖8〗；而素加敬，难自诘让〖9〗，忿忿不解。瑾揣知其故，而不敢显陈，乃乞以意私自问。遂于权前为书〖10〗，泛论物理；因以己心，遥往忖度之。毕，以呈权；权喜，笑曰：“孤意解矣！颜氏之德〖11〗，使人加亲〖12〗：岂谓此邪","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":240,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":130,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
