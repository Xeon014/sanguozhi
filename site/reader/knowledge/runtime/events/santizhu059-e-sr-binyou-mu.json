{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"santizhu059-e-sr-binyou-mu","title":"孙登使胡综作《宾友目》、羊衜私驳","accounts":[{"id":"santizhu059-a-6ff8d3b68107a2c026da","label":"裴注·江表传","text":"《江表传》称登使侍中胡综作《宾友目》品评恪谭景慎；衜私驳综评四友各有指趣，卒以此言见咎不为恪等所亲","evidence":["santizhu059-q-706ca9485cff86e2ec84"]}],"participants":[{"person":"zhouyu-p0025","role":"使胡综作宾友目","evidence":["santizhu059-q-706ca9485cff86e2ec84"]},{"person":"wuzhu-p0091","role":"作宾友目","evidence":["santizhu059-q-706ca9485cff86e2ec84"]},{"person":"wuzhu-p0097","role":"私驳胡综之评","evidence":["santizhu059-q-706ca9485cff86e2ec84"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"未由相邻段落推算纪年；原文时间表达保留在来源引句中。","evidence":["santizhu059-q-706ca9485cff86e2ec84"]},"ordering_evidence":"santizhu059-q-706ca9485cff86e2ec84","source_order":[59,26,0],"order":10429}],"persons":[{"id":"wuzhu-p0091","name":"胡综","facts":[],"aliases":[]},{"id":"wuzhu-p0097","name":"羊衜","facts":[],"aliases":[]},{"id":"zhouyu-p0025","name":"孙登","facts":[],"aliases":[]}],"evidence":[{"id":"santizhu059-q-706ca9485cff86e2ec84","section":"chapter-059","block":"b-0b7d8c39eaea0ad6ff01","layer":"pei","quote":"《江表传》曰：“登使侍中胡综作《宾友目》曰：‘英才卓越，超逾伦匹，则诸葛恪；精识时机，达幽究微，则顾谭；凝辨宏达，言能释结，则谢景；究学甄微，游夏同科，则范慎。’衜乃私驳综曰：‘元逊才而疏，子嘿精而狠，叔发辨而浮，孝敬深而狭。’所言皆有指趣。而衜卒以此言见咎，不为恪等所亲。","attribution":"裴注·江表传","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":25,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-907884c580254ae9cf88","start":237,"end":374,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
