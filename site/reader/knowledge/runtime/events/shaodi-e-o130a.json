{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":575,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":197,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
