{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dengzhang-e-o161","title":"杨颙谏诸葛亮校簿","accounts":[{"id":"dengzhang-a-6ecbd9891268c30435e3","label":"裴注·襄阳记","text":"杨颙谏诸葛亮校簿","evidence":["dengzhang-q-cd544388e5e220dc72eb"]}],"participants":[{"person":"dengzhang-p0038","role":"直入谏亮，为治有体上下不可相侵，以家譬之，引邴吉、陈平事，称坐而论道谓之王公作而行之谓之士大夫，劝不可躬自校簿书","evidence":["dengzhang-q-cd544388e5e220dc72eb"]},{"person":"zhuge-liang","role":"尝自校簿书，受谏谢之","evidence":["dengzhang-q-cd544388e5e220dc72eb"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["dengzhang-q-cd544388e5e220dc72eb"]},"ordering_evidence":"dengzhang-q-cd544388e5e220dc72eb","source_order":[45,258,40],"order":7945}],"persons":[{"id":"dengzhang-p0038","name":"杨颙","facts":[],"aliases":[]},{"id":"zhuge-liang","name":"诸葛亮","facts":[],"aliases":[]}],"evidence":[{"id":"dengzhang-q-cd544388e5e220dc72eb","section":"chapter-045","block":"b-fcbf045ac94a0a206f3b","layer":"pei","quote":"亮尝自校簿书，颙直入谏曰：‘为治有体，上下不可相侵。请为明公以作家譬之：今有人使奴执耕稼，婢典炊爨，鸡主司晨，犬主吠盗，牛负重载，马涉远路；私业无旷，所求皆足；雍容高枕，饮食而已。忽一旦尽欲以身亲其役，不复付任；劳其体力，为此碎务；形疲神困，终无一成。岂其智之不如奴婢鸡狗哉？失为家主之法也！是故古人称，坐而论道谓之王公，作而行之谓之士大夫。故邴吉不问横道死人，而忧牛喘；陈平不肯知钱谷之数，云自有主者：彼诚达于位分之体也。今明公为治，乃躬自校簿书，流汗竟日，不亦劳乎！’亮谢之","attribution":"裴注·襄阳记","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":257,"anchor":null},"note_id":"n-8d683843ae555c62c0ee","start":40,"end":279}],"profiles":{},"directory_counts":{}}
