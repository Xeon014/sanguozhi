{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xunyu-e-p014a","title":"刘表待祢衡上宾后听谮疏逐","accounts":[{"id":"xunyu-e-p014a-account","label":"《傅子》","text":"刘表待祢衡上宾后听谮疏逐","evidence":["xunyu-e-p014a-q"]}],"participants":[{"person":"liu-biao","role":"接纳疏逐","evidence":["xunyu-e-p014a-q"]},{"person":"xunyu-p0026","role":"被逐","evidence":["xunyu-e-p014a-q"]}],"place":null,"time":{"label":"祢衡在荆州时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xunyu-e-p014a-q"]},"ordering_evidence":"xunyu-e-p014a-q","source_order":[10,83,"P014a"],"order":2416}],"persons":[{"id":"liu-biao","name":"刘表","facts":[],"aliases":[]},{"id":"xunyu-p0026","name":"祢衡","facts":[],"aliases":[]}],"evidence":[{"id":"xunyu-e-p014a-q","section":"chapter-010","block":"b-e53bfa5229e6b984ced6","layer":"pei","quote":"《傅子》曰：“衡辩于言，而克于论。见荆州牧刘表日，所以自结于表者甚至；表悦之，以为上宾。衡称表之美盈口，而论表左右不废绳墨。于是左右因形而谮之曰：‘衡称将军之仁，西伯不过也；唯以为不能断，终不济者，必由此也。’是言实指表智短，而非衡所言也。表不详察，遂疏衡而逐之。衡以交绝于刘表，智穷于黄祖，身死名灭，为天下笑者，谮之者有形也。”","attribution":"《傅子》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":82,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c5cdbaf6b01ad416ab88","start":0,"end":165,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
