6357578003e333bc0a14a28","note_id":null,"start":0,"end":27,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-74319c5176f2b48f6187","section":"chapter-007","block":"b-3ecb53f343c9ec34aa0e","layer":"original","quote":"兴平元年，太祖复征谦","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":44,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":10,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o029a-q","section":"chapter-001","block":"b-8f42ea81154b4797c2b1","layer":"original","quote":"夏，使荀彧、程昱守鄄城〖3〗；复征陶谦，拔五城，遂略地至东海〖4〗。还过郯〖5〗；谦将曹豹与刘备屯郯东，要太祖〖6〗。太祖击破之，遂攻拔襄贲〖7〗。所过多所残戮。﹝二﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":205,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":84,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-927979d68d5dacfd36fe","section":"chapter-001","block":"b-927979d68d5dacfd36fe","layer":"modern","quote":"〖1〗二年：兴平二年（公元 195）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":246,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8c38464987eb86819ded","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o028","section":"chapter-001","block":"b-fefe0240b8480efce927","layer":"original","quote":"兴平元年春，太祖自徐州还〖1〗。初，太祖父嵩，去官后还谯。董卓之乱，避难琅邪〖2〗。为陶谦所害，故太祖志在复仇东伐。﹝一﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":204,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":61,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
