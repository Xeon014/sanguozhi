{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o015a","title":"曹操拒绝拥立刘虞","accounts":[{"id":"wudi-e-o015a-account","label":"正文","text":"袁绍、韩馥谋立刘虞为帝，曹操拒绝；袁绍又展示玉印，使曹操愈加厌恶。","evidence":["wudi-e-o015a-q"]}],"participants":[{"person":"wudi-p0052","role":"谋立示印","evidence":["wudi-e-o015a-q"]},{"person":"wudi-p0058","role":"谋立","evidence":["wudi-e-o015a-q"]},{"person":"cao-cao","role":"拒绝","evidence":["wudi-e-o015a-q"]}],"place":null,"time":{"label":"初平元年","year":190,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o015a-q","wudi-q-o009","wudi-q-b-4a17eb75600ced2abdde"],"chronology":"wudi-y190","dating_review":{"anchor":"wudi-q-o009","basis":"初平元年","reviewed":true}},"source_order":[1,105,"O015a"],"order":65}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0052","name":"袁绍","facts":[],"aliases":[]},{"id":"wudi-p0058","name":"韩馥","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-o015a-q","section":"chapter-001","block":"b-1fad0ca8925dabf48f3f","layer":"original","quote":"袁绍与韩馥谋立幽州牧刘虞为帝〖27〗，太祖拒之。﹝二﹞绍又尝得一玉印〖28〗，于太祖坐中，举向其肘〖29〗；太祖由是笑而恶焉。﹝三﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":104,"anchor":null},"note_id":null,"start":0,"end":66},{"id":"wudi-q-b-4a17eb75600ced2abdde","section":"chapter-001","block":"b-4a17eb75600ced2abdde","layer":"modern","quote":"〖1〗初平元年：公元 190 年。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":86,"anchor":null},"note_id":"n-93d66253e23c705b336d","start":0,"end":17},{"id":"wudi-q-o009","section":"chapter-001","block":"b-20c7e941eb42ee97df8c","layer":"original","quote":"初平元年春正月〖1〗，后将军袁术、冀州牧韩馥、﹝一﹞豫州刺史孔伷、﹝二﹞兖州刺史刘岱、﹝三﹞河内太守王匡、﹝四﹞勃海太守袁绍、陈留太守张邈、东郡太守桥瑁、﹝五﹞山阳太守袁遗、﹝六﹞济北相鲍信，﹝七﹞同时俱起兵〖2〗。众各数万，推绍为盟主。太祖行奋武将军〖3〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":84,"anchor":null},"note_id":null,"