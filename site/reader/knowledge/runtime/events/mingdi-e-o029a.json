ull},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":92,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-b-412fc25655f53a4b4d33","section":"chapter-003","block":"b-412fc25655f53a4b4d33","layer":"modern","quote":"〖1〗六年：太和六年（公元 232）。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":191,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-d1427f90b1f8dd585e5a","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-o026","section":"chapter-003","block":"b-42d0ed5edde34d9ea9f5","layer":"original","quote":"六年春二月〖1〗，诏曰：“古之帝王，封建诸侯，所以藩屏王室也〖2〗。《诗》不云乎，‘怀德维宁，宗子维城’〖3〗。秦、汉继周，或强或弱〖4〗，俱失厥中〖5〗。大魏创业，诸王开国；随时之宜，未有定制：非所以永为后法也。其改封诸侯王，皆以郡为国〖6〗。”三月，癸酉〖7〗，行东巡；所过存问高年鳏寡孤独〖8〗，赐谷帛。乙亥〖9〗，月犯轩辕大星。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":186,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":168,"offset_unit":"unicode_code_point"},{"id":"wuzhu-e-o101a-q","section":"chapter-047","block":"b-5d95e91b49ef1f5258c6","layer":"original","quote":"秋九月，魏将田豫要击〖1〗，斩贺于成山〖2〗。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":11,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":23,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
