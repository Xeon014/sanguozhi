{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o013a","title":"曹操在酸枣提出进军方案","accounts":[{"id":"wudi-e-o013a-account","label":"正文","text":"曹操责诸军观望，提出分路控制险要、以疑兵震动关中的方案，张邈等未采用。","evidence":["wudi-e-o013a-q"]}],"participants":[{"person":"cao-cao","role":"提出方案","evidence":["wudi-e-o013a-q"]},{"person":"wudi-p0062","role":"未采纳","evidence":["wudi-e-o013a-q"]}],"place":{"text":"酸枣","evidence":["wudi-e-o013a-q"]},"time":{"label":"初平元年","year":190,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o013a-q","wudi-q-o009","wudi-q-b-4a17eb75600ced2abdde"],"chronology":"wudi-y190","dating_review":{"anchor":"wudi-q-o009","basis":"初平元年","reviewed":true}},"source_order":[1,103,"O013a"],"order":62}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0062","name":"张邈","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-o013a-q","section":"chapter-001","block":"b-6d90d341ed08685dd83b","layer":"original","quote":"太祖到酸枣。诸军兵十余万，日置酒高会，不图进取。太祖责让之〖13〗，因为谋曰：“诸君听吾计：使勃海引河内之众临孟津〖14〗；酸枣诸将守成皋，据敖仓〖15〗，塞轘辕、太谷〖16〗，全制其险；使袁将军率南阳之军军丹、析〖17〗，入武关〖18〗，以震三辅〖19〗。皆高垒深壁，勿与战；益为疑兵〖20〗，示天下形势。以顺诛逆，可立定也！今兵以义动，持疑而不进，失天下之望。窃为诸君耻之！”邈等不能用。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":102,"anchor":null},"note_id":null,"start":0,"end":196},{"id":"wudi-q-b-4a17eb75600ced2abdde","section":"chapter-001","block":"b-4a17eb75600ced2abdde","layer":"modern","quote":"〖1〗初平元年：公元 190 年。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":86,"anchor":null},"note_id":"n-93d66253e23c705b336d","start":0,"end":17},{"id":"wudi-q-o009","section":"chapter-001","block":"b-20c7e941eb42ee97df8c","layer":"original","quote":"初平元年春正月〖1〗，后将军袁术、冀州牧韩馥、﹝一﹞豫州刺史孔伷、﹝二﹞兖州刺史刘岱、﹝三﹞河内太守王匡、﹝四﹞勃海太守袁绍、陈留太守张邈、东郡太守桥瑁、﹝五﹞山阳太守袁遗、﹝六﹞济北相鲍信，﹝七﹞同时俱起兵〖2〗。众各数万，推绍为盟主。太祖行奋武将军〖3〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":84,"anchor":null},"note_id":null,"start":0,"end":130}],"profiles":{},"directory_counts":{}}
