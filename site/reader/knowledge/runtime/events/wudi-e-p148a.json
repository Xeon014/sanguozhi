{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p148a","title":"孙权称臣劝进，陈群桓阶进奏","accounts":[{"id":"wudi-e-p148a-account","label":"《魏略》","text":"《魏略》记孙权上书称臣并称天命，曹操示书于众；陈群、桓阶进奏劝受命。","evidence":["wudi-e-p148a-q"]}],"participants":[{"person":"sun-quan","role":"称臣劝进","evidence":["wudi-e-p148a-q"]},{"person":"cao-cao","role":"示书","evidence":["wudi-e-p148a-q"]},{"person":"wudi-p0394","role":"进奏","evidence":["wudi-e-p148a-q"]},{"person":"wudi-p0395","role":"进奏","evidence":["wudi-e-p148a-q"]}],"place":null,"time":{"label":"孙权请讨关羽后","year":219,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-p148a-q","wudi-q-o194","wudi-q-b-1e7ae1441471aa22d204"],"chronology":"wudi-y219","dating_review":{"anchor":"wudi-q-o194","basis":"孙权请讨关羽后","reviewed":true}},"source_order":[1,1116,"P148a"],"order":438}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"wudi-p0394","name":"陈群","facts":[],"aliases":[]},{"id":"wudi-p0395","name":"桓阶","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-p148a-q","section":"chapter-001","block":"b-6ad4d93ffadfd8178d7c","layer":"pei","quote":"﹝五﹞《魏略》曰：“孙权上书称臣，称说天命。王以权书示外曰：‘是儿欲踞吾著炉火上邪！’侍中陈群、尚书桓阶奏曰：‘汉自安帝以来，政去公室，国统数绝。至于今者，唯有名号；尺土一民，皆非汉有。期运久已尽，历数久已终，非适今日也。是以桓、灵之间，诸明图纬者，皆言“汉行气尽，黄家当兴”。殿下应期，十分天下而有其九，以服事汉；群生注望，遐迩怨叹，是故孙权在远称臣。此天人之应，异气齐声。臣愚以为虞、夏不以谦辞，殷、周不吝诛放；畏天知命，无所与让也。’”","attribution":"《魏略》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":440,"anchor":null},"note_id":"n-b733ce3606187de56ac6","start":0,"end":221},{"id":"wudi-q-b-1e7ae1441471aa22d204","section":"chapter-001","block":"b-1e7ae1441471aa22d204","layer":"modern","quote":"〖1〗二十四年：建安二十四年（公元 219）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":428,"anchor":null},"note_id":"n-f2589f07b550616f1e63","start":0,"end":23},{"id":"wudi-q-o194","section":"