{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xiahoucao-e-p047a","title":"金乡公主忧何晏母笑其妒","accounts":[{"id":"xiahoucao-e-p047a-account","label":"《魏末传》","text":"金乡公主忧何晏母笑其妒","evidence":["xiahoucao-e-p047a-q"]},{"id":"xiahoucao-a-p047-judgment","label":"裴松之按语","text":"裴松之反驳何晏与金乡公主同母说，指出沛王母为杜夫人，何晏母姓尹，不能据此称同母。","evidence":["xiahoucao-q-p047-judgment"]}],"participants":[{"person":"xiahoucao-p0096","role":"忧夫","evidence":["xiahoucao-e-p047a-q"]}],"place":null,"time":{"label":"何晏为恶至被诛","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xiahoucao-e-p047a-q"]},"ordering_evidence":"xiahoucao-e-p047a-q","source_order":[9,387,"P047a"],"order":2309}],"persons":[{"id":"xiahoucao-p0096","name":"金乡公主","facts":[],"aliases":[]}],"evidence":[{"id":"xiahoucao-e-p047a-q","section":"chapter-009","block":"b-8f654c67b72ea809e6a5","layer":"pei","quote":"晏妇金乡公主，即晏同母妹。公主贤，谓其母沛王太妃曰：‘晏为恶日甚，将何保身？’母笑曰：‘汝得无妒晏邪？","attribution":"《魏末传》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":386,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-46a3d2d6a327171eb9f7","start":8,"end":59,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-p047-judgment","section":"chapter-009","block":"b-8f654c67b72ea809e6a5","layer":"pei","quote":"臣松之按：《魏末传》云晏取其同母妹为妻，此搢绅所不忍言；虽楚王之妻（嫂）〔媦〕，不是甚也已。设令此言出于旧史，犹将莫之或信，况底下之书乎？按《诸王公传》，沛王出自杜夫人所生。晏母姓尹，公主若与沛王同生，焉得言与晏同母？","attribution":"裴松之按语","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":386,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-46a3d2d6a327171eb9f7","start":144,"end":253,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
