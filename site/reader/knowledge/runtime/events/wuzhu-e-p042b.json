{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wuzhu-e-p042b","title":"邓芝复聘孙权解释魏求和非有他图","accounts":[{"id":"wuzhu-e-p042b-account","label":"《吴录》","text":"邓芝来聘，孙权解释一度因山民作乱而议通魏，并无他图。","evidence":["wuzhu-e-p042b-q"]}],"participants":[{"person":"guanzhang-p0046","role":"奉使","evidence":["wuzhu-e-p042b-q"]},{"person":"sun-quan","role":"释疑","evidence":["wuzhu-e-p042b-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["wuzhu-e-p042b-q"]},"ordering_evidence":"wuzhu-e-p042b-q","source_order":[47,384,"P042b"],"order":8263}],"persons":[{"id":"guanzhang-p0046","name":"邓芝","facts":[],"aliases":[]},{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]}],"evidence":[{"id":"wuzhu-e-p042b-q","section":"chapter-047","block":"b-f9b2d8cafa27af1b92ad","layer":"pei","quote":"是岁，蜀主又遣邓芝来聘，重结盟好。权谓芝曰：‘山民作乱，江边守兵多撤；虑曹丕乘空弄态，而反求和。议者以为：“内有不暇，幸来求和，于我有利；宜当与通，以自辨定。”恐西州不能明孤赤心，用致嫌疑。孤土地边外，间隙万端；而长江巨海，皆当防守；丕观衅而动，惟不见便：宁得忘此，复有他图！’","attribution":"《吴录》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":383,"anchor":null},"note_id":"n-f2364975efe3e0fa778d","start":153,"end":292}],"profiles":{},"directory_counts":{}}
