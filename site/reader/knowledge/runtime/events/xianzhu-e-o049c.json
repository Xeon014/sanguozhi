{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-o049c","title":"刘封孟达李平攻上庸","accounts":[{"id":"xianzhu-e-o049c-account","label":"《先主传》正文","text":"刘备遣刘封、孟达、李平进攻上庸申耽。","evidence":["xianzhu-e-o049c-q"]},{"id":"liuliao-a-d08eac14319c829753ed","label":"正文","text":"封统达军会上庸申耽举众降","evidence":["liuliao-q-79ddd8e23b5a267e775e"]}],"participants":[{"person":"liu-bei","role":"遣将","evidence":["xianzhu-e-o049c-q"]},{"person":"xianzhu-p0070","role":"进攻","evidence":["xianzhu-e-o049c-q"]},{"person":"xianzhu-p0071","role":"进攻","evidence":["xianzhu-e-o049c-q"]},{"person":"xianzhu-p0072","role":"进攻","evidence":["xianzhu-e-o049c-q"]},{"person":"xianzhu-p0073","role":"受攻","evidence":["xianzhu-e-o049c-q"]},{"person":"mingdi-p0064","role":"任建信将军西城太守","evidence":["liuliao-q-79ddd8e23b5a267e775e"]}],"place":{"text":"上庸","evidence":["xianzhu-e-o049c-q"]},"time":{"year":219,"label":"建安二十四年夏","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xianzhu-y219","dating_review":{"reviewed":true,"anchor":"xianzhu-q-o048","basis":"建安二十四年夏"},"evidence":["xianzhu-e-o049c-q","xianzhu-q-o048","xianzhu-q-b-c3e56caa3865de7f7114"]},"source_order":[32,205,"O049c"],"order":6579}],"persons":[{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"mingdi-p0064","name":"申仪","facts":[],"aliases":[]},{"id":"xianzhu-p0070","name":"刘封","facts":[],"aliases":[]},{"id":"xianzhu-p0071","name":"孟达","facts":[],"aliases":[]},{"id":"xianzhu-p0072","name":"李平（攻上庸将领）","facts":[],"aliases":[]},{"id":"xianzhu-p0073","name":"申耽","facts":[],"aliases":[]}],"evidence":[{"id":"liuliao-q-79ddd8e23b5a267e775e","section":"chapter-040","block":"b-ee57665e94513ca12cf7","layer":"original","quote":"达将进攻上庸〖4〗，先主阴恐达难独任；乃遣封自汉中乘沔水下统达军，与达会上庸。上庸太守申耽举众降，遣妻子及宗族诣成都。先主加耽征北将军，领上庸太守，员乡侯如故。以耽弟仪为建信将军、西城太守〖5〗。迁封为副军将军","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":3,"anchor":null},"note_id":null,"start":31,"end":136},{"id":"xianzhu-e-o049c-q","section":"chapter-032","block":"b-8a052498f4fbd858ba0b","layer":"original","quote":"遣刘封、孟达、李平等攻申耽于上庸〖15〗。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":204,"anchor":null},"note_id":null,"start":83,"end":104},{"id":"xianzhu-q-b-c3e56caa3865de7f7114","section":"chapter-032","block":"b-c3e56caa3865de7f7114","layer":"modern","quote":"〖11〗二十四年：建安二十四年（公元 219）。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":222,"anchor":null},"note_id":"n-fd85f82251e498647de7","start":0,"end":24},{"id":"xianzhu-q-o048","section":"chapter-032","block":"b-2d515ba2dae40f6a248e","layer":"original","quote":"二十四年春〖11〗，自阳平南渡沔水，缘山稍前〖12〗，于定军山（势）作营〖13〗。渊将兵来争其地，先主命黄忠乘高鼓噪攻之。大破渊军，斩渊及曹公所署益州刺史赵颙等。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":203,"anchor":null},"note_id":null,"start":0,"end":81}],"profiles":{},"directory_counts":{}}
