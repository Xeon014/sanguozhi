{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wuzhu-e-p037a","title":"孙权推五德定土行用未祖辰腊","accounts":[{"id":"wuzhu-e-p037a-account","label":"《江表传》","text":"孙权推五德定土行用未祖辰腊","evidence":["wuzhu-e-p037a-q"]},{"id":"wuzhu-a-p038-judgment","label":"《志林》","text":"《志林》认为土行辰腊合数而未祖不合运。","evidence":["wuzhu-q-p038-judgment"]}],"participants":[{"person":"sun-quan","role":"议礼","evidence":["wuzhu-e-p037a-q"]}],"place":null,"time":{"label":"改乾象历时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["wuzhu-e-p037a-q"]},"ordering_evidence":"wuzhu-e-p037a-q","source_order":[47,379,"P037a"],"order":8257}],"persons":[{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]}],"evidence":[{"id":"wuzhu-e-p037a-q","section":"chapter-047","block":"b-f866abf1a495233ced89","layer":"pei","quote":"﹝一﹞《江表传》曰：“权推五德之运，以为土行；用未祖、辰腊。”","attribution":"《江表传》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":378,"anchor":null},"note_id":"n-908bac15a1ebfe5162f9","start":0,"end":31},{"id":"wuzhu-q-p038-judgment","section":"chapter-047","block":"b-f5082802c6ccddda61fe","layer":"pei","quote":"《志林》曰：“土行以辰腊，得其数矣。土盛于戌，而以未祖，其义非也。土生于未，故未为坤初。是以《月令》：‘建未之月，祀黄精于郊，祖用其盛。’今祖用其始，岂应运乎？”","attribution":"《志林》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":379,"anchor":null},"note_id":"n-908bac15a1ebfe5162f9","start":0,"end":81}],"profiles":{},"directory_counts":{}}
