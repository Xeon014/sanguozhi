{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhouyu-e-p012g","title":"周瑜三日后引蒋幹观营宴饮拒游说","accounts":[{"id":"zhouyu-e-p012g-account","label":"《江表传》","text":"周瑜三日后引蒋幹观营库军资器仗，宴饮陈君臣骨肉之义，称不可游说移心。","evidence":["zhouyu-e-p012g-q"]}],"participants":[{"person":"zhou-yu","role":"观营陈志","evidence":["zhouyu-e-p012g-q"]},{"person":"zhouyu-p0023","role":"受示","evidence":["zhouyu-e-p012g-q"]}],"place":null,"time":{"label":"蒋幹来后三日","precision":"relative","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["zhouyu-e-p012g-q"]},"ordering_evidence":"zhouyu-e-p012g-q","source_order":[54,120,"P012g"],"order":9614}],"persons":[{"id":"zhou-yu","name":"周瑜","facts":[],"aliases":[]},{"id":"zhouyu-p0023","name":"蒋幹","facts":[],"aliases":[]}],"evidence":[{"id":"zhouyu-e-p012g-q","section":"chapter-054","block":"b-2214c5c24f10e6532e39","layer":"pei","quote":"后三日，瑜请幹与周观营中，行视仓库、军资、器仗讫，还宴饮；示之侍者、服饰、珍玩之物。因谓幹曰：‘丈夫处世，遇知己之主；外托君臣之义，内结骨肉之恩；言行计从，祸福共之。假使苏、张更生，郦叟复出；犹抚其背，而折其辞：岂足下幼生，所能移乎！","attribution":"《江表传》","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":119,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f170ddcf31cbbfb5f027","start":282,"end":399,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
