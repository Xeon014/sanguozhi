{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wgc-e-3-e21","title":"诸葛诞遣邓艾据肥阳","order":5655,"accounts":[{"id":"wgc-a-3-e21","label":"正文","text":"诸葛诞遣邓艾据肥阳","evidence":["wgc-q0351","wgc-q0043"]}],"participants":[{"person":"shaodi-p0044","role":"遣艾据肥阳","evidence":["wgc-q0351","wgc-q0043"]},{"person":"shaodi-p0080","role":"受遣据肥阳","evidence":["wgc-q0351","wgc-q0043"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0351","wgc-q0043"]},"ordering_evidence":"wgc-q0351"}],"persons":[{"id":"shaodi-p0044","name":"诸葛诞","facts":[],"aliases":[]},{"id":"shaodi-p0080","name":"邓艾","facts":[],"aliases":[]}],"evidence":[{"id":"wgc-q0043","section":"chapter-028","block":"b-7aa260ba6c445f9f0967","layer":"original","quote":"毌丘俭作乱，遣健步赍书〖1〗，欲疑惑大众〖2〗；艾斩之，兼道进军〖3〗。先趣乐嘉城，作浮桥；司马景王至，遂据之。文钦以后大军〖4〗，破败于城下；艾追之至丘头，钦奔吴。吴大将军孙峻等号十万众，将渡江，镇东将军诸葛诞遣艾据肥阳〖5〗；艾以与贼势相远，非要害之地；辄移屯附亭〖6〗，遣泰山太守诸葛绪等，于黎浆拒战〖7〗，遂走之。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":295,"anchor":null},"note_id":null,"start":0,"end":161},{"id":"wgc-q0351","section":"chapter-028","block":"b-7aa260ba6c445f9f0967","layer":"original","quote":"镇东将军诸葛诞遣艾据肥阳","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":295,"anchor":null},"note_id":null,"start":99,"end":111}],"profiles":{},"directory_counts":{}}
