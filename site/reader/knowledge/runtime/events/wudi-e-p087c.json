{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p087c","title":"王儁避居武陵拒征","accounts":[{"id":"wudi-e-p087c-account","label":"皇甫谧《逸士传》","text":"王儁不应州郡三府及公车征召，避居武陵，百余家归附；汉都许后再征尚书，仍未就任。","evidence":["wudi-e-p087c-q"]}],"participants":[{"person":"wudi-p0259","role":"拒征避居","evidence":["wudi-e-p087c-q"]}],"place":{"text":"武陵","evidence":["wudi-e-p087c-q"]},"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p087c-q"]},"source_order":[1,689,"P087c"],"order":286}],"persons":[{"id":"wudi-p0259","name":"王儁","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-p087c-q","section":"chapter-001","block":"b-ea056e74ee4abddcf775","layer":"pei","quote":"儁为人外静而内明，不应州郡、三府之命。公车征，不到。避地居武陵，归儁者一百余家。帝之都许，复征为尚书，又不就。","attribution":"皇甫谧《逸士传》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":13,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cf8a0075075368325cde","start":157,"end":212,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
