{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wuzhu-e-p044a","title":"陈化使魏答曹丕问受厚送孙权授犍为太守迁太常尚书令","accounts":[{"id":"wuzhu-e-p044a-account","label":"《吴书》","text":"陈化使魏答曹丕问受厚送孙权授犍为太守迁太常尚书令","evidence":["wuzhu-e-p044a-q"]}],"participants":[{"person":"wuzhu-p0052","role":"奉使受任","evidence":["wuzhu-e-p044a-q"]},{"person":"wudi-p0170","role":"询问","evidence":["wuzhu-e-p044a-q"]},{"person":"sun-quan","role":"授官","evidence":["wuzhu-e-p044a-q"]}],"place":null,"time":{"label":"陈化任官至卒","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["wuzhu-e-p044a-q"]},"ordering_evidence":"wuzhu-e-p044a-q","source_order":[47,386,"P044a"],"order":8266}],"persons":[{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"wudi-p0170","name":"曹丕","facts":[],"aliases":[]},{"id":"wuzhu-p0052","name":"陈化","facts":[],"aliases":[]}],"evidence":[{"id":"wuzhu-e-p044a-q","section":"chapter-047","block":"b-18ebe4b5f421a0b951d1","layer":"pei","quote":"为郎中令，使魏。魏文帝因酒酣，嘲问曰：‘吴、魏峙立，谁将平一海内者乎？’化对曰：‘《易》称帝出乎震；加闻先哲知命旧说，紫盖黄旗，运在东南。’帝曰：‘昔文王以西伯王天下，岂复在东乎？’化曰：‘周之初基，太伯在东；是以文王，能兴于西。’帝笑，无以难，心奇其辞。使毕当还，礼送甚厚。权以化奉命光国，拜犍为太守，置官属。顷之，迁太常，兼尚书令。","attribution":"《吴书》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":385,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-e3000e5763a1cac243ce","start":50,"end":218,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
