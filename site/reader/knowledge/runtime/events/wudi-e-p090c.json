{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p090c","title":"曹操自述征讨袁术","accounts":[{"id":"wudi-e-p090c-account","label":"《魏武故事》所载令文","text":"令文回叙袁术僭号、欲称帝而顾忌曹操，以及四将被擒后穷亡病死。","evidence":["wudi-e-p090c-review-q"]}],"participants":[{"person":"cao-cao","role":"自述","evidence":["wudi-e-p090c-review-q"]}],"place":null,"time":{"label":"回叙数次征战，不合定于颁令之年","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p090c-review-q"]},"source_order":[1,724,"P090c"],"order":303}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-p090c-review-q","section":"chapter-001","block":"b-2caf3e4f7e42b9fcda41","layer":"pei","quote":"又袁术僭号于九江，下皆‘称臣’，名门曰‘建号门’，衣被皆为天子之制，两妇预争为皇后。志计已定，人有劝术使遂即帝位，露布天下；答言‘曹公尚在，未可也’。后孤讨擒其四将，获其人众；遂使术穷亡解沮，发病而死。","attribution":"《魏武故事》所载令文","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":48,"anchor":null},"note_id":"n-e46e3191255096f1e405","start":366,"end":467}],"profiles":{},"directory_counts":{}}
