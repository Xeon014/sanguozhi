{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"chengguo-e-o256","title":"昭论休不能独渡臧霸不肯乘危","accounts":[{"id":"chengguo-a-17e969382301715c7cd1","label":"正文","text":"昭论休不能独渡臧霸不肯乘危","evidence":["chengguo-q-5a41e5c44735798c3988"]}],"participants":[{"person":"wudi-p0122","role":"侍侧、窃见陛下有忧色独以休济江故乎、今者渡江人情所难、臧霸等既富且贵无复他望但欲终其天年、何肯乘危自投死地以求侥幸、苟霸等不进休意自沮、恐虽有敕渡之诏犹必沉吟","evidence":["chengguo-q-5a41e5c44735798c3988"]},{"person":"wudi-p0170","role":"被答者","evidence":["chengguo-q-5a41e5c44735798c3988"]}],"place":null,"time":{"label":"黄初三年","precision":"year","year":222,"basis":"首轮审定确认的上下文现代释年；承接与逐项对读见审定记录。","evidence":["chengguo-q-4543cc7c2ebcb62c4067","chengguo-q-5a41e5c44735798c3988"],"chronology":"chengguo-y-382bf7ef46cad96f6029","dating_review":{"reviewed":true,"anchor":"chengguo-q-4543cc7c2ebcb62c4067","basis":"本次上下文现代释年注释直接释年；承接与逐项对读见首轮审定记录。"}},"ordering_evidence":"chengguo-q-5a41e5c44735798c3988","source_order":[14,235,76],"order":3067}],"persons":[{"id":"wudi-p0122","name":"董昭","facts":[],"aliases":[]},{"id":"wudi-p0170","name":"曹丕","facts":[],"aliases":[]}],"evidence":[{"id":"chengguo-q-4543cc7c2ebcb62c4067","section":"chapter-014","block":"b-5537d843cd1205f6a86a","layer":"modern","quote":"〖2〗三年：黄初三年（公元222）。","attribution":"现代注释","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":243,"anchor":null},"note_id":"n-10e6de8056ae1ef3a8c8","start":0,"end":18},{"id":"chengguo-q-5a41e5c44735798c3988","section":"chapter-014","block":"b-9c27d5aec2365f908f87","layer":"original","quote":"时昭侍侧，因曰：“窃见陛下有忧色，独以休济江故乎？今者渡江，人情所难。就休有此志，势不独行，当须诸将。臧霸等既富且贵，无复他望；但欲终其天年，保守禄祚而已：何肯乘危自投死地，以求侥幸？苟霸等不进，休意自沮〖6〗。臣恐陛下虽有敕渡之诏，犹必沉吟〖7〗，未便从命也","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":234,"anchor":null},"note_id":null,"start":76,"end":206}],"profiles":{},"directory_counts":{}}
