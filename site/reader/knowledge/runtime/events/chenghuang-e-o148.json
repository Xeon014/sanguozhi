{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"chenghuang-e-o148","title":"潘璋作筏拟烧浮桥未发夏侯尚先退","accounts":[{"id":"chenghuang-a-948546724f4aacb4ff7f","label":"正文","text":"潘璋作筏拟烧浮桥未发夏侯尚先退","evidence":["chenghuang-q-dc55f52f75ab6b5a64ff"]}],"participants":[{"person":"zhouyu-p0055","role":"曰魏势始盛江水又浅未可与战、将所领到魏上流五十里、伐苇数百万束缚作大筏欲顺流放火烧败浮桥、作筏适毕伺水长当下、下备陆口","evidence":["chenghuang-q-dc55f52f75ab6b5a64ff"]},{"person":"mingdi-p0063","role":"魏将、等围南郡分前部三万人作浮桥渡百里洲上、魏兵日渡不绝、便引退","evidence":["chenghuang-q-dc55f52f75ab6b5a64ff"]},{"person":"mingdi-p0002","role":"会兵赴救未知所出","evidence":["chenghuang-q-dc55f52f75ab6b5a64ff"]},{"person":"wuzhu-p0027","role":"同会兵赴救","evidence":["chenghuang-q-dc55f52f75ab6b5a64ff"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["chenghuang-q-dc55f52f75ab6b5a64ff"]},"ordering_evidence":"chenghuang-q-dc55f52f75ab6b5a64ff","source_order":[55,334,0],"order":9923}],"persons":[{"id":"mingdi-p0002","name":"诸葛瑾","facts":[],"aliases":[]},{"id":"mingdi-p0063","name":"夏侯尚","facts":[],"aliases":[]},{"id":"wuzhu-p0027","name":"杨粲","facts":[],"aliases":[]},{"id":"zhouyu-p0055","name":"潘璋","facts":[],"aliases":[]}],"evidence":[{"id":"chenghuang-q-dc55f52f75ab6b5a64ff","section":"chapter-055","block":"b-05b9092f0aa52d2daf07","layer":"original","quote":"魏将夏侯尚等围南郡，分前部三万人作浮桥，渡百里洲上〖13〗。诸葛瑾、杨粲，并会兵赴救，未知所出〖14〗。而魏兵日渡不绝，璋曰：“魏势始盛，江水又浅，未可与战。”便将所领，到魏上流五十里，伐苇数百万束，缚作大筏；欲顺流放火，烧败浮桥。作筏适毕，伺水长当下：尚便引退。璋下备陆口","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":333,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":137,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
