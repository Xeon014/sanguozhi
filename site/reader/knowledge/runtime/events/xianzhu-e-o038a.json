{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-o038a","title":"刘备驻葭萌收众心","accounts":[{"id":"xianzhu-e-o038a-account","label":"《先主传》正文","text":"刘璋还成都，刘备北至葭萌，未立即讨张鲁，厚施恩德收众心。","evidence":["xianzhu-e-o038a-q"]},{"id":"liuermu-a-21e533daa0a5ff56775c","label":"正文","text":"刘备明年至葭萌","evidence":["liuermu-q-fd64ce6811161efac607"]}],"participants":[{"person":"wudi-p0253","role":"还成都","evidence":["xianzhu-e-o038a-q"]},{"person":"liu-bei","role":"驻军","evidence":["xianzhu-e-o038a-q"]}],"place":{"text":"葭萌","evidence":["xianzhu-e-o038a-q"]},"time":{"year":211,"label":"是岁","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xianzhu-y211","dating_review":{"reviewed":true,"anchor":"xianzhu-q-o034","basis":"是岁"},"evidence":["xianzhu-e-o038a-q","xianzhu-q-o034","xianzhu-q-b-09400c250015597cdc75"]},"source_order":[32,164,"O038a"],"order":6474}],"persons":[{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"wudi-p0253","name":"刘璋","facts":[],"aliases":[]}],"evidence":[{"id":"liuermu-q-fd64ce6811161efac607","section":"chapter-031","block":"b-9368771bcb03c6644bf6","layer":"original","quote":"明年，先主至葭萌","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":72,"anchor":null},"note_id":null,"start":0,"end":8},{"id":"xianzhu-e-o038a-q","section":"chapter-032","block":"b-797707021c595495aa66","layer":"original","quote":"是岁，璋还成都。先主北到葭萌，未即讨鲁；厚树恩德，以收众心。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":163,"anchor":null},"note_id":null,"start":0,"end":30},{"id":"xianzhu-q-b-09400c250015597cdc75","section":"chapter-032","block":"b-09400c250015597cdc75","layer":"modern","quote":"〖10〗十六年：建安十六年（公元 211 ）。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":152,"anchor":null},"note_id":"n-8471d798647e2ff3307a","start":0,"end":23},{"id":"xianzhu-q-o034","section":"chapter-032","block":"b-464a6d3ab5db13314b70","layer":"original","quote":"十六年〖10〗，益州牧刘璋，遥闻曹公将遣钟繇等向汉中讨张鲁，内怀恐惧。别驾从事蜀郡张松说璋曰：“曹公兵强，无敌于天下；若因张鲁之资以取蜀土〖11〗，谁能御之者乎？”璋曰：“吾固忧之而未有计。”松曰：“刘豫州，使君之宗室，而曹公之深仇也，善用兵；若使之讨鲁，鲁必破；鲁破，则益州强；曹公虽来，无能为也。”","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":140,"anchor":null},"note_id":null,"start":0,"end":151}],"profiles":{},"directory_counts":{}}
