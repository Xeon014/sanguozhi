{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wgc-e-2-e13","title":"钦欲尽出北方人诞不听争恨","order":5592,"accounts":[{"id":"wgc-a-2-e13","label":"正文","text":"钦欲尽出北方人诞不听争恨","evidence":["wgc-q0292","wgc-q0031"]}],"participants":[{"person":"shaodi-p0074","role":"欲尽出北方人省食、与诞争恨","evidence":["wgc-q0292","wgc-q0031"]},{"person":"shaodi-p0044","role":"不听钦计","evidence":["wgc-q0292","wgc-q0031"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0292","wgc-q0031"]},"ordering_evidence":"wgc-q0292"}],"persons":[{"id":"shaodi-p0044","name":"诸葛诞","facts":[],"aliases":[]},{"id":"shaodi-p0074","name":"文钦","facts":[],"aliases":[]}],"evidence":[{"id":"wgc-q0031","section":"chapter-028","block":"b-9d7ef003463dd3c8aa40","layer":"original","quote":"钦欲尽出北方人，省食，与吴人坚守；诞不听，由是争恨〖8〗。钦素与诞有隙，徒以计合〖9〗，事急愈相疑；钦见诞计事，诞遂杀钦。钦子鸯及虎将兵在小城中，闻钦死，勒兵驰赴之〖10〗，众不为用。鸯、虎单走，逾城出，自归大将军。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":196,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":108,"offset_unit":"unicode_code_point"},{"id":"wgc-q0292","section":"chapter-028","block":"b-9d7ef003463dd3c8aa40","layer":"original","quote":"钦欲尽出北方人，省食，与吴人坚守；诞不听，由是争恨","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":196,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":25,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
