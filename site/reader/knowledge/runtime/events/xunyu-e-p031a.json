{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xunyu-e-p031a","title":"晋纪记荀顗和峤察太子孙盛记为荀勖","accounts":[{"id":"xunyu-e-p031a-account","label":"干宝《晋纪》","text":"干宝《晋纪》记晋武帝遣荀顗、和峤观察太子，二人回报不同。","evidence":["xunyu-e-p031a-q"]},{"id":"xunyu-a-p032-judgment","label":"裴松之按","text":"裴松之认为荀顗已卒、荀勖位次不合，应是荀恺，另述恺及兄弟官职。","evidence":["xunyu-q-p032-judgment"]},{"id":"xunyu-a-p031-sunsheng","label":"孙盛异说","text":"孙盛另记遣荀勖，其余语相同。","evidence":["xunyu-q-p031-sunsheng"]}],"participants":[{"person":"shaodi-p0136","role":"遣察","evidence":["xunyu-e-p031a-q"]},{"person":"shaodi-p0090","role":"被记察太子","evidence":["xunyu-e-p031a-q"]},{"person":"xunyu-p0070","role":"察太子","evidence":["xunyu-e-p031a-q"]}],"place":null,"time":{"label":"晋武帝察太子时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xunyu-e-p031a-q"]},"ordering_evidence":"xunyu-e-p031a-q","source_order":[10,190,"P031a"],"order":2471}],"persons":[{"id":"shaodi-p0090","name":"荀顗","facts":[],"aliases":[]},{"id":"shaodi-p0136","name":"司马炎","facts":[],"aliases":[]},{"id":"xunyu-p0070","name":"和峤","facts":[],"aliases":[]}],"evidence":[{"id":"xunyu-e-p031a-q","section":"chapter-010","block":"b-643aa55563b5613e764f","layer":"pei","quote":"武帝使侍中荀顗、和峤，俱至东宫，观察太子。顗还，称太子‘德识进茂’，而峤云‘圣质如初’。","attribution":"干宝《晋纪》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":189,"anchor":null},"note_id":"n-1cd39ba61e7c038ca47e","start":9,"end":53},{"id":"xunyu-q-p031-sunsheng","section":"chapter-010","block":"b-643aa55563b5613e764f","layer":"pei","quote":"孙盛曰“遣荀勖”，其余语则同。","attribution":"孙盛异说","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":189,"anchor":null},"note_id":"n-1cd39ba61e7c038ca47e","start":54,"end":69},{"id":"xunyu-q-p032-judgment","section":"chapter-010","block":"b-5ab93710c1bb7fe30998","layer":"pei","quote":"臣松之按：和峤为侍中，荀顗亡没久矣。荀勖位亚台司，不与峤同班，无缘方称“侍中”。二书所云，皆为非也。考其时位，恺实当之。恺位至征西大将军。恺兄儋，少府。弟悝，护军将军，追赠车骑大将军。","attribution":"裴松之按","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":190,"anchor":null},"note_id":"n-1cd39ba61e7c038ca47e","start":0,"end":92}],"profiles":{},"directory_counts":{}}
