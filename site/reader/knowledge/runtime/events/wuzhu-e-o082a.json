{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wuzhu-e-o082a","title":"孙权至皖口陆逊破曹休于石亭吕范卒","accounts":[{"id":"wuzhu-e-o082a-account","label":"《吴主传第二》正文","text":"孙权至皖口陆逊破曹休于石亭吕范卒","evidence":["wuzhu-e-o082a-q"]},{"id":"zhulv-a-0c3ed078b365883b7183","label":"正文","text":"黄武七年，范迁大司马；印绶未下，疾卒；权素服举哀，遣使者追赠印绶","evidence":["zhulv-q-683a8ab48c5a3b0ce599"]}],"participants":[{"person":"sun-quan","role":"进军","evidence":["wuzhu-e-o082a-q"]},{"person":"xianzhu-p0115","role":"督战","evidence":["wuzhu-e-o082a-q"]},{"person":"wendi-p0039","role":"战败","evidence":["wuzhu-e-o082a-q"]},{"person":"wendi-p0157","role":"卒","evidence":["wuzhu-e-o082a-q"]}],"place":null,"time":{"year":228,"label":"秋八月","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"wuzhu-y228","dating_review":{"reviewed":true,"anchor":"wuzhu-q-o080","basis":"秋八月"},"evidence":["wuzhu-e-o082a-q","wuzhu-q-o080","zhuge-q-o032","zhuge-q-b-0d2dada465388f4c2e39"]},"ordering_evidence":"wuzhu-e-o082a-q","source_order":[47,398,"O082a"],"related_events":[{"event":"mingdi-e-o011a","type":"related","evidence":["wuzhu-e-o082a-q","mingdi-e-o011a-q"]}],"order":8281},{"id":"mingdi-e-o011a","title":"曹休石亭战陆议败绩","accounts":[{"id":"mingdi-e-o011a-account","label":"《明帝纪》正文","text":"曹休石亭战陆议败绩","evidence":["mingdi-e-o011a-q"]},{"id":"luxun-e-o028a-account","label":"《陆逊传第十三》正文","text":"陆议与朱桓全琮三路破曹休追至夹石","evidence":["luxun-e-o028a-q"]},{"id":"xiahoucao-e-o045d-account","label":"《诸夏侯曹传第九》正文","text":"曹休因吴将诈降而深入，交战不利退石亭，夜惊弃甲兵辎重。","evidence":["xiahoucao-e-o045d-q"]},{"id":"wgc-a-0-e13","label":"正文","text":"曹休征吴失利于夹石王凌力战决围","evidence":["wgc-q0154","wgc-q0003"]},{"id":"hequan-a-b6df40ea2ceeb646a38d","label":"正文","text":"权使琮与陆逊破曹休于石亭","evidence":["hequan-q-2afeb15e4179e2c6965f"]},{"id":"hequan-a-9b2e1baf57e7b3dd930b","label":"正文","text":"密计报施行曹休信鲂帅十万入皖","evidence":["hequan-q-ed9abb31471fb1300eba"]},{"id":"hequan-a-367d223522dd77d412e4","label":"正文","text":"鲂随陆逊横截曹休斩获万计","evidence":["hequan-q-9c04392ea2c13e9d3f34"]},{"id":"hequan-a-82fa595a4a3498ac9319","label":"正文","text":"七年〖4〗，权到皖。使琮与辅国将军陆逊击曹休，破之于石亭","evidence":["hequan-q-2afeb15e4179e2c6965f"]},{"id":"chengguo-a-5dff187d26b61174931c","label":"正文","text":"曹休败退吴欲塞夹石遇救得不没","evidence":["chengguo-q-669f81846adbd9bfb438"]},{"id":"liusima-a-ac0c8e32fe437d7eb767","label":"正文","text":"太和二年帝使贾逵督满宠、胡质等四军从西阳直向东关","evidence":["liusima-q-370dbbad6a87363b1da8"]},{"id":"liusima-a-29368d35c26659e185c5","label":"正文","text":"逵至五将山，休表贼请降求深入，诏宣王驻军，逵东与休合进","evidence":["liusima-q-61347dbba77a5b3a2780"]},{"id":"liusima-a-2069b08032606a2f54e4","label":"正文","text":"贾逵料贼必并军于皖、休必败，部署诸将水陆并进","evidence":["liusima-q-514a28cf96f2848649c5"]},{"id":"liusima-a-938ba17389cc269b0d6f","label":"正文","text":"行二百里得生贼，言休战败、权遣兵断夹石","evidence":["liusima-q-34ebc4333e41238cb1f8"]},{"id":"liusima-a-0d74ecb9f201501ecd44","label":"正文","text":"贾逵力主疾进出其不意，兼道进军多设旗鼓为疑兵","evidence":["liusima-q-94f46ae12716d005b862"]},{"id":"liusima-a-7c1cb08b91ca04d2d36a","label":"正文","text":"贼见逵军遂退，逵据夹石以兵粮给休，休军乃振","evidence":["liusima-q-60815b50b05409c75607"]},{"id":"zhulv-a-55f09df98670e4964a94","label":"正文","text":"黄武七年，鄱阳太守周鲂谲诱魏大司马曹休；休将步骑十万，至皖城以迎鲂","evidence":["zhulv-q-5bf1aafd1427750a4ac5"]},{"id":"zhulv-a-cf560cfdd95c063e3122","label":"正文","text":"时陆逊为元帅，全琮与桓为左、右督，各督三万人击休","evidence":["zhulv-q-7f64cfcd6eebc75196a2"]},{"id":"zhulv-a-315088dde157b902ea3c","label":"正文","text":"休知见欺，当引军还；自负众盛，（徼）〔邀〕于一战","evidence":["zhulv-q-577e1bad3da930cf0e7e"]},{"id":"shiyi-a-e2718f36c43e18223d7f","label":"正文","text":"曹休到，吴军大破之","evidence":["shiyi-q-88c9220ecaf50448e4df"]}],"participants":[{"person":"wendi-p0039","role":"战败","evidence":["mingdi-e-o011a-q"]},{"person":"xianzhu-p0115","role":"击败","evidence":["mingdi-e-o011a-q"]},{"person":"wuzhu-p0028","role":"左翼","evidence":["luxun-e-o028a-q"]},{"person":"shaodi-p0005","role":"右翼","evidence":["luxun-e-o028a-q"]},{"person":"shaodi-p0004","role":"力战决围救曹休","evidence":["wgc-q0154","wgc-q0003"]},{"person":"sun-quan","role":"到皖、使琮与辅国将军陆逊击曹休","evidence":["hequan-q-2afeb15e4179e2c6965f"]},{"person":"wuzhu-p0058","role":"合众随陆逊横截休","evidence":["hequan-q-9c04392ea2c13e9d3f34"]},{"person":"wendi-p0005","role":"使逵督前将军满宠、东莞太守胡质等四军，从西阳直向东关","evidence":["liusima-q-370dbbad6a87363b1da8"]},{"person":"identity-six-20261024-p-jia-kui-liangdao","role":"督满宠、胡质等四军，从西阳直向东关；至五将山，东行与休合进；度贼无东关之备，必并军于皖，休深入与贼战必败，乃部署诸将，水陆并进；行二百里，得生贼；称休兵败于外、路绝于内，安危之机不及终日；今疾进出其不意，先人以夺其心，贼见吾兵必走，若待后军贼已断险兵虽多何益；乃兼道进军，多设旗鼓为疑兵；据夹石，以兵粮给休，贼见逵军遂退，休军乃振","evidence":["liusima-q-370dbbad6a87363b1da8","liusima-q-61347dbba77a5b3a2780","liusima-q-514a28cf96f2848649c5","liusima-q-34ebc4333e41238cb1f8","liusima-q-94f46ae12716d005b862","liusima-q-60815b50b05409c75607"]},{"person":"mingdi-p0038","role":"前将军，受逵督","evidence":["liusima-q-370dbbad6a87363b1da8"]},{"person":"mingdi-p0047","role":"东莞太守，受逵督","evidence":["liusima-q-370dbbad6a87363b1da8"]},{"person":"wudi-p0364","role":"时为司马宣王，从江陵；受诏驻军","evidence":["liusima-q-370dbbad6a87363b1da8","liusima-q-61347dbba77a5b3a2780"]}],"place":{"text":"石亭","evidence":["mingdi-e-o011a-q"]},"time":{"year":228,"label":"太和二年秋九月","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"mingdi-y228","dating_review":{"reviewed":true,"anchor":"mingdi-q-o008","basis":"太和二年秋九月"},"evidence":["mingdi-e-o011a-q","mingdi-q-o008","mingdi-q-b-76fba510250937628a99"]},"ordering_evidence":"mingdi-e-o011a-q","source_order":[3,58,"O011a"],"related_events":[{"event":"wuzhu-e-o082a","type":"related","evidence":["wuzhu-e-o082a-q","mingdi-e-o011a-q"]}],"order":745}],"persons":[{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"wendi-p0039","name":"曹休","facts":[],"aliases":[]},{"id":"wendi-p0157","name":"吕范","facts":[],"aliases":[]},{"id":"xianzhu-p0115","name":"陆逊","facts":[],"aliases":[]}],"evidence":[{"id":"mingdi-e-o011a-q","section":"chapter-003","block":"b-0f7011a011e59527fd63","layer":"original","quote":"秋九月，曹休率诸军至皖〖16〗，与吴将陆议战于石亭〖17〗，败绩〖18〗。乙酉〖19〗，立皇子穆为繁阳王。庚子〖20〗，大司马曹休薨。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":57,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":67,"offset_unit":"unicode_code_point"},{"id":"wuzhu-e-o082a-q","section":"chapter-047","block":"b-c344c51caf4dab973911","layer":"original","quote":"秋八月，权至皖口；使将军陆逊，督诸将大破休于石亭〖36〗。大司马吕范卒〖37〗。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":397,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":40,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o080","section":"chapter-047","block":"b-125198d654f90db2adc1","layer":"original","quote":"七年春三月〖33〗，封子虑为建昌侯〖34〗。罢东安郡。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":395,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":27,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-b-0d2dada465388f4c2e39","section":"chapter-035","block":"b-0d2dada465388f4c2e39","layer":"modern","quote":"〖1〗六年：建兴六年（公元 228）。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":220,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c990758acc37a646578b","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-o032","section":"chapter-035","block":"b-f4828bab0392be0b0bf7","layer":"original","quote":"六年春〖1〗，扬声由斜谷道取郿〖2〗，使赵云、邓芝为疑军〖3〗，据箕谷〖4〗；魏大将军曹真举众拒之。亮身率诸军攻祁山〖5〗，戎阵整齐，赏罚肃而号令明；南安、天水、安定三郡叛魏应亮，关中响震〖6〗。﹝二﹞","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":213,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":101,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-683a8ab48c5a3b0ce599","section":"chapter-056","block":"b-519059db38fa01507e30","layer":"original","quote":"黄武七年，范迁大司马；印绶未下，疾卒。权素服举哀，遣使者追赠印绶","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":177,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":32,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
