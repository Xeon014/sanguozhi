{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhanggu-e-o084","title":"征羌牖外见骘旌小盘饭待之","accounts":[{"id":"zhanggu-a-7ec043fed1061cdde7e5","label":"正文","text":"征羌牖外见骘旌小盘饭待之","evidence":["zhanggu-q-735fa26e4d9021f67ed9"]}],"participants":[{"person":"zhanggu-p0021","role":"方在内卧驻之移时、良久开牖见之身隐几坐帐中设席致地坐骘旌于牖外、作食身享大案肴膳重沓以小盘饭与骘旌惟菜茹而已","evidence":["zhanggu-q-735fa26e4d9021f67ed9"]},{"person":"shaodi-p0007","role":"辞色自若、极饭致饱乃辞出","evidence":["zhanggu-q-735fa26e4d9021f67ed9"]},{"person":"panlu-p0007","role":"愈耻之、不能食","evidence":["zhanggu-q-735fa26e4d9021f67ed9"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["zhanggu-q-735fa26e4d9021f67ed9"]},"ordering_evidence":"zhanggu-q-735fa26e4d9021f67ed9","source_order":[52,340,0],"order":9364}],"persons":[{"id":"panlu-p0007","name":"卫旌","facts":[],"aliases":[]},{"id":"shaodi-p0007","name":"步骘","facts":[],"aliases":[]},{"id":"zhanggu-p0021","name":"焦征羌","facts":[],"aliases":[]}],"evidence":[{"id":"zhanggu-q-735fa26e4d9021f67ed9","section":"chapter-052","block":"b-3ed014dddc21c2a5ff6b","layer":"original","quote":"征羌方在内卧，驻之移时。旌欲委去，骘止之曰：“本所以来，畏其强也；而今舍去，欲以为高，只结怨耳！”良久，征羌开牖见之〖4〗。身隐几，坐帐中〖5〗；设席致地，坐骘、旌于牖外。旌愈耻之，骘辞色自若。征羌作食，身享大案，肴膳重沓〖6〗；以小盘饭与骘、旌，惟菜茹而已〖7〗。旌不能食，骘极饭致饱，乃辞出","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":339,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":147,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
