order":[61,6,55],"related_events":[{"event":"wuzhu-e-o110a","type":"related","evidence":["panlu-q-db1c8c481beb9a31af7a","wuzhu-e-o110a-q"]}],"order":10706}],"persons":[{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"wuzhu-p0065","name":"潘濬","facts":[],"aliases":[]},{"id":"wuzhu-p0084","name":"李桓","facts":[],"aliases":[]},{"id":"wuzhu-p0085","name":"罗厉","facts":[],"aliases":[]},{"id":"wuzhu-p0086","name":"吕岱","facts":[],"aliases":[]}],"evidence":[{"id":"hequan-q-456b72384dd5082d20cb","section":"chapter-060","block":"b-5da9db7cdaa1e4989202","layer":"original","quote":"会武陵蛮夷蠢动，岱与太常潘濬共讨定之","section_title":"贺全吕周钟离传第十五","source":{"file":"OEBPS/Text/titlepage_0127.xhtml","index":187,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":27,"end":45,"offset_unit":"unicode_code_point"},{"id":"panlu-q-71cf51b83daa12bc6661","section":"chapter-061","block":"b-d09ac44ce73d7c54ccbc","layer":"original","quote":"五溪蛮夷叛乱盘结，权假濬节，督诸军讨之；信赏必行，法不可干；斩首获生，盖以万数。自是群蛮衰弱，一方宁静","section_title":"潘濬陆凯传第十六","source":{"file":"OEBPS/Text/titlepage_0129.xhtml","index":5,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":51,"offset_unit":"unicode_code_point"},{"id":"panlu-q-db1c8c481beb9a31af7a","section":"chapter-061","block":"b-d09ac44ce73d7c54ccbc","layer":"original","quote":"先是，濬与陆逊俱驻武昌，共掌留事〖11〗。还〖12〗，复故","section_title":"潘濬陆凯传第十六","source":{"file":"OEBPS/Text/titlepage_0129.xhtml","index":5,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":55,"end":84,"offset_unit":"unicode_code_point"},{"id":"wuzhu-e-o110a-q","section":"chapter-047","block":"b-25c8543a614585a1e1a6","layer":"original","quote":"冬十一月，太常潘濬平武陵蛮夷事毕，还武昌。诏复曲阿为云阳，丹徒为武进〖11〗。庐陵贼李桓、罗厉等为乱〖12〗。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":49,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":55,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o107","section":"chapter-047","block":"b-adeefad7184b459985c1","layer":"original","quote":"三年春正月〖1〗，诏曰：“兵久不辍，民困于役，岁或不登〖2〗。其宽诸逋〖3〗，勿复督课〖4〗。”","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":46,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":48,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-b-934abed655148ea08df3","section":"chapter-035","block":"b-934abed655148ea08df3","layer":"modern","quote":"〖2〗十二年：建兴十二年（公元 234）。以上诸葛亮出兵北伐共计五次，经由祁山只有两次。后世所说的“六出祁山”并非历史真实。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":269,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1e22705f935572994567","start":0,"end":62,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-o039","section":"chapter-035","block":"b-e60db7c722cd4fe4fb69","layer":"original","quote":"十二年春〖2〗，亮悉大众由斜谷出，以流马运；据武功五丈原〖3〗，与司马宣王对于渭南〖4〗。亮每患粮不继，使己志不申；是以分兵屯田，为久驻之基。耕者杂于渭滨居民之间，而百姓安堵〖5〗，军无私焉〖6〗。﹝三﹞相持百余日。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":258,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":108,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
