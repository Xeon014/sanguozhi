{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o064a","title":"魏种离叛后因才再获用","accounts":[{"id":"wudi-e-o064a-account","label":"正文","text":"正文回叙魏种在兖州叛乱时离曹，射犬被攻下后遭生擒，曹操惜其才而释放任用。","evidence":["wudi-e-o064a-q"]}],"participants":[{"person":"cao-cao","role":"惜才任用","evidence":["wudi-e-o064a-q"]},{"person":"wudi-p0161","role":"离叛被获复用","evidence":["wudi-e-o064a-q"]}],"place":{"text":"兖州、射犬","evidence":["wudi-e-o064a-q"]},"time":{"label":"建安四年射犬被攻下后","year":199,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o064a-q","wudi-q-o061","wudi-q-b-51bced16741add42ff70"],"chronology":"wudi-y199","dating_review":{"anchor":"wudi-q-o061","basis":"建安四年射犬被攻下后","reviewed":true}},"source_order":[1,362,"O064a"],"order":161}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0161","name":"魏种","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-o064a-q","section":"chapter-001","block":"b-9172d68a143ddf0b1939","layer":"original","quote":"初，公举种孝廉。兖州叛〖9〗，公曰：“唯魏种且不弃孤也〖10〗。”及闻种走，公怒曰：“种不南走越、北走胡〖11〗；不置汝也〖12〗！”既下射犬，生擒种。公曰：“唯其才也！”释其缚而用之。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":361,"anchor":null},"note_id":null,"start":0,"end":93},{"id":"wudi-q-b-51bced16741add42ff70","section":"chapter-001","block":"b-51bced16741add42ff70","layer":"modern","quote":"〖1〗四年：建安四年（公元 199）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":369,"anchor":null},"note_id":"n-20628d34a709162c77f0","start":0,"end":19},{"id":"wudi-q-o061","section":"chapter-001","block":"b-502d4e8c0ed143eaa30d","layer":"original","quote":"四年春二月〖1〗，公还至昌邑〖2〗。张杨将杨丑杀杨〖3〗。眭固又杀丑，以其众属袁绍，屯射犬〖4〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":358,"anchor":null},"note_id":null,"start":0,"end":49}],"profiles":{},"directory_counts":{}}
