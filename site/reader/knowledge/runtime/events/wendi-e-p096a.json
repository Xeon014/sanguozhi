{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wendi-e-p096a","title":"曹丕东征还师途中作诗","accounts":[{"id":"wendi-e-p096a-account","label":"裴注·魏书","text":"曹丕东征还师途中作诗","evidence":["wendi-e-p096a-q"]}],"participants":[{"person":"wudi-p0170","role":"作诗","evidence":["wendi-e-p096a-q"]}],"place":null,"time":{"year":225,"label":"黄初六年冬还师时","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"wendi-y225","dating_review":{"reviewed":true,"anchor":"wendi-q-o049","basis":"黄初六年冬还师时"},"evidence":["wendi-e-p096a-q","wendi-q-o049","wendi-q-b-e28c5cd47fe98ad60171"]},"ordering_evidence":"wendi-e-p096a-q","source_order":[2,487,"P096a"],"order":673}],"persons":[{"id":"wudi-p0170","name":"曹丕","facts":[],"aliases":[]}],"evidence":[{"id":"wendi-e-p096a-q","section":"chapter-002","block":"b-90253257c9b238c99314","layer":"pei","quote":"﹝二﹞《魏书》载帝于马上为诗曰：“观兵临江水，水流何汤汤！戈矛成山林，玄甲耀日光。猛将怀暴怒，胆气正纵横。谁云江水广？一苇可以航！不战屈敌虏，戢兵称贤良。古公宅岐邑，实始剪殷商。孟献营虎牢，郑人惧稽颡。充国务耕植，先零自破亡。兴农淮、泗间，筑室都徐方。量宜运权略，六军咸悦康！岂如《东山》诗，悠悠多忧伤？”","attribution":"裴注·魏书","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":486,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c38ccbf4e12c20b6106b","start":0,"end":153,"offset_unit":"unicode_code_point"},{"id":"wendi-q-b-e28c5cd47fe98ad60171","section":"chapter-002","block":"b-e28c5cd47fe98ad60171","layer":"modern","quote":"〖1〗六年：黄初六年（公元 225）。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":467,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-61512c4ade75d71d6a76","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wendi-q-o049","section":"chapter-002","block":"b-d5847039c2d504d36e8e","layer":"original","quote":"六年春二月〖1〗，遣使者循行许昌以东，尽沛郡〖2〗。问民所疾苦，贫者赈贷之。﹝一﹞三月，行幸召陵〖3〗，通讨虏渠〖4〗。乙巳〖5〗，还许昌宫。并州刺史梁习讨鲜卑轲比能〖6〗，大破之。辛未〖7〗，帝为舟师，东征。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":461,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":105,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
