{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"pangfa-e-o024b","title":"曹操闻法正策称刘备必受人教","accounts":[{"id":"pangfa-e-o024b-account","label":"《庞统法正传第七》正文","text":"曹操西征闻法正之策，称刘备必为人所教。","evidence":["pangfa-e-o024b-q"]},{"id":"pangfa-a-p014-judgment","label":"裴松之按","text":"裴松之认为听用嘉谋是霸王常事，曹操之语是耻恨之辞，不是测实之言。","evidence":["pangfa-q-p014-judgment"]}],"participants":[{"person":"cao-cao","role":"评论","evidence":["pangfa-e-o024b-q"]}],"place":null,"time":{"year":219,"label":"建安二十四年西征时","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"pangfa-y219","dating_review":{"reviewed":true,"anchor":"pangfa-q-o024","basis":"建安二十四年西征时"},"evidence":["pangfa-e-o024b-q","pangfa-q-o024","pangfa-q-b-2bde1ec2bffff2934f01"]},"ordering_evidence":"pangfa-e-o024b-q","source_order":[37,150,"O024b"],"order":6998}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]}],"evidence":[{"id":"pangfa-e-o024b-q","section":"chapter-037","block":"b-b3d109bb3fe355546163","layer":"original","quote":"曹公西征，闻正之策，曰：“吾故知玄德不辨有此〖30〗，必为人所教也。”","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":149,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":84,"end":119,"offset_unit":"unicode_code_point"},{"id":"pangfa-q-b-2bde1ec2bffff2934f01","section":"chapter-037","block":"b-2bde1ec2bffff2934f01","layer":"modern","quote":"〖27〗二十四年：建安二十四年（公元 219）。","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":180,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b2b8a5dc69bfaa995101","start":0,"end":24,"offset_unit":"unicode_code_point"},{"id":"pangfa-q-o024","section":"chapter-037","block":"b-b3d109bb3fe355546163","layer":"original","quote":"二十四年〖27〗，先主自阳平南渡沔水，缘山稍前〖28〗，于定军（兴势）〔山〕作营。渊将兵来争其地。正曰：“可击矣！”先主命黄忠乘高鼓噪攻之，大破渊军，渊等授首〖29〗。曹公西征，闻正之策，曰：“吾故知玄德不辨有此〖30〗，必为人所教也。”﹝三﹞","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":149,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":122,"offset_unit":"unicode_code_point"},{"id":"pangfa-q-p014-judgment","section":"chapter-037","block":"b-c10481dc521c857744b0","layer":"pei","quote":"﹝三﹞臣松之以为：蜀与汉中，其犹唇齿也。刘主之智，岂不及此？（将）〔特〕计略未展，正先发之耳。夫听用嘉谋，以成功业，霸王之主，谁不皆然？魏武以为人所教，亦岂劣哉！此盖耻恨之余辞，非测实之（常）〔当〕言也。","attribution":"裴松之按","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":190,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-70f9197b3390bcc259fa","start":0,"end":102,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
