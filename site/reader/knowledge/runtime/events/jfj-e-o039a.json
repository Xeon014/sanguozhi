{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"jfj-e-o039a","title":"姜维拟联羌胡大举而费祎限制兵力","order":7807,"accounts":[{"id":"jfj-a-o039a","label":"正文","text":"姜维拟联羌胡大举而费祎限制兵力","evidence":["jfj-q0150"]},{"id":"jfj-a-p011a","label":"《汉晋春秋》","text":"费祎劝姜维保国治民勿侥幸大举","evidence":["jfj-q0232"]}],"participants":[{"person":"shaodi-p0050","role":"谋大举","evidence":["jfj-q0150"]},{"person":"shaodi-p0051","role":"限制兵力","evidence":["jfj-q0150"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"逐条保留原时间；未从邻段自动继承公元年。","evidence":["jfj-q0150"]},"ordering_evidence":"jfj-q0150"}],"persons":[{"id":"shaodi-p0050","name":"姜维","facts":[],"aliases":[]},{"id":"shaodi-p0051","name":"费祎","facts":[],"aliases":[]}],"evidence":[{"id":"jfj-q0150","section":"chapter-044","block":"b-b5d003becd52d74fe30a","layer":"original","quote":"维自以练西方风俗〖7〗，兼负其才武；欲诱诸羌胡以为羽翼，谓自陇以西可断而有也〖8〗。每欲兴军大举，费祎常裁制不从〖9〗，与其兵不过万人。﹝一﹞","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":179,"anchor":null},"note_id":null,"start":0,"end":71},{"id":"jfj-q0232","section":"chapter-044","block":"b-bf9b4744932bc6a54615","layer":"pei","quote":"﹝一﹞《汉晋春秋》曰：“费祎谓维曰：‘吾等不如丞相亦已远矣；丞相犹不能定中夏，况吾等乎？且不如保国治民，敬守社稷，如其功业，以俟能者；无以为希冀侥幸，而决成败于一举：若不如志，悔之无及！’”","attribution":"《汉晋春秋》","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":193,"anchor":null},"note_id":"n-b6640f36af849f3d57c3","start":0,"end":95}],"profiles":{},"directory_counts":{}}
