{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"rensu-e-o215","title":"京兆自马超破后民多不专农殖，颜斐到官令属县整阡陌、树桑果","accounts":[{"id":"rensu-a-a79cae27106c520a59c3","label":"裴注·魏略","text":"京兆自马超破后民多不专农殖，颜斐到官令属县整阡陌、树桑果","evidence":["rensu-q-79b49139f1687c9010a0"]},{"id":"rensu-a-dd20f900abeb6e79251e","label":"裴注·魏略","text":"颜斐课民闲月取车材转相教匠作车，又课无牛者蓄猪狗卖以买牛，一二年间家家有丁车大牛","evidence":["rensu-q-1545ecc0b09a7a63e6a1"]},{"id":"rensu-a-4a8121bda843ff86f5fe","label":"裴注·魏略","text":"颜斐起文学，听吏民欲读书者复其小徭","evidence":["rensu-q-2f670191faa3a3e81cd9"]},{"id":"rensu-a-53c6dae94e8a3036404a","label":"裴注·魏略","text":"颜斐于府下起菜园使吏役闲锄治，课民输租时车牛因便致薪两束为冬寒炙笔砚，于是风化大行，吏不烦民民不求吏","evidence":["rensu-q-4f0e743daf9464536218"]}],"participants":[{"person":"rensu-p0062","role":"到官课农者；课民者；兴学者","evidence":["rensu-q-79b49139f1687c9010a0","rensu-q-1545ecc0b09a7a63e6a1","rensu-q-2f670191faa3a3e81cd9","rensu-q-4f0e743daf9464536218"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["rensu-q-79b49139f1687c9010a0","rensu-q-1545ecc0b09a7a63e6a1","rensu-q-2f670191faa3a3e81cd9","rensu-q-4f0e743daf9464536218"]},"ordering_evidence":"rensu-q-79b49139f1687c9010a0","source_order":[16,375,44],"order":3465}],"persons":[{"id":"rensu-p0062","name":"颜斐","facts":[],"aliases":[]}],"evidence":[{"id":"rensu-q-1545ecc0b09a7a63e6a1","section":"chapter-016","block":"b-6577b6fcf8117e2e08d7","layer":"pei","quote":"是时民多无车牛，斐又课民以闲月取车材，使转相教匠作车。又课民无牛者，令蓄猪狗，卖以买牛。始者，民以为烦；一二年间，家家有丁车、大牛","attribution":"裴注·魏略","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":374,"anchor":null},"note_id":"n-5a7a9e505ad84ef4841b","start":101,"end":166},{"id":"rensu-q-2f670191faa3a3e81cd9","section":"chapter-016","block":"b-6577b6fcf8117e2e08d7","layer":"pei","quote":"又起文学，听吏民欲读书者，复其小徭","attribution":"裴注·魏略","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":374,"anchor":null},"note_id":"n-5a7a9e505ad84ef4841b","start":167,"end":184},{"id":"rensu-q-4f0e743daf9464536218","section":"chapter-016","block":"b-6577b6fcf8117e2e08d7","layer":"pei","quote":"又于府下起菜园，使吏役闲锄治。又课民当输租时，车牛各因便，致薪两束，为冬寒冰，炙笔砚。于是风化大行，吏不烦民，民不求吏","attribution":"裴注·魏略","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":374,"anchor":null},"note_id":"n-5a7a9e505ad84ef4841b","start":185,"end":244},{"id":"rensu-q-79b49139f1687c9010a0","section":"chapter-016","block":"b-6577b6fcf8117e2e08d7","layer":"pei","quote":"始，京兆从马超破后，民人多不专于农殖；又历数四二千石，取解目前，亦不为民作久远计。斐到官，乃令属县整阡陌，树桑果","attribution":"裴注·魏略","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":374,"anchor":null},"note_id":"n-5a7a9e505ad84ef4841b","start":44,"end":100}],"profiles":{},"directory_counts":{}}
