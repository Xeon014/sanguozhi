{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o106a","title":"高幹降后复叛据壶关","accounts":[{"id":"wudi-e-o106a-account","label":"正文","text":"高幹在邺破后降曹并任并州刺史，乘曹操讨乌丸时叛，执上党太守守壶关；乐进、李典奉命进击。","evidence":["wudi-e-o106a-q"]},{"id":"dongyuan-e-o063a-account","label":"《董二袁刘传第六》正文","text":"高幹降仍任并州刺史","evidence":["dongyuan-e-o063a-q"]},{"id":"dongyuan-e-o066a-account","label":"《董二袁刘传第六》正文","text":"高幹反执上党太守守壶口关乐进李典不克","evidence":["dongyuan-e-o066a-q"]},{"id":"liusima-a-28d50570da4bc9ad51bd","label":"正文","text":"其后高幹复举并州反","evidence":["liusima-q-c71a87b97cf1fca6018b"]},{"id":"rensu-a-2581b69060f3646a01de","label":"正文","text":"高幹举并州反","evidence":["rensu-q-a4434afe58fa4338b5ca"]},{"id":"lizang-a-2995adc33f6a57aa19e5","label":"正文","text":"李典与乐进围高幹于壶关（后皆破之）","evidence":["lizang-q-868e5eeda14aec6401f9"]}],"participants":[{"person":"wudi-p0235","role":"降后复叛","evidence":["wudi-e-o106a-q"]},{"person":"cao-cao","role":"遣军","evidence":["wudi-e-o106a-q"]},{"person":"wudi-p0236","role":"进击","evidence":["wudi-e-o106a-q"]},{"person":"wudi-p0237","role":"进击","evidence":["wudi-e-o106a-q"]}],"place":{"text":"并州、上党、壶关","evidence":["wudi-e-o106a-q"]},"time":{"label":"建安十年讨乌丸时","year":205,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o106a-q","wudi-q-o100","wudi-q-b-2e98e13ca098117a86e9"],"chronology":"wudi-y205","dating_review":{"anchor":"wudi-q-o100","basis":"建安十年讨乌丸时","reviewed":true}},"source_order":[1,579,"O106a"],"order":241}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0235","name":"高幹","facts":[],"aliases":[]},{"id":"wudi-p0236","name":"乐进","facts":[],"aliases":[]},{"id":"wudi-p0237","name":"李典","facts":[],"aliases":[]}],"evidence":[{"id":"dongyuan-e-o063a-q","section":"chapter-006","block":"b-10271ae5ef4c9ea9db1a","layer":"original","quote":"高幹以并州降，复以幹为刺史。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":370,"anchor":null},"note_id":null,"start":0,"end":14},{"id":"dongyuan-e-o066a-q","section":"chapter-006","block":"b-c04aa2e6c942c6cf2a0e","layer":"original","quote":"高幹叛，执上党太守，举兵守壶口关。遣乐进、李典击之，未拔。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":373,"anchor":null},"note_id":null,"start":0,"end":29},{"id":"liusima-q-c71a87b97cf1fca6018b","section":"chapter-015","block":"b-d158b35e0c99bd1badc0","layer":"original","quote":"其后幹复举并州反","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":137,"anchor":null},"note_id":null,"start":110,"end":118},{"id":"lizang-q-868e5eeda14aec6401f9","section":"chapter-018","block":"b-2d2b7f4d5bd4d51b6feb","layer":"original","quote":"与乐进围高幹于壶关，击管承于长广〖7〗；皆破之","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":3,"anchor":null},"note_id":null,"start":117,"end":140},{"id":"rensu-q-a4434afe58fa4338b5ca","section":"chapter-016","block":"b-18fc621e57fb0ca723bc","layer":"original","quote":"而高幹举并州反","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":67,"anchor":null},"note_id":null,"start":49,"end":56},{"id":"wudi-e-o106a-q","section":"chapter-001","block":"b-8b9e6e02f2ce41e4085c","layer":"original","quote":"初，袁绍以甥高幹领并州牧〖13〗。公之拔邺，幹降，遂以为刺史。幹闻公讨乌丸，乃以州叛。执上党太守，举兵守壶关口〖14〗。遣乐进、李典击之〖15〗，幹还守壶关城〖16〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":578,"anchor":null},"note_id":null,"start":0,"end":84},{"id":"wudi-q-b-2e98e13ca098117a86e9","section":"chapter-001","block":"b-2e98e13ca098117a86e9","layer":"modern","quote":"〖1〗十年：建安十年（公元 205）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":560,"anchor":null},"note_id":"n-a9b0434ee8de64aed40f","start":0,"end":19},{"id":"wudi-q-o100","section":"chapter-001","block":"b-1ca17316b02d7b4d213c","layer":"original","quote":"十年春正月〖1〗，攻谭，破之。斩谭，诛其妻子〖2〗，冀州平。﹝一﹞下令曰：“其与袁氏同恶者，与之更始〖3〗。”令民不得复私仇，禁厚葬；皆一之于法〖4〗。是月，袁熙大将焦触、张南等叛〖5〗，攻熙、尚；熙、尚奔三郡乌丸〖6〗。触等举其县降，封为列侯。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":557,"anchor":null},"note_id":null,"start":0,"end":123}],"profiles":{},"directory_counts":{}}
