{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"guanzhang-e-o032a","title":"刘备任马超左将军假节","accounts":[{"id":"guanzhang-e-o032a-account","label":"《关张马黄赵传第六》正文","text":"刘备任马超左将军假节","evidence":["guanzhang-e-o032a-q"]}],"participants":[{"person":"liu-bei","role":"任用","evidence":["guanzhang-e-o032a-q"]},{"person":"wudi-p0282","role":"受任","evidence":["guanzhang-e-o032a-q"]}],"place":null,"time":{"year":219,"label":"刘备为汉中王","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"guanzhang-y219","dating_review":{"reviewed":true,"anchor":"guanzhang-q-o008","basis":"刘备为汉中王"},"evidence":["guanzhang-e-o032a-q","guanzhang-q-o008","guanzhang-q-b-edafc9276d2732d2c2af"]},"ordering_evidence":"guanzhang-e-o032a-q","source_order":[36,142,"O032a"],"order":6911}],"persons":[{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"wudi-p0282","name":"马超","facts":[],"aliases":[]}],"evidence":[{"id":"guanzhang-e-o032a-q","section":"chapter-036","block":"b-643f29a163428494fe87","layer":"original","quote":"先主为汉中王，拜超为左将军，假节。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":141,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":17,"offset_unit":"unicode_code_point"},{"id":"guanzhang-q-b-edafc9276d2732d2c2af","section":"chapter-036","block":"b-edafc9276d2732d2c2af","layer":"modern","quote":"〖1〗二十四年：建安二十四年（公元 219）。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":42,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-16dc4b02f597093385c1","start":0,"end":23,"offset_unit":"unicode_code_point"},{"id":"guanzhang-q-o008","section":"chapter-036","block":"b-b96955cde6bd0ef2541b","layer":"original","quote":"二十四年〖1〗，先主为汉中王；拜羽为前将军，假节、钺。是岁，羽率众攻曹仁于樊。曹公遣于禁助仁。秋，大霖雨，汉水泛溢，禁所督七军皆没；禁降羽，羽又斩将军庞德〖2〗；梁、郏、陆浑群盗或遥受羽印号〖3〗，为之支党。羽威震华夏〖4〗，曹公议徙许都，以避其锐。司马宣王、蒋济以为：“关羽得志，孙权必不愿也。可遣人劝权蹑其后〖5〗，许割江南以封权，则樊围自解。”曹公从之。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":35,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":180,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
