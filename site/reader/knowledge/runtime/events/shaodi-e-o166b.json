{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"shaodi-e-o166b","title":"命钟会由骆谷伐蜀","accounts":[{"id":"shaodi-e-o166b-account","label":"《三少帝纪》正文","text":"命钟会由骆谷伐蜀","evidence":["shaodi-e-o166b-q"]},{"id":"wgc-a-5-e41","label":"正文 · 景元四年秋","text":"钟会统十余万分从斜谷骆谷入","evidence":["wgc-q0451","wgc-q0070"]}],"participants":[{"person":"shaodi-p0073","role":"奉诏伐蜀","evidence":["shaodi-e-o166b-q"]}],"place":{"text":"骆谷","evidence":["shaodi-q-o166"]},"time":{"year":263,"label":"夏五月","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"shaodi-y263","dating_review":{"reviewed":true,"anchor":"shaodi-q-o165","basis":"夏五月"},"evidence":["shaodi-e-o166b-q","shaodi-q-o165","shaodi-q-b-ded6d700dc6f860d1670"]},"ordering_evidence":"shaodi-e-o166b-q","source_order":[4,788,"O166b"],"order":1268}],"persons":[{"id":"shaodi-p0073","name":"钟会","facts":[],"aliases":[]}],"evidence":[{"id":"shaodi-e-o166b-q","section":"chapter-004","block":"b-b237d0439beadd09325c","layer":"original","quote":"夏五月，诏曰：“蜀，蕞尔小国〖2〗，土狭民寡。而姜维虐用其众，曾无废志〖3〗。往岁破败之后，犹复耕种沓中〖4〗，刻剥众羌，劳役无已，民不堪命。夫‘兼弱攻昧〖5〗，武之善经’；‘致人而不致于人〖6〗’，兵家之上略。蜀所恃赖，唯维而已；因其远离巢窟〖7〗，用力为易。今使征西将军邓艾督帅诸军，趋甘松、沓中以罗取维〖8〗；雍州刺史诸葛绪督诸军，趋（武都、高楼）〔武街、桥头〕〖9〗：首尾蹴讨。若擒维，便当东西并进，扫灭巴蜀也。”又命镇西将军钟会由骆谷伐蜀〖10〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":195,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":229,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-b-ded6d700dc6f860d1670","section":"chapter-004","block":"b-ded6d700dc6f860d1670","layer":"modern","quote":"〖1〗四年：景元四年（公元 263）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":201,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ef642248e44d01f3825d","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o165","section":"chapter-004","block":"b-b35fdf03685051716720","layer":"original","quote":"四年春二月〖1〗，复命大将军进位、爵赐，一如前诏。又固辞，乃止。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":194,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":32,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o166","section":"chapter-004","block":"b-b237d0439beadd09325c","layer":"original","quote":"夏五月，诏曰：“蜀，蕞尔小国〖2〗，土狭民寡。而姜维虐用其众，曾无废志〖3〗。往岁破败之后，犹复耕种沓中〖4〗，刻剥众羌，劳役无已，民不堪命。夫‘兼弱攻昧〖5〗，武之善经’；‘致人而不致于人〖6〗’，兵家之上略。蜀所恃赖，唯维而已；因其远离巢窟〖7〗，用力为易。今使征西将军邓艾督帅诸军，趋甘松、沓中以罗取维〖8〗；雍州刺史诸葛绪督诸军，趋（武都、高楼）〔武街、桥头〕〖9〗：首尾蹴讨。若擒维，便当东西并进，扫灭巴蜀也。”又命镇西将军钟会由骆谷伐蜀〖10〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":195,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":229,"offset_unit":"unicode_code_point"},{"id":"wgc-q0070","section":"chapter-028","block":"b-a8c7cff17ae8b7e5d8a8","layer":"original","quote":"四年秋〖1〗，乃下诏使邓艾、诸葛绪各统诸军三万余人：艾趋甘松、沓中，连缀维；绪趋武街，桥头〖2〗，绝维归路。会统十余万众，分从斜谷、骆谷入〖3〗。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":471,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":73,"offset_unit":"unicode_code_point"},{"id":"wgc-q0451","section":"chapter-028","block":"b-a8c7cff17ae8b7e5d8a8","layer":"original","quote":"会统十余万众，分从斜谷、骆谷入","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":471,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":54,"end":69,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
