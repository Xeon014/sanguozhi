{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"erfei-e-o036","title":"刘备立刘理为梁王","accounts":[{"id":"erfei-a-3cf92865f69a496e3635","label":"正文","text":"刘备立刘理为梁王","evidence":["erfei-q-c3c569251512cc0e8809","erfei-q2-5891323d029ef85a67aa"]}],"participants":[{"person":"liu-bei","role":"章武元年六月使司徒许靖策立刘理为梁王","evidence":["erfei-q-c3c569251512cc0e8809"]},{"person":"xianzhu-p0059","role":"奉命策立刘理为梁王","evidence":["erfei-q-c3c569251512cc0e8809"]},{"person":"xianzhu-p0114","role":"被立为梁王","evidence":["erfei-q-c3c569251512cc0e8809"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["erfei-q-c3c569251512cc0e8809"]},"ordering_evidence":"erfei-q-c3c569251512cc0e8809","source_order":[34,80,18],"order":6734}],"persons":[{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"xianzhu-p0059","name":"许靖","facts":[],"aliases":[]},{"id":"xianzhu-p0114","name":"刘理","facts":[],"aliases":[]}],"evidence":[{"id":"erfei-q-c3c569251512cc0e8809","section":"chapter-034","block":"b-ba53693076b6b95703b6","layer":"original","quote":"章武元年六月，使司徒靖立理为梁王","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":79,"anchor":null},"note_id":null,"start":18,"end":34},{"id":"erfei-q2-5891323d029ef85a67aa","section":"chapter-034","block":"b-ba53693076b6b95703b6","layer":"original","quote":"刘理字奉孝。亦后主庶弟也，与永异母。章武元年六月，使司徒靖立理为梁王。策曰：“小子理：朕统承汉序，祗顺天命。遵修典秩〖1〗，建尔于东，为汉藩辅。惟彼梁土，畿甸之邦〖2〗；民狎教化〖3〗，易导以礼。往悉乃心〖4〗，怀保黎庶〖5〗，以永尔国。王其敬之哉！”","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":79,"anchor":null},"note_id":null,"start":0,"end":126}],"profiles":{},"directory_counts":{}}
