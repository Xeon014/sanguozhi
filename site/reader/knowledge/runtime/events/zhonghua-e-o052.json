epage_0031.xhtml","index":152,"anchor":null},"note_id":null,"start":97,"end":200},{"id":"zhonghua-q-6d728e29779895e86c08","section":"chapter-013","block":"b-208364683defba7f9058","layer":"original","quote":"孙权欲不遣，歆谓权曰：“将军奉王命，始交好曹公，分义未固〖10〗。使仆得为将军效心〖11〗，岂不有益乎？今空留仆，是为养无用之物：非将军之良计也。”权悦，乃遣歆。","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":152,"anchor":null},"note_id":null,"start":16,"end":97}],"profiles":{},"directory_counts":{}}
