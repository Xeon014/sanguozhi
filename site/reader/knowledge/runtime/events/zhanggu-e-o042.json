{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhanggu-e-o042","title":"雍选用将吏密以闻权以此重之","accounts":[{"id":"zhanggu-a-e775269c9e259f5fbb5c","label":"正文","text":"雍选用将吏密以闻权以此重之","evidence":["zhanggu-q-eb814da8bafb2b095d59"]}],"participants":[{"person":"wuzhu-p0045","role":"随能所任心无适莫、时访逮民间及政职所宜辄密以闻、若见纳用则归之于上不用终不宣泄、于公朝有所陈及辞色虽顺而所执者正","evidence":["zhanggu-q-eb814da8bafb2b095d59"]},{"person":"sun-quan","role":"以此重之者","evidence":["zhanggu-q-eb814da8bafb2b095d59"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["zhanggu-q-eb814da8bafb2b095d59"]},"ordering_evidence":"zhanggu-q-eb814da8bafb2b095d59","source_order":[52,143,26],"order":9291}],"persons":[{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"wuzhu-p0045","name":"顾雍","facts":[],"aliases":[]}],"evidence":[{"id":"zhanggu-q-eb814da8bafb2b095d59","section":"chapter-052","block":"b-2cf0929ef24b445f39d3","layer":"original","quote":"其所选用文武将吏，各随能所任，心无适莫〖1〗。时访逮民间，及政职所宜，辄密以闻。若见纳用，则归之于上；不用，终不宣泄：权以此重之。然于公朝有所陈及〖2〗，辞色虽顺，而所执者正","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":142,"anchor":null},"note_id":null,"start":26,"end":113}],"profiles":{},"directory_counts":{}}
