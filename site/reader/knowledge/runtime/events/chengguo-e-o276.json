{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"chengguo-e-o276","title":"晔自引佩刀斫杀郑宝","accounts":[{"id":"chengguo-a-00f50343093ecadeae68","label":"正文","text":"晔自引佩刀斫杀郑宝","evidence":["chengguo-q-d1728674a64e042f676a"]}],"participants":[{"person":"wendi-p0071","role":"令家僮将宝众坐中门外为设酒饭、与宝于内宴饮、密勒健儿令因行觞而斫宝、因自引取佩刀斫杀宝、斩其首以令其军云曹公有令敢有动者与宝同罪","evidence":["chengguo-q-d1728674a64e042f676a"]},{"person":"zhouyu-p0030","role":"从数百人赍牛酒来候使、性不甘酒视候甚明、被斫杀","evidence":["chengguo-q-d1728674a64e042f676a"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["chengguo-q-d1728674a64e042f676a"]},"ordering_evidence":"chengguo-q-d1728674a64e042f676a","source_order":[14,270,32],"order":3088}],"persons":[{"id":"wendi-p0071","name":"刘晔","facts":[],"aliases":[]},{"id":"zhouyu-p0030","name":"郑宝","facts":[],"aliases":[]}],"evidence":[{"id":"chengguo-q-d1728674a64e042f676a","section":"chapter-014","block":"b-7d5f88463aff3b4230e0","layer":"original","quote":"宝果从数百人，赍牛酒来候使；晔令家僮将其众坐中门外，为设酒饭。与宝于内，宴饮。密勒健儿，令因行觞而斫宝〖6〗。宝性不甘酒〖7〗，视候甚明〖8〗，觞者不敢发。晔因自引取佩刀，斫杀宝，斩其首以令其军。云：“曹公有令。敢有动者，与宝同罪！”众皆惊怖，走还营","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":269,"anchor":null},"note_id":null,"start":32,"end":157}],"profiles":{},"directory_counts":{}}
