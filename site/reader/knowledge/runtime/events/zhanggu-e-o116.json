{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhanggu-e-o116","title":"昭辅权绥抚百姓诸侯宾旅自安","accounts":[{"id":"zhanggu-a-d6928e1249360a6a9246","label":"裴注·吴书","text":"昭辅权绥抚百姓诸侯宾旅自安","evidence":["zhanggu-q-ddce687494b40365a2da"]}],"participants":[{"person":"wendi-p0133","role":"辅权绥抚百姓，出征留守领幕府事","evidence":["zhanggu-q-ddce687494b40365a2da"]},{"person":"sun-quan","role":"受辅；出征留昭镇守","evidence":["zhanggu-q-ddce687494b40365a2da"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["zhanggu-q-ddce687494b40365a2da"]},"ordering_evidence":"zhanggu-q-ddce687494b40365a2da","source_order":[52,49,0],"order":9252}],"persons":[{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"wendi-p0133","name":"张昭","facts":[],"aliases":[]}],"evidence":[{"id":"zhanggu-q-ddce687494b40365a2da","section":"chapter-052","block":"b-f77d2cc90a0c29cd804e","layer":"pei","quote":"﹝一﹞《吴书》曰：“是时，天下分裂，擅命者众。孙策莅事日浅，恩泽未洽；一旦倾陨，士民狼狈，颇有同异。及昭辅权，绥抚百姓；诸侯、宾旅寄寓之士，得用自安。权每出征，留昭镇守，领幕府事。后黄巾贼起，昭讨平之。权征合肥，命昭别讨匡琦；又督领诸将，攻破豫章贼率周凤等于南城。自此希复将帅，常在左右，为谋谟臣。权以昭旧臣，待遇尤重。”","attribution":"裴注·吴书","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":48,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-3e1357ac49951abe2d65","start":0,"end":161,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
