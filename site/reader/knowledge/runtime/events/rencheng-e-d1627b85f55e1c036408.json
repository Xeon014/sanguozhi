1a1a12d","chapter-013":"24c6e486e7f78fc4d59ff01277b36cb77ffb69c68a6a9030889fe00efe4b3d27","chapter-016":"6cfac20452f269a832b087d2e808cc4b3017944d17dca1d5b1e068ebb98d8327","chapter-018":"7a62f43c1f5dc64661b088ef0fdd48392063ef5c49001fa980aa65e766380b23","chapter-019":"a43f6648e6c9d8389d561bee9d00824665f8f06542ab2a65aac06ed8a7601c5b","chapter-020":"2ef7e28be018140e07d27d7636a9df480a5cb7ef1cb3572c314a70e0d1acd07c","chapter-050":"71faaaddb69f25a5bdd7f315f15562e867eed9e897c9bd439a99a09c435bfe91","chapter-023":"908d4e64a01e171bdb09c0a7ee5484b8743be26b7cc75f49bd8b41b7ff391ff2","chapter-024":"39be893c0040dbb3148f9447402c47fc24dcb4356360f8558243258cb85b089a","chapter-025":"f37fc365e7d07f96b5fd289119e1846fe7f0030d8b46a7195fab316badf817b7","chapter-027":"dd48b2052380e1f6b6f6ffcb4835dd99cfe70efe4a9096fa51448dbdfaa14f00","chapter-062":"7031fb8ebde1ea3c95cdedcf93218fb46f69a71a29a1d9e82361f7108436a86a","chapter-063":"3ae8edfbae98c3e86a518f7022c664ed35a0d68d5ac36b331ceb560e76b1848f","chapter-065":"13c50dd7dc9a229aef1cfb43dd231955a0b1a6359dab04c54708df93fa114e12","chapter-057":"39e3922e223fe25b811b77f14049327071298549de6ed788ba7da697f067f2e3","chapter-021":"18c02b71e8f81644cf71ffea582a8e019509de0b5e9bc11451de595fa03e2cf3","chapter-029":"6ffb35bac29d20aa512b5a734e72f98ec5729b176f1bc5d6837e673bcc00880d","chapter-030":"3e0682212c3e242d0f221308bc203bd8309851b8498b94db16383bdde5234ce1"},"events":[{"id":"rencheng-e-d1627b85f55e1c036408","title":"曹植上疏请求诸国通问亲戚","accounts":[{"id":"rencheng-a-d1627b85f55e1c036408","label":"正文","text":"曹植上疏请求诸国通问亲戚","evidence":["rencheng-q-80af58d3ee3ff737495f","rencheng-q-72dd7c5d52a64386925f","rencheng-q-4364ca1d2cd7c855ab8b","rencheng-q-75b395ef015312ba65f4","rencheng-q-711eb08a06217cfe4925","rencheng-q-abe1cf9417262e46ee2c"]}],"participants":[{"person":"wudi-p0280","role":"上书或作诗者","evidence":["rencheng-q-80af58d3ee3ff737495f","rencheng-q-72dd7c5d52a64386925f","rencheng-q-4364ca1d2cd7c855ab8b","rencheng-q-75b395ef015312ba65f4","rencheng-q-711eb08a06217cfe4925","rencheng-q-abe1cf9417262e46ee2c"]}],"place":null,"time":{"label":"太和五年","year":231,"precision":"year","basis":"本篇原纪年与对应现代释年逐项对读。","evidence":["rencheng-q-566db2375c13b3187601","rencheng-q-80af58d3ee3ff737495f","rencheng-q-72dd7c5d52a64386925f","rencheng-q-4364ca1d2cd7c855ab8b","rencheng-q-75b395ef015312ba65f4","rencheng-q-711eb08a06217cfe4925","rencheng-q-abe1cf9417262e46ee2c"],"chronology":"rencheng-y-8b1a165d674f626dfcec","dating_review":{"reviewed":true,"anchor":"rencheng-q-566db2375c13b3187601","basis":"注释编号与本篇该条原纪年对应；文书与本段“其年”/“上疏”语境连续，未从其他事件继承公元年。"}},"ordering_evidence":"rencheng-q-80af58d3ee3ff737495f","order":3805}],"persons":[{"id":"wudi-p0280","name":"曹植","facts":[],"aliases":[]}],"evidence":[{"id":"rencheng-q-4364ca1d2cd7c855ab8b","section":"chapter-019","block":"b-77d2688d2e782f8140a1","layer":"original","quote":"至于臣者，人道绝绪〖22〗，禁锢明时，臣窃自伤也。不敢过望交气类〖23〗，修人事，叙人伦；近且婚媾不通〖24〗，兄弟（乖）〔永〕绝；吉凶之问塞〖25〗，庆吊之礼废；恩纪之违〖26〗，甚于路人；隔阂之异，殊于胡越〖27〗。今臣以一切之制〖28〗，永无朝觐之望；至于注心皇极，结情紫闼〖29〗，神明知之矣。然“天实为之〖30〗，谓之何哉〖31〗”！退惟诸王常有戚戚具尔之心〖32〗，愿陛下沛然垂诏〖33〗：使诸国庆问，四节得展；以叙骨肉之欢恩，全怡怡之笃义；妃妾之家，膏沐之遗〖34〗，岁得再通；齐义于贵宗〖35〗，等惠于百司〖36〗。如此，则古人之所叹，风雅之所咏，复存于圣世矣。臣伏自惟省，岂无锥刀之用？及观陛下之所拔授，若以臣为异姓，窃自料度，不后于朝士矣〖37〗。若得辞远游〖38〗，戴武弁〖39〗；解朱组〖40〗，佩青绂〖41〗；驸马、奉车〖42〗，趣得一号〖43〗；安宅京室，执鞭珥笔〖44〗；出从华盖，入侍辇毂；承答圣问，拾遗左右：乃臣丹诚之至愿，不离于梦想者也！远慕《鹿鸣》君臣之宴〖45〗，中咏《常棣》匪他之诫〖46〗；下思《伐木》友生之义〖47〗，终怀《蓼莪》罔极之哀〖48〗。每四节之会，块然独处〖49〗；左右唯仆隶，所对唯妻子；高谈无所与陈，发义无所与展。未尝不闻乐而拊心〖50〗，临觞而叹息也。","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":290,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":558,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-566db2375c13b3187601","section":"chapter-019","block":"b-b0d8386f9201c2e1f9f5","layer":"modern","quote":"〖2〗五年：太和五年（公元231）。","attribution":"现代注释","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":297,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4a318ded2a2da80157fb","start":0,"end":18,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-711eb08a06217cfe4925","section":"chapter-019","block":"b-fa82d5aff055040eb0c3","layer":"original","quote":"臣闻《文子》曰〖55〗：“不为福始，不为祸先。”今之否隔〖56〗，友于同忧〖57〗；而臣独倡言者，窃不愿于圣世使有不蒙施之物。有不蒙施之物，必有惨毒之怀〖58〗；故《柏舟》有“天只”之怨〖59〗，《谷风》有“弃予”之叹〖60〗。故伊尹耻其君不为尧舜；孟子曰〖61〗：“不以舜之所以事尧事其君者，不敬其君者也。”臣之愚蔽，固非虞、伊；至于欲使陛下崇光被时雍之美〖62〗，宜缉熙章明之德者〖63〗，是臣&&之诚，窃所独守。实怀鹤立企伫","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":292,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":215,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-72dd7c5d52a64386925f","section":"chapter-019","block":"b-676ee0906182ab0d8940","layer":"original","quote":"臣闻天称其高者，以无不覆；地称其广者，以无不载；日月称其明者，以无不照；江海称其大者，以无不容。故孔子曰：“大哉！尧之为君。惟天为大，惟尧则之〖4〗。”夫天德之于万物，可谓弘广矣；盖尧之为教，先亲后疏，自近及远。其《传》曰：“克明俊德〖5〗，以亲九族〖6〗；九族既睦，平章百姓〖7〗。”及周之文王，亦崇厥化〖8〗。其《诗》曰：“刑于寡妻〖9〗，至于兄弟；以御于家邦〖10〗。”是以雍雍穆穆〖11〗，风人咏之。昔周公吊管、蔡之不咸〖12〗，广封懿亲以藩屏王室。《传》曰：“周之宗盟〖13〗，异姓为后〖14〗。”诚骨肉之恩，爽而不离〖15〗；亲亲之义，实在敦固。未有义而后其君〖16〗，仁而遗其亲者也〖17〗。伏惟陛下：资帝唐钦明之德，体文王翼翼之仁〖18〗；惠洽椒房〖19〗，恩昭九族；群后百僚〖20〗，番休递上〖21〗；执政不废于公朝，下情得展于私室；亲理之路通，庆吊之情展。诚可谓恕己治人，推惠施恩者矣。","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":289,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":403,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-75b395ef015312ba65f4","section":"chapter-019","block":"b-3748775f357cf5933ad1","layer":"original","quote":"臣伏以为：犬马之诚不能动人，譬人之诚不能动天。崩城、陨霜〖51〗，臣初信之；以臣心况〖52〗，徒虚语耳！若葵藿之倾叶太阳〖53〗，虽不为之回光〖54〗，然〔终〕向之者，诚也。窃自比于葵藿；若降天地之施垂三光之明者，实在陛下。","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":291,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":112,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-80af58d3ee3ff737495f","section":"chapter-019","block":"b-0a27268809f16d0433fa","layer":"original","quote":"三年〖1〗，徙封东阿。五年〖2〗，复上疏，求存问亲戚〖3〗，因致其意曰：","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":288,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":36,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-abe1cf9417262e46ee2c","section":"chapter-019","block":"b-c789255dc9ce771e320d","layer":"original","quote":"之心；敢复陈闻者，冀陛下傥发天聪而垂神听也。","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":293,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":22,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
