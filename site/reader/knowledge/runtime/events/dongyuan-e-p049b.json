{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dongyuan-e-p049b","title":"李乐备船董承谋系帝伏德献绢尚弘负帝下岸渡河争船断指","accounts":[{"id":"dongyuan-e-p049b-account","label":"《献帝纪》","text":"李乐备船董承谋系帝伏德献绢尚弘负帝下岸渡河争船断指","evidence":["dongyuan-e-p049b-q"]}],"participants":[{"person":"dongyuan-p0020","role":"备船","evidence":["dongyuan-e-p049b-q"]},{"person":"wudi-p0113","role":"谋渡","evidence":["dongyuan-e-p049b-q"]},{"person":"dongyuan-p0102","role":"供绢","evidence":["dongyuan-e-p049b-q"]},{"person":"dongyuan-p0103","role":"负帝","evidence":["dongyuan-e-p049b-q"]},{"person":"wudi-p0054","role":"渡河","evidence":["dongyuan-e-p049b-q"]},{"person":"wudi-p0331","role":"被扶渡","evidence":["dongyuan-e-p049b-q"]}],"place":null,"time":{"label":"献帝渡河时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-p049b-q"]},"ordering_evidence":"dongyuan-e-p049b-q","source_order":[6,180,"P049b"],"order":1594}],"persons":[{"id":"dongyuan-p0020","name":"李乐","facts":[],"aliases":[]},{"id":"dongyuan-p0102","name":"伏德","facts":[],"aliases":[]},{"id":"dongyuan-p0103","name":"尚弘","facts":[],"aliases":[]},{"id":"wudi-p0054","name":"汉献帝","facts":[],"aliases":[]},{"id":"wudi-p0113","name":"董承","facts":[],"aliases":[]},{"id":"wudi-p0331","name":"伏皇后","facts":[],"aliases":[]}],"evidence":[{"id":"dongyuan-e-p049b-q","section":"chapter-006","block":"b-35cfbd89b795007423e6","layer":"pei","quote":"及当北渡，使李乐具船。天子步行趋河岸，岸高不得下。董承等谋欲以马羁相续，以系帝腰。时中宫仆伏德，扶中宫，一手持十匹绢；乃取德绢，连续为辇。行军校尉尚弘多力，令弘居前负帝，乃得下登船。其余不得渡者甚众，复遣船收诸不得渡者。皆争攀船，船上人以刃栎断其指；舟中之指可掬。","attribution":"《献帝纪》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":179,"anchor":null},"note_id":"n-6ae51262f7f7704d518a","start":94,"end":226}],"profiles":{},"directory_counts":{}}
