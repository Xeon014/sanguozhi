{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"yululu-e-900b4482bcfd1f0d2f9b","title":"虞翻谏孙策轻出微行游猎，策以为然","accounts":[{"id":"yululu-a-900b4482bcfd1f0d2f9b","label":"正文","text":"虞翻谏孙策轻出微行游猎，策以为然","evidence":["yululu-q-a34458db61dd80930b60"]}],"participants":[{"person":"zhouyu-p0058","role":"进谏","evidence":["yululu-q-a34458db61dd80930b60"]},{"person":"wudi-p0099","role":"听纳","evidence":["yululu-q-a34458db61dd80930b60"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["yululu-q-a34458db61dd80930b60"]},"ordering_evidence":"yululu-q-a34458db61dd80930b60","order":10054}],"persons":[{"id":"wudi-p0099","name":"孙策","facts":[],"aliases":[]},{"id":"zhouyu-p0058","name":"虞翻","facts":[],"aliases":[]}],"evidence":[{"id":"yululu-q-a34458db61dd80930b60","section":"chapter-057","block":"b-e030b10b3be869b379db","layer":"original","quote":"翻谏曰：“明府用乌集之众〖8〗，驱散附之士，皆得其死力：虽汉高帝不及也！至于轻出微行〖9〗，从官不暇严〖10〗，吏卒常苦之。夫君人者不重则不威〖11〗。故白龙鱼服〖12〗，困于豫且；白蛇自放〖13〗，刘季害之〖14〗。愿少留意〖15〗！”策曰：“君言是也！然时有所思，端坐悒悒〖16〗，有裨谌草创之计〖17〗。是以行耳","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":2,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":36,"end":195,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
