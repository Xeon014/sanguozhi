{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dongyuan-e-o035a","title":"袁绍出奔周毖伍琼何颙劝董卓赦之拜勃海太守","accounts":[{"id":"dongyuan-e-o035a-account","label":"《董二袁刘传第六》正文","text":"袁绍出奔周毖伍琼何颙劝董卓赦之拜勃海太守","evidence":["dongyuan-e-o035a-q"]}],"participants":[{"person":"wudi-p0052","role":"出奔受任","evidence":["dongyuan-e-o035a-q"]},{"person":"dongyuan-p0006","role":"劝赦","evidence":["dongyuan-e-o035a-q"]},{"person":"xunyu-p0076","role":"劝赦","evidence":["dongyuan-e-o035a-q"]},{"person":"wudi-p0029","role":"劝赦","evidence":["dongyuan-e-o035a-q"]},{"person":"wudi-p0053","role":"赦任","evidence":["dongyuan-e-o035a-q"]}],"place":null,"time":{"label":"袁绍奔冀州后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-o035a-q"]},"ordering_evidence":"dongyuan-e-o035a-q","source_order":[6,221,"O035a"],"order":1626}],"persons":[{"id":"dongyuan-p0006","name":"周毖","facts":[],"aliases":[]},{"id":"wudi-p0029","name":"何颙","facts":[],"aliases":[]},{"id":"wudi-p0052","name":"袁绍","facts":[],"aliases":[]},{"id":"wudi-p0053","name":"董卓","facts":[],"aliases":[]},{"id":"xunyu-p0076","name":"伍琼","facts":[],"aliases":[]}],"evidence":[{"id":"dongyuan-e-o035a-q","section":"chapter-006","block":"b-274eb213f46bac4967b9","layer":"original","quote":"绍既出，遂亡奔冀州。侍中周毖、城门校尉伍琼、议郎何颙等，皆名士也；卓信之。而阴为绍，乃说卓曰：“夫废立大事，非常人所及。绍不达大体，恐惧，故出奔，非有他志也。今购之急〖3〗，势必为变。袁氏树恩四世，门生故吏遍于天下〖4〗；若收豪杰以聚徒众，英雄因之而起，则山东非公之有也。不如赦之，拜一郡守；则绍喜于免罪，必无患矣。”卓以为然，乃拜绍勃海太守，封邟乡侯。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":220,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":177,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
