{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dongyuan-e-p046a","title":"李傕祭董卓信巫带刃见帝李祯解疑侍臣持刀","accounts":[{"id":"dongyuan-e-p046a-account","label":"《献帝起居注》","text":"李傕祭董卓信巫带刃见帝李祯解疑侍臣持刀","evidence":["dongyuan-e-p046a-q"]}],"participants":[{"person":"wudi-p0089","role":"祠祭见帝疑臣","evidence":["dongyuan-e-p046a-q"]},{"person":"wudi-p0054","role":"对答","evidence":["dongyuan-e-p046a-q"]},{"person":"dongyuan-p0094","role":"释疑","evidence":["dongyuan-e-p046a-q"]}],"place":null,"time":{"label":"李郭交攻时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-p046a-q"]},"ordering_evidence":"dongyuan-e-p046a-q","source_order":[6,162,"P046a"],"order":1575}],"persons":[{"id":"dongyuan-p0094","name":"李祯","facts":[],"aliases":[]},{"id":"wudi-p0054","name":"汉献帝","facts":[],"aliases":[]},{"id":"wudi-p0089","name":"李傕","facts":[],"aliases":[]}],"evidence":[{"id":"dongyuan-e-p046a-q","section":"chapter-006","block":"b-01aaf749bfd0fc201fac","layer":"pei","quote":"傕性喜鬼怪左道之术，常有道人及女巫歌讴击鼓，下神；祠祭六丁，符劾厌胜之具，无所不为。又于朝廷省门外，为董卓作神坐，数以牛羊祠之。讫，过省< ，问起居，求入见。傕带三刀，手复与鞭合持一刃。侍中、侍郎见傕带仗，皆惶恐；亦带剑持刀，先入在帝侧。傕对帝，或言‘明陛下’，或言‘明帝’；为帝说郭汜无状，帝亦随其意答应之。傕喜，出言：‘明陛下，真贤圣主！’意遂自信，自谓良得天子欢心也。虽然，犹不欲令近臣带剑在帝边，谓人言：‘此曹子，将欲图我邪？而皆持刀也？’侍中李祯，傕州里，素与傕通；语傕：‘所以持刀者，军中不可不尔。此国家故事。’傕意乃解。","attribution":"《献帝起居注》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":161,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-33c32b6c80ba50b749a6","start":13,"end":280,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
