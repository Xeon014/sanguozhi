{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xiahoucao-e-o040a","title":"曹洪卒曹馥嗣","accounts":[{"id":"xiahoucao-e-o040a-account","label":"《诸夏侯曹传第九》正文","text":"曹洪卒曹馥嗣","evidence":["xiahoucao-e-o040a-q"]}],"participants":[{"person":"wudi-p0075","role":"死亡","evidence":["xiahoucao-e-o040a-q"]},{"person":"xiahoucao-p0051","role":"嗣爵","evidence":["xiahoucao-e-o040a-q"]}],"place":null,"time":{"year":232,"label":"太和六年","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xiahoucao-y232","dating_review":{"reviewed":true,"anchor":"xiahoucao-q-o040","basis":"太和六年"},"evidence":["xiahoucao-e-o040a-q","xiahoucao-q-o040","wuzhu-q-o100","houfei-q-o031","mingdi-q-o026","mingdi-q-b-412fc25655f53a4b4d33"]},"ordering_evidence":"xiahoucao-e-o040a-q","source_order":[9,172,"O040a"],"order":2210}],"persons":[{"id":"wudi-p0075","name":"曹洪","facts":[],"aliases":[]},{"id":"xiahoucao-p0051","name":"曹馥","facts":[],"aliases":[]}],"evidence":[{"id":"houfei-q-o031","section":"chapter-005","block":"b-6812c920b6ae5772de59","layer":"original","quote":"太和六年，明帝爱女淑薨，追封谥淑为平原懿公主，为之立庙。取后亡从孙黄与合葬〖22〗，追封黄列侯。以夫人郭氏从弟德，为之后〖23〗，承甄氏姓；封德为平原侯，袭公主爵。﹝一﹞","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":124,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":85,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-b-412fc25655f53a4b4d33","section":"chapter-003","block":"b-412fc25655f53a4b4d33","layer":"modern","quote":"〖1〗六年：太和六年（公元 232）。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":191,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-d1427f90b1f8dd585e5a","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-o026","section":"chapter-003","block":"b-42d0ed5edde34d9ea9f5","layer":"original","quote":"六年春二月〖1〗，诏曰：“古之帝王，封建诸侯，所以藩屏王室也〖2〗。《诗》不云乎，‘怀德维宁，宗子维城’〖3〗。秦、汉继周，或强或弱〖4〗，俱失厥中〖5〗。大魏创业，诸王开国；随时之宜，未有定制：非所以永为后法也。其改封诸侯王，皆以郡为国〖6〗。”三月，癸酉〖7〗，行东巡；所过存问高年鳏寡孤独〖8〗，赐谷帛。乙亥〖9〗，月犯轩辕大星。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":186,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":168,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o100","section":"chapter-047","block":"b-2e3c046df01ea81f7bf6","layer":"original","quote":"嘉禾元年春正月，建昌侯虑卒。三月，遣将军周贺、校尉裴潜，乘海之辽东。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":10,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":34,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o040a-q","section":"chapter-009","block":"b-8219416fd7f206e08922","layer":"original","quote":"太和六年，薨。谥曰恭侯。子馥，嗣侯。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":171,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":18,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-o040","section":"chapter-009","block":"b-8219416fd7f206e08922","layer":"original","quote":"太和六年，薨。谥曰恭侯。子馥，嗣侯。初，太祖分洪户，封子震列侯。洪族父瑜，修慎笃敬〖12〗；官至卫将军，封列侯。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":171,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":56,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
