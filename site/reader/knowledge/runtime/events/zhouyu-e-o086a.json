{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhouyu-e-o086a","title":"吕蒙代鲁肃西屯陆口领军任汉昌太守","accounts":[{"id":"zhouyu-e-o086a-account","label":"《周瑜鲁肃吕蒙传》正文","text":"吕蒙代鲁肃西屯陆口领军任汉昌太守","evidence":["zhouyu-e-o086a-q"]}],"participants":[{"person":"lu-meng","role":"代领军受任","evidence":["zhouyu-e-o086a-q"]}],"place":null,"time":{"year":217,"label":"鲁肃卒后","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"zhouyu-y217","dating_review":{"reviewed":true,"anchor":"zhouyu-q-o061","basis":"鲁肃卒后"},"evidence":["zhouyu-e-o086a-q","zhouyu-q-o061","wendi-q-o001","wendi-q-b-913ec5db27e9333e32b7"]},"ordering_evidence":"zhouyu-e-o086a-q","source_order":[54,409,"O086a"],"order":9721}],"persons":[{"id":"lu-meng","name":"吕蒙","facts":[],"aliases":[]}],"evidence":[{"id":"wendi-q-b-913ec5db27e9333e32b7","section":"chapter-002","block":"b-913ec5db27e9333e32b7","layer":"modern","quote":"〖4〗二十二年：建安二十二年（公元 217）。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":7,"anchor":null},"note_id":"n-39c60c4f69065f26a257","start":0,"end":23},{"id":"wendi-q-o001","section":"chapter-002","block":"b-b7c78fcc8111b892643d","layer":"original","quote":"文皇帝讳丕，字子桓。武帝太子也。中平四年冬〖1〗，生于谯。﹝一﹞建安十六年〖2〗，为五官中郎将，副丞相〖3〗。二十二年〖4〗，立为魏太子。﹝二﹞","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":1,"anchor":null},"note_id":null,"start":0,"end":72},{"id":"zhouyu-e-o086a-q","section":"chapter-054","block":"b-d3ba3e8aca62b77055d2","layer":"original","quote":"鲁肃卒，蒙西屯陆口，肃军人马万余，尽以属蒙。又拜汉昌太守，食下隽、刘阳、汉昌、州陵。与关羽分土接境，知羽骁雄，有并兼心，且居国上流：其势难久。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":408,"anchor":null},"note_id":null,"start":0,"end":71},{"id":"zhouyu-q-o061","section":"chapter-054","block":"b-de047b32de569664b9fa","layer":"original","quote":"肃年四十六，建安二十二年卒。权为举哀〖17〗，又临其葬〖18〗。诸葛亮亦为发哀。﹝二﹞","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":282,"anchor":null},"note_id":null,"start":0,"end":43}],"profiles":{},"directory_counts":{}}
