{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o127a","title":"建铜雀台","accounts":[{"id":"wudi-e-o127a-account","label":"正文","text":"曹操建铜雀台。","evidence":["wudi-e-o127a-q"]}],"participants":[{"person":"cao-cao","role":"建台","evidence":["wudi-e-o127a-q"]}],"place":{"text":"铜雀台","evidence":["wudi-e-o127a-q"]},"time":{"label":"建安十五年冬","year":210,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o127a-q","wudi-q-o126","wudi-q-b-ee0c0fb3013218aec86b"],"chronology":"wudi-y210","dating_review":{"anchor":"wudi-q-o126","basis":"建安十五年冬","reviewed":true}},"source_order":[1,695,"O127a"],"order":296}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-o127a-q","section":"chapter-001","block":"b-1e43776d1026415a419f","layer":"original","quote":"冬，作铜雀台〖25〗。﹝一﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":19,"anchor":null},"note_id":null,"start":0,"end":14},{"id":"wudi-q-b-ee0c0fb3013218aec86b","section":"chapter-001","block":"b-ee0c0fb3013218aec86b","layer":"modern","quote":"〖12〗十五年：建安十五年（公元 210）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":32,"anchor":null},"note_id":"n-1cc8bff8736e92ce7836","start":0,"end":22},{"id":"wudi-q-o126","section":"chapter-001","block":"b-4d2f95c3f31b3ee562eb","layer":"original","quote":"十五年春〖12〗，下令曰：“自古受命及中兴之君〖13〗，曷尝不得贤人君子与之共治天下者乎〖14〗？及其得贤也，曾不出闾巷〖15〗。岂幸相遇哉〖16〗？上之人（不）求〔取〕之耳〖17〗！今天下尚未定，此特求贤之急时也。‘孟公绰为赵、魏老则优〖18〗，不可以为滕、薛大夫〖19〗’。若必廉士而后可用，则齐桓其何以霸世〖20〗？今天下得无有被褐怀玉而钓于渭滨者乎〖21〗？又得无盗嫂受金而未遇无知者乎〖22〗？二三子其佐我明扬仄陋〖23〗，唯才是举〖24〗。吾得而用之。”","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":18,"anchor":null},"note_id":null,"start":0,"end":233}],"profiles":{},"directory_counts":{}}
