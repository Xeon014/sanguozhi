{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhouyu-e-p015a","title":"魏书九州春秋称鲁肃激说迎曹遭怒再请助刘","accounts":[{"id":"zhouyu-e-p015a-account","label":"《魏书》《九州春秋》","text":"魏书九州春秋称鲁肃激说迎曹遭怒再请助刘","evidence":["zhouyu-e-p015a-q"]},{"id":"zhouyu-a-p016-judgment","label":"孙盛论","text":"孙盛以鲁肃先倡拒曹及请使观变为据，认为无缘再激说迎曹，且迎曹者多不应独斩鲁肃。","evidence":["zhouyu-q-p016-judgment"]}],"participants":[],"place":null,"time":{"label":"曹公征荆州时的激说之说（孙盛驳）","precision":"undated","basis":"保存两史叙述与孙盛反驳，不把争议说辞作确定行迹。","evidence":["zhouyu-e-p015a-q"]},"ordering_evidence":"zhouyu-e-p015a-q","source_order":[54,257,"P015a"],"order":9651}],"persons":[],"evidence":[{"id":"zhouyu-e-p015a-q","section":"chapter-054","block":"b-057e30489c8147d44975","layer":"pei","quote":"﹝一﹞《魏书》及《九州春秋》曰：“曹公征荆州，孙权大惧。鲁肃实欲劝权拒曹公，乃激说权曰：‘彼曹公者，实严敌也！新并袁绍，兵马甚精；乘战胜之威，伐丧乱之国：克可必也！不如遣兵助之，且送将军家诣邺；不然，将危！’权大怒，欲斩肃，肃因曰：‘今事已急，即有他图，何不遣兵助刘备，而欲斩我乎？’权然之，乃遣周瑜助备。”","attribution":"《魏书》《九州春秋》","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":256,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b21c708f39c1524bbfbe","start":0,"end":154,"offset_unit":"unicode_code_point"},{"id":"zhouyu-q-p016-judgment","section":"chapter-054","block":"b-ab7923a23d88e03e004f","layer":"pei","quote":"孙盛曰：“《吴书》及《江表传》，鲁肃一见孙权，便说拒曹公而论帝王之略；刘表之死也，又请使观变：无缘方复激说劝迎曹公也。又是时劝迎者众，而云独欲斩肃，非其论也。”","attribution":"孙盛论","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":257,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b21c708f39c1524bbfbe","start":0,"end":80,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
