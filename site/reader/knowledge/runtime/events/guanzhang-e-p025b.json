{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"guanzhang-e-p025b","title":"赵云北山迎黄忠突围救张著","accounts":[{"id":"guanzhang-e-p025b-account","label":"《云别传》","text":"赵云北山迎黄忠突围救张著","evidence":["guanzhang-e-p025b-q"]}],"participants":[{"person":"xianzhu-p0034","role":"迎救","evidence":["guanzhang-e-p025b-q"]},{"person":"xianzhu-p0051","role":"取粮","evidence":["guanzhang-e-p025b-q"]},{"person":"guanzhang-p0044","role":"被救","evidence":["guanzhang-e-p025b-q"]}],"place":null,"time":{"label":"益州既定后至刘备东征后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["guanzhang-e-p025b-q"]},"ordering_evidence":"guanzhang-e-p025b-q","source_order":[36,199,"P025b"],"order":6936}],"persons":[{"id":"guanzhang-p0044","name":"张著","facts":[],"aliases":[]},{"id":"xianzhu-p0034","name":"赵云","facts":[],"aliases":[]},{"id":"xianzhu-p0051","name":"黄忠","facts":[],"aliases":[]}],"evidence":[{"id":"guanzhang-e-p025b-q","section":"chapter-036","block":"b-bfbd05c62f55b5319eef","layer":"pei","quote":"夏侯渊败，曹公争汉中地，运米北山下，数千万囊。黄忠以为可取，云兵随忠取米。忠过期不还，云将数十骑轻行出围，迎视忠等。值曹公扬兵大出，云为公前锋所击，方战，其大众至；势逼，遂前突其阵，且斗且却。公军败，已复合；云陷敌，还趋围。将张著被创，云复驰马还营，迎著。","attribution":"《云别传》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":198,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a08234bc0170e60d90c5","start":135,"end":263,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
