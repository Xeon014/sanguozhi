{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dongyuan-e-p119a","title":"曹操令听刘琮还州表谏议大夫参军事","accounts":[{"id":"dongyuan-e-p119a-account","label":"《魏武故事》","text":"曹操令听刘琮还州表谏议大夫参军事","evidence":["dongyuan-e-p119a-q"]}],"participants":[{"person":"cao-cao","role":"表任","evidence":["dongyuan-e-p119a-q"]},{"person":"liu-cong","role":"辞州受任","evidence":["dongyuan-e-p119a-q"]}],"place":null,"time":{"label":"刘琮任青州后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-p119a-q"]},"ordering_evidence":"dongyuan-e-p119a-q","source_order":[6,504,"P119a"],"order":1773}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"liu-cong","name":"刘琮","facts":[],"aliases":[]}],"evidence":[{"id":"dongyuan-e-p119a-q","section":"chapter-006","block":"b-7894f607b9c538202d22","layer":"pei","quote":"﹝一﹞《魏武故事》载令曰：“楚有江、汉山川之险，后服先强，与秦争衡；荆州则其故地，刘镇南久用其民矣。身没之后，诸子鼎峙，虽终难全，犹可引日。青州刺史琮，心高志洁，智深虑广；轻荣重义，薄利厚德；蔑万里之业，忽三军之众；笃中正之体，敦令名之誉；上耀先君之遗尘，下图不朽之余祚。鲍永之弃并州，窦融之离五郡，未足以喻也。虽封列侯一州之位，犹恨此宠未副其人。而比有笺，求还州；监史虽尊，秩禄未优。今听所执，表琮为谏议大夫，参同军事。”","attribution":"《魏武故事》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":503,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-999e214a5f215703b579","start":0,"end":212,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
