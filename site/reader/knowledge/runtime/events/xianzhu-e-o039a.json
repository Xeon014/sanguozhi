{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-o039a","title":"孙权请刘备救吴","accounts":[{"id":"xianzhu-e-o039a-account","label":"《先主传》正文","text":"曹操征孙权，孙权向刘备求救。","evidence":["xianzhu-e-o039a-q"]}],"participants":[{"person":"cao-cao","role":"征吴","evidence":["xianzhu-e-o039a-q"]},{"person":"sun-quan","role":"求救","evidence":["xianzhu-e-o039a-q"]},{"person":"liu-bei","role":"受请","evidence":["xianzhu-e-o039a-q"]}],"place":null,"time":{"year":212,"label":"建安十七年（承上文“明年”）","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xianzhu-y212","dating_review":{"reviewed":true,"anchor":"xianzhu-q-o039","basis":"建安十七年（承上文“明年”）"},"evidence":["xianzhu-e-o039a-q","xianzhu-q-o039","xianzhu-q-o034","xianzhu-q-b-09400c250015597cdc75"]},"source_order":[32,165,"O039a"],"order":6558}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]}],"evidence":[{"id":"xianzhu-e-o039a-q","section":"chapter-032","block":"b-3fc74e22c633afc483a4","layer":"original","quote":"明年，曹公征孙权，权呼先主自救〖4〗。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":164,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-b-09400c250015597cdc75","section":"chapter-032","block":"b-09400c250015597cdc75","layer":"modern","quote":"〖10〗十六年：建安十六年（公元 211 ）。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":152,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8471d798647e2ff3307a","start":0,"end":23,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o034","section":"chapter-032","block":"b-464a6d3ab5db13314b70","layer":"original","quote":"十六年〖10〗，益州牧刘璋，遥闻曹公将遣钟繇等向汉中讨张鲁，内怀恐惧。别驾从事蜀郡张松说璋曰：“曹公兵强，无敌于天下；若因张鲁之资以取蜀土〖11〗，谁能御之者乎？”璋曰：“吾固忧之而未有计。”松曰：“刘豫州，使君之宗室，而曹公之深仇也，善用兵；若使之讨鲁，鲁必破；鲁破，则益州强；曹公虽来，无能为也。”","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":140,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":151,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o039","section":"chapter-032","block":"b-3fc74e22c633afc483a4","layer":"original","quote":"明年，曹公征孙权，权呼先主自救〖4〗。先主遣使告璋曰：“曹公征吴，吴忧危急；孙氏与孤，本为唇齿。又乐进在青泥与关羽相拒〖5〗；今不往救羽，进必大克；转侵州界〖6〗，其忧有甚于鲁。鲁，自守之贼，不足虑也。”乃从璋求万兵及资（宝）〔实〕〖7〗，欲以东行。璋但许兵四千，其余皆给半。﹝一﹞","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":164,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":141,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
