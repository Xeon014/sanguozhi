{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"guanzhang-e-p010a","title":"蜀记称孙权欲活关羽听左右言而斩","accounts":[{"id":"guanzhang-e-p010a-account","label":"《蜀记》","text":"蜀记称孙权欲活关羽听左右言而斩","evidence":["guanzhang-e-p010a-q"]},{"id":"guanzhang-a-p011-judgment","label":"裴松之按《吴书》","text":"裴松之据吴书称潘璋断路关羽至即斩，反驳孙权为敌刘曹而欲活关羽之说。","evidence":["guanzhang-q-p011-judgment"]}],"participants":[{"person":"sun-quan","role":"议杀","evidence":["guanzhang-e-p010a-q"]},{"person":"wudi-p0172","role":"被斩","evidence":["guanzhang-e-p010a-q"]},{"person":"guanzhang-p0002","role":"被获","evidence":["guanzhang-e-p010a-q"]}],"place":null,"time":{"label":"关羽被获时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["guanzhang-e-p010a-q"]},"ordering_evidence":"guanzhang-e-p010a-q","source_order":[36,58,"P010a"],"order":6864}],"persons":[{"id":"guanzhang-p0002","name":"关平","facts":[],"aliases":[]},{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"wudi-p0172","name":"关羽","facts":[],"aliases":[]}],"evidence":[{"id":"guanzhang-e-p010a-q","section":"chapter-036","block":"b-deb4718f4002ac03c133","layer":"pei","quote":"﹝三﹞《蜀记》曰：“权遣将军击羽，获羽及子平。权欲活羽，以敌刘、曹，左右曰：‘狼子不可养！后必为害。曹公不即除之，自取大患，乃议徙都；今岂可生！’乃斩之。”","attribution":"《蜀记》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":57,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4a5fb7be9dd6fee324ea","start":0,"end":78,"offset_unit":"unicode_code_point"},{"id":"guanzhang-q-p011-judgment","section":"chapter-036","block":"b-7321306238e0ce7cfa42","layer":"pei","quote":"臣松之按《吴书》：孙权遣将潘璋，逆断羽走路，羽至即斩；且临沮去江陵二三百里，岂容不时杀羽，方议其生死乎？又云“权欲活羽，以敌刘、曹”，此之不然，可以绝智者之口。","attribution":"裴松之按《吴书》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":58,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4a5fb7be9dd6fee324ea","st