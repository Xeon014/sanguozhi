{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"liuliao-e-o073","title":"亮集载诸葛亮表廖立及后主诏徙","accounts":[{"id":"liuliao-a-98b2601b6b0ea0618dc6","label":"裴注·亮集（表）及所附诏文","text":"亮集载诸葛亮表廖立及后主诏徙","evidence":["liuliao-q-ba3e6db6c73ff09ccb23"]}],"participants":[{"person":"zhuge-liang","role":"上表陈立罪状","evidence":["liuliao-q-ba3e6db6c73ff09ccb23"]},{"person":"liuliao-p0004","role":"表中被控告者、诏令徙不毛","evidence":["liuliao-q-ba3e6db6c73ff09ccb23"]},{"person":"xianzhu-p0112","role":"下诏不忍刑而令徙","evidence":["liuliao-q-ba3e6db6c73ff09ccb23"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liuliao-q-ba3e6db6c73ff09ccb23"]},"ordering_evidence":"liuliao-q-ba3e6db6c73ff09ccb23","source_order":[40,185,0],"order":7279}],"persons":[{"id":"liuliao-p0004","name":"廖立","facts":[],"aliases":[]},{"id":"xianzhu-p0112","name":"刘禅","facts":[],"aliases":[]},{"id":"zhuge-liang","name":"诸葛亮","facts":[],"aliases":[]}],"evidence":[{"id":"liuliao-q-ba3e6db6c73ff09ccb23","section":"chapter-040","block":"b-e66b83f5d243a2e13fe8","layer":"pei","quote":"﹝二﹞《亮集》有亮表曰：“立奉先帝，无忠孝之心：守长沙，则开门就敌；领巴郡，则（有）〔又〕暗昧�茸其事；随大（将）军，则诽谤讥诃；侍梓宫，则挟刃断人头于梓宫之侧。陛下即位之后，普增职号；立随比为将军，面语臣曰：‘我何宜在诸将军中？不表我为卿，（上）〔尚〕当在五校！’臣答：‘将军者，随大比耳。至于卿者，正方亦未为卿也。且宜处五校。’自是之后，怏怏怀恨。”诏曰：“三苗乱政，有虞流宥；廖立狂惑，朕不忍刑：亟徙不毛之地。”","attribution":"裴注·亮集（表）及所附诏文","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":184,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-48a3455186e423621200","start":0,"end":209,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
