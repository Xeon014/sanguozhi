e-o030a-q"]},{"id":"hequan-a-a06957c6b5b825b0b90d","label":"裴注·《江表传》","text":"张辽掩袭权于津北齐迎于津南","evidence":["hequan-q-70589874176e47a80f82"]},{"id":"hequan-a-2fda064dea06a8cfa23c","label":"正文","text":"贺齐传“从权征合肥……徐盛被创失矛牙……齐引兵拒击”与魏纪 wudi-e-o177a“孙权围合肥；张辽、李典击破之”为同一战役两侧记载","evidence":["hequan-q-fa635cf609ade308bebc"]},{"id":"chenghuang-a-152378ae71e08772436e","label":"正文","text":"从征合肥张辽袭权津北钦力战有功","evidence":["chenghuang-q-bbdae7d754c04167e68f"]},{"id":"chenghuang-a-d9b3e148186a42092011","label":"正文","text":"建安二十年武从击合肥奋命战死","evidence":["chenghuang-q-c9178e4de5e1f4d5f1c0"]},{"id":"chenghuang-a-8ef6b3f1c1ad4b276353","label":"正文","text":"逍遥津北宁引弓射敌厉问鼓吹","evidence":["chenghuang-q-30bc891313fd88e2f571"]},{"id":"chenghuang-a-b5813f480b65349e7b25","label":"正文","text":"逍遥津统陷围扶扞权出","evidence":["chenghuang-q-dfa8281d3da2ee994167"]},{"id":"chenghuang-a-73545f385449d776e0cb","label":"正文","text":"合肥张辽奄至璋斩走者兵皆还战","evidence":["chenghuang-q-7f09015d19a4599e5bc0"]},{"id":"lizang-a-c760164c2f50a362982c","label":"正文","text":"李典与张辽乐进屯合肥","evidence":["lizang-q-05f0fb998bfc8704c14b"]},{"id":"lizang-a-4e74afeaed7f3a096d98","label":"正文","text":"孙权率众围合肥","evidence":["lizang-q-b36ec05beaafe3e95b4a"]},{"id":"lizang-a-537f1f9f42fdd46d5990","label":"正文","text":"张辽欲奉曹操之教出战，素与进典不睦恐其不从","evidence":["lizang-q-b2a7cbf802ececc91f14"]},{"id":"lizang-a-05e28af3747476dbf1d9","label":"正文","text":"李典慨然申明不可以私憾忘公义","evidence":["lizang-q-ef25d47a4d54797ab7f5"]},{"id":"lizang-a-0e8cf6b456b51fdecb76","label":"正文","text":"李典乃率众与张辽破走孙权","evidence":["lizang-q-34c79c216a498f50c9b2"]}],"participants":[{"person":"sun-quan","role":"围城败退","evidence":["wudi-e-o177a-q"]},{"person":"wudi-p0178","role":"破敌","evidence":["wudi-e-o177a-q"]},{"person":"wudi-p0237","role":"破敌","evidence":["wudi-e-o177a-q"]},{"person":"lu-meng","role":"护卫","evidence":["zhouyu-e-o085b-q"]},{"person":"ling-tong","role":"护卫","evidence":["zhouyu-e-o085b-q"]},{"person":"cao-cao","role":"授官","evidence":["zhangle-e-o009b-q"]},{"person":"gan-ning","role":"护卫","evidence":["wuzhu-e-o030a-q"]},{"person":"wuzhu-p0005","role":"时率三千兵在津南迎权","evidence":["hequan-q-70589874176e47a80f82"]},{"person":"zhouyu-p0049","role":"从征合肥、力战有功；同从权逍遥津北者","evidence":["chenghuang-q-bbdae7d754c04167e68f","chenghuang-q-30bc891313fd88e2f571"]},{"person":"chenghuang-p0023","role":"从击合肥、奋命战死；斗死","evidence":["chenghuang-q-c9178e4de5e1f4d5f1c0","chenghuang-q-7f09015d19a4599e5bc0"]},{"person":"zhouyu-p0055","role":"横马斩宋谦徐盛兵走者二人使还战","evidence":["chenghuang-q-7f09015d19a4599e5bc0"]},{"person":"wuzhu-p0026","role":"披走","evidence":["chenghuang-q-7f09015d19a4599e5bc0"]},{"person":"wuzhu-p0030","role":"披走","evidence":["chenghuang-q-7f09015d19a4599e5bc0"]},{"person":"wudi-p0236","role":"同屯合肥；被围守城；素不睦者之一","evidence":["lizang-q-05f0fb998bfc8704c14b","lizang-q-b36ec05beaafe3e95b4a","lizang-q-b2a7cbf802ececc91f14"]}],"place":{"text":"合肥","evidence":["wudi-e-o177a-q"]},"time":{"label":"建安二十年八月","year":215,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o177a-q","wudi-q-o173","wudi-q-b-e0a96bdd9353a663e5ab"],"chronology":"wudi-y215","dating_review":{"anchor":"wudi-q-o173","basis":"建安二十年八月","reviewed":true}},"source_order":[1,999,"O177a"],"order":376}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"chenghuang-p0023","name":"陈武","facts":[],"aliases":[]},{"id":"gan-ning","name":"甘宁","facts":[],"aliases":[]},{"id":"ling-tong","name":"凌统","facts":[],"aliases":[]},{"id":"lu-meng","name":"吕蒙","facts":[],"aliases":[]},{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"wudi-p0178","name":"张辽","facts":[],"aliases":[]},{"id":"wudi-p0236","name":"乐进","facts":[],"aliases":[]},{"id":"wudi-p0237","name":"李典","facts":[],"aliases":[]},{"id":"wuzhu-p0005","name":"贺齐","facts":[],"aliases":[]},{"id":"wuzhu-p0026","name":"宋谦","facts":[],"aliases":[]},{"id":"wuzhu-p0030","name":"徐盛","facts":[],"aliases":[]},{"id":"zhouyu-p0049","name":"蒋钦","facts":[],"aliases":[]},{"id":"zhouyu-p0055","name":"潘璋","facts":[],"aliases":[]}],"evidence":[{"id":"chenghuang-q-30bc891313fd88e2f571","section":"chapter-055","block":"b-59188630395876d5b2b2","layer":"original","quote":"建安二十年，从攻合肥。会疫疾，军旅皆已引出；唯车下虎士千余人〖2〗，并吕蒙、蒋钦、凌统及宁，从权逍遥津北。张辽觇望知之〖3〗，即将步骑奄至。宁引弓射敌，与统等死战。宁厉声问：“鼓吹何以不作〖4〗！”壮气毅然，权尤嘉之","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":247,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":108,"offset_unit":"unicode_code_point"},{"id":"chenghuang-q-7f09015d19a4599e5bc0","section":"chapter-055","block":"b-1c84071264809633ecc0","layer":"original","quote":"合肥之役，张辽奄至，诸将不备。陈武斗死，宋谦、徐盛皆披走。璋身次在后，便驰进；横马斩谦、盛兵走者二人，兵皆还战：权甚壮之。拜偏将军，遂领（百）〔五〕校，屯半州","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":330,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":52,"end":131,"offset_unit":"unicode_code_point"},{"id":"chenghuang-q-bbdae7d754c04167e68f","section":"chapter-055","block":"b-09bba882c0c6e26f80f2","layer":"original","quote":"从征合肥，魏将张辽袭权于津北〖6〗，钦力战有功","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":82,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":82,"end":105,"offset_unit":"unicode_code_point"},{"id":"chenghuang-q-c9178e4de5e1f4d5f1c0","section":"chapter-055","block":"b-fc775defe345ffb22e72","layer":"original","quote":"建安二十年，从击合肥，奋命战死。权哀之，自临其葬","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":128,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":24,"offset_unit":"unicode_code_point"},{"id":"chenghuang-q-dfa8281d3da2ee994167","section":"chapter-055","block":"b-6c8f6e6155dc4b71961f","layer":"original","quote":"时权撤军，前部已发；魏将张辽等，奄至津北。权使追还前兵，兵去已远，势不相及；统率亲近三百人陷围，扶扞权出。敌已毁桥，桥之属者两版〖15〗，权策马驱驰；统复还战，左右尽死，身亦被创，所杀数十人；度权已免，乃还。桥败路绝，统被甲潜行","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":272,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":114,"offset_unit":"unicode_code_point"},{"id":"hequan-q-70589874176e47a80f82","section":"chapter-060","block":"b-5e810aa332c2516ac50a","layer":"pei","quote":"权征合肥还，为张辽所掩袭于津北：几至危殆。齐时率三千兵，在津南迎权。权既入大船，会诸将饮宴","attribution":"裴注·《江表传》","section_title":"贺全吕周钟离传第十五","source":{"file":"OEBPS/Text/titlepage_0127.xhtml","index":85,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-eb3c2cf75ce087f62140","start":11,"end":56,"offset_unit":"unicode_code_point"},{"id":"hequan-q-fa635cf609ade308bebc","section":"chapter-060","block":"b-13fedaa660ef9dfd713e","layer":"original","quote":"二十年〖13〗，从权征合肥。时城中出战，徐盛被创失（矛）〔牙〕〖14〗。齐引兵拒击，得盛所失","section_title":"贺全吕周钟离传第十五","source":{"file":"OEBPS/Text/titlepage_0127.xhtml","index":59,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":46,"offset_unit":"unicode_code_point"},{"id":"lizang-q-05f0fb998bfc8704c14b","section":"chapter-018","block":"b-64eb7ed11151550d0650","layer":"original","quote":"与张辽、乐进屯合肥","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":5,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":9,"offset_unit":"unicode_code_point"},{"id":"lizang-q-34c79c216a498f50c9b2","section":"chapter-018","block":"b-64eb7ed11151550d0650","layer":"original","quote":"乃率众与辽破走权","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":5,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":76,"end":84,"offset_unit":"unicode_code_point"},{"id":"lizang-q-b2a7cbf802ececc91f14","section":"chapter-018","block":"b-64eb7ed11151550d0650","layer":"original","quote":"辽欲奉教出战〖12〗；进、典、辽，皆素不睦，辽恐其不从","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":5,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":17,"end":44,"offset_unit":"unicode_code_point"},{"id":"lizang-q-b36ec05beaafe3e95b4a","section":"chapter-018","block":"b-64eb7ed11151550d0650","layer":"original","quote":"孙权率众围之","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":5,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":10,"end":16,"offset_unit":"unicode_code_point"},{"id":"lizang-q-ef25d47a4d54797ab7f5","section":"chapter-018","block":"b-64eb7ed11151550d0650","layer":"original","quote":"典慨然曰：“此国家大事，顾君计何如耳！吾可以私憾而忘公义乎","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":5,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":45,"end":74,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o177a-q","section":"chapter-001","block":"b-56be09918e62007ce730","layer":"original","quote":"八月，孙权围合肥；张辽、李典击破之。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":323,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":18,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-e0a96bdd9353a663e5ab","section":"chapter-001","block":"b-e0a96bdd9353a663e5ab","layer":"modern","quote":"〖1〗二十年：建安二十年（公元 215 ）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":328,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-3bb2f11071aab1690790","start":0,"end":22,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o173","section":"chapter-001","block":"b-fc2c779b81f1c3c13b40","layer":"original","quote":"二十年春正月〖1〗，天子立公中女为皇后〖2〗。省云中、定襄、五原、朔方郡〖3〗，郡置一县领其民；合以为新兴郡〖4〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":319,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":58,"offset_unit":"unicode_code_point"},{"id":"wuzhu-e-o030a-q","section":"chapter-047","block":"b-c5544862d0f0dbfb0095","layer":"original","quote":"权返自陆口，遂征合肥。合肥未下，撤军还，兵皆就路。权与凌统、甘宁等在津北，为魏将张辽所袭〖15〗；统等以死捍权，权乘骏马越津桥，得去。﹝二﹞","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":128,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":70,"offset_unit":"unicode_code_point"},{"id":"zhangle-e-o009a-q","section":"chapter-017","block":"b-7aaac17cec433f853374","layer":"original","quote":"平旦〖9〗，辽被甲持戟，先登陷阵；杀数十人，斩二将；大呼自名〖10〗，冲垒入，至权麾下。权大惊，众不知所为；走登高冢，以长戟自守。辽叱权“下战”，权不敢动；望见辽所将众少，乃聚围辽数重。辽左右麾围〖11〗，直前急击；围开，辽将麾下数十人得出。余众号呼曰：“将军弃我乎！”辽复还，突围，拔出余众。权人马皆披靡，无敢当者。自旦战至日中，吴人夺气〖12〗。还修守备，众心乃安，诸将咸服。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":20,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":190,"offset_unit":"unicode_code_point"},{"id":"zhangle-e-o009b-q","section":"chapter-017","block":"b-7aaac17cec433f853374","layer":"original","quote":"权守合肥十余日〖13〗，城不可拔，乃引退。辽率诸军追击，几复获权。太祖大壮辽，拜征东将军。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":20,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":190,"end":235,"offset_unit":"unicode_code_point"},{"id":"zhouyu-e-o085b-q","section":"chapter-054","block":"b-1827f70f66ba5b4938c3","layer":"original","quote":"师还，遂征合肥。既撤兵，为张辽等所袭，蒙与凌统，以死扞卫。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":384,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":11,"end":40,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
