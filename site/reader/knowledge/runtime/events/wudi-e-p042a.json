{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p042a","title":"曹操以堤伏击吕布","accounts":[{"id":"wudi-e-p042a-account","label":"《魏书》","text":"《魏书》记曹操营中不足千人，先以疑兵使吕布退屯，次日伏兵堤中，击败追进之敌。","evidence":["wudi-e-p042a-q"]}],"participants":[{"person":"cao-cao","role":"疑兵设伏","evidence":["wudi-e-p042a-q"]},{"person":"wudi-p0088","role":"进攻战败","evidence":["wudi-e-p042a-q"]}],"place":null,"time":{"label":"兴平二年夏","year":195,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-p042a-q","wudi-q-o035","wudi-q-b-927979d68d5dacfd36fe"],"chronology":"wudi-y195","dating_review":{"anchor":"wudi-q-o035","basis":"兴平二年夏","reviewed":true}},"source_order":[1,258,"P042a"],"order":115}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0088","name":"吕布","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-p042a-q","section":"chapter-001","block":"b-3f5eb1c28f8ab77e5fd0","layer":"pei","quote":"﹝一﹞《魏书》曰：“于是兵皆出取麦；在者不能千人，屯营不固。太祖乃令妇人守陴，悉兵拒之。屯西有大堤，其南树木幽深。布疑有伏，乃相谓曰：‘曹操多谲，勿入伏中！’引军屯南十余里。明日复来，太祖隐兵堤里，出半兵堤外。布益进，乃令轻兵挑战。既合，伏兵乃悉乘堤，步骑并进。大破之，获其鼓车，追至其营而还。”","attribution":"《魏书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":257,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4804ce324c91aa153983","start":0,"end":148,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-927979d68d5dacfd36fe","section":"chapter-001","block":"b-927979d68d5dacfd36fe","layer":"modern","quote":"〖1〗二年：兴平二年（公元 195）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":246,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8c38464987eb86819ded","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o035","section":"chapter-001","block":"b-94e8aac81304812fd313","layer":"original","quote":"二年春〖1〗，袭定陶。