{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhangle-e-o013a","title":"张辽朝洛阳曹丕问战事赐第优礼其母","accounts":[{"id":"zhangle-e-o013a-account","label":"《张乐于张徐传第十七》正文","text":"张辽朝洛阳曹丕问战事赐第优礼其母","evidence":["zhangle-e-o013a-q"]}],"participants":[{"person":"wudi-p0178","role":"朝见","evidence":["zhangle-e-o013a-q"]},{"person":"wudi-p0170","role":"赐第","evidence":["zhangle-e-o013a-q"]}],"place":null,"time":{"year":221,"label":"黄初二年","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"zhangle-y221","dating_review":{"reviewed":true,"anchor":"zhangle-q-o013","basis":"黄初二年"},"evidence":["zhangle-e-o013a-q","zhangle-q-o013","houfei-q-o020","houfei-q-b-3d6c2095d369a628f9e5"]},"ordering_evidence":"zhangle-e-o013a-q","source_order":[17,42,"O013a"],"order":3497}],"persons":[{"id":"wudi-p0170","name":"曹丕","facts":[],"aliases":[]},{"id":"wudi-p0178","name":"张辽","facts":[],"aliases":[]}],"evidence":[{"id":"houfei-q-b-3d6c2095d369a628f9e5","section":"chapter-005","block":"b-3d6c2095d369a628f9e5","layer":"modern","quote":"〖8〗二年：黄初二年（公元 221）。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":85,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-504e55d5381157bfc70c","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"houfei-q-o020","section":"chapter-005","block":"b-dd2adf33c3625f91bf58","layer":"original","quote":"延康元年正月，文帝即王位。六月，南征，后留邺。黄初元年十月，帝践阼。践阼之后，山阳公奉二女以嫔于魏，郭后、李、阴贵人，并爱幸；后愈失意，有怨言，帝大怒。二年六月〖8〗，遣使赐死；葬于邺。﹝四﹞","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":76,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":96,"offset_unit":"unicode_code_point"},{"id":"zhangle-e-o013a-q","section":"chapter-017","block":"b-96070d5724473c2e0ea5","layer":"original","quote":"黄初二年，辽朝洛阳宫。文帝引辽会建始殿，亲问破吴意状〖4〗。帝叹息，顾左右曰：“此亦古之召虎也〖5〗！”为起第舍，又特为辽母作殿；以辽所从破吴军应募步卒，皆为虎贲〖6〗。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":41,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":85,"offset_unit":"unicode_code_point"},{"id":"zhangle-q-o013","section":"chapter-017","block":"b-96070d5724473c2e0ea5","layer":"original","quote":"黄初二年，辽朝洛阳宫。文帝引辽会建始殿，亲问破吴意状〖4〗。帝叹息，顾左右曰：“此亦古之召虎也〖5〗！”为起第舍，又特为辽母作殿；以辽所从破吴军应募步卒，皆为虎贲〖6〗。孙权复称藩，辽还屯雍丘，得疾。帝遣侍中刘晔将太医视疾〖7〗，虎贲问消息，道路相属。疾未瘳，帝迎辽就行在所。车驾亲临，执其手；赐以御衣，太官日送御食。疾小差〖8〗，还屯。孙权复叛，帝遣辽，乘舟与曹休至海陵，临江。权甚惮焉，敕诸将：“张辽虽病，不可当也。慎之！”是岁，辽与诸将破权将吕范。辽病笃，遂薨于江都〖9〗。帝为流涕，谥曰刚侯。子虎嗣。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":41,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":254,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
