rce_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-883c0927aa968cdb0ae9","start":354,"end":370,"offset_unit":"unicode_code_point"},{"id":"chengguo-q-cf7d855e69450bf5bb81","section":"chapter-014","block":"b-2c211642b5918230ce4c","layer":"pei","quote":"刘备来奔，以为豫州牧。或谓太祖曰：‘备有英雄志，今不早图，后必为患。’太祖以问嘉，嘉曰：‘有是。然公提剑起义兵，为百姓除暴。推诚仗信，以招俊杰，犹惧其未也。今备有英雄名，以穷归己而害之，是以害贤为名；则志士将自疑，回心择主，公谁与定天下？夫除一人之患，以沮四海之望；安危之机，不可不察！’太祖笑曰：‘君得之矣","attribution":"裴注·《魏书》","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":116,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-883c0927aa968cdb0ae9","start":7,"end":161,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
