{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wuzhu-e-p040b","title":"冯熙使魏答曹丕陈群诱降不从被留自刺未死后卒魏","accounts":[{"id":"wuzhu-e-p040b-account","label":"《吴书》","text":"冯熙使魏答曹丕陈群诱降不从被留自刺未死后卒魏","evidence":["wuzhu-e-p040b-q"]}],"participants":[{"person":"wuzhu-p0049","role":"奉使拒诱自刺","evidence":["wuzhu-e-p040b-q"]},{"person":"wudi-p0170","role":"询问留使","evidence":["wuzhu-e-p040b-q"]},{"person":"wudi-p0394","role":"诱降","evidence":["wuzhu-e-p040b-q"]},{"person":"sun-quan","role":"闻而哀悼","evidence":["wuzhu-e-p040b-q"]}],"place":null,"time":{"label":"刘备卒后冯熙使蜀魏时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["wuzhu-e-p040b-q"]},"ordering_evidence":"wuzhu-e-p040b-q","source_order":[47,382,"P040b"],"order":8260}],"persons":[{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"wudi-p0170","name":"曹丕","facts":[],"aliases":[]},{"id":"wudi-p0394","name":"陈群","facts":[],"aliases":[]},{"id":"wuzhu-p0049","name":"冯熙","facts":[],"aliases":[]}],"evidence":[{"id":"wuzhu-e-p040b-q","section":"chapter-047","block":"b-757416591c6ec0bc242a","layer":"pei","quote":"后使于魏，文帝问曰：‘吴王若欲修宿好，宜当厉兵江关，悬旍巴蜀；而闻复遣修好，必有变故！’熙曰：‘臣闻西使直报问，且以观衅，非有谋也。’又曰：‘闻吴国比年灾旱，人物凋损；以大夫之明，观之何如？’熙对曰：‘吴王体量聪明，善于任使；赋政施役，每事必咨；教养宾旅，亲贤爱士；赏不择怨仇，而罚必加有罪：臣下皆感恩怀德，惟忠与义。带甲百万，谷帛如山；稻田沃野，民无饥岁：所谓金城汤池，强富之国也。以臣观之：轻重之分，未可量也！’帝不悦，以陈群与熙同郡，使群诱之；啖以重利，熙不为回。送至摩陂，欲困苦之。后又召还，未至；熙惧见迫不从，必危身辱命，乃引刀自刺，〔中乳房。〕御者觉之，不得死。权闻之，垂涕曰：‘此与苏武何异！’竟死于魏。","attribution":"《吴书》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":381,"anchor":null},"note_id":"n-9c2e0aed8e9f5846c710","start":63,"end":372}],"profiles":{},"directory_counts":{}}
