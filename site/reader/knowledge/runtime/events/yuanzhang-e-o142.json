{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"yuanzhang-e-o142","title":"布之破也，陈群父子见太祖皆拜，袁涣独高揖不为礼，太祖甚严惮之","accounts":[{"id":"yuanzhang-a-e590cf9b05d0d02fd24e","label":"裴注·袁氏世纪","text":"布之破也，陈群父子见太祖皆拜，袁涣独高揖不为礼，太祖甚严惮之","evidence":["yuanzhang-q-e7bec9a3c0fe4c7f4012"]},{"id":"yuanzhang-a-d4d90beaba633befb1c6","label":"裴注·袁氏世纪","text":"太祖给众官车使取布军中物，众人皆重载，唯袁涣取书数百卷资粮而已，众人闻之大惭，太祖益以此重焉","evidence":["yuanzhang-q-f39087cf125e17bbf9e3"]}],"participants":[{"person":"wudi-p0394","role":"与父时在吕布军中，见太祖皆拜","evidence":["yuanzhang-q-e7bec9a3c0fe4c7f4012"]},{"person":"wudi-p0308","role":"独高揖，不为礼；唯取书数百卷、资粮而已","evidence":["yuanzhang-q-e7bec9a3c0fe4c7f4012","yuanzhang-q-f39087cf125e17bbf9e3"]},{"person":"cao-cao","role":"甚严惮之；给众官车各数乘使取布军中物唯其所欲，益以此重袁涣","evidence":["yuanzhang-q-e7bec9a3c0fe4c7f4012","yuanzhang-q-f39087cf125e17bbf9e3"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["yuanzhang-q-e7bec9a3c0fe4c7f4012","yuanzhang-q-f39087cf125e17bbf9e3"]},"ordering_evidence":"yuanzhang-q-e7bec9a3c0fe4c7f4012","source_order":[11,43,12],"order":2542}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0308","name":"袁涣","facts":[],"aliases":[]},{"id":"wudi-p0394","name":"陈群","facts":[],"aliases":[]}],"evidence":[{"id":"yuanzhang-q-e7bec9a3c0fe4c7f4012","section":"chapter-011","block":"b-19ef452e5c3ac0d60bf4","layer":"pei","quote":"布之破也，陈群父子，时亦在布之军，见太祖皆拜；涣独高揖，不为礼，太祖甚严惮之","attribution":"裴注·袁氏世纪","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":42,"anchor":null},"note_id":"n-26041dd17129d54064d5","start":12,"end":50},{"id":"yuanzhang-q-f39087cf125e17bbf9e3","section":"chapter-011","block":"b-19ef452e5c3ac0d60bf4","layer":"pei","quote":"时太祖又给众官车，各数乘，使取布军中物，唯其所欲。众人皆重载；唯涣取书数百卷，资粮而已。众人闻之，大惭。涣谓所亲曰：‘脱我以行阵，令军发足以为行粮而已，不以此为我有；由是厉名也，大悔恨之！’太祖益以此重焉","attribution":"裴注·袁氏世纪","section_title":"袁张凉国田王邴管传第十一","so