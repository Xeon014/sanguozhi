{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"liuliao-e-o039","title":"李平督运不继呼诸葛亮还军又上表称伪退","accounts":[{"id":"liuliao-a-25172339c277fee3bfa7","label":"正文","text":"李平督运不继呼诸葛亮还军又上表称伪退","evidence":["liuliao-q-d55d149c2d8576c8b32c"]}],"participants":[{"person":"xianzhu-p0057","role":"督运不继、遣狐忠成藩呼还、又表后主称伪退","evidence":["liuliao-q-d55d149c2d8576c8b32c"]},{"person":"liuliao-p0007","role":"受遣喻指","evidence":["liuliao-q-d55d149c2d8576c8b32c"]},{"person":"liuliao-p0005","role":"受遣喻指","evidence":["liuliao-q-d55d149c2d8576c8b32c"]},{"person":"zhuge-liang","role":"承喻指退军","evidence":["liuliao-q-d55d149c2d8576c8b32c"]},{"person":"xianzhu-p0112","role":"受表者","evidence":["liuliao-q-d55d149c2d8576c8b32c"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liuliao-q-d55d149c2d8576c8b32c"]},"ordering_evidence":"liuliao-q-d55d149c2d8576c8b32c","source_order":[40,205,0],"order":7289}],"persons":[{"id":"liuliao-p0005","name":"成藩","facts":[],"aliases":[]},{"id":"liuliao-p0007","name":"狐忠","facts":[],"aliases":[]},{"id":"xianzhu-p0057","name":"李严","facts":[],"aliases":[]},{"id":"xianzhu-p0112","name":"刘禅","facts":[],"aliases":[]},{"id":"zhuge-liang","name":"诸葛亮","facts":[],"aliases":[]}],"evidence":[{"id":"liuliao-q-d55d149c2d8576c8b32c","section":"chapter-040","block":"b-25b551a22086b30e9958","layer":"original","quote":"九年春〖10〗，亮军祁山，平催督运事。秋夏之际，值天霖雨，运粮不继。平遣参军狐忠、督军成藩喻指〖11〗，呼亮来还，亮承以退军。平闻军退，乃更佯惊，说：“军粮饶足〖12〗，何以便归？”欲以解己不办之责，显亮不进之愆也〖13〗。又表后主，说：“军伪退，欲以诱贼与战。”","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":204,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":132,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
