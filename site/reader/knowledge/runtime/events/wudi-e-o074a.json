{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o074a","title":"曹操解白马围并斩颜良","accounts":[{"id":"wudi-e-o074a-account","label":"正文","text":"曹操用荀攸声东击西之策，使袁绍分兵，轻军趋白马，以张辽、关羽为前锋破颜良并斩之，迁民西行。","evidence":["wudi-e-o074a-q"]},{"id":"guanzhang-e-o003b-account","label":"《关张马黄赵传第六》正文","text":"关羽张辽先锋击颜良关羽刺斩解白马围封汉寿亭侯","evidence":["guanzhang-e-o003b-q"]},{"id":"xunyu-e-o042a-account","label":"《荀彧荀攸贾诩传第十》正文","text":"荀攸策解白马斩颜良","evidence":["xunyu-e-o042a-q"]},{"id":"dongyuan-e-o048c-account","label":"《董二袁刘传第六》正文","text":"曹操救刘延，击破斩颜良。","evidence":["dongyuan-e-o048c-q"]}],"participants":[{"person":"cao-cao","role":"救援","evidence":["wudi-e-o074a-q"]},{"person":"wudi-p0143","role":"献策","evidence":["wudi-e-o074a-q"]},{"person":"wudi-p0052","role":"分兵","evidence":["wudi-e-o074a-q"]},{"person":"wudi-p0176","role":"战败被斩","evidence":["wudi-e-o074a-q"]},{"person":"wudi-p0178","role":"前锋","evidence":["wudi-e-o074a-q"]},{"person":"wudi-p0172","role":"前锋","evidence":["wudi-e-o074a-q"]},{"person":"wudi-p0177","role":"获救","evidence":["wudi-e-o074a-q"]}],"place":{"text":"延津、白马","evidence":["wudi-e-o074a-q"]},"time":{"label":"建安五年夏四月","year":200,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o074a-q","wudi-q-o071","wudi-q-b-9900125064e5d85f08ad"],"chronology":"wudi-y200","dating_review":{"anchor":"wudi-q-o071","basis":"建安五年夏四月","reviewed":true}},"source_order":[1,412,"O074a"],"order":178}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0052","name":"袁绍","facts":[],"aliases":[]},{"id":"wudi-p0143","name":"荀攸","facts":[],"aliases":[]},{"id":"wudi-p0172","name":"关羽","facts":[],"aliases":[]},{"id":"wudi-p0176","name":"颜良","facts":[],"aliases":[]},{"id":"wudi-p0177","name":"刘延","facts":[],"aliases":[]},{"id":"wudi-p0178","name":"张辽","facts":[],"aliases":[]}],"evidence":[{"id":"dongyuan-e-o048c-q","section":"chapter-006","block":"b-839daef927a1c0dd9463","layer":"original","quote":"太祖救延，与良战，破斩良。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":306,"anchor":null},"note_id":null,"start":45,"end":58},{"id":"guanzhang-e-o003b-q","section":"chapter-036","block":"b-8598d8002cca4ca06d2c","layer":"original","quote":"绍遣大将（军）颜良，攻东郡太守刘延于白马。曹公使张辽及羽为先锋击之。羽望见良麾盖〖2〗，策马刺良于万众之中，斩其首还；绍诸将莫能当者，遂解白马围。曹公即表封羽为汉寿亭侯。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":9,"anchor":null},"note_id":null,"start":34,"end":119},{"id":"wudi-e-o074a-q","section":"chapter-001","block":"b-d459f6854c24b119312f","layer":"original","quote":"夏四月，公北救延。荀攸说公曰：“今兵少，不敌，分其势乃可。公到延津〖2〗，若将渡兵向其后者，绍必西应之。然后轻兵袭白马，掩其不备〖3〗；颜良可擒也。”公从之。绍闻兵渡，即分兵西应之。公乃引军兼行趋白马〖4〗。未至十余里，良大惊，来逆战。使张辽、关羽前登〖5〗，击破，斩良；遂解白马围，徙其民，循河而西。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":411,"anchor":null},"note_id":null,"start":0,"end":151},{"id":"wudi-q-b-9900125064e5d85f08ad","section":"chapter-001","block":"b-9900125064e5d85f08ad","layer":"modern","quote":"〖1〗五年：建安五年（公元 200）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":403,"anchor":null},"note_id":"n-744e4aee7f5ff14cca85","start":0,"end":19},{"id":"wudi-q-o071","section":"chapter-001","block":"b-c9f735ddad48a8f5c2b6","layer":"original","quote":"五年春正月〖1〗，董承等谋泄，皆伏诛。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":400,"anchor":null},"note_id":null,"start":0,"end":19},{"id":"xunyu-e-o042a-q","section":"chapter-010","block":"b-c726b53542d9123e59fd","layer":"original","quote":"后从救刘延于白马，攸画策斩颜良。语在《武纪》。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":220,"anchor":null},"note_id":null,"start":0,"end":23}],"profiles":{},"directory_counts":{}}
