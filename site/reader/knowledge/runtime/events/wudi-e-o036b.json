{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o036b","title":"曹操伏击吕布并收复定陶","accounts":[{"id":"wudi-e-o036b-account","label":"正文","text":"吕布与陈宫再来，曹操设伏击败，继而攻下定陶；吕布东投刘备，张邈随行，张超守雍丘。","evidence":["wudi-e-o036b-q"]}],"participants":[{"person":"cao-cao","role":"设伏克城","evidence":["wudi-e-o036b-q"]},{"person":"wudi-p0088","role":"战败东投","evidence":["wudi-e-o036b-q"]},{"person":"wudi-p0096","role":"来战","evidence":["wudi-e-o036b-q"]},{"person":"wudi-p0062","role":"随吕布","evidence":["wudi-e-o036b-q"]},{"person":"wudi-p0111","role":"守雍丘","evidence":["wudi-e-o036b-q"]},{"person":"liu-bei","role":"吕布投奔对象","evidence":["wudi-e-o036b-q"]}],"place":{"text":"东缗、定陶、雍丘","evidence":["wudi-e-o036b-q"]},"time":{"label":"兴平二年夏","year":195,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o036b-q","wudi-q-o035","wudi-q-b-927979d68d5dacfd36fe"],"chronology":"wudi-y195","dating_review":{"anchor":"wudi-q-o035","basis":"兴平二年夏","reviewed":true}},"source_order":[1,242,"O036b"],"order":110}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"wudi-p0062","name":"张邈","facts":[],"aliases":[]},{"id":"wudi-p0088","name":"吕布","facts":[],"aliases":[]},{"id":"wudi-p0096","name":"陈宫","facts":[],"aliases":[]},{"id":"wudi-p0111","name":"张超（张邈弟）","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-o036b-q","section":"chapter-001","block":"b-46b956aeab7b17efb940","layer":"original","quote":"布复从东缗与陈宫将万余人来战〖5〗。时太祖兵少，设伏，纵奇兵击；大破之，﹝一﹞布夜走。太祖复攻，拔定陶，分兵平诸县。布东奔刘备；张邈从布，使其弟超将家属保雍丘〖6〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":241,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":36,"end":119,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-927979d68d5dacfd36fe","section":"chapter-001","block":"b-927979d68d5dacfd36fe","layer":"modern","quote":"〖1〗二年：兴平二年（公元 195）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":246,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8c38464987eb86819ded","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o035","section":"chapter-001","block":"b-94e8aac81304812fd313","layer":"original","quote":"二年春〖1〗，袭定陶。济阴太守吴资保南城〖2〗，未拔〖3〗。会吕布至，又击破之。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":240,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":40,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
