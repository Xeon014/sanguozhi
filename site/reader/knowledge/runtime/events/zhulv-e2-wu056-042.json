{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhulv-e2-wu056-042","title":"陈寿评朱治、吕范、朱然、朱桓、吕据、朱异、施绩","accounts":[{"id":"zhulv-a2-5768ee7148d1b709358f","label":"陈寿评","text":"陈寿评朱治、吕范、朱然、朱桓、吕据、朱异、施绩","evidence":["zhulv-q2-cfeafa291993356009f6"]}],"participants":[],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["zhulv-q2-cfeafa291993356009f6"]},"ordering_evidence":"zhulv-q2-cfeafa291993356009f6","order":10046}],"persons":[],"evidence":[{"id":"zhulv-q2-cfeafa291993356009f6","section":"chapter-056","block":"b-58b12458fffa27f89a96","layer":"original","quote":"评曰：朱治、吕范，以旧臣任用；朱然、朱桓，以勇烈著闻；吕据、朱异、施绩，咸有将领之才，克绍堂构〖1〗。若范、桓之越隘〖2〗，得以吉终；至于据、异无此之尤而反罹殃者〖3〗，所遇之时殊也〖4〗！","attribution":"陈寿评","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":297,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":95,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
