{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhuge-e-o035b","title":"诸葛亮围陈仓粮尽退斩追将王双","accounts":[{"id":"zhuge-e-o035b-account","label":"《诸葛亮传第五》正文","text":"诸葛亮围陈仓粮尽退斩追将王双","evidence":["zhuge-e-o035b-q"]},{"id":"houzhu-a-6c3218c0baba","label":"《后主传》正文","text":"冬，复出散关，围陈仓，粮尽，退。魏将王双率军追亮；亮与战，破之，斩双。还汉中。","evidence":["houzhu-q-O018"]}],"participants":[{"person":"zhuge-liang","role":"征讨","evidence":["zhuge-e-o035b-q"]},{"person":"zhuge-p0030","role":"追击战死","evidence":["zhuge-e-o035b-q"]},{"person":"wendi-p0038","role":"拒敌","evidence":["zhuge-e-o035b-q"]}],"place":null,"time":{"year":228,"label":"冬","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"zhuge-y228","dating_review":{"reviewed":true,"anchor":"zhuge-q-o032","basis":"冬"},"evidence":["zhuge-e-o035b-q","zhuge-q-o032","zhuge-q-b-0d2dada465388f4c2e39"]},"ordering_evidence":"zhuge-e-o035b-q","source_order":[35,217,"O035b"],"order":6791}],"persons":[{"id":"wendi-p0038","name":"曹真","facts":[],"aliases":[]},{"id":"zhuge-liang","name":"诸葛亮","facts":[],"aliases":[]},{"id":"zhuge-p0030","name":"王双","facts":[],"aliases":[]}],"evidence":[{"id":"houzhu-q-O018","section":"chapter-033","block":"b-1c360af1a6f15b74d3cc","layer":"original","quote":"冬，复出散关，围陈仓，粮尽，退。魏将王双率军追亮；亮与战，破之，斩双。还汉中。","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":50,"anchor":null},"note_id":null,"start":0,"end":39},{"id":"zhuge-e-o035b-q","section":"chapter-035","block":"b-e1f95db1c12301ddcd6f","layer":"original","quote":"冬，亮复出散关〖19〗，围陈仓〖20〗。曹真拒之，亮粮尽而还。魏将王双率骑追亮，亮与战；破之，斩双。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":216,"anchor":null},"note_id":null,"start":23,"end":73},{"id":"zhuge-q-b-0d2dada465388f4c2e39","section":"chapter-035","block":"b-0d2dada465388f4c2e39","layer":"modern","quote":"〖1〗六年：建兴六年（公元 228）。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":220,"anchor":null},"note_id":"n-c990758acc37a646578b","start":0,"end":19},{"id":"zhuge-q-o032","section":"chapter-035","block":"b-f4828bab0392be0b0bf7","layer":"original","quote":"六年春〖1〗，扬声由斜谷道取郿〖2〗，使赵云、邓芝为疑军〖3〗，据箕谷〖4〗；魏大将军曹真举众拒之。亮身率诸军攻祁山〖5〗，戎阵整齐，赏罚肃而号令明；南安、天水、安定三郡叛魏应亮，关中响震〖6〗。﹝二﹞","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":213,"anchor":null},"note_id":null,"start":0,"end":101}],"profiles":{},"directory_counts":{}}
