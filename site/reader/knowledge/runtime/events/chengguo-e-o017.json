{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"chengguo-e-o017","title":"改易权书离间诸葛亮孙权","accounts":[{"id":"chengguo-a-f11f0658ca042c6534bd","label":"正文","text":"改易权书离间诸葛亮孙权","evidence":["chengguo-q-d761cd3104b1a2d1e6c5"]}],"participants":[{"person":"mingdi-p0106","role":"三祖诏命有所招喻多放所为、边候得权书乃改易其辞往往换其本文而傅合之、与征东将军满宠若欲归化、封以示亮","evidence":["chengguo-q-d761cd3104b1a2d1e6c5"]},{"person":"sun-quan","role":"与诸葛亮连和欲俱出为寇、惧亮自疑深自解说","evidence":["chengguo-q-d761cd3104b1a2d1e6c5"]},{"person":"zhuge-liang","role":"受示书、腾与吴大将步骘等","evidence":["chengguo-q-d761cd3104b1a2d1e6c5"]},{"person":"shaodi-p0007","role":"受亮腾示以见权","evidence":["chengguo-q-d761cd3104b1a2d1e6c5"]},{"person":"mingdi-p0038","role":"被伪为若欲归化者","evidence":["chengguo-q-d761cd3104b1a2d1e6c5"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["chengguo-q-d761cd3104b1a2d1e6c5"]},"ordering_evidence":"chengguo-q-d761cd3104b1a2d1e6c5","source_order":[14,500,0],"order":3191}],"persons":[{"id":"mingdi-p0038","name":"满宠","facts":[],"aliases":[]},{"id":"mingdi-p0106","name":"刘放","facts":[],"aliases":[]},{"id":"shaodi-p0007","name":"步骘","facts":[],"aliases":[]},{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"zhuge-liang","name":"诸葛亮","facts":[],"aliases":[]}],"evidence":[{"id":"chengguo-q-d761cd3104b1a2d1e6c5","section":"chapter-014","block":"b-6878162b1b20512afbf4","layer":"original","quote":"放善为书檄。三祖诏命，有所招喻，多放所为。青龙初，孙权与诸葛亮连和，欲俱出为寇。边候得权书〖1〗，放乃改易其辞：往往换其本文，而傅合之〖2〗；与征东将军满宠，若欲归化。封以示亮，亮腾与吴大将步骘等〖3〗，骘等以见权。权惧亮自疑，深自解说","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":499,"anchor":null},"note_id":null,"start":0,"end":118}],"profiles":{},"directory_counts":{}}
