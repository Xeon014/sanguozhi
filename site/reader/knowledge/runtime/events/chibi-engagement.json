{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"chibi-engagement","title":"赤壁交战","order":273,"accounts":[{"id":"chibi-engagement-account-1","label":"记载","text":"《武帝纪》记曹操至赤壁与刘备战，不利；继而写到大疫和引军还。","evidence":["battle-wei"]},{"id":"chibi-engagement-account-2","label":"记载","text":"《先主传》记与曹军战于赤壁，大破并焚烧其舟船。","evidence":["battle-shu"]},{"id":"chibi-engagement-account-3","label":"记载","text":"《周瑜传》将初次交战写为曹军败退至江北，周瑜等驻南岸；并称曹军此前已有疾病。","evidence":["first-battle","allied-zhou"]},{"id":"wudi-e-o122b-account","label":"正文","text":"正文记曹操在赤壁与刘备交战不利。","evidence":["wudi-e-o122b-q"]},{"id":"zhouyu-a-o028-petition-wulin","label":null,"text":"诸葛瑾步骘为周胤请复爵，奏中以周瑜挫曹于乌林的旧功为论据。","evidence":["zhouyu-q-o028-petition-wulin"]},{"id":"wuzhu-e-o014c-account","label":"《吴主传第二》正文","text":"周瑜程普刘备赤壁破曹操曹操烧船退军","evidence":["wuzhu-e-o014c-q"]},{"id":"liuermu-a-98c93b2872a8186cf60d","label":"正文","text":"曹操军赤壁不利疫死","evidence":["liuermu-q-72714e8e65e531c4239a"]},{"id":"dongliu-a-4acbb1ff9b65ed147986","label":"裴注·零陵先贤传","text":"曹操败于乌林","evidence":["dongliu-q-a39e9358b20c1f65e3e3"]},{"id":"zhulv-a-cdcce87cea21b806d106","label":"正文","text":"曹公至赤壁，范与周瑜等俱拒破之；拜裨将军，领彭泽太守，以彭泽、柴桑、历（阳）〔陵〕为奉邑","evidence":["zhulv-q-16767d8bba4402e7c31f"]}],"participants":[{"person":"cao-cao","role":"交战一方","evidence":["battle-wei"]},{"person":"liu-bei","role":"交战一方","evidence":["battle-wei","battle-shu"]},{"person":"zhou-yu","role":"初战后驻南岸","evidence":["first-battle"]},{"person":"cheng-pu","role":"统军","evidence":["wuzhu-e-o014c-q"]},{"person":"wendi-p0157","role":"俱拒破之者","evidence":["zhulv-q-16767d8bba4402e7c31f"]}],"place":{"text":"赤壁；江北、南岸","evidence":["allied-zhou","first-battle"]},"time":{"label":"建安十三年（208）","year":208,"precision":"year","basis":"年次承接本篇建安十三年记事，现代注释释为公元 208 年；此条未记具体月日。","evidence":["year-original","year-modern","zhou-year","zhou-year-modern","battle-wei","allied-zhou"]}}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"cheng-pu","name":"程普","facts":[],"aliases":[]},{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"wendi-p0157","name":"吕范","facts":[],"aliases":[]},{"id":"zhou-yu","name":"周瑜","facts":[],"aliases":[]}],"evidence":[{"id":"allied-zhou","section":"chapter-054","block":"b-df9e8a2d1c2855c608f2","quote":"权遂遣瑜及程普等，与备并力逆曹公，遇于赤壁。","layer":"original","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":62,"anchor":null},"note_id":null,"start":41,"end":63},{"id":"battle-shu","section":"chapter-032","block":"b-1846d8225e91af23e064","quote":"与曹公战于赤壁〖10〗；大破之，焚其舟船。先主与吴军水陆并进，追到南郡。时又疾疫，北军多死，曹公引归。","layer":"original","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":113,"anchor":null},"note_id":null,"start":40,"end":91},{"id":"battle-wei","section":"chapter-001","block":"b-c35781bdeff07231cb61","quote":"公至赤壁〖16〗，与备战，不利；于是大疫，吏士多死者。乃引军还，","layer":"original","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":664,"anchor":null},"note_id":null,"start":50,"end":82},{"id":"dongliu-q-a39e9358b20c1f65e3e3","section":"chapter-039","block":"b-fed3da9a5cea5249184f","layer":"pei","quote":"曹公败于乌林","attribution":"裴注·零陵先贤传","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":57,"anchor":null},"note_id":"n-badf7ad8b29f822bb855","start":13,"end":19},{"id":"first-battle","section":"chapter-054","block":"b-95e35995161a23acb622","quote":"时曹公军众，已有疾病；初一交战，公军败退，引次江北〖1〗。瑜等在南岸。","layer":"original","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":63,"anchor":null},"note_id":null,"start":0,"end":35},{"id":"liuermu-q-72714e8e65e531c4239a","section":"chapter-031","block":"b-16f433ec30acbf04267b","layer":"original","quote":"会曹公军不利于赤壁〖9〗，兼以疫死","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":69,"anchor":null},"note_id":null,"start":43,"end":60},{"id":"wudi-e-o122b-q","section":"chapter-001","block":"b-c35781bdeff07231cb61","layer":"original","quote":"公至赤壁〖16〗，与备战，不利；","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":664,"anchor":null},"note_id":null,"start":50,"end":66},{"id":"wuzhu-e-o014c-q","section":"chapter-047","block":"b-5e943c9b5fe8a6b84c9b","layer":"original","quote":"瑜、普为左右督〖14〗，各领万人；与备俱进，遇于赤壁〖15〗，大破曹公军。公烧其余船，引退，士卒饥疫，死者太半。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":62,"anchor":null},"note_id":null,"start":156,"end":212},{"id":"year-modern","section":"chapter-001","block":"b-888495d8be7766faf20c","quote":"十三年：建安十三年（公元 208）。","layer":"modern","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":666,"anchor":null},"note_id":"n-0bae348fdb687025113d","start":3,"end":21},{"id":"year-original","section":"chapter-001","block":"b-4bcffcc4ee709a4e5ea3","quote":"十三年春正月〖1〗，公还邺。","layer":"original","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":661,"anchor":null},"note_id":null,"start":0,"end":14},{"id":"zhou-year","section":"chapter-054","block":"b-3661896c106f1817bf4b","quote":"十三年春〖6〗，权讨江夏，瑜为前部大督〖7〗。其年九月，曹公入荆州，刘琮举众降。","layer":"original","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":34,"anchor":null},"note_id":null,"start":0,"end":40},{"id":"zhou-year-modern","section":"chapter-054","block":"b-63f47c62fde80b3a0132","quote":"十三年：建安十三年（公元 208）。","layer":"modern","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":43,"anchor":null},"note_id":"n-8f109f42647e5ee8d831","start":3,"end":21},{"id":"zhouyu-q-o028-petition-wulin","section":"chapter-054","block":"b-c69fec6445fc3c06335b","layer":"original","quote":"故能摧曹操于乌林〖8〗，走曹仁于郢都〖9〗；","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":122,"anchor":null},"note_id":null,"start":109,"end":131},{"id":"zhulv-q-16767d8bba4402e7c31f","section":"chapter-056","block":"b-9e9fd56866fb5c05952c","layer":"original","quote":"曹公至赤壁，与周瑜等俱拒破之。拜裨将军，领彭泽太守〖1〗，以彭泽、柴桑、历（阳）〔陵〕为奉邑","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":171,"anchor":null},"note_id":null,"start":22,"end":68}],"profiles":{},"directory_counts":{}}
