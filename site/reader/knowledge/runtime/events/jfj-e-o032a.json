{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"jfj-e-o032a","title":"天水太守疑姜维等夜退上邽","order":7787,"accounts":[{"id":"jfj-a-o032a","label":"正文 · 建兴六年","text":"天水太守疑姜维等夜退上邽","evidence":["jfj-q0130"]},{"id":"jfj-a-p009a","label":"《魏略》","text":"《魏略》记马遵随郭淮退上邽","evidence":["jfj-q0224"]}],"participants":[{"person":"jfj-p0017","role":"退保上邽","evidence":["jfj-q0130"]},{"person":"shaodi-p0050","role":"随行","evidence":["jfj-q0130"]},{"person":"jfj-p0018","role":"随行","evidence":["jfj-q0130"]},{"person":"jfj-p0019","role":"随行","evidence":["jfj-q0130"]},{"person":"jfj-p0020","role":"随行","evidence":["jfj-q0130"]},{"person":"mingdi-p0100","role":"退保","evidence":["jfj-q0224"]}],"place":null,"time":{"label":"建兴六年","precision":"undated","basis":"逐条保留原时间；未从邻段自动继承公元年。","evidence":["jfj-q0130"]},"ordering_evidence":"jfj-q0130"}],"persons":[{"id":"jfj-p0017","name":"马遵","facts":[],"aliases":[]},{"id":"jfj-p0018","name":"梁绪","facts":[],"aliases":[]},{"id":"jfj-p0019","name":"尹赏","facts":[],"aliases":[]},{"id":"jfj-p0020","name":"梁虔","facts":[],"aliases":[]},{"id":"mingdi-p0100","name":"郭淮","facts":[],"aliases":[]},{"id":"shaodi-p0050","name":"姜维","facts":[],"aliases":[]}],"evidence":[{"id":"jfj-q0130","section":"chapter-044","block":"b-85aae37594d28a751d2e","layer":"original","quote":"建兴六年，丞相诸葛亮军向祁山。时天水太守适出案行〖3〗，维及功曹梁绪、主簿尹赏、主记梁虔等从行〖4〗。太守闻蜀军垂至，而诸县响应；疑维等皆有异心，于是夜亡保上邽","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":158,"anchor":null},"note_id":null,"start":0,"end":80},{"id":"jfj-q0224","section":"chapter-044","block":"b-1fcbe6e22b07445711e4","layer":"pei","quote":"天水太守马遵，将维及诸官属，随雍州刺史郭淮偶自西至洛门案行。会闻亮已到祁山，淮顾遵曰：‘是欲不善！’遂驱东，还上邽。遵念所治冀县界在西偏，又恐吏民乐乱，遂亦随淮去。","attribution":"《魏略》","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":173,"anchor":null},"note_id":"n-46e2cf216fe32246f7b2","start":10,"end":92}],"profiles":{},"directory_counts":{}}
