{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"houfei-e-p008b","title":"卞兰病渴拒巫水曹叡变色","accounts":[{"id":"houfei-e-p008b-account","label":"《魏略》","text":"卞兰病渴拒巫水曹叡变色","evidence":["houfei-e-p008b-q"]}],"participants":[{"person":"houfei-p0010","role":"拒水","evidence":["houfei-e-p008b-q"]},{"person":"wendi-p0005","role":"赐水","evidence":["houfei-e-p008b-q"]}],"place":null,"time":{"label":"明帝时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["houfei-e-p008b-q"]},"ordering_evidence":"houfei-e-p008b-q","source_order":[5,73,"P008b"],"order":1369}],"persons":[{"id":"houfei-p0010","name":"卞兰","facts":[],"aliases":[]},{"id":"wendi-p0005","name":"曹叡","facts":[],"aliases":[]}],"evidence":[{"id":"houfei-e-p008b-q","section":"chapter-005","block":"b-7f4aac8c36e9b47fec66","layer":"pei","quote":"﹝四﹞《魏略》曰：“明帝时，兰见外有二难，而帝留意于宫室。常因侍从，数切谏。帝虽不能从，犹纳其诚款。后兰苦酒消渴，时帝信巫女用水方，使人持水赐兰；兰不肯饮。诏问其意。兰言：‘治病自当以方药，何信于此？’帝为变色，而兰终不服。后渴稍甚，以至于亡。故时人见兰好直言，谓帝面折之而兰自杀。其实不然。”","attribution":"《魏略》","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":72,"anchor":null},"note_id":"n-61012e729f4dd79ee506","start":0,"end":147}],"profiles":{},"directory_counts":{}}
