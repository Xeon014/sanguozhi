{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p157a","title":"曹操杀边让及追杀袁忠桓邵之记","accounts":[{"id":"wudi-e-p157a-account","label":"《曹瞒传》","text":"《曹瞒传》称曹操因旧怨杀边让并族其家，又遣使赴交州士燮处追杀袁忠、桓邵家族；桓邵自首仍被杀。","evidence":["wudi-e-p157a-q"]}],"participants":[{"person":"cao-cao","role":"据书中记载杀人","evidence":["wudi-e-p157a-q"]},{"person":"wudi-p0413","role":"被杀","evidence":["wudi-e-p157a-q"]},{"person":"wudi-p0411","role":"被追杀","evidence":["wudi-e-p157a-q"]},{"person":"wudi-p0412","role":"被杀","evidence":["wudi-e-p157a-q"]},{"person":"wudi-p0414","role":"使者所至","evidence":["wudi-e-p157a-q"]}],"place":{"text":"兖州、交州","evidence":["wudi-e-p157a-q"]},"time":{"label":"领兖州以后，回叙旧怨","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p157a-q"]},"source_order":[1,1137,"P157a"],"order":456}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0411","name":"袁忠","facts":[],"aliases":[]},{"id":"wudi-p0412","name":"桓邵","facts":[],"aliases":[]},{"id":"wudi-p0413","name":"边让","facts":[],"aliases":[]},{"id":"wudi-p0414","name":"士燮","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-p157a-q","section":"chapter-001","block":"b-b02c08a63c1f0172f907","layer":"pei","quote":"初，袁忠为沛相，尝欲以法治太祖。沛国桓邵，亦轻之。及在兖州，陈留边让，言议颇侵太祖。太祖杀让，族其家。忠、邵俱避难交州，太祖遣使就太守士燮，尽族之。桓邵得出首，拜谢于庭中。太祖谓曰：‘跪可解死邪！’遂杀之。","attribution":"《曹瞒传》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":461,"anchor":null},"note_id":"n-6c928ccff5d542bc3225","start":159,"end":262}],"profiles":{},"directory_counts":{}}
