{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"lvzang-e-o075","title":"陈容谏绍专诛忠义绍复杀容","accounts":[{"id":"lvzang-a-a5cee9a1f508e452112d","label":"正文","text":"陈容谏绍专诛忠义绍复杀容","evidence":["lvzang-q-aa56469105848ae6d443"]}],"participants":[{"person":"lvzang-p0026","role":"少为书生亲慕洪随洪为东郡丞、城未败被洪遣出、绍令在坐见洪当死起谓绍曰将军举大事欲为天下除暴而专先诛忠义岂合天意臧洪发举为郡将奈何杀之、顾曰夫仁义岂有常蹈之则君子背之则小人今日宁与臧洪同日而死不与将军同日而生、复见杀","evidence":["lvzang-q-aa56469105848ae6d443"]},{"person":"wudi-p0052","role":"令容在坐、惭、左右使人牵出谓曰汝非臧洪俦空复尔为、复杀容","evidence":["lvzang-q-aa56469105848ae6d443"]},{"person":"lvzang-p0017","role":"城未败遣容出","evidence":["lvzang-q-aa56469105848ae6d443"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["lvzang-q-aa56469105848ae6d443"]},"ordering_evidence":"lvzang-q-aa56469105848ae6d443","source_order":[7,337,197],"order":1904}],"persons":[{"id":"lvzang-p0017","name":"臧洪","facts":[],"aliases":[]},{"id":"lvzang-p0026","name":"陈容","facts":[],"aliases":[]},{"id":"wudi-p0052","name":"袁绍","facts":[],"aliases":[]}],"evidence":[{"id":"lvzang-q-aa56469105848ae6d443","section":"chapter-007","block":"b-afee1171f0be37dc4055","layer":"original","quote":"洪邑人陈容，少为书生，亲慕洪，随洪为东郡丞〖7〗。城未败，洪遣出。绍令在坐，见洪当死，起谓绍曰：“将军举大事，欲为天下除暴；而专先诛忠义，岂合天意！臧洪发举为郡将〖8〗，奈何杀之？”绍惭，左右使人牵出，谓曰：“汝非臧洪俦〖9〗，空复尔为〖10〗？”容顾曰：“夫仁义岂有常！蹈之则君子，背之则小人。今日宁与臧洪同日而死，不与将军同日而生！”复见杀","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":336,"anchor":null},"note_id":null,"start":197,"end":369}],"profiles":{},"directory_counts":{}}
