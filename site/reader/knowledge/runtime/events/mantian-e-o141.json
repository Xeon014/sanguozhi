{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"mantian-e-o141","title":"淮分兵取化霸追维皆如计","accounts":[{"id":"mantian-a-3a2737c9a756bdec4d72","label":"正文","text":"淮分兵取化霸追维皆如计","evidence":["mantian-q-e2093a6f6a07520eef7b"]}],"participants":[{"person":"mingdi-p0100","role":"欲分兵取之、曰今往取化出贼不意维必狼顾、比维自致足以定化、且使维疲于奔命、兵不远西而胡交自离此一举而两全之策也、乃别遣夏侯霸等追维于沓中、自率诸军就攻化等、进封都乡侯","evidence":["mantian-q-e2093a6f6a07520eef7b"]},{"person":"shaodi-p0050","role":"出石营从强川西迎治无戴、果驰还救化","evidence":["mantian-q-e2093a6f6a07520eef7b"]},{"person":"luxun-p0019","role":"阴平太守、留于成重山筑城敛破羌保质、被攻","evidence":["mantian-q-e2093a6f6a07520eef7b"]},{"person":"guanzhang-p0049","role":"被遣追维于沓中","evidence":["mantian-q-e2093a6f6a07520eef7b"]}],"place":null,"time":{"label":"正始九年","precision":"year","year":248,"basis":"首轮审定确认的上下文现代释年；承接与逐项对读见审定记录。","evidence":["mantian-q-c44c6e7c29f0e387b75e","mantian-q-e2093a6f6a07520eef7b"],"chronology":"mantian-y-c82d1b03555547ee5dc5","dating_review":{"reviewed":true,"anchor":"mantian-q-c44c6e7c29f0e387b75e","basis":"本次上下文现代释年注释直接释年；承接与逐项对读见首轮审定记录。"}},"ordering_evidence":"mantian-q-e2093a6f6a07520eef7b","source_order":[26,332,154],"order":5273}],"persons":[{"id":"guanzhang-p0049","name":"夏侯霸","facts":[],"aliases":[]},{"id":"luxun-p0019","name":"廖淳","facts":[],"aliases":[]},{"id":"mingdi-p0100","name":"郭淮","facts":[],"aliases":[]},{"id":"shaodi-p0050","name":"姜维","facts":[],"aliases":[]}],"evidence":[{"id":"mantian-q-c44c6e7c29f0e387b75e","section":"chapter-026","block":"b-35426a824e988af35226","layer":"modern","quote":"〖15〗九年：正始九年（公元 248）。","attribution":"现代注释","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":350,"anchor":null},"note_id":"n-7a85f1e5a526a58dd446","start":0,"end":20},{"id":"mantian-q-e2093a6f6a07520eef7b","section":"chapter-026","block":"b-a5b1ad11436e99dbc058","layer":"original","quote":"姜维出石营〖24〗，从强川〖25〗，乃西迎治无戴；留阴平太守廖化于成重山筑城〖26〗，敛破羌保质〖27〗。淮欲分兵取之，诸将以：“维众西接强胡，化已据险；分军两持，兵势转弱；进不制维，退不拔化：非计也。不如合而俱西，及胡、蜀未接，绝其内外。此伐交之兵也〖28〗”。淮曰：“今往取化，出贼不意，维必狼顾〖29〗。比维自致，足以定化〖30〗；且使维疲于奔命。兵不远西〖31〗，而胡交自离，此一举而两全之策也。”乃别遣夏侯霸等追维于沓中〖32〗，淮自率诸军就攻化等。维果驰还救化，皆如淮计。进封都乡侯","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":331,"anchor":null},"note_id":null,"start":154,"end":401}],"profiles":{},"directory_counts":{}}
