{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dongyuan-e-p075c","title":"袁谭信华彦孔顺轻王修使妇弟兵两将索贿募兵税籍大减","accounts":[{"id":"dongyuan-e-p075c-account","label":"《九州春秋》","text":"袁谭信华彦孔顺轻王修使妇弟兵两将索贿募兵税籍大减","evidence":["dongyuan-e-p075c-q"]}],"participants":[{"person":"wudi-p0163","role":"用佞任兵","evidence":["dongyuan-e-p075c-q"]},{"person":"dongyuan-p0132","role":"受信","evidence":["dongyuan-e-p075c-q"]},{"person":"dongyuan-p0133","role":"受信","evidence":["dongyuan-e-p075c-q"]},{"person":"wendi-p0053","role":"备官","evidence":["dongyuan-e-p075c-q"]}],"place":null,"time":{"label":"袁谭赴青州前后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-p075c-q"]},"ordering_evidence":"dongyuan-e-p075c-q","source_order":[6,294,"P075c"],"order":1661}],"persons":[{"id":"dongyuan-p0132","name":"华彦","facts":[],"aliases":[]},{"id":"dongyuan-p0133","name":"孔顺","facts":[],"aliases":[]},{"id":"wendi-p0053","name":"王修","facts":[],"aliases":[]},{"id":"wudi-p0163","name":"袁谭","facts":[],"aliases":[]}],"evidence":[{"id":"dongyuan-e-p075c-q","section":"chapter-006","block":"b-f39003f8dec6806c0da9","layer":"pei","quote":"然信用群小，好受近言；肆志奢淫，不知稼穑之艰难。华彦、孔顺，皆奸佞小人也，信以为腹心；王修等备官而已。然能接待宾客，慕名敬士。使妇弟领兵在内，至令草窃市井而外，虏掠田野。别使两将募兵下县，有赂者见免，无者见取；贫弱者多，乃至于窜伏丘野之中，放兵捕索，如猎鸟兽。邑有万户者，著籍不盈数百；收赋纳税，三分不入一。招命贤士，不就；不趋赴军期，安居族党，亦不能罪也。","attribution":"《九州春秋》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":293,"anchor":null},"note_id":"n-06a13297a618ccaa32fd","start":179,"end":358}],"profiles":{},"directory_counts":{}}
