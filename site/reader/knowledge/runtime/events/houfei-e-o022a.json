itlepage_0011.xhtml","index":30,"anchor":null},"note_id":null,"start":0,"end":123},{"id":"mingdi-q-o008","section":"chapter-003","block":"b-bec9198de0001b0aa26c","layer":"original","quote":"二年春正月〖1〗，宣王攻破新城。斩达，传其首〖2〗。﹝一﹞分新城之上庸、武陵、巫县为上庸郡〖3〗，锡县为锡郡。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":54,"anchor":null},"note_id":null,"start":0,"end":55}],"profiles":{},"directory_counts":{}}
