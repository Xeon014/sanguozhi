{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xiahoucao-e-o096a","title":"司马懿回书赞三议而以待贤能及旧制难改为辞","accounts":[{"id":"xiahoucao-e-o096a-account","label":"《诸夏侯曹传第九》正文","text":"司马懿回书赞三议而以待贤能及旧制难改为辞","evidence":["xiahoucao-e-o096a-q"]}],"participants":[{"person":"wudi-p0364","role":"答书","evidence":["xiahoucao-e-o096a-q"]}],"place":null,"time":{"label":"司马懿答夏侯玄书时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xiahoucao-e-o096a-q"]},"ordering_evidence":"xiahoucao-e-o096a-q","source_order":[9,536,"O096a"],"order":2335}],"persons":[{"id":"wudi-p0364","name":"司马懿","facts":[],"aliases":[]}],"evidence":[{"id":"xiahoucao-e-o096a-q","section":"chapter-009","block":"b-b04a1ada258261b00fbc","layer":"original","quote":"宣王报书曰：“审官择人，除重官〖20〗，改服制，皆大善。礼：乡闾本行〖21〗，朝廷考事〖22〗。大指如所示〖23〗。而中间一相承习〖24〗，卒不能改。秦时无刺史，但有郡守、长吏。汉家虽有刺史，奉六条而已〖25〗。故刺史称‘传车’，其吏言‘从事’；居无常治〖26〗，吏不成臣〖27〗。其后转更为官司耳〖28〗。昔贾谊亦患服制〖29〗；汉文虽身服弋绨〖30〗，犹不能使上下如意〖31〗。恐此三事，当待贤能然后了耳〖32〗。”","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":535,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":210,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
