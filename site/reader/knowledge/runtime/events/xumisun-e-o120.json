{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xumisun-e-o120","title":"诸葛亮问秦宓任安所长","accounts":[{"id":"xumisun-a-dcdb6d29c2464f04c42a","label":"裴注·益部耆旧传","text":"诸葛亮问秦宓任安所长","evidence":["xumisun-q-9e5f166b06f36499b6bb","xumisun-q2-72d53338911b084f3955"]}],"participants":[{"person":"zhuge-liang","role":"任丞相后，问秦宓以任安所长","evidence":["xumisun-q-9e5f166b06f36499b6bb"]},{"person":"liuliao-p0008","role":"答曰记人之善，忘人之过","evidence":["xumisun-q-9e5f166b06f36499b6bb"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["xumisun-q-9e5f166b06f36499b6bb"]},"ordering_evidence":"xumisun-q-9e5f166b06f36499b6bb","source_order":[38,273,181],"order":7089}],"persons":[{"id":"liuliao-p0008","name":"秦宓","facts":[],"aliases":[]},{"id":"zhuge-liang","name":"诸葛亮","facts":[],"aliases":[]}],"evidence":[{"id":"xumisun-q-9e5f166b06f36499b6bb","section":"chapter-038","block":"b-927acb42202d160eaa63","layer":"pei","quote":"后丞相亮，问秦宓以‘安所长’，宓曰：‘记人之善，忘人之过","attribution":"裴注·益部耆旧传","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":272,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ef97ef6afdee0c02cbbd","start":181,"end":209,"offset_unit":"unicode_code_point"},{"id":"xumisun-q2-72d53338911b084f3955","section":"chapter-038","block":"b-927acb42202d160eaa63","layer":"pei","quote":"﹝一﹞《益部耆旧传》曰：“安，广汉人。少事聘士杨厚，究极图籍。游览京师，还家讲授，与董扶俱以学行齐声。郡请功曹，州辟治中、别驾；终不久居。举孝廉、茂才；太尉载辟；除博士，公车征：皆称疾不就。州牧刘焉，表荐安：‘味精道度，厉节高邈；揆其器量，国之元宝；宜处弼疑之辅，以消非常之咎：玄'之礼，所宜招命。’王途隔塞，遂无聘命。年七十九，建安七年卒。门人慕仰，为立碑铭。后丞相亮，问秦宓以‘安所长’，宓曰：‘记人之善，忘人之过。’”","attribution":"裴注（引书见原文）","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":272,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ef97ef6afdee0c02cbbd","start":0,"end":212,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
