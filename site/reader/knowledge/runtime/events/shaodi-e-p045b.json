{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"shaodi-e-p045b","title":"王沈王业奔告司马昭","accounts":[{"id":"shaodi-e-p045b-account","label":"《汉晋春秋》","text":"王沈王业奔告司马昭","evidence":["shaodi-e-p045b-q"]}],"participants":[{"person":"shaodi-p0103","role":"告密","evidence":["shaodi-e-p045b-q"]},{"person":"shaodi-p0129","role":"告密","evidence":["shaodi-e-p045b-q"]},{"person":"shaodi-p0045","role":"得报备兵","evidence":["shaodi-e-p045b-q"]}],"place":null,"time":{"year":260,"label":"五月己丑","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"shaodi-y260","dating_review":{"reviewed":true,"anchor":"shaodi-q-o139","basis":"五月己丑"},"evidence":["shaodi-e-p045b-q","shaodi-q-o139","shaodi-q-b-77066dd061eb6a338ffa"]},"ordering_evidence":"shaodi-e-p045b-q","source_order":[4,665,"P045b"],"order":1226}],"persons":[{"id":"shaodi-p0045","name":"司马昭","facts":[],"aliases":[]},{"id":"shaodi-p0103","name":"王沈","facts":[],"aliases":[]},{"id":"shaodi-p0129","name":"王业","facts":[],"aliases":[]}],"evidence":[{"id":"shaodi-e-p045b-q","section":"chapter-004","block":"b-7b9a7d8c7e1e41d12750","layer":"pei","quote":"﹝一﹞《汉晋春秋》曰：“帝见威权日去，不胜其忿。乃召侍中王沈、尚书王经、散骑常侍王业，谓曰：‘司马昭之心，路人所知也！吾不能坐受废辱！今日当与卿自出讨之。’王经曰：‘昔鲁昭公不忍季氏，败走失国，为天下笑。今权在其门，为日久矣。朝廷四方皆为之致死，不顾逆顺之理，非一日也。且宿卫空阙，兵甲寡弱，陛下何所资用？而一旦如此，无乃欲除疾而更深之邪？祸殆不测，宜见重详！’帝乃出怀中版令投地，曰：‘行之决矣！正使死，何所惧？况不必死邪！’于是入白太后。沈、业奔走告文王，文王为之备。帝遂帅僮仆数百，鼓噪而出。文王弟屯骑校尉伷入，遇帝于东止车门，左右呵之，伷众奔走。中护军贾充又逆帝，战于南阙下。帝自用剑，众欲退。太子舍人成济问充曰：‘事急矣。当云何？’充曰：‘畜养汝等，正谓今日！今日之事，无所问也！’济即前刺帝，刃出于背。文王闻，大惊，自投于地曰：‘天下其谓我何！’太傅孚奔往，枕帝股而哭，哀甚。曰：‘杀陛下者，臣之罪也！’”","attribution":"《汉晋春秋》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":72,"anchor":null},"note_id":"n-74646ac2cf964244648d","start":0,"end":409},{"id":"shaodi-q-b-77066dd061eb6a338ffa","section":"chapter-004","block":"b-77066dd061eb6a338ffa","layer":"modern","quote":"〖1〗五年：甘露五年（公元 260 ）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml