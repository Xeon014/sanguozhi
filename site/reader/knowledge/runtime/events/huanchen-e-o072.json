{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"huanchen-e-o072","title":"薛悌异矫结为亲友后承代","accounts":[{"id":"huanchen-a-dd7f701cdac0862108d4","label":"正文","text":"薛悌异矫结为亲友后承代","evidence":["huanchen-q-4ab4ceb021fd502ac56a"]}],"participants":[{"person":"zhangle-p0008","role":"异之结为亲友、后为魏郡及尚书令皆承代矫","evidence":["huanchen-q-4ab4ceb021fd502ac56a"]},{"person":"wendi-p0072","role":"为郡功曹使过泰山；被薛悌异而结友，后为悌所承代","evidence":["huanchen-q-4ab4ceb021fd502ac56a"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["huanchen-q-4ab4ceb021fd502ac56a"]},"ordering_evidence":"huanchen-q-4ab4ceb021fd502ac56a","source_order":[22,366,36],"order":4580}],"persons":[{"id":"wendi-p0072","name":"陈矫","facts":[],"aliases":[]},{"id":"zhangle-p0008","name":"薛悌","facts":[],"aliases":[]}],"evidence":[{"id":"huanchen-q-4ab4ceb021fd502ac56a","section":"chapter-022","block":"b-36911014e2aba4efaef8","layer":"original","quote":"初，矫为郡功曹，使过泰山〖8〗。泰山太守东郡薛悌异之〖9〗，结为亲友〖10〗；戏谓矫曰：“以郡吏而交二千石〖11〗，邻国君屈从陪臣游〖12〗，不亦可乎！”悌后为魏郡及尚书令，皆承代矫云。","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":365,"anchor":null},"note_id":null,"start":28,"end":121}],"profiles":{},"directory_counts":{}}
