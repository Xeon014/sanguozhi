{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"sunshi-e-p018c","title":"孙坚劝周慎断运不纳周慎军败董卓封侯","accounts":[{"id":"sunshi-e-p018c-account","label":"《山阳公载记》","text":"孙坚劝周慎断运不纳周慎军败董卓封侯","evidence":["sunshi-e-p018c-q"]}],"participants":[{"person":"wudi-p0119","role":"献策","evidence":["sunshi-e-p018c-q"]},{"person":"sunshi-p0030","role":"拒策败走","evidence":["sunshi-e-p018c-q"]},{"person":"wudi-p0053","role":"受封","evidence":["sunshi-e-p018c-q"]}],"place":null,"time":{"label":"西征金城时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["sunshi-e-p018c-q"]},"ordering_evidence":"sunshi-e-p018c-q","source_order":[46,163,"P018c"],"order":8054}],"persons":[{"id":"sunshi-p0030","name":"周慎","facts":[],"aliases":[]},{"id":"wudi-p0053","name":"董卓","facts":[],"aliases":[]},{"id":"wudi-p0119","name":"孙坚","facts":[],"aliases":[]}],"evidence":[{"id":"sunshi-e-p018c-q","section":"chapter-046","block":"b-c8fd920a32479644dd63","layer":"pei","quote":"而孙坚随周慎行，谓慎：求将万兵造金城，使慎以二万作后驻；边、韩城中，无宿谷，当于外运；畏慎大兵，不敢轻与坚战，而坚兵足以断其运道。儿曹用〔其言〕，必还羌谷中，凉州或能定也。温既不能用孤；慎又不用坚，自攻金城，坏其外垣。驰使语温，自以克在旦夕；温时亦自以计中也。而渡辽儿果断（蔡园）〔葵园峡〕，慎弃辎重走，果如孤策。台以此封孤都乡侯。坚以佐军司马，所见与人同，自为可耳；〔但无故从诸袁儿，终亦殆尔！","attribution":"《山阳公载记》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":162,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-400db0528d9f41d40f3f","start":225,"end":423,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
