{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wgc-e-4-e4","title":"先登至江由马邈降","order":5675,"accounts":[{"id":"wgc-a-4-e4","label":"正文","text":"先登至江由马邈降","evidence":["wgc-q0381","wgc-q0048"]}],"participants":[{"person":"shaodi-p0080","role":"先登至江由","evidence":["wgc-q0381","wgc-q0048"]},{"person":"wgc-p0032","role":"蜀守将降","evidence":["wgc-q0381","wgc-q0048"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0381","wgc-q0048"]},"ordering_evidence":"wgc-q0381"}],"persons":[{"id":"shaodi-p0080","name":"邓艾","facts":[],"aliases":[]},{"id":"wgc-p0032","name":"马邈","facts":[],"aliases":[]}],"evidence":[{"id":"wgc-q0048","section":"chapter-028","block":"b-24ac76f590c35110890e","layer":"original","quote":"冬十月，艾自阴平道，行无人之地七百余里；凿山通道，造作桥、阁〖16〗；山高谷深，至为艰险；又粮运将匮，濒于危殆。艾以毡自裹，推转而下；将士皆攀木缘崖，鱼贯而进。先登至江由〖17〗，蜀守将马邈降。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":324,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":97,"offset_unit":"unicode_code_point"},{"id":"wgc-q0381","section":"chapter-028","block":"b-24ac76f590c35110890e","layer":"original","quote":"先登至江由〖17〗，蜀守将马邈降","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":324,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":80,"end":96,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
