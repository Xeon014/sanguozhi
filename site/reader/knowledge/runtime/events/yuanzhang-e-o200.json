{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"yuanzhang-e-o200","title":"晋宣帝为布衣时与胡昭有旧，同郡周生等谋害帝；昭步陟险邀生于崤渑之间，泣与结诚，生感义乃止，因与斫枣树共盟而别","accounts":[{"id":"yuanzhang-a-0315675bd6eaf7fc0ce4","label":"裴注·高士传","text":"晋宣帝为布衣时与胡昭有旧，同郡周生等谋害帝；昭步陟险邀生于崤渑之间，泣与结诚，生感义乃止，因与斫枣树共盟而别","evidence":["yuanzhang-q-cecf23ef31c1ff3a67da"]},{"id":"yuanzhang-a-fffb13d820724f95372c","label":"裴注·高士传","text":"胡昭有阴德于晋宣帝，口终不言，人莫知之；信行著于乡党","evidence":["yuanzhang-q-ae596e3b733b71751961"]}],"participants":[{"person":"wudi-p0364","role":"为布衣时与胡昭有旧，同郡周生等谋害之；受胡昭之阴德","evidence":["yuanzhang-q-cecf23ef31c1ff3a67da","yuanzhang-q-ae596e3b733b71751961"]},{"person":"yuanzhang-p0065","role":"闻而步陟险邀周生，泣与结诚，因与斫枣树共盟而别；有阴德于帝而口终不言，信行著于乡党","evidence":["yuanzhang-q-cecf23ef31c1ff3a67da","yuanzhang-q-ae596e3b733b71751961"]},{"person":"yuanzhang-p0015","role":"谋害晋宣帝，感胡昭之义乃止","evidence":["yuanzhang-q-cecf23ef31c1ff3a67da"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["yuanzhang-q-cecf23ef31c1ff3a67da","yuanzhang-q-ae596e3b733b71751961"]},"ordering_evidence":"yuanzhang-q-cecf23ef31c1ff3a67da","source_order":[11,578,11],"order":2684}],"persons":[{"id":"wudi-p0364","name":"司马懿","facts":[],"aliases":[]},{"id":"yuanzhang-p0015","name":"周生","facts":[],"aliases":[]},{"id":"yuanzhang-p0065","name":"胡昭","facts":[],"aliases":[]}],"evidence":[{"id":"yuanzhang-q-ae596e3b733b71751961","section":"chapter-011","block":"b-f52adda04d4dcebae578","layer":"pei","quote":"昭虽有阴德于帝，口终不言，人莫知之。信行著于乡党","attribution":"裴注·高士传","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":577,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a4138397b368dfc7c4ab","start":85,"end":109,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-cecf23ef31c1ff3a67da","section":"chapter-011","block":"b-f52adda04d4dcebae578","layer":"pei","quote":"初，晋宣帝为布衣时，与昭有旧。同郡周生等，谋害帝。昭闻而步陟险，邀生于崤、渑之间；止生，生不肯。昭泣与结诚，生感其义，乃止。昭因与斫枣树，共盟而别","attribution":"裴注·高士传","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":577,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a4138397b368dfc7c4ab","start":11,"end":84,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
