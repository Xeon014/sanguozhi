{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wendi-e-p098a","title":"曹叡将送葬因曹真等谏暑而止","accounts":[{"id":"wendi-e-p098a-account","label":"裴注·魏氏春秋","text":"曹叡将送葬因曹真等谏暑而止","evidence":["wendi-e-p098a-q"]},{"id":"wendi-a-p099-disputes","label":"裴注·孙盛曰","text":"孙盛认为送葬为孝子大痛，批评曹真等以暑热谏止。","evidence":["wendi-q-p099-disputes"]}],"participants":[{"person":"wendi-p0005","role":"欲送葬而止","evidence":["wendi-e-p098a-q"]},{"person":"wendi-p0038","role":"谏","evidence":["wendi-e-p098a-q"]},{"person":"wudi-p0394","role":"谏","evidence":["wendi-e-p098a-q"]},{"person":"wudi-p0309","role":"谏","evidence":["wendi-e-p098a-q"]}],"place":null,"time":{"year":226,"label":"黄初七年六月葬文帝时","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"wendi-y226","dating_review":{"reviewed":true,"anchor":"wendi-q-o054","basis":"黄初七年六月葬文帝时"},"evidence":["wendi-e-p098a-q","wendi-q-o054","wendi-q-o049","wendi-q-b-e28c5cd47fe98ad60171"]},"ordering_evidence":"wendi-e-p098a-q","source_order":[2,502,"P098a"],"order":681}],"persons":[{"id":"wendi-p0005","name":"曹叡","facts":[],"aliases":[]},{"id":"wendi-p0038","name":"曹真","facts":[],"aliases":[]},{"id":"wudi-p0309","name":"王朗","facts":[],"aliases":[]},{"id":"wudi-p0394","name":"陈群","facts":[],"aliases":[]}],"evidence":[{"id":"wendi-e-p098a-q","section":"chapter-002","block":"b-f0bdf111cabe162717cc","layer":"pei","quote":"﹝二﹞《魏氏春秋》曰：“明帝将送葬，曹真、陈群、王朗等以暑热固谏；乃止。”","attribution":"裴注·魏氏春秋","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":501,"anchor":null},"note_id":"n-b4f84d71221f74ec4b16","start":0,"end":37},{"id":"wendi-q-b-e28c5cd47fe98ad60171","section":"chapter-002","block":"b-e28c5cd47fe98ad60171","layer":"modern","quote":"〖1〗六年：黄初六年（公元 225）。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":467,"anchor":null},"note_id":"n-61512c4ade75d71d6a76","start":0,"end":19},{"id":"wendi-q-o049","section":"chapter-002","block":"b-d5847039c2d504d36e8e","layer":"original","quote":"六年春二月〖1〗，遣使者循行许昌以东，尽沛郡〖2〗。问民所疾苦，贫者赈贷之。﹝一﹞三月，行幸召陵〖3〗，通讨虏渠〖4〗。乙巳〖5〗，还许昌宫。并州刺史梁习讨鲜卑轲比能〖6〗，大破之。辛未〖7〗，帝为舟师，东征。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":461,"anchor":null},"note_id":null,"start":0,"end":105},{"id":"wendi-q-o054","section":"chapter-002","block":"b-19250f15bc304637f90e","layer":"original","quote":"七年春正月，将幸许昌。许昌城南门，无故自崩；帝心恶之，遂不入。壬子〖1〗，行还洛阳宫。三月，筑九华台〖2〗。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":487,"anchor":null},"note_id":null,"start":0,"end":54},{"id":"wendi-q-p099-disputes","section":"chapter-002","block":"b-1356a6199dd745789bf6","layer":"pei","quote":"孙盛曰：“夫窀穸之事，孝子之极痛也！人伦之道，于斯莫重。故天子七月而葬，同轨毕至。夫以义感之情，犹尽临隧之哀；况乎天性发中，敦礼者重之哉！魏氏之德，仍世不基矣。昔华元厚葬，君子以为弃君于恶；群等之谏，弃孰甚焉！”","attribution":"裴注·孙盛曰","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":502,"anchor":null},"note_id":"n-b4f84d71221f74ec4b16","start":0,"end":106}],"profiles":{},"directory_counts":{}}
