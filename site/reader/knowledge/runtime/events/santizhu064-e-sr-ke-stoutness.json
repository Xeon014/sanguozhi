{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"santizhu064-e-sr-ke-stoutness","title":"《恪别传》权问恪何以自娱肥泽、何如滕胤","accounts":[{"id":"santizhu064-a-a72cd0873f74649380c0","label":"裴注·恪别传","text":"权问恪何以自娱更肥泽，恪答富润屋德润身臣非自娱乐修己而已；又问何如滕胤，恪答登阶蹑履不如胤、回筹转策胤不如臣","evidence":["santizhu064-q-5549c8ed7ac8acfcab75"]}],"participants":[{"person":"sun-quan","role":"发问者","evidence":["santizhu064-q-5549c8ed7ac8acfcab75"]},{"person":"shaodi-p0041","role":"作答","evidence":["santizhu064-q-5549c8ed7ac8acfcab75"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"未由相邻段落推算纪年；原文时间表达保留在来源引句中。","evidence":["santizhu064-q-5549c8ed7ac8acfcab75"]},"ordering_evidence":"santizhu064-q-5549c8ed7ac8acfcab75","source_order":[64,28,0],"order":10928}],"persons":[{"id":"shaodi-p0041","name":"诸葛恪","facts":[],"aliases":[]},{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]}],"evidence":[{"id":"santizhu064-q-5549c8ed7ac8acfcab75","section":"chapter-064","block":"b-e8c408211dc6ad158d52","layer":"pei","quote":"权尝问恪：‘顷何以自娱，而更肥泽？’恪对曰：‘臣闻富润屋，德润身；臣非敢自娱，修己而已。’又问：‘卿何如滕胤？’恪答曰：‘登阶蹑履，臣不如胤；回筹转策，胤不如臣。’","attribution":"裴注·恪别传","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":27,"anchor":null},"note_id":"n-12b3579a9c9a4da79693","start":137,"end":219}],"profiles":{},"directory_counts":{}}
