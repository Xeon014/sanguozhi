{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"chengguo-e-o220","title":"帝诏尚作威作福济谏追取诏","accounts":[{"id":"chengguo-a-a352bc8f9b0cede93d9b","label":"正文","text":"帝诏尚作威作福济谏追取诏","evidence":["chengguo-q-7e2d6d98218ebc519d8b"]}],"participants":[{"person":"wudi-p0170","role":"诏征南将军夏侯尚卿腹心重将、恩施足死惠爱可怀、作威作福杀人活人、忿然作色而问其故、意解、遣追取前诏","evidence":["chengguo-q-7e2d6d98218ebc519d8b"]},{"person":"mingdi-p0063","role":"征南将军、以诏示济","evidence":["chengguo-q-7e2d6d98218ebc519d8b"]},{"person":"shaodi-p0009","role":"对曰未有他善但见亡国之语耳、夫作威作福书之明诫、天子无戏言古人所慎、惟陛下察之","evidence":["chengguo-q-7e2d6d98218ebc519d8b"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["chengguo-q-7e2d6d98218ebc519d8b"]},"ordering_evidence":"chengguo-q-7e2d6d98218ebc519d8b","source_order":[14,387,19],"order":3146}],"persons":[{"id":"mingdi-p0063","name":"夏侯尚","facts":[],"aliases":[]},{"id":"shaodi-p0009","name":"蒋济","facts":[],"aliases":[]},{"id":"wudi-p0170","name":"曹丕","facts":[],"aliases":[]}],"evidence":[{"id":"chengguo-q-7e2d6d98218ebc519d8b","section":"chapter-014","block":"b-03c419f218ca6d29f185","layer":"original","quote":"时有诏，诏征南将军夏侯尚曰：“卿腹心重将，特当任使。恩施足死，惠爱可怀。作威作福，杀人活人。”尚以示济。济既至，帝问曰：“卿所闻见天下风教何如〖3〗？”济对曰：“未有他善，但见亡国之语耳！”帝忿然作色，而问其故。济具以答，因曰：“夫‘作威作福’，《书》之明诫〖4〗；‘天子无戏言’，古人所慎。惟陛下察之。”于是帝意解，遣追取前诏","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":386,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":19,"end":183,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
