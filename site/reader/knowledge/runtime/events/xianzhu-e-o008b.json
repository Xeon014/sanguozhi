{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-o008b","title":"陶谦增刘备丹杨兵","accounts":[{"id":"xianzhu-e-o008b-account","label":"《先主传》正文","text":"陶谦以丹杨兵四千增援刘备，刘备离田楷而归陶谦。","evidence":["xianzhu-e-o008b-q"]}],"participants":[{"person":"wudi-p0095","role":"增兵","evidence":["xianzhu-e-o008b-q"]},{"person":"liu-bei","role":"转归陶谦","evidence":["xianzhu-e-o008b-q"]}],"place":{"text":"徐州","evidence":["xianzhu-e-o008b-q"]},"time":{"label":"赴援陶谦之后","precision":"relative","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xianzhu-e-o008b-q"],"after":"xianzhu-e-o008a"},"source_order":[32,39,"O008b"],"order":6509},{"id":"xianzhu-e-o008a","title":"刘备田楷屯齐并救陶谦","accounts":[{"id":"xianzhu-e-o008a-account","label":"《先主传》正文","text":"袁绍攻公孙瓒，刘备与田楷东屯齐；曹操攻徐州时，二人应陶谦求救前往。","evidence":["xianzhu-e-o008a-q"]}],"participants":[{"person":"liu-bei","role":"屯齐赴援","evidence":["xianzhu-e-o008a-q"]},{"person":"xianzhu-p0017","role":"赴援","evidence":["xianzhu-e-o008a-q"]},{"person":"wudi-p0095","role":"求援","evidence":["xianzhu-e-o008a-q"]},{"person":"cao-cao","role":"征徐州","evidence":["xianzhu-e-o008a-q"]}],"place":{"text":"齐、徐州","evidence":["xianzhu-e-o008a-q"]},"time":{"label":"曹操征徐州时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xianzhu-e-o008a-q"]},"source_order":[32,39,"O008a"],"order":6508}],"persons":[{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"wudi-p0095","name":"陶谦","facts":[],"aliases":[]}],"evidence":[{"id":"xianzhu-e-o008b-q","section":"chapter-032","block":"b-896d9587cf6b9dcbaff8","layer":"original","quote":"时先主自有兵千余人及幽州乌丸杂胡骑，又略得饥民数千人。既到，谦以丹杨兵四千，益先主〖1〗；先主遂去楷，归谦。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":38,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":43,"end":97,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
