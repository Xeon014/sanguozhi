{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"mingdi-e-p058b","title":"刘放孙资说易辅政者举曹爽并召司马懿","accounts":[{"id":"mingdi-e-p058b-account","label":"裴注·汉晋春秋","text":"刘放孙资说易辅政者举曹爽并召司马懿","evidence":["mingdi-e-p058b-q"]}],"participants":[{"person":"mingdi-p0106","role":"游说","evidence":["mingdi-e-p058b-q"]},{"person":"mingdi-p0075","role":"游说","evidence":["mingdi-e-p058b-q"]},{"person":"wendi-p0005","role":"从议","evidence":["mingdi-e-p058b-q"]}],"place":null,"time":{"year":238,"label":"景初二年十二月甲申","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"mingdi-y238","dating_review":{"reviewed":true,"anchor":"mingdi-q-o059","basis":"景初二年十二月甲申"},"evidence":["mingdi-e-p058b-q","mingdi-q-o059","mingdi-q-b-78ee587f18f11aa30bd9"]},"ordering_evidence":"mingdi-e-p058b-q","source_order":[3,490,"P058b"],"order":967}],"persons":[{"id":"mingdi-p0075","name":"孙资","facts":[],"aliases":[]},{"id":"mingdi-p0106","name":"刘放","facts":[],"aliases":[]},{"id":"wendi-p0005","name":"曹叡","facts":[],"aliases":[]}],"evidence":[{"id":"mingdi-e-p058b-q","section":"chapter-003","block":"b-479566b169dbc75ea2fe","layer":"pei","quote":"中书监刘放、令孙资，久专权宠，为朗等素所不善，惧有后害，阴图间之；而宇常在帝侧，故未得有言。甲申，帝气微，宇下殿呼曹肇有所议，未还。而帝少间，惟曹爽独在。放知之，呼资与谋。资曰：‘不可动也！’放曰：‘俱入鼎镬，何不可之有？’乃突前见帝，垂泣曰：‘陛下气微，若有不讳，将以天下付谁？’帝曰：‘卿不闻用燕王耶？’放曰：‘陛下忘先帝诏敕：藩王不得辅政。且陛下方病，而曹肇、秦朗等便与才人侍疾者言戏；燕王拥兵南面，不听臣等入：此即竖刁、赵高也。今皇太子幼弱，未能统政；外有强暴之寇，内有劳怨之民。陛下不远虑存亡，而近系恩旧；委祖宗之业，付二三凡士；寝疾数日，外内壅隔；社稷危殆，而己不知：此臣等所以痛心也。’帝得放言，大怒曰：‘谁可任者？’放、资乃举爽代宇，又白‘宜诏司马宣王使相参’，帝从之。","attribution":"裴注·汉晋春秋","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":489,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-3df5334abffeb752155c","start":58,"end":401,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-b-78ee587f18f11aa30bd9","section":"chapter-003","block":"b-78ee587f18f11aa30bd9","layer":"modern","quote":"〖1〗二年：景初二年（公元 238 ）。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":438,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-917b5dc4aecce5a0dcf4","start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-o059","section":"chapter-003","block":"b-5790b2efe14805978c50","layer":"original","quote":"二年春正月〖1〗，诏太尉司马宣王。率众讨辽东。﹝一﹞","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":434,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":26,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
