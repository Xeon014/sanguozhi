{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p003d","title":"种暠奏劾曹腾未获准","accounts":[{"id":"wudi-e-p003d-account","label":"《续汉书》","text":"种暠据蜀郡太守寄给曹腾的书笺奏劾，皇帝认为曹腾没有回信而不予治罪；曹腾仍称赞种暠。","evidence":["wudi-e-p003d-q"]}],"participants":[{"person":"wudi-p0024","role":"奏劾","evidence":["wudi-e-p003d-q"]},{"person":"wudi-p0002","role":"被奏劾并称赞种暠","evidence":["wudi-e-p003d-q"]}],"place":{"text":"函谷关","evidence":["wudi-e-p003d-q"]},"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p003d-q"]},"source_order":[1,15,"P003d"],"order":6}],"persons":[{"id":"wudi-p0002","name":"曹腾","facts":[],"aliases":[]},{"id":"wudi-p0024","name":"种暠","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-p003d-q","section":"chapter-001","block":"b-5e6a7e419a7747bd1cda","layer":"pei","quote":"蜀郡太守因计吏修敬于腾，益州刺史种暠于函谷关搜得其笺，上太守，并奏腾内臣外交，所不当为，请免官治罪。帝曰：‘笺自外来，腾书不出，非其罪也。’乃寝暠奏。腾不以介意，常称叹暠，以为暠得事上之节。暠后为司徒，语人曰：‘今日为公，乃曹常侍恩也。’腾之行事，皆此类也。","attribution":"《续汉书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":14,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-2c3453013ec854037801","start":265,"end":394,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
