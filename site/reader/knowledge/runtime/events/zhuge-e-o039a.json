{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhuge-e-o039a","title":"诸葛亮流马运出五丈原与司马懿渭南相持屯田","accounts":[{"id":"zhuge-e-o039a-account","label":"《诸葛亮传第五》正文","text":"诸葛亮流马运出五丈原与司马懿渭南相持屯田","evidence":["zhuge-e-o039a-q"]},{"id":"houzhu-a-758e8a7c64aa","label":"《后主传》正文","text":"十二年春二月，亮由斜谷出，始以流马运。","evidence":["houzhu-q-O027"]},{"id":"dengzhang-a-af4fe8b3f599a300a526","label":"正文","text":"亮以张翼为前军都督","evidence":["dengzhang-q-34d0270166fbcc4bcda4"]}],"participants":[{"person":"zhuge-liang","role":"出军屯田","evidence":["zhuge-e-o039a-q"]},{"person":"wudi-p0364","role":"相持","evidence":["zhuge-e-o039a-q"]},{"person":"guanzhang-p0045","role":"受任前军都督，领扶风太守","evidence":["dengzhang-q-34d0270166fbcc4bcda4"]}],"place":null,"time":{"year":234,"label":"建兴十二年春以后","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"zhuge-y234","dating_review":{"reviewed":true,"anchor":"zhuge-q-o039","basis":"建兴十二年春以后"},"evidence":["zhuge-e-o039a-q","zhuge-q-o039","zhuge-q-b-934abed655148ea08df3"]},"ordering_evidence":"zhuge-e-o039a-q","source_order":[35,259,"O039a"],"order":6800}],"persons":[{"id":"guanzhang-p0045","name":"张翼","facts":[],"aliases":[]},{"id":"wudi-p0364","name":"司马懿","facts":[],"aliases":[]},{"id":"zhuge-liang","name":"诸葛亮","facts":[],"aliases":[]}],"evidence":[{"id":"dengzhang-q-34d0270166fbcc4bcda4","section":"chapter-045","block":"b-85188dfac171b2dc23b0","layer":"original","quote":"亮出武功，以翼为前军都督，领扶风太守","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":45,"anchor":null},"note_id":null,"start":0,"end":18},{"id":"houzhu-q-O027","section":"chapter-033","block":"b-e55d800452827d4e9527","layer":"original","quote":"十二年春二月，亮由斜谷出，始以流马运。","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":59,"anchor":null},"note_id":null,"start":0,"end":19},{"id":"zhuge-e-o039a-q","section":"chapter-035","block":"b-e60db7c722cd4fe4fb69","layer":"original","quote":"十二年春〖2〗，亮悉大众由斜谷出，以流马运；据武功五丈原〖3〗，与司马宣王对于渭南〖4〗。亮每患粮不继，使己志不申；是以分兵屯田，为久驻之基。耕者杂于渭滨居民之间，而百姓安堵〖5〗，军无私焉〖6〗。﹝三﹞相持百余日。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":258,"anchor":null},"note_id":null,"start":0,"end":108},{"id":"zhuge-q-b-934abed655148ea08df3","section":"chapter-035","block":"b-934abed655148ea08df3","layer":"modern","quote":"〖2〗十二年：建兴十二年（公元 234）。以上诸葛亮出兵北伐共计五次，经由祁山只有两次。后世所说的“六出祁山”并非历史真实。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":269,"anchor":null},"note_id":"n-1e22705f935572994567","start":0,"end":62},{"id":"zhuge-q-o039","section":"chapter-035","block":"b-e60db7c722cd4fe4fb69","layer":"original","quote":"十二年春〖2〗，亮悉大众由斜谷出，以流马运；据武功五丈原〖3〗，与司马宣王对于渭南〖4〗。亮每患粮不继，使己志不申；是以分兵屯田，为久驻之基。耕者杂于渭滨居民之间，而百姓安堵〖5〗，军无私焉〖6〗。﹝三﹞相持百余日。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":258,"anchor":null},"note_id":null,"start":0,"end":108}],"profiles":{},"directory_counts":{}}
