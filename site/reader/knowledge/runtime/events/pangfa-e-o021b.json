{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"pangfa-e-o021b","title":"诸葛亮答抑法正之议","accounts":[{"id":"pangfa-e-o021b-account","label":"《庞统法正传第七》正文","text":"诸葛亮答抑法正之议","evidence":["pangfa-e-o021b-q"]},{"id":"pangfa-a-p013-judgment","label":"孙盛论","text":"孙盛批评诸葛亮以功臣为由纵法正，援颠颉杨干为例。","evidence":["pangfa-q-p013-judgment"]}],"participants":[{"person":"zhuge-liang","role":"答议","evidence":["pangfa-e-o021b-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["pangfa-e-o021b-q"]},"ordering_evidence":"pangfa-e-o021b-q","source_order":[37,147,"O021b"],"order":6995}],"persons":[{"id":"zhuge-liang","name":"诸葛亮","facts":[],"aliases":[]}],"evidence":[{"id":"pangfa-e-o021b-q","section":"chapter-037","block":"b-f386822659cca9c963b7","layer":"original","quote":"或谓诸葛亮曰〖11〗：“法正于蜀郡太纵横〖12〗；将军宜启主公，抑其威福〖13〗。”亮答曰：“主公之在公安也，北畏曹公之强，东惮孙权之逼，近则惧孙夫人生变于肘腋之下〖14〗：当斯之时，进退狼跋〖15〗。法孝直为之辅翼，令翻然翱翔〖16〗，不可复制。如何禁止法正〖17〗，使不得行其意邪！”","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":146,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":57,"end":201,"offset_unit":"unicode_code_point"},{"id":"pangfa-q-p013-judgment","section":"chapter-037","block":"b-b1b888007831717e3087","layer":"pei","quote":"﹝二﹞孙盛曰：“夫威福自下，亡家害国之道；刑纵于宠，毁政乱理之源。安可以功臣而极其陵肆，嬖幸而藉其国柄者哉？故颠颉虽勤，不免违命之刑；杨干虽亲，犹加乱行之戮。夫岂不爱？王宪故也。诸葛氏之言，于是乎失政刑矣。”","attribution":"孙盛论","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":189,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-368fe212c90f9644b63a","start":0,"end":104,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
