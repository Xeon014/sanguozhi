{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"huang-fire","title":"黄盖诈降与火攻","order":9598,"accounts":[{"id":"huang-fire-account-1","label":"记载","text":"《周瑜传》记黄盖提出火攻、先书诈降，再放船发火，火势延及岸上营落。","evidence":["huang-plan","huang-feint","huang-fire"]},{"id":"huang-fire-account-2","label":"记载","text":"裴注引《江表传》补叙东南风、火船逼近及延烧岸营。","evidence":["fire-jiangbiao"]},{"id":"zhouyu-a-p012-cao-claim","label":"《江表传》","text":"江表传引曹操书孙权称赤壁值病、自烧船退，与本篇黄盖火攻叙事分列。","evidence":["zhouyu-q-p012-cao-claim"]},{"id":"chenghuang-a-956e65a9b581e5e32300","label":"正文","text":"盖随周瑜拒曹公于赤壁建策火攻","evidence":["chenghuang-q-112b25280beb3b55ffc1"]}],"participants":[{"person":"huang-gai","role":"提出并实施火攻","evidence":["huang-plan","huang-fire"]},{"person":"cao-cao","role":"诈降书与火攻所向","evidence":["huang-feint","huang-plan"]},{"person":"zhou-yu","role":"黄盖所属主将","evidence":["huang-plan"]}],"place":{"text":"赤壁交战水域及岸上营落","evidence":["allied-zhou","huang-fire"]},"time":{"label":"建安十三年（208）","year":208,"precision":"year","basis":"年次承接本篇建安十三年记事，现代注释释为公元 208 年；此条未记具体月日。","evidence":["year-original","year-modern","zhou-year","zhou-year-modern","allied-zhou","huang-fire"]}}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"huang-gai","name":"黄盖","facts":[],"aliases":[]},{"id":"zhou-yu","name":"周瑜","facts":[],"aliases":[]}],"evidence":[{"id":"allied-zhou","section":"chapter-054","block":"b-df9e8a2d1c2855c608f2","quote":"权遂遣瑜及程普等，与备并力逆曹公，遇于赤壁。","layer":"original","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":62,"anchor":null},"note_id":null,"start":41,"end":63},{"id":"chenghuang-q-112b25280beb3b55ffc1","section":"chapter-055","block":"b-a556c357dc51a16db882","layer":"original","quote":"建安中，随周瑜拒曹公于赤壁：建策火攻，语在《瑜传》","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":24,"anchor":null},"note_id":null,"start":0,"end":25},{"id":"fire-jiangbiao","section":"chapter-054","block":"b-046b11c4d33d588538b8","quote":"时东南风急，因以十舰最著前，中江举帆。盖举火白诸校，使众兵齐声大叫曰：‘降焉！’操军人皆出营立观。去北军二里余，同时发火；火烈风猛，往船如箭；飞埃绝烂，烧尽北船，延及岸边营（柴）〔栅〕。","layer":"pei","attribution":"《江表传》","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":86,"anchor":null},"note_id":"n-90216583c8655708d70e","start":53,"end":146},{"id":"huang-feint","section":"chapter-054","block":"b-8be6669092a37ba75e2e","quote":"先书报曹公，欺以欲降。","layer":"original","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":64,"anchor":null},"note_id":null,"start":76,"end":87},{"id":"huang-fire","section":"chapter-054","block":"b-8be6669092a37ba75e2e","quote":"盖放诸船，同时发火。时风盛〔火〕猛，悉延烧岸上营落。","layer":"original","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":64,"anchor":null},"note_id":null,"start":132,"end":158},{"id":"huang-plan","section":"chapter-054","block":"b-8be6669092a37ba75e2e","quote":"瑜部将黄盖曰：“今寇众我寡，难与持久。然观操军船舰，首尾相接：可烧而走也。”","layer":"original","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":64,"anchor":null},"note_id":null,"start":0,"end":38},{"id":"year-modern","section":"chapter-001","block":"b-888495d8be7766faf20c","quote":"十三年：建安十三年（公元 208）。","layer":"modern","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":666,"anchor":null},"note_id":"n-0bae348fdb687025113d","start":3,"end":21},{"id":"year-original","section":"chapter-001","block":"b-4bcffcc4ee709a4e5ea3","quote":"十三年春正月〖1〗，公还邺。","layer":"original","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":661,"anchor":null},"note_id":null,"start":0,"end":14},{"id":"zhou-year","section":"chapter-054","block":"b-3661896c106f1817bf4b","quote":"十三年春〖6〗，权讨江夏，瑜为前部大督〖7〗。其年九月，曹公入荆州，刘琮举众降。","layer":"original","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":34,"anchor":null},"note_id":null,"start":0,"end":40},{"id":"zhou-year-modern","section":"chapter-054","block":"b-63f47c62fde80b3a0132","quote":"十三年：建安十三年（公元 208）。","layer":"modern","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":43,"anchor":null},"note_id":"n-8f109f42647e5ee8d831","start":3,"end":21},{"id":"zhouyu-q-p012-cao-claim","section":"chapter-054","block":"b-2214c5c24f10e6532e39","layer":"pei","quote":"后书与权曰：‘赤壁之役，值有疾病；孤烧船自退，横使周瑜虚获此名！","attribution":"《江表传》","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":119,"anchor":null},"note_id":"n-f170ddcf31cbbfb5f027","start":545,"end":577}],"profiles":{},"directory_counts":{}}
