{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"hechang-e-c161af2e844a71148983","title":"杜根郎中直谏邓后被扑佯死逃宜城十五年","accounts":[{"id":"hechang-a-c161af2e844a71148983","label":"裴注·先贤行状","text":"杜根郎中直谏邓后被扑佯死逃宜城十五年","evidence":["hechang-q-06a730904ce4c621580c"]}],"participants":[{"person":"hechang-p-679b5fa5e2ad31","role":"任官直谏被扑逃难","evidence":["hechang-q-06a730904ce4c621580c"]},{"person":"wudi-p0016","role":"命扑诛","evidence":["hechang-q-06a730904ce4c621580c"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["hechang-q-06a730904ce4c621580c"]},"ordering_evidence":"hechang-q-06a730904ce4c621580c","order":4751}],"persons":[{"id":"hechang-p-679b5fa5e2ad31","name":"杜根","facts":[],"aliases":[]},{"id":"wudi-p0016","name":"邓太后","facts":[],"aliases":[]}],"evidence":[{"id":"hechang-q-06a730904ce4c621580c","section":"chapter-023","block":"b-2b9f13516e39cc1ccab5","layer":"pei","quote":"根举孝廉，除郎中。时和熹邓后临朝，外戚横恣；安帝长大，犹未归政。根乃与同时郎，上书直谏；邓后怒，收根等伏诛。诛者皆绢囊盛，于殿上扑地。执法者以根德重事公，默语行事人，使不加力。诛讫，车载城外；根以扑轻，得苏息，遂闭目不动摇。经三日，乃密起逃窜，为宜城山中酒家客，积十五年。","attribution":"裴注·先贤行状","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":198,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5f96384ee27ad7b7aab1","start":260,"end":396,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
