{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"luxun-e-o013a","title":"陆议领宜都拜抚边将军封华亭侯","accounts":[{"id":"luxun-e-o013a-account","label":"《陆逊传第十三》正文","text":"陆议领宜都拜抚边将军封华亭侯","evidence":["luxun-e-o013a-q"]}],"participants":[{"person":"xianzhu-p0115","role":"受任封爵","evidence":["luxun-e-o013a-q"]}],"place":null,"time":{"year":219,"label":"建安二十四年十一月","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"luxun-y219","dating_review":{"reviewed":true,"anchor":"luxun-q-o013","basis":"建安二十四年十一月"},"evidence":["luxun-e-o013a-q","luxun-q-o013","pangfa-q-o024","pangfa-q-b-2bde1ec2bffff2934f01"]},"ordering_evidence":"luxun-e-o013a-q","source_order":[58,41,"O013a"],"order":10303}],"persons":[{"id":"xianzhu-p0115","name":"陆逊","facts":[],"aliases":[]}],"evidence":[{"id":"luxun-e-o013a-q","section":"chapter-058","block":"b-78a7bdbb35a431936825","layer":"original","quote":"逊径进，领宜都太守〖32〗，拜抚边将军〖33〗，封华亭侯。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":40,"anchor":null},"note_id":null,"start":0,"end":29},{"id":"luxun-q-o013","section":"chapter-058","block":"b-78a7bdbb35a431936825","layer":"original","quote":"逊径进，领宜都太守〖32〗，拜抚边将军〖33〗，封华亭侯。备宜都太守樊友委郡走，诸城长吏及蛮夷君长皆降。逊请金、银、铜印〖34〗，以假授初附。是岁建安二十四年，十一月也。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":40,"anchor":null},"note_id":null,"start":0,"end":85},{"id":"pangfa-q-b-2bde1ec2bffff2934f01","section":"chapter-037","block":"b-2bde1ec2bffff2934f01","layer":"modern","quote":"〖27〗二十四年：建安二十四年（公元 219）。","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":180,"anchor":null},"note_id":"n-b2b8a5dc69bfaa995101","start":0,"end":24},{"id":"pangfa-q-o024","section":"chapter-037","block":"b-b3d109bb3fe355546163","layer":"original","quote":"二十四年〖27〗，先主自阳平南渡沔水，缘山稍前〖28〗，于定军（兴势）〔山〕作营。渊将兵来争其地。正曰：“可击矣！”先主命黄忠乘高鼓噪攻之，大破渊军，渊等授首〖29〗。曹公西征，闻正之策，曰：“吾故知玄德不辨有此〖30〗，必为人所教也。”﹝三﹞","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":149,"anchor":null},"note_id":null,"start":0,"end":122}],"profiles":{},"directory_counts":{}}
