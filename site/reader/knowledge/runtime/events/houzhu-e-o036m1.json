{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"houzhu-e-o036m1","title":"刘禅立刘璿为太子","accounts":[{"id":"houzhu-a-d99175cbc741","label":"《后主传》正文","text":"刘禅立刘璿为太子","evidence":["houzhu-q-O036"]},{"id":"erfei-a-702370a3591ceca9092d","label":"正文","text":"刘禅立刘璿为皇太子","evidence":["erfei-q-be066eabde783ade7a19","erfei-q2-478bae2e56304e34573c"]}],"participants":[{"person":"xianzhu-p0112","role":"册立者","evidence":["houzhu-q-O036"]},{"person":"houzhu-p0026","role":"被册立者","evidence":["houzhu-q-O036"]},{"person":"liuliao-p0019","role":"以行丞相事、左将军持节授太子印绶","evidence":["erfei-q-be066eabde783ade7a19"]}],"place":null,"time":{"label":"延熙元年春正月","precision":"undated","basis":"保留本段原始时间表达；没有直接绑定的公元年证据，未补公元年。","evidence":["houzhu-q-O036"]},"ordering_evidence":"houzhu-q-O036","source_order":[33,36,"O036m1"],"order":6651}],"persons":[{"id":"houzhu-p0026","name":"刘璿","facts":[],"aliases":[]},{"id":"liuliao-p0019","name":"向朗","facts":[],"aliases":[]},{"id":"xianzhu-p0112","name":"刘禅","facts":[],"aliases":[]}],"evidence":[{"id":"erfei-q-be066eabde783ade7a19","section":"chapter-034","block":"b-7da40348af4a58b0e891","layer":"original","quote":"延熙元年正月策曰","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":92,"anchor":null},"note_id":null,"start":25,"end":33},{"id":"erfei-q2-478bae2e56304e34573c","section":"chapter-034","block":"b-7da40348af4a58b0e891","layer":"original","quote":"后主太子璿，字文衡。母王贵人，本敬哀张皇后侍人也。延熙元年正月策曰：“在昔帝王，继体立嗣〖1〗；副贰国统，古今常道。今以璿为皇太子，昭显祖宗之威。命使行丞相事、左将军朗，持节，授印绶。其勉修茂质，祗恪道义；咨询典礼，敬友师傅；斟酌众善，翼成尔德〖2〗。可不务修以自勖哉〖3〗！”时年十五。","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":92,"anchor":null},"note_id":null,"start":0,"end":144},{"id":"houzhu-q-O036","section":"chapter-033","block":"b-106d75ef6065149f87ea","layer":"original","quote":"延熙元年春正月〖1〗，立皇后张氏〖2〗。大赦，改元。立子璿为太子〖3〗，子瑶为安定王。","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":94,"anchor":null},"note_id":null,"start":0,"end":43}],"profiles":{},"directory_counts":{}}
