{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wgc-e-add062","title":"向雄收葬钟会","order":5830,"accounts":[{"id":"wgc-a-add062","label":"汉晋春秋；习凿齿论","text":"向雄收葬钟会","evidence":["wgc-q0705","wgc-q0138"]}],"participants":[{"person":"xiahoucao-p0126","role":"收葬","evidence":["wgc-q0705","wgc-q0138"]},{"person":"shaodi-p0073","role":"被收葬","evidence":["wgc-q0705","wgc-q0138"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0705","wgc-q0138"]},"ordering_evidence":"wgc-q0705"}],"persons":[{"id":"shaodi-p0073","name":"钟会","facts":[],"aliases":[]},{"id":"xiahoucao-p0126","name":"向雄","facts":[],"aliases":[]}],"evidence":[{"id":"wgc-q0138","section":"chapter-028","block":"b-2734da889060ff3b807a","layer":"pei","quote":"《汉晋春秋》曰：“文王闻钟会功曹向雄之收葬会也，召而责之曰：‘往者王经之死，卿哭于东市而我不问，今钟会躬为叛逆而又辄收葬；若复相容，其如王法何！’雄曰：‘昔先王掩骼埋胔，仁流朽骨，当时岂先卜其功罪而后收葬哉？今王诛既加，于法已备；雄感义收葬，教亦无阙。法立于上，教弘于下；以此训物，雄曰可矣，何必使雄背死违生，以立于时？殿下仇对枯骨，捐之中野，百岁之后，为臧获所笑，岂仁贤所掩哉？’王悦，与宴谈而遣之。”习凿齿曰：“向伯茂，可谓勇于蹈义也！哭王经而哀感市人，葬钟会而义动明主；彼皆忠烈奋劲，知死而往，非存生也。况使经、会处世，或身在急难，而有不赴者乎？故寻其奉死之心，可以见事生之情；览其忠贞之节，足以愧背义之士矣。王加礼而遣，可谓明达。”","attribution":"汉晋春秋；习凿齿论","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":620,"anchor":null},"note_id":"n-b8c46d3147cdc6a86a2c","start":0,"end":320},{"id":"wgc-q0705","section":"chapter-028","block":"b-2734da889060ff3b807a","layer":"pei","quote":"文王闻钟会功曹向雄之收葬会也，","attribution":"汉晋春秋；习凿齿论","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":620,"anchor":null},"note_id":"n-b8c46d3147cdc6a86a2c","start":9,"end":24}],"profiles":{},"directory_counts":{}}
