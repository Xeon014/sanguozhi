{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"huanchen-e-o046","title":"矫说太祖赴救登追破吴军","accounts":[{"id":"huanchen-a-eab376a2a29891da7342","label":"正文","text":"矫说太祖赴救登追破吴军","evidence":["huanchen-q-afb24b404f540de414be"]}],"participants":[{"person":"wendi-p0072","role":"说太祖鄙郡虽小形便之国也、若蒙救援使为外藩则吴人挫谋徐方永安、崇德养威此王业也、辞曰本国倒悬本奔走告急、纵无申胥之效敢忘弘演之义","evidence":["huanchen-q-afb24b404f540de414be"]},{"person":"cao-cao","role":"奇矫欲留之、乃遣赴救","evidence":["huanchen-q-afb24b404f540de414be"]},{"person":"xianzhu-p0022","role":"吴军既退后多设间伏勒兵追奔大破之","evidence":["huanchen-q-afb24b404f540de414be"]},{"person":"wudi-p0099","role":"吴军被破","evidence":["huanchen-q-afb24b404f540de414be"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["huanchen-q-afb24b404f540de414be"]},"ordering_evidence":"huanchen-q-afb24b404f540de414be","source_order":[22,313,28],"order":4565}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wendi-p0072","name":"陈矫","facts":[],"aliases":[]},{"id":"wudi-p0099","name":"孙策","facts":[],"aliases":[]},{"id":"xianzhu-p0022","name":"陈登","facts":[],"aliases":[]}],"evidence":[{"id":"huanchen-q-afb24b404f540de414be","section":"chapter-022","block":"b-0e6921918b168369595c","layer":"original","quote":"矫说太祖曰：“鄙郡虽小，形便之国也〖16〗。若蒙救援，使为外藩；则吴人挫谋，徐方永安〖17〗；武声远震，仁爱滂流；未从之国，望风影附。崇德养威，此王业也。”太祖奇矫，欲留之。矫辞曰：“本国倒悬，本奔走告急；纵无申胥之效〖18〗，敢忘弘演之义乎？”﹝一﹞太祖乃遣赴救。吴军既退，登多设间伏，勒兵追奔，大破之","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":312,"anchor":null},"note_id":null,"start":28,"end":180}],"profiles":{},"directory_counts":{}}
