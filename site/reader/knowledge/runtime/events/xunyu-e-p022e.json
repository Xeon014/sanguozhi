{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xunyu-e-p022e","title":"曹操论二荀荐士钟繇论荀彧德行","accounts":[{"id":"xunyu-e-p022e-account","label":"《彧别传》","text":"曹操论二荀荐士钟繇论荀彧德行","evidence":["xunyu-e-p022e-q"]}],"participants":[{"person":"cao-cao","role":"评论","evidence":["xunyu-e-p022e-q"]},{"person":"wudi-p0181","role":"评论","evidence":["xunyu-e-p022e-q"]}],"place":null,"time":{"label":"荀彧在世及身后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xunyu-e-p022e-q"]},"ordering_evidence":"xunyu-e-p022e-q","source_order":[10,169,"P022e"],"order":2450}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0181","name":"钟繇","facts":[],"aliases":[]}],"evidence":[{"id":"xunyu-e-p022e-q","section":"chapter-010","block":"b-5c49047dd8a20acd24fb","layer":"pei","quote":"荀攸后为魏尚书令，亦推贤进士。太祖曰：‘二荀令之论人，久而益信。吾没世不忘。’钟繇以为：‘颜子既没；能备九德，不贰其过，唯荀彧然。’或问繇曰：‘君雅重荀君，比之颜子，自以不及；可得闻乎？’曰：‘夫明君师臣，其次友之。以太祖之聪明，每有大事，常先咨之荀君，是则古师友之义也。吾等受命而行，犹或不尽，相去顾不远邪！","attribution":"《彧别传》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":168,"anchor":null},"note_id":"n-e9f2abc222316e1535f8","start":556,"end":711}],"profiles":{},"directory_counts":{}}
