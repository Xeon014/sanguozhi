{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wangwei-e-b80e2dd54d5f5ce792df","title":"陈寿评王粲、卫觊、刘劭、刘廙及傅嘏","accounts":[{"id":"wangwei-a-b80e2dd54d5f5ce792df","label":"正文","text":"陈寿评王粲、卫觊、刘劭、刘廙及傅嘏","evidence":["wangwei-q-3148be3cf15e29868f33"]}],"participants":[],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["wangwei-q-3148be3cf15e29868f33"]},"ordering_evidence":"wangwei-q-3148be3cf15e29868f33","order":4477}],"persons":[],"evidence":[{"id":"wangwei-q-3148be3cf15e29868f33","section":"chapter-021","block":"b-c5a68c8975d950778174","layer":"original","quote":"评曰：昔文帝、陈王以公子之尊〖1〗，博好文采；同声相应，才士并出，惟粲等六人最见名目〖2〗。而粲特处常伯之官〖3〗，兴一代之制；然其冲虚德宇〖4〗，未若徐幹之粹也。卫觊亦以多识典故，相时王之式〖5〗。刘劭该览学籍，文质周洽。刘廙以清鉴著〖6〗，傅嘏用才达显云〖7〗。﹝一﹞","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":558,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":136,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
