{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"hechang-e-0496ccec1b32cb34f03f","title":"杜安十三入太学知名藏贵戚书避牵连","accounts":[{"id":"hechang-a-0496ccec1b32cb34f03f","label":"裴注·先贤行状","text":"杜安十三入太学知名藏贵戚书避牵连","evidence":["hechang-q-2995fd81955af488a444"]}],"participants":[{"person":"hechang-p-105fcdba20b4f8","role":"就学藏书","evidence":["hechang-q-2995fd81955af488a444"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["hechang-q-2995fd81955af488a444"]},"ordering_evidence":"hechang-q-2995fd81955af488a444","order":4747}],"persons":[{"id":"hechang-p-105fcdba20b4f8","name":"杜安","facts":[],"aliases":[]}],"evidence":[{"id":"hechang-q-2995fd81955af488a444","section":"chapter-023","block":"b-2b9f13516e39cc1ccab5","layer":"pei","quote":"《先贤行状》曰：“安年十岁，名称乡党。至十三，入太学，号曰‘神童’。既名知人，清高绝俗。洛阳令周纡，数候安，安常逃避不见。时贵戚慕安高行，多有与书者，辄不发；以虑后患，常凿壁藏书。后诸与书者，果有大罪，推捕所与交通者。吏至门，安乃发壁出书，印封如故，当时皆嘉其虑远。","attribution":"裴注·先贤行状","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":198,"anchor":null},"note_id":"n-5f96384ee27ad7b7aab1","start":3,"end":136}],"profiles":{},"directory_counts":{}}
