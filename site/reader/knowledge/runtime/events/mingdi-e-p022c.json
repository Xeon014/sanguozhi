{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"mingdi-e-p022c","title":"曹叡赏赐秦朗起宅四方馈遗","accounts":[{"id":"mingdi-e-p022c-account","label":"裴注·魏略","text":"曹叡赏赐秦朗起宅四方馈遗","evidence":["mingdi-e-p022c-q"]},{"id":"mingdi-a-p025-disputes","label":"裴注·鱼豢曰","text":"鱼豢批评无德无功而获荣禄的佞幸，认为使中正日损、倾邪滋多。","evidence":["mingdi-q-p025-disputes"]}],"participants":[{"person":"wendi-p0005","role":"宠赐","evidence":["mingdi-e-p022c-q"]},{"person":"mingdi-p0031","role":"受宠受馈","evidence":["mingdi-e-p022c-q"]}],"place":null,"time":{"label":"曹叡在位时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["mingdi-e-p022c-q"]},"ordering_evidence":"mingdi-e-p022c-q","source_order":[3,243,"P022c"],"order":836}],"persons":[{"id":"mingdi-p0031","name":"秦朗","facts":[],"aliases":[]},{"id":"wendi-p0005","name":"曹叡","facts":[],"aliases":[]}],"evidence":[{"id":"mingdi-e-p022c-q","section":"chapter-003","block":"b-75e72fb739f1c4a56dea","layer":"pei","quote":"帝亦以是亲爱，每顾问之，多呼其小字‘阿稣’；数加赏赐，为起大第于京城中。四方虽知朗无能为益，犹以附近至尊，多赂遗之，富均公侯。","attribution":"裴注·魏略","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":242,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9ebeadb65240878258aa","start":92,"end":155,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-p025-disputes","section":"chapter-003","block":"b-37447dd432015f9ac917","layer":"pei","quote":"鱼豢曰：“为上者不虚授，处下者不虚受。然后外无‘伐檀’之叹，内无尸素之刺；雍熙之美著，太平之律显矣。而佞幸之徒，但姑息人主；至乃无德而荣，无功而禄。如是焉得不使中正日朘，倾邪滋多乎！以武皇帝之慎赏，明皇帝之持法，而犹有若此等人，而况下斯者乎？”","attribution":"裴注·鱼豢曰","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":245,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9ebeadb65240878258aa","start":0,"end":122,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
