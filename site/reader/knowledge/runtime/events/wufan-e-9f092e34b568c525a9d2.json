{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wufan-e-9f092e34b568c525a9d2","title":"黄武五年吴范病卒","accounts":[{"id":"wufan-a-8b7d84562440d67b001f","label":"正文","text":"黄武五年吴范病卒","evidence":["wufan-q-45d99d4594e620efd0aa"]},{"id":"wufan-a-c912df9524639d38ef24","label":"裴注·吴录","text":"至其日，吴范果卒","evidence":["wufan-q-7b273c4263f3aa857f9c"]}],"participants":[{"person":"wufan-p-8e104caf2e8d33","role":"病卒者；至其日果卒者","evidence":["wufan-q-45d99d4594e620efd0aa","wufan-q-7b273c4263f3aa857f9c"]}],"place":null,"time":{"label":"黄武五年","precision":"undated","basis":"本条原文明确时间表达；未归一公元年，不由预言内容、年龄或邻段推算。","evidence":["wufan-q-45d99d4594e620efd0aa","wufan-q-7b273c4263f3aa857f9c"]},"ordering_evidence":"wufan-q-45d99d4594e620efd0aa","order":10872}],"persons":[{"id":"wufan-p-8e104caf2e8d33","name":"吴范（术数家）","facts":[],"aliases":[]}],"evidence":[{"id":"wufan-q-45d99d4594e620efd0aa","section":"chapter-063","block":"b-72117c9d0f78574995ae","layer":"original","quote":"黄武五年，范病卒。长子先死，少子尚幼：于是业绝。","section_title":"吴范刘惇赵达传第十八","source":{"file":"OEBPS/Text/titlepage_0133.xhtml","index":30,"anchor":null},"note_id":null,"start":0,"end":24},{"id":"wufan-q-7b273c4263f3aa857f9c","section":"chapter-063","block":"b-fd7981443a3a373270e1","layer":"pei","quote":"﹝三﹞《吴录》曰：“范先知其死日，谓权曰：‘陛下某日，当丧军师。’权曰：‘吾无军师，焉得丧之？’范曰：‘陛下出军临敌，须臣言而后行；臣乃陛下之军师也！’至其日，果卒。”臣松之按：范死时，权未称帝；此云“陛下”，非也。","attribution":"《吴录》","section_title":"吴范刘惇赵达传第十八","source":{"file":"OEBPS/Text/titlepage_0133.xhtml","index":52,"anchor":null},"note_id":"n-321bec019a72e74d3518","start":0,"end":108}],"profiles":{},"directory_counts":{}}
