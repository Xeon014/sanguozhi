{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-p036b","title":"张松一省暗诵曹操兵书","accounts":[{"id":"xianzhu-e-p036b-account","label":"《益部耆旧杂记》","text":"杨修以曹操兵书示张松，张松宴饮间一省便能暗诵，杨修更为惊异。","evidence":["xianzhu-e-p036b-q"]}],"participants":[{"person":"wudi-p0392","role":"示书","evidence":["xianzhu-e-p036b-q"]},{"person":"xianzhu-p0045","role":"暗诵","evidence":["xianzhu-e-p036b-q"]}],"place":null,"time":{"label":"张松出使曹操期间","precision":"relative","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xianzhu-e-p036b-q"],"after":"xianzhu-e-p036a"},"source_order":[32,184,"P036b"],"order":6564},{"id":"xianzhu-e-p036a","title":"张松使曹与杨修荐举不纳","accounts":[{"id":"xianzhu-e-p036a-account","label":"《益部耆旧杂记》","text":"刘璋遣张松见曹操，曹操不礼；杨修推荐张松，曹操未采纳。","evidence":["xianzhu-e-p036a-q"]},{"id":"liuermu-a-962ca14ae0fdf9510401","label":"正文","text":"曹操定荆州走刘备不录张松","evidence":["liuermu-q-a6a9944ebeeef80fb19a"]},{"id":"liuermu-a-a64cfdcae277b7e3bc2d","label":"裴注·汉晋春秋","text":"张松见曹操不被存录","evidence":["liuermu-q-3a79282f055d43a77a92"]}],"participants":[{"person":"xianzhu-p0045","role":"出使","evidence":["xianzhu-e-p036a-q"]},{"person":"wudi-p0253","role":"遣使","evidence":["xianzhu-e-p036a-q"]},{"person":"cao-cao","role":"不纳荐举","evidence":["xianzhu-e-p036a-q"]},{"person":"wudi-p0392","role":"荐举","evidence":["xianzhu-e-p036a-q"]},{"person":"liu-bei","role":"被曹操攻走者","evidence":["liuermu-q-a6a9944ebeeef80fb19a"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xianzhu-e-p036a-q"]},"source_order":[32,184,"P036a"],"order":6465}],"persons":[{"id":"wudi-p0392","name":"杨修","facts":[],"aliases":[]},{"id":"xianzhu-p0045","name":"张松","facts":[],"aliases":[]}],"evidence":[{"id":"xianzhu-e-p036b-q","section":"chapter-032","block":"b-0db6f9a5f70b8cb84627","layer":"pei","quote":"修以公所撰兵书，示松，松宴饮之间，一（看）〔省〕便暗诵。修以此益异之。”","attribution":"《益部耆旧杂记》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage