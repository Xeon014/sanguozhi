{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wuzhu-e-p009a","title":"孙权围取曹操夜渡军","accounts":[{"id":"wuzhu-e-p009a-account","label":"《吴历》","text":"孙权围取曹操夜渡军","evidence":["wuzhu-e-p009a-q"]}],"participants":[{"person":"sun-quan","role":"围取","evidence":["wuzhu-e-p009a-q"]},{"person":"cao-cao","role":"夜渡","evidence":["wuzhu-e-p009a-q"]}],"place":null,"time":{"year":213,"label":"曹操出濡须时","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"wuzhu-y213","dating_review":{"reviewed":true,"anchor":"wuzhu-q-o022","basis":"曹操出濡须时"},"evidence":["wuzhu-e-p009a-q","wuzhu-q-o022","wudi-q-o139","wudi-q-b-b9d79988a2b2559f2bb5"]},"ordering_evidence":"wuzhu-e-p009a-q","source_order":[47,123,"P009a"],"order":8182}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-q-b-b9d79988a2b2559f2bb5","section":"chapter-001","block":"b-b9d79988a2b2559f2bb5","layer":"modern","quote":"〖11〗十八年：建安十八年（公元 213）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":137,"anchor":null},"note_id":"n-bec99dfe67d67ae54b06","start":0,"end":22},{"id":"wudi-q-o139","section":"chapter-001","block":"b-d44820525c4645832365","layer":"original","quote":"十八年春正月〖11〗，进军濡须口〖12〗；攻破权江西营，获权都督公孙阳〖13〗，乃引军还。诏书并十四州〖14〗，复为九州〖15〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":107,"anchor":null},"note_id":null,"start":0,"end":65},{"id":"wuzhu-e-p009a-q","section":"chapter-047","block":"b-f4f6d3ec5dba2a520a76","layer":"pei","quote":"曹公出濡须，作油船，夜渡洲上。权以水军围取，得三千余人，其没溺者亦数千人。","attribution":"《吴历》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":122,"anchor":null},"note_id":"n-b09efb6707c11b9584ce","start":10,"end":47},{"id":"wuzhu-q-o022","section":"chapter-047","block":"b-ae3a2e9a341d7faddfa0","layer":"original","quote":"十八年正月〖5〗，曹公攻濡须。权与相拒月余，曹公望权军，叹其齐肃〖6〗，乃退。﹝一﹞","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":104,"anchor":null},"note_id":null,"start":0,"end":42}],"profiles":{},"directory_counts":{}}
