{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"houfei-e-o014c","title":"卞秉卒卞兰嗣爵","accounts":[{"id":"houfei-e-o014c-account","label":"《后妃传》正文","text":"卞秉卒，子卞兰嗣。","evidence":["houfei-e-o014c-q"]}],"participants":[{"person":"houfei-p0009","role":"卒","evidence":["houfei-e-o014c-q"]},{"person":"houfei-p0010","role":"嗣爵","evidence":["houfei-e-o014c-q"]}],"place":null,"time":{"label":"秉薨后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["houfei-e-o014c-q"]},"ordering_evidence":"houfei-e-o014c-q","source_order":[5,47,"O014c"],"order":1354}],"persons":[{"id":"houfei-p0009","name":"卞秉","facts":[],"aliases":[]},{"id":"houfei-p0010","name":"卞兰","facts":[],"aliases":[]}],"evidence":[{"id":"houfei-e-o014c-q","section":"chapter-005","block":"b-87bc74c5c9a764cda8ec","layer":"original","quote":"初，太后弟秉，以功封都乡侯。黄初七年，进封开阳侯，邑千二百户，为昭烈将军〖15〗。﹝二﹞秉薨，子兰嗣。少有才学，﹝三﹞为奉车都尉，游击将军〖16〗，加散骑常侍。兰薨，子晖嗣。﹝四﹞又分秉爵，封兰弟琳为列侯，官至步兵校尉。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":46,"anchor":null},"note_id":null,"start":0,"end":110}],"profiles":{},"directory_counts":{}}
