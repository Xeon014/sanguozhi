{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"lvzang-e-o073","title":"绍盛施帏幔大会诸将见洪问服未","accounts":[{"id":"lvzang-a-8f714deede609d70719e","label":"正文","text":"绍盛施帏幔大会诸将见洪问服未","evidence":["lvzang-q-87b414b65cbf5d61a922"]},{"id":"lvzang-a-59959993087a0fe65cb5","label":"正文","text":"洪据地嗔目责绍诸袁多杀忠良不自讳死","evidence":["lvzang-q-3bb51e2a9e0a90e06e82"]}],"participants":[{"person":"wudi-p0052","role":"素亲洪、盛施帏幔大会诸将见洪、谓曰臧洪何相负若此今日服未","evidence":["lvzang-q-87b414b65cbf5d61a922"]},{"person":"lvzang-p0017","role":"被见问；据地嗔目曰诸袁事汉四世五公可谓受恩今王室衰弱无扶翼之意欲因际会希冀非望多杀忠良以立奸威洪亲见呼张陈留为兄则洪府君亦宜为弟同共戮力为国除害何为拥众观人屠灭惜洪力劣不能推刃为天下报仇何谓服乎","evidence":["lvzang-q-87b414b65cbf5d61a922","lvzang-q-3bb51e2a9e0a90e06e82"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["lvzang-q-87b414b65cbf5d61a922","lvzang-q-3bb51e2a9e0a90e06e82"]},"ordering_evidence":"lvzang-q-87b414b65cbf5d61a922","source_order":[7,337,0],"order":1902}],"persons":[{"id":"lvzang-p0017","name":"臧洪","facts":[],"aliases":[]},{"id":"wudi-p0052","name":"袁绍","facts":[],"aliases":[]}],"evidence":[{"id":"lvzang-q-3bb51e2a9e0a90e06e82","section":"chapter-007","block":"b-afee1171f0be37dc4055","layer":"original","quote":"洪据地嗔目曰：“诸袁事汉，四世五公，可谓受恩。今王室衰弱，无扶翼之意；欲因际会，希冀非望〖4〗；多杀忠良，以立奸威。洪亲见呼张陈留为‘兄’〖5〗，则洪府君亦宜为‘弟’〖6〗；同共戮力，为国除害：何为拥众观人屠灭？惜洪力劣，不能推刃为天下报仇，何谓服乎","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":336,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":37,"end":162,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-87b414b65cbf5d61a922","section":"chapter-007","block":"b-afee1171f0be37dc4055","layer":"original","quote":"绍素亲洪，盛施帏幔，大会诸将，见洪。谓曰：“臧洪，何相负若此！今日服未","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":336,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e3