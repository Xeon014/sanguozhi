{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhuge-e-p012a","title":"袁子记张昭荐诸葛亮孙权而亮不留","accounts":[{"id":"zhuge-e-p012a-account","label":"《袁子》","text":"袁子记张昭荐诸葛亮孙权而亮不留","evidence":["zhuge-e-p012a-q"]},{"id":"zhuge-a-p012-judgment","label":"裴松之论","text":"裴松之认为此说失实：诸葛亮与刘备终始之分不可间，不应归因为孙权不能尽用。","evidence":["zhuge-q-p012-judgment"]}],"participants":[{"person":"wendi-p0133","role":"推荐","evidence":["zhuge-e-p012a-q"]},{"person":"zhuge-liang","role":"拒留","evidence":["zhuge-e-p012a-q"]}],"place":null,"time":{"label":"诸葛亮在吴时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["zhuge-e-p012a-q"]},"ordering_evidence":"zhuge-e-p012a-q","source_order":[35,98,"P012a"],"order":6770}],"persons":[{"id":"wendi-p0133","name":"张昭","facts":[],"aliases":[]},{"id":"zhuge-liang","name":"诸葛亮","facts":[],"aliases":[]}],"evidence":[{"id":"zhuge-e-p012a-q","section":"chapter-035","block":"b-5ba3d9210bec001e748f","layer":"pei","quote":"张子布荐亮于孙权，亮不肯留。人问其故，曰：‘孙将军可谓人士，然观其度：能贤亮，而不能尽亮。吾是以不留。","attribution":"《袁子》","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":97,"anchor":null},"note_id":"n-bb52c5885c1c27219355","start":10,"end":61},{"id":"zhuge-q-p012-judgment","section":"chapter-035","block":"b-5ba3d9210bec001e748f","layer":"pei","quote":"臣松之以为：袁孝尼著文立论，甚重诸葛之为人；至如此言，则失之殊远。观亮君臣相遇，可谓希世一时；终始之分，谁能间之？宁有中违断金，甫怀择主？设使权尽其量，便当翻然去就乎？葛生行己，岂其然哉！关羽为曹公所获，遇之甚厚，可谓能尽其用矣；犹义不背本，曾谓孔明之不若云长乎？","attribution":"裴松之论","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":97,"anchor":null},"note_id":"n-bb52c5885c1c27219355","start":63,"end":195}],"profiles":{},"directory_counts":{}}
