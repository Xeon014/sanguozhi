{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wgc-e-0-e30","title":"王凌表求讨贼诏报不听","order":5433,"accounts":[{"id":"wgc-a-0-e30","label":"正文 · 嘉平三年春","text":"王凌表求讨贼诏报不听","evidence":["wgc-q0174","wgc-q0008"]}],"participants":[{"person":"shaodi-p0004","role":"欲因吴塞涂水发难、大严诸军、表求讨贼","evidence":["wgc-q0174","wgc-q0008"]}],"place":null,"time":{"label":"嘉平三年春","precision":"year","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0174","wgc-q0008","wgc-q0173"],"year":251,"chronology":"wgc-y-0-e30","dating_review":{"reviewed":true,"anchor":"wgc-q0008","basis":"逐项对读原行动及直接释年注，保留原季月，不沿用后续迁官。"}},"ordering_evidence":"wgc-q0174"}],"persons":[{"id":"shaodi-p0004","name":"王凌","facts":[],"aliases":[]}],"evidence":[{"id":"wgc-q0008","section":"chapter-028","block":"b-47cde046d1bd69dbed3b","layer":"original","quote":"三年春〖11〗，吴贼塞涂水〖12〗。凌欲因此发，大严诸军；表求讨贼，诏报不听〖13〗。凌阴谋滋甚〖14〗，遣将军杨弘，为废立事告兖州刺史黄华；华、弘连名，以白太傅司马宣王。宣王将中军，乘水道讨凌，先下赦赦凌罪；又将尚书广东〖15〗，使为书喻凌。大军掩至百尺〖16〗，逼凌。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":24,"anchor":null},"note_id":null,"start":0,"end":136},{"id":"wgc-q0173","section":"chapter-028","block":"b-75100a884300c0fc6491","layer":"modern","quote":"〖11〗三年：嘉平三年（公元 251）。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":38,"anchor":null},"note_id":"n-a99c88f7a8076a83999e","start":0,"end":20},{"id":"wgc-q0174","section":"chapter-028","block":"b-47cde046d1bd69dbed3b","layer":"original","quote":"凌欲因此发，大严诸军；表求讨贼，诏报不听","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":24,"anchor":null},"note_id":null,"start":18,"end":38}],"profiles":{},"directory_counts":{}}
