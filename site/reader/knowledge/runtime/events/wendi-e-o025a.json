{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wendi-e-o025a","title":"杨彪受光禄大夫","accounts":[{"id":"wendi-e-o025a-account","label":"《文帝纪》正文","text":"杨彪受光禄大夫","evidence":["wendi-e-o025a-q"]},{"id":"wendi-a-p078-alternative","label":"裴注·续汉书","text":"《续汉书》记黄初四年拜杨彪光禄大夫，正文系于黄初二年；不抹去任官纪年分歧。","evidence":["wendi-q-p078-alternative"]}],"participants":[{"person":"wudi-p0153","role":"受任","evidence":["wendi-e-o025a-q"]}],"place":null,"time":{"year":221,"label":"黄初二年十月","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"wendi-y221","dating_review":{"reviewed":true,"anchor":"wendi-q-o019","basis":"黄初二年十月"},"evidence":["wendi-e-o025a-q","wendi-q-o019","wendi-q-b-ec88012a7f6c352d0e04"]},"ordering_evidence":"wendi-e-o025a-q","source_order":[2,267,"O025a"],"order":585}],"persons":[{"id":"wudi-p0153","name":"杨彪","facts":[],"aliases":[]}],"evidence":[{"id":"wendi-e-o025a-q","section":"chapter-002","block":"b-406df4ff6d725a717cee","layer":"original","quote":"冬十月，授杨彪光禄大夫〖3〗。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":266,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":15,"offset_unit":"unicode_code_point"},{"id":"wendi-q-b-ec88012a7f6c352d0e04","section":"chapter-002","block":"b-ec88012a7f6c352d0e04","layer":"modern","quote":"〖1〗二年：黄初二年（公元 221）。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":210,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8fff547b113ffa36bbc1","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wendi-q-o019","section":"chapter-002","block":"b-8820e5c7f9006d364c44","layer":"original","quote":"二年春正月〖1〗，郊祀天地、明堂〖2〗。甲戌〖3〗，校猎至原陵〖4〗。遣使者，以太牢祠汉世祖〖5〗。乙亥〖6〗，朝日于东郊〖7〗。﹝一﹞初令郡国口满十万者〖8〗，岁察孝廉一人；其有秀异〖9〗，无拘户口。辛巳〖10〗，分三公户邑，封子弟各一人为列侯。壬午〖11〗，复颍川郡一年田租〖12〗。﹝二﹞改许县为许昌县。以魏郡东部为阳平郡〖13〗，西部为广平郡〖14〗。﹝三﹞","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":208,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":183,"offset_unit":"unicode_code_point"},{"id":"wendi-q-p078-alternative","section":"chapter-002","block":"b-ab61d2c808dc92999a0f","layer":"pei","quote":"黄初四年，诏拜光禄大夫，秩中二千石，朝见位次三公，如孔光故事。","attribution":"裴注·续汉书","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":278,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b239b360975b723b7ddd","start":109,"end":140,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
