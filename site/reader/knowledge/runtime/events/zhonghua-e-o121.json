nit":"unicode_code_point"},{"id":"zhonghua-q-1c92809c59c4ed26b372","section":"chapter-013","block":"b-6007847d1ec8e28149ac","layer":"pei","quote":"诏征河东太守王邑。邑以天下未定，心不愿征；而吏民亦恋邑，郡掾卫固及中郎将范先等，各诣繇求乞邑。而诏已拜杜畿为太守，畿已入界。繇不听先等，促邑交符。邑佩印绶，径从河北诣，自归。","attribution":"裴注·魏略","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":46,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-7e5989b9f71152934b24","start":10,"end":97,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
