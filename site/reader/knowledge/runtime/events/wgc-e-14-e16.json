{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wgc-e-14-e16","title":"裴潜以州泰为从事数遣诣宣王","order":5715,"accounts":[{"id":"wgc-a-14-e16","label":"裴注·世语","text":"裴潜以州泰为从事数遣诣宣王","evidence":["wgc-q0610","wgc-q0126"]}],"participants":[{"person":"dongyuan-p0182","role":"以泰为从事、数遣诣宣王","evidence":["wgc-q0610","wgc-q0126"]},{"person":"shaodi-p0035","role":"任从事奉使","evidence":["wgc-q0610","wgc-q0126"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0610","wgc-q0126"]},"ordering_evidence":"wgc-q0610"}],"persons":[{"id":"dongyuan-p0182","name":"裴潜","facts":[],"aliases":[]},{"id":"shaodi-p0035","name":"州泰","facts":[],"aliases":[]}],"evidence":[{"id":"wgc-q0126","section":"chapter-028","block":"b-7c4cb6e3288767c0659f","layer":"pei","quote":"﹝二﹞《世语》曰：“初，荆州刺史裴潜以泰为从事。司马宣王镇宛，潜数遣诣宣王，由此为宣王所知。及征孟达，泰又导军，遂辟泰。泰频丧考、妣、祖，九年居丧；宣王留缺待之。至，三十六日，擢为新城太守。宣王为泰会，使尚书钟（繇）〔毓〕调泰：‘君释褐登宰府，三十六日拥麾盖，守兵马郡；乞儿乘小车，一何驶乎？’泰曰：‘诚有此！君，名公之子，少有文采，故守吏职；猕猴骑上牛，又何迟也！’众宾咸悦。后历兖、豫州刺史，所在有筹算绩效。”","attribution":"世语","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":435,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-83035962258f184f04f4","start":0,"end":207,"offset_unit":"unicode_code_point"},{"id":"wgc-q0610","section":"chapter-028","block":"b-7c4cb6e3288767c0659f","layer":"pei","quote":"初，荆州刺史裴潜以泰为从事。司马宣王镇宛，潜数遣诣宣王，由此为宣王所知","attribution":"裴注·世语","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":435,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-83035962258f184f04f4","start":10,"end":45,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
