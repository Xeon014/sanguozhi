{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wgc-e-0-e50","title":"毌丘俭上疏谏治宫室","order":5480,"accounts":[{"id":"wgc-a-0-e50","label":"正文","text":"毌丘俭上疏谏治宫室","evidence":["wgc-q0195","wgc-q0192"]}],"participants":[{"person":"mingdi-p0048","role":"上疏谏取农民治宫室","evidence":["wgc-q0195","wgc-q0192"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0195","wgc-q0192"]},"ordering_evidence":"wgc-q0195"}],"persons":[{"id":"mingdi-p0048","name":"毌丘俭","facts":[],"aliases":[]}],"evidence":[{"id":"wgc-q0192","section":"chapter-028","block":"b-8d288427da2468ead23f","layer":"original","quote":"明帝即位，为尚书郎，迁羽林监〖5〗。以东宫之旧，甚见亲待。出为洛阳典农。时取农民以治宫室，俭上疏曰：“臣愚以为天下所急除者，二贼〖6〗；所急务者，衣食。诚使二贼不灭，士民饥冻；虽崇美宫室，犹无益也。”","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":62,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":100,"offset_unit":"unicode_code_point"},{"id":"wgc-q0195","section":"chapter-028","block":"b-8d288427da2468ead23f","layer":"original","quote":"时取农民以治宫室，俭上疏曰：“臣愚以为天下所急除者，二贼〖6〗；所急务者，衣食。诚使二贼不灭，士民饥冻；虽崇美宫室，犹无益也","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":62,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":36,"end":98,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
