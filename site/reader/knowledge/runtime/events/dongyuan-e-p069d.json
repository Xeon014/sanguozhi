{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dongyuan-e-p069d","title":"于毒等覆邺杀栗成陶升护袁绍家送斥丘受中郎将","accounts":[{"id":"dongyuan-e-p069d-account","label":"《英雄记》","text":"于毒等覆邺杀栗成陶升护袁绍家送斥丘受中郎将","evidence":["dongyuan-e-p069d-q"]}],"participants":[{"person":"wudi-p0080","role":"陷城","evidence":["dongyuan-e-p069d-q"]},{"person":"dongyuan-p0118","role":"被杀","evidence":["dongyuan-e-p069d-q"]},{"person":"dongyuan-p0119","role":"护家受任","evidence":["dongyuan-e-p069d-q"]},{"person":"wudi-p0052","role":"授官","evidence":["dongyuan-e-p069d-q"]}],"place":null,"time":{"label":"界桥及冀州诸战时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-p069d-q"]},"ordering_evidence":"dongyuan-e-p069d-q","source_order":[6,277,"P069d"],"order":1646}],"persons":[{"id":"dongyuan-p0118","name":"栗成","facts":[],"aliases":[]},{"id":"dongyuan-p0119","name":"陶升","facts":[],"aliases":[]},{"id":"wudi-p0052","name":"袁绍","facts":[],"aliases":[]},{"id":"wudi-p0080","name":"于毒","facts":[],"aliases":[]}],"evidence":[{"id":"dongyuan-e-p069d-q","section":"chapter-006","block":"b-e78509101d005195918b","layer":"pei","quote":"绍既破瓒，引军南到薄落津，方与宾客诸将共会。闻魏郡兵反，与黑山贼于毒共覆邺城，遂杀太守栗成；贼十余部，众数万人，聚会邺中。坐上诸客有家在邺者，皆忧怖失色，或起啼泣；绍容貌不变，自若也。贼陶升者，故内黄小吏也，有善心。独将部众逾西城入，闭守州门，不纳他贼；以车载绍家及诸衣冠在州内者，身自捍卫，送到斥丘，乃还。绍到，遂屯斥丘，以陶升为建义中郎将。","attribution":"《英雄记》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":276,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-14470fffeafe6a651893","start":534,"end":706,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
