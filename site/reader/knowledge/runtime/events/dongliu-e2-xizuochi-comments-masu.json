{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dongliu-e2-xizuochi-comments-masu","title":"习凿齿评论诸葛亮用才与诛马谡","accounts":[{"id":"dongliu-a2-be3c3351929a4b1ed7ed","label":"裴注（引书见原文）","text":"习凿齿评论诸葛亮用才与诛马谡","evidence":["dongliu-q2-612773619ce245e60890"]}],"participants":[],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"第二轮逐项审定；仅保原文时序，不另行推年。","evidence":["dongliu-q2-612773619ce245e60890"]},"ordering_evidence":"dongliu-q2-612773619ce245e60890","order":7187}],"persons":[],"evidence":[{"id":"dongliu-q2-612773619ce245e60890","section":"chapter-039","block":"b-42a72b5bca82dac63101","layer":"pei","quote":"习凿齿曰：“诸葛亮之不能兼上国也，岂不宜哉！夫晋人规林父之后济，故废法而收功；楚成暗得臣之益己，故杀之以重败。今蜀僻陋一方，才少上国；而杀其俊杰，退收驽下之用；明法胜才，不师三败之道：将以成业，不亦难乎？且先主诫谡之不可大用，岂不谓其非才也？亮受诫而不获奉承，明谡之难废也。为天下宰匠，欲大收物之力，而不量才节任，随器付业。知之大过，则违明主之诫；裁之失中，即杀有益之人：难乎其可与言智者也。”","attribution":"裴注（引书见原文）","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":111,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1cf57332fa3806683c57","start":195,"end":392,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
