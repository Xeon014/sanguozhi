{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"mingdi-e-o007e","title":"孟达反叛诏司马懿讨之","accounts":[{"id":"mingdi-e-o007e-account","label":"《明帝纪》正文","text":"孟达反叛诏司马懿讨之","evidence":["mingdi-e-o007e-q"]},{"id":"huowang-a-5f440d0388327efaaa1c","label":"正文","text":"孟达通蜀谋叛魏","evidence":["huowang-q-0efc9c69ce2f688cea3c"]}],"participants":[{"person":"xianzhu-p0071","role":"反叛","evidence":["mingdi-e-o007e-q"]},{"person":"wudi-p0364","role":"奉诏出讨","evidence":["mingdi-e-o007e-q"]},{"person":"zhuge-liang","role":"与孟达数相交通","evidence":["huowang-q-0efc9c69ce2f688cea3c"]}],"place":null,"time":{"year":227,"label":"十二月","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"mingdi-y227","dating_review":{"reviewed":true,"anchor":"mingdi-q-o004","basis":"十二月"},"evidence":["mingdi-e-o007e-q","mingdi-q-o004","mingdi-q-o008","mingdi-q-b-76fba510250937628a99"]},"ordering_evidence":"mingdi-e-o007e-q","source_order":[3,34,"O007e"],"order":727}],"persons":[{"id":"wudi-p0364","name":"司马懿","facts":[],"aliases":[]},{"id":"xianzhu-p0071","name":"孟达","facts":[],"aliases":[]},{"id":"zhuge-liang","name":"诸葛亮","facts":[],"aliases":[]}],"evidence":[{"id":"huowang-q-0efc9c69ce2f688cea3c","section":"chapter-041","block":"b-a4301f50d305160e3ee1","layer":"original","quote":"达得亮书，数相交通〖32〗，辞欲叛魏","section_title":"霍王向张杨费传第十一","source":{"file":"OEBPS/Text/titlepage_0088.xhtml","index":175,"anchor":null},"note_id":null,"start":0,"end":18},{"id":"mingdi-e-o007e-q","section":"chapter-003","block":"b-3b980088f10c9823d34d","layer":"original","quote":"冬十月，丙寅〖11〗，治兵于东郊。焉耆王遣子入侍〖12〗。十一月，立皇后毛氏〖13〗。赐天下男子爵，人二级；鳏寡孤独不能自存者，赐谷。十二月，封后父毛嘉为列侯。新城太守孟达反〖14〗，诏骠骑将军司马宣王讨之。﹝一﹞","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":33,"anchor":null},"note_id":null,"start":0,"end":107},{"id":"mingdi-q-b-76fba510250937628a99","section":"chapter-003","block":"b-76fba510250937628a99","layer":"modern","quote":"〖1〗二年：太和二年（公元 228）。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":60,"anchor":null},"note_id":"n-38a74578b09178cb1fd4","start":0,"end":19},{"id":"mingdi-q-o004","section":"chapter-003","block":"b-3d867ec3331f738aeaf5","layer":"original","quote":"太和元年春正月，郊祀武皇帝，以配天；宗祀文皇帝于明堂，以配上帝〖1〗。分江夏南部，置江夏南部都尉。西平麹英反，杀临羌令、西都长〖2〗。遣将军郝昭、鹿磐，讨斩之。二月，辛未〖3〗，帝耕于籍田。辛巳〖4〗，立文昭皇后寝庙于邺。丁亥〖5〗，朝日于东郊。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":30,"anchor":null},"note_id":null,"start":0,"end":123},{"id":"mingdi-q-o008","section":"chapter-003","block":"b-bec9198de0001b0aa26c","layer":"original","quote":"二年春正月〖1〗，宣王攻破新城。斩达，传其首〖2〗。﹝一﹞分新城之上庸、武陵、巫县为上庸郡〖3〗，锡县为锡郡。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":54,"anchor":null},"note_id":null,"start":0,"end":55}],"profiles":{},"directory_counts":{}}
