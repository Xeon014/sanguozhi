{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"santizhu059-e-sr-deng-pellet","title":"孙登比对弹丸释放被疑者","accounts":[{"id":"santizhu059-a-874d1fd15a27373a4456","label":"正文","text":"孙登乘马出遇弹丸，左右执弹佩丸者被疑；登使求得过丸比对非类，释放不服者","evidence":["santizhu059-q-fd93649cde1e2330a991"]}],"participants":[{"person":"zhouyu-p0025","role":"使求过丸比对并释放被疑者","evidence":["santizhu059-q-fd93649cde1e2330a991"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"未由相邻段落推算纪年；原文时间表达保留在来源引句中。","evidence":["santizhu059-q-fd93649cde1e2330a991"]},"ordering_evidence":"santizhu059-q-fd93649cde1e2330a991","source_order":[59,29,0],"order":10430}],"persons":[{"id":"zhouyu-p0025","name":"孙登","facts":[],"aliases":[]}],"evidence":[{"id":"santizhu059-q-fd93649cde1e2330a991","section":"chapter-059","block":"b-d24929807233787b6840","layer":"original","quote":"尝乘马出，有弹丸过，左右求之。有一人操弹佩丸，咸以为是；辞对不服，从者欲捶之。登不听，使求过丸〖4〗；比之非类〖5〗，乃见释","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":28,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":62,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
