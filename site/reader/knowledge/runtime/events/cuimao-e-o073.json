{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"cuimao-e-o073","title":"何夔上言长广宜依远域新邦之典，缓齐以法","accounts":[{"id":"cuimao-a-e414b8545a78e82a9915","label":"正文","text":"何夔上言长广宜依远域新邦之典，缓齐以法","evidence":["cuimao-q-f74dc7d921fd36e67a47"]},{"id":"cuimao-a-4c2c173314f02df6b9f2","label":"正文","text":"太祖从何夔之言","evidence":["cuimao-q-67a37b27d5999b274f3b"]}],"participants":[{"person":"wudi-p0323","role":"上言者","evidence":["cuimao-q-f74dc7d921fd36e67a47"]},{"person":"cao-cao","role":"从其言者","evidence":["cuimao-q-67a37b27d5999b274f3b"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["cuimao-q-f74dc7d921fd36e67a47","cuimao-q-67a37b27d5999b274f3b"]},"ordering_evidence":"cuimao-q-f74dc7d921fd36e67a47","source_order":[12,227,49],"order":2791}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0323","name":"何夔","facts":[],"aliases":[]}],"evidence":[{"id":"cuimao-q-67a37b27d5999b274f3b","section":"chapter-012","block":"b-17f2c5893c0f9cd350ee","layer":"original","quote":"太祖从其言","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":226,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":246,"end":251,"offset_unit":"unicode_code_point"},{"id":"cuimao-q-f74dc7d921fd36e67a47","section":"chapter-012","block":"b-17f2c5893c0f9cd350ee","layer":"original","quote":"乃上言曰：“自丧乱以来，民人失所；今虽小安，然服教日浅。所下新科，皆以明罚敕法，齐一大化也。所领六县，疆域初定，加以饥馑；若一切齐以科禁〖4〗，恐或有不从教者。有不从教者不得不诛，则非观民设教随时之意也。先王辨九服之赋以殊远近〖5〗，制三典之刑以平治乱〖6〗；愚以为此郡宜依远域新邦之典。其民间小事，使长吏临时随宜；上不背正法，下以顺百姓之心。比及三年，民安其业；然后齐之以法，则无所不至矣","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":226,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":49,"end":244,"offset_unit":"unicode_code_point"}],"profiles":{},"