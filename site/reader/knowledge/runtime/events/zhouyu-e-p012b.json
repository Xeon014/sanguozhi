{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhouyu-e-p012b","title":"曹操遣蒋幹初见周瑜","accounts":[{"id":"zhouyu-e-p012b-account","label":"《江表传》","text":"曹操遣蒋幹游说，周瑜迎而点破来意，设食后先遣就馆。","evidence":["zhouyu-e-p012b-q"]}],"participants":[{"person":"cao-cao","role":"遣说","evidence":["zhouyu-e-p012b-q"]},{"person":"zhouyu-p0023","role":"往见","evidence":["zhouyu-e-p012b-q"]},{"person":"zhou-yu","role":"拒说","evidence":["zhouyu-e-p012b-q"]}],"place":null,"time":{"label":"周瑜在世至孙权称帝后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["zhouyu-e-p012b-q"]},"ordering_evidence":"zhouyu-e-p012b-q","source_order":[54,120,"P012b"],"order":9613}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"zhou-yu","name":"周瑜","facts":[],"aliases":[]},{"id":"zhouyu-p0023","name":"蒋幹","facts":[],"aliases":[]}],"evidence":[{"id":"zhouyu-e-p012b-q","section":"chapter-054","block":"b-2214c5c24f10e6532e39","layer":"pei","quote":"初曹公闻瑜年少，有美才，谓可游说动也；乃密下扬州，遣九江蒋幹往见瑜。幹有仪容，以才辩见称；独步江、淮之间，莫与为对。乃布衣葛巾，自托私行，诣瑜。瑜出迎之，立谓幹曰：‘子翼良苦！远涉江湖为曹氏做说客邪？’幹曰：‘吾与足下州里，中间别隔；遥闻芳烈，故来叙阔，并观雅规。而云说客，无乃逆诈乎？’瑜曰：‘吾虽不及夔、旷，闻弦赏音，足知雅曲也。’因延幹入，为设酒食。毕，遣之曰：‘适吾有密事，且出就馆；事了，别自相请。","attribution":"《江表传》","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":119,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f170ddcf31cbbfb5f027","start":77,"end":281,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
