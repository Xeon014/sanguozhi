{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"shaodi-e-p035b","title":"侯音反应余冒矢救东里衮身死","accounts":[{"id":"shaodi-e-p035b-account","label":"《楚国先贤传》","text":"侯音反应余冒矢救东里衮身死","evidence":["shaodi-e-p035b-q"]}],"participants":[{"person":"wudi-p0382","role":"起兵","evidence":["shaodi-e-p035b-q"]},{"person":"shaodi-p0122","role":"救主","evidence":["shaodi-e-p035b-q"]},{"person":"wudi-p0390","role":"被救","evidence":["shaodi-e-p035b-q"]}],"place":null,"time":{"label":"建安二十三年","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["shaodi-e-p035b-q"]},"ordering_evidence":"shaodi-e-p035b-q","source_order":[4,618,"P035b"],"related_events":[{"event":"wudi-e-o193a","type":"related","evidence":["shaodi-e-p035b-q","wudi-e-o193a-q"]}],"order":1205},{"id":"wudi-e-o193a","title":"侯音据宛反叛，曹仁受命围城","accounts":[{"id":"wudi-e-o193a-account","label":"正文","text":"侯音执南阳太守据宛，曹仁原屯樊讨关羽，此月奉命围宛。","evidence":["wudi-e-o193a-q"]},{"id":"lizang-a-c5206a54f1c3bdba5398","label":"正文","text":"侯音卫开等以宛叛","evidence":["lizang-q-05620856109b831dafe0"]}],"participants":[{"person":"wudi-p0382","role":"反叛","evidence":["wudi-e-o193a-q"]},{"person":"cao-ren","role":"围城","evidence":["wudi-e-o193a-q"]},{"person":"cao-cao","role":"遣将","evidence":["wudi-e-o193a-q"]},{"person":"lizang-p0005","role":"以宛叛","evidence":["lizang-q-05620856109b831dafe0"]}],"place":{"text":"宛、樊城","evidence":["wudi-e-o193a-q"]},"time":{"label":"建安二十三年冬十月","year":218,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o193a-q","wudi-q-o188","wudi-q-b-ac93ccb47f6e7be3aea4"],"chronology":"wudi-y218","dating_review":{"anchor":"wudi-q-o188","basis":"建安二十三年冬十月","reviewed":true}},"source_order":[1,1077,"O193a"],"related_events":[{"event":"shaodi-e-p035b","type":"related","evidence":["shaodi-e-p035b-q","wudi-e-o193a-q"]}],"order":414}],"persons":[{"id":"shaodi-p0122","name":"应余","facts":[],"aliases":[]},{"id":"wudi-p0382","name":"侯音","facts":[],"aliases":[]},{"id":"wudi-p0390","name":"东里衮","facts":[],"aliases":[]}],"evidence":[{"id":"shaodi-e-p035b-q","section":"chapter-004","block":"b-26e03b3ad17e56cbdf8f","layer":"pei","quote":"﹝一﹞《楚国先贤传》曰：“余字子正。天姿方毅，志尚仁义。建安二十三年为郡功曹。是时吴、蜀不宾，疆埸多虞。宛将侯音，扇动山民，保城以叛。余与太守东里衮，当扰攘之际，进窜得出。音即遣骑追逐，去城十里相及；贼便射衮，飞矢交流。余前以身当箭，被七创。因谓追贼曰：‘侯音狂狡，造为凶逆，大军寻至，诛夷在近。谓卿曹本是善人，素无恶心；当思反善，何为受其指挥？我以身代君，已被重创；若身死君全，陨没无恨！’因仰天号哭泣涕，血泪俱下。贼见其义烈，释衮不害。贼去之后，余亦命绝。征南将军曹仁讨平音，表余行状，并修祭醊。太祖闻之，嗟叹良久。下荆州：复表门闾，赐谷千斛。”","attribution":"《楚国先贤传》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":25,"anchor":null},"note_id":"n-7dcbf2833a9c8d0368aa","start":0,"end":275},{"id":"wudi-e-o193a-q","section":"chapter-001","block":"b-21f24b8f57341b1dcb4e","layer":"original","quote":"冬十月，宛守将侯音等反；执南阳太守，劫略吏民，保宛。初，曹仁讨关羽，屯樊城；是月，使仁围宛。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":401,"anchor":null},"note_id":null,"start":0,"end":46}],"profiles":{},"directory_counts":{}}
