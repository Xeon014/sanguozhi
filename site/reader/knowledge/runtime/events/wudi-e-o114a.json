{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o114a","title":"大水阻海道，田畴引军出卢龙","accounts":[{"id":"wudi-e-o114a-account","label":"正文","text":"秋七月大水导致海道不通，曹操采纳田畴引路建议，出卢龙塞，开山填谷转向柳城。","evidence":["wudi-e-o114a-q"]}],"participants":[{"person":"cao-cao","role":"改道行军","evidence":["wudi-e-o114a-q"]},{"person":"wudi-p0243","role":"引导","evidence":["wudi-e-o114a-q"]}],"place":{"text":"卢龙塞、白檀、平冈、鲜卑庭、柳城","evidence":["wudi-e-o114a-q"]},"time":{"label":"建安十二年秋七月","year":207,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o114a-q","wudi-q-o111","wudi-q-b-fbc277caaf5ad8b958df"],"chronology":"wudi-y207","dating_review":{"anchor":"wudi-q-o111","basis":"建安十二年秋七月","reviewed":true}},"source_order":[1,634,"O114a"],"order":254}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0243","name":"田畴","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-o114a-q","section":"chapter-001","block":"b-450f7815dc8f8edb5b1d","layer":"original","quote":"秋七月，大水，傍海道不通；田畴请为乡导〖3〗，公从之。引军出卢龙塞〖4〗，塞外道绝不通。乃堑山堙谷五百余里〖5〗，经白檀〖6〗，历平冈〖7〗；涉鲜卑庭〖8〗，东指柳城〖9〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":633,"anchor":null},"note_id":null,"start":0,"end":87},{"id":"wudi-q-b-fbc277caaf5ad8b958df","section":"chapter-001","block":"b-fbc277caaf5ad8b958df","layer":"modern","quote":"〖1〗十二年：建安十二年（公元 207）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":623,"anchor":null},"note_id":"n-20efb4f3aff50357a189","start":0,"end":21},{"id":"wudi-q-o111","section":"chapter-001","block":"b-01eaf58b917a530c61d5","layer":"original","quote":"十二年春二月〖1〗，公自淳于还邺。丁酉〖2〗，令曰：“吾起义兵诛暴乱，于今十九年；所征必克，岂吾功哉？乃贤士大夫之力也！天下虽未悉定，吾当要与贤士大夫共定之；而专享其劳〖3〗，吾何以安焉？其促定功行封〖4〗。”于是大封功臣二十余人，皆为列侯；其余各以次受封；及复死事之孤〖5〗：轻重各有差〖6〗。﹝一﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":621,"anchor":null},"note_id":null,"start":0,"end":151}],"profiles":{},"directory_counts":{}}
