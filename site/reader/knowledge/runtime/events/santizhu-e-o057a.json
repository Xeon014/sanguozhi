{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"santizhu-e-o057a","title":"孙休停止召韦曜等入侍讲业","accounts":[{"id":"santizhu-a-0ad73671019ee1332633","label":"正文","text":"孙休停止召韦曜等入侍讲业","evidence":["santizhu-q-1922f12b5a8acb884465"]},{"id":"wanglou-a-1060ed2834d85a27836e","label":"正文","text":"休深恨张布（语在《休传》），然曜竟止不入","evidence":["wanglou-q-585827b20006c67c9a28"]}],"participants":[{"person":"shaodi-p0150","role":"最终停止讲业并不再令韦曜入侍","evidence":["santizhu-q-1922f12b5a8acb884465"]},{"person":"santizhu-p0049","role":"不再被召入侍","evidence":["santizhu-q-1922f12b5a8acb884465"]},{"person":"santizhu-p0035","role":"被恨","evidence":["wanglou-q-585827b20006c67c9a28"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["santizhu-q-1922f12b5a8acb884465"]},"ordering_evidence":"santizhu-q-1922f12b5a8acb884465","source_order":[48,57,56],"order":8627}],"persons":[{"id":"santizhu-p0035","name":"张布","facts":[],"aliases":[]},{"id":"santizhu-p0049","name":"韦曜","facts":[],"aliases":[]},{"id":"shaodi-p0150","name":"孙休","facts":[],"aliases":[]}],"evidence":[{"id":"santizhu-q-1922f12b5a8acb884465","section":"chapter-048","block":"b-1c93dc03470b1e67bbe4","layer":"original","quote":"休虽解此旨〖23〗，心不能悦；更恐其疑惧，竟如布意，废其讲业，不复使（冲）〔曜〕等入","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":238,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":56,"end":98,"offset_unit":"unicode_code_point"},{"id":"wanglou-q-585827b20006c67c9a28","section":"chapter-065","block":"b-b27bb92720d6b263929a","layer":"original","quote":"孙休践阼，为中书郎，博士祭酒〖2〗。命曜依刘向故事〖3〗，校定众书；又欲延曜侍讲〖4〗。而左将军张布近习宠幸〖5〗，事行多玷〖6〗；惮曜侍讲儒士，又性精确〖7〗，惧以古今警戒休意，固争不可。休深恨布，语在《休传》。然曜竟止不入。","section_title":"王楼贺韦华传第二十","source":{"file":"OEBPS/Text/titlepage_0137.xhtml","index":253,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":114,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
