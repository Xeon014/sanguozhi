{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-o006a","title":"刘备随毌丘毅募兵并战下邳","accounts":[{"id":"xianzhu-e-o006a-account","label":"《先主传》正文","text":"何进遣毌丘毅赴丹杨募兵，刘备同行，至下邳遇贼，力战有功。","evidence":["xianzhu-e-o006a-q"]}],"participants":[{"person":"wudi-p0051","role":"遣使募兵","evidence":["xianzhu-e-o006a-q"]},{"person":"xianzhu-p0016","role":"募兵","evidence":["xianzhu-e-o006a-q"]},{"person":"liu-bei","role":"同行力战","evidence":["xianzhu-e-o006a-q"]}],"place":{"text":"下邳","evidence":["xianzhu-e-o006a-q"]},"time":{"label":"弃安熹尉后","precision":"relative","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xianzhu-e-o006a-q"],"after":"xianzhu-e-o005c"},"source_order":[32,21,"O006a"],"order":6499},{"id":"xianzhu-e-o005c","title":"刘备鞭督邮弃官","accounts":[{"id":"xianzhu-e-o005c-account","label":"《先主传》正文","text":"正文记刘备求见督邮不得，缚而杖二百，解绶系其颈，随后弃官亡命。","evidence":["xianzhu-e-o005c-q"]},{"id":"xianzhu-a-p005-dianlue","label":"《典略》","text":"《典略》称督邮将遣刘备，刘备以密教为辞绑走督邮，杖百余下，因其求哀而放走；与正文的杖数和细节分列。","evidence":["xianzhu-q-p005-dianlue"]}],"participants":[{"person":"liu-bei","role":"杖督邮弃官","evidence":["xianzhu-e-o005c-q"]}],"place":{"text":"安熹","evidence":["xianzhu-e-o005c-q"]},"time":{"label":"任安熹尉后","precision":"relative","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xianzhu-e-o005c-q"],"after":"xianzhu-e-o005b"},"source_order":[32,20,"O005c"],"order":6498}],"persons":[{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"wudi-p0051","name":"何进","facts":[],"aliases":[]},{"id":"xianzhu-p0016","name":"毌丘毅","facts":[],"aliases":[]}],"evidence":[{"id":"xianzhu-e-o006a-q","section":"chapter-032","block":"b-93cc554cdef884e90c88","layer":"original","quote":"顷之，大将军何进遣都尉毌丘毅，诣丹杨募兵，先主与俱行。至下邳遇贼，力战有功，","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":20,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":38,"offset_unit":"unicode_code_