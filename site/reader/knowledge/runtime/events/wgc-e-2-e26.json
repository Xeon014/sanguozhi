{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wgc-e-2-e26","title":"黄初中利城郡反推唐咨为主","order":5604,"accounts":[{"id":"wgc-a-2-e26","label":"正文 · 黄初中","text":"黄初中利城郡反推唐咨为主","evidence":["wgc-q0308","wgc-q0034"]}],"participants":[{"person":"wuzhu-p0088","role":"被推为主","evidence":["wgc-q0308","wgc-q0034"]},{"person":"wendi-p0034","role":"被利城叛众杀害","evidence":["wgc-q0308","wgc-q0034"]}],"place":null,"time":{"label":"黄初中","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0308","wgc-q0034"]},"ordering_evidence":"wgc-q0308"}],"persons":[{"id":"wendi-p0034","name":"徐质","facts":[],"aliases":[]},{"id":"wuzhu-p0088","name":"唐咨","facts":[],"aliases":[]}],"evidence":[{"id":"wgc-q0034","section":"chapter-028","block":"b-1557e93d1c7c76ec6209","layer":"original","quote":"唐咨本利城人〖9〗。黄初中，利城郡反，杀太守徐箕，推咨为主。文帝遣诸军讨破之，咨走入海；遂亡至吴；官至左将军，封侯，持节。诞、钦屠戮，咨亦生擒；三叛皆获，天下快焉。﹝三﹞拜咨安远将军〖10〗，其余裨将咸假号位〖11〗。吴众悦服，江东感之，皆不诛其家。其淮南将吏士民诸为诞所胁略者，惟诛其首逆，余皆赦之。听鸯、虎收敛钦丧，给其车牛，致葬旧墓。﹝四﹞","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":217,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":173,"offset_unit":"unicode_code_point"},{"id":"wgc-q0308","section":"chapter-028","block":"b-1557e93d1c7c76ec6209","layer":"original","quote":"黄初中，利城郡反，杀太守徐箕，推咨为主","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":217,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":10,"end":29,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
