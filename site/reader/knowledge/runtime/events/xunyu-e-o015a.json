{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xunyu-e-o015a","title":"袁绍书辞悖慢曹操怒钟繇问荀彧","accounts":[{"id":"xunyu-e-o015a-account","label":"《荀彧荀攸贾诩传第十》正文","text":"袁绍书辞悖慢曹操怒钟繇问荀彧","evidence":["xunyu-e-o015a-q"]}],"participants":[{"person":"wudi-p0052","role":"致书","evidence":["xunyu-e-o015a-q"]},{"person":"cao-cao","role":"受书","evidence":["xunyu-e-o015a-q"]},{"person":"wudi-p0181","role":"问事","evidence":["xunyu-e-o015a-q"]},{"person":"wudi-p0100","role":"察意","evidence":["xunyu-e-o015a-q"]}],"place":null,"time":{"label":"曹操宛败后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xunyu-e-o015a-q"]},"ordering_evidence":"xunyu-e-o015a-q","source_order":[10,87,"O015a"],"order":2421}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0052","name":"袁绍","facts":[],"aliases":[]},{"id":"wudi-p0100","name":"荀彧","facts":[],"aliases":[]},{"id":"wudi-p0181","name":"钟繇","facts":[],"aliases":[]}],"evidence":[{"id":"xunyu-e-o015a-q","section":"chapter-010","block":"b-b11086d208b9de14553f","layer":"original","quote":"自太祖之迎天子也，袁绍内怀不服。绍既并河朔，天下畏其强。太祖方东忧吕布，南拒张绣。而绣败太祖军于宛，绍益骄，与太祖书，其辞悖慢〖1〗。太祖大怒，出入动静变于常，众皆谓以失利于张绣故也。钟繇以问彧，彧曰：“公之聪明，必不追咎往事；殆有他虑。”则见太祖问之。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":86,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":127,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
