{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dongyuan-e-p069f","title":"马日！赵岐和关东赵岐至河北绍奉命公孙瓒书和","accounts":[{"id":"dongyuan-e-p069f-account","label":"《英雄记》","text":"马日！赵岐和关东赵岐至河北绍奉命公孙瓒书和","evidence":["dongyuan-e-p069f-q"]}],"participants":[{"person":"sunshi-p0041","role":"奉使","evidence":["dongyuan-e-p069f-q"]},{"person":"xunyu-p0029","role":"调停","evidence":["dongyuan-e-p069f-q"]},{"person":"wudi-p0052","role":"受命","evidence":["dongyuan-e-p069f-q"]},{"person":"wudi-p0093","role":"致书","evidence":["dongyuan-e-p069f-q"]}],"place":null,"time":{"label":"界桥及冀州诸战时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-p069f-q"]},"ordering_evidence":"dongyuan-e-p069f-q","source_order":[6,277,"P069f"],"order":1648}],"persons":[{"id":"sunshi-p0041","name":"马日！","facts":[],"aliases":[]},{"id":"wudi-p0052","name":"袁绍","facts":[],"aliases":[]},{"id":"wudi-p0093","name":"公孙瓒","facts":[],"aliases":[]},{"id":"xunyu-p0029","name":"赵岐","facts":[],"aliases":[]}],"evidence":[{"id":"dongyuan-e-p069f-q","section":"chapter-006","block":"b-e78509101d005195918b","layer":"pei","quote":"初平四年，天子使太傅马日!、太仆赵岐和解关东。岐别诣河北，绍出迎于百里上，拜奉帝命。岐住绍营，移书告瓒。瓒遣使具与绍书曰：‘赵太仆以周召之德，衔命来征，宣扬朝恩，示以和睦；旷若开云见日，何喜如之？昔贾复、寇恂，亦争士卒，欲相危害；遇光武之宽，亲俱陛见，同舆共出，时人以为荣。自省边鄙，得与将军共同此福；此诚将军之眷，而瓒之幸也！’","attribution":"《英雄记》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":276,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-14470fffeafe6a651893","start":821,"end":986,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
