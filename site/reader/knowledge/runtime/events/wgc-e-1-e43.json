{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wgc-e-1-e43","title":"俭钦遣使诣诞诞斩使露布","order":5558,"accounts":[{"id":"wgc-a-1-e43","label":"正文","text":"俭钦遣使诣诞诞斩使露布","evidence":["wgc-q0257","wgc-q0258"]}],"participants":[{"person":"mingdi-p0048","role":"遣使诣诞招呼豫州士民","evidence":["wgc-q0257","wgc-q0258"]},{"person":"shaodi-p0074","role":"同遣使","evidence":["wgc-q0257","wgc-q0258"]},{"person":"shaodi-p0044","role":"斩其使、露布天下","evidence":["wgc-q0257","wgc-q0258"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0257","wgc-q0258"]},"ordering_evidence":"wgc-q0257"}],"persons":[{"id":"mingdi-p0048","name":"毌丘俭","facts":[],"aliases":[]},{"id":"shaodi-p0044","name":"诸葛诞","facts":[],"aliases":[]},{"id":"shaodi-p0074","name":"文钦","facts":[],"aliases":[]}],"evidence":[{"id":"wgc-q0257","section":"chapter-028","block":"b-4874feeb725426be8160","layer":"original","quote":"后毌丘俭、文钦反，遣使诣诞，招呼豫州士民。诞斩其使，露布天下〖9〗，令知俭、钦凶逆","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":152,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":41,"offset_unit":"unicode_code_point"},{"id":"wgc-q0258","section":"chapter-028","block":"b-4874feeb725426be8160","layer":"original","quote":"后毌丘俭、文钦反，遣使诣诞，招呼豫州士民。诞斩其使，露布天下〖9〗，令知俭、钦凶逆。大将军司马景王东征，使诞督豫州诸军，渡安风津向寿春。俭、钦之破也，诞先至寿春。寿春中十余万口，闻俭、钦败，恐诛，悉破城门出；流迸山泽，或散走入吴。以诞久在淮南，乃复以为镇东大将军，仪同三司，都督扬州。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":152,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":142,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
