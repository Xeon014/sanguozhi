{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-o013b","title":"曹操资助刘备东击吕布","accounts":[{"id":"xianzhu-e-o013b-account","label":"《先主传》正文","text":"曹操给刘备军粮和增兵，使其返回沛地收散卒、东击吕布。","evidence":["xianzhu-e-o013b-q"]}],"participants":[{"person":"cao-cao","role":"给粮增兵","evidence":["xianzhu-e-o013b-q"]},{"person":"liu-bei","role":"东击吕布","evidence":["xianzhu-e-o013b-q"]}],"place":{"text":"沛","evidence":["xianzhu-e-o013b-q"]},"time":{"label":"刘备归曹操后","precision":"relative","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xianzhu-e-o013b-q"],"after":"wudi-e-o048a"},"source_order":[32,60,"O013b"],"order":6516},{"id":"wudi-e-o048a","title":"刘备失下邳来投曹操","accounts":[{"id":"wudi-e-o048a-account","label":"正文","text":"吕布袭取下邳，刘备来投曹操；程昱建议早图刘备，曹操以招纳英雄为由拒绝。","evidence":["wudi-e-o048a-q"]},{"id":"xianzhu-e-o011a-account","label":"《先主传》正文","text":"刘备与袁术相持时，曹豹内应吕布，下邳失守，刘备妻子被虏，刘备转军海西。","evidence":["xianzhu-e-o011a-q"]},{"id":"xianzhu-a-p009-yingxiong","label":"《英雄记》","text":"《英雄记》记张飞欲杀曹豹，曹豹部众招吕布，张飞败走；与正文的守城叙述分列。","evidence":["xianzhu-q-p009-yingxiong"]},{"id":"xianzhu-e-o013a-account","label":"《先主传》正文","text":"刘备还小沛重聚万余兵，吕布出兵击败他；刘备归曹操，获厚遇并为豫州牧。","evidence":["xianzhu-e-o013a-q"]},{"id":"chengguo-a-d39ee7b7aa1f72659b7b","label":"正文","text":"刘备失徐州来归太祖","evidence":["chengguo-q-705e3235b353e56fbd21"]}],"participants":[{"person":"wudi-p0088","role":"袭取","evidence":["wudi-e-o048a-q"]},{"person":"liu-bei","role":"来投","evidence":["wudi-e-o048a-q"]},{"person":"wudi-p0101","role":"进言","evidence":["wudi-e-o048a-q"]},{"person":"cao-cao","role":"拒绝杀备","evidence":["wudi-e-o048a-q"]},{"person":"wudi-p0102","role":"迎吕布","evidence":["xianzhu-e-o011a-q"]},{"person":"wudi-p0367","role":"据《英雄记》守下邳败走","evidence":["xianzhu-q-p009-yingxiong"]}],"place":{"text":"下邳","evidence":["wudi-e-o048a-q"]},"time":{"label":"建安元年","year":196,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o048a-q","wudi-q-o040","wudi-q-b-16a5462