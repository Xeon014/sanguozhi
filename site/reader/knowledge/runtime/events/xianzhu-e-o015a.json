{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-o015a","title":"曹操论英雄与刘备失箸","accounts":[{"id":"xianzhu-e-o015a-account","label":"《先主传》正文","text":"曹操对刘备说天下英雄唯二人，刘备失落手中匕箸。","evidence":["xianzhu-e-o015a-q"]},{"id":"xianzhu-a-p014-huayang","label":"《华阳国志》","text":"《华阳国志》补记恰逢雷震，刘备借孔子迅雷风烈必变之语解释失态。","evidence":["xianzhu-q-p014-huayang"]}],"participants":[{"person":"cao-cao","role":"论英雄","evidence":["xianzhu-e-o015a-q"]},{"person":"liu-bei","role":"失箸","evidence":["xianzhu-e-o015a-q"]}],"place":null,"time":{"year":199,"label":"受遣邀击袁术之前","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xianzhu-y199","dating_review":{"reviewed":true,"anchor":"xianzhu-q-o014","basis":"受遣邀击袁术之前"},"evidence":["xianzhu-e-o015a-q","xianzhu-q-o014","wudi-q-o061","wudi-q-b-51bced16741add42ff70"]},"source_order":[32,71,"O015a"],"order":6521}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-q-b-51bced16741add42ff70","section":"chapter-001","block":"b-51bced16741add42ff70","layer":"modern","quote":"〖1〗四年：建安四年（公元 199）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":369,"anchor":null},"note_id":"n-20628d34a709162c77f0","start":0,"end":19},{"id":"wudi-q-o061","section":"chapter-001","block":"b-502d4e8c0ed143eaa30d","layer":"original","quote":"四年春二月〖1〗，公还至昌邑〖2〗。张杨将杨丑杀杨〖3〗。眭固又杀丑，以其众属袁绍，屯射犬〖4〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":358,"anchor":null},"note_id":null,"start":0,"end":49},{"id":"xianzhu-e-o015a-q","section":"chapter-032","block":"b-98e30108a13f2ee6046a","layer":"original","quote":"是时，曹公从容谓先主曰〖2〗：“今天下英雄，唯使君与操耳！本初之徒〖3〗，不足数也〖4〗。”先主方食，失匕箸〖5〗。﹝二﹞","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":70,"anchor":null},"note_id":null,"start":41,"end":102},{"id":"xianzhu-q-o014","section":"chapter-032","block":"b-9236c229b2cd9315f1e3","layer":"original","quote":"袁术欲经徐州北就袁绍，曹公遣先主督朱灵、路招要击术〖4〗。未至，术病死。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":60,"anchor":null},"note_id":null,"start":0,"end":36},{"id":"xianzhu-q-p014-huayang","section":"chapter-032","block":"b-4b036300f736679f6e61","layer":"pei","quote":"﹝二﹞《华阳国志》云：“于时，正当雷震，备因谓操曰：‘圣人云“迅雷风烈必变”，良有以也；一震之威，乃可至于此也！’”","attribution":"《华阳国志》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":86,"anchor":null},"note_id":"n-58bd55202ead3c4c2c60","start":0,"end":58}],"profiles":{},"directory_counts":{}}
