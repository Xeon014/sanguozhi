{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhuge-e-p043a","title":"杨仪姜维反旗鸣鼓退司马懿入谷发丧","accounts":[{"id":"zhuge-e-p043a-account","label":"《汉晋春秋》","text":"杨仪姜维反旗鸣鼓退司马懿入谷发丧","evidence":["zhuge-e-p043a-q"]},{"id":"houzhu-a-split-58cfd319c11a","label":"《后主传》正文","text":"魏延与杨仪相攻","evidence":["houzhu-q-O028"]}],"participants":[{"person":"zhuge-p0045","role":"退军","evidence":["zhuge-e-p043a-q"]},{"person":"shaodi-p0050","role":"疑兵","evidence":["zhuge-e-p043a-q"]},{"person":"wudi-p0364","role":"追而退","evidence":["zhuge-e-p043a-q"]}],"place":null,"time":{"label":"诸葛亮卒后蜀军退时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["zhuge-e-p043a-q"]},"ordering_evidence":"zhuge-e-p043a-q","source_order":[35,313,"P043a"],"order":6817}],"persons":[{"id":"shaodi-p0050","name":"姜维","facts":[],"aliases":[]},{"id":"wudi-p0364","name":"司马懿","facts":[],"aliases":[]},{"id":"zhuge-p0045","name":"杨仪","facts":[],"aliases":[]}],"evidence":[{"id":"houzhu-q-O028","section":"chapter-033","block":"b-f14b2099cf9ad715d98a","layer":"original","quote":"秋八月，亮卒于渭滨。征西大将军魏延，与丞相长史杨仪争权，不和〖17〗，举兵相攻，延败走，斩延首；仪率诸军还成都。大赦。以左将军吴壹为车骑将军，假节督汉中。以丞相留府长史蒋琬为尚书令〖18〗，总统国事。","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":60,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":100,"offset_unit":"unicode_code_point"},{"id":"zhuge-e-p043a-q","section":"chapter-035","block":"b-2f2b6bbbac71886c81dc","layer":"pei","quote":"﹝五﹞《汉晋春秋》曰：“杨仪等整军而出，百姓奔告宣王，宣王追焉。姜维令仪反旗鸣鼓，若将向宣王者；宣王乃退，不敢逼。于是仪结阵而去，入谷然后发丧。宣王之退也，百姓为之谚曰：‘死诸葛走生仲达！’或以告宣王，宣王曰：‘吾能料生，不便料死也。’”","attribution":"《汉晋春秋》","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":312,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5f62dbf3d1f1e8688ec4","start":0,"end":119,"offset_unit":"unicode_code_point"}],