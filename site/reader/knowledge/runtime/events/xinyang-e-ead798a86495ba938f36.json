{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xinyang-e-ead798a86495ba938f36","title":"杨阜丧妻请假赴姜叙述冀难劝讨超","accounts":[{"id":"xinyang-a-ead798a86495ba938f36","label":"正文","text":"杨阜丧妻请假赴姜叙述冀难劝讨超","evidence":["xinyang-q-b4a51f5a525287c3bc91"]}],"participants":[{"person":"mingdi-p0040","role":"请假劝讨","evidence":["xinyang-q-b4a51f5a525287c3bc91"]},{"person":"guanzhang-p0016","role":"闻议","evidence":["xinyang-q-b4a51f5a525287c3bc91"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["xinyang-q-b4a51f5a525287c3bc91"]},"ordering_evidence":"xinyang-q-b4a51f5a525287c3bc91","order":5055}],"persons":[{"id":"guanzhang-p0016","name":"姜叙","facts":[],"aliases":[]},{"id":"mingdi-p0040","name":"杨阜","facts":[],"aliases":[]}],"evidence":[{"id":"xinyang-q-b4a51f5a525287c3bc91","section":"chapter-025","block":"b-82ea9da80d4764679147","layer":"original","quote":"顷之，阜以丧妻求葬假。阜外兄姜叙屯历城〖1〗。阜少长叙家，见叙母及叙，说前在冀中时事，歔欷悲甚。叙曰：“何为乃尔？”阜曰：“守城不能完，君亡不能死〖2〗，亦何面目以视息于天下〖3〗！马超背父叛君〖4〗，虐杀州将〖5〗，岂独阜之忧责，一州士大夫皆蒙其耻。君拥兵专制而无讨贼心〖6〗，此赵盾所以书弑君也〖7〗。超强而无义，多衅易图耳。”","section_title":"辛毗杨阜高堂隆传第二十五","source":{"file":"OEBPS/Text/titlepage_0056.xhtml","index":148,"anchor":null},"note_id":null,"start":0,"end":166}],"profiles":{},"directory_counts":{}}
