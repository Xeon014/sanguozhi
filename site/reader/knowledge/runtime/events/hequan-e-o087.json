{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"hequan-e-o087","title":"张承与岱书褒忠勤过廉颇","accounts":[{"id":"hequan-a-0f2683e255947d7c78ef","label":"正文","text":"张承与岱书褒忠勤过廉颇","evidence":["hequan-q-22cc7361a6e314774ba2"]}],"participants":[{"person":"wudi-p0310","role":"奋威将军与岱书、褒其忠勤相先劳谦相让、上马自超乘过廉颇也","evidence":["hequan-q-22cc7361a6e314774ba2"]},{"person":"wuzhu-p0086","role":"被褒者","evidence":["hequan-q-22cc7361a6e314774ba2"]},{"person":"xianzhu-p0115","role":"书中与岱并称者","evidence":["hequan-q-22cc7361a6e314774ba2"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["hequan-q-22cc7361a6e314774ba2"]},"ordering_evidence":"hequan-q-22cc7361a6e314774ba2","source_order":[60,218,24],"order":10628}],"persons":[{"id":"wudi-p0310","name":"张承","facts":[],"aliases":[]},{"id":"wuzhu-p0086","name":"吕岱","facts":[],"aliases":[]},{"id":"xianzhu-p0115","name":"陆逊","facts":[],"aliases":[]}],"evidence":[{"id":"hequan-q-22cc7361a6e314774ba2","section":"chapter-060","block":"b-48d20c4be4307fa1dadc","layer":"original","quote":"张承与岱书曰：“昔旦、奭翼周〖7〗，《二南》作歌〖8〗；今则足下与陆子也〖9〗。忠勤相先，劳谦相让；功以权成，化与道合。君子叹其德，小人悦其美。加以文书鞅掌〖10〗，宾客终日；疲不舍事，劳不言倦。又知上马辄自超乘〖11〗，不由跨蹑；如此，足下过廉颇也〖12〗！何其事事快也〖13〗？《周易》有之：‘礼言恭〖14〗，德言盛。’足下何有尽此美耶","section_title":"贺全吕周钟离传第十五","source":{"file":"OEBPS/Text/titlepage_0127.xhtml","index":217,"anchor":null},"note_id":null,"start":24,"end":194}],"profiles":{},"directory_counts":{}}
