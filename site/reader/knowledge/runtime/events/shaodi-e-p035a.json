{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"shaodi-e-p035a","title":"应余任南阳郡功曹","accounts":[{"id":"shaodi-e-p035a-account","label":"《楚国先贤传》","text":"应余任南阳郡功曹","evidence":["shaodi-e-p035a-q"]}],"participants":[{"person":"shaodi-p0122","role":"受任","evidence":["shaodi-e-p035a-q"]}],"place":null,"time":{"label":"建安二十三年","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["shaodi-e-p035a-q"]},"ordering_evidence":"shaodi-e-p035a-q","source_order":[4,618,"P035a"],"order":1204}],"persons":[{"id":"shaodi-p0122","name":"应余","facts":[],"aliases":[]}],"evidence":[{"id":"shaodi-e-p035a-q","section":"chapter-004","block":"b-26e03b3ad17e56cbdf8f","layer":"pei","quote":"﹝一﹞《楚国先贤传》曰：“余字子正。天姿方毅，志尚仁义。建安二十三年为郡功曹。是时吴、蜀不宾，疆埸多虞。宛将侯音，扇动山民，保城以叛。余与太守东里衮，当扰攘之际，进窜得出。音即遣骑追逐，去城十里相及；贼便射衮，飞矢交流。余前以身当箭，被七创。因谓追贼曰：‘侯音狂狡，造为凶逆，大军寻至，诛夷在近。谓卿曹本是善人，素无恶心；当思反善，何为受其指挥？我以身代君，已被重创；若身死君全，陨没无恨！’因仰天号哭泣涕，血泪俱下。贼见其义烈，释衮不害。贼去之后，余亦命绝。征南将军曹仁讨平音，表余行状，并修祭醊。太祖闻之，嗟叹良久。下荆州：复表门闾，赐谷千斛。”","attribution":"《楚国先贤传》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":25,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-7dcbf2833a9c8d0368aa","start":0,"end":275,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
