{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"hechang-e-7e0f25847516688250f9","title":"赵俨书荀彧请还绢曹操令还阳安郡民","accounts":[{"id":"hechang-a-7e0f25847516688250f9","label":"正文","text":"赵俨书荀彧请还绢曹操令还阳安郡民","evidence":["hechang-q-36d4db713e2ba6401545"]}],"participants":[{"person":"shaodi-p0016","role":"致书建议","evidence":["hechang-q-36d4db713e2ba6401545"]},{"person":"wudi-p0100","role":"转白答书","evidence":["hechang-q-36d4db713e2ba6401545"]},{"person":"cao-cao","role":"下文还绢","evidence":["hechang-q-36d4db713e2ba6401545"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["hechang-q-36d4db713e2ba6401545"]},"ordering_evidence":"hechang-q-36d4db713e2ba6401545","order":4780}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"shaodi-p0016","name":"赵俨","facts":[],"aliases":[]},{"id":"wudi-p0100","name":"荀彧","facts":[],"aliases":[]}],"evidence":[{"id":"hechang-q-36d4db713e2ba6401545","section":"chapter-023","block":"b-19f5dd71070b5f4ac752","layer":"original","quote":"乃书与荀彧曰：“今阳安郡当送绵绢，道路艰阻，必致寇害。百姓困穷，邻城并叛，易用倾荡，乃一方安危之机也。且此郡人执守忠节，在险不贰；微善必赏，则为义者劝。善为国者，藏之于民。以为国家宜垂慰抚，所敛绵绢，皆俾还之〖11〗。”彧报曰：“辄白曹公，公文下郡：绵绢悉以还民。”上下欢喜，郡内遂安。","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":250,"anchor":null},"note_id":null,"start":0,"end":143}],"profiles":{},"directory_counts":{}}
