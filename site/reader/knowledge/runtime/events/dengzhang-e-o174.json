{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dengzhang-e-o174","title":"羌胡裨姜维军资","accounts":[{"id":"dengzhang-a-0686a88a53296b3d19bf","label":"裴注·益部耆旧杂记","text":"羌胡裨姜维军资","evidence":["dengzhang-q-62fc4e59ef4ee735270f","dengzhang-q2-e10ff89d901efa1dd4ff"]}],"participants":[{"person":"shaodi-p0050","role":"大将军，每出北征","evidence":["dengzhang-q-62fc4e59ef4ee735270f"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["dengzhang-q-62fc4e59ef4ee735270f"]},"ordering_evidence":"dengzhang-q-62fc4e59ef4ee735270f","source_order":[45,384,85],"order":7993}],"persons":[{"id":"shaodi-p0050","name":"姜维","facts":[],"aliases":[]}],"evidence":[{"id":"dengzhang-q-62fc4e59ef4ee735270f","section":"chapter-045","block":"b-c785353b82c6cb3590f3","layer":"pei","quote":"大将军姜维每出北征，羌胡出马牛羊毡毦，及义谷裨军粮，国赖其资","attribution":"裴注·益部耆旧杂记","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":383,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-bf5185fbe57a5a8d3a38","start":85,"end":115,"offset_unit":"unicode_code_point"},{"id":"dengzhang-q2-e10ff89d901efa1dd4ff","section":"chapter-045","block":"b-c785353b82c6cb3590f3","layer":"pei","quote":"“王嗣字承宗，犍为资中人也。其先，延熙世，以功德显著。举孝廉，稍迁西安围督、汶山太守，加安远将军。绥集羌胡，咸悉归服，诸种素桀恶者，皆来首降；嗣待以恩信，时北境得以宁静。大将军姜维每出北征，羌胡出马牛羊毡毦，及义谷裨军粮，国赖其资。迁镇军，故领郡。后从维北征，为流矢所伤，数月卒。戎夷会葬赠送，数千人号呼涕泣。嗣为人，美厚笃至，众所爱信。嗣子及孙，羌胡见之如骨肉，或结兄弟，恩至于此。”","attribution":"裴注（引书见原文）","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":383,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-bf5185fbe57a5a8d3a38","start":0,"end":193,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
