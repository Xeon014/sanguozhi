{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"shaodi-e-p025a","title":"司马师问曹髦才性钟会对答","accounts":[{"id":"shaodi-e-p025a-account","label":"《魏氏春秋》","text":"司马师问曹髦才性钟会对答","evidence":["shaodi-e-p025a-q"]}],"participants":[{"person":"shaodi-p0038","role":"问","evidence":["shaodi-e-p025a-q"]},{"person":"shaodi-p0073","role":"答","evidence":["shaodi-e-p025a-q"]}],"place":null,"time":{"year":254,"label":"曹髦即位罢朝后","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"shaodi-y254","dating_review":{"reviewed":true,"anchor":"shaodi-q-o059","basis":"曹髦即位罢朝后"},"evidence":["shaodi-e-p025a-q","shaodi-q-o059","shaodi-q-b-91c7db3288e80e5b9e4b"]},"ordering_evidence":"shaodi-e-p025a-q","source_order":[4,331,"P025a"],"order":1134}],"persons":[{"id":"shaodi-p0038","name":"司马师","facts":[],"aliases":[]},{"id":"shaodi-p0073","name":"钟会","facts":[],"aliases":[]}],"evidence":[{"id":"shaodi-e-p025a-q","section":"chapter-004","block":"b-72c970bb40d4f6ad5140","layer":"pei","quote":"﹝一﹞《魏氏春秋》曰：“公神明爽俊，德音宣朗。罢朝，景王私曰：‘上何如主也？’钟会对曰：‘才同陈思，武类太祖。’景王曰：‘若如卿言，社稷之福也。’”","attribution":"《魏氏春秋》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":330,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b700df29adde5f0adb8e","start":0,"end":74,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-b-91c7db3288e80e5b9e4b","section":"chapter-004","block":"b-91c7db3288e80e5b9e4b","layer":"modern","quote":"〖1〗六年：嘉平六年（公元 254）。己丑：旧历初一日。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":275,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-386affd091adab4ef2df","start":0,"end":28,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o059","section":"chapter-004","block":"b-83849af55ebd17291970","layer":"original","quote":"六年春二月，己丑〖1〗，镇东将军毌丘俭上言：“昔诸葛恪围合肥新城，城中遣士刘整出围〖2〗，传消息，为贼所得。考问所传，语整曰：‘诸葛公欲活汝，汝可具服〖3〗。’整骂曰：‘死狗，此何言也！我当必死为魏国鬼！不苟求活逐汝去也。欲杀我者，便速杀之！’终无他辞。又遣士郑像出城传消息。或以语恪，恪遣马骑寻围迹索，得像还。四五人的头面缚〖4〗，将绕城表。敕语像〖5〗，使大呼，言：‘大军已还洛，不如早降！’像不从其言，更大呼城中曰：‘大军近在围外，壮士努力！’贼以刀筑其口，使不得言。像遂大呼，令城中闻知。整、像为兵，能守义执节，子弟宜有差异〖6〗。”","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":266,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":271,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
