{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhangle-e-o025a","title":"曹操遣于禁夺朱灵军","accounts":[{"id":"zhangle-e-o025a-account","label":"《张乐于张徐传第十七》正文","text":"曹操遣于禁持令夺朱灵之军，朱灵改为于禁部下督。","evidence":["zhangle-e-o025a-q"]}],"participants":[{"person":"cao-cao","role":"遣令","evidence":["zhangle-e-o025a-q"]},{"person":"wudi-p0162","role":"夺军","evidence":["zhangle-e-o025a-q"]},{"person":"wudi-p0164","role":"失军","evidence":["zhangle-e-o025a-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["zhangle-e-o025a-q"]},"ordering_evidence":"zhangle-e-o025a-q","source_order":[17,78,"O025a"],"order":3533}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0162","name":"于禁","facts":[],"aliases":[]},{"id":"wudi-p0164","name":"朱灵","facts":[],"aliases":[]}],"evidence":[{"id":"zhangle-e-o025a-q","section":"chapter-017","block":"b-4beeeaaef04a39f31bab","layer":"original","quote":"太祖常恨朱灵，欲夺其营。以禁有威重，遣禁将数十骑，赍令书，径诣灵营，夺其军；灵及其部众，莫敢动。乃以灵为禁部下督，众皆震服。其见惮如此。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":77,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":81,"end":149,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
