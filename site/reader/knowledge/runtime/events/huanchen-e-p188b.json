{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"huanchen-e-p188b","title":"泰垂涕入请诛贾充以谢天下文王不复言","accounts":[{"id":"huanchen-a-257ea6b87490a6685425","label":"裴注·干宝《晋纪》","text":"泰垂涕入请诛贾充以谢天下文王不复言","evidence":["huanchen-q-2c53e4e79f6ddf09fe15"]}],"participants":[{"person":"shaodi-p0046","role":"不至、垂涕而入、对曰诛贾充以谢天下、言惟有进于此不知其次","evidence":["huanchen-q-2c53e4e79f6ddf09fe15"]},{"person":"shaodi-p0090","role":"受命召泰","evidence":["huanchen-q-2c53e4e79f6ddf09fe15"]},{"person":"shaodi-p0131","role":"被请诛者","evidence":["huanchen-q-2c53e4e79f6ddf09fe15"]},{"person":"shaodi-p0045","role":"待泰于曲室问何以处我，闻诛贾充之对，令更思其次","evidence":["huanchen-q-2c53e4e79f6ddf09fe15"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["huanchen-q-2c53e4e79f6ddf09fe15"]},"ordering_evidence":"huanchen-q-2c53e4e79f6ddf09fe15","source_order":[22,308,31],"order":4557}],"persons":[{"id":"shaodi-p0045","name":"司马昭","facts":[],"aliases":[]},{"id":"shaodi-p0046","name":"陈泰","facts":[],"aliases":[]},{"id":"shaodi-p0090","name":"荀顗","facts":[],"aliases":[]},{"id":"shaodi-p0131","name":"贾充","facts":[],"aliases":[]}],"evidence":[{"id":"huanchen-q-2c53e4e79f6ddf09fe15","section":"chapter-022","block":"b-901797ddbd952af29d74","layer":"pei","quote":"太常陈泰不至。使其舅荀顗召之，顗至，告以可否。泰曰：‘世之论者，以泰方于舅；今舅不如泰也。’子弟内外咸共逼之，垂涕而入。王待之曲室，谓曰：‘玄伯，卿何以处我？’对曰：‘诛贾充以谢天下。’文王曰：‘为我更思其次。’泰曰：‘泰言惟有进于此，不知其次","attribution":"裴注·干宝《晋纪》","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":307,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0bbc954a34e821268698","start":31,"end":153,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
