{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"rencheng-e-286ca92e1e5b5e10cd35","title":"曹植欲因清河长公主谢帝，被迎止后负斧诣阙获复王服","accounts":[{"id":"rencheng-a-286ca92e1e5b5e10cd35","label":"裴注引《魏略》","text":"曹植欲因清河长公主谢帝，被迎止后负斧诣阙获复王服","evidence":["rencheng-q-9121cd6feb291a075377"]}],"participants":[{"person":"wudi-p0280","role":"谢罪者","evidence":["rencheng-q-9121cd6feb291a075377"]},{"person":"wudi-p0170","role":"处置者","evidence":["rencheng-q-9121cd6feb291a075377"]},{"person":"houfei-p0080","role":"曹植求见者","evidence":["rencheng-q-9121cd6feb291a075377"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["rencheng-q-9121cd6feb291a075377"]},"ordering_evidence":"rencheng-q-9121cd6feb291a075377","order":3795}],"persons":[{"id":"houfei-p0080","name":"清河长公主","facts":[],"aliases":[]},{"id":"wudi-p0170","name":"曹丕","facts":[],"aliases":[]},{"id":"wudi-p0280","name":"曹植","facts":[],"aliases":[]}],"evidence":[{"id":"rencheng-q-9121cd6feb291a075377","section":"chapter-019","block":"b-c4f19efe0dc366c28ef5","layer":"pei","quote":"﹝一﹞《魏略》曰：“初，植未到关，自念有过，宜当谢帝；乃留其从官著关东，单将两三人微行；入见清河长公主，欲因主谢。而关吏以闻，帝使人逆之，不得见。太后以为自杀也，对帝泣。会植科头负斧锧，徒跣诣阙下，帝及太后乃喜。及见之，帝犹严颜色；不与语，又不使冠履。植伏地泣涕，太后为不乐。诏乃听复王服。”","attribution":"裴注引《魏略》","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":195,"anchor":null},"note_id":"n-0a878bba935f7bb4469c","start":0,"end":146}],"profiles":{},"directory_counts":{}}
