{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhulv-e-o024","title":"权从兄豫章太守贲，女为曹公子妇；及曹公破荆州，威震南土，贲畏惧，欲遣子入质","accounts":[{"id":"zhulv-a-256021619328d0fc2d8b","label":"正文","text":"权从兄豫章太守贲，女为曹公子妇；及曹公破荆州，威震南土，贲畏惧，欲遣子入质","evidence":["zhulv-q-ed91176d1ef7a90968b0"]},{"id":"zhulv-a-924820ba127eebfbe605","label":"正文","text":"治闻之，求往见贲，为陈安危，贲由此遂止","evidence":["zhulv-q-eeafb4598bbaef21f780"]},{"id":"zhulv-a-43c024eddd22af6f4e98","label":"裴注·江表传","text":"《江表传》载治说贲：破虏昔率义兵讨董卓声冠中夏，讨逆廓定六郡，讨虏聪明神武继承洪业必克成王基应运东南，刘备远布腹心求见拯救；今曹公阻兵倾覆汉室、幼帝流离、中国萧条，岂能越长江与我争利；责其欲背骨肉之亲、违万安之计，为一女子改虑易图，失机毫厘差以千里","evidence":["zhulv-q-e0e3d6ac42ab9233d45b"]}],"participants":[{"person":"sunshi-p0027","role":"畏惧欲遣子入质者；闻而止者；被说者","evidence":["zhulv-q-ed91176d1ef7a90968b0","zhulv-q-eeafb4598bbaef21f780","zhulv-q-e0e3d6ac42ab9233d45b"]},{"person":"cao-cao","role":"破荆州威震南土、其公子娶贲女者（背景）；阻兵倾覆汉室者（背景）","evidence":["zhulv-q-ed91176d1ef7a90968b0","zhulv-q-e0e3d6ac42ab9233d45b"]},{"person":"sunshi-p0052","role":"往陈安危者；进说者","evidence":["zhulv-q-eeafb4598bbaef21f780","zhulv-q-e0e3d6ac42ab9233d45b"]},{"person":"wudi-p0119","role":"破虏将军（背景）","evidence":["zhulv-q-e0e3d6ac42ab9233d45b"]},{"person":"wudi-p0099","role":"讨逆（背景）","evidence":["zhulv-q-e0e3d6ac42ab9233d45b"]},{"person":"sun-quan","role":"讨虏（背景）","evidence":["zhulv-q-e0e3d6ac42ab9233d45b"]},{"person":"liu-bei","role":"远布腹心者（背景）","evidence":["zhulv-q-e0e3d6ac42ab9233d45b"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["zhulv-q-ed91176d1ef7a90968b0","zhulv-q-eeafb4598bbaef21f780","zhulv-q-e0e3d6ac42ab9233d45b"]},"ordering_evidence":"zhulv-q-ed91176d1ef7a90968b0","source_order":[56,23,37],"order":9964}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"sunshi-p0027","name":"孙贲","facts":[],"aliases":[]},{"id":"sunshi-p0052","name":"朱治","facts":[],"aliases":[]},{"id":"wudi-p0099","name":"孙策","facts":[],"aliases":[]},{"id":"wudi-p0119","name":"孙坚","facts":[],"aliases":[]}],"evidence":[{"id":"zhulv-q-e0e3d6ac42ab9233d45b","section":"chapter-056","block":"b-4ba7559dc4f6890a6e38","layer":"pei","quote":"破虏将军昔率义兵入讨董卓，声冠中夏：义士壮之。讨逆继世，廓定六郡；特以君侯骨肉至亲，器为时生；故表汉朝，剖符大郡，兼建将校，仍关综两府：荣冠宗室，为远近所瞻。加讨虏聪明神武，继承洪业；揽结英雄，周济世务；军众日盛，事业日隆。虽昔萧王之在河北，无以加也；必克成王基，应运东南。故刘玄德远布腹心，求见拯救。此天下所共知也。前在东，闻道路之言，云将军‘有异趣’，良用怃然！今曹公阻兵，倾覆汉室，幼帝流离；百姓元元，未知所归。而中国萧条，或百里无烟；城邑空虚，道殣相望；士叹于外，妇怨乎室；加之以师旅，因之以饥馑。以此料之，岂能越长江与我争利哉！将军当斯时也，而欲背骨肉之亲，违万安之计，割同气之肤，啖虎狼之口；为一女子，改虑易图；失机毫厘，差以千里：岂不惜哉","attribution":"裴注·江表传","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":39,"anchor":null},"note_id":"n-0a35fcb1544e7e1e70ab","start":15,"end":341},{"id":"zhulv-q-ed91176d1ef7a90968b0","section":"chapter-056","block":"b-830e1b7b03ae5a272e12","layer":"original","quote":"权从兄豫章太守贲〖13〗，女为曹公子妇〖14〗。及曹公破荆州，威震南土。贲畏惧，欲遣子入质","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":22,"anchor":null},"note_id":null,"start":37,"end":82},{"id":"zhulv-q-eeafb4598bbaef21f780","section":"chapter-056","block":"b-830e1b7b03ae5a272e12","layer":"original","quote":"治闻之，求往见贲，为陈安危；﹝一﹞贲由此遂止","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":22,"anchor":null},"note_id":null,"start":83,"end":105}],"profiles":{},"directory_counts":{}}
