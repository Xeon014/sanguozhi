{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xuhuwang-e-cfe6b2499af254ba05f6","title":"胡质辞张辽请治中说辽与武周复和","accounts":[{"id":"xuhuwang-a-cfe6b2499af254ba05f6","label":"正文","text":"胡质辞张辽请治中说辽与武周复和","evidence":["xuhuwang-q-492c0be1aba021b02cb1"]}],"participants":[{"person":"mingdi-p0047","role":"辞请劝和","evidence":["xuhuwang-q-492c0be1aba021b02cb1"]},{"person":"wudi-p0178","role":"求请复和","evidence":["xuhuwang-q-492c0be1aba021b02cb1"]},{"person":"wendi-p0086","role":"复和","evidence":["xuhuwang-q-492c0be1aba021b02cb1"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["xuhuwang-q-492c0be1aba021b02cb1"]},"ordering_evidence":"xuhuwang-q-492c0be1aba021b02cb1","order":5309}],"persons":[{"id":"mingdi-p0047","name":"胡质","facts":[],"aliases":[]},{"id":"wendi-p0086","name":"武周","facts":[],"aliases":[]},{"id":"wudi-p0178","name":"张辽","facts":[],"aliases":[]}],"evidence":[{"id":"xuhuwang-q-492c0be1aba021b02cb1","section":"chapter-027","block":"b-f4fb197aeb5241edd0b4","layer":"original","quote":"州请为治中〖10〗。将军张辽与其护军武周有隙。辽见刺史温恢求请质〖11〗，质辞以疾。辽出谓质曰：“仆委意于君，何以相辜如此？”质曰：“古人之交也，取多知其不贪〖12〗，奔北知其不怯〖13〗，闻流言而不信；故可终也。武伯南身为雅士〖14〗，往者将军称之不容于口；今以睚眦之恨〖15〗，﹝二﹞乃成嫌隙；况质才薄，岂能终好？是以不愿也。”辽感言，复与周平〖16〗。","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":62,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":179,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
