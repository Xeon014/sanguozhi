{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"hechang-e-e8a249a5a5c8373a080c","title":"王象荐复守南阳的杨俊还朝","accounts":[{"id":"hechang-a-e8a249a5a5c8373a080c","label":"正文","text":"王象荐复守南阳的杨俊还朝","evidence":["hechang-q-2d7d3826f2ff061c20bb"]}],"participants":[{"person":"cuimao-p0041","role":"任南阳太守","evidence":["hechang-q-2d7d3826f2ff061c20bb"]},{"person":"xiahoucao-p0084","role":"荐举","evidence":["hechang-q-2d7d3826f2ff061c20bb"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["hechang-q-2d7d3826f2ff061c20bb"]},"ordering_evidence":"hechang-q-2d7d3826f2ff061c20bb","order":4736}],"persons":[{"id":"cuimao-p0041","name":"杨俊","facts":[],"aliases":[]},{"id":"xiahoucao-p0084","name":"王象","facts":[],"aliases":[]}],"evidence":[{"id":"hechang-q-2d7d3826f2ff061c20bb","section":"chapter-023","block":"b-15e74fbb83c4abf58213","layer":"original","quote":"文帝践阼，复在南阳。时王象为散骑常侍，荐俊曰：“伏见南阳太守杨俊，秉纯粹之茂质，履忠肃之弘量；体仁足以育物，笃实足以动众〖1〗；克长后进〖2〗，惠训不倦；外宽内直，仁而有断。自初弹冠〖3〗，所历垂化〖4〗；再守南阳〖5〗，恩德流著；殊邻异党〖6〗，襁负而至〖7〗。今境守清静，无所展其智能；宜还本朝，宣力辇毂〖8〗，熙帝之载〖9〗。”","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":166,"anchor":null},"note_id":null,"start":0,"end":167}],"profiles":{},"directory_counts":{}}
