{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dongyuan-e-p016a","title":"尚书宣读废刘辩何太后立刘协策丁宫称善","accounts":[{"id":"dongyuan-e-p016a-account","label":"《献帝起居注》","text":"尚书宣读废刘辩何太后立刘协策丁宫称善","evidence":["dongyuan-e-p016a-q"]}],"participants":[{"person":"wudi-p0049","role":"被废","evidence":["dongyuan-e-p016a-q"]},{"person":"wudi-p0050","role":"还政","evidence":["dongyuan-e-p016a-q"]},{"person":"wudi-p0054","role":"被立","evidence":["dongyuan-e-p016a-q"]},{"person":"dongyuan-p0063","role":"赞议","evidence":["dongyuan-e-p016a-q"]}],"place":null,"time":{"label":"废少帝时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-p016a-q"]},"ordering_evidence":"dongyuan-e-p016a-q","source_order":[6,56,"P016a"],"order":1503}],"persons":[{"id":"dongyuan-p0063","name":"丁宫","facts":[],"aliases":[]},{"id":"wudi-p0049","name":"刘辩","facts":[],"aliases":[]},{"id":"wudi-p0050","name":"何太后","facts":[],"aliases":[]},{"id":"wudi-p0054","name":"汉献帝","facts":[],"aliases":[]}],"evidence":[{"id":"dongyuan-e-p016a-q","section":"chapter-006","block":"b-3a3a3bfdb7e407ad21bb","layer":"pei","quote":"策曰：‘孝灵皇帝不究高宗眉寿之祚，早弃臣子。皇帝承绍，海内侧望。而帝天姿轻佻，威仪不恪；在丧慢惰，衰如故焉。凶德既彰，淫秽发闻；损辱神器，忝污宗庙。皇太后教无母仪，统政荒乱。永乐太后暴崩，众论惑焉。三纲之道，天地之纪，而乃有阙，罪之大者。陈留王协，圣德伟茂，规矩邈然；丰下兑上，有尧图之表。居丧哀戚，言不及邪；岐嶷之性，有周成之懿。休声美称，天下所闻。宜承洪业，为万世统，可以承宗庙。废皇帝为弘农王。皇太后还政。’尚书读册毕，群臣莫有言。尚书丁宫曰：‘天祸汉室，丧乱弘多。昔祭仲废忽立突，《春秋》大其权。今大臣量宜为社稷计，诚合天人，请称“万岁”。’","attribution":"《献帝起居注》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":55,"anchor":null},"note_id":"n-04146f894cef8a06feb3","start":10,"end":285}],"profiles":{},"directory_counts":{}}
