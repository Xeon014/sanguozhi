{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"lvzang-e-o080","title":"杨受傕汜购募外许内护布诏以布为颍川太守","accounts":[{"id":"lvzang-a-5c2931022076561d0c47","label":"裴注·英雄记","text":"杨受傕汜购募外许内护布诏以布为颍川太守","evidence":["lvzang-q-a8bac1ecd116712cb9d8"]}],"participants":[{"person":"wudi-p0123","role":"及部曲诸将皆受傕汜购募共图布、外许汜傕内实保护布","evidence":["lvzang-q-a8bac1ecd116712cb9d8"]},{"person":"wudi-p0088","role":"闻之谓杨曰布卿州里也卿杀布于卿弱不如卖布可极得汜傕爵宠","evidence":["lvzang-q-a8bac1ecd116712cb9d8"]},{"person":"wudi-p0089","role":"与汜购募图布、患之、更下大封诏书以布为颍川太守","evidence":["lvzang-q-a8bac1ecd116712cb9d8"]},{"person":"wudi-p0090","role":"与傕购募图布、患之、下大封诏书以布为颍川太守","evidence":["lvzang-q-a8bac1ecd116712cb9d8"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["lvzang-q-a8bac1ecd116712cb9d8"]},"ordering_evidence":"lvzang-q-a8bac1ecd116712cb9d8","source_order":[7,42,11],"order":1798}],"persons":[{"id":"wudi-p0088","name":"吕布","facts":[],"aliases":[]},{"id":"wudi-p0089","name":"李傕","facts":[],"aliases":[]},{"id":"wudi-p0090","name":"郭汜","facts":[],"aliases":[]},{"id":"wudi-p0123","name":"张杨","facts":[],"aliases":[]}],"evidence":[{"id":"lvzang-q-a8bac1ecd116712cb9d8","section":"chapter-007","block":"b-26bfcb8938a83a3494de","layer":"pei","quote":"杨及部曲诸将，皆受傕、汜购募，共图布。布闻之，谓杨曰：‘布，卿州里也。卿杀布，于卿弱；不如卖布，可极得汜、傕爵宠。’杨于是外许汜、傕，内实保护布。汜、傕患之，更下大封诏书，以布为颍川太守","attribution":"裴注·英雄记","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":41,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-d4cb01724584cb47e01f","start":11,"end":104,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
