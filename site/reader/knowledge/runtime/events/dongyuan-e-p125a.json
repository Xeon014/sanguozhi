{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dongyuan-e-p125a","title":"曹操欲妻周不疑不受曹冲卒后遣刺客杀之曹丕谏不止","accounts":[{"id":"dongyuan-e-p125a-account","label":"《先贤传》","text":"曹操欲以女妻周不疑，不疑不受；曹冲死后，曹操拒曹丕之谏遣刺客杀不疑。","evidence":["dongyuan-e-p125a-q"]}],"participants":[{"person":"cao-cao","role":"议婚遣刺","evidence":["dongyuan-e-p125a-q"]},{"person":"dongyuan-p0187","role":"辞婚被杀","evidence":["dongyuan-e-p125a-q"]},{"person":"wudi-p0170","role":"谏诤","evidence":["dongyuan-e-p125a-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-p125a-q"]},"ordering_evidence":"dongyuan-e-p125a-q","source_order":[6,510,"P125a"],"order":1782}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"dongyuan-p0187","name":"周不疑","facts":[],"aliases":[]},{"id":"wudi-p0170","name":"曹丕","facts":[],"aliases":[]}],"evidence":[{"id":"dongyuan-e-p125a-q","section":"chapter-006","block":"b-359c0d550c2e4b58c3fc","layer":"pei","quote":"不疑幼有异才，聪明敏达；太祖欲以女妻之，不疑不敢当。太祖爱子仓舒，夙有才智，谓可与不疑为俦。及仓舒卒，太祖心忌不疑，欲除之。文帝谏以为不可，太祖曰：‘此人非汝所能驾御也。’乃遣刺客杀之。","attribution":"《先贤传》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":509,"anchor":null},"note_id":"n-0ebae0c8750bf2131337","start":24,"end":117}],"profiles":{},"directory_counts":{}}
