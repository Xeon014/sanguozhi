{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xumisun-e2-hansui-mateng-letters","title":"韩遂马腾与刘焉通信","accounts":[{"id":"xumisun-a2-28e86af42e928f5b3722","label":"裴注（引书见原文）","text":"韩遂马腾与刘焉通信","evidence":["xumisun-q2-32ebad95f174eacfb5f3"]}],"participants":[{"person":"wudi-p0048","role":"与刘焉通信","evidence":["xumisun-q2-32ebad95f174eacfb5f3"]},{"person":"guanzhang-p0013","role":"与刘焉通信","evidence":["xumisun-q2-32ebad95f174eacfb5f3"]},{"person":"gongsuntao-p0021","role":"通信对象","evidence":["xumisun-q2-32ebad95f174eacfb5f3"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"第二轮逐项审定；仅保原文时序，不另行推年。","evidence":["xumisun-q2-32ebad95f174eacfb5f3"]},"ordering_evidence":"xumisun-q2-32ebad95f174eacfb5f3","order":7032}],"persons":[{"id":"gongsuntao-p0021","name":"刘焉","facts":[],"aliases":[]},{"id":"guanzhang-p0013","name":"马腾","facts":[],"aliases":[]},{"id":"wudi-p0048","name":"韩遂","facts":[],"aliases":[]}],"evidence":[{"id":"xumisun-q2-32ebad95f174eacfb5f3","section":"chapter-038","block":"b-015fe050c1e38820e503","layer":"pei","quote":"﹝五﹞《益州耆旧传》曰：“商字文表，广汉人。以才学称，声问著于州里。刘璋辟为治中从事。是时王途隔绝，州之牧伯，犹七国之诸侯也；而璋懦弱多疑，不能党信大臣。商奏记谏璋，璋颇感悟。初，韩遂与马腾，作乱关中，数与璋父焉交通信；至腾子超，复与璋相闻，有连蜀之意。商谓璋曰：‘超勇而不仁，见得不思义，不可以为唇齿。《老子》曰：“国之利器，不可以示人。”今之益部，士美民丰，宝物所出；斯乃狡夫所欲倾覆，超等所以西望也。若引而近之，则犹养虎，将自遗患矣。’璋从其言，乃拒绝之。荆州牧刘表及儒者宋忠，咸闻其名，遗书与商，叙致殷勤。许靖号为臧否，至蜀，见商而称之曰：‘设使商生于华夏，虽王景兴无以加也！’璋以商为蜀郡大守。成都禽坚，有至孝之行，商表其墓，追赠孝廉。又与严君平、李弘立祠作铭，以旌先贤。修学广农，百姓便之。在郡十载，卒于官；许靖代之。”","attribution":"裴注（引书见原文）","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":146,"anchor":null},"note_id":"n-e690f802ed6909fadf71","start":0,"end":366}],"profiles":{},"directory_counts":{}}
