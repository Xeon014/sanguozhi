{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wgc-e-5-e42","title":"钟会斩治道之许仪","order":5770,"accounts":[{"id":"wgc-a-5-e42","label":"正文 · 景元四年","text":"钟会斩治道之许仪","evidence":["wgc-q0452","wgc-q0071"]},{"id":"lizang-a-219c19b2ba1db9a2e0a9","label":"正文","text":"许仪为钟会所杀","evidence":["lizang-q-77c96371a3b2cd939086"]}],"participants":[{"person":"shaodi-p0073","role":"命许仪治道、桥穿马足陷、斩仪、犹不原贷","evidence":["wgc-q0452","wgc-q0071"]},{"person":"wgc-p0044","role":"在前治道、被斩","evidence":["wgc-q0452","wgc-q0071"]}],"place":null,"time":{"label":"景元四年","precision":"year","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0452","wgc-q0071","wgc-q0070","wgc-q0450"],"year":263,"chronology":"wgc-y-5-e42","dating_review":{"reviewed":true,"anchor":"wgc-q0071","basis":"逐项对读原行动及直接释年注，保留原季月，不沿用后续迁官。"}},"ordering_evidence":"wgc-q0452"}],"persons":[{"id":"shaodi-p0073","name":"钟会","facts":[],"aliases":[]},{"id":"wgc-p0044","name":"许仪","facts":[],"aliases":[]}],"evidence":[{"id":"lizang-q-77c96371a3b2cd939086","section":"chapter-018","block":"b-3703f6dd2f88633384a8","layer":"original","quote":"仪为钟会所杀","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":137,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":28,"end":34,"offset_unit":"unicode_code_point"},{"id":"wgc-q0070","section":"chapter-028","block":"b-a8c7cff17ae8b7e5d8a8","layer":"original","quote":"四年秋〖1〗，乃下诏使邓艾、诸葛绪各统诸军三万余人：艾趋甘松、沓中，连缀维；绪趋武街，桥头〖2〗，绝维归路。会统十余万众，分从斜谷、骆谷入〖3〗。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":471,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":73,"offset_unit":"unicode_code_point"},{"id":"wgc-q0071","section":"chapter-028","block":"b-afe1f03c03c6678f28f4","layer":"original","quote":"先命牙门将许仪在前治道〖4〗，会在后行；而桥穿，马足陷，于是斩仪。仪者，许褚之子；有功王室，犹不原贷。诸军闻之，莫不震竦。蜀令诸围皆不得战〖5〗，退还汉、乐二城守〖6〗。魏兴太守刘钦趋子午谷，诸军数道平行，至汉中。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":472,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":107,"offset_unit":"unicode_code_point"},{"id":"wgc-q0450","section":"chapter-028","block":"b-219fc93bca7450fde6e4","layer":"modern","quote":"〖1〗四年：景元四年（公元 263）。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":481,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-73de38374e0e0ac03994","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wgc-q0452","section":"chapter-028","block":"b-afe1f03c03c6678f28f4","layer":"original","quote":"先命牙门将许仪在前治道〖4〗，会在后行；而桥穿，马足陷，于是斩仪。仪者，许褚之子；有功王室，犹不原贷。诸军闻之，莫不震竦","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":472,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":60,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
