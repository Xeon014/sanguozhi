{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wufan-e-a34f434a9050ea455783","title":"孙辅异之，以刘惇为军师","accounts":[{"id":"wufan-a-a34f434a9050ea455783","label":"正文","text":"孙辅异之，以刘惇为军师","evidence":["wufan-q-a589ac9a55c31dc88fa4"]}],"participants":[{"person":"sunshi-p0051","role":"任以为军师者","evidence":["wufan-q-a589ac9a55c31dc88fa4"]},{"person":"wufan-p-68c6a8b7006d7d","role":"受任军师者","evidence":["wufan-q-a589ac9a55c31dc88fa4"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["wufan-q-a589ac9a55c31dc88fa4"]},"ordering_evidence":"wufan-q-a589ac9a55c31dc88fa4","order":10879}],"persons":[{"id":"sunshi-p0051","name":"孙辅","facts":[],"aliases":[]},{"id":"wufan-p-68c6a8b7006d7d","name":"刘惇","facts":[],"aliases":[]}],"evidence":[{"id":"wufan-q-a589ac9a55c31dc88fa4","section":"chapter-063","block":"b-4756992061338dc7e698","layer":"original","quote":"每有水旱寇贼，皆先时处期〖4〗，无不中者。辅异焉，以为军师。军中咸敬事之，号曰“神明”。建安中，孙权在豫章。时有星变〖5〗，以问惇。惇曰：“灾在丹杨。”权曰：“何如？”曰：“客胜主人。到某日，当得问〖6〗。”是时边鸿作乱〖7〗，卒如惇言。","section_title":"吴范刘惇赵达传第十八","source":{"file":"OEBPS/Text/titlepage_0133.xhtml","index":54,"anchor":null},"note_id":null,"start":0,"end":119}],"profiles":{},"directory_counts":{}}
