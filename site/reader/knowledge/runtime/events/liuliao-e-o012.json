{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"liuliao-e-o012","title":"彭羕荐秦宓于许靖","accounts":[{"id":"liuliao-a-9effe545d007d542e7ff","label":"正文","text":"彭羕荐秦宓于许靖","evidence":["liuliao-q-20caedd4a9cadd6c705a"]}],"participants":[{"person":"xianzhu-p0064","role":"荐秦宓于太守许靖","evidence":["liuliao-q-20caedd4a9cadd6c705a"]},{"person":"liuliao-p0008","role":"被荐者","evidence":["liuliao-q-20caedd4a9cadd6c705a"]},{"person":"xianzhu-p0059","role":"受荐书者","evidence":["liuliao-q-20caedd4a9cadd6c705a"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liuliao-q-20caedd4a9cadd6c705a"]},"ordering_evidence":"liuliao-q-20caedd4a9cadd6c705a","source_order":[40,81,0],"order":7256}],"persons":[{"id":"liuliao-p0008","name":"秦宓","facts":[],"aliases":[]},{"id":"xianzhu-p0059","name":"许靖","facts":[],"aliases":[]},{"id":"xianzhu-p0064","name":"彭羕","facts":[],"aliases":[]}],"evidence":[{"id":"liuliao-q-20caedd4a9cadd6c705a","section":"chapter-040","block":"b-62685cfcf25eb40f88cd","layer":"original","quote":"彭羕字永年，广汉人。身长八尺，容貌甚伟。姿性骄傲，多所轻忽；惟敬同郡秦子敕〖1〗，荐之于太守许靖曰：“昔高宗梦傅说〖2〗，周文求吕尚〖3〗；爰及汉祖，纳食其于布衣〖4〗。此乃帝王之所以倡业垂统〖5〗，缉熙厥功也〖6〗。今明府稽古皇极〖7〗，允执神灵〖8〗；体公刘之德〖9〗，行勿践之惠〖10〗；《清庙》之作于是乎始〖11〗，褒贬之义于是乎兴。然而六翮未之备也〖12〗。伏见处士绵竹秦宓：膺山甫之德〖13〗，履隽生之直〖14〗；枕石漱流，吟咏缊袍〖15〗；偃息于仁义之途〖16〗，恬淡于浩然之域；高概节行，守真不亏。虽古人潜遁，蔑以加旃〖17〗！若明府能招致此人，必有忠谠落落之誉〖18〗，丰功厚利，建迹（之）〔立〕勋；然后纪功于王府，飞声于来世。不亦美哉！”","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":80,"anchor":null},"note_id":null,"start":0,"end":329}],"profiles":{},"directory_counts":{}}
