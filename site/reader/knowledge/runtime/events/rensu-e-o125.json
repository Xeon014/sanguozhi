{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"rensu-e-o125","title":"郡界患水涝百姓饥乏，郑浑于萧、相二县界兴陂堨开稻田，郡人皆以为不便，浑谓地势洿下宜溉灌、终有鱼稻经久之利","accounts":[{"id":"rensu-a-786516f0c6bad0e017d8","label":"正文","text":"郡界患水涝百姓饥乏，郑浑于萧、相二县界兴陂堨开稻田，郡人皆以为不便，浑谓地势洿下宜溉灌、终有鱼稻经久之利","evidence":["rensu-q-0ed38237e575e30b127c"]},{"id":"rensu-a-051fa52e577556fa5225","label":"正文","text":"郑浑躬率吏民兴立功夫，一冬间皆成；比年大收，顷亩岁增，租入倍常；民刻石颂之，号曰\"郑陂\"","evidence":["rensu-q-9198cbf44f7b6ceb4a2b"]}],"participants":[{"person":"wendi-p0084","role":"兴陂主政者；躬率兴修者","evidence":["rensu-q-0ed38237e575e30b127c","rensu-q-9198cbf44f7b6ceb4a2b"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["rensu-q-0ed38237e575e30b127c","rensu-q-9198cbf44f7b6ceb4a2b"]},"ordering_evidence":"rensu-q-0ed38237e575e30b127c","source_order":[16,340,29],"order":3456}],"persons":[{"id":"wendi-p0084","name":"郑浑","facts":[],"aliases":[]}],"evidence":[{"id":"rensu-q-0ed38237e575e30b127c","section":"chapter-016","block":"b-3162d819a45ee9752dd7","layer":"original","quote":"郡界下湿，患水涝，百姓饥乏。浑于萧、相二县界，兴陂堨，开稻田。郡人皆以为不便，浑曰：“地势洿下，宜溉灌，终有鱼稻经久之利。此丰民之本也","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":339,"anchor":null},"note_id":null,"start":29,"end":96},{"id":"rensu-q-9198cbf44f7b6ceb4a2b","section":"chapter-016","block":"b-3162d819a45ee9752dd7","layer":"original","quote":"遂躬率吏民，兴立功夫〖2〗，一冬间皆成。比年大收，顷亩岁增，租入倍常。民赖其利，刻石颂之，号曰“郑陂”","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":339,"anchor":null},"note_id":null,"start":98,"end":149}],"profiles":{},"directory_counts":{}}
