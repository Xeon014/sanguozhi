{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p086d","title":"曹操获梁鹄任其书写","accounts":[{"id":"wudi-e-p086d-account","label":"卫恒《四体书势序》","text":"荆州平后曹操寻访梁鹄，梁鹄自缚来见，受署军假司马在秘书供职；曹操喜爱其书。","evidence":["wudi-e-p086d-q"]}],"participants":[{"person":"cao-cao","role":"寻访任用","evidence":["wudi-e-p086d-q"]},{"person":"wudi-p0258","role":"归附任职","evidence":["wudi-e-p086d-q"]}],"place":{"text":"荆州","evidence":["wudi-e-p086d-q"]},"time":{"label":"荆州平后","year":208,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-p086d-q","wudi-q-o119","wudi-q-b-888495d8be7766faf20c"],"chronology":"wudi-y208","dating_review":{"anchor":"wudi-q-o119","basis":"荆州平后","reviewed":true}},"source_order":[1,688,"P086d"],"order":283}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0258","name":"梁鹄","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-p086d-q","section":"chapter-001","block":"b-648d7c68dbec5a605916","layer":"pei","quote":"及荆州平，公募求鹄；鹄惧，自缚诣门。署军假司马，使在秘书，以勤书自效。公常悬著帐中，及以钉壁玩之，谓胜宜官。","attribution":"卫恒《四体书势序》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":12,"anchor":null},"note_id":"n-cf8a0075075368325cde","start":114,"end":168},{"id":"wudi-q-b-888495d8be7766faf20c","section":"chapter-001","block":"b-888495d8be7766faf20c","layer":"modern","quote":"〖1〗十三年：建安十三年（公元 208）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":666,"anchor":null},"note_id":"n-0bae348fdb687025113d","start":0,"end":21},{"id":"wudi-q-o119","section":"chapter-001","block":"b-4bcffcc4ee709a4e5ea3","layer":"original","quote":"十三年春正月〖1〗，公还邺。作玄武池以肄舟师〖2〗。﹝一﹞汉罢三公官，置丞相、御史大夫〖3〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":661,"anchor":null},"note_id":null,"start":0,"end":47}],"profiles":{},"directory_counts":{}}
