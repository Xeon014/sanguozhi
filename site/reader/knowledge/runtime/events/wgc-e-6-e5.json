{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wgc-e-6-e5","title":"姜维自沓中还欲赴关城","order":5775,"accounts":[{"id":"wgc-a-6-e5","label":"正文","text":"姜维自沓中还欲赴关城","evidence":["wgc-q0459","wgc-q0072"]}],"participants":[{"person":"shaodi-p0050","role":"自沓中还、至阴平合集士众、欲赴关城","evidence":["wgc-q0459","wgc-q0072"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0459","wgc-q0072"]},"ordering_evidence":"wgc-q0459"}],"persons":[{"id":"shaodi-p0050","name":"姜维","facts":[],"aliases":[]}],"evidence":[{"id":"wgc-q0072","section":"chapter-028","block":"b-78045a2622266a435eeb","layer":"original","quote":"蜀监军王含守乐城，护军蒋斌守汉城，兵各五千。会使护军荀恺、前将军李辅各统万人：恺围汉城，辅围乐城。会径过，西出阳安口〖7〗，遣人祭诸葛亮之墓〖8〗。使护军胡烈等行前，攻破关城〖9〗，得库藏积谷。姜维自沓中还，至阴平，合集士众，欲赴关城。未到，闻其已破，退趋白水，与蜀将张翼、廖化等合守剑阁拒会〖10〗。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":473,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":151,"offset_unit":"unicode_code_point"},{"id":"wgc-q0459","section":"chapter-028","block":"b-78045a2622266a435eeb","layer":"original","quote":"姜维自沓中还，至阴平，合集士众，欲赴关城","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":473,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":97,"end":117,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
