{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"gongsuntao-e-o028","title":"虞举兵袭瓒败奔居庸瓒攻拔生获虞执还蓟","accounts":[{"id":"gongsuntao-a-5c6b1e831d05dec1cc36","label":"正文","text":"虞举兵袭瓒败奔居庸瓒攻拔生获虞执还蓟","evidence":["gongsuntao-q-bdbeb3ef3aa2c49019d7"]},{"id":"gongsuntao-a-a213b9d55fad7e144fc9","label":"裴注·魏氏春秋","text":"攸病死后虞密令众袭瓒","evidence":["gongsuntao-q-926438f971064a631998"]},{"id":"gongsuntao-a-b2307a29bc994f2456c3","label":"裴注·魏氏春秋","text":"虞兵无部伍瓒放火精锐冲突虞众溃被害","evidence":["gongsuntao-q-c361510b2083ca5ca463"]}],"participants":[{"person":"wudi-p0079","role":"惧瓒为变、举兵袭瓒、为瓒所败出奔居庸、被生获；又与官属议、密令众袭瓒；兵无部伍不习战、又爱民屋敕令勿烧、众大溃奔居庸城","evidence":["gongsuntao-q-bdbeb3ef3aa2c49019d7","gongsuntao-q-926438f971064a631998","gongsuntao-q-c361510b2083ca5ca463"]},{"person":"wudi-p0093","role":"败虞、攻拔居庸、生获虞执虞还蓟；部曲放散在外、自惧败掘东城门欲走、得放火因以精锐冲突、攻及家属以还、杀害州府衣冠善士殆尽","evidence":["gongsuntao-q-bdbeb3ef3aa2c49019d7","gongsuntao-q-c361510b2083ca5ca463"]},{"person":"gongsuntao-p0085","role":"后一年病死","evidence":["gongsuntao-q-926438f971064a631998"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["gongsuntao-q-bdbeb3ef3aa2c49019d7","gongsuntao-q-926438f971064a631998","gongsuntao-q-c361510b2083ca5ca463"]},"ordering_evidence":"gongsuntao-q-bdbeb3ef3aa2c49019d7","source_order":[8,72,0],"order":1948}],"persons":[{"id":"gongsuntao-p0085","name":"魏攸","facts":[],"aliases":[]},{"id":"wudi-p0079","name":"刘虞","facts":[],"aliases":[]},{"id":"wudi-p0093","name":"公孙瓒","facts":[],"aliases":[]}],"evidence":[{"id":"gongsuntao-q-926438f971064a631998","section":"chapter-008","block":"b-deb9c214938ab961b032","layer":"pei","quote":"后一年，攸病死。虞又与官属议，密令众袭瓒","attribution":"裴注·魏氏春秋","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":94,"anchor":null},"note_id":"n-797c280929a2aef5d86a","start":149,"end":169},{"id":"gongsuntao-q-bdbeb3ef3aa2c49019d7","section":"chapter-008","block":"b-8b368e19f10d3af815d3","layer":"original","quote":"虞惧瓒为变，遂举兵袭瓒；虞为瓒所败，出奔居庸〖1〗。瓒攻拔居庸，生获虞，执虞还蓟","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":71,"anchor":null},"note_id":null,"start":0,"end":40},{"id":"gongsuntao-q-c361510b2083ca5ca463","section":"chapter-008","block":"b-deb9c214938ab961b032","layer":"pei","quote":"瓒部曲放散在外，自惧败，掘东城门欲走。虞兵无部伍，不习战；又爱民屋，敕令勿烧。故瓒得放火，因以精锐冲突。虞众大溃，奔居庸城。瓒攻及家属以还，杀害州府衣冠，善士殆尽","attribution":"裴注·魏氏春秋","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":94,"anchor":null},"note_id":"n-797c280929a2aef5d86a","start":170,"end":251}],"profiles":{},"directory_counts":{}}
