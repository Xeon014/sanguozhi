{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o020a","title":"王允吕布杀董卓","accounts":[{"id":"wudi-e-o020a-account","label":"正文","text":"王允与吕布共同杀死董卓。","evidence":["wudi-e-o020a-q"]},{"id":"dongyuan-e-o015a-account","label":"《董二袁刘传第六》正文","text":"李肃奉吕布命刺董卓吕布宣诏杀卓","evidence":["dongyuan-e-o015a-q"]},{"id":"wgc-a-0-e1","label":"正文","text":"王允诛董卓","evidence":["wgc-q0142","wgc-q0001"]},{"id":"lvzang-a-aa4419531ec863ac25fd","label":"正文","text":"布许允手刃刺卓","evidence":["lvzang-q-980e4b285e4d8f548875"]}],"participants":[{"person":"wudi-p0087","role":"参与诛杀","evidence":["wudi-e-o020a-q"]},{"person":"wudi-p0088","role":"参与诛杀","evidence":["wudi-e-o020a-q"]},{"person":"wudi-p0053","role":"被杀","evidence":["wudi-e-o020a-q"]},{"person":"dongyuan-p0010","role":"刺杀","evidence":["dongyuan-e-o015a-q"]}],"place":null,"time":{"label":"初平三年夏四月","year":192,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o020a-q","wudi-q-o019","wudi-q-b-3863a19b555811d1f415"],"chronology":"wudi-y192","dating_review":{"anchor":"wudi-q-o019","basis":"初平三年夏四月","reviewed":true}},"source_order":[1,161,"O020a"],"order":78}],"persons":[{"id":"dongyuan-p0010","name":"李肃","facts":[],"aliases":[]},{"id":"wudi-p0053","name":"董卓","facts":[],"aliases":[]},{"id":"wudi-p0087","name":"王允","facts":[],"aliases":[]},{"id":"wudi-p0088","name":"吕布","facts":[],"aliases":[]}],"evidence":[{"id":"dongyuan-e-o015a-q","section":"chapter-006","block":"b-f9747e419c3e6d3b3ded","layer":"original","quote":"是时，天子有疾新愈，大会未央殿。布使同郡骑都尉李肃等，将亲兵十余人，伪著卫士服，守掖门。布怀诏书。卓至，肃等格卓；卓惊呼：“布所在〖3〗？”布曰：“有诏！”遂杀卓，","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":118,"anchor":null},"note_id":null,"start":0,"end":82},{"id":"lvzang-q-980e4b285e4d8f548875","section":"chapter-007","block":"b-173e74345a2db4910d3a","layer":"original","quote":"布遂许之，手刃刺卓","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":24,"anchor":null},"note_id":null,"start":0,"end":9},{"id":"wgc-q0001","section":"chapter-028","block":"b-896a3eb8d1574d15437e","layer":"original","quote":"王凌字彦云，太原祁人也〖1〗。叔父允〖2〗，为汉司徒，诛董卓。卓将李傕、郭汜等为卓报仇〖3〗，入长安，杀允，尽害其家。凌及兄晨，时年皆少；逾城得脱，亡命归乡里。凌举孝廉，为发干长。﹝一﹞稍迁至中山太守，所在有治。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":1,"anchor":null},"note_id":null,"start":0,"end":106},{"id":"wgc-q0142","section":"chapter-028","block":"b-896a3eb8d1574d15437e","layer":"original","quote":"为汉司徒，诛董卓","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":1,"anchor":null},"note_id":null,"start":22,"end":30},{"id":"wudi-e-o020a-q","section":"chapter-001","block":"b-cdac46ba3c53b50c81e1","layer":"original","quote":"夏四月，司徒王允与吕布共杀卓〖1〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":160,"anchor":null},"note_id":null,"start":0,"end":18},{"id":"wudi-q-b-3863a19b555811d1f415","section":"chapter-001","block":"b-3863a19b555811d1f415","layer":"modern","quote":"〖1〗三年：初平三年（公元 192）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":152,"anchor":null},"note_id":"n-2063caf2b642ce9ff2bc","start":0,"end":19},{"id":"wudi-q-o019","section":"chapter-001","block":"b-43620706e925cc9a268c","layer":"original","quote":"三年春〖1〗，太祖军顿丘，毒等攻东武阳。太祖乃引兵西入山，攻毒等本屯〖2〗。﹝一﹞毒闻之，弃武阳还〖3〗。太祖要击眭固〖4〗，又击匈奴于夫罗于内黄〖5〗，皆大破之。﹝二﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":150,"anchor":null},"note_id":null,"start":0,"end":85}],"profiles":{},"directory_counts":{}}
