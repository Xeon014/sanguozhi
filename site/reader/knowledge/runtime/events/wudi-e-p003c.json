{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p003c","title":"曹腾升迁并荐举人才","accounts":[{"id":"wudi-e-p003c-account","label":"《续汉书》","text":"《续汉书》记曹腾在顺帝即位后升迁，并荐举虞放、边韶等人，未自夸其功。","evidence":["wudi-e-p003c-q"]}],"participants":[{"person":"wudi-p0002","role":"升迁荐贤","evidence":["wudi-e-p003c-q"]},{"person":"wudi-p0018","role":"获荐","evidence":["wudi-e-p003c-q"]},{"person":"wudi-p0019","role":"获荐","evidence":["wudi-e-p003c-q"]},{"person":"wudi-p0020","role":"获荐","evidence":["wudi-e-p003c-q"]},{"person":"wudi-p0021","role":"获荐","evidence":["wudi-e-p003c-q"]},{"person":"wudi-p0022","role":"获荐","evidence":["wudi-e-p003c-q"]},{"person":"wudi-p0023","role":"获荐","evidence":["wudi-e-p003c-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p003c-q"]},"source_order":[1,15,"P003c"],"order":5}],"persons":[{"id":"wudi-p0002","name":"曹腾","facts":[],"aliases":[]},{"id":"wudi-p0018","name":"虞放","facts":[],"aliases":[]},{"id":"wudi-p0019","name":"边韶","facts":[],"aliases":[]},{"id":"wudi-p0020","name":"延固","facts":[],"aliases":[]},{"id":"wudi-p0021","name":"张温","facts":[],"aliases":[]},{"id":"wudi-p0022","name":"张奂","facts":[],"aliases":[]},{"id":"wudi-p0023","name":"堂谿典","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-p003c-q","section":"chapter-001","block":"b-5e6a7e419a7747bd1cda","layer":"pei","quote":"顺帝即位，为小黄门，迁至中常侍、大长秋。在省闼三十余年，历事四帝，未尝有过。好进达贤能，终无所毁伤。其所称荐，若陈留虞放、边韶，南阳延固、张温，弘农张奂，颍川堂谿典等，皆致位公卿，而不伐其善。","attribution":"《续汉书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":14,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-2c3453013ec854037801","start":169,"end":265,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
