{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"sunshi-e-p047b","title":"孙策率军破黄祖获家属斩刘虎韩晞","accounts":[{"id":"sunshi-e-p047b-account","label":"《吴录》","text":"孙策率军破黄祖获家属斩刘虎韩晞","evidence":["sunshi-e-p047b-q"]},{"id":"sunshi-e-p046h-account","label":"《江表传》","text":"孙策进夏口破黄祖刘虎韩晞援军","evidence":["sunshi-e-p046h-q"]}],"participants":[{"person":"wudi-p0099","role":"破军","evidence":["sunshi-e-p047b-q"]},{"person":"zhouyu-p0033","role":"败走","evidence":["sunshi-e-p047b-q"]},{"person":"sunshi-p0072","role":"战死","evidence":["sunshi-e-p047b-q"]},{"person":"sunshi-p0073","role":"战死","evidence":["sunshi-e-p047b-q"]},{"person":"liu-biao","role":"遣援","evidence":["sunshi-e-p046h-q"]}],"place":null,"time":{"label":"孙策讨黄祖十二月","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["sunshi-e-p047b-q"]},"ordering_evidence":"sunshi-e-p047b-q","source_order":[46,259,"P047b"],"order":8125}],"persons":[{"id":"liu-biao","name":"刘表","facts":[],"aliases":[]},{"id":"sunshi-p0072","name":"刘虎（刘表从子）","facts":[],"aliases":[]},{"id":"sunshi-p0073","name":"韩晞","facts":[],"aliases":[]},{"id":"wudi-p0099","name":"孙策","facts":[],"aliases":[]},{"id":"zhouyu-p0033","name":"黄祖","facts":[],"aliases":[]}],"evidence":[{"id":"sunshi-e-p046h-q","section":"chapter-046","block":"b-0df888008b92c8896d19","layer":"pei","quote":"遂前进夏口，攻黄祖。时刘表遣从子虎、南阳韩晞，将长矛五千，来为黄祖前锋。策与战，大破之。","attribution":"《江表传》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":257,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-344fcece1d1f127d763a","start":435,"end":479,"offset_unit":"unicode_code_point"},{"id":"sunshi-e-p047b-q","section":"chapter-046","block":"b-f9a911c6b81ca23bec0b","layer":"pei","quote":"身跨马綝阵，手击急鼓，以齐战势；吏士奋激，踊跃百倍，心精意果，各竞用命。越渡重堑，迅疾若飞；火放上风，兵激烟下；弓弩并发，流矢雨集；日加辰时，祖乃溃烂。锋刃所截，猋火所焚；前无生寇，惟祖迸走。获其妻、息男女七人，斩虎（狼）、韩晞以下二万余级，其赴水溺者一万余口；船六千余艘，财物山积。虽表未擒，祖宿狡猾，为表腹心，出作爪牙；表之鸱张，以祖气息；而祖家属部曲，扫地无余；表孤特之虏，成鬼行尸。诚皆圣朝，神武远振，臣讨有罪，得效微勤。","attribution":"《吴录》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":258,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-344fcece1d1f127d763a","start":131,"end":346,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
