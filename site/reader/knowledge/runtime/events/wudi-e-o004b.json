{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o004b","title":"曹操整治济南吏治与淫祀","accounts":[{"id":"wudi-e-o004b-account","label":"正文","text":"曹操迁济南相，奏免贪污长吏，禁断淫祀。","evidence":["wudi-e-o004b-q"]}],"participants":[{"person":"cao-cao","role":"整治政务","evidence":["wudi-e-o004b-q"]}],"place":{"text":"济南","evidence":["wudi-e-o004b-q"]},"time":{"label":"讨颍川黄巾之后","precision":"relative","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-o004b-q"],"after":"wudi-e-o004a"},"source_order":[1,40,"O004b"],"order":28},{"id":"wudi-e-o004a","title":"曹操讨颍川黄巾","accounts":[{"id":"wudi-e-o004a-account","label":"正文","text":"光和末黄巾起，曹操受拜骑都尉，讨颍川黄巾。","evidence":["wudi-e-o004a-q"]}],"participants":[{"person":"cao-cao","role":"领兵讨伐","evidence":["wudi-e-o004a-q"]}],"place":{"text":"颍川","evidence":["wudi-e-o004a-q"]},"time":{"label":"光和末","year":184,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o004a-q","wudi-q-o004","wudi-q-b-0b46b06245df0636b76c"],"chronology":"wudi-y184","dating_review":{"anchor":"wudi-q-o004","basis":"光和末","reviewed":true}},"source_order":[1,40,"O004a"],"order":27}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-o004b-q","section":"chapter-001","block":"b-f4a52cf5e3cf71b97de6","layer":"original","quote":"迁为济南相〖5〗，国有十余县，长吏多阿附贵戚〖6〗，赃污狼藉；于是奏免其八〔九〕。禁断淫祀〖7〗，奸宄逃窜〖8〗，郡界肃然。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":39,"anchor":null},"note_id":null,"start":30,"end":92}],"profiles":{},"directory_counts":{}}
