{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wgc-e-6-e10","title":"邓艾简选精锐欲趋成都","order":5777,"accounts":[{"id":"wgc-a-6-e10","label":"正文","text":"邓艾简选精锐欲趋成都","evidence":["wgc-q0463","wgc-q0076"]}],"participants":[{"person":"shaodi-p0080","role":"追维到阴平、简选精锐、欲从汉德阳入江由左担道诣绵竹趋成都","evidence":["wgc-q0463","wgc-q0076"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0463","wgc-q0076"]},"ordering_evidence":"wgc-q0463"}],"persons":[{"id":"shaodi-p0080","name":"邓艾","facts":[],"aliases":[]}],"evidence":[{"id":"wgc-q0076","section":"chapter-028","block":"b-e3e892ba497cf66aa3a6","layer":"original","quote":"邓艾追姜维到阴平，简选精锐；欲从汉德阳入江由、左担道，诣绵竹〖1〗，趋成都，与诸葛绪共行。绪以本受节度邀姜维，西行非本诏；遂进军前向白水，与会合。会遣将军田章等从剑阁西，径出江由。未至百里，章先破蜀伏兵三校〖2〗；艾使章先登。遂长驱而前。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":529,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":119,"offset_unit":"unicode_code_point"},{"id":"wgc-q0463","section":"chapter-028","block":"b-e3e892ba497cf66aa3a6","layer":"original","quote":"邓艾追姜维到阴平，简选精锐；欲从汉德阳入江由、左担道，诣绵竹〖1〗，趋成都，与诸葛绪共行","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":529,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":44,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
