{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dongyuan-e-p044b","title":"李傕隔帝北坞赐腐骨杨琦劝帝隐忍","accounts":[{"id":"dongyuan-e-p044b-account","label":"《献帝起居注》","text":"李傕隔帝北坞赐腐骨杨琦劝帝隐忍","evidence":["dongyuan-e-p044b-q"]}],"participants":[{"person":"wudi-p0089","role":"隔帝不给粮","evidence":["dongyuan-e-p044b-q"]},{"person":"wudi-p0054","role":"求粮","evidence":["dongyuan-e-p044b-q"]},{"person":"dongyuan-p0088","role":"进谏","evidence":["dongyuan-e-p044b-q"]}],"place":null,"time":{"label":"李傕质帝时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-p044b-q"]},"ordering_evidence":"dongyuan-e-p044b-q","source_order":[6,160,"P044b"],"order":1572}],"persons":[{"id":"dongyuan-p0088","name":"杨琦","facts":[],"aliases":[]},{"id":"wudi-p0054","name":"汉献帝","facts":[],"aliases":[]},{"id":"wudi-p0089","name":"李傕","facts":[],"aliases":[]}],"evidence":[{"id":"dongyuan-e-p044b-q","section":"chapter-006","block":"b-b4b3790f4f883e68840d","layer":"pei","quote":"是日，傕复移乘舆幸北坞，使校尉监坞门，内外隔绝。诸侍臣皆有饥色，时盛暑热，人尽寒心。帝求米五斛、牛骨五具以赐左右。傕曰：‘朝;上饭，何用米为？’乃与腐牛骨，皆臭不可食。帝大怒，欲诘责之。侍中杨琦上封事曰：‘傕，边鄙之人，习于夷风。今又自知所犯悖逆，常有怏怏之色；欲辅车驾，幸黄白城以纾其愤。臣愿陛下忍之，未可显其罪也。’帝纳之。初，傕屯黄白城，故谋欲徙之。","attribution":"《献帝起居注》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":159,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-7f8915c0e475c5efba56","start":126,"end":304,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
