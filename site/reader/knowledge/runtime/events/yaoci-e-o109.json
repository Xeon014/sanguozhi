{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"yaoci-e-o109","title":"慈见策论豫章：华子鱼良德也然非筹略才，无他方规自守而已","accounts":[{"id":"yaoci-a-e78154d6c32ac0e11d7d","label":"裴注·江表传","text":"慈见策论豫章：华子鱼良德也然非筹略才，无他方规自守而已","evidence":["yaoci-q-83864604ea9ad266f0d8"]},{"id":"yaoci-a-7619a1a095e67978fe10","label":"裴注·江表传","text":"丹杨僮芝自擅庐陵，诈言被诏书为太守","evidence":["yaoci-q-37b36817e82ae111dab6"]},{"id":"yaoci-a-e1b9f955938edbed161c","label":"裴注·江表传","text":"鄱阳民帅别立宗部，阻兵守界，不受子鱼所遣长吏，言我已别立郡，须汉遣真太守来当迎之","evidence":["yaoci-q-206beb152ff048c5fdad"]},{"id":"yaoci-a-310b2ce1517f1175d635","label":"裴注·江表传","text":"海昏上缭壁五六千家相结聚作宗伍，惟输租布于郡；华子鱼发召一人遂不可得，亦睹视之而已","evidence":["yaoci-q-cf43a6b8f6441724a504"]}],"participants":[{"person":"wuzhu-p0003","role":"论事者","evidence":["yaoci-q-83864604ea9ad266f0d8"]},{"person":"wudi-p0340","role":"被论者（华子鱼）；不能谐庐陵鄱阳、发召不可得者（华子鱼）","evidence":["yaoci-q-83864604ea9ad266f0d8","yaoci-q-cf43a6b8f6441724a504"]},{"person":"yaoci-p0001","role":"自擅诈言者","evidence":["yaoci-q-37b36817e82ae111dab6"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["yaoci-q-83864604ea9ad266f0d8","yaoci-q-37b36817e82ae111dab6","yaoci-q-206beb152ff048c5fdad","yaoci-q-cf43a6b8f6441724a504"]},"ordering_evidence":"yaoci-q-83864604ea9ad266f0d8","source_order":[49,172,147],"order":8984}],"persons":[{"id":"wudi-p0340","name":"华歆","facts":[],"aliases":[]},{"id":"wuzhu-p0003","name":"太史慈","facts":[],"aliases":[]},{"id":"yaoci-p0001","name":"僮芝","facts":[],"aliases":[]}],"evidence":[{"id":"yaoci-q-206beb152ff048c5fdad","section":"chapter-049","block":"b-2cdec7258908eadc1d9f","layer":"pei","quote":"鄱阳民帅别立宗部，阻兵守界，不受子鱼所遣长吏，言：“我已别立郡，须汉遣真太守来，当迎之耳","attribution":"裴注·江表传","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":171,"anchor":null},"note_id":"n-321352b9fd1cdac5f263","start":197,"end":241},{"id":"yaoci-q-37b36817e82ae111dab6","section":"chapter-049","block":"b-2cdec7258908eadc1d9f","layer":"pei","quote":"又丹杨僮芝，自擅庐陵，诈言被诏书为太守","attribution":"裴注·江表传","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":171,"anchor":null},"note_id":"n-321352b9fd1cdac5f263","start":177,"end":196},{"id":"yaoci-q-83864604ea9ad266f0d8","section":"chapter-049","block":"b-2cdec7258908eadc1d9f","layer":"pei","quote":"慈见策曰：‘华子鱼，良德也，然非筹略才；无他方规，自守而已","attribution":"裴注·江表传","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":171,"anchor":null},"note_id":"n-321352b9fd1cdac5f263","start":147,"end":176},{"id":"yaoci-q-cf43a6b8f6441724a504","section":"chapter-049","block":"b-2cdec7258908eadc1d9f","layer":"pei","quote":"子鱼不但不能谐庐陵、鄱阳；近自海昏有上缭壁，有五六千家相结聚作宗伍，惟输租布于郡耳，发召，一人遂不可得。子鱼亦睹视之而已","attribution":"裴注·江表传","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":171,"anchor":null},"note_id":"n-321352b9fd1cdac5f263","start":243,"end":303}],"profiles":{},"directory_counts":{}}
