{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"mingdi-e-p005b","title":"孟他借监奴拜迎获馈遗转赂张让得凉州刺史","accounts":[{"id":"mingdi-e-p005b-account","label":"裴注·三辅决录及其注","text":"孟他借监奴拜迎获馈遗转赂张让得凉州刺史","evidence":["mingdi-e-p005b-q"]}],"participants":[{"person":"mingdi-p0058","role":"行贿受任","evidence":["mingdi-e-p005b-q"]},{"person":"wudi-p0031","role":"受贿授官","evidence":["mingdi-e-p005b-q"]}],"place":null,"time":{"label":"汉灵帝时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["mingdi-e-p005b-q"]},"ordering_evidence":"mingdi-e-p005b-q","source_order":[3,51,"P005b"],"order":729}],"persons":[{"id":"mingdi-p0058","name":"孟他","facts":[],"aliases":[]},{"id":"wudi-p0031","name":"张让","facts":[],"aliases":[]}],"evidence":[{"id":"mingdi-e-p005b-q","section":"chapter-003","block":"b-4275bc6283624abd0772","layer":"pei","quote":"﹝一﹞《三辅决录》曰：“伯郎，凉州人。名不令休。其注曰：‘伯郎姓孟，名他。扶风人。’灵帝时，中常侍张让专朝政；让监奴典护家事。他仕不遂，乃尽以家财赂监奴，与共结亲。积年家业为之破尽，众奴皆惭，问他所欲。他曰：‘欲得卿曹拜耳。’奴被恩久，皆许诺。时宾客求见让者，门下车常数百乘，或累日不得通。他最后到，众奴伺其至，皆迎车而拜，径将他车独入。众人悉惊，谓他与让善，争以珍物遗他。他得之，尽以赂让；让大喜。他又以蒲桃酒一斛遗让，即拜凉州刺史。”","attribution":"裴注·三辅决录及其注","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":50,"anchor":null},"note_id":"n-680a01f5d7c24c678bdc","start":0,"end":219}],"profiles":{},"directory_counts":{}}
