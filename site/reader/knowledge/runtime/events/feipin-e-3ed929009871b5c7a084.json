{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"feipin-e-3ed929009871b5c7a084","title":"搜神记载孙峻杀朱主，孙皓拟改葬问巫识墓开冢（灵异叙述归属）","accounts":[{"id":"feipin-a-3ed929009871b5c7a084","label":"裴注·搜神记","text":"搜神记载孙峻杀朱主，孙皓拟改葬问巫识墓开冢（灵异叙述归属）","evidence":["feipin-q-16995cb82d7e7b8aafcf"]}],"participants":[{"person":"shaodi-p0075","role":"杀害者","evidence":["feipin-q-16995cb82d7e7b8aafcf"]},{"person":"santizhu-p0155","role":"改葬对象","evidence":["feipin-q-16995cb82d7e7b8aafcf"]},{"person":"shaodi-p0162","role":"拟改葬者","evidence":["feipin-q-16995cb82d7e7b8aafcf"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["feipin-q-16995cb82d7e7b8aafcf"]},"ordering_evidence":"feipin-q-16995cb82d7e7b8aafcf","order":9085}],"persons":[{"id":"santizhu-p0155","name":"鲁育","facts":[],"aliases":[]},{"id":"shaodi-p0075","name":"孙峻","facts":[],"aliases":[]},{"id":"shaodi-p0162","name":"孙皓","facts":[],"aliases":[]}],"evidence":[{"id":"feipin-q-16995cb82d7e7b8aafcf","section":"chapter-050","block":"b-8fc6f7166b988660dd9a","layer":"pei","quote":"﹝二﹞《搜神记》曰：“孙峻杀朱主，埋于石子冈。归命即位，将欲改葬之；冢墓相亚，不可识别。而宫人颇识主亡时所著衣服，乃使两巫各住一处以伺其灵；使（察鉴）〔察战监之〕，不得相近。久时，二人俱白：见一女人，年可三十余，上著青锦束头，紫白袷裳，丹绨丝履；从石子冈上，半冈而以手抑膝，长太息；小住须臾，进一冢上便住；徘徊良久，奄然不见。二人之言，不谋而同；于是开冢，衣服如之。”","attribution":"裴注·搜神记","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":136,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-07a4632007338c4f1431","start":0,"end":184,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
