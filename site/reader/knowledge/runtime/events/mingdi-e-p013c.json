{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"mingdi-e-p013c","title":"靳详两说郝昭降诸葛亮而不得","accounts":[{"id":"mingdi-e-p013c-account","label":"裴注·魏略","text":"靳详两说郝昭降诸葛亮而不得","evidence":["mingdi-e-p013c-q"]}],"participants":[{"person":"mingdi-p0074","role":"劝降","evidence":["mingdi-e-p013c-q"]},{"person":"mingdi-p0007","role":"拒降","evidence":["mingdi-e-p013c-q"]},{"person":"zhuge-liang","role":"遣说","evidence":["mingdi-e-p013c-q"]}],"place":{"text":"陈仓","evidence":["mingdi-e-p013c-q"]},"time":{"year":228,"label":"太和二年陈仓之围","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"mingdi-y228","dating_review":{"reviewed":true,"anchor":"mingdi-q-o008","basis":"太和二年陈仓之围"},"evidence":["mingdi-e-p013c-q","mingdi-q-o008","mingdi-q-b-76fba510250937628a99"]},"ordering_evidence":"mingdi-e-p013c-q","source_order":[3,87,"P013c"],"order":757}],"persons":[{"id":"mingdi-p0007","name":"郝昭","facts":[],"aliases":[]},{"id":"mingdi-p0074","name":"靳详","facts":[],"aliases":[]},{"id":"zhuge-liang","name":"诸葛亮","facts":[],"aliases":[]}],"evidence":[{"id":"mingdi-e-p013c-q","section":"chapter-003","block":"b-35f8b7adee36b5682ae8","layer":"pei","quote":"亮围陈仓，使昭乡人靳详于城外遥说之，昭于楼上应详曰：‘魏家科法，卿所练也；我之为人，卿所知也。我受国恩多而门户重，卿无可言者，但有必死耳。卿还谢诸葛，便可攻也！’详以昭语告亮，亮又使详重说昭，言‘人兵不敌，无为空自破灭’。昭谓详曰：‘前言已定矣。我识卿耳，箭不识也！’详乃去。","attribution":"裴注·魏略","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":86,"anchor":null},"note_id":"n-91d96e75113271a0d70d","start":82,"end":220},{"id":"mingdi-q-b-76fba510250937628a99","section":"chapter-003","block":"b-76fba510250937628a99","layer":"modern","quote":"〖1〗二年：太和二年（公元 228）。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":60,"anchor":null},"note_id":"n-38a74578b09178cb1fd4","start":0,"end":19},{"id":"mingdi-q-o008","section":"chapter-003","block":"b-bec9198de0001b0aa26c","layer":"original","quote":"二年春正月〖1〗，宣王攻破新城。斩达，传其首〖2〗。﹝一﹞分新城之上庸、武陵、巫县为上庸郡〖3〗，锡县为锡郡。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":54,"anchor":null},"note_id":null,"start":0,"end":55}],"profiles":{},"directory_counts":{}}
