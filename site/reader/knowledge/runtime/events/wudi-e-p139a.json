{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p139a","title":"金祎等谋攻魏求援刘备","accounts":[{"id":"wudi-e-p139a-account","label":"《三辅决录注》","text":"《三辅决录注》记金祎等结谋，计划杀王必、挟天子攻魏、南援刘备，尚属其谋划。","evidence":["wudi-e-p139a-q"]}],"participants":[{"person":"wudi-p0383","role":"结谋","evidence":["wudi-e-p139a-q"]},{"person":"wudi-p0373","role":"结谋","evidence":["wudi-e-p139a-q"]},{"person":"wudi-p0374","role":"结谋","evidence":["wudi-e-p139a-q"]},{"person":"wudi-p0372","role":"结谋","evidence":["wudi-e-p139a-q"]},{"person":"wudi-p0384","role":"结谋","evidence":["wudi-e-p139a-q"]},{"person":"wudi-p0385","role":"结谋","evidence":["wudi-e-p139a-q"]},{"person":"wudi-p0375","role":"谋杀对象","evidence":["wudi-e-p139a-q"]}],"place":{"text":"许","evidence":["wudi-e-p139a-q"]},"time":{"label":"许中兵变前","year":218,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-p139a-q","wudi-q-o188","wudi-q-b-ac93ccb47f6e7be3aea4"],"chronology":"wudi-y218","dating_review":{"anchor":"wudi-q-o188","basis":"许中兵变前","reviewed":true}},"source_order":[1,1094,"P139a"],"order":416}],"persons":[{"id":"wudi-p0372","name":"吉本","facts":[],"aliases":[]},{"id":"wudi-p0373","name":"耿纪","facts":[],"aliases":[]},{"id":"wudi-p0374","name":"韦晃","facts":[],"aliases":[]},{"id":"wudi-p0375","name":"王必","facts":[],"aliases":[]},{"id":"wudi-p0383","name":"金祎","facts":[],"aliases":[]},{"id":"wudi-p0384","name":"吉邈","facts":[],"aliases":[]},{"id":"wudi-p0385","name":"吉穆","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-p139a-q","section":"chapter-001","block":"b-66e857f79a5f5bdfcda8","layer":"pei","quote":"时有京兆金祎，字德祎。自以世为汉臣，自日䃅讨莽何罗，忠诚显著，名节累叶。睹汉祚将移，谓可季兴；乃喟然发愤，遂与耿纪、韦晃、吉本、本子邈、邈弟穆等结谋。纪字季行。少有美名，为丞相掾，王甚敬异之。迁侍中，守少府。邈字文然，穆字思然；以祎慷慨有日!之风，又与王必善，因以间之。若杀必，欲挟天子以攻魏，南援刘备。","attribution":"《三辅决录注》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":418,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e