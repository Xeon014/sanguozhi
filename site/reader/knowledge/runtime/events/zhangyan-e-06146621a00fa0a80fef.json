{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhangyan-e-06146621a00fa0a80fef","title":"孔融遗张纮书，言大军西征足下留镇、不有居者谁守社稷，深固折冲亦大勋也，及李广之气乐一当单于、（孙叔）〔叔孙〕投戈绛灌俎豆等语","accounts":[{"id":"zhangyan-a-06146621a00fa0a80fef","label":"裴注·吴书","text":"孔融遗张纮书，言大军西征足下留镇、不有居者谁守社稷，深固折冲亦大勋也，及李广之气乐一当单于、（孙叔）〔叔孙〕投戈绛灌俎豆等语","evidence":["zhangyan-q-117b7ad160d613a29619"]}],"participants":[{"person":"wudi-p0155","role":"遗书者","evidence":["zhangyan-q-117b7ad160d613a29619"]},{"person":"sunshi-p0048","role":"受书者","evidence":["zhangyan-q-117b7ad160d613a29619"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["zhangyan-q-117b7ad160d613a29619"]},"ordering_evidence":"zhangyan-q-117b7ad160d613a29619","order":9426}],"persons":[{"id":"sunshi-p0048","name":"张纮","facts":[],"aliases":[]},{"id":"wudi-p0155","name":"孔融","facts":[],"aliases":[]}],"evidence":[{"id":"zhangyan-q-117b7ad160d613a29619","section":"chapter-053","block":"b-ba6e583185faf20d4400","layer":"pei","quote":"孔融遗纮书曰：‘闻大军西征，足下留镇。不有居者，谁守社稷？深固折冲，亦大勋也。无乃李广之气，苍发益怒，乐一当单于，以尽余愤乎？南北并定，世将无事；（孙叔）〔叔孙〕投戈，绛、灌俎豆，亦在今日；但用离析，无缘会面，为愁叹耳！道直途清，相见岂复难哉！’","attribution":"裴注·吴书","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":32,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-911a32786eb288af892f","start":304,"end":427,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
