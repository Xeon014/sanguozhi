{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhouyu-e-p021a","title":"孙权劝吕蒙蒋钦读书吕蒙就学","accounts":[{"id":"zhouyu-e-p021a-account","label":"《江表传》","text":"孙权劝吕蒙蒋钦读书吕蒙就学","evidence":["zhouyu-e-p021a-q"]}],"participants":[{"person":"sun-quan","role":"劝学","evidence":["zhouyu-e-p021a-q"]},{"person":"lu-meng","role":"就学","evidence":["zhouyu-e-p021a-q"]},{"person":"zhouyu-p0049","role":"受劝","evidence":["zhouyu-e-p021a-q"]}],"place":null,"time":{"label":"孙权统事后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["zhouyu-e-p021a-q"]},"ordering_evidence":"zhouyu-e-p021a-q","source_order":[54,361,"P021a"],"order":9699}],"persons":[{"id":"lu-meng","name":"吕蒙","facts":[],"aliases":[]},{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"zhouyu-p0049","name":"蒋钦","facts":[],"aliases":[]}],"evidence":[{"id":"zhouyu-e-p021a-q","section":"chapter-054","block":"b-3a711981ab0547842a9a","layer":"pei","quote":"初，权谓蒙及蒋钦曰：‘卿今并当途掌事，宜学问以自开益。’蒙曰：‘在军中，常苦多务，恐不容复读书。’权曰：‘孤岂欲卿治经为博士邪？但当令涉猎见往事耳！卿言多务，孰若孤？孤少时历《诗》、《书》、《礼记》、《左传》、《国语》，惟不读《易》。至统事以来，省三史、诸家兵书，自以为大有所益。如卿二人，意性朗悟；学必得之，宁当不为乎！宜急读《孙子》、《六韬》、《左传》、《国语》及三史。孔子言：“终日不食，终夜不寝以思，无益；不如学也。”光武当兵马之务，手不释卷。孟德亦自谓“老而好学”。卿何独不自勉勖邪？’蒙始就学，笃志不倦；其所览见，旧儒不胜。","attribution":"《江表传》","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":360,"anchor":null},"note_id":"n-5c8f4d175003c76305bc","start":11,"end":279}],"profiles":{},"directory_counts":{}}
