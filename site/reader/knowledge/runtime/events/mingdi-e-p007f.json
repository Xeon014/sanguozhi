{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"mingdi-e-p007f","title":"司马懿遣梁几察孟达劝朝孟达惧而反","accounts":[{"id":"mingdi-e-p007f-account","label":"裴注·魏略","text":"司马懿遣梁几察孟达，又劝入朝；孟达惊惧而反。","evidence":["mingdi-e-p007f-q"]}],"participants":[{"person":"wudi-p0364","role":"遣察","evidence":["mingdi-e-p007f-q"]},{"person":"mingdi-p0065","role":"察劝","evidence":["mingdi-e-p007f-q"]},{"person":"xianzhu-p0071","role":"惧反","evidence":["mingdi-e-p007f-q"]}],"place":null,"time":{"year":227,"label":"太和元年孟达反时","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"mingdi-y227","dating_review":{"reviewed":true,"anchor":"mingdi-q-o004","basis":"太和元年孟达反时"},"evidence":["mingdi-e-p007f-q","mingdi-q-o004","mingdi-q-o008","mingdi-q-b-76fba510250937628a99"]},"ordering_evidence":"mingdi-e-p007f-q","source_order":[3,53,"P007f"],"order":734}],"persons":[{"id":"mingdi-p0065","name":"梁几","facts":[],"aliases":[]},{"id":"wudi-p0364","name":"司马懿","facts":[],"aliases":[]},{"id":"xianzhu-p0071","name":"孟达","facts":[],"aliases":[]}],"evidence":[{"id":"mingdi-e-p007f-q","section":"chapter-003","block":"b-5bf81d9dfe407ed70c63","layer":"pei","quote":"司马宣王遣参军梁几，察之，又劝其入朝。达惊惧，遂反。","attribution":"裴注·魏略","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":52,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-680a01f5d7c24c678bdc","start":600,"end":626,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-b-76fba510250937628a99","section":"chapter-003","block":"b-76fba510250937628a99","layer":"modern","quote":"〖1〗二年：太和二年（公元 228）。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":60,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-38a74578b09178cb1fd4","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-o004","section":"chapter-003","block":"b-3d867ec3331f738aeaf5","layer":"original","quote":"太和元年春正月，郊祀武皇帝，以配天；宗祀文皇帝于明堂，以配上帝〖1〗。分江夏南部，置江夏南部都尉。西平麹英反，杀临羌令、西都长〖2〗。遣将军郝昭、鹿磐，讨斩之。二月，辛未〖3〗，帝耕于籍田。辛巳〖4〗，立文昭皇后寝庙于邺。丁亥〖5〗，朝日于东郊。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":30,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":123,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-o008","section":"chapter-003","block":"b-bec9198de0001b0aa26c","layer":"original","quote":"二年春正月〖1〗，宣王攻破新城。斩达，传其首〖2〗。﹝一﹞分新城之上庸、武陵、巫县为上庸郡〖3〗，锡县为锡郡。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":54,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":55,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
