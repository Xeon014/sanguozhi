{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"houfei-e-o041a","title":"郭表受封迁官郭详任骑都尉","accounts":[{"id":"houfei-e-o041a-account","label":"《后妃传》正文","text":"郭表受封迁官郭详任骑都尉","evidence":["houfei-e-o041a-q"]}],"participants":[{"person":"houfei-p0061","role":"受封迁官","evidence":["houfei-e-o041a-q"]},{"person":"houfei-p0066","role":"任官","evidence":["houfei-e-o041a-q"]}],"place":null,"time":{"year":230,"label":"太和四年","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"houfei-y230","dating_review":{"reviewed":true,"anchor":"houfei-q-o012","basis":"太和四年"},"evidence":["houfei-e-o041a-q","houfei-q-o012","houfei-q-b-cbf406b91aa2796bad01"]},"ordering_evidence":"houfei-e-o041a-q","source_order":[5,202,"O041a"],"order":1438}],"persons":[{"id":"houfei-p0061","name":"郭表","facts":[],"aliases":[]},{"id":"houfei-p0066","name":"郭详","facts":[],"aliases":[]}],"evidence":[{"id":"houfei-e-o041a-q","section":"chapter-005","block":"b-ea6bed6da1ea24121baf","layer":"original","quote":"太和四年，诏封表安阳亭侯。又进爵乡侯，增邑并前五百户，迁中垒将军。以表子详为骑都尉。其年，帝追谥太后父永，为安阳乡敬侯；母董，为都乡君。迁表昭德将军〖1〗，加金紫〖2〗，位特进；表第二子训，为骑都尉。及孟武母卒，欲厚葬，起祠堂。太后止之曰：“自丧乱以来，坟墓无不发掘。皆由厚葬也，首阳陵可以为法。”","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":201,"anchor":null},"note_id":null,"start":0,"end":149},{"id":"houfei-q-b-cbf406b91aa2796bad01","section":"chapter-005","block":"b-cbf406b91aa2796bad01","layer":"modern","quote":"〖10〗四年：太和四年（公元 230）。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":108,"anchor":null},"note_id":"n-776c1db56d4d5699fd84","start":0,"end":20},{"id":"houfei-q-o012","section":"chapter-005","block":"b-743375ca04aa18c715da","layer":"original","quote":"至太和四年春，明帝乃追谥太后祖父广曰开阳恭侯〖12〗，父远曰敬侯〖13〗，祖母周封阳都君，及（恭）〔敬〕侯夫人，皆赠印绶〖14〗。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":44,"anchor":null},"note_id":null,"start":0,"end":65}],"profiles":{},"directory_counts":{}}
