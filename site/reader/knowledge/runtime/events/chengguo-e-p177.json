{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"chengguo-e-p177","title":"或教帝反问验晔情晔发狂忧死","accounts":[{"id":"chengguo-a-c86e69bc085ee22d32ea","label":"裴注·《傅子》","text":"或教帝反问验晔情晔发狂忧死","evidence":["chengguo-q-c962c916345ac477b2d2"]}],"participants":[{"person":"wendi-p0005","role":"如言以验之、果得其情、从此疏焉","evidence":["chengguo-q-c962c916345ac477b2d2"]},{"person":"wendi-p0071","role":"被谮不尽忠善伺上意、遂发狂、出为大鸿胪、以忧死","evidence":["chengguo-q-c962c916345ac477b2d2"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["chengguo-q-c962c916345ac477b2d2"]},"ordering_evidence":"chengguo-q-c962c916345ac477b2d2","source_order":[14,364,421],"order":3129}],"persons":[{"id":"wendi-p0005","name":"曹叡","facts":[],"aliases":[]},{"id":"wendi-p0071","name":"刘晔","facts":[],"aliases":[]}],"evidence":[{"id":"chengguo-q-c962c916345ac477b2d2","section":"chapter-014","block":"b-cbe6200530aade931fad","layer":"pei","quote":"或恶晔于帝曰：‘晔不尽忠，善伺上意所趋而合之。陛下试与晔言，皆反意而问之：若皆与所问反者，是晔常与圣意合也；复每问皆同者，晔之情，必无所逃矣。’帝如言以验之，果得其情，从此疏焉。晔遂发狂，出为大鸿胪，以忧死。谚曰‘巧诈不如拙诚’，信矣！以晔之明智权计，若居之以德义，行之以忠信，古之上贤，何以加诸？独任才智，不与世士相经纬；内不推心事上，外困于俗，卒不能自安于天下。岂不惜哉","attribution":"裴注·《傅子》","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":363,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-96f386a1b5bf5c263563","start":421,"end":608,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
