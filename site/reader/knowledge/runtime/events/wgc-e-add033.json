{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wgc-e-add033","title":"爰翰任河东太守","order":5695,"accounts":[{"id":"wgc-a-add033","label":"荀绰冀州记；裴松之按","text":"爰翰任河东太守","evidence":["wgc-q0680","wgc-q0124"]}],"participants":[{"person":"wgc-p0089","role":"任官","evidence":["wgc-q0680","wgc-q0124"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0680","wgc-q0124"]},"ordering_evidence":"wgc-q0680"}],"persons":[{"id":"wgc-p0089","name":"爰翰","facts":[],"aliases":[]}],"evidence":[{"id":"wgc-q0124","section":"chapter-028","block":"b-c763989a9114027401e7","layer":"pei","quote":"﹝二﹞荀绰《冀州记》曰：“邵起自干吏，位至卫尉。长子翰，河东太守。中子敞，大司农。少子倩，字君幼；宽厚有器局，勤于当世，历位冀州刺史、太子右卫率。翰子俞，字世都；清贞贵素，辩于论议，采公孙龙之辞以谈微理。少有能名，辟太尉府，稍历显位，至侍中、中书令，迁为监。”臣松之按《蹇》彖辞云“《蹇》利西南，往得中也”，不云“有功”；下云“利见大人，往有功也”。","attribution":"荀绰冀州记；裴松之按","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":401,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b19153d66abe27e1cc00","start":0,"end":175,"offset_unit":"unicode_code_point"},{"id":"wgc-q0680","section":"chapter-028","block":"b-c763989a9114027401e7","layer":"pei","quote":"长子翰，河东太守。","attribution":"荀绰冀州记；裴松之按","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":401,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b19153d66abe27e1cc00","start":24,"end":33,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
