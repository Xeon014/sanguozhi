{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p116a","title":"使团迎曹氏二贵人入宫","accounts":[{"id":"wudi-e-p116a-account","label":"《献帝起居注》","text":"《献帝起居注》记王邑、刘艾等持节迎二贵人，二月癸亥授印绶，甲子迎车，癸酉至洧仓，侍中丹奉命迎接，乙亥入宫设宴。","evidence":["wudi-e-p116a-q"]}],"participants":[{"person":"wudi-p0319","role":"迎接","evidence":["wudi-e-p116a-q"]},{"person":"wudi-p0126","role":"迎接","evidence":["wudi-e-p116a-q"]},{"person":"wudi-p0334","role":"迎接","evidence":["wudi-e-p116a-q"]},{"person":"cao-cao","role":"送女","evidence":["wudi-e-p116a-q"]},{"person":"wudi-p0054","role":"纳贵人","evidence":["wudi-e-p116a-q"]}],"place":{"text":"魏国、洧仓、汉宫","evidence":["wudi-e-p116a-q"]},"time":{"label":"建安十九年二月癸亥、甲子、癸酉、乙亥","year":214,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-p116a-q","wudi-q-o161","wudi-q-b-c4192d9fada3bef44302"],"chronology":"wudi-y214","dating_review":{"anchor":"wudi-q-o161","basis":"建安十九年二月癸亥、甲子、癸酉、乙亥","reviewed":true}},"source_order":[1,991,"P116a"],"order":364}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0054","name":"汉献帝","facts":[],"aliases":[]},{"id":"wudi-p0126","name":"刘艾","facts":[],"aliases":[]},{"id":"wudi-p0319","name":"王邑","facts":[],"aliases":[]},{"id":"wudi-p0334","name":"侍中丹","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-p116a-q","section":"chapter-001","block":"b-a59a838d7cad4ea3b6ef","layer":"pei","quote":"﹝一﹞《献帝起居注》曰：“使行太常事、大司农、安阳亭侯王邑，与宗正刘艾，皆持节；介者五人，赍束帛驷马；及给事黄门侍郎、掖庭丞、中常侍二人：迎二贵人于魏公国。二月癸亥，又于魏公宗庙授二贵人印绶。甲子，诣魏公宫延秋门，迎贵人升车。魏遣郎中令、少府、博士、御府乘黄厩令、丞相掾属，侍送贵人。癸酉，二贵人至洧仓中。遣侍中丹，将冗从虎贲前后络绎往迎之。乙亥，二贵人入宫；御史大夫、中二千石将、大夫、议郎会殿中，魏国二卿及侍中、中郎二人，与汉公卿并升殿，宴。”","attribution":"《献帝起居注》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":315,"anchor":null},"note_id":"n-58401ed617bd43840473","start":0,"end":224},{"id":"wudi-q-b-c4192d9fada3bef44302","section":"chapter-001","block":"b-c4192d9fada3bef44302","layer":"modern","quote":"〖1〗