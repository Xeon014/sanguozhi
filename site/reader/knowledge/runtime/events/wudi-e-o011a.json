{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o011a","title":"曹操劝进兵并西向成皋","accounts":[{"id":"wudi-e-o011a-account","label":"正文","text":"曹操认为董卓焚宫迁帝后应立即进攻，遂引兵西行，准备据成皋。","evidence":["wudi-e-o011a-q"]}],"participants":[{"person":"cao-cao","role":"劝战进军","evidence":["wudi-e-o011a-q"]},{"person":"wudi-p0053","role":"征讨对象","evidence":["wudi-e-o011a-q"]}],"place":{"text":"成皋","evidence":["wudi-e-o011a-q"]},"time":{"label":"初平元年","year":190,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o011a-q","wudi-q-o009","wudi-q-b-4a17eb75600ced2abdde"],"chronology":"wudi-y190","dating_review":{"anchor":"wudi-q-o009","basis":"初平元年","reviewed":true}},"source_order":[1,101,"O011a"],"order":60}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0053","name":"董卓","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-o011a-q","section":"chapter-001","block":"b-2f2de2a84a24af528d29","layer":"original","quote":"太祖曰：“举义兵以诛暴乱，大众已合，诸君何疑？向使董卓闻山东兵起〖6〗，倚王室之重，据二周之险〖7〗，东向以临天下，虽以无道行之，犹足为患。今焚烧宫室，劫迁天子，海内震动，不知所归。此天亡之时也！一战而天下定矣。不可失也！”遂引兵西，将据成皋〖8〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":100,"anchor":null},"note_id":null,"start":0,"end":125},{"id":"wudi-q-b-4a17eb75600ced2abdde","section":"chapter-001","block":"b-4a17eb75600ced2abdde","layer":"modern","quote":"〖1〗初平元年：公元 190 年。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":86,"anchor":null},"note_id":"n-93d66253e23c705b336d","start":0,"end":17},{"id":"wudi-q-o009","section":"chapter-001","block":"b-20c7e941eb42ee97df8c","layer":"original","quote":"初平元年春正月〖1〗，后将军袁术、冀州牧韩馥、﹝一﹞豫州刺史孔伷、﹝二﹞兖州刺史刘岱、﹝三﹞河内太守王匡、﹝四﹞勃海太守袁绍、陈留太守张邈、东郡太守桥瑁、﹝五﹞山阳太守袁遗、﹝六﹞济北相鲍信，﹝七﹞同时俱起兵〖2〗。众各数万，推绍为盟主。太祖行奋武将军〖3〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":84,"anchor":null},"note_id":null,"start":0,"end":130}],"p