{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wuzhu-e-o129a","title":"孙权诏察吏非法勿役夺农桑","accounts":[{"id":"wuzhu-e-o129a-account","label":"《吴主传第二》正文","text":"孙权诏察吏非法勿役夺农桑","evidence":["wuzhu-e-o129a-q"]}],"participants":[{"person":"sun-quan","role":"颁诏","evidence":["wuzhu-e-o129a-q"]}],"place":null,"time":{"year":240,"label":"赤乌三年春正月","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"wuzhu-y240","dating_review":{"reviewed":true,"anchor":"wuzhu-q-o129","basis":"赤乌三年春正月"},"evidence":["wuzhu-e-o129a-q","wuzhu-q-o129","shaodi-q-o008","shaodi-q-o012","shaodi-q-b-f56b355cff79244bd89c"]},"ordering_evidence":"wuzhu-e-o129a-q","source_order":[47,676,"O129a"],"order":8347}],"persons":[{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]}],"evidence":[{"id":"shaodi-q-b-f56b355cff79244bd89c","section":"chapter-004","block":"b-f56b355cff79244bd89c","layer":"modern","quote":"〖1〗二年：正始二年（公元 241）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":62,"anchor":null},"note_id":"n-bf9ccbeb544f540e6afb","start":0,"end":19},{"id":"shaodi-q-o008","section":"chapter-004","block":"b-44ec00442cdb41f1ea33","layer":"original","quote":"正始元年春二月，乙丑〖1〗，加侍中、中书监刘放，侍中、中书令孙资为左、右光禄大夫〖2〗。丙戌〖3〗，以辽东汶、北丰县民流徙渡海〖4〗，规齐郡之西安、临菑、昌国县界，为新汶、南丰县〖5〗，以居流民。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":39,"anchor":null},"note_id":null,"start":0,"end":98},{"id":"shaodi-q-o012","section":"chapter-004","block":"b-33e60ac0c003858f0640","layer":"original","quote":"二年春二月〖1〗，帝初通《论语》〖2〗。使太常以太牢祭孔子于辟雍〖3〗，以颜渊配〖4〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":58,"anchor":null},"note_id":null,"start":0,"end":44},{"id":"wuzhu-e-o129a-q","section":"chapter-047","block":"b-28d3218b32b0e3cbebdb","layer":"original","quote":"三年春正月〖5〗，诏曰：“盖君非民不立，民非谷不生。顷者以来〖6〗，民多征役；岁又水旱，年谷有损；而吏〔或〕不良，侵夺民时：以致饥困。自今以来，督军、郡守〖7〗，其谨察非法：当农桑时，以役事扰民者，举正以闻〖8〗。”","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":164,"anchor":null},"note_id":null,"start":0,"end":108},{"id":"wuzhu-q-o129","section":"chapter-047","block":"b-28d3218b32b0e3cbebdb","layer":"original","quote":"三年春正月〖5〗，诏曰：“盖君非民不立，民非谷不生。顷者以来〖6〗，民多征役；岁又水旱，年谷有损；而吏〔或〕不良，侵夺民时：以致饥困。自今以来，督军、郡守〖7〗，其谨察非法：当农桑时，以役事扰民者，举正以闻〖8〗。”","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":164,"anchor":null},"note_id":null,"start":0,"end":108}],"profiles":{},"directory_counts":{}}
