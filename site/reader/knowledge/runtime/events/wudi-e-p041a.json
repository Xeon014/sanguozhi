{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p041a","title":"曹操入濮阳后以黄马脱险","accounts":[{"id":"wudi-e-p041a-account","label":"《献帝春秋》","text":"《献帝春秋》记田氏为内应使曹操入城，败后曹操被吕布骑兵拦住，以黄马之说脱身并突火而出。","evidence":["wudi-e-p041a-q"]}],"participants":[{"person":"cao-cao","role":"入城脱险","evidence":["wudi-e-p041a-q"]},{"person":"wudi-p0088","role":"其骑兵拦截曹操","evidence":["wudi-e-p041a-q"]}],"place":{"text":"濮阳","evidence":["wudi-e-p041a-q"]},"time":{"label":"兴平元年","year":194,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-p041a-q","wudi-q-o028","wudi-q-b-927979d68d5dacfd36fe"],"chronology":"wudi-y194","dating_review":{"anchor":"wudi-q-o028","basis":"兴平元年","reviewed":true}},"source_order":[1,232,"P041a"],"order":102}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0088","name":"吕布","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-p041a-q","section":"chapter-001","block":"b-20894ec0cf7f86e2e3c3","layer":"pei","quote":"﹝一﹞袁#《献帝春秋》曰：“太祖围濮阳，濮阳大姓田氏，为反间，太祖得入城。烧其东门，示无返意。及战，军败。布骑得太祖，而不知是，问曰：‘曹操何在？’太祖曰：‘乘黄马走者，是也！’布骑乃释太祖而追黄马者。门火犹盛，太祖突火而出。”","attribution":"《献帝春秋》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":231,"anchor":null},"note_id":"n-b560032f5cf0381f9eee","start":0,"end":114},{"id":"wudi-q-b-927979d68d5dacfd36fe","section":"chapter-001","block":"b-927979d68d5dacfd36fe","layer":"modern","quote":"〖1〗二年：兴平二年（公元 195）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":246,"anchor":null},"note_id":"n-8c38464987eb86819ded","start":0,"end":19},{"id":"wudi-q-o028","section":"chapter-001","block":"b-fefe0240b8480efce927","layer":"original","quote":"兴平元年春，太祖自徐州还〖1〗。初，太祖父嵩，去官后还谯。董卓之乱，避难琅邪〖2〗。为陶谦所害，故太祖志在复仇东伐。﹝一﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":204,"anchor":null},"note_id":null,"start":0,"end":61}],"profiles":{},"dir