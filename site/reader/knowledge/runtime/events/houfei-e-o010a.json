{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"houfei-e-o010a","title":"陈群谏曹丕追封卞太后父母","accounts":[{"id":"houfei-e-o010a-account","label":"《后妃传》正文","text":"陈群谏曹丕追封卞太后父母","evidence":["houfei-e-o010a-q"]},{"id":"houfei-a-o011-judgment","label":null,"text":"曹丕称陈群议是，令不施行并藏诏为后式。","evidence":["houfei-q-o011-judgment"]}],"participants":[{"person":"wudi-p0394","role":"进谏","evidence":["houfei-e-o010a-q"]},{"person":"wudi-p0170","role":"欲追封","evidence":["houfei-e-o010a-q"]}],"place":null,"time":{"label":"黄初中","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["houfei-e-o010a-q"]},"ordering_evidence":"houfei-e-o010a-q","source_order":[5,43,"O010a"],"order":1350}],"persons":[{"id":"wudi-p0170","name":"曹丕","facts":[],"aliases":[]},{"id":"wudi-p0394","name":"陈群","facts":[],"aliases":[]}],"evidence":[{"id":"houfei-e-o010a-q","section":"chapter-005","block":"b-53993d9f60930c9e24cf","layer":"original","quote":"黄初中，文帝欲追封太后父母。尚书陈群奏曰：“陛下以圣德应运受命，创业革制，当永为后式。案典籍之文，无妇人分土命爵之制。在礼典：妇因夫爵〖8〗。秦违古法〖9〗，汉氏因之〖10〗；非先王之令典也。”","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":42,"anchor":null},"note_id":null,"start":0,"end":97},{"id":"houfei-q-o011-judgment","section":"chapter-005","block":"b-7db62c0ddcc619fd31b4","layer":"original","quote":"帝曰：“此议是也，其勿施行。以作著诏下藏之台阁〖11〗，永为后式。”","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":43,"anchor":null},"note_id":null,"start":0,"end":34}],"profiles":{},"directory_counts":{}}
