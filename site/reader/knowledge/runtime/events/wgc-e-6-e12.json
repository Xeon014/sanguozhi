{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wgc-e-6-e12","title":"田章破蜀伏兵三校","order":5779,"accounts":[{"id":"wgc-a-6-e12","label":"正文","text":"田章破蜀伏兵三校","evidence":["wgc-q0465","wgc-q0076"]}],"participants":[{"person":"shaodi-p0073","role":"遣田章等从剑阁西径出江由","evidence":["wgc-q0465","wgc-q0076"]},{"person":"wgc-p0047","role":"未至百里、先破蜀伏兵三校","evidence":["wgc-q0465","wgc-q0076"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0465","wgc-q0076"]},"ordering_evidence":"wgc-q0465"}],"persons":[{"id":"shaodi-p0073","name":"钟会","facts":[],"aliases":[]},{"id":"wgc-p0047","name":"田章","facts":[],"aliases":[]}],"evidence":[{"id":"wgc-q0076","section":"chapter-028","block":"b-e3e892ba497cf66aa3a6","layer":"original","quote":"邓艾追姜维到阴平，简选精锐；欲从汉德阳入江由、左担道，诣绵竹〖1〗，趋成都，与诸葛绪共行。绪以本受节度邀姜维，西行非本诏；遂进军前向白水，与会合。会遣将军田章等从剑阁西，径出江由。未至百里，章先破蜀伏兵三校〖2〗；艾使章先登。遂长驱而前。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":529,"anchor":null},"note_id":null,"start":0,"end":119},{"id":"wgc-q0465","section":"chapter-028","block":"b-e3e892ba497cf66aa3a6","layer":"original","quote":"会遣将军田章等从剑阁西，径出江由。未至百里，章先破蜀伏兵三校","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":529,"anchor":null},"note_id":null,"start":73,"end":103}],"profiles":{},"directory_counts":{}}
