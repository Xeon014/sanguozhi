1a1a12d","chapter-013":"24c6e486e7f78fc4d59ff01277b36cb77ffb69c68a6a9030889fe00efe4b3d27","chapter-016":"6cfac20452f269a832b087d2e808cc4b3017944d17dca1d5b1e068ebb98d8327","chapter-018":"7a62f43c1f5dc64661b088ef0fdd48392063ef5c49001fa980aa65e766380b23","chapter-019":"a43f6648e6c9d8389d561bee9d00824665f8f06542ab2a65aac06ed8a7601c5b","chapter-020":"2ef7e28be018140e07d27d7636a9df480a5cb7ef1cb3572c314a70e0d1acd07c","chapter-050":"71faaaddb69f25a5bdd7f315f15562e867eed9e897c9bd439a99a09c435bfe91","chapter-023":"908d4e64a01e171bdb09c0a7ee5484b8743be26b7cc75f49bd8b41b7ff391ff2","chapter-024":"39be893c0040dbb3148f9447402c47fc24dcb4356360f8558243258cb85b089a","chapter-025":"f37fc365e7d07f96b5fd289119e1846fe7f0030d8b46a7195fab316badf817b7","chapter-027":"dd48b2052380e1f6b6f6ffcb4835dd99cfe70efe4a9096fa51448dbdfaa14f00","chapter-062":"7031fb8ebde1ea3c95cdedcf93218fb46f69a71a29a1d9e82361f7108436a86a","chapter-063":"3ae8edfbae98c3e86a518f7022c664ed35a0d68d5ac36b331ceb560e76b1848f","chapter-065":"13c50dd7dc9a229aef1cfb43dd231955a0b1a6359dab04c54708df93fa114e12","chapter-057":"39e3922e223fe25b811b77f14049327071298549de6ed788ba7da697f067f2e3","chapter-021":"18c02b71e8f81644cf71ffea582a8e019509de0b5e9bc11451de595fa03e2cf3","chapter-029":"6ffb35bac29d20aa512b5a734e72f98ec5729b176f1bc5d6837e673bcc00880d","chapter-030":"3e0682212c3e242d0f221308bc203bd8309851b8498b94db16383bdde5234ce1"},"events":[{"id":"wgc-e-6-e7","title":"钟会移檄蜀将吏士民","order":5776,"accounts":[{"id":"wgc-a-6-e7","label":"正文","text":"钟会移檄蜀将吏士民","evidence":["wgc-q0461","wgc-q0462"]},{"id":"wgc-a-add006","label":"正文","text":"钟会移檄蜀将吏士民（檄文）","evidence":["wgc-q0073"]},{"id":"wgc-a-add007","label":"正文","text":"钟会移檄蜀将吏士民（檄文）","evidence":["wgc-q0661"]},{"id":"wgc-a-add008","label":"正文","text":"钟会移檄蜀将吏士民（檄文）","evidence":["wgc-q0074"]},{"id":"wgc-a-add009","label":"正文","text":"钟会移檄蜀将吏士民（檄文）","evidence":["wgc-q0075"]},{"id":"wgc-a-add010","label":"正文","text":"钟会移檄蜀将吏士民（檄文）","evidence":["wgc-q0662"]}],"participants":[{"person":"shaodi-p0073","role":"移檄蜀将吏士民","evidence":["wgc-q0461","wgc-q0462"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0461","wgc-q0462"]},"ordering_evidence":"wgc-q0461"}],"persons":[{"id":"shaodi-p0073","name":"钟会","facts":[],"aliases":[]}],"evidence":[{"id":"wgc-q0073","section":"chapter-028","block":"b-2b6128e9af6c0c763639","layer":"original","quote":"往者汉祚衰微，率土分崩〖11〗；生民之命，几于泯灭。太祖武皇帝神武圣哲，拨乱反正；拯其将坠，造我区夏〖12〗。高祖文皇帝应天顺民，受命践阼。烈祖明皇帝奕世重光〖13〗，恢拓洪业。然江山之外，异政殊俗；率土齐民〖14〗，未蒙王化。此三祖所以顾怀遗恨也。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":475,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":125,"offset_unit":"unicode_code_point"},{"id":"wgc-q0074","section":"chapter-028","block":"b-ad4a9805799e67d1f158","layer":"original","quote":"益州先主以命世英才，兴兵朔野〖24〗；困踬冀、徐之郊〖25〗，制命绍、布之手〖26〗。太祖拯而济之，与隆大好；中更背违，弃同即异。诸葛孔明仍规秦川〖27〗，姜伯约屡出陇右〖28〗；劳动我边境，侵扰我氐、羌。方国家多故，未遑修九伐之征也〖29〗。今边境乂清〖30〗，方内无事；蓄力待时，并兵一向〖31〗。而巴蜀一州之众，分张守备，难以御天下之师；段谷、侯和，沮伤之气〖32〗，难以敌堂堂之阵；比年以来，曾无宁岁，征夫勤瘁，难以当子来之民〖33〗：此皆诸贤所亲见也。蜀相壮见擒于秦〖34〗，公孙述授首于汉，九州之险，是非一姓〖35〗。此皆诸贤所备闻也。明者见危于无形，智者规祸于未萌〖36〗。是以微子去商〖37〗，长为周宾；陈平背项〖38〗，立功于汉。岂晏安鸩毒〖39〗，怀禄而不变哉〖40〗！","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":477,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":345,"offset_unit":"unicode_code_point"},{"id":"wgc-q0075","section":"chapter-028","block":"b-7c536b5df4fd050637db","layer":"original","quote":"今国朝隆天覆之恩，宰辅弘宽恕之德；先惠后诛，好生恶杀。往者吴将孙壹举众内附〖41〗，位为上司〖42〗，宠秩殊异。文钦、唐咨为国大害，叛主雠贼〖43〗，还为戎首〖44〗。咨困逼擒获，钦二子还降，皆将军、封侯；咨与闻国事。壹等穷蹙归命〖45〗，犹加盛宠，况巴蜀贤智见机而作者哉？诚能深鉴成败，邈然高蹈〖46〗；投迹微子之踪，措身陈平之轨；则福同古人，庆流来裔〖47〗；百姓士民，安堵（旧）〔乐〕业；农不易亩，市不回肆〖48〗；去累卵之危，就永安之福。岂不美与！","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":478,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":228,"offset_unit":"unicode_code_point"},{"id":"wgc-q0461","section":"chapter-028","block":"b-6ce326a020412f473132","layer":"original","quote":"会移檄蜀将吏士民曰","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":474,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":9,"offset_unit":"unicode_code_point"},{"id":"wgc-q0462","section":"chapter-028","block":"b-6ce326a020412f473132","layer":"original","quote":"会移檄蜀将吏士民曰：","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":474,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":10,"offset_unit":"unicode_code_point"},{"id":"wgc-q0661","section":"chapter-028","block":"b-e63f8e1a2b4e999216ab","layer":"original","quote":"今主上圣德钦明，绍隆前绪，宰辅忠肃明允〖15〗，劬劳王室〖16〗；布政垂惠而万邦协和，施德百蛮而肃慎致贡。悼彼巴蜀，独为匪民〖17〗；愍此百姓，劳役未已。是以命授六师，龚行天罚〖18〗；征西、雍州、镇西诸军，五道并进〖19〗。古之行军，以仁为本，以义治之；王者之师，有征无战；故虞舜舞干戚而服有苗〖20〗，周武有散财、发廪、表闾之义〖21〗。今镇西奉辞衔命，摄统戎（重）〔车〕；庶弘文告之训〖22〗，以济元元之命〖23〗；非欲穷武极战，以快一朝之（政）〔志〕。故略陈安危之要，其敬听话言。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":476,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":244,"offset_unit":"unicode_code_point"},{"id":"wgc-q0662","section":"chapter-028","block":"b-2c58f0662accdc0a8c91","layer":"original","quote":"若偷安旦夕，迷而不反；大兵一（发）〔放〕，玉石皆碎；虽欲悔之，亦无及已！其详择利害，自求多福；各具宣布，咸使闻知。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":479,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":57,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
