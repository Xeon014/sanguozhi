{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p144a","title":"杨修以鸡肋口令知曹操欲还","accounts":[{"id":"wudi-e-p144a-account","label":"《九州春秋》","text":"曹操出令鸡肋，杨修据此收拾行装，解释曹操有退汉中之意。","evidence":["wudi-e-p144a-q"]}],"participants":[{"person":"cao-cao","role":"出令","evidence":["wudi-e-p144a-q"]},{"person":"wudi-p0392","role":"解令","evidence":["wudi-e-p144a-q"]}],"place":{"text":"汉中","evidence":["wudi-e-p144a-q"]},"time":{"label":"汉中撤军前","year":219,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-p144a-q","wudi-q-o194","wudi-q-b-1e7ae1441471aa22d204"],"chronology":"wudi-y219","dating_review":{"anchor":"wudi-q-o194","basis":"汉中撤军前","reviewed":true}},"source_order":[1,1112,"P144a"],"order":434}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0392","name":"杨修","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-p144a-q","section":"chapter-001","block":"b-febee645f3c37533b12d","layer":"pei","quote":"﹝二﹞《九州春秋》曰：“时王欲还，出令曰‘鸡肋’。官属不知所谓。主簿杨修便自严装，人惊问修：‘何以知之？’修曰：‘夫鸡肋，弃之如可惜，食之无所得；以比汉中，知王欲还也。’”","attribution":"《九州春秋》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":436,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-17b89537074c62353929","start":0,"end":86,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-1e7ae1441471aa22d204","section":"chapter-001","block":"b-1e7ae1441471aa22d204","layer":"modern","quote":"〖1〗二十四年：建安二十四年（公元 219）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":428,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f2589f07b550616f1e63","start":0,"end":23,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o194","section":"chapter-001","block":"b-adb6682558d65fc17e1a","layer":"original","quote":"二十四年春正月〖1〗，仁屠宛，斩音。﹝一﹞","section_title