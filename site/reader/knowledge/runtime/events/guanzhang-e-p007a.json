{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"guanzhang-e-p007a","title":"孙权缓遣助使关羽怒骂孙权书谢许往","accounts":[{"id":"guanzhang-e-p007a-account","label":"《典略》","text":"孙权缓遣助使关羽怒骂孙权书谢许往","evidence":["guanzhang-e-p007a-q"]},{"id":"guanzhang-a-p008-judgment","label":"裴松之论","text":"裴松之以袭羽潜师密发及吕蒙传为据，质疑孙权许亲往助关羽。","evidence":["guanzhang-q-p008-judgment"]}],"participants":[{"person":"sun-quan","role":"遣使致书","evidence":["guanzhang-e-p007a-q"]},{"person":"wudi-p0172","role":"怒斥","evidence":["guanzhang-e-p007a-q"]}],"place":null,"time":{"label":"关羽围樊时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["guanzhang-e-p007a-q"]},"ordering_evidence":"guanzhang-e-p007a-q","source_order":[36,55,"P007a"],"order":6862}],"persons":[{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"wudi-p0172","name":"关羽","facts":[],"aliases":[]}],"evidence":[{"id":"guanzhang-e-p007a-q","section":"chapter-036","block":"b-3bbcba216cd8b086f036","layer":"pei","quote":"﹝一﹞《典略》曰：“羽围樊，权遣使求助之；敕使莫速进，又遣主簿先致命于羽。羽忿其淹迟，又自已得于禁等，乃骂曰：‘狢子敢尔！如使樊城拔，吾不能灭汝邪！’权闻之，知其轻己，伪手书以谢羽，许以自往。”","attribution":"《典略》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":54,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6319365ec2e2e4c89907","start":0,"end":97,"offset_unit":"unicode_code_point"},{"id":"guanzhang-q-p008-judgment","section":"chapter-036","block":"b-e269b6355d91c358309b","layer":"pei","quote":"臣松之以为：荆、吴虽外睦，而内相猜防；故权之袭羽，潜师密发。按《吕蒙传》云：“伏精兵于}~之中，使白衣摇橹，作商贾服。”以此言之，羽不求助于权，权必不语羽当往也。若许相援助，何故匿其形迹乎？","attribution":"裴松之论","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":55,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6319365ec2e2e4c89907","start":0,"end":95,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
