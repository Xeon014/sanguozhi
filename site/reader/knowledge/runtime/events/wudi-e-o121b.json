b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":35,"end":37,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o121b-q","section":"chapter-001","block":"b-031a374e9090ba29242f","layer":"original","quote":"八月，表卒；其子琮代〖4〗，屯襄阳〖5〗。刘备屯樊〖6〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":663,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":10,"end":39,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-888495d8be7766faf20c","section":"chapter-001","block":"b-888495d8be7766faf20c","layer":"modern","quote":"〖1〗十三年：建安十三年（公元 208）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":666,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0bae348fdb687025113d","start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o119","section":"chapter-001","block":"b-4bcffcc4ee709a4e5ea3","layer":"original","quote":"十三年春正月〖1〗，公还邺。作玄武池以肄舟师〖2〗。﹝一﹞汉罢三公官，置丞相、御史大夫〖3〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":661,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":47,"offset_unit":"unicode_code_point"},{"id":"wufan-q-e297cdefd9d420d39248","section":"chapter-063","block":"b-b84cf48ba2c7aa9dcf0c","layer":"original","quote":"会孙权起于东南，范委身服事。每有灾祥，辄推数言状；其术多效，遂以显名。初，权在吴，欲讨黄祖。范曰：“今兹少利，不如明年。明年戊子〖4〗，荆州刘表亦身死国亡。”权遂征祖，卒不能克。明年，军出。行及寻阳，范见风气，因诣船贺，催兵急行。至即破祖，祖（得）夜亡〖5〗。权恐失之，范曰：“未远，必生擒祖。”至五更中，果得之。刘表竟死，荆州分割。","section_title":"吴范刘惇赵达传第十八","source":{"file":"OEBPS/Text/titlepage_0133.xhtml","index":2,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":167,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o024a-q","section":"chapter-032","block":"b-c857386227851cc86ab3","layer":"original","quote":"（曹公南征表）〔及曹公南征〕，会表卒，﹝二﹞子琮代立〖2〗，","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":108,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":30,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
