{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"mingdi-e-o017c","title":"曹真司马懿公孙渊升将军号","accounts":[{"id":"mingdi-e-o017c-account","label":"《明帝纪》正文","text":"曹真司马懿公孙渊升将军号","evidence":["mingdi-e-o017c-q"]}],"participants":[{"person":"wendi-p0038","role":"大司马","evidence":["mingdi-e-o017c-q"]},{"person":"wudi-p0364","role":"大将军","evidence":["mingdi-e-o017c-q"]},{"person":"mingdi-p0013","role":"车骑将军","evidence":["mingdi-e-o017c-q"]}],"place":null,"time":{"year":230,"label":"二月癸巳","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"mingdi-y230","dating_review":{"reviewed":true,"anchor":"mingdi-q-o017","basis":"二月癸巳"},"evidence":["mingdi-e-o017c-q","mingdi-q-o017","mingdi-q-b-bb76480af553d2282673"]},"ordering_evidence":"mingdi-e-o017c-q","source_order":[3,126,"O017c"],"order":772}],"persons":[{"id":"mingdi-p0013","name":"公孙渊","facts":[],"aliases":[]},{"id":"wendi-p0038","name":"曹真","facts":[],"aliases":[]},{"id":"wudi-p0364","name":"司马懿","facts":[],"aliases":[]}],"evidence":[{"id":"mingdi-e-o017c-q","section":"chapter-003","block":"b-cbdedf2111b567dd6b4d","layer":"original","quote":"四年春二月，壬午〖1〗，诏曰：“世之质文〖2〗，随教而变。兵乱以来，经学废绝；后生进趣，不由典谟〖3〗。岂〔朕〕训导未洽〖4〗，将进用者不以德显乎〖5〗？其郎吏学通一经〖6〗，才任牧民；博士课试，擢其高第者〖7〗：亟用〖8〗。其浮华不务道本者〖9〗，皆罢退之。”戊子〖10〗，诏太傅、三公：“以文帝《典论》刻石〖11〗，立于庙门之外。”癸巳〖12〗，以大将军曹真为大司马，骠骑将军司马宣王为大将军，辽东太守公孙渊为车骑将军〖13〗。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":125,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":216,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-b-bb76480af553d2282673","section":"chapter-003","block":"b-bb76480af553d2282673","layer":"modern","quote":"〖1〗四年：太和四年（公元 230）。壬午：旧历初四日。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":130,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"