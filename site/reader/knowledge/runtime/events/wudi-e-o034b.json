{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o034b","title":"陶谦卒而刘备代领","accounts":[{"id":"wudi-e-o034b-account","label":"正文","text":"陶谦去世，刘备接替。","evidence":["wudi-e-o034b-q"]},{"id":"xianzhu-e-o009b-account","label":"《先主传》正文","text":"陶谦临终向麋竺推举刘备；麋竺迎立，陈登、孔融说服刘备，刘备遂领徐州。","evidence":["xianzhu-e-o009b-q"]},{"id":"huanchen-a-cf410b584e89c41e660f","label":"正文","text":"陶谦卒徐州迎备群谏勿东备遂东","evidence":["huanchen-q-7700f6cd209511e7343b"]},{"id":"gongsuntao-a-416a9ac95cf4905052fc","label":"正文","text":"是岁谦病死","evidence":["gongsuntao-q-f2070888381a83d16d5c"]},{"id":"xumisun-a-1dc6638f0cf56924ac1a","label":"正文","text":"麋竺奉遗命迎刘备","evidence":["xumisun-q-b87d1a96ca892cae0a6b"]}],"participants":[{"person":"wudi-p0095","role":"去世","evidence":["wudi-e-o034b-q"]},{"person":"liu-bei","role":"接替","evidence":["wudi-e-o034b-q"]},{"person":"xianzhu-p0021","role":"迎立","evidence":["xianzhu-e-o009b-q"]},{"person":"xianzhu-p0022","role":"劝进","evidence":["xianzhu-e-o009b-q"]},{"person":"wudi-p0155","role":"劝进","evidence":["xianzhu-e-o009b-q"]},{"person":"wudi-p0394","role":"谏袁术尚强吕布袭后","evidence":["huanchen-q-7700f6cd209511e7343b"]},{"person":"wudi-p0057","role":"与备战者","evidence":["huanchen-q-7700f6cd209511e7343b"]},{"person":"wudi-p0088","role":"果袭下邳助术破备","evidence":["huanchen-q-7700f6cd209511e7343b"]}],"place":null,"time":{"label":"兴平元年","year":194,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o034b-q","wudi-q-o028","wudi-q-b-927979d68d5dacfd36fe"],"chronology":"wudi-y194","dating_review":{"anchor":"wudi-q-o028","basis":"兴平元年","reviewed":true}},"source_order":[1,235,"O034b"],"order":107}],"persons":[{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"wudi-p0057","name":"袁术","facts":[],"aliases":[]},{"id":"wudi-p0088","name":"吕布","facts":[],"aliases":[]},{"id":"wudi-p0095","name":"陶谦","facts":[],"aliases":[]},{"id":"wudi-p0155","name":"孔融","facts":[],"aliases":[]},{"id":"wudi-p0394","name":"陈群","facts":[],"aliases":[]},{"id":"xianzhu-p0021","name":"麋竺","facts":[],"aliases":[]},{"id":"xianzhu-p0022","name":"陈登","facts":[],"aliases":[]}],"evidence":[{"id":"gongsuntao-q-f2070888381a83d16d5c","section":"chapter-008","block":"b-d4288ccd4470bb04ff2a","layer":"original","quote":"是岁，谦病死","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":126,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":42,"end":48,"offset_unit":"unicode_code_point"},{"id":"huanchen-q-7700f6cd209511e7343b","section":"chapter-022","block":"b-697e9917d0a7eb79ce7f","layer":"original","quote":"时陶谦病死〖7〗，徐州迎备；备欲往，群说备曰：“袁术尚强〖8〗；今东〖9〗，必与之争。吕布若袭将军之后〖10〗，将军虽得徐州，事必无成。”备遂东，与袁术战。布果袭下邳〖11〗；遣兵助术，大破备军。备恨不用群言。","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":57,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":18,"end":123,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o034b-q","section":"chapter-001","block":"b-7e852afeccc6f4ba0787","layer":"original","quote":"陶谦死，刘备代之。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":234,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":27,"end":36,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-927979d68d5dacfd36fe","section":"chapter-001","block":"b-927979d68d5dacfd36fe","layer":"modern","quote":"〖1〗二年：兴平二年（公元 195）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":246,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8c38464987eb86819ded","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o028","section":"chapter-001","block":"b-fefe0240b8480efce927","layer":"original","quote":"兴平元年春，太祖自徐州还〖1〗。初，太祖父嵩，去官后还谯。董卓之乱，避难琅邪〖2〗。为陶谦所害，故太祖志在复仇东伐。﹝一﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":204,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":61,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o009b-q","section":"chapter-032","block":"b-939a0c2b5149377c476b","layer":"original","quote":"谦病笃，谓别驾麋竺曰〖3〗：“非刘备，不能安此州也！”谦死，竺率州人迎先主。先主未敢当，下邳陈登谓先主曰：“今汉室陵迟，海内倾覆；立功立事，在于今日！（彼）〔鄙〕州殷富〖4〗，户口百万；欲屈使君，抚临州事。”先主曰：“袁公路近在寿春〖5〗；此君四世五公〖6〗，海内所归；君可以州与之。”登曰：“公路骄豪，非治乱之主！今欲为使君合步骑十万：上可以匡主济民，成五霸之业〖7〗；下可以割地守境，书功于竹帛。若使君不见听许，登亦未敢听使君也！”北海相孔融谓先主曰：“袁公路岂忧国忘家者邪？冢中枯骨〖8〗，何足介意！今日之事，百姓与能〖9〗；天与不取，悔不可追！”先主遂领徐州。﹝一﹞","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":39,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":17,"end":304,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-b87d1a96ca892cae0a6b","section":"chapter-038","block":"b-719670e32a6cfc0ac3bf","layer":"original","quote":"谦卒，竺奉谦遗命，迎先主于小沛","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":173,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":58,"end":73,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
