{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"yaoci-e2-wu049-030","title":"陈寿评刘繇、太史慈、士燮","accounts":[{"id":"yaoci-a2-4661f1537b3ee0651e87","label":"陈寿评","text":"陈寿评刘繇、太史慈、士燮","evidence":["yaoci-q2-63590502637a0aaf1122"]}],"participants":[],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["yaoci-q2-63590502637a0aaf1122"]},"ordering_evidence":"yaoci-q2-63590502637a0aaf1122","order":9007}],"persons":[],"evidence":[{"id":"yaoci-q2-63590502637a0aaf1122","section":"chapter-049","block":"b-838723868d860f0b4830","layer":"original","quote":"评曰：刘繇藻厉名行〖1〗，好尚臧否〖2〗；至于扰攘之时〖3〗，据万里之土〖4〗，非其长也。太史慈信义笃烈，有古人之分。士燮作守南越，优游终世；至子不慎，自贻凶咎：盖庸才玩富贵而恃阻险使之然也〖5〗。","attribution":"陈寿评","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":249,"anchor":null},"note_id":null,"start":0,"end":99}],"profiles":{},"directory_counts":{}}
