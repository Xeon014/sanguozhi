{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"luxun-e-o050a","title":"陆议议以民为本宜先宁济百姓","accounts":[{"id":"luxun-e-o050a-account","label":"《陆逊传第十三》正文","text":"陆议议以民为本宜先宁济百姓","evidence":["luxun-e-o050a-q"]}],"participants":[{"person":"xianzhu-p0115","role":"议政","evidence":["luxun-e-o050a-q"]}],"place":null,"time":{"label":"谢渊谢厷献策后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["luxun-e-o050a-q"]},"ordering_evidence":"luxun-e-o050a-q","source_order":[58,232,"O050a"],"order":10357}],"persons":[{"id":"xianzhu-p0115","name":"陆逊","facts":[],"aliases":[]}],"evidence":[{"id":"luxun-e-o050a-q","section":"chapter-058","block":"b-5398f8cec39e33c08ff0","layer":"original","quote":"逊议曰：“国以民为本：强由民力，财由民出。夫民殷国弱〖7〗，民瘠国强者，未之有也。故为国者，得民则治，失之则乱；若不受利，而令尽用立效〖8〗，亦为难也。是以《诗》叹‘宜民宜人〖9〗，受禄于天’。乞垂圣恩，宁济百姓。数年之间，国用少丰，然后更图。”","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":231,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":123,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
