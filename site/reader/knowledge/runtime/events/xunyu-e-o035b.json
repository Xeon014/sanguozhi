{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xunyu-e-o035b","title":"荀攸郑泰何颙种辑伍琼谋刺董卓事泄何颙自杀荀攸后免","accounts":[{"id":"xunyu-e-o035b-account","label":"《荀彧荀攸贾诩传第十》正文","text":"荀攸郑泰何颙种辑伍琼谋刺董卓事泄何颙自杀荀攸后免","evidence":["xunyu-e-o035b-q"]},{"id":"xunyu-a-p037-judgment","label":"《魏书》","text":"《魏书》称荀攸遣人说董卓而免，与正文董卓死后得免不同。","evidence":["xunyu-q-p037-judgment"]},{"id":"rensu-a-09e58f4af1ae89c2efe3","label":"正文","text":"郑泰与荀攸等谋诛董卓","evidence":["rensu-q-c21e8c32e233b8003b27"]}],"participants":[{"person":"wudi-p0143","role":"谋刺入狱获免","evidence":["xunyu-e-o035b-q"]},{"person":"wudi-p0067","role":"谋刺","evidence":["xunyu-e-o035b-q"]},{"person":"wudi-p0029","role":"谋刺而死","evidence":["xunyu-e-o035b-q"]},{"person":"xianzhu-p0024","role":"谋刺","evidence":["xunyu-e-o035b-q"]},{"person":"xunyu-p0076","role":"谋刺","evidence":["xunyu-e-o035b-q"]},{"person":"wudi-p0053","role":"谋诛对象","evidence":["rensu-q-c21e8c32e233b8003b27"]}],"place":null,"time":{"label":"何进征名士至董卓死","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xunyu-e-o035b-q"]},"ordering_evidence":"xunyu-e-o035b-q","source_order":[10,193,"O035b"],"order":2474}],"persons":[{"id":"wudi-p0029","name":"何颙","facts":[],"aliases":[]},{"id":"wudi-p0053","name":"董卓","facts":[],"aliases":[]},{"id":"wudi-p0067","name":"郑泰","facts":[],"aliases":[]},{"id":"wudi-p0143","name":"荀攸","facts":[],"aliases":[]},{"id":"xianzhu-p0024","name":"种辑","facts":[],"aliases":[]},{"id":"xunyu-p0076","name":"伍琼","facts":[],"aliases":[]}],"evidence":[{"id":"rensu-q-c21e8c32e233b8003b27","section":"chapter-016","block":"b-0ec29c53f32db50fc2e0","layer":"original","quote":"浑兄泰，与荀攸等谋诛董卓","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":315,"anchor":null},"note_id":null,"start":44,"end":56},{"id":"xunyu-e-o035b-q","section":"chapter-010","block":"b-a71a6145f32bc39dc4a6","layer":"original","quote":"董卓之乱，关东兵起，卓徙都长安。攸与议郎郑泰、何颙，侍中种辑，越骑校尉伍琼等谋曰〖3〗：“董卓无道，甚于桀、纣，天下皆怨之；虽资强兵〖4〗，实一匹夫耳！今直刺杀之，以谢百姓；然后据殽、函〖5〗，辅王命，以号令天下。此桓、文之举也。”事垂就而觉，收颙、攸系狱；颙忧惧自杀，﹝三﹞攸言语饮食自若。会卓死，得免。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":192,"anchor":null},"note_id":null,"start":27,"end":180},{"id":"xunyu-q-p037-judgment","section":"chapter-010","block":"b-51e04de8f5d89ce7b7e7","layer":"pei","quote":"﹝四﹞《魏书》云“攸使人说卓，得免”，与此不同。","attribution":"《魏书》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":206,"anchor":null},"note_id":"n-d0ad75dc84a584928116","start":0,"end":24}],"profiles":{},"directory_counts":{}}
