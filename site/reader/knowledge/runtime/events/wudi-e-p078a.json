{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p078a","title":"曹操令属吏按月言失","accounts":[{"id":"wudi-e-p078a-account","label":"《魏书》","text":"《魏书》载曹操令掾属、治中、别驾每月初一陈述自己的过失。","evidence":["wudi-e-p078a-q"]}],"participants":[{"person":"cao-cao","role":"征求批评","evidence":["wudi-e-p078a-q"]}],"place":null,"time":{"label":"建安十一年十月乙亥","year":206,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-p078a-q","wudi-q-o107","wudi-q-b-6509a80488ce395ecab9"],"chronology":"wudi-y206","dating_review":{"anchor":"wudi-q-o107","basis":"建安十一年十月乙亥","reviewed":true}},"source_order":[1,619,"P078a"],"order":248}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-p078a-q","section":"chapter-001","block":"b-c949b7d48e5abda7f02e","layer":"pei","quote":"﹝一﹞《魏书》载十月乙亥令曰：“夫治世御众，建立辅弼，诫在面从。《诗》称‘听用我谋，庶无大悔’，斯实君臣恳恳之求也。吾充重任，每惧失中；频年以来，不闻嘉谋。岂吾开延不勤之咎邪？自今以后，诸掾属、治中、别驾，常以月旦，各言其失。吾将览焉。”","attribution":"《魏书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":618,"anchor":null},"note_id":"n-e784a6850f2486a6ba34","start":0,"end":119},{"id":"wudi-q-b-6509a80488ce395ecab9","section":"chapter-001","block":"b-6509a80488ce395ecab9","layer":"modern","quote":"〖1〗十一年：建安十一年（公元 206）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":603,"anchor":null},"note_id":"n-60fd0962dbcc47eb5807","start":0,"end":21},{"id":"wudi-q-o107","section":"chapter-001","block":"b-25deb42237a5de280ce3","layer":"original","quote":"十一年春正月〖1〗，公征幹。幹闻之，乃留其别将守城，走入匈奴，求救于单于〖2〗。单于不受。公围壶关三月，拔之。幹遂走荆州〖3〗，上洛都尉王琰捕斩之。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":598,"anchor":null},"note_id":null,"start":0,"end":74}],"profiles":{},"directory_counts":{}}
