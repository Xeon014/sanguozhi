["zhulv-q-c03cc9d0b63dbe4212b5"]}],"participants":[{"person":"mingdi-p0046","role":"围攻","evidence":["shaodi-e-o013a-q"]},{"person":"wudi-p0364","role":"拒敌","evidence":["shaodi-e-o013a-q"]},{"person":"liusima-p0001","role":"城中守将，等求救甚急；等遥见之","evidence":["liusima-q-70d7dc6fd929ae6d41a4","liusima-q-2c64e66934fef0012fa0"]},{"person":"xiahoucao-p0025","role":"进屯邓塞，以兵少不敢进，但作鼓吹设导从，去然六七里翱翔而还，使修等遥见之，数数如是；及太傅到乃俱进","evidence":["liusima-q-2c64e66934fef0012fa0","liusima-q-3ef9ed0e108f57517e16"]},{"person":"wuzhu-p0127","role":"破外围者","evidence":["zhulv-q-b67f8c2f45d747b56b24"]},{"person":"wuzhu-p0126","role":"破外围者；从攻而建计者","evidence":["zhulv-q-b67f8c2f45d747b56b24","zhulv-q-c03cc9d0b63dbe4212b5"]}],"place":{"text":"樊城","evidence":["shaodi-q-o013"]},"time":{"year":241,"label":"夏五月至六月","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"shaodi-y241","dating_review":{"reviewed":true,"anchor":"shaodi-q-o012","basis":"夏五月至六月"},"evidence":["shaodi-e-o013a-q","shaodi-q-o012","shaodi-q-b-f56b355cff79244bd89c"]},"ordering_evidence":"shaodi-e-o013a-q","source_order":[4,60,"O013a"],"related_events":[{"event":"wuzhu-e-o133b","type":"related","evidence":["wuzhu-e-o133b-q","shaodi-e-o013a-q"]}],"order":1001}],"persons":[{"id":"hequan-p0007","name":"全绪","facts":[],"aliases":[]},{"id":"luxun-p0044","name":"顾承","facts":[],"aliases":[]},{"id":"mingdi-p0002","name":"诸葛瑾","facts":[],"aliases":[]},{"id":"mingdi-p0046","name":"朱然","facts":[],"aliases":[]},{"id":"shaodi-p0004","name":"王凌","facts":[],"aliases":[]},{"id":"shaodi-p0005","name":"全琮","facts":[],"aliases":[]},{"id":"shaodi-p0031","name":"孙礼","facts":[],"aliases":[]},{"id":"shaodi-p0042","name":"全端","facts":[],"aliases":[]},{"id":"wgc-p0072","name":"张休","facts":[],"aliases":[]},{"id":"wuzhu-p0106","name":"秦晃","facts":[],"aliases":[]}],"evidence":[{"id":"hancui-q-2554659cfd2fbba6bd23","section":"chapter-024","block":"b-f3afcdb8c325c1801064","layer":"original","quote":"吴大将全琮帅数万众来侵寇〖21〗；时州兵休使〖22〗，在者无几。礼躬勒卫兵御之，战于芍陂〖23〗；自旦及暮，将士死伤过半。礼犯蹈白刃，马被数创，手秉枹鼓〖24〗，奋不顾身；贼众乃退。","section_title":"韩崔高孙王传第二十四","source":{"file":"OEBPS/Text/titlepage_0054.xhtml","index":338,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":42,"end":133,"offset_unit":"unicode_code_point"},{"id":"shaodi-e-o013a-q","section":"chapter-004","block":"b-0cd1e6082bde64409582","layer":"original","quote":"夏五月，吴将朱然等围襄阳之樊城，太傅司马宣王率众拒之。﹝一﹞六月，辛丑〖5〗，退。己卯〖6〗，以征东将军王凌为车骑将军〖7〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":59,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":63,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-b-f56b355cff79244bd89c","section":"chapter-004","block":"b-f56b355cff79244bd89c","layer":"modern","quote":"〖1〗二年：正始二年（公元 241）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":62,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-bf9ccbeb544f540e6afb","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o012","section":"chapter-004","block":"b-33e60ac0c003858f0640","layer":"original","quote":"二年春二月〖1〗，帝初通《论语》〖2〗。使太常以太牢祭孔子于辟雍〖3〗，以颜渊配〖4〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":58,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":44,"offset_unit":"unicode_code_point"},{"id":"wgc-q0005","section":"chapter-028","block":"b-280a1e8d1f852b5e78af","layer":"original","quote":"二年〖1〗，吴大将全琮数万众寇芍陂〖2〗。凌率诸军逆讨，与贼争塘，力战连日，贼退走。进封南乡侯，邑千三百五十户；迁车骑将军，仪同三司。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":21,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":67,"offset_unit":"unicode_code_point"},{"id":"wgc-q0159","section":"chapter-028","block":"b-280a1e8d1f852b5e78af","layer":"original","quote":"吴大将全琮数万众寇芍陂〖2〗。凌率诸军逆讨，与贼争塘，力战连日，贼退走","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":21,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":6,"end":41,"offset_unit":"unicode_code_point"},{"id":"wuzhu-e-o133b-q","section":"chapter-047","block":"b-8af6f7908a818f7cd9b1","layer":"original","quote":"琮与魏将王凌，战于芍陂；中郎将秦晃等十余人，战死。车骑将军朱然围樊，大将军诸葛瑾取柤中〖15〗。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":168,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":56,"end":104,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o132","section":"chapter-047","block":"b-339340f557e9065aedfa","layer":"original","quote":"四年春正月〖10〗，大雪，平地深三尺，鸟兽死者太半。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":167,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":26,"offset_unit":"unicode_code_point"},{"id":"zhanggu-q-2113b80d6f9f8a3da0c7","section":"chapter-052","block":"b-027aa53bd5dbba95ebf6","layer":"original","quote":"时长公主婿卫将军全琮子寄，为霸宾客〖19〗；寄素倾邪〖20〗，谭所不纳。先是，谭弟承与张休俱北征寿春，全琮时为大都督；与魏将王凌战于芍陂，军不利，魏兵乘胜陷没五营将秦（儿）〔晃〕军；休、承奋击之，遂驻魏师〖21〗。时琮群子绪、端，亦并为将，因敌既驻，乃进击之：凌军用退","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":197,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":134,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
