{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wuzhu-e-p016a","title":"孙权问星气有称帝意先事魏","accounts":[{"id":"wuzhu-e-p016a-account","label":"《魏略》","text":"孙权问星气有称帝意先事魏","evidence":["wuzhu-e-p016a-q"]}],"participants":[{"person":"sun-quan","role":"问星气称臣","evidence":["wuzhu-e-p016a-q"]},{"person":"wudi-p0170","role":"被事","evidence":["wuzhu-e-p016a-q"]}],"place":null,"time":{"label":"曹丕受禅刘备称帝后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["wuzhu-e-p016a-q"]},"ordering_evidence":"wuzhu-e-p016a-q","source_order":[47,288,"P016a"],"order":8209}],"persons":[{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"wudi-p0170","name":"曹丕","facts":[],"aliases":[]}],"evidence":[{"id":"wuzhu-e-p016a-q","section":"chapter-047","block":"b-5dfbee03f5f715458aa8","layer":"pei","quote":"﹝二﹞《魏略》曰：“权闻魏文帝受禅，而刘备称帝；乃呼问知星者，己‘分野中星气何如’？遂有僭意。而以位次尚少，无以威众；又欲先卑而后踞之。为卑则可以假宠，后踞则必致讨；致讨然后可以怒众，众怒然后可以自大：故深绝蜀而专事魏。”","attribution":"《魏略》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":287,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cbad41f7e7fe29b83d2f","start":0,"end":111,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
