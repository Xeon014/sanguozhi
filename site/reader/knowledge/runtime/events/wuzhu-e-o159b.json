{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wuzhu-e-o159b","title":"孙权废孙和处故鄣赐孙霸死","accounts":[{"id":"wuzhu-e-o159b-account","label":"《吴主传第二》正文","text":"孙权废孙和处故鄣赐孙霸死","evidence":["wuzhu-e-o159b-q"]},{"id":"wuzhu-a-p076-judgment","label":"裴松之论","text":"裴松之驳以废和为亡国根因的判断，认为暴皓致亡，并举反事实论证。","evidence":["wuzhu-q-p076-judgment"]}],"participants":[{"person":"sun-quan","role":"废储赐死","evidence":["wuzhu-e-o159b-q"]},{"person":"wuzhu-p0113","role":"被废","evidence":["wuzhu-e-o159b-q"]},{"person":"wuzhu-p0116","role":"赐死","evidence":["wuzhu-e-o159b-q"]}],"place":null,"time":{"year":250,"label":"秋七月至八月","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"wuzhu-y250","dating_review":{"reviewed":true,"anchor":"wuzhu-q-o158","basis":"秋七月至八月"},"evidence":["wuzhu-e-o159b-q","wuzhu-q-o158","shaodi-q-o046","shaodi-q-b-33155276d789f594176b"]},"ordering_evidence":"wuzhu-e-o159b-q","source_order":[47,778,"O159b"],"order":8401}],"persons":[{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"wuzhu-p0113","name":"孙和","facts":[],"aliases":[]},{"id":"wuzhu-p0116","name":"孙霸","facts":[],"aliases":[]}],"evidence":[{"id":"shaodi-q-b-33155276d789f594176b","section":"chapter-004","block":"b-33155276d789f594176b","layer":"modern","quote":"〖13〗二年：嘉平二年（公元 250）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":198,"anchor":null},"note_id":"n-235bc158a4eae2a0609a","start":0,"end":20},{"id":"shaodi-q-o046","section":"chapter-004","block":"b-8bc97b77985c9cc83eeb","layer":"original","quote":"二年夏五月〖13〗，以征西将军郭淮为车骑将军〖14〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":183,"anchor":null},"note_id":null,"start":0,"end":27},{"id":"wuzhu-e-o159b-q","section":"chapter-047","block":"b-cab648dda000f8546177","layer":"original","quote":"废太子和〖17〗，处故鄣；鲁王霸，赐死。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":266,"anchor":null},"note_id":null,"start":59,"end":79},{"id":"wuzhu-q-o158","section":"chapter-047","block":"b-781d2f88aede8a4f2628","layer":"original","quote":"十三年夏五月〖10〗，日至〖11〗，荧惑入南斗〖12〗。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":265,"anchor":null},"note_id":null,"start":0,"end":28},{"id":"wuzhu-q-p076-judgment","section":"chapter-047","block":"b-69fcfbf889ec41c68ff7","layer":"pei","quote":"﹝二﹞臣松之以为：孙权横废无罪之子，虽为兆乱；然国之倾覆，自由暴皓。若权不废和，皓为世嫡，终至灭亡，有何异哉！此则丧国由于昏虐，不在于废黜也。设使亮保国祚，休不早死，则皓不得立；皓不得立，则吴不亡矣。","attribution":"裴松之论","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":341,"anchor":null},"note_id":"n-02886fb29e73419f9247","start":0,"end":100}],"profiles":{},"directory_counts":{}}
