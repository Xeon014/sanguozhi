{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wendi-e-o022a","title":"曹仁任大将军","accounts":[{"id":"wendi-e-o022a-account","label":"《文帝纪》正文","text":"曹仁任大将军","evidence":["wendi-e-o022a-q"]},{"id":"xiahoucao-e-o030b-account","label":"《诸夏侯曹传第九》正文","text":"曹丕遣使拜曹仁大将军","evidence":["xiahoucao-e-o030b-q"]}],"participants":[{"person":"cao-ren","role":"受任","evidence":["wendi-e-o022a-q"]},{"person":"wudi-p0170","role":"授官","evidence":["xiahoucao-e-o030b-q"]}],"place":null,"time":{"year":221,"label":"黄初二年四月","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"wendi-y221","dating_review":{"reviewed":true,"anchor":"wendi-q-o019","basis":"黄初二年四月"},"evidence":["wendi-e-o022a-q","wendi-q-o019","wendi-q-b-ec88012a7f6c352d0e04"]},"ordering_evidence":"wendi-e-o022a-q","source_order":[2,231,"O022a"],"order":577}],"persons":[{"id":"cao-ren","name":"曹仁","facts":[],"aliases":[]},{"id":"wudi-p0170","name":"曹丕","facts":[],"aliases":[]}],"evidence":[{"id":"wendi-e-o022a-q","section":"chapter-002","block":"b-f05723e78a83ba5b015e","layer":"original","quote":"夏四月，以车骑将军曹仁为大将军。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":230,"anchor":null},"note_id":null,"start":0,"end":16},{"id":"wendi-q-b-ec88012a7f6c352d0e04","section":"chapter-002","block":"b-ec88012a7f6c352d0e04","layer":"modern","quote":"〖1〗二年：黄初二年（公元 221）。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":210,"anchor":null},"note_id":"n-8fff547b113ffa36bbc1","start":0,"end":19},{"id":"wendi-q-o019","section":"chapter-002","block":"b-8820e5c7f9006d364c44","layer":"original","quote":"二年春正月〖1〗，郊祀天地、明堂〖2〗。甲戌〖3〗，校猎至原陵〖4〗。遣使者，以太牢祠汉世祖〖5〗。乙亥〖6〗，朝日于东郊〖7〗。﹝一﹞初令郡国口满十万者〖8〗，岁察孝廉一人；其有秀异〖9〗，无拘户口。辛巳〖10〗，分三公户邑，封子弟各一人为列侯。壬午〖11〗，复颍川郡一年田租〖12〗。﹝二﹞改许县为许昌县。以魏郡东部为阳平郡〖13〗，西部为广平郡〖14〗。﹝三﹞","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":208,"anchor":null},"note_id":null,"start":0,"end":183},{"id":"xiahoucao-e-o030b-q","section":"chapter-009","block":"b-c437a5d357838e7708fe","layer":"original","quote":"文帝遣使，即拜仁大将军〖11〗。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":136,"anchor":null},"note_id":null,"start":58,"end":74}],"profiles":{},"directory_counts":{}}
