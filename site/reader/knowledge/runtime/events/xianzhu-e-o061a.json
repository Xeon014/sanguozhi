{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-o061a","title":"曹丕称帝改元黄初","accounts":[{"id":"xianzhu-e-o061a-account","label":"《先主传》正文","text":"魏文帝曹丕称帝，改元黄初。","evidence":["xianzhu-e-o061a-q"]},{"id":"wendi-e-o014a-account","label":"《文帝纪》正文","text":"庚午，延康改黄初之际，曹丕登坛即帝位。","evidence":["wendi-e-o014a-q"]},{"id":"wendi-a-p067-alternative","label":"裴注·献帝传","text":"《献帝传》记辛未受禅，与正文庚午异；保留两种日期。","evidence":["wendi-q-p067-alternative"]},{"id":"wendi-a-p068-remark","label":"裴注·魏氏春秋","text":"《魏氏春秋》载曹丕升坛礼毕论舜禹之事。","evidence":["wendi-q-p068-remark"]},{"id":"wendi-e-o014b-account","label":"《文帝纪》正文","text":"黄初元年，改元黄初大赦。","evidence":["wendi-e-o014b-q"]},{"id":"wendi-a-p067-decree","label":"裴注·献帝传","text":"《献帝传》所载受禅诏改延康为黄初并大赦。","evidence":["wendi-q-p067-decree"]},{"id":"wendi-a-p071-calendar","label":"裴注·魏书","text":"魏书补述采用夏正，以建寅为正月，服色尚黄。","evidence":["wendi-q-p071-calendar"]},{"id":"wuzhu-e-o041a-account","label":"《吴主传第二》正文","text":"曹丕称帝改元黄初","evidence":["wuzhu-e-o041a-q"]},{"id":"wgc-a-0-e6","label":"正文","text":"曹丕称帝","evidence":["wgc-q0147","wgc-q0002"]},{"id":"cuimao-a-b95a321bd519cdffc398","label":"正文","text":"文帝受禅","evidence":["cuimao-q-77011d012be1278780d6"]},{"id":"zhonghua-a-b480f212d37d535a7a72","label":"裴注·魏书","text":"文帝受禅，华歆登坛相仪，奉皇帝玺绶，以成受命之礼","evidence":["zhonghua-q-41e9bb3ad6e68b418f37"]}],"participants":[{"person":"wudi-p0170","role":"称帝改元","evidence":["xianzhu-e-o061a-q"]},{"person":"wudi-p0340","role":"登坛相仪奉玺绶者","evidence":["zhonghua-q-41e9bb3ad6e68b418f37"]}],"place":null,"time":{"year":220,"label":"建安二十五年","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xianzhu-y220","dating_review":{"reviewed":true,"anchor":"xianzhu-q-o061","basis":"建安二十五年"},"evidence":["xianzhu-e-o061a-q","xianzhu-q-o061","xianzhu-q-b-702ed09e6ffd28cb4f1b"]},"source_order":[32,317,"O061a"],"order":507}],"persons":[{"id":"wudi-p0170","name":"曹丕","facts":[],"aliases":[]},{"id":"wudi-p0340","name":"华歆","facts":[],"aliases":[]}],"evidence":[{"id":"cuimao-q-77011d012be1278780d6","section":"chapter-012","block":"b-de953617adca4d22f61a","layer":"original","quote":"文帝受禅","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":299,"anchor":null},"note_id":null,"start":25,"end":29},{"id":"wendi-e-o014a-q","section":"chapter-002","block":"b-e5916fff2d5a996fb2f8","layer":"original","quote":"庚午〖31〗，王升坛，即阼〖32〗；百官陪位。事讫，降坛，视燎成礼而反〖33〗。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":98,"anchor":null},"note_id":null,"start":0,"end":40},{"id":"wendi-e-o014b-q","section":"chapter-002","block":"b-e5916fff2d5a996fb2f8","layer":"original","quote":"改延康为黄初，大赦。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":98,"anchor":null},"note_id":null,"start":40,"end":50},{"id":"wendi-q-p067-alternative","section":"chapter-002","block":"b-d6ee5b412f1384d4b785","layer":"pei","quote":"﹝三﹞《献帝传》曰：“辛未，魏王登坛，受禅。公卿、列侯、诸将、匈奴单于、四夷朝者数万人，陪位。燎祭天地、五岳、四渎，曰：‘皇帝臣丕，敢用玄牡，昭告于皇皇后帝：汉历世二十有四，践年四百二十有六；四海困穷，三纲不立；五纬错行，灵祥并见。推术数者，虑之古道，咸以为天之历数，运终兹世；凡诸嘉祥民神之意，比昭有汉数终之极、魏家受命之符。汉主以神器宜授于臣，宪章有虞，致位于丕。丕震畏天命，虽休勿休。群公庶尹六事之人，外及将士，洎于蛮夷君长，佥曰：“天命不可以辞拒，神器不可以久旷；群臣不可以无主，万机不可以无统。”丕祗承皇象，敢不钦承。卜之守龟，兆有大横；筮之三易，兆有革兆。谨择元日，与群僚登坛受帝玺绶，告类于尔大神；唯尔有神，尚飨！永吉兆民之望，祚于有魏世享。’遂制诏三公：‘上古之始有君也，必崇恩化以美风俗，然百姓顺教而刑辟措焉。今朕承帝王之绪，其以延康元年为黄初元年；议改正朔，易服色，殊徽号，同律度量。承土行，大赦天下：自殊死以下，诸不当得赦，皆赦除之。’”","attribution":"裴注·献帝传","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":179,"anchor":null},"note_id":"n-bca8269a20de90320b06","start":0,"end":430},{"id":"wendi-q-p067-decree","section":"chapter-002","block":"b-d6ee5b412f1384d4b785","layer":"pei","quote":"﹝三﹞《献帝传》曰：“辛未，魏王登坛，受禅。公卿、列侯、诸将、匈奴单于、四夷朝者数万人，陪位。燎祭天地、五岳、四渎，曰：‘皇帝臣丕，敢用玄牡，昭告于皇皇后帝：汉历世二十有四，践年四百二十有六；四海困穷，三纲不立；五纬错行，灵祥并见。推术数者，虑之古道，咸以为天之历数，运终兹世；凡诸嘉祥民神之意，比昭有汉数终之极、魏家受命之符。汉主以神器宜授于臣，宪章有虞，致位于丕。丕震畏天命，虽休勿休。群公庶尹六事之人，外及将士，洎于蛮夷君长，佥曰：“天命不可以辞拒，神器不可以久旷；群臣不可以无主，万机不可以无统。”丕祗承皇象，敢不钦承。卜之守龟，兆有大横；筮之三易，兆有革兆。谨择元日，与群僚登坛受帝玺绶，告类于尔大神；唯尔有神，尚飨！永吉兆民之望，祚于有魏世享。’遂制诏三公：‘上古之始有君也，必崇恩化以美风俗，然百姓顺教而刑辟措焉。今朕承帝王之绪，其以延康元年为黄初元年；议改正朔，易服色，殊徽号，同律度量。承土行，大赦天下：自殊死以下，诸不当得赦，皆赦除之。’”","attribution":"裴注·献帝传","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":179,"anchor":null},"note_id":"n-bca8269a20de90320b06","start":0,"end":430},{"id":"wendi-q-p068-remark","section":"chapter-002","block":"b-f4a5d37fd5802ac4e3bf","layer":"pei","quote":"《魏氏春秋》曰：“帝升坛，礼毕，顾谓群臣曰：‘舜、禹之事，吾知之矣！’”","attribution":"裴注·魏氏春秋","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":180,"anchor":null},"note_id":"n-bca8269a20de90320b06","start":0,"end":36},{"id":"wendi-q-p071-calendar","section":"chapter-002","block":"b-01ee7b10ff6f39c6802d","layer":"pei","quote":"《魏书》曰：“以夏数为得天，故即用夏正，而服色尚黄。”","attribution":"裴注·魏书","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":206,"anchor":null},"note_id":"n-480b1792ff2b48c91fa3","start":0,"end":27},{"id":"wgc-q0002","section":"chapter-028","block":"b-4be6add429aa347c7747","layer":"original","quote":"太祖辟为丞相掾、属。文帝践阼，拜散骑常侍。出为兖州刺史，与张辽等至广陵讨孙权。临江，夜大风，吴将吕范等船漂至北岸〖4〗。凌与诸将逆击，捕斩首虏，获舟船；有功，封宜城亭侯，加建武将军〖5〗。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":2,"anchor":null},"note_id":null,"start":0,"end":94},{"id":"wgc-q0147","section":"chapter-028","block":"b-4be6add429aa347c7747","layer":"original","quote":"文帝践阼","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":2,"anchor":null},"note_id":null,"start":10,"end":14},{"id":"wuzhu-e-o041a-q","section":"chapter-047","block":"b-668d98182d7d75951adc","layer":"original","quote":"冬，魏嗣王称尊号，改元为黄初。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":187,"anchor":null},"note_id":null,"start":0,"end":15},{"id":"xianzhu-e-o061a-q","section":"chapter-032","block":"b-fb8f2a2c4ba112009d00","layer":"original","quote":"二十五年〖1〗，魏文帝称尊号，改年曰“黄初”。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":316,"anchor":null},"note_id":null,"start":0,"end":23},{"id":"xianzhu-q-b-702ed09e6ffd28cb4f1b","section":"chapter-032","block":"b-702ed09e6ffd28cb4f1b","layer":"modern","quote":"〖1〗二十五年：建安二十五年（公元 220）。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":320,"anchor":null},"note_id":"n-05fade9a1016742646ad","start":0,"end":23},{"id":"xianzhu-q-o061","section":"chapter-032","block":"b-fb8f2a2c4ba112009d00","layer":"original","quote":"二十五年〖1〗，魏文帝称尊号，改年曰“黄初”。或传闻汉帝见害，先主乃发丧制服〖2〗，追谥曰“孝愍皇帝”。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":316,"anchor":null},"note_id":null,"start":0,"end":52},{"id":"zhonghua-q-41e9bb3ad6e68b418f37","section":"chapter-013","block":"b-b647fae24bfea7ccc1f0","layer":"pei","quote":"文帝受禅，歆登坛，相仪，奉皇帝玺绶，以成受命之礼。”","attribution":"裴注·魏书","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":189,"anchor":null},"note_id":"n-58cbf5044cca12754f4e","start":10,"end":36}],"profiles":{},"directory_counts":{}}
