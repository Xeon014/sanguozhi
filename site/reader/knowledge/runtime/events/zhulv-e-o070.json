083ac4e62f2a","section":"chapter-056","block":"b-c9cf0497c6ffd682f91e","layer":"original","quote":"绩便引兵及昶于纪南〖12〗。纪南去城三十里，绩先战胜而融不进，绩后失利","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":119,"anchor":null},"note_id":null,"start":131,"end":166},{"id":"zhulv-q-44a86491fc0a66fb96ed","section":"chapter-056","block":"b-c9cf0497c6ffd682f91e","layer":"original","quote":"绩与奋威将军诸葛融书曰：“昶远来疲困，马无所食；力屈而走，此天助也。今追之力少，可引兵相继；吾欲破之于前，足下乘之于后。岂一人之功哉？宜同断金之义〖11〗！”融答许绩","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":119,"anchor":null},"note_id":null,"start":47,"end":130},{"id":"zhulv-q-d14072171647868c3cd3","section":"chapter-056","block":"b-c9cf0497c6ffd682f91e","layer":"original","quote":"初绩与恪、融不平〖13〗，及此事变，为隙益甚","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":119,"anchor":null},"note_id":null,"start":192,"end":214},{"id":"zhulv-q-e894d375af904df023f6","section":"chapter-056","block":"b-c9cf0497c6ffd682f91e","layer":"original","quote":"权深嘉绩，盛责怒融。融兄大将军恪贵重，故融得不废","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":119,"anchor":null},"note_id":null,"start":167,"end":191}],"profiles":{},"directory_counts":{}}
