{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xiahoucao-e-o029a","title":"曹丕任曹仁车骑督三州进陈侯追谥曹炽","accounts":[{"id":"xiahoucao-e-o029a-account","label":"《诸夏侯曹传第九》正文","text":"曹丕任曹仁车骑督三州进陈侯追谥曹炽","evidence":["xiahoucao-e-o029a-q"]}],"participants":[{"person":"wudi-p0170","role":"授官追谥","evidence":["xiahoucao-e-o029a-q"]},{"person":"cao-ren","role":"受任封","evidence":["xiahoucao-e-o029a-q"]}],"place":null,"time":{"year":220,"label":"曹丕即王位","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xiahoucao-y220","dating_review":{"reviewed":true,"anchor":"xiahoucao-q-o007","basis":"曹丕即王位"},"evidence":["xiahoucao-e-o029a-q","xiahoucao-q-o007","pangfa-q-o026","pangfa-q-o024","pangfa-q-b-2bde1ec2bffff2934f01"]},"ordering_evidence":"xiahoucao-e-o029a-q","source_order":[9,136,"O029a"],"order":2189}],"persons":[{"id":"cao-ren","name":"曹仁","facts":[],"aliases":[]},{"id":"wudi-p0170","name":"曹丕","facts":[],"aliases":[]}],"evidence":[{"id":"pangfa-q-b-2bde1ec2bffff2934f01","section":"chapter-037","block":"b-2bde1ec2bffff2934f01","layer":"modern","quote":"〖27〗二十四年：建安二十四年（公元 219）。","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":180,"anchor":null},"note_id":"n-b2b8a5dc69bfaa995101","start":0,"end":24},{"id":"pangfa-q-o024","section":"chapter-037","block":"b-b3d109bb3fe355546163","layer":"original","quote":"二十四年〖27〗，先主自阳平南渡沔水，缘山稍前〖28〗，于定军（兴势）〔山〕作营。渊将兵来争其地。正曰：“可击矣！”先主命黄忠乘高鼓噪攻之，大破渊军，渊等授首〖29〗。曹公西征，闻正之策，曰：“吾故知玄德不辨有此〖30〗，必为人所教也。”﹝三﹞","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":149,"anchor":null},"note_id":null,"start":0,"end":122},{"id":"pangfa-q-o026","section":"chapter-037","block":"b-60f5f2906a17e7bc1611","layer":"original","quote":"明年卒，时年四十五。先主为之流涕者累日。谥曰翼侯。赐子邈爵关内侯，官至奉车都尉、汉阳太守。","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":151,"anchor":null},"note_id":null,"start":0,"end":45},{"id":"xiahoucao-e-o029a-q","section":"chapter-009","block":"b-f10a343a8acf7a23a382","layer":"original","quote":"及即王位，拜仁车骑将军，都督荆、扬、益州诸军事；进封陈侯，增邑二千，并前三千五百户；追赐仁父炽谥曰陈穆侯，置守冢十家。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":135,"anchor":null},"note_id":null,"start":0,"end":59},{"id":"xiahoucao-q-o007","section":"chapter-009","block":"b-8cf38289506cbca296a8","layer":"original","quote":"文帝即王位，拜惇〔为〕大将军。数月薨。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":18,"anchor":null},"note_id":null,"start":0,"end":19}],"profiles":{},"directory_counts":{}}
