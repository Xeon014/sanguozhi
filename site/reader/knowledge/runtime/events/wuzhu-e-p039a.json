{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wuzhu-e-p039a","title":"孙权辞帝号解释受魏封因防两面受敌","accounts":[{"id":"wuzhu-e-p039a-account","label":"《江表传》","text":"孙权辞帝号解释受魏封因防两面受敌","evidence":["wuzhu-e-p039a-q"]}],"participants":[{"person":"sun-quan","role":"辞位释意","evidence":["wuzhu-e-p039a-q"]}],"place":null,"time":{"label":"群臣劝称帝时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["wuzhu-e-p039a-q"]},"ordering_evidence":"wuzhu-e-p039a-q","source_order":[47,381,"P039a"],"order":8258}],"persons":[{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]}],"evidence":[{"id":"wuzhu-e-p039a-q","section":"chapter-047","block":"b-68cdeaadb0a6a28ba808","layer":"pei","quote":"﹝二﹞《江表传》曰：“权辞让曰：‘汉家堙替，不能存救；亦何心而竞乎！’群臣称天命符瑞，固重以请；权未之许，而谓将相曰：‘往年孤以玄德方向西鄙，故先命陆逊选众以待之。闻北部分，欲以助孤，孤内嫌其有挟；若不受其拜，是相折辱而促其速发，便当与西俱至，二处受敌，于孤为剧：故自抑按，就其封王。低屈之趣，诸君似未之尽：今故以此相解耳。’”","attribution":"《江表传》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":380,"anchor":null},"note_id":"n-da8e7acfcbdf17a4b43e","start":0,"end":164}],"profiles":{},"directory_counts":{}}
