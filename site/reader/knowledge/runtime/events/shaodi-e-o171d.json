page_0090.xhtml","index":580,"anchor":null},"note_id":null,"start":0,"end":11},{"id":"erfei-q-4ab49b058c3f91a0cda7","section":"chapter-034","block":"b-caa1bd390bc6a9f3db51","layer":"original","quote":"咸熙元年正月，钟会作乱于成都","section_title":"二主妃子传第四","source":{"file":"OEBPS/Text/titlepage_0074.xhtml","index":93,"anchor":null},"note_id":null,"start":9,"end":23},{"id":"houzhu-q-O080","section":"chapter-033","block":"b-5d3fe85765efd9badd26","layer":"original","quote":"资严未发〖44〗，明年春正月，艾见收〖45〗。钟会自涪至成都，作乱。会既死，蜀中军众抄略，死丧狼藉；数日乃安集。","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":156,"anchor":null},"note_id":null,"start":0,"end":56},{"id":"jfj-q0205","section":"chapter-044","block":"b-09db8f32c9900218f0c8","layer":"original","quote":"因将维等诣成都，自称益州牧以叛；","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":234,"anchor":null},"note_id":null,"start":92,"end":108},{"id":"jfj-q0207","section":"chapter-044","block":"b-09db8f32c9900218f0c8","layer":"original","quote":"魏将士愤怒，杀会及维，维妻子皆伏诛。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":234,"anchor":null},"note_id":null,"start":124,"end":142},{"id":"shaodi-e-o171d-q","section":"chapter-004","block":"b-cef469d41ec5962b4e48","layer":"original","quote":"咸熙元年春正月，壬戌〖1〗，槛车征邓艾〖2〗。甲子〖3〗，行幸长安。壬申〖4〗，使使者以璧币祀华山〖5〗。是月，钟会反于蜀，为众所讨。邓艾亦见杀。二月，辛卯〖6〗，特赦诸在益土者。庚申〖7〗，葬明元郭后。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":220,"anchor":null},"note_id":null,"start":0,"end":102},{"id":"shaodi-q-b-ded6d700dc6f860d1670","section":"chapter-004","block":"b-ded6d700dc6f860d1670","layer":"modern","quote":"〖1〗四年：景元四年（公元 263）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":201,"anchor":null},"note_id":"n-ef642248e44d01f3825d","start":0,"end":19},{"id":"shaodi-q-o165","section":"chapter-004","block":"b-b35fdf03685051716720","layer":"original","quote":"四年春二月〖1〗，复命大将军进位、爵赐，一如前诏。又固辞，乃止。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":194,"anchor":null},"note_id":null,"start":0,"end":32},{"id":"shaodi-q-o171","section":"chapter-004","block":"b-cef469d41ec5962b4e48","layer":"original","quote":"咸熙元年春正月，壬戌〖1〗，槛车征邓艾〖2〗。甲子〖3〗，行幸长安。壬申〖4〗，使使者以璧币祀华山〖5〗。是月，钟会反于蜀，为众所讨。邓艾亦见杀。二月，辛卯〖6〗，特赦诸在益土者。庚申〖7〗，葬明元郭后。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":220,"anchor":null},"note_id":null,"start":0,"end":102},{"id":"wgc-q0057","section":"chapter-028","block":"b-2e26eca35db56085032f","layer":"original","quote":"艾父子既囚，钟会至成都；先送艾，然后作乱。会已死，艾本营将士追出艾槛车，迎还。瓘遣田续等讨艾，遇于绵竹西；斩之，子忠与艾俱死。余子在洛阳者悉诛，徙艾妻（子）及孙于西（域）〔城〕〖1〗。﹝一﹞","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":388,"anchor":null},"note_id":null,"start":0,"end":95},{"id":"wgc-q0123","section":"chapter-028","block":"b-46cb05252baea122f899","layer":"pei","quote":"﹝一﹞《汉晋春秋》曰：“初，艾之下江由也，以续不进，欲斩，既而舍之。及瓘遣续，谓曰：‘可以报江由之辱矣！’杜预言于众曰：‘伯玉其不免乎！身为名士，位望已高。既无德音，又不御下以正；是小人而乘君子之器，将何以堪其责乎？’瓘闻之，不俟驾而谢。”《世语》曰：“师纂亦与艾俱死。纂，性急少恩，死之日体无完皮。”","attribution":"汉晋春秋；世语","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":400,"anchor":null},"note_id":"n-708919d257dd4281bec0","start":0,"end":151},{"id":"wgc-q0135","section":"chapter-028","block":"b-a344b1173e6856a98116","layer":"pei","quote":"﹝四﹞《晋诸公赞》曰：“胡烈儿名渊，字世元。遵之孙也。遵，安定人，以才兼文武，累居藩镇，至车骑将军。子奋，字玄威。亦历方任。女为晋武帝贵人，有宠。太康中，以奋为尚书仆射，加镇军大将军，开府。弟广，字宣祖，少府；次烈，字玄武，秦州刺史；次岐，字玄嶷，并州刺史。广子喜，凉州刺史。渊小字鹞鸱。时年十八，既杀会救父，名震远近。后赵王伦篡位，三王兴义，伦使渊与张泓，将兵御齐王，屡破齐军。会成都战克，渊乃归降，伏法。”","attribution":"晋诸公赞","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":593,"anchor":null},"note_id":"n-7dfa0827333ec78b2b0e","start":0,"end":205},{"id":"wgc-q0401","section":"chapter-028","block":"b-2e26eca35db56085032f","layer":"original","quote":"瓘遣田续等讨艾，遇于绵竹西；斩之，子忠与艾俱死","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":388,"anchor":null},"note_id":null,"start":39,"end":62},{"id":"wgc-q0501","section":"chapter-028","block":"b-89b8e850e65ff34865e9","layer":"original","quote":"十八日日中，烈军兵与烈儿擂鼓出门，诸军兵不期皆鼓噪出〖20〗；曾无督促之者，而争先赴城。时方给与姜维铠杖，白“外有匈匈声，似失火”。有顷，白“兵走向城〖21〗”。会惊，谓维曰：“兵来似欲作恶〖22〗，当云何〖23〗？”维曰：“但当击之耳！”会遣兵悉杀所闭诸牙门、郡守，内人共举几以柱门〖24〗；兵斫门，不能破。斯须，门外倚梯登城，或烧城屋，蚁附乱进，矢下如雨；牙门、郡守各缘屋出，与其卒兵相得〖25〗。姜维率会左右战，手杀五六人；众既格斩维，争赴杀会。会时年四十。将士死者数百人。﹝四﹞","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":562,"anchor":null},"note_id":null,"start":0,"end":243},{"id":"wgc-q0504","section":"chapter-028","block":"b-89b8e850e65ff34865e9","layer":"original","quote":"姜维率会左右战，手杀五六人；众既格斩维，争赴杀会","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":562,"anchor":null},"note_id":null,"start":201,"end":225},{"id":"wgc-q0605","section":"chapter-028","block":"b-46cb05252baea122f899","layer":"pei","quote":"及瓘遣续，谓曰：‘可以报江由之辱矣","attribution":"裴注·汉晋春秋","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":400,"anchor":null},"note_id":"n-708919d257dd4281bec0","start":34,"end":51},{"id":"wgc-q0638","section":"chapter-028","block":"b-a344b1173e6856a98116","layer":"pei","quote":"渊小字鹞鸱。时年十八，既杀会救父，名震远近","attribution":"裴注·晋诸公赞","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":593,"anchor":null},"note_id":"n-7dfa0827333ec78b2b0e","start":138,"end":159}],"profiles":{},"directory_counts":{}}
