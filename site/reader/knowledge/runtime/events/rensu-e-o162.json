{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"rensu-e-o162","title":"初杜畿在郡被书录寡妇；他郡或已自相配嫁依书皆录夺啼哭道路，畿但取寡者故所送少","accounts":[{"id":"rensu-a-441f30243f327d5162f5","label":"裴注·魏略","text":"初杜畿在郡被书录寡妇；他郡或已自相配嫁依书皆录夺啼哭道路，畿但取寡者故所送少","evidence":["rensu-q-40221874da360ab0e854"]},{"id":"rensu-a-0a8685805973480afa4d","label":"裴注·魏略","text":"及赵俨代畿而所送多；文帝问畿前所送何少今何多，畿对曰臣前所录皆亡者妻、今俨送生人妇也，帝及左右顾而失色","evidence":["rensu-q-a29a8415910a8611a04c"]}],"participants":[{"person":"wendi-p0020","role":"录寡妇但取寡者；对答者","evidence":["rensu-q-40221874da360ab0e854","rensu-q-a29a8415910a8611a04c"]},{"person":"wudi-p0170","role":"发问者","evidence":["rensu-q-a29a8415910a8611a04c"]},{"person":"shaodi-p0016","role":"所送多之代任者","evidence":["rensu-q-a29a8415910a8611a04c"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["rensu-q-40221874da360ab0e854","rensu-q-a29a8415910a8611a04c"]},"ordering_evidence":"rensu-q-40221874da360ab0e854","source_order":[16,137,10],"order":3425}],"persons":[{"id":"shaodi-p0016","name":"赵俨","facts":[],"aliases":[]},{"id":"wendi-p0020","name":"杜畿","facts":[],"aliases":[]},{"id":"wudi-p0170","name":"曹丕","facts":[],"aliases":[]}],"evidence":[{"id":"rensu-q-40221874da360ab0e854","section":"chapter-016","block":"b-63bbfd3abcee0b717679","layer":"pei","quote":"初，畿在郡，被书录寡妇。是时他郡或有已自相配嫁，依书，皆录夺，啼哭道路。畿但取寡者，故所送少","attribution":"裴注·魏略","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":136,"anchor":null},"note_id":"n-c532b931666ce2edfecd","start":10,"end":56},{"id":"rensu-q-a29a8415910a8611a04c","section":"chapter-016","block":"b-63bbfd3abcee0b717679","layer":"pei","quote":"及赵俨代畿，而所送多。文帝问畿：‘前君所送何少，今何多也？’畿对曰：‘臣前所录，皆亡者妻；今俨送，生人妇也。’帝及左右顾而失色","attribution":"裴注·魏略","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":136,"anchor":null},"note_id":"n-c532b931666ce2edfecd","start":57,"end":120}],"profiles":{},"dire