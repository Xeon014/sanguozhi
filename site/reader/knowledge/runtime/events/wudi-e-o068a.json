{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o068a","title":"曹操遣刘备朱灵邀袁术","accounts":[{"id":"wudi-e-o068a-account","label":"正文","text":"袁术欲北投袁谭，曹操遣刘备、朱灵邀击，恰逢袁术病死。","evidence":["wudi-e-o068a-q"]},{"id":"xianzhu-e-o014a-account","label":"《先主传》正文","text":"曹操命刘备督朱灵、路招截击欲北就袁绍的袁术，未至而袁术病死。","evidence":["xianzhu-e-o014a-q"]}],"participants":[{"person":"wudi-p0057","role":"拟北行而病死","evidence":["wudi-e-o068a-q"]},{"person":"wudi-p0163","role":"遣迎","evidence":["wudi-e-o068a-q"]},{"person":"cao-cao","role":"遣军","evidence":["wudi-e-o068a-q"]},{"person":"liu-bei","role":"奉命邀击","evidence":["wudi-e-o068a-q"]},{"person":"wudi-p0164","role":"奉命邀击","evidence":["wudi-e-o068a-q"]},{"person":"xianzhu-p0023","role":"从征","evidence":["xianzhu-e-o014a-q"]}],"place":{"text":"下邳","evidence":["wudi-e-o068a-q"]},"time":{"label":"建安四年","year":199,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o068a-q","wudi-q-o061","wudi-q-b-51bced16741add42ff70"],"chronology":"wudi-y199","dating_review":{"anchor":"wudi-q-o061","basis":"建安四年","reviewed":true}},"source_order":[1,366,"O068a"],"order":167}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"wudi-p0057","name":"袁术","facts":[],"aliases":[]},{"id":"wudi-p0163","name":"袁谭","facts":[],"aliases":[]},{"id":"wudi-p0164","name":"朱灵","facts":[],"aliases":[]},{"id":"xianzhu-p0023","name":"路招","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-o068a-q","section":"chapter-001","block":"b-4e5d0e149cee6f7fc779","layer":"original","quote":"袁术自败于陈，稍困〖23〗。袁谭自青州遣迎之〖24〗，术欲从下邳北过；公遣刘备、朱灵要之〖25〗，会术病死。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":365,"anchor":null},"note_id":null,"start":0,"end":54},{"id":"wudi-q-b-51bced16741add42ff70","section":"chapter-001","block":"b-51bced16741add42ff70","layer":"modern","quote":"〖1〗四年：建安四年（公元 199）。","secti