{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"yaoci-e-o058","title":"孙策解太史慈缚，结纳共事","accounts":[{"id":"yaoci-a-365c228d5f4a822412b7","label":"正文","text":"策即解慈缚，捉其手问宁识神亭时邪，慈答未可量也，策大笑曰今日之事当与卿共之","evidence":["yaoci-q-5846ea42bc6115af8633"]}],"participants":[{"person":"wudi-p0099","role":"解缚结纳者","evidence":["yaoci-q-5846ea42bc6115af8633"]},{"person":"wuzhu-p0003","role":"被解缚、应对者","evidence":["yaoci-q-5846ea42bc6115af8633"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"多时段分列，不推年。","evidence":["yaoci-q-5846ea42bc6115af8633"]},"ordering_evidence":"yaoci-q-5846ea42bc6115af8633","source_order":[49,143,0],"related_events":[{"event":"yaoci-e-o058-s2-1","type":"related","evidence":["yaoci-q-3d5a9a5f559fa0dd43e5","yaoci-q-47b2b2a2dca4499b9504","yaoci-q-e003f5754eee11275f1a","yaoci-q-f9ccb7c3eef1fe79ce06","yaoci-q-5846ea42bc6115af8633"]},{"event":"yaoci-e-o058-s2-1","type":"alternative","evidence":["yaoci-q-3d5a9a5f559fa0dd43e5","yaoci-q-47b2b2a2dca4499b9504","yaoci-q-e003f5754eee11275f1a","yaoci-q-f9ccb7c3eef1fe79ce06","yaoci-q-5846ea42bc6115af8633"]}],"order":8972},{"id":"yaoci-e-o058-s2-1","title":"《吴历》另记太史慈于神亭战败被执及践约归来","accounts":[{"id":"yaoci-a-b55e2f38d5df0e390d69","label":"裴注·吴历","text":"慈于神亭战败，为策所执；策素闻其名，即解缚请见，咨问进取之术","evidence":["yaoci-q-3d5a9a5f559fa0dd43e5"]},{"id":"yaoci-a-b38c68ec1dd1a11b6c9b","label":"裴注·吴历","text":"慈以破军之将不足与论事辞，策引韩信定计广武之喻决疑于慈","evidence":["yaoci-q-47b2b2a2dca4499b9504"]},{"id":"yaoci-a-d7ec71fb400a394ce5e3","label":"裴注·吴历","text":"慈言州军新破、士卒离心，恐傥分散难复合聚，欲出宣恩安集；策长跪许之，约明日中望君来还","evidence":["yaoci-q-e003f5754eee11275f1a"]},{"id":"yaoci-a-e214ca427847e666e457","label":"裴注·吴历","text":"诸将皆疑，策言太史子义青州名士、以信义为先终不欺策；明日大请诸将豫设酒食，立竿视影，日中而慈至，策大悦，常与参论诸军事","evidence":["yaoci-q-f9ccb7c3eef1fe79ce06"]}],"participants":[{"person":"wudi-p0099","role":"《吴历》所记解缚相邀、信慈者","evidence":["yaoci-q-3d5a9a5f559fa0dd43e5","yaoci-q-47b2b2a2dca4499b9504","yaoci-q-e003f5754eee11275f1a","yaoci-q-f9ccb7c3eef1fe79ce06"]},{"person":"wuzhu-p0003","role":"《吴历》所记神亭被执、请求安集并如期归来者","evidence":["yaoci-q-3d5a9a5f559fa0dd43e5","yaoci-q-47b2b2a2dca4499b9504","yaoci-q-e003f5754eee11275f1a","yaoci-q-f9ccb7c3eef1fe79ce06"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原文时间表达；各账户以所引文献为准。","evidence":["yaoci-q-3d5a9a5f559fa0dd43e5","yaoci-q-47b2b2a2dca4499b9504","yaoci-q-e003f5754eee11275f1a","yaoci-q-f9ccb7c3eef1fe79ce06"]},"ordering_evidence":"yaoci-q-3d5a9a5f559fa0dd43e5","related_events":[{"event":"yaoci-e-o058","type":"related","evidence":["yaoci-q-3d5a9a5f559fa0dd43e5","yaoci-q-47b2b2a2dca4499b9504","yaoci-q-e003f5754eee11275f1a","yaoci-q-f9ccb7c3eef1fe79ce06","yaoci-q-5846ea42bc6115af8633"]},{"event":"yaoci-e-o058","type":"alternative","evidence":["yaoci-q-3d5a9a5f559fa0dd43e5","yaoci-q-47b2b2a2dca4499b9504","yaoci-q-e003f5754eee11275f1a","yaoci-q-f9ccb7c3eef1fe79ce06","yaoci-q-5846ea42bc6115af8633"]},{"event":"yaoci-e2-wu049-016","type":"disputes","evidence":["yaoci-q2-cfeaa9d0221e41b4ac4d","yaoci-q-3d5a9a5f559fa0dd43e5","yaoci-q-47b2b2a2dca4499b9504","yaoci-q-e003f5754eee11275f1a","yaoci-q-f9ccb7c3eef1fe79ce06"]}],"order":8981}],"persons":[{"id":"wudi-p0099","name":"孙策","facts":[],"aliases":[]},{"id":"wuzhu-p0003","name":"太史慈","facts":[],"aliases":[]}],"evidence":[{"id":"yaoci-q-3d5a9a5f559fa0dd43e5","section":"chapter-049","block":"b-04c6f3e9c0502aef3f65","layer":"pei","quote":"慈于神亭战败，为策所执。策素闻其名，即解缚请见，咨问进取之术","attribution":"裴注·吴历","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":167,"anchor":null},"note_id":"n-b9032394c20d288bbb38","start":10,"end":40},{"id":"yaoci-q-47b2b2a2dca4499b9504","section":"chapter-049","block":"b-04c6f3e9c0502aef3f65","layer":"pei","quote":"慈答曰：‘破军之将，不足与论事！’策曰：‘昔韩信定计于广武，今策决疑于仁者：君何辞焉","attribution":"裴注·吴历","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":167,"anchor":null},"note_id":"n-b9032394c20d288bbb38","start":41,"end":83},{"id":"yaoci-q-5846ea42bc6115af8633","section":"chapter-049","block":"b-480fed902e52b9a6520c","layer":"original","quote":"策即解缚，捉其手曰：“宁识神亭时邪〖1〗！若卿尔时得我，云何〖2〗？”慈曰：“未可量也！”策大笑曰：“今日之事，当与卿共之","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":142,"anchor":null},"note_id":null,"start":0,"end":61},{"id":"yaoci-q-e003f5754eee11275f1a","section":"chapter-049","block":"b-04c6f3e9c0502aef3f65","layer":"pei","quote":"州军新破，士卒离心；若傥分散，难复合聚。欲出宣恩安集，恐不合尊意。’策长跪答曰：‘诚本心所望也！明日中，望君来还","attribution":"裴注·吴历","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":167,"anchor":null},"note_id":"n-b9032394c20d288bbb38","start":89,"end":145},{"id":"yaoci-q-f9ccb7c3eef1fe79ce06","section":"chapter-049","block":"b-04c6f3e9c0502aef3f65","layer":"pei","quote":"诸将皆疑，策曰：‘太史子义，青州名士；以信义为先，终不欺策！’明日，大请诸将，豫设酒食；立竿视影，日中而慈至。策大悦，常与参论诸军事","attribution":"裴注·吴历","section_title":"刘繇太史慈士燮传第四","source":{"file":"OEBPS/Text/titlepage_0105.xhtml","index":167,"anchor":null},"note_id":"n-b9032394c20d288bbb38","start":147,"end":213}],"profiles":{},"directory_counts":{}}
