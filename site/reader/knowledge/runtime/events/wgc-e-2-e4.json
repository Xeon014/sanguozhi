{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wgc-e-2-e4","title":"石苞州泰简锐卒为游军备外寇","order":5578,"accounts":[{"id":"wgc-a-2-e4","label":"正文","text":"石苞州泰简锐卒为游军备外寇","evidence":["wgc-q0282","wgc-q0028"]}],"participants":[{"person":"shaodi-p0045","role":"使石苞、州泰等为游军","evidence":["wgc-q0282","wgc-q0028"]},{"person":"shaodi-p0138","role":"简锐卒为游军备外寇","evidence":["wgc-q0282","wgc-q0028"]},{"person":"shaodi-p0035","role":"简锐卒为游军备外寇","evidence":["wgc-q0282","wgc-q0028"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0282","wgc-q0028"]},"ordering_evidence":"wgc-q0282"}],"persons":[{"id":"shaodi-p0035","name":"州泰","facts":[],"aliases":[]},{"id":"shaodi-p0045","name":"司马昭","facts":[],"aliases":[]},{"id":"shaodi-p0138","name":"石苞","facts":[],"aliases":[]}],"evidence":[{"id":"wgc-q0028","section":"chapter-028","block":"b-c135ec113c597ad4f2da","layer":"original","quote":"六月，车驾东征，至项。大将军司马文王督中外诸军二十六万众，临淮讨之。大将军屯丘头，使基及安东将军陈骞等四面合围，表里再重〖9〗，堑垒甚峻。又使监军石苞、兖州刺史州泰等〖10〗，简锐卒为游军〖11〗，备外寇。钦等数出犯围〖12〗，逆击走之。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":175,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":119,"offset_unit":"unicode_code_point"},{"id":"wgc-q0282","section":"chapter-028","block":"b-c135ec113c597ad4f2da","layer":"original","quote":"又使监军石苞、兖州刺史州泰等〖10〗，简锐卒为游军〖11〗，备外寇","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":175,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":69,"end":102,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
