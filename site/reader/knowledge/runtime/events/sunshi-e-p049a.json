{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"sunshi-e-p049a","title":"孙策召高岱论左传受谗怒而杀之","accounts":[{"id":"sunshi-e-p049a-account","label":"《吴录》","text":"孙策召高岱论左传受谗怒而杀之","evidence":["sunshi-e-p049a-q"]}],"participants":[{"person":"wudi-p0099","role":"召见杀人","evidence":["sunshi-e-p049a-q"]},{"person":"sunshi-p0077","role":"应召遇害","evidence":["sunshi-e-p049a-q"]},{"person":"sunshi-p0078","role":"迎接","evidence":["sunshi-e-p049a-q"]}],"place":null,"time":{"label":"高岱受孙策召前后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["sunshi-e-p049a-q"]},"ordering_evidence":"sunshi-e-p049a-q","source_order":[46,278,"P049a"],"order":8130}],"persons":[{"id":"sunshi-p0077","name":"高岱","facts":[],"aliases":[]},{"id":"sunshi-p0078","name":"陆昭","facts":[],"aliases":[]},{"id":"wudi-p0099","name":"孙策","facts":[],"aliases":[]}],"evidence":[{"id":"sunshi-e-p049a-q","section":"chapter-046","block":"b-96d4b25d5c0244aea4a1","layer":"pei","quote":"时有高岱者，隐于余姚。策命出，使会稽丞陆昭逆之，策虚己候焉。闻其善《左传》，乃自玩读，欲与论讲。或谓之曰：‘高岱以将军但英武而已，无文学之才；若与论《传》而或云不知者，则某言符矣。’又谓岱曰：‘孙将军为人，恶胜己者；若每问，当言不知，乃合意耳；如皆辨义，此必危殆！’岱以为然，及与论《传》，或答不知。策果怒，以为轻己，乃囚之。知交及时人，皆露坐为请。策登楼，望见数里中填满。策恶其收众心，遂杀之。","attribution":"《吴录》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":277,"anchor":null},"note_id":"n-9299c159b0512c392271","start":10,"end":208}],"profiles":{},"directory_counts":{}}
