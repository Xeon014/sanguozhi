{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p087b","title":"曹操王儁赴袁氏母丧论二袁","accounts":[{"id":"wudi-e-p087b-account","label":"皇甫谧《逸士传》","text":"曹操、王儁在袁绍与袁术母丧时相会，曹操私下称二袁将为乱首，应先诛之；王儁以平天下相期。","evidence":["wudi-e-p087b-q"]}],"participants":[{"person":"cao-cao","role":"议论","evidence":["wudi-e-p087b-q"]},{"person":"wudi-p0259","role":"对答","evidence":["wudi-e-p087b-q"]},{"person":"wudi-p0052","role":"治母丧","evidence":["wudi-e-p087b-q"]},{"person":"wudi-p0057","role":"治母丧","evidence":["wudi-e-p087b-q"]}],"place":{"text":"汝南","evidence":["wudi-e-p087b-q"]},"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p087b-q"]},"source_order":[1,689,"P087b"],"order":285}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0052","name":"袁绍","facts":[],"aliases":[]},{"id":"wudi-p0057","name":"袁术","facts":[],"aliases":[]},{"id":"wudi-p0259","name":"王儁","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-p087b-q","section":"chapter-001","block":"b-ea056e74ee4abddcf775","layer":"pei","quote":"及袁绍与弟术丧母，归葬汝南；儁与公会之，会者三万人。公于外密语儁曰：‘天下将乱，为乱魁者，必此二人也！欲济天下，为百姓请命；不先诛此二子，乱今作矣。’儁曰：‘如卿之言，济天下者，舍卿复谁？’相对而笑。","attribution":"皇甫谧《逸士传》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":13,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cf8a0075075368325cde","start":57,"end":157,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
