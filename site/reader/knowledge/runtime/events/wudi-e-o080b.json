{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o080b","title":"曹操夜袭淳于琼粮营","accounts":[{"id":"wudi-e-o080b-account","label":"正文","text":"曹操留曹洪守营，亲率五千步骑夜袭粮营，不分兵迎援骑，集中击破淳于琼等。","evidence":["wudi-e-o080b-q"]},{"id":"dongyuan-e-o051b-account","label":"《董二袁刘传第六》正文","text":"曹操留曹洪守营夜攻乌巢破杀淳于琼袁绍援骑败","evidence":["dongyuan-e-o051b-q"]}],"participants":[{"person":"cao-cao","role":"夜袭","evidence":["wudi-e-o080b-q"]},{"person":"wudi-p0075","role":"留守","evidence":["wudi-e-o080b-q"]},{"person":"wudi-p0175","role":"被袭战败","evidence":["wudi-e-o080b-q"]},{"person":"wudi-p0052","role":"遣骑救援","evidence":["wudi-e-o080b-q"]}],"place":null,"time":{"label":"建安五年冬十月","year":200,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o080b-q","wudi-q-o071","wudi-q-b-9900125064e5d85f08ad"],"chronology":"wudi-y200","dating_review":{"anchor":"wudi-q-o071","basis":"建安五年冬十月","reviewed":true}},"source_order":[1,437,"O080b"],"order":191}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0052","name":"袁绍","facts":[],"aliases":[]},{"id":"wudi-p0075","name":"曹洪","facts":[],"aliases":[]},{"id":"wudi-p0175","name":"淳于琼","facts":[],"aliases":[]}],"evidence":[{"id":"dongyuan-e-o051b-q","section":"chapter-006","block":"b-c11903f59e2abda470f6","layer":"original","quote":"琼宿乌巢〖8〗，去绍军四十里。太祖乃留曹洪守，自将步骑五千，候夜潜往攻琼。绍遣骑救之，败走。破琼等，悉斩之。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":309,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":77,"end":131,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o080b-q","section":"chapter-001","block":"b-f14e576d21da5d0fb49a","layer":"original","quote":"公乃留曹洪守，自将步骑五千人，夜往。会明至〖6〗，琼等望见公兵少，出阵门外。公急击之，琼退保营，遂攻之。绍遣骑救琼，左右或言：“贼骑稍近，请分兵拒之！”公怒曰：“贼在背后，乃白！”士卒皆殊死战，大破琼等，皆斩之。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":436,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":73,"end":179,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-9900125064e5d85f08ad","section":"chapter-001","block":"b-9900125064e5d85f08ad","layer":"modern","quote":"〖1〗五年：建安五年（公元 200）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":403,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-744e4aee7f5ff14cca85","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o071","section":"chapter-001","block":"b-c9f735ddad48a8f5c2b6","layer":"original","quote":"五年春正月〖1〗，董承等谋泄，皆伏诛。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":400,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":19,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
