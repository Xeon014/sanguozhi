{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dongyuan-e-o065b","title":"焦触自称幽州刺史背袁向曹盟诸郡韩珩拒事曹获许","accounts":[{"id":"dongyuan-e-o065b-account","label":"《董二袁刘传第六》正文","text":"焦触自称幽州刺史背袁向曹盟诸郡韩珩拒事曹获许","evidence":["dongyuan-e-o065b-q"]}],"participants":[{"person":"wudi-p0222","role":"自立盟众","evidence":["dongyuan-e-o065b-q"]},{"person":"dongyuan-p0034","role":"拒从","evidence":["dongyuan-e-o065b-q"]}],"place":null,"time":{"label":"袁熙袁尚失幽州时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-o065b-q"]},"ordering_evidence":"dongyuan-e-o065b-q","source_order":[6,373,"O065b"],"order":1709}],"persons":[{"id":"dongyuan-p0034","name":"韩珩","facts":[],"aliases":[]},{"id":"wudi-p0222","name":"焦触","facts":[],"aliases":[]}],"evidence":[{"id":"dongyuan-e-o065b-q","section":"chapter-006","block":"b-192340983e440a0e661b","layer":"original","quote":"触自号幽州刺史，驱率诸郡太守、令长，背袁向曹；陈兵数万，杀白马盟。令曰：“违命者斩！”众莫敢语，各以次歃〖3〗。至别驾韩珩，曰：“吾受袁公父子厚恩，今其破亡，智不能救，勇不能死，于义缺矣；若乃北面于曹氏〖4〗，所弗能为也！”一坐为珩失色。触曰：“夫兴大事，当立大义；事之济否，不待一人。可卒珩志〖5〗，以励事君〖6〗。”","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":372,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":20,"end":180,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
