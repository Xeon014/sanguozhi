{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"mingdi-e-p021b","title":"关羽求娶杜氏曹操陷城后自纳之","accounts":[{"id":"mingdi-e-p021b-account","label":"裴注·献帝传","text":"关羽求娶杜氏曹操陷城后自纳之","evidence":["mingdi-e-p021b-q"]},{"id":"guanzhang-e-p001a-account","label":"《蜀记》","text":"关羽请娶秦宜禄妻曹操先迎自留","evidence":["guanzhang-e-p001a-q"]}],"participants":[{"person":"wudi-p0172","role":"求娶","evidence":["mingdi-e-p021b-q"]},{"person":"cao-cao","role":"纳妇","evidence":["mingdi-e-p021b-q"]},{"person":"mingdi-p0078","role":"被纳","evidence":["mingdi-e-p021b-q"]}],"place":null,"time":{"label":"吕布被围前后，回叙","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["mingdi-e-p021b-q"]},"ordering_evidence":"mingdi-e-p021b-q","source_order":[3,242,"P021b"],"order":830}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"mingdi-p0078","name":"杜氏（秦朗母）","facts":[],"aliases":[]},{"id":"wudi-p0172","name":"关羽","facts":[],"aliases":[]}],"evidence":[{"id":"guanzhang-e-p001a-q","section":"chapter-036","block":"b-79022483cd461a542448","layer":"pei","quote":"﹝一﹞《蜀记》曰：“曹公与刘备围吕布于下邳。关羽启公：布使秦宜禄行求救，乞娶其妻；公许之。临破，又屡启于公。公疑其有异色，先遣迎看；因自留之，羽心不自安。”此与《魏氏春秋》所说无异也。","attribution":"《蜀记》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":7,"anchor":null},"note_id":"n-f214c7b82beace6c970a","start":0,"end":92},{"id":"mingdi-e-p021b-q","section":"chapter-003","block":"b-0b51273f0eff3bb164c4","layer":"pei","quote":"布之被围，关羽屡请于太祖，求以杜氏为妻。太祖疑其有色。及城陷，太祖见之，乃自纳之。","attribution":"裴注·献帝传","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":241,"anchor":null},"note_id":"n-9ebeadb65240878258aa","start":41,"end":82}],"profiles":{},"directory_counts":{}}
