{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"shaodi-e-o172a","title":"王祥何曾荀顗迁三公","accounts":[{"id":"shaodi-e-o172a-account","label":"《三少帝纪》正文","text":"王祥何曾荀顗迁三公","evidence":["shaodi-e-o172a-q"]}],"participants":[{"person":"shaodi-p0123","role":"任太尉","evidence":["shaodi-e-o172a-q"]},{"person":"mingdi-p0097","role":"任司徒","evidence":["shaodi-e-o172a-q"]},{"person":"shaodi-p0090","role":"任司空","evidence":["shaodi-e-o172a-q"]}],"place":null,"time":{"year":264,"label":"丁丑","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"shaodi-y264","dating_review":{"reviewed":true,"anchor":"shaodi-q-o171","basis":"丁丑"},"evidence":["shaodi-e-o172a-q","shaodi-q-o171","shaodi-q-o165","shaodi-q-b-ded6d700dc6f860d1670"]},"ordering_evidence":"shaodi-e-o172a-q","source_order":[4,814,"O172a"],"order":1285}],"persons":[{"id":"mingdi-p0097","name":"何曾","facts":[],"aliases":[]},{"id":"shaodi-p0090","name":"荀顗","facts":[],"aliases":[]},{"id":"shaodi-p0123","name":"王祥","facts":[],"aliases":[]}],"evidence":[{"id":"shaodi-e-o172a-q","section":"chapter-004","block":"b-7741168fd487e5577b62","layer":"original","quote":"三月，丁丑〖8〗，以司空王祥为太尉，征北将军何曾为司徒，尚书左仆射荀顗为司空〖9〗。己卯〖10〗，进晋公爵为王〖11〗； 〔增〕 封十郡，并前二十。﹝一﹞丁亥〖12〗，封刘禅为安乐公〖13〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":221,"anchor":null},"note_id":null,"start":0,"end":96},{"id":"shaodi-q-b-ded6d700dc6f860d1670","section":"chapter-004","block":"b-ded6d700dc6f860d1670","layer":"modern","quote":"〖1〗四年：景元四年（公元 263）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":201,"anchor":null},"note_id":"n-ef642248e44d01f3825d","start":0,"end":19},{"id":"shaodi-q-o165","section":"chapter-004","block":"b-b35fdf03685051716720","layer":"original","quote":"四年春二月〖1〗，复命大将军进位、爵赐，一如前诏。又固辞，乃止。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":194,"anchor":null},"note_id":null,"start":0,"end":32},{"id":"shaodi-q-o171","section":"chapter-004","block":"b-cef469d41ec5962b4e48","layer":"original","quote":"咸熙元年春正月，壬戌〖1〗，槛车征邓艾〖2〗。甲子〖3〗，行幸长安。壬申〖4〗，使使者以璧币祀华山〖5〗。是月，钟会反于蜀，为众所讨。邓艾亦见杀。二月，辛卯〖6〗，特赦诸在益土者。庚申〖7〗，葬明元郭后。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":220,"anchor":null},"note_id":null,"start":0,"end":102}],"profiles":{},"directory_counts":{}}
