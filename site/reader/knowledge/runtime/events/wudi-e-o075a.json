{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o075a","title":"延津诱骑战斩文丑","accounts":[{"id":"wudi-e-o075a-account","label":"正文","text":"曹操与荀攸以辎重诱敌，待袁军骑兵散逐，纵不足六百骑击败文丑、刘备所率骑兵，斩文丑。","evidence":["wudi-e-o075a-q"]},{"id":"xunyu-e-o042b-account","label":"《荀彧荀攸贾诩传第十》正文","text":"荀攸劝留辎重诱敌曹操破文丑","evidence":["xunyu-e-o042b-q"]},{"id":"dongyuan-e-o048b-account","label":"《董二袁刘传第六》正文","text":"袁绍渡河营延津遣刘备文丑挑战曹操破斩文丑","evidence":["dongyuan-e-o048b-q"]}],"participants":[{"person":"wudi-p0052","role":"渡河追军","evidence":["wudi-e-o075a-q"]},{"person":"cao-cao","role":"设诱出击","evidence":["wudi-e-o075a-q"]},{"person":"wudi-p0143","role":"赞同饵敌","evidence":["wudi-e-o075a-q"]},{"person":"wudi-p0179","role":"战败被杀","evidence":["wudi-e-o075a-q"]},{"person":"liu-bei","role":"率骑来战","evidence":["wudi-e-o075a-q"]}],"place":{"text":"延津南","evidence":["wudi-e-o075a-q"]},"time":{"label":"白马解围后","year":200,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o075a-q","wudi-q-o071","wudi-q-b-9900125064e5d85f08ad"],"chronology":"wudi-y200","dating_review":{"anchor":"wudi-q-o071","basis":"白马解围后","reviewed":true}},"source_order":[1,413,"O075a"],"order":179}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"wudi-p0052","name":"袁绍","facts":[],"aliases":[]},{"id":"wudi-p0143","name":"荀攸","facts":[],"aliases":[]},{"id":"wudi-p0179","name":"文丑","facts":[],"aliases":[]}],"evidence":[{"id":"dongyuan-e-o048b-q","section":"chapter-006","block":"b-839daef927a1c0dd9463","layer":"original","quote":"绍渡河，壁延津南〖2〗；使刘备、文丑挑战。太祖击破之，斩丑。再战，擒绍大将，绍军大震。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":306,"anchor":null},"note_id":null,"start":61,"end":104},{"id":"wudi-e-o075a-q","section":"chapter-001","block":"b-b402416da31f7c7dd9e1","layer":"original","quote":"绍于是渡河，追公军，至延津南。公勒兵驻营南坂下，使登垒望之。曰：“可五六百骑〖6〗。”有顷，复白〖7〗：“骑稍多，步兵不可胜数。”公曰：“勿复白！”乃令骑解鞍放马。是时，白马辎重就道；诸将以为敌骑多，不如还保营。荀攸曰：“此所以饵敌〖8〗，如何去之！”绍骑将文丑与刘备将五六千骑，前后至。诸将复白：“可上马。”公曰：“未也。”有顷，骑至稍多，或分趋辎重。公曰：“可矣！”乃皆上马，时骑不满六百；遂纵兵击，大破之，斩丑。良、丑皆绍名将也，再战〖9〗，悉擒；绍军大震。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":412,"anchor":null},"note_id":null,"start":0,"end":232},{"id":"wudi-q-b-9900125064e5d85f08ad","section":"chapter-001","block":"b-9900125064e5d85f08ad","layer":"modern","quote":"〖1〗五年：建安五年（公元 200）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":403,"anchor":null},"note_id":"n-744e4aee7f5ff14cca85","start":0,"end":19},{"id":"wudi-q-o071","section":"chapter-001","block":"b-c9f735ddad48a8f5c2b6","layer":"original","quote":"五年春正月〖1〗，董承等谋泄，皆伏诛。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":400,"anchor":null},"note_id":null,"start":0,"end":19},{"id":"xunyu-e-o042b-q","section":"chapter-010","block":"b-c726b53542d9123e59fd","layer":"original","quote":"太祖拔白马还，遣辎重循河而西。袁绍渡河追，猝与太祖遇。诸将皆恐，说太祖还保营。攸曰：“此所以（擒）〔饵〕敌〖1〗，奈何去之？”太祖目攸而笑，遂以辎重饵贼；贼竞奔之，阵乱。乃纵步骑击，大破之，斩其骑将文丑。太祖遂与绍相拒于官渡。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":220,"anchor":null},"note_id":null,"start":23,"end":136}],"profiles":{},"directory_counts":{}}
