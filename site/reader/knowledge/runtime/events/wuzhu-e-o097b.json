文物出土。","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":268,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-7893325ea43d52084752","start":0,"end":113,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-o038","section":"chapter-035","block":"b-975c90b64c3e4282352a","layer":"original","quote":"九年〖1〗，亮复出祁山，以木牛运，﹝一﹞粮尽退军；与魏将张郃交战，射杀郃。﹝二﹞","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":257,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":40,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
