{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"lvzang-e-o039","title":"布用珪策离暹奉并力击术勋大破败","accounts":[{"id":"lvzang-a-bb0fa430952b1580f492","label":"正文","text":"布用珪策离暹奉并力击术勋大破败","evidence":["lvzang-q-8c16a5237fcdeea47140"]},{"id":"lvzang-a-3a3ea43c200b6a24fa74","label":"裴注·九州春秋","text":"布与暹奉书劝共击术暹奉回计从布","evidence":["lvzang-q-62f6f06678aca807f40c"]},{"id":"lvzang-a-a3c37ba6537e6e75a991","label":"裴注·九州春秋","text":"布进军暹奉兵并发大破勋军","evidence":["lvzang-q-0ea390afd2c83caa18a9"]}],"participants":[{"person":"wudi-p0088","role":"问珪今致术军卿之由也为之奈何、用珪策遣人说暹奉使与己并力共击术军、军资所有悉许暹奉；与暹奉书曰二将军拔大驾来东有元功于国当书勋竹帛万世不朽今袁术造逆当共诛讨奈何与贼臣还共伐布布有杀董卓之功与二将军俱为功臣可因今共击破术建功于天下此时不可失也；进军去勋等营百步","evidence":["lvzang-q-8c16a5237fcdeea47140","lvzang-q-62f6f06678aca807f40c","lvzang-q-0ea390afd2c83caa18a9"]},{"person":"dongyuan-p0039","role":"答暹奉与术猝合之军耳策谋不素定不能相维持、子登策之比之连鸡势不俱栖可解离也","evidence":["lvzang-q-8c16a5237fcdeea47140"]},{"person":"wudi-p0121","role":"从布并力共击术军；得书即回计从布；兵同时并发","evidence":["lvzang-q-8c16a5237fcdeea47140","lvzang-q-62f6f06678aca807f40c","lvzang-q-0ea390afd2c83caa18a9"]},{"person":"wudi-p0120","role":"从布并力共击术军；得书即回计从布；兵同时并发","evidence":["lvzang-q-8c16a5237fcdeea47140","lvzang-q-62f6f06678aca807f40c","lvzang-q-0ea390afd2c83caa18a9"]},{"person":"sunshi-p0042","role":"大破败；营被攻、将十将被斩、杀伤堕水死者不可胜数","evidence":["lvzang-q-8c16a5237fcdeea47140","lvzang-q-0ea390afd2c83caa18a9"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["lvzang-q-8c16a5237fcdeea47140","lvzang-q-62f6f06678aca807f40c","lvzang-q-0ea390afd2c83caa18a9"]},"ordering_evidence":"lvzang-q-8c16a5237fcdeea47140","source_order":[7,96,22],"order":1835}],"persons":[{"id":"dongyuan-p0039","name":"陈珪","facts":[],"aliases":[]},{"id":"sunshi-p0042","name":"张勋","facts":[],"aliases":[]},{"id":"wudi-p0088","name":"吕布","facts":[],"aliases":[]},{"id":"wudi-p0120","name":"杨奉","facts":[],"aliases":[]},{"id":"wudi-p0121","name":"韩暹","facts":[],"aliases":[]}],"evidence":[{"id":"lvzang-q-0ea390afd2c83caa18a9","section":"chapter-007","block":"b-fe60abe324d40d59e61e","layer":"pei","quote":"布进军，去勋等营百步，暹、奉兵同时并发。斩十将首，杀伤堕水死者不可胜数","attribution":"裴注·九州春秋","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":117,"anchor":null},"note_id":"n-a7ab9de04a39324dfeda","start":119,"end":154},{"id":"lvzang-q-62f6f06678aca807f40c","section":"chapter-007","block":"b-fe60abe324d40d59e61e","layer":"pei","quote":"布与暹、奉书曰：‘二将军拔大驾来东，有元功于国；当书勋竹帛，万世不朽。今袁术造逆，当共诛讨，奈何与贼臣还共伐布？布有杀董卓之功，与二将军俱为功臣；可因今共击破术，建功于天下，此时不可失也！’暹、奉得书，即回计从布","attribution":"裴注·九州春秋","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":117,"anchor":null},"note_id":"n-a7ab9de04a39324dfeda","start":12,"end":118},{"id":"lvzang-q-8c16a5237fcdeea47140","section":"chapter-007","block":"b-0c7981b3fdfd16298529","layer":"original","quote":"布谓珪曰：“今致术军，卿之由也。为之奈何？”珪曰：“暹、奉与术，猝合之军耳！策谋不素定，不能相维持。子登策之，比之连鸡〖1〗：势不俱栖，可解离也。”布用珪策，遣人说暹、奉，使与己并力共击术军；军资所有，悉许暹、奉。于是暹、奉从之，勋大破败","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":95,"anchor":null},"note_id":null,"start":22,"end":141}],"profiles":{},"directory_counts":{}}
