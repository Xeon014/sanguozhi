{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dongyuan-e-p124a","title":"刘先使许答曹操刘表郊祀之问拜武陵太守","accounts":[{"id":"dongyuan-e-p124a-account","label":"《零陵先贤传》","text":"刘先使许答曹操刘表郊祀之问拜武陵太守","evidence":["dongyuan-e-p124a-q"]}],"participants":[{"person":"dongyuan-p0050","role":"奉使对答受任","evidence":["dongyuan-e-p124a-q"]},{"person":"cao-cao","role":"询问授官","evidence":["dongyuan-e-p124a-q"]}],"place":null,"time":{"label":"刘先奉章许及后仕时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-p124a-q"]},"ordering_evidence":"dongyuan-e-p124a-q","source_order":[6,509,"P124a"],"order":1780}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"dongyuan-p0050","name":"刘先","facts":[],"aliases":[]}],"evidence":[{"id":"dongyuan-e-p124a-q","section":"chapter-006","block":"b-500bf1ca64c961579d4b","layer":"pei","quote":"为刘表别驾，奉章诣许，见太祖。时宾客并会，太祖问先：‘刘牧如何郊天也？’先对曰：‘刘牧托汉室肺腑，处牧伯之位，而遭王道未平，群凶塞路；抱玉帛而无所聘俯，修章表而不获达御，是以郊天祀地，昭告赤诚。’太祖曰：‘群凶为谁？’先曰：‘举目皆是。’太祖曰：‘今孤有熊罴之士，步骑十万，奉辞伐罪，谁敢不服？’先曰：‘汉道陵迟，群生憔悴；既无忠义之士翼戴天子，绥宁海内，使万邦归德；而阻兵安忍，曰莫己若，即蚩尤、智伯复现于今也。’太祖默然。拜先武陵大守。","attribution":"《零陵先贤传》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":508,"anchor":null},"note_id":"n-0ebae0c8750bf2131337","start":37,"end":257}],"profiles":{},"directory_counts":{}}
