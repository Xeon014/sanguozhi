{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"sunshi-e-p046c","title":"刘勋遣刘偕籴于华歆刘偕劝袭宗帅刘勋袭空","accounts":[{"id":"sunshi-e-p046c-account","label":"《江表传》","text":"刘勋遣刘偕籴于华歆刘偕劝袭宗帅刘勋袭空","evidence":["sunshi-e-p046c-q"]}],"participants":[{"person":"wudi-p0168","role":"遣籴袭击","evidence":["sunshi-e-p046c-q"]},{"person":"sunshi-p0071","role":"籴米劝袭","evidence":["sunshi-e-p046c-q"]},{"person":"wudi-p0340","role":"遣吏筹粮","evidence":["sunshi-e-p046c-q"]}],"place":null,"time":{"label":"袁术死前后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["sunshi-e-p046c-q"]},"ordering_evidence":"sunshi-e-p046c-q","source_order":[46,258,"P046c"],"order":8117}],"persons":[{"id":"sunshi-p0071","name":"刘偕","facts":[],"aliases":[]},{"id":"wudi-p0168","name":"刘勋","facts":[],"aliases":[]},{"id":"wudi-p0340","name":"华歆","facts":[],"aliases":[]}],"evidence":[{"id":"sunshi-e-p046c-q","section":"chapter-046","block":"b-0df888008b92c8896d19","layer":"pei","quote":"勋粮食少，无以相赈；乃遣从弟偕，告籴于豫章太守华歆。歆郡素少谷，遣吏将偕，就海昏、上缭，使诸宗帅共出三万斛米以与偕。偕往历月，才得数千斛。偕乃报勋，具说形状，使勋来袭取之。勋得偕书，使潜军到海昏邑下。宗帅知之，空壁逃匿，勋了无所得。","attribution":"《江表传》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":257,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-344fcece1d1f127d763a","start":99,"end":215,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
