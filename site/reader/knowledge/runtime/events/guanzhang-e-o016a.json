{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"guanzhang-e-o016a","title":"张飞诸葛亮溯江定郡破江州释严颜","accounts":[{"id":"guanzhang-e-o016a-account","label":"《关张马黄赵传第六》正文","text":"张飞诸葛亮溯江定郡破江州释严颜","evidence":["guanzhang-e-o016a-q"]}],"participants":[{"person":"wudi-p0367","role":"征讨释俘","evidence":["guanzhang-e-o016a-q"]},{"person":"zhuge-liang","role":"征讨","evidence":["guanzhang-e-o016a-q"]},{"person":"guanzhang-p0006","role":"被俘获释","evidence":["guanzhang-e-o016a-q"]}],"place":null,"time":{"label":"刘备攻刘璋时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["guanzhang-e-o016a-q"]},"ordering_evidence":"guanzhang-e-o016a-q","source_order":[36,65,"O016a"],"order":6871}],"persons":[{"id":"guanzhang-p0006","name":"严颜","facts":[],"aliases":[]},{"id":"wudi-p0367","name":"张飞","facts":[],"aliases":[]},{"id":"zhuge-liang","name":"诸葛亮","facts":[],"aliases":[]}],"evidence":[{"id":"guanzhang-e-o016a-q","section":"chapter-036","block":"b-d1ccc642b9a84445e667","layer":"original","quote":"先主入益州，还攻刘璋；飞与诸葛亮等溯流而上，分定郡县。至江州，破璋将巴郡太守严颜〖4〗。生获颜，飞呵颜曰：“大军至，何以不降而敢拒战？”颜答曰：“卿等无状〖5〗，侵夺我州；我州但有断头将军，无有降将军也！”飞怒，令左右牵去斫头〖6〗；颜色不变，曰：“斫头便斫头，何为怒邪！”飞壮而释之，引为宾客。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":64,"anchor":null},"note_id":null,"start":0,"end":148}],"profiles":{},"directory_counts":{}}
