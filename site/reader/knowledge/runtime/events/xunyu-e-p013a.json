{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xunyu-e-p013a","title":"孔融荐祢衡曹操以为鼓吏祢衡裸身击鼓","accounts":[{"id":"xunyu-e-p013a-account","label":"张衡《文士传》","text":"孔融荐祢衡曹操以为鼓吏祢衡裸身击鼓","evidence":["xunyu-e-p013a-q"]}],"participants":[{"person":"wudi-p0155","role":"推荐","evidence":["xunyu-e-p013a-q"]},{"person":"cao-cao","role":"任鼓吏","evidence":["xunyu-e-p013a-q"]},{"person":"xunyu-p0026","role":"击鼓","evidence":["xunyu-e-p013a-q"]}],"place":null,"time":{"label":"祢衡在许都时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xunyu-e-p013a-q"]},"ordering_evidence":"xunyu-e-p013a-q","source_order":[10,82,"P013a"],"order":2414}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0155","name":"孔融","facts":[],"aliases":[]},{"id":"xunyu-p0026","name":"祢衡","facts":[],"aliases":[]}],"evidence":[{"id":"xunyu-e-p013a-q","section":"chapter-010","block":"b-3e2135952faf7548507a","layer":"pei","quote":"孔融数荐衡于太祖，欲与相见；而衡疾恶之，意常愤懑。因狂疾，不肯往，而数有言论。太祖闻其名，图欲辱之，乃录为鼓吏。后至八月，朝，大宴，宾客并会。时鼓吏击鼓，过，皆当脱其故服，易着新衣。次衡，衡击为‘渔阳参挝’，容态不常，音节殊妙。坐上宾客听之，莫不慷慨。过，不易衣，吏呵之。衡乃当太祖前，以次脱衣，裸身而立；徐徐乃著裈、帽毕，复击鼓参挝，而颜色不怍。太祖大笑，告四坐曰：‘本欲辱衡，衡反辱孤！’至今有‘渔阳参挝’，自衡造也。","attribution":"张衡《文士传》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":81,"anchor":null},"note_id":"n-c5cdbaf6b01ad416ab88","start":10,"end":221}],"profiles":{},"directory_counts":{}}
