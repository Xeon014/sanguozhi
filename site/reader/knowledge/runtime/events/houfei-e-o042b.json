{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"houfei-e-o042b","title":"郭表进封观津侯郭详迁驸马都尉","accounts":[{"id":"houfei-e-o042b-account","label":"《后妃传》正文","text":"郭表进封观津侯郭详迁驸马都尉","evidence":["houfei-e-o042b-q"]}],"participants":[{"person":"houfei-p0061","role":"受封","evidence":["houfei-e-o042b-q"]},{"person":"houfei-p0066","role":"受任","evidence":["houfei-e-o042b-q"]}],"place":null,"time":{"year":235,"label":"郭后葬后","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"houfei-y235","dating_review":{"reviewed":true,"anchor":"houfei-q-o025","basis":"郭后葬后"},"evidence":["houfei-e-o042b-q","houfei-q-o025","houfei-q-b-e47ffea5cca5eab53d92"]},"ordering_evidence":"houfei-e-o042b-q","source_order":[5,203,"O042b"],"order":1442}],"persons":[{"id":"houfei-p0061","name":"郭表","facts":[],"aliases":[]},{"id":"houfei-p0066","name":"郭详","facts":[],"aliases":[]}],"evidence":[{"id":"houfei-e-o042b-q","section":"chapter-005","block":"b-66c1f6044f4f1392a642","layer":"original","quote":"青龙三年春，后崩于许昌，以终制营陵。三月庚寅〖3〗，葬首阳陵西。﹝一﹞帝进表爵为观津侯，增邑五百，并前千户。迁详为驸马都尉〖4〗。四年〖5〗，追改封永为观津敬侯，世妇董为堂阳君；追封谥后兄浮为梁里亭戴侯，都为武城亭孝侯，成为新乐亭定侯：皆使使者奉策，祠以太牢。表薨，子详嗣；又分表爵，封详弟述为列侯。详薨，子钊嗣。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":202,"anchor":null},"note_id":null,"start":0,"end":157},{"id":"houfei-q-b-e47ffea5cca5eab53d92","section":"chapter-005","block":"b-e47ffea5cca5eab53d92","layer":"modern","quote":"〖15〗三年：青龙三年（公元 235）。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":113,"anchor":null},"note_id":"n-4aa0b3373c71cedadeb9","start":0,"end":20},{"id":"houfei-q-o025","section":"chapter-005","block":"b-0744a279ae4c62a54e64","layer":"original","quote":"青龙二年春，追谥后兄俨曰安城乡穆侯。夏，吴贼寇扬州，以像为伏波将军〖12〗，持节，监诸将东征〖13〗。还，复为射声校尉〖14〗。三年薨〖15〗，追赠卫将军，改封魏昌县，谥曰贞侯。子畅嗣。又封畅弟温、4 、艳，皆为列侯。四年〖16〗，改逸、俨本封，皆曰魏昌侯，谥因故〖17〗。封俨世妇刘为东乡君〖18〗，又追封逸世妇张为安喜君。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":97,"anchor":null},"note_id":null,"start":0,"end":163}],"profiles":{},"directory_counts":{}}
