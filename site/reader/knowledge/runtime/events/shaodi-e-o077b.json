{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"shaodi-e-o077b","title":"姜维退军","accounts":[{"id":"shaodi-e-o077b-account","label":"《三少帝纪》正文","text":"姜维退军","evidence":["shaodi-e-o077b-q"]},{"id":"jfj-a-o042b","label":"正文 · 延熙十八年","text":"陈泰解围姜维退钟题","evidence":["jfj-q0160"]}],"participants":[{"person":"shaodi-p0050","role":"退还","evidence":["shaodi-e-o077b-q"]},{"person":"shaodi-p0046","role":"解围","evidence":["jfj-q0160"]}],"place":null,"time":{"year":255,"label":"甲辰","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"shaodi-y255","dating_review":{"reviewed":true,"anchor":"shaodi-q-o072","basis":"甲辰"},"evidence":["shaodi-e-o077b-q","shaodi-q-o072","shaodi-q-b-2de9ea37d1e15a7d296f"]},"ordering_evidence":"shaodi-e-o077b-q","source_order":[4,338,"O077b"],"order":1156}],"persons":[{"id":"shaodi-p0046","name":"陈泰","facts":[],"aliases":[]},{"id":"shaodi-p0050","name":"姜维","facts":[],"aliases":[]}],"evidence":[{"id":"jfj-q0160","section":"chapter-044","block":"b-5af1c31721bbfd739fd3","layer":"original","quote":"魏征西将军陈泰进兵解围，维却住钟题","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":195,"anchor":null},"note_id":null,"start":56,"end":73},{"id":"shaodi-e-o077b-q","section":"chapter-004","block":"b-73a3b6bc2611d46777de","layer":"original","quote":"九月，庚子〖32〗，讲《尚书》业终；赐执经亲授者司空郑冲、侍中郑小同等各有差〖33〗。甲辰〖34〗，姜维退还。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":337,"anchor":null},"note_id":null,"start":0,"end":55},{"id":"shaodi-q-b-2de9ea37d1e15a7d296f","section":"chapter-004","block":"b-2de9ea37d1e15a7d296f","layer":"modern","quote":"〖6〗二年：正元二年（公元 255）。乙丑：旧历十二日。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":346,"anchor":null},"note_id":"n-96103ace1e11ae4131ba","start":0,"end":28},{"id":"shaodi-q-o072","section":"chapter-004","block":"b-4b9070779d1c209c6814","layer":"original","quote":"二年春正月，乙丑〖6〗，镇东将军毌丘俭、扬州刺史文钦反。（戊戌）〔戊寅〕〖7〗，大将军司马景王征之。癸未〖8〗，车骑将军郭淮薨。闰月，己亥〖9〗，破钦于乐嘉〖10〗；钦遁走，遂奔吴。甲辰〖11〗，安风淮津都尉斩俭〖12〗，传首京都。﹝一﹞壬子〖13〗，复特赦淮南士民诸为俭、钦所诖误者〖14〗。以镇南将军诸葛诞为镇东大将军〖15〗。司马景王薨于许昌。二月，丁巳〖16〗，以卫将军司马文王为大将军〖17〗，录尚书事。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":332,"anchor":null},"note_id":null,"start":0,"end":207}],"profiles":{},"directory_counts":{}}
