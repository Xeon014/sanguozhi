{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dongyuan-e-p118b","title":"华容女子狱中呼刘表死官验释女后李立任荆州刺史","accounts":[{"id":"dongyuan-e-p118b-account","label":"《搜神记》","text":"《搜神记》载女子预言、验死而释，及李立任荆州刺史的应谣叙事。","evidence":["dongyuan-e-p118b-q"]}],"participants":[{"person":"dongyuan-p0183","role":"受任","evidence":["dongyuan-e-p118b-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-p118b-q"]},"ordering_evidence":"dongyuan-e-p118b-q","source_order":[6,499,"P118b"],"order":1771}],"persons":[{"id":"dongyuan-p0183","name":"李立（荆州刺史）","facts":[],"aliases":[]}],"evidence":[{"id":"dongyuan-e-p118b-q","section":"chapter-006","block":"b-d954c685525c5090df05","layer":"pei","quote":"是时，华容有女子忽啼呼云：‘荆州将有大丧！’言语过差，县以为妖言，系狱月余。忽于狱中哭曰：‘刘荆州今日死！’华容去州数百里，即遣马吏验视；而刘表果死，县乃出之。续又歌吟曰：‘不意李立为贵人。’后无几，太祖平荆州，以涿郡李立字建贤，为荆州刺史。","attribution":"《搜神记》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":498,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-aad7859d6d1ec44f2250","start":225,"end":346,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
