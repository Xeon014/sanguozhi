{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p055a","title":"王忠夺娄子伯兵归曹操","accounts":[{"id":"wudi-e-p055a-account","label":"《魏略》","text":"《魏略》记王忠逢三辅乱南行，不愿随娄子伯去荆州，率众夺其兵，后以千余众归曹操，拜中郎将。","evidence":["wudi-e-p055a-q"]}],"participants":[{"person":"wudi-p0167","role":"夺兵归附","evidence":["wudi-e-p055a-q"]},{"person":"wudi-p0169","role":"被夺兵","evidence":["wudi-e-p055a-q"]},{"person":"cao-cao","role":"受降授官","evidence":["wudi-e-p055a-q"]}],"place":{"text":"三辅、武关","evidence":["wudi-e-p055a-q"]},"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p055a-q"]},"source_order":[1,400,"P055a"],"order":172}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0167","name":"王忠","facts":[],"aliases":[]},{"id":"wudi-p0169","name":"娄子伯","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-p055a-q","section":"chapter-001","block":"b-a0d16c61570ecad54643","layer":"pei","quote":"王忠，扶风人。少为亭长。三辅乱，忠饥乏噉人，随辈南向武关。值娄子伯为荆州遣，迎北方客人。忠不欲去，因率等仵逆击之，夺其兵，聚众千余人以归公。拜忠中郎将，从征讨。","attribution":"《魏略》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":399,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-f142c35558b278dd215d","start":7,"end":87,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
