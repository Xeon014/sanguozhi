{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wgc-e-13-e4","title":"王凌奏文钦贪残征还","order":5545,"accounts":[{"id":"wgc-a-13-e4","label":"裴注·魏书","text":"王凌奏文钦贪残征还","evidence":["wgc-q0574","wgc-q0107"]}],"participants":[{"person":"shaodi-p0004","role":"奏钦贪残不宜抚边、求免官治罪","evidence":["wgc-q0574","wgc-q0107"]},{"person":"shaodi-p0074","role":"被奏劾征还","evidence":["wgc-q0574","wgc-q0107"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0574","wgc-q0107"]},"ordering_evidence":"wgc-q0574"}],"persons":[{"id":"shaodi-p0004","name":"王凌","facts":[],"aliases":[]},{"id":"shaodi-p0074","name":"文钦","facts":[],"aliases":[]}],"evidence":[{"id":"wgc-q0107","section":"chapter-028","block":"b-01db76f800633531c3ca","layer":"pei","quote":"《魏书》曰：“钦字仲若，谯郡人。父稷，建安中为骑将，有勇力。钦少以名将子材武，见称。魏讽反，钦坐与讽辞语相连；及下狱，掠答数百，当死；太祖以稷故，赦之。太和中，为五营校督，出为牙门将。钦性刚暴无礼，所在倨傲陵上，不奉官法；辄见奏遣，明帝抑之。后复以为淮南牙门将，转为庐江太守、鹰扬将军。王凌奏钦贪残，不宜抚边，求免官治罪，由是征钦还。曹爽以钦乡里，厚养待之，不治钦事。复遣还庐江，加冠军将军，贵宠逾前。钦以故益骄，好自矜伐，以壮勇高人，颇得虚名于三军。曹爽诛后，进钦为前将军，以安其心，后代诸葛诞为扬州刺史。自曹爽之诛，钦常内惧；与诸葛诞相恶，无所与谋。会诞去兵，毌丘俭往，乃阴共结谋。战败走，昼夜间行，追者不及；遂得入吴，孙峻厚待之。钦虽在他国，不能屈节下人，自吕据、朱异等诸大将，皆憎疾之，惟峻常左右之。”","attribution":"魏书","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":148,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-768f4d3727cf793bd05b","start":0,"end":355,"offset_unit":"unicode_code_point"},{"id":"wgc-q0574","section":"chapter-028","block":"b-01db76f800633531c3ca","layer":"pei","quote":"王凌奏钦贪残，不宜抚边，求免官治罪，由是征钦还","attribution":"裴注·魏书","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":148,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-768f4d3727cf793bd05b","start":143,"end":166,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
