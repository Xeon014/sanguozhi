{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dongyuan-e-p084a","title":"沮授自言不降曹操劝共事沮授以袁氏家人为念请速死","accounts":[{"id":"dongyuan-e-p084a-account","label":"《献帝传》","text":"沮授自言不降曹操劝共事沮授以袁氏家人为念请速死","evidence":["dongyuan-e-p084a-q"]}],"participants":[{"person":"wudi-p0218","role":"拒降","evidence":["dongyuan-e-p084a-q"]},{"person":"cao-cao","role":"劝用","evidence":["dongyuan-e-p084a-q"]}],"place":null,"time":{"label":"沮授被获时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-p084a-q"]},"ordering_evidence":"dongyuan-e-p084a-q","source_order":[6,336,"P084a"],"order":1682}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0218","name":"沮授","facts":[],"aliases":[]}],"evidence":[{"id":"dongyuan-e-p084a-q","section":"chapter-006","block":"b-5083be0be119fd3b818a","layer":"pei","quote":"﹝五﹞《献帝传》云：“授大呼曰：‘授不降也，为军所执耳！’太祖与之有旧，逆谓授曰：‘分野殊异，遂用圮绝；不图今日，乃相擒也！’授对曰：‘冀州失策，以取奔北。授智力俱困，宜其见擒耳。’太祖曰：‘本初无谋，不用君计。今丧乱过纪，国家未定，当相与图之。’授曰：‘叔父、母、弟，悬命袁氏；若蒙公灵，速死为福。’太祖叹曰：‘孤早相得，天下不足虑！’”","attribution":"《献帝传》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":335,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-dfd32419f8839c61ad81","start":0,"end":170,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
