{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"yuanzhang-e-o185","title":"管宁所居屯落会井汲者争斗，宁多买器分置井傍汲以待之又不使知，来者问知宁所为乃各相责，不复斗讼","accounts":[{"id":"yuanzhang-a-57e29935059f8fd6d3f4","label":"裴注·高士传","text":"管宁所居屯落会井汲者争斗，宁多买器分置井傍汲以待之又不使知，来者问知宁所为乃各相责，不复斗讼","evidence":["yuanzhang-q-ab6efe2feb64b59741c3"]},{"id":"yuanzhang-a-351e53b5345a1b3335dc","label":"裴注·高士传","text":"邻牛暴管宁田，宁牵牛着凉处自为饮食过于牛主，牛主大惭若犯严刑，是以左右无斗讼之声，礼让移于海表","evidence":["yuanzhang-q-095630647e5512d28391"]}],"participants":[{"person":"huanchen-p0600","role":"患会井汲者男女杂错争井斗阋，乃多买器分置井傍汲以待之又不使知，来者问知宁所为乃各相责不复斗讼；为牵牛着凉处，自为饮食过于牛主，左右无斗讼之声，礼让移于海表","evidence":["yuanzhang-q-ab6efe2feb64b59741c3","yuanzhang-q-095630647e5512d28391"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["yuanzhang-q-ab6efe2feb64b59741c3","yuanzhang-q-095630647e5512d28391"]},"ordering_evidence":"yuanzhang-q-ab6efe2feb64b59741c3","source_order":[11,365,11],"order":2651}],"persons":[{"id":"huanchen-p0600","name":"管宁","facts":[],"aliases":[]}],"evidence":[{"id":"yuanzhang-q-095630647e5512d28391","section":"chapter-011","block":"b-bbcb362d43169663aed0","layer":"pei","quote":"邻有牛暴宁田者，宁为牵牛着凉处；自为饮食，过于牛主。牛主得牛，大惭，若犯严刑。是以左右无斗讼之声，礼让移于海表","attribution":"裴注·高士传","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":364,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4958052ff2433e6ba0c5","start":81,"end":136,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-ab6efe2feb64b59741c3","section":"chapter-011","block":"b-bbcb362d43169663aed0","layer":"pei","quote":"宁所居屯落，会井汲者，或男女杂错，或争井斗阋。宁患之，乃多买器，分置井傍；汲以待之，又不使知。来者得而怪之，问知宁所为；乃各相责，不复斗讼","attribution":"裴注·高士传","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":364,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4958052ff2433e6ba0c5","start":11,"end":80,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
