{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wgc-e-0-e61","title":"梁口大战位宫连破走","order":5492,"accounts":[{"id":"wgc-a-0-e61","label":"正文","text":"梁口大战位宫连破走","evidence":["wgc-q0207","wgc-q0014"]},{"id":"wuhuan-a-63e5e97d10dff51017ff","label":"正文","text":"正始五年位宫为幽州刺史毌丘俭所破","evidence":["wuhuan-q-ef30f7a11e957773b5d5"]}],"participants":[{"person":"mingdi-p0048","role":"大战梁口","evidence":["wgc-q0207","wgc-q0014"]},{"person":"wgc-p0012","role":"连破走","evidence":["wgc-q0207","wgc-q0014"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0207","wgc-q0014"]},"ordering_evidence":"wgc-q0207"}],"persons":[{"id":"mingdi-p0048","name":"毌丘俭","facts":[],"aliases":[]},{"id":"wgc-p0012","name":"位宫","facts":[],"aliases":[]}],"evidence":[{"id":"wgc-q0014","section":"chapter-028","block":"b-e84cfed6dc081f886cb5","layer":"original","quote":"正始中，俭以高句骊数侵叛〖1〗，督诸军步骑万人出玄菟〖2〗，从诸道讨之。句骊王宫将步骑二万人〖3〗，进军沸流水上〖4〗；大战梁口〖5〗，﹝一﹞宫连破走。俭遂束马悬车〖6〗，以登丸都〖7〗；屠句骊所都，斩获首虏以千数。句骊沛者名得来〖8〗，数谏宫，﹝二﹞宫不从其言。得来叹曰：“立见此地将生蓬蒿〖9〗。”遂不食而死，举国贤之。俭令诸军不坏其墓，不伐其树；得其妻子，皆放遣之。宫单将妻子逃窜，俭引军还。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":83,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":199,"offset_unit":"unicode_code_point"},{"id":"wgc-q0207","section":"chapter-028","block":"b-e84cfed6dc081f886cb5","layer":"original","quote":"大战梁口〖5〗，﹝一﹞宫连破走","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":83,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":60,"end":75,"offset_unit":"unicode_code_point"},{"id":"wuhuan-q-ef30f7a11e957773b5d5","section":"chapter-030","block":"b-ff66571bde87edf233d8","layer":"original","quote":"其五年〖40〗，为幽州刺史毌丘俭所破","section_title":"乌丸鲜卑东夷传第三十","source":{"file":"OEBPS/Text/titlepage_0066.xhtml","index":193,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":58,"end":76,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
