{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"pangfa-e-p005a","title":"庞统劝刘备取益州","accounts":[{"id":"pangfa-e-p005a-account","label":"《九州春秋》","text":"《九州春秋》记庞统劝刘备取益州；刘备先以信义为虑，庞统以权变相劝。","evidence":["pangfa-e-p005a-q"]}],"participants":[{"person":"xianzhu-p0048","role":"献策","evidence":["pangfa-e-p005a-q"]},{"person":"liu-bei","role":"答议","evidence":["pangfa-e-p005a-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["pangfa-e-p005a-q"]},"ordering_evidence":"pangfa-e-p005a-q","source_order":[37,35,"P005a"],"order":6965}],"persons":[{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"xianzhu-p0048","name":"庞统","facts":[],"aliases":[]}],"evidence":[{"id":"pangfa-e-p005a-q","section":"chapter-037","block":"b-27683b06f78341851e28","layer":"pei","quote":"统说备曰：‘荆州荒残，人物殚尽；东有吴孙，北有曹氏；鼎足之计，难以得志。今益州国富民强，户口百万；四部兵马，所出必具，宝货无求于外。今可权借，以定大事。’备曰：‘今指与吾为水火者，曹操也。操以急，吾以宽；操以暴，吾以仁；操以谲，吾以忠：每与操反，事乃可成耳。今以小故而失信义于天下者，吾所不取也。’统曰：‘权变之时，固非一道所能定也。兼弱攻昧，五伯之事。逆取顺守，报之以义；事定之后，封以大国，何负于信？今日不取，终为人利耳！’备遂行。”","attribution":"《九州春秋》","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":34,"anchor":null},"note_id":"n-67e41912fb751b852523","start":12,"end":231}],"profiles":{},"directory_counts":{}}
