"index":285,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":15,"offset_unit":"unicode_code_point"},{"id":"huanchen-q-2c53e4e79f6ddf09fe15","section":"chapter-022","block":"b-901797ddbd952af29d74","layer":"pei","quote":"太常陈泰不至。使其舅荀顗召之，顗至，告以可否。泰曰：‘世之论者，以泰方于舅；今舅不如泰也。’子弟内外咸共逼之，垂涕而入。王待之曲室，谓曰：‘玄伯，卿何以处我？’对曰：‘诛贾充以谢天下。’文王曰：‘为我更思其次。’泰曰：‘泰言惟有进于此，不知其次","attribution":"裴注·干宝《晋纪》","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":307,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0bbc954a34e821268698","start":31,"end":153,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
