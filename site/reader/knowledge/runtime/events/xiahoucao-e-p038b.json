{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xiahoucao-e-p038b","title":"丁斐私易官牛下狱曹操戏问而复官后卒","accounts":[{"id":"xiahoucao-e-p038b-account","label":"《魏略》","text":"丁斐私易官牛下狱曹操戏问而复官后卒","evidence":["xiahoucao-e-p038b-q"]}],"participants":[{"person":"wudi-p0286","role":"易牛获免而卒","evidence":["xiahoucao-e-p038b-q"]},{"person":"cao-cao","role":"复官","evidence":["xiahoucao-e-p038b-q"]}],"place":null,"time":{"label":"丁斐及丁谧仕魏时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xiahoucao-e-p038b-q"]},"ordering_evidence":"xiahoucao-e-p038b-q","source_order":[9,372,"P038b"],"order":2284}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0286","name":"丁斐","facts":[],"aliases":[]}],"evidence":[{"id":"xiahoucao-e-p038b-q","section":"chapter-009","block":"b-884d7077d19ad250ca59","layer":"pei","quote":"建安末，从太祖征吴。斐随行，自以家牛羸困，乃私易官牛；为人所白，被收送狱，夺官。其后太祖问斐曰：‘文侯，印绶所在？’斐亦知见戏，对曰：‘以易饼耳！’太祖笑，顾谓左右曰：‘东曹毛掾，数白此家，欲令我重治；我非不知此人不清，良有以也。我之有斐，譬如人家有盗狗而善捕鼠；盗虽有小损，而完我囊贮。’遂复斐官，听用如初。后数岁，病亡。","attribution":"《魏略》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":371,"anchor":null},"note_id":"n-45775d68baddd17aab59","start":72,"end":234}],"profiles":{},"directory_counts":{}}
