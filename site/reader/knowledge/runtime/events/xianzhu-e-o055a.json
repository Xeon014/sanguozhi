33124c9ebbcef6c42","huangli-q2-0a4da79e2745b2da2b6c"]}],"participants":[{"person":"xianzhu-p0062","role":"任治中从事","evidence":["huangli-q2-0a4da79e2745b2da2b6c"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"第二轮逐项审定；仅保原文时序，不另行推年。","evidence":["huangli-q2-0a4da79e2745b2da2b6c"]},"ordering_evidence":"huangli-q2-0a4da79e2745b2da2b6c","related_events":[{"event":"xianzhu-e-o055a","type":"related","evidence":["huangli-q2-0a4da79e2745b2da2b6c","xianzhu-e-o055a-q"]}],"order":7589}],"persons":[{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"xianzhu-p0059","name":"许靖","facts":[],"aliases":[]},{"id":"xianzhu-p0065","name":"刘巴","facts":[],"aliases":[]}],"evidence":[{"id":"dengzhang-q2-0eabec327d7f8184a731","section":"chapter-045","block":"b-96d3f55961b19f0ab838","layer":"original","quote":"王元泰名谋，汉嘉人也。有容止操行〖66〗。刘璋时，为巴郡太守。还为州治中从事。先主定益州，领牧，以为别驾。先主为汉中王，用荆楚宿士零陵赖恭为太常〖67〗，南阳黄柱为光禄勋，谋为少府。建兴初，赐爵关内侯。后代赖恭为太常。恭、柱、谋皆失其行事，故不为传。恭子厷，为丞相西曹令史〖68〗。随诸葛亮于汉中，早夭。亮甚惜之，与留府长史、参军张裔、蒋琬书曰：“令史失赖厷，掾属丧杨颙，为朝中损益多矣〖69〗！”颙亦荆州人也。后大将军蒋琬问张休曰：“汉嘉前辈有王元泰，今谁继者？”休对曰：“至于元泰，州里无继〖70〗；况鄙郡乎？”其见重如此。﹝一﹞","section_title":"邓张宗杨传第十五","source":{"file":"OEBPS/Text/titlepage_0096.xhtml","index":179,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":267,"offset_unit":"unicode_code_point"},{"id":"dongliu-q-c06fe3dfe6262833bc5a","section":"chapter-039","block":"b-22ff29b0855feef1fa8d","layer":"original","quote":"建安二十四年，先主为汉中王，巴为尚书","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":46,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":63,"end":81,"offset_unit":"unicode_code_point"},{"id":"huangli-q-ed531f2e5ebe41d602d8","section":"chapter-043","block":"b-6db5580c9991faf8b338","layer":"original","quote":"先主为汉中王，犹领益州牧","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":11,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":12,"offset_unit":"unicode_code_point"},{"id":"huangli-q2-0a4da79e2745b2da2b6c","section":"chapter-043","block":"b-6db5580c9991faf8b338","layer":"original","quote":"以权为治中从事。","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":11,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":13,"end":21,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o055a-q","section":"chapter-032","block":"b-430cf056e3d7a4efdfc3","layer":"original","quote":"遂于沔阳设坛场〖60〗，陈兵列众，群臣陪位；读奏讫，御王冠于先主。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":210,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":33,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-b-c3e56caa3865de7f7114","section":"chapter-032","block":"b-c3e56caa3865de7f7114","layer":"modern","quote":"〖11〗二十四年：建安二十四年（公元 219）。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":222,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fd85f82251e498647de7","start":0,"end":24,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o048","section":"chapter-032","block":"b-2d515ba2dae40f6a248e","layer":"original","quote":"二十四年春〖11〗，自阳平南渡沔水，缘山稍前〖12〗，于定军山（势）作营〖13〗。渊将兵来争其地，先主命黄忠乘高鼓噪攻之。大破渊军，斩渊及曹公所署益州刺史赵颙等。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":203,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":81,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-3c2ad97c444c1d4d259f","section":"chapter-038","block":"b-0bdedb2d238ea43a24e7","layer":"original","quote":"先主为汉中王","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":149,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":6,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-93fdd6eff8ba1f4b93c5","section":"chapter-038","block":"b-0bdedb2d238ea43a24e7","layer":"original","quote":"靖为太傅","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":149,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":7,"end":11,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
