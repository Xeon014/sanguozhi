{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p098a","title":"曹操再会韩遂陈列铁骑","accounts":[{"id":"wudi-e-p098a-account","label":"《魏书》","text":"《魏书》记曹操再会韩遂，接受诸将建议置木行马防护，并列铁骑五千，观者震惧。","evidence":["wudi-e-p098a-q"]}],"participants":[{"person":"cao-cao","role":"会谈列骑","evidence":["wudi-e-p098a-q"]},{"person":"wudi-p0048","role":"会谈","evidence":["wudi-e-p098a-q"]}],"place":null,"time":{"label":"西征会谈时","year":211,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-p098a-q","wudi-q-o128","wudi-q-b-2dc1a34b174874acae8b"],"chronology":"wudi-y211","dating_review":{"anchor":"wudi-q-o128","basis":"西征会谈时","reviewed":true}},"source_order":[1,778,"P098a"],"order":323}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0048","name":"韩遂","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-p098a-q","section":"chapter-001","block":"b-1059cbe8ce71255beb30","layer":"pei","quote":"﹝四﹞《魏书》曰：“公后日复与遂等会语，诸将曰：‘公与虏交语，不宜轻脱；可为木行马，以为防遏。’公然之。贼将见公，悉于马上拜；秦、胡观者，前后重沓。公笑谓贼曰：‘汝欲观曹公邪？亦犹人也；非有四目两口，但多智耳！’胡前后大观。又列铁骑五千，为十重阵，精光耀日，贼益震惧。”","attribution":"《魏书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":102,"anchor":null},"note_id":"n-2a0803153db27222873f","start":0,"end":135},{"id":"wudi-q-b-2dc1a34b174874acae8b","section":"chapter-001","block":"b-2dc1a34b174874acae8b","layer":"modern","quote":"〖1〗十六年：建安十六年（公元 211）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":54,"anchor":null},"note_id":"n-889c5acff5776ef2f54b","start":0,"end":21},{"id":"wudi-q-o128","section":"chapter-001","block":"b-37e542ccc37d1632e170","layer":"original","quote":"十六年春正月〖1〗，﹝一﹞天子命公世子丕为五官中郎将〖2〗，置官属〖3〗；为丞相副。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":51,"anchor":null},"note_id":null,"start":0,"end":42}],"profiles":{},"directory_counts":{}}
