santizhu-q-9b248481834fb33d577b","shaodi-e-o073a-q"]},{"event":"santizhu064-e-r-255-campaign","type":"related","evidence":["santizhu064-q-20d87b32e3639cb4e23a","shaodi-e-o073a-q"]},{"event":"santizhu064-e-sr-liuzan-death-wushu","type":"alternative","evidence":["santizhu064-q-51aceda50efd02b54ab2","shaodi-e-o073a-q"]}],"order":1147}],"persons":[{"id":"santizhu-p0009","name":"孙楞","facts":[],"aliases":[]},{"id":"santizhu-p0010","name":"蒋修","facts":[],"aliases":[]},{"id":"shaodi-p0076","name":"留赞","facts":[],"aliases":[]},{"id":"wgc-p0019","name":"蒋班","facts":[],"aliases":[]}],"evidence":[{"id":"santizhu-q-9b248481834fb33d577b","section":"chapter-048","block":"b-d33ac4d7966626cd5c5b","layer":"original","quote":"留赞为诞别将蒋班所败于菰陂〖9〗，赞及将军孙楞、蒋修等，皆遇害。","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":53,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":153,"end":185,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-51aceda50efd02b54ab2","section":"chapter-064","block":"b-d6d1b5c9cae4cad8e15d","layer":"pei","quote":"孙峻征淮南，授赞节，拜左护军。未至寿春，道路病发，峻令赞将车重先还。魏将蒋班，以步骑四千追赞。赞病困，不能整阵；知必败，乃解曲盖、印绶，付弟子以归，曰：‘吾自为将，破敌搴旗，未尝负败。今病困兵羸，众寡不敌；汝速去矣，俱死无益于国，适所以快敌耳。’弟子不肯受，拔刀欲斫之，乃去。初，赞为将，临敌必先被发叫天，因抗音而歌，左右应之；毕，乃进战，战无不克。及败，叹曰：‘吾战有常术，今病困若此，固命也！’遂被害，时年七十三。众庶痛惜焉。二子：略、平，并为大将。”","attribution":"裴注·吴书","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":414,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9d9f10434c65e6735646","start":299,"end":527,"offset_unit":"unicode_code_point"},{"id":"shaodi-e-o073a-q","section":"chapter-004","block":"b-edb853525f526ca4c6d7","layer":"original","quote":"甲子〖18〗，吴大将孙峻等众号十万〖19〗，至寿春；诸葛诞拒击破之，斩吴左将军留赞〖20〗，献捷于京都。三月，立皇后卞氏〖21〗，大赦。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":333,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":68,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
