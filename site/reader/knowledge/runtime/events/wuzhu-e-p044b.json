{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wuzhu-e-p044b","title":"陈化戒子弟不争利辞宗室婚老归章安卒","accounts":[{"id":"wuzhu-e-p044b-account","label":"《吴书》","text":"陈化戒子弟不争利辞宗室婚老归章安卒","evidence":["wuzhu-e-p044b-q"]}],"participants":[{"person":"wuzhu-p0052","role":"戒家辞婚退居","evidence":["wuzhu-e-p044b-q"]},{"person":"sun-quan","role":"许辞","evidence":["wuzhu-e-p044b-q"]}],"place":null,"time":{"label":"陈化任官至卒","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["wuzhu-e-p044b-q"]},"ordering_evidence":"wuzhu-e-p044b-q","source_order":[47,386,"P044b"],"order":8267}],"persons":[{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"wuzhu-p0052","name":"陈化","facts":[],"aliases":[]}],"evidence":[{"id":"wuzhu-e-p044b-q","section":"chapter-047","block":"b-18ebe4b5f421a0b951d1","layer":"pei","quote":"正色立朝，（劝）〔敕〕子弟：废田业，绝治产；仰官廪禄，不与百姓争利。妻早亡，化以古事为鉴，乃不复娶。权闻而贵之，以其年壮，敕宗正：妻以宗室女；化固辞以疾，权不违其志。年出七十，乃上疏乞骸骨。遂爰居章安，卒于家。","attribution":"《吴书》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":385,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-e3000e5763a1cac243ce","start":218,"end":323,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
