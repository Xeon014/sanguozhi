{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wendi-e-p097a","title":"殡曹丕于崇华前殿","accounts":[{"id":"wendi-e-p097a-account","label":"裴注·魏书","text":"殡曹丕于崇华前殿","evidence":["wendi-e-p097a-q"]}],"participants":[],"place":null,"time":{"year":226,"label":"黄初七年五月卒后","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"wendi-y226","dating_review":{"reviewed":true,"anchor":"wendi-q-o054","basis":"黄初七年五月卒后"},"evidence":["wendi-e-p097a-q","wendi-q-o054","wendi-q-o049","wendi-q-b-e28c5cd47fe98ad60171"]},"ordering_evidence":"wendi-e-p097a-q","source_order":[2,501,"P097a"],"order":680}],"persons":[],"evidence":[{"id":"wendi-e-p097a-q","section":"chapter-002","block":"b-61f842d5a01f2702923d","layer":"pei","quote":"﹝一﹞《魏书》曰：“殡于崇华前殿。”","attribution":"裴注·魏书","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":500,"anchor":null},"note_id":"n-ea8bbb0ab5e37651ea5e","start":0,"end":18},{"id":"wendi-q-b-e28c5cd47fe98ad60171","section":"chapter-002","block":"b-e28c5cd47fe98ad60171","layer":"modern","quote":"〖1〗六年：黄初六年（公元 225）。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":467,"anchor":null},"note_id":"n-61512c4ade75d71d6a76","start":0,"end":19},{"id":"wendi-q-o049","section":"chapter-002","block":"b-d5847039c2d504d36e8e","layer":"original","quote":"六年春二月〖1〗，遣使者循行许昌以东，尽沛郡〖2〗。问民所疾苦，贫者赈贷之。﹝一﹞三月，行幸召陵〖3〗，通讨虏渠〖4〗。乙巳〖5〗，还许昌宫。并州刺史梁习讨鲜卑轲比能〖6〗，大破之。辛未〖7〗，帝为舟师，东征。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":461,"anchor":null},"note_id":null,"start":0,"end":105},{"id":"wendi-q-o054","section":"chapter-002","block":"b-19250f15bc304637f90e","layer":"original","quote":"七年春正月，将幸许昌。许昌城南门，无故自崩；帝心恶之，遂不入。壬子〖1〗，行还洛阳宫。三月，筑九华台〖2〗。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":487,"anchor":null},"note_id":null,"start":0,"end":54}],"profiles":{},"directory_counts":{}}
