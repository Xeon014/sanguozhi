{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"houzhu-e-o070m1","title":"孙綝废孙亮、立孙休","accounts":[{"id":"houzhu-a-92e9112a3c0c","label":"《后主传》正文","text":"孙綝废孙亮、立孙休","evidence":["houzhu-q-O070"]},{"id":"feipin-a-8af204ffe4312ce23621","label":"正文","text":"朱损妻为峻妹，孙綝益忌孙亮而废立孙休","evidence":["feipin-q-d26e3fd768be78646377"]}],"participants":[{"person":"houzhu-p0013","role":"废立者","evidence":["houzhu-q-O070"]},{"person":"wuzhu-p0128","role":"被废者","evidence":["houzhu-q-O070"]},{"person":"shaodi-p0150","role":"被立者","evidence":["houzhu-q-O070"]}],"place":null,"time":{"label":"景耀元年","precision":"undated","basis":"保留本段原始时间表达；没有直接绑定的公元年证据，未补公元年。","evidence":["houzhu-q-O070"]},"ordering_evidence":"houzhu-q-O070","source_order":[33,70,"O070m1"],"order":6687}],"persons":[{"id":"houzhu-p0013","name":"孙綝","facts":[],"aliases":[]},{"id":"shaodi-p0150","name":"孙休","facts":[],"aliases":[]},{"id":"wuzhu-p0128","name":"孙亮","facts":[],"aliases":[]}],"evidence":[{"id":"feipin-q-d26e3fd768be78646377","section":"chapter-050","block":"b-69af0fa98c05338f3141","layer":"original","quote":"损妻是峻妹也，孙綝益忌亮；遂废亮，立休。","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":124,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":52,"end":72,"offset_unit":"unicode_code_point"},{"id":"houzhu-q-O070","section":"chapter-033","block":"b-2716021d4754d2fb64f1","layer":"original","quote":"景耀元年〖1〗，姜维还成都。史官言景星现〖2〗，于是大赦，改年。宦人黄皓始专政〖3〗。吴大将军孙綝废其主亮〖4〗，立琅邪王休〖5〗。","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":146,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":66,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
