{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wgc-e-7-e19","title":"丘建启会使听纳亲兵","order":5804,"accounts":[{"id":"wgc-a-7-e19","label":"正文","text":"丘建启会使听纳亲兵","evidence":["wgc-q0497","wgc-q0081"]}],"participants":[{"person":"wgc-p0051","role":"愍烈独坐、启会","evidence":["wgc-q0497","wgc-q0081"]},{"person":"shaodi-p0073","role":"准亲兵出取饮食","evidence":["wgc-q0497","wgc-q0081"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0497","wgc-q0081"]},"ordering_evidence":"wgc-q0497"}],"persons":[{"id":"shaodi-p0073","name":"钟会","facts":[],"aliases":[]},{"id":"wgc-p0051","name":"丘建","facts":[],"aliases":[]}],"evidence":[{"id":"wgc-q0081","section":"chapter-028","block":"b-a7b757d1ec374b56c0b4","layer":"original","quote":"会帐下督丘建本属胡烈〖14〗，烈荐之文王；会请以自随，任爱之〖15〗。建愍烈独坐，启会：使听纳一亲兵出取饮食〖16〗，诸牙门随例各纳一人。烈绐语亲兵及疏与其子曰〖17〗：“丘建密说消息：会已作大坑，白棓﹝二﹞数千〖18〗；欲悉呼外兵入，人赐白-，﹝三﹞拜为散将〖19〗，以次棓杀坑中。”诸牙门亲兵亦咸说此语，一夜传相告，皆遍。或谓会：“可尽杀牙门、骑督以上！”会犹豫未决。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":561,"anchor":null},"note_id":null,"start":0,"end":186},{"id":"wgc-q0497","section":"chapter-028","block":"b-a7b757d1ec374b56c0b4","layer":"original","quote":"会帐下督丘建本属胡烈〖14〗，烈荐之文王；会请以自随，任爱之〖15〗。建愍烈独坐，启会：使听纳一亲兵出取饮食〖16〗，诸牙门随例各纳一人","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":561,"anchor":null},"note_id":null,"start":0,"end":68}],"profiles":{},"directory_counts":{}}
