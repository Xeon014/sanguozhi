{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"liuliao-e-o077","title":"习凿齿论亮能用刑","accounts":[{"id":"liuliao-a-5b5d836877c03f68bc4d","label":"裴注·习凿齿","text":"习凿齿论亮能用刑","evidence":["liuliao-q-c0bf4cf6fcf4c63a673a"]}],"participants":[{"person":"gongsuntao-p0004","role":"论诸葛亮能用刑","evidence":["liuliao-q-c0bf4cf6fcf4c63a673a"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liuliao-q-c0bf4cf6fcf4c63a673a"]},"ordering_evidence":"liuliao-q-c0bf4cf6fcf4c63a673a","source_order":[40,236,0],"order":7295}],"persons":[{"id":"gongsuntao-p0004","name":"习凿齿","facts":[],"aliases":[]}],"evidence":[{"id":"liuliao-q-c0bf4cf6fcf4c63a673a","section":"chapter-040","block":"b-eea8178a96ccf332824e","layer":"pei","quote":"﹝四﹞习凿齿曰：“昔管仲夺伯氏骈邑三百，没齿而无怨言，圣人以为难；诸葛亮之使廖立垂泣，李平致死：岂徒无怨言而已哉！夫水至平而邪者取法，镜至明而丑者（亡）〔忘〕怒；水镜之所以能穷物而无怨者，以其无私也。水镜无私，犹以免谤；况大人君子怀乐生之心，流矜恕之德；法行于不可不用，刑加乎自犯之罪；爵之而非私，诛之而不怒：天下有不服者乎？诸葛亮于是可谓能用刑矣。自秦、汉以来，未之有也！”","attribution":"裴注·习凿齿","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":235,"anchor":null},"note_id":"n-663ac9785137c14de303","start":0,"end":188}],"profiles":{},"directory_counts":{}}
