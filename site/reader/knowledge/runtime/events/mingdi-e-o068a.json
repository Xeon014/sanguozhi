{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"mingdi-e-o068a","title":"司马懿还河内被召曹叡托以后事","accounts":[{"id":"mingdi-e-o068a-account","label":"《明帝纪》正文","text":"司马懿还河内被召曹叡托以后事","evidence":["mingdi-e-o068a-q"]},{"id":"mingdi-a-p059-weilue","label":"裴注·魏略","text":"《魏略》载明帝示齐秦二王，指齐王让司马懿辨认并教其抱颈。","evidence":["mingdi-q-p059-weilue"]},{"id":"mingdi-a-p059-weichunqiu","label":"裴注·魏氏春秋","text":"《魏氏春秋》载太子八岁、秦王九岁，明帝忍死待司马懿，托与曹爽共辅。","evidence":["mingdi-q-p059-weichunqiu"]}],"participants":[{"person":"wendi-p0005","role":"托孤","evidence":["mingdi-e-o068a-q"]},{"person":"wudi-p0364","role":"受托","evidence":["mingdi-e-o068a-q"]}],"place":null,"time":{"year":239,"label":"春正月丁亥","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"mingdi-y239","dating_review":{"reviewed":true,"anchor":"mingdi-q-o068","basis":"春正月丁亥"},"evidence":["mingdi-e-o068a-q","mingdi-q-o068","mingdi-q-b-e59395a0e3cfa7e31144"]},"ordering_evidence":"mingdi-e-o068a-q","source_order":[3,492,"O068a"],"order":971}],"persons":[{"id":"wendi-p0005","name":"曹叡","facts":[],"aliases":[]},{"id":"wudi-p0364","name":"司马懿","facts":[],"aliases":[]}],"evidence":[{"id":"mingdi-e-o068a-q","section":"chapter-003","block":"b-15faf626ce48eb2f68b4","layer":"original","quote":"三年春正月，丁亥〖4〗，太尉宣王还至河内；帝驿马召到〖5〗，引入卧内，执其手谓曰：“吾疾甚！以后事属君。君其与爽辅少子〖6〗。吾得见君，无所恨！”宣王顿首流涕〖7〗。﹝一﹞即日，帝崩于嘉福殿。﹝二﹞时年三十六〖8〗。﹝三﹞癸丑〖9〗，葬高平陵〖10〗。﹝四﹞","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":491,"anchor":null},"note_id":null,"start":0,"end":129},{"id":"mingdi-q-b-e59395a0e3cfa7e31144","section":"chapter-003","block":"b-e59395a0e3cfa7e31144","layer":"modern","quote":"〖4〗三年：景初三年（公元 239）。丁亥：旧历初一日。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":496,"anchor":null},"note_id":"n-271e1436daf6e49feb83","start":0,"end":28},{"id":"mingdi-q-o068","section":"chapter-003","block":"b-15faf626ce48eb2f68b4","layer":"original","quote":"三年春正月，丁亥〖4〗，太尉宣王还至河内；帝驿马召到〖5〗，引入卧内，执其手谓曰：“吾疾甚！以后事属君。君其与爽辅少子〖6〗。吾得见君，无所恨！”宣王顿首流涕〖7〗。﹝一﹞即日，帝崩于嘉福殿。﹝二﹞时年三十六〖8〗。﹝三﹞癸丑〖9〗，葬高平陵〖10〗。﹝四﹞","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":491,"anchor":null},"note_id":null,"start":0,"end":129},{"id":"mingdi-q-p059-weichunqiu","section":"chapter-003","block":"b-01f308ceee7bbcec7d92","layer":"pei","quote":"《魏氏春秋》曰：“时太子芳年八岁，秦王九岁，在于御侧。帝执宣王手，目太子曰：‘死乃复可忍，朕忍死待君。君其与爽辅此。’宣王曰：‘陛下不见先帝属臣以陛下乎？","attribution":"裴注·魏氏春秋","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":504,"anchor":null},"note_id":"n-3c7ed950a28610e3bcab","start":178,"end":255},{"id":"mingdi-q-p059-weilue","section":"chapter-003","block":"b-01f308ceee7bbcec7d92","layer":"pei","quote":"劳问讫，乃召齐、秦二王以示宣王。别指齐王谓宣王曰：‘此是也！君谛视之，勿误也！’又教齐王令前抱宣王颈。","attribution":"裴注·魏略","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":504,"anchor":null},"note_id":"n-3c7ed950a28610e3bcab","start":126,"end":177}],"profiles":{},"directory_counts":{}}
