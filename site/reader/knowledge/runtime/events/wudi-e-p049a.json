{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p049a","title":"曹操临淯水祭阵亡将士","accounts":[{"id":"wudi-e-p049a-account","label":"《魏书》","text":"曹操在淯水祭亡将士，流泪致众人感恸。","evidence":["wudi-e-p049a-q"]}],"participants":[{"person":"cao-cao","role":"祭悼","evidence":["wudi-e-p049a-q"]}],"place":{"text":"淯水","evidence":["wudi-e-p049a-q"]},"time":{"label":"建安二年冬十一月南征时","year":197,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-p049a-q","wudi-q-o050","wudi-q-b-40d8b7057f4a29d6fe0d"],"chronology":"wudi-y197","dating_review":{"anchor":"wudi-q-o050","basis":"建安二年冬十一月南征时","reviewed":true}},"source_order":[1,323,"P049a"],"order":142}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-p049a-q","section":"chapter-001","block":"b-8f71f6ca792c5bc58491","layer":"pei","quote":"﹝三﹞《魏书》曰：“临淯水，祠亡将士。歔欷流涕，众皆感恸。”","attribution":"《魏书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":322,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c0909dbe16ece0730cc4","start":0,"end":30,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-40d8b7057f4a29d6fe0d","section":"chapter-001","block":"b-40d8b7057f4a29d6fe0d","layer":"modern","quote":"〖3〗二年：建安二年（公元 197）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":305,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-de6807349faf5c41a470","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o050","section":"chapter-001","block":"b-c2d0fc350fb933237a70","layer":"original","quote":"二年春正月〖3〗，公到宛〖4〗。张绣降，既而悔之，复反。公与战，军败，为流矢所中。长子昂、弟子安民遇害〖5〗。﹝一﹞公乃引兵还舞阴〖6〗，绣将骑来抄〖7〗。公击破之，绣奔穰〖8〗，与刘表合。公谓诸将曰：“吾降张绣等，失不便取其质〖9〗，以至于此。吾知所以败。诸卿观之：自今以后，不复败矣！”遂还许。﹝二﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_s