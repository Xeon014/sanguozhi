{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"rencheng-e-b749ab37e4457c04e178","title":"曹植琴瑟调歌全文以转蓬自喻","accounts":[{"id":"rencheng-a-b749ab37e4457c04e178","label":"裴注（引书待核）","text":"曹植琴瑟调歌全文以转蓬自喻","evidence":["rencheng-q-82ab598d52a4ea21122f"]}],"participants":[{"person":"wudi-p0280","role":"作者","evidence":["rencheng-q-82ab598d52a4ea21122f"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["rencheng-q-82ab598d52a4ea21122f"]},"ordering_evidence":"rencheng-q-82ab598d52a4ea21122f","order":3818}],"persons":[{"id":"wudi-p0280","name":"曹植","facts":[],"aliases":[]}],"evidence":[{"id":"rencheng-q-82ab598d52a4ea21122f","section":"chapter-019","block":"b-29737cfdd08523bece8d","layer":"pei","quote":"﹝一﹞植尝为琴瑟调歌，辞曰：“吁嗟此转蓬，居世何独然！长去本根逝，夙夜无休闲。东西经七陌，南北越九阡；猝遇回风起，吹我入云间。自谓终天路，忽焉下沉渊；惊飚接我出，故归彼中田。当南而更北，谓东而反西。宕宕当何依？忽亡而复存。飘飘周八泽，连翩历五山；流转无恒处，谁知吾苦艰？愿为中林草，秋随野火燔；糜灭岂不痛？愿与根荄连！”","attribution":"裴注（引书待核）","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":459,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c04763ce3aa8e45f11a0","start":0,"end":160,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
