{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"hequan-e-p017","title":"徐众评鲂自占诱敌非君子所美","accounts":[{"id":"hequan-a-d346d9c6dd1459e96a33","label":"裴注·徐众《评》","text":"徐众评鲂自占诱敌非君子所美","evidence":["hequan-q-999bf1fe58af115f42e6"]}],"participants":[{"person":"hequan-p0028","role":"评人臣立功效节各有分、鲂为郡守职在治民、非君所命自占诱敌、髡剔发肤以徇功名、虽事济受爵非君子所美","evidence":["hequan-q-999bf1fe58af115f42e6"]},{"person":"wuzhu-p0058","role":"被评者","evidence":["hequan-q-999bf1fe58af115f42e6"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["hequan-q-999bf1fe58af115f42e6"]},"ordering_evidence":"hequan-q-999bf1fe58af115f42e6","source_order":[60,372,11],"order":10659}],"persons":[{"id":"hequan-p0028","name":"徐众","facts":[],"aliases":[]},{"id":"wuzhu-p0058","name":"周鲂","facts":[],"aliases":[]}],"evidence":[{"id":"hequan-q-999bf1fe58af115f42e6","section":"chapter-060","block":"b-0538a4805373e0472185","layer":"pei","quote":"夫人臣立功效节，虽非一途，然各有分也。为将执桴鼓，则有必死之义；志守，则有不假器之义：死必得所，义在不苟。鲂为郡守，职在治民。非君所命，自占诱敌；髡剔发肤，以徇功名。虽事济受爵，非君子所美","attribution":"裴注·徐众《评》","section_title":"贺全吕周钟离传第十五","source":{"file":"OEBPS/Text/titlepage_0127.xhtml","index":371,"anchor":null},"note_id":"n-8e16211cb7d5b29c13ea","start":11,"end":105}],"profiles":{},"directory_counts":{}}
