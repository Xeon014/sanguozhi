{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p015a","title":"曹操托疾归乡读书弋猎","accounts":[{"id":"wudi-e-p015a-account","label":"《魏书》","text":"《魏书》记曹操因屡犯权贵，求留宿卫任议郎，又常托病归乡，读书弋猎自娱。","evidence":["wudi-e-p015a-q"]}],"participants":[{"person":"cao-cao","role":"归乡自处","evidence":["wudi-e-p015a-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p015a-q"]},"source_order":[1,57,"P015a"],"order":32}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-p015a-q","section":"chapter-001","block":"b-c9c0e58a3600a47a4c2e","layer":"pei","quote":"于是权臣专朝，贵戚横恣。太祖不能违道取容，数数干忤。恐为家祸，遂乞留宿卫，拜议郎。常托疾病，辄告归乡里：筑室城外，春夏习读书传，秋冬弋猎，以自娱乐。","attribution":"《魏书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":56,"anchor":null},"note_id":"n-a8c68d76c6cd451bbca8","start":10,"end":84}],"profiles":{},"directory_counts":{}}
