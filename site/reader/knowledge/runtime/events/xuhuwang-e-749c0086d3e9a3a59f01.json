{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xuhuwang-e-749c0086d3e9a3a59f01","title":"王基召秘书郎王凌复留王朗辟劾亦不遣","accounts":[{"id":"xuhuwang-a-749c0086d3e9a3a59f01","label":"正文","text":"王基召秘书郎王凌复留王朗辟劾亦不遣","evidence":["xuhuwang-q-2ae9fd03e5a505855c55"]}],"participants":[{"person":"shaodi-p0034","role":"受召被留","evidence":["xuhuwang-q-2ae9fd03e5a505855c55"]},{"person":"shaodi-p0004","role":"留基","evidence":["xuhuwang-q-2ae9fd03e5a505855c55"]},{"person":"wudi-p0309","role":"辟基劾州","evidence":["xuhuwang-q-2ae9fd03e5a505855c55"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["xuhuwang-q-2ae9fd03e5a505855c55"]},"ordering_evidence":"xuhuwang-q-2ae9fd03e5a505855c55","order":5375}],"persons":[{"id":"shaodi-p0004","name":"王凌","facts":[],"aliases":[]},{"id":"shaodi-p0034","name":"王基","facts":[],"aliases":[]},{"id":"wudi-p0309","name":"王朗","facts":[],"aliases":[]}],"evidence":[{"id":"xuhuwang-q-2ae9fd03e5a505855c55","section":"chapter-027","block":"b-787db8136f0d41caedcc","layer":"original","quote":"后召为秘书郎〖2〗，凌复请还。顷之，司徒王朗辟基，凌不遣。朗书劾州曰〖3〗：“凡家臣之良〖4〗，则升于公辅〖5〗；公臣之良，则入于王职〖6〗。是故古者侯伯有贡士之礼。今州取宿卫之臣〖7〗，留秘阁之吏〖8〗：所希闻也〖9〗。”凌犹不遣。","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":255,"anchor":null},"note_id":null,"start":31,"end":148}],"profiles":{},"directory_counts":{}}
