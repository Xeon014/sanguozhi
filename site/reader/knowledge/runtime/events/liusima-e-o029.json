{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"liusima-e-o029","title":"李邵欲自野王徙居温，司马朗劝止，邵不从","accounts":[{"id":"liusima-a-7a6681e2304bf74f217b","label":"正文","text":"李邵欲自野王徙居温，司马朗劝止，邵不从","evidence":["liusima-q-cc437f7b23f80c7e143a"]},{"id":"liusima-a-c03e32e9339e0e0dae7f","label":"正文","text":"边山之民果乱，内徙，或为寇抄","evidence":["liusima-q-67bc7b43e48842cca6cd"]}],"participants":[{"person":"liusima-p0038","role":"欲徙者","evidence":["liusima-q-cc437f7b23f80c7e143a"]},{"person":"xunyu-p0024","role":"劝止者","evidence":["liusima-q-cc437f7b23f80c7e143a"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liusima-q-cc437f7b23f80c7e143a","liusima-q-67bc7b43e48842cca6cd"]},"ordering_evidence":"liusima-q-cc437f7b23f80c7e143a","source_order":[15,46,6],"order":3249}],"persons":[{"id":"liusima-p0038","name":"李邵（故冀州刺史）","facts":[],"aliases":[]},{"id":"xunyu-p0024","name":"司马朗","facts":[],"aliases":[]}],"evidence":[{"id":"liusima-q-67bc7b43e48842cca6cd","section":"chapter-015","block":"b-7967f52e91e783420954","layer":"original","quote":"边山之民果乱，内徙，或为寇抄","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":45,"anchor":null},"note_id":null,"start":125,"end":139},{"id":"liusima-q-cc437f7b23f80c7e143a","section":"chapter-015","block":"b-7967f52e91e783420954","layer":"original","quote":"故冀州刺史李邵，家居野王，近山险，欲徙居温。朗谓邵曰：“唇齿之喻，岂唯虞、虢〖5〗？温与野王即是也。今去彼而居此，是为避朝亡之期耳〖6〗。且君，国人之望也。今寇未至而先徙，带山之县必骇。是摇动民之心而开奸宄之原也！窃为郡内忧之。”邵不从","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":45,"anchor":null},"note_id":null,"start":6,"end":124}],"profiles":{},"directory_counts":{}}
