17.xhtml","index":2,"anchor":null},"note_id":null,"start":164,"end":201},{"id":"chenghuang-q-a1970ba8acfd65577e93","section":"chapter-055","block":"b-ac3d85213e7994859abe","layer":"original","quote":"从征刘勋，破黄祖；还讨鄱阳，领乐安长，山越畏服","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":54,"anchor":null},"note_id":null,"start":30,"end":53},{"id":"wudi-q-b-51bced16741add42ff70","section":"chapter-001","block":"b-51bced16741add42ff70","layer":"modern","quote":"〖1〗四年：建安四年（公元 199）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":369,"anchor":null},"note_id":"n-20628d34a709162c77f0","start":0,"end":19},{"id":"wudi-q-o061","section":"chapter-001","block":"b-502d4e8c0ed143eaa30d","layer":"original","quote":"四年春二月〖1〗，公还至昌邑〖2〗。张杨将杨丑杀杨〖3〗。眭固又杀丑，以其众属袁绍，屯射犬〖4〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":358,"anchor":null},"note_id":null,"start":0,"end":49},{"id":"wuzhu-e-o003a-q","section":"chapter-047","block":"b-9dfc26d83bc6f0a49854","layer":"original","quote":"建安四年，从策征庐江太守刘勋。勋破，进讨黄祖于沙羡〖1〗。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":15,"anchor":null},"note_id":null,"start":0,"end":29},{"id":"wuzhu-q-o003","section":"chapter-047","block":"b-9dfc26d83bc6f0a49854","layer":"original","quote":"建安四年，从策征庐江太守刘勋。勋破，进讨黄祖于沙羡〖1〗。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":15,"anchor":null},"note_id":null,"start":0,"end":29},{"id":"xianzhu-q-o014","section":"chapter-032","block":"b-9236c229b2cd9315f1e3","layer":"original","quote":"袁术欲经徐州北就袁绍，曹公遣先主督朱灵、路招要击术〖4〗。未至，术病死。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":60,"anchor":null},"note_id":null,"start":0,"end":36}],"profiles":{},"directory_counts":{}}
