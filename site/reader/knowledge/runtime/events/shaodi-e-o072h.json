{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"shaodi-e-o072h","title":"司马昭任大将军录尚书事","accounts":[{"id":"shaodi-e-o072h-account","label":"《三少帝纪》正文","text":"司马昭任大将军录尚书事","evidence":["shaodi-e-o072h-q"]},{"id":"wgc-a-5-e21","label":"正文","text":"朝廷拜司马昭为大将军辅政","evidence":["wgc-q0429","wgc-q0428"]}],"participants":[{"person":"shaodi-p0045","role":"受任","evidence":["shaodi-e-o072h-q"]}],"place":null,"time":{"year":255,"label":"二月丁巳","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"shaodi-y255","dating_review":{"reviewed":true,"anchor":"shaodi-q-o072","basis":"二月丁巳"},"evidence":["shaodi-e-o072h-q","shaodi-q-o072","shaodi-q-b-2de9ea37d1e15a7d296f"]},"ordering_evidence":"shaodi-e-o072h-q","source_order":[4,333,"O072h"],"order":1146}],"persons":[{"id":"shaodi-p0045","name":"司马昭","facts":[],"aliases":[]}],"evidence":[{"id":"shaodi-e-o072h-q","section":"chapter-004","block":"b-4b9070779d1c209c6814","layer":"original","quote":"二年春正月，乙丑〖6〗，镇东将军毌丘俭、扬州刺史文钦反。（戊戌）〔戊寅〕〖7〗，大将军司马景王征之。癸未〖8〗，车骑将军郭淮薨。闰月，己亥〖9〗，破钦于乐嘉〖10〗；钦遁走，遂奔吴。甲辰〖11〗，安风淮津都尉斩俭〖12〗，传首京都。﹝一﹞壬子〖13〗，复特赦淮南士民诸为俭、钦所诖误者〖14〗。以镇南将军诸葛诞为镇东大将军〖15〗。司马景王薨于许昌。二月，丁巳〖16〗，以卫将军司马文王为大将军〖17〗，录尚书事。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":332,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":207,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-b-2de9ea37d1e15a7d296f","section":"chapter-004","block":"b-2de9ea37d1e15a7d296f","layer":"modern","quote":"〖6〗二年：正元二年（公元 255）。乙丑：旧历十二日。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":346,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-96103ace1e11ae4131ba","start":0,"end":28,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o072","section":"chapter-004","block":"b-4b9070779d1c2