bb1919765cd60","label":"正文","text":"时然城中兵多肿病，堪战者才五千人；真等起土山、凿地道、立楼橹临城，弓矢雨注；将士皆失色，然晏如而无恐意，方厉吏士，伺间隙攻破两屯","evidence":["zhulv-q-8fa9dae900f463f37d31"]},{"id":"zhulv-a-a6c03a8770583a76ac82","label":"正文","text":"魏攻围然凡六月日，未退","evidence":["zhulv-q-4fc2f37c4cb50ba06acc"]}],"participants":[{"person":"mingdi-p0063","role":"夜袭","evidence":["xiahoucao-e-o076a-q"]},{"person":"wendi-p0038","role":"围攻","evidence":["xiahoucao-e-o076a-q"]},{"person":"mingdi-p0002","role":"渡江被破","evidence":["xiahoucao-e-o076a-q"]},{"person":"mingdi-p0038","role":"破吴于江陵有功、更拜伏波将军屯新野","evidence":["mantian-q-0a7cc6b0c47532f03bd5"]},{"person":"wudi-p0250","role":"围江陵别屯沔口御贼有功","evidence":["lizang-q-fa2bc07f8ef64376ac71"]},{"person":"wudi-p0183","role":"攻江陵者","evidence":["zhulv-q-41f5bbcdfd86a897766f"]},{"person":"wudi-p0170","role":"自住宛为势援者","evidence":["zhulv-q-41f5bbcdfd86a897766f"]},{"person":"mingdi-p0046","role":"晏如守城而破两屯者；被围者","evidence":["zhulv-q-8fa9dae900f463f37d31","zhulv-q-4fc2f37c4cb50ba06acc"]}],"place":null,"time":{"year":222,"label":"黄初三年","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xiahoucao-y222","dating_review":{"reviewed":true,"anchor":"xiahoucao-q-o051","basis":"黄初三年"},"evidence":["xiahoucao-e-o076a-q","xiahoucao-q-o051","luxun-q-o016","pangfa-q-o027","wuzhu-q-o054","guanzhang-q-o034","guanzhang-q-b-be58a15ce144f67b67a5"]},"ordering_evidence":"xiahoucao-e-o076a-q","source_order":[9,392,"O076a"],"order":2323}],"persons":[{"id":"mingdi-p0002","name":"诸葛瑾","facts":[],"aliases":[]},{"id":"mingdi-p0038","name":"满宠","facts":[],"aliases":[]},{"id":"mingdi-p0046","name":"朱然","facts":[],"aliases":[]},{"id":"mingdi-p0063","name":"夏侯尚","facts":[],"aliases":[]},{"id":"wendi-p0038","name":"曹真","facts":[],"aliases":[]},{"id":"wudi-p0170","name":"曹丕","facts":[],"aliases":[]},{"id":"wudi-p0183","name":"张郃","facts":[],"aliases":[]},{"id":"wudi-p0250","name":"文聘","facts":[],"aliases":[]}],"evidence":[{"id":"guanzhang-q-b-be58a15ce144f67b67a5","section":"chapter-036","block":"b-be58a15ce144f67b67a5","layer":"modern","quote":"〖13〗二年：章武二年（公元 222）。马超的祠墓遗址，相传在今四川成都市新都区城南的马超小学内，曾有墓碑出土。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":158,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1fcace810489e51a4218","start":0,"end":56,"offset_unit":"unicode_code_point"},{"id":"guanzhang-q-o034","section":"chapter-036","block":"b-7ddd1fa08ce5c9feb1d4","layer":"original","quote":"二年卒〖13〗，时年四十七。临没上疏曰：“臣门宗二百余口〖14〗，为孟德所诛略尽〖15〗；惟有从弟岱，当为微宗血食之继〖16〗，深托陛下。余无复言。”","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":143,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":75,"offset_unit":"unicode_code_point"},{"id":"lizang-q-fa2bc07f8ef64376ac71","section":"chapter-018","block":"b-3616192fc3097de9e23c","layer":"original","quote":"与夏侯尚围江陵，使聘别屯沔口〖9〗，止石梵〖10〗；自当一队，御贼有功","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":90,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":15,"end":50,"offset_unit":"unicode_code_point"},{"id":"luxun-q-o016","section":"chapter-058","block":"b-91a1c767b310bb1e937f","layer":"original","quote":"黄武元年，刘备率大众来向西界。权命逊为大都督，假节，督朱然、潘璋、宋谦、韩当、徐盛、鲜于丹、孙桓等五万人拒之〖5〗。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":85,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":58,"offset_unit":"unicode_code_point"},{"id":"mantian-q-0a7cc6b0c47532f03bd5","section":"chapter-026","block":"b-a7ad6a975022165aee8e","layer":"original","quote":"破吴于江陵有功〖2〗，更拜伏波将军，屯新野〖3〗。","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":37,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":15,"end":40,"offset_unit":"unicode_code_point"},{"id":"pangfa-q-o027","section":"chapter-037","block":"b-6b23f8730a9cef243526","layer":"original","quote":"诸葛亮与正，虽好尚不同〖31〗，以公义相取〖32〗；亮每奇正智术。先主既即尊号，将东征孙权以复关羽之耻，群臣多谏，一不从。章武二年，大军败绩，还住白帝。亮叹曰：“法孝直若在，则能制主上，令不东行；就复东行，必不倾危矣！”﹝四﹞","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":152,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":113,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o054","section":"chapter-047","block":"b-7e0fdf82962252602cbd","layer":"original","quote":"黄武元年春正月〖1〗，陆逊部将军宋谦等〖2〗，攻蜀五屯；皆破之，斩其将。三月，鄱阳言黄龙现〖3〗。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":293,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":49,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-e-o076a-q","section":"chapter-009","block":"b-9bfe77ade6e9f77acfac","layer":"original","quote":"黄初三年，车驾幸宛，使尚率诸军，与曹真共围江陵。权将诸葛瑾与尚军对江。瑾渡，入江中渚，而分水军于江中。尚夜多持油船，将步骑万余人，于下流潜渡，攻瑾诸军。夹江烧其舟船，水陆并攻。破之，","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":391,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":91,"offset_unit":"unicode_code_point"},{"id":"xiahoucao-q-o051","section":"chapter-009","block":"b-6486329ff9f86141fcad","layer":"original","quote":"黄初三年，还京都。以真为上军大将军，都督中外诸军事〖7〗，假节、钺。与夏侯尚等征孙权，击牛渚屯〖8〗，破之。转拜中军大将军，加给事中〖9〗。七年〖10〗，文帝寝疾，真与陈群、司马宣王等，受遗诏辅政〖11〗。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":220,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":103,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-41f5bbcdfd86a897766f","section":"chapter-056","block":"b-23a74b6605060ffd45f3","layer":"original","quote":"魏遣曹真、夏侯尚、张郃等，攻江陵；魏文帝自住宛，为其势援，连屯围城","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":66,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":33,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-4fc2f37c4cb50ba06acc","section":"chapter-056","block":"b-6aeea7197e36b0f42123","layer":"original","quote":"魏攻围然凡六月日〖5〗，未退","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":67,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":147,"end":161,"offset_unit":"unicode_code_point"},{"id":"zhulv-q-8fa9dae900f463f37d31","section":"chapter-056","block":"b-6aeea7197e36b0f42123","layer":"original","quote":"时然城中兵多肿病〖2〗，堪战者才五千人。真等起土山，凿地道，立楼橹临城〖3〗，弓矢雨注。将士皆失色，然晏如而无恐意〖4〗；方厉吏士，伺间隙攻破两屯","section_title":"朱治朱然吕范朱桓传第十一","source":{"file":"OEBPS/Text/titlepage_0119.xhtml","index":67,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":73,"end":146,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
