{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o034a","title":"饥荒中罢新募吏兵","accounts":[{"id":"wudi-e-o034a-account","label":"正文","text":"当年粮价极高且出现人相食，曹操罢遣新募吏兵。","evidence":["wudi-e-o034a-q"]}],"participants":[{"person":"cao-cao","role":"罢遣吏兵","evidence":["wudi-e-o034a-q"]}],"place":null,"time":{"label":"兴平元年","year":194,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o034a-q","wudi-q-o028","wudi-q-b-927979d68d5dacfd36fe"],"chronology":"wudi-y194","dating_review":{"anchor":"wudi-q-o028","basis":"兴平元年","reviewed":true}},"source_order":[1,235,"O034a"],"order":106}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-o034a-q","section":"chapter-001","block":"b-7e852afeccc6f4ba0787","layer":"original","quote":"是岁，谷一斛五十余万钱〖4〗，人相食。乃罢吏兵新募者。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":234,"anchor":null},"note_id":null,"start":0,"end":27},{"id":"wudi-q-b-927979d68d5dacfd36fe","section":"chapter-001","block":"b-927979d68d5dacfd36fe","layer":"modern","quote":"〖1〗二年：兴平二年（公元 195）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":246,"anchor":null},"note_id":"n-8c38464987eb86819ded","start":0,"end":19},{"id":"wudi-q-o028","section":"chapter-001","block":"b-fefe0240b8480efce927","layer":"original","quote":"兴平元年春，太祖自徐州还〖1〗。初，太祖父嵩，去官后还谯。董卓之乱，避难琅邪〖2〗。为陶谦所害，故太祖志在复仇东伐。﹝一﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":204,"anchor":null},"note_id":null,"start":0,"end":61}],"profiles":{},"directory_counts":{}}
