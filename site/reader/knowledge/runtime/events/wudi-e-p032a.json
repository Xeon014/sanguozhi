{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p032a","title":"曹操向袁绍陈说不宜另立天子","accounts":[{"id":"wudi-e-p032a-account","label":"《魏书》","text":"《魏书》载曹操认为举兵本为讨董，幼主无失国之过，不应另立。","evidence":["wudi-e-p032a-q"]}],"participants":[{"person":"cao-cao","role":"答复反对","evidence":["wudi-e-p032a-q"]},{"person":"wudi-p0052","role":"受答","evidence":["wudi-e-p032a-q"]}],"place":null,"time":{"label":"议立刘虞时","year":190,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-p032a-q","wudi-q-o009","wudi-q-b-4a17eb75600ced2abdde"],"chronology":"wudi-y190","dating_review":{"anchor":"wudi-q-o009","basis":"议立刘虞时","reviewed":true}},"source_order":[1,138,"P032a"],"order":67}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0052","name":"袁绍","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-p032a-q","section":"chapter-001","block":"b-a21b0c40f8e337a0888b","layer":"pei","quote":"﹝二﹞《魏书》载太祖答绍曰：“董卓之罪，暴于四海；吾等合大众、兴义兵而远近莫不响应，此以义动故也。今幼主微弱，制于奸臣，未有昌邑亡国之衅；而一旦改易，天下其孰安之？诸君北面，我自西向！”","attribution":"《魏书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":137,"anchor":null},"note_id":"n-cc0352e8563df399e477","start":0,"end":93},{"id":"wudi-q-b-4a17eb75600ced2abdde","section":"chapter-001","block":"b-4a17eb75600ced2abdde","layer":"modern","quote":"〖1〗初平元年：公元 190 年。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":86,"anchor":null},"note_id":"n-93d66253e23c705b336d","start":0,"end":17},{"id":"wudi-q-o009","section":"chapter-001","block":"b-20c7e941eb42ee97df8c","layer":"original","quote":"初平元年春正月〖1〗，后将军袁术、冀州牧韩馥、﹝一﹞豫州刺史孔伷、﹝二﹞兖州刺史刘岱、﹝三﹞河内太守王匡、﹝四﹞勃海太守袁绍、陈留太守张邈、东郡太守桥瑁、﹝五﹞山阳太守袁遗、﹝六﹞济北相鲍信，﹝七﹞同时俱起兵〖2〗。众各数万，推绍为盟主。太祖行奋武将军〖3〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":84,"anchor":null},"note_id":null,"start":0,"end":130}],"profiles":{},"directory_counts":