{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"guanzhang-e-p027a","title":"刘禅诏议赵云谥姜维等议顺平","accounts":[{"id":"guanzhang-e-p027a-account","label":"《云别传》载后主诏及姜维等议","text":"刘禅诏议赵云谥姜维等议顺平","evidence":["guanzhang-e-p027a-q"]}],"participants":[{"person":"xianzhu-p0112","role":"诏议","evidence":["guanzhang-e-p027a-q"]},{"person":"shaodi-p0050","role":"议谥","evidence":["guanzhang-e-p027a-q"]}],"place":null,"time":{"label":"赵云追谥时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["guanzhang-e-p027a-q"]},"ordering_evidence":"guanzhang-e-p027a-q","source_order":[36,215,"P027a"],"order":6949}],"persons":[{"id":"shaodi-p0050","name":"姜维","facts":[],"aliases":[]},{"id":"xianzhu-p0112","name":"刘禅","facts":[],"aliases":[]}],"evidence":[{"id":"guanzhang-e-p027a-q","section":"chapter-036","block":"b-25952ddb0b7aa3dad8f8","layer":"pei","quote":"﹝二﹞《云别传》载：“后主诏曰：‘云昔从先帝，功绩既著；朕以幼冲，涉途艰难；赖恃忠顺，济于危险。夫谥所以叙元勋也，外议云宜谥。’大将军姜维等议，以为：‘云昔从先帝，劳绩既著；经营天下，遵奉法度，功效可书。当阳之役，义贯金石。忠以卫上，君念其赏；礼以厚下，臣忘其死。死者有知，足以不朽；生者感恩，足以殒身。谨按《谥法》：柔贤慈惠曰顺；执事有班曰平，克定祸乱曰平：应谥云曰顺平侯。’”","attribution":"《云别传》载后主诏及姜维等议","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":214,"anchor":null},"note_id":"n-e497232cbcdc8322888f","start":0,"end":190}],"profiles":{},"directory_counts":{}}
