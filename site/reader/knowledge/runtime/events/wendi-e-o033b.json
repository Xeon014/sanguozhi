{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wendi-e-o033b","title":"黄权率众降魏","accounts":[{"id":"wendi-e-o033b-account","label":"《文帝纪》正文","text":"黄权率众降魏","evidence":["wendi-e-o033b-q"]},{"id":"wendi-a-p083-weishu","label":"裴注·魏书","text":"魏书载黄权与南郡太守史郃等归降，曹丕以礼接见。","evidence":["wendi-q-p083-weishu"]},{"id":"huangli-a-2d9b0722b2970c718c8c","label":"正文","text":"黄权道隔绝降魏","evidence":["huangli-q-ec9b6dfe068218ab6b09"]}],"participants":[{"person":"xianzhu-p0062","role":"归降","evidence":["wendi-e-o033b-q"]}],"place":null,"time":{"year":222,"label":"黄初三年八月","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"wendi-y222","dating_review":{"reviewed":true,"anchor":"wendi-q-o028","basis":"黄初三年八月"},"evidence":["wendi-e-o033b-q","wendi-q-o028","wendi-q-b-ffbd612d6e6a445d21d8"]},"ordering_evidence":"wendi-e-o033b-q","source_order":[2,321,"O033b"],"related_events":[{"event":"xianzhu-e-o069b","type":"related","evidence":["wendi-e-o033b-q","xianzhu-e-o069b-q"]}],"order":611},{"id":"xianzhu-e-o069b","title":"陆议猇亭破刘备冯习张南战死","accounts":[{"id":"xianzhu-e-o069b-account","label":"《先主传》正文","text":"黄气记载后十余日，陆议大破刘备军，冯习、张南等战死。","evidence":["xianzhu-e-o069b-q"]},{"id":"wendi-e-o032a-account","label":"《文帝纪》正文","text":"黄初三年闰月，孙权于夷陵破刘备。","evidence":["wendi-e-o032a-q"]},{"id":"wuzhu-e-o055a-account","label":"《吴主传第二》正文","text":"陆逊破蜀诸营刘备败走","evidence":["wuzhu-e-o055a-q"]},{"id":"luxun-e-o021b-account","label":"《陆逊传第十三》正文","text":"陆议命持茅火攻诸军破营斩将受降","evidence":["luxun-e-o021b-q"]},{"id":"chenghuang-a-3031b7ed32ab7604e611","label":"正文","text":"夷陵璋与陆逊拒备部下斩冯习","evidence":["chenghuang-q-b5bf74db1c826dfa961a"]},{"id":"dongliu-a-c7afeeb23b4de680799c","label":"正文","text":"刘备败绩于夷陵","evidence":["dongliu-q-c0644cd45cb4f702516d"]},{"id":"dongliu-a-5e4b1a516e24db16a68e","label":"正文","text":"马良遇害","evidence":["dongliu-q-25211585ffcc2365b464"]},{"id":"huangli-a-bb675fc02dbdab33c5e7","label":"正文","text":"陆逊乘流断围，刘备败退","evidence":["huangli-q-f120862d5699e9b578c9"]},{"id":"huangli-a-274eedfab07c354b719a","label":"正文","text":"刘备东征败于猇亭","evidence":["huangli-q-1cb5e0273ed0af39abc6"]},{"id":"huowang-a-7b5a3f002fd86423db09","label":"正文","text":"秭归之败向宠营完","evidence":["huowang-q-7c6eeec51538912b9b6d"]},{"id":"dengzhang-a-49e31ae28921909ce18a","label":"正文","text":"王甫遇害于秭归","evidence":["dengzhang-q-ef6e93679179b6c18260"]},{"id":"dengzhang-a-ff96514ff8de3ca340a4","label":"正文","text":"冯习领军败于猇亭","evidence":["dengzhang-q-44dded103d55f29ebfe9"]},{"id":"dengzhang-a-017f531a3d582ce651bd","label":"正文","text":"张南与冯习俱死于吴役","evidence":["dengzhang-q-7b18684e8ffd04292b00"]},{"id":"dengzhang-a-357d786f386b0d8f580d","label":"正文","text":"傅肜断后战死","evidence":["dengzhang-q-412416358d4db55f12ea"]},{"id":"dengzhang-a-a54b080ee54598e42846","label":"正文","text":"程畿执戟战死","evidence":["dengzhang-q-67e4f9b2b1bed056a47b"]},{"id":"zongshi-a-666bb9805219e2b2d9cb","label":"正文","text":"桓与陆逊共拒刘备，备军众甚盛，弥山盈谷；桓投刀奋命，与逊戮力，备遂败走","evidence":["zongshi-q-9d9cb181df7b17ae9deb"]},{"id":"zongshi-a-088c90499934bf7962b3","label":"正文","text":"桓斩上（兜）〔夔〕道，截其径要","evidence":["zongshi-q-fd7d20b4b4223a4457f7"]},{"id":"zongshi-a-b0aad961acd2d86ec13c","label":"正文","text":"备逾山越险，仅乃得免，忿恚叹曰：吾昔初至京城，桓尚小儿，而今迫孤，乃至此也","evidence":["zongshi-q-a9b2efcfa5afd7f77f4c"]},{"id":"zhulv-a-ebb9f68c4650560ea6e3","label":"正文","text":"黄武元年，刘备举兵攻宜都；然督五千人，与陆逊并力拒备","evidence":["zhulv-q-0f64e349b7617004ae8b"]},{"id":"zhulv-a-c2041007383fddf1326a","label":"正文","text":"然别攻破备前锋，断其后道，备遂破走","evidence":["zhulv-q-91f98b8cef7e20d317da"]}],"participants":[{"person":"xianzhu-p0115","role":"破军","evidence":["xianzhu-e-o069b-q"]},{"person":"liu-bei","role":"败军","evidence":["xianzhu-e-o069b-q"]},{"person":"xianzhu-p0119","role":"战死","evidence":["xianzhu-e-o069b-q"]},{"person":"xianzhu-p0122","role":"战死","evidence":["xianzhu-e-o069b-q"]},{"person":"sun-quan","role":"破敌","evidence":["wendi-e-o032a-q"]},{"person":"luxun-p0021","role":"战死","evidence":["luxun-e-o021b-q"]},{"person":"luxun-p0022","role":"投降","evidence":["luxun-e-o021b-q"]},{"person":"luxun-p0023","role":"投降","evidence":["luxun-e-o021b-q"]},{"person":"zhouyu-p0055","role":"与陆逊并力拒刘备，部下斩冯习等","evidence":["chenghuang-q-b5bf74db1c826dfa961a"]},{"person":"xianzhu-p0121","role":"夷陵之败中遇害","evidence":["dongliu-q-25211585ffcc2365b464"]},{"person":"zhuge-p0029","role":"秭归之败中其营垒独完好","evidence":["huowang-q-7c6eeec51538912b9b6d"]},{"person":"dengzhang-p0044","role":"随先主征吴，军败于秭归，遇害","evidence":["dengzhang-q-ef6e93679179b6c18260"]},{"person":"luxun-p0020","role":"先主退军时断后拒战，兵人死尽，骂吴将曰吴狗何有汉将军降者，遂战死","evidence":["dengzhang-q-412416358d4db55f12ea"]},{"person":"dengzhang-p0047","role":"拒解船轻去之劝，称未曾为敌走况从天子而见危，身执戟战，敌船有覆者，众大至共击之，乃死","evidence":["dengzhang-q-67e4f9b2b1bed056a47b"]},{"person":"luxun-p0016","role":"投刀奋命者；截道者；迫备者（背景）","evidence":["zongshi-q-9d9cb181df7b17ae9deb","zongshi-q-fd7d20b4b4223a4457f7","zongshi-q-a9b2efcfa5afd7f77f4c"]},{"person":"mingdi-p0046","role":"督众拒备者；破前锋断道者","evidence":["zhulv-q-0f64e349b7617004ae8b","zhulv-q-91f98b8cef7e20d317da"]}],"place":{"text":"猇亭","evidence":["xianzhu-e-o069b-q"]},"time":{"year":222,"label":"章武二年夏六月、黄气现后十余日","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xianzhu-y222","dating_review":{"reviewed":true,"anchor":"xianzhu-q-o068","basis":"章武二年夏六月、黄气现后十余日"},"evidence":["xianzhu-e-o069b-q","xianzhu-q-o068","xianzhu-q-b-e2b85eacbc16310809ee"]},"source_order":[32,403,"O069b"],"related_events":[{"event":"wendi-e-o033b","type":"related","evidence":["wendi-e-o033b-q","xianzhu-e-o069b-q"]}],"order":607}],"persons":[{"id":"xianzhu-p0062","name":"黄权","facts":[],"aliases":[]}],"evidence":[{"id":"huangli-q-ec9b6dfe068218ab6b09","section":"chapter-043","block":"b-0996c97d882e13e06732","layer":"original","quote":"而道隔绝，权不得还，故率将所领降于魏","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":13,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":24,"end":42,"offset_unit":"unicode_code_point"},{"id":"wendi-e-o033b-q","section":"chapter-002","block":"b-a5bf91c6f666aa87700c","layer":"original","quote":"八月，蜀大将黄权率众降〖2〗。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":320,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":29,"end":44,"offset_unit":"unicode_code_point"},{"id":"wendi-q-b-ffbd612d6e6a445d21d8","section":"chapter-002","block":"b-ffbd612d6e6a445d21d8","layer":"modern","quote":"〖1〗三年：黄初三年（公元 222 ）。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":287,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-2c01bc8dd8508fc686e1","start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"wendi-q-o028","section":"chapter-002","block":"b-9204f4c854f659a541df","layer":"original","quote":"三年春正月〖1〗，丙寅朔，日有食之。庚午〖2〗，行幸许昌宫。诏曰：“今之计、（考）〔孝〕〖3〗，古之贡士也。十室之邑，必有忠信。若限年然后取士〖4〗，是吕尚、周晋不显于前世也〖5〗。其令郡国所选，勿拘老幼；儒通经术，吏达文法〖6〗，到，皆试用。有司纠故不以实者〖7〗。”﹝一﹞","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":281,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":138,"offset_unit":"unicode_code_point"},{"id":"wendi-q-p083-weishu","section":"chapter-002","block":"b-433e8a044233daf1a02c","layer":"pei","quote":"权及领南郡太守史郃等三百一十八人，诣荆州刺史，奉上所假印绶、棨戟、幢麾、牙门、鼓车。权等诣行在所，帝置酒设乐，引见于承光殿。权、郃等，人人前自陈；帝为论说军旅成败去就之分，诸将无不喜悦。","attribution":"裴注·魏书","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":333,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6defd535a55e9bd7ca04","start":10,"end":103,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o069b-q","section":"chapter-032","block":"b-5398e8ba8cc35262f80d","layer":"original","quote":"后十余日，陆议大破先主军于犹亭；将军冯习、张南等皆没〖12〗。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":402,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":20,"end":51,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
