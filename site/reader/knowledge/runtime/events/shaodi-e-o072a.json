ll},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-96103ace1e11ae4131ba","start":0,"end":28,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o072","section":"chapter-004","block":"b-4b9070779d1c209c6814","layer":"original","quote":"二年春正月，乙丑〖6〗，镇东将军毌丘俭、扬州刺史文钦反。（戊戌）〔戊寅〕〖7〗，大将军司马景王征之。癸未〖8〗，车骑将军郭淮薨。闰月，己亥〖9〗，破钦于乐嘉〖10〗；钦遁走，遂奔吴。甲辰〖11〗，安风淮津都尉斩俭〖12〗，传首京都。﹝一﹞壬子〖13〗，复特赦淮南士民诸为俭、钦所诖误者〖14〗。以镇南将军诸葛诞为镇东大将军〖15〗。司马景王薨于许昌。二月，丁巳〖16〗，以卫将军司马文王为大将军〖17〗，录尚书事。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":332,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":207,"offset_unit":"unicode_code_point"},{"id":"wangwei-q-a06de1e20b39429c7594","section":"chapter-021","block":"b-058d67cdb457581aea96","layer":"original","quote":"正元二年春，毌丘俭、文钦作乱","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":524,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":14,"offset_unit":"unicode_code_point"},{"id":"wgc-q0018","section":"chapter-028","block":"b-8c475e54b34bd0181952","layer":"original","quote":"正元二年正月，有彗星数十丈，西北竟天〖17〗，起于吴、楚之分〖18〗。俭、钦喜，以为己祥〖19〗。遂矫太后诏〖20〗，罪状大将军司马景王〖21〗，移诸郡国，举兵反。迫胁淮南将守诸别屯者，及吏民大小，皆入寿春城；为坛于城西，歃血称兵为盟〖22〗，分老弱守城，俭、钦自将五六万众渡淮；西至项。俭坚守，钦在外为游兵〖23〗。﹝四﹞","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":87,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":162,"offset_unit":"unicode_code_point"},{"id":"wgc-q0224","section":"chapter-028","block":"b-8c475e54b34bd0181952","layer":"original","quote":"遂矫太后诏〖20〗，罪状大将军司马景王〖21〗，移诸郡国，举兵反","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":87,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a63575780