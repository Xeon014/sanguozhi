dence":["santizhu064-q-7f20cc569ae15f362b09"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"未由相邻段落推算纪年；原文时间表达保留在来源引句中。","evidence":["santizhu064-q-7f20cc569ae15f362b09"]},"ordering_evidence":"santizhu064-q-7f20cc569ae15f362b09","source_order":[64,25,230],"related_events":[{"event":"santizhu064-e-o094a","type":"alternative","evidence":["santizhu064-q-7f20cc569ae15f362b09","santizhu064-q-e5d1dd0847f190e833bb"]},{"event":"santizhu064-e-o094b","type":"related","evidence":["santizhu064-q-7f20cc569ae15f362b09","santizhu064-q-efee3ca1833ae60db26c"]}],"order":11031}],"persons":[{"id":"houzhu-p0013","name":"孙綝","facts":[],"aliases":[]},{"id":"santizhu-p0001","name":"全公主","facts":[],"aliases":[]},{"id":"santizhu-p0002","name":"全尚","facts":[],"aliases":[]},{"id":"santizhu-p0003","name":"全氏（孙亮妃／后）","facts":[],"aliases":[]},{"id":"santizhu-p0020","name":"刘丞","facts":[],"aliases":[]},{"id":"wuzhu-p0128","name":"孙亮","facts":[],"aliases":[]}],"evidence":[{"id":"santizhu-q-4ea4628abd86d3d6823f","section":"chapter-048","block":"b-fce5536b05cb3d0ea98d","layer":"original","quote":"亮以綝专恣，与太常全尚，将军刘丞，谋诛綝","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":121,"anchor":null},"note_id":null,"start":0,"end":20},{"id":"santizhu064-q-5274abc71ef19e4c91a7","section":"chapter-064","block":"b-95b6f4e559a9caf04f8a","layer":"original","quote":"亮妃，綝从姊女也〖5〗，以其谋告綝。","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":455,"anchor":null},"note_id":null,"start":91,"end":109},{"id":"santizhu064-q-7f20cc569ae15f362b09","section":"chapter-064","block":"b-5a68ad209c9913a5a2f5","layer":"pei","quote":"纪承诏，以告尚；尚无远虑，以语纪母。母使人密语綝。綝夜发严兵废亮，比明，兵已围宫","attribution":"裴注·江表传","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":477,"anchor":null},"note_id":"n-3c25a1ac71ab7fb35794","start":230,"end":270},{"id":"santizhu064-q-e5d1dd0847f190e833bb","section":"chapter-064","block":"b-95b6f4e559a9caf04f8a","layer":"original","quote":"亮遂与公主鲁班、太常全尚、将军刘（承）〔丞〕议诛綝。亮妃，綝从姊女也〖5〗，以其谋告綝","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":455,"anchor":null},"note_id":null,"start":65,"end":108},{"id":"santizhu064-q-f4cffdb0d4a70d37ea2f","section":"chapter-064","block":"b-5a68ad209c9913a5a2f5","layer":"pei","quote":"亮召全尚息黄门侍郎纪，密谋，曰：‘孙綝专势，轻小于孤。孤（见）〔前〕敕之，使速上岸，为唐咨等作援；而留湖中，不上岸一步。又委罪朱异，擅杀功臣，不先表闻。筑第桥南，不复朝见。此为自在，无复所畏，不可久忍。今规取之，卿父作中军都督，使密严整士马；孤当自出临桥，帅宿卫虎骑、左右无难，一时围之；作板诏敕綝所领皆解散，不得举手：正尔，自〔当〕得之！卿去，但当使密耳。卿宣诏语卿父，勿令卿母知之；女人既不晓大事，且綝同堂姊：邂逅泄漏，误孤非小也","attribution":"裴注·江表传","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":477,"anchor":null},"note_id":"n-3c25a1ac71ab7fb35794","start":11,"end":228}],"profiles":{},"directory_counts":{}}
