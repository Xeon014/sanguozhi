{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhangle-e-o018a","title":"乐进卒乐綝嗣","accounts":[{"id":"zhangle-e-o018a-account","label":"《张乐于张徐传第十七》正文","text":"乐进卒乐綝嗣","evidence":["zhangle-e-o018a-q"]}],"participants":[{"person":"wudi-p0236","role":"卒","evidence":["zhangle-e-o018a-q"]},{"person":"shaodi-p0108","role":"嗣爵","evidence":["zhangle-e-o018a-q"]}],"place":null,"time":{"year":218,"label":"建安二十三年","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"zhangle-y218","dating_review":{"reviewed":true,"anchor":"zhangle-q-o018","basis":"建安二十三年"},"evidence":["zhangle-e-o018a-q","zhangle-q-o018","xianzhu-q-o047","xianzhu-q-b-83ca0a92aa843c9ad193"]},"ordering_evidence":"zhangle-e-o018a-q","source_order":[17,60,"O018a"],"order":3516}],"persons":[{"id":"shaodi-p0108","name":"乐綝","facts":[],"aliases":[]},{"id":"wudi-p0236","name":"乐进","facts":[],"aliases":[]}],"evidence":[{"id":"xianzhu-q-b-83ca0a92aa843c9ad193","section":"chapter-032","block":"b-83ca0a92aa843c9ad193","layer":"modern","quote":"〖10〗二十三年：建安二十三年（公元 218 ）。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":221,"anchor":null},"note_id":"n-30fd48fc702deb140e7e","start":0,"end":25},{"id":"xianzhu-q-o047","section":"chapter-032","block":"b-44db547f089e12d33623","layer":"original","quote":"二十三年〖10〗，先主率诸将进兵汉中。分遣将军吴兰、雷铜等入武都；皆为曹公军所没。先主次于阳平关，与渊、郃等相拒。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":202,"anchor":null},"note_id":null,"start":0,"end":57},{"id":"zhangle-e-o018a-q","section":"chapter-017","block":"b-1e0a6d94bfa7c99ac8da","layer":"original","quote":"建安二十三年薨，谥曰威侯。子綝嗣。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":59,"anchor":null},"note_id":null,"start":0,"end":17},{"id":"zhangle-q-o018","section":"chapter-017","block":"b-1e0a6d94bfa7c99ac8da","layer":"original","quote":"建安二十三年薨，谥曰威侯。子綝嗣。綝果毅有父风，官至扬州刺史。诸葛诞反，掩袭杀綝。诏悼惜之，追赠卫尉，谥曰愍侯。子肇嗣。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":59,"anchor":null},"note_id":null,"start":0,"end":60}],"profiles":{},"directory_counts":{}}
