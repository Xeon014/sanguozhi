{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wuzhu-e-o137b","title":"大疫有司再请立后诸王孙霸立鲁王","accounts":[{"id":"wuzhu-e-o137b-account","label":"《吴主传第二》正文","text":"大疫有司再请立后诸王孙霸立鲁王","evidence":["wuzhu-e-o137b-q"]}],"participants":[{"person":"wuzhu-p0116","role":"受封","evidence":["wuzhu-e-o137b-q"]},{"person":"sun-quan","role":"封子","evidence":["wuzhu-e-o137b-q"]}],"place":null,"time":{"year":242,"label":"秋七月至八月","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"wuzhu-y242","dating_review":{"reviewed":true,"anchor":"wuzhu-q-o135","basis":"秋七月至八月"},"evidence":["wuzhu-e-o137b-q","wuzhu-q-o135","shaodi-q-o015","shaodi-q-b-f25c29f875d80e25ad66"]},"ordering_evidence":"wuzhu-e-o137b-q","source_order":[47,707,"O137b"],"order":8364}],"persons":[{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"wuzhu-p0116","name":"孙霸","facts":[],"aliases":[]}],"evidence":[{"id":"shaodi-q-b-f25c29f875d80e25ad66","section":"chapter-004","block":"b-f25c29f875d80e25ad66","layer":"modern","quote":"〖1〗三年：正始三年（公元 242）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":84,"anchor":null},"note_id":"n-0c94d6c7ec4663a4ff7d","start":0,"end":19},{"id":"shaodi-q-o015","section":"chapter-004","block":"b-928dff832b77cf5f2f14","layer":"original","quote":"三年春正月〖1〗，东平王徽薨〖2〗。三月，太尉满宠薨。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":71,"anchor":null},"note_id":null,"start":0,"end":27},{"id":"wuzhu-e-o137b-q","section":"chapter-047","block":"b-fb43c4f02a5cae882f38","layer":"original","quote":"是岁大疫。有司又奏立后及诸王。八月，立子霸为鲁王〖9〗。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":195,"anchor":null},"note_id":null,"start":28,"end":56},{"id":"wuzhu-q-o135","section":"chapter-047","block":"b-692e948ed8fd30650c98","layer":"original","quote":"五年春正月〖1〗，立子和为太子〖2〗。大赦，改禾兴为嘉兴。百官奏立皇后及四王，诏曰：“今天下不定，民物劳瘁〖3〗；且有功者或未录，饥寒者尚未恤；猥割土壤以丰子弟〖4〗，崇爵位以宠妃妾：孤甚不取。其释此议。”三月，海盐县言黄龙现〖5〗。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":193,"anchor":null},"note_id":null,"start":0,"end":117}],"profiles":{},"directory_counts":{}}
