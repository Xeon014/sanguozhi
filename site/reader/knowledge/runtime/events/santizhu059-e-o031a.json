{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"santizhu059-e-o031a","title":"孙权准孙虑假节开府治半州","accounts":[{"id":"santizhu059-a-1ff98fbe64575bf2e3dc","label":"正文","text":"孙权准孙虑假节开府治半州","evidence":["santizhu059-q-5dfabc606617c443c4c3"]},{"id":"santizhu059-a-494212f1100175c60ba7","label":"裴注·吴书","text":"《吴书》载权授虑上将之位诏全文：授上将之位、显殊特之荣、宠兵马之势、委偏方之任，诫其持盈若冲","evidence":["santizhu059-q-e8673df808bef205c468"]}],"participants":[{"person":"sun-quan","role":"准许","evidence":["santizhu059-q-5dfabc606617c443c4c3"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"未由相邻段落推算纪年；原文时间表达保留在来源引句中。","evidence":["santizhu059-q-5dfabc606617c443c4c3"]},"ordering_evidence":"santizhu059-q-5dfabc606617c443c4c3","source_order":[59,31,0],"order":10446}],"persons":[{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]}],"evidence":[{"id":"santizhu059-q-5dfabc606617c443c4c3","section":"chapter-059","block":"b-9c7ab4a9f6b617d6677f","layer":"original","quote":"权乃许之。于是假节，开府〖11〗，治半州","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":111,"anchor":null},"note_id":null,"start":0,"end":20},{"id":"santizhu059-q-e8673df808bef205c468","section":"chapter-059","block":"b-038296e29ca21ebf1d8c","layer":"pei","quote":"《吴书》载权诏曰：“期运扰乱，凶邪肆虐；威罚有序，干戈不戢。以虑气志休懿，武略夙昭，必能为国佐定大业。故授以上将之位，显以殊特之荣；宠以兵马之势，委以偏方之任。外欲威振敌虏，厌难万里；内欲镇抚远近，慰恤将士：诚虑建功立事竭命之秋也。虑其内修文德，外经武训；持盈若冲，则满而不溢。敬慎乃心，无忝所受。”","attribution":"裴注·吴书","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":129,"anchor":null},"note_id":"n-6036a439c16a97376e9b","start":3,"end":153}],"profiles":{},"directory_counts":{}}
