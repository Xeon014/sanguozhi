{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o104a","title":"曹操下令纠正冀州毁誉风俗","accounts":[{"id":"wudi-e-o104a-account","label":"正文","text":"曹操以历代毁誉失实的典故，批评冀州结党相互吹捧诋毁的风俗，表示要加以整治。","evidence":["wudi-e-o104a-q"]}],"participants":[{"person":"cao-cao","role":"颁令整俗","evidence":["wudi-e-o104a-q"]}],"place":{"text":"冀州","evidence":["wudi-e-o104a-q"]},"time":{"label":"建安十年九月","year":205,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o104a-q","wudi-q-o100","wudi-q-b-2e98e13ca098117a86e9"],"chronology":"wudi-y205","dating_review":{"anchor":"wudi-q-o100","basis":"建安十年九月","reviewed":true}},"source_order":[1,577,"O104a"],"order":239}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-o104a-q","section":"chapter-001","block":"b-8efba5dafb5dd32d0163","layer":"original","quote":"九月，令曰：“阿党比周〖4〗，先圣所疾也〖5〗。闻冀州俗：父子异部更相毁誉〖6〗。昔直不疑无兄，世人谓之盗嫂〖7〗；第五伯鱼三娶孤女，谓之挝妇翁〖8〗；王凤擅权，谷永比之申伯〖9〗；王商忠议，张匡谓之左道〖10〗。此皆以白为黑，欺天罔君者也〖11〗。吾欲整齐风俗；四者不除〖12〗，吾以为羞！”","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":576,"anchor":null},"note_id":null,"start":0,"end":147},{"id":"wudi-q-b-2e98e13ca098117a86e9","section":"chapter-001","block":"b-2e98e13ca098117a86e9","layer":"modern","quote":"〖1〗十年：建安十年（公元 205）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":560,"anchor":null},"note_id":"n-a9b0434ee8de64aed40f","start":0,"end":19},{"id":"wudi-q-o100","section":"chapter-001","block":"b-1ca17316b02d7b4d213c","layer":"original","quote":"十年春正月〖1〗，攻谭，破之。斩谭，诛其妻子〖2〗，冀州平。﹝一﹞下令曰：“其与袁氏同恶者，与之更始〖3〗。”令民不得复私仇，禁厚葬；皆一之于法〖4〗。是月，袁熙大将焦触、张南等叛〖5〗，攻熙、尚；熙、尚奔三郡乌丸〖6〗。触等举其县降，封为列侯。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":557,"anchor":null},"note_id":null,"start":0,"end":123}],"profiles":{},"directory_counts":{}}
