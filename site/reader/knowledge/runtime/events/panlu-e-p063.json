1a1a12d","chapter-013":"24c6e486e7f78fc4d59ff01277b36cb77ffb69c68a6a9030889fe00efe4b3d27","chapter-016":"6cfac20452f269a832b087d2e808cc4b3017944d17dca1d5b1e068ebb98d8327","chapter-018":"7a62f43c1f5dc64661b088ef0fdd48392063ef5c49001fa980aa65e766380b23","chapter-019":"a43f6648e6c9d8389d561bee9d00824665f8f06542ab2a65aac06ed8a7601c5b","chapter-020":"2ef7e28be018140e07d27d7636a9df480a5cb7ef1cb3572c314a70e0d1acd07c","chapter-050":"71faaaddb69f25a5bdd7f315f15562e867eed9e897c9bd439a99a09c435bfe91","chapter-023":"908d4e64a01e171bdb09c0a7ee5484b8743be26b7cc75f49bd8b41b7ff391ff2","chapter-024":"39be893c0040dbb3148f9447402c47fc24dcb4356360f8558243258cb85b089a","chapter-025":"f37fc365e7d07f96b5fd289119e1846fe7f0030d8b46a7195fab316badf817b7","chapter-027":"dd48b2052380e1f6b6f6ffcb4835dd99cfe70efe4a9096fa51448dbdfaa14f00","chapter-062":"7031fb8ebde1ea3c95cdedcf93218fb46f69a71a29a1d9e82361f7108436a86a","chapter-063":"3ae8edfbae98c3e86a518f7022c664ed35a0d68d5ac36b331ceb560e76b1848f","chapter-065":"13c50dd7dc9a229aef1cfb43dd231955a0b1a6359dab04c54708df93fa114e12","chapter-057":"39e3922e223fe25b811b77f14049327071298549de6ed788ba7da697f067f2e3","chapter-021":"18c02b71e8f81644cf71ffea582a8e019509de0b5e9bc11451de595fa03e2cf3","chapter-029":"6ffb35bac29d20aa512b5a734e72f98ec5729b176f1bc5d6837e673bcc00880d","chapter-030":"3e0682212c3e242d0f221308bc203bd8309851b8498b94db16383bdde5234ce1"},"events":[{"id":"panlu-e-p063","title":"凯重表谏罢宫功修德","accounts":[{"id":"panlu-a-2bda13a3b30f103bdccc","label":"裴注·《江表传》","text":"凯重表谏罢宫功修德","evidence":["panlu-q-a461f2fbfeff27fbb95e"]}],"participants":[{"person":"wuzhu-p0115","role":"重表陈频烦上事往往留中、年已六十九荣禄已重复何所冀、大皇帝创基立业劳苦勤至白发生于鬓肤、幼主嗣统柄在臣下贼臣干政公家空竭、今强敌当途西州倾覆孤疲之民宜当畜养、禳灾以德除咎以义、陛下不务修德而务筑宫室虽殷辛之瑶台秦皇之阿房何止而不丧身覆国、大皇帝居南宫自谓过于阿房、先朝大臣以为宫室宜厚而大皇帝冲让未肯筑宫、愿陛下留意臣不虚言","evidence":["panlu-q-a461f2fbfeff27fbb95e"]},{"person":"shaodi-p0162","role":"诏答君所谏诚是大趣然未合鄙意、此宫殿不利宜当避之、被重表谏者","evidence":["panlu-q-a461f2fbfeff27fbb95e"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["panlu-q-a461f2fbfeff27fbb95e"]},"ordering_evidence":"panlu-q-a461f2fbfeff27fbb95e","source_order":[61,240,341],"order":10761}],"persons":[{"id":"shaodi-p0162","name":"孙皓","facts":[],"aliases":[]},{"id":"wuzhu-p0115","name":"陆凯","facts":[],"aliases":[]}],"evidence":[{"id":"panlu-q-a461f2fbfeff27fbb95e","section":"chapter-061","block":"b-99adf9d4b09529e21fdf","layer":"pei","quote":"臣闻宫功当起，夙夜反侧；是以频烦上事，往往留中，不见省报；於邑叹息，企想应罢。昨食时，被诏曰：“君所谏，诚是大趣；然未合鄙意，如何？此宫殿不利，宜当避之，乃可以妨劳役，长坐不利宫乎？父之不安，子亦何倚？”臣拜纸诏，伏读一周，不觉气结于胸，而涕泣雨集也。臣年已六十九，荣禄已重，于臣过望，复何所冀？所以勤勤数进苦言者，臣伏念大皇帝创基立业，劳苦勤至；白发生于鬓肤，黄耇被于甲胄；天下始静，晏驾早崩。自含息之类，能言之伦，无不歔欷，如丧考妣。幼主嗣统，柄在臣下；军有连征之费，民有凋残之损；贼臣干政，公家空竭。今强敌当途，西州倾覆；孤疲之民，宜当畜养；广力肆业，以备有虞。且始徙都，属有军征；战士流离，州郡骚扰；而大功复起，征召四方：斯非保国致治之渐也。臣闻为人主者，禳灾以德，除咎以义。故汤遭大旱，身祷桑林；荧惑守心，宋景退殿。是以旱魃销亡，妖星移舍。今宫室之不利，但当克己复礼，笃汤、宋之至道，愍黎庶之困苦；何忧宫之不安，灾之不销乎？陛下不务修德，而务筑宫室；若德之不修，行之不贵；虽殷辛之瑶台，秦皇之阿房，何止而不丧身覆国，宗庙作墟乎？夫兴土功，高台榭；既致水旱，民又多疾，其不疑也。为父长安，使子无倚；此乃子离于父，臣离于陛下之象也。臣子一离，虽念克骨，茅茨不剪，复何益焉？是以大皇帝居于南宫，自谓过于阿房。故先朝大臣，以为宫室宜厚，备卫非常，大皇帝曰：“逆虏游魂，当爱育百姓，何聊趋于不急？”然臣下恳恻，由不获已；故裁调近郡，苟副众心；比当就功，犹豫三年。当此之时，寇抄慑威，不犯我境，师徒奔北；且西阻岷、汉，南州无事；尚犹冲让，未肯筑宫。况陛下危侧之世，又乏大皇帝之德，可不虑哉？愿陛下留意，臣不虚言","attribution":"裴注·《江表传》","section_title":"潘濬陆凯传第十六","source":{"file":"OEBPS/Text/titlepage_0129.xhtml","index":239,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-d8f24f67c921112bdbc6","start":341,"end":1045,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
