{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"houfei-e-p002b","title":"丁氏因曹昂死与曹操绝","accounts":[{"id":"houfei-e-p002b-account","label":"《魏略》","text":"丁氏因曹昂死与曹操绝","evidence":["houfei-e-p002b-q"]}],"participants":[{"person":"houfei-p0008","role":"归家决绝","evidence":["houfei-e-p002b-q"]},{"person":"cao-cao","role":"求复不成","evidence":["houfei-e-p002b-q"]}],"place":null,"time":{"label":"子修亡于穰后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["houfei-e-p002b-q"]},"ordering_evidence":"houfei-e-p002b-q","source_order":[5,38,"P002b"],"order":1342}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"houfei-p0008","name":"丁夫人（曹操夫人）","facts":[],"aliases":[]}],"evidence":[{"id":"houfei-e-p002b-q","section":"chapter-005","block":"b-e655a9cd53f203645964","layer":"pei","quote":"子修亡于穰，丁常言：‘将我儿杀之，都不复念！’遂哭泣无节。太祖忿之，遣归家，欲其意折。后太祖就见之，夫人方织。外人传云‘公至’，夫人踞机如故。太祖到，抚其背曰：‘顾我共载归乎？’夫人不顾，又不应。太祖却行，立于户外。复云：‘得无尚可邪？’遂不应。太祖曰：‘真诀矣！’遂与绝。欲其家嫁之，其家不敢。","attribution":"《魏略》","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":37,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8073d620865a43f9e1af","start":41,"end":189,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
