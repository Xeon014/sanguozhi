{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhangyan-e-682ce22a2d51f8eaed09","title":"张纮建计宜出都秣陵，孙权从之","accounts":[{"id":"zhangyan-a-682ce22a2d51f8eaed09","label":"正文","text":"张纮建计宜出都秣陵，孙权从之","evidence":["zhangyan-q-d2322ec0cc993eff5979"]}],"participants":[{"person":"sunshi-p0048","role":"建计者","evidence":["zhangyan-q-d2322ec0cc993eff5979"]},{"person":"sun-quan","role":"从之者","evidence":["zhangyan-q-d2322ec0cc993eff5979"]}],"place":null,"time":{"label":"建安十六年","precision":"year","year":211,"basis":"注18直接解释出都秣陵为211年","evidence":["zhangyan-q-27f3e07f8e20d0405308","zhangyan-q-d2322ec0cc993eff5979"],"chronology":"zhangyan-y-b1fbb8aa99dde6906498","dating_review":{"reviewed":true,"anchor":"zhangyan-q-27f3e07f8e20d0405308","basis":"注18直接解释出都秣陵为211年；核对本篇引句语境，不由前后事件套年。"}},"ordering_evidence":"zhangyan-q-d2322ec0cc993eff5979","order":9409}],"persons":[{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"sunshi-p0048","name":"张纮","facts":[],"aliases":[]}],"evidence":[{"id":"zhangyan-q-27f3e07f8e20d0405308","section":"chapter-053","block":"b-79bfa17b21ed37bd63cb","layer":"modern","quote":"〖18〗出都：出外建都。当时孙权的治所在吴县（今江苏苏州市），处于江东的腹心地区。为了适应向西、向北扩张的政治形势，孙权在建安十六年（公元 211）把治所移到长江之滨的秣陵（今江苏南京市）。秣陵相对于吴县而言是外围，所以说是出都。","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":26,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c325cbb44b22972126da","start":0,"end":115,"offset_unit":"unicode_code_point"},{"id":"zhangyan-q-d2322ec0cc993eff5979","section":"chapter-053","block":"b-b05c3210bd9228a99f5c","layer":"original","quote":"纮建计宜出都秣陵〖18〗，权从之","section_title":"张严程阚薛传第八","source":{"file":"OEBPS/Text/titlepage_0113.xhtml","index":7,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":16,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_count