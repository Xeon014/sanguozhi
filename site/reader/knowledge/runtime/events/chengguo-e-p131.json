{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"chengguo-e-p131","title":"徐众评允宜先救至亲","accounts":[{"id":"chengguo-a-4bb73ae108b003192292","label":"裴注·徐众《评》","text":"徐众评允宜先救至亲","evidence":["chengguo-q-9e839c0be438527f4f68"]}],"participants":[{"person":"hequan-p0028","role":"评允于曹公未成君臣、母至亲也于义应去、允宜先救至亲、曹公亦宜遣允","evidence":["chengguo-q-9e839c0be438527f4f68"]},{"person":"chengguo-p0049","role":"被评者","evidence":["chengguo-q-9e839c0be438527f4f68"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["chengguo-q-9e839c0be438527f4f68"]},"ordering_evidence":"chengguo-q-9e839c0be438527f4f68","source_order":[14,29,11],"order":2967}],"persons":[{"id":"chengguo-p0049","name":"靳允","facts":[],"aliases":[]},{"id":"hequan-p0028","name":"徐众","facts":[],"aliases":[]}],"evidence":[{"id":"chengguo-q-9e839c0be438527f4f68","section":"chapter-014","block":"b-fe8b3016f0fea6efad57","layer":"pei","quote":"允于曹公，未成君臣；母，至亲也，于义应去。昔王陵母为项羽所拘，母以高祖必得天下，因自杀，以固陵志。明心无所系，然后可得成事人尽死之节。卫公子开方，仕齐，积年不归。管仲以为不怀其亲，安能爱君，不可以为相。是以求忠臣必于孝子之门。允宜先救至亲。徐庶母为曹公所得，刘备乃遣庶归：欲为天下者，恕人子之情也。曹公亦宜遣允","attribution":"裴注·徐众《评》","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":28,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-edaf45fc6ef4dcd2d302","start":11,"end":166,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
