{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"sunshi-e-p044a","title":"孙策上表谢袭爵领郡废袁术私授之号","accounts":[{"id":"sunshi-e-p044a-account","label":"《吴录》","text":"孙策上表谢袭爵领郡废袁术私授之号","evidence":["sunshi-e-p044a-q"]}],"participants":[{"person":"wudi-p0099","role":"谢恩废号","evidence":["sunshi-e-p044a-q"]}],"place":null,"time":{"label":"孙策受汉诏之后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["sunshi-e-p044a-q"]},"ordering_evidence":"sunshi-e-p044a-q","source_order":[46,256,"P044a"],"order":8113}],"persons":[{"id":"wudi-p0099","name":"孙策","facts":[],"aliases":[]}],"evidence":[{"id":"sunshi-e-p044a-q","section":"chapter-046","block":"b-6dabcacbdec9507efd9d","layer":"pei","quote":"臣以固陋，孤特边陲。陛下广播高泽，不遗细节；以臣袭爵，兼典名郡：仰荣（宠顾）〔顾宠〕，所不克堪。兴平二年十二月二十日，于吴郡曲阿得袁术所呈表，以臣行殄寇将军；至被诏书，乃知诈擅。虽辄捐废，犹用悚悸。臣年十七，丧失所怙；惧有不任堂构之鄙，以忝析薪之戒；诚无去病十八建功，世祖列将弱冠佐命。臣初领兵，年未弱冠；虽驽懦不武，然思竭微命。惟术狂惑，为恶深重。臣凭威灵，奉辞伐罪；庶必献捷，以报所授。","attribution":"《吴录》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":255,"anchor":null},"note_id":"n-724f2dcc828652965c88","start":12,"end":207}],"profiles":{},"directory_counts":{}}
