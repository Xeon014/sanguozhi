{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhanggu-e-o007","title":"昭扶权上马陈兵众心有所归","accounts":[{"id":"zhanggu-a-7adbd4d4e66abe0ec8a0","label":"正文","text":"昭扶权上马陈兵众心有所归","evidence":["zhanggu-q-64231a8db758c42a283c"]}],"participants":[{"person":"wendi-p0133","role":"谓权曰夫为人后者贵能负荷先轨克昌堂构以成勋业也方今天下鼎沸群盗满山孝廉何得寝伏哀戚肆匹夫之情哉、乃身自扶权上马陈兵而出、复为权长史授任如前","evidence":["zhanggu-q-64231a8db758c42a283c"]},{"person":"sun-quan","role":"悲感未视事、被扶上马","evidence":["zhanggu-q-64231a8db758c42a283c"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["zhanggu-q-64231a8db758c42a283c"]},"ordering_evidence":"zhanggu-q-64231a8db758c42a283c","source_order":[52,22,0],"order":9244}],"persons":[{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"wendi-p0133","name":"张昭","facts":[],"aliases":[]}],"evidence":[{"id":"zhanggu-q-64231a8db758c42a283c","section":"chapter-052","block":"b-91a08bc1db9a0335a44c","layer":"original","quote":"权悲感，未视事。昭谓权曰：“夫为人后者〖1〗，贵能负荷先轨〖2〗，克昌堂构〖3〗，以成勋业也！方今天下鼎沸〖4〗，群盗满山；孝廉何得寝伏哀戚〖5〗，肆匹夫之情哉！”乃身自扶权上马，陈兵而出：然后众心知有所归。昭复为权长史，授任如前","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":21,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":115,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
