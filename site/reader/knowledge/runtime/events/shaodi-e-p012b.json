{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"shaodi-e-p012b","title":"诸葛诞建议分兵牵吴司马师从议","accounts":[{"id":"shaodi-e-p012b-account","label":"《汉晋春秋》","text":"诸葛诞建议分兵牵吴司马师从议","evidence":["shaodi-e-p012b-q"]}],"participants":[{"person":"shaodi-p0044","role":"建策","evidence":["shaodi-e-p012b-q"]},{"person":"shaodi-p0038","role":"从议","evidence":["shaodi-e-p012b-q"]}],"place":null,"time":{"year":252,"label":"是岁","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"shaodi-y252","dating_review":{"reviewed":true,"anchor":"shaodi-q-o052","basis":"是岁"},"evidence":["shaodi-e-p012b-q","shaodi-q-o052","shaodi-q-b-20272e7cc5379b3fe346"]},"ordering_evidence":"shaodi-e-p012b-q","source_order":[4,237,"P012b"],"order":1089}],"persons":[{"id":"shaodi-p0038","name":"司马师","facts":[],"aliases":[]},{"id":"shaodi-p0044","name":"诸葛诞","facts":[],"aliases":[]}],"evidence":[{"id":"shaodi-e-p012b-q","section":"chapter-004","block":"b-b21524fb470242deda03","layer":"pei","quote":"﹝一﹞《汉晋春秋》曰：“初，孙权筑东兴堤，以遏巢湖。后征淮南，坏不复修。是岁，诸葛恪帅军更于堤左右，结山挟筑两城；使全端、留略守之，引军而还。诸葛诞言于司马景王曰：‘致人而不致于人者，此之谓也。今因其内侵，使文舒逼江陵，仲恭向武昌，以羁吴之上流；然后简精卒，攻两城：比救至，可大获也！’景王从之。”","attribution":"《汉晋春秋》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":236,"anchor":null},"note_id":"n-8fa5c9b0224b3bacd13f","start":0,"end":149},{"id":"shaodi-q-b-20272e7cc5379b3fe346","section":"chapter-004","block":"b-20272e7cc5379b3fe346","layer":"modern","quote":"〖17〗四年：嘉平四年（公元252）。癸卯：旧历初二日。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":230,"anchor":null},"note_id":"n-db96ad991a403b6a010e","start":0,"end":28},{"id":"shaodi-q-o052","section":"chapter-004","block":"b-944c76689fd8a3e8fa86","layer":"original","quote":"四年春正月，癸卯〖17〗，以抚军大将军司马景王为大将军。二月，立皇后张氏〖18〗，大赦。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":210,"anchor":null},"note_id":null,"start":0