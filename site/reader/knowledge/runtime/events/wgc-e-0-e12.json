{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wgc-e-0-e12","title":"王凌布政青州","order":5420,"accounts":[{"id":"wgc-a-0-e12","label":"正文","text":"王凌布政青州","evidence":["wgc-q0153","wgc-q0003"]}],"participants":[{"person":"shaodi-p0004","role":"布政施教、赏善罚恶","evidence":["wgc-q0153","wgc-q0003"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0153","wgc-q0003"]},"ordering_evidence":"wgc-q0153"}],"persons":[{"id":"shaodi-p0004","name":"王凌","facts":[],"aliases":[]}],"evidence":[{"id":"wgc-q0003","section":"chapter-028","block":"b-6b32530f1b0a1d7ab598","layer":"original","quote":"转在青州。是时海滨乘丧乱之后，法度未整。凌布政施教，赏善罚恶，甚有纲纪〖6〗；百姓称之，不容于口〖7〗。后从曹休征吴，与贼遇于夹石。休军失利，凌力战决围，休得免难。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":3,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":82,"offset_unit":"unicode_code_point"},{"id":"wgc-q0153","section":"chapter-028","block":"b-6b32530f1b0a1d7ab598","layer":"original","quote":"凌布政施教，赏善罚恶，甚有纲纪〖6〗；百姓称之，不容于口","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":3,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":20,"end":48,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
