age_0103.xhtml","index":521,"anchor":null},"note_id":null,"start":29,"end":44},{"id":"santizhu-q-7a8416cd6b0d5b9429fe","section":"chapter-048","block":"b-bd13b56d791a176f2445","layer":"pei","quote":"临海松阳人柳荣，从悌至杨府。荣病死船中，二日；时军已上岸，无有埋之者。忽然大呼，言：‘人缚军师！人缚军师！’声激扬，遂活。人问之，荣曰：‘上天，北斗门下，猝见人缚张悌。意中大愕，不觉大呼，言：“何以缚张军师！”门下人怒荣，叱逐使去。荣便去，怖惧，口余声发扬耳。’其日，悌战死。荣至晋元帝时，犹在。","attribution":"《搜神记》","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":551,"anchor":null},"note_id":"n-5564fe5f445521640591","start":8,"end":156}],"profiles":{},"directory_counts":{}}
