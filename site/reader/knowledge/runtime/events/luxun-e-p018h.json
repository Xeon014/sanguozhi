{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"luxun-e-p018h","title":"牵秀孟玖谮陆机司马颖收杀陆氏兄弟","accounts":[{"id":"luxun-e-p018h-account","label":"《机云别传》","text":"牵秀等与孟玖谮陆机，司马颖信之，收陆机陆云陆耽，皆伏法。","evidence":["luxun-e-p018h-q"]},{"id":"luxun-a-p018-comment","label":"《机云别传》","text":"别传称陆氏兄弟无罪被夷，并引人以陆抗诛及婴孩说报应；这些是该书评述，非客观因果。","evidence":["luxun-q-p018-comment"]},{"id":"luxun-a-p018-letter","label":"孙惠致朱诞书（《机云别传》所载）","text":"孙惠致朱诞书以马援择君为比，叹三陆相携暴朝杀身伤名。","evidence":["luxun-q-p018-letter"]}],"participants":[{"person":"luxun-p0085","role":"谮毁","evidence":["luxun-e-p018h-q"]},{"person":"luxun-p0086","role":"谮毁","evidence":["luxun-e-p018h-q"]},{"person":"luxun-p0082","role":"令收","evidence":["luxun-e-p018h-q"]},{"person":"luxun-p0076","role":"被杀","evidence":["luxun-e-p018h-q"]},{"person":"wuzhu-p0110","role":"被杀","evidence":["luxun-e-p018h-q"]},{"person":"luxun-p0088","role":"被杀","evidence":["luxun-e-p018h-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["luxun-e-p018h-q"]},"ordering_evidence":"luxun-e-p018h-q","source_order":[58,455,"P018h"],"order":10420}],"persons":[{"id":"luxun-p0076","name":"陆机","facts":[],"aliases":[]},{"id":"luxun-p0082","name":"司马颖","facts":[],"aliases":[]},{"id":"luxun-p0085","name":"牵秀","facts":[],"aliases":[]},{"id":"luxun-p0086","name":"孟玖","facts":[],"aliases":[]},{"id":"luxun-p0088","name":"陆耽","facts":[],"aliases":[]},{"id":"wuzhu-p0110","name":"陆云","facts":[],"aliases":[]}],"evidence":[{"id":"luxun-e-p018h-q","section":"chapter-058","block":"b-20b860773c1dd9d264dc","layer":"pei","quote":"及牵秀等谮机于颖，以为持两端；玖又构之于内：颖信之。遣收机，并收云及弟耽，并伏法。","attribution":"《机云别传》","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":454,"anchor":null},"note_id":"n-d3a7d3771e82327ad7c0","start":365,"end":406},{"id":"luxun-q-p018-comment","section":"chapter-058","block":"b-20b860773c1dd9d264dc","layer":"pei","quote":"机兄弟既江南之秀，亦著名诸夏；并以无罪夷灭，天下痛惜之。机文章为世所重，云所著亦传于世。初，抗之克步阐也，诛及婴孩。识道者尤之曰：‘后世必受其殃！’及机之诛，三族无遗。","attribution":"《机云别传》","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":454,"anchor":null},"note_id":"n-d3a7d3771e82327ad7c0","start":406,"end":490},{"id":"luxun-q-p018-letter","section":"chapter-058","block":"b-20b860773c1dd9d264dc","layer":"pei","quote":"孙惠与朱诞书曰：‘马援择君，凡人所闻。不意三陆，相携暴朝；杀身伤名，可为悼叹！’","attribution":"孙惠致朱诞书（《机云别传》所载）","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":454,"anchor":null},"note_id":"n-d3a7d3771e82327ad7c0","start":490,"end":530}],"profiles":{},"directory_counts":{}}
