{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xiahoucao-e-p049b","title":"曹爽诛后夏侯文宁等促令女改嫁令女断鼻拒绝","accounts":[{"id":"xiahoucao-e-p049b-account","label":"皇甫谧《列女传》","text":"曹爽诛后夏侯文宁等促令女改嫁令女断鼻拒绝","evidence":["xiahoucao-e-p049b-q"]}],"participants":[{"person":"xiahoucao-p0099","role":"拒嫁自伤","evidence":["xiahoucao-e-p049b-q"]},{"person":"xiahoucao-p0100","role":"劝嫁","evidence":["xiahoucao-e-p049b-q"]}],"place":null,"time":{"label":"曹文叔卒至曹爽诛后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xiahoucao-e-p049b-q"]},"ordering_evidence":"xiahoucao-e-p049b-q","source_order":[9,389,"P049b"],"order":2314}],"persons":[{"id":"xiahoucao-p0099","name":"夏侯令女","facts":[],"aliases":[]},{"id":"xiahoucao-p0100","name":"夏侯文宁","facts":[],"aliases":[]}],"evidence":[{"id":"xiahoucao-e-p049b-q","section":"chapter-009","block":"b-0d5e954d728f52943dea","layer":"pei","quote":"及爽被诛，曹氏尽死。令女叔父上书与曹氏绝婚，强迎令女归。时文宁为梁相，怜其少，执义；又曹氏无遗类，冀其意沮，乃微使人讽之。令女叹且泣曰：‘吾亦惟之，许之是也。’家以为信，防之少懈。令女于是窃入寝室，以刀断鼻，蒙被而卧。其母呼与语，不应；发被视之，血流满床席。举家惊惶，奔往视之，莫不酸鼻。或谓之曰：‘人生世间，如轻尘栖弱草耳，何至辛苦乃尔！且夫家夷灭已尽，守此欲谁为哉？’令女曰：‘闻仁者不以盛衰改节，义者不以存亡易心；曹氏前盛之时，尚欲保终；况今衰亡，何忍弃之？禽兽之行，吾岂为乎！","attribution":"皇甫谧《列女传》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":388,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-46a3d2d6a327171eb9f7","start":88,"end":330,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
