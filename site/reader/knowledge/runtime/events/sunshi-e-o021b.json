{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"sunshi-e-o021b","title":"孙坚行岘山为黄祖军士射杀","accounts":[{"id":"sunshi-e-o021b-account","label":"《孙破虏讨逆传第一》正文","text":"孙坚行岘山为黄祖军士射杀","evidence":["sunshi-e-o021b-q"]},{"id":"sunshi-a-p044-judgment","label":"裴松之按语","text":"裴松之以孙策谢表年龄与《汉纪》《吴历》对照，认为孙坚卒于初平二年，正文初平三年为误；本底本已据校改。","evidence":["sunshi-q-p044-judgment"]},{"id":"sunshi-e-p027b-account","label":"《典略》","text":"孙坚乘胜夜追黄祖，为黄祖部兵从竹木间暗射而死。","evidence":["sunshi-e-p027b-q"]}],"participants":[{"person":"wudi-p0119","role":"遇害","evidence":["sunshi-e-o021b-q"]}],"place":null,"time":{"year":191,"label":"初平二年（底本校定）","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"sunshi-y191","dating_review":{"reviewed":true,"anchor":"sunshi-q-o021","basis":"初平二年（底本校定）"},"evidence":["sunshi-e-o021b-q","sunshi-q-o021","sunshi-q-b-8def9b9a583b6e66e28f"]},"ordering_evidence":"sunshi-e-o021b-q","source_order":[46,133,"O021b"],"order":8049}],"persons":[{"id":"wudi-p0119","name":"孙坚","facts":[],"aliases":[]}],"evidence":[{"id":"sunshi-e-o021b-q","section":"chapter-046","block":"b-1d0f9de1e75c38a11c0e","layer":"original","quote":"单马行岘山〖18〗，为祖军士所射杀。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":132,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":64,"end":82,"offset_unit":"unicode_code_point"},{"id":"sunshi-e-p027b-q","section":"chapter-046","block":"b-760ad2c11830e05077b7","layer":"pei","quote":"坚乘胜夜追祖；祖部兵，从竹木间暗射坚，杀之。","attribution":"《典略》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":171,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-c7bf5e729acd4a0d41f3","start":51,"end":73,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-b-8def9b9a583b6e66e28f","section":"chapter-046","block":"b-8def9b9a583b6e66e28f","layer":"modern","quote":"〖14〗初平二年：公元 191 年。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":149,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-43f1998c7eea8e582a74","start":0,"end":18,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-o021","section":"chapter-046","block":"b-1d0f9de1e75c38a11c0e","layer":"original","quote":"初平（三）〔二〕年〖14〗，术使坚征荆州，击刘表〖15〗。表遣黄祖逆于樊、邓之间〖16〗。坚击破之，追渡汉水，遂围襄阳〖17〗；单马行岘山〖18〗，为祖军士所射杀。﹝六﹞","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":132,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":85,"offset_unit":"unicode_code_point"},{"id":"sunshi-q-p044-judgment","section":"chapter-046","block":"b-6dabcacbdec9507efd9d","layer":"pei","quote":"臣松之按：本传云孙坚以初平三年卒，策以建安五年卒，策死时年二十六。计坚之亡，策应十八；而此表云十七，则为不符。张璠《汉纪》及《吴历》并以坚初平二年死，此为是，而本传误也。","attribution":"裴松之按语","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":255,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-724f2dcc828652965c88","start":208,"end":293,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
