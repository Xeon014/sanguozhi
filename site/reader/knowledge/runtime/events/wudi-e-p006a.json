{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p006a","title":"曹操佯病离间父叔","accounts":[{"id":"wudi-e-p006a-account","label":"《曹瞒传》","text":"《曹瞒传》记曹操佯装中风，使父亲曹嵩不再相信叔父对他的告诫。","evidence":["wudi-e-p006a-q"]}],"participants":[{"person":"cao-cao","role":"佯病","evidence":["wudi-e-p006a-q"]},{"person":"wudi-p0003","role":"听信其说","evidence":["wudi-e-p006a-q"]}],"place":null,"time":{"label":"曹操少年时","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p006a-q"]},"source_order":[1,32,"P006a"],"order":14}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0003","name":"曹嵩","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-p006a-q","section":"chapter-001","block":"b-0cefa3b0c2e2968fd83c","layer":"pei","quote":"﹝一﹞《曹瞒传》云：“太祖少好飞鹰走狗，游荡无度。其叔父数言之于嵩，太祖患之。后逢叔父于路，乃佯败面口。叔父怪而问其故，太祖曰：‘猝中恶风。’叔父以告嵩，嵩惊愕。呼太祖，太祖口貌如故。嵩问曰：‘叔父言汝中风，已差乎？’太祖曰：‘初不中风，但失爱于叔父，故见罔耳。’嵩乃疑焉。自后叔父有所告，嵩终不复信。太祖于是益得肆意矣。”","attribution":"《曹瞒传》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":31,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a493b9d4ce2760e7585c","start":0,"end":163,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
