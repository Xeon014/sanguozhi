{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"liu-cong-surrender","title":"刘琮降曹","order":269,"accounts":[{"id":"liu-cong-surrender-account-1","label":"记载","text":"《武帝纪》记九月曹操到新野，刘琮遂降。","evidence":["surrender"]},{"id":"liu-cong-surrender-account-2","label":"记载","text":"《周瑜传》同记其年九月曹操入荆州、刘琮举众降。","evidence":["zhou-year"]},{"id":"wudi-e-o121c-account","label":"正文","text":"曹操到新野，刘琮投降，刘备逃往夏口。","evidence":["wudi-e-o121c-q"]},{"id":"xianzhu-e-o024b-account","label":"《先主传》正文","text":"刘琮遣使降曹；刘备屯樊，闻曹操到宛后率众离去。","evidence":["xianzhu-e-o024b-q"]},{"id":"dongyuan-e-o089a-account","label":"《董二袁刘传第六》正文","text":"刘琮降曹操刘备奔夏口","evidence":["dongyuan-e-o089a-q"]},{"id":"cuimao-a-8511ebcdbde10aa05b73","label":"裴注·《吴书》","text":"刘表亡曹公向荆州，刘琮以节迎降，诸将疑诈，曹公问娄圭，圭断为至诚，遂进兵","evidence":["cuimao-q-e4c76a262233ce6e6ef6"]},{"id":"lizang-a-586ad0366ea08c466a5b","label":"正文","text":"太祖征荆州，刘琮举州降","evidence":["lizang-q-3c2e146e8eb20fe6cfbc"]}],"participants":[{"person":"cao-cao","role":"受降","evidence":["surrender"]},{"person":"liu-cong","role":"举众投降","evidence":["zhou-year"]},{"person":"liu-bei","role":"率众离樊","evidence":["xianzhu-e-o024b-q"]},{"person":"cuimao-p0027","role":"断为至诚者","evidence":["cuimao-q-e4c76a262233ce6e6ef6"]},{"person":"liu-biao","role":"新亡之荆州牧","evidence":["cuimao-q-e4c76a262233ce6e6ef6"]}],"place":{"text":"新野；荆州","evidence":["surrender","zhou-year"]},"time":{"label":"建安十三年九月","year":208,"precision":"lunar-month","basis":"月份见正文；年次承接本篇十三年，公元年份采用现代注释释年。","evidence":["year-original","year-modern","surrender","zhou-year"],"month":9}}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"cuimao-p0027","name":"娄圭","facts":[],"aliases":[]},{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"liu-biao","name":"刘表","facts":[],"aliases":[]},{"id":"liu-cong","name":"刘琮","facts":[],"aliases":[]}],"evidence":[{"id":"cuimao-q-e4c76a262233ce6e6ef6","section":"chapter-012","block":"b-ecadc2b94d58e0bc3ac4","layer":"pei","quote":"刘表亡，曹公向荆州。表子琮降，以节迎曹公；诸将皆疑诈，曹公以问子伯。子伯曰：‘天下扰攘，各贪王命以自重；今以节来，是必至诚。’曹公曰：‘大善！’遂进兵","attribution":"裴注·《吴书》","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":103,"anchor":null},"note_id":"n-4d3d422b1c33b802fc46","start":257,"end":332},{"id":"dongyuan-e-o089a-q","section":"chapter-006","block":"b-ed6c3abce1fb6b3e0309","layer":"original","quote":"太祖军到襄阳，琮举州降；备走奔夏口。﹝三﹞","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":486,"anchor":null},"note_id":null,"start":0,"end":21},{"id":"lizang-q-3c2e146e8eb20fe6cfbc","section":"chapter-018","block":"b-2cd5dc7dbc155510ae63","layer":"original","quote":"太祖征荆州，琮举州降","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":87,"anchor":null},"note_id":null,"start":31,"end":41},{"id":"surrender","section":"chapter-001","block":"b-031a374e9090ba29242f","quote":"九月，公到新野〖7〗，琮遂降。备走夏口〖8〗。","layer":"original","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":663,"anchor":null},"note_id":null,"start":39,"end":62},{"id":"wudi-e-o121c-q","section":"chapter-001","block":"b-031a374e9090ba29242f","layer":"original","quote":"九月，公到新野〖7〗，琮遂降。备走夏口〖8〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":663,"anchor":null},"note_id":null,"start":39,"end":62},{"id":"xianzhu-e-o024b-q","section":"chapter-032","block":"b-c857386227851cc86ab3","layer":"original","quote":"子琮代立〖2〗，遣使请降。先主屯樊，不知曹公猝至；至宛乃闻之，遂将其众去。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":108,"anchor":null},"note_id":null,"start":22,"end":59},{"id":"year-modern","section":"chapter-001","block":"b-888495d8be7766faf20c","quote":"十三年：建安十三年（公元 208）。","layer":"modern","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":666,"anchor":null},"note_id":"n-0bae348fdb687025113d","start":3,"end":21},{"id":"year-original","section":"chapter-001","block":"b-4bcffcc4ee709a4e5ea3","quote":"十三年春正月〖1〗，公还邺。","layer":"original","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":661,"anchor":null},"note_id":null,"start":0,"end":14},{"id":"zhou-year","section":"chapter-054","block":"b-3661896c106f1817bf4b","quote":"十三年春〖6〗，权讨江夏，瑜为前部大督〖7〗。其年九月，曹公入荆州，刘琮举众降。","layer":"original","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":34,"anchor":null},"note_id":null,"start":0,"end":40}],"profiles":{},"directory_counts":{}}
