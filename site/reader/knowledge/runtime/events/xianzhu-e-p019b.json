{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-p019b","title":"《世语》载刘备跃马过檀溪","accounts":[{"id":"xianzhu-e-p019b-account","label":"《世语》","text":"《世语》称蒯越、蔡瑁欲在宴会中取刘备，刘备骑的卢逃走跃过檀溪；孙盛否定此说。","evidence":["xianzhu-e-p019b-q"]},{"id":"xianzhu-a-p019-sunsheng","label":"孙盛评论","text":"孙盛认为刘备寄居刘表，若有谋害便不能长期无事相处，判此说为世俗妄说。","evidence":["xianzhu-q-p019-sunsheng"]}],"participants":[{"person":"liu-bei","role":"逃走","evidence":["xianzhu-e-p019b-q"]},{"person":"xianzhu-p0032","role":"谋取刘备","evidence":["xianzhu-e-p019b-q"]},{"person":"xianzhu-p0033","role":"谋取刘备","evidence":["xianzhu-e-p019b-q"]}],"place":{"text":"襄阳、檀溪","evidence":["xianzhu-e-p019b-q"]},"time":{"label":"《世语》所述屯樊期间","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xianzhu-e-p019b-q"]},"source_order":[32,107,"P019b"],"order":6529}],"persons":[{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"xianzhu-p0032","name":"蒯越","facts":[],"aliases":[]},{"id":"xianzhu-p0033","name":"蔡瑁","facts":[],"aliases":[]}],"evidence":[{"id":"xianzhu-e-p019b-q","section":"chapter-032","block":"b-9712ba6ad60f4913b802","layer":"pei","quote":"《世语》曰：“备屯樊城，刘表礼焉；惮其为人，不甚信用。曾请备宴会，蒯越、蔡瑁，欲因会取备；备觉之，伪如厕，潜遁出。所乘马名‘的卢’，骑的卢走，坠襄阳城西檀溪水中，溺不得出。备急曰：‘的卢：今日厄矣，可努力！’的卢乃一踊三丈，遂得过；乘桴渡河，中流而追者至，以表意谢之，曰：‘何去之速乎！’”","attribution":"《世语》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":106,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-e77161c4472b3e98758e","start":101,"end":246,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-p019-sunsheng","section":"chapter-032","block":"b-9712ba6ad60f4913b802","layer":"pei","quote":"孙盛曰：“此不然之言。备时羁旅，客主势殊，若有此变，岂敢晏然终表之世而无衅故乎？此皆世俗妄说，非事实也。”","attribution":"孙盛评论","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":106,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-e77161c4472b3e98758e","start":246,"end":299,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
