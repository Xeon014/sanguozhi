{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhangle-e-o027a","title":"孙权遣于禁还曹丕慰喻拜安远将军拟使吴","accounts":[{"id":"zhangle-e-o027a-account","label":"《张乐于张徐传第十七》正文","text":"孙权遣于禁还曹丕慰喻拜安远将军拟使吴","evidence":["zhangle-e-o027a-q"]},{"id":"zhangle-a-p005-judgment","label":"《魏书》载制","text":"制书以荀林父、孟明为例，称樊城系突发水灾，令复于禁等官。","evidence":["zhangle-q-p005-judgment"]}],"participants":[{"person":"sun-quan","role":"遣还","evidence":["zhangle-e-o027a-q"]},{"person":"wudi-p0162","role":"归还受任","evidence":["zhangle-e-o027a-q"]},{"person":"wudi-p0170","role":"慰喻授官","evidence":["zhangle-e-o027a-q"]}],"place":null,"time":{"label":"文帝践阼后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["zhangle-e-o027a-q"]},"ordering_evidence":"zhangle-e-o027a-q","source_order":[17,80,"O027a"],"order":3537}],"persons":[{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"wudi-p0162","name":"于禁","facts":[],"aliases":[]},{"id":"wudi-p0170","name":"曹丕","facts":[],"aliases":[]}],"evidence":[{"id":"zhangle-e-o027a-q","section":"chapter-017","block":"b-0efd3feb5cbcd7a2deea","layer":"original","quote":"文帝践阼，权称藩，遣禁还。帝引见禁，须发皓白，形容憔悴，泣涕顿首。帝慰喻以荀林父、孟明视故事〖14〗。﹝二﹞拜为安远将军〖15〗，欲遣使吴。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":79,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":70,"offset_unit":"unicode_code_point"},{"id":"zhangle-q-p005-judgment","section":"chapter-017","block":"b-61049b77df43aec43cb6","layer":"pei","quote":"﹝二﹞《魏书》载制曰：“昔荀林父败绩于邲，孟明丧师于崤；秦、晋不替，使复其位；其后晋获狄土，秦霸西戎。区区小国，犹尚若斯，而况万乘乎？樊城之败，水灾暴至，非战之咎。其复禁等官。’”","attribution":"《魏书》载制","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":99,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-41fb03570b2431bf37f2","start":0,"end":90,"offset_unit":"unicode_code_point"}],"pr