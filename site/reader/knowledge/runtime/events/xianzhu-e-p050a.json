{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-p050a","title":"刘备遗诏训勉后主","accounts":[{"id":"xianzhu-e-p050a-account","label":"《诸葛亮集》","text":"《诸葛亮集》载刘备遗诏，称射君转述诸葛亮赞后主智量，勉以为善修德并读史书诸子。","evidence":["xianzhu-e-p050a-q"]}],"participants":[{"person":"liu-bei","role":"遗诏","evidence":["xianzhu-e-p050a-q"]},{"person":"xianzhu-p0112","role":"受诫","evidence":["xianzhu-e-p050a-q"]},{"person":"xianzhu-p0126","role":"转述","evidence":["xianzhu-e-p050a-q"]},{"person":"zhuge-liang","role":"被转述赞语","evidence":["xianzhu-e-p050a-q"]}],"place":null,"time":{"year":223,"label":"刘备临终时","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xianzhu-y223","dating_review":{"reviewed":true,"anchor":"xianzhu-q-o073","basis":"刘备临终时"},"evidence":["xianzhu-e-p050a-q","xianzhu-q-o073","xianzhu-q-b-c3a154cca1b5578eba4b"]},"source_order":[32,458,"P050a"],"order":6626}],"persons":[{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"xianzhu-p0112","name":"刘禅","facts":[],"aliases":[]},{"id":"xianzhu-p0126","name":"射君（遗诏所见）","facts":[],"aliases":[]},{"id":"zhuge-liang","name":"诸葛亮","facts":[],"aliases":[]}],"evidence":[{"id":"xianzhu-e-p050a-q","section":"chapter-032","block":"b-bbf1e8d2263342ea3d93","layer":"pei","quote":"《诸葛亮集》载先主遗诏敕后主曰：“朕初疾，但下痢耳；后转杂他病，殆不自济。人五十不称夭，年已六十有余，何所复恨！不复自伤，但以卿兄弟为念！射君到，说丞相叹卿‘智量甚大，增修过于所望’；审能如此，吾复何忧！勉之，勉之！勿以恶小而为之，勿以善小而不为；惟贤惟德，能服于人。汝父德薄，勿效之。可读《汉书》、《礼记》，闲暇历观诸子及《六韬》、《商君书》，益人意智。","attribution":"《诸葛亮集》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":457,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-fe13c85cd9ed1cb581d9","start":3,"end":181,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-b-c3a154cca1b5578eba4b","section":"chapter-032","block":"b-c3a154cca1b5578eba4b","layer":"modern","quote":"〖1〗三年：章武三年（公元 223）。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":435,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-51b38d25bb3f712211d0","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o073","section":"chapter-032","block":"b-4232898cf1bcba6ab843","layer":"original","quote":"三年春二月〖1〗，丞相亮自成都到永安。三月，黄元进兵攻临邛县〖2〗。遣将军陈曶﹝一﹞讨元。元军败，顺流下江；为其亲兵所缚，生致成都，斩之。先主病笃，托孤于丞相亮〖3〗；尚书令李严为副。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":429,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":92,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
