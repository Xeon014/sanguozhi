{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wuzhu-e-o112a","title":"降雹魏以马求珠玑孙权许交易","accounts":[{"id":"wuzhu-e-o112a-account","label":"《吴主传第二》正文","text":"降雹魏以马求珠玑孙权许交易","evidence":["wuzhu-e-o112a-q"]}],"participants":[{"person":"sun-quan","role":"许交易","evidence":["wuzhu-e-o112a-q"]}],"place":null,"time":{"year":235,"label":"秋七月","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"wuzhu-y235","dating_review":{"reviewed":true,"anchor":"wuzhu-q-o111","basis":"秋七月"},"evidence":["wuzhu-e-o112a-q","wuzhu-q-o111","houfei-q-o025","houfei-q-b-e47ffea5cca5eab53d92"]},"ordering_evidence":"wuzhu-e-o112a-q","source_order":[47,563,"O112a"],"order":8324}],"persons":[{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]}],"evidence":[{"id":"houfei-q-b-e47ffea5cca5eab53d92","section":"chapter-005","block":"b-e47ffea5cca5eab53d92","layer":"modern","quote":"〖15〗三年：青龙三年（公元 235）。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":113,"anchor":null},"note_id":"n-4aa0b3373c71cedadeb9","start":0,"end":20},{"id":"houfei-q-o025","section":"chapter-005","block":"b-0744a279ae4c62a54e64","layer":"original","quote":"青龙二年春，追谥后兄俨曰安城乡穆侯。夏，吴贼寇扬州，以像为伏波将军〖12〗，持节，监诸将东征〖13〗。还，复为射声校尉〖14〗。三年薨〖15〗，追赠卫将军，改封魏昌县，谥曰贞侯。子畅嗣。又封畅弟温、4 、艳，皆为列侯。四年〖16〗，改逸、俨本封，皆曰魏昌侯，谥因故〖17〗。封俨世妇刘为东乡君〖18〗，又追封逸世妇张为安喜君。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":97,"anchor":null},"note_id":null,"start":0,"end":163},{"id":"wuzhu-e-o112a-q","section":"chapter-047","block":"b-833cef22df921687e15e","layer":"original","quote":"秋七月，有雹。魏使以马求易珠玑、翡翠、玳瑁〖14〗。权曰：“此皆孤所不用，而可得马；何苦而不听其交易？”","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":51,"anchor":null},"note_id":null,"start":0,"end":52},{"id":"wuzhu-q-o111","section":"chapter-047","block":"b-fb2c79bf54078d88d523","layer":"original","quote":"四年夏〖13〗，遣吕岱讨桓等。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":50,"anchor":null},"note_id":null,"start":0,"end":15}],"profiles":{},"directory_counts":{}}
