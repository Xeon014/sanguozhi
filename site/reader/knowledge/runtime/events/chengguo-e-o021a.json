{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"chengguo-e-o021a","title":"帝引见放资问燕王放资赞成曹爽召宣王作诏","accounts":[{"id":"chengguo-a-40e78d8a460f31420b28","label":"正文","text":"帝引见放资问燕王放资赞成曹爽召宣王作诏","evidence":["chengguo-q-f011a8cc6ba0bc34d500"]}],"participants":[{"person":"wendi-p0005","role":"引见放资、问燕王正尔为、曰曹爽可代宇不、纳其言","evidence":["chengguo-q-f011a8cc6ba0bc34d500"]},{"person":"mingdi-p0106","role":"对燕王自知不堪、赞成曹爽、深陈宜速召宣王、受黄纸作诏","evidence":["chengguo-q-f011a8cc6ba0bc34d500"]},{"person":"mingdi-p0075","role":"同对赞成","evidence":["chengguo-q-f011a8cc6ba0bc34d500"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["chengguo-q-f011a8cc6ba0bc34d500"]},"ordering_evidence":"chengguo-q-f011a8cc6ba0bc34d500","source_order":[14,513,0],"related_events":[{"event":"chengguo-e-p164","type":"alternative","evidence":["chengguo-q-f011a8cc6ba0bc34d500","chengguo-q-029b7356f91faf07f7f6"],"note":"本传与《世语》关于受遗树置先后不同，保留两源。"}],"order":3206},{"id":"chengguo-e-p164","title":"放资惧献肇劝帝召宣王","accounts":[{"id":"chengguo-a-57f544888b2b28090709","label":"裴注·《世语》","text":"放资惧献肇劝帝召宣王","evidence":["chengguo-q-029b7356f91faf07f7f6"]}],"participants":[{"person":"mingdi-p0106","role":"久典机任、惧、乃劝帝召宣王、对曰曹爽、蹑爽足耳之曰臣以死奉社稷","evidence":["chengguo-q-029b7356f91faf07f7f6"]},{"person":"mingdi-p0075","role":"同惧、同劝","evidence":["chengguo-q-029b7356f91faf07f7f6"]},{"person":"mingdi-p0104","role":"心内不平、殿中指鸡栖树相谓","evidence":["chengguo-q-029b7356f91faf07f7f6"]},{"person":"mingdi-p0105","role":"心内不平","evidence":["chengguo-q-029b7356f91faf07f7f6"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["chengguo-q-029b7356f91faf07f7f6"]},"ordering_evidence":"chengguo-q-029b7356f91faf07f7f6","source_order":[14,534,10],"order":3219}],"persons":[{"id":"mingdi-p0075","name":"孙资","facts":[],"aliases":[]},{"id":"mingdi-p0106","name":"刘放","facts":[],"aliases":[]},{"id":"wendi-p0005","name":"曹叡","facts":[],"aliases":[]}],"evidence":[{"id":"chengguo-q-029b7356f91faf07f7f6","section":"chapter-014","block":"b-a638d9784fc427a6f989","layer":"pei","quote":"放、资久典机任，献、肇心内不平。殿中有鸡栖树，二人相谓：‘此亦久矣！其能复几？’指谓放、资。放、资惧，乃劝帝召宣王。帝作手诏，令给使辟邪，至以授宣王。宣王在汲，献等先诏，令于轵关西还长安；辟邪又至，宣王疑有变。呼辟邪具问，乃乘追锋车驰至京师。帝问放、资：‘谁可与太尉对者？’放曰：‘曹爽。’帝曰：‘堪其事不？’爽在左右，流汗不能对。放蹑其足，耳之曰：‘臣以死奉社稷！’","attribution":"正文","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":533,"anchor":null},"note_id":"n-f69dd3b4e827e95f0087","start":10,"end":194},{"id":"chengguo-q-f011a8cc6ba0bc34d500","section":"chapter-014","block":"b-0658bbe4420b47d45ac8","layer":"original","quote":"帝引见放、资，入卧内。问曰：“燕王正尔为〖3〗？”放、资对曰：“燕王实自知不堪大任故耳。”帝曰：“曹爽可代宇不？”放、资因赞成之；又深陈宜速召太尉司马宣王，以纲维皇室。帝纳其言，即以黄纸授放作诏〖4〗","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":512,"anchor":null},"note_id":null,"start":0,"end":100}],"profiles":{},"directory_counts":{}}
