{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"shaodi-e-o115a","title":"邓艾上邽破姜维诏犒军","accounts":[{"id":"shaodi-e-o115a-account","label":"《三少帝纪》正文","text":"邓艾上邽破姜维诏犒军","evidence":["shaodi-e-o115a-q"]},{"id":"houzhu-a-split-9fce87d47998","label":"《后主传》正文","text":"邓艾在上邽击败姜维","evidence":["houzhu-q-O067"]},{"id":"jfj-a-o043c","label":"正文 · 延熙十九年","text":"姜维段谷败于邓艾","evidence":["jfj-q0163"]},{"id":"wgc-a-3-e29","label":"正文 · 其夜渡渭东行后","text":"邓艾大破姜维于段谷","evidence":["wgc-q0361","wgc-q0359"]}],"participants":[{"person":"shaodi-p0080","role":"破敌","evidence":["shaodi-e-o115a-q"]},{"person":"shaodi-p0050","role":"战败","evidence":["shaodi-e-o115a-q"]}],"place":{"text":"上邽","evidence":["shaodi-q-o115"]},"time":{"year":256,"label":"七月癸未","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"shaodi-y256","dating_review":{"reviewed":true,"anchor":"shaodi-q-o080","basis":"七月癸未"},"evidence":["shaodi-e-o115a-q","shaodi-q-o080","shaodi-q-o117","shaodi-q-b-6209c552405e0ebbdf98"]},"ordering_evidence":"shaodi-e-o115a-q","source_order":[4,509,"O115a"],"order":1175}],"persons":[{"id":"shaodi-p0050","name":"姜维","facts":[],"aliases":[]},{"id":"shaodi-p0080","name":"邓艾","facts":[],"aliases":[]}],"evidence":[{"id":"houzhu-q-O067","section":"chapter-033","block":"b-675808f55be844a65e02","layer":"original","quote":"秋八月，维为魏大将军邓艾所破于上邽，维退军还成都。是岁，立子瓒为新干王。大赦。","section_title":"后主传第三","source":{"file":"OEBPS/Text/titlepage_0072.xhtml","index":125,"anchor":null},"note_id":null,"start":0,"end":39},{"id":"jfj-q0163","section":"chapter-044","block":"b-39e4cd8abbef79354a43","layer":"original","quote":"故维为魏大将邓艾所破于段谷。星散流离，死者甚众，众庶由是怨讟〖7〗；而陇以西亦骚动不宁","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":196,"anchor":null},"note_id":null,"start":44,"end":87},{"id":"shaodi-e-o115a-q","section":"chapter-004","block":"b-5e29f5fd2ed894b02a53","layer":"original","quote":"癸未〖6〗，安西将军邓艾，大破蜀大将姜维于上邽〖7〗。诏曰：“兵未极武〖8〗，丑虏摧破。斩首获生，动以万计。自顷战克，无如此者。今遣使者犒赐将士，大会临飨，饮宴终日。称朕意焉。”八月，庚午〖9〗，命大将军司马文王加号大都督，奏事不名，假黄钺。癸酉〖10〗，以太尉司马孚为太傅。九月，以司徒高柔为太尉。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":508,"anchor":null},"note_id":null,"start":0,"end":150},{"id":"shaodi-q-b-6209c552405e0ebbdf98","section":"chapter-004","block":"b-6209c552405e0ebbdf98","layer":"modern","quote":"〖1〗二年：甘露二年（公元 257 ）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":535,"anchor":null},"note_id":"n-4dd98e402a6a8de51491","start":0,"end":20},{"id":"shaodi-q-o080","section":"chapter-004","block":"b-5e69a7d6a960c6ff6623","layer":"original","quote":"甘露元年春正月辛丑〖1〗，青龙现轵县井中〖2〗。乙巳〖3〗，沛王林薨〖4〗。﹝一﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":386,"anchor":null},"note_id":null,"start":0,"end":41},{"id":"shaodi-q-o115","section":"chapter-004","block":"b-5e29f5fd2ed894b02a53","layer":"original","quote":"癸未〖6〗，安西将军邓艾，大破蜀大将姜维于上邽〖7〗。诏曰：“兵未极武〖8〗，丑虏摧破。斩首获生，动以万计。自顷战克，无如此者。今遣使者犒赐将士，大会临飨，饮宴终日。称朕意焉。”八月，庚午〖9〗，命大将军司马文王加号大都督，奏事不名，假黄钺。癸酉〖10〗，以太尉司马孚为太傅。九月，以司徒高柔为太尉。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":508,"anchor":null},"note_id":null,"start":0,"end":150},{"id":"shaodi-q-o117","section":"chapter-004","block":"b-d021e0b00f489a01f208","layer":"original","quote":"二年春二月〖1〗，青龙现温县井中。三月，司空卢毓薨。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":522,"anchor":null},"note_id":null,"start":0,"end":26},{"id":"wgc-q0359","section":"chapter-028","block":"b-7d6fd411dbae89ba4690","layer":"original","quote":"顷之，维果向祁山；闻艾已有备，乃回从董亭趋南安〖15〗。艾据武城山以相持〖16〗。维与艾争险，不克。其夜，渡渭东行，缘山趋上邽；艾与战于段谷〖17〗，大破之。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":298,"anchor":null},"note_id":null,"start":0,"end":79},{"id":"wgc-q0361","section":"chapter-028","block":"b-7d6fd411dbae89ba4690","layer":"original","quote":"其夜，渡渭东行，缘山趋上邽；艾与战于段谷〖17〗，大破之","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":298,"anchor":null},"note_id":null,"start":50,"end":78}],"profiles":{},"directory_counts":{}}
