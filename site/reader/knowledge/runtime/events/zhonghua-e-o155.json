1f","layer":"pei","quote":"后马超反，超劫洪，将诣华阴，使作露布；洪不获已，为作之。司徒钟繇在东，识其文，曰：‘此贾洪作也！’","attribution":"裴注·魏略","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":516,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-29aaab3281d7871e6af5","start":97,"end":146,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
