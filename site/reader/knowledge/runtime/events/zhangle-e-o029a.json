{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhangle-e-o029a","title":"张郃劝救乌巢郭图主攻曹营袁绍未用重兵救粮","accounts":[{"id":"zhangle-e-o029a-account","label":"《张乐于张徐传第十七》正文","text":"张郃劝救乌巢郭图主攻曹营袁绍未用重兵救粮","evidence":["zhangle-e-o029a-q"]}],"participants":[{"person":"wudi-p0183","role":"献策","evidence":["zhangle-e-o029a-q"]},{"person":"wudi-p0174","role":"献策","evidence":["zhangle-e-o029a-q"]},{"person":"wudi-p0052","role":"决策","evidence":["zhangle-e-o029a-q"]}],"place":null,"time":{"label":"官渡之战时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["zhangle-e-o029a-q"]},"ordering_evidence":"zhangle-e-o029a-q","source_order":[17,102,"O029a"],"order":3541}],"persons":[{"id":"wudi-p0052","name":"袁绍","facts":[],"aliases":[]},{"id":"wudi-p0174","name":"郭图","facts":[],"aliases":[]},{"id":"wudi-p0183","name":"张郃","facts":[],"aliases":[]}],"evidence":[{"id":"zhangle-e-o029a-q","section":"chapter-017","block":"b-a4ccf00fcd84c9fc6e1a","layer":"original","quote":"太祖与袁绍相拒于官渡。﹝一﹞绍遣将淳于琼等督运，屯乌巢，太祖自将急击之。郃说绍曰：“曹公兵精，往必破琼等；琼等破，则将军事去矣：宜急引兵救之！”郭图曰：“郃计非也！不如攻其本营，势必还；此为不救而自解也。”郃曰：“曹公营固，攻之必不拔；若琼等见擒，吾属尽为虏矣。”绍但遣轻骑救琼；而以重兵攻太祖营，不能下。","section_title":"张乐于张徐传第十七","source":{"file":"OEBPS/Text/titlepage_0039.xhtml","index":101,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":153,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
