{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"santizhu064-e-sr-whiteheaded-bird","title":"《江表传》白头乌之对、张昭难而恪反诘","accounts":[{"id":"santizhu064-a-bee6c1c670b1c4ed9641","label":"裴注·江表传","text":"殿前白头乌，权问何鸟，恪答白头翁；张昭自以最老疑恪戏己，请使求白头母；恪答鸟名鹦母未必有对，试使辅吴复求鹦父，昭不能答，坐中皆欢笑","evidence":["santizhu064-q-489c85a7ee0acc775820"]}],"participants":[{"person":"sun-quan","role":"发问者","evidence":["santizhu064-q-489c85a7ee0acc775820"]},{"person":"shaodi-p0041","role":"作答并反诘","evidence":["santizhu064-q-489c85a7ee0acc775820"]},{"person":"wendi-p0133","role":"发难而不能答","evidence":["santizhu064-q-489c85a7ee0acc775820"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"未由相邻段落推算纪年；原文时间表达保留在来源引句中。","evidence":["santizhu064-q-489c85a7ee0acc775820"]},"ordering_evidence":"santizhu064-q-489c85a7ee0acc775820","source_order":[64,29,0],"order":10930}],"persons":[{"id":"shaodi-p0041","name":"诸葛恪","facts":[],"aliases":[]},{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"wendi-p0133","name":"张昭","facts":[],"aliases":[]}],"evidence":[{"id":"santizhu064-q-489c85a7ee0acc775820","section":"chapter-064","block":"b-9a2ac3925d7629b42062","layer":"pei","quote":"《江表传》曰：“曾有白头乌集殿前。权曰：‘此何鸟也？’恪曰：‘白头翁也。’张昭自以坐中最老，疑恪以鸟戏之。因曰：‘恪欺陛下，未尝闻鸟名白头翁者！试使恪复求白头母。’恪曰：‘鸟名鹦母，未必有对；试使辅吴，复求鹦父。’昭不能答，坐中皆欢笑。”","attribution":"裴注·江表传","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":28,"anchor":null},"note_id":"n-12b3579a9c9a4da79693","start":0,"end":119}],"profiles":{},"directory_counts":{}}
