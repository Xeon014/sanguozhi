{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-o032a","title":"殷观劝刘备婉拒孙权共取蜀","accounts":[{"id":"xianzhu-e-o032a-account","label":"《先主传》正文","text":"孙权请求共同取蜀，殷观劝刘备口头赞同、以新据诸郡为由不发兵，使吴不能越境独取。","evidence":["xianzhu-e-o032a-q"]}],"participants":[{"person":"sun-quan","role":"遣使邀约","evidence":["xianzhu-e-o032a-q"]},{"person":"xianzhu-p0044","role":"进策","evidence":["xianzhu-e-o032a-q"]},{"person":"liu-bei","role":"听取","evidence":["xianzhu-e-o032a-q"]}],"place":null,"time":{"label":"入益州前","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xianzhu-e-o032a-q"]},"source_order":[32,139,"O032a"],"order":6550}],"persons":[{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"xianzhu-p0044","name":"殷观","facts":[],"aliases":[]}],"evidence":[{"id":"xianzhu-e-o032a-q","section":"chapter-032","block":"b-b7a5a5ed00e0ae31882d","layer":"original","quote":"权遣使云“欲共取蜀”，或以为“宜报听许，吴终不能越荆有蜀，蜀地可为己有”。荆州主簿殷观进曰〖7〗：“若为吴先驱；进未能克蜀，退为吴所乘，即事去矣。今但可然赞其伐蜀〖8〗；而自说新据诸郡，未可兴动〖9〗：吴必不敢越我而独取蜀。如此进退之计，可以收吴、蜀之利。”","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":138,"anchor":null},"note_id":null,"start":0,"end":129}],"profiles":{},"directory_counts":{}}
