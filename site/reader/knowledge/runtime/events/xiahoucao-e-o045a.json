{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xiahoucao-e-o045a","title":"曹叡遣司马懿曹休两道征吴","accounts":[{"id":"xiahoucao-e-o045a-account","label":"《诸夏侯曹传第九》正文","text":"曹叡遣司马懿曹休两道征吴","evidence":["xiahoucao-e-o045a-q"]}],"participants":[{"person":"wendi-p0005","role":"遣征","evidence":["xiahoucao-e-o045a-q"]},{"person":"wudi-p0364","role":"出军","evidence":["xiahoucao-e-o045a-q"]},{"person":"wendi-p0039","role":"督军","evidence":["xiahoucao-e-o045a-q"]}],"place":null,"time":{"year":228,"label":"太和二年","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xiahoucao-y228","dating_review":{"reviewed":true,"anchor":"xiahoucao-q-o045","basis":"太和二年"},"evidence":["xiahoucao-e-o045a-q","xiahoucao-q-o045","luxun-q-o027","luxun-q-b-537c2ab6aaf33280136b"]},"ordering_evidence":"xiahoucao-e-o045a-q","source_order":[9,193,"O045a"],"order":2223}],"persons":[{"id":"wendi-p0005","name":"曹叡","facts":[],"aliases":[]},{"id":"wendi-p0039","name":"曹休","facts":[],"aliases":[]},{"id":"wudi-p0364","name":"司马懿","facts":[],"aliases":[]}],"evidence":[{"id":"luxun-q-b-537c2ab6aaf33280136b","section":"chapter-058","block":"b-537c2ab6aaf33280136b","layer":"modern","quote":"〖1〗七年：黄武七年（公元 228）。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":139,"anchor":null},"note_id":"n-26a3d21704231c7e2739","start":0,"end":19},{"id":"luxun-q-o027","section":"chapter-058","block":"b-1dfb331a9884eb630d46","layer":"original","quote":"七年〖1〗，权使鄱阳太守（孙）〔周〕鲂，谲魏大司马曹休：休果举众入皖〖2〗。乃召逊，假黄钺〖3〗，为大都督，逆休。﹝一﹞休既觉知，耻见欺诱；自恃兵马精多，遂交战。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":135,"anchor":null},"note_id":null,"start":0,"end":81},{"id":"xiahoucao-e-o045a-q","section":"chapter-009","block":"b-772f3a3de27ca1a3e015","layer":"original","quote":"太和二年，帝为二道征吴，遣司马宣王从汉水下，（督休）〔休督〕诸军向寻阳。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":192,"anchor":null},"note_id":null,"start":0,"end":36},{"id":"xiahoucao-q-o045","section":"chapter-009","block":"b-772f3a3de27ca1a3e015","layer":"original","quote":"太和二年，帝为二道征吴，遣司马宣王从汉水下，（督休）〔休督〕诸军向寻阳。贼将伪降〖12〗，休深入；战不利，退还宿石亭。军夜惊，士卒乱，弃甲兵辎重甚多。休上书，谢罪；帝遣屯骑校尉杨暨慰谕，礼赐益隆。休因此痈发背薨〖13〗。谥曰壮侯。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":192,"anchor":null},"note_id":null,"start":0,"end":115}],"profiles":{},"directory_counts":{}}
