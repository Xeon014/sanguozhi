{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"shaodi-e-o045a","title":"王凌任太尉","accounts":[{"id":"shaodi-e-o045a-account","label":"《三少帝纪》正文","text":"王凌任太尉","evidence":["shaodi-e-o045a-q"]},{"id":"wgc-a-0-e22","label":"正文","text":"王凌进为太尉假节钺","evidence":["wgc-q0165","wgc-q0006"]}],"participants":[{"person":"shaodi-p0004","role":"受任","evidence":["shaodi-e-o045a-q"]}],"place":null,"time":{"year":249,"label":"辛卯","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"shaodi-y249","dating_review":{"reviewed":true,"anchor":"shaodi-q-o043","basis":"辛卯"},"evidence":["shaodi-e-o045a-q","shaodi-q-o043","shaodi-q-o046","shaodi-q-b-33155276d789f594176b"]},"ordering_evidence":"shaodi-e-o045a-q","source_order":[4,183,"O045a"],"order":1059}],"persons":[{"id":"shaodi-p0004","name":"王凌","facts":[],"aliases":[]}],"evidence":[{"id":"shaodi-e-o045a-q","section":"chapter-004","block":"b-34c3571f78f38e0864ec","layer":"original","quote":"冬十二月，辛卯〖10〗，以司空王凌为太尉。庚子〖11〗，以司隶校尉孙礼为司空〖12〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":182,"anchor":null},"note_id":null,"start":0,"end":43},{"id":"shaodi-q-b-33155276d789f594176b","section":"chapter-004","block":"b-33155276d789f594176b","layer":"modern","quote":"〖13〗二年：嘉平二年（公元 250）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":198,"anchor":null},"note_id":"n-235bc158a4eae2a0609a","start":0,"end":20},{"id":"shaodi-q-o043","section":"chapter-004","block":"b-b1c990928436e9ed43da","layer":"original","quote":"嘉平元年春正月，甲午〖1〗，车驾谒高平陵。﹝一﹞太傅司马宣王奏免大将军曹爽、爽弟中领军羲、武卫将军训、散骑常侍彦官〖2〗，以侯就第。戊戌〖3〗，有司奏收黄门张当付廷尉〖4〗；考实其辞，爽与谋不轨。又尚书丁谧、邓飏、何晏，司隶校尉毕轨，荆州刺史李胜，大司农桓范，皆与爽通奸谋〖5〗，夷三族。语在《爽传》。丙午〖6〗，大赦。丁未〖7〗，以太傅司马宣王为丞相；固让，乃止。﹝二﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":180,"anchor":null},"note_id":null,"start":0,"end":186},{"id":"shaodi-q-o046","section":"chapter-004","block":"b-8bc97b77985c9cc83eeb","layer":"original","quote":"二年夏五月〖13〗，以征西将军郭淮为车骑将军〖14〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":183,"anchor":null},"note_id":null,"start":0,"end":27},{"id":"wgc-q0006","section":"chapter-028","block":"b-48d8a8c3b1b7a3ef24e8","layer":"original","quote":"是时，凌外甥令狐愚以才能为兖州刺史，屯平阿〖3〗。舅甥并典兵，专淮南之重。凌就迁为司空〖4〗。司马宣王既诛曹爽，进凌为太尉，假节、钺。凌、愚密协计，谓齐王不任天位〖5〗，楚王彪长而才〖6〗，欲迎立彪都许昌。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":22,"anchor":null},"note_id":null,"start":0,"end":103},{"id":"wgc-q0165","section":"chapter-028","block":"b-48d8a8c3b1b7a3ef24e8","layer":"original","quote":"进凌为太尉，假节、钺","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":22,"anchor":null},"note_id":null,"start":56,"end":66}],"profiles":{},"directory_counts":{}}
