{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"cuimao-e2-maojie-pushe","title":"《毛玠传》记毛玠为尚书仆射","accounts":[{"id":"cuimao-a-575b4fd194918474872c","label":"正文","text":"本传记毛玠为尚书仆射；《魏氏春秋》魏初清单记凉茂为仆射、毛玠为尚书。","evidence":["cuimao-q-5d4a4cfe1d0dc9e816a8","cuimao-q2-0df6e379d9342b276a19"]}],"participants":[{"person":"wudi-p0301","role":"魏国初建，为尚书仆射，复典选举","evidence":["cuimao-q2-0df6e379d9342b276a19"]}],"place":null,"time":{"label":"魏国初建","precision":"undated","basis":"第二轮逐项审定；仅保原文时序，不另行推年。","evidence":["cuimao-q2-0df6e379d9342b276a19"]},"ordering_evidence":"cuimao-q2-0df6e379d9342b276a19","order":2760}],"persons":[{"id":"wudi-p0301","name":"毛玠","facts":[],"aliases":[]}],"evidence":[{"id":"cuimao-q-5d4a4cfe1d0dc9e816a8","section":"chapter-012","block":"b-1fad2e8748149fe35370","layer":"original","quote":"魏国初建，为尚书仆射，复典选举","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":110,"anchor":null},"note_id":null,"start":94,"end":109},{"id":"cuimao-q2-0df6e379d9342b276a19","section":"chapter-012","block":"b-1fad2e8748149fe35370","layer":"original","quote":"初，太祖平柳城，班所获器物〖14〗；特以素屏风、素凭几赐玠，曰：“君有古人之风，故赐君古人之服〖15〗。”玠居显位，常布衣蔬食，抚育孤兄子甚笃；赏赐以赈施贫族，家无所余。迁右军师〖16〗。魏国初建，为尚书仆射，复典选举。﹝一﹞","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":110,"anchor":null},"note_id":null,"start":0,"end":113}],"profiles":{},"directory_counts":{}}
