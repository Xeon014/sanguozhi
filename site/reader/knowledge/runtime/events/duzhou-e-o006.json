{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"duzhou-e-o006","title":"杜微乞归亮复书挽留","accounts":[{"id":"duzhou-a-a65d1229508022f03e57","label":"正文","text":"杜微乞归亮复书挽留","evidence":["duzhou-q-0576ff9abd6985578439","duzhou-q2-7e5f7551749d5933a4ef"]}],"participants":[{"person":"duzhou-p0038","role":"自乞老病求归","evidence":["duzhou-q-0576ff9abd6985578439"]},{"person":"zhuge-liang","role":"复书答杜微","evidence":["duzhou-q-0576ff9abd6985578439"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["duzhou-q-0576ff9abd6985578439"]},"ordering_evidence":"duzhou-q-0576ff9abd6985578439","source_order":[42,5,0],"order":7470}],"persons":[{"id":"duzhou-p0038","name":"杜微","facts":[],"aliases":[]},{"id":"zhuge-liang","name":"诸葛亮","facts":[],"aliases":[]}],"evidence":[{"id":"duzhou-q-0576ff9abd6985578439","section":"chapter-042","block":"b-d34749af9587529c3386","layer":"original","quote":"微自乞老病求归，亮又与书答曰","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":4,"anchor":null},"note_id":null,"start":0,"end":14},{"id":"duzhou-q2-7e5f7551749d5933a4ef","section":"chapter-042","block":"b-d34749af9587529c3386","layer":"original","quote":"微自乞老病求归，亮又与书答曰：“曹丕篡弑，自立为帝，是犹土龙、刍狗之有名也〖17〗。欲与群贤因其邪伪，以正道灭之；怪君未有相诲，便欲求还于山野。丕又大兴劳役〖18〗，以向吴、楚〖19〗。今因丕多务，且以闭境（勤）〔劝〕农，育养民物〖20〗，并治甲兵，以待其挫；然后伐之，可使兵不战民不劳而天下定也。君但当以德辅时耳〖21〗，不责君军事〖22〗；何为汲汲欲求去乎〖23〗？”其敬微如此。","section_title":"杜周杜许孟来尹李谯郤传第十二","source":{"file":"OEBPS/Text/titlepage_0090.xhtml","index":4,"anchor":null},"note_id":null,"start":0,"end":192}],"profiles":{},"directory_counts":{}}
