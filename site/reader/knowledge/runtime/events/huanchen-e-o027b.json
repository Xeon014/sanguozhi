{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"huanchen-e-o027b","title":"帝徙民实谯毓表徙民于梁失意左迁典农校尉躬视利民","accounts":[{"id":"huanchen-a-fb2e70ebb321f5f4a781","label":"正文","text":"帝徙民实谯毓表徙民于梁失意左迁典农校尉躬视利民","evidence":["huanchen-q-d16bc34634f355a0b703"]}],"participants":[{"person":"wudi-p0170","role":"以谯旧乡大徙民屯田、听毓所表而心恨之、遂左迁毓","evidence":["huanchen-q-d16bc34634f355a0b703"]},{"person":"wendi-p0127","role":"上表徙民于梁国、将徙民为睢阳典农校尉、躬自临视择美田","evidence":["huanchen-q-d16bc34634f355a0b703"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["huanchen-q-d16bc34634f355a0b703"]},"ordering_evidence":"huanchen-q-d16bc34634f355a0b703","source_order":[22,542,28],"order":4636}],"persons":[{"id":"wendi-p0127","name":"卢毓","facts":[],"aliases":[]},{"id":"wudi-p0170","name":"曹丕","facts":[],"aliases":[]}],"evidence":[{"id":"huanchen-q-d16bc34634f355a0b703","section":"chapter-022","block":"b-6410529d6721f90c5fb3","layer":"original","quote":"帝以谯旧乡〖2〗，故大徙民充之，以为屯田〖3〗。而谯土地_瘠〖4〗，百姓穷困；毓愍之，上表徙民于梁国就沃衍〖5〗，失帝意。虽听毓所表，心犹恨之；遂左迁毓〖6〗，使将徙民为睢阳典农校尉〖7〗。毓心在利民，躬自临视〖8〗，择居美田，百姓赖之。迁安平、广平太守〖9〗，所在有惠化","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":541,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":28,"end":164,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
