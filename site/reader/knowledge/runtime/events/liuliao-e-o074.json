{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"liuliao-e-o074","title":"李严劝诸葛亮受九锡诸葛亮答书辞之","accounts":[{"id":"liuliao-a-8afd09332f2d87d35396","label":"裴注·诸葛亮集","text":"李严劝诸葛亮受九锡诸葛亮答书辞之","evidence":["liuliao-q-716dee365c945803524b"]}],"participants":[{"person":"xianzhu-p0057","role":"与书劝受九锡进爵称王","evidence":["liuliao-q-716dee365c945803524b"]},{"person":"zhuge-liang","role":"答书辞之，称灭魏后方可受","evidence":["liuliao-q-716dee365c945803524b"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liuliao-q-716dee365c945803524b"]},"ordering_evidence":"liuliao-q-716dee365c945803524b","source_order":[40,233,0],"order":7293}],"persons":[{"id":"xianzhu-p0057","name":"李严","facts":[],"aliases":[]},{"id":"zhuge-liang","name":"诸葛亮","facts":[],"aliases":[]}],"evidence":[{"id":"liuliao-q-716dee365c945803524b","section":"chapter-040","block":"b-b7fb0234d7ee29d6d610","layer":"pei","quote":"﹝一﹞《诸葛亮集》有严与亮书，劝亮“宜受九锡，进爵称王”。亮答书曰：“吾与足下，相知久矣，可不复相解？足下方诲以光国，戒之以勿拘之道，是以未得默已。吾本东方下士，误用于先帝，位极人臣，禄赐百亿；今讨贼未效，知己未答，而方宠齐、晋，坐自贵大：非其义也！若灭魏斩叡，帝还故居，与诸子并升；虽十命可受，况于九邪！”","attribution":"裴注·诸葛亮集","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":232,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5a055cf50316f478bc8d","start":0,"end":154,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
