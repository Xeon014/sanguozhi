1a1a12d","chapter-013":"24c6e486e7f78fc4d59ff01277b36cb77ffb69c68a6a9030889fe00efe4b3d27","chapter-016":"6cfac20452f269a832b087d2e808cc4b3017944d17dca1d5b1e068ebb98d8327","chapter-018":"7a62f43c1f5dc64661b088ef0fdd48392063ef5c49001fa980aa65e766380b23","chapter-019":"a43f6648e6c9d8389d561bee9d00824665f8f06542ab2a65aac06ed8a7601c5b","chapter-020":"2ef7e28be018140e07d27d7636a9df480a5cb7ef1cb3572c314a70e0d1acd07c","chapter-050":"71faaaddb69f25a5bdd7f315f15562e867eed9e897c9bd439a99a09c435bfe91","chapter-023":"908d4e64a01e171bdb09c0a7ee5484b8743be26b7cc75f49bd8b41b7ff391ff2","chapter-024":"39be893c0040dbb3148f9447402c47fc24dcb4356360f8558243258cb85b089a","chapter-025":"f37fc365e7d07f96b5fd289119e1846fe7f0030d8b46a7195fab316badf817b7","chapter-027":"dd48b2052380e1f6b6f6ffcb4835dd99cfe70efe4a9096fa51448dbdfaa14f00","chapter-062":"7031fb8ebde1ea3c95cdedcf93218fb46f69a71a29a1d9e82361f7108436a86a","chapter-063":"3ae8edfbae98c3e86a518f7022c664ed35a0d68d5ac36b331ceb560e76b1848f","chapter-065":"13c50dd7dc9a229aef1cfb43dd231955a0b1a6359dab04c54708df93fa114e12","chapter-057":"39e3922e223fe25b811b77f14049327071298549de6ed788ba7da697f067f2e3","chapter-021":"18c02b71e8f81644cf71ffea582a8e019509de0b5e9bc11451de595fa03e2cf3","chapter-029":"6ffb35bac29d20aa512b5a734e72f98ec5729b176f1bc5d6837e673bcc00880d","chapter-030":"3e0682212c3e242d0f221308bc203bd8309851b8498b94db16383bdde5234ce1"},"events":[{"id":"panlu-e-o030","title":"凯上疏谏徙都","accounts":[{"id":"panlu-a-1dfb20293926d9c63c39","label":"正文","text":"凯谏徙都疏全文（整篇文书账户）：自“臣闻有道之君”至“愿陛下留神，思臣愚言”","evidence":["panlu-q-00001ed2e58c884fe113","panlu-q-43afae7e173c267197bd","panlu-q-5054a2339e847c71d6f5","panlu-q-c19672baf1a1713d7bc7","panlu-q-94b28acc20c474534b31","panlu-q-453b3ef3acd5d4f749dd","panlu-q-d3cb4405b29d90bd505a","panlu-q-ad481f7667ce339be6e8","panlu-q-69f4351ba65f9933af32","panlu-q-cc4274a6ee0f58b2e2b5"]}],"participants":[{"person":"wuzhu-p0115","role":"上疏谏徙都","evidence":["panlu-q-00001ed2e58c884fe113"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["panlu-q-00001ed2e58c884fe113","panlu-q-43afae7e173c267197bd","panlu-q-5054a2339e847c71d6f5","panlu-q-c19672baf1a1713d7bc7","panlu-q-94b28acc20c474534b31","panlu-q-453b3ef3acd5d4f749dd","panlu-q-d3cb4405b29d90bd505a","panlu-q-ad481f7667ce339be6e8","panlu-q-69f4351ba65f9933af32","panlu-q-cc4274a6ee0f58b2e2b5"]},"ordering_evidence":"panlu-q-00001ed2e58c884fe113","source_order":[61,61,23],"order":10741}],"persons":[{"id":"wuzhu-p0115","name":"陆凯","facts":[],"aliases":[]}],"evidence":[{"id":"panlu-q-00001ed2e58c884fe113","section":"chapter-061","block":"b-ccd2ca2f368117883cd0","layer":"original","quote":"又政事多谬，黎元穷匮〖2〗。凯上疏曰：","section_title":"潘濬陆凯传第十六","source":{"file":"OEBPS/Text/titlepage_0129.xhtml","index":60,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":23,"end":42,"offset_unit":"unicode_code_point"},{"id":"panlu-q-43afae7e173c267197bd","section":"chapter-061","block":"b-a19dd35ebb6d47f60802","layer":"original","quote":"臣闻有道之君，以乐乐民；无道之君，以乐乐身。乐民者，其乐弥长；乐身者，不乐而亡。夫民者，国之根也；诚宜重其食，爱其命。民安则君安，民乐则君乐。","section_title":"潘濬陆凯传第十六","source":{"file":"OEBPS/Text/titlepage_0129.xhtml","index":61,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":71,"offset_unit":"unicode_code_point"},{"id":"panlu-q-453b3ef3acd5d4f749dd","section":"chapter-061","block":"b-6fe944240d9325896d33","layer":"original","quote":"又武昌土地，实危险而瘠确〖23〗，非王都安国养民之处；船泊则沉漂，陵居则峻危〖24〗。且童谣言：“宁饮建业水，不食武昌鱼；宁还建业死，不止武昌居！”臣闻翼星为变〖25〗，荧惑作妖〖26〗；童谣之言，生于天心，乃以安居而比死：足明天意，知民所苦也。","section_title":"潘濬陆凯传第十六","source":{"file":"OEBPS/Text/titlepage_0129.xhtml","index":65,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":123,"offset_unit":"unicode_code_point"},{"id":"panlu-q-5054a2339e847c71d6f5","section":"chapter-061","block":"b-1de3d3b77decb1853e50","layer":"original","quote":"自顷年以来，君威伤于桀、纣〖3〗，君明暗于奸雄，君惠闭于群孽〖4〗。无灾而民命尽，无为而国财空；辜无罪〖5〗，赏无功；使君有谬误之愆，天为作妖〖6〗。而诸公卿，媚上以求爱，困民以求饶〖7〗；导君于不义，败政于淫俗：臣窃为痛心！今邻国交好〖8〗，四边无事；当务息役养士，实其廪库〖9〗，以待天时。而更倾动天心，骚扰万姓；使民不安，大小呼嗟：此非保国养民之术也。臣闻吉凶在天，犹影之在形，响之在声也。形动则影动，形止则影止；此分数乃有所系〖10〗，非在口之所进退也〖11〗。","section_title":"潘濬陆凯传第十六","source":{"file":"OEBPS/Text/titlepage_0129.xhtml","index":62,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":235,"offset_unit":"unicode_code_point"},{"id":"panlu-q-69f4351ba65f9933af32","section":"chapter-061","block":"b-9cb28c66dfdbb6d81bf8","layer":"original","quote":"臣闻殷汤取士于商贾〖45〗，齐桓取士于车辕〖46〗；周武取士于负薪〖47〗，大汉取士于奴仆〖48〗。明王圣主取士以贤，不拘卑贱；故其功德洋溢，名流竹素〖49〗；非求颜色而取好服、捷口、容悦者也〖50〗。臣伏见当今内宠之臣，位非其人，任非其量〖51〗；不能辅国匡时，群党相扶，害忠隐贤。愿陛下简文武之臣〖52〗，各勤其官；州牧督将，藩镇方外；公卿尚书，务修仁化；上助陛下，下拯黎民；各尽其忠，拾遗万一。则康哉之歌作〖53〗，刑措之理清〖54〗。","section_title":"潘濬陆凯传第十六","source":{"file":"OEBPS/Text/titlepage_0129.xhtml","index":68,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":221,"offset_unit":"unicode_code_point"},{"id":"panlu-q-94b28acc20c474534b31","section":"chapter-061","block":"b-43fe1e899ec79c530b19","layer":"original","quote":"臣暗于大理，文不及义〖19〗；智慧浅劣，无复冀望：窃为陛下惜天下耳！臣谨奏耳目所闻见，百姓所为烦苛，刑政所为错乱；愿陛下息大功，损百役〖20〗，务宽荡〖21〗，忽苛政〖22〗。","section_title":"潘濬陆凯传第十六","source":{"file":"OEBPS/Text/titlepage_0129.xhtml","index":64,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":88,"offset_unit":"unicode_code_point"},{"id":"panlu-q-ad481f7667ce339be6e8","section":"chapter-061","block":"b-7fd051188631c0b5a870","layer":"original","quote":"臣闻五音令人耳不聪〖38〗，五色令人目不明〖39〗；此无益于政，有损于事者也。自昔先帝时，后宫列女，及诸织络〖40〗，数不满百；米有蓄积，货财有余。先帝崩后，幼、景在位〖41〗；更改奢侈，不蹈先迹。伏闻织络及诸徒坐〖42〗，乃有千数；计其所长〖43〗，不足为国财；然坐食官廪，岁岁相承，此为无益。愿陛下料出赋嫁〖44〗，给与无妻者。如此，上应天心，下合地意，天下幸甚！","section_title":"潘濬陆凯传第十六","source":{"file":"OEBPS/Text/titlepage_0129.xhtml","index":67,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":184,"offset_unit":"unicode_code_point"},{"id":"panlu-q-c19672baf1a1713d7bc7","section":"chapter-061","block":"b-36901026327cc7e69887","layer":"original","quote":"昔秦所以亡天下者，但坐赏轻而罚重〖12〗，政刑错乱，民力尽于奢侈；目眩于美色，志浊于财宝；邪臣在位，贤哲隐藏；百姓业业〖13〗，天下苦之：是以遂有覆巢破卵之忧。汉所以强者，躬行诚信，听谏纳贤；惠及负薪〖14〗，躬请岩穴〖15〗；广采博察，以成其谋：此往事之明证也。近者汉之衰末，三家鼎立；曹失纲纪〖16〗，晋有其政。又益州危险〖17〗，兵多精强；闭门固守，可保万世。而刘氏与夺乖错〖18〗，赏罚失所；君恣意于奢侈，民力竭于不急。是以为晋所伐，君臣见虏：此目前之明验也。","section_title":"潘濬陆凯传第十六","source":{"file":"OEBPS/Text/titlepage_0129.xhtml","index":63,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":234,"offset_unit":"unicode_code_point"},{"id":"panlu-q-cc4274a6ee0f58b2e2b5","section":"chapter-061","block":"b-9d826dabc2cfa69cac7f","layer":"original","quote":"愿陛下留神，思臣愚言。","section_title":"潘濬陆凯传第十六","source":{"file":"OEBPS/Text/titlepage_0129.xhtml","index":69,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":11,"offset_unit":"unicode_code_point"},{"id":"panlu-q-d3cb4405b29d90bd505a","section":"chapter-061","block":"b-754acb21adbf03f6c771","layer":"original","quote":"臣闻国无三年之储，谓之非国。而今无一年之蓄，此臣下之责也。而诸公卿，位处人上，禄延子孙；曾无致命之节〖27〗，匡救之术；苟进小利于君，以求容媚；荼毒百姓，不为君计也。自从孙弘造义兵以来〖28〗，耕种既废，所在无复输入〖29〗；而分一家父子异役〖30〗，廪食日张〖31〗，蓄积日耗；民有离散之怨，国有露根之渐〖32〗，而莫之恤也。民力困穷，鬻卖儿子〖33〗；调赋相仍〖34〗，日以疲极。所在长吏，不加隐括〖35〗；加有监官，既不爱民，务行威势，所在骚扰，更为烦苛：民苦二端，财力再耗，此为无益而有损也。愿陛下一息此辈〖36〗，矜哀孤弱，以镇抚百姓之心；此犹鱼鳖得免毒螫之渊，鸟兽得离罗网之纲，四方之民襁负而至矣〖37〗。如此，民可得保，先王之国存焉。","section_title":"潘濬陆凯传第十六","source":{"file":"OEBPS/Text/titlepage_0129.xhtml","index":66,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":324,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
