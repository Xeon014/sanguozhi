{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o077b","title":"荀彧劝曹操坚持官渡","accounts":[{"id":"wudi-e-o077b-account","label":"正文","text":"曹操缺粮致信荀彧议退许，荀彧劝其抓住决胜时机继续坚持，曹操听从。","evidence":["wudi-e-o077b-q"]},{"id":"xunyu-e-o020a-account","label":"《荀彧荀攸贾诩传第十》正文","text":"曹操官渡乏粮书荀彧议还许","evidence":["xunyu-e-o020a-q"]},{"id":"xunyu-e-o021a-account","label":"《荀彧荀攸贾诩传第十》正文","text":"荀彧劝坚守曹操奇袭淳于琼破袁绍","evidence":["xunyu-e-o021a-q"]}],"participants":[{"person":"cao-cao","role":"议退听劝","evidence":["wudi-e-o077b-q"]},{"person":"wudi-p0100","role":"劝坚持","evidence":["wudi-e-o077b-q"]},{"person":"wudi-p0052","role":"围攻","evidence":["xunyu-e-o020a-q"]},{"person":"wudi-p0175","role":"被斩","evidence":["xunyu-e-o021a-q"]}],"place":{"text":"官渡、许","evidence":["wudi-e-o077b-q"]},"time":{"label":"建安五年官渡相持时","year":200,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o077b-q","wudi-q-o071","wudi-q-b-9900125064e5d85f08ad"],"chronology":"wudi-y200","dating_review":{"anchor":"wudi-q-o071","basis":"建安五年官渡相持时","reviewed":true}},"source_order":[1,415,"O077b"],"order":183}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0052","name":"袁绍","facts":[],"aliases":[]},{"id":"wudi-p0100","name":"荀彧","facts":[],"aliases":[]},{"id":"wudi-p0175","name":"淳于琼","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-o077b-q","section":"chapter-001","block":"b-1c352ef0b3dd554afb44","layer":"original","quote":"时公粮少，与荀彧书，议欲还许。彧以为：“绍悉众聚官渡，欲与公决胜败；公以至弱当至强，若不能制，必为所乘。是天下之大机也〖12〗。且绍，布衣之雄耳〖13〗，能聚人而不能用。夫以公之神武明哲而辅以大顺〖14〗，何向而不济〖15〗！”公从之。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":414,"anchor":null},"note_id":null,"start":104,"end":222},{"id":"wudi-q-b-9900125064e5d85f08ad","section":"chapter-001","block":"b-9900125064e5d85f08ad","layer":"modern","quote":"〖1〗五年：建安五年（公元 200）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":403,"anchor":null},"note_id":"n-744e4aee7f5ff14cca85","start":0,"end":19},{"id":"wudi-q-o071","section":"chapter-001","block":"b-c9f735ddad48a8f5c2b6","layer":"original","quote":"五年春正月〖1〗，董承等谋泄，皆伏诛。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":400,"anchor":null},"note_id":null,"start":0,"end":19},{"id":"xunyu-e-o020a-q","section":"chapter-010","block":"b-ae8147f907358950d8ac","layer":"original","quote":"五年〖3〗，与绍连战。太祖保官渡，绍围之；太祖军粮方尽，书与彧，议欲还许，以引绍〖4〗。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":110,"anchor":null},"note_id":null,"start":0,"end":44},{"id":"xunyu-e-o021a-q","section":"chapter-010","block":"b-b530db2d928e9990c4ea","layer":"original","quote":"彧曰：“今军食虽少，未若楚、汉在荥阳、成皋间也〖5〗。是时刘、项，莫肯先退；先退者，势屈也。公以十分居一之众，画地而守之，扼其喉而不得进，已半年矣。情见势竭，必将有变；此用奇之时，不可失也！”太祖乃住，遂以奇兵袭绍别屯〖6〗，斩其将淳于琼等，绍退走；","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":111,"anchor":null},"note_id":null,"start":0,"end":125}],"profiles":{},"directory_counts":{}}
