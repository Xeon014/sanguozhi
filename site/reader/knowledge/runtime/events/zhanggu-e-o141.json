{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhanggu-e-o141","title":"裴论瑾以大义责备之书","accounts":[{"id":"zhanggu-a-55797fbccb7efb4e1f5b","label":"裴注·注家按语","text":"裴论瑾以大义责备之书","evidence":["zhanggu-q-df53e8b30aaf9529c54b"]}],"participants":[{"person":"shaodi-p0003","role":"批评诸葛瑾与刘备笺","evidence":["zhanggu-q-df53e8b30aaf9529c54b"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["zhanggu-q-df53e8b30aaf9529c54b"]},"ordering_evidence":"zhanggu-q-df53e8b30aaf9529c54b","source_order":[52,286,0],"order":9348}],"persons":[{"id":"shaodi-p0003","name":"裴松之","facts":[],"aliases":[]}],"evidence":[{"id":"zhanggu-q-df53e8b30aaf9529c54b","section":"chapter-052","block":"b-461341092bfe3ba015a3","layer":"pei","quote":"﹝一﹞臣松之云：以为刘后以庸蜀为关河，荆楚为维翰；关羽扬兵沔、汉，志陵上国，虽匡主定霸，功未可必，要为威声远震，有其经略。孙权潜包祸心，助魏除害；是为剪宗子勤王之师，纾曹公移都之计。拯汉之规，于兹而止；义旗所指，宜其在孙氏矣！瑾以大义责备，答之何患无辞；且备、羽相与，有若四体；股肱横亏，愤痛已深，岂此奢阔之书所能回驻哉！载之于篇，实为辞章之费。","attribution":"裴注·注家按语","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":285,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8bf43107305f720d2daf","start":0,"end":173,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
