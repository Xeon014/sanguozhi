{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"shiyi-e-d50c7bf01419401c784e","title":"徐众评是仪不雷同害人与忠勇公正","accounts":[{"id":"shiyi-a-d50c7bf01419401c784e","label":"徐众《评》","text":"徐众评是仪不雷同害人与忠勇公正","evidence":["shiyi-q-cc75a3414def1a003cb8"]}],"participants":[],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["shiyi-q-cc75a3414def1a003cb8"]},"ordering_evidence":"shiyi-q-cc75a3414def1a003cb8","order":10798}],"persons":[],"evidence":[{"id":"shiyi-q-cc75a3414def1a003cb8","section":"chapter-062","block":"b-50cef559359027d15c72","layer":"pei","quote":"﹝一﹞徐众《评》曰：“是仪以羁旅异方，客仕吴朝；值谗邪殄行，当严毅之威，命悬漏刻，祸急危机；不雷同以害人，不苟免以伤义：可谓忠勇公正之士！虽祁奚之免叔向，庆忌之济朱云，何以尚之？忠不谄君，勇不慑耸，公不存私，正不党邪；资此四德，加之以文敏，崇之以谦约，履之以和顺：保傅二宫，存身爱名，不亦宜乎！”","attribution":"徐众《评》","section_title":"是仪胡综传第十七","source":{"file":"OEBPS/Text/titlepage_0131.xhtml","index":34,"anchor":null},"note_id":"n-fb54a83264eb247f9786","start":0,"end":148}],"profiles":{},"directory_counts":{}}
