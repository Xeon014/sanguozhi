{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhuge-e-p018a","title":"郭冲记诸葛亮察刘备客为刺客刺客逃走","accounts":[{"id":"zhuge-e-p018a-account","label":"《蜀记》郭冲二事","text":"郭冲记诸葛亮察刘备客为刺客刺客逃走","evidence":["zhuge-e-p018a-q"]},{"id":"zhuge-a-p019-judgment","label":"裴松之难","text":"裴松之指出此客的才具、受命行刺与后来无闻之间难自洽，质疑郭冲二事。","evidence":["zhuge-q-p019-judgment"]}],"participants":[{"person":"zhuge-liang","role":"被记察奸","evidence":["zhuge-e-p018a-q"]},{"person":"liu-bei","role":"被记接客","evidence":["zhuge-e-p018a-q"]}],"place":null,"time":{"label":"郭冲所述曹氏刺客时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["zhuge-e-p018a-q"]},"ordering_evidence":"zhuge-e-p018a-q","source_order":[35,130,"P018a"],"order":6778}],"persons":[{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"zhuge-liang","name":"诸葛亮","facts":[],"aliases":[]}],"evidence":[{"id":"zhuge-e-p018a-q","section":"chapter-035","block":"b-50e85dba7a22dc6ba2d6","layer":"pei","quote":"其二事曰：“曹公遣刺客见刘备；方得交接，开论伐魏形势，甚合备计，稍欲亲近。刺者尚未得便会，既而亮入，魏客神色失措；亮因而察之，亦知非常人。须臾，客如厕，备谓亮曰：‘向得奇士，足以助君补益。’亮问‘所在’？备曰：‘起者其人也。’亮徐叹曰：‘观客色动而神惧，视低而忤数；奸形外漏，邪心内藏：必曹氏刺客也！’追之，已越墙而走。”","attribution":"《蜀记》郭冲二事","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":129,"anchor":null},"note_id":"n-e1fd0c802665084e965d","start":0,"end":161},{"id":"zhuge-q-p019-judgment","section":"chapter-035","block":"b-6e2169c483f0845b6952","layer":"pei","quote":"难曰：凡为刺客，皆暴虎冯河，死而无悔者也。刘主有知人之鉴，而惑于此客；则此客，必一时之奇士也。又语诸葛云“足以助君补益”，则亦诸葛之流亚也。凡如诸葛之俦，鲜有为人作刺客者矣；时主亦当惜其器用，必不投之死地也。且此人不死，要应显达为魏，竟是谁乎？何其寂蔑而无闻？","attribution":"裴松之难","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":130,"anchor":null},"note_id":"n-e1fd0c802665084e965d","start":0,"end":130}],"profiles":{},"directory_counts":{}}
