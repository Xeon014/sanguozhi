{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xiahoucao-e-p041b","title":"桓范与郑岐争屋欲斩坐免后耻受吕昭节制杀妻不赴冀州","accounts":[{"id":"xiahoucao-e-p041b-account","label":"《魏略》","text":"桓范与郑岐争屋欲斩坐免后耻受吕昭节制杀妻不赴冀州","evidence":["xiahoucao-e-p041b-q"]}],"participants":[{"person":"shaodi-p0030","role":"争官杀妻","evidence":["xiahoucao-e-p041b-q"]},{"person":"xiahoucao-p0085","role":"奏劾","evidence":["xiahoucao-e-p041b-q"]},{"person":"xiahoucao-p0086","role":"谏夫遇害","evidence":["xiahoucao-e-p041b-q"]}],"place":null,"time":{"label":"桓范仕魏至高平陵事","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xiahoucao-e-p041b-q"]},"ordering_evidence":"xiahoucao-e-p041b-q","source_order":[9,375,"P041b"],"order":2296}],"persons":[{"id":"shaodi-p0030","name":"桓范","facts":[],"aliases":[]},{"id":"xiahoucao-p0085","name":"郑岐","facts":[],"aliases":[]},{"id":"xiahoucao-p0086","name":"仲长（桓范妻）","facts":[],"aliases":[]}],"evidence":[{"id":"xiahoucao-e-p041b-q","section":"chapter-009","block":"b-e208aef32668918e941e","layer":"pei","quote":"与徐州刺史郑岐，争屋，引节，欲斩岐，为岐所奏；不直，坐免还。复为兖州刺史，怏怏不得意。又闻当转为冀州牧。是时冀州统属镇北，而镇北将军吕昭才实、仕进，本在范后。范谓其妻仲长曰：‘我宁作诸卿，向三公长跪耳；不能为吕子展屈也！’其妻曰：‘君前在东，坐欲擅斩徐州刺史，众人谓君难为作下；今复羞为吕屈，是复难为作上也。’范忿其言触实，乃以刀环撞其腹；妻时怀孕，遂堕胎，死。范亦竟称疾，不赴冀州。","attribution":"《魏略》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":374,"anchor":null},"note_id":"n-45775d68baddd17aab59","start":86,"end":278}],"profiles":{},"directory_counts":{}}
