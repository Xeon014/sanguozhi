{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dongyuan-e-o054a","title":"袁绍败归因耻笑之疑杀田丰","accounts":[{"id":"dongyuan-e-o054a-account","label":"《董二袁刘传第六》正文","text":"袁绍败归因耻笑之疑杀田丰","evidence":["dongyuan-e-o054a-q"]},{"id":"dongyuan-a-p086-judgment","label":"孙盛论","text":"孙盛赞田丰沮授之谋，并讨论丰知败必死仍尽忠及臣下去就。","evidence":["dongyuan-q-p086-judgment"]}],"participants":[{"person":"wudi-p0052","role":"杀臣","evidence":["dongyuan-e-o054a-q"]},{"person":"wudi-p0139","role":"被杀","evidence":["dongyuan-e-o054a-q"]}],"place":null,"time":{"label":"官渡败后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-o054a-q"]},"ordering_evidence":"dongyuan-e-o054a-q","source_order":[6,313,"O054a"],"order":1677}],"persons":[{"id":"wudi-p0052","name":"袁绍","facts":[],"aliases":[]},{"id":"wudi-p0139","name":"田丰","facts":[],"aliases":[]}],"evidence":[{"id":"dongyuan-e-o054a-q","section":"chapter-006","block":"b-27383b00fe3773825ed1","layer":"original","quote":"绍军既败，或谓丰曰：“君必见重。”丰曰：“若军有利，吾必全；今军败，吾其死矣！”绍还，谓左右曰：“吾不用田丰言，果为所笑！”遂杀之。﹝六﹞绍外宽雅，有局度〖12〗，忧喜不形于色；而内多忌害〖13〗，皆此类也。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":312,"anchor":null},"note_id":null,"start":0,"end":104},{"id":"dongyuan-q-p086-judgment","section":"chapter-006","block":"b-43dc1ea8833c9c774b2c","layer":"pei","quote":"孙盛曰：“观田丰、沮授之谋，虽良、平何以过之！故君贵审才，臣尚量主。君用忠良，则伯王之业隆；臣奉暗后，则覆亡之祸至。存亡荣辱，常必由兹。丰知绍将败，败则己必死，甘冒虎口以尽忠规；烈士之于所事，虑不存己。夫诸侯之臣，义有去就，况丰与绍非纯臣乎？《诗》云‘逝将去汝，适彼乐土’，言去乱邦，就有道，可也。”","attribution":"孙盛论","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":337,"anchor":null},"note_id":"n-247ea57f2666f37d6b34","start":0,"end":150}],"profiles":{},"directory_counts":{}}
