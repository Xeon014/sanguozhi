{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"mingdi-e-o044a","title":"大治洛阳宫起昭阳太极殿总章观","accounts":[{"id":"mingdi-e-o044a-account","label":"《明帝纪》正文","text":"大治洛阳宫起昭阳太极殿总章观","evidence":["mingdi-e-o044a-q"]}],"participants":[{"person":"wendi-p0005","role":"营宫","evidence":["mingdi-e-o044a-q"]}],"place":{"text":"洛阳","evidence":["mingdi-e-o044a-q"]},"time":{"year":235,"label":"青龙三年","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"mingdi-y235","dating_review":{"reviewed":true,"anchor":"mingdi-q-o043","basis":"青龙三年"},"evidence":["mingdi-e-o044a-q","mingdi-q-o043","mingdi-q-b-e98ed256e58910694910"]},"ordering_evidence":"mingdi-e-o044a-q","source_order":[3,294,"O044a"],"related_events":[{"event":"wendi-e-p070b","type":"related","evidence":["mingdi-e-o044a-q","wendi-e-p070b-q"]}],"order":877},{"id":"wendi-e-p070b","title":"曹叡在汉南宫崇德殿处建太极昭阳诸殿","accounts":[{"id":"wendi-e-p070b-account","label":"裴注·裴松之按","text":"曹叡在汉南宫崇德殿处建太极昭阳诸殿","evidence":["wendi-e-p070b-q"]}],"participants":[{"person":"wendi-p0005","role":"营宫","evidence":["wendi-e-p070b-q"]}],"place":null,"time":{"label":"明帝时，在文帝之后","precision":"relative","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["wendi-e-p070b-q"]},"ordering_evidence":"wendi-e-p070b-q","source_order":[2,206,"P070b"],"related_events":[{"event":"mingdi-e-o044a","type":"related","evidence":["mingdi-e-o044a-q","wendi-e-p070b-q"]}],"order":563}],"persons":[{"id":"wendi-p0005","name":"曹叡","facts":[],"aliases":[]}],"evidence":[{"id":"mingdi-e-o044a-q","section":"chapter-003","block":"b-8c8a43d20cb08b566342","layer":"original","quote":"是时，大治洛阳宫，起昭阳、太极殿，筑总章观。百姓失农时","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":293,"anchor":null},"note_id":null,"start":0,"end":27},{"id":"mingdi-q-b-e98ed256e58910694910","section":"chapter-003","block":"b-e98ed256e58910694910","layer":"modern","quote":"〖1〗三年：青龙三年（公元 235）。明帝将司马懿提升为太尉，使他让出大将军一职，出自深层次政治考量。太尉作为三公之首，品级地位虽然略高于大将军，但是在控制军事实权和亲近皇帝的程度上，却比不上后者。明帝是要为曹氏亲族的年轻将领腾出这一重要位置，与异姓元勋重臣进行力量平衡，从而保证皇权安定稳固。戊子：旧历初八日。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":297,"anchor":null},"note_id":"n-ddf87e6819a0a2dfe019","start":0,"end":156},{"id":"mingdi-q-o043","section":"chapter-003","block":"b-9b32a12fd737552ea52d","layer":"original","quote":"三年春正月，戊子〖1〗，以大将军司马宣王为太尉。己亥〖2〗。复置朔方郡。京都大疫。丁巳〖3〗，皇太后崩。乙亥〖4〗，陨石于寿光县〖5〗。三月，庚寅〖6〗，葬文德郭后。营陵于首阳陵涧西〖7〗，如终制。﹝一﹞","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":292,"anchor":null},"note_id":null,"start":0,"end":102},{"id":"wendi-e-p070b-q","section":"chapter-002","block":"b-0b7471ed43efb8d984f7","layer":"pei","quote":"明帝时，始于汉南宫崇德殿处，起太极、昭阳诸殿。","attribution":"裴注·裴松之按","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":205,"anchor":null},"note_id":"n-480b1792ff2b48c91fa3","start":51,"end":74}],"profiles":{},"directory_counts":{}}
