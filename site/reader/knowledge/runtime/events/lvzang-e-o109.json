{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"lvzang-e-o109","title":"布欲自将断粮道妻谏宫顺不和布不能自决","accounts":[{"id":"lvzang-a-445b15dfe031d6b35d0e","label":"裴注·英雄记","text":"布欲自将断粮道妻谏宫顺不和布不能自决","evidence":["lvzang-q-cd24258052e243fc9830"]},{"id":"lvzang-a-02728928e693479dae8a","label":"裴注·魏氏春秋","text":"宫劝布出屯内外夹击布妻谏布乃止","evidence":["lvzang-q-c077f5e3db2ee782c27e"]}],"participants":[{"person":"wudi-p0088","role":"欲令陈宫高顺守城自将骑断太祖粮道、得妻言愁闷不能自决；然之、乃止","evidence":["lvzang-q-cd24258052e243fc9830","lvzang-q-c077f5e3db2ee782c27e"]},{"person":"lvzang-p0004","role":"谓曰将军自出断曹公粮道是也宫顺素不和将军一出宫顺必不同心共城守也如有蹉跌将军当于何自立乎愿将军谛计之无为宫等所误也妾昔在长安已为将军所弃赖得庞舒私藏妾身耳今不须顾妾也；曰昔曹氏待公台如赤子犹舍而来今将军厚公台不过于曹公而欲委全城捐妻子孤军远出若一旦有变妾岂得为将军妻哉","evidence":["lvzang-q-cd24258052e243fc9830","lvzang-q-c077f5e3db2ee782c27e"]},{"person":"wudi-p0096","role":"素与顺不和者；谓布曰曹公远来势不能久若将军以步骑出屯为势于外宫将余众闭守于内若向将军宫引兵而攻其背若来攻城将军为救于外不过旬日军食必尽击之可破","evidence":["lvzang-q-cd24258052e243fc9830","lvzang-q-c077f5e3db2ee782c27e"]},{"person":"wudi-p0140","role":"素与宫不和者","evidence":["lvzang-q-cd24258052e243fc9830"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["lvzang-q-cd24258052e243fc9830","lvzang-q-c077f5e3db2ee782c27e"]},"ordering_evidence":"lvzang-q-cd24258052e243fc9830","source_order":[7,121,151],"order":1848}],"persons":[{"id":"lvzang-p0004","name":"布妻","facts":[],"aliases":[]},{"id":"wudi-p0088","name":"吕布","facts":[],"aliases":[]},{"id":"wudi-p0096","name":"陈宫","facts":[],"aliases":[]},{"id":"wudi-p0140","name":"高顺","facts":[],"aliases":[]}],"evidence":[{"id":"lvzang-q-c077f5e3db2ee782c27e","section":"chapter-007","block":"b-159cd164ea69a63a78e2","layer":"pei","quote":"陈宫谓布曰：‘曹公远来，势不能久。若将军以步骑出屯，为势于外，宫将余众闭守于内：若向将军，宫引兵而攻其背；若来攻城，将军为救于外。不过旬日，军食必尽，击之可破。’布然之。布妻曰：‘昔曹氏待公台如赤子，犹舍而来。今将军厚公台不过于曹公，而欲委全城，捐妻子，孤军远出；若一旦有变，妾岂得为将军妻哉！’布乃止","attribution":"裴注·魏氏春秋","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":121,"anchor":null},"note_id":"n-0324e650424a8aac337a","start":9,"end":160},{"id":"lvzang-q-cd24258052e243fc9830","section":"chapter-007","block":"b-34ee8404b5682e6bd0e4","layer":"pei","quote":"布欲令陈宫、高顺守城，自将骑断太祖粮道；布妻谓曰：‘将军自出断曹公粮道，是也。宫、顺素不和，将军一出，宫、顺必不同心共城守也。如有蹉跌，将军当于何自立乎？愿将军谛计之，无为宫等所误也！妾昔在长安，已为将军所弃，赖得庞舒私藏妾身耳。今不须顾妾也。’布得妻言，愁闷不能自决","attribution":"裴注·英雄记","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":120,"anchor":null},"note_id":"n-0324e650424a8aac337a","start":151,"end":285}],"profiles":{},"directory_counts":{}}
