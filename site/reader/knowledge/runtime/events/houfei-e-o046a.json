{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"houfei-e-o046a","title":"毛嘉卒追赠改封安国侯谥节侯","accounts":[{"id":"houfei-e-o046a-account","label":"《后妃传》正文","text":"毛嘉卒追赠改封安国侯谥节侯","evidence":["houfei-e-o046a-q"]}],"participants":[{"person":"mingdi-p0010","role":"卒","evidence":["houfei-e-o046a-q"]}],"place":null,"time":{"year":235,"label":"青龙三年","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"houfei-y235","dating_review":{"reviewed":true,"anchor":"houfei-q-o025","basis":"青龙三年"},"evidence":["houfei-e-o046a-q","houfei-q-o025","houfei-q-b-e47ffea5cca5eab53d92"]},"ordering_evidence":"houfei-e-o046a-q","source_order":[5,216,"O046a"],"order":1456}],"persons":[{"id":"mingdi-p0010","name":"毛嘉","facts":[],"aliases":[]}],"evidence":[{"id":"houfei-e-o046a-q","section":"chapter-005","block":"b-57d03da0c132cfffd26d","layer":"original","quote":"青龙三年，嘉薨。追赠光禄大夫，改封安国侯，增邑五百，并前千户，谥曰节侯。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":215,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":36,"offset_unit":"unicode_code_point"},{"id":"houfei-q-b-e47ffea5cca5eab53d92","section":"chapter-005","block":"b-e47ffea5cca5eab53d92","layer":"modern","quote":"〖15〗三年：青龙三年（公元 235）。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":113,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4aa0b3373c71cedadeb9","start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"houfei-q-o025","section":"chapter-005","block":"b-0744a279ae4c62a54e64","layer":"original","quote":"青龙二年春，追谥后兄俨曰安城乡穆侯。夏，吴贼寇扬州，以像为伏波将军〖12〗，持节，监诸将东征〖13〗。还，复为射声校尉〖14〗。三年薨〖15〗，追赠卫将军，改封魏昌县，谥曰贞侯。子畅嗣。又封畅弟温、4 、艳，皆为列侯。四年〖16〗，改逸、俨本封，皆曰魏昌侯，谥因故〖17〗。封俨世妇刘为东乡君〖18〗，又追封逸世妇张为安喜君。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":97,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":163,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
