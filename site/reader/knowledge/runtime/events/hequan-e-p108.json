{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"hequan-e-p108","title":"牧答朱育功薄宠过不恨","accounts":[{"id":"hequan-a-47394be108bf04221cda","label":"裴注·《会稽典录》","text":"牧答朱育功薄宠过不恨","evidence":["hequan-q-b38d1be5759caf1402b6"]}],"participants":[{"person":"santizhu-p0023","role":"笑答卿之所言未获我心、功不足录而见宠已过当岂以为恨、国家不深相知而见害朝人故默默不敢有所陈、若其不然当建进取之计以报所受之恩不徒自守而已","evidence":["hequan-q-b38d1be5759caf1402b6"]},{"person":"hequan-p0033","role":"牧笑答未获我心之对语者","evidence":["hequan-q-b38d1be5759caf1402b6"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["hequan-q-b38d1be5759caf1402b6"]},"ordering_evidence":"hequan-q-b38d1be5759caf1402b6","source_order":[60,426,104],"order":10693}],"persons":[{"id":"hequan-p0033","name":"朱育","facts":[],"aliases":[]},{"id":"santizhu-p0023","name":"钟离牧","facts":[],"aliases":[]}],"evidence":[{"id":"hequan-q-b38d1be5759caf1402b6","section":"chapter-060","block":"b-7bdcab2ebb40d42ee681","layer":"pei","quote":"牧笑而答曰：‘卿之所言，未获我心也！马援有言：人当功多而赏薄。吾功不足录，而见宠已过当，岂以为恨！国家不深相知，而见害朝人，是以默默不敢有所陈。若其不然，当建进取之计，以报所受之恩；不徒自守而已：愤叹以此也","attribution":"裴注·《会稽典录》","section_title":"贺全吕周钟离传第十五","source":{"file":"OEBPS/Text/titlepage_0127.xhtml","index":425,"anchor":null},"note_id":"n-33595db1c58d43d13067","start":104,"end":207}],"profiles":{},"directory_counts":{}}
