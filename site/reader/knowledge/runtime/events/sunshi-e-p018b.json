{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"sunshi-e-p018b","title":"董卓劝张温为周慎后驻不纳改讨羌留刘靖声援","accounts":[{"id":"sunshi-e-p018b-account","label":"《山阳公载记》","text":"董卓劝张温为周慎后驻不纳改讨羌留刘靖声援","evidence":["sunshi-e-p018b-q"]}],"participants":[{"person":"wudi-p0053","role":"献策征讨","evidence":["sunshi-e-p018b-q"]},{"person":"wudi-p0021","role":"拒策遣将","evidence":["sunshi-e-p018b-q"]},{"person":"sunshi-p0030","role":"围攻","evidence":["sunshi-e-p018b-q"]},{"person":"sunshi-p0031","role":"屯安定","evidence":["sunshi-e-p018b-q"]},{"person":"wudi-p0047","role":"被围","evidence":["sunshi-e-p018b-q"]},{"person":"wudi-p0048","role":"被围","evidence":["sunshi-e-p018b-q"]}],"place":null,"time":{"label":"西征边章韩遂时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["sunshi-e-p018b-q"]},"ordering_evidence":"sunshi-e-p018b-q","source_order":[46,163,"P018b"],"order":8053}],"persons":[{"id":"sunshi-p0030","name":"周慎","facts":[],"aliases":[]},{"id":"sunshi-p0031","name":"刘靖","facts":[],"aliases":[]},{"id":"wudi-p0021","name":"张温","facts":[],"aliases":[]},{"id":"wudi-p0047","name":"边章","facts":[],"aliases":[]},{"id":"wudi-p0048","name":"韩遂","facts":[],"aliases":[]},{"id":"wudi-p0053","name":"董卓","facts":[],"aliases":[]}],"evidence":[{"id":"sunshi-e-p018b-q","section":"chapter-046","block":"b-c8fd920a32479644dd63","layer":"pei","quote":"孤昔与周慎西征，慎围边、韩于金城。孤语张温，求引所将兵，为慎作后驻，温不听。孤时上言其形势，知慎必不克：台今有本末。事未报，温又使孤讨先零叛羌，以为西方可一时荡定。孤皆知其不然，而不得止，遂行；留别部司马刘靖，将步骑四千屯安定，以为声势。叛羌便还，欲截归道；孤小击，辄开，畏安定有兵故也。虏谓安定当数万人，不知但靖也。时又上章言状。","attribution":"《山阳公载记》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":162,"anchor":null},"note_id":"n-400db0528d9f41d40f3f","start":59,"end":225}],"profiles":{},"directory_counts":{}}
