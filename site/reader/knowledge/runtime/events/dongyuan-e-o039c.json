{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dongyuan-e-o039c","title":"赵浮程奂请拒袁绍韩馥不听","accounts":[{"id":"dongyuan-e-o039c-account","label":"《董二袁刘传第六》正文","text":"赵浮、程奂请求用兵拒袁绍，韩馥不听。","evidence":["dongyuan-e-o039c-q"]},{"id":"dongyuan-e-p063b-account","label":"《九州春秋》","text":"赵浮程奂请拒袁绍韩馥不听遣子送州印","evidence":["dongyuan-e-p063b-q"]}],"participants":[{"person":"dongyuan-p0030","role":"请拒","evidence":["dongyuan-e-o039c-q"]},{"person":"dongyuan-p0031","role":"请拒","evidence":["dongyuan-e-o039c-q"]},{"person":"wudi-p0058","role":"不纳","evidence":["dongyuan-e-o039c-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-o039c-q"]},"ordering_evidence":"dongyuan-e-o039c-q","source_order":[6,233,"O039c"],"order":1632}],"persons":[{"id":"dongyuan-p0030","name":"赵浮","facts":[],"aliases":[]},{"id":"dongyuan-p0031","name":"程奂","facts":[],"aliases":[]},{"id":"wudi-p0058","name":"韩馥","facts":[],"aliases":[]}],"evidence":[{"id":"dongyuan-e-o039c-q","section":"chapter-006","block":"b-cc00a1d34aed4013ad69","layer":"original","quote":"从事赵浮、程奂请以兵拒之〖12〗，馥又不听。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":232,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":128,"end":150,"offset_unit":"unicode_code_point"},{"id":"dongyuan-e-p063b-q","section":"chapter-006","block":"b-501b9aaae088f305661d","layer":"pei","quote":"浮等到，谓馥曰：‘袁本初军无斗粮，各已离散；虽有张杨、于扶罗新附，未肯为用：不足敌也。小从事等请自以现兵拒之，旬日之间，必土崩瓦解。明将军但当开阽閤高枕，何忧何惧！’馥不从，乃避位，出居赵忠故舍。遣子赍冀州印绶，于黎阳与绍。","attribution":"《九州春秋》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":248,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-7c576da3d950edb687e2","start":92,"end":204,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_co