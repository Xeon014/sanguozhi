{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wgc-e-add002","title":"刻石纪高句骊战功","order":5499,"accounts":[{"id":"wgc-a-add002","label":"正文","text":"刻石纪高句骊战功","evidence":["wgc-q0657","wgc-q0015"]}],"participants":[],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0657","wgc-q0015"]},"ordering_evidence":"wgc-q0657"}],"persons":[],"evidence":[{"id":"wgc-q0015","section":"chapter-028","block":"b-d69c99d640aab2056824","layer":"original","quote":"六年〖10〗，复征之，宫遂奔买沟〖11〗。俭遣玄菟太守王颀追之，﹝三﹞过沃沮千有余里〖12〗，至肃慎氏南界〖13〗；刻石纪功，刊丸都之山〖14〗，铭不耐之城〖15〗。诸所诛纳八千余口，论功受赏，侯者百余人。穿山溉灌，民赖其利。迁左将军，假节，监豫州诸军事，领豫州刺史。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":84,"anchor":null},"note_id":null,"start":0,"end":134},{"id":"wgc-q0657","section":"chapter-028","block":"b-d69c99d640aab2056824","layer":"original","quote":"刻石纪功，刊丸都之山〖14〗，铭不耐之城〖15〗。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":84,"anchor":null},"note_id":null,"start":58,"end":83}],"profiles":{},"directory_counts":{}}
