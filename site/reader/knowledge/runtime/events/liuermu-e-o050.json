,"source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":69,"anchor":null},"note_id":null,"start":61,"end":73},{"id":"liuermu-q-f0468922c02524256ea0","section":"chapter-031","block":"b-db95f98a00cdc5ca2f50","layer":"pei","quote":"松归，乃劝璋自绝","attribution":"裴注·汉晋春秋","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":117,"anchor":null},"note_id":"n-5274271211324b50d999","start":30,"end":38},{"id":"liuermu-q2-b75cdaea192a96c41691","section":"chapter-031","block":"b-16f433ec30acbf04267b","layer":"original","quote":"璋复遣别驾张松诣曹公〖6〗。曹公时已定荆州，走先主〖7〗，不复存录松〖8〗；松以此怨。会曹公军不利于赤壁〖9〗，兼以疫死。松还，疵毁曹公，劝璋自绝。﹝四﹞因说璋曰：“刘豫州〖10〗，使君之肺腑〖11〗，可与交通〖12〗。”璋皆然之，遣法正连好先主〖13〗；寻又令正及孟达送兵数千助先主守御〖14〗，正遂还。","section_title":"刘二牧传第一","source":{"file":"OEBPS/Text/titlepage_0068.xhtml","index":69,"anchor":null},"note_id":null,"start":0,"end":153}],"profiles":{},"directory_counts":{}}
