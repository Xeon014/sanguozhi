{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xiahoucao-e-p019c","title":"曹丕在东宫贷曹洪绢不称意后曹洪获免上书谢","accounts":[{"id":"xiahoucao-e-p019c-account","label":"《魏略》","text":"曹丕在东宫贷曹洪绢不称意后曹洪获免上书谢","evidence":["xiahoucao-e-p019c-q"]}],"participants":[{"person":"wudi-p0170","role":"贷绢","evidence":["xiahoucao-e-p019c-q"]},{"person":"wudi-p0075","role":"拒贷谢恩","evidence":["xiahoucao-e-p019c-q"]}],"place":null,"time":{"label":"曹洪下狱前后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xiahoucao-e-p019c-q"]},"ordering_evidence":"xiahoucao-e-p019c-q","source_order":[9,188,"P019c"],"order":2215}],"persons":[{"id":"wudi-p0075","name":"曹洪","facts":[],"aliases":[]},{"id":"wudi-p0170","name":"曹丕","facts":[],"aliases":[]}],"evidence":[{"id":"xiahoucao-e-p019c-q","section":"chapter-009","block":"b-44c4d09657fffcca3b53","layer":"pei","quote":"文帝在东宫，尝从洪贷绢百匹，洪不称意。及洪犯法，自分必死；既得原，喜。上书谢曰：‘臣少不由道，过在人伦；长窃非任，遂蒙含贷。性无检度知足之分，而有豺狼无厌之质；老昏倍贪，触突国网；罪迫三千，不在赦宥；当就辜诛，弃诸市朝；犹蒙天恩，骨肉更生。臣仰视天日，愧负灵神；俯惟愆阙，惭愧怖悸，不能雉经以自裁割。谨涂颜阙门，拜章陈情。","attribution":"《魏略》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":187,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a3ea61406a229d36aa2c","start":163,"end":324,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
