tizhu064-a-9b7ccbe24f72b402a289","label":"正文","text":"孙綝出屯镬里遣朱异等攻魏","evidence":["santizhu064-q-bc79e2ff7fe0cc5495b3"]}],"participants":[{"person":"houzhu-p0013","role":"大发兵出屯镬里并遣将攻魏","evidence":["santizhu064-q-bc79e2ff7fe0cc5495b3"]},{"person":"wuzhu-p0126","role":"率丁奉、黎斐等攻魏","evidence":["santizhu064-q-bc79e2ff7fe0cc5495b3"]},{"person":"santizhu-p0017","role":"受命随朱异攻魏","evidence":["santizhu064-q-bc79e2ff7fe0cc5495b3"]},{"person":"santizhu-p0163","role":"受命随朱异攻魏","evidence":["santizhu064-q-bc79e2ff7fe0cc5495b3"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"未由相邻段落推算纪年；原文时间表达保留在来源引句中。","evidence":["santizhu064-q-bc79e2ff7fe0cc5495b3"]},"ordering_evidence":"santizhu064-q-bc79e2ff7fe0cc5495b3","source_order":[64,90,0],"related_events":[{"event":"shaodi-e-o129a","type":"related","evidence":["santizhu064-q-bc79e2ff7fe0cc5495b3","shaodi-e-o129a-q"]},{"event":"chenghuang-e-o156","type":"related","evidence":["chenghuang-q-0cf97fa905c953017d83","santizhu064-q-bc79e2ff7fe0cc5495b3"]}],"order":11016}],"persons":[{"id":"shaodi-p0044","name":"诸葛诞","facts":[],"aliases":[]},{"id":"shaodi-p0045","name":"司马昭","facts":[],"aliases":[]},{"id":"wgc-p0026","name":"胡奋","facts":[],"aliases":[]}],"evidence":[{"id":"santizhu-q-a805fae656d71ba8f345","section":"chapter-048","block":"b-dc57a9e53d35b30f8168","layer":"original","quote":"三月，司马文王克寿春；诞及左右战死，将吏以下皆降。","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":119,"anchor":null},"note_id":null,"start":16,"end":41},{"id":"santizhu064-q-4ee6b68e68a3fac3ca3f","section":"chapter-064","block":"b-390d7a804c8a1bdac217","layer":"original","quote":"魏大将军诸葛诞举寿春叛，保城请降。吴遣文钦、唐咨、全端、全怿等帅三万人救之。魏镇南将军王基，围诞〖1〗，钦等突围入城","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":439,"anchor":null},"note_id":null,"start":0,"end":58},{"id":"santizhu064-q-bc79e2ff7fe0cc5495b3","section":"chapter-064","block":"b-f1f75337999ea6de2e8a","layer":"original","quote":"綝于是大发卒，出屯镬里〖4〗；复遣异率将军丁奉、黎斐等五万人，攻魏，留辎重于都陆","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":440,"anchor":null},"note_id":null,"start":0,"end":40},{"id":"shaodi-e-o129a-q","section":"chapter-004","block":"b-b1abcd215d0c852fc17c","layer":"original","quote":"三年春二月〖1〗，大将军司马文王陷寿春城，斩诸葛诞。三月，诏曰：“古者克敌，收其尸以为京观〖2〗，所以惩昏逆而彰武功也。汉孝武元鼎中〖3〗，改桐乡为闻喜〖4〗，新乡为获嘉〖5〗，以著南越之亡〖6〗。大将军亲总六戎〖7〗，营据丘头〖8〗；内夷群凶〖9〗，外殄寇虏〖10〗；功济兆民，声振四海。克敌之地，宜有令名〖11〗：其改‘丘头’为‘武丘’。明以武平乱，后世不忘；亦京观、二邑之义也〖12〗”。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":575,"anchor":null},"note_id":null,"start":0,"end":197},{"id":"shaodi-q-b-ee7d999da8e03b038d07","section":"chapter-004","block":"b-ee7d999da8e03b038d07","layer":"modern","quote":"〖1〗三年：甘露三年（公元 258）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":582,"anchor":null},"note_id":"n-663d9ce877d00f2d0cbc","start":0,"end":19},{"id":"shaodi-q-o129","section":"chapter-004","block":"b-b1abcd215d0c852fc17c","layer":"original","quote":"三年春二月〖1〗，大将军司马文王陷寿春城，斩诸葛诞。三月，诏曰：“古者克敌，收其尸以为京观〖2〗，所以惩昏逆而彰武功也。汉孝武元鼎中〖3〗，改桐乡为闻喜〖4〗，新乡为获嘉〖5〗，以著南越之亡〖6〗。大将军亲总六戎〖7〗，营据丘头〖8〗；内夷群凶〖9〗，外殄寇虏〖10〗；功济兆民，声振四海。克敌之地，宜有令名〖11〗：其改‘丘头’为‘武丘’。明以武平乱，后世不忘；亦京观、二邑之义也〖12〗”。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":575,"anchor":null},"note_id":null,"start":0,"end":197},{"id":"wgc-q0032","section":"chapter-028","block":"b-7511a5080accea460f90","layer":"original","quote":"大将军乃自临围，四面进兵，同时鼓噪登城。城内无敢动者。诞窘急，单乘马，将其麾下突小城门出。大将军司马胡奋部兵逆击〖11〗，斩诞；传首，夷三族。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":198,"anchor":null},"note_id":null,"start":0,"end":71},{"id":"wgc-q0298","section":"chapter-028","block":"b-7511a5080accea460f90","layer":"original","quote":"大将军乃自临围，四面进兵，同时鼓噪登城","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":198,"anchor":null},"note_id":null,"start":0,"end":19},{"id":"wgc-q0299","section":"chapter-028","block":"b-7511a5080accea460f90","layer":"original","quote":"诞窘急，单乘马，将其麾下突小城门出。大将军司马胡奋部兵逆击〖11〗，斩诞；传首，夷三族","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":198,"anchor":null},"note_id":null,"start":27,"end":70},{"id":"wgc-q0303","section":"chapter-028","block":"b-3e13a9b79fa20e998b01","layer":"original","quote":"初围寿春，议者多欲急攻之。大将军以为：“城固而众多，攻之必力屈；若有外寇，表里受敌，此危道也。今三叛相聚于孤城之中〖2〗，天其或者将使同就戮；吾当以全策縻之〖3〗，可坐而制也。”诞以二年五月反，三年二月破灭。六军按甲〖4〗，深沟高垒；而诞自困，竟不烦攻而克。﹝二﹞","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":215,"anchor":null},"note_id":null,"start":0,"end":132},{"id":"wgc-q0304","section":"chapter-028","block":"b-3e13a9b79fa20e998b01","layer":"original","quote":"诞以二年五月反，三年二月破灭。六军按甲〖4〗，深沟高垒；而诞自困，竟不烦攻而克","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":215,"anchor":null},"note_id":null,"start":89,"end":128}],"profiles":{},"directory_counts":{}}
