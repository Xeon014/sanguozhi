{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-o017a","title":"昌霸等叛曹归刘备与孙乾通袁绍","accounts":[{"id":"xianzhu-e-o017a-account","label":"《先主传》正文","text":"昌霸即已登记的昌豨反曹，郡县归附刘备；刘备遣孙乾与袁绍连和。","evidence":["xianzhu-e-o017a-q"]}],"participants":[{"person":"wudi-p0151","role":"反曹","evidence":["xianzhu-e-o017a-q"]},{"person":"liu-bei","role":"遣使","evidence":["xianzhu-e-o017a-q"]},{"person":"xianzhu-p0027","role":"使袁绍","evidence":["xianzhu-e-o017a-q"]}],"place":{"text":"东海","evidence":["xianzhu-e-o017a-q"]},"time":{"year":199,"label":"刘备据徐州后","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xianzhu-y199","dating_review":{"reviewed":true,"anchor":"xianzhu-q-o014","basis":"刘备据徐州后"},"evidence":["xianzhu-e-o017a-q","xianzhu-q-o014","wudi-q-o061","wudi-q-b-51bced16741add42ff70"]},"source_order":[32,73,"O017a"],"order":6522}],"persons":[{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"wudi-p0151","name":"昌豨","facts":[],"aliases":[]},{"id":"xianzhu-p0027","name":"孙乾","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-q-b-51bced16741add42ff70","section":"chapter-001","block":"b-51bced16741add42ff70","layer":"modern","quote":"〖1〗四年：建安四年（公元 199）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":369,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-20628d34a709162c77f0","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o061","section":"chapter-001","block":"b-502d4e8c0ed143eaa30d","layer":"original","quote":"四年春二月〖1〗，公还至昌邑〖2〗。张杨将杨丑杀杨〖3〗。眭固又杀丑，以其众属袁绍，屯射犬〖4〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":358,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":49,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-o017a-q","section":"chapter-032","block":"b-7cba73e5d6ee78cda30a","layer":"original","quote":"东海昌霸反，郡县多叛曹公为先主〖7〗。众数万人，遣孙乾与袁绍连和〖8〗。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":72,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":36,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o014","section":"chapter-032","block":"b-9236c229b2cd9315f1e3","layer":"original","quote":"袁术欲经徐州北就袁绍，曹公遣先主督朱灵、路招要击术〖4〗。未至，术病死。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":60,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":36,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
