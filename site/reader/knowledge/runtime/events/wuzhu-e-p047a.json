{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wuzhu-e-p047a","title":"孙权试舟遇风谷利违命转舵保全后受敬重","accounts":[{"id":"wuzhu-e-p047a-account","label":"《江表传》","text":"孙权试舟遇风谷利违命转舵保全后受敬重","evidence":["wuzhu-e-p047a-q"]}],"participants":[{"person":"sun-quan","role":"试舟","evidence":["wuzhu-e-p047a-q"]},{"person":"wuzhu-p0013","role":"强谏转舵","evidence":["wuzhu-e-p047a-q"]}],"place":null,"time":{"label":"孙权武昌试长安船时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["wuzhu-e-p047a-q"]},"ordering_evidence":"wuzhu-e-p047a-q","source_order":[47,441,"P047a"],"order":8283}],"persons":[{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"wuzhu-p0013","name":"谷利","facts":[],"aliases":[]}],"evidence":[{"id":"wuzhu-e-p047a-q","section":"chapter-047","block":"b-988a85084750ad2ac394","layer":"pei","quote":"﹝二﹞《江表传》曰：“权于武昌，新装大船，名为‘长安’。试泛之钓台圻，时风大盛，谷利令舵工取樊口。权曰：‘当张头取罗州。’利拔刀向舵工曰：‘不取樊口者，斩！’工即转舵入樊口。风遂猛，不可行，乃还。权曰：‘阿利畏水何怯也？’利跪曰：‘大王万乘之主，轻于不测之渊，戏于猛浪之中；船楼装高，邂逅颠危，奈社稷何？是以利辄敢以死争！’权于是贵重之。自此后不复名之，常呼曰‘谷’。”","attribution":"《江表传》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":440,"anchor":null},"note_id":"n-30742eeb9da92f40cdda","start":0,"end":185}],"profiles":{},"directory_counts":{}}
