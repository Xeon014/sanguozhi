{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"shaodi-e-o129b","title":"改丘头为武丘彰淮南功","accounts":[{"id":"shaodi-e-o129b-account","label":"《三少帝纪》正文","text":"改丘头为武丘彰淮南功","evidence":["shaodi-e-o129b-q"]}],"participants":[],"place":null,"time":{"year":258,"label":"三月","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"shaodi-y258","dating_review":{"reviewed":true,"anchor":"shaodi-q-o129","basis":"三月"},"evidence":["shaodi-e-o129b-q","shaodi-q-o129","shaodi-q-b-ee7d999da8e03b038d07"]},"ordering_evidence":"shaodi-e-o129b-q","source_order":[4,576,"O129b"],"order":1196}],"persons":[],"evidence":[{"id":"shaodi-e-o129b-q","section":"chapter-004","block":"b-b1abcd215d0c852fc17c","layer":"original","quote":"三年春二月〖1〗，大将军司马文王陷寿春城，斩诸葛诞。三月，诏曰：“古者克敌，收其尸以为京观〖2〗，所以惩昏逆而彰武功也。汉孝武元鼎中〖3〗，改桐乡为闻喜〖4〗，新乡为获嘉〖5〗，以著南越之亡〖6〗。大将军亲总六戎〖7〗，营据丘头〖8〗；内夷群凶〖9〗，外殄寇虏〖10〗；功济兆民，声振四海。克敌之地，宜有令名〖11〗：其改‘丘头’为‘武丘’。明以武平乱，后世不忘；亦京观、二邑之义也〖12〗”。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":575,"anchor":null},"note_id":null,"start":0,"end":197},{"id":"shaodi-q-b-ee7d999da8e03b038d07","section":"chapter-004","block":"b-ee7d999da8e03b038d07","layer":"modern","quote":"〖1〗三年：甘露三年（公元 258）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":582,"anchor":null},"note_id":"n-663d9ce877d00f2d0cbc","start":0,"end":19},{"id":"shaodi-q-o129","section":"chapter-004","block":"b-b1abcd215d0c852fc17c","layer":"original","quote":"三年春二月〖1〗，大将军司马文王陷寿春城，斩诸葛诞。三月，诏曰：“古者克敌，收其尸以为京观〖2〗，所以惩昏逆而彰武功也。汉孝武元鼎中〖3〗，改桐乡为闻喜〖4〗，新乡为获嘉〖5〗，以著南越之亡〖6〗。大将军亲总六戎〖7〗，营据丘头〖8〗；内夷群凶〖9〗，外殄寇虏〖10〗；功济兆民，声振四海。克敌之地，宜有令名〖11〗：其改‘丘头’为‘武丘’。明以武平乱，后世不忘；亦京观、二邑之义也〖12〗”。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":575,"anchor":null},"note_id":null,"start":0,"end":197}],"profiles":{},"directory_counts":{}}
