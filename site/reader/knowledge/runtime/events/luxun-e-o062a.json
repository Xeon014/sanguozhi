{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"luxun-e-o062a","title":"陆抗拜奋威将军","accounts":[{"id":"luxun-e-o062a-account","label":"《陆逊传第十三》正文","text":"陆抗拜奋威将军","evidence":["luxun-e-o062a-q"]}],"participants":[{"person":"luxun-p0048","role":"受任","evidence":["luxun-e-o062a-q"]}],"place":null,"time":{"year":252,"label":"建兴元年","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"luxun-y252","dating_review":{"reviewed":true,"anchor":"luxun-q-o062","basis":"建兴元年"},"evidence":["luxun-e-o062a-q","luxun-q-o062","wuzhu-q-o166","shaodi-q-o052","shaodi-q-b-20272e7cc5379b3fe346"]},"ordering_evidence":"luxun-e-o062a-q","source_order":[58,287,"O062a"],"order":10375}],"persons":[{"id":"luxun-p0048","name":"陆抗","facts":[],"aliases":[]}],"evidence":[{"id":"luxun-e-o062a-q","section":"chapter-058","block":"b-a4ce40676ec0d8dc3720","layer":"original","quote":"建兴元年，拜奋威将军。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":286,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":11,"offset_unit":"unicode_code_point"},{"id":"luxun-q-o062","section":"chapter-058","block":"b-a4ce40676ec0d8dc3720","layer":"original","quote":"建兴元年，拜奋威将军。太平二年，魏将诸葛诞举寿春降；拜抗为柴桑督〖13〗，赴寿春，破魏牙门将、偏将军〖14〗。迁征北将军。","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":286,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":61,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-b-20272e7cc5379b3fe346","section":"chapter-004","block":"b-20272e7cc5379b3fe346","layer":"modern","quote":"〖17〗四年：嘉平四年（公元252）。癸卯：旧历初二日。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":230,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-db96ad991a403b6a010e","start":0,"end":28,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o052","section":"chapter-004","block":"b-944c76689fd8a3e8fa86","layer":"original","quote":"四年春正月，癸卯〖17〗，以抚军大将军司马景王为大将军。二月，立皇后张氏〖18〗，大赦。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":210,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":44,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o166","section":"chapter-047","block":"b-b62c4eca93eda253f3b0","layer":"original","quote":"二年春正月〖12〗，立故太子和为南阳王，居长沙〖13〗；子奋为齐王，居武昌；子休为琅邪王〖14〗，居虎林〖15〗。二月，大赦，改元为神凤。皇后潘氏薨。诸将吏数诣王表请福，表亡去。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":302,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":89,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
