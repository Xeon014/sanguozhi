{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhanggu-e-o005","title":"北方书疏归美昭策以管仲喻安之","accounts":[{"id":"zhanggu-a-295c610af3401ffa958d","label":"正文","text":"北方书疏归美昭策以管仲喻安之","evidence":["zhanggu-q-e7592f0f32d5c24a3ae7"]}],"participants":[{"person":"wendi-p0133","role":"得北方士大夫书疏专归美于昭、欲默而不宣则惧有私宣之则恐非宜进退不安","evidence":["zhanggu-q-e7592f0f32d5c24a3ae7"]},{"person":"wudi-p0099","role":"闻之欢笑曰昔管仲相齐一则仲父二则仲父而桓公为霸者宗今子布贤我能用之其功名独不在我乎","evidence":["zhanggu-q-e7592f0f32d5c24a3ae7"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["zhanggu-q-e7592f0f32d5c24a3ae7"]},"ordering_evidence":"zhanggu-q-e7592f0f32d5c24a3ae7","source_order":[52,4,0],"order":9240}],"persons":[{"id":"wendi-p0133","name":"张昭","facts":[],"aliases":[]},{"id":"wudi-p0099","name":"孙策","facts":[],"aliases":[]}],"evidence":[{"id":"zhanggu-q-e7592f0f32d5c24a3ae7","section":"chapter-052","block":"b-f23637db19ae241e2012","layer":"original","quote":"昭每得北方士大夫书疏，专归美于昭。昭欲默而不宣，则惧有私；宣之，则恐非宜：进退不安。策闻之，欢笑曰：“昔管仲相齐，一则仲父〖9〗，二则仲父；而桓公为霸者宗〖10〗。今子布贤，我能用之；其功名独不在我乎","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":3,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":100,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
