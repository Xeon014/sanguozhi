1a1a12d","chapter-013":"24c6e486e7f78fc4d59ff01277b36cb77ffb69c68a6a9030889fe00efe4b3d27","chapter-016":"6cfac20452f269a832b087d2e808cc4b3017944d17dca1d5b1e068ebb98d8327","chapter-018":"7a62f43c1f5dc64661b088ef0fdd48392063ef5c49001fa980aa65e766380b23","chapter-019":"a43f6648e6c9d8389d561bee9d00824665f8f06542ab2a65aac06ed8a7601c5b","chapter-020":"2ef7e28be018140e07d27d7636a9df480a5cb7ef1cb3572c314a70e0d1acd07c","chapter-050":"71faaaddb69f25a5bdd7f315f15562e867eed9e897c9bd439a99a09c435bfe91","chapter-023":"908d4e64a01e171bdb09c0a7ee5484b8743be26b7cc75f49bd8b41b7ff391ff2","chapter-024":"39be893c0040dbb3148f9447402c47fc24dcb4356360f8558243258cb85b089a","chapter-025":"f37fc365e7d07f96b5fd289119e1846fe7f0030d8b46a7195fab316badf817b7","chapter-027":"dd48b2052380e1f6b6f6ffcb4835dd99cfe70efe4a9096fa51448dbdfaa14f00","chapter-062":"7031fb8ebde1ea3c95cdedcf93218fb46f69a71a29a1d9e82361f7108436a86a","chapter-063":"3ae8edfbae98c3e86a518f7022c664ed35a0d68d5ac36b331ceb560e76b1848f","chapter-065":"13c50dd7dc9a229aef1cfb43dd231955a0b1a6359dab04c54708df93fa114e12","chapter-057":"39e3922e223fe25b811b77f14049327071298549de6ed788ba7da697f067f2e3","chapter-021":"18c02b71e8f81644cf71ffea582a8e019509de0b5e9bc11451de595fa03e2cf3","chapter-029":"6ffb35bac29d20aa512b5a734e72f98ec5729b176f1bc5d6837e673bcc00880d","chapter-030":"3e0682212c3e242d0f221308bc203bd8309851b8498b94db16383bdde5234ce1"},"events":[{"id":"xumisun-e-o021","title":"许靖与曹操书","accounts":[{"id":"xumisun-a-1dac36e3f6fdd0cec05a","label":"正文","text":"许靖与曹操书","evidence":["xumisun-q-e84171f1cb1a026bb16d","xumisun-q2-3535e789bcc1bfe41a25","xumisun-q-8072121bbfe3d7c46942","xumisun-q-2f71dbc54e19fe88f451","xumisun-q-9955c80f6d6baf3faf35","xumisun-q-4fffd8d2d12facdb131b","xumisun-q-49275c082059d3831804","xumisun-q-6a10059fbebcccfd22a4","xumisun-q-6dd846f8086eb1904c31"]}],"participants":[{"person":"xianzhu-p0059","role":"自交州与曹操上书陈情","evidence":["xumisun-q-e84171f1cb1a026bb16d"]},{"person":"cao-cao","role":"受许靖书","evidence":["xumisun-q-e84171f1cb1a026bb16d"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["xumisun-q-e84171f1cb1a026bb16d"]},"ordering_evidence":"xumisun-q-e84171f1cb1a026bb16d","source_order":[38,36,42],"order":7026}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"xianzhu-p0059","name":"许靖","facts":[],"aliases":[]}],"evidence":[{"id":"xumisun-q-2f71dbc54e19fe88f451","section":"chapter-038","block":"b-13fc34aae44fcaec731a","layer":"original","quote":"既济南海〖34〗，与领守兒孝德相见〖35〗。知足下忠义奋发，整饬元戎〖36〗，西迎大驾，巡省中岳〖37〗。承此休问〖38〗，且悲且喜；即与袁沛及徐元贤复共严装〖39〗，欲北上荆州。会苍梧诸县，夷越蜂起〖40〗；州府倾覆〖41〗，道路阻绝；元贤被害，老弱并杀。靖寻循渚岸，五千余里，复遇疾疠〖42〗；伯母陨命〖43〗，并及群从〖44〗：自诸妻子〖45〗，一时略尽。复相扶（侍）〔持〕，前到此郡〖46〗；计为兵害及病亡者，十遗一二。生民之艰〖47〗，辛苦之甚，岂可具陈哉！﹝二﹞","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":37,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":237,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-49275c082059d3831804","section":"chapter-038","block":"b-32643b373166fd57d74c","layer":"original","quote":"昔营丘翼周〖76〗，杖钺专征〖77〗；博陆佐汉〖78〗，虎贲警跸〖79〗。﹝四﹞今日足下扶危持倾，为国柱石；秉师望之任〖80〗，兼霍光之重；五侯九伯〖81〗，制御在手。自古及今，人臣之尊，未有及足下者也。夫爵高者忧深，禄厚者责重。足下据爵高之任，当责重之地；言出于口，即为赏罚；意之所存，便为祸福。行之得道，即社稷用宁；行之失道，即四方散乱。国家安危，在于足下；百姓之命，悬于执事。","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":40,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":191,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-4fffd8d2d12facdb131b","section":"chapter-038","block":"b-2be3027a41401032d77a","layer":"original","quote":"知圣主允明〖61〗，显授足下专征之任〖62〗：凡诸逆节〖63〗，多所诛讨；想力竞者一心〖64〗，顺从者同规矣。又张子云昔在京师〖65〗，志匡王室；今虽临荒域〖66〗，不得参与本朝〖67〗，亦国家之藩镇，足下之外援也。﹝三﹞若荆楚平和〖68〗，王泽南至〖69〗；足下忽有声命於子云，勤见保属〖70〗，令得假途由荆州出〖71〗；不然，当复相绍介於益州兄弟〖72〗，使相纳受。倘天假其年〖73〗，人缓其祸；得归死国家，解逋逃之负〖74〗；泯躯九泉，将复何恨？若时有险易，事有利钝，人命无常，陨没不达者；则永衔罪责，入于裔土矣〖75〗。","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":39,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":264,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-6a10059fbebcccfd22a4","section":"chapter-038","block":"b-1ec5c7e46915ae9eb3f0","layer":"original","quote":"自华及夷〖82〗，颙颙注望〖83〗。足下任此，岂可不远览载籍废兴之由〖84〗，荣辱之机；弃忘旧恶，宽和群司〖85〗；审量五材〖86〗，为官择人？苟得其人，虽仇必举；苟非其人，虽亲不授。以宁社稷，以济下民；事立功成，则系音于管弦〖87〗，勒勋于金石〖88〗。","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":41,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":128,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-6dd846f8086eb1904c31","section":"chapter-038","block":"b-9e8f543dcd2a100be219","layer":"original","quote":"愿君勉之，为国自重，为民自爱！","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":42,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":15,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-8072121bbfe3d7c46942","section":"chapter-038","block":"b-3b7a06fb39624940616e","layer":"original","quote":"世路戎夷〖14〗，祸乱遂合；驽怯偷生，自窜蛮貊〖15〗；（成）〔契〕阔十年〖16〗，吉凶礼废。昔在会稽，得所贻书；辞旨款密〖17〗，久要不忘〖18〗。迫於袁术方命圮族〖19〗，扇动群逆，津途四塞；虽悬心北风〖20〗，欲行靡由〖21〗。正礼师退〖22〗，术兵前进〖23〗；会稽倾覆〖24〗，景兴失据〖25〗；三江五湖〖26〗，皆为虏庭〖27〗。临时困厄〖28〗，无所控告〖29〗；便与袁沛、邓子孝等浮涉沧海，南至交州。经历东瓯、闽越之国〖30〗，行经万里，不见汉地；漂薄风波〖31〗，绝粮茹草〖32〗；饥殍荐臻〖33〗，死者大半。","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":36,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":264,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-9955c80f6d6baf3faf35","section":"chapter-038","block":"b-01b905ea8bebbb78da6d","layer":"original","quote":"惧猝颠仆〖48〗，永为亡虏〖49〗；忧瘁惨惨〖50〗，忘寝与食。欲附奉朝贡使〖51〗，自获济通，归死阙庭〖52〗；而荆州水陆无津，交部驿使断绝。欲上益州，复有峻防〖53〗；故官长吏，一不得入。前令交阯太守士威彦〖54〗，深相分托于益州兄弟〖55〗；又靖亦自与书，辛苦恳侧；而复寂寞〖56〗，未有报应〖57〗。虽仰瞻光灵〖58〗，延颈企踵〖59〗，何由假翼自致哉〖60〗？","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":38,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":185,"offset_unit":"unicode_code_point"},{"id":"xumisun-q-e84171f1cb1a026bb16d","section":"chapter-038","block":"b-bf4e8ab7d05eaf89b85e","layer":"original","quote":"靖与曹公书曰","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":35,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":42,"end":48,"offset_unit":"unicode_code_point"},{"id":"xumisun-q2-3535e789bcc1bfe41a25","section":"chapter-038","block":"b-bf4e8ab7d05eaf89b85e","layer":"original","quote":"靖与曹公书曰：","section_title":"许麋孙简伊秦传第八","source":{"file":"OEBPS/Text/titlepage_0082.xhtml","index":35,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":42,"end":49,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
