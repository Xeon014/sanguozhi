{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"yuanzhang-e-o055","title":"田畴得报驰还，未至而刘虞已为公孙瓒所害","accounts":[{"id":"yuanzhang-a-601c0a042d4931732f37","label":"正文","text":"田畴得报驰还，未至而刘虞已为公孙瓒所害","evidence":["yuanzhang-q-eda6768457c2bf8632dc"]},{"id":"yuanzhang-a-548e89436ea5d5465240","label":"正文","text":"田畴至刘虞墓，谒祭，陈发章报，哭泣而去。","evidence":["yuanzhang-q-857628b8201eaa1c99a3","yuanzhang-q2-f9fb057ef4ffcd64f5cd"]},{"id":"yuanzhang-a-7f8f17c447d2c3a7b506","label":"正文","text":"公孙瓒闻之大怒，购求获田畴，问何自哭刘虞墓而不送章报","evidence":["yuanzhang-q-a3df0aceba74593d90e0"]},{"id":"yuanzhang-a-9272f895653b288322c6","label":"正文","text":"田畴答汉室衰颓唯刘公不失忠节，章报于将军未美故不进","evidence":["yuanzhang-q-51a11114066524cc4772"]},{"id":"yuanzhang-a-98e12d20de59f69d66f3","label":"正文","text":"公孙瓒壮田畴之对，释不诛，拘之军下禁故人与通","evidence":["yuanzhang-q-e0307dd7e30c16ab718d"]},{"id":"yuanzhang-a-21d9aaac37c173157126","label":"正文","text":"或人说公孙瓒田畴义士囚之恐失众心，瓒乃纵遣畴","evidence":["yuanzhang-q-b0e3f0574e4762196a69"]}],"participants":[{"person":"wudi-p0243","role":"得报驰还，谒祭刘虞墓、陈发章报；被公孙瓒拘留后获释","evidence":["yuanzhang-q-eda6768457c2bf8632dc","yuanzhang-q-857628b8201eaa1c99a3","yuanzhang-q-a3df0aceba74593d90e0","yuanzhang-q-51a11114066524cc4772","yuanzhang-q-e0307dd7e30c16ab718d","yuanzhang-q-b0e3f0574e4762196a69","yuanzhang-q2-f9fb057ef4ffcd64f5cd"]},{"person":"wudi-p0079","role":"已为公孙瓒所害；墓被田畴谒祭；被称唯刘公不失忠节","evidence":["yuanzhang-q-eda6768457c2bf8632dc","yuanzhang-q-857628b8201eaa1c99a3","yuanzhang-q-51a11114066524cc4772"]},{"person":"wudi-p0093","role":"闻之大怒，购求获田畴；壮其对释不诛，拘之军下，禁其故人莫得与通；闻说后纵遣田畴","evidence":["yuanzhang-q-a3df0aceba74593d90e0","yuanzhang-q-e0307dd7e30c16ab718d","yuanzhang-q-b0e3f0574e4762196a69"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["yuanzhang-q-eda6768457c2bf8632dc","yuanzhang-q-857628b8201eaa1c99a3","yuanzhang-q-a3df0aceba74593d90e0","yuanzhang-q-51a11114066524cc4772","yuanzhang-q-e0307dd7e30c16ab718d","yuanzhang-q-b0e3f0574e4762196a69"]},"ordering_evidence":"yuanzhang-q-eda6768457c2bf8632dc","source_order":[11,175,0],"order":2578}],"persons":[{"id":"wudi-p0079","name":"刘虞","facts":[],"aliases":[]},{"id":"wudi-p0093","name":"公孙瓒","facts":[],"aliases":[]},{"id":"wudi-p0243","name":"田畴","facts":[],"aliases":[]}],"evidence":[{"id":"yuanzhang-q-51a11114066524cc4772","section":"chapter-011","block":"b-ae7e3077c7a8d77a0a57","layer":"original","quote":"畴答曰：“汉室衰颓，人怀异心；唯刘公不失忠节〖17〗。章报所言，于将军未美〖18〗；恐非所乐闻，故不进也。且将军方举大事，以求所欲，既灭无罪之君，又仇守义之臣；诚行此事〖19〗，则燕、赵之士将皆蹈东海而死耳〖20〗：岂忍有从将军者乎","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":174,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":87,"end":203,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-857628b8201eaa1c99a3","section":"chapter-011","block":"b-ae7e3077c7a8d77a0a57","layer":"original","quote":"畴至，谒祭虞墓；陈发章（表）〔报〕〖15〗，哭泣而去","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":174,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":22,"end":48,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-a3df0aceba74593d90e0","section":"chapter-011","block":"b-ae7e3077c7a8d77a0a57","layer":"original","quote":"瓒闻之大怒，购求，获畴〖16〗。谓曰：“汝何自哭刘虞墓，而不送章报于我也","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":174,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":49,"end":85,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-b0e3f0574e4762196a69","section":"chapter-011","block":"b-d43248b3d72d611fac58","layer":"original","quote":"或说瓒曰：“田畴义士，君弗能礼；而又囚之，恐失众心。”瓒乃纵遣畴","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":175,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":28,"end":60,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-e0307dd7e30c16ab718d","section":"chapter-011","block":"b-d43248b3d72d611fac58","layer":"original","quote":"瓒壮其对，释不诛也；拘之军下〖21〗，禁其故人莫得与通","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":175,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":27,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q-eda6768457c2bf8632dc","section":"chapter-011","block":"b-ae7e3077c7a8d77a0a57","layer":"original","quote":"得报〖14〗，驰还；未至，虞已为公孙瓒所害","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":174,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"yuanzhang-q2-f9fb057ef4ffcd64f5cd","section":"chapter-011","block":"b-ae7e3077c7a8d77a0a57","layer":"original","quote":"得报〖14〗，驰还；未至，虞已为公孙瓒所害。畴至，谒祭虞墓；陈发章（表）〔报〕〖15〗，哭泣而去。瓒闻之大怒，购求，获畴〖16〗。谓曰：“汝何自哭刘虞墓，而不送章报于我也？”畴答曰：“汉室衰颓，人怀异心；唯刘公不失忠节〖17〗。章报所言，于将军未美〖18〗；恐非所乐闻，故不进也。且将军方举大事，以求所欲，既灭无罪之君，又仇守义之臣；诚行此事〖19〗，则燕、赵之士将皆蹈东海而死耳〖20〗：岂忍有从将军者乎！”","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":174,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":205,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
