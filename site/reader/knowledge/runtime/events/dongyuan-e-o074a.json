{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dongyuan-e-o074a","title":"陈珪答书拒袁术劝同匡汉","accounts":[{"id":"dongyuan-e-o074a-account","label":"《董二袁刘传第六》正文","text":"陈珪答书拒袁术劝同匡汉","evidence":["dongyuan-e-o074a-q"]}],"participants":[{"person":"dongyuan-p0039","role":"答书拒附","evidence":["dongyuan-e-o074a-q"]},{"person":"wudi-p0057","role":"收书","evidence":["dongyuan-e-o074a-q"]}],"place":null,"time":{"label":"陈珪答袁术时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-o074a-q"]},"ordering_evidence":"dongyuan-e-o074a-q","source_order":[6,404,"O074a"],"order":1727}],"persons":[{"id":"dongyuan-p0039","name":"陈珪","facts":[],"aliases":[]},{"id":"wudi-p0057","name":"袁术","facts":[],"aliases":[]}],"evidence":[{"id":"dongyuan-e-o074a-q","section":"chapter-006","block":"b-39a40a126fa53840c495","layer":"original","quote":"珪答书曰：“昔秦末世，肆暴恣情，虐流天下，毒被生民；下不堪命，故遂土崩。今虽季世〖8〗，未有亡秦苛暴之乱也。曹将军神武应期〖9〗，兴复典刑〖10〗；将拨平凶慝〖11〗，清定海内：信有征矣〖12〗。以为足下当戮力同心〖13〗，匡翼汉室；而阴谋不轨〖14〗，以身试祸：岂不痛哉！若迷而知反，尚可以免。吾备旧知〖15〗，故陈至情；虽逆于耳，骨肉之惠也〖16〗。欲吾营私阿附，有犯死不能也！”","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":403,"anchor":null},"note_id":null,"start":0,"end":192}],"profiles":{},"directory_counts":{}}
