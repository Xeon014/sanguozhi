{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhonghua-e-o127","title":"太子书报钟繇，繇答书引同郡故司空荀爽语，顾念孙权了更妩媚","accounts":[{"id":"zhonghua-a-a90ba55c198a45e44618","label":"裴注·魏略","text":"太子书报钟繇，繇答书引同郡故司空荀爽语，顾念孙权了更妩媚","evidence":["zhonghua-q-051f7150cb029b629f20"]},{"id":"zhonghua-a-afeaa2c41ae2e5c43df9","label":"裴注·魏略","text":"太子又书，称荀公之清谈孙权之妩媚，若权复黠当折以汝南许劭月旦之评","evidence":["zhonghua-q-22e49a2f9f2906335545"]}],"participants":[{"person":"wudi-p0170","role":"书报者；又书者","evidence":["zhonghua-q-051f7150cb029b629f20","zhonghua-q-22e49a2f9f2906335545"]},{"person":"wudi-p0181","role":"答书者","evidence":["zhonghua-q-051f7150cb029b629f20"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["zhonghua-q-051f7150cb029b629f20","zhonghua-q-22e49a2f9f2906335545"]},"ordering_evidence":"zhonghua-q-051f7150cb029b629f20","source_order":[13,51,20],"order":2863}],"persons":[{"id":"wudi-p0170","name":"曹丕","facts":[],"aliases":[]},{"id":"wudi-p0181","name":"钟繇","facts":[],"aliases":[]}],"evidence":[{"id":"zhonghua-q-051f7150cb029b629f20","section":"chapter-013","block":"b-99af87e1e34a6bef26fb","layer":"pei","quote":"太子书报繇，繇答书曰：‘臣同郡故司空荀爽言：“人当道情。爱我者，一何可爱！憎我者，一何可憎！”顾念孙权，了更妩媚。’","attribution":"裴注·魏略","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":50,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-334fcd776faf7da504c3","start":20,"end":78,"offset_unit":"unicode_code_point"},{"id":"zhonghua-q-22e49a2f9f2906335545","section":"chapter-013","block":"b-99af87e1e34a6bef26fb","layer":"pei","quote":"太子又书曰：‘得报，知喜南方。至于荀公之清谈，孙权之妩媚；执书嗢噱，不能离手。若权复黠，当折以汝南许劭月旦之评。权优游二国，俯仰荀、许，亦已足矣。’","attribution":"裴注·魏略","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":50,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-334fcd776faf7da504c3","start":78,"end":152,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
