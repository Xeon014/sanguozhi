{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o096a","title":"曹操免河北租赋并重抑兼并","accounts":[{"id":"wudi-e-o096a-account","label":"正文","text":"曹操下令河北当年免租赋，加强约束豪强兼并；天子令其领冀州牧，曹操交还兖州。","evidence":["wudi-e-o096a-q"]}],"participants":[{"person":"cao-cao","role":"颁令领州","evidence":["wudi-e-o096a-q"]},{"person":"wudi-p0054","role":"授官","evidence":["wudi-e-o096a-q"]}],"place":{"text":"河北、冀州、兖州","evidence":["wudi-e-o096a-q"]},"time":{"label":"建安九年九月","year":204,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o096a-q","wudi-q-o092","wudi-q-b-6787e3ddd3e334b677d4"],"chronology":"wudi-y204","dating_review":{"anchor":"wudi-q-o092","basis":"建安九年九月","reviewed":true}},"source_order":[1,541,"O096a"],"order":226}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0054","name":"汉献帝","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-o096a-q","section":"chapter-001","block":"b-72f6b40e6d69899e4c06","layer":"original","quote":"九月，令曰：“河北罹袁氏之难〖1〗。其令无出今年租赋〖2〗！”重豪强兼并之法〖3〗，百姓喜悦。﹝一﹞天子以公领冀州牧，公让还兖州。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":540,"anchor":null},"note_id":null,"start":0,"end":65},{"id":"wudi-q-b-6787e3ddd3e334b677d4","section":"chapter-001","block":"b-6787e3ddd3e334b677d4","layer":"modern","quote":"〖1〗九年：建安九年（公元 204）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":510,"anchor":null},"note_id":"n-c8fff97bafc82c655f3f","start":0,"end":19},{"id":"wudi-q-o092","section":"chapter-001","block":"b-3e549c423b15df48398a","layer":"original","quote":"九年春正月〖1〗，济河，遏淇水入白沟以通粮道〖2〗。二月，尚复攻谭，留苏由、审配守邺〖3〗。公进军到洹水〖4〗，由降；既至，攻邺，为土山、地道。武安长尹楷屯毛城〖5〗，通上党粮道〖6〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":506,"anchor":null},"note_id":null,"start":0,"end":93}],"profiles":{},"directory_counts":{}}
