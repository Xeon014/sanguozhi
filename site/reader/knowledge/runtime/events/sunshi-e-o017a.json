{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"sunshi-e-o017a","title":"袁术疑孙坚停粮孙坚夜见申说袁术复供粮","accounts":[{"id":"sunshi-e-o017a-account","label":"《孙破虏讨逆传第一》正文","text":"袁术疑孙坚停粮孙坚夜见申说袁术复供粮","evidence":["sunshi-e-o017a-q"]},{"id":"sunshi-e-p016a-account","label":"《江表传》","text":"有人以得洛难制离间孙坚袁术因而疑之","evidence":["sunshi-e-p016a-q"]},{"id":"sunshi-e-p017a-account","label":"《江表传》","text":"孙坚以吴起乐毅为鉴劝袁术续军粮","evidence":["sunshi-e-p017a-q"]}],"participants":[{"person":"wudi-p0057","role":"断粮复供","evidence":["sunshi-e-o017a-q"]},{"person":"wudi-p0119","role":"驰见申说","evidence":["sunshi-e-o017a-q"]}],"place":null,"time":{"label":"阳人战后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["sunshi-e-o017a-q"]},"ordering_evidence":"sunshi-e-o017a-q","source_order":[46,129,"O017a"],"order":8043}],"persons":[{"id":"wudi-p0057","name":"袁术","facts":[],"aliases":[]},{"id":"wudi-p0119","name":"孙坚","facts":[],"aliases":[]}],"evidence":[{"id":"sunshi-e-o017a-q","section":"chapter-046","block":"b-5b14c23aafd54e4e2666","layer":"original","quote":"是时，或间坚于术〖1〗；术怀疑，不运军粮。﹝一﹞阳人，去鲁阳百余里；坚夜驰见术，画地计校，曰：“所以出身不顾，上为国家讨贼，下慰将军家门之私仇〖2〗；坚与卓，非有骨肉之怨也〖3〗。而将军受谮润之言〖4〗，还相嫌疑〖5〗！”﹝二﹞术踧踖〖6〗，即调发军粮，坚还屯。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":128,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":131,"offset_unit":"unicode_code_point"},{"id":"sunshi-e-p016a-q","section":"chapter-046","block":"b-036b5c6564ab93956fa5","layer":"pei","quote":"﹝一﹞《江表传》曰：“或谓术曰：‘坚若得洛，不可复制；此为除狼而得虎也！’故术疑之。”","attribution":"《江表传》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":160,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8e4b25adf4aff45b51bb","start":0,"end":43,"offset_unit":"unicode_code_point"},{"id":"sunshi-e-p017a-q","section":"chapter-046","block":"b-67c999ea8dc8388e2e9a","layer":"pei","quote":"﹝二﹞《江表传》载坚语曰：“大勋垂捷而军粮不继：此吴起所以叹泣于西河，乐毅所以遗恨于垂成也！愿将军深思之。”","attribution":"《江表传》","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":161,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-67ddb287fe300a60f2f0","start":0,"end":54,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
