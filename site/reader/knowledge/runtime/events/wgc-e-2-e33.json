{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wgc-e-2-e33","title":"邓艾年十二随母至颍川","order":5621,"accounts":[{"id":"wgc-a-2-e33","label":"正文 · 年十二","text":"邓艾年十二随母至颍川","evidence":["wgc-q0315","wgc-q0035"]}],"participants":[{"person":"shaodi-p0080","role":"年十二随母至颍川","evidence":["wgc-q0315","wgc-q0035"]}],"place":null,"time":{"label":"年十二","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0315","wgc-q0035"]},"ordering_evidence":"wgc-q0315"}],"persons":[{"id":"shaodi-p0080","name":"邓艾","facts":[],"aliases":[]}],"evidence":[{"id":"wgc-q0035","section":"chapter-028","block":"b-80b838a103a1e5853a53","layer":"original","quote":"邓艾字士载，义阳棘阳人也〖1〗。少孤〖2〗，太祖破荆州，徙汝南，为农民养犊。年十二，随母至颍川。读故太丘长陈寔碑文〖3〗，言“文为世范，行为士则”；艾遂自名范，字士则。后宗族有与同者，故改焉。为都尉学士〖4〗，以口吃，不得作干佐〖5〗，为稻田守丛草吏。同郡吏父怜其家贫，资给甚厚，艾初不称谢〖6〗。每见高山大泽，辄规度指画军营处所，时人多笑焉。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":236,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":172,"offset_unit":"unicode_code_point"},{"id":"wgc-q0315","section":"chapter-028","block":"b-80b838a103a1e5853a53","layer":"original","quote":"年十二，随母至颍川","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":236,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":38,"end":47,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
