{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p013d","title":"曹操再谏州县举奏偏私","accounts":[{"id":"wudi-e-p013d-account","label":"《魏书》","text":"曹操借灾异问政再谏三公举奏偏私；皇帝责让三府，将因谣言被征者改拜议郎。","evidence":["wudi-e-p013d-q"]}],"participants":[{"person":"cao-cao","role":"进谏","evidence":["wudi-e-p013d-q"]},{"person":"wudi-p0025","role":"责让三府","evidence":["wudi-e-p013d-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p013d-q"]},"source_order":[1,39,"P013d"],"order":26}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0025","name":"汉灵帝","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-p013d-q","section":"chapter-001","block":"b-c8ebb5719c067c6530d1","layer":"pei","quote":"是后诏书敕三府：举奏州县政理无效，民为作谣言者，免罢之。三公倾邪，皆希世见用，货赂并行。强者为怨，不见举奏；弱者守道，多被陷毁。太祖疾之。是岁，以灾异博问得失，因此复上书切谏，说三公所举奏专回避贵戚之意。奏上，天子感悟，以示三府，责让之；诸以谣言征者，皆拜议郎。是后政教日乱，豪猾益炽，多所摧毁。太祖知不可匡正，遂不复献言。","attribution":"《魏书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":38,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-93b8bf4cd95e2ce6a347","start":100,"end":262,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
