{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wangwei-e-8a4f94f2ed95fc70bee8","title":"刘劭议：贼众新至心专气锐，宜先遣步兵五千精骑三千，扬声进道，曜兵城下，拟其归路、要其粮道，贼必震怖遁走；帝从之","accounts":[{"id":"wangwei-a-8a4f94f2ed95fc70bee8","label":"正文","text":"刘劭议：贼众新至心专气锐，宜先遣步兵五千精骑三千，扬声进道，曜兵城下，拟其归路、要其粮道，贼必震怖遁走；帝从之","evidence":["wangwei-q-6515567a79485a0664fd"]}],"participants":[{"person":"huanchen-p0003","role":"献策者","evidence":["wangwei-q-6515567a79485a0664fd"]},{"person":"wendi-p0005","role":"从议者","evidence":["wangwei-q-6515567a79485a0664fd"]}],"place":null,"time":{"label":"青龙中","precision":"undated","basis":"保留原纪年及粒度；本账户未独立归一公元年，不继承相邻事件年份。","evidence":["wangwei-q-6515567a79485a0664fd"]},"ordering_evidence":"wangwei-q-6515567a79485a0664fd","order":4367}],"persons":[{"id":"huanchen-p0003","name":"刘劭","facts":[],"aliases":[]},{"id":"wendi-p0005","name":"曹叡","facts":[],"aliases":[]}],"evidence":[{"id":"wangwei-q-6515567a79485a0664fd","section":"chapter-021","block":"b-3ac3e0851d07498d52be","layer":"original","quote":"劭议以为：“贼众新至，心专气锐。宠以少人自战其地，若便进击，不必能制〖15〗。宠求待兵，未有所失也。以为可先遣步兵五千，精骑三千，军前发〖16〗；扬声进道〖17〗，震曜形势。骑到合肥，疏其行队，多其旌鼓，曜兵城下；引出贼后，拟其归路〖18〗，要其粮道〖19〗。贼闻大军来，骑断其后；必震怖遁走，不战自破贼矣。”帝从之","section_title":"王卫二刘傅传第二十一","source":{"file":"OEBPS/Text/titlepage_0048.xhtml","index":349,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":57,"end":215,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
