e_id":"n-a0fe7cc485014c90c5c0","start":0,"end":107,"offset_unit":"unicode_code_point"},{"id":"hechang-q-e721646aa7b271ebcad8","section":"chapter-023","block":"b-42927788712d6fb53b06","layer":"pei","quote":"臣松之按《魏武纪》：破绍后，得许下军中人书，皆焚之。若故“使人搜阅”，知其有无，则非所以安人情也。疑此语为不然。","attribution":"裴注·裴松之评论","section_title":"和常杨杜赵裴传第二十三","source":{"file":"OEBPS/Text/titlepage_0052.xhtml","index":304,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a0fe7cc485014c90c5c0","start":107,"end":163,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
