{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p157d","title":"曹操杀小斛发粮主者之记","accounts":[{"id":"wudi-e-p157d-account","label":"《曹瞒传》","text":"《曹瞒传》称曹操准用小斛发粮，众议其欺众，便杀主者以平众议，宣称其盗谷。","evidence":["wudi-e-p157d-q"]}],"participants":[{"person":"cao-cao","role":"据书中记载杀主者","evidence":["wudi-e-p157d-q"]}],"place":null,"time":{"label":"一次征讨缺粮时","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p157d-q"]},"source_order":[1,1137,"P157d"],"order":459}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-p157d-q","section":"chapter-001","block":"b-b02c08a63c1f0172f907","layer":"pei","quote":"尝讨贼，廪谷不足。私谓主者曰：‘如何？’主者曰：‘可以小斛以足之。’太祖曰：‘善！’后军中言太祖欺众，太祖谓主者曰：‘特当借君死以厌众，不然，事不解。’乃斩之，取首题徇曰：‘行小斛，盗官谷。’斩之军门。","attribution":"《曹瞒传》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":461,"anchor":null},"note_id":"n-6c928ccff5d542bc3225","start":415,"end":516}],"profiles":{},"directory_counts":{}}
