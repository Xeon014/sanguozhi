xt/titlepage_0070.xhtml","index":199,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":52,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-b-e74ba7effc86126dc3fe","section":"chapter-032","block":"b-e74ba7effc86126dc3fe","layer":"modern","quote":"〖1〗二十年：建安二十年（公元 215）。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":212,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5302047b97c4e4d2cb00","start":0,"end":21,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-o044","section":"chapter-032","block":"b-fcd99756379fb59ed6f5","layer":"original","quote":"二十年〖1〗，孙权以先主已得益州，使使报“欲得荆州〖2〗”。先主言：“须得凉州，当以荆州相与。”权忿之，乃遣吕蒙袭夺长沙、零陵、桂阳三郡〖3〗。先主引兵五万下公安，令关羽入益阳〖4〗。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":199,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":92,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
