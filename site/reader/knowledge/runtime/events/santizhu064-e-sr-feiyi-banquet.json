{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"santizhu064-e-sr-feiyi-banquet","title":"《恪别传》权飨蜀使费祎、祎嘲伏食、恪答、各作赋","accounts":[{"id":"santizhu064-a-3d7cb7e6a965a4cfcb6f","label":"裴注·恪别传","text":"权飨蜀使费祎，先逆敕群臣伏食勿起；祎至嘲驴骡伏食；恪答爰植梧桐有何燕雀；祎停食索笔作麦赋，恪请笔作磨赋，咸称善","evidence":["santizhu064-q-560ec41b35e9e95cb49b"]}],"participants":[{"person":"sun-quan","role":"飨蜀使并预敕群臣","evidence":["santizhu064-q-560ec41b35e9e95cb49b"]},{"person":"shaodi-p0051","role":"使吴、嘲吴臣、作麦赋","evidence":["santizhu064-q-560ec41b35e9e95cb49b"]},{"person":"shaodi-p0041","role":"答嘲并作磨赋","evidence":["santizhu064-q-560ec41b35e9e95cb49b"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"未由相邻段落推算纪年；原文时间表达保留在来源引句中。","evidence":["santizhu064-q-560ec41b35e9e95cb49b"]},"ordering_evidence":"santizhu064-q-560ec41b35e9e95cb49b","source_order":[64,28,0],"order":10927}],"persons":[{"id":"shaodi-p0041","name":"诸葛恪","facts":[],"aliases":[]},{"id":"shaodi-p0051","name":"费祎","facts":[],"aliases":[]},{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]}],"evidence":[{"id":"santizhu064-q-560ec41b35e9e95cb49b","section":"chapter-064","block":"b-e8c408211dc6ad158d52","layer":"pei","quote":"权尝飨蜀使费祎，先逆敕群臣：‘使至，伏食勿起！’祎至，权为辍食，而群下不起。祎啁之曰：‘凤凰来翔，骐T吐哺；驴骡无知，伏食如故。’恪答曰：‘爰植梧桐，以待凤凰；有何燕雀，自称来翔？何不弹射，使还故乡！’祎停食饼，索笔作麦赋；恪亦请笔，作磨赋：咸称善焉。","attribution":"裴注·恪别传","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":27,"anchor":null},"note_id":"n-12b3579a9c9a4da79693","start":11,"end":137}],"profiles":{},"directory_counts":{}}
