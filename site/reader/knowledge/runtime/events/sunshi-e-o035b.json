{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"sunshi-e-o035b","title":"孙策顾命张昭等辅弟孙权授印绶","accounts":[{"id":"sunshi-e-o035b-account","label":"《孙破虏讨逆传第一》正文","text":"孙策顾命张昭等辅弟孙权授印绶","evidence":["sunshi-e-o035b-q"]},{"id":"zhanggu-a-78e1c58ea66ae7955e8b","label":"正文","text":"策临亡托权于昭率群僚辅之","evidence":["zhanggu-q-239b07564b5677c78ac9"]}],"participants":[{"person":"wudi-p0099","role":"顾命授印","evidence":["sunshi-e-o035b-q"]},{"person":"wendi-p0133","role":"受托","evidence":["sunshi-e-o035b-q"]},{"person":"sun-quan","role":"受印","evidence":["sunshi-e-o035b-q"]}],"place":null,"time":{"year":200,"label":"建安五年同次遇害语境逐条核对","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"sunshi-y200","dating_review":{"reviewed":true,"anchor":"sunshi-q-o034","basis":"建安五年同次遇害语境逐条核对"},"evidence":["sunshi-e-o035b-q","sunshi-q-o034","xunyu-q-o020","xunyu-q-b-3c961618b484f81c3582"]},"ordering_evidence":"sunshi-e-o035b-q","source_order":[46,262,"O035b"],"order":8127}],"persons":[{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"wendi-p0133","name":"张昭","facts":[],"aliases":[]},{"id":"wudi-p0099","name":"孙策","facts":[],"aliases":[]}],"evidence":[{"id":"sunshi-e-o035b-q","section":"chapter-046","block":"b-18e349ce1607f40f98f6","layer":"original","quote":"请张昭等谓曰：“中国方乱〖6〗；夫以吴、越之众〖7〗，三江之固〖8〗，足以观成败。公等善相吾弟〖9〗！”呼权，佩以印绶，谓曰：“举江东之众，决机于两阵之间〖10〗，与天下争衡，卿不如我；举贤任能，各尽其心，以保江东，我不如卿。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":261,"anchor":null},"note_id":null,"start":42,"end":155},{"id":"sunshi-q-o034","section":"chapter-046","block":"b-8480cc17db549540a4f6","layer":"original","quote":"建安五年，曹公与袁绍相拒于官渡〖1〗。策阴欲袭许〖2〗，迎汉帝〖3〗；﹝一﹞密治兵，部署诸将。未发，会为故吴郡太守许贡客所杀〖4〗。","section_title":"孙破虏讨逆传第一","source":{"file":"OEBPS/Text/titlepage_0099.xhtml","index":260,"anchor":null},"note_id":null,"start":0,"end":66},{"id":"xunyu-q-b-3c961618b484f81c3582","section":"chapter-010","block":"b-3c961618b484f81c3582","layer":"modern","quote":"〖3〗五年：建安五年（公元 200）。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":115,"anchor":null},"note_id":"n-3bbb3ef01ba77a895b2f","start":0,"end":19},{"id":"xunyu-q-o020","section":"chapter-010","block":"b-ae8147f907358950d8ac","layer":"original","quote":"五年〖3〗，与绍连战。太祖保官渡，绍围之；太祖军粮方尽，书与彧，议欲还许，以引绍〖4〗。","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":110,"anchor":null},"note_id":null,"start":0,"end":44},{"id":"zhanggu-q-239b07564b5677c78ac9","section":"chapter-052","block":"b-5efb8060fc7d82d9dd19","layer":"original","quote":"策临亡，以弟权托昭。昭率群僚，立而辅之；﹝三﹞上表汉室，下移属城〖11〗；中外将校，各令奉职","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":4,"anchor":null},"note_id":null,"start":0,"end":46}],"profiles":{},"directory_counts":{}}
