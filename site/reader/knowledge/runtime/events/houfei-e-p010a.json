{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"houfei-e-p010a","title":"甄氏丧甄俨敬嫂劝母优待寡嫂","accounts":[{"id":"houfei-e-p010a-account","label":"《魏略》","text":"甄氏丧甄俨敬嫂劝母优待寡嫂","evidence":["houfei-e-p010a-q"]}],"participants":[{"person":"wendi-p0016","role":"劝母","evidence":["houfei-e-p010a-q"]},{"person":"houfei-p0024","role":"卒","evidence":["houfei-e-p010a-q"]},{"person":"houfei-p0022","role":"听劝","evidence":["houfei-e-p010a-q"]}],"place":null,"time":{"label":"甄氏年十四","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["houfei-e-p010a-q"]},"ordering_evidence":"houfei-e-p010a-q","source_order":[5,89,"P010a"],"order":1384}],"persons":[{"id":"houfei-p0022","name":"张氏（甄逸妻）","facts":[],"aliases":[]},{"id":"houfei-p0024","name":"甄俨","facts":[],"aliases":[]},{"id":"wendi-p0016","name":"甄氏","facts":[],"aliases":[]}],"evidence":[{"id":"houfei-e-p010a-q","section":"chapter-005","block":"b-acd5708678449fc13c24","layer":"pei","quote":"﹝二﹞《魏略》曰：“后年十四，丧中兄俨，悲哀过制。事寡嫂谦敬，事处其劳。拊养俨子，慈爱甚笃。后母性严，待诸妇有常。后数谏母曰：‘兄不幸早终，嫂年少守节，顾留一子。以大义言之：待之当如妇，爱之宜如女。’母感后言，流涕，便令后与嫂共止。寝息坐起常相随，恩爱益密。”","attribution":"《魏略》","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":88,"anchor":null},"note_id":"n-00cdf08ac301438cca93","start":0,"end":130}],"profiles":{},"directory_counts":{}}
