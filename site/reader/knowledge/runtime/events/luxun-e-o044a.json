{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"luxun-e-o044a","title":"陆议伪作答逯式归附书","accounts":[{"id":"luxun-e-o044a-account","label":"《陆逊传第十三》正文","text":"陆议伪作答逯式归附书","evidence":["luxun-e-o044a-q"]},{"id":"luxun-a-p011-judgment","label":"裴松之论","text":"裴松之认为边将作害常事，不值得用小诈使逯式得罪。","evidence":["luxun-q-p011-judgment"]}],"participants":[{"person":"xianzhu-p0115","role":"伪书离间","evidence":["luxun-e-o044a-q"]}],"place":null,"time":{"label":"逯式文休不协时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["luxun-e-o044a-q"]},"ordering_evidence":"luxun-e-o044a-q","source_order":[58,202,"O044a"],"order":10349}],"persons":[{"id":"xianzhu-p0115","name":"陆逊","facts":[],"aliases":[]}],"evidence":[{"id":"luxun-e-o044a-q","section":"chapter-058","block":"b-4eb699375293eec54f88","layer":"original","quote":"又魏江夏太守逯式﹝三﹞兼领兵马，颇作边害；而与北旧将文聘子休，宿不协〖14〗。逊闻其然，即假作答式书云：“得报恳恻〖15〗，知与休久结嫌隙〖16〗，势不两存，欲来归附。辄以密呈来书表闻〖17〗，选众相迎。宜潜速严〖18〗，更示定期。”","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":201,"anchor":null},"note_id":null,"start":0,"end":117},{"id":"luxun-q-p011-judgment","section":"chapter-058","block":"b-9402d202ce487ef4ef01","layer":"pei","quote":"﹝四﹞臣松之以为：边将为害，盖其常事；使逯式得罪，代者亦复如之。自非狡焉思肆，将成大患；何足亏损雅虑，尚为小诈哉！以斯为美，又所不取。","attribution":"裴松之论","section_title":"陆逊传第十三","source":{"file":"OEBPS/Text/titlepage_0123.xhtml","index":226,"anchor":null},"note_id":"n-74f44a698cf97f8f97b4","start":0,"end":67}],"profiles":{},"directory_counts":{}}
