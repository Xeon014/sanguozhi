{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dongyuan-e-p070a","title":"沮授劝袁绍迎帝邺郭图淳于琼反对袁绍不用","accounts":[{"id":"dongyuan-e-p070a-account","label":"《献帝传》","text":"沮授劝袁绍迎帝邺郭图淳于琼反对袁绍不用","evidence":["dongyuan-e-p070a-q"]},{"id":"dongyuan-a-p071-judgment","label":"裴松之按","text":"裴注指出献帝传郭图反对迎帝与本传郭图主张迎帝相违。","evidence":["dongyuan-q-p071-judgment"]}],"participants":[{"person":"wudi-p0218","role":"献策","evidence":["dongyuan-e-p070a-q"]},{"person":"wudi-p0174","role":"反对","evidence":["dongyuan-e-p070a-q"]},{"person":"wudi-p0175","role":"反对","evidence":["dongyuan-e-p070a-q"]},{"person":"wudi-p0052","role":"不纳","evidence":["dongyuan-e-p070a-q"]}],"place":null,"time":{"label":"袁绍迎帝议时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-p070a-q"]},"ordering_evidence":"dongyuan-e-p070a-q","source_order":[6,289,"P070a"],"order":1655}],"persons":[{"id":"wudi-p0052","name":"袁绍","facts":[],"aliases":[]},{"id":"wudi-p0174","name":"郭图","facts":[],"aliases":[]},{"id":"wudi-p0175","name":"淳于琼","facts":[],"aliases":[]},{"id":"wudi-p0218","name":"沮授","facts":[],"aliases":[]}],"evidence":[{"id":"dongyuan-e-p070a-q","section":"chapter-006","block":"b-f788287ac55fa0fa37e8","layer":"pei","quote":"﹝一﹞《献帝传》曰：“沮授说绍云：‘将军累叶辅弼，世济忠义。今朝廷播越，宗庙毁坏。观诸州郡，外托义兵，内图相灭，未有存主恤民者。且今州城粗定，宜迎大驾，安宫邺都；挟天子而令诸侯，畜士马以讨不庭：谁能御之！’绍悦，将从之。郭图、淳于琼曰：‘汉室陵迟，为日久矣；今欲兴之，不亦难乎？且今英雄据有州郡，众动万计；所谓秦失其鹿，先得者王。若迎天子以自近，动辄表闻；从之则权轻，违之则拒命：非计之善者也。’授曰：‘今迎朝廷，至义也；又于时宜，大计也。若不早图，必有先人者也。夫权不失机，功在速捷，将军其图之！’绍弗能用。”","attribution":"《献帝传》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":288,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1c5f3bd8be343c161b14","start":0,"end":256,"offset_unit":"unicode_code_point"},{"id":"dongyuan-q-p071-judgment","section":"chapter-006","block":"b-19646086a63e95e8273a","layer":"pei","quote":"按此书称郭图之计，则与本传违也。","attribution":"裴松之按","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":289,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-1c5f3bd8be343c161b14","start":0,"end":16,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
