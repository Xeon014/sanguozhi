{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wgc-e-3-e4","title":"邓艾迁城阳太守","order":5641,"accounts":[{"id":"wgc-a-3-e4","label":"正文","text":"邓艾迁城阳太守","evidence":["wgc-q0333","wgc-q0039"]}],"participants":[{"person":"shaodi-p0080","role":"迁城阳太守","evidence":["wgc-q0333","wgc-q0039"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0333","wgc-q0039"]},"ordering_evidence":"wgc-q0333"}],"persons":[{"id":"shaodi-p0080","name":"邓艾","facts":[],"aliases":[]}],"evidence":[{"id":"wgc-q0039","section":"chapter-028","block":"b-d693a552b14d342eae71","layer":"original","quote":"后迁城阳太守〖5〗。是时并州（右）〔左〕贤王刘豹并为一部〖6〗。艾上言曰：“戎狄兽心，不以义亲；强则侵暴，弱则内附。故周宣有狁之寇〖7〗，汉祖有平城之围〖8〗；每匈奴一盛，为前代重患。自单于在外〖9〗，莫能牵制长卑〖10〗；诱而致之，使来入侍〖11〗。由是羌夷失统〖12〗，合散无主；以单于在内，万里顺轨〖13〗。今单于之尊日疏，外土之威浸重〖14〗，则胡虏不可不深备也。闻刘豹部有叛胡，可因叛，割为二国，以分其势。去卑功显前朝〖15〗，而子不继业；宜加其子显号〖16〗，使居雁门。离国弱寇〖17〗，追录旧勋，此御边长计也。”","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":264,"anchor":null},"note_id":null,"start":0,"end":263},{"id":"wgc-q0333","section":"chapter-028","block":"b-d693a552b14d342eae71","layer":"original","quote":"后迁城阳太守","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":264,"anchor":null},"note_id":null,"start":0,"end":6}],"profiles":{},"directory_counts":{}}
