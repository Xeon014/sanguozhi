{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"yuanzhang-e2-pei-disputes-wangxiu-tianchou","title":"裴松之质疑《傅子》合述王修田畴哭谭","accounts":[{"id":"yuanzhang-a2-e8f1d66fc64dedddb522","label":"裴注（引书见原文）","text":"裴松之质疑《傅子》合述王修田畴哭谭","evidence":["yuanzhang-q2-513a3c93741a277e40d9"]}],"participants":[],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"第二轮逐项审定；仅保原文时序，不另行推年。","evidence":["yuanzhang-q2-513a3c93741a277e40d9"]},"ordering_evidence":"yuanzhang-q2-513a3c93741a277e40d9","order":2610}],"persons":[],"evidence":[{"id":"yuanzhang-q2-513a3c93741a277e40d9","section":"chapter-011","block":"b-2d5c8c954ff0db30a2fd","layer":"pei","quote":"﹝一﹞《傅子》曰：“太祖既诛袁谭，枭其首，令曰：‘敢哭之者，戮及妻子！’于是王叔治、田子泰相谓曰：‘生受辟命，亡而不哭，非义也。畏死亡义，何以立世？’遂造其首而哭之，哀动三军。军正白行其戮，太祖曰：‘义士也。’赦之。”臣松之按《田畴传》，畴为袁尚所辟，不被谭命。《傅子》合而言之，有违事实。","attribution":"裴注（引书见原文）","section_title":"袁张凉国田王邴管传第十一","source":{"file":"OEBPS/Text/titlepage_0027.xhtml","index":306,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-2a96f5f08fb86abd62d8","start":0,"end":145,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
