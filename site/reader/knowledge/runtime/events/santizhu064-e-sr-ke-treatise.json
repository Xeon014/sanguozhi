1a1a12d","chapter-013":"24c6e486e7f78fc4d59ff01277b36cb77ffb69c68a6a9030889fe00efe4b3d27","chapter-016":"6cfac20452f269a832b087d2e808cc4b3017944d17dca1d5b1e068ebb98d8327","chapter-018":"7a62f43c1f5dc64661b088ef0fdd48392063ef5c49001fa980aa65e766380b23","chapter-019":"a43f6648e6c9d8389d561bee9d00824665f8f06542ab2a65aac06ed8a7601c5b","chapter-020":"2ef7e28be018140e07d27d7636a9df480a5cb7ef1cb3572c314a70e0d1acd07c","chapter-050":"71faaaddb69f25a5bdd7f315f15562e867eed9e897c9bd439a99a09c435bfe91","chapter-023":"908d4e64a01e171bdb09c0a7ee5484b8743be26b7cc75f49bd8b41b7ff391ff2","chapter-024":"39be893c0040dbb3148f9447402c47fc24dcb4356360f8558243258cb85b089a","chapter-025":"f37fc365e7d07f96b5fd289119e1846fe7f0030d8b46a7195fab316badf817b7","chapter-027":"dd48b2052380e1f6b6f6ffcb4835dd99cfe70efe4a9096fa51448dbdfaa14f00","chapter-062":"7031fb8ebde1ea3c95cdedcf93218fb46f69a71a29a1d9e82361f7108436a86a","chapter-063":"3ae8edfbae98c3e86a518f7022c664ed35a0d68d5ac36b331ceb560e76b1848f","chapter-065":"13c50dd7dc9a229aef1cfb43dd231955a0b1a6359dab04c54708df93fa114e12","chapter-057":"39e3922e223fe25b811b77f14049327071298549de6ed788ba7da697f067f2e3","chapter-021":"18c02b71e8f81644cf71ffea582a8e019509de0b5e9bc11451de595fa03e2cf3","chapter-029":"6ffb35bac29d20aa512b5a734e72f98ec5729b176f1bc5d6837e673bcc00880d","chapter-030":"3e0682212c3e242d0f221308bc203bd8309851b8498b94db16383bdde5234ce1"},"events":[{"id":"santizhu064-e-sr-ke-treatise","title":"诸葛恪著论喻众意（全文）","accounts":[{"id":"santizhu064-a-7229fc4340bf2e418fac","label":"正文","text":"恪乃著论喻众：引战国诸侯纵恣为秦所并、刘表坐观曹操强大、子胥谏夫差、秦并六国与今魏吴蜀之势对比、司马懿诛凌自毙其子幼弱，当今伐之为厄会；论产育强弱、讥偷安之计、引汉祖出攻楚、荆邯说公孙述、家叔父与贼争竞之表；众皆以为必为之辞，莫敢复难","evidence":["santizhu064-q-b977f4386ff3b5cfc551","santizhu064-q-39cd15d5d3e7d1f76479","santizhu064-q-942f9e2b953168892d32","santizhu064-q-9673edb62d40cf19af3e","santizhu064-q-5006aa01c00c3526204c","santizhu064-q-ea3b0ff0773d9d028e90","santizhu064-q-e84a3f27d7bf3d9b093d","santizhu064-q-0dd056f8824d16d93b0d","santizhu064-q-975dff98adc0dde1eeaa"]}],"participants":[{"person":"shaodi-p0041","role":"著论喻众","evidence":["santizhu064-q-b977f4386ff3b5cfc551","santizhu064-q-39cd15d5d3e7d1f76479","santizhu064-q-942f9e2b953168892d32","santizhu064-q-9673edb62d40cf19af3e","santizhu064-q-5006aa01c00c3526204c","santizhu064-q-ea3b0ff0773d9d028e90","santizhu064-q-e84a3f27d7bf3d9b093d","santizhu064-q-0dd056f8824d16d93b0d","santizhu064-q-975dff98adc0dde1eeaa"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"未由相邻段落推算纪年；原文时间表达保留在来源引句中。","evidence":["santizhu064-q-b977f4386ff3b5cfc551","santizhu064-q-39cd15d5d3e7d1f76479","santizhu064-q-942f9e2b953168892d32","santizhu064-q-9673edb62d40cf19af3e","santizhu064-q-5006aa01c00c3526204c","santizhu064-q-ea3b0ff0773d9d028e90","santizhu064-q-e84a3f27d7bf3d9b093d","santizhu064-q-0dd056f8824d16d93b0d","santizhu064-q-975dff98adc0dde1eeaa"]},"ordering_evidence":"santizhu064-q-b977f4386ff3b5cfc551","source_order":[64,189,0],"order":10957}],"persons":[{"id":"shaodi-p0041","name":"诸葛恪","facts":[],"aliases":[]}],"evidence":[{"id":"santizhu064-q-0dd056f8824d16d93b0d","section":"chapter-064","block":"b-6df609b6cfcbd9d401ac","layer":"original","quote":"夙夜反侧，所虑如此；故聊疏愚言，以达二三君子之末〖32〗。若一朝陨殁，志画不立〖33〗；贵令来世知我所忧〖34〗，可思于后。","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":195,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":62,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-39cd15d5d3e7d1f76479","section":"chapter-064","block":"b-b47752daf5458ef1ae51","layer":"original","quote":"夫天无二日，土无二王。王者不务兼并天下而欲垂祚后世，古今未之有也。昔战国之时，诸侯自恃兵强地广，互有救援；谓此足以传世，人莫能危。恣情纵怀，惮于劳苦；使秦渐得自大，遂以并之：此既然矣。近者刘景升在荆州〖1〗，有众十万，财谷如山；不及曹操尚微〖2〗，与之力竞；坐观其强大，吞灭诸袁〖3〗。北方都定之后，操率三十万众来向荆州；当时虽有智者，不能复为画计。于是景升儿子，交臂请降，遂为囚虏。","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":189,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":192,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-5006aa01c00c3526204c","section":"chapter-064","block":"b-95d38be14aef4faa27b0","layer":"original","quote":"自（本）〔古〕以来，国之强弱，在乎产育〖17〗。今者贼民，岁月繁滋〖18〗；但以尚小，未可得用耳。若复十数年后，其众必倍于今；而国家劲兵之地，皆已空尽，唯有此现众可以定事。若不早用之，端坐使老；复十数年，略当损半，而现子弟数不足言。若贼众一倍，而我兵损半；虽复使伊、管图之〖19〗，未可如何〖20〗！","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":192,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":150,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-942f9e2b953168892d32","section":"chapter-064","block":"b-8e097bface3331649773","layer":"original","quote":"凡敌国欲相吞，即仇雠欲相除也〖4〗。有雠而长之，祸不在己，则在后人，不可不为远虑也。昔伍子胥曰〖5〗：“越十年生聚〖6〗，十年教训〖7〗；二十年之外，吴其为沼乎〖8〗！”夫差自恃强大，闻此邈然〖9〗；是以诛子胥而无备越之心。至于临败悔之，岂有及乎？越小于吴，尚为吴祸；况其强大者邪？","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":190,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":141,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-9673edb62d40cf19af3e","section":"chapter-064","block":"b-cf7cc934464b8e7bf4e5","layer":"original","quote":"昔秦但得关西耳，尚以并吞六国。今贼皆得秦、赵、韩、魏、燕、齐九州之地〖10〗；地悉戎马之乡，士林之薮〖11〗。今以魏比古之秦，土地数倍；以吴与蜀比古六国，不能半之。然今所以能敌之，但以操时兵众，于今适尽；而后生者未悉长大，正是贼衰少未盛之时。加司马懿先诛王凌〖12〗，续自陨毙〖13〗；其子幼弱〖14〗，而专彼大任；虽有智计之士，未得施用。当今伐之，是其厄会〖15〗。圣人急于趋时〖16〗，诚谓今日。若顺众人之情，怀偷安之计，以为长江之险可以传世；不论魏之终始，而以今日遂轻其后：此吾所以长叹息者也。","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":191,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":250,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-975dff98adc0dde1eeaa","section":"chapter-064","block":"b-791e78cb602c56f4756c","layer":"original","quote":"众皆以恪此论，欲必为之辞，然莫敢复难。","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":196,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-b977f4386ff3b5cfc551","section":"chapter-064","block":"b-c44ba2c77e15fb6f792f","layer":"original","quote":"恪乃著论喻众意曰：","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":188,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":9,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-e84a3f27d7bf3d9b093d","section":"chapter-064","block":"b-dae54d85b0d89fdf5508","layer":"original","quote":"今闻众人或以百姓尚贫，欲务闲息；此不知虑其大危，而爱其小勤者也〖27〗。昔汉祖幸已自有三秦之地〖28〗，何不闭关守险，以自娱乐？空出攻楚，身被创痍〖29〗；介胄生虮虱，将士厌困苦？岂甘锋刃而忘安宁哉？虑于长久不得两存者耳！每览荆邯说公孙述以进取之图〖30〗，近见家叔父表陈与贼争竞之计〖31〗，未尝不喟然叹息也！","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":194,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":156,"offset_unit":"unicode_code_point"},{"id":"santizhu064-q-ea3b0ff0773d9d028e90","section":"chapter-064","block":"b-af45cd9323ac84f32e3d","layer":"original","quote":"今不达远虑者，必以此言为迂。夫祸难未至而预忧虑，此固众人之所迂也。及于难至，然后顿颡〖21〗；虽有智者，又不能图。此乃古今所病，非独一时。昔吴始以伍员为迂，故难至而不可救。刘景升不能虑十年之后，故无以诒其子孙〖22〗。今恪无具臣之才〖23〗，而受大吴萧、霍之任〖24〗；智与众同，思不经远；若不及今日为国斥境〖25〗，俯仰年老〖26〗，而仇敌更强；欲刎颈谢责，宁有补邪？","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":193,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":185,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
