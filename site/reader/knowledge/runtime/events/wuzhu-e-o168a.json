0,"end":15,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o166","section":"chapter-047","block":"b-b62c4eca93eda253f3b0","layer":"original","quote":"二年春正月〖12〗，立故太子和为南阳王，居长沙〖13〗；子奋为齐王，居武昌；子休为琅邪王〖14〗，居虎林〖15〗。二月，大赦，改元为神凤。皇后潘氏薨。诸将吏数诣王表请福，表亡去。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":302,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":89,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
