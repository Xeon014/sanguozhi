{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wgc-e-13-e18","title":"见者言吴纲类吴芮纲惊问","order":5585,"accounts":[{"id":"wgc-a-13-e18","label":"裴注·世语","text":"见者言吴纲类吴芮纲惊问","evidence":["wgc-q0588","wgc-q0112"]}],"participants":[{"person":"wgc-p0020","role":"瞿然言是先祖、问更葬否","evidence":["wgc-q0588","wgc-q0112"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0588","wgc-q0112"]},"ordering_evidence":"wgc-q0588"}],"persons":[{"id":"wgc-p0020","name":"吴纲","facts":[],"aliases":[]}],"evidence":[{"id":"wgc-q0112","section":"chapter-028","block":"b-a91f937bee4efb666a6d","layer":"pei","quote":"﹝二﹞《世语》曰：“黄初末，吴人发长沙王吴芮冢，以其砖，于临湘为孙坚立庙。芮容貌如生，衣服不朽。后预发者见吴纲曰：‘君何类长沙王吴芮？但微短耳。’纲瞿然曰：‘是先祖也！君何由见之？’见者言所由，纲曰：‘更葬否？’答曰：‘即更葬矣。’自芮之卒年至冢发，四百余年；纲，芮之十六世孙矣。”","attribution":"世语","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":193,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b7a94f70c07c06cf3c16","start":0,"end":141,"offset_unit":"unicode_code_point"},{"id":"wgc-q0588","section":"chapter-028","block":"b-a91f937bee4efb666a6d","layer":"pei","quote":"后预发者见吴纲曰：‘君何类长沙王吴芮？但微短耳。’纲瞿然曰：‘是先祖也！君何由见之？’见者言所由，纲曰：‘更葬否？’答曰：‘即更葬矣。’自芮之卒年至冢发，四百余年；纲，芮之十六世孙矣","attribution":"裴注·世语","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":193,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b7a94f70c07c06cf3c16","start":48,"end":139,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
