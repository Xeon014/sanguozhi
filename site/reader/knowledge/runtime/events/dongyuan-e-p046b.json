{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dongyuan-e-p046b","title":"汉帝遣皇甫郦和解郭汜受诏李傕不纳","accounts":[{"id":"dongyuan-e-p046b-account","label":"《献帝起居注》","text":"汉帝遣皇甫郦和解郭汜受诏李傕不纳","evidence":["dongyuan-e-p046b-q"]}],"participants":[{"person":"wudi-p0054","role":"遣使","evidence":["dongyuan-e-p046b-q"]},{"person":"dongyuan-p0095","role":"奉使","evidence":["dongyuan-e-p046b-q"]},{"person":"wudi-p0090","role":"受诏","evidence":["dongyuan-e-p046b-q"]},{"person":"wudi-p0089","role":"拒诏","evidence":["dongyuan-e-p046b-q"]}],"place":null,"time":{"label":"李郭交攻时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-p046b-q"]},"ordering_evidence":"dongyuan-e-p046b-q","source_order":[6,162,"P046b"],"order":1576}],"persons":[{"id":"dongyuan-p0095","name":"皇甫郦","facts":[],"aliases":[]},{"id":"wudi-p0054","name":"汉献帝","facts":[],"aliases":[]},{"id":"wudi-p0089","name":"李傕","facts":[],"aliases":[]},{"id":"wudi-p0090","name":"郭汜","facts":[],"aliases":[]}],"evidence":[{"id":"dongyuan-e-p046b-q","section":"chapter-006","block":"b-01aaf749bfd0fc201fac","layer":"pei","quote":"天子以谒者仆射皇甫郦凉州旧姓，有专对之才，遣令和傕、汜。郦先诣汜，汜受诏命。诣傕，傕不肯，曰：‘我有吕布之功，辅政四年，三辅清静，天下所知也。郭多，盗马虏耳，何敢乃欲与吾等邪？必欲诛之！君为凉州人，观吾方略士众，足办多不？多又劫质公卿，所为如是；而君苟欲利郭多，李傕有胆自知之。’郦答曰：‘昔有穷后羿恃其善射，不思患难，以至于毙。近董公之强，明将军目所见：内有王公以为内主；外有董旻、承、璜以为鲠毒。吕布受恩而反图之，斯须之间，头悬竿端：此有勇而无谋也。今将军身为上将，把钺仗节；子孙握权，宗族荷宠，国家好爵而皆据之。今郭多劫质公卿，将军胁至尊，谁为轻重邪？张济与郭多、杨定有谋，又为冠带所附。杨奉，白波帅耳，犹知将军所为非是；将军虽拜宠之，犹不肯尽力也。’傕不纳郦言，而呵之令出。","attribution":"《献帝起居注》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":161,"anchor":null},"note_id":"n-33c32b6c80ba50b749a6","start":280,"end":621}],"profiles":{},"directory_counts":{}}
