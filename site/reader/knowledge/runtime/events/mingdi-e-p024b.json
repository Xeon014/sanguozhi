{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"mingdi-e-p024b","title":"孔桂善迎意受曹操亲爱赏赐","accounts":[{"id":"mingdi-e-p024b-account","label":"裴注·魏略","text":"孔桂善迎意受曹操亲爱赏赐","evidence":["mingdi-e-p024b-q"]},{"id":"mingdi-a-p025-argument","label":"裴注·鱼豢曰","text":"鱼豢以武帝慎赏仍宠佞幸为戒。","evidence":["mingdi-q-p025-argument"]}],"participants":[{"person":"mingdi-p0080","role":"曲意受宠","evidence":["mingdi-e-p024b-q"]},{"person":"cao-cao","role":"宠赐","evidence":["mingdi-e-p024b-q"]}],"place":null,"time":{"label":"建安初","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["mingdi-e-p024b-q"]},"ordering_evidence":"mingdi-e-p024b-q","source_order":[3,245,"P024b"],"order":839}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"mingdi-p0080","name":"孔桂","facts":[],"aliases":[]}],"evidence":[{"id":"mingdi-e-p024b-q","section":"chapter-003","block":"b-93cd3c37ec40bb3fa146","layer":"pei","quote":"桂性便辟，晓博弈、蹋鞠，故太祖爱之；每在左右，出入随从。桂察太祖意，喜乐之时，因言次曲有所陈，事多见从。数得赏赐，人多馈遗，桂由此侯服玉食。","attribution":"裴注·魏略","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":244,"anchor":null},"note_id":"n-9ebeadb65240878258aa","start":51,"end":121},{"id":"mingdi-q-p025-argument","section":"chapter-003","block":"b-37447dd432015f9ac917","layer":"pei","quote":"鱼豢曰：“为上者不虚授，处下者不虚受。然后外无‘伐檀’之叹，内无尸素之刺；雍熙之美著，太平之律显矣。而佞幸之徒，但姑息人主；至乃无德而荣，无功而禄。如是焉得不使中正日朘，倾邪滋多乎！以武皇帝之慎赏，明皇帝之持法，而犹有若此等人，而况下斯者乎？”","attribution":"裴注·鱼豢曰","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":245,"anchor":null},"note_id":"n-9ebeadb65240878258aa","start":0,"end":122}],"profiles":{},"directory_counts":{}}
