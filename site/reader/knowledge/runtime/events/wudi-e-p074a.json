{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p074a","title":"曹操规定田租户调并禁擅征","accounts":[{"id":"wudi-e-p074a-account","label":"《魏书》所载曹操令","text":"曹操令定亩租四升、户出绢二匹绵二斤，禁止另行擅征，并要求郡国防止豪强隐匿、弱民兼负赋税。","evidence":["wudi-e-p074a-q"]}],"participants":[{"person":"cao-cao","role":"颁赋税令","evidence":["wudi-e-p074a-q"]}],"place":{"text":"河北","evidence":["wudi-e-p074a-q"]},"time":{"label":"建安九年","year":204,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-p074a-q","wudi-q-o092","wudi-q-b-6787e3ddd3e334b677d4"],"chronology":"wudi-y204","dating_review":{"anchor":"wudi-q-o092","basis":"建安九年","reviewed":true}},"source_order":[1,557,"P074a"],"order":230}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-p074a-q","section":"chapter-001","block":"b-68fe577c0416d63f98d3","layer":"pei","quote":"﹝一﹞《魏书》载公令曰：“‘有国有家者，不患寡而患不均，不患贫而患不安’。袁氏之治也，使豪强擅恣，亲戚兼并；下民贫弱，代出租赋；炫鬻家财，不足应命。审配宗族，至乃藏匿罪人，为逋逃主。欲望百姓亲附，甲兵强盛，岂可得邪！其收田租亩四升，户出绢二匹、绵二斤而已；他不得擅兴发！郡国守相明检察之，无令强民有所隐藏，而弱民兼赋也。”","attribution":"《魏书》所载曹操令","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":556,"anchor":null},"note_id":"n-5d60dc598e100a3d84bd","start":0,"end":161},{"id":"wudi-q-b-6787e3ddd3e334b677d4","section":"chapter-001","block":"b-6787e3ddd3e334b677d4","layer":"modern","quote":"〖1〗九年：建安九年（公元 204）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":510,"anchor":null},"note_id":"n-c8fff97bafc82c655f3f","start":0,"end":19},{"id":"wudi-q-o092","section":"chapter-001","block":"b-3e549c423b15df48398a","layer":"original","quote":"九年春正月〖1〗，济河，遏淇水入白沟以通粮道〖2〗。二月，尚复攻谭，留苏由、审配守邺〖3〗。公进军到洹水〖4〗，由降；既至，攻邺，为土山、地道。武安长尹楷屯毛城〖5〗，通上党粮道〖6〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":506,"anchor":null},"note_id":null,"start":0,"end":93}],"profiles":{},"directory_counts":{}}
