{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"houfei-e-o019a","title":"曹丕于邺纳甄氏","accounts":[{"id":"houfei-e-o019a-account","label":"《后妃传》正文","text":"冀州平后，曹丕于邺纳甄氏，有宠。","evidence":["houfei-e-o019a-q"]},{"id":"houfei-e-p011a-account","label":"《魏略》","text":"魏略记曹丕见甄氏曹操迎取","evidence":["houfei-e-p011a-q"]},{"id":"houfei-e-p011b-account","label":"《世语》","text":"世语记曹丕先入袁尚府见甄氏","evidence":["houfei-e-p011b-q"]}],"participants":[{"person":"wudi-p0170","role":"纳妻","evidence":["houfei-e-o019a-q"]},{"person":"wendi-p0016","role":"入室","evidence":["houfei-e-o019a-q"]},{"person":"cao-cao","role":"迎取","evidence":["houfei-e-p011a-q"]},{"person":"houfei-p0031","role":"举其面","evidence":["houfei-e-p011a-q"]}],"place":{"text":"邺","evidence":["houfei-q-o019"]},"time":{"label":"冀州平后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["houfei-e-o019a-q"]},"ordering_evidence":"houfei-e-o019a-q","source_order":[5,76,"O019a"],"order":1375}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"houfei-p0031","name":"袁绍妻刘氏","facts":[],"aliases":[]},{"id":"wendi-p0016","name":"甄氏","facts":[],"aliases":[]},{"id":"wudi-p0170","name":"曹丕","facts":[],"aliases":[]}],"evidence":[{"id":"houfei-e-o019a-q","section":"chapter-005","block":"b-9095fc9bd91a8083aa77","layer":"original","quote":"及冀州平，文帝纳后于邺；有宠，生明帝及东乡公主。﹝三﹞","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":75,"anchor":null},"note_id":null,"start":0,"end":27},{"id":"houfei-e-p011a-q","section":"chapter-005","block":"b-2475f674eb8be8e10e44","layer":"pei","quote":"《魏略》曰：“熙出在幽州，后留侍姑。及邺城破，绍妻及后共坐（皇堂）〔堂皇〕上。文帝入绍舍，见绍妻及后。后怖，以头伏姑膝上，绍妻两手自搏。文帝谓曰：‘夫人云何如此！令新妇举头。’姑乃捧后令仰，文帝就视，见其颜色非凡，称叹之。太祖闻其意，遂为迎取。","attribution":"《魏略》","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":89,"anchor":null},"note_id":"n-1067b6f68b33416d66ff","start":3,"end":125},{"id":"houfei-e-p011b-q","section":"chapter-005","block":"b-2475f674eb8be8e10e44","layer":"pei","quote":"《世语》曰：“太祖下邺，文帝先入袁尚府。有妇人被发垢面，垂涕立绍妻刘后。文帝问之，刘答：‘是熙妻。’顾揽发髻，以巾拭面，姿貌绝伦。既过，刘谓后‘不忧死矣！’遂见纳，有宠。","attribution":"《世语》","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":89,"anchor":null},"note_id":"n-1067b6f68b33416d66ff","start":126,"end":211},{"id":"houfei-q-o019","section":"chapter-005","block":"b-9095fc9bd91a8083aa77","layer":"original","quote":"及冀州平，文帝纳后于邺；有宠，生明帝及东乡公主。﹝三﹞","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":75,"anchor":null},"note_id":null,"start":0,"end":27}],"profiles":{},"directory_counts":{}}
