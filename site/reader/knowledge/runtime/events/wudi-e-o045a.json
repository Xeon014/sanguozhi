{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o045a","title":"杨奉欲拦天子而未及","accounts":[{"id":"wudi-e-o045a-account","label":"正文","text":"天子东行时，杨奉从梁出发欲拦截，未能赶上。","evidence":["wudi-e-o045a-q"]}],"participants":[{"person":"wudi-p0120","role":"拟拦截","evidence":["wudi-e-o045a-q"]},{"person":"wudi-p0054","role":"东行","evidence":["wudi-e-o045a-q"]}],"place":{"text":"梁","evidence":["wudi-e-o045a-q"]},"time":{"label":"天子东行时","year":196,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o045a-q","wudi-q-o040","wudi-q-b-16a5462151b1cfe5142d"],"chronology":"wudi-y196","dating_review":{"anchor":"wudi-q-o040","basis":"天子东行时","reviewed":true}},"source_order":[1,283,"O045a"],"order":127}],"persons":[{"id":"wudi-p0054","name":"汉献帝","facts":[],"aliases":[]},{"id":"wudi-p0120","name":"杨奉","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-o045a-q","section":"chapter-001","block":"b-e89defb6eccd7b1c2bd3","layer":"original","quote":"天子之东也，奉自梁欲要之，不及。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":282,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":16,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-16a5462151b1cfe5142d","section":"chapter-001","block":"b-16a5462151b1cfe5142d","layer":"modern","quote":"〖1〗建安元年：公元 196 年。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":264,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-df2756e12f4ac1fef3c4","start":0,"end":17,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o040","section":"chapter-001","block":"b-c71d10ef121af30ac6b7","layer":"original","quote":"建安元年春正月〖1〗，太祖军临武平〖2〗。袁术所置陈相袁嗣，降。太祖将迎天子，诸将或疑；荀彧、程昱劝之。乃遣曹洪将兵西迎。卫将军董承与袁术将苌奴拒险〖3〗，洪不得进。汝南、颍川黄巾何仪、刘辟、黄邵、何曼等〖4〗，众各数万。初应袁术，又附孙坚〖5〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":258,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":124,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
