01c9aa06","zhonghua-q-484c1ae2b5a072caef61","zhonghua-q-80ebc1bb04da8c788ab8","zhonghua-q-d63f7cb0ab54efaf3bf3"]},"ordering_evidence":"zhonghua-q-e0116a0edb458be1c06c","source_order":[13,286,11],"order":2909}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0181","name":"钟繇","facts":[],"aliases":[]},{"id":"wudi-p0309","name":"王朗","facts":[],"aliases":[]},{"id":"zhonghua-p0028","name":"夏逸","facts":[],"aliases":[]},{"id":"zhonghua-p0042","name":"张登","facts":[],"aliases":[]},{"id":"zhonghua-p0061","name":"王隽","facts":[],"aliases":[]}],"evidence":[{"id":"zhonghua-q-484c1ae2b5a072caef61","section":"chapter-013","block":"b-ac9dcb7f823564d0c19b","layer":"pei","quote":"太祖以所急者多，未遑擢叙。","attribution":"裴注·王朗集","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":285,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-7ebe8801c2b097282bd2","start":120,"end":133,"offset_unit":"unicode_code_point"},{"id":"zhonghua-q-5fc5e5818292b0f756da","section":"chapter-013","block":"b-ac9dcb7f823564d0c19b","layer":"pei","quote":"值黑山贼围郡，登与县长王隽，帅吏兵七十二人直往赴救，与贼交战，吏兵散走。隽殆见害，登手格一贼，以全隽命。","attribution":"裴注·王朗集","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":285,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-7ebe8801c2b097282bd2","start":34,"end":86,"offset_unit":"unicode_code_point"},{"id":"zhonghua-q-80ebc1bb04da8c788ab8","section":"chapter-013","block":"b-ac9dcb7f823564d0c19b","layer":"pei","quote":"至黄初初，朗又与太尉钟繇连名表闻，兼称登在职勤劳。","attribution":"裴注·王朗集","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":285,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-7ebe8801c2b097282bd2","start":133,"end":158,"offset_unit":"unicode_code_point"},{"id":"zhonghua-q-d63f7cb0ab54efaf3bf3","section":"chapter-013","block":"b-ac9dcb7f823564d0c19b","layer":"pei","quote":"诏曰：‘登，忠义彰著，在职功勤；名位虽卑，直亮宜显。饔膳近任，当得此吏。今以登为太官令。’","attribution":"裴注·王朗集","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":285,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-7ebe8801c2b097282bd2","start":158,"end":203,"offset_unit":"unicode_code_point"},{"id":"zhonghua-q-e0116a0edb458be1c06c","section":"chapter-013","block":"b-ac9dcb7f823564d0c19b","layer":"pei","quote":"朗为大理时，上：‘主簿赵郡张登，昔为本县主簿。值黑山贼围郡，登与县长王隽，帅吏兵七十二人直往赴救，与贼交战，吏兵散走。隽殆见害，登手格一贼，以全隽命。又守长夏逸，为督邮所枉；登身受考掠，理逸之罪。义济二君，宜加显异。’","attribution":"裴注·王朗集","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":285,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-7ebe8801c2b097282bd2","start":11,"end":120,"offset_unit":"unicode_code_point"},{"id":"zhonghua-q-e6a8cde96d8d01c9aa06","section":"chapter-013","block":"b-ac9dcb7f823564d0c19b","layer":"pei","quote":"又守长夏逸，为督邮所枉；登身受考掠，理逸之罪。","attribution":"裴注·王朗集","section_title":"钟繇华歆王朗传第十三","source":{"file":"OEBPS/Text/titlepage_0031.xhtml","index":285,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-7ebe8801c2b097282bd2","start":86,"end":109,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
