S/Text/titlepage_0029.xhtml","index":286,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":132,"end":181,"offset_unit":"unicode_code_point"},{"id":"cuimao-q-fb45f079c7dbd5d9441b","section":"chapter-012","block":"b-2edea839c54738e633ff","layer":"original","quote":"太祖时在谯；太子留邺，数手书为之请罪。勋不敢擅纵，具列上","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":286,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":100,"end":128,"offset_unit":"unicode_code_point"},{"id":"cuimao-q2-2bacce779ef3bdf2c458","section":"chapter-012","block":"b-2edea839c54738e633ff","layer":"original","quote":"建安十七年，太祖追录信功，表封勋兄邵，新都亭侯；﹝二﹞辟勋，丞相掾。﹝三﹞二十二年〖3〗，立太子，以勋为中庶子〖4〗。徙黄门侍郎。出为魏郡西部都尉。太子郭夫人弟，为曲周县吏，断盗官布，法应弃市〖5〗。太祖时在谯；太子留邺，数手书为之请罪。勋不敢擅纵，具列上〖6〗。勋前在东宫，守正不挠，太子固不能悦；及重此事，恚望滋甚。会郡界休兵有失期者〖7〗，密敕中尉奏免勋官。久之，拜侍御史。","section_title":"崔毛徐何邢鲍司马传第十二","source":{"file":"OEBPS/Text/titlepage_0029.xhtml","index":286,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":190,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
