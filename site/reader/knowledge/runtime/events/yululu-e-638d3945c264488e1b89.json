{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"yululu-e-638d3945c264488e1b89","title":"殷基《通语》载朱据于二宫构争时谏争（太子国之本根、雅性仁孝；猝责之将有一朝之虑；引晋献骊姬、汉武江充为戒）","accounts":[{"id":"yululu-a-638d3945c264488e1b89","label":"裴注·《通语》","text":"殷基《通语》载朱据于二宫构争时谏争（太子国之本根、雅性仁孝；猝责之将有一朝之虑；引晋献骊姬、汉武江充为戒）","evidence":["yululu-q-eaf4845207afc74b848d"]}],"participants":[{"person":"wuzhu-p0125","role":"谏争","evidence":["yululu-q-eaf4845207afc74b848d"]},{"person":"sun-quan","role":"被谏","evidence":["yululu-q-eaf4845207afc74b848d"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["yululu-q-eaf4845207afc74b848d"]},"ordering_evidence":"yululu-q-eaf4845207afc74b848d","order":10283}],"persons":[{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"wuzhu-p0125","name":"朱据","facts":[],"aliases":[]}],"evidence":[{"id":"yululu-q-eaf4845207afc74b848d","section":"chapter-057","block":"b-eef43528688286740d84","layer":"pei","quote":"﹝一﹞殷基《通语》载据争曰：“臣闻太子，国之本根；雅性仁孝，天下归心。今猝责之，将有一朝之虑。昔晋献用骊姬而申生不存，汉武信江充而戾太子冤死。臣窃惧太子不堪其忧；虽立思子之宫，无所复及矣！”","attribution":"裴注·《通语》","section_title":"虞陆张骆陆吾朱传第十二","source":{"file":"OEBPS/Text/titlepage_0121.xhtml","index":489,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-a7732515a6c6b87fd48f","start":0,"end":95,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
