{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wendi-e-o019c","title":"朝日东郊","accounts":[{"id":"wendi-e-o019c-account","label":"《文帝纪》正文","text":"朝日东郊","evidence":["wendi-e-o019c-q"]},{"id":"wendi-a-p073-disputes","label":"裴注·裴松之按","text":"裴松之认为乙亥朝日条有日无月，是脱文；不确认它属于正月。","evidence":["wendi-q-p073-disputes"]}],"participants":[{"person":"wudi-p0170","role":"朝日","evidence":["wendi-e-o019c-q"]}],"place":null,"time":{"year":221,"label":"黄初二年乙亥，月份有异议","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"wendi-y221","dating_review":{"reviewed":true,"anchor":"wendi-q-o019","basis":"黄初二年乙亥，月份有异议"},"evidence":["wendi-e-o019c-q","wendi-q-o019","wendi-q-b-ec88012a7f6c352d0e04"]},"ordering_evidence":"wendi-e-o019c-q","source_order":[2,209,"O019c"],"order":567}],"persons":[{"id":"wudi-p0170","name":"曹丕","facts":[],"aliases":[]}],"evidence":[{"id":"wendi-e-o019c-q","section":"chapter-002","block":"b-8820e5c7f9006d364c44","layer":"original","quote":"乙亥〖6〗，朝日于东郊〖7〗。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":208,"anchor":null},"note_id":null,"start":50,"end":65},{"id":"wendi-q-b-ec88012a7f6c352d0e04","section":"chapter-002","block":"b-ec88012a7f6c352d0e04","layer":"modern","quote":"〖1〗二年：黄初二年（公元 221）。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":210,"anchor":null},"note_id":"n-8fff547b113ffa36bbc1","start":0,"end":19},{"id":"wendi-q-o019","section":"chapter-002","block":"b-8820e5c7f9006d364c44","layer":"original","quote":"二年春正月〖1〗，郊祀天地、明堂〖2〗。甲戌〖3〗，校猎至原陵〖4〗。遣使者，以太牢祠汉世祖〖5〗。乙亥〖6〗，朝日于东郊〖7〗。﹝一﹞初令郡国口满十万者〖8〗，岁察孝廉一人；其有秀异〖9〗，无拘户口。辛巳〖10〗，分三公户邑，封子弟各一人为列侯。壬午〖11〗，复颍川郡一年田租〖12〗。﹝二﹞改许县为许昌县。以魏郡东部为阳平郡〖13〗，西部为广平郡〖14〗。﹝三﹞","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":208,"anchor":null},"note_id":null,"start":0,"end":183},{"id":"wendi-q-p073-disputes","section":"chapter-002","block":"b-d54c2562695c9875c164","layer":"pei","quote":"﹝一﹞臣松之以为：礼，天子以春分朝日，秋分夕月。寻此年正月郊祀，有月无日；乙亥朝日，则有日无月：盖文之脱也。按明帝朝日、夕月，皆如礼文，故知此纪为误者也。","attribution":"裴注·裴松之按","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":225,"anchor":null},"note_id":"n-7aa25536820c38c519b2","start":0,"end":77}],"profiles":{},"directory_counts":{}}
