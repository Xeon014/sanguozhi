{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xiahoucao-e-p035a","title":"曹爽兄弟受围求粮司马懿送米肉兄弟自谓不死","accounts":[{"id":"xiahoucao-e-p035a-account","label":"《魏末传》","text":"曹爽兄弟受围求粮司马懿送米肉兄弟自谓不死","evidence":["xiahoucao-e-p035a-q"]}],"participants":[{"person":"mingdi-p0056","role":"求粮","evidence":["xiahoucao-e-p035a-q"]},{"person":"wudi-p0364","role":"送粮","evidence":["xiahoucao-e-p035a-q"]}],"place":null,"time":{"label":"曹爽兄弟还第后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xiahoucao-e-p035a-q"]},"ordering_evidence":"xiahoucao-e-p035a-q","source_order":[9,356,"P035a"],"order":2278}],"persons":[{"id":"mingdi-p0056","name":"曹爽","facts":[],"aliases":[]},{"id":"wudi-p0364","name":"司马懿","facts":[],"aliases":[]}],"evidence":[{"id":"xiahoucao-e-p035a-q","section":"chapter-009","block":"b-ec32ef84379aeb5308fe","layer":"pei","quote":"﹝二﹞《魏末传》曰：“爽兄弟归家。敕洛阳县：发民八百人，使尉部围爽第四角；角作高楼，令人在上望视爽兄弟举动。爽计穷愁闷，持弹到后园中，楼上人便唱言：‘故大将军东南行！’爽还厅事上，与兄弟共议，未知宣王意深浅。作书与宣王曰：‘贱子爽哀惶恐怖，无状招祸，分受屠灭。前遣家人迎粮，于今未反；数日乏匮，当烦见饷，以继旦夕。’宣王得书大惊，即答书曰：‘初不知乏粮，甚怀踧踖。令致米一百斛，并肉脯、盐豉、大豆。’寻送。爽兄弟不达变数，即便喜欢，自谓不死。”","attribution":"《魏末传》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":355,"anchor":null},"note_id":"n-b0aeffdd11e76b737178","start":0,"end":222}],"profiles":{},"directory_counts":{}}
