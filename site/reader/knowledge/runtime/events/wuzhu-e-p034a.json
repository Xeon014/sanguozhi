{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wuzhu-e-p034a","title":"曹丕信孙权遣子之辞孙权终不遣浩周疏远不用","accounts":[{"id":"wuzhu-e-p034a-account","label":"《魏略》","text":"曹丕信孙权遣子之辞孙权终不遣浩周疏远不用","evidence":["wuzhu-e-p034a-q"]}],"participants":[{"person":"wudi-p0170","role":"信书疏臣","evidence":["wuzhu-e-p034a-q"]},{"person":"sun-quan","role":"不遣子","evidence":["wuzhu-e-p034a-q"]},{"person":"wuzhu-p0029","role":"失用","evidence":["wuzhu-e-p034a-q"]}],"place":null,"time":{"label":"孙权许遣子入侍后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["wuzhu-e-p034a-q"]},"ordering_evidence":"wuzhu-e-p034a-q","source_order":[47,352,"P034a"],"order":8240}],"persons":[{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"wudi-p0170","name":"曹丕","facts":[],"aliases":[]},{"id":"wuzhu-p0029","name":"浩周","facts":[],"aliases":[]}],"evidence":[{"id":"wuzhu-e-p034a-q","section":"chapter-047","block":"b-c83aa5cd5e3564bc77d6","layer":"pei","quote":"于是诏曰：‘权前对浩周自陈，不敢自远，乐委质长为外臣；又前后辞旨，头尾击地：此鼠子自知不能保尔许地也。又今与周书，请以十二月遣子；复欲遣孙长绪、张子布随子俱来，彼二人皆权股肱心腹也。又欲为子于京师求妇，此权〔无〕异心之明效也。’帝既信权甘言，且谓周为得其真；而权但华伪，竟无遣子意。自是之后，帝既彰权罪；周亦见疏远，终身不用。”","attribution":"《魏略》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":351,"anchor":null},"note_id":"n-43467797fb37569f4074","start":0,"end":164}],"profiles":{},"directory_counts":{}}
