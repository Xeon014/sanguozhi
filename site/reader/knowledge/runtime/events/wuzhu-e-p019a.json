{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wuzhu-e-p019a","title":"赵咨擢中大夫使魏后拜骑都尉","accounts":[{"id":"wuzhu-e-p019a-account","label":"《吴书》","text":"赵咨使魏数次应对，归后受孙权嘉奖拜骑都尉。","evidence":["wuzhu-e-p019a-q"]}],"participants":[{"person":"wuzhu-p0023","role":"奉使受任","evidence":["wuzhu-e-p019a-q"]},{"person":"wudi-p0170","role":"询问","evidence":["wuzhu-e-p019a-q"]},{"person":"sun-quan","role":"擢任","evidence":["wuzhu-e-p019a-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["wuzhu-e-p019a-q"]},"ordering_evidence":"wuzhu-e-p019a-q","source_order":[47,291,"P019a"],"order":8211}],"persons":[{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"wudi-p0170","name":"曹丕","facts":[],"aliases":[]},{"id":"wuzhu-p0023","name":"赵咨","facts":[],"aliases":[]}],"evidence":[{"id":"wuzhu-e-p019a-q","section":"chapter-047","block":"b-6695ba6f0576d968e9c7","layer":"pei","quote":"权为吴王，擢中大夫。使魏，魏文帝善之，嘲咨曰：‘吴王颇知学乎？’咨曰：‘吴王浮江万艘，带甲百万；任贤使能，志存经略；虽有余闲，博览书传，历史籍，采奇异：不效诸生寻章摘句而已。’帝曰：‘吴可征不？’咨对曰：‘大国有征伐之兵，小国有备御之固。’又曰：‘吴难魏不？’咨曰：‘带甲百万，江、汉为池：何难之有？’又曰：‘吴如大夫者几人？’咨日：‘聪明特达者八九十人；如臣之比，车载斗量，不可胜数！’咨频载使，北人敬异。权闻而嘉之，拜骑都尉。","attribution":"《吴书》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":290,"anchor":null},"note_id":"n-46f04f90ecb6c017d08c","start":30,"end":245}],"profiles":{},"directory_counts":{}}
