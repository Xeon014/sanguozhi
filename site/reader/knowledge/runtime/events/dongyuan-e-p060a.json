{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dongyuan-e-p060a","title":"董卓与袁绍激辩废帝袁绍横刀辞出","accounts":[{"id":"dongyuan-e-p060a-account","label":"《献帝春秋》","text":"董卓与袁绍激辩废帝袁绍横刀辞出","evidence":["dongyuan-e-p060a-q"]},{"id":"dongyuan-a-p061-judgment","label":"裴松之论","text":"裴松之认为献帝春秋所载董卓袁绍激辩不可信。","evidence":["dongyuan-q-p061-judgment"]}],"participants":[{"person":"wudi-p0053","role":"议废立","evidence":["dongyuan-e-p060a-q"]},{"person":"wudi-p0052","role":"拒议","evidence":["dongyuan-e-p060a-q"]}],"place":null,"time":{"label":"董卓议废立时异说","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-p060a-q"]},"ordering_evidence":"dongyuan-e-p060a-q","source_order":[6,229,"P060a"],"order":1627}],"persons":[{"id":"wudi-p0052","name":"袁绍","facts":[],"aliases":[]},{"id":"wudi-p0053","name":"董卓","facts":[],"aliases":[]}],"evidence":[{"id":"dongyuan-e-p060a-q","section":"chapter-006","block":"b-3c498933c751d69e13dd","layer":"pei","quote":"﹝一﹞《献帝春秋》曰：“卓欲废帝，谓绍曰：‘皇帝冲暗，非万乘之主。陈留王犹胜，今欲立之。人有少智，大或痴，亦知复何如？为当且尔。卿不见灵帝乎？念此令人愤毒！’绍曰：‘汉家君天下，四百许年，恩泽深渥，兆民戴之来久。今帝虽幼冲，未有不善宣闻天下；公欲废嫡立庶，恐众不从公议也。’卓谓绍曰：‘竖子！天下事岂不决我？我今为之，谁敢不从？尔谓董卓刀为不利乎！’绍曰：‘天下健者，岂唯董公！’引佩刀横揖而出。”","attribution":"《献帝春秋》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":228,"anchor":null},"note_id":"n-ca82cc66f8330aa4ef22","start":0,"end":199},{"id":"dongyuan-q-p061-judgment","section":"chapter-006","block":"b-28e554710389910f8239","layer":"pei","quote":"臣松之以为：绍于时与卓未构嫌隙，故卓与之咨谋。若但以言议不同，便骂为“竖子”，而有推刃之心；及绍复答，屈强为甚：卓又安能容忍而不加害乎？且如绍此言，进非亮正，退违诡逊；而显其竞爽之旨，以触哮阚之锋；有志功业者，理岂然哉？此语，妄之甚矣！","attribution":"裴松之论","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":229,"anchor":null},"note_id":"n-ca82cc66f8330aa4ef22","start":0,"end":118}],"profiles":{},"directory_counts":{}}
