{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dongliu-e-o011","title":"诸葛亮下教群下论参署","accounts":[{"id":"dongliu-a-d1b262223b722241a3f1","label":"正文","text":"诸葛亮下教群下论参署","evidence":["dongliu-q-2c4286d66218d494f95b","dongliu-q2-08960b4d0a5affce3ea1"]}],"participants":[{"person":"zhuge-liang","role":"为丞相后下教与群下，论参署集众思广忠益","evidence":["dongliu-q-2c4286d66218d494f95b"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["dongliu-q-2c4286d66218d494f95b"]},"ordering_evidence":"dongliu-q-2c4286d66218d494f95b","source_order":[39,5,0],"order":7125}],"persons":[{"id":"zhuge-liang","name":"诸葛亮","facts":[],"aliases":[]}],"evidence":[{"id":"dongliu-q-2c4286d66218d494f95b","section":"chapter-039","block":"b-434416551b1b07e500fd","layer":"original","quote":"亮后为丞相，教与群下曰","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":4,"anchor":null},"note_id":null,"start":0,"end":11},{"id":"dongliu-q2-08960b4d0a5affce3ea1","section":"chapter-039","block":"b-434416551b1b07e500fd","layer":"original","quote":"亮后为丞相，教与群下曰〖17〗：“夫参署者〖18〗，集众思、广忠益也。若远小嫌〖19〗，难相违覆〖20〗，旷阙损矣〖21〗。违覆而得中〖22〗，犹弃弊v而获珠玉〖23〗。然人心苦不能尽〖24〗，惟徐元直处兹不惑〖25〗。又董幼宰参署七年，事有不至〖26〗，至于十返〖27〗，来相启告。苟能慕元直之十一〖28〗，幼宰之殷勤〖29〗，有忠于国，则亮可少过矣〖30〗。”","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":4,"anchor":null},"note_id":null,"start":0,"end":182}],"profiles":{},"directory_counts":{}}
