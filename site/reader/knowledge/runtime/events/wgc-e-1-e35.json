{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wgc-e-1-e35","title":"曹叡免诸葛诞官","order":5553,"accounts":[{"id":"wgc-a-1-e35","label":"正文","text":"曹叡免诸葛诞官","evidence":["wgc-q0248","wgc-q0022"]}],"participants":[{"person":"wendi-p0005","role":"恶浮华之风、免诞官","evidence":["wgc-q0248","wgc-q0022"]},{"person":"shaodi-p0044","role":"被免官","evidence":["wgc-q0248","wgc-q0022"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0248","wgc-q0022"]},"ordering_evidence":"wgc-q0248"}],"persons":[{"id":"shaodi-p0044","name":"诸葛诞","facts":[],"aliases":[]},{"id":"wendi-p0005","name":"曹叡","facts":[],"aliases":[]}],"evidence":[{"id":"wgc-q0022","section":"chapter-028","block":"b-12a13b8751046de2d4db","layer":"original","quote":"诸葛诞字公休，琅邪阳都人〖1〗。诸葛丰后也〖2〗。初以尚书郎为荥阳令。﹝一﹞入为吏部郎。人有所属托〖3〗，辄显其言而承用之；后有当否，则公议其得失以为褒贬：自是群僚莫不慎其所举。累迁御史中丞、尚书，与夏侯玄、邓飏等相善；收名朝廷，京都翕然〖4〗。言事者以诞、飏等修浮华，合虚誉，渐不可长。明帝恶之，免诞官。﹝二﹞","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":149,"anchor":null},"note_id":null,"start":0,"end":156},{"id":"wgc-q0248","section":"chapter-028","block":"b-12a13b8751046de2d4db","layer":"original","quote":"言事者以诞、飏等修浮华，合虚誉，渐不可长。明帝恶之，免诞官","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":149,"anchor":null},"note_id":null,"start":123,"end":152}],"profiles":{},"directory_counts":{}}
