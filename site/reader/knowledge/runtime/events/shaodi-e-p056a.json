{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"shaodi-e-p056a","title":"石苞卖铁于长安得司马懿赏识后迁官","accounts":[{"id":"shaodi-e-p056a-account","label":"《世语》","text":"石苞卖铁于长安得司马懿赏识后迁官","evidence":["shaodi-e-p056a-q"]}],"participants":[{"person":"shaodi-p0138","role":"获识迁官","evidence":["shaodi-e-p056a-q"]},{"person":"wudi-p0364","role":"识拔","evidence":["shaodi-e-p056a-q"]}],"place":null,"time":{"label":"青龙中以后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["shaodi-e-p056a-q"]},"ordering_evidence":"shaodi-e-p056a-q","source_order":[4,715,"P056a"],"order":1246}],"persons":[{"id":"shaodi-p0138","name":"石苞","facts":[],"aliases":[]},{"id":"wudi-p0364","name":"司马懿","facts":[],"aliases":[]}],"evidence":[{"id":"shaodi-e-p056a-q","section":"chapter-004","block":"b-dac5896f2380535b6283","layer":"pei","quote":"﹝二﹞《世语》曰：“初，青龙中，石苞鬻铁于长安。得见司马宣王，宣王知焉。后擢为尚书郎，历青州刺史、镇东将军。甘露中入朝，当还，辞高贵乡公，留中尽日。文王遣人邀，令过。文王问苞：‘何淹留也？’苞曰：‘非常人也！’明日发至荥阳，数日而难作。”","attribution":"《世语》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_001.xhtml","index":122,"anchor":null},"note_id":"n-1ed87a609f609653d8e4","start":0,"end":119}],"profiles":{},"directory_counts":{}}
