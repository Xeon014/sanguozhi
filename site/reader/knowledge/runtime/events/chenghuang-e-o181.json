{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"chenghuang-e-o181","title":"宁叩头乞苏飞首领权乃赦之","accounts":[{"id":"chenghuang-a-c6caf1f68d97674b8484","label":"裴注·吴书","text":"宁叩头乞苏飞首领权乃赦之","evidence":["chenghuang-q-5082bab296eb170576ca"]}],"participants":[{"person":"gan-ning","role":"曰飞若不言吾岂忘之、下席叩头血涕交流、为权言飞畴昔旧恩宁不值飞固已损骸于沟壑不得致命于麾下今飞罪当夷戮特从将军乞其首领、曰飞免分裂之祸受更生之恩逐之尚必不走岂当图亡哉若尔宁头当代入函","evidence":["chenghuang-q-5082bab296eb170576ca"]},{"person":"sun-quan","role":"破祖先作两函欲以盛祖及苏飞首、为诸将置酒、感其言、谓曰今为君置之若走云何、乃赦之","evidence":["chenghuang-q-5082bab296eb170576ca"]},{"person":"chenghuang-p0016","role":"令人告急于宁、被赦","evidence":["chenghuang-q-5082bab296eb170576ca"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["chenghuang-q-5082bab296eb170576ca"]},"ordering_evidence":"chenghuang-q-5082bab296eb170576ca","source_order":[55,226,10],"order":9874}],"persons":[{"id":"chenghuang-p0016","name":"苏飞","facts":[],"aliases":[]},{"id":"gan-ning","name":"甘宁","facts":[],"aliases":[]},{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]}],"evidence":[{"id":"chenghuang-q-5082bab296eb170576ca","section":"chapter-055","block":"b-49ca62dbcfc9e04378b6","layer":"pei","quote":"初，权破祖，先作两函，欲以盛祖及苏飞首。飞令人告急于宁，宁曰：‘飞若不言，吾岂忘之！’权为诸将置酒，宁下席叩头，血涕交流，为权言：‘飞，畴昔旧恩；宁不值飞，固已损骸于沟壑，不得致命于麾下！今飞罪当夷戮，特从将军乞其首领！’权感其言，谓曰：‘今为君（致）〔置〕之，若走（去）〔云〕何？’宁曰：‘飞免分裂之祸，受更生之恩；逐之尚必不走，岂当图亡哉！若尔，宁头当代入函。’权乃赦之","attribution":"裴注·吴书","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":225,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-e50213f1deb1ae1bbd7c","start":10,"end":197,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
