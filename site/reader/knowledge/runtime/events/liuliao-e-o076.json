{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"liuliao-e-o076","title":"亮与李丰教劝慰都护","accounts":[{"id":"liuliao-a-d3ca858810485a0249de","label":"裴注·诸葛亮与李丰教","text":"亮与李丰教劝慰都护","evidence":["liuliao-q-5d9afca6edb8ffa5f7d8"]}],"participants":[{"person":"zhuge-liang","role":"与李丰教劝慰都护","evidence":["liuliao-q-5d9afca6edb8ffa5f7d8"]},{"person":"liuliao-p0016","role":"受教者","evidence":["liuliao-q-5d9afca6edb8ffa5f7d8"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liuliao-q-5d9afca6edb8ffa5f7d8"]},"ordering_evidence":"liuliao-q-5d9afca6edb8ffa5f7d8","source_order":[40,235,0],"order":7294}],"persons":[{"id":"liuliao-p0016","name":"李丰","facts":[],"aliases":[]},{"id":"zhuge-liang","name":"诸葛亮","facts":[],"aliases":[]}],"evidence":[{"id":"liuliao-q-5d9afca6edb8ffa5f7d8","section":"chapter-040","block":"b-fa461c68c665079d96af","layer":"pei","quote":"﹝三﹞诸葛亮又与平子丰教曰：“吾与君父子戮力以奖汉室，此神明所闻，非但人知之也。表都护典汉中，委君于东关者，不与人议也。谓至心感动，终始可保；何图中乖乎？昔楚卿屡绌，亦乃克复；思道则福，应自然之数也。愿宽慰都护，勤追前阙。今虽解任，形业夫故；奴婢宾客，百数十人；君以中郎、参军居府：方之气类，犹为上家。若都护思负一意，君与公琰推心从事者，否可复通，逝可复还也。详思斯戒，明吾用心。临书长叹，涕泣而已！”","attribution":"裴注·诸葛亮与李丰教","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":234,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0a13c28f54c21cfab67b","start":0,"end":201,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
