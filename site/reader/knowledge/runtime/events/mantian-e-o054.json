{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"mantian-e-o054","title":"宠谏休深入贼断夹石休败还","accounts":[{"id":"mantian-a-24ef435633a2a5a0beca","label":"正文","text":"宠谏休深入贼断夹石休败还","evidence":["mantian-q-7ed04aec9db9cb6c48e3"]}],"participants":[{"person":"wendi-p0039","role":"从庐江南入合肥、遂深入、战不利退走、军乃得还","evidence":["mantian-q-7ed04aec9db9cb6c48e3"]},{"person":"mingdi-p0038","role":"令向夏口、上疏曹休虽明果而希用兵、今所从道背湖旁江易进难退、若入无强口宜深为之备、表未报","evidence":["mantian-q-7ed04aec9db9cb6c48e3"]},{"person":"wudi-p0164","role":"等从后来断道与贼相遇","evidence":["mantian-q-7ed04aec9db9cb6c48e3"]},{"person":"wendi-p0005","role":"使曹休从庐江南入合肥、令宠向夏口","evidence":["mantian-q-7ed04aec9db9cb6c48e3"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["mantian-q-7ed04aec9db9cb6c48e3"]},"ordering_evidence":"mantian-q-7ed04aec9db9cb6c48e3","source_order":[26,48,85],"order":5146}],"persons":[{"id":"mingdi-p0038","name":"满宠","facts":[],"aliases":[]},{"id":"wendi-p0005","name":"曹叡","facts":[],"aliases":[]},{"id":"wendi-p0039","name":"曹休","facts":[],"aliases":[]},{"id":"wudi-p0164","name":"朱灵","facts":[],"aliases":[]}],"evidence":[{"id":"mantian-q-7ed04aec9db9cb6c48e3","section":"chapter-026","block":"b-9c263b5bb6638ae82cd3","layer":"original","quote":"秋，使曹休从庐江南入合肥〖5〗，令宠向夏口〖6〗。宠上疏曰：“曹休虽明果而希用兵〖7〗，今所从道，背湖旁江，易进难退，此兵之（洼）〔d 〕地也〖8〗。若入无强口〖9〗，宜深为之备。”宠表未报，休遂深入。贼果从无强口断夹石〖10〗，要休还路〖11〗。休战不利，退走。会朱灵等从后来断道，与贼相遇。贼惊走，休军乃得还","section_title":"满田牵郭传第二十六","source":{"file":"OEBPS/Text/titlepage_0058.xhtml","index":47,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":83,"end":239,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
