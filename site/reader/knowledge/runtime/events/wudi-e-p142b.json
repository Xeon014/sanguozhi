{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p142b","title":"曹操颁赡恤孤老残疾贫民令","accounts":[{"id":"wudi-e-p142b-account","label":"《魏书》","text":"曹操规定对符合条件的孤老、幼儿、残疾者廪食，对贫民按口贷粮，并免九十岁老人家一人徭役。","evidence":["wudi-e-p142b-q"]}],"participants":[{"person":"cao-cao","role":"颁赡恤令","evidence":["wudi-e-p142b-q"]}],"place":null,"time":{"label":"建安二十三年","year":218,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-p142b-q","wudi-q-o188","wudi-q-b-ac93ccb47f6e7be3aea4"],"chronology":"wudi-y218","dating_review":{"anchor":"wudi-q-o188","basis":"建安二十三年","reviewed":true}},"source_order":[1,1097,"P142b"],"order":422}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-p142b-q","section":"chapter-001","block":"b-04be1d3bb1a099cf6d53","layer":"pei","quote":"其令吏民男女：女年七十以上无夫、子，若年十二以下无父母、兄弟，及目无所见，手不能作，足不能行，而无妻、子、父、兄、产业者，廪食终身。幼者至十二止。贫穷不能自赡者，随口给贷。老耄须待养者，年九十以上，复不事；家一人。","attribution":"《魏书》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":421,"anchor":null},"note_id":"n-fea367d8b493cbb18793","start":40,"end":147},{"id":"wudi-q-b-ac93ccb47f6e7be3aea4","section":"chapter-001","block":"b-ac93ccb47f6e7be3aea4","layer":"modern","quote":"〖1〗二十三年：建安二十三年（公元 218）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":403,"anchor":null},"note_id":"n-8cae36984cdc22e48444","start":0,"end":23},{"id":"wudi-q-o188","section":"chapter-001","block":"b-1336d4803d0b76311776","layer":"original","quote":"二十三年春正月〖1〗，汉太医令吉本与少府耿纪、司直韦晃等反〖2〗。攻许，烧丞相长史王必营〖3〗。﹝一﹞必与颍川典农中郎将严匡讨斩之〖4〗。﹝二﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":396,"anchor":null},"note_id":null,"start":0,"end":72}],"profiles":{},"directory_counts":{}}
