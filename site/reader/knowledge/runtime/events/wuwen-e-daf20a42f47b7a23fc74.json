{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wuwen-e-daf20a42f47b7a23fc74","title":"曹丕迁葬曹冲、追赐邓公并以太牢祭祠","accounts":[{"id":"wuwen-a-daf20a42f47b7a23fc74","label":"裴注引《魏书》策命","text":"曹丕迁葬曹冲、追赐邓公并以太牢祭祠","evidence":["wuwen-q-011bb6cb38971512e901"]}],"participants":[{"person":"wudi-p0170","role":"策命者","evidence":["wuwen-q-011bb6cb38971512e901"]},{"person":"dongyuan-p0188","role":"被迁葬追封者","evidence":["wuwen-q-011bb6cb38971512e901"]},{"person":"wuwen-p-bb3f2a7047f261","role":"持节使者","evidence":["wuwen-q-011bb6cb38971512e901"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["wuwen-q-011bb6cb38971512e901"]},"ordering_evidence":"wuwen-q-011bb6cb38971512e901","order":3868}],"persons":[{"id":"dongyuan-p0188","name":"曹冲","facts":[],"aliases":[]},{"id":"wudi-p0170","name":"曹丕","facts":[],"aliases":[]},{"id":"wuwen-p-bb3f2a7047f261","name":"陈承","facts":[],"aliases":[]}],"evidence":[{"id":"wuwen-q-011bb6cb38971512e901","section":"chapter-020","block":"b-456709c15dd45753e139","layer":"pei","quote":"﹝三﹞《魏书》载策曰：“惟黄初二年八月丙午，皇帝曰：‘咨！尔邓哀侯冲：昔皇天钟美于尔躬，俾聪哲之才，成于弱年；当永享显祚，克成厥终。如何不禄，早世夭昏！朕承天序，享有四海，并建亲亲，以藩王室；惟尔不逮斯荣，且葬礼未备：追悼之怀，怆然攸伤！今迁葬于高陵，使使持节兼谒者仆射、郎中陈承，追赐号曰邓公，祠以太牢。魂而有灵，休兹宠荣。呜呼哀哉！’”","attribution":"裴注引《魏书》策命","section_title":"武文世王公传第二十","source":{"file":"OEBPS/Text/titlepage_0045.xhtml","index":37,"anchor":null},"note_id":"n-08a1bd7f439bf9705bcc","start":0,"end":170}],"profiles":{},"directory_counts":{}}
