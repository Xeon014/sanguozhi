{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"mingdi-e-o002a","title":"孙权攻江夏文聘坚守曹叡议不发援军","accounts":[{"id":"mingdi-e-o002a-account","label":"《明帝纪》正文","text":"孙权攻江夏文聘坚守曹叡议不发援军","evidence":["mingdi-e-o002a-q"]}],"participants":[{"person":"sun-quan","role":"进攻","evidence":["mingdi-e-o002a-q"]},{"person":"wudi-p0250","role":"坚守","evidence":["mingdi-e-o002a-q"]},{"person":"wendi-p0005","role":"料敌","evidence":["mingdi-e-o002a-q"]}],"place":{"text":"江夏","evidence":["mingdi-e-o002a-q"]},"time":{"year":226,"label":"黄初七年秋八月","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"mingdi-y226","dating_review":{"reviewed":true,"anchor":"mingdi-q-o001","basis":"黄初七年秋八月"},"evidence":["mingdi-e-o002a-q","mingdi-q-o001","mingdi-q-b-b7b4e1eced04c86a11c0"]},"ordering_evidence":"mingdi-e-o002a-q","source_order":[3,18,"O002a"],"order":707}],"persons":[{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"wendi-p0005","name":"曹叡","facts":[],"aliases":[]},{"id":"wudi-p0250","name":"文聘","facts":[],"aliases":[]}],"evidence":[{"id":"mingdi-e-o002a-q","section":"chapter-003","block":"b-500c15b5ba207c89e625","layer":"original","quote":"〔秋〕八月，孙权攻江夏郡〖1〗。太守文聘坚守〖2〗，朝议欲发兵救之。帝曰：“权习水战，所以敢下船陆攻者，几掩不备也〖3〗。今已与聘相持；夫攻守势倍〖4〗，终不敢久也。”先时，遣治书侍御史荀禹慰劳边方〖5〗。禹到，于江夏发所经县兵及所从步骑千人乘山举火〖6〗，权退走。辛巳〖7〗，立皇子冏为清河王。吴将诸葛瑾、张霸等寇襄阳〖8〗。抚军大将军司马宣王讨破之，斩霸。征东大将军曹休又破其别将于寻阳〖9〗。论功行赏各有差。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":17,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":207,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-b-b7b4e1eced04c86a11c0","section":"chapter-003","block":"b-b7b4e1eced04c86a11c0","layer":"modern","quote":"〖2〗七年：黄初七年（公元226）。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":4,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-7290e2008f81d6cad349","start":0,"end":18,"offset_unit":"unicode_code_point"},{"id":"mingdi-q-o001","section":"chapter-003","block":"b-fe69417d79b76e276a24","layer":"original","quote":"明皇帝讳叡，字元仲。文帝太子也。生而太祖爱之，常令在左右。﹝一﹞年十五，封武德侯。黄初二年为齐公。三年为平原王〖1〗。以其母诛，故未建为嗣。﹝二﹞七年夏五月〖2〗，帝病笃，乃立为皇太子。丁巳〖3〗，即皇帝位。大赦；尊皇太后曰太皇太后〖4〗，皇后曰皇太后〖5〗；诸臣封爵各有差。﹝三﹞〔六月〕，癸未〖6〗，追谥母甄夫人曰文昭皇后〖7〗。壬辰〖8〗，立皇弟蕤为阳平王〖9〗。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":1,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":185,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
