{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"shaodi-e-p013a","title":"毌丘俭王昶烧屯走司马师引咎惟削司马昭爵","accounts":[{"id":"shaodi-e-p013a-account","label":"《汉晋春秋》","text":"毌丘俭王昶烧屯走司马师引咎惟削司马昭爵","evidence":["shaodi-e-p013a-q"]},{"id":"shaodi-a-p014-judgment","label":"习凿齿论","text":"习凿齿赞司马师引二败为己过，认为能消过而隆业。","evidence":["shaodi-q-p014-judgment"]}],"participants":[{"person":"mingdi-p0048","role":"退军","evidence":["shaodi-e-p013a-q"]},{"person":"shaodi-p0032","role":"退军","evidence":["shaodi-e-p013a-q"]},{"person":"shaodi-p0038","role":"引咎","evidence":["shaodi-e-p013a-q"]},{"person":"shaodi-p0045","role":"被削爵","evidence":["shaodi-e-p013a-q"]}],"place":null,"time":{"year":252,"label":"东关败后","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"shaodi-y252","dating_review":{"reviewed":true,"anchor":"shaodi-q-o052","basis":"东关败后"},"evidence":["shaodi-e-p013a-q","shaodi-q-o052","shaodi-q-b-20272e7cc5379b3fe346"]},"ordering_evidence":"shaodi-e-p013a-q","source_order":[4,238,"P013a"],"order":1090}],"persons":[{"id":"mingdi-p0048","name":"毌丘俭","facts":[],"aliases":[]},{"id":"shaodi-p0032","name":"王昶","facts":[],"aliases":[]},{"id":"shaodi-p0038","name":"司马师","facts":[],"aliases":[]},{"id":"shaodi-p0045","name":"司马昭","facts":[],"aliases":[]}],"evidence":[{"id":"shaodi-e-p013a-q","section":"chapter-004","block":"b-e0d2979abcf13f87f304","layer":"pei","quote":"﹝二﹞《汉晋春秋》曰：“毌丘俭、王昶闻东军败，各烧屯走。朝议欲贬黜诸将，景王曰：‘我不听公休，以至于此。此我过也！诸将何罪？’悉原之。时司马文王为监军，统诸军；唯削文王爵而已。是岁，雍州刺史陈泰求敕并州，并力讨胡，景王从之。未集，而雁门、新兴二郡以为将远役，遂惊反。景王又谢朝士曰：‘此我过也，非玄伯之责！’于是魏人愧悦，人思其报。”","attribution":"《汉晋春秋》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":237,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b26599b45ae85dc080dd","start":0,"end":167,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-b-20272e7cc5379b3fe346","section":"chapter-004","block":"b-20272e7cc5379b3fe346","layer":"modern","quote":"〖17〗四年：嘉平四年（公元252）。癸卯：旧历初二日。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":230,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-db96ad991a403b6a010e","start":0,"end":28,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o052","section":"chapter-004","block":"b-944c76689fd8a3e8fa86","layer":"original","quote":"四年春正月，癸卯〖17〗，以抚军大将军司马景王为大将军。二月，立皇后张氏〖18〗，大赦。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":210,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":44,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-p014-judgment","section":"chapter-004","block":"b-49bc67e1ff4fc380b3a1","layer":"pei","quote":"习凿齿曰：“司马大将军引二败以为己过，过消而业隆，可谓智矣。夫民忘其败，而下思其报；虽欲不康，其可得邪？若乃讳败推过，归咎万物，常执其功而隐其丧；上下离心，贤愚解体，是楚再败而晋再克也：谬之甚矣！君人者，苟统斯理，而以御国，则朝无秕政，身靡留愆；行失而名扬，兵挫而战胜，虽百败可也，况于再乎！”","attribution":"习凿齿论","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":238,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b26599b45ae85dc080dd","start":0,"end":147,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
