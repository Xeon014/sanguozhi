1a1a12d","chapter-013":"24c6e486e7f78fc4d59ff01277b36cb77ffb69c68a6a9030889fe00efe4b3d27","chapter-016":"6cfac20452f269a832b087d2e808cc4b3017944d17dca1d5b1e068ebb98d8327","chapter-018":"7a62f43c1f5dc64661b088ef0fdd48392063ef5c49001fa980aa65e766380b23","chapter-019":"a43f6648e6c9d8389d561bee9d00824665f8f06542ab2a65aac06ed8a7601c5b","chapter-020":"2ef7e28be018140e07d27d7636a9df480a5cb7ef1cb3572c314a70e0d1acd07c","chapter-050":"71faaaddb69f25a5bdd7f315f15562e867eed9e897c9bd439a99a09c435bfe91","chapter-023":"908d4e64a01e171bdb09c0a7ee5484b8743be26b7cc75f49bd8b41b7ff391ff2","chapter-024":"39be893c0040dbb3148f9447402c47fc24dcb4356360f8558243258cb85b089a","chapter-025":"f37fc365e7d07f96b5fd289119e1846fe7f0030d8b46a7195fab316badf817b7","chapter-027":"dd48b2052380e1f6b6f6ffcb4835dd99cfe70efe4a9096fa51448dbdfaa14f00","chapter-062":"7031fb8ebde1ea3c95cdedcf93218fb46f69a71a29a1d9e82361f7108436a86a","chapter-063":"3ae8edfbae98c3e86a518f7022c664ed35a0d68d5ac36b331ceb560e76b1848f","chapter-065":"13c50dd7dc9a229aef1cfb43dd231955a0b1a6359dab04c54708df93fa114e12","chapter-057":"39e3922e223fe25b811b77f14049327071298549de6ed788ba7da697f067f2e3","chapter-021":"18c02b71e8f81644cf71ffea582a8e019509de0b5e9bc11451de595fa03e2cf3","chapter-029":"6ffb35bac29d20aa512b5a734e72f98ec5729b176f1bc5d6837e673bcc00880d","chapter-030":"3e0682212c3e242d0f221308bc203bd8309851b8498b94db16383bdde5234ce1"},"events":[{"id":"rencheng-e-540a1d0cc080173db06c","title":"曹植上疏论审慎举贤与亲用宗室","accounts":[{"id":"rencheng-a-540a1d0cc080173db06c","label":"正文","text":"曹植上疏论审慎举贤与亲用宗室","evidence":["rencheng-q-e5fd25275b851d125b07","rencheng-q-cfcd796b9637bdf950a1","rencheng-q-459f2d547b20738389b0","rencheng-q-2830023fbebf1c365e35","rencheng-q-5835ec44e707e37959f2","rencheng-q-a98c6cab6e97bd6bbc1f","rencheng-q-6a4e44fcb91a2390308c","rencheng-q-7533829edaa34c47f225","rencheng-q-458a86fb6378ca225b68"]}],"participants":[{"person":"wudi-p0280","role":"上书或作诗者","evidence":["rencheng-q-e5fd25275b851d125b07","rencheng-q-cfcd796b9637bdf950a1","rencheng-q-459f2d547b20738389b0","rencheng-q-2830023fbebf1c365e35","rencheng-q-5835ec44e707e37959f2","rencheng-q-a98c6cab6e97bd6bbc1f","rencheng-q-6a4e44fcb91a2390308c","rencheng-q-7533829edaa34c47f225","rencheng-q-458a86fb6378ca225b68"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["rencheng-q-e5fd25275b851d125b07","rencheng-q-cfcd796b9637bdf950a1","rencheng-q-459f2d547b20738389b0","rencheng-q-2830023fbebf1c365e35","rencheng-q-5835ec44e707e37959f2","rencheng-q-a98c6cab6e97bd6bbc1f","rencheng-q-6a4e44fcb91a2390308c","rencheng-q-7533829edaa34c47f225","rencheng-q-458a86fb6378ca225b68"]},"ordering_evidence":"rencheng-q-e5fd25275b851d125b07","order":3807}],"persons":[{"id":"wudi-p0280","name":"曹植","facts":[],"aliases":[]}],"evidence":[{"id":"rencheng-q-2830023fbebf1c365e35","section":"chapter-019","block":"b-017ab5fbfbde708b8111","layer":"original","quote":"陛下体天真之淑圣〖15〗，登神机以继统〖16〗；冀闻康哉之歌〖17〗，偃武（行）〔修〕文之美。而数年以来，水旱不时，民困衣食；师徒之发，岁岁增调；加东有覆败之军〖18〗，西有殪没之将〖19〗：至使蚌蛤浮翔于淮、泗〖20〗，鼲鼬喧哗于林木〖21〗。臣每念之，未尝不辍食而挥餐〖22〗，临觞而扼腕矣！","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":365,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":148,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-458a86fb6378ca225b68","section":"chapter-019","block":"b-7712ef28dcd7e1b0a404","layer":"original","quote":"不胜愤懑，拜表陈情。若有不合，乞且藏之书府〖66〗，不便灭弃〖67〗；臣死之后，事或可思。若有毫厘少挂圣意者，乞出之朝堂；使夫博古之士，纠臣表之不合义者。如是，则臣愿足矣！","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":370,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":86,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-459f2d547b20738389b0","section":"chapter-019","block":"b-141d68bb0c4713cac11c","layer":"original","quote":"故阴阳不和，三光不畅〖12〗，官旷无人，庶政不整者，三司之责也；疆埸骚动，方隅内侵，没军丧众，干戈不息者，边将之忧也。岂可虚荷国宠而不称其任哉！故任益隆者负益重，位益高者责益深；《书》称“无旷庶官〖13〗”，《诗》有“职思其忧〖14〗”：此其义也。","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":364,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":124,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-5835ec44e707e37959f2","section":"chapter-019","block":"b-1977547299fb6471e9e0","layer":"original","quote":"昔汉文发代〖23〗，疑朝有变。宋昌曰〖24〗：“内有朱虚、东牟之亲〖25〗；外有齐、楚、淮南、琅邪〖26〗：此则磐石之宗〖27〗，愿王勿疑！”臣伏惟陛下远览姬文二虢之援〖28〗，中虑周成召、毕之辅〖29〗，下存宋昌磐石之固。昔骐骥之于吴坂，可谓困矣；及其伯乐相之，孙邮御之〖30〗，形体不劳而坐取千里。盖伯乐善御马，明君善御臣；伯乐驰千里，明君致太平：诚任贤使能之明效也。若朝司唯良〖31〗，万机内理；武将行师，方难克弭〖32〗：陛下可得雍容都城〖33〗，何事劳动銮驾〖34〗，暴露于边境哉！","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":366,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":246,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-6a4e44fcb91a2390308c","section":"chapter-019","block":"b-dbbb83d87f8ad552579e","layer":"original","quote":"屈平曰〖48〗：“国有骥而不知乘，焉皇皇而更索〖49〗！”昔管、蔡放诛，周、召作弼〖50〗；叔鱼陷刑〖51〗，叔向匡国〖52〗。三监之衅〖53〗，臣自当之；二南之辅〖54〗，求必不远：华宗贵族，藩王之中，必有应斯举者。故传曰：“无周公之亲〖55〗，不得行周公之事。”唯陛下少留意焉。","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":368,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":141,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-7533829edaa34c47f225","section":"chapter-019","block":"b-d05cfd3661d7c3a0a5ff","layer":"original","quote":"近者汉氏广建藩王，丰则连城数十，约则飨食祖祭而已〖56〗；未若姬周之树国，五等之品制也。若扶苏之谏始皇〖57〗，淳于越之难周青臣〖58〗，可谓知时变矣。夫能使天下倾耳注目者，当权者是矣；故谋能移主，威能慑下。豪右执政〖59〗，不在亲戚；权之所在，虽疏必重；势之所去，虽亲必轻。盖取齐者田族〖60〗，非吕宗也；分晋者赵、魏〖61〗，非姬姓也：唯陛下察之！苟吉专其位〖62〗，凶离其患者〖63〗，异姓之臣也；欲国之安，祈家之贵，存共其荣，没同其祸者，公族之臣也〖64〗。今反公族疏而异姓亲，臣窃惑焉。臣闻孟子曰：“君子穷则独善其身〖65〗，达则兼善天下。”今臣与陛下，践冰履炭，登山浮涧；寒温燥湿，高下共之：岂得离陛下哉！","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":369,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":309,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-a98c6cab6e97bd6bbc1f","section":"chapter-019","block":"b-ee03c628c00e7b9878e1","layer":"original","quote":"臣闻羊质虎皮，见草则悦，见豺则战〖35〗，忘其皮之虎也。今置将不良，有似于此。故语曰：“患为之者不知，知之者不得为也。”昔乐毅奔赵，心不忘燕；廉颇在楚〖36〗，思为赵将。臣生乎乱，长乎军，又数承教于武皇帝，伏见行师用兵之要，不必取孙、吴而暗与之合〖37〗。窃揆之于心，常愿得一奉朝觐，排金门〖38〗，蹈玉陛；列有职之臣，赐须臾之（问）〔间〕〖39〗；使臣得一散所怀，摅舒蕴积〖40〗：死不恨矣。被鸿胪所下发士息书〖41〗，期会甚急〖42〗。又闻豹尾已建〖43〗，戎轩鹜驾〖44〗，陛下将复劳玉躬，扰挂神思。臣诚竦息，不遑宁处。愿得策马执鞭，首当尘露；撮风后之奇〖45〗，接孙、吴之要〖46〗，追慕卜商起予左右〖47〗，效命先驱，毕命轮毂：虽无大益，冀有小补。然天高听远，情不上通；徒独望青云而拊心，仰高天而叹息耳。","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":367,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":357,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-cfcd796b9637bdf950a1","section":"chapter-019","block":"b-f508ba0004e8172b3e54","layer":"original","quote":"臣闻天地协气而万物生〖2〗，君臣合德而庶政成〖3〗。五帝之世非皆智，三季之末非皆愚〖4〗；用与不用，知与不知也。既时有举贤之名，而无得贤之实，必各援其类而进矣。谚曰：“相门有相，将门有将。”夫相者，文德昭者也；将者，武功烈者也。文德昭，则可以匡国朝，致雍熙〖5〗，稷、契、夔、龙是也；武功烈，则所以征不庭〖6〗，威四夷，南仲、方叔是矣。昔伊尹之为媵臣〖7〗，至贱也；吕尚之处屠钓，至陋也。及其见举于汤武、周文，诚道合志同，玄谟神通〖8〗；岂复假近习之荐〖9〗，因左右之介哉〖10〗！《书》曰：“有不世之君，必能用不世之臣；用不世之臣，必能立不世之功。”殷、周二王是矣。若夫龌龊近步〖11〗，遵常守故，安足为陛下言哉！","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":363,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":308,"offset_unit":"unicode_code_point"},{"id":"rencheng-q-e5fd25275b851d125b07","section":"chapter-019","block":"b-db0fe881bfb9c8da3087","layer":"original","quote":"植复上疏，陈审举之义〖1〗，曰：","section_title":"任城陈萧王传第十九","source":{"file":"OEBPS/Text/titlepage_0043.xhtml","index":362,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":16,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
