{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"guanzhang-e-p020a","title":"山阳公载记称关张持刀示礼令马超不再呼刘备字","accounts":[{"id":"guanzhang-e-p020a-account","label":"《山阳公载记》","text":"山阳公载记称关张持刀示礼令马超不再呼刘备字","evidence":["guanzhang-e-p020a-q"]},{"id":"guanzhang-a-p021-judgment","label":"裴松之按","text":"裴松之指出关羽当留荆州未尝入蜀，以此及称字叙述的逻辑矛盾反驳该故事。","evidence":["guanzhang-q-p021-judgment"]}],"participants":[{"person":"liu-bei","role":"答议","evidence":["guanzhang-e-p020a-q"]},{"person":"wudi-p0172","role":"被记欲杀","evidence":["guanzhang-e-p020a-q"]},{"person":"wudi-p0367","role":"被记示礼","evidence":["guanzhang-e-p020a-q"]},{"person":"wudi-p0282","role":"被记改称","evidence":["guanzhang-e-p020a-q"]}],"place":null,"time":{"label":"山阳公载记所述马超归刘备后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["guanzhang-e-p020a-q"]},"ordering_evidence":"guanzhang-e-p020a-q","source_order":[36,165,"P020a"],"order":6916}],"persons":[{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"wudi-p0172","name":"关羽","facts":[],"aliases":[]},{"id":"wudi-p0282","name":"马超","facts":[],"aliases":[]},{"id":"wudi-p0367","name":"张飞","facts":[],"aliases":[]}],"evidence":[{"id":"guanzhang-e-p020a-q","section":"chapter-036","block":"b-03ceb059abb5accaba62","layer":"pei","quote":"﹝一﹞《山阳公载记》曰：“超因见备待之厚，与备言，常呼备字；关羽怒，请杀之。备曰：‘人穷来归我，卿等怒，以呼我字故而杀之：何以示于天下也？’张飞曰：‘如是，当示之以礼。’明日大会，请超入；羽、飞并杖刀，立直。超顾坐席，不见羽、飞；见其直也，乃大惊，遂一不复呼备字。明日叹曰：‘我今乃知其所以败。为呼人主字，几为关羽、张飞所杀！’自后乃尊事备。”","attribution":"《山阳公载记》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":164,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-94720fb313f5fe2d48e5","start":0,"end":172,"offset_unit":"unicode_code_point"},{"id":"guanzhang-q-p021-judgment","section":"chapter-036","block":"b-c4467a61141e1de6d023","layer":"pei","quote":"臣松之按：以为超以穷归备，受其爵位，何容傲慢而呼备字？且备之入蜀，留关羽镇荆州，羽未尝在益土也；故羽闻马超归降，以书问诸葛亮“超人才可谁比类”，不得如书所云。羽焉得与张飞立直乎？凡人行事，皆谓其可也：知其不可，则不行之矣。超若果呼备字，亦谓于理宜尔也。就令羽请杀超，超不应闻；但见二子立直，何由便知以呼字之故，云几为关、张所杀乎？言不经理，深可忿疾也！袁#、乐资等诸所记载，秽杂虚谬，若此之类，殆不可胜言也。","attribution":"裴松之按","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":165,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-94720fb313f5fe2d48e5","start":0,"end":204,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
