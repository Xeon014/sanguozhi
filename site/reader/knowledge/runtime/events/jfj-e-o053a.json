{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"jfj-e-o053a","title":"姜维不答钟会书守险使魏军议退","order":7834,"accounts":[{"id":"jfj-a-o053a","label":"正文 · 景耀六年","text":"姜维不答钟会书守险使魏军议退","evidence":["jfj-q0193"]},{"id":"wgc-a-6-e15","label":"正文","text":"钟会攻剑阁不克引退","evidence":["wgc-q0469","wgc-q0468"]}],"participants":[{"person":"shaodi-p0050","role":"拒守","evidence":["jfj-q0193"]},{"person":"shaodi-p0073","role":"谋退","evidence":["jfj-q0193"]}],"place":null,"time":{"label":"景耀六年","precision":"year","basis":"逐条保留原时间；未从邻段自动继承公元年。","evidence":["jfj-q0193","jfj-q0028","jfj-q0029"],"year":263,"chronology":"jfj-y263","dating_review":{"reviewed":true,"anchor":"jfj-q0028","basis":"本条行动与所列正文纪年逐项核对；现代注释直接释年。原季月保留，不推公历日。"}},"ordering_evidence":"jfj-q0193"}],"persons":[{"id":"shaodi-p0050","name":"姜维","facts":[],"aliases":[]},{"id":"shaodi-p0073","name":"钟会","facts":[],"aliases":[]}],"evidence":[{"id":"jfj-q0028","section":"chapter-044","block":"b-6e2f890762325a17fefa","layer":"original","quote":"六年〖1〗，维表后主：“闻钟会治兵关中，欲规进取；宜并遣张翼、廖化督诸军，分护阳安关口、阴平桥头，以防未然〖2〗。”皓征信鬼巫〖3〗，谓敌终不自致；启后主寝其事〖4〗，而群臣不知。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":228,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":90,"offset_unit":"unicode_code_point"},{"id":"jfj-q0029","section":"chapter-044","block":"b-244c42d136c1fc518809","layer":"modern","quote":"〖1〗六年：景耀六年（公元 263）。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":236,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-07b5919ab8c7edcb2376","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"jfj-q0193","section":"chapter-044","block":"b-9de65e02e159a5ef52b1","layer":"original","quote":"维不答书，列营守险。会不能克，粮运悬远，将议还归。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":232,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":25,"offset_unit":"unicode_code_point"},{"id":"wgc-q0468","section":"chapter-028","block":"b-c0dc2458d677fcaed01f","layer":"original","quote":"会与绪军向剑阁。会欲专军势，密白绪畏懦不进；槛车征还，军悉属会。﹝一﹞进攻剑阁，不克，引退。蜀军保险拒守。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":530,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":53,"offset_unit":"unicode_code_point"},{"id":"wgc-q0469","section":"chapter-028","block":"b-c0dc2458d677fcaed01f","layer":"original","quote":"进攻剑阁，不克，引退。蜀军保险拒守","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":530,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":35,"end":52,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
