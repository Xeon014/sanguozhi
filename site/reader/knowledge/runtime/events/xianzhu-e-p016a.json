{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-p016a","title":"《吴历》载刘备种菜避曹并夜出","accounts":[{"id":"xianzhu-e-p016a-account","label":"胡冲《吴历》","text":"《吴历》称刘备因曹操窥伺而与关羽、张飞夜出，往小沛聚众；此说另受裴松之反驳。","evidence":["xianzhu-e-p016a-q"]},{"id":"xianzhu-a-p016-pei","label":"裴松之按语","text":"裴松之认为刘备受曹操之命邀击袁术，并非因种菜而逃；与《吴历》叙述分别保存。","evidence":["xianzhu-q-p016-pei"]}],"participants":[{"person":"liu-bei","role":"夜出","evidence":["xianzhu-e-p016a-q"]},{"person":"wudi-p0367","role":"同行","evidence":["xianzhu-e-p016a-q"]},{"person":"wudi-p0172","role":"同行","evidence":["xianzhu-e-p016a-q"]},{"person":"cao-cao","role":"遣人窥伺","evidence":["xianzhu-e-p016a-q"]}],"place":{"text":"许、小沛","evidence":["xianzhu-e-p016a-q"]},"time":{"label":"《吴历》所述离曹时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xianzhu-e-p016a-q"]},"source_order":[32,89,"P016a"],"order":6523}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"wudi-p0172","name":"关羽","facts":[],"aliases":[]},{"id":"wudi-p0367","name":"张飞","facts":[],"aliases":[]}],"evidence":[{"id":"xianzhu-e-p016a-q","section":"chapter-032","block":"b-8cb7e0cc0005a8b2523b","layer":"pei","quote":"胡冲《吴历》曰：“曹公数遣亲近，密觇诸将有宾客酒食者，辄因事害之。备时闭门，将人种芜菁。曹公使人窥门，既去；备谓张飞、关羽曰：‘吾岂种菜者乎？曹公必有疑意，不可复留！’其夜开后栅，与飞等轻骑俱去；所得赐遗衣服，悉封留之。乃往小沛收合兵众。”","attribution":"胡冲《吴历》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":88,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-973ee13dc5c031beee99","start":3,"end":123,"offset_unit":"unicode_code_point"},{"id":"xianzhu-q-p016-pei","section":"chapter-032","block":"b-8cb7e0cc0005a8b2523b","layer":"pei","quote":"臣松之按：魏武帝遣先主统诸将，要击袁术；郭嘉等并谏，魏武不从。其事显然，非因种菜遁逃而去。如胡冲所云，何乖僻之甚乎！","attribution":"裴松之按语","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":88,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-973ee13dc5c031beee99","start":123,"end":181,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
