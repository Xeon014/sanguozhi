{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xiahoucao-e-p040a","title":"李休为张鲁司马劝举号不纳后劝内附曹操授爵历郡守","accounts":[{"id":"xiahoucao-e-p040a-account","label":"《魏略》","text":"李休为张鲁司马劝举号不纳后劝内附曹操授爵历郡守","evidence":["xiahoucao-e-p040a-q"]}],"participants":[{"person":"xiahoucao-p0082","role":"献策历官","evidence":["xiahoucao-e-p040a-q"]},{"person":"wudi-p0279","role":"不纳","evidence":["xiahoucao-e-p040a-q"]},{"person":"cao-cao","role":"授爵","evidence":["xiahoucao-e-p040a-q"]}],"place":null,"time":{"label":"李休李胜仕汉魏时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xiahoucao-e-p040a-q"]},"ordering_evidence":"xiahoucao-e-p040a-q","source_order":[9,374,"P040a"],"order":2291}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0279","name":"张鲁","facts":[],"aliases":[]},{"id":"xiahoucao-p0082","name":"李休","facts":[],"aliases":[]}],"evidence":[{"id":"xiahoucao-e-p040a-q","section":"chapter-009","block":"b-64fbf7e2e74c7b21e8c7","layer":"pei","quote":"父休字子朗，有智略。张鲁前为镇北将军，休为司马，家南郑。时汉中有甘露降，子朗见张鲁精兵数万人，有四塞之固；遂建言赤气久衰，黄家当兴，欲鲁举号；鲁不听。会鲁破，太祖以其劝鲁内附，赐爵关内侯，署散官骑从，诣邺。至黄初中，仕历上党、钜鹿二郡太守。后以年老还，拜议郎。","attribution":"《魏略》","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":373,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-45775d68baddd17aab59","start":7,"end":137,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
