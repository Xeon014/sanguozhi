{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"chenghuang-e-o183","title":"统怨宁杀父吕蒙舍会以身分之","accounts":[{"id":"chenghuang-a-0ca233972e16388a41d4","label":"裴注·吴书","text":"统怨宁杀父吕蒙舍会以身分之","evidence":["chenghuang-q-280c37795269ef0349a3"]}],"participants":[{"person":"ling-tong","role":"怨宁杀其父操、尝于吕蒙舍会酒酣乃以刀舞","evidence":["chenghuang-q-280c37795269ef0349a3"]},{"person":"gan-ning","role":"常备统不与相见、起曰宁能双戟舞、后遂徙屯于半州","evidence":["chenghuang-q-280c37795269ef0349a3"]},{"person":"lu-meng","role":"曰宁虽能未若蒙之巧也、因操刀持盾以身分之","evidence":["chenghuang-q-280c37795269ef0349a3"]},{"person":"sun-quan","role":"亦命统不得仇之、知统意因令宁将兵","evidence":["chenghuang-q-280c37795269ef0349a3"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["chenghuang-q-280c37795269ef0349a3"]},"ordering_evidence":"chenghuang-q-280c37795269ef0349a3","source_order":[55,266,10],"order":9885}],"persons":[{"id":"gan-ning","name":"甘宁","facts":[],"aliases":[]},{"id":"ling-tong","name":"凌统","facts":[],"aliases":[]},{"id":"lu-meng","name":"吕蒙","facts":[],"aliases":[]},{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]}],"evidence":[{"id":"chenghuang-q-280c37795269ef0349a3","section":"chapter-055","block":"b-bd6ecaf4febe6b0a31d3","layer":"pei","quote":"凌统怨宁杀其父操。宁常备统，不与相见；权亦命统，不得仇之。尝于吕蒙舍会，酒酣，统乃以刀舞。宁起曰：‘宁能双戟舞。’蒙曰：‘宁虽能，未若蒙之巧也。’因操刀持盾，以身分之。后权知统意，因令宁将兵，遂徙屯于半州","attribution":"裴注·吴书","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":265,"anchor":null},"note_id":"n-e9834fb9cfdf2298c5ed","start":10,"end":112}],"profiles":{},"directory_counts":{}}
