{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"liusima-e-o018","title":"应璩致书刘靖，称其治绩","accounts":[{"id":"liusima-a-2a3c3016d7bd8309c26f","label":"正文","text":"应璩致书刘靖，称其治绩","evidence":["liusima-q-5030dfc650541494d0d8","liusima-q2-f6ba281881b29532bb5c"]}],"participants":[{"person":"liusima-p0022","role":"致书者","evidence":["liusima-q-5030dfc650541494d0d8"]},{"person":"liusima-p0009","role":"受书者","evidence":["liusima-q-5030dfc650541494d0d8"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liusima-q-5030dfc650541494d0d8"]},"ordering_evidence":"liusima-q-5030dfc650541494d0d8","source_order":[15,7,21],"order":3238}],"persons":[{"id":"liusima-p0009","name":"刘靖（刘馥子）","facts":[],"aliases":[]},{"id":"liusima-p0022","name":"应璩","facts":[],"aliases":[]}],"evidence":[{"id":"liusima-q-5030dfc650541494d0d8","section":"chapter-015","block":"b-88ded8218a019af909a9","layer":"original","quote":"散骑常侍应璩书与靖曰","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":6,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":21,"end":31,"offset_unit":"unicode_code_point"},{"id":"liusima-q2-f6ba281881b29532bb5c","section":"chapter-015","block":"b-88ded8218a019af909a9","layer":"original","quote":"转在河内。迁尚书，赐爵关内侯。出为河南尹。散骑常侍应璩书与靖曰〖6〗：“入作纳言〖7〗，出临京任〖8〗。富民之术，日引月长：藩落高峻〖9〗，绝穿窬之心；五种别出〖10〗，远水火之灾；农器必具，无失时之阙〖11〗；蚕麦有苫备之用，无雨湿之虞；封符指期〖12〗，无流连之吏；鳏寡孤独，蒙廪赈之实。加之以明擿幽微，重之以秉宪不挠〖13〗；有司供承王命，百里垂拱仰办〖14〗：虽昔赵、张、三王之治〖15〗，未足以方也！”靖为政类如此。初虽如碎密〖16〗，终于百姓便之，有馥遗风。","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":6,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":235,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
