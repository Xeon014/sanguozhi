{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p022c","title":"韩馥听刘子惠议而许袁绍起兵","accounts":[{"id":"wudi-e-p022c-account","label":"《英雄记》","text":"韩馥原派人监守袁绍，后听刘子惠议论，写信允许袁绍举兵讨董卓。","evidence":["wudi-e-p022c-q"]}],"participants":[{"person":"wudi-p0058","role":"议定放行","evidence":["wudi-e-p022c-q"]},{"person":"wudi-p0066","role":"进言","evidence":["wudi-e-p022c-q"]},{"person":"wudi-p0052","role":"获准起兵","evidence":["wudi-e-p022c-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p022c-q"]},"source_order":[1,91,"P022c"],"order":52}],"persons":[{"id":"wudi-p0052","name":"袁绍","facts":[],"aliases":[]},{"id":"wudi-p0058","name":"韩馥","facts":[],"aliases":[]},{"id":"wudi-p0066","name":"刘子惠","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-p022c-q","section":"chapter-001","block":"b-8628e740812ad3fcff78","layer":"pei","quote":"馥得移，请诸从事问曰：‘今当助袁氏邪，助董卓邪？’治中从事刘子惠曰：‘今兴兵为国，何谓袁、董！’馥自知言短，而有惭色。子惠复言：‘兵者凶事，不可为首。今宜往视他州，有发动者，然后和之。冀州于他州不为弱也，他人功未有在冀州之右者也。’馥然之。馥乃作书与绍，道卓之恶，听其举兵。","attribution":"《英雄记》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":90,"anchor":null},"note_id":"n-6e459510c0c0ec488b06","start":121,"end":258}],"profiles":{},"directory_counts":{}}
