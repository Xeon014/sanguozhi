{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xinyang-e-be2b3053c5a300d5c371","title":"列女传载姜叙母劝姜叙杨阜等讨马超后被超杀","accounts":[{"id":"xinyang-a-be2b3053c5a300d5c371","label":"裴注·皇甫谧列女传","text":"列女传载姜叙母劝姜叙杨阜等讨马超后被超杀","evidence":["xinyang-q-3e6d91bb65ad6ebd7957"]}],"participants":[{"person":"xinyang-p-12f3b806a6bdc0","role":"劝讨被杀","evidence":["xinyang-q-3e6d91bb65ad6ebd7957"]},{"person":"guanzhang-p0016","role":"举兵","evidence":["xinyang-q-3e6d91bb65ad6ebd7957"]},{"person":"mingdi-p0040","role":"结谋","evidence":["xinyang-q-3e6d91bb65ad6ebd7957"]},{"person":"guanzhang-p0017","role":"闭门","evidence":["xinyang-q-3e6d91bb65ad6ebd7957"]},{"person":"xinyang-p-750b5606035c59","role":"守祁山","evidence":["xinyang-q-3e6d91bb65ad6ebd7957"]},{"person":"wudi-p0327","role":"守祁山","evidence":["xinyang-q-3e6d91bb65ad6ebd7957"]},{"person":"wudi-p0282","role":"攻城杀人","evidence":["xinyang-q-3e6d91bb65ad6ebd7957"]},{"person":"cao-cao","role":"褒扬","evidence":["xinyang-q-3e6d91bb65ad6ebd7957"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["xinyang-q-3e6d91bb65ad6ebd7957"]},"ordering_evidence":"xinyang-q-3e6d91bb65ad6ebd7957","order":5061}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"guanzhang-p0016","name":"姜叙","facts":[],"aliases":[]},{"id":"guanzhang-p0017","name":"梁宽","facts":[],"aliases":[]},{"id":"mingdi-p0040","name":"杨阜","facts":[],"aliases":[]},{"id":"wudi-p0282","name":"马超","facts":[],"aliases":[]},{"id":"wudi-p0327","name":"尹奉","facts":[],"aliases":[]},{"id":"xinyang-p-12f3b806a6bdc0","name":"姜叙母（未具名）","facts":[],"aliases":[]},{"id":"xinyang-p-750b5606035c59","name":"赵昂","facts":[],"aliases":[]}],"evidence":[{"id":"xinyang-q-3e6d91bb65ad6ebd7957","section":"chapter-025","block":"b-fa5c21f33022af07daea","layer":"pei","quote":"﹝一﹞皇甫谧《列女传》曰：“姜叙母者，天永姜伯奕之母也。建安中，马超攻冀，害凉州刺史韦康。州人凄然，莫不感愤。叙为抚夷将军，拥兵屯历。叙姑子杨阜，故为康从事；同等十余人，皆略属超，阴相结为康报仇，未有间。会阜妻死，辞超宁归西；因过至历，候叙母，说康被害及冀中之难，相对泣良久。姜叙举室感悲，叙母曰：‘咄！伯奕，韦使君遇难，岂一州之耻，亦汝之负，岂独义山哉？汝无顾我，事淹变生。人谁不死？死国，忠义之大者！但当速发，我自为汝当之，不以余年累汝也。’因敕叙与阜参议，许诺，分人使语乡里尹奉、赵昂及安定梁宽等，令叙先举兵叛超；超怒，必自来击叙，宽等因从后闭门。约誓以定，叙遂进兵入卤，昂、奉守祁山。超闻，果自出击叙；宽等从后闭冀门。超失据，过卤，叙守卤。超因进至历，历中见超往，以为叙军还；又传闻超已走奔汉中，故历无备。及超入历，执叙母，母怒骂超。超被骂大怒，即杀叙母及其子，烧城而去。”阜等以状闻，太祖甚嘉之，手令褒扬，语如本传。臣松之按：谧称阜为“叙姑子”，而本传云叙为“阜外兄”，与今名“内外”为不同。","attribution":"裴注·皇甫谧列女传","section_title":"辛毗杨阜高堂隆传第二十五","source":{"file":"OEBPS/Text/titlepage_0056.xhtml","index":174,"anchor":null},"note_id":"n-7ab6316d3e38e1652aa4","start":0,"end":451}],"profiles":{},"directory_counts":{}}
