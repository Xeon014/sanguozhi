:null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-36d7289d4fc3e06d3183","start":0,"end":91,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o035","section":"chapter-004","block":"b-7a58be9723bf49d1ec80","layer":"original","quote":"八年春二月朔〖1〗，日有食之。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":145,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":15,"offset_unit":"unicode_code_point"},{"id":"wuzhu-e-p065a-q","section":"chapter-047","block":"b-fac2e3eecdec61e0362c","layer":"pei","quote":"﹝三﹞《江表传》曰：“是岁，权遣诸葛壹伪叛，以诱诸葛诞；诞以步骑一万，迎壹于高山。权出涂中，遂至高山，潜军以待之。诞觉而退。”","attribution":"《江表传》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":259,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-9048ea0c85ba44fb05a4","start":0,"end":63,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o151","section":"chapter-047","block":"b-58d734185bb62383e211","layer":"original","quote":"十年春正月〖12〗，右大司马全琮卒。﹝三﹞二月，权适南宫〖13〗。三月，改作太初宫〖14〗，诸将及州郡皆义作〖15〗。﹝四﹞","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":236,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":62,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
