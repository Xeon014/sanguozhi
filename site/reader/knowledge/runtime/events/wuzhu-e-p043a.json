{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wuzhu-e-p043a","title":"孙邵任孔融功曹从刘繇后仕孙权劝通贡聘历官丞相","accounts":[{"id":"wuzhu-e-p043a-account","label":"《吴录》","text":"孙邵任孔融功曹从刘繇后仕孙权劝通贡聘历官丞相","evidence":["wuzhu-e-p043a-q"]},{"id":"wuzhu-a-p043-judgment","label":"《志林》","text":"《志林》记刘声叔解释孙邵无传或因与张温不合及史家党争。","evidence":["wuzhu-q-p043-judgment"]}],"participants":[{"person":"wuzhu-p0037","role":"任职献策","evidence":["wuzhu-e-p043a-q"]},{"person":"sun-quan","role":"采纳任用","evidence":["wuzhu-e-p043a-q"]}],"place":null,"time":{"label":"孙邵历仕至卒","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["wuzhu-e-p043a-q"]},"ordering_evidence":"wuzhu-e-p043a-q","source_order":[47,385,"P043a"],"order":8264}],"persons":[{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"wuzhu-p0037","name":"孙邵","facts":[],"aliases":[]}],"evidence":[{"id":"wuzhu-e-p043a-q","section":"chapter-047","block":"b-6b2bb5d40ee64209cfad","layer":"pei","quote":"邵字长绪。北海人。长八尺。为孔融功曹，融称曰：‘廊庙才也！’从刘繇于江东。及权统事，数陈便宜；以为应纳贡聘，权即从之。拜庐江太守，迁车骑长史。黄武初，为丞相，威远将军，封阳羡侯。","attribution":"《吴录》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":384,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ca3da22a7824a5fd1e57","start":10,"end":99,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-p043-judgment","section":"chapter-047","block":"b-6b2bb5d40ee64209cfad","layer":"pei","quote":"《志林》曰：“吴之创基，邵为首相；史无其传，窃常怪之。尝问刘声叔。声叔，博物君子也，云：‘推其名位，自应立传。项竣、（吴）〔丁〕孚时，已有注记此，云“与张惠恕不能”。后韦氏作史，盖惠恕之党，故不见书。’","attribution":"《志林》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":384,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-ca3da22a7824a5fd1e57","start":127,"end":228,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
