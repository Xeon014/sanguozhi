{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o024b","title":"曹操破匡亭并追逐袁术","accounts":[{"id":"wudi-e-o024b-account","label":"正文","text":"曹操击刘详，破袁术救军，继而围封丘、追至太寿决水灌城，袁术辗转退到九江。","evidence":["wudi-e-o024b-q"]}],"participants":[{"person":"cao-cao","role":"进击追逐","evidence":["wudi-e-o024b-q"]},{"person":"wudi-p0097","role":"被击","evidence":["wudi-e-o024b-q"]},{"person":"wudi-p0057","role":"救援战败","evidence":["wudi-e-o024b-q"]}],"place":{"text":"匡亭、封丘、襄邑、太寿、宁陵、九江","evidence":["wudi-e-o024b-q"]},"time":{"label":"初平四年春","year":193,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o024b-q","wudi-q-o024","wudi-q-b-5e63888ed5d8c41275f1"],"chronology":"wudi-y193","dating_review":{"anchor":"wudi-q-o024","basis":"初平四年春","reviewed":true}},"source_order":[1,186,"O024b"],"order":90}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0057","name":"袁术","facts":[],"aliases":[]},{"id":"wudi-p0097","name":"刘详","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-o024b-q","section":"chapter-001","block":"b-c2e697c9981c6cd8d3e8","layer":"original","quote":"术使将刘详屯匡亭〖5〗。太祖击详，术救之；与战，大破之。术退保封丘，遂围之；未合，术走襄邑〖6〗。追到太寿〖7〗，决渠水灌城；走宁陵〖8〗。又追之，走九江〖9〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":185,"anchor":null},"note_id":null,"start":53,"end":134},{"id":"wudi-q-b-5e63888ed5d8c41275f1","section":"chapter-001","block":"b-5e63888ed5d8c41275f1","layer":"modern","quote":"〖1〗四年：初平四年（公元 193）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":190,"anchor":null},"note_id":"n-c3dba248d94a4751844d","start":0,"end":19},{"id":"wudi-q-o024","section":"chapter-001","block":"b-c2e697c9981c6cd8d3e8","layer":"original","quote":"四年春〖1〗，军鄄城〖2〗。荆州牧刘表断术粮道〖3〗。术引军入陈留，屯封丘〖4〗；黑山余贼及于夫罗等佐之。术使将刘详屯匡亭〖5〗。太祖击详，术救之；与战，大破之。术退保封丘，遂围之；未合，术走襄邑〖6〗。追到太寿〖7〗，决渠水灌城；走宁陵〖8〗。又追之，走九江〖9〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":185,"anchor":null},"note_id":null,"start":0,"end":134}],"profiles":{},"directory_counts":{}}
