{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dongyuan-e-o038a","title":"袁绍还延津遣高幹荀谌说韩馥让冀州韩馥从","accounts":[{"id":"dongyuan-e-o038a-account","label":"《董二袁刘传第六》正文","text":"袁绍还延津遣高幹荀谌说韩馥让冀州韩馥从","evidence":["dongyuan-e-o038a-q"]}],"participants":[{"person":"wudi-p0052","role":"遣说","evidence":["dongyuan-e-o038a-q"]},{"person":"wudi-p0235","role":"游说","evidence":["dongyuan-e-o038a-q"]},{"person":"xunyu-p0003","role":"游说","evidence":["dongyuan-e-o038a-q"]},{"person":"wudi-p0058","role":"从议","evidence":["dongyuan-e-o038a-q"]}],"place":null,"time":{"label":"董卓西入关后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-o038a-q"]},"ordering_evidence":"dongyuan-e-o038a-q","source_order":[6,232,"O038a"],"order":1630}],"persons":[{"id":"wudi-p0052","name":"袁绍","facts":[],"aliases":[]},{"id":"wudi-p0058","name":"韩馥","facts":[],"aliases":[]},{"id":"wudi-p0235","name":"高幹","facts":[],"aliases":[]},{"id":"xunyu-p0003","name":"荀谌","facts":[],"aliases":[]}],"evidence":[{"id":"dongyuan-e-o038a-q","section":"chapter-006","block":"b-7d2984aa42c7b84600cb","layer":"original","quote":"会卓西入关〖2〗，绍还军延津。因馥惶遽，使陈留高幹、颍川荀谌等说馥曰：“公孙瓒乘胜来向南，而诸郡应之。袁车骑引军东向〖3〗，此其意不可知。窃为将军危之！”馥曰：“为之奈何？”谌曰：“公孙提燕、代之卒，其锋不可当。袁氏一时之杰，必不为将军下。夫冀州，天下之重资也〖4〗。若两雄并力，兵交于城下，危亡可立而待也！夫袁氏，将军之旧〖5〗，且同盟也。当今为将军计，莫若举冀州以让袁氏。袁氏得冀州，则瓒不能与之争，必厚德将军〖6〗。冀州入于亲交，是将军有让贤之名，而身安于泰山也。愿将军勿疑！”馥素恇怯〖7〗，因然其计。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":231,"anchor":null},"note_id":null,"start":0,"end":255}],"profiles":{},"directory_counts":{}}
