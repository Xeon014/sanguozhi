{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o025b","title":"阙宣称帝与陶谦进兵","accounts":[{"id":"wudi-e-o025b-account","label":"正文","text":"阙宣聚众称天子，陶谦与其共同举兵，取华、费并侵掠任城。","evidence":["wudi-e-o025b-q"]},{"id":"gongsuntao-a-b8e1ba3d86a4f3cd85ca","label":"正文","text":"阙宣自称天子谦初与合从寇抄","evidence":["gongsuntao-q-1e3ff7dd84d266c69b1b"]}],"participants":[{"person":"wudi-p0098","role":"称帝举兵","evidence":["wudi-e-o025b-q"]},{"person":"wudi-p0095","role":"共同举兵","evidence":["wudi-e-o025b-q"]}],"place":{"text":"下邳、华、费、任城","evidence":["wudi-e-o025b-q"]},"time":{"label":"初平四年夏","year":193,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o025b-q","wudi-q-o024","wudi-q-b-5e63888ed5d8c41275f1"],"chronology":"wudi-y193","dating_review":{"anchor":"wudi-q-o024","basis":"初平四年夏","reviewed":true}},"source_order":[1,187,"O025b"],"order":92}],"persons":[{"id":"wudi-p0095","name":"陶谦","facts":[],"aliases":[]},{"id":"wudi-p0098","name":"阙宣","facts":[],"aliases":[]}],"evidence":[{"id":"gongsuntao-q-1e3ff7dd84d266c69b1b","section":"chapter-008","block":"b-5cce4a366696ef346ff4","layer":"original","quote":"下邳阙宣自称天子；谦初与合从寇抄","section_title":"二公孙陶四张传第八","source":{"file":"OEBPS/Text/titlepage_0021.xhtml","index":124,"anchor":null},"note_id":null,"start":0,"end":16},{"id":"wudi-e-o025b-q","section":"chapter-001","block":"b-e96c1359a215f75e34b9","layer":"original","quote":"下邳阙宣聚众数千人，自称天子。徐州牧陶谦与共举兵，取泰山华、费〖11〗，略任城〖12〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":186,"anchor":null},"note_id":null,"start":13,"end":57},{"id":"wudi-q-b-5e63888ed5d8c41275f1","section":"chapter-001","block":"b-5e63888ed5d8c41275f1","layer":"modern","quote":"〖1〗四年：初平四年（公元 193）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":190,"anchor":null},"note_id":"n-c3dba248d94a4751844d","start":0,"end":19},{"id":"wudi-q-o024","section":"chapter-001","block":"b-c2e697c9981c6cd8d3e8","layer":"original","quote":"四年春〖1〗，军鄄城〖2〗。荆州牧刘表断术粮道〖3〗。术引军入陈留，屯封丘〖4〗；黑山余贼及于夫罗等佐之。术使将刘详屯匡亭〖5〗。太祖击详，术救之；与战，大破之。术退保封丘，遂围之；未合，术走襄邑〖6〗。追到太寿〖7〗，决渠水灌城；走宁陵〖8〗。又追之，走九江〖9〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":185,"anchor":null},"note_id":null,"start":0,"end":134}],"profiles":{},"directory_counts":{}}
