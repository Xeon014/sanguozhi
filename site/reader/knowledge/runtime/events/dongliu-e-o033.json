{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dongliu-e-o033","title":"马良自草使吴文书","accounts":[{"id":"dongliu-a-a88f2a01a63a809dabc8","label":"正文","text":"马良自草使吴文书","evidence":["dongliu-q-a5a7e79329b0d387d618","dongliu-q2-e38d1eaf62294955b45f"]}],"participants":[{"person":"xianzhu-p0121","role":"依诸葛亮言自为使吴国书之草","evidence":["dongliu-q-a5a7e79329b0d387d618"]},{"person":"sun-quan","role":"国书所致之吴主","evidence":["dongliu-q-a5a7e79329b0d387d618"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["dongliu-q-a5a7e79329b0d387d618"]},"ordering_evidence":"dongliu-q-a5a7e79329b0d387d618","source_order":[39,67,64],"order":7173}],"persons":[{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"xianzhu-p0121","name":"马良","facts":[],"aliases":[]}],"evidence":[{"id":"dongliu-q-a5a7e79329b0d387d618","section":"chapter-039","block":"b-4686344692214a1f3293","layer":"original","quote":"良即为草曰","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":66,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":64,"end":69,"offset_unit":"unicode_code_point"},{"id":"dongliu-q2-e38d1eaf62294955b45f","section":"chapter-039","block":"b-4686344692214a1f3293","layer":"original","quote":"先主辟良为左将军掾。后遣使吴，良谓亮曰：“今衔国命〖18〗，协穆二家〖19〗；幸为良介于孙将军〖20〗。”亮曰：“君试自为文。”良即为草曰：“寡君遣掾马良〖21〗，通聘继好，以绍昆吾、豕韦之勋〖22〗。其人吉士〖23〗，荆楚之令〖24〗；鲜于造次之华〖25〗，而有克终之美〖26〗。愿降心存纳〖27〗，以慰将命。”权敬待之。","section_title":"董刘马陈董吕传第九","source":{"file":"OEBPS/Text/titlepage_0084.xhtml","index":66,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":162,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
