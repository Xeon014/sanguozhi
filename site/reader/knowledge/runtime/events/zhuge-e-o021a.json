{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhuge-e-o021a","title":"刘备永安托孤诸葛亮诏刘禅事丞相如父","accounts":[{"id":"zhuge-e-o021a-account","label":"《诸葛亮传第五》正文","text":"刘备永安托孤诸葛亮诏刘禅事丞相如父","evidence":["zhuge-e-o021a-q"]},{"id":"zhuge-a-p020-judgment","label":"孙盛论","text":"孙盛批评刘备可自取之言会开启异心，认为不合托孤话言之义。","evidence":["zhuge-q-p020-judgment"]}],"participants":[{"person":"liu-bei","role":"托孤","evidence":["zhuge-e-o021a-q"]},{"person":"zhuge-liang","role":"受托","evidence":["zhuge-e-o021a-q"]},{"person":"xianzhu-p0112","role":"受诏","evidence":["zhuge-e-o021a-q"]}],"place":null,"time":{"year":223,"label":"章武三年春","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"zhuge-y223","dating_review":{"reviewed":true,"anchor":"zhuge-q-o021","basis":"章武三年春"},"evidence":["zhuge-e-o021a-q","zhuge-q-o021","wendi-q-o038","wendi-q-b-94d58550e3abb558ad13"]},"ordering_evidence":"zhuge-e-o021a-q","source_order":[35,132,"O021a"],"order":6779}],"persons":[{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"xianzhu-p0112","name":"刘禅","facts":[],"aliases":[]},{"id":"zhuge-liang","name":"诸葛亮","facts":[],"aliases":[]}],"evidence":[{"id":"wendi-q-b-94d58550e3abb558ad13","section":"chapter-002","block":"b-94d58550e3abb558ad13","layer":"modern","quote":"〖1〗四年：黄初四年（公元 223）。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":394,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-2950ca88709b8c25fb44","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wendi-q-o038","section":"chapter-002","block":"b-62c39b4b73d5f8874468","layer":"original","quote":"四年春正月〖1〗，诏曰：“丧乱以来，兵革未戢〖2〗。天下之人，互相残杀。今海内初定，敢有私复仇者，皆族之〖3〗！”筑南巡台于宛。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":391,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":64,"offset_unit":"unicode_code_point"},{"id":"zhuge-e-o021a-q","section":"chapter-035","block":"b-6f9ad1f5d575a9d3f55f","layer":"original","quote":"章武三年春，先主于永安病笃〖1〗；召亮于成都，属以后事。谓亮曰：“君才十倍曹丕，必能安国，终定大事。若嗣子可辅，辅之；如其不才〖2〗，君可自取〖3〗。”亮涕泣曰：“臣敢竭股肱之力〖4〗，效忠贞之节，继之以死！”先主又为诏敕后主曰：“汝与丞相从事〖5〗，事之如父。”﹝一﹞","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":131,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":135,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-o021","section":"chapter-035","block":"b-6f9ad1f5d575a9d3f55f","layer":"original","quote":"章武三年春，先主于永安病笃〖1〗；召亮于成都，属以后事。谓亮曰：“君才十倍曹丕，必能安国，终定大事。若嗣子可辅，辅之；如其不才〖2〗，君可自取〖3〗。”亮涕泣曰：“臣敢竭股肱之力〖4〗，效忠贞之节，继之以死！”先主又为诏敕后主曰：“汝与丞相从事〖5〗，事之如父。”﹝一﹞","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":131,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":135,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-p020-judgment","section":"chapter-035","block":"b-0aef5323812fc8da8864","layer":"pei","quote":"﹝一﹞孙盛曰：“夫杖道扶义，体存信顺，然后能匡主济功，终定大业。语曰‘弈者举棋不定，犹不胜其偶’，况量君之才否而二三其节，可以摧服强邻囊括四海者乎？备之命亮，乱孰甚焉！世或有谓备欲以固委付之诚，且以一蜀人之志。君子曰：‘不然！苟所寄忠贤，则不须若斯之诲；如非其人，不宜启篡逆之途。’是以古之顾命，必贻话言：诡伪之辞，非托孤之谓。幸值刘禅暗弱，无猜险之性；诸葛威略，足以检卫异端。故使异同之心，无由自起耳。不然，殆生疑隙不逞之衅。谓之为权，不亦惑哉！”","attribution":"孙盛论","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":148,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-6f03cda0d27badf42e81","start":0,"end":225,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
