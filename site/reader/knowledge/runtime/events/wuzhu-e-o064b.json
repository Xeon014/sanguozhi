6":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":29,"end":44,"offset_unit":"unicode_code_point"},{"id":"wendi-q-b-94d58550e3abb558ad13","section":"chapter-002","block":"b-94d58550e3abb558ad13","layer":"modern","quote":"〖1〗四年：黄初四年（公元 223）。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":394,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-2950ca88709b8c25fb44","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wendi-q-o038","section":"chapter-002","block":"b-62c39b4b73d5f8874468","layer":"original","quote":"四年春正月〖1〗，诏曰：“丧乱以来，兵革未戢〖2〗。天下之人，互相残杀。今海内初定，敢有私复仇者，皆族之〖3〗！”筑南巡台于宛。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":391,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":64,"offset_unit":"unicode_code_point"},{"id":"wuzhu-e-o064b-q","section":"chapter-047","block":"b-744efca71aedfb9d521d","layer":"original","quote":"先是，戏口守将晋宗，杀将王直，以众叛如魏；魏以为蕲春太守，数犯边境。六月，权令将军贺齐，督麋芳、刘邵等，袭蕲春；邵等生虏宗。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":355,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":42,"end":104,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-o063","section":"chapter-047","block":"b-81e074e42b79f01d129f","layer":"original","quote":"二年春正月〖1〗，曹真分军据江陵中州〖2〗。是月，城江夏山〖3〗。改《四分》〖4〗，用《乾象历》〖5〗。﹝一﹞三月，曹仁遣将军常雕等，以兵五千，乘油船〖6〗，晨渡濡须中州；仁子泰，因引军急攻朱桓，桓兵拒之；遣将军严圭等击破雕等。是月，魏军皆退。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":354,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":122,"offset_unit":"unicode_code_point"},{"id":"zhuge-q-o021","section":"chapter-035","block":"b-6f9ad1f5d575a9d3f55f","layer":"original","quote":"章武三年春，先主于永安病笃〖1〗；召亮于成都，属以后事。谓亮曰：“君才十倍曹丕，必能安国，终定大事。若嗣子可辅，辅之；如其不才〖2〗，君可自取〖3〗。”亮涕泣曰：“臣敢竭股肱之力〖4〗，效忠贞之节，继之以死！”先主又为诏敕后主曰：“汝与丞相从事〖5〗，事之如父。”﹝一﹞","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":131,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":135,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
