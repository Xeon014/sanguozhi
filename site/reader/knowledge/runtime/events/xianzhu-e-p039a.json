{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-p039a","title":"赵戬拒董卓任用私党","accounts":[{"id":"xianzhu-e-p039a-account","label":"《典略》","text":"赵戬任尚书选部郎，拒绝董卓以私人充台阁，面对杀威仍陈说是非，使董卓谢过，后迁平陵令。","evidence":["xianzhu-e-p039a-q"]}],"participants":[{"person":"xianzhu-p0067","role":"拒私荐","evidence":["xianzhu-e-p039a-q"]},{"person":"wudi-p0053","role":"怒而后谢","evidence":["xianzhu-e-p039a-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xianzhu-e-p039a-q"]},"source_order":[32,199,"P039a"],"order":6569}],"persons":[{"id":"wudi-p0053","name":"董卓","facts":[],"aliases":[]},{"id":"xianzhu-p0067","name":"赵戬","facts":[],"aliases":[]}],"evidence":[{"id":"xianzhu-e-p039a-q","section":"chapter-032","block":"b-41aefcb279e2501eff36","layer":"pei","quote":"辟公府，入为尚书选部郎。董卓欲以所私，并充台阁，戬拒不听。卓怒，召戬欲杀之；观者皆为戬惧，而戬自若。及见卓，引辞正色，陈说是非；卓虽凶戾，屈而谢之。迁平陵令。","attribution":"《典略》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":198,"anchor":null},"note_id":"n-b5ff5b5f2ba2531e20bb","start":207,"end":286}],"profiles":{},"directory_counts":{}}
