{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p086b","title":"梁鹄窃取师宜官书札学书","accounts":[{"id":"wudi-e-p086b-account","label":"卫恒《四体书势序》","text":"师宜官书后常毁札，梁鹄供书版并请其饮酒，趁醉取札，后来以书艺任选部尚书。","evidence":["wudi-e-p086b-q"]}],"participants":[{"person":"wudi-p0258","role":"学书受官","evidence":["wudi-e-p086b-q"]},{"person":"wudi-p0257","role":"书札被取","evidence":["wudi-e-p086b-q"]}],"place":null,"time":{"label":"灵帝好书的叙事背景","precision":"undated","basis":"保留本条时间表达，不据所在段落机械补定年份。","evidence":["wudi-e-p086b-q"]},"source_order":[1,688,"P086b"],"order":281}],"persons":[{"id":"wudi-p0257","name":"师宜官","facts":[],"aliases":[]},{"id":"wudi-p0258","name":"梁鹄","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-p086b-q","section":"chapter-001","block":"b-648d7c68dbec5a605916","layer":"pei","quote":"至灵帝好书，世多能者，而师宜官为最。甚矜其能，每书，辄削焚其札。梁鹄乃益为版而饮之酒，候其醉而窃其札。鹄卒以攻书至选部尚书。","attribution":"卫恒《四体书势序》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":12,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cf8a0075075368325cde","start":30,"end":92,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
