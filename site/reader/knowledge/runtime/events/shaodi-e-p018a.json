{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"shaodi-e-p018a","title":"郭修谋刺刘禅未成","accounts":[{"id":"shaodi-e-p018a-account","label":"《魏氏春秋》","text":"魏氏春秋称郭修在蜀受官后欲刺刘禅，被左右所遏，事不克；不将刘禅列为实施谋议者。","evidence":["shaodi-e-p018a-q"]}],"participants":[{"person":"shaodi-p0049","role":"谋刺","evidence":["shaodi-e-p018a-q"]}],"place":null,"time":{"label":"被掳入蜀后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["shaodi-e-p018a-q"]},"ordering_evidence":"shaodi-e-p018a-q","source_order":[4,265,"P018a"],"order":1106}],"persons":[{"id":"shaodi-p0049","name":"郭修","facts":[],"aliases":[]}],"evidence":[{"id":"shaodi-e-p018a-q","section":"chapter-004","block":"b-5c35212fabc5cc58302f","layer":"pei","quote":"﹝三﹞《魏氏春秋》曰：“修字孝先。素有业行，著名西州。姜维劫之，修不为屈。刘禅以为左将军，修欲刺禅而不得亲近。每因庆贺，且拜且前；为禅左右所遏，事辄不克，故杀祎焉。”","attribution":"《魏氏春秋》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":264,"anchor":null},"note_id":"n-8cc9180077c660fd8f82","start":0,"end":83}],"profiles":{},"directory_counts":{}}
