{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o065a","title":"袁绍兼四州准备攻许","accounts":[{"id":"wudi-e-o065a-account","label":"正文","text":"袁绍吞并公孙瓒、据四州后拟进攻许，曹操向诸将分析袁绍军政弱点。","evidence":["wudi-e-o065a-q"]},{"id":"dongyuan-e-o044c-account","label":"《董二袁刘传第六》正文","text":"袁绍以审配逢纪统军田丰等谋主颜良文丑将率备攻许","evidence":["dongyuan-e-o044c-q"]},{"id":"dongyuan-a-p076-judgment","label":"孙盛评","text":"孙盛据冀州户籍推论袁绍南征兵数，认为十万较接近；不把推数改成确定实数。","evidence":["dongyuan-q-p076-judgment"]}],"participants":[{"person":"wudi-p0052","role":"并州拟攻","evidence":["wudi-e-o065a-q"]},{"person":"wudi-p0093","role":"被吞并","evidence":["wudi-e-o065a-q"]},{"person":"cao-cao","role":"评敌备战","evidence":["wudi-e-o065a-q"]},{"person":"wudi-p0208","role":"统军事","evidence":["dongyuan-e-o044c-q"]},{"person":"xunyu-p0033","role":"统军事","evidence":["dongyuan-e-o044c-q"]},{"person":"wudi-p0139","role":"谋主","evidence":["dongyuan-e-o044c-q"]},{"person":"xunyu-p0003","role":"谋主","evidence":["dongyuan-e-o044c-q"]},{"person":"wudi-p0038","role":"谋主","evidence":["dongyuan-e-o044c-q"]},{"person":"wudi-p0176","role":"将率","evidence":["dongyuan-e-o044c-q"]},{"person":"wudi-p0179","role":"将率","evidence":["dongyuan-e-o044c-q"]}],"place":{"text":"许","evidence":["wudi-e-o065a-q"]},"time":{"label":"建安四年","year":199,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o065a-q","wudi-q-o061","wudi-q-b-51bced16741add42ff70"],"chronology":"wudi-y199","dating_review":{"anchor":"wudi-q-o061","basis":"建安四年","reviewed":true}},"source_order":[1,363,"O065a"],"order":162}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0038","name":"许攸","facts":[],"aliases":[]},{"id":"wudi-p0052","name":"袁绍","facts":[],"aliases":[]},{"id":"wudi-p0093","name":"公孙瓒","facts":[],"aliases":[]},{"id":"wudi-p0139","name":"田丰","facts":[],"aliases":[]},{"id":"wudi-p0176","name":"颜良","facts":[],"aliases":[]},{"id":"wudi-p0179","name":"文丑","facts":[],"aliases":[]},{"id":"wudi-p0208","name":"审配","facts":[],"aliases":[]},{"id":"xunyu-p0003","name":"荀谌","facts":[],"aliases":[]},{"id":"xunyu-p0033","name":"逢纪","facts":[],"aliases":[]}],"evidence":[{"id":"dongyuan-e-o044c-q","section":"chapter-006","block":"b-9378127fbfcbf250d81d","layer":"original","quote":"众数十万。以审配、逢纪统军事〖5〗；田丰、荀谌、许攸为谋主〖6〗；颜良、文丑为将率；简精卒十万〖7〗，骑万匹，将攻许。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":278,"anchor":null},"note_id":null,"start":78,"end":137},{"id":"dongyuan-q-p076-judgment","section":"chapter-006","block":"b-db94f2025a3cc6337b58","layer":"pei","quote":"孙盛评曰：“按魏武谓崔琰曰‘昨案贵州户籍，可得三十万众’。由此推之，但冀州胜兵已如此；况兼幽、并及青州乎？绍之大举，必悉师而起：十万近之矣。","attribution":"孙盛评","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":294,"anchor":null},"note_id":"n-f9b297d2a3b3d9e09127","start":21,"end":91},{"id":"wudi-e-o065a-q","section":"chapter-001","block":"b-58c959449a0f1f33e31e","layer":"original","quote":"是时，袁绍既并公孙瓒〖13〗，兼四州之地〖14〗，众十余万，将进军攻许。诸将以为不可敌。公曰：“吾知绍之为人：志大而智小；色厉而胆薄〖15〗；忌克而少威〖16〗；兵多而分画不明〖17〗；将骄而政令不一。土地虽广，粮食虽丰，适足以为吾奉也〖18〗！”","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":362,"anchor":null},"note_id":null,"start":0,"end":124},{"id":"wudi-q-b-51bced16741add42ff70","section":"chapter-001","block":"b-51bced16741add42ff70","layer":"modern","quote":"〖1〗四年：建安四年（公元 199）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":369,"anchor":null},"note_id":"n-20628d34a709162c77f0","start":0,"end":19},{"id":"wudi-q-o061","section":"chapter-001","block":"b-502d4e8c0ed143eaa30d","layer":"original","quote":"四年春二月〖1〗，公还至昌邑〖2〗。张杨将杨丑杀杨〖3〗。眭固又杀丑，以其众属袁绍，屯射犬〖4〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":358,"anchor":null},"note_id":null,"start":0,"end":49}],"profiles":{},"directory_counts":{}}
