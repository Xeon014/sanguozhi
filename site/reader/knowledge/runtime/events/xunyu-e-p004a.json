{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xunyu-e-p004a","title":"典略记唐衡女嫁荀彧及荀绲慕势说","accounts":[{"id":"xunyu-e-p004a-account","label":"《典略》","text":"典略记唐衡女嫁荀彧及荀绲慕势说","evidence":["xunyu-e-p004a-q"]},{"id":"xunyu-a-p005-judgment","label":"裴松之按","text":"裴松之据唐衡去世时荀彧尚幼，认为婚时唐衡已死，慕势说不然。","evidence":["xunyu-q-p005-judgment"]},{"id":"xunyu-a-p006-judgment","label":"裴松之论","text":"裴松之又以宦官威权推论荀绲或受逼迫，反对以婚事伤其清操。","evidence":["xunyu-q-p006-judgment"]}],"participants":[{"person":"xunyu-p0017","role":"议婚","evidence":["xunyu-e-p004a-q"]},{"person":"zhouyu-p0012","role":"结婚","evidence":["xunyu-e-p004a-q"]},{"person":"wudi-p0100","role":"成婚","evidence":["xunyu-e-p004a-q"]}],"place":null,"time":{"label":"荀彧成婚时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["xunyu-e-p004a-q"]},"ordering_evidence":"xunyu-e-p004a-q","source_order":[10,20,"P004a"],"order":2393}],"persons":[{"id":"wudi-p0100","name":"荀彧","facts":[],"aliases":[]},{"id":"xunyu-p0017","name":"唐衡","facts":[],"aliases":[]},{"id":"zhouyu-p0012","name":"荀绲","facts":[],"aliases":[]}],"evidence":[{"id":"xunyu-e-p004a-q","section":"chapter-010","block":"b-52c69f6bca4740f3744f","layer":"pei","quote":"﹝二﹞《典略》曰：“中常侍唐衡，欲以女妻汝南傅公明；公明不娶，转以与彧。父绲慕衡势，为彧娶之。彧为论者所讥。”","attribution":"《典略》","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":19,"anchor":null},"note_id":"n-a2a81df5b8cc852cc823","start":0,"end":55},{"id":"xunyu-q-p005-judgment","section":"chapter-010","block":"b-804a2fb917c5799b1678","layer":"pei","quote":"臣松之按：《汉纪》云“唐衡以桓帝延熹七年死”，计彧于时年始二岁；则彧婚之日，衡之没久矣。慕势之言为不然也。","attribution":"裴松之按","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":20,"anchor":null},"note_id":"n-a2a81df5b8cc852cc823","start":0,"end":53},{"id":"xunyu-q-p006-judgment","section":"chapter-010","block":"b-daab014fd82307701cd6","layer":"pei","quote":"臣松之又以为：绲，“八龙”之一，必非苟得者也；将有逼而然，何云慕势哉？昔郑忽以违齐致讥，隽生以拒霍见美；致讥在于失援，见美嘉其虑远；并无交至之害，故得各全其志耳。至于阉竖用事，四海屏气；左悺、唐衡，杀生在口。故于时谚云“左回天，唐独坐”，言威权莫二也。顺之则六亲以安，忤违则大祸立至；斯诚以存易亡，蒙耻期全之日。昔蒋诩姻于王氏，无损清高之操；绲之此婚，庸何伤乎？","attribution":"裴松之论","section_title":"荀彧荀攸贾诩传第十","source":{"file":"OEBPS/Text/titlepage_0025.xhtml","index":21,"anchor":null},"note_id":"n-a2a81df5b8cc852cc823","start":0,"end":181}],"profiles":{},"directory_counts":{}}
