{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wgc-e-4-e22","title":"艾本营将士追出槛车迎还","order":5688,"accounts":[{"id":"wgc-a-4-e22","label":"正文","text":"艾本营将士追出槛车迎还","evidence":["wgc-q0400","wgc-q0057"]}],"participants":[{"person":"shaodi-p0080","role":"被本营将士迎还","evidence":["wgc-q0400","wgc-q0057"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0400","wgc-q0057"]},"ordering_evidence":"wgc-q0400"}],"persons":[{"id":"shaodi-p0080","name":"邓艾","facts":[],"aliases":[]}],"evidence":[{"id":"wgc-q0057","section":"chapter-028","block":"b-2e26eca35db56085032f","layer":"original","quote":"艾父子既囚，钟会至成都；先送艾，然后作乱。会已死，艾本营将士追出艾槛车，迎还。瓘遣田续等讨艾，遇于绵竹西；斩之，子忠与艾俱死。余子在洛阳者悉诛，徙艾妻（子）及孙于西（域）〔城〕〖1〗。﹝一﹞","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":388,"anchor":null},"note_id":null,"start":0,"end":95},{"id":"wgc-q0400","section":"chapter-028","block":"b-2e26eca35db56085032f","layer":"original","quote":"会已死，艾本营将士追出艾槛车，迎还","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":388,"anchor":null},"note_id":null,"start":21,"end":38}],"profiles":{},"directory_counts":{}}
