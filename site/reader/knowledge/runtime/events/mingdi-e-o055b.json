{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"mingdi-e-o055b","title":"朱然围江夏胡质击退","accounts":[{"id":"mingdi-e-o055b-account","label":"《明帝纪》正文","text":"朱然围江夏胡质击退","evidence":["mingdi-e-o055b-q"]}],"participants":[{"person":"sun-quan","role":"遣军","evidence":["mingdi-e-o055b-q"]},{"person":"mingdi-p0046","role":"进攻退走","evidence":["mingdi-e-o055b-q"]},{"person":"mingdi-p0047","role":"击退","evidence":["mingdi-e-o055b-q"]}],"place":null,"time":{"year":237,"label":"景初元年秋七月","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"mingdi-y237","dating_review":{"reviewed":true,"anchor":"mingdi-q-o052","basis":"景初元年秋七月"},"evidence":["mingdi-e-o055b-q","mingdi-q-o052","mingdi-q-o059","mingdi-q-b-78ee587f18f11aa30bd9"]},"ordering_evidence":"mingdi-e-o055b-q","source_order":[3,398,"O055b"],"order":917}],"persons":[{"id":"mingdi-p0046","name":"朱然","facts":[],"aliases":[]},{"id":"mingdi-p0047","name":"胡质","facts":[],"aliases":[]},{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]}],"evidence":[{"id":"mingdi-e-o055b-q","section":"chapter-003","block":"b-955a979a396107f90820","layer":"original","quote":"秋七月，丁卯〖1〗，司徒陈矫薨。孙权遣将朱然等二万人，围江夏郡〖2〗；荆州刺史胡质等击之〖3〗，然退走。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":397,"anchor":null},"note_id":null,"start":0,"end":52},{"id":"mingdi-q-b-78ee587f18f11aa30bd9","section":"chapter-003","block":"b-78ee587f18f11aa30bd9","layer":"modern","quote":"〖1〗二年：景初二年（公元 238 ）。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":438,"anchor":null},"note_id":"n-917b5dc4aecce5a0dcf4","start":0,"end":20},{"id":"mingdi-q-o052","section":"chapter-003","block":"b-26b7ecd6c3ecce777040","layer":"original","quote":"景初元年春（正）〔二〕月，壬辰〖1〗，山茌县言黄龙现〖2〗。﹝一﹞于是有司奏，以为魏得地统〖3〗，宜以建丑之月为正〖4〗。三月，定历改年为孟夏四月；﹝二﹞服色尚黄〖5〗；牺牲用白〖6〗；戎事乘黑首白马〖7〗，建大赤之旂〖8〗；朝会，建大白之旗。﹝三﹞改太和历曰景初历〖9〗：其春夏秋冬孟仲季月，虽与正岁不同〖10〗，至于郊祀、迎气、礿祠、蒸尝、巡狩、蒐田、分至启闭、班宣时令、中气早晚、敬授民事〖11〗，皆以正岁斗建为历数之序〖12〗。","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":363,"anchor":null},"note_id":null,"start":0,"end":218},{"id":"mingdi-q-o059","section":"chapter-003","block":"b-5790b2efe14805978c50","layer":"original","quote":"二年春正月〖1〗，诏太尉司马宣王。率众讨辽东。﹝一﹞","section_title":"明帝纪第三","source":{"file":"OEBPS/Text/titlepage_0011.xhtml","index":434,"anchor":null},"note_id":null,"start":0,"end":26}],"profiles":{},"directory_counts":{}}
