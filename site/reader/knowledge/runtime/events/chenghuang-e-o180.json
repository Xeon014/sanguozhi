{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"chenghuang-e-o180","title":"苏飞置酒劝宁白为邾长招怀亡客","accounts":[{"id":"chenghuang-a-44b6ec5bffcbce2fc50e","label":"裴注·吴书","text":"苏飞置酒劝宁白为邾长招怀亡客","evidence":["chenghuang-q-e9c20b259489df9848ba"]}],"participants":[{"person":"chenghuang-p0016","role":"知其意、邀宁为之置酒、谓曰吾荐子者数矣主不能用日月逾迈人生几何宜自远图庶遇知己、欲白子为邾长于是去就孰与临版转丸乎、白祖听宁之县","evidence":["chenghuang-q-e9c20b259489df9848ba"]},{"person":"gan-ning","role":"良久乃曰虽有其志未知所由、曰幸甚、之县招怀亡客并义从者得数百人","evidence":["chenghuang-q-e9c20b259489df9848ba"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["chenghuang-q-e9c20b259489df9848ba"]},"ordering_evidence":"chenghuang-q-e9c20b259489df9848ba","source_order":[55,208,179],"order":9869}],"persons":[{"id":"chenghuang-p0016","name":"苏飞","facts":[],"aliases":[]},{"id":"gan-ning","name":"甘宁","facts":[],"aliases":[]}],"evidence":[{"id":"chenghuang-q-e9c20b259489df9848ba","section":"chapter-055","block":"b-49b0f5118da5406c8c09","layer":"pei","quote":"飞知其意，乃邀宁，为之置酒。谓曰：‘吾荐子者数矣！主不能用。日月逾迈，人生几何？宜自远图，庶遇知己。’宁良久乃曰：‘虽有其志，未知所由。’飞曰：‘吾欲白子为邾长：于是去就，孰与临版转丸乎？’宁曰：‘幸甚！’飞白祖，听宁之县。招怀亡客并义从者，得数百人","attribution":"裴注·吴书","section_title":"程黄韩蒋周陈董甘凌徐潘丁传第十","source":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":207,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4cdec240085a4d591c10","start":179,"end":304,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
