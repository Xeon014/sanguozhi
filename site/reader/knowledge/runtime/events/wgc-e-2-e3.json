ordering_evidence":"xuhuwang-q-0a36f993281a315758d8","related_events":[{"event":"wgc-e-2-e3","type":"related","evidence":["xuhuwang-q-0a36f993281a315758d8","xuhuwang-q-6ba1d4f27600ec5d9bfd","wgc-q0281","wgc-q0028"]}],"order":5397}],"persons":[{"id":"shaodi-p0034","name":"王基","facts":[],"aliases":[]},{"id":"shaodi-p0044","name":"诸葛诞","facts":[],"aliases":[]},{"id":"shaodi-p0045","name":"司马昭","facts":[],"aliases":[]},{"id":"shaodi-p0107","name":"陈骞","facts":[],"aliases":[]}],"evidence":[{"id":"huanchen-q-a43d399dccbc32a4b144","section":"chapter-022","block":"b-cc10d81a0825ac1ea7dc","layer":"original","quote":"诸葛诞作乱寿春〖13〗，司马文王率六军军丘头〖14〗","section_title":"桓二陈徐卫卢传第二十二","source":{"file":"OEBPS/Text/titlepage_0050.xhtml","index":283,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":65,"end":91,"offset_unit":"unicode_code_point"},{"id":"wgc-q0028","section":"chapter-028","block":"b-c135ec113c597ad4f2da","layer":"original","quote":"六月，车驾东征，至项。大将军司马文王督中外诸军二十六万众，临淮讨之。大将军屯丘头，使基及安东将军陈骞等四面合围，表里再重〖9〗，堑垒甚峻。又使监军石苞、兖州刺史州泰等〖10〗，简锐卒为游军〖11〗，备外寇。钦等数出犯围〖12〗，逆击走之。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":175,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":119,"offset_unit":"unicode_code_point"},{"id":"wgc-q0281","section":"chapter-028","block":"b-c135ec113c597ad4f2da","layer":"original","quote":"大将军屯丘头，使基及安东将军陈骞等四面合围，表里再重〖9〗，堑垒甚峻","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":175,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":34,"end":68,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-0a36f993281a315758d8","section":"chapter-027","block":"b-71ebf1201b1cb1b1419e","layer":"original","quote":"时大军在项，以贼兵精，诏基敛军坚垒。基累启求进讨。会吴遣朱异来救诞〖1〗，军于安城〖2〗。基又被诏引诸军转据北山〖3〗。基谓诸将曰：“今围垒转固，兵马向集，但当精修守备以待越逸；而更移兵守险，使得放纵：虽有智者不能善〔其〕后矣。”遂守便宜上疏曰〖4〗：“今与贼家对敌，当不动如山。若迁移依险，人心摇荡，于势大损。诸军并据深沟高垒，众心皆定，不可倾动。此御兵之要也。”书奏，报听。大将军司马文王进屯丘头，分部围守，各有所统；基督城东、城南二十六军。文王敕军吏：“入镇南部界〖5〗，一不得有所遣〖6〗。”城中食尽，昼夜攻垒；基辄拒击，破之。","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":336,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":24,"end":292,"offset_unit":"unicode_code_point"},{"id":"xuhuwang-q-6ba1d4f27600ec5d9bfd","section":"chapter-027","block":"b-4abb07ca0728157daafa","layer":"original","quote":"寿春既拔，文王与基书曰：“初议者云云，求移者甚众；时未临履〖7〗，亦谓宜然。将军深算利害，独秉固志；上违诏命，下拒众议，终至制敌擒贼：虽古人所述，不是过也。”","section_title":"徐胡二王传第二十七","source":{"file":"OEBPS/Text/titlepage_0060.xhtml","index":337,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":79,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
