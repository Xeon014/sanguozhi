{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"panlu-e-o012","title":"谢厷说吕壹惧解散顾雍事","accounts":[{"id":"panlu-a-0815ccfb9dc9491831a8","label":"正文","text":"谢厷说吕壹惧解散顾雍事","evidence":["panlu-q-bef1c618302df19e00ed"]}],"participants":[{"person":"luxun-p0040","role":"黄门侍郎、问壹顾公事何如、问若此公免退谁当代之、曰得无潘太常得之乎、谓曰潘太常常切齿于君今日代顾公恐明日便击君矣","evidence":["panlu-q-bef1c618302df19e00ed"]},{"person":"wuzhu-p0094","role":"答不能佳、良久曰君语近之也、大惧、遂解散雍事","evidence":["panlu-q-bef1c618302df19e00ed"]},{"person":"wuzhu-p0065","role":"被言切齿于壹者","evidence":["panlu-q-bef1c618302df19e00ed"]},{"person":"wuzhu-p0045","role":"其事遂解","evidence":["panlu-q-bef1c618302df19e00ed"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["panlu-q-bef1c618302df19e00ed"]},"ordering_evidence":"panlu-q-bef1c618302df19e00ed","source_order":[61,27,33],"order":10724}],"persons":[{"id":"luxun-p0040","name":"谢厷","facts":[],"aliases":[]},{"id":"wuzhu-p0045","name":"顾雍","facts":[],"aliases":[]},{"id":"wuzhu-p0065","name":"潘濬","facts":[],"aliases":[]},{"id":"wuzhu-p0094","name":"吕壹","facts":[],"aliases":[]}],"evidence":[{"id":"panlu-q-bef1c618302df19e00ed","section":"chapter-061","block":"b-55337a59319992546fa6","layer":"original","quote":"黄门侍郎谢厷，语次问壹〖2〗：“顾公事何如？”壹答：“不能佳。”厷又问：“若此公免退，谁当代之？”壹未答厷。厷曰：“得无潘太常得之乎〖3〗？”壹良久曰：“君语近之也。”厷谓曰：“潘太常，常切齿于君，但道远无因耳〖4〗。今日代顾公，恐明日便击君矣〖5〗！”壹大惧，遂解散雍事","section_title":"潘濬陆凯传第十六","source":{"file":"OEBPS/Text/titlepage_0129.xhtml","index":26,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":33,"end":169,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
