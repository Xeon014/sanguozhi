{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wuzhu-e-o157c","title":"朱据领丞相燎鹊祭","accounts":[{"id":"wuzhu-e-o157c-account","label":"《吴主传第二》正文","text":"朱据领丞相，燎鹊以祭。","evidence":["wuzhu-e-o157c-q"]}],"participants":[{"person":"wuzhu-p0125","role":"领丞相祭祀","evidence":["wuzhu-e-o157c-q"]}],"place":null,"time":{"year":249,"label":"四月丙寅","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"wuzhu-y249","dating_review":{"reviewed":true,"anchor":"wuzhu-q-o157","basis":"四月丙寅"},"evidence":["wuzhu-e-o157c-q","wuzhu-q-o157","shaodi-q-o043","shaodi-q-o046","shaodi-q-b-33155276d789f594176b"]},"ordering_evidence":"wuzhu-e-o157c-q","source_order":[47,776,"O157c"],"order":8398}],"persons":[{"id":"wuzhu-p0125","name":"朱据","facts":[],"aliases":[]}],"evidence":[{"id":"shaodi-q-b-33155276d789f594176b","section":"chapter-004","block":"b-33155276d789f594176b","layer":"modern","quote":"〖13〗二年：嘉平二年（公元 250）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":198,"anchor":null},"note_id":"n-235bc158a4eae2a0609a","start":0,"end":20},{"id":"shaodi-q-o043","section":"chapter-004","block":"b-b1c990928436e9ed43da","layer":"original","quote":"嘉平元年春正月，甲午〖1〗，车驾谒高平陵。﹝一﹞太傅司马宣王奏免大将军曹爽、爽弟中领军羲、武卫将军训、散骑常侍彦官〖2〗，以侯就第。戊戌〖3〗，有司奏收黄门张当付廷尉〖4〗；考实其辞，爽与谋不轨。又尚书丁谧、邓飏、何晏，司隶校尉毕轨，荆州刺史李胜，大司农桓范，皆与爽通奸谋〖5〗，夷三族。语在《爽传》。丙午〖6〗，大赦。丁未〖7〗，以太傅司马宣王为丞相；固让，乃止。﹝二﹞","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":180,"anchor":null},"note_id":null,"start":0,"end":186},{"id":"shaodi-q-o046","section":"chapter-004","block":"b-8bc97b77985c9cc83eeb","layer":"original","quote":"二年夏五月〖13〗，以征西将军郭淮为车骑将军〖14〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":183,"anchor":null},"note_id":null,"start":0,"end":27},{"id":"wuzhu-e-o157c-q","section":"chapter-047","block":"b-6a63d6237256eeada959","layer":"original","quote":"丙寅〖9〗，骠骑将军朱据领丞相，燎鹊以祭。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":264,"anchor":null},"note_id":null,"start":31,"end":52},{"id":"wuzhu-q-o157","section":"chapter-047","block":"b-6a63d6237256eeada959","layer":"original","quote":"十二年春三月〖8〗，左大司马朱然卒。四月，有两乌衔鹊，堕东馆。丙寅〖9〗，骠骑将军朱据领丞相，燎鹊以祭。﹝三﹞","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_001.xhtml","index":264,"anchor":null},"note_id":null,"start":0,"end":55}],"profiles":{},"directory_counts":{}}
