{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhanggu-e-o132","title":"权遣顾徽使北探曹公","accounts":[{"id":"zhanggu-a-11d706a0ae02955b7538","label":"裴注·吴书","text":"权遣顾徽使北探曹公","evidence":["zhanggu-q-70985ce5374968bb7dc5"]}],"participants":[{"person":"sun-quan","role":"谓徽曰卿孤腹心今传孟德怀异意莫足使揣之卿为吾行、拜徽巴东太守欲大用之","evidence":["zhanggu-q-70985ce5374968bb7dc5"]},{"person":"zhanggu-p0036","role":"拜辅义都尉、到北与曹公相见、应对婉顺因说江东大丰山薮宿恶皆慕化为善义出作兵、曰正以明公与主将义固磐石休戚共之必欲知江表消息是以及耳、还答权曰敌国隐情猝难探察然徽潜采听方与袁谭交争未有他意、会卒","evidence":["zhanggu-q-70985ce5374968bb7dc5"]},{"person":"cao-cao","role":"具问境内消息、笑曰孤与孙将军一结婚姻共辅汉室义如一家君何为道此、厚待遣还","evidence":["zhanggu-q-70985ce5374968bb7dc5"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["zhanggu-q-70985ce5374968bb7dc5"]},"ordering_evidence":"zhanggu-q-70985ce5374968bb7dc5","source_order":[52,173,126],"order":9307}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"zhanggu-p0036","name":"顾徽","facts":[],"aliases":[]}],"evidence":[{"id":"zhanggu-q-70985ce5374968bb7dc5","section":"chapter-052","block":"b-731a4f7dcbb9861aef8c","layer":"pei","quote":"转东曹掾。或传曹公欲东，权谓徽曰：‘卿，孤腹心。今传孟德怀异意，莫足使揣之，卿为吾行。’拜辅义都尉，到北与曹公相见。公具问境内消息，徽应对婉顺；因说江东大丰，山薮宿恶，皆慕化为善，义出作兵。公笑曰：‘孤与孙将军一结婚姻，共辅汉室，义如一家。君何为道此？’徽曰：‘正以明公与主将义固磐石，休戚共之，必欲知江表消息，是以及耳。’公厚待，遣还。权问：‘定云何？’徽曰：‘敌国隐情，猝难探察；然徽潜采听，方与袁谭交争，未有他意。’乃拜徽巴东太守，欲大用之，会卒","attribution":"裴注·吴书","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":172,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-5a9c7df73f863da1ddae","start":126,"end":352,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
