{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"shaodi-e-p006c","title":"司马懿示攻追败退遁吴军","accounts":[{"id":"shaodi-e-p006c-account","label":"干宝《晋纪》","text":"司马懿示攻追败退遁吴军","evidence":["shaodi-e-p006c-q"]}],"participants":[{"person":"wudi-p0364","role":"部署追击","evidence":["shaodi-e-p006c-q"]},{"person":"mingdi-p0046","role":"退兵","evidence":["shaodi-e-p006c-q"]}],"place":{"text":"三州口","evidence":["shaodi-q-p006"]},"time":{"year":241,"label":"六月","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"shaodi-y241","dating_review":{"reviewed":true,"anchor":"shaodi-q-o012","basis":"六月"},"evidence":["shaodi-e-p006c-q","shaodi-q-o012","shaodi-q-b-f56b355cff79244bd89c"]},"ordering_evidence":"shaodi-e-p006c-q","source_order":[4,71,"P006c"],"order":1006}],"persons":[{"id":"mingdi-p0046","name":"朱然","facts":[],"aliases":[]},{"id":"wudi-p0364","name":"司马懿","facts":[],"aliases":[]}],"evidence":[{"id":"shaodi-e-p006c-q","section":"chapter-004","block":"b-9de4e9797fd7af8b9b35","layer":"pei","quote":"﹝一﹞干宝《晋纪》曰：“吴将全琮寇芍陂，朱然、孙伦五万人围樊城，诸葛瑾、步骘寇柤中。琮已破走而樊围急，宣王曰：‘柤中民夷十万，隔在水南，流离无主；樊城被攻，历月不解。此危事也，请自讨之。’议者咸言：‘贼远围樊城不可拔，挫于坚城之下，有自破之势，宜长策以御之。’宣王曰：‘军志有之：将能而御之，此为縻军；不能而任之，此为覆军。今疆埸骚动，民心疑惑，是社稷之大忧也！’六月，督诸军南征。车驾送津阳城门外。宣王以南方暑湿，不宜持久；使轻骑挑之，然不敢动。于是乃令诸军休息洗沐，简精锐，募先登，申号令，示必攻之势。然等闻之，乃夜遁。追至三州口，大杀获。”","attribution":"干宝《晋纪》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":70,"anchor":null},"note_id":"n-464892127dfdead33756","start":0,"end":273},{"id":"shaodi-q-b-f56b355cff79244bd89c","section":"chapter-004","block":"b-f56b355cff79244bd89c","layer":"modern","quote":"〖1〗二年：正始二年（公元 241）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":62,"anchor":null},"note_id":"n-bf9ccbeb544f540e6afb","start":0,"end":19},{"id":"shaodi-q-o012","section":"chapter-004","block":"b-33e60ac0c003858f0640","layer":"original","quote":"二年春二月〖1〗，帝初通《论语》〖2〗。使太常以太牢祭孔子于辟雍〖3〗，以颜渊配〖4〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":58,"anchor":null},"note_id":null,"start":0,"end":44},{"id":"shaodi-q-p006","section":"chapter-004","block":"b-9de4e9797fd7af8b9b35","layer":"pei","quote":"﹝一﹞干宝《晋纪》曰：“吴将全琮寇芍陂，朱然、孙伦五万人围樊城，诸葛瑾、步骘寇柤中。琮已破走而樊围急，宣王曰：‘柤中民夷十万，隔在水南，流离无主；樊城被攻，历月不解。此危事也，请自讨之。’议者咸言：‘贼远围樊城不可拔，挫于坚城之下，有自破之势，宜长策以御之。’宣王曰：‘军志有之：将能而御之，此为縻军；不能而任之，此为覆军。今疆埸骚动，民心疑惑，是社稷之大忧也！’六月，督诸军南征。车驾送津阳城门外。宣王以南方暑湿，不宜持久；使轻骑挑之，然不敢动。于是乃令诸军休息洗沐，简精锐，募先登，申号令，示必攻之势。然等闻之，乃夜遁。追至三州口，大杀获。”","attribution":"干宝《晋纪》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":70,"anchor":null},"note_id":"n-464892127dfdead33756","start":0,"end":273}],"profiles":{},"directory_counts":{}}
