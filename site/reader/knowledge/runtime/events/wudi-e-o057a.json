{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o057a","title":"高顺破刘备与曹操征吕布","accounts":[{"id":"wudi-e-o057a-account","label":"正文","text":"吕布助袁术，遣高顺攻刘备；夏侯惇救援不利，刘备战败，曹操九月东征吕布。","evidence":["wudi-e-o057a-q"]},{"id":"xianzhu-e-o013c-account","label":"《先主传》正文","text":"高顺攻刘备，夏侯惇不能救；曹操亲征，与刘备围吕布于下邳并生擒之，刘备取回妻子。","evidence":["xianzhu-e-o013c-q"]},{"id":"xianzhu-e-p012b-account","label":"《英雄记》","text":"《英雄记》记高顺、张辽攻沛，九月破城，十月刘备在梁国界迎曹操东征。","evidence":["xianzhu-e-p012b-q"]},{"id":"lvzang-a-785e5cc417581d1eb3ac","label":"正文","text":"建安三年布复叛为术遣高顺攻备于沛破之","evidence":["lvzang-q-4fe6a800149fd9eee435"]},{"id":"lvzang-a-e720d1198d79a702e79c","label":"正文","text":"太祖遣夏侯惇救备为顺所败","evidence":["lvzang-q-292cdc633bfd71d74aca"]}],"participants":[{"person":"wudi-p0088","role":"遣将","evidence":["wudi-e-o057a-q"]},{"person":"wudi-p0057","role":"获吕布协助","evidence":["wudi-e-o057a-q"]},{"person":"wudi-p0140","role":"攻破刘备","evidence":["wudi-e-o057a-q"]},{"person":"liu-bei","role":"战败","evidence":["wudi-e-o057a-q"]},{"person":"cao-cao","role":"遣救东征","evidence":["wudi-e-o057a-q"]},{"person":"wudi-p0027","role":"救援不利","evidence":["wudi-e-o057a-q"]},{"person":"wudi-p0178","role":"攻沛","evidence":["xianzhu-e-p012b-q"]}],"place":null,"time":{"label":"建安三年九月东征","year":198,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o057a-q","wudi-q-o054","wudi-q-b-4269a9733b31c7ed1578"],"chronology":"wudi-y198","dating_review":{"anchor":"wudi-q-o054","basis":"建安三年九月东征","reviewed":true}},"source_order":[1,338,"O057a"],"order":148}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"wudi-p0027","name":"夏侯惇","facts":[],"aliases":[]},{"id":"wudi-p0057","name":"袁术","facts":[],"aliases":[]},{"id":"wudi-p0088","name":"吕布","facts":[],"aliases":[]},{"id":"wudi-p0140","name":"高顺","facts":[],"aliases":[]},{"id":"wudi-p0178","name":"张辽","facts":[],"aliases":[]}],"evidence":[{"id":"lvzang-q-292cdc633bfd71d74aca","section":"chapter-007","block":"b-40fdcaab8e953c623e46","layer":"original","quote":"太祖遣夏侯惇救备，为顺所败","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":96,"anchor":null},"note_id":null,"start":23,"end":36},{"id":"lvzang-q-4fe6a800149fd9eee435","section":"chapter-007","block":"b-40fdcaab8e953c623e46","layer":"original","quote":"建安三年，布复叛为术；遣高顺攻刘备于沛，破之","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":96,"anchor":null},"note_id":null,"start":0,"end":22},{"id":"wudi-e-o057a-q","section":"chapter-001","block":"b-961dbaf078534b1eab6b","layer":"original","quote":"吕布复为袁术，使高顺攻刘备〖1〗。公遣夏侯惇救之，不利；备为顺所败。九月，公东征布。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":337,"anchor":null},"note_id":null,"start":0,"end":42},{"id":"wudi-q-b-4269a9733b31c7ed1578","section":"chapter-001","block":"b-4269a9733b31c7ed1578","layer":"modern","quote":"〖1〗三年：建安三年（公元 198）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":327,"anchor":null},"note_id":"n-1273453201e8129c485c","start":0,"end":19},{"id":"wudi-q-o054","section":"chapter-001","block":"b-ec1ae0750950ac5532fb","layer":"original","quote":"三年春正月〖1〗，公还许。初置军师祭酒〖2〗。三月，公围张绣于穰。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":323,"anchor":null},"note_id":null,"start":0,"end":33},{"id":"xianzhu-e-o013c-q","section":"chapter-032","block":"b-2bcaabf007ae7b6068f2","layer":"original","quote":"布遣高顺攻之〖3〗；曹公遣夏侯惇往，不能救；为顺所败，复虏先主妻子送布。曹公自出东征，﹝二﹞助先主围布于下邳。生擒布，先主复得妻子。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":59,"anchor":null},"note_id":null,"start":76,"end":142},{"id":"xianzhu-e-p012b-q","section":"chapter-032","block":"b-65b45459ea9295068b1f","layer":"pei","quote":"布由是遣中郎将高顺、北地太守张辽等，攻备。九月，遂破沛城，备单身走，获其妻息。十月，曹公自征布；备于梁国界中，与曹公相遇，遂随公俱东征。","attribution":"《英雄记》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":69,"anchor":null},"note_id":"n-3ea9ec85d80bc5c5b2e4","start":36,"end":104}],"profiles":{},"directory_counts":{}}
