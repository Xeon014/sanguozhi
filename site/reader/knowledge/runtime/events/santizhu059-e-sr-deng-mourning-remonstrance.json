{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"santizhu059-e-sr-deng-mourning-remonstrance","title":"孙登闻孙虑卒兼行诣权谏止减膳","accounts":[{"id":"santizhu059-a-e582b60f4dd9da3024b1","label":"正文","text":"孙虑卒权为之降损；登昼夜兼行到赖乡，谏权不过礼制；权纳其言为之加膳","evidence":["santizhu059-q-08290482486fb617afae"]}],"participants":[{"person":"zhouyu-p0025","role":"昼夜兼行诣权并谏止减膳","evidence":["santizhu059-q-08290482486fb617afae"]},{"person":"sun-quan","role":"为虑卒降损膳食，纳登谏加膳","evidence":["santizhu059-q-08290482486fb617afae"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"未由相邻段落推算纪年；原文时间表达保留在来源引句中。","evidence":["santizhu059-q-08290482486fb617afae"]},"ordering_evidence":"santizhu059-q-08290482486fb617afae","source_order":[59,31,0],"order":10432}],"persons":[{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"zhouyu-p0025","name":"孙登","facts":[],"aliases":[]}],"evidence":[{"id":"santizhu059-q-08290482486fb617afae","section":"chapter-059","block":"b-e4274ebd423d6ab0aa40","layer":"original","quote":"后弟虑卒，权为之降损〖9〗。登昼夜兼行，到赖乡〖10〗。自闻〖11〗，即时召见。见权悲泣，因谏曰：“虑寝疾不起，此乃命也。方今朔土未一〖12〗，四海喁喁〖13〗，天戴陛下。而以下流之念〖14〗，减损太官肴馔〖15〗；过于礼制，臣窃忧惶！”权纳其言，为之加膳","section_title":"吴主五子传第十四","source":{"file":"OEBPS/Text/titlepage_0125.xhtml","index":30,"anchor":null},"note_id":null,"start":0,"end":128}],"profiles":{},"directory_counts":{}}
