{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p037a","title":"陈宫游说州吏迎曹操","accounts":[{"id":"wudi-e-p037a-account","label":"《世语》","text":"《世语》记刘岱死后，陈宫向州吏游说迎曹操领州，鲍信等赞同。","evidence":["wudi-e-p037a-q"]}],"participants":[{"person":"wudi-p0096","role":"游说","evidence":["wudi-e-p037a-q"]},{"person":"cao-cao","role":"被推举","evidence":["wudi-e-p037a-q"]},{"person":"wudi-p0065","role":"赞同","evidence":["wudi-e-p037a-q"]}],"place":{"text":"兖州","evidence":["wudi-e-p037a-q"]},"time":{"label":"刘岱死后","year":192,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-p037a-q","wudi-q-o019","wudi-q-b-3863a19b555811d1f415"],"chronology":"wudi-y192","dating_review":{"anchor":"wudi-q-o019","basis":"刘岱死后","reviewed":true}},"source_order":[1,184,"P037a"],"order":86}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0065","name":"鲍信","facts":[],"aliases":[]},{"id":"wudi-p0096","name":"陈宫","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-p037a-q","section":"chapter-001","block":"b-923b3640b464a66c29b2","layer":"pei","quote":"﹝一﹞《世语》曰：“岱既死，陈宫谓太祖曰：‘州今无主，而王命断绝。宫请说州中，明府寻往牧之。资之以收天下，此霸王之业也。’宫说别驾、治中曰：‘今天下分裂而州无主。曹东郡，命世之才也；若迎以牧州，必宁生民。’鲍信等亦谓之然。”","attribution":"《世语》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":183,"anchor":null},"note_id":"n-e4a6518d16f574fcb395","start":0,"end":112},{"id":"wudi-q-b-3863a19b555811d1f415","section":"chapter-001","block":"b-3863a19b555811d1f415","layer":"modern","quote":"〖1〗三年：初平三年（公元 192）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":152,"anchor":null},"note_id":"n-2063caf2b642ce9ff2bc","start":0,"end":19},{"id":"wudi-q-o019","section":"chapter-001","block":"b-43620706e925cc9a268c","layer":"original","quote":"三年春〖1〗，太祖军顿丘，毒等攻东武阳。太祖乃引兵西入山，攻毒等本屯〖2〗。﹝一﹞毒闻之，弃武阳还〖3〗。太祖要击眭固〖4〗，又击匈奴于夫罗于内黄〖5〗，皆大破之。﹝二﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/T