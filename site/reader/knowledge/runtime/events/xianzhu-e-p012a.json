{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-p012a","title":"刘备军夺吕布买马金","accounts":[{"id":"xianzhu-e-p012a-account","label":"《英雄记》","text":"《英雄记》记建安三年春，吕布使人持金往河内买马，为刘备军夺取。","evidence":["xianzhu-e-p012a-q"]}],"participants":[{"person":"liu-bei","role":"部军夺金","evidence":["xianzhu-e-p012a-q"]},{"person":"wudi-p0088","role":"遣使买马","evidence":["xianzhu-e-p012a-q"]}],"place":{"text":"河内","evidence":["xianzhu-e-p012a-q"]},"time":{"year":198,"label":"建安三年春","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xianzhu-y198","dating_review":{"reviewed":true,"anchor":"xianzhu-q-o013","basis":"建安三年春"},"evidence":["xianzhu-e-p012a-q","xianzhu-q-o013","wudi-q-o054","wudi-q-b-4269a9733b31c7ed1578"]},"source_order":[32,70,"P012a"],"order":6519}],"persons":[{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"wudi-p0088","name":"吕布","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-q-b-4269a9733b31c7ed1578","section":"chapter-001","block":"b-4269a9733b31c7ed1578","layer":"modern","quote":"〖1〗三年：建安三年（公元 198）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":327,"anchor":null},"note_id":"n-1273453201e8129c485c","start":0,"end":19},{"id":"wudi-q-o054","section":"chapter-001","block":"b-ec1ae0750950ac5532fb","layer":"original","quote":"三年春正月〖1〗，公还许。初置军师祭酒〖2〗。三月，公围张绣于穰。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":323,"anchor":null},"note_id":null,"start":0,"end":33},{"id":"xianzhu-e-p012a-q","section":"chapter-032","block":"b-65b45459ea9295068b1f","layer":"pei","quote":"建安三年春，布使人赍金，欲诣河内买马，为备兵所抄。","attribution":"《英雄记》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":69,"anchor":null},"note_id":"n-3ea9ec85d80bc5c5b2e4","start":11,"end":36},{"id":"xianzhu-q-o013","section":"chapter-032","block":"b-2bcaabf007ae7b6068f2","layer":"original","quote":"先主还小沛，﹝一﹞复合兵得万余人。吕布恶之，自出兵攻先主。先主败走归曹公〖1〗，曹公厚遇之〖2〗，以为豫州牧。将至沛收散卒，给其军粮；益与兵，使东击布。布遣高顺攻之〖3〗；曹公遣夏侯惇往，不能救；为顺所败，复虏先主妻子送布。曹公自出东征，﹝二﹞助先主围布于下邳。生擒布，先主复得妻子。从曹公还许，表先主为左将军；礼之愈重，出则同舆，坐则同席。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":59,"anchor":null},"note_id":null,"start":0,"end":171}],"profiles":{},"directory_counts":{}}
