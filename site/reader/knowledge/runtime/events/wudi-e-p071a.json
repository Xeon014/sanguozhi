{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p071a","title":"曹操据侦报断言可得冀州","accounts":[{"id":"wudi-e-p071a-account","label":"《曹瞒传》","text":"《曹瞒传》记多批侦察者证实袁尚走西道，曹操据此向诸将称已可得冀州。","evidence":["wudi-e-p071a-q"]}],"participants":[{"person":"cao-cao","role":"分析侦报","evidence":["wudi-e-p071a-q"]},{"person":"wudi-p0198","role":"行军被侦察","evidence":["wudi-e-p071a-q"]}],"place":{"text":"邯郸、冀州","evidence":["wudi-e-p071a-q"]},"time":{"label":"建安九年救邺战前","year":204,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-p071a-q","wudi-q-o092","wudi-q-b-6787e3ddd3e334b677d4"],"chronology":"wudi-y204","dating_review":{"anchor":"wudi-q-o092","basis":"建安九年救邺战前","reviewed":true}},"source_order":[1,531,"P071a"],"order":224}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0198","name":"袁尚","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-p071a-q","section":"chapter-001","block":"b-4b5a549872e7f2201c60","layer":"pei","quote":"﹝二﹞《曹瞒传》曰：“遣候者数部，前后参之，皆曰：‘定从西道，已在邯郸。’公大喜，会诸将曰：‘孤已得冀州，诸君知之乎？’皆曰：‘不知。’公曰：‘诸君方见不久也。’”","attribution":"《曹瞒传》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":530,"anchor":null},"note_id":"n-4c7c2b4782d72d457c46","start":0,"end":82},{"id":"wudi-q-b-6787e3ddd3e334b677d4","section":"chapter-001","block":"b-6787e3ddd3e334b677d4","layer":"modern","quote":"〖1〗九年：建安九年（公元 204）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":510,"anchor":null},"note_id":"n-c8fff97bafc82c655f3f","start":0,"end":19},{"id":"wudi-q-o092","section":"chapter-001","block":"b-3e549c423b15df48398a","layer":"original","quote":"九年春正月〖1〗，济河，遏淇水入白沟以通粮道〖2〗。二月，尚复攻谭，留苏由、审配守邺〖3〗。公进军到洹水〖4〗，由降；既至，攻邺，为土山、地道。武安长尹楷屯毛城〖5〗，通上党粮道〖6〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":506,"anchor":null},"note_id":null,"start":0,"end":93}],"profiles":{},"directo