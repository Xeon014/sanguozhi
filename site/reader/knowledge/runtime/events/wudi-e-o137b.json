start":13,"end":43},{"id":"wudi-e-o137b-q","section":"chapter-001","block":"b-f4c8ba9bf8d7f6ff8015","layer":"original","quote":"马超余众梁兴等，屯蓝田〖6〗，使夏侯渊击平之。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":105,"anchor":null},"note_id":null,"start":51,"end":74},{"id":"wudi-q-b-d1b3bd1bb0408268b940","section":"chapter-001","block":"b-d1b3bd1bb0408268b940","layer":"modern","quote":"〖1〗十七年：建安十七年（公元 212）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":127,"anchor":null},"note_id":"n-32846c231ed2b04de76f","start":0,"end":21},{"id":"wudi-q-o137","section":"chapter-001","block":"b-f4c8ba9bf8d7f6ff8015","layer":"original","quote":"十七年春正月〖1〗，公还邺。天子命公赞拜不名〖2〗，入朝不趋〖3〗，剑履上殿〖4〗：如萧何故事〖5〗。马超余众梁兴等，屯蓝田〖6〗，使夏侯渊击平之。割河内之荡阴、朝歌、林虑〖7〗，东郡之卫国、顿丘、东武阳、发干〖8〗，巨鹿之廮陶、曲周、南和、广平、（之）任（城）〖9〗，赵之襄国、邯郸、易阳，以益魏郡〖10〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":105,"anchor":null},"note_id":null,"start":0,"end":155}],"profiles":{},"directory_counts":{}}
