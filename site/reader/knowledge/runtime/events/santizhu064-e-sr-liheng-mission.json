{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"santizhu064-e-sr-liheng-mission","title":"《汉晋春秋》恪使李衡说姜维同举伐魏","accounts":[{"id":"santizhu064-a-c5f5916ce8a6d7c9f57c","label":"裴注·汉晋春秋","text":"恪使司马李衡往蜀说姜维令同举：敌政在私门兵挫民怨，吴攻其东汉入其西，破之必矣；维从之","evidence":["santizhu064-q-a49c469fafde41f74313"]}],"participants":[{"person":"shaodi-p0041","role":"遣李衡使蜀","evidence":["santizhu064-q-a49c469fafde41f74313"]},{"person":"santizhu-p0030","role":"奉命往蜀说姜维","evidence":["santizhu064-q-a49c469fafde41f74313"]},{"person":"shaodi-p0050","role":"被劝说者，从之（shaodi-p0050）","evidence":["santizhu064-q-a49c469fafde41f74313"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"未由相邻段落推算纪年；原文时间表达保留在来源引句中。","evidence":["santizhu064-q-a49c469fafde41f74313"]},"ordering_evidence":"santizhu064-q-a49c469fafde41f74313","source_order":[64,188,0],"order":10956}],"persons":[{"id":"santizhu-p0030","name":"李衡","facts":[],"aliases":[]},{"id":"shaodi-p0041","name":"诸葛恪","facts":[],"aliases":[]},{"id":"shaodi-p0050","name":"姜维","facts":[],"aliases":[]}],"evidence":[{"id":"santizhu064-q-a49c469fafde41f74313","section":"chapter-064","block":"b-bf7194ba919f0bb9485e","layer":"pei","quote":"《汉晋春秋》曰：“恪使司马李衡，往蜀说姜维，令同举。曰：‘古人有言：圣人不能（为）〔违〕时，时至亦不可失也。今敌政在私门，外内猜隔；兵挫于外，而民怨于内。自曹操以来，彼之亡形，未有如今者也。若大举伐之，使吴攻其东，汉入其西；彼救西则东虚，重东则西轻。以练实之军，乘虚轻之敌：破之必矣！’维从之。”","attribution":"裴注·汉晋春秋","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":187,"anchor":null},"note_id":"n-bc261450f526f19497a5","start":3,"end":151}],"profiles":{},"directory_counts":{}}
