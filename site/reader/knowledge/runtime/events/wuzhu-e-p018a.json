{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wuzhu-e-p018a","title":"孙权以时宜受魏封王","accounts":[{"id":"wuzhu-e-p018a-account","label":"《江表传》","text":"孙权以时宜受魏封王","evidence":["wuzhu-e-p018a-q"]},{"id":"wuzhu-a-p018-judgment","label":"孙盛论","text":"孙盛批评孙权臣否反复，主张守汉将之节。","evidence":["wuzhu-q-p018-judgment"]}],"participants":[{"person":"sun-quan","role":"受封","evidence":["wuzhu-e-p018a-q"]}],"place":null,"time":{"label":"孙权受魏封王时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["wuzhu-e-p018a-q"]},"ordering_evidence":"wuzhu-e-p018a-q","source_order":[47,290,"P018a"],"order":8210}],"persons":[{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]}],"evidence":[{"id":"wuzhu-e-p018a-q","section":"chapter-047","block":"b-231f9023ba9f01eda093","layer":"pei","quote":"权群臣议，以为‘宜称上将军、九州伯，不应受魏封’。权曰：‘九州伯，于古未闻也；昔沛公，亦受项羽拜为汉王：此盖时宜耳，复何损邪？’遂受之。","attribution":"《江表传》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":289,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-60662b39a0bdae2735a9","start":11,"end":79,"offset_unit":"unicode_code_point"},{"id":"wuzhu-q-p018-judgment","section":"chapter-047","block":"b-231f9023ba9f01eda093","layer":"pei","quote":"孙盛曰：“昔伯夷、叔齐不屈有周，鲁仲连不为秦民。夫以匹夫之志，犹义不辱；况列国之君三分天下，而可二三其节，或臣或否乎？余观吴、蜀，咸称奉汉；至于汉代，莫能固秉臣节。君子是以知其不能克昌厥后，卒见吞于大国也。向使权从群臣之议，终身称汉将；岂不义悲六合，仁感百世哉！","attribution":"孙盛论","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":289,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-60662b39a0bdae2735a9","start":80,"end":211,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
