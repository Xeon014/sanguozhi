{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"chengguo-e-o252a","title":"董昭代曹操作书结杨奉","accounts":[{"id":"chengguo-a-923c715950ded346dca3","label":"正文","text":"董昭代曹操作书结杨奉","evidence":["chengguo-q-bdb4dfff43489054317e"]}],"participants":[{"person":"wudi-p0122","role":"代曹操作书","evidence":["chengguo-q-bdb4dfff43489054317e"]},{"person":"wudi-p0120","role":"受书","evidence":["chengguo-q-bdb4dfff43489054317e"]}],"place":null,"time":{"label":"原文纪年见引文","precision":"undated","basis":"拆分行动分别核对；无本条直接释年，不承袭复合候选公元年。","evidence":["chengguo-q-bdb4dfff43489054317e"]},"ordering_evidence":"chengguo-q-bdb4dfff43489054317e","source_order":[14,155,43],"order":3044}],"persons":[{"id":"wudi-p0120","name":"杨奉","facts":[],"aliases":[]},{"id":"wudi-p0122","name":"董昭","facts":[],"aliases":[]}],"evidence":[{"id":"chengguo-q-bdb4dfff43489054317e","section":"chapter-014","block":"b-d63745ed601e2334eece","layer":"original","quote":"昭以奉兵马最强而少党援，作太祖书与奉曰：“吾与将军闻名慕义，便推赤心。今将军拔万乘之艰难〖13〗，反之旧都；翼佐之功，超世无畴〖14〗：何其休哉〖15〗！方今群凶猾夏〖16〗，四海未宁；神器至重〖17〗，事在维辅；必须众贤，以清王轨〖18〗；诚非一人，所能独建。心腹四支，实相恃赖；一物不备，则有阙焉。将军当为内主，吾为外援。今吾有粮，将军有兵；有无相通，足以相济；死生契阔〖19〗，相与共之！”","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":154,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":43,"end":241,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
