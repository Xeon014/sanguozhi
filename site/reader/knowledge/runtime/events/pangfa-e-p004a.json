{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"pangfa-e-p004a","title":"刘备庞统谈周瑜留备之谋","accounts":[{"id":"pangfa-e-p004a-account","label":"《江表传》","text":"《江表传》记刘备宴语问庞统周瑜劝孙权留备之事，庞统答有之，刘备回叙赴吴取舍。","evidence":["pangfa-e-p004a-q"]}],"participants":[{"person":"liu-bei","role":"问谈","evidence":["pangfa-e-p004a-q"]},{"person":"xianzhu-p0048","role":"答问","evidence":["pangfa-e-p004a-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["pangfa-e-p004a-q"]},"ordering_evidence":"pangfa-e-p004a-q","source_order":[37,34,"P004a"],"order":6964}],"persons":[{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"xianzhu-p0048","name":"庞统","facts":[],"aliases":[]}],"evidence":[{"id":"pangfa-e-p004a-q","section":"chapter-037","block":"b-a95724bbdde369c9f50e","layer":"pei","quote":"先主与统从容宴语，问曰：‘卿为周公瑾功曹，孤到吴，闻此人密有白事，劝仲谋相留，有之乎？在君为君，卿其无隐。’统对曰：‘有之。’备叹息曰：‘孤时危急，当有所求，故不得不往。殆不免周瑜之手！天下智谋之士，所见略同耳。时孔明谏孤莫行，其意独笃，亦虑此也。孤以仲谋所防在北，当赖孤为援，故决意不疑：此诚出于险途，非万全之计也。’”","attribution":"《江表传》","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":33,"anchor":null},"note_id":"n-e6939cf3eb12cc10ae71","start":11,"end":172}],"profiles":{},"directory_counts":{}}
