b6750e782","lizang-q-4dd32d6de5ba21052d86","lizang-q-97b4d48b792349c78402"]}],"order":3660}],"persons":[],"evidence":[{"id":"lizang-q-4dd32d6de5ba21052d86","section":"chapter-018","block":"b-c8eb075b65caf93a904c","layer":"pei","quote":"孙权尝自将数万众，猝至。时大雨，城栅崩坏；人民散在田野，未及补治","attribution":"裴注·魏略","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":108,"anchor":null},"note_id":"n-0c9dbffd502308ebdc57","start":10,"end":42},{"id":"lizang-q-97b4d48b792349c78402","section":"chapter-018","block":"b-c8eb075b65caf93a904c","layer":"pei","quote":"聘闻权到，不知所施，乃思惟：莫若潜默可以疑之。乃敕城中人使不得见，又自卧舍中不起。权果疑之，语其部党曰：‘北方以此人忠臣也，故委之以此郡；今我至而不动，此不有密图，必当有外救。’遂不敢攻而去","attribution":"裴注·魏略","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":108,"anchor":null},"note_id":"n-0c9dbffd502308ebdc57","start":43,"end":138},{"id":"lizang-q2-7c7c7dd5620b6750e782","section":"chapter-018","block":"b-c8eb075b65caf93a904c","layer":"pei","quote":"《魏略》此语，与本传反。","attribution":"裴注·裴松之按","section_title":"二李臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":108,"anchor":null},"note_id":"n-0c9dbffd502308ebdc57","start":140,"end":152}],"profiles":{},"directory_counts":{}}
