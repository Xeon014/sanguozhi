臧文吕许典二庞阎传第十八","source":{"file":"OEBPS/Text/titlepage_0041.xhtml","index":51,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":263,"end":288,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o185a-q","section":"chapter-001","block":"b-1e821a23c7f404685c92","layer":"original","quote":"二十二年春正月〖1〗，王军居巢〖2〗。二月，进军屯江西郝溪〖3〗。权在濡须口筑城，拒守。遂逼攻之，权退走。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":379,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":53,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-f23b885c4cc219692803","section":"chapter-001","block":"b-f23b885c4cc219692803","layer":"modern","quote":"〖1〗二十二年：建安二十二年（公元 217）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":383,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4fc85cb108cb7e71f49d","start":0,"end":23,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o185","section":"chapter-001","block":"b-1e821a23c7f404685c92","layer":"original","quote":"二十二年春正月〖1〗，王军居巢〖2〗。二月，进军屯江西郝溪〖3〗。权在濡须口筑城，拒守。遂逼攻之，权退走。三月，王引军还，留夏侯惇、曹仁、张辽等屯居巢。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":379,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":76,"offset_unit":"unicode_code_point"},{"id":"wuzhu-e-o031a-q","section":"chapter-047","block":"b-89f18ed57ac537b291ca","layer":"original","quote":"二十一年冬〖1〗，曹公次于居巢〖2〗，遂攻濡须。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":148,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":24,"offset_unit":"unicode_code_point"},{"id":"zhouyu-e-o085c-q","section":"chapter-05