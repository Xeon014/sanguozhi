ce":{"file":"OEBPS/Text/titlepage_0117.xhtml","index":357,"anchor":null},"note_id":null,"start":0,"end":63},{"id":"santizhu-q-dd4508cca788282ba550","section":"chapter-048","block":"b-d33ac4d7966626cd5c5b","layer":"original","quote":"二年春正月〖1〗，魏镇东大将军毌丘俭、前将军文钦，以淮南之众西入〖2〗，战于乐嘉〖3〗。","section_title":"三嗣主传第三","source":{"file":"OEBPS/Text/titlepage_0103.xhtml","index":53,"anchor":null},"note_id":null,"start":0,"end":44},{"id":"santizhu064-q-155c121d1b344531cadb","section":"chapter-064","block":"b-76cb3429cd16dda88c09","layer":"modern","quote":"〖9〗二年：五凤二年（公元 255）。","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":404,"anchor":null},"note_id":"n-c74c07c3ecd7068db28a","start":0,"end":19},{"id":"santizhu064-q-20d87b32e3639cb4e23a","section":"chapter-064","block":"b-c440da85565fe532313d","layer":"original","quote":"二年〖9〗，魏将毌丘俭、文钦以众叛，与魏人战于乐嘉〖10〗。峻帅骠骑将军吕据、左将军留赞袭寿春；会钦败降，军还","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":390,"anchor":null},"note_id":null,"start":0,"end":55},{"id":"shaodi-e-o073a-q","section":"chapter-004","block":"b-edb853525f526ca4c6d7","layer":"original","quote":"甲子〖18〗，吴大将孙峻等众号十万〖19〗，至寿春；诸葛诞拒击破之，斩吴左将军留赞〖20〗，献捷于京都。三月，立皇后卞氏〖21〗，大赦。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":333,"anchor":null},"note_id":null,"start":0,"end":68}],"profiles":{},"directory_counts":{}}
