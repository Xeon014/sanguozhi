{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"liang-envoy","title":"诸葛亮出使孙权","order":6534,"accounts":[{"id":"liang-envoy-account-1","label":"记载","text":"《先主传》记刘备派诸葛亮与孙权联结。","evidence":["envoy-shu"]},{"id":"liang-envoy-account-2","label":"记载","text":"《鲁肃传》记刘备到夏口后派诸葛亮出使，鲁肃返回复命。","evidence":["envoy-su"]},{"id":"liang-envoy-account-3","label":"记载","text":"裴松之按语将刘备与孙权合力拒曹的谋划归于鲁肃；这是注家的判断。","evidence":["pei-su-assessment"]},{"id":"xianzhu-e-p027b-account","label":"《江表传》","text":"《江表传》记刘备住鄂县后遣诸葛亮随鲁肃至孙权处结盟。","evidence":["xianzhu-e-p027b-q"]},{"id":"zhouyu-e-o012b-account","label":"《周瑜鲁肃吕蒙传》正文","text":"建安十三年：刘备至夏口遣诸葛亮使孙权","evidence":["zhouyu-e-o012b-q"]},{"id":"zhuge-e-o010a-account","label":"《诸葛亮传第五》正文","text":"诸葛亮请使孙权求援","evidence":["zhuge-e-o010a-q"]}],"participants":[{"person":"liu-bei","role":"派遣使者","evidence":["envoy-shu"]},{"person":"zhuge-liang","role":"出使","evidence":["envoy-shu"]},{"person":"sun-quan","role":"出使对象","evidence":["envoy-shu"]},{"person":"lu-su","role":"返回复命","evidence":["envoy-su"]}],"place":{"text":"夏口（出发记事）","evidence":["envoy-su"]},"time":{"label":"建安十三年（208）","year":208,"precision":"year","basis":"年次承接本篇建安十三年记事，现代注释释为公元 208 年；此条未记具体月日。","evidence":["year-original","year-modern","zhou-year","zhou-year-modern","meeting-zhou","envoy-su"]}}],"persons":[{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"lu-su","name":"鲁肃","facts":[],"aliases":[]},{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"zhuge-liang","name":"诸葛亮","facts":[],"aliases":[]}],"evidence":[{"id":"envoy-shu","section":"chapter-032","block":"b-1846d8225e91af23e064","quote":"先主遣诸葛亮自结于孙权，","layer":"original","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":113,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":12,"offset_unit":"unicode_code_point"},{"id":"envoy-su","section":"chapter-054","block":"b-47261412a84083cdfce6","quote":"备遂到夏口，遣亮使权。肃亦反命〖13〗。","layer":"original","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":214,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":31,"end":51,"offset_unit":"unicode_code_point"},{"id":"meeting-zhou","section":"chapter-054","block":"b-df9e8a2d1c2855c608f2","quote":"时刘备为曹公所破，欲引南渡江；与鲁肃遇于当阳，遂共图计。因进住夏口，遣诸葛亮诣权。权遂遣瑜及程普等，与备并力逆曹公，遇于赤壁。","layer":"original","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":62,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":63,"offset_unit":"unicode_code_point"},{"id":"pei-su-assessment","section":"chapter-054","block":"b-ce708dbc3c8fcdf9b474","quote":"臣松之按：刘备与权并力，共拒中国，皆肃之本谋。","layer":"pei","attribution":"裴松之按语","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":230,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-44a03e4ab7c323e722bd","start":3,"end":26,"offset_unit":"unicode_code_point"},{"id":"xianzhu-e-p027b-q","section":"chapter-032","block":"b-2604f77f12fa0a0ec398","layer":"pei","quote":"备大喜，进住鄂县；即遣诸葛亮，随肃诣孙权，结同盟誓。”","attribution":"《江表传》","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":133,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-71fe375a47894e50905a","start":218,"end":245,"offset_unit":"unicode_code_point"},{"id":"year-modern","section":"chapter-001","block":"b-888495d8be7766faf20c","quote":"十三年：建安十三年（公元 208）。","layer":"modern","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":666,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-0bae348fdb687025113d","start":3,"end":21,"offset_unit":"unicode_code_point"},{"id":"year-original","section":"chapter-001","block":"b-4bcffcc4ee709a4e5ea3","quote":"十三年春正月〖1〗，公还邺。","layer":"original","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":661,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":14,"offset_unit":"unicode_code_point"},{"id":"zhou-year","section":"chapter-054","block":"b-3661896c106f1817bf4b","quote":"十三年春〖6〗，权讨江夏，瑜为前部大督〖7〗。其年九月，曹公入荆州，刘琮举众降。","layer":"original","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":34,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":40,"offset_unit":"unicode_code_point"},{"id":"zhou-year-modern","section":"chapter-054","block":"b-63f47c62fde80b3a0132","quote":"十三年：建安十三年（公元 208）。","layer":"modern","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":43,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-8f109f42647e5ee8d831","start":3,"end":21,"offset_unit":"unicode_code_point"},{"id":"zhouyu-e-o012b-q","section":"chapter-054","block":"b-df9e8a2d1c2855c608f2","layer":"original","quote":"时刘备为曹公所破，欲引南渡江；与鲁肃遇于当阳，遂共图计。因进住夏口，遣诸葛亮诣权。权遂遣瑜及程普等，与备并力逆曹公，遇于赤壁。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":62,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":63,"offset_unit":"unicode_code_point"},{"id":"zhuge-e-o010a-q","section":"chapter-035","block":"b-bf05a709ded079ef9f74","layer":"original","quote":"先主至于夏口〖2〗，亮曰：“事急矣！请奉命求救于孙将军〖3〗。”","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":71,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":32,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
