{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"shaodi-e-o119a","title":"曹髦幸辟雍命赋诗免和逌陈骞迟作之罪","accounts":[{"id":"shaodi-e-o119a-account","label":"《三少帝纪》正文","text":"曹髦幸辟雍命赋诗免和逌陈骞迟作之罪","evidence":["shaodi-e-o119a-q"]}],"participants":[{"person":"shaodi-p0068","role":"下诏宽免","evidence":["shaodi-e-o119a-q"]},{"person":"shaodi-p0106","role":"赋诗","evidence":["shaodi-e-o119a-q"]},{"person":"shaodi-p0107","role":"赋诗","evidence":["shaodi-e-o119a-q"]}],"place":null,"time":{"year":257,"label":"五月辛未","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"shaodi-y257","dating_review":{"reviewed":true,"anchor":"shaodi-q-o117","basis":"五月辛未"},"evidence":["shaodi-e-o119a-q","shaodi-q-o117","shaodi-q-b-6209c552405e0ebbdf98"]},"ordering_evidence":"shaodi-e-o119a-q","source_order":[4,525,"O119a"],"order":1184}],"persons":[{"id":"shaodi-p0068","name":"曹髦","facts":[],"aliases":[]},{"id":"shaodi-p0106","name":"和逌","facts":[],"aliases":[]},{"id":"shaodi-p0107","name":"陈骞","facts":[],"aliases":[]}],"evidence":[{"id":"shaodi-e-o119a-q","section":"chapter-004","block":"b-664faf315e1d49a284ae","layer":"original","quote":"五月，辛未〖7〗，帝幸辟雍。会，命群臣赋诗。侍中和逌、尚书陈骞等作诗稽留〖8〗，有司奏免官。诏曰：“吾以暗昧，爱好文雅。广延诗赋，以知得失。而乃尔纷纭〖9〗，良用反仄〖10〗。其原逌等，主者宣敕：自今以后，群臣皆当玩习古义，修明经典。称朕意焉。”","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":524,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":123,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-b-6209c552405e0ebbdf98","section":"chapter-004","block":"b-6209c552405e0ebbdf98","layer":"modern","quote":"〖1〗二年：甘露二年（公元 257 ）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":535,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-4dd98e402a6a8de51491","start":0,"end":20,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o117","section":"chapter-004","block":"b-d021e0b00f489a01f208","layer":"original","quote":"二年春二月〖1〗，青龙现温县井中。三月，司空卢毓薨。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":522,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":26,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
