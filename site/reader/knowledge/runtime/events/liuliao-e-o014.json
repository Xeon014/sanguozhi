{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"liuliao-e-o014","title":"彭羕径上庞统床卧统善之并致先主","accounts":[{"id":"liuliao-a-7547d9f74c1936205f7c","label":"正文","text":"彭羕径上庞统床卧统善之并致先主","evidence":["liuliao-q-ca0ac8de1d6d3dd403d1"]}],"participants":[{"person":"xianzhu-p0064","role":"欲纳说先主乃往见庞统、径上统床卧谓统曰须客罢当与卿善谈、又先责统食然后共语、因留信宿至于经日","evidence":["liuliao-q-ca0ac8de1d6d3dd403d1"]},{"person":"xianzhu-p0048","role":"与羕非故人又适有宾客、客罢往就羕坐、大善之","evidence":["liuliao-q-ca0ac8de1d6d3dd403d1"]},{"person":"xianzhu-p0046","role":"宿自知羕、并致之先主","evidence":["liuliao-q-ca0ac8de1d6d3dd403d1"]},{"person":"liu-bei","role":"入蜀溯流北行、所纳说者","evidence":["liuliao-q-ca0ac8de1d6d3dd403d1"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liuliao-q-ca0ac8de1d6d3dd403d1"]},"ordering_evidence":"liuliao-q-ca0ac8de1d6d3dd403d1","source_order":[40,104,0],"order":7258}],"persons":[{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"xianzhu-p0046","name":"法正","facts":[],"aliases":[]},{"id":"xianzhu-p0048","name":"庞统","facts":[],"aliases":[]},{"id":"xianzhu-p0064","name":"彭羕","facts":[],"aliases":[]}],"evidence":[{"id":"liuliao-q-ca0ac8de1d6d3dd403d1","section":"chapter-040","block":"b-a60256a46596492ac845","layer":"original","quote":"会先主入蜀，溯流北行。羕欲纳说先主〖1〗，乃往见庞统。统与羕非故人，又适有宾客；羕径上统床卧，谓统曰：“须客罢当与卿善谈〖2〗。”统客既罢，往就羕坐；羕又先责统食〖3〗，然后共语。因留信宿〖4〗，至于经日。统大善之，而法正宿自知羕：遂并致之先主","section_title":"刘彭廖李刘魏杨传第十","source":{"file":"OEBPS/Text/titlepage_0086.xhtml","index":103,"anchor":null},"note_id":null,"start":0,"end":122}],"profiles":{},"directory_counts":{}}
