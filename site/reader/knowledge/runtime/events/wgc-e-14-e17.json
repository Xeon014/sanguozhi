{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wgc-e-14-e17","title":"司马懿征孟达州泰导军遂辟泰","order":5716,"accounts":[{"id":"wgc-a-14-e17","label":"裴注·世语","text":"司马懿征孟达州泰导军遂辟泰","evidence":["wgc-q0611","wgc-q0126"]}],"participants":[{"person":"wudi-p0364","role":"征孟达、遂辟泰","evidence":["wgc-q0611","wgc-q0126"]},{"person":"shaodi-p0035","role":"又导军","evidence":["wgc-q0611","wgc-q0126"]},{"person":"xianzhu-p0071","role":"被征者","evidence":["wgc-q0611","wgc-q0126"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0611","wgc-q0126"]},"ordering_evidence":"wgc-q0611"}],"persons":[{"id":"shaodi-p0035","name":"州泰","facts":[],"aliases":[]},{"id":"wudi-p0364","name":"司马懿","facts":[],"aliases":[]},{"id":"xianzhu-p0071","name":"孟达","facts":[],"aliases":[]}],"evidence":[{"id":"wgc-q0126","section":"chapter-028","block":"b-7c4cb6e3288767c0659f","layer":"pei","quote":"﹝二﹞《世语》曰：“初，荆州刺史裴潜以泰为从事。司马宣王镇宛，潜数遣诣宣王，由此为宣王所知。及征孟达，泰又导军，遂辟泰。泰频丧考、妣、祖，九年居丧；宣王留缺待之。至，三十六日，擢为新城太守。宣王为泰会，使尚书钟（繇）〔毓〕调泰：‘君释褐登宰府，三十六日拥麾盖，守兵马郡；乞儿乘小车，一何驶乎？’泰曰：‘诚有此！君，名公之子，少有文采，故守吏职；猕猴骑上牛，又何迟也！’众宾咸悦。后历兖、豫州刺史，所在有筹算绩效。”","attribution":"世语","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":435,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-83035962258f184f04f4","start":0,"end":207,"offset_unit":"unicode_code_point"},{"id":"wgc-q0611","section":"chapter-028","block":"b-7c4cb6e3288767c0659f","layer":"pei","quote":"及征孟达，泰又导军，遂辟泰","attribution":"裴注·世语","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":435,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-83035962258f184f04f4","start":46,"end":59,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
