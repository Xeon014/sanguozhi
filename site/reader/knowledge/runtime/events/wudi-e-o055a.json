{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o055a","title":"安众退军设伏破张绣刘表","accounts":[{"id":"wudi-e-o055a-account","label":"正文","text":"刘表救张绣断曹军后路，曹操撤围至安众，夜开地道转运辎重，设伏击破追军，并曾致书荀彧预言必胜。","evidence":["wudi-e-o055a-q"]}],"participants":[{"person":"liu-biao","role":"遣兵救援","evidence":["wudi-e-o055a-q"]},{"person":"wudi-p0131","role":"追击战败","evidence":["wudi-e-o055a-q"]},{"person":"cao-cao","role":"撤军设伏","evidence":["wudi-e-o055a-q"]},{"person":"wudi-p0100","role":"受书","evidence":["wudi-e-o055a-q"]}],"place":{"text":"安众","evidence":["wudi-e-o055a-q"]},"time":{"label":"建安三年夏五月","year":198,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o055a-q","wudi-q-o054","wudi-q-b-4269a9733b31c7ed1578"],"chronology":"wudi-y198","dating_review":{"anchor":"wudi-q-o054","basis":"建安三年夏五月","reviewed":true}},"source_order":[1,325,"O055a"],"order":145}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"liu-biao","name":"刘表","facts":[],"aliases":[]},{"id":"wudi-p0100","name":"荀彧","facts":[],"aliases":[]},{"id":"wudi-p0131","name":"张绣","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-o055a-q","section":"chapter-001","block":"b-7c914882bba7916d6c93","layer":"original","quote":"夏五月，刘表遣兵救绣，以绝军后〖3〗。﹝一﹞公将引还，绣兵来。公军不得进，连营稍前〖4〗。公与荀彧书曰：“贼来追吾，虽日行数里；吾策之〖5〗，到安众，破绣必矣！”到安众〖6〗，绣与表兵合，守险，公军前后受敌。公乃夜凿险为地道，悉过辎重；设奇兵。会明，贼谓公为遁也，悉军来追〖7〗。乃纵奇兵步骑夹攻，大破之。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":324,"anchor":null},"note_id":null,"start":0,"end":153},{"id":"wudi-q-b-4269a9733b31c7ed1578","section":"chapter-001","block":"b-4269a9733b31c7ed1578","layer":"modern","quote":"〖1〗三年：建安三年（公元 198）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":327,"anchor":null},"note_id":"n-1273453201e8129c485c","start":0,"end":19},{"id":"wudi-q-o054","section":"chapter-001","block":"b-ec1ae0750950ac5532fb","layer":"original","quote":"三年春正月〖1〗，公还许。初置军师祭酒〖2〗。三月，公围张绣于穰。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":323,"anchor":null},"note_id":null,"start":0,"end":33}],"profiles":{},"directory_counts":{}}
