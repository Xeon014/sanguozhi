{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o086a","title":"袁绍病卒与二子分据","accounts":[{"id":"wudi-e-o086a-account","label":"正文","text":"袁绍败后发病呕血，五月去世，袁尚接替；袁谭自号车骑将军屯黎阳。","evidence":["wudi-e-o086a-q"]},{"id":"dongyuan-e-o056a-account","label":"《董二袁刘传第六》正文","text":"袁绍官渡败后病忧卒","evidence":["dongyuan-e-o056a-q"]}],"participants":[{"person":"wudi-p0052","role":"病卒","evidence":["wudi-e-o086a-q"]},{"person":"wudi-p0198","role":"接替","evidence":["wudi-e-o086a-q"]},{"person":"wudi-p0163","role":"自号屯兵","evidence":["wudi-e-o086a-q"]}],"place":{"text":"黎阳","evidence":["wudi-e-o086a-q"]},"time":{"label":"建安七年夏五月","year":202,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o086a-q","wudi-q-o085","wudi-q-b-6de9e09a3ba1d95f3972"],"chronology":"wudi-y202","dating_review":{"anchor":"wudi-q-o085","basis":"建安七年夏五月","reviewed":true}},"source_order":[1,476,"O086a"],"order":204}],"persons":[{"id":"wudi-p0052","name":"袁绍","facts":[],"aliases":[]},{"id":"wudi-p0163","name":"袁谭","facts":[],"aliases":[]},{"id":"wudi-p0198","name":"袁尚","facts":[],"aliases":[]}],"evidence":[{"id":"dongyuan-e-o056a-q","section":"chapter-006","block":"b-017ec988403eb5ff269b","layer":"original","quote":"自军败后发病；七年〖14〗，忧死。","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":314,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":17,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o086a-q","section":"chapter-001","block":"b-096efbb7993c523bbbb0","layer":"original","quote":"绍自军破后，发病呕血；夏五月死，小子尚代〖1〗。谭自号车骑将军，屯黎阳。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":475,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":36,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-6de9e09a3ba1d95f3972","section":"chapter-001","block":"b-6de9e09a3ba1d95f3972","layer":"modern","quote":"〖5〗七年：建安七年（公元 202）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":464,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-225e544b9b47ac46c22e","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o085","section":"chapter-001","block":"b-a8b85fd0a011c49dc335","layer":"original","quote":"七年春正月〖5〗，公军谯。令曰：“吾起义兵，为天下除暴乱。旧土人民〖6〗，死丧略尽〖7〗。国中终日行，不见所识〖8〗，使吾凄怆伤怀！其举义兵以来〖9〗，将士绝无后者，求其亲戚以后之〖10〗；授土田，官给耕牛；置学师以教之。为存者立庙，使祀其先人。魂而有灵，吾百年之后何恨哉！”遂至浚仪〖11〗，治睢阳渠〖12〗；遣使以太牢祀桥玄〖13〗。﹝一﹞进军官渡。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":458,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":177,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
