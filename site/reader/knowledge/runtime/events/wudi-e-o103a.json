{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o103a","title":"曹操斩赵犊救犷平","accounts":[{"id":"wudi-e-o103a-account","label":"正文","text":"曹操征讨斩赵犊等，渡潞河救犷平，乌丸出塞退走。","evidence":["wudi-e-o103a-q"]}],"participants":[{"person":"cao-cao","role":"征讨救援","evidence":["wudi-e-o103a-q"]},{"person":"wudi-p0225","role":"被斩","evidence":["wudi-e-o103a-q"]},{"person":"wudi-p0226","role":"所属叛军被讨","evidence":["wudi-e-o103a-q"]},{"person":"wudi-p0227","role":"获援","evidence":["wudi-e-o103a-q"]}],"place":{"text":"潞河、犷平","evidence":["wudi-e-o103a-q"]},"time":{"label":"建安十年秋八月","year":205,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o103a-q","wudi-q-o100","wudi-q-b-2e98e13ca098117a86e9"],"chronology":"wudi-y205","dating_review":{"anchor":"wudi-q-o100","basis":"建安十年秋八月","reviewed":true}},"source_order":[1,576,"O103a"],"order":238}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0225","name":"赵犊","facts":[],"aliases":[]},{"id":"wudi-p0226","name":"霍奴","facts":[],"aliases":[]},{"id":"wudi-p0227","name":"鲜于辅","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-o103a-q","section":"chapter-001","block":"b-ad33f6ad633a7e19ef65","layer":"original","quote":"秋八月，公征之，斩犊等。乃渡潞河救犷平〖3〗；乌丸奔走，出塞。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":575,"anchor":null},"note_id":null,"start":0,"end":31},{"id":"wudi-q-b-2e98e13ca098117a86e9","section":"chapter-001","block":"b-2e98e13ca098117a86e9","layer":"modern","quote":"〖1〗十年：建安十年（公元 205）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":560,"anchor":null},"note_id":"n-a9b0434ee8de64aed40f","start":0,"end":19},{"id":"wudi-q-o100","section":"chapter-001","block":"b-1ca17316b02d7b4d213c","layer":"original","quote":"十年春正月〖1〗，攻谭，破之。斩谭，诛其妻子〖2〗，冀州平。﹝一﹞下令曰：“其与袁氏同恶者，与之更始〖3〗。”令民不得复私仇，禁厚葬；皆一之于法〖4〗。是月，袁熙大将焦触、张南等叛〖5〗，攻熙、尚；熙、尚奔三郡乌丸〖6〗。触等举其县降，封为列侯。",