{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"rensu-e-o152","title":"文帝令问雍州刺史张既：苏则功效为可加爵邑未邪，封爵重事，密白意勿宣露","accounts":[{"id":"rensu-a-a59ad60d2d6559609bd1","label":"裴注·魏名臣奏","text":"文帝令问雍州刺史张既：苏则功效为可加爵邑未邪，封爵重事，密白意勿宣露","evidence":["rensu-q-2ce585223f687dd1d287"]},{"id":"rensu-a-b5b6eb69149cdeb5c735","label":"裴注·魏名臣奏","text":"文帝令语：闻苏则又出军西定湟中，为河西作声势","evidence":["rensu-q-1deb67dbba4228bb801c"]},{"id":"rensu-a-3c81ee56edc9a7916e3f","label":"裴注·魏名臣奏","text":"张既答辞：金城昔为韩遂所见屠剥户不满五百，苏则到官内抚凋残、外鸠离散，今现户千余","evidence":["rensu-q-0cf05f92d4708205a1e0"]},{"id":"rensu-a-2a44f6d9e2e6a946f1e2","label":"裴注·魏名臣奏","text":"张既答辞：梁烧杂种羌昔与韩遂同恶、遂毙后越出障塞；苏则前后招怀，归就郡者三千余落","evidence":["rensu-q-e9fe3b81ca92b452e731"]},{"id":"rensu-a-48d679018b8907c4c8c1","label":"裴注·魏名臣奏","text":"张既答辞：西平麹演等倡造邪谋，苏则寻出军临其项领，演即归命送质，破绝贼粮","evidence":["rensu-q-1022c01121a0d0e69f41"]},{"id":"rensu-a-1bc3d2d781a7263cba22","label":"裴注·魏名臣奏","text":"张既答辞：苏则既有恤民之效又能和戎狄，若加爵邑诚足劝忠臣励风俗","evidence":["rensu-q-e5239f6008ca77124338"]}],"participants":[{"person":"wudi-p0170","role":"令问者","evidence":["rensu-q-2ce585223f687dd1d287"]},{"person":"wgc-p0068","role":"受问者；建言者","evidence":["rensu-q-2ce585223f687dd1d287","rensu-q-e5239f6008ca77124338"]},{"person":"wendi-p0010","role":"被议功加爵者；出军者；到官抚治者；招怀者；出军临讨者；所请加爵邑者","evidence":["rensu-q-2ce585223f687dd1d287","rensu-q-1deb67dbba4228bb801c","rensu-q-0cf05f92d4708205a1e0","rensu-q-e9fe3b81ca92b452e731","rensu-q-1022c01121a0d0e69f41","rensu-q-e5239f6008ca77124338"]},{"person":"wudi-p0048","role":"昔屠剥金城者","evidence":["rensu-q-0cf05f92d4708205a1e0"]},{"person":"wudi-p0342","role":"倡乱而归命送质者","evidence":["rensu-q-1022c01121a0d0e69f41"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["rensu-q-2ce585223f687dd1d287","rensu-q-1deb67dbba4228bb801c","rensu-q-0cf05f92d4708205a1e0","rensu-q-e9fe3b81ca92b452e731","rensu-q-1022c01121a0d0e69f41","rensu-q-e5239f6008ca77124338"]},"ordering_evidence":"rensu-q-2ce585223f687dd1d287","source_order":[16,62,12],"order":3403}],"persons":[{"id":"wendi-p0010","name":"苏则","facts":[],"aliases":[]},{"id":"wgc-p0068","name":"张既","facts":[],"aliases":[]},{"id":"wudi-p0048","name":"韩遂","facts":[],"aliases":[]},{"id":"wudi-p0170","name":"曹丕","facts":[],"aliases":[]},{"id":"wudi-p0342","name":"麴演","facts":[],"aliases":[]}],"evidence":[{"id":"rensu-q-0cf05f92d4708205a1e0","section":"chapter-016","block":"b-134322f702062bcfda6b","layer":"pei","quote":"金城郡，昔为韩遂所见屠剥，死丧流亡；或窜戎狄，或陷寇乱：户不满五百。则到官，内抚凋残，外鸠离散，今现户千余","attribution":"裴注·魏名臣奏","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":61,"anchor":null},"note_id":"n-f97bee5ed11ae5ac93c4","start":104,"end":157},{"id":"rensu-q-1022c01121a0d0e69f41","section":"chapter-016","block":"b-134322f702062bcfda6b","layer":"pei","quote":"西平麹演等，倡造邪谋，则寻出军，临其项领；演即归命送质，破绝贼粮","attribution":"裴注·魏名臣奏","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":61,"anchor":null},"note_id":"n-f97bee5ed11ae5ac93c4","start":207,"end":239},{"id":"rensu-q-1deb67dbba4228bb801c","section":"chapter-016","block":"b-134322f702062bcfda6b","layer":"pei","quote":"闻又出军西定湟中，为河西作声势","attribution":"裴注·魏名臣奏","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":61,"anchor":null},"note_id":"n-f97bee5ed11ae5ac93c4","start":44,"end":59},{"id":"rensu-q-2ce585223f687dd1d287","section":"chapter-016","block":"b-134322f702062bcfda6b","layer":"pei","quote":"文帝令，问雍州刺史张既曰：‘试守金城太守苏则，既有绥民平夷之功，闻又出军西定湟中，为河西作声势，吾甚嘉之。则之功效，为可加爵邑未邪？封爵重事，故以问卿。密白意，且勿宣露也","attribution":"裴注·魏名臣奏","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":61,"anchor":null},"note_id":"n-f97bee5ed11ae5ac93c4","start":12,"end":97},{"id":"rensu-q-e5239f6008ca77124338","section":"chapter-016","block":"b-134322f702062bcfda6b","layer":"pei","quote":"则既有恤民之效，又能和戎狄，尽忠效节。遭遇圣明，有功必录；若则加爵邑，诚足以劝忠臣，励风俗也","attribution":"裴注·魏名臣奏","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":61,"anchor":null},"note_id":"n-f97bee5ed11ae5ac93c4","start":240,"end":286},{"id":"rensu-q-e9fe3b81ca92b452e731","section":"chapter-016","block":"b-134322f702062bcfda6b","layer":"pei","quote":"又梁烧杂种羌，昔与遂同恶；遂毙之后，越出障塞。则前后招怀，归就郡者三千余落；皆恤以威恩，为官效用","attribution":"裴注·魏名臣奏","section_title":"任苏杜郑仓传第十六","source":{"file":"OEBPS/Text/titlepage_0037.xhtml","index":61,"anchor":null},"note_id":"n-f97bee5ed11ae5ac93c4","start":158,"end":206}],"profiles":{},"directory_counts":{}}
