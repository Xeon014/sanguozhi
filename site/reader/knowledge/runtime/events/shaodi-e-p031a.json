{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"shaodi-e-p031a","title":"虞松请录少康论钟会退而论次","accounts":[{"id":"shaodi-e-p031a-account","label":"《魏氏春秋》","text":"虞松请录少康论钟会退而论次","evidence":["shaodi-e-p031a-q"]}],"participants":[{"person":"shaodi-p0053","role":"请录","evidence":["shaodi-e-p031a-q"]},{"person":"shaodi-p0068","role":"答","evidence":["shaodi-e-p031a-q"]},{"person":"shaodi-p0073","role":"编次","evidence":["shaodi-e-p031a-q"]}],"place":null,"time":{"year":256,"label":"少康论辩后","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"shaodi-y256","dating_review":{"reviewed":true,"anchor":"shaodi-q-o080","basis":"少康论辩后"},"evidence":["shaodi-e-p031a-q","shaodi-q-o080","shaodi-q-o117","shaodi-q-b-6209c552405e0ebbdf98"]},"ordering_evidence":"shaodi-e-p031a-q","source_order":[4,399,"P031a"],"order":1165}],"persons":[{"id":"shaodi-p0053","name":"虞松","facts":[],"aliases":[]},{"id":"shaodi-p0068","name":"曹髦","facts":[],"aliases":[]},{"id":"shaodi-p0073","name":"钟会","facts":[],"aliases":[]}],"evidence":[{"id":"shaodi-e-p031a-q","section":"chapter-004","block":"b-027295b741ddd9b3bba6","layer":"pei","quote":"中书令松进曰：‘少康之事，去世久远，其文昧如；是以自古及今，议论之士莫有言者，德美隐而不宣。陛下既垂心远鉴，考详古昔；又发德音，赞明少康之美，使显于千载之上。宜录以成篇，永垂于后。’帝曰：‘吾学不博，所闻浅狭，惧于所论，未获其宜；纵有可采，亿则屡中，又不足贵；无乃致笑后贤，彰吾暗昧乎！’于是侍郎钟会，退论次焉。”","attribution":"《魏氏春秋》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":398,"anchor":null},"note_id":"n-be32dc82db4f0e2cc984","start":0,"end":157},{"id":"shaodi-q-b-6209c552405e0ebbdf98","section":"chapter-004","block":"b-6209c552405e0ebbdf98","layer":"modern","quote":"〖1〗二年：甘露二年（公元 257 ）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":535,"anchor":null},"note_id":"n-4dd98e402a6a8de51491","start":0,"end":20},{"id":"shaodi-q-o080","section":"chapter-004","block":"b-5e69a7d6a960c6ff6623","layer":"original","quote":"甘露元年春正月辛丑〖1〗，青龙现轵县井中〖2〗。乙巳〖3〗，沛王林薨〖4〗。