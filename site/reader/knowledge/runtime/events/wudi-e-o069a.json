{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o069a","title":"刘备杀车胄起兵","accounts":[{"id":"wudi-e-o069a-account","label":"正文","text":"刘备东行前曾暗与董承等合谋；到下邳后杀车胄，举兵屯沛，曹操遣刘岱、王忠进攻未胜。","evidence":["wudi-e-o069a-q"]},{"id":"xianzhu-e-o016b-account","label":"《先主传》正文","text":"刘备据下邳，朱灵等返回；刘备杀车胄，留关羽守下邳，自己回小沛。","evidence":["xianzhu-e-o016b-q"]},{"id":"chengguo-a-ce7efe2e02d7877e36ca","label":"正文","text":"刘备杀车胄举兵背曹操","evidence":["chengguo-q-57bb02c8bc8efe183f2e"]},{"id":"chengguo-a-730be3f405180eb5540f","label":"正文","text":"刘备杀车胄反","evidence":["chengguo-q-791bacb1947a88965eb8"]}],"participants":[{"person":"liu-bei","role":"合谋起兵","evidence":["wudi-e-o069a-q"]},{"person":"wudi-p0113","role":"合谋","evidence":["wudi-e-o069a-q"]},{"person":"wudi-p0165","role":"被杀","evidence":["wudi-e-o069a-q"]},{"person":"cao-cao","role":"遣将","evidence":["wudi-e-o069a-q"]},{"person":"wudi-p0166","role":"进攻未克","evidence":["wudi-e-o069a-q"]},{"person":"wudi-p0167","role":"进攻未克","evidence":["wudi-e-o069a-q"]},{"person":"wudi-p0172","role":"守下邳","evidence":["xianzhu-e-o016b-q"]},{"person":"wudi-p0164","role":"返回","evidence":["xianzhu-e-o016b-q"]}],"place":{"text":"下邳、沛","evidence":["wudi-e-o069a-q"]},"time":{"label":"建安四年","year":199,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o069a-q","wudi-q-o061","wudi-q-b-51bced16741add42ff70"],"chronology":"wudi-y199","dating_review":{"anchor":"wudi-q-o061","basis":"建安四年","reviewed":true}},"source_order":[1,367,"O069a"],"order":169}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"wudi-p0113","name":"董承","facts":[],"aliases":[]},{"id":"wudi-p0164","name":"朱灵","facts":[],"aliases":[]},{"id":"wudi-p0165","name":"车胄","facts":[],"aliases":[]},{"id":"wudi-p0166","name":"刘岱（字公山）","facts":[],"aliases":[]},{"id":"wudi-p0167","name":"王忠","facts":[],"aliases":[]},{"id":"wudi-p0172","name":"关羽","facts":[],"aliases":[]}],"evidence":[{"id":"chengguo-q-57bb02c8bc8efe183f2e","section":"chapter-014","block":"b-e9401b31a90b17c74409","layer":"original","quote":"备至徐州，遂杀车胄，举兵背太祖","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":33,"anchor":null},"note_id":null,"start":97,"end":112},{"id":"chengguo-q-791bacb1947a88965eb8","section":"chapter-014","block":"b-546398c9e99f491661e8","layer":"original","quote":"备到下邳，杀徐州刺史车胄，反。","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":178,"anchor":null},"note_id":null,"start":64,"end":79},{"id":"wudi-e-o069a-q","section":"chapter-001","block":"b-b951d04332712c30fc16","layer":"original","quote":"备之未东也，阴与董承等谋反。至下邳，遂杀徐州刺史车胄，举兵屯沛〖26〗。遣刘岱、王忠击之，不克。﹝一﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":366,"anchor":null},"note_id":null,"start":0,"end":51},{"id":"wudi-q-b-51bced16741add42ff70","section":"chapter-001","block":"b-51bced16741add42ff70","layer":"modern","quote":"〖1〗四年：建安四年（公元 199）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":369,"anchor":null},"note_id":"n-20628d34a709162c77f0","start":0,"end":19},{"id":"wudi-q-o061","section":"chapter-001","block":"b-502d4e8c0ed143eaa30d","layer":"original","quote":"四年春二月〖1〗，公还至昌邑〖2〗。张杨将杨丑杀杨〖3〗。眭固又杀丑，以其众属袁绍，屯射犬〖4〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":358,"anchor":null},"note_id":null,"start":0,"end":49},{"id":"xianzhu-e-o016b-q","section":"chapter-032","block":"b-b2ba16ddd29a37182478","layer":"original","quote":"先主据下邳，灵等还。先主乃杀徐州刺史车胄，留关羽守下邳，而身还小沛。﹝四﹞","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":71,"anchor":null},"note_id":null,"start":12,"end":49}],"profiles":{},"directory_counts":{}}
