{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"feipin-e-4c68ca37c49864def282","title":"陈寿论孙氏嫡庶与闺庭之乱","accounts":[{"id":"feipin-a-4c68ca37c49864def282","label":"陈寿评说","text":"陈寿论孙氏嫡庶与闺庭之乱","evidence":["feipin-q-ef21e0922ba733e0cc0f"]}],"participants":[],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["feipin-q-ef21e0922ba733e0cc0f"]},"ordering_evidence":"feipin-q-ef21e0922ba733e0cc0f","order":9110}],"persons":[],"evidence":[{"id":"feipin-q-ef21e0922ba733e0cc0f","section":"chapter-050","block":"b-e0adac9cc6a675efe8c1","layer":"original","quote":"评曰：《易》称“正家而天下定〖1〗”，《诗》云“刑于寡妻〖2〗，至于兄弟，以御于家邦〖3〗”：诚哉，是言也！远观齐桓，近察孙权，皆有识士之明，杰人之志；而嫡庶不分，闺庭错乱：遗笑古今，殃流后嗣。由是论之，惟以道义为心、平一为主者，然后克免斯累邪〖4〗！","section_title":"妃嫔传第五","source":{"file":"OEBPS/Text/titlepage_0107.xhtml","index":165,"anchor":null},"note_id":null,"start":0,"end":126}],"profiles":{},"directory_counts":{}}
