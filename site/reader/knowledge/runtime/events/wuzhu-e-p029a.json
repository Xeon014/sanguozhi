{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wuzhu-e-p029a","title":"孙权向曹丕陈称受恩愿忠","accounts":[{"id":"wuzhu-e-p029a-account","label":"《魏略》","text":"孙权向曹丕陈称受恩愿忠","evidence":["wuzhu-e-p029a-q"]}],"participants":[{"person":"sun-quan","role":"致笺","evidence":["wuzhu-e-p029a-q"]},{"person":"wudi-p0170","role":"受笺","evidence":["wuzhu-e-p029a-q"]}],"place":null,"time":{"label":"曹丕践阼后","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["wuzhu-e-p029a-q"]},"ordering_evidence":"wuzhu-e-p029a-q","source_order":[47,347,"P029a"],"order":8232}],"persons":[{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"wudi-p0170","name":"曹丕","facts":[],"aliases":[]}],"evidence":[{"id":"wuzhu-e-p029a-q","section":"chapter-047","block":"b-5f9748512e57c63b0c08","layer":"pei","quote":"又曰：‘权本性空薄，文武不昭；昔承父兄成军之绪，得为先王所见奖饰；遂因国恩，抚绥东土。而中间寡虑，庶事不明；畏威忘德，以取重戾。先王恩仁，不忍遐弃；既释其宿罪，且开明信。虽致命虏廷，枭获关羽；功效浅薄，未报万一。事业未究，先王即世。殿下践阼，威仁流迈；私惧情愿，未蒙昭察。梁寓来到，具知殿下不遂疏远，必欲抚录，追本先绪。权之得此，欣然踊跃，心开目明，不胜其庆。权世受宠遇，分义深笃；今日之事，永执一心。惟察\"\"，重垂含覆。’","attribution":"《魏略》","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":346,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-43467797fb37569f4074","start":0,"end":212,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
