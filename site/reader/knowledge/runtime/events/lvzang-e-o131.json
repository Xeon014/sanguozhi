{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"lvzang-e-o131","title":"旻对袁逢口陈手画西域诸国转拜长水校尉终太原太守","accounts":[{"id":"lvzang-a-34bb1ef01bbd3b365ecf","label":"裴注·后汉书（谢承）","text":"旻对袁逢口陈手画西域诸国转拜长水校尉终太原太守","evidence":["lvzang-q-10f0a8a1ede4398098fe"]}],"participants":[{"person":"sunshi-p0005","role":"还京师见太尉袁逢、具答言西域本三十六国后分为五十五稍散至百余国其国大小道里近远人数多少风俗燥湿山川草木鸟兽异物名种不与中国同者悉口陈其状手画地形、转拜长水校尉终太原太守","evidence":["lvzang-q-10f0a8a1ede4398098fe"]},{"person":"dongyuan-p0037","role":"太尉、问其西域诸国土地风俗人物种数、奇其才叹息言虽班固作西域传何以加此","evidence":["lvzang-q-10f0a8a1ede4398098fe"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["lvzang-q-10f0a8a1ede4398098fe"]},"ordering_evidence":"lvzang-q-10f0a8a1ede4398098fe","source_order":[7,163,99],"order":1876}],"persons":[{"id":"dongyuan-p0037","name":"袁逢","facts":[],"aliases":[]},{"id":"sunshi-p0005","name":"臧旻","facts":[],"aliases":[]}],"evidence":[{"id":"lvzang-q-10f0a8a1ede4398098fe","section":"chapter-007","block":"b-e2f3b3d6a80ec490e88c","layer":"pei","quote":"还京师，见太尉袁逢。逢问其西域诸国土地、风俗、人物、种数。旻具答言：西域本三十六国，后分为五十五，稍散至百余国。其国大小，道里近远，人数多少，风俗燥湿，山川、草木、鸟兽、异物名种，不与中国同者，悉口陈其状，手画地形。逢奇其才，叹息言：‘虽班固作《西域传》，何以加此？’旻转拜长水校尉，终太原太守","attribution":"裴注·后汉书（谢承）","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":162,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-3473eb9b61408b668d54","start":99,"end":246,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
