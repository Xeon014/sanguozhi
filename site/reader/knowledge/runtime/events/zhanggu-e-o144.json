{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhanggu-e-o144","title":"裴按权论魏主竟为无征","accounts":[{"id":"zhanggu-a-06e0c5685508fa8ccbab","label":"裴注·注家按语","text":"裴按权论魏主竟为无征","evidence":["zhanggu-q-3390d074a22b0c89707a"]}],"participants":[{"person":"shaodi-p0003","role":"评孙权论魏明帝无征而可鉴齐王世","evidence":["zhanggu-q-3390d074a22b0c89707a"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["zhanggu-q-3390d074a22b0c89707a"]},"ordering_evidence":"zhanggu-q-3390d074a22b0c89707a","source_order":[52,311,0],"order":9351}],"persons":[{"id":"shaodi-p0003","name":"裴松之","facts":[],"aliases":[]}],"evidence":[{"id":"zhanggu-q-3390d074a22b0c89707a","section":"chapter-052","block":"b-fc572d985bd355bac50a","layer":"pei","quote":"﹝一﹞臣松之以为：魏明帝一时明主，政自己出；孙权此论，竟为无征。而史载之者，将以主幼国疑，威柄不一，乱亡之形，有如权言，宜其存录，以为鉴戒；或当以虽失之于明帝，而事著于齐王。齐王之世，可不谓验乎！不敢显斥，抑足表之微辞。","attribution":"裴注·注家按语","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":310,"anchor":null},"note_id":"n-de84d9e9fd27066c532d","start":0,"end":110}],"profiles":{},"directory_counts":{}}
