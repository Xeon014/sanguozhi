{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p061a","title":"曹操上报官渡战果并列袁绍罪状","accounts":[{"id":"wudi-e-p061a-account","label":"《献帝起居注》所载曹操上言","text":"曹操上言追述袁绍、韩馥立刘虞及袁氏欲称帝之事，报告淳于琼等被斩、袁绍父子出逃和俘获战果。","evidence":["wudi-e-p061a-q"]}],"participants":[{"person":"cao-cao","role":"上报","evidence":["wudi-e-p061a-q"]},{"person":"wudi-p0052","role":"被指控","evidence":["wudi-e-p061a-q"]},{"person":"wudi-p0163","role":"败走","evidence":["wudi-e-p061a-q"]},{"person":"wudi-p0175","role":"被报斩首","evidence":["wudi-e-p061a-q"]}],"place":null,"time":{"label":"官渡胜后","year":200,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-p061a-q","wudi-q-o071","wudi-q-b-9900125064e5d85f08ad"],"chronology":"wudi-y200","dating_review":{"anchor":"wudi-q-o071","basis":"官渡胜后","reviewed":true}},"source_order":[1,454,"P061a"],"order":197}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0052","name":"袁绍","facts":[],"aliases":[]},{"id":"wudi-p0163","name":"袁谭","facts":[],"aliases":[]},{"id":"wudi-p0175","name":"淳于琼","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-p061a-q","section":"chapter-001","block":"b-346c577b4a71c73e6226","layer":"pei","quote":"﹝二﹞《献帝起居注》曰：“公上言：‘大将军邺侯袁绍，前与冀州牧韩馥立故大司马刘虞，刻作金玺；遣故任长毕瑜，诣虞，为说命录之数。又绍与臣书云：“可都鄄城，当有所立。”擅铸金银印，孝廉、计吏，皆往诣绍。从弟济阴太守叙，与绍书云：“今海内丧败，天意实在我家；神应有征，当在尊兄。南兄臣下欲使即位，南兄言：以年则北兄长，以位则北兄重；便欲送玺，会曹操断道。”绍宗族累世受国重恩，而凶逆无道，乃至于此。辄勒兵马，与战官渡；乘圣朝之威，得斩绍大将淳于琼等八人首，遂大破溃。绍与子谭轻身迸走。凡斩首七万余级，辎重财物巨亿。’”","attribution":"《献帝起居注》所载曹操上言","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":453,"anchor":null},"note_id":"n-3663cf74d422f76a0a08","start":0,"end":256},{"id":"wudi-q-b-9900125064e5d85f08ad","section":"chapter-001","block":"b-9900125064e5d85f08ad","layer":"modern","quote":"〖1〗五年：建安五年（公元 200）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":403,"anchor":null},"note_id":"n-744e4aee7f5ff14cca85","start":0,"end":19},{"id":"wudi-q-o071","section":"chapter-001","block":"b-c9f735ddad48a8f5c2b6","layer":"original","quote":"五年春正月〖1〗，董承等谋泄，皆伏诛。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":400,"anchor":null},"note_id":null,"start":0,"end":19}],"profiles":{},"directory_counts":{}}
