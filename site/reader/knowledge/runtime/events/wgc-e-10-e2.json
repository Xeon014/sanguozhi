{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wgc-e-10-e2","title":"蒋济评王凌父子","order":5468,"accounts":[{"id":"wgc-a-10-e2","label":"裴注·魏氏春秋","text":"蒋济评王凌父子","evidence":["wgc-q0549","wgc-q0095"]}],"participants":[{"person":"shaodi-p0009","role":"评凌文武俱赡当今无双、广等志力有美于父","evidence":["wgc-q0549","wgc-q0095"]},{"person":"wudi-p0364","role":"问人材","evidence":["wgc-q0549","wgc-q0095"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0549","wgc-q0095"]},"ordering_evidence":"wgc-q0549"}],"persons":[{"id":"shaodi-p0009","name":"蒋济","facts":[],"aliases":[]},{"id":"wudi-p0364","name":"司马懿","facts":[],"aliases":[]}],"evidence":[{"id":"wgc-q0095","section":"chapter-028","block":"b-1f42f395caf5c5623752","layer":"pei","quote":"﹝七﹞《魏氏春秋》曰：“广字公渊。弟飞枭、金虎，并才武过人。太傅尝从容问蒋济，济曰：‘凌文武俱赡，当今无双。广等志力，有美于父耳。’退而悔之，告所亲曰：‘吾此言，灭人门宗矣。’”《魏末传》曰：“凌少子，字明山。最知名。善书，多技艺；人得其书，皆以为法。走向太原，追军及之；时有飞鸟集桑树，随枝低昂，举弓射之即倒；追人乃止，不复进。明山投亲家食，亲家告吏，乃就执之。”","attribution":"魏氏春秋；魏末传","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":59,"anchor":null},"note_id":"n-5a364a62ecb0465162dc","start":0,"end":183},{"id":"wgc-q0549","section":"chapter-028","block":"b-1f42f395caf5c5623752","layer":"pei","quote":"太傅尝从容问蒋济，济曰：‘凌文武俱赡，当今无双。广等志力，有美于父耳","attribution":"裴注·魏氏春秋","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":59,"anchor":null},"note_id":"n-5a364a62ecb0465162dc","start":30,"end":64}],"profiles":{},"directory_counts":{}}
