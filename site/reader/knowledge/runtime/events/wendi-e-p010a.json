{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wendi-e-p010a","title":"曹丕素服于邺东门发哀","accounts":[{"id":"wendi-e-p010a-account","label":"裴注·魏书","text":"曹丕素服于邺东门发哀","evidence":["wendi-e-p010a-q"]},{"id":"wendi-a-p011-disputes","label":"裴注·孙盛曰","text":"孙盛批评曹丕哭城门不合礼，应于宗庙门外哭同姓。","evidence":["wendi-q-p011-disputes"]}],"participants":[{"person":"wudi-p0170","role":"发哀","evidence":["wendi-e-p010a-q"]}],"place":null,"time":{"year":220,"label":"夏侯惇薨后","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"wendi-y220","dating_review":{"reviewed":true,"anchor":"wendi-q-o002","basis":"夏侯惇薨后"},"evidence":["wendi-e-p010a-q","wendi-q-o002","wendi-q-o019","wendi-q-b-ec88012a7f6c352d0e04"]},"ordering_evidence":"wendi-e-p010a-q","source_order":[2,60,"P010a"],"order":490}],"persons":[{"id":"wudi-p0170","name":"曹丕","facts":[],"aliases":[]}],"evidence":[{"id":"wendi-e-p010a-q","section":"chapter-002","block":"b-99d6a2cf41a52504aeb3","layer":"pei","quote":"王素服幸邺东城门，发哀。","attribution":"裴注·魏书","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":59,"anchor":null},"note_id":"n-52dd8e913a82e52a69b3","start":10,"end":22},{"id":"wendi-q-b-ec88012a7f6c352d0e04","section":"chapter-002","block":"b-ec88012a7f6c352d0e04","layer":"modern","quote":"〖1〗二年：黄初二年（公元 221）。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":210,"anchor":null},"note_id":"n-8fff547b113ffa36bbc1","start":0,"end":19},{"id":"wendi-q-o002","section":"chapter-002","block":"b-1c3ea4f0ea338bf2ec5a","layer":"original","quote":"太祖崩，嗣位为丞相，魏王。﹝三﹞尊王后曰王太后〖5〗。改建安二十五年为延康元年。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":2,"anchor":null},"note_id":null,"start":0,"end":40},{"id":"wendi-q-o019","section":"chapter-002","block":"b-8820e5c7f9006d364c44","layer":"original","quote":"二年春正月〖1〗，郊祀天地、明堂〖2〗。甲戌〖3〗，校猎至原陵〖4〗。遣使者，以太牢祠汉世祖〖5〗。乙亥〖6〗，朝日于东郊〖7〗。﹝一﹞初令郡国口满十万者〖8〗，岁察孝廉一人；其有秀异〖9〗，无拘户口。辛巳〖10〗，分三公户邑，封子弟各一人为列侯。壬午〖11〗，复颍川郡一年田租〖12〗。﹝二﹞改许县为许昌县。以魏郡东部为阳平郡〖13〗，西部为广平郡〖14〗。﹝三﹞","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":208,"anchor":null},"note_id":null,"start":0,"end":183},{"id":"wendi-q-p011-disputes","section":"chapter-002","block":"b-16b1e3851f4ebc1f8823","layer":"pei","quote":"孙盛曰：“在礼，‘天子哭同姓于宗庙门之外’。哭于城门，失其所也。”","attribution":"裴注·孙盛曰","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":60,"anchor":null},"note_id":"n-52dd8e913a82e52a69b3","start":0,"end":33}],"profiles":{},"directory_counts":{}}
