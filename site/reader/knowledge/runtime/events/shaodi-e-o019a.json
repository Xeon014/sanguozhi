{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"shaodi-e-o019a","title":"立甄氏为皇后大赦","accounts":[{"id":"shaodi-e-o019a-account","label":"《三少帝纪》正文","text":"立甄氏为皇后大赦","evidence":["shaodi-e-o019a-q"]},{"id":"houfei-e-o032d-account","label":"《后妃传》正文","text":"齐王立后时：甄俨孙女为齐王皇后封其母广乐乡君","evidence":["houfei-e-o032d-q"]}],"participants":[{"person":"shaodi-p0010","role":"受立","evidence":["shaodi-e-o019a-q"]}],"place":null,"time":{"year":243,"label":"夏四月乙卯","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"shaodi-y243","dating_review":{"reviewed":true,"anchor":"shaodi-q-o018","basis":"夏四月乙卯"},"evidence":["shaodi-e-o019a-q","shaodi-q-o018","shaodi-q-b-1f82bc956ef2b05c2fd6"]},"ordering_evidence":"shaodi-e-o019a-q","source_order":[4,76,"O019a"],"order":1013}],"persons":[{"id":"shaodi-p0010","name":"甄皇后（曹芳后）","facts":[],"aliases":[]}],"evidence":[{"id":"houfei-e-o032d-q","section":"chapter-005","block":"b-9e951bfabd4d5de652fe","layer":"original","quote":"青龙中，又封后从兄子毅及像弟三人，皆为列侯。毅数上疏陈时政，官至越骑校尉〖24〗。嘉平中，复封畅子二人为列侯。后兄俨孙女，为齐王皇后；后父已没，封后母为广乐乡君。","section_title":"后妃传第五","source":{"file":"OEBPS/Text/titlepage_0015.xhtml","index":125,"anchor":null},"note_id":null,"start":0,"end":81},{"id":"shaodi-e-o019a-q","section":"chapter-004","block":"b-88e59339361f00dd04e1","layer":"original","quote":"夏四月，乙卯〖8〗，立皇后甄氏〖9〗。大赦。五月朔，日有食之，既〖10〗。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":75,"anchor":null},"note_id":null,"start":0,"end":37},{"id":"shaodi-q-b-1f82bc956ef2b05c2fd6","section":"chapter-004","block":"b-1f82bc956ef2b05c2fd6","layer":"modern","quote":"〖6〗四年：正始四年（公元243）。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":89,"anchor":null},"note_id":"n-de40b5693d22ad649e35","start":0,"end":18},{"id":"shaodi-q-o018","section":"chapter-004","block":"b-506c43889efc5c34fe4a","layer":"original","quote":"四年春正月〖6〗，帝加元服〖7〗。赐群臣各有差。","sect