{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wendi-e-p024b","title":"姜合向李伏张鲁陈说魏公子桓之谶","accounts":[{"id":"wendi-e-p024b-account","label":"裴注·献帝传","text":"姜合向李伏张鲁陈说魏公子桓之谶","evidence":["wendi-e-p024b-q"]}],"participants":[{"person":"wendi-p0069","role":"陈谶","evidence":["wendi-e-p024b-q"]},{"person":"wendi-p0068","role":"转述","evidence":["wendi-e-p024b-q"]},{"person":"wudi-p0279","role":"询问","evidence":["wendi-e-p024b-q"]}],"place":null,"time":{"label":"回叙初建魏国时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["wendi-e-p024b-q"]},"ordering_evidence":"wendi-e-p024b-q","source_order":[2,137,"P024b"],"order":509}],"persons":[{"id":"wendi-p0068","name":"李伏","facts":[],"aliases":[]},{"id":"wendi-p0069","name":"姜合","facts":[],"aliases":[]},{"id":"wudi-p0279","name":"张鲁","facts":[],"aliases":[]}],"evidence":[{"id":"wendi-e-p024b-q","section":"chapter-002","block":"b-8ce23de800ba4ed0cb49","layer":"pei","quote":"昔先王初建魏国，在境外者闻之未审，皆以为拜王。武都李庶姜合，羁旅汉中，谓臣曰：‘必为魏公，未便王也。定天下者，魏公子桓。神之所命，当合符谶，以应天人之位。’臣以合辞语镇南将军张鲁，鲁亦问合：‘知书所出？’合曰：‘孔子《玉版》也。天子历数，虽百世可知。’是后月余，有亡人来，写得册文，卒如合辞。","attribution":"裴注·献帝传","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":136,"anchor":null},"note_id":"n-fc6f9c6942b5c231c294","start":12,"end":158}],"profiles":{},"directory_counts":{}}
