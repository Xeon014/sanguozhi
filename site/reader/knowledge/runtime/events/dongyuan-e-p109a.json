{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dongyuan-e-p109a","title":"刘表受学王畅十七岁谏过俭","accounts":[{"id":"dongyuan-e-p109a-account","label":"谢承《后汉书》","text":"刘表受学王畅，以中庸谏王畅过俭，王畅答以矫俗。","evidence":["dongyuan-e-p109a-q"]}],"participants":[{"person":"liu-biao","role":"受学进谏","evidence":["dongyuan-e-p109a-q"]},{"person":"xunyu-p0005","role":"答问","evidence":["dongyuan-e-p109a-q"]}],"place":null,"time":{"label":"原文未明示时间","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-p109a-q"]},"ordering_evidence":"dongyuan-e-p109a-q","source_order":[6,469,"P109a"],"order":1749}],"persons":[{"id":"liu-biao","name":"刘表","facts":[],"aliases":[]},{"id":"xunyu-p0005","name":"王畅","facts":[],"aliases":[]}],"evidence":[{"id":"dongyuan-e-p109a-q","section":"chapter-006","block":"b-8c13365348655e1e7588","layer":"pei","quote":"表受学于同郡王畅。畅为南阳太守，行过乎俭。表时年十七，进谏曰：‘奢不僭上，俭不逼下，盖中庸之道；是故蘧伯玉耻独为君子。府君若不师孔圣之明训，而慕夷、齐之末操，无乃皎然自遗于世！’畅答曰：‘以约失之者，鲜矣。且以矫俗也。’","attribution":"谢承《后汉书》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":468,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-79d1d1dad564a618e84b","start":80,"end":190,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
