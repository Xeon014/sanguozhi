{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xinyang-e-7103aee95e7fab3c6fa7","title":"裴松之疑辛毗以帝譬张郃为诬","accounts":[{"id":"xinyang-a-7103aee95e7fab3c6fa7","label":"裴注·裴松之评论","text":"裴松之疑辛毗以帝譬张郃为诬","evidence":["xinyang-q-772493b0d24f50edee67"]}],"participants":[],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["xinyang-q-772493b0d24f50edee67"]},"ordering_evidence":"xinyang-q-772493b0d24f50edee67","related_events":[{"event":"xinyang-e-2ec229e98bffe057bac4","type":"disputes","evidence":["xinyang-q-772493b0d24f50edee67","xinyang-q-c92dbefde4e74f7252f7"]}],"order":5037},{"id":"xinyang-e-2ec229e98bffe057bac4","title":"魏略载张郃追诸葛亮死辛毗驳陈群惜将明帝笑","accounts":[{"id":"xinyang-a-2ec229e98bffe057bac4","label":"裴注·魏略","text":"魏略载张郃追诸葛亮死辛毗驳陈群惜将明帝笑","evidence":["xinyang-q-c92dbefde4e74f7252f7"]}],"participants":[{"person":"wudi-p0183","role":"追击阵亡","evidence":["xinyang-q-c92dbefde4e74f7252f7"]},{"person":"zhuge-liang","role":"退军","evidence":["xinyang-q-c92dbefde4e74f7252f7"]},{"person":"wudi-p0394","role":"答言","evidence":["xinyang-q-c92dbefde4e74f7252f7"]},{"person":"wudi-p0203","role":"反驳","evidence":["xinyang-q-c92dbefde4e74f7252f7"]},{"person":"wendi-p0005","role":"叹将答言","evidence":["xinyang-q-c92dbefde4e74f7252f7"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["xinyang-q-c92dbefde4e74f7252f7"]},"ordering_evidence":"xinyang-q-c92dbefde4e74f7252f7","related_events":[{"event":"xinyang-e-7103aee95e7fab3c6fa7","type":"disputes","evidence":["xinyang-q-772493b0d24f50edee67","xinyang-q-c92dbefde4e74f7252f7"]}],"order":5036}],"persons":[],"evidence":[{"id":"xinyang-q-772493b0d24f50edee67","section":"chapter-025","block":"b-33497dcc644c58fb24ea","layer":"pei","quote":"臣松之以为：拟人必于其伦，取譬宜引其类；故君子于其言，无所苟而已矣。毗欲弘广主意，当举若张辽之畴；安有于一将之死，而可以祖宗为譬哉？非所宜言，莫过于兹：进违其类，退似谄佞。佐治，刚正之体，不宜有此。《魏略》既已难信，习氏又从而载之，窃谓斯人受诬不少。","attribution":"裴注·裴松之评论","section_title":"辛毗杨阜高堂隆传第二十五","source":{"file":"OEBPS/Text/titlepage_0056.xhtml","index":118,"anchor":null},"note_id":"n-f9e400ca729810bb3e7e","start":0,"end":125},{"id":"xinyang-q-c92dbefde4e74f7252f7","section":"chapter-025","block":"b-47d909917c843a35cfa0","layer":"pei","quote":"﹝一﹞《魏略》曰：“诸葛亮围祁山，不克，引退。张郃追之，为流矢所中死。帝惜郃，临朝而叹曰：‘蜀未平而郃死，将若之何！’司空陈群曰：‘郃诚良将，国所依也。’毗心以为：郃虽可惜，然已死，不当内弱主意，而示外以不大也。乃持群曰：‘陈公，是何言欤！当建安之末，天下不可一日无武皇帝也；及委国祚，而文皇帝受命。黄初之世，亦谓不可无文皇帝也；及委弃天下，而陛下龙兴。今国内所少，岂张郃乎？’陈群曰：‘亦诚如辛毗言。’帝笑曰：‘陈公可谓善变矣。’”","attribution":"裴注·魏略","section_title":"辛毗杨阜高堂隆传第二十五","source":{"file":"OEBPS/Text/titlepage_0056.xhtml","index":117,"anchor":null},"note_id":"n-f9e400ca729810bb3e7e","start":0,"end":217}],"profiles":{},"directory_counts":{}}
