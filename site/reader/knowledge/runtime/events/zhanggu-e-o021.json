{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"zhanggu-e-o021","title":"权土塞昭门烧门载昭还宫","accounts":[{"id":"zhanggu-a-9cb527a4698b4155efbb","label":"正文","text":"权土塞昭门烧门载昭还宫","evidence":["zhanggu-q-aaedddf10f4639958d2c"]}],"participants":[{"person":"wendi-p0133","role":"忿言之不用称疾不朝、又于内以土封之、固不起、辞疾笃、更闭户、不得已然后朝会","evidence":["zhanggu-q-aaedddf10f4639958d2c"]},{"person":"sun-quan","role":"恨之土塞其门、渊果杀弥晏后数慰谢昭、因出过其门呼昭、烧其门欲以恐之、使人灭火住门良久、载昭以还宫深自克责","evidence":["zhanggu-q-aaedddf10f4639958d2c"]},{"person":"mingdi-p0013","role":"果杀弥晏者","evidence":["zhanggu-q-aaedddf10f4639958d2c"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["zhanggu-q-aaedddf10f4639958d2c"]},"ordering_evidence":"zhanggu-q-aaedddf10f4639958d2c","source_order":[52,58,0],"order":9265}],"persons":[{"id":"mingdi-p0013","name":"公孙渊","facts":[],"aliases":[]},{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"wendi-p0133","name":"张昭","facts":[],"aliases":[]}],"evidence":[{"id":"zhanggu-q-aaedddf10f4639958d2c","section":"chapter-052","block":"b-4ab1a47761cf8b2f341b","layer":"original","quote":"昭忿言之不用，称疾不朝。权恨之，土塞其门；昭又于内，以土封之。渊果杀弥、晏；权数慰谢昭，昭固不起〖22〗。权因出过其门，呼昭；昭辞疾笃〖23〗。权烧其门，欲以恐之；昭更闭户。权使人灭火，住门良久。昭诸子，共扶昭起；权载以还宫，深自克责。昭不得已，然后朝会","section_title":"张顾诸葛步传第七","source":{"file":"OEBPS/Text/titlepage_0111.xhtml","index":57,"anchor":null},"note_id":null,"start":0,"end":127}],"profiles":{},"directory_counts":{}}
