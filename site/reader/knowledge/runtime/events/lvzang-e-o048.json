{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"lvzang-e-o048","title":"太祖问宫宫答孝治仁施太祖养宫母嫁宫女","accounts":[{"id":"lvzang-a-b028f052057f1b2dd1e0","label":"正文","text":"太祖问宫宫答孝治仁施太祖养宫母嫁宫女","evidence":["lvzang-q-d7cc619e98f9ea2ff02d"]},{"id":"lvzang-a-70b802f05ef410e2d090","label":"裴注·典略","text":"下邳败宫对太祖请出就戮","evidence":["lvzang-q-dd8b5ca217c015e2ba70"]},{"id":"lvzang-a-b4983369e20393f527cd","label":"裴注·典略","text":"太祖泣送宫待其家厚如初","evidence":["lvzang-q-7bba6c2542cc03d4898c"]}],"participants":[{"person":"cao-cao","role":"之擒宫也、问宫欲活老母及女不、召养其母终其身、嫁其女；下邳败后皆见之与语平生、谓宫曰公台卿平常自谓智计有余今竟何如、笑曰今日之事当云何、曰卿如是奈卿老母何、曰若卿妻子何、未复言；泣而送之、宫死后待其家皆厚如初","evidence":["lvzang-q-d7cc619e98f9ea2ff02d","lvzang-q-dd8b5ca217c015e2ba70","lvzang-q-7bba6c2542cc03d4898c"]},{"person":"wudi-p0096","role":"对曰宫闻孝治天下者不绝人之亲仁施四海者不乏人之祀老母在公不在宫也；为布画策布每不从其计、顾指布曰但坐此人不从宫言以至于此若其见从亦未必为擒也、曰为臣不忠为子不孝死自分也、曰宫闻将以孝治天下者不害人之亲老母之存否在明公也、曰宫闻将施仁政于天下者不绝人之祀妻子之存否亦在明公也、曰请出就戮以明军法、遂趋出不可止；不还顾","evidence":["lvzang-q-d7cc619e98f9ea2ff02d","lvzang-q-dd8b5ca217c015e2ba70","lvzang-q-7bba6c2542cc03d4898c"]},{"person":"wudi-p0088","role":"军士所执之一、有求活之言","evidence":["lvzang-q-dd8b5ca217c015e2ba70"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["lvzang-q-d7cc619e98f9ea2ff02d","lvzang-q-dd8b5ca217c015e2ba70","lvzang-q-7bba6c2542cc03d4898c"]},"ordering_evidence":"lvzang-q-d7cc619e98f9ea2ff02d","source_order":[7,101,0],"order":1837}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0088","name":"吕布","facts":[],"aliases":[]},{"id":"wudi-p0096","name":"陈宫","facts":[],"aliases":[]}],"evidence":[{"id":"lvzang-q-7bba6c2542cc03d4898c","section":"chapter-007","block":"b-06f5b92881bcd273c2b0","layer":"pei","quote":"太祖泣而送之，宫不还顾。宫死后，太祖待其家皆厚如初","attribution":"裴注·典略","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":126,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-7c80a4dae2dae7a40081","start":323,"end":348,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-d7cc619e98f9ea2ff02d","section":"chapter-007","block":"b-30812d8adeccd65f6901","layer":"original","quote":"太祖之擒宫也，问宫：“欲活老母及女不？”宫对曰：“宫闻孝治天下者不绝人之亲〖12〗，仁施四海者不乏人之祀〖13〗；老母在公〖14〗，不在宫也。”太祖召养其母，终其身；嫁其女","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":100,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":86,"offset_unit":"unicode_code_point"},{"id":"lvzang-q-dd8b5ca217c015e2ba70","section":"chapter-007","block":"b-06f5b92881bcd273c2b0","layer":"pei","quote":"下邳败，军士执布及宫，太祖皆见之，与语平生，故布有求活之言。大祖谓宫曰：‘公台，卿平常自谓智计有余，今竟何如？’宫顾指布曰：‘但坐此人不从宫言，以至于此。若其见从，亦未必为擒也。’太祖笑曰：‘今日之事，当云何？’宫曰：‘为臣不忠，为子不孝；死，自分也！’太祖曰：‘卿如是，奈卿老母何？’宫曰：‘宫闻将以孝治天下者，不害人之亲；老母之存否，在明公也。’太祖曰：‘若卿妻子何？’宫曰：‘宫闻将施仁政于天下者，不绝人之祀；妻子之存否，亦在明公也。’太祖未复言。宫曰：‘请出就戮，以明军法！’遂趋出，不可止","attribution":"裴注·典略","section_title":"吕布张邈臧洪传第七","source":{"file":"OEBPS/Text/titlepage_0019.xhtml","index":126,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-7c80a4dae2dae7a40081","start":73,"end":322,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
