{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"sunshi-e-p055a","title":"九州春秋称孙策闻曹操北征自号大司马欲袭许而遇难","accounts":[{"id":"sunshi-e-p055a-account","label":"《九州春秋》","text":"九州春秋称孙策闻曹操北征自号大司马欲袭许而遇难","evidence":["sunshi-e-p055a-q"]}],"participants":[{"person":"wudi-p0099","role":"谋袭遇害","evidence":["sunshi-e-p055a-q"]}],"place":null,"time":{"label":"《九州春秋》所称曹操北征柳城时（与孙策卒年不合）","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["sunshi-e-p055a-q"]},"ordering_evidence":"sunshi-e-p055a-q","source_order":[46,284,"P055a"],"related_events":[{"event":"wudi-e-o078a","type":"alternative","evidence":["sunshi-e-p055a-q","wudi-e-o078a-q"]}],"order":8143},{"id":"wudi-e-o078a","title":"孙策谋袭许未发遇刺","accounts":[{"id":"wudi-e-o078a-account","label":"正文","text":"孙策闻曹袁相持而谋袭许，未出发即被刺客杀死。","evidence":["wudi-e-o078a-q"]},{"id":"sunshi-e-o034a-account","label":"《孙破虏讨逆传第一》正文","text":"孙策闻曹操袁绍官渡相拒密谋袭许未发遇害","evidence":["sunshi-e-o034a-q"]},{"id":"sunshi-a-p056-judgment","label":"孙盛《异同评》","text":"孙盛质疑孙策在当时形势下袭许迎帝说，支持伐陈登；并指出曹操征柳城在建安十二年，与孙策建安五年卒相矛盾。","evidence":["sunshi-q-p056-judgment"]},{"id":"sunshi-a-p057-judgment","label":"裴松之按语","text":"裴松之同驳柳城误年，但不同意孙盛否定袭许谋划；认为当先图陈登而志不止登，并以魏武纪官渡驻军驳时间疑问。","evidence":["sunshi-q-p057-judgment"]},{"id":"sunshi-e-o035c-account","label":"《孙破虏讨逆传第一》正文","text":"孙策其夜卒年二十六","evidence":["sunshi-e-o035c-q"]},{"id":"sunshi-e-p058a-account","label":"《吴历》","text":"吴历记孙策照镜捶几创裂当夜卒","evidence":["sunshi-e-p058a-q"]},{"id":"sunshi-e-p058b-account","label":"《搜神记》","text":"《搜神记》称孙策杀于吉后常见其幻象，照镜见于吉，扑镜创裂而死。","evidence":["sunshi-e-p058b-q"]},{"id":"chengguo-a-c01d14b4e8f3eb839892","label":"正文","text":"策临江未济果为许贡客所杀","evidence":["chengguo-q-cdb15e5b46ef7ecd2519"]}],"participants":[{"person":"wudi-p0099","role":"拟袭许而遇刺","evidence":["wudi-e-o078a-q"]},{"person":"cao-cao","role":"相拒","evidence":["sunshi-e-o034a-q"]},{"person":"wudi-p0052","role":"相拒","evidence":["sunshi-e-o034a-q"]}],"place":{"text":"许","evidence":