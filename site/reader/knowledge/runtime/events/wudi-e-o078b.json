{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o078b","title":"曹仁破刘备刘辟","accounts":[{"id":"wudi-e-o078b-account","label":"正文","text":"刘辟等叛应袁绍侵掠许下，袁绍使刘备援助，曹操遣曹仁击败，刘备退走、刘辟营屯被破。","evidence":["wudi-e-o078b-q"]},{"id":"xianzhu-e-o020c-account","label":"《先主传》正文","text":"曹操遣曹仁攻刘备，刘备返回袁绍军。","evidence":["xianzhu-e-o020c-q"]},{"id":"xiahoucao-e-o022a-account","label":"《诸夏侯曹传第九》正文","text":"曹仁论刘备新兵可破曹操遣骑破备复叛县","evidence":["xiahoucao-e-o022a-q"]}],"participants":[{"person":"wudi-p0116","role":"叛应侵掠","evidence":["wudi-e-o078b-q"]},{"person":"wudi-p0052","role":"遣援","evidence":["wudi-e-o078b-q"]},{"person":"liu-bei","role":"援助战败","evidence":["wudi-e-o078b-q"]},{"person":"cao-cao","role":"遣军","evidence":["wudi-e-o078b-q"]},{"person":"cao-ren","role":"破敌","evidence":["wudi-e-o078b-q"]}],"place":{"text":"汝南、许下","evidence":["wudi-e-o078b-q"]},"time":{"label":"建安五年","year":200,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o078b-q","wudi-q-o071","wudi-q-b-9900125064e5d85f08ad"],"chronology":"wudi-y200","dating_review":{"anchor":"wudi-q-o071","basis":"建安五年","reviewed":true}},"source_order":[1,435,"O078b"],"order":187}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"cao-ren","name":"曹仁","facts":[],"aliases":[]},{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"wudi-p0052","name":"袁绍","facts":[],"aliases":[]},{"id":"wudi-p0116","name":"刘辟","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-o078b-q","section":"chapter-001","block":"b-1a4793df0505fd3101f2","layer":"original","quote":"汝南降贼刘辟等，叛应绍，略许下〖1〗。绍使刘备助辟，公使曹仁击破之。备走，遂破辟屯。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":434,"anchor":null},"note_id":null,"start":23,"end":65},{"id":"wudi-q-b-9900125064e5d85f08ad","section":"chapter-001","block":"b-9900125064e5d85f08ad","layer":"modern","quote":"〖1〗五年：建安五年（公元 200）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":403,"anchor":null},"note_id":"n-744e4aee7f5ff14cca85","start":0,"end":19},{"id":"wudi-q-o071","section":"chapter-001","block":"b-c9f735ddad48a8f5c2b6","layer":"original","quote":"五年春正月〖1〗，董承等谋泄，皆伏诛。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":400,"anchor":null},"note_id":null,"start":0,"end":19},{"id":"xiahoucao-e-o022a-q","section":"chapter-009","block":"b-36cfff1e8c8cf56e720f","layer":"original","quote":"太祖与袁绍，久相持于官渡。绍遣刘备徇！强诸县〖1〗，多举众应之；自许以南，吏民不安。太祖以为忧。仁曰：“南方以大军方有目前急，其势不能相救；刘备以强兵临之，其背叛，固宜也。备新将绍兵，未能得其用，击之可破也。”太祖善其言，遂使将骑击备；破走之，仁尽复收诸叛县而还。","section_title":"诸夏侯曹传第九","source":{"file":"OEBPS/Text/titlepage_0023.xhtml","index":117,"anchor":null},"note_id":null,"start":0,"end":132},{"id":"xianzhu-e-o020c-q","section":"chapter-032","block":"b-b25bb3f6fa26f880ffc6","layer":"original","quote":"曹公遣曹仁将兵击先主。先主还绍军，","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":91,"anchor":null},"note_id":null,"start":49,"end":66}],"profiles":{},"directory_counts":{}}
