{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"liusima-e-o227","title":"功曹徐英尝自鞭郡小吏张既三十","accounts":[{"id":"liusima-a-80b4a0c8143857a3435a","label":"裴注·魏略","text":"功曹徐英尝自鞭郡小吏张既三十","evidence":["liusima-q-b9711b0ba19bb5a2dffe"]},{"id":"liusima-a-4778ba914427efeb910d","label":"裴注·魏略","text":"张既因醉欲亲狎徐英，英抗意不纳，由此不复进用；时人善既不挟旧怨而壮英之不挠","evidence":["liusima-q-b469798e518c1e211563"]}],"participants":[{"person":"liusima-p0031","role":"功曹，尝自鞭既三十；故抗意不纳，由此遂不复进用","evidence":["liusima-q-b9711b0ba19bb5a2dffe","liusima-q-b469798e518c1e211563"]},{"person":"wgc-p0068","role":"为郡小吏，被鞭三十；虽得志亦不顾计本原，犹欲与英和，尝因醉欲亲狎英","evidence":["liusima-q-b9711b0ba19bb5a2dffe","liusima-q-b469798e518c1e211563"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["liusima-q-b9711b0ba19bb5a2dffe","liusima-q-b469798e518c1e211563"]},"ordering_evidence":"liusima-q-b9711b0ba19bb5a2dffe","source_order":[15,201,10],"order":3330}],"persons":[{"id":"liusima-p0031","name":"徐英","facts":[],"aliases":[]},{"id":"wgc-p0068","name":"张既","facts":[],"aliases":[]}],"evidence":[{"id":"liusima-q-b469798e518c1e211563","section":"chapter-015","block":"b-a820ee6f77d959dc4d2f","layer":"pei","quote":"既虽得志，亦不顾计本原，犹欲与英和。尝因醉，欲亲狎英；英故抗意，不纳。英由此遂不复进用。故时人善既不挟旧怨，而壮英之不挠","attribution":"裴注·魏略","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":200,"anchor":null},"note_id":"n-64a9cd2d8174aae4cbce","start":87,"end":147},{"id":"liusima-q-b9711b0ba19bb5a2dffe","section":"chapter-015","block":"b-a820ee6f77d959dc4d2f","layer":"pei","quote":"初，既为郡小吏。功曹徐英，尝自鞭既三十","attribution":"裴注·魏略","section_title":"刘司马梁张温贾传第十五","source":{"file":"OEBPS/Text/titlepage_0035.xhtml","index":200,"anchor":null},"note_id":"n-64a9cd2d8174aae4cbce","start":10,"end":29}],"profiles":{},"directory_counts":{}}
