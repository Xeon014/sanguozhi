{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o043b","title":"董昭劝迁都许","accounts":[{"id":"wudi-e-o043b-account","label":"正文","text":"洛阳残破，董昭等劝曹操迁都许。","evidence":["wudi-e-o043b-q"]},{"id":"chengguo-a-892854b4e8f4a491ab0a","label":"正文","text":"太祖问计昭建议移驾幸许","evidence":["chengguo-q-d8a838e52bd75f4c5be9"]}],"participants":[{"person":"wudi-p0122","role":"劝迁","evidence":["wudi-e-o043b-q"]},{"person":"cao-cao","role":"受劝","evidence":["wudi-e-o043b-q"]}],"place":{"text":"洛阳、许","evidence":["wudi-e-o043b-q"]},"time":{"label":"建安元年","year":196,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o043b-q","wudi-q-o040","wudi-q-b-16a5462151b1cfe5142d"],"chronology":"wudi-y196","dating_review":{"anchor":"wudi-q-o040","basis":"建安元年","reviewed":true}},"source_order":[1,262,"O043b"],"order":122}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0122","name":"董昭","facts":[],"aliases":[]}],"evidence":[{"id":"chengguo-q-d8a838e52bd75f4c5be9","section":"chapter-014","block":"b-089f6b5dc0e8a9b3cd1e","layer":"original","quote":"太祖朝天子于洛阳，引昭并坐。问曰：“今孤来此，当施何计？”昭曰：“将军兴义兵以诛暴乱，入朝天子，辅翼王室，此五伯之功也〖1〗。此下诸将〖2〗，人殊意异，未必服从；今留匡弼，事势不便，惟有移驾幸许耳。然朝廷播越〖3〗，新还旧京；远近跂望〖4〗，冀一朝获安：今复徙驾，不厌众心〖5〗。夫行非常之事，乃有非常之功，愿将军算其多者。”太祖曰：“此孤本志也。杨奉近在梁耳，闻其兵精，得无为孤累乎？”昭曰：“奉少党援，将独委质。镇东、费亭之事〖6〗，皆奉所定；又闻书命申束〖7〗，足以见信。宜时遣使，厚遗答谢〖8〗，以安其意，说：‘京都无粮，欲车驾暂幸鲁阳；鲁阳近许，转运稍易，可无悬乏之忧〖9〗。’奉为人勇而寡虑，必不见疑","section_title":"程郭董刘蒋刘传第十四","source":{"file":"OEBPS/Text/titlepage_0033.xhtml","index":176,"anchor":null},"note_id":null,"start":0,"end":306},{"id":"wudi-e-o043b-q","section":"chapter-001","block":"b-db9622d15d0b32d20b90","layer":"original","quote":"洛阳残破，董昭等劝太祖都许〖13〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":261,"anchor":null},"note_id":null,"start":71,"end":89},{"id":"wudi-q-b-16a5462151b1cfe5142d","section":"chapter-001","block":"b-16a5462151b1cfe5142d","layer":"modern","quote":"〖1〗建安元年：公元 196 年。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":264,"anchor":null},"note_id":"n-df2756e12f4ac1fef3c4","start":0,"end":17},{"id":"wudi-q-o040","section":"chapter-001","block":"b-c71d10ef121af30ac6b7","layer":"original","quote":"建安元年春正月〖1〗，太祖军临武平〖2〗。袁术所置陈相袁嗣，降。太祖将迎天子，诸将或疑；荀彧、程昱劝之。乃遣曹洪将兵西迎。卫将军董承与袁术将苌奴拒险〖3〗，洪不得进。汝南、颍川黄巾何仪、刘辟、黄邵、何曼等〖4〗，众各数万。初应袁术，又附孙坚〖5〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":258,"anchor":null},"note_id":null,"start":0,"end":124}],"profiles":{},"directory_counts":{}}
