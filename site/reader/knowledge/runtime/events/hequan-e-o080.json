{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"hequan-e-o080","title":"权诏褒岱平乱忠武益著","accounts":[{"id":"hequan-a-7dc0e521c2e7d37f0be6","label":"正文","text":"权诏褒岱平乱忠武益著","evidence":["hequan-q-4d9ad9af97486cf61656"]}],"participants":[{"person":"sun-quan","role":"诏褒岱厉负险自致枭首、桓凶狡反覆非君规略谁能枭之、忠武之节于是益著、国家永无南顾之虞、赏不逾月君其裁之","evidence":["hequan-q-4d9ad9af97486cf61656"]},{"person":"wuzhu-p0086","role":"被褒者","evidence":["hequan-q-4d9ad9af97486cf61656"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"本批仅记录原文时间表达，不由相邻纪年推算公元年。","evidence":["hequan-q-4d9ad9af97486cf61656"]},"ordering_evidence":"hequan-q-4d9ad9af97486cf61656","source_order":[60,191,0],"order":10621}],"persons":[{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"wuzhu-p0086","name":"吕岱","facts":[],"aliases":[]}],"evidence":[{"id":"hequan-q-4d9ad9af97486cf61656","section":"chapter-060","block":"b-765b85756e6171421c23","layer":"original","quote":"权诏岱曰：“厉负险作乱，自致枭首。桓凶狡反覆，已降复叛；前后讨伐，历年不擒。非君规略，谁能枭之？忠武之节，于是益著。元恶既除，大小震慑；其余细类，扫地族矣〖18〗！自今以去〖19〗，国家永无南顾之虞，三郡晏然无怵惕之惊〖20〗；又得恶民以供赋役：重用叹息〖21〗。赏不逾月，国之常典；制度所宜，君其裁之","section_title":"贺全吕周钟离传第十五","source":{"file":"OEBPS/Text/titlepage_0127.xhtml","index":190,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":151,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
