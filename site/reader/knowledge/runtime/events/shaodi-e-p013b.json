{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"shaodi-e-p013b","title":"陈泰请并州讨胡二郡惊反司马师再引咎","accounts":[{"id":"shaodi-e-p013b-account","label":"《汉晋春秋》","text":"陈泰请并州讨胡二郡惊反司马师再引咎","evidence":["shaodi-e-p013b-q"]}],"participants":[{"person":"shaodi-p0046","role":"请讨","evidence":["shaodi-e-p013b-q"]},{"person":"shaodi-p0038","role":"从议引咎","evidence":["shaodi-e-p013b-q"]}],"place":null,"time":{"year":252,"label":"东关败后","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"shaodi-y252","dating_review":{"reviewed":true,"anchor":"shaodi-q-o052","basis":"东关败后"},"evidence":["shaodi-e-p013b-q","shaodi-q-o052","shaodi-q-b-20272e7cc5379b3fe346"]},"ordering_evidence":"shaodi-e-p013b-q","source_order":[4,238,"P013b"],"order":1091}],"persons":[{"id":"shaodi-p0038","name":"司马师","facts":[],"aliases":[]},{"id":"shaodi-p0046","name":"陈泰","facts":[],"aliases":[]}],"evidence":[{"id":"shaodi-e-p013b-q","section":"chapter-004","block":"b-e0d2979abcf13f87f304","layer":"pei","quote":"﹝二﹞《汉晋春秋》曰：“毌丘俭、王昶闻东军败，各烧屯走。朝议欲贬黜诸将，景王曰：‘我不听公休，以至于此。此我过也！诸将何罪？’悉原之。时司马文王为监军，统诸军；唯削文王爵而已。是岁，雍州刺史陈泰求敕并州，并力讨胡，景王从之。未集，而雁门、新兴二郡以为将远役，遂惊反。景王又谢朝士曰：‘此我过也，非玄伯之责！’于是魏人愧悦，人思其报。”","attribution":"《汉晋春秋》","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":237,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-b26599b45ae85dc080dd","start":0,"end":167,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-b-20272e7cc5379b3fe346","section":"chapter-004","block":"b-20272e7cc5379b3fe346","layer":"modern","quote":"〖17〗四年：嘉平四年（公元252）。癸卯：旧历初二日。","section_title":"三少帝纪第四","source":{"file":"OEBPS/Text/titlepage_0013_split_000.xhtml","index":230,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-db96ad991a403b6a010e","start":0,"end":28,"offset_unit":"unicode_code_point"},{"id":"shaodi-q-o052","se