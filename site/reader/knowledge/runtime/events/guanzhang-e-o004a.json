{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"guanzhang-e-o004a","title":"曹操遣张辽问关羽去意","accounts":[{"id":"guanzhang-e-o004a-account","label":"《关张马黄赵传第六》正文","text":"曹操遣张辽问关羽去意","evidence":["guanzhang-e-o004a-q"]},{"id":"guanzhang-a-p003-judgment","label":"《傅子》","text":"《傅子》载张辽权衡后报告，曹操赞关羽不忘其本。","evidence":["guanzhang-q-p003-judgment"]}],"participants":[{"person":"cao-cao","role":"询问","evidence":["guanzhang-e-o004a-q"]},{"person":"wudi-p0178","role":"问答","evidence":["guanzhang-e-o004a-q"]},{"person":"wudi-p0172","role":"明志","evidence":["guanzhang-e-o004a-q"]}],"place":null,"time":{"label":"关羽在曹营至归刘备","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["guanzhang-e-o004a-q"]},"ordering_evidence":"guanzhang-e-o004a-q","source_order":[36,11,"O004a"],"order":6845}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0172","name":"关羽","facts":[],"aliases":[]},{"id":"wudi-p0178","name":"张辽","facts":[],"aliases":[]}],"evidence":[{"id":"guanzhang-e-o004a-q","section":"chapter-036","block":"b-059db639660483f35247","layer":"original","quote":"初，曹公壮羽为人，而察其心神无久留之意。谓张辽曰：“卿试以情问之。”既而辽以问羽，羽叹曰：“吾极知曹公待我厚；然吾受刘将军厚恩，誓以共死，不可背之，吾终不留；吾要当立效〖3〗，以报曹公，乃去。”辽以羽言报曹公，曹公义之。","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":10,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":110,"offset_unit":"unicode_code_point"},{"id":"guanzhang-q-p003-judgment","section":"chapter-036","block":"b-891f47d70e2a81102468","layer":"pei","quote":"﹝二﹞《傅子》曰：“辽欲白太祖，恐太祖杀羽；不白，非事君之道，乃叹曰：‘公，君父也；羽，兄弟耳！’遂白之。太祖曰：‘事君不忘其本，天下义士也！度何时能去？’辽曰：‘羽受公恩，必立效报公，而后去也。’”","attribution":"《傅子》","section_title":"关张马黄赵传第六","source":{"file":"OEBPS/Text/titlepage_0078.xhtml","index":19,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-d356f619240f1950d77b","start":0,"end":100,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
