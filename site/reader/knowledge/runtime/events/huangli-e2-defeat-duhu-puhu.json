e":"交战","evidence":["wudi-e-o195a-q"]},{"person":"xianzhu-p0051","role":"进攻","evidence":["xianzhu-e-o048a-q"]},{"person":"xianzhu-p0069","role":"战死","evidence":["xianzhu-e-o048a-q"]},{"person":"xianzhu-p0046","role":"请击","evidence":["pangfa-e-o024a-q"]},{"person":"wudi-p0183","role":"拒战不利","evidence":["xiahoucao-e-o019a-q"]},{"person":"cao-cao","role":"还邺，留夏侯渊拒刘备","evidence":["mantian-q-60ee42f505cc336d697b"]},{"person":"mingdi-p0100","role":"被留为渊司马","evidence":["mantian-q-60ee42f505cc336d697b"]}],"place":{"text":"阳平","evidence":["wudi-e-o195a-q"]},"time":{"label":"建安二十四年","year":219,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o195a-q","wudi-q-o194","wudi-q-b-1e7ae1441471aa22d204"],"chronology":"wudi-y219","dating_review":{"anchor":"wudi-q-o194","basis":"建安二十四年","reviewed":true}},"source_order":[1,1099,"O195a"],"related_events":[{"event":"huangli-e2-defeat-duhu-puhu","type":"related","evidence":["huangli-q2-8ec763646120744b2ac2","wudi-e-o195a-q"]},{"event":"huangli-e2-occupy-hanzhong","type":"related","evidence":["huangli-q2-8ec763646120744b2ac2","wudi-e-o195a-q"]}],"order":424}],"persons":[{"id":"wudi-p0348","name":"朴胡","facts":[],"aliases":[]},{"id":"wudi-p0349","name":"杜濩","facts":[],"aliases":[]}],"evidence":[{"id":"huangli-q-4f391fe6950149b60fdc","section":"chapter-043","block":"b-b937b741ffd9fc15238b","layer":"original","quote":"然卒破杜濩、朴胡〖2〗，杀夏侯渊，据汉中：皆权本谋也","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":10,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":80,"end":106,"offset_unit":"unicode_code_point"},{"id":"huangli-q2-8ec763646120744b2ac2","section":"chapter-043","block":"b-b937b741ffd9fc15238b","layer":"original","quote":"先主假权偏将军。﹝一﹞及曹公破张鲁，鲁走入巴中。权进曰：“若失汉中，则三巴不振〖1〗，此为割蜀之股臂也！”于是先主以权为护军，率诸将迎鲁；鲁已还南郑，北降曹公。然卒破杜濩、朴胡〖2〗，杀夏侯渊，据汉中：皆权本谋也。","section_title":"黄李吕马王张传第十三","source":{"file":"OEBPS/Text/titlepage_0092.xhtml","index":10,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":107,"offset_unit":"unicode_code_point"},{"id":"wudi-e-o195a-q","section":"chapter-001","block":"b-a6c4894727ead1cc5e5d","layer":"original","quote":"夏侯渊与刘备战于阳平，为备所杀。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":423,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":16,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
