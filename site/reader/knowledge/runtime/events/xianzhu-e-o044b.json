{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"xianzhu-e-o044b","title":"吕蒙袭夺荆州三郡","accounts":[{"id":"xianzhu-e-o044b-account","label":"《先主传》正文","text":"孙权命吕蒙袭夺长沙、零陵、桂阳。","evidence":["xianzhu-e-o044b-q"]},{"id":"zhouyu-e-o058a-account","label":"《周瑜鲁肃吕蒙传》正文","text":"刘备得益州后：孙权求三郡刘备不许遣吕蒙进取","evidence":["zhouyu-e-o058a-q"]},{"id":"zhouyu-e-o081a-account","label":"《周瑜鲁肃吕蒙传》正文","text":"取三郡时：孙权命吕蒙取长沙零桂二郡归服零陵拒守","evidence":["zhouyu-e-o081a-q"]},{"id":"wuzhu-e-o027a-account","label":"《吴主传第二》正文","text":"孙权遣吕蒙督鲜于丹徐忠孙规取三郡鲁肃拒关羽","evidence":["wuzhu-e-o027a-q"]}],"participants":[{"person":"sun-quan","role":"遣军","evidence":["xianzhu-e-o044b-q"]},{"person":"lu-meng","role":"袭夺","evidence":["xianzhu-e-o044b-q"]},{"person":"liu-bei","role":"拒郡","evidence":["zhouyu-e-o058a-q"]},{"person":"wuzhu-p0011","role":"出军","evidence":["wuzhu-e-o027a-q"]},{"person":"wuzhu-p0012","role":"出军","evidence":["wuzhu-e-o027a-q"]},{"person":"zhouyu-p0052","role":"出军","evidence":["wuzhu-e-o027a-q"]},{"person":"lu-su","role":"拒守","evidence":["wuzhu-e-o027a-q"]}],"place":{"text":"长沙、零陵、桂阳","evidence":["xianzhu-e-o044b-q"]},"time":{"year":215,"label":"建安二十年","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"xianzhu-y215","dating_review":{"reviewed":true,"anchor":"xianzhu-q-o044","basis":"建安二十年"},"evidence":["xianzhu-e-o044b-q","xianzhu-q-o044","xianzhu-q-b-e74ba7effc86126dc3fe"]},"source_order":[32,200,"O044b"],"order":6575}],"persons":[{"id":"liu-bei","name":"刘备","facts":[],"aliases":[]},{"id":"lu-meng","name":"吕蒙","facts":[],"aliases":[]},{"id":"lu-su","name":"鲁肃","facts":[],"aliases":[]},{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"wuzhu-p0011","name":"鲜于丹","facts":[],"aliases":[]},{"id":"wuzhu-p0012","name":"徐忠","facts":[],"aliases":[]},{"id":"zhouyu-p0052","name":"孙规","facts":[],"aliases":[]}],"evidence":[{"id":"wuzhu-e-o027a-q","section":"chapter-047","block":"b-1c7d099f67169d9f1682","layer":"original","quote":"权大怒，乃遣吕蒙督鲜于丹、徐忠、孙规等兵二万，取长沙、零陵、桂阳三郡；使鲁肃以万人屯巴丘〖6〗，﹝一﹞以御关羽；权住陆口，为诸军节度〖7〗。","section_title":"吴主传第二","source":{"file":"OEBPS/Text/titlepage_0101_split_000.xhtml","index":125,"anchor":null},"note_id":null,"start":0,"end":70},{"id":"xianzhu-e-o044b-q","section":"chapter-032","block":"b-fcd99756379fb59ed6f5","layer":"original","quote":"乃遣吕蒙袭夺长沙、零陵、桂阳三郡〖3〗。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":199,"anchor":null},"note_id":null,"start":52,"end":72},{"id":"xianzhu-q-b-e74ba7effc86126dc3fe","section":"chapter-032","block":"b-e74ba7effc86126dc3fe","layer":"modern","quote":"〖1〗二十年：建安二十年（公元 215）。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":212,"anchor":null},"note_id":"n-5302047b97c4e4d2cb00","start":0,"end":21},{"id":"xianzhu-q-o044","section":"chapter-032","block":"b-fcd99756379fb59ed6f5","layer":"original","quote":"二十年〖1〗，孙权以先主已得益州，使使报“欲得荆州〖2〗”。先主言：“须得凉州，当以荆州相与。”权忿之，乃遣吕蒙袭夺长沙、零陵、桂阳三郡〖3〗。先主引兵五万下公安，令关羽入益阳〖4〗。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":199,"anchor":null},"note_id":null,"start":0,"end":92},{"id":"zhouyu-e-o058a-q","section":"chapter-054","block":"b-20eaf3786f782c63ee9e","layer":"original","quote":"备既定益州，权求长沙、零、桂；备不承旨〖8〗，权遣吕蒙率众进取。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":279,"anchor":null},"note_id":null,"start":0,"end":32},{"id":"zhouyu-e-o081a-q","section":"chapter-054","block":"b-82ba5f92bc12b49d8842","layer":"original","quote":"是时刘备令关羽镇守，专有荆土。权命蒙西取长沙、零、桂三郡。蒙移书二郡，望风归服；惟零陵太守郝普〖1〗，城守不降。","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":380,"anchor":null},"note_id":null,"start":0,"end":56}],"profiles":{},"directory_counts":{}}
