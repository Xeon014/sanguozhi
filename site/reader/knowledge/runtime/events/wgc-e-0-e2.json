{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wgc-e-0-e2","title":"李傕郭汜入长安杀王允","order":5412,"accounts":[{"id":"wgc-a-0-e2","label":"正文","text":"李傕郭汜入长安杀王允","evidence":["wgc-q0143","wgc-q0001"]}],"participants":[{"person":"wudi-p0089","role":"为董卓报仇领兵入长安","evidence":["wgc-q0143","wgc-q0001"]},{"person":"wudi-p0090","role":"为董卓报仇领兵入长安","evidence":["wgc-q0143","wgc-q0001"]},{"person":"wudi-p0087","role":"被害者","evidence":["wgc-q0143","wgc-q0001"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"原纪年逐项对读；不从邻段继承绝对年份。","evidence":["wgc-q0143","wgc-q0001"]},"ordering_evidence":"wgc-q0143"}],"persons":[{"id":"wudi-p0087","name":"王允","facts":[],"aliases":[]},{"id":"wudi-p0089","name":"李傕","facts":[],"aliases":[]},{"id":"wudi-p0090","name":"郭汜","facts":[],"aliases":[]}],"evidence":[{"id":"wgc-q0001","section":"chapter-028","block":"b-896a3eb8d1574d15437e","layer":"original","quote":"王凌字彦云，太原祁人也〖1〗。叔父允〖2〗，为汉司徒，诛董卓。卓将李傕、郭汜等为卓报仇〖3〗，入长安，杀允，尽害其家。凌及兄晨，时年皆少；逾城得脱，亡命归乡里。凌举孝廉，为发干长。﹝一﹞稍迁至中山太守，所在有治。","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":1,"anchor":null},"note_id":null,"start":0,"end":106},{"id":"wgc-q0143","section":"chapter-028","block":"b-896a3eb8d1574d15437e","layer":"original","quote":"卓将李傕、郭汜等为卓报仇〖3〗，入长安，杀允，尽害其家","section_title":"王毌丘诸葛邓钟传第二十八","source":{"file":"OEBPS/Text/titlepage_0062.xhtml","index":1,"anchor":null},"note_id":null,"start":31,"end":58}],"profiles":{},"directory_counts":{}}
