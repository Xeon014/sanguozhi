{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-o051a","title":"袁术告称帝而与吕布交战","accounts":[{"id":"wudi-e-o051a-account","label":"正文","text":"袁术欲称帝并告吕布，吕布拘使上书；袁术怒而攻吕布，反被击败。","evidence":["wudi-e-o051a-q"]}],"participants":[{"person":"wudi-p0057","role":"告帝号进攻","evidence":["wudi-e-o051a-q"]},{"person":"wudi-p0088","role":"拘使迎战","evidence":["wudi-e-o051a-q"]}],"place":{"text":"淮南","evidence":["wudi-e-o051a-q"]},"time":{"label":"建安二年","year":197,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-o051a-q","wudi-q-o050","wudi-q-b-40d8b7057f4a29d6fe0d"],"chronology":"wudi-y197","dating_review":{"anchor":"wudi-q-o050","basis":"建安二年","reviewed":true}},"source_order":[1,300,"O051a"],"order":136}],"persons":[{"id":"wudi-p0057","name":"袁术","facts":[],"aliases":[]},{"id":"wudi-p0088","name":"吕布","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-o051a-q","section":"chapter-001","block":"b-872c42b00681ea538e76","layer":"original","quote":"袁术欲称帝于淮南〖10〗，使人告吕布。布收其使〖11〗，上其书。术怒，攻布，为布所破。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":299,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":43,"offset_unit":"unicode_code_point"},{"id":"wudi-q-b-40d8b7057f4a29d6fe0d","section":"chapter-001","block":"b-40d8b7057f4a29d6fe0d","layer":"modern","quote":"〖3〗二年：建安二年（公元 197）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":305,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-de6807349faf5c41a470","start":0,"end":19,"offset_unit":"unicode_code_point"},{"id":"wudi-q-o050","section":"chapter-001","block":"b-c2d0fc350fb933237a70","layer":"original","quote":"二年春正月〖3〗，公到宛〖4〗。张绣降，既而悔之，复反。公与战，军败，为流矢所中。长子昂、弟子安民遇害〖5〗。﹝一﹞公乃引兵还舞阴〖6〗，绣将骑来抄〖7〗。公击破之，绣奔穰〖8〗，与刘表合。公谓诸将曰：“吾降张绣等，失不便取其质〖9〗，以至于此。吾知所以败。诸卿观之：自今以后，不复败矣！”遂还许。﹝二﹞","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":298,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":152,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
