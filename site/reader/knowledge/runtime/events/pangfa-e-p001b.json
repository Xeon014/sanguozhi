{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"pangfa-e-p001b","title":"司马徽访庞德公家相待如亲","accounts":[{"id":"pangfa-e-p001b-account","label":"《襄阳记》","text":"《襄阳记》记司马徽访庞德公家，闻徐庶称有客将至，令其家人作黍相待。","evidence":["pangfa-e-p001b-q"]}],"participants":[{"person":"zhuge-p0014","role":"访友","evidence":["pangfa-e-p001b-q"]},{"person":"pangfa-p0003","role":"会见","evidence":["pangfa-e-p001b-q"]}],"place":null,"time":{"label":"庞德公渡沔祭墓时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["pangfa-e-p001b-q"]},"ordering_evidence":"pangfa-e-p001b-q","source_order":[37,23,"P001b"],"order":6956}],"persons":[{"id":"pangfa-p0003","name":"庞德公","facts":[],"aliases":[]},{"id":"zhuge-p0014","name":"司马徽","facts":[],"aliases":[]}],"evidence":[{"id":"pangfa-e-p001b-q","section":"chapter-037","block":"b-67cdb392b3293b4195ae","layer":"pei","quote":"德操尝造德公，值其渡沔，上祀先人墓；德操径入其室，呼德公妻子，使速作黍：‘徐元直向云有客当来，就我与庞公谈。’其妻子皆罗列拜于堂下，奔走供设；须臾，德公还，直入相就：不知何者是客也。","attribution":"《襄阳记》","section_title":"庞统法正传第七","source":{"file":"OEBPS/Text/titlepage_0080.xhtml","index":22,"anchor":null},"note_id":"n-952f093ecb11b9f464e8","start":73,"end":164}],"profiles":{},"directory_counts":{}}
