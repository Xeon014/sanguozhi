{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dongyuan-e-o040a","title":"沮授说袁绍平河北迎帝兴复之策袁绍喜表监军将军","accounts":[{"id":"dongyuan-e-o040a-account","label":"《董二袁刘传第六》正文","text":"沮授说袁绍平河北迎帝兴复之策袁绍喜表监军将军","evidence":["dongyuan-e-o040a-q"]}],"participants":[{"person":"wudi-p0218","role":"献策受任","evidence":["dongyuan-e-o040a-q"]},{"person":"wudi-p0052","role":"采纳表任","evidence":["dongyuan-e-o040a-q"]}],"place":null,"time":{"label":"袁绍领冀州时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-o040a-q"]},"ordering_evidence":"dongyuan-e-o040a-q","source_order":[6,250,"O040a"],"order":1635}],"persons":[{"id":"wudi-p0052","name":"袁绍","facts":[],"aliases":[]},{"id":"wudi-p0218","name":"沮授","facts":[],"aliases":[]}],"evidence":[{"id":"dongyuan-e-o040a-q","section":"chapter-006","block":"b-d1dc27b2f8ddd7223f4f","layer":"original","quote":"绍遂领冀州牧。从事沮授说绍曰：“将军弱冠登朝〖1〗，则播名海内；值废立之际，则忠义奋发；单骑出奔，则董卓怀怖；济河而北，则勃海稽首〖2〗。振一郡之卒〖3〗，撮冀州之众；威震河朔〖4〗，名重天下。虽黄巾猾乱〖5〗，黑山跋扈；举军东向，则青州可定；还讨黑山，则张燕可灭；回众北首〖6〗，则公孙必丧；震胁戎狄，则匈奴必从。横大河之北〖7〗，合四州之地〖8〗；收英雄之才，拥百万之众；迎大驾于西京〖9〗，复宗庙于洛邑〖10〗；号令天下，以讨未复〖11〗。以此争锋，谁能敌之！比及数年，此功不难。”绍喜曰：“此吾心也！”即表授为监军、奋威将军〖12〗。﹝一﹞","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":249,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":274,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
