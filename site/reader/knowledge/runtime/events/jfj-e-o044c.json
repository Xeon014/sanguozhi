{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"jfj-e-o044c","title":"姜维芒水挑战司马望邓艾不应","order":7813,"accounts":[{"id":"jfj-a-o044c","label":"正文 · 延熙二十年","text":"姜维芒水挑战司马望邓艾不应","evidence":["jfj-q0167"]}],"participants":[{"person":"shaodi-p0050","role":"挑战","evidence":["jfj-q0167"]},{"person":"shaodi-p0071","role":"拒战","evidence":["jfj-q0167"]},{"person":"shaodi-p0080","role":"拒战","evidence":["jfj-q0167"]}],"place":null,"time":{"label":"延熙二十年","precision":"year","basis":"逐条保留原时间；未从邻段自动继承公元年。","evidence":["jfj-q0167","jfj-q0024","jfj-q0025"],"year":257,"chronology":"jfj-y257","dating_review":{"reviewed":true,"anchor":"jfj-q0024","basis":"本条行动与所列正文纪年逐项核对；现代注释直接释年。原季月保留，不推公历日。"}},"ordering_evidence":"jfj-q0167"}],"persons":[{"id":"shaodi-p0050","name":"姜维","facts":[],"aliases":[]},{"id":"shaodi-p0071","name":"司马望","facts":[],"aliases":[]},{"id":"shaodi-p0080","name":"邓艾","facts":[],"aliases":[]}],"evidence":[{"id":"jfj-q0024","section":"chapter-044","block":"b-70b129f69e54215e09f3","layer":"original","quote":"二十年〖10〗，魏征东大将军诸葛诞反于淮南，分关中兵东下。维欲乘虚向秦川，复率数万人出骆谷，径至沈岭〖11〗。时长城积谷甚多而守兵乃少〖12〗；闻维方到，众皆惶惧。魏大将军司马望拒之〖13〗，邓艾亦自陇右：皆军于长城。维前住芒水〖14〗，（皆）倚山为营。望、艾傍渭坚围；维数下挑战，望、艾不应。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":197,"anchor":null},"note_id":null,"start":0,"end":147},{"id":"jfj-q0025","section":"chapter-044","block":"b-2042526783f17163c7e8","layer":"modern","quote":"〖10〗二十年：延熙二十年（公元257）。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":208,"anchor":null},"note_id":"n-b269653f5ff038081692","start":0,"end":21},{"id":"jfj-q0167","section":"chapter-044","block":"b-70b129f69e54215e09f3","layer":"original","quote":"维前住芒水〖14〗，（皆）倚山为营。望、艾傍渭坚围；维数下挑战，望、艾不应。","section_title":"蒋琬费祎姜维传第十四","source":{"file":"OEBPS/Text/titlepage_0094.xhtml","index":197,"anchor":null},"note_id":null,"start":109,"end":147}],"profiles":{},"directory_counts":{}}
