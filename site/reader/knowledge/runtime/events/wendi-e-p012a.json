{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wendi-e-p012a","title":"曹丕任郑称为武德侯傅","accounts":[{"id":"wendi-e-p012a-account","label":"裴注·魏略","text":"曹丕任郑称为武德侯傅","evidence":["wendi-e-p012a-q"]}],"participants":[{"person":"wudi-p0170","role":"任命","evidence":["wendi-e-p012a-q"]},{"person":"wendi-p0055","role":"任傅","evidence":["wendi-e-p012a-q"]}],"place":null,"time":{"year":220,"label":"延康元年五月封武德侯之后","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"wendi-y220","dating_review":{"reviewed":true,"anchor":"wendi-q-o002","basis":"延康元年五月封武德侯之后"},"evidence":["wendi-e-p012a-q","wendi-q-o002","wendi-q-o019","wendi-q-b-ec88012a7f6c352d0e04"]},"ordering_evidence":"wendi-e-p012a-q","source_order":[2,62,"P012a"],"order":491}],"persons":[{"id":"wendi-p0055","name":"郑称","facts":[],"aliases":[]},{"id":"wudi-p0170","name":"曹丕","facts":[],"aliases":[]}],"evidence":[{"id":"wendi-e-p012a-q","section":"chapter-002","block":"b-4d43b91c28bea285daf1","layer":"pei","quote":"以侍中郑称，为武德侯傅，令曰：‘龙渊、太阿，出昆吾之金；和氏之璧，由井里之田。砻之以砥励，错之以他山；故能致连城之价，为命世之宝。学亦人之砥砺也。称，笃学大儒，勉以经学辅侯；宜旦夕入侍，曜明其志。","attribution":"裴注·魏略","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":61,"anchor":null},"note_id":"n-c3807b5821b95c9c61bc","start":10,"end":108},{"id":"wendi-q-b-ec88012a7f6c352d0e04","section":"chapter-002","block":"b-ec88012a7f6c352d0e04","layer":"modern","quote":"〖1〗二年：黄初二年（公元 221）。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":210,"anchor":null},"note_id":"n-8fff547b113ffa36bbc1","start":0,"end":19},{"id":"wendi-q-o002","section":"chapter-002","block":"b-1c3ea4f0ea338bf2ec5a","layer":"original","quote":"太祖崩，嗣位为丞相，魏王。﹝三﹞尊王后曰王太后〖5〗。改建安二十五年为延康元年。","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":2,"anchor":null},"note_id":null,"start":0,"end":40},{"id":"wendi-q-o019","section":"chapter-002","block":"b-8820e5c7f9006d364c44","layer":"original","quote":"二年春正月〖1〗，郊祀天地、明堂〖2〗。甲戌〖3〗，校猎至原陵〖4〗。遣使者，以太牢祠汉世祖〖5〗。乙亥〖6〗，朝日于东郊〖7〗。﹝一﹞初令郡国口满十万者〖8〗，岁察孝廉一人；其有秀异〖9〗，无拘户口。辛巳〖10〗，分三公户邑，封子弟各一人为列侯。壬午〖11〗，复颍川郡一年田租〖12〗。﹝二﹞改许县为许昌县。以魏郡东部为阳平郡〖13〗，西部为广平郡〖14〗。﹝三﹞","section_title":"文帝纪第二","source":{"file":"OEBPS/Text/titlepage_0009.xhtml","index":208,"anchor":null},"note_id":null,"start":0,"end":183}],"profiles":{},"directory_counts":{}}
