{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"dongyuan-e-p015b","title":"董卓九月甲戌复会群臣言废何后刘辩立刘协","accounts":[{"id":"dongyuan-e-p015b-account","label":"《献帝纪》","text":"董卓九月甲戌复会群臣言废何后刘辩立刘协","evidence":["dongyuan-e-p015b-q"]}],"participants":[{"person":"wudi-p0053","role":"议废立","evidence":["dongyuan-e-p015b-q"]}],"place":null,"time":{"label":"董卓议废立时","precision":"undated","basis":"保留本条时间表达，不据相邻段落自动补年。","evidence":["dongyuan-e-p015b-q"]},"ordering_evidence":"dongyuan-e-p015b-q","source_order":[6,55,"P015b"],"order":1502}],"persons":[{"id":"wudi-p0053","name":"董卓","facts":[],"aliases":[]}],"evidence":[{"id":"dongyuan-e-p015b-q","section":"chapter-006","block":"b-87f3878f95852484824d","layer":"pei","quote":"九月，甲戌，卓复大会群臣曰：‘太后逼迫永乐太后，令以忧死；逆妇姑之礼，无孝顺之节。天子幼质，软弱不君。昔伊尹放太甲，霍光废昌邑；著在典籍，佥以为善。今太后宜如太甲，皇帝宜如昌邑；陈留王仁孝，宜即尊皇祚。’","attribution":"《献帝纪》","section_title":"董二袁刘传第六","source":{"file":"OEBPS/Text/titlepage_0017.xhtml","index":54,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-04146f894cef8a06feb3","start":167,"end":269,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
