{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"santizhu064-e-sr-liang-letter-rotation","title":"《江表传》诸葛亮闻恪典粮谷书陆逊、逊白权转恪领兵","accounts":[{"id":"santizhu064-a-617928deac8b5bcd0774","label":"裴注·江表传","text":"权初置节度官典军粮，初用徐详，详死特用恪；亮闻恪代详书陆逊言家兄年老恪性疏典粮不安，请逊启至尊转之；逊以白权，即转恪领兵","evidence":["santizhu064-q-a71ad8cbb03d695f4408"]}],"participants":[{"person":"zhuge-liang","role":"闻恪代详，书陆逊请转任","evidence":["santizhu064-q-a71ad8cbb03d695f4408"]},{"person":"xianzhu-p0115","role":"受书并白孙权","evidence":["santizhu064-q-a71ad8cbb03d695f4408"]},{"person":"sun-quan","role":"闻白后即转恪领兵","evidence":["santizhu064-q-a71ad8cbb03d695f4408"]},{"person":"shaodi-p0041","role":"由节度转领兵","evidence":["santizhu064-q-a71ad8cbb03d695f4408"]}],"place":null,"time":{"label":"原文纪年见引文；不换算公元年","precision":"undated","basis":"未由相邻段落推算纪年；原文时间表达保留在来源引句中。","evidence":["santizhu064-q-a71ad8cbb03d695f4408"]},"ordering_evidence":"santizhu064-q-a71ad8cbb03d695f4408","source_order":[64,88,0],"order":10941}],"persons":[{"id":"shaodi-p0041","name":"诸葛恪","facts":[],"aliases":[]},{"id":"sun-quan","name":"孙权","facts":[],"aliases":[]},{"id":"xianzhu-p0115","name":"陆逊","facts":[],"aliases":[]},{"id":"zhuge-liang","name":"诸葛亮","facts":[],"aliases":[]}],"evidence":[{"id":"santizhu064-q-a71ad8cbb03d695f4408","section":"chapter-064","block":"b-6b9edc917f34e7cd159d","layer":"pei","quote":"《江表传》曰：“权为吴王，初置节度官，使典掌军粮：非汉制也。初用侍中、偏将军徐详；详死，（将）〔特〕用恪。诸葛亮闻恪代详，书与陆逊曰：‘家兄年老，而恪性疏。今使典主粮谷，粮谷军之要最；仆虽在远，窃用不安。足下特为启至尊，转之。’逊以白权，即转恪领兵。”","attribution":"裴注·江表传","section_title":"诸葛滕二孙濮阳传第十九","source":{"file":"OEBPS/Text/titlepage_0135.xhtml","index":87,"anchor":null},"note_id":"n-31c9cea7ff8d0e14f82a","start":3,"end":129}],"profiles":{},"directory_counts":{}}
