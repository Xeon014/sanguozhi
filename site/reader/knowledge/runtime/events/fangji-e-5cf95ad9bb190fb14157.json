{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"fangji-e-5cf95ad9bb190fb14157","title":"刘邠欲从管辂学射覆；辂言明府以虚神于注《易》，亦宜绝思于灵蓍，纤微未可以为易；邠曰以为术者《易》之近数欲求其端；留辂五日不遑恤官，但共清谈","accounts":[{"id":"fangji-a-5cf95ad9bb190fb14157","label":"裴注·辂别传","text":"刘邠欲从管辂学射覆；辂言明府以虚神于注《易》，亦宜绝思于灵蓍，纤微未可以为易；邠曰以为术者《易》之近数欲求其端；留辂五日不遑恤官，但共清谈","evidence":["fangji-q-42d673fec1d583b58b1b"]}],"participants":[{"person":"fangji-p-45e95af396f222","role":"求学留客者","evidence":["fangji-q-42d673fec1d583b58b1b"]},{"person":"fangji-p-f06456c2a8f978","role":"答者","evidence":["fangji-q-42d673fec1d583b58b1b"]}],"place":null,"time":{"label":"年代未详","precision":"undated","basis":"未审定公元年，不从相邻段落推算。","evidence":["fangji-q-42d673fec1d583b58b1b"]},"ordering_evidence":"fangji-q-42d673fec1d583b58b1b","order":6055}],"persons":[{"id":"fangji-p-45e95af396f222","name":"刘邠","facts":[],"aliases":[]},{"id":"fangji-p-f06456c2a8f978","name":"管辂","facts":[],"aliases":[]}],"evidence":[{"id":"fangji-q-42d673fec1d583b58b1b","section":"chapter-029","block":"b-71b292f114846bf765a2","layer":"pei","quote":"欲从辂学射覆，辂言：‘今明府以虚神于注《易》，亦宜绝思于灵蓍。灵蓍者，二仪之明数，阴阳之幽契；施之于道，则定天下吉凶；用之于术，则收天下毫纤。纤微，未可以为易也。’邠曰：‘以为术者，《易》之近数，欲求其端耳。若如来论，何事于斯！’留辂五日，不遑恤官，但共清谈","attribution":"裴注·辂别传","section_title":"方伎传第二十九","source":{"file":"OEBPS/Text/titlepage_0064.xhtml","index":409,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":"n-cb3321ae6817ee796b04","start":460,"end":589,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
