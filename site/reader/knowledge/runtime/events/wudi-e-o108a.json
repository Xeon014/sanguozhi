e_point"},{"id":"wudi-q-o107","section":"chapter-001","block":"b-25deb42237a5de280ce3","layer":"original","quote":"十一年春正月〖1〗，公征幹。幹闻之，乃留其别将守城，走入匈奴，求救于单于〖2〗。单于不受。公围壶关三月，拔之。幹遂走荆州〖3〗，上洛都尉王琰捕斩之。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":598,"anchor":null},"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","note_id":null,"start":0,"end":74,"offset_unit":"unicode_code_point"}],"profiles":{},"directory_counts":{}}
