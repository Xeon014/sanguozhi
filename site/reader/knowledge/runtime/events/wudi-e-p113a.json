{"schema_version":2,"source_sha256":"b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28","events":[{"id":"wudi-e-p113a","title":"曹操上书谢受魏公","accounts":[{"id":"wudi-e-p113a-account","label":"《魏略》","text":"《魏略》载曹操上书，追述奉汉征战，解释接受封国，并许父子尽命报恩。","evidence":["wudi-e-p113a-q"]}],"participants":[{"person":"cao-cao","role":"上书","evidence":["wudi-e-p113a-q"]},{"person":"wudi-p0054","role":"受书","evidence":["wudi-e-p113a-q"]}],"place":null,"time":{"label":"受封魏公后","year":213,"precision":"year","basis":"纪年经本批逐段审定；年份依据见所引原文纪年与现代注释。","evidence":["wudi-e-p113a-q","wudi-q-o139","wudi-q-b-b9d79988a2b2559f2bb5"],"chronology":"wudi-y213","dating_review":{"anchor":"wudi-q-o139","basis":"受封魏公后","reviewed":true}},"source_order":[1,939,"P113a"],"order":340}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[]},{"id":"wudi-p0054","name":"汉献帝","facts":[],"aliases":[]}],"evidence":[{"id":"wudi-e-p113a-q","section":"chapter-001","block":"b-3b3e7993f0e5c4582a4b","layer":"pei","quote":"《魏略》载公上书谢曰：“臣蒙先帝厚恩，致位郎署；受性疲怠，意望毕足；非敢希望高位，庶几显达。会董卓作乱，义当死难；故敢奋身出命，摧锋率众。遂值千载之运，奉役目下。当二袁炎沸侵侮之际，陛下与臣寒心同忧，顾瞻京师，进受猛敌；常恐君臣俱陷虎口，诚不自意能全首领。赖祖宗灵祐，丑类夷灭，得使微臣，窃名其间。陛下加恩，授以上相；封爵宠禄，丰大弘厚；生平之愿，实不望也。口与心计，幸且待罪；保持列侯，遗付子孙；自托圣世，永无忧责。不意陛下乃发盛意，开国备锡，以贶愚臣；地比齐、鲁，礼同藩王；非臣无功，所宜膺据。归情上闻，不蒙听许；严诏切至，诚使臣心俯仰逼迫。伏自惟省，列在大臣；命制王室，身非己有；岂敢自私，遂其愚意？亦将黜退，令就初服。今奉疆土，备数藩翰；非敢远期，虑有后世。至于父子相誓，终身灰躯尽命，报塞厚恩。天威在颜，悚惧受诏。”","attribution":"《魏略》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":263,"anchor":null},"note_id":"n-97e94061646080072adf","start":0,"end":363},{"id":"wudi-q-b-b9d79988a2b2559f2bb5","section":"chapter-001","block":"b-b9d79988a2b2559f2bb5","layer":"modern","quote":"〖11〗十八年：建安十八年（公元 213）。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":137,"anchor":null},"note_id":"n-bec99dfe67d67ae54b06","start":0,"end":22},{"id":"wudi-q-o139","section":"chapter-001","block":"b-d44820525c4645832365","layer":"original","quote":"十八年春正月〖11〗，进军濡须口〖12〗；攻破权江西营，获权都督公孙阳〖13〗，乃引军还。诏书并十四州〖14〗，复为九州〖15〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":107,"anchor":null},"note_id":null,"start":0,"end":65}],"profiles":{},"directory_counts":{}}
