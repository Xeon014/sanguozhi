e":"卒","evidence":["zhuge-e-o040a-q"]},{"person":"wudi-p0364","role":"察营","evidence":["zhuge-e-o040a-q"]},{"person":"xianzhu-p0112","role":"诸葛亮卒，素服发哀三日；遣李福省侍诸葛亮，因咨以国家大计","evidence":["dengzhang-q-36e16d5d0fc6a1c96f0d"]},{"person":"xianzhu-p0102","role":"在家闻诸葛亮卒，即便奔赴；寻有诏书禁断，惟其以速行得达","evidence":["duzhou-q-89291fa3e519e1471949"]}],"place":null,"time":{"year":234,"label":"其年八月及退军后","precision":"year","basis":"逐条核对本篇纪年及所引释年；未换算公历日。","chronology":"zhuge-y234","dating_review":{"reviewed":true,"anchor":"zhuge-q-o039","basis":"其年八月及退军后"},"evidence":["zhuge-e-o040a-q","zhuge-q-o039","zhuge-q-b-934abed655148ea08df3"]},"ordering_evidence":"zhuge-e-o040a-q","source_order":[35,260,"O040a"],"related_events":[{"event":"zhuge-e-p039a","type":"alternative","evidence":["zhuge-e-o040a-q"]},{"event":"dengzhang-e2-lifu-asks-successor","type":"related","evidence":["dengzhang-q2-f46c6578f33e567665bf","zhuge-e-o040a-q"]}],"order":6801}],"persons":[{"id":"zhuge-liang","name":"诸葛亮","facts":[],"aliases":[]}],"evidence":[{"id":"zhuge-e-p039a-q","section":"chapter-035","block":"b-471647abd7bfa93d4889","layer":"pei","quote":"﹝四﹞《魏书》曰：“亮粮尽势穷，忧恚呕血，一夕烧营遁走；入谷，道发病卒。”","attribution":"《魏书》","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":308,"anchor":null},"note_id":"n-b775a3de637528356864","start":0,"end":37},{"id":"zhuge-q-p042-judgment","section":"chapter-035","block":"b-0a59dde320aea01c4c71","layer":"pei","quote":"臣松之以为：亮在渭滨，魏人蹑迹；胜负之形，未可测量。而云“呕血”，盖因亮自亡而自夸大也。夫以孔明之略，岂为仲达呕血乎？及至刘琨丧师，与晋元帝笺亦云“亮军败呕血”，此则引虚记以为言也。其云“入谷”而卒，缘蜀人入谷发丧故也。","attribution":"裴松之论","section_title":"诸葛亮传第五","source":{"file":"OEBPS/Text/titlepage_0076.xhtml","index":311,"anchor":null},"note_id":"n-b775a3de637528356864","start":0,"end":110}],"profiles":{},"directory_counts":{}}
