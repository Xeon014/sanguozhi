1","label":"记载","text":"《周瑜传》记甘宁据夷陵后被曹仁分兵围攻，周瑜采纳吕蒙建议，留凌统守后，亲自与吕蒙救援。","evidence":["yiling-zhou"]},{"id":"yiling-relief-account-2","label":"记载","text":"《吕蒙传》保存吕蒙提出留凌公绩守后、自己与周瑜等救援的言辞。","evidence":["yiling-meng"]},{"id":"wuzhu-e-o015b-account","label":"《吴主传第二》正文","text":"甘宁被围周瑜用吕蒙计留凌统拒曹仁分兵救甘宁","evidence":["wuzhu-e-o015b-q"]}],"participants":[{"person":"gan-ning","role":"据夷陵、告急","evidence":["yiling-zhou"]},{"person":"cao-ren","role":"分兵围攻","evidence":["yiling-zhou"]},{"person":"zhou-yu","role":"救援","evidence":["yiling-zhou"]},{"person":"lu-meng","role":"献策、同行救援","evidence":["yiling-zhou"]},{"person":"ling-tong","role":"留守后方","evidence":["yiling-zhou"]}],"place":{"text":"夷陵","evidence":["yiling-zhou"]},"time":{"label":"曹军北归后的南郡战事","precision":"relative","basis":"依《周瑜传》北归、进南郡、救夷陵的叙述先后；原段未明示年月，不沿用赤壁年份。","after":"cao-retreat","evidence":["retreat","yiling-zhou"]}},{"id":"zhou-plan","title":"周瑜陈说拒曹之策","order":9592,"accounts":[{"id":"zhou-plan-account-1","label":"记载","text":"周瑜请率精兵进住夏口；孙权赞同迎击曹操。","evidence":["zhou-advice","sun-decision"]},{"id":"zhouyu-a-o010-reasoning","label":null,"text":"周瑜从北土未安、马韩后患、水战不习及寒疾等方面论拒曹之利。","evidence":["zhouyu-q-o010-reasoning"]},{"id":"zhouyu-a-p007-priority","label":"裴松之论","text":"裴松之认为拒曹本谋始鲁肃，周瑜自鄱阳还与肃暗同，批评本传攘肃之善。","evidence":["zhouyu-q-p007-priority"]}],"participants":[{"person":"zhou-yu","role":"陈说进军方案","evidence":["zhou-advice"]},{"person":"sun-quan","role":"赞同迎击","evidence":["sun-decision"]},{"person":"cao-cao","role":"拟迎击对象","evidence":["allied-zhou","zhou-advice"]}],"place":{"text":"夏口（拟进军地点）","evidence":["zhou-advice"]},"time":{"label":"建安十三年（208）","year":208,"precision":"year","basis":"年次承接本篇建安十三年记事，现代注释释为公元 208 年；此条未记具体月日。","evidence":["year-original","year-modern","zhou-year","zhou-year-modern","zhou-advice","sun-decision"]}}],"persons":[{"id":"cao-cao","name":"曹操","facts":[],"aliases":[],"evidence":[]},{"id":"liu-bei","name":"刘备","facts":[],"aliases":[],"evidence":[]},{"id":"lu-meng","name":"吕蒙","facts":[],"aliases":[],"evidence":[]},{"id":"lu-su","name":"鲁肃","facts":[],"aliases":[],"evidence":[]},{"id":"zhou-yu","name":"周瑜","facts":[],"aliases":[],"evidence":[]}],"evidence":[{"id":"allied-zhou","section":"chapter-054","block":"b-df9e8a2d1c2855c608f2","quote":"权遂遣瑜及程普等，与备并力逆曹公，遇于赤壁。","layer":"original","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":62,"anchor":null},"note_id":null,"start":41,"end":63},{"id":"battle-shu","section":"chapter-032","block":"b-1846d8225e91af23e064","quote":"与曹公战于赤壁〖10〗；大破之，焚其舟船。先主与吴军水陆并进，追到南郡。时又疾疫，北军多死，曹公引归。","layer":"original","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":113,"anchor":null},"note_id":null,"start":40,"end":91},{"id":"battle-wei","section":"chapter-001","block":"b-c35781bdeff07231cb61","quote":"公至赤壁〖16〗，与备战，不利；于是大疫，吏士多死者。乃引军还，","layer":"original","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":664,"anchor":null},"note_id":null,"start":50,"end":82},{"id":"envoy-shu","section":"chapter-032","block":"b-1846d8225e91af23e064","quote":"先主遣诸葛亮自结于孙权，","layer":"original","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":113,"anchor":null},"note_id":null,"start":0,"end":12},{"id":"envoy-su","section":"chapter-054","block":"b-47261412a84083cdfce6","quote":"备遂到夏口，遣亮使权。肃亦反命〖13〗。","layer":"original","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":214,"anchor":null},"note_id":null,"start":31,"end":51},{"id":"fire-jiangbiao","section":"chapter-054","block":"b-046b11c4d33d588538b8","quote":"时东南风急，因以十舰最著前，中江举帆。盖举火白诸校，使众兵齐声大叫曰：‘降焉！’操军人皆出营立观。去北军二里余，同时发火；火烈风猛，往船如箭；飞埃绝烂，烧尽北船，延及岸边营（柴）〔栅〕。","layer":"pei","attribution":"《江表传》","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":86,"anchor":null},"note_id":"n-90216583c8655708d70e","start":53,"end":146},{"id":"first-battle","section":"chapter-054","block":"b-95e35995161a23acb622","quote":"时曹公军众，已有疾病；初一交战，公军败退，引次江北〖1〗。瑜等在南岸。","layer":"original","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":63,"anchor":null},"note_id":null,"start":0,"end":35},{"id":"huang-feint","section":"chapter-054","block":"b-8be6669092a37ba75e2e","quote":"先书报曹公，欺以欲降。","layer":"original","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":64,"anchor":null},"note_id":null,"start":76,"end":87},{"id":"huang-fire","section":"chapter-054","block":"b-8be6669092a37ba75e2e","quote":"盖放诸船，同时发火。时风盛〔火〕猛，悉延烧岸上营落。","layer":"original","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":64,"anchor":null},"note_id":null,"start":132,"end":158},{"id":"huang-plan","section":"chapter-054","block":"b-8be6669092a37ba75e2e","quote":"瑜部将黄盖曰：“今寇众我寡，难与持久。然观操军船舰，首尾相接：可烧而走也。”","layer":"original","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":64,"anchor":null},"note_id":null,"start":0,"end":38},{"id":"meeting-zhou","section":"chapter-054","block":"b-df9e8a2d1c2855c608f2","quote":"时刘备为曹公所破，欲引南渡江；与鲁肃遇于当阳，遂共图计。因进住夏口，遣诸葛亮诣权。权遂遣瑜及程普等，与备并力逆曹公，遇于赤壁。","layer":"original","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":62,"anchor":null},"note_id":null,"start":0,"end":63},{"id":"retreat","section":"chapter-054","block":"b-9cefd55fcd0518a1c94f","quote":"军遂败退，还保南郡。﹝二﹞备与瑜等复共追。曹公留曹仁等守江陵城，径自北归。","layer":"original","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":65,"anchor":null},"note_id":null,"start":0,"end":37},{"id":"south","section":"chapter-001","block":"b-031a374e9090ba29242f","quote":"秋七月，公南征刘表。八月，表卒；其子琮代〖4〗，屯襄阳〖5〗。","layer":"original","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":663,"anchor":null},"note_id":null,"start":0,"end":31},{"id":"su-advice","section":"chapter-054","block":"b-472e77c03c5b35774219","quote":"权知其意，执肃手曰：“卿欲何言？”肃对曰：“向察众人之议〖5〗，专欲误将军：不足与图大事。今肃可迎操耳，如将军，不可也。何以言之？今肃迎操，操当以肃还付乡党〖6〗；品其名位，犹不失下曹从事〖7〗，乘犊车〖8〗，从吏卒，交游士林：累官故不失州郡也〖9〗。将军迎操，欲安所归〖10〗？愿早定大计，莫用众人之议也！”","layer":"original","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":232,"anchor":null},"note_id":null,"start":0,"end":155},{"id":"su-meets","section":"chapter-054","block":"b-ecd089e31afbb09dad94","quote":"权即遣肃行。到夏口，闻曹公已向荆州，晨夜兼道。比至南郡，而表子琮已降曹公；备惶遽奔走，欲南渡江。肃径迎之，到当阳长坂〖10〗，与备会。宣腾权旨〖11〗，及陈江东强固，劝备与权并力：备甚欢悦。","layer":"original","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":213,"anchor":null},"note_id":null,"start":0,"end":95},{"id":"sun-decision","section":"chapter-054","block":"b-ce104dcfbe59e8754c6b","quote":"君言当击，甚与孤合，此天以君授孤也！","layer":"original","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":36,"anchor":null},"note_id":null,"start":59,"end":77},{"id":"surrender","section":"chapter-001","block":"b-031a374e9090ba29242f","quote":"九月，公到新野〖7〗，琮遂降。备走夏口〖8〗。","layer":"original","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":663,"anchor":null},"note_id":null,"start":39,"end":62},{"id":"wudi-e-o122c-q","section":"chapter-001","block":"b-c35781bdeff07231cb61","layer":"original","quote":"于是大疫，吏士多死者。乃引军还，备遂有荆州江南诸郡〖17〗。","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":664,"anchor":null},"note_id":null,"start":66,"end":96},{"id":"wudi-e-p088a-q","section":"chapter-001","block":"b-1d0fe831aaf31892272a","layer":"pei","quote":"《山阳公载记》曰：“公船舰为备所烧，引军从华容道，步归。遇泥泞，道不通。天又大风，悉使羸兵负草填之，骑乃得过。羸兵为人马所蹈藉，陷泥中，死者甚众。军既得出，公大喜；诸将问之，公曰：‘刘备，吾俦也，但得计少晚。向使早放火，吾徒无类矣！’备寻亦放火而无所及。","attribution":"《山阳公载记》","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_001.xhtml","index":14,"anchor":null},"note_id":"n-b1c5198aca732b51719e","start":3,"end":130},{"id":"xianzhu-e-o024b-q","section":"chapter-032","block":"b-c857386227851cc86ab3","layer":"original","quote":"子琮代立〖2〗，遣使请降。先主屯樊，不知曹公猝至；至宛乃闻之，遂将其众去。","section_title":"先主传第二","source":{"file":"OEBPS/Text/titlepage_0070.xhtml","index":108,"anchor":null},"note_id":null,"start":22,"end":59},{"id":"year-modern","section":"chapter-001","block":"b-888495d8be7766faf20c","quote":"十三年：建安十三年（公元 208）。","layer":"modern","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":666,"anchor":null},"note_id":"n-0bae348fdb687025113d","start":3,"end":21},{"id":"year-original","section":"chapter-001","block":"b-4bcffcc4ee709a4e5ea3","quote":"十三年春正月〖1〗，公还邺。","layer":"original","section_title":"武帝纪第一","source":{"file":"OEBPS/Text/titlepage_0007_split_000.xhtml","index":661,"anchor":null},"note_id":null,"start":0,"end":14},{"id":"yiling-meng","section":"chapter-054","block":"b-b3cb94f577df75ecc6eb","quote":"瑜使甘宁前据夷陵。曹仁分众攻宁；宁困急，使使请救。诸将以兵少不足分，蒙谓瑜、普曰：“留凌公绩〖20〗，蒙与君行；解围释急，势亦不久。蒙保公绩能十日守也。”","layer":"original","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":318,"anchor":null},"note_id":null,"start":0,"end":77},{"id":"yiling-zhou","section":"chapter-054","block":"b-e959844e829722ef4767","quote":"瑜与程普又进南郡，与仁相对，各隔大江。兵未交锋，﹝三﹞瑜即遣甘宁前据夷陵。仁分兵骑，别攻围宁，宁告急于瑜。瑜用吕蒙计，留凌统以守其后〖7〗；身与蒙上〖8〗，救宁。","layer":"original","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":66,"anchor":null},"note_id":null,"start":0,"end":81},{"id":"zhou-advice","section":"chapter-054","block":"b-bacde9135abd2a205a56","quote":"瑜请得精兵三万人，进住夏口，保为将军破之！","layer":"original","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":35,"anchor":null},"note_id":null,"start":276,"end":297},{"id":"zhou-year","section":"chapter-054","block":"b-3661896c106f1817bf4b","quote":"十三年春〖6〗，权讨江夏，瑜为前部大督〖7〗。其年九月，曹公入荆州，刘琮举众降。","layer":"original","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":34,"anchor":null},"note_id":null,"start":0,"end":40},{"id":"zhou-year-modern","section":"chapter-054","block":"b-63f47c62fde80b3a0132","quote":"十三年：建安十三年（公元 208）。","layer":"modern","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":43,"anchor":null},"note_id":"n-8f109f42647e5ee8d831","start":3,"end":21},{"id":"zhouyu-q-o010-reasoning","section":"chapter-054","block":"b-bacde9135abd2a205a56","layer":"original","quote":"瑜曰：“不然！操虽托名汉相，其实汉贼也！将军以神武雄才，兼仗父兄之烈〖11〗；割据江东，地方数千里；兵精足用，英雄乐业。尚当横行天下，为汉家除残去秽；况操自送死，而可迎之邪？请为将军筹之：今使北土已安〖12〗，操无内忧；能旷日持久，来争疆埸；又能与我较胜负于船楫〖13〗，（可乎）〔可也〕〖14〗。今北土既未平安；加马超、韩遂尚在关西〖15〗，为操后患；且舍鞍马，仗舟楫，与吴、越争衡〖16〗，本非中国所长〖17〗；又今盛寒，马无稿草〖18〗；驱中国士众远涉江湖之间，不习水土，必生疾病。此数四者〖19〗，用兵之患也，而操皆冒行之。将军擒操，宜在今日。瑜请得精兵三万人，进住夏口，保为将军破之！”","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":35,"anchor":null},"note_id":null,"start":0,"end":298},{"id":"zhouyu-q-p007-priority","section":"chapter-054","block":"b-693763015f3a5c900fb2","layer":"pei","quote":"臣松之以为：建计拒曹公，实始鲁肃。于时周瑜使鄱阳，肃劝权呼瑜；瑜使鄱阳还，但与肃暗同，故能共成大勋。本传直云，权延见群下，问以计策，瑜摆拨众人之议，独言抗拒之计；了不云肃先有谋，殆为攘肃之善也。","attribution":"裴松之论","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":61,"anchor":null},"note_id":"n-19fd8eb85b7b2ca85f96","start":315,"end":412},{"id":"zhouyu-q-p012-cao-claim","section":"chapter-054","block":"b-2214c5c24f10e6532e39","layer":"pei","quote":"后书与权曰：‘赤壁之役，值有疾病；孤烧船自退，横使周瑜虚获此名！","attribution":"《江表传》","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":119,"anchor":null},"note_id":"n-f170ddcf31cbbfb5f027","start":545,"end":577},{"id":"zhouyu-q-p014-judgment","section":"chapter-054","block":"b-ce708dbc3c8fcdf9b474","layer":"pei","quote":"﹝一﹞臣松之按：刘备与权并力，共拒中国，皆肃之本谋。又语诸葛亮曰：“我子瑜友也！”则亮已亟闻肃言矣。而《蜀书•亮传》曰：“亮以连横之略说权，权乃大喜。”如似此计，始出于亮。若二国史官，各记所闻，竟欲称扬本国容美，各取其功；今此二书，同出一人，而舛互若此，非载述之体也。","attribution":"裴松之按","section_title":"周瑜鲁肃吕蒙传第九","source":{"file":"OEBPS/Text/titlepage_0115.xhtml","index":230,"anchor":null},"note_id":"n-44a03e4ab7c323e722bd","start":0,"end":134}],"profiles":{},"directory_counts":{}}
