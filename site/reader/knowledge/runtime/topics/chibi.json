":["year-original","year-modern","zhou-year","zhou-year-modern","su-meets","meeting-zhou"]}},{"id":"huang-fire","title":"黄盖诈降与火攻","order":9598,"accounts":[{"id":"huang-fire-account-1","label":"记载","text":"《周瑜传》记黄盖提出火攻、先书诈降，再放船发火，火势延及岸上营落。","evidence":["huang-plan","huang-feint","huang-fire"]},{"id":"huang-fire-account-2","label":"记载","text":"裴注引《江表传》补叙东南风、火船逼近及延烧岸营。","evidence":["fire-jiangbiao"]},{"id":"zhouyu-a-p012-cao-claim","label":"《江表传》","text":"江表传引曹操书孙权称赤壁值病、自烧船退，与本篇黄盖火攻叙事分列。","evidence":["zhouyu-q-p012-cao-claim"]},{"id":"chenghuang-a-956e65a9b581e5e32300","label":"正文","text":"盖随周瑜拒曹公于赤壁建策火攻","evidence":["chenghuang-q-112b25280beb3b55ffc1"]}],"participants":[{"person":"huang-gai","role":"提出并实施火攻","evidence":["huang-plan","huang-fire"]},{"person":"cao-cao","role":"诈降书与火攻所向","evidence":["huang-feint","huang-plan"]},{"person":"zhou-yu","role":"黄盖所属主将","evidence":["huang-plan"]}],"place":{"text":"赤壁交战水域及岸上营落","evidence":["allied-zhou","huang-fire"]},"time":{"label":"建安十三年（208）","year":208,"precision":"year","basis":"年次承接本篇建安十三年记事，现代注释释为公元 208 年；此条未记具体月日。","evidence":["year-original","year-modern","zhou-year","zhou-year-modern","allied-zhou","huang-fire"]}},{"id":"liang-envoy","title":"诸葛亮出使孙权","order":6534,"accounts":[{"id":"liang-envoy-account-1","label":"记载","text":"《先主传》记刘备派诸葛亮与孙权联结。","evidence":["envoy-shu"]},{"id":"liang-envoy-account-2","label":"记载","text":"《鲁肃传》记刘备到夏口后派诸葛亮出使，鲁肃返回复命。","evidence":["envoy-su"]},{"id":"liang-envoy-account-3","label":"记载","text":"裴松之按语将刘备与孙权合力拒曹的谋划归于鲁肃；这是注家的判断。","evidence":["pei-su-assessment"]},{"id":"xianzhu-e-p027b-account","label":"《江表传》","text":"《江表传》记刘备住鄂县后遣诸葛亮随鲁肃至孙权处结盟。","evidence":["xianzhu-e-p027b-q"]},{"id":"zhouyu-e-o012b-account","label":"《周瑜鲁肃吕蒙传》正文","text":"建安十三年：刘备至夏口遣诸葛亮使孙权","evidence":["zhouyu-e-o012b-q"]},{"id":"zhuge-e-o010a-account","label":"《诸葛亮传第五》正文","text":"诸葛亮请使孙权求援","evidence":["zhuge-e-o010a-q"]}],"participants":[{"person":"liu-bei","role":"派遣使者","evidence":["envoy-shu"]},{"person":"zhuge-liang","r