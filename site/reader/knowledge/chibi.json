    },
    {
      "id": "sun-decision",
      "section": "chapter-054",
      "block": "b-ce104dcfbe59e8754c6b",
      "quote": "君言当击，甚与孤合，此天以君授孤也！",
      "layer": "original",
      "section_title": "周瑜鲁肃吕蒙传第九",
      "source": {
        "file": "OEBPS/Text/titlepage_0115.xhtml",
        "index": 36,
        "anchor": null
      },
      "source_sha256": "b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28",
      "note_id": null,
      "start": 59,
      "end": 77,
      "offset_unit": "unicode_code_point"
    },
    {
      "id": "allied-shu",
      "section": "chapter-032",
      "block": "b-1846d8225e91af23e064",
      "quote": "权遣周瑜、程普等水军数万〖9〗；与先主并力，",
      "layer": "original",
      "section_title": "先主传第二",
      "source": {
        "file": "OEBPS/Text/titlepage_0070.xhtml",
        "index": 113,
        "anchor": null
      },
      "source_sha256": "b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28",
      "note_id": null,
      "start": 15,
      "end": 37,
      "offset_unit": "unicode_code_point"
    },
    {
      "id": "allied-zhou",
      "section": "chapter-054",
      "block": "b-df9e8a2d1c2855c608f2",
      "quote": "权遂遣瑜及程普等，与备并力逆曹公，遇于赤壁。",
      "layer": "original",
      "section_title": "周瑜鲁肃吕蒙传第九",
      "source": {
        "file": "OEBPS/Text/titlepage_0115.xhtml",
        "index": 62,
        "anchor": null
      },
      "source_sha256": "b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28",
      "note_id": null,
      "start": 41,
      "end": 63,
      "offset_unit": "unicode_code_point"
    },
    {
      "id": "su-role",
      "section": "chapter-054",
      "block": "b-27591a11de61813e45a8",
      "quote": "遂任瑜以行事，以肃为赞军校尉〖13〗，助画方略。",
      "layer": "original",
      "section_title": "周瑜鲁肃吕蒙传第九",
      "source": {
        "file": "OEBPS/Text/titlepage_0115.xhtml",
        "index": 234,
        "anchor": null
      },
      "source_sha256": "b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28",
      "note_id": null,
      "start": 0,
      "end": 24,
      "offset_unit": "unicode_code_point"
    },
    {
      "id": "first-battle",
      "section": "chapter-054",
      "block": "b-95e35995161a23acb622",
      "quote": "时曹公军众，已有疾病；初一交战，公军败退，引次江北〖1〗。瑜等在南岸。",
      "layer": "original",
      "section_title": "周瑜鲁肃吕蒙传第九",
      "source": {
        "file": "OEBPS/Text/titlepage_0115.xhtml",
        "index": 63,
        "anchor": null
      },
      "source_sha256": "b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28",
      "note_id": null,
      "start": 0,
      "end": 35,
      "offset_unit": "unicode_code_point"
    },
    {
      "id": "battle-wei",
      "section": "chapter-001",
      "block": "b-c35781bdeff07231cb61",
      "quote": "公至赤壁〖16〗，与备战，不利；于是大疫，吏士多死者。乃引军还，",
      "layer": "original",
      "section_title": "武帝纪第一",
      "source": {
        "file": "OEBPS/Text/titlepage_0007_split_000.xhtml",
        "index": 664,
        "anchor": null
      },
      "source_sha256": "b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28",
      "note_id": null,
      "start": 50,
      "end": 82,
      "offset_unit": "unicode_code_point"
    },
    {
      "id": "battle-shu",
      "section": "chapter-032",
      "block": "b-1846d8225e91af23e064",
      "quote": "与曹公战于赤壁〖10〗；大破之，焚其舟船。先主与吴军水陆并进，追到南郡。时又疾疫，北军多死，曹公引归。",
      "layer": "original",
      "section_title": "先主传第二",
      "source": {
        "file": "OEBPS/Text/titlepage_0070.xhtml",
        "index": 113,
        "anchor": null
      },
      "source_sha256": "b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28",
      "note_id": null,
      "start": 40,
      "end": 91,
      "offset_unit": "unicode_code_point"
    },
    {
      "id": "huang-plan",
      "section": "chapter-054",
      "block": "b-8be6669092a37ba75e2e",
      "quote": "瑜部将黄盖曰：“今寇众我寡，难与持久。然观操军船舰，首尾相接：可烧而走也。”",
      "layer": "original",
      "section_title": "周瑜鲁肃吕蒙传第九",
      "source": {
        "file": "OEBPS/Text/titlepage_0115.xhtml",
        "index": 64,
        "anchor": null
      },
      "source_sha256": "b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28",
      "note_id": null,
      "start": 0,
      "end": 38,
      "offset_unit": "unicode_code_point"
    },
    {
      "id": "huang-feint",
      "section": "chapter-054",
      "block": "b-8be6669092a37ba75e2e",
      "quote": "先书报曹公，欺以欲降。",
      "layer": "original",
      "section_title": "周瑜鲁肃吕蒙传第九",
      "source": {
        "file": "OEBPS/Text/titlepage_0115.xhtml",
        "index": 64,
        "anchor": null
      },
      "source_sha256": "b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28",
      "note_id": null,
      "start": 76,
      "end": 87,
      "offset_unit": "unicode_code_point"
    },
    {
      "id": "huang-fire",
      "section": "chapter-054",
      "block": "b-8be6669092a37ba75e2e",
      "quote": "盖放诸船，同时发火。时风盛〔火〕猛，悉延烧岸上营落。",
      "layer": "original",
      "section_title": "周瑜鲁肃吕蒙传第九",
      "source": {
        "file": "OEBPS/Text/titlepage_0115.xhtml",
        "index": 64,
        "anchor": null
      },
      "source_sha256": "b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28",
      "note_id": null,
      "start": 132,
      "end": 158,
      "offset_unit": "unicode_code_point"
    },
    {
      "id": "fire-jiangbiao",
      "section": "chapter-054",
      "block": "b-046b11c4d33d588538b8",
      "quote": "时东南风急，因以十舰最著前，中江举帆。盖举火白诸校，使众兵齐声大叫曰：‘降焉！’操军人皆出营立观。去北军二里余，同时发火；火烈风猛，往船如箭；飞埃绝烂，烧尽北船，延及岸边营（柴）〔栅〕。",
      "layer": "pei",
      "attribution": "《江表传》",
      "section_title": "周瑜鲁肃吕蒙传第九",
      "source": {
        "file": "OEBPS/Text/titlepage_0115.xhtml",
        "index": 86,
        "anchor": null
      },
      "source_sha256": "b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28",
      "note_id": "n-90216583c8655708d70e",
      "start": 53,
      "end": 146,
      "offset_unit": "unicode_code_point"
    },
    {
      "id": "retreat",
      "section": "chapter-054",
      "block": "b-9cefd55fcd0518a1c94f",
      "quote": "军遂败退，还保南郡。﹝二﹞备与瑜等复共追。曹公留曹仁等守江陵城，径自北归。",
      "layer": "original",
      "section_title": "周瑜鲁肃吕蒙传第九",
      "source": {
        "file": "OEBPS/Text/titlepage_0115.xhtml",
        "index": 65,
        "anchor": null
      },
      "source_sha256": "b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28",
      "note_id": null,
      "start": 0,
      "end": 37,
      "offset_unit": "unicode_code_point"
    },
    {
      "id": "retreat-shanyang",
      "section": "chapter-001",
      "block": "b-1d0fe831aaf31892272a",
      "quote": "公船舰为备所烧，引军从华容道，步归。",
      "layer": "pei",
      "attribution": "《山阳公载记》",
      "section_title": "武帝纪第一",
      "source": {
        "file": "OEBPS/Text/titlepage_0007_split_001.xhtml",
        "index": 14,
        "anchor": null
      },
      "source_sha256": "b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28",
      "note_id": "n-b1c5198aca732b51719e",
      "start": 13,
      "end": 31,
      "offset_unit": "unicode_code_point"
    },
    {
      "id": "meng-wulin",
      "section": "chapter-054",
      "block": "b-c5dafa5a24682c296ffa",
      "quote": "是岁，又与周瑜、程普等，西破曹公于乌林，围曹仁于南郡。",
      "layer": "original",
      "section_title": "周瑜鲁肃吕蒙传第九",
      "source": {
        "file": "OEBPS/Text/titlepage_0115.xhtml",
        "index": 316,
        "anchor": null
      },
      "source_sha256": "b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28",
      "note_id": null,
      "start": 91,
      "end": 118,
      "offset_unit": "unicode_code_point"
    },
    {
      "id": "meng-context",
      "section": "chapter-054",
      "block": "b-c5dafa5a24682c296ffa",
      "quote": "从征黄祖，祖令都督陈就，逆以水军出战。蒙勒前锋〖15〗，亲枭就首；将士乘胜，进攻其城。",
      "layer": "original",
      "section_title": "周瑜鲁肃吕蒙传第九",
      "source": {
        "file": "OEBPS/Text/titlepage_0115.xhtml",
        "index": 316,
        "anchor": null
      },
      "source_sha256": "b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28",
      "note_id": null,
      "start": 0,
      "end": 43,
      "offset_unit": "unicode_code_point"
    },
    {
      "id": "yiling-zhou",
      "section": "chapter-054",
      "block": "b-e959844e829722ef4767",
      "quote": "瑜与程普又进南郡，与仁相对，各隔大江。兵未交锋，﹝三﹞瑜即遣甘宁前据夷陵。仁分兵骑，别攻围宁，宁告急于瑜。瑜用吕蒙计，留凌统以守其后〖7〗；身与蒙上〖8〗，救宁。",
      "layer": "original",
      "section_title": "周瑜鲁肃吕蒙传第九",
      "source": {
        "file": "OEBPS/Text/titlepage_0115.xhtml",
        "index": 66,
        "anchor": null
      },
      "source_sha256": "b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28",
      "note_id": null,
      "start": 0,
      "end": 81,
      "offset_unit": "unicode_code_point"
    },
    {
      "id": "yiling-meng",
      "section": "chapter-054",
      "block": "b-b3cb94f577df75ecc6eb",
      "quote": "瑜使甘宁前据夷陵。曹仁分众攻宁；宁困急，使使请救。诸将以兵少不足分，蒙谓瑜、普曰：“留凌公绩〖20〗，蒙与君行；解围释急，势亦不久。蒙保公绩能十日守也。”",
      "layer": "original",
      "section_title": "周瑜鲁肃吕蒙传第九",
      "source": {
        "file": "OEBPS/Text/titlepage_0115.xhtml",
        "index": 318,
        "anchor": null
      },
      "source_sha256": "b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28",
      "note_id": null,
      "start": 0,
      "end": 77,
      "offset_unit": "unicode_code_point"
    },
    {
      "id": "pei-su-assessment",
      "section": "chapter-054",
      "block": "b-ce708dbc3c8fcdf9b474",
      "quote": "臣松之按：刘备与权并力，共拒中国，皆肃之本谋。",
      "layer": "pei",
      "attribution": "裴松之按语",
      "section_title": "周瑜鲁肃吕蒙传第九",
      "source": {
        "file": "OEBPS/Text/titlepage_0115.xhtml",
        "index": 230,
        "anchor": null
      },
      "source_sha256": "b0f2c19b3dce18a6d6e6148b6c0c6dd9332e1ab1a6357578003e333bc0a14a28",
      "note_id": "n-44a03e4ab7c323e722bd",
      "start": 3,
      "end": 26,
      "offset_unit": "unicode_code_point"
    }
  ],
