    {
      "id": "south",
      "section": "chapter-001",
      "block": "b-031a374e9090ba29242f",
      "quote": "秋七月，公南征刘表。八月，表卒；其子琮代〖4〗，屯襄阳〖5〗。",
      "layer": "original",
      "section_title": "武帝纪第一",
      "source": {
        "file": "OEBPS/Text/titlepage_0007_split_000.xhtml",
        "index": 663,
